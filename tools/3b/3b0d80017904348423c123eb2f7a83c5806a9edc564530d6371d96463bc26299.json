{
 "description": "Count issues with filters",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assigneeId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "attachment": {
    "type": "boolean"
   },
   "categoryId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "createdSince": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "createdUntil": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "createdUserId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "dueDateSince": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "dueDateUntil": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "hasDueDate": {
    "type": "boolean"
   },
   "id": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "issueTypeId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "keyword": {
    "type": "string"
   },
   "milestoneId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "offset": {
    "type": "number"
   },
   "order": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "parentChild": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 3,
      "type": "number"
     },
     {
      "const": 4,
      "type": "number"
     }
    ]
   },
   "parentIssueId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "priorityId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "projectId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "resolutionId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "sharedFile": {
    "type": "boolean"
   },
   "sort": {
    "enum": [
     "issueType",
     "category",
     "version",
     "milestone",
     "summary",
     "status",
     "priority",
     "attachment",
     "sharedFile",
     "created",
     "createdUser",
     "updated",
     "updatedUser",
     "assignee",
     "startDate",
     "dueDate",
     "estimatedHours",
     "actualHours",
     "childIssue"
    ],
    "type": "string"
   },
   "startDateSince": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "startDateUntil": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "statusId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "updatedSince": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "updatedUntil": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "versionId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "count_issues"
}
