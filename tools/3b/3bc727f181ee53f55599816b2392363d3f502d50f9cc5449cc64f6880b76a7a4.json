{
 "_meta": {
  "openai/outputTemplate": "ui://sendit/widget/accounts-carousel.html",
  "openai/toolInvocation/invoked": "Accounts loaded",
  "openai/toolInvocation/invoking": "Loading accounts...",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://sendit/apps/accounts-app.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List all connected social media accounts. Pass team_id to see a team's accounts instead of your personal ones.",
 "inputSchema": {
  "properties": {
   "team_id": {
    "description": "Team ID to list team accounts. Get available teams with list_teams. If omitted, lists personal accounts.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_connected_accounts",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "accounts": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "authUrl": {
       "type": "string"
      },
      "connected": {
       "type": "boolean"
      },
      "expiryWarning": {
       "type": "boolean"
      },
      "platform": {
       "enum": [
        "x",
        "linkedin",
        "linkedin-page",
        "facebook",
        "instagram",
        "threads",
        "bluesky",
        "mastodon",
        "nostr",
        "youtube",
        "tiktok",
        "lemmy",
        "discord",
        "slack",
        "telegram",
        "pinterest",
        "dribbble",
        "devto",
        "hashnode",
        "gmb",
        "whop",
        "producthunt"
       ],
       "type": "string"
      },
      "platformUsername": {
       "type": "string"
      },
      "username": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "connectedCount": {
    "type": "number"
   },
   "errorMessage": {
    "type": "string"
   },
   "followUpSuggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "isError": {
    "type": "boolean"
   },
   "totalPlatforms": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "List Connected Accounts"
}
