{
 "description": "List available payment processors and their capabilities. Returns Yoco (card, immediate) and Ozow (instant EFT via South African bank account). Call when the customer asks 'how can I pay?' or before presenting options. The result informs the payment_method field in create_checkout and complete_checkout.",
 "inputSchema": {
  "properties": {
   "order_total_zar": {
    "description": "Optional. For future per-handler limit filtering.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get_payment_methods",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "default_currency": {
    "const": "ZAR",
    "type": "string"
   },
   "handlers": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "display_name": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "methods": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "redirect": {
       "type": "boolean"
      },
      "supports_3ds": {
       "type": "boolean"
      },
      "supports_banks": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "webhook_verified": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "display_name",
      "methods",
      "redirect",
      "webhook_verified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   }
  },
  "required": [
   "default_currency",
   "handlers",
   "note"
  ],
  "type": "object"
 }
}
