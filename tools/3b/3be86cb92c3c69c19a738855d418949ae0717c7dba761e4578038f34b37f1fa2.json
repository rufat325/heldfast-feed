{
 "_meta": {
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "order:submit",
   "scopes": [
    "order:submit"
   ]
  },
  "vesremont.com/user-confirmation": true
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit only an order already approved by the buyer in the confirmation page. Requires the returned token and a stable unique idempotency_key; retry the same key after uncertainty. Never bypass confirmation. OAuth scopes: order:submit. Changes buyer or order state.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token returned by prepare_order for the exact summary the buyer personally approved on the confirmation page. It cannot replace that approval.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Unique key for ONE approved submission. Keep this key and the same body for retries after uncertainty; never generate a new key to retry that order. REST sends it as Idempotency-Key.",
    "pattern": "^[A-Za-z0-9._:-]{16,128}$",
    "type": "string"
   }
  },
  "required": [
   "confirmation_token",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "submit_order",
 "outputSchema": {
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "cancelled": {
      "type": "boolean"
     },
     "created_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "order_id": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
     },
     "payment_status": {
      "enum": [
       "paid",
       "partially_paid",
       "unpaid"
      ]
     },
     "status": {
      "description": "Actual Bitrix status code; submitted is not store confirmation.",
      "type": "string"
     },
     "status_history": {
      "type": "null"
     },
     "submission_status": {
      "const": "submitted"
     },
     "summary": {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "type": "string"
       },
       "delivery_finalized": {
        "type": "null"
       },
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "line_total": {
           "type": "number"
          },
          "name": {
           "maxLength": 300,
           "type": "string"
          },
          "product_id": {
           "minimum": 0,
           "type": "integer"
          },
          "quantity": {
           "type": "number"
          },
          "unit_price": {
           "type": "number"
          }
         },
         "required": [
          "product_id",
          "name",
          "quantity",
          "unit_price",
          "line_total"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "recorded_order_total": {
        "type": "number"
       },
       "store_confirmation": {
        "type": "null"
       }
      },
      "required": [
       "items",
       "recorded_order_total",
       "currency",
       "delivery_finalized",
       "store_confirmation"
      ],
      "type": "object"
     },
     "updated_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "order_id",
     "submission_status",
     "status",
     "cancelled",
     "payment_status",
     "created_at",
     "updated_at",
     "summary",
     "status_history"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "operation_id": {
      "type": "string"
     },
     "status": {
      "const": "processing"
     }
    },
    "required": [
     "status",
     "operation_id",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
