{
 "description": "List recent workflow executions for the project, optionally filtered by workflowId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assignedToMeOnly": {
    "description": "Only executions assigned to the calling user (OAuth user, or the bot's owner with --bot).",
    "type": "boolean"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pendingApprovalOnly": {
    "description": "Only PENDING_INVOKE_APPROVAL / PLANNED executions.",
    "type": "boolean"
   },
   "workflowId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-workflow-executions"
}
