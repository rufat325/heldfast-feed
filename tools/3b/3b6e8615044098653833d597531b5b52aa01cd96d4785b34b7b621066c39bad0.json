{
 "description": "Recomenda tipo de investimento com base no perfil, prazo, valor e objetivo. Retorna op\u00e7\u00f5es rankeadas com pr\u00f3s e contras.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Valor dispon\u00edvel para investir em R$",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "goal": {
    "default": "growth",
    "description": "Objetivo",
    "enum": [
     "emergency_fund",
     "short_term",
     "aposentadoria",
     "passive_income",
     "growth"
    ],
    "type": "string"
   },
   "months": {
    "description": "Prazo em meses",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "needs_liquidity": {
    "default": true,
    "description": "Precisa de liquidez di\u00e1ria?",
    "type": "boolean"
   },
   "profile": {
    "description": "Perfil de risco",
    "enum": [
     "conservative",
     "moderate",
     "aggressive"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "months",
   "profile"
  ],
  "type": "object"
 },
 "name": "advise_investment"
}
