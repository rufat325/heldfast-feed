{
 "description": "Generate a PDF from a URL or raw HTML. Provide either 'url' or 'html', not both.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "css": {
    "description": "CSS to inject before rendering",
    "type": "string"
   },
   "emulateMediaType": {
    "enum": [
     "screen",
     "print"
    ],
    "type": "string"
   },
   "enableFormFields": {
    "description": "Enable interactive PDF form fields from HTML",
    "type": "boolean"
   },
   "footer": {
    "description": "HTML string for the page footer",
    "type": "string"
   },
   "header": {
    "description": "HTML string for the page header",
    "type": "string"
   },
   "html": {
    "description": "Raw HTML string to render as PDF",
    "type": "string"
   },
   "javascript": {
    "description": "JavaScript to inject before rendering",
    "type": "string"
   },
   "marginBottom": {
    "description": "Bottom margin",
    "type": "string"
   },
   "marginLeft": {
    "description": "Left margin",
    "type": "string"
   },
   "marginRight": {
    "description": "Right margin",
    "type": "string"
   },
   "marginTop": {
    "description": "Top margin e.g. '10mm'",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Custom metadata to attach",
    "type": "object"
   },
   "orientation": {
    "description": "Page orientation (default: portrait)",
    "enum": [
     "portrait",
     "landscape"
    ],
    "type": "string"
   },
   "pageSizeType": {
    "description": "Page size (default: a4)",
    "enum": [
     "a0",
     "a1",
     "a2",
     "a3",
     "a4",
     "a5",
     "a6",
     "ledger",
     "tabloid",
     "legal",
     "letter"
    ],
    "type": "string"
   },
   "preSignedUrlExpiresIn": {
    "description": "Pre-signed download URL expiry in seconds (60\u201386400)",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "printBackground": {
    "description": "Print background graphics (default: true)",
    "type": "boolean"
   },
   "url": {
    "description": "Public URL to render as PDF",
    "format": "uri",
    "type": "string"
   },
   "waitForNetworkIdle": {
    "description": "Wait for network idle before rendering",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "generate_pdf"
}
