{
 "description": "Resize an image with optional fit mode. At least one of width or height required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fit": {
    "description": "Fit mode",
    "enum": [
     "cover",
     "contain",
     "fill",
     "inside",
     "outside"
    ],
    "type": "string"
   },
   "format": {
    "description": "Output format",
    "enum": [
     "jpeg",
     "png",
     "webp",
     "avif"
    ],
    "type": "string"
   },
   "height": {
    "description": "Target height in pixels",
    "minimum": 1,
    "type": "number"
   },
   "image_base64": {
    "description": "Base64-encoded image file",
    "type": "string"
   },
   "quality": {
    "description": "Output quality",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "width": {
    "description": "Target width in pixels",
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "image_base64"
  ],
  "type": "object"
 },
 "name": "bytario_image_resize"
}
