{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Open, inspect, restore, or cancel one bounded TouchDesigner editor workspace using an existing Network Editor plus one right-hand TOP Viewer or Panel split. The bridge schedules every UI access on the TD main thread, keeps only JSON job state, uses compare-and-swap restoration, and fails closed in Perform/headless/conflicted states. It never opens arbitrary UI, creates project operators, adds graph undo, or falls back to raw Python; the authenticated structured routes work with ALLOW_EXEC=0.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "open",
     "status",
     "restore",
     "cancel"
    ],
    "type": "string"
   },
   "lease_seconds": {
    "description": "Bounded lease before compare-and-swap cleanup is attempted.",
    "maximum": 900,
    "minimum": 30,
    "type": "integer"
   },
   "network_path": {
    "description": "Explicit COMP to show in the existing Network Editor.",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "split_ratio": {
    "description": "Share of the existing Network Editor after the right-hand split.",
    "maximum": 0.75,
    "minimum": 0.35,
    "type": "number"
   },
   "viewer_mode": {
    "description": "Use a bounded TOP Viewer or Panel pane; arbitrary pane types are not accepted.",
    "enum": [
     "top_output",
     "panel_controls"
    ],
    "type": "string"
   },
   "viewer_path": {
    "description": "Exact TOP output or panel-capable COMP to show.",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "workspace_id": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_artist_workspace",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "open",
     "status",
     "restore",
     "cancel"
    ],
    "type": "string"
   },
   "baseline": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "fingerprint": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "pane_count": {
        "maximum": 16,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "pane_count",
       "fingerprint"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "cleanup": {
    "additionalProperties": false,
    "properties": {
     "attempted": {
      "type": "boolean"
     },
     "baseline_verified": {
      "type": "boolean"
     },
     "owned_pane_closed": {
      "type": "boolean"
     },
     "source_restored": {
      "type": "boolean"
     }
    },
    "required": [
     "attempted",
     "owned_pane_closed",
     "source_restored",
     "baseline_verified"
    ],
    "type": "object"
   },
   "created_at": {
    "minimum": 0,
    "type": "number"
   },
   "deduplicated": {
    "type": "boolean"
   },
   "expires_at": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "owned_pane": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "name": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "enum": [
         "TOPVIEWER",
         "PANEL"
        ],
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "reason": {
    "anyOf": [
     {
      "enum": [
       "perform_mode",
       "ui_unavailable",
       "no_active_network_editor",
       "source_pane_unavailable",
       "target_not_found",
       "wrong_target_family",
       "cross_project",
       "pane_limit",
       "workspace_capacity",
       "stale_target",
       "artist_layout_changed",
       "owned_pane_missing",
       "scheduling_error",
       "apply_timeout",
       "lease_expired",
       "client_cancelled",
       "callback_error"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "source_pane": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 256,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "type": {
        "const": "NETWORKEDITOR",
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "scheduled",
     "active",
     "restore_scheduled",
     "cancel_scheduled",
     "cleanup_scheduled",
     "restored",
     "cancelled",
     "expired",
     "suppressed",
     "conflicted",
     "failed"
    ],
    "type": "string"
   },
   "targets": {
    "additionalProperties": false,
    "properties": {
     "network_path": {
      "anyOf": [
       {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "split_ratio": {
      "anyOf": [
       {
        "maximum": 0.75,
        "minimum": 0.35,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "viewer_mode": {
      "anyOf": [
       {
        "enum": [
         "top_output",
         "panel_controls"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "viewer_path": {
      "anyOf": [
       {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "network_path",
     "viewer_path",
     "viewer_mode",
     "split_ratio"
    ],
    "type": "object"
   },
   "undo_label": {
    "type": "null"
   },
   "warnings": {
    "items": {
     "maxLength": 512,
     "type": "string"
    },
    "maxItems": 16,
    "type": "array"
   },
   "workspace": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "fingerprint": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "pane_count": {
        "maximum": 16,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "pane_count",
       "fingerprint"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "workspace_id": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "action",
   "status",
   "deduplicated",
   "created_at",
   "expires_at",
   "targets",
   "source_pane",
   "owned_pane",
   "baseline",
   "workspace",
   "cleanup",
   "reason",
   "warnings",
   "undo_label"
  ],
  "type": "object"
 },
 "title": "Manage a temporary artist workspace"
}
