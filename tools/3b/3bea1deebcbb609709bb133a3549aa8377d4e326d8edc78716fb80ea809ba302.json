{
 "description": "Validate a Xahau/XRPL address (classic r-address or X-address) \u2192 type, account-id, embedded destination tag, network. Offline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "validate_address",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "type": "string"
   },
   "classicAddress": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "network": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "tag": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "type": {
    "type": "string"
   },
   "valid": {
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
