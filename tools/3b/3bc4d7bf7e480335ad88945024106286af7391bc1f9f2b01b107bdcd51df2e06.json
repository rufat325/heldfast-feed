{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check compensation"
 },
 "description": "Check EU261/UK261 compensation eligibility and amount for a delayed or cancelled flight. Give IATA codes; distance is computed for known airports.",
 "inputSchema": {
  "properties": {
   "arrival": {
    "description": "Arrival airport IATA code, e.g. JFK",
    "type": "string"
   },
   "arrival_delay_hours": {
    "type": "number"
   },
   "carrier_country": {
    "description": "Carrier's country code, e.g. DE",
    "type": "string"
   },
   "departure": {
    "description": "Departure airport IATA code, e.g. LHR",
    "type": "string"
   },
   "disrupted": {
    "enum": [
     "delayed",
     "cancelled"
    ],
    "type": "string"
   },
   "distance_km": {
    "type": "number"
   },
   "notice_days": {
    "type": "number"
   },
   "reason_category": {
    "enum": [
     "unknown",
     "weather",
     "atc",
     "security",
     "political",
     "strike_atc",
     "strike_airline",
     "technical",
     "crew",
     "other"
    ],
    "type": "string"
   },
   "reroute_arrival_delay_hours": {
    "type": "number"
   },
   "rerouted": {
    "type": "boolean"
   }
  },
  "required": [
   "departure",
   "arrival",
   "disrupted"
  ],
  "type": "object"
 },
 "name": "check_compensation"
}
