{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Change a confirmed booking's dates, guests, add-ons or rate (a stay under way can only be extended). Booked nights keep their booked price; added ones are at today's price; removing nights follows the cancellation terms. Without confirm it only shows the new total, what's still to pay or refunded; to change it, call again with confirm: true and expectedTotal set to the newTotal the person agreed to.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"adults":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"bookingId":{"type":"string"},"children":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"confirm":{"default":false,"description":"Must be true to actually change it","type":"boolean"},"expectedTotal":{"description":"With confirm: the newTotal from the preview, e.g. '\u20a6130,000'","type":"string"},"rateId":{"type":"string"},"when":{"description":"New dates, in the shape the rate uses; omit to keep them","oneOf":[{"properties":{"checkIn":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"checkOut":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"kind":{"const":"nights","type":"string"}},"required":["kind","checkIn","checkOut"],"type":"object"},{"properties":{"hours":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"kind":{"const":"hours","type":"string"},"start":{"description":"Local start, YYYY-MM-DDTHH:mm","type":"string"}},"required":["kind","start","hours"],"type":"object"},{"properties":{"block":{"description":"Block name from the rate, e.g. Morning","type":"string"},"date":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"kind":{"const":"block","type":"string"}},"required":["kind","date","block"],"type":"object"},{"properties":{"days":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"kind":{"const":"days","type":"string"},"start":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["kind","start","days"],"type":"object"},{"properties":{"kind":{"const":"months","type":"string"},"months":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"start":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["kind","start","months"],"type":"object"},{"properties":{"kind":{"const":"years","type":"string"},"start":{"description":"YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"years":{"maximum":9007199254740991,"minimum":1,"type":"integer"}},"required":["kind","start","years"],"type":"object"}]}},"required":["bookingId"],"type":"object"},"name":"change_booking","title":"Change a booking"}
