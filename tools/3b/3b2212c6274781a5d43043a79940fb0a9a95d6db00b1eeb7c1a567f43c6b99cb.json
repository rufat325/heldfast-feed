  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Secret Reference UUID or slug",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_secret_reference",
