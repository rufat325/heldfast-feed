    "required": [
     "id",
     "organisation_id",
     "name",
     "slug",
     "description",
     "manager_type",
     "secret_path",
     "secret_key",
     "allow_all_workspaces",
     "tags",
     "status",
     "created_by",
     "created_at",
     "last_updated_at",
     "auth_config",
