{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "title": "Update entry"
 },
 "description": "Update an existing entry. Only send fields you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contact_ids": {
    "description": "Replace associated contacts",
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "type": "array"
   },
   "content": {
    "description": "Entry content (supports #tag# and [[tag]])",
    "type": "string"
   },
   "date": {
    "description": "Date (YYYY-MM-DD)",
    "type": "string"
   },
   "id": {
    "description": "Entry UUID",
    "format": "uuid",
    "type": "string"
   },
   "tag_ids": {
    "description": "Replace associated tags",
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Entry type",
    "enum": [
     "call",
     "email",
     "meeting",
     "event",
     "gift",
     "letter",
     "message",
     "log",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_entry"
}
