{
 "description": "List comments",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Published after this ISO8601 date",
    "type": "string"
   },
   "author": {
    "description": "Limit to comments by these user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "author_email": {
    "description": "Limit to comments by this author email",
    "type": "string"
   },
   "author_exclude": {
    "description": "Exclude comments by these user IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "before": {
    "description": "Published before this ISO8601 date",
    "type": "string"
   },
   "exclude": {
    "description": "Exclude these comment IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "include": {
    "description": "Limit to these comment IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "offset": {
    "description": "Skip this many comments (overrides page)",
    "type": "integer"
   },
   "order": {
    "description": "Sort direction (default desc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "description": "Sort field (default date_gmt)",
    "enum": [
     "date",
     "date_gmt",
     "id",
     "include",
     "post",
     "parent",
     "type"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "integer"
   },
   "parent": {
    "description": "Limit to replies to these comment IDs ([0] = top level)",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "parent_exclude": {
    "description": "Exclude replies to these comment IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "password": {
    "description": "Password of the post, if it is password protected (write-only, never returned)",
    "type": "string"
   },
   "per_page": {
    "default": 20,
    "description": "Comments per page (max 100)",
    "type": "integer"
   },
   "post": {
    "description": "Limit to comments on these post IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Comment status (default approve; 'all' = approved and pending)",
    "enum": [
     "approve",
     "hold",
     "spam",
     "trash",
     "all"
    ],
    "type": "string"
   },
   "type": {
    "description": "Comment type: comment (default), pingback, trackback, note, ...",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_comments"
}
