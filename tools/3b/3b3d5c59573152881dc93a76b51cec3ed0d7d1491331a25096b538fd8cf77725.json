{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get playlist"
 },
 "description": "Use this before editing a playlist (item ids for remove and reorder come from here, and so does the `version` the edit tools take) and after swapping one onto a live stream (to see the swap finished). Returns the draft items in play order, what a running stream is playing right now, whether the draft differs from that, how it differs, and any custom playback order attached: id, name, kind, mode, version, liveVersion, hasUnpublishedChanges, publishStatus, items, liveItems, diff, orderSequencer and its version and status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Playlist id (pl_...), from list_playlists.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_playlist",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "diff": {
      "additionalProperties": {},
      "description": "added, removed and moved items: the draft against liveItems.",
      "properties": {},
      "type": "object"
     },
     "hasUnpublishedChanges": {
      "description": "The draft differs from what a running stream plays.",
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "items": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": {},
         "properties": {
          "id": {
           "description": "Item id (plitm_...).",
           "type": "string"
          },
          "objectID": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "position": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          }
         },
         "required": [
          "id",
          "objectID",
          "position"
         ],
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Draft items in play order."
     },
     "kind": {
      "type": "string"
     },
     "liveItems": {
      "description": "What a running stream plays now.",
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     },
     "liveVersion": {
      "description": "The version a running stream plays.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "mode": {
      "description": "sequential or shuffle.",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "orderSequencer": {
      "anyOf": [
       {
        "additionalProperties": {},
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "The custom playback order attached, if any."
     },
     "publishStatus": {
      "description": "Progress of a live swap.",
      "type": "string"
     },
     "version": {
      "description": "Draft version: pass as basedOnVersion / expectedDraftVersion.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "id",
     "name",
     "kind",
     "mode",
     "version",
     "liveVersion",
     "hasUnpublishedChanges",
     "publishStatus",
     "items",
     "liveItems",
     "diff",
     "orderSequencer"
