{
 "_meta": {
  "openai/outputTemplate": "ui://astra-db/app.html",
  "ui": {
   "resourceUri": "ui://astra-db/app.html"
  },
  "ui/resourceUri": "ui://astra-db/app.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find documents or rows"
 },
 "description": "Read documents (collections) or rows (tables) with an optional Data API filter, sort, and projection. Returns pages of 20 plus nextPageState for more. For similarity search use vector_search. Renders an interactive explorer.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "database": {
    "description": "Database to use: name, id, or Data API endpoint URL. Omit for the configured default.",
    "minLength": 1,
    "type": "string"
   },
   "emit": {
    "default": "structured",
    "description": "html_file also writes a self-contained HTML page and returns a link to it \u2014 only for terminal-only hosts, when the user asks for a visual.",
    "enum": [
     "structured",
     "html_file"
    ],
    "type": "string"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Data API filter, e.g. {\"status\": \"active\", \"year\": {\"$gte\": 2020}}. Typed ids as {\"$uuid\": \"\u2026\"} / {\"$objectId\": \"\u2026\"}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "keyspace": {
    "description": "Keyspace. Omit for the configured/default keyspace.",
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "description": "Only needed when a collection and a table share the name; otherwise detected.",
    "enum": [
     "collection",
     "table"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Documents to return (rounded up to whole pages of 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Collection or table name.",
    "minLength": 1,
    "type": "string"
   },
   "pageState": {
    "description": "nextPageState from a previous call, to continue paging.",
    "type": "string"
   },
   "projection": {
    "additionalProperties": {
     "anyOf": [
      {
       "const": 0,
       "type": "number"
      },
      {
       "const": 1,
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "description": "Fields to include (1) or exclude (0), e.g. {\"title\": 1, \"author\": 1}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "sort": {
    "additionalProperties": {
     "anyOf": [
      {
       "const": 1,
       "type": "number"
      },
      {
       "const": -1,
       "type": "number"
      }
     ]
    },
    "description": "Non-vector sort, e.g. {\"createdAt\": -1}. For similarity use vector_search.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "find",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "displayFields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "documents": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "endpoint": {
    "description": "Data API endpoint of the database this came from; pass it as `database` in follow-up calls.",
    "type": "string"
   },
   "fields": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "present": {
       "type": "number"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "present"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "filter": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "keyspace": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "collection",
     "table"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "nextPageState": {
    "type": [
     "string",
     "null"
    ]
   },
   "sort": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "view": {
    "const": "explorer",
    "type": "string"
   }
  },
  "required": [
   "view",
   "keyspace",
   "name",
   "kind",
   "filter",
   "sort",
   "documents",
   "displayFields",
   "fields",
   "nextPageState"
  ],
  "type": "object"
 },
 "title": "Find documents or rows"
}
