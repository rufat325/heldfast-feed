    "type": "integer"
   },
   "next_step": {
    "type": "string"
   },
   "products": {
    "items": {
     "properties": {
      "brand": {
       "properties": {
        "brand_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [],
       "type": "object"
      },
