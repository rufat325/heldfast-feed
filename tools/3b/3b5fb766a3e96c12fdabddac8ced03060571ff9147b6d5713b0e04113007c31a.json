 "description": "Privileged writer for reserved settings keys (security:* / policy:*) \u2014 the ONLY tool that can write them; the generic data_* tools refuse reserved keys. Upserts one key/value in the settings collection.",
 "inputSchema": {
  "properties": {
   "command_id": {
    "description": "idempotency key (uuid); auto-generated if omitted",
    "type": "string"
   },
   "key": {
    "description": "a reserved key, e.g. security:kanban:send_message (cap suffixes are snake_case \u2014 the caps field names)",
    "type": "string"
   },
   "value": {
    "description": "the policy value: allow | deny (true/false too); delete_items also takes confirm; call_tools takes \"*\", a JSON array or a comma-separated tool list; policy:csp:<app> (or policy:csp:*) takes a JSON object of origin arrays, e.g. {\"connectDomains\":[\"https://api.example.com\"]}. An unknown value is REFUSED, never stored",
    "type": "string"
   }
  },
  "required": [
   "key",
   "value"
  ],
  "type": "object"
 },
