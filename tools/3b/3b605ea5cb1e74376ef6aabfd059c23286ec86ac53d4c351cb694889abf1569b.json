 "description": "Create a fillable form with a public link anyone can use to submit responses (like a Google Form) \u2014 for surveys, sign-ups, feedback, RSVPs. Returns the shareable link; responses collect in Xenition. Use when the user wants to gather input from other people.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "collectEmail": {
    "description": "require the respondent's email",
    "type": "boolean"
   },
   "fields": {
    "description": "the fields to collect",
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "description": "the question / field label",
       "type": "string"
      },
      "options": {
       "description": "choices for select / multiselect",
       "items": {
        "type": "string"
       },
       "type": [
        "null",
        "array"
       ]
      },
      "required": {
       "type": "boolean"
      },
      "type": {
       "description": "field type: text, textarea, select, multiselect, number, date, email, boolean (default text)",
       "type": "string"
      }
     },
     "required": [
      "label"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "title": {
    "description": "the form's title",
    "type": "string"
   }
  },
  "required": [
