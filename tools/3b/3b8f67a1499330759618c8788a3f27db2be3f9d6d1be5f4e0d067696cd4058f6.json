{
 "description": "Test webhook delivery by sending a simulated match or event payload to an endpoint. Useful for verifying webhook integration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endpoint": {
    "description": "HTTPS webhook URL to test",
    "type": "string"
   },
   "type": {
    "description": "Event type to simulate",
    "enum": [
     "ad.update.price",
     "ad.update.surface",
     "ad.update.pictures",
     "ad.update.expired",
     "property.ad.create",
     "property.ad.update"
    ],
    "type": "string"
   }
  },
  "required": [
   "endpoint",
   "type"
  ],
  "type": "object"
 },
 "name": "test-webhook"
}
