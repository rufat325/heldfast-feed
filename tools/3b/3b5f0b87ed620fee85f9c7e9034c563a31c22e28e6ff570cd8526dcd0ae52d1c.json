{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read stream state"
 },
 "description": "Read a stream's current state, its current cued message, and event count. Read-only \u2014 does NOT advance the stream or consume a cue. Use it between feedback turns to inspect where a patient is in their federally-sourced, audience-safety-checked sequence.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "stream_id": {
    "description": "The stream_id returned by create_patient_stream.",
    "type": "integer"
   }
  },
  "required": [
   "stream_id"
  ],
  "type": "object"
 },
 "name": "read_stream_state",
 "outputSchema": {
  "properties": {
   "_meta": {
    "additionalProperties": true,
    "description": "Legal/disclosure block returned on every 2xx (A1 \u00a76.7).",
    "properties": {
     "api_version": {
      "type": "string"
     },
     "delivery_mode": {
      "type": "string"
     },
     "license_attribution": {
      "type": "string"
     },
     "no_medical_advice": {
      "type": "boolean"
     },
     "not_samd": {
      "type": "boolean"
     },
     "sequencing_ip_notice": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "current_cue": {
    "additionalProperties": true,
    "type": [
     "object",
     "null"
    ]
   },
   "events_count": {
    "type": "integer"
   },
   "next_cue_eligible": {
    "type": "boolean"
   },
   "rate_limit": {
    "additionalProperties": true,
    "description": "Discovery monthly cue-cap headroom. Absent on non-Discovery tiers (no cap).",
    "properties": {
     "limit": {
      "description": "Discovery monthly cue cap.",
      "type": "integer"
     },
     "remaining": {
      "description": "Cues remaining in the current calendar month (UTC).",
      "type": "integer"
     },
     "reset": {
      "description": "Seconds until the cap window resets (start of next calendar month, UTC; same basis as the 429 Retry-After).",
      "type": "integer"
     }
    },
    "type": "object"
   },
   "state": {
    "type": "string"
   },
   "stream_id": {
    "type": "integer"
   },
   "template_id": {
    "type": "string"
   }
  },
  "required": [
   "stream_id",
   "state",
   "_meta"
  ],
  "type": "object"
 }
}
