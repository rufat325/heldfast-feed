{
 "description": "Generate a security audit report for the n8n instance. Categories: credentials, database, filesystem, instance, nodes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Audit categories (all if omitted)",
    "items": {
     "enum": [
      "credentials",
      "database",
      "filesystem",
      "instance",
      "nodes"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "daysAbandonedWorkflow": {
    "description": "Days to consider a workflow abandoned (default 90)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "n8n_generate_audit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {},
  "type": "object"
 },
 "title": "Security audit"
}
