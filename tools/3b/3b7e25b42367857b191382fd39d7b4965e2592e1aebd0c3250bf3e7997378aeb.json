{
 "description": "Scroll the page or scroll an element into view",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Pixels (default: 500)",
    "type": "number"
   },
   "direction": {
    "enum": [
     "up",
     "down",
     "top",
     "bottom"
    ],
    "type": "string"
   },
   "selector": {
    "description": "Element to scroll into view",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "zen_scroll"
}
