{
 "annotations": {
  "destructiveHint": true,
  "title": "Fill region"
 },
 "description": "Place `block` into every empty (air) cell of the axis-aligned box from `from` to `to`. Best-effort: the bot must have the material and be able to reach a supporting face \u2014 cells with no adjacent solid to build against are skipped. Stops after `maxBlocks` placements (default 256). Cancellable; reports placed/skipped/failed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "block": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Block/item to place, e.g. \"cobblestone\""
   },
   "from": {
    "description": "One corner of the box",
    "properties": {
     "x": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "y": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "z": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "maxBlocks": {
    "description": "Max blocks to place this call (default 256)",
    "maximum": 20000,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "Opposite corner of the box",
    "properties": {
     "x": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "y": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "z": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   }
  },
  "required": [
   "from",
   "to",
   "block"
  ],
  "type": "object"
 },
 "name": "fill_region"
}
