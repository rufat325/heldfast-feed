{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List a scene's versions"
 },
 "description": "Lists a scene's published versions, newest first. Answers items (version, publishedAt, publishedBy), nextCursor and hasMore. Read one with scene_get and version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "The `nextCursor` from a previous page of this same tool.",
    "type": "string"
   },
   "first": {
    "description": "How many rows to return on this page; 20 when omitted.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "scene": {
    "description": "The scene (scn_\u2026), from list_scenes or create_scene.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "scene"
  ],
  "type": "object"
 },
 "name": "list_scene_versions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "items": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "publishedAt": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "publishedBy": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "version": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "version",
        "publishedAt",
        "publishedBy"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nextCursor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Pass back as `after` for the next page; null on the last"
     }
    },
    "required": [
     "items",
     "nextCursor",
     "hasMore"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "code": {
