   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "logs"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "event": {
    "type": "string"
   },
   "headers": {
    "type": "string"
   },
   "id": {
    "description": "ID del webhook",
    "type": "number"
   },
   "is_active": {
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "secret": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
