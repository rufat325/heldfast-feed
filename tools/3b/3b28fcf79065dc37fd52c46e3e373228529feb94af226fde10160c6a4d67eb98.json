{
 "description": "Update a claimed work item as it progresses. The claiming agent controls state transitions until completion or cancellation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "blockedReason": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dueAt": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "state": {
    "enum": [
     "open",
     "claimed",
     "blocked",
     "review",
     "done",
     "cancelled"
    ],
    "type": "string"
   },
   "workId": {
    "maxLength": 200,
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "workId",
   "agentId"
  ],
  "type": "object"
 },
 "name": "work_update"
}
