{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Product"
 },
 "description": "Update an existing product. Only provided fields are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "categoryIds": {
    "description": "Category IDs (first is primary). Replaces all existing categories.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "description": {
    "description": "Product description",
    "type": "string"
   },
   "discountPrice": {
    "description": "Discounted price",
    "type": "string"
   },
   "memberPrice": {
    "description": "Members-only price",
    "type": "string"
   },
   "name": {
    "description": "Product name",
    "type": "string"
   },
   "price": {
    "description": "Price as decimal string",
    "type": "string"
   },
   "productId": {
    "description": "The product ID",
    "type": "number"
   },
   "sku": {
    "description": "SKU code",
    "type": "string"
   },
   "status": {
    "description": "Product status",
    "enum": [
     "DRAFT",
     "ACTIVE",
     "ARCHIVED"
    ],
    "type": "string"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "update_product",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
