{
 "description": "Generate an opening description for a new scene. Uses location data and tone to create engaging scene framing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "focusOn": {
    "description": "Elements to emphasize (optional)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "layout": {
    "default": "exploration",
    "description": "Scene layout type (default: exploration)",
    "enum": [
     "splash",
     "exploration",
     "dialogue",
     "combat",
     "transition"
    ],
    "type": "string"
   },
   "locationId": {
    "description": "Location ID from world pack",
    "type": "string"
   },
   "locationName": {
    "description": "Location name if no ID",
    "type": "string"
   },
   "mood": {
    "description": "Desired mood (optional)",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "timeOfDay": {
    "description": "Time context (optional)",
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "frame_scene"
}
