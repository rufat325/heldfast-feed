{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List your bookmarked conduitAI catalog assets, with title and slug enriched per item. Supports filtering by asset type and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (1-100, default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "Filter by asset type",
    "enum": [
     "mcp_server",
     "mcp_client",
     "agent",
     "skill",
     "prompt",
     "plugin"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_bookmarks",
 "title": "List your bookmarks"
}
