{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare two retained snapshots. No longer observed does not mean reinstated; enrichment-only changes are excluded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque next_cursor from an earlier change page.",
    "type": [
     "string",
     "null"
    ]
   },
   "from_generation": {
    "description": "Older retained snapshot UUID to compare.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum changes to return, up to the service page limit.",
    "format": "uint",
    "maximum": 50,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "to_generation": {
    "description": "Newer retained snapshot UUID; omit for the current snapshot.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "from_generation"
  ],
  "type": "object"
 },
 "name": "exclusion_changes",
 "outputSchema": {
  "$defs": {
   "ExclusionChange": {
    "properties": {
     "change": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "change"
    ],
    "type": "object"
   },
   "ExclusionCoverage": {
    "properties": {
     "freshness": {
      "$ref": "#/$defs/SourceFreshness",
      "description": "Fresh, stale, unknown or unavailable, with age and the 24-hour warning policy."
     },
     "observed_at": {
      "description": "Observation time does not replace the official source timestamp.",
      "type": [
       "string",
       "null"
      ]
     },
     "scope": {
      "type": [
       "string",
       "null"
      ]
     },
     "sha256": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "description": "Present as unavailable when no SAM coverage exists in this generation.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "freshness"
    ],
    "type": "object"
   },
   "FreshnessState": {
    "enum": [
     "fresh",
     "stale",
     "unknown",
     "unavailable"
    ],
    "type": "string"
   },
   "SourceFreshness": {
    "properties": {
     "evaluated_at": {
      "description": "UTC time when age was evaluated; source and observation dates are unchanged.",
      "type": "string"
     },
     "max_age_seconds": {
      "description": "Explicit warning threshold for this daily snapshot. Not a scheduler promise.",
      "format": "int64",
      "type": "integer"
     },
     "source_age_seconds": {
      "description": "Age of the official source timestamp, never the import or enrichment timestamp.",
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "state": {
      "$ref": "#/$defs/FreshnessState"
     },
     "warning": {
      "description": "User-facing warning, or null when within the warning threshold.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "state",
     "evaluated_at",
     "max_age_seconds"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from_coverage": {
    "$ref": "#/$defs/ExclusionCoverage"
   },
   "from_generation": {
    "type": "string"
   },
   "items": {
    "items": {
     "$ref": "#/$defs/ExclusionChange"
    },
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "to_coverage": {
    "$ref": "#/$defs/ExclusionCoverage"
   },
   "to_generation": {
    "type": "string"
   }
  },
  "required": [
   "from_generation",
   "to_generation",
   "from_coverage",
   "to_coverage",
   "items",
   "meaning"
  ],
  "type": "object"
 },
 "title": "Review exclusion changes"
}
