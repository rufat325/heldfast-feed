{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get links to one application's documents"
 },
 "description": "Returns version-specific resume PDF and DOCX, cover-letter PDF and combined-pack PDF download links for one application, plus source, inclusion, lock state and revision. Links open without login for about ten minutes. Null links indicate missing or excluded documents. packPageUrl requires sign-in. There is no cover-letter DOCX.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicationId": {
    "type": "string"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "get_application_documents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applicationId": {
    "type": "string"
   },
   "coverLetter": {
    "additionalProperties": false,
    "properties": {
     "filename": {
      "type": "string"
     },
     "format": {
      "enum": [
       "text",
       "pdf",
       "docx",
       "txt",
       "md"
      ],
      "type": "string"
     },
     "included": {
      "type": "boolean"
     },
     "present": {
      "type": "boolean"
     },
     "source": {
      "anyOf": [
       {
        "enum": [
         "generated",
         "person"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "present",
     "included",
     "source"
    ],
    "type": "object"
   },
   "expiresAt": {
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "coverLetterPdf": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "packPdf": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resumeDocx": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resumePdf": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "resumePdf",
     "resumeDocx",
     "coverLetterPdf",
     "packPdf"
    ],
    "type": "object"
   },
   "locked": {
    "description": "A send is in flight; nothing about it can be changed.",
    "type": "boolean"
   },
   "packPageUrl": {
    "type": "string"
   },
   "resume": {
    "additionalProperties": false,
    "properties": {
     "filename": {
      "type": "string"
     },
     "format": {
      "enum": [
       "text",
       "pdf",
       "docx",
       "txt",
       "md"
      ],
      "type": "string"
     },
     "present": {
      "type": "boolean"
     },
     "sentAs": {
      "enum": [
       "original_pdf",
       "rendered_from_text"
      ],
      "type": "string"
     },
     "source": {
      "description": "`default` is their profile resume, `tailored` the copy written for this role, `person` one they handed in for it.",
      "enum": [
       "tailored",
       "default",
       "person"
      ],
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "present",
     "source"
    ],
    "type": "object"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "applicationId",
   "revision",
   "locked",
   "resume",
   "coverLetter",
   "links",
   "expiresAt",
   "packPageUrl"
  ],
  "type": "object"
 },
 "title": "Get links to one application's documents"
}
