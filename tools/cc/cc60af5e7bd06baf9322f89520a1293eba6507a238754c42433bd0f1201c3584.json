{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Aggregate Datadog logs with statistical computations (count, avg, sum, percentiles) and grouping",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregation": {
    "description": "Aggregation function. Example: count",
    "enum": [
     "count",
     "cardinality",
     "avg",
     "sum",
     "min",
     "max",
     "pc75",
     "pc90",
     "pc95",
     "pc98",
     "pc99"
    ],
    "type": "string"
   },
   "from": {
    "description": "Start time (ISO 8601). Example: 2026-02-26T00:00:00Z",
    "type": "string"
   },
   "groupBy": {
    "description": "Field to group by. Example: service or status or @http.status_code",
    "type": "string"
   },
   "metric": {
    "description": "Metric field for non-count aggregations. Example: @duration or @http.response_time",
    "type": "string"
   },
   "query": {
    "description": "Log filter query. Example: service:api-server status:error",
    "type": "string"
   },
   "to": {
    "description": "End time (ISO 8601). Example: 2026-02-26T23:59:59Z",
    "type": "string"
   }
  },
  "required": [
   "query",
   "from",
   "to",
   "aggregation"
  ],
  "type": "object"
 },
 "name": "aggregate-logs"
}
