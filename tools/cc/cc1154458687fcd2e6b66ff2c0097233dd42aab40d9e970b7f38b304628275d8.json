   },
   "company_id": {
    "description": "Restrict to one company",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "name_contains": {
    "description": "Text the configuration name contains",
    "type": "string"
   },
   "page_number": {
