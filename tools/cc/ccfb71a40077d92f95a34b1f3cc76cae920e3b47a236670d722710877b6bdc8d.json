{
 "annotations": {
  "readOnlyHint": true,
  "title": "List reviews"
 },
 "description": "List guest-to-host and host-to-guest reviews with rating (0-10), public review, private feedback and the host's reply. Filter by listings, reservation, type, status, rating range, dates, guest name, or whether the host has replied. Hostaway: GET /v1/reviews.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "departureDateEnd": {
    "description": "Reservation departure on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departureDateStart": {
    "description": "Reservation departure on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "guestName": {
    "description": "Partial, case-insensitive guest-name match.",
    "type": "string"
   },
   "hasHostReply": {
    "description": "true = only replied-to reviews; false = only unanswered.",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum records to return (1-500).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "listingMapIds": {
    "description": "Only reviews for these listing ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "offset": {
    "description": "Records to skip from the start.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "ratingMax": {
    "description": "Maximum rating (0-10).",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "ratingMin": {
    "description": "Minimum rating (0-10).",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "reservationId": {
    "description": "Hostaway reservation id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "sortBy": {
    "description": "Sort field.",
    "enum": [
     "id",
     "rating",
     "submittedAt",
     "arrivalDate",
     "departureDate",
     "guestName",
     "listingMapId",
     "status"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction (default desc).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "statuses": {
    "description": "Review statuses.",
    "items": {
     "enum": [
      "awaiting",
      "pending",
      "scheduled",
      "submitted",
      "published",
      "expired"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "submittedAtEnd": {
    "description": "Submitted on or before (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "submittedAtStart": {
    "description": "Submitted on or after (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "type": {
    "description": "Review direction.",
    "enum": [
     "guest-to-host",
     "host-to-guest"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hostaway_list_reviews",
 "title": "List reviews"
}
