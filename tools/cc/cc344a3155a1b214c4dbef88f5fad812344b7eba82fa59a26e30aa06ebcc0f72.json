{
 "annotations": {
  "_meta": {
   "ui": {
    "resourceUri": "ui://gate-approval"
   }
  },
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Approve or Reject Mandatory Gate"
 },
 "description": "Approve or reject a pending MANDATORY gate decision. Lists pending gates if no gate_id provided. This is the human-in-the-loop mechanism for MANDATORY classifications.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "approve",
     "reject",
     "break_glass"
    ],
    "type": "string"
   },
   "approved_by": {
    "default": "HUMAN",
    "description": "Identity of the approver",
    "type": "string"
   },
   "gate_id": {
    "description": "Gate ID to approve/reject (required for approve/reject)",
    "type": "string"
   },
   "rationale": {
    "description": "Reason for approval/rejection",
    "type": "string"
   },
   "webauthn_proof": {
    "additionalProperties": false,
    "description": "Optional WebAuthn passkey proof for cryptographic identity verification",
    "properties": {
     "credentialId": {
      "type": "string"
     },
     "signatureVerified": {
      "type": "boolean"
     },
     "userId": {
      "type": "string"
     },
     "verifiedAt": {
      "type": "string"
     }
    },
    "required": [
     "credentialId",
     "userId",
     "verifiedAt",
     "signatureVerified"
    ],
    "type": "object"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "approve_gate"
}
