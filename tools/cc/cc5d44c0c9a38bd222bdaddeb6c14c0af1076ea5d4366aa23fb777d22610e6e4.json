{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List bans"
 },
 "description": "List the users banned from the server, with their ban reasons. Returns { bans: [...], nextCursor }. A page holds up to 1000 bans; if nextCursor is non-null, pass it back as `after` to fetch the next page. Requires the Ban Members permission. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Pagination cursor: a user ID (snowflake). Pass the previous response's nextCursor to fetch the next page.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "limit": {
    "default": 1000,
    "description": "Max bans per page (1\u20131000). Default 1000.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "guild_id"
  ],
  "type": "object"
 },
 "name": "discord_list_bans",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bans": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reason": {
       "type": [
        "string",
        "null"
       ]
      },
      "user_id": {
       "type": "string"
      },
      "username": {
       "type": "string"
      }
     },
     "required": [
      "user_id",
      "username",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "bans",
   "nextCursor"
  ],
  "type": "object"
 }
}
