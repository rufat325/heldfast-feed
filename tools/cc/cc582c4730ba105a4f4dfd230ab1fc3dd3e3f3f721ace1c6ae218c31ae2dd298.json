{
 "description": "Create a QR code that encodes a contact card (vCard). When scanned by a phone camera, it prompts the user to save the contact. Supports all standard vCard fields and custom QR styling.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Street address.",
    "type": "string"
   },
   "background_color": {
    "description": "Hex color for background.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "corner_style": {
    "description": "Corner shape.",
    "enum": [
     "square",
     "extra-rounded",
     "dot"
    ],
    "type": "string"
   },
   "dot_style": {
    "description": "Dot shape.",
    "enum": [
     "square",
     "rounded",
     "dots",
     "classy-rounded"
    ],
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "type": "string"
   },
   "first_name": {
    "description": "Contact first name.",
    "type": "string"
   },
   "foreground_color": {
    "description": "Hex color for dots.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "format": {
    "default": "svg",
    "description": "Image format.",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "frame_color": {
    "description": "Frame background color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "frame_style": {
    "description": "Frame style around QR.",
    "enum": [
     "none",
     "banner_bottom",
     "banner_top",
     "rounded"
    ],
    "type": "string"
   },
   "frame_text": {
    "description": "CTA text on frame (max 30 chars).",
    "maxLength": 30,
    "type": "string"
   },
   "frame_text_color": {
    "description": "Frame text color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "label": {
    "description": "Label for this QR code.",
    "type": "string"
   },
   "last_name": {
    "description": "Contact last name.",
    "type": "string"
   },
   "logo_url": {
    "description": "Logo URL or data URI.",
    "type": "string"
   },
   "note": {
    "description": "Additional notes.",
    "type": "string"
   },
   "organization": {
    "description": "Company or organization.",
    "type": "string"
   },
   "phone": {
    "description": "Phone number.",
    "type": "string"
   },
   "title": {
    "description": "Job title.",
    "type": "string"
   },
   "url": {
    "description": "Website URL.",
    "type": "string"
   }
  },
  "required": [
   "first_name",
   "last_name"
  ],
  "type": "object"
 },
 "name": "create_vcard_qr"
}
