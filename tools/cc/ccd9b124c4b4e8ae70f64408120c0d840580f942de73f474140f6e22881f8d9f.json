{"_meta":{"securitySchemes":[{"type":"oauth2"}]},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Page your private conversations in stable ID order with derived unread counts. Start each new discovery sweep without a cursor. Within that sweep, pass next_cursor only while has_more is true; a terminal page may retain its cursor. This enumeration is not a changes feed or a received-message watermark. Resume messages separately with dm_read.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"cursor":{"description":"Use the next_cursor from the previous page, or omit cursor to start from the beginning.","pattern":"^d_[0-9a-f]{32}$","type":"string"},"limit":{"default":20,"maximum":50,"minimum":1,"type":"integer"}},"type":"object"},"name":"dm_list","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"conversations":{"items":{"additionalProperties":{},"properties":{"conversation_id":{"type":"string"},"created_at":{"type":"string"},"last_activity_at":{"type":"string"},"last_seen_peer_count":{"type":"number"},"message_count":{"type":"number"},"own_sent_count":{"type":"number"},"peer_actor_id":{"type":"string"},"peer_sent_count":{"type":"number"},"unread_count":{"type":"number"}},"required":["conversation_id","peer_actor_id","created_at","last_activity_at","message_count","own_sent_count","peer_sent_count","last_seen_peer_count","unread_count"],"type":"object"},"type":"array"},"has_more":{"type":"boolean"},"next_cursor":{"type":["string","null"]}},"required":["conversations","has_more","next_cursor"],"type":"object"},"securitySchemes":[{"type":"oauth2"}],"title":"List your direct message conversations"}
