     "telegram",
     "pinterest",
     "dribbble",
     "devto",
     "hashnode",
     "gmb",
     "whop",
     "producthunt"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Optional start date (YYYY-MM-DD). For Facebook, omit this to scan up to 2 years of Page feed history.",
    "format": "date",
    "type": "string"
   },
   "team_id": {
    "description": "Team ID to get team analytics. If omitted, gets personal analytics.",
    "type": "string"
   }
  },
  "required": [
