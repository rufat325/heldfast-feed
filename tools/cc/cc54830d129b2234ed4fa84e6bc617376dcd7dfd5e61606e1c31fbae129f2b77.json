 "description": "Get engagement analytics for a platform. Facebook and TikTok can include account-wide posts not published through SendIt; unresolved TikTok inbox-draft deliveries may appear as placeholders until SendIt can link them.",
 "inputSchema": {
  "properties": {
   "endDate": {
    "description": "Optional end date (YYYY-MM-DD).",
    "format": "date",
    "type": "string"
   },
   "limit": {
    "description": "Optional maximum posts to return. Facebook feed scanning is capped at 1,000 posts.",
    "maximum": 1000,
    "minimum": 1,
    "type": "number"
   },
   "platform": {
    "description": "Platform to get analytics for",
    "enum": [
     "x",
     "linkedin",
     "linkedin-page",
     "facebook",
     "instagram",
     "threads",
     "bluesky",
     "mastodon",
     "nostr",
