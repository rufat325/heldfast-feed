{
 "description": "Report the outcome of a purchase after using a PayClaw card. Must be called after every purchase attempt \u2014 this closes the audit trail.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actual_amount": {
    "description": "Actual amount charged in USD",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "number"
   },
   "intent_id": {
    "description": "The intent_id returned by payclaw_getCard",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "items": {
    "description": "Items purchased (free-form description)",
    "maxLength": 2000,
    "type": "string"
   },
   "merchant_name": {
    "description": "Merchant name as it appeared on the receipt",
    "maxLength": 500,
    "type": "string"
   },
   "order_confirmation": {
    "description": "Order confirmation number or ID",
    "maxLength": 200,
    "type": "string"
   },
   "success": {
    "description": "Whether the purchase succeeded",
    "type": "boolean"
   }
  },
  "required": [
   "intent_id",
   "success"
  ],
  "type": "object"
 },
 "name": "payclaw_reportPurchase"
}
