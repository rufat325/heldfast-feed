{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"See how a review is going, waiting up to about 25 seconds for news. Keep calling it while the status is checking or reviewing. When finished, it gives the verdict, each finding's title and severity, and a link to the full PDF to give the user. When the status is needs-answers, ask the user its questions and call answer_contract_review_questions.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"reviewId":{"pattern":"^[A-Za-z0-9_-]{43}\\.[0-9a-f-]{36}\\.[0-9a-f-]{36}$","type":"string"}},"required":["reviewId"],"type":"object"},"name":"get_contract_review","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"findings":{"items":{"properties":{"severity":{"type":"string"},"title":{"type":"string"}},"required":["severity","title"],"type":"object"},"type":"array"},"pdfUrl":{"type":"string"},"questions":{"items":{"properties":{"key":{"type":"string"},"prompt":{"type":"string"}},"required":["key","prompt"],"type":"object"},"type":"array"},"reason":{"type":"string"},"reviewId":{"type":"string"},"status":{"enum":["checking","reviewing","needs-answers","completed","turned-away","failed"],"type":"string"},"verdict":{"type":"string"}},"required":["reviewId","status"],"type":"object"},"title":"Get a contract review"}
