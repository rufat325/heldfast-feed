{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a map-tile overlay scaffold with tile layer maps, viewport metadata, attribution rows, adapter source, and token/cache safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "attribution_required": {
    "default": true,
    "type": "boolean"
   },
   "center_lat": {
    "default": 0,
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "center_lng": {
    "default": 0,
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "layer_count": {
    "default": 4,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "map_tile_overlay",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the map scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "openstreetmap",
    "enum": [
     "mapbox",
     "maptiler",
     "openstreetmap",
     "custom_tiles"
    ],
    "type": "string"
   },
   "style_id": {
    "default": "standard",
    "type": "string"
   },
   "tile_url_template": {
    "default": "https://tile.openstreetmap.org/{z}/{x}/{y}.png",
    "type": "string"
   },
   "zoom_level": {
    "default": 12,
    "maximum": 22,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_map_tile_overlay",
 "title": "Connect map tile overlay"
}
