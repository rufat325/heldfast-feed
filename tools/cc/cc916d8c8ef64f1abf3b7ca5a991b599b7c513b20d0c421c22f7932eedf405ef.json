{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Corbah's live catalog of cycling jerseys, bib shorts, skinsuits and accessories. All filters optional. Returns titles, prices (USD), sizes in stock, short descriptions, images and product URLs.",
 "inputSchema": {
  "properties": {
   "collection": {
    "description": "Collection handle (see list_collections)",
    "type": "string"
   },
   "include_unavailable": {
    "type": "boolean"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Maximum price in USD",
    "type": "number"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Free-text search, e.g. 'women bib shorts', 'camo', 'skinsuit'",
    "type": "string"
   },
   "size": {
    "description": "Only products available in this size, e.g. 'MD'",
    "type": "string"
   },
   "type": {
    "description": "Product type, e.g. 'Cycling Jersey', 'Bib Shorts', 'Skinsuit'",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_catalog",
 "title": "Browse Corbah's catalog"
}
