{
 "description": "Create a snapshot group that snapshots multiple volumes together. Set exactly one of `volumes` (explicit volume names) or `volumeSelector` (label query) \u2014 not both, not neither. Longhorn docs: https://longhorn.io/docs/1.13.0/snapshots-and-backups/csi-snapshot-support/csi-volume-group-snapshot/",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deadlineSeconds": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "labels": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "volumeSelector": {
    "properties": {
     "matchExpressions": {
      "items": {
       "properties": {
        "key": {
         "type": "string"
        },
        "operator": {
         "type": "string"
        },
        "values": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "key",
        "operator"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "matchLabels": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "volumes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "snapshotgroup_create",
 "title": "Create snapshot group"
}
