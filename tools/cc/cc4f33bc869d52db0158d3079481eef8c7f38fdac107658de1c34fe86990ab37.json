  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Rank Countries By Food Prices"
 },
 "description": "Rank countries by food price index (world average = 100) in a region or worldwide: the cheapest first, or with order=most_expensive the most expensive first. Use it when someone asks where food or groceries are cheapest or most expensive.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "How many countries to return.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Language the user writes in (en, ru, de, fr, es, pt, tr). Set it on every call: the answer and the interactive card are shown in this language and units; without it the card falls back to the app's interface language.",
    "enum": [
     "en",
     "ru",
     "de",
     "fr",
     "es",
     "pt",
     "tr"
    ],
    "type": "string"
   },
   "order": {
    "default": "cheapest",
    "description": "cheapest first (default) or most_expensive first.",
    "enum": [
     "cheapest",
     "most_expensive"
    ],
    "type": "string"
   },
   "region": {
    "default": "world",
    "description": "Only countries of this region. Default: world.",
    "enum": [
     "world",
     "europe",
     "asia",
     "africa",
     "north_america",
     "south_america",
     "oceania"
    ],
    "type": "string"
   }
  },
  "type": "object"
