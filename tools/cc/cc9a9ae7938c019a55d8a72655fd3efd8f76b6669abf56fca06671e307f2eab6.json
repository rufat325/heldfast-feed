{
 "description": "Search/filter elements within a global section (Header/Footer/block) without dumping the whole tree.\nFilter by type, id substring, custom_class, text, or has_bind / has_events / has_custom_class.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "custom_class": {
    "description": "Filter by custom class substring",
    "type": "string"
   },
   "global_section_id": {
    "description": "Global section ID",
    "type": "string"
   },
   "has_bind": {
    "description": "Only elements with data bindings",
    "type": "boolean"
   },
   "has_custom_class": {
    "description": "Only elements with a custom class",
    "type": "boolean"
   },
   "has_events": {
    "description": "Only elements with events",
    "type": "boolean"
   },
   "id": {
    "description": "Filter by element ID substring",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max results (default 50)",
    "type": "number"
   },
   "text": {
    "description": "Filter by text content substring",
    "type": "string"
   },
   "type": {
    "description": "Filter by element type (e.g. 'menu', 'menu-item', 'container', 'image', 'text')",
    "type": "string"
   }
  },
  "required": [
   "global_section_id"
  ],
  "type": "object"
 },
 "name": "search_global_section_elements"
}
