{
 "description": "Create charts (pie, bar, column, line) from spreadsheet data ranges. Charts anchor to specific cells with optional pixel offsets. Data range should include headers. PIE charts use 2 columns (labels, values). BAR/COLUMN/LINE charts use first row as headers. Best for visualizing spreadsheet data.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chartType": {
    "description": "Type of chart to create",
    "enum": [
     "PIE",
     "BAR",
     "COLUMN",
     "LINE"
    ],
    "type": "string"
   },
   "dataRange": {
    "description": "A1 notation range containing chart data including headers (e.g., \"A1:C10\")",
    "minLength": 1,
    "type": "string"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "is3D": {
    "default": false,
    "description": "Render as 3D chart (PIE only)",
    "type": "boolean"
   },
   "legend": {
    "default": "BOTTOM",
    "description": "Legend position",
    "enum": [
     "BOTTOM",
     "RIGHT",
     "TOP",
     "LEFT",
     "NONE"
    ],
    "type": "string"
   },
   "position": {
    "properties": {
     "anchorCell": {
      "description": "A1 notation cell where chart top-left anchors (e.g., \"F2\")",
      "minLength": 1,
      "type": "string"
     },
     "offsetX": {
      "default": 0,
      "description": "Horizontal pixel offset from anchor",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "offsetY": {
      "default": 0,
      "description": "Vertical pixel offset from anchor",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "anchorCell"
    ],
    "type": "object"
   },
   "title": {
    "description": "Chart title displayed at top",
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "chartType",
   "dataRange",
   "position"
  ],
  "type": "object"
 },
 "name": "chart-create",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "anchorCell": {
        "description": "Where chart was anchored",
        "type": "string"
       },
       "chartId": {
        "description": "Unique chart ID for future updates/deletion",
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Title of the sheet containing the chart",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the sheet containing the chart",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "sheetTitle",
       "sheetUrl",
       "chartId",
       "anchorCell"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
