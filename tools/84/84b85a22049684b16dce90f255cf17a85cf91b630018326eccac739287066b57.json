{"_meta":{"openai/toolInvocation/invoked":"Made the table","openai/toolInvocation/invoking":"Making the table"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Use this when the user pastes a chat with customer orders, a typed list or notes and wants a clean table. Pass text and optionally hint. For a chat it makes one row per item each customer ordered, with later changes applied and noted. Returns the table, sum checks, CSV text and 24-hour links. For a table that is already in clean columns, you do not need this tool.","inputSchema":{"additionalProperties":false,"examples":[{"text":"[09:12] Grace Okafor: Hi! For Friday please 10 meat pies and 6 bottles zobo\n[09:14] Shop: Noted Grace, thank you\n[09:20] Tunde B: 2 trays jollof rice, 1 tray fried plantain\n[09:31] Grace Okafor: Sorry make the zobo 8 bottles not 6\n[09:40] Amaka: 15 puff puff and 4 bottles zobo. Pickup 5pm\n[09:41] Shop: Meat pie 1500 each, zobo 1000 a bottle, jollof tray 12000, plantain tray 8000, puff puff 200 each"}],"properties":{"hint":{"description":"Optional: what the content is or which columns the person wants, for example 'stock count, item and quantity only'.","maxLength":300,"type":"string"},"text":{"description":"The text to copy: a pasted chat with orders, a typed list or notes.","maxLength":20000,"minLength":1,"type":"string"}},"required":["text"],"type":"object"},"name":"text_to_sheet","outputSchema":{"properties":{"checks":{"items":{"properties":{"check":{"enum":["line_amount","column_sum","total_math","row_total"],"type":"string"},"detail":{"type":"string"},"row":{"type":["integer","null"]},"status":{"enum":["ok","mismatch","unchecked"],"type":"string"}},"required":["check","status","row","detail"],"type":"object"},"type":"array"},"columns":{"items":{"properties":{"name":{"type":"string"},"role":{"enum":["label","quantity","unit_price","amount","row_total","part","date","time","person","other"],"type":"string"},"type":{"enum":["text","number","money","date","time"],"type":"string"}},"required":["name","type","role"],"type":"object"},"type":"array"},"csv":{"type":"string"},"currency":{"type":["string","null"]},"kind":{"enum":["receipt","notebook","shelf","chat","timesheet","expenses","orders","log","other",null],"type":["string","null"]},"links":{"properties":{"csv":{"type":"string"},"expires_at":{"type":"string"},"json":{"type":"string"},"page":{"type":"string"}},"required":["page","csv","json","expires_at"],"type":["object","null"]},"message":{"type":"string"},"notes":{"items":{"type":"string"},"type":"array"},"notice":{"type":"string"},"rows":{"items":{"items":{"type":["string","null"]},"type":"array"},"type":"array"},"source":{"enum":["photo","voice","text"],"type":"string"},"status":{"enum":["ok","no_table","unreadable","no_speech","capacity_reached","unavailable"],"type":"string"},"title":{"type":"string"},"totals":{"items":{"properties":{"label":{"type":"string"},"role":{"enum":["subtotal","tax","discount","tip","total","paid","change","other"],"type":"string"},"value":{"type":"string"}},"required":["label","role","value"],"type":"object"},"type":"array"},"transcript":{"properties":{"language":{"type":["string","null"]},"seconds":{"type":["number","null"]},"text":{"type":"string"}},"required":["text","language","seconds"],"type":["object","null"]},"unclear":{"items":{"properties":{"column":{"type":"string"},"reading":{"type":"string"},"row":{"type":"integer"}},"required":["row","column","reading"],"type":"object"},"type":"array"}},"required":["status","source","kind","title","currency","columns","rows","totals","unclear","notes","checks","transcript","csv","links","message","notice"],"type":"object"},"title":"Turn a chat or list into a table"}
