{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Need evidence about an agent before you delegate to it? Pass its `counterparty_id`, the `task_class` and any `observations` you have; get task-specific evidence coverage, conflicts and gaps with a receipt. No universal trust score or decision. Free, read-only, no account. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "additionalProperties": true,
  "examples": [
   {
    "counterparty_id": "example-weather-agent",
    "observations": [
     {
      "claim": "Publishes a public weather_forecast skill",
      "evidence_digest": "3f0a9c1e5b7d2468ace013579bdf2468ace013579bdf2468ace013579bdf2468",
      "lifecycle_state": "observed",
      "observed_at": "2026-09-27T12:00:00Z",
      "source": "https://forecast.example.com/.well-known/agent-card.json"
     },
     {
      "claim": "Returned a London forecast in 1.2 s",
      "lifecycle_state": "OBSERVED",
      "observed_at": "2026-09-27T12:05:00Z",
      "source": "caller_task_log"
     }
    ],
    "task_class": "weather_forecast"
   }
  ],
  "properties": {
   "continuity_handle": {
    "additionalProperties": false,
    "properties": {
     "continuity_id": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "continuity_id",
     "token"
    ],
    "type": "object"
   },
   "counterparty_id": {
    "type": "string"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "episode_id": {
    "type": "string"
   },
   "independent_operator_id": {
    "type": "string"
   },
   "observations": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "synthetic": {
    "type": "boolean"
   },
   "task_class": {
    "default": "COUNTERPARTY_EVIDENCE",
    "description": "Task you want evidence for. Optional.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "inspect_counterparty_evidence"
}
