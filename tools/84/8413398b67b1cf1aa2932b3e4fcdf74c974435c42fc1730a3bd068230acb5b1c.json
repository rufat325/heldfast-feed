{
 "description": "Search memories semantically. Finds memories by MEANING, not keywords. Use at the start of sessions to restore context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Filter by context category",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Max results to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to search for (natural language)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "recall"
}
