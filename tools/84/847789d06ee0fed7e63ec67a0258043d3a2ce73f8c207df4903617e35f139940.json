{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Update a site's cookie banner: layout (pill, bar, modal, corner), colours or preset, categories, services, Google Consent Mode v2, languages and wording. Only the fields you pass change. Pro sites can also switch geo-targeting and monthly rescans.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"design":{"additionalProperties":false,"description":"Banner fields to change; nested objects merge.","properties":{"autoLang":{"type":"boolean"},"categories":{"properties":{"analytics":{"type":"boolean"},"functional":{"type":"boolean"},"marketing":{"type":"boolean"}},"type":"object"},"closeX":{"description":"Show an X on the banner. Closing it rejects non-essential cookies (all Consent Mode signals denied), as Italy's Garante describes. On by default for new sites.","type":"boolean"},"defaultLang":{"enum":["en","de","fr","nl","es","it"],"type":"string"},"equal":{"description":"Give Accept and Reject equal visual weight.","type":"boolean"},"expiryDays":{"maximum":395,"minimum":1,"type":"integer"},"gcm":{"properties":{"enabled":{"type":"boolean"},"passthrough":{"type":"boolean"},"redact":{"type":"boolean"},"wait":{"maximum":5000,"minimum":0,"type":"number"}},"type":"object"},"languages":{"items":{"enum":["en","de","fr","nl","es","it"],"type":"string"},"minItems":1,"type":"array"},"layout":{"enum":["pill","bar","modal","corner"],"type":"string"},"overrides":{"additionalProperties":{"properties":{"accept":{"maxLength":40,"type":"string"},"body":{"maxLength":600,"type":"string"},"customize":{"maxLength":40,"type":"string"},"reject":{"maxLength":40,"type":"string"},"title":{"maxLength":120,"type":"string"}},"type":"object"},"propertyNames":{"enum":["en","de","fr","nl","es","it"],"type":"string"},"type":"object"},"policyUrl":{"maxLength":500,"type":"string"},"preset":{"description":"Apply a built