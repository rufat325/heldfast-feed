    "type": "string"
   },
   "date_to": {
    "type": "string"
   },
   "exact": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "description": "AND values. Fields: subject/spatial/author/language/country/newspaper/topic_id/min_prob/scored_by; country_raw=whole cell; polarity:<model>.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "field": {
    "description": "subject (default) | spatial | author | language",
    "type": "string"
   },
