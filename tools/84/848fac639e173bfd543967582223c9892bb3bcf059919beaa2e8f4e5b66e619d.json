   },
   "subject": {
    "description": "Exact tag",
    "type": "string"
   },
   "subset": {
    "description": "articles (default) | publications | references",
    "type": "string"
   },
   "top_n": {
    "description": "Values on each axis (default 15, max 30)",
    "type": "integer"
   }
  },
  "type": "object"
 },
