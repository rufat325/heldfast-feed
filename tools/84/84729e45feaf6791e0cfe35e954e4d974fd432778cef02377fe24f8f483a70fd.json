{
 "annotations": {},
 "description": "Create a NEW Cloud DB Serverless cluster from a backup (POST /mysql/v1/clusters/restore \u2192 202 Operation). source.type BACKUP needs originalClusterName + backupName (from ncloud_serverless_list_backups); IMPORTED_BACKUP needs backupName (imported backup name) + adminUserName + adminPassword. No point-in-time restore. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoScale": {
    "additionalProperties": false,
    "properties": {
     "scaleOut": {
      "additionalProperties": false,
      "properties": {
       "enabled": {
        "description": "Horizontal scaling of replicas (default false)",
        "type": "boolean"
       },
       "replica": {
        "additionalProperties": false,
        "description": "Replica count range",
        "properties": {
         "max": {
          "type": "integer"
         },
         "min": {
          "type": "integer"
         }
        },
        "type": "object"
       },
       "thresholdConnection": {
        "description": "Scale-out trigger by connections (500-30,000; mutually exclusive with thresholdCpu)",
        "maximum": 30000,
        "minimum": 500,
        "type": "integer"
       },
       "thresholdCpu": {
        "description": "Scale-out trigger by CPU % (30-99; mutually exclusive with thresholdConnection)",
        "maximum": 99,
        "minimum": 30,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "scaleUp": {
      "additionalProperties": false,
      "properties": {
       "enabled": {
        "description": "Vertical scaling between unit.min and unit.max (default false = pinned to unit.max)",
        "type": "boolean"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "backupConfig": {
    "additionalProperties": false,
    "properties": {
     "backupAuto": {
      "description": "true (default) = service-chosen time (backupTime ignored); false = use backupTime",
      "type": "boolean"
     },
     "backupTime": {
      "description": "Backup time HH:MM in UTC (required when backupAuto=false)",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
      "type": "string"
     },
     "retentionDays": {
      "description": "Retention days (1-30)",
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "retentionDays"
    ],
    "type": "object"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without restoring",
    "type": "boolean"
   },
   "highAvailability": {
    "type": "boolean"
   },
   "multiZone": {
    "type": "boolean"
   },
   "name": {
    "description": "Name of the cluster to create",
    "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
    "type": "string"
   },
   "network": {
    "additionalProperties": false,
    "properties": {
     "port": {
      "description": "DB port (e.g. 3306)",
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
     },
     "subnetNo": {
      "description": "Subnet number",
      "type": "integer"
     },
     "vpcNo": {
      "description": "VPC number",
      "type": "integer"
     }
    },
    "required": [
     "vpcNo",
     "subnetNo",
     "port"
    ],
    "type": "object"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "adminPassword": {
      "description": "8-20 chars with a letter, a digit and a special character; ` & + \\ \" ' / and spaces are not allowed. Never returned by the API",
      "maxLength": 20,
      "minLength": 8,
      "type": "string"
     },
     "adminUserName": {
      "description": "Admin user (required for IMPORTED_BACKUP)",
      "pattern": "^[A-Za-z][A-Za-z0-9_-]{2,14}[A-Za-z0-9]$",
      "type": "string"
     },
     "backupName": {
      "description": "Cluster backup name (BACKUP) or imported backup name (IMPORTED_BACKUP)",
      "pattern": "^[a-z0-9-]{3,45}$",
      "type": "string"
     },
     "originalClusterName": {
      "description": "Source cluster (required for BACKUP)",
      "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
      "type": "string"
     },
     "storageType": {
      "const": "CB2",
      "type": "string"
     },
     "type": {
      "enum": [
       "BACKUP",
       "IMPORTED_BACKUP"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "backupName"
    ],
    "type": "object"
   },
   "unit": {
    "additionalProperties": false,
    "properties": {
     "max": {
      "description": "Maximum unit (\u22651, multiple of 0.5, \u2265 min). Without autoScale.scaleUp the cluster is pinned to max",
      "minimum": 1,
      "type": "number"
     },
     "min": {
      "description": "Minimum unit (\u22651, multiple of 0.5)",
      "minimum": 1,
      "type": "number"
     }
    },
    "required": [
     "min",
     "max"
    ],
    "type": "object"
   }
  },
  "required": [
   "name",
   "source",
   "network",
   "multiZone",
   "unit",
   "backupConfig",
   "highAvailability"
  ],
  "type": "object"
 },
 "name": "ncloud_serverless_restore_cluster"
}
