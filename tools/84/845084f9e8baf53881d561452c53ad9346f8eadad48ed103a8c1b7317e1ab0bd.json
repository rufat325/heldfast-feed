{
 "description": "Register for an API key. Provide your email to get a key immediately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "email": {
    "description": "Your email address.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "label": {
    "description": "An optional label to identify this API key.",
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
 "name": "register"
}
