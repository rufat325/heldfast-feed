{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lookup error code, reason, or HTTP status in the official error reference catalog. Returns meaning, billing implications (whether the call was billed), retryability, retry delay, recommended agent action, and documentation URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "Error code (e.g. -32600, -32005, -32020, or console code string like 'siwe_invalid').",
    "type": [
     "number",
     "string"
    ]
   },
   "http_status": {
    "description": "HTTP status code (e.g. 200, 400, 402, 404, 429, 500, 503).",
    "type": "number"
   },
   "lang": {
    "description": "Language for explanations: 'en' for English or 'zh' for Chinese. Defaults to 'en'.",
    "enum": [
     "en",
     "zh"
    ],
    "type": "string"
   },
   "reason": {
    "description": "Error reason slug (e.g. 'invalid_request', 'key_rate_limit', 'insufficient_balance', 'not_found').",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "explain_error",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "number"
   },
   "errors": {
    "items": {
     "properties": {
      "action": {
       "type": "string"
      },
      "billed": {
       "type": [
        "boolean",
        "string"
       ]
      },
      "category": {
       "type": "string"
      },
      "code": {
       "type": [
        "number",
        "string"
       ]
      },
      "docs_url": {
       "type": "string"
      },
      "http": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "reason": {
       "type": [
        "string",
        "null"
       ]
      },
      "retry_after": {
       "type": [
        "string",
        "null"
       ]
      },
      "retryable": {
       "type": "boolean"
      }
     },
     "required": [
      "code",
      "http",
      "message",
      "billed",
      "retryable",
      "action",
      "docs_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matched": {
    "type": "boolean"
   }
  },
  "required": [
   "matched",
   "errors"
  ],
  "type": "object"
 },
 "title": "Explain Error Code or Reason"
}
