{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"The stations that carry a variable: id, name, position, sampling height,\n    country, ecosystem -- near a point (sorted by distance), in a box, by name\n    or by country.  The ids are what estimate and get_data take as station=.","inputSchema":{"properties":{"country":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"two-letter code, e.g. SE","title":"Country"},"id":{"description":"a station-based variable id from search_variables","title":"Id","type":"string"},"lat_max":{"anyOf":[{"maximum":90,"minimum":-90,"type":"number"},{"type":"null"}],"default":null,"description":"northern edge of a bounding box, degrees north","title":"Lat Max"},"lat_min":{"anyOf":[{"maximum":90,"minimum":-90,"type":"number"},{"type":"null"}],"default":null,"description":"southern edge of a bounding box, degrees north","title":"Lat Min"},"limit":{"default":50,"description":"the most stations to return","maximum":200,"minimum":1,"title":"Limit","type":"integer"},"lon_max":{"anyOf":[{"maximum":180,"minimum":-180,"type":"number"},{"type":"null"}],"default":null,"description":"eastern edge of a bounding box, degrees east","title":"Lon Max"},"lon_min":{"anyOf":[{"maximum":180,"minimum":-180,"type":"number"},{"type":"null"}],"default":null,"description":"western edge of a bounding box, degrees east","title":"Lon Min"},"near_lat":{"anyOf":[{"maximum":90,"minimum":-90,"type":"number"},{"type":"null"}],"default":null,"description":"search around this point, with near_lon and radius_km","title":"Near Lat"},"near_lon":{"anyOf":[{"maximum":180,"minimum":-180,"type":"number"},{"type":"null"}],"default":null,"description":"longitude of the point near_lat names","title":"Near Lon"},"radius_km":{"default":300,"description":"search radius around near_lat/near_lon, km","exclusiveMinimum":0,"maximum":20000,"title":"Radius Km","type":"number"},"text":{"anyOf":[{"type"