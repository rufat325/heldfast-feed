{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check that a quote of 5 to 500 characters appears on the stated page in extracted native text. This does not establish truth or visual reading order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "page": {
    "description": "1-based page containing the quote.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "quote": {
    "description": "Quote to verify in native PDF text.",
    "maxLength": 500,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "document_id",
   "capability",
   "page",
   "quote"
  ],
  "type": "object"
 },
 "name": "verify_document_citation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Citation verification result with exact page and text evidence.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "evidence": {
    "items": {},
    "type": "array"
   },
   "extensions": {},
   "method": {
    "type": "string"
   },
   "page": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pageLabel": {
    "type": "string"
   },
   "pageTextOffset": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "quote": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "resource": {},
   "verified": {
    "type": "boolean"
   },
   "warning": {
    "type": "string"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Verify PDF text citation"
}
