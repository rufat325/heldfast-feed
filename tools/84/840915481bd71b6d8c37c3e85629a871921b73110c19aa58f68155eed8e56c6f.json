{
 "description": "Search and list companies in amoCRM. Use 'with' to embed linked leads and contacts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Items per page (max 250, default 50)",
    "maximum": 250,
    "type": "number"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "query": {
    "description": "Search query across company name",
    "type": "string"
   },
   "with": {
    "description": "Related entities to embed",
    "items": {
     "enum": [
      "leads",
      "contacts",
      "catalog_elements"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_companies"
}
