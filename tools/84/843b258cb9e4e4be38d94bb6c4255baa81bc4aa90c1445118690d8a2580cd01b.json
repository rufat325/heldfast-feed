{
 "description": "Plan and run multiple model-swarm hypotheses, then compare outcomes for product-spec decision work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hypotheses": {
    "description": "Hypotheses to run.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "maxAgents": {
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "research": {
    "description": "Optional ResearchStore JSON string.",
    "type": "string"
   },
   "rounds": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "hypotheses"
  ],
  "type": "object"
 },
 "name": "simulation_run_matrix"
}
