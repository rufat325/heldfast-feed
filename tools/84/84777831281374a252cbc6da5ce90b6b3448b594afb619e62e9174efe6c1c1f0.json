{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "FREE, no key. Compare supplied feed identity, price, currency and availability with selected JSON-LD product evidence; preserve conflicts and unknown fields. Optional availabilityProfile google_merchant applies Google feed mappings; generic is the default. Entire JSON input: 16384 UTF-8 bytes. Supplied data only; no fetch, payment or automatic paid fallback.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "feed": {
     "availability": "in_stock",
     "currency": "USD",
     "price": "9.49",
     "sku": "COFFEE-500"
    },
    "html": "<link rel=\"canonical\" href=\"https://example.com/coffee\"><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebPage\",\"@id\":\"https://example.com/coffee\",\"mainEntity\":{\"@id\":\"#coffee\"}},{\"@type\":\"Product\",\"@id\":\"#coffee\",\"name\":\"Coffee beans\",\"sku\":\"COFFEE-500\",\"offers\":{\"@type\":\"Offer\",\"price\":\"8.99\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\"}},{\"@type\":\"Product\",\"name\":\"Related mug\",\"sku\":\"MUG-1\",\"offers\":{\"@type\":\"Offer\",\"price\":\"12.00\",\"priceCurrency\":\"USD\"}}]}</script>",
    "pageUrl": "https://example.com/coffee"
   }
  ],
  "properties": {
   "availabilityProfile": {
    "description": "Default generic preserves existing vocabulary distinctions. google_merchant maps non-vehicle Schema.org availability to Google feed categories; not an eligibility check.",
    "enum": [
     "generic",
     "google_merchant"
    ],
    "type": "string"
   },
   "feed": {
    "additionalProperties": false,
    "properties": {
     "availability": {
      "maxLength": 100,
      "type": "string"
     },
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "gtin": {
      "pattern": "^\\d{8,14}$",
      "type": "string"
     },
     "mpn": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     "price": {
      "maxLength": 30,
      "type": "string"
     },
     "sku": {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "html": {
    "maxLength": 16384,
    "type": "string"
   },
   "offerUrl": {
    "maxLength": 2048,
    "type": "string"
   },
   "pageUrl": {
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "html",
   "feed"
  ],
  "type": "object"
 },
 "name": "agent_utilities_feed_page_compare_preview",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "chargedMicroUsd": {
    "const": "0"
   },
   "executionPerformed": {
    "const": true
   },
   "limits": {
    "additionalProperties": false,
    "properties": {
     "maxInputBytes": {
      "const": 16384,
      "type": "integer"
     }
    },
    "required": [
     "maxInputBytes"
    ],
    "type": "object"
   },
   "mode": {
    "const": "free-preview"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "availabilityProfile": {
      "enum": [
       "generic",
       "google_merchant"
      ],
      "type": "string"
     },
     "checks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "feedValue": {
         "type": [
          "string",
          "null"
         ]
        },
        "field": {
         "type": "string"
        },
        "pageValues": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "reason": {
         "type": "string"
        },
        "status": {
         "enum": [
          "match",
          "mismatch",
          "ambiguous",
          "unknown",
          "not_supplied"
         ],
         "type": "string"
        }
       },
       "required": [
        "field",
        "feedValue",
        "pageValues",
        "status",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "evidence": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "offerSources": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "offerBlock": {
             "type": "number"
            },
            "offerPointer": {
             "type": "string"
            },
            "productBlock": {
             "type": "number"
            },
            "productPointer": {
             "type": "string"
            }
           },
           "required": [
            "productBlock",
            "productPointer",
            "offerBlock",
            "offerPointer"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "originalAvailability": {
          "items": {
           "type": [
            "string",
            "null"
           ]
          },
          "type": "array"
         },
         "productSources": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "block": {
             "type": "number"
            },
            "pointer": {
             "type": "string"
            }
           },
           "required": [
            "block",
            "pointer"
           ],
           "type": "object"
          },
          "type": "array"
         }
        },
        "required": [
         "productSources",
         "offerSources",
         "originalAvailability"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "identityStatus": {
      "enum": [
       "match",
       "mismatch",
       "unknown"
      ],
      "type": "string"
     },
     "scope": {
      "type": "string"
     },
     "selection": {
      "additionalProperties": false,
      "properties": {
       "reason": {
        "type": "string"
       },
       "selectedId": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "enum": [
         "selected",
         "ambiguous",
         "no_product"
        ],
        "type": "string"
       }
      },
      "required": [
       "status",
       "reason",
       "selectedId"
      ],
      "type": "object"
     },
     "status": {
      "enum": [
       "match",
       "mismatch",
       "identity_mismatch",
       "inconclusive"
      ],
      "type": "string"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "status",
     "identityStatus",
     "availabilityProfile",
     "selection",
     "checks",
     "evidence",
     "warnings",
     "scope"
    ],
    "type": "object"
   }
  },
  "required": [
   "mode",
   "chargedMicroUsd",
   "executionPerformed",
   "result",
   "limits"
  ],
  "type": "object"
 }
}
