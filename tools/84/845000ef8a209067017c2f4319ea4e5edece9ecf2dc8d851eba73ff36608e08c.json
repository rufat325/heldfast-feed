{
 "description": "Rewrite a draft (usually AI-generated) so it reads in the user's own voice, using their stored style profile. The headline tool: call this whenever the user wants text to 'sound like me' or 'less AI'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contextLabel": {
    "enum": [
     "casual",
     "professional",
     "annoyed",
     "polite",
     "direct",
     "sales",
     "email",
     "text",
     "linkedin"
    ],
    "type": "string"
   },
   "directives": {
    "items": {
     "enum": [
      "more_like_me",
      "more_professional",
      "less_aggressive",
      "shorter",
      "warmer",
      "more_direct"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "draft": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "enum": [
     "anthropic",
     "openai",
     "gemini",
     "ollama"
    ],
    "type": "string"
   }
  },
  "required": [
   "draft"
  ],
  "type": "object"
 },
 "name": "humanify_text"
}
