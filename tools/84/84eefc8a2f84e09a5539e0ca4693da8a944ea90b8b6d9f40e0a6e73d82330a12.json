{
 "description": "Search public tenders on simap.ch with filters by date, canton, CPV codes, and other criteria",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bkpCodes": {
    "description": "BKP codes for construction (e.g., 211 for masonry)",
    "items": {
     "pattern": "^[0-9]{1,3}(\\.[0-9])?$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "cantons": {
    "description": "Swiss cantons (e.g., BE, VD, GE, ZH)",
    "items": {
     "enum": [
      "AG",
      "AI",
      "AR",
      "BE",
      "BL",
      "BS",
      "FR",
      "GE",
      "GL",
      "GR",
      "JU",
      "LU",
      "NE",
      "NW",
      "OW",
      "SG",
      "SH",
      "SO",
      "SZ",
      "TG",
      "TI",
      "UR",
      "VD",
      "VS",
      "ZG",
      "ZH"
     ],
     "type": "string"
    },
    "maxItems": 26,
    "type": "array"
   },
   "cpvCodes": {
    "description": "CPV codes (8 digits, e.g., 72000000 for IT services)",
    "items": {
     "pattern": "^[0-9]{8}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "issuedByOrganizations": {
    "description": "UUIDs of issuing organizations",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "lang": {
    "default": "en",
    "description": "Preferred language for results",
    "enum": [
     "de",
     "fr",
     "it",
     "en"
    ],
    "type": "string"
   },
   "lastItem": {
    "description": "Pagination token (format: date|projectNumber) to retrieve the next page",
    "pattern": "^\\d{8}\\|.+$",
    "type": "string"
   },
   "processTypes": {
    "description": "Process types (open, selective, invitation, direct, no_process)",
    "items": {
     "enum": [
      "open",
      "selective",
      "invitation",
      "direct",
      "no_process"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "projectSubTypes": {
    "description": "Project types to filter",
    "items": {
     "enum": [
      "construction",
      "service",
      "supply",
      "project_competition",
      "idea_competition",
      "overall_performance_competition",
      "project_study",
      "idea_study",
      "overall_performance_study",
      "request_for_information"
     ],
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "pubTypes": {
    "description": "Publication types (tender, award_tender, correction, etc.)",
    "items": {
     "enum": [
      "advance_notice",
      "request_for_information",
      "tender",
      "competition",
      "study_contract",
      "award_tender",
      "award_study_contract",
      "award_competition",
      "direct_award",
      "participant_selection",
      "selective_offering_phase",
      "correction",
      "revocation",
      "abandonment"
     ],
     "type": "string"
    },
    "maxItems": 14,
    "type": "array"
   },
   "publicationFrom": {
    "description": "Publication start date (format YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "publicationUntil": {
    "description": "Publication end date (format YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "search": {
    "description": "Search text (min 3 characters)",
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_tenders"
}
