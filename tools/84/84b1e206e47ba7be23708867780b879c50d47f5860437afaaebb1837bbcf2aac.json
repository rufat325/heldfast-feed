    "default": 0,
    "type": "integer"
   },
   "radius": {
    "default": 1024,
    "type": "integer"
   },
   "x": {
    "type": "integer"
   },
   "z": {
    "type": "integer"
   }
  },
  "required": [
   "x",
   "z"
  ],
  "type": "object"
 },
 "name": "find_nocom_clusters",
