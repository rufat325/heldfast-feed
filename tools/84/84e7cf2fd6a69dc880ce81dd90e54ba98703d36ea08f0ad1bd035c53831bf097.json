          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "block_hash": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "block_number": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "decode_status": {
        "enum": [
         "pending",
         "complete",
         "unavailable"
        ],
        "type": "string"
       },
       "economic_activity_tao": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "economic_activity_usd": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "event_count": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "extrinsic_count": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "fee_tao": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "issuance_tao": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "native_transfer_tao": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "observed_at": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "parent_hash": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "spec_version": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "stake_flow_tao": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "subnet_ids": {
        "items": {
         "minimum": 0,
         "type": "integer"
        },
        "type": "array"
       },
       "tao_usd_basis": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "tao_usd_block": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "tao_usd_observed_at": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "tao_usd_unavailable": {
        "enum": [
         "no_index_reading",
         "index_unpriced",
         "index_stale",
         "no_alpha_price"
        ],
        "type": "string"
       },
       "tip_tao": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "usd_per_tao": {
        "anyOf": [
         {
          "exclusiveMinimum": 0,
          "type": "number"
         },
         {
          "type": "null"
