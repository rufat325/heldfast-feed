    ]
   },
   "degraded": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "An event-derived result could not be measured because its source is unavailable, its stream was never emitted, or its derivation could not answer this request. Absent on measured answers, including successfully read quiet windows.",
      "properties": {
       "detail": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Present ONLY on a decline. A null `block` WITHOUT this is a CONFIRMED ABSENCE -- the store was read and holds no such block, which is a measurement. With it, the read failed and nothing is known about whether the block exists."
   },
   "next_block_number": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Nearest STORED higher block height for chain-walk nav (detail only); null at the head of the retained window or when the ref didn't resolve."
   },
   "prev_block_number": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Nearest STORED lower block height for chain-walk nav (detail only); null at the start of the retained window or when the ref didn't resolve."
   },
   "ref": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "schema_version": {
    "type": "integer"
   }
  },
  "required": [
   "schema_version",
   "ref",
   "block",
   "prev_block_number",
   "next_block_number"
  ],
  "type": "object"
 },
 "title": "Get a block by number or hash"
}
