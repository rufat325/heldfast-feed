      },
      "required": [
       "block_number",
       "block_hash",
       "parent_hash",
       "author",
       "extrinsic_count",
       "event_count",
       "spec_version",
       "observed_at",
       "decode_status",
       "native_transfer_tao",
       "stake_flow_tao",
       "economic_activity_tao",
       "fee_tao",
       "tip_tao",
       "issuance_tao",
       "subnet_ids",
       "economic_activity_usd",
       "usd_per_tao",
       "tao_usd_block",
       "tao_usd_observed_at",
       "tao_usd_basis"
