{
 "_meta": {
  "ui": {
   "visibility": [
    "app"
   ]
  }
 },
 "description": "Compact newest-first change timeline for one schema object, sized for the visualizer detail panel. App-facing companion to get_object_history.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endpoint": {
    "enum": [
     "v1.0",
     "beta"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "node_id": {
    "description": "Entity type name (case-insensitive)",
    "type": "string"
   },
   "since": {
    "description": "ISO date or day count (e.g. \"90\")",
    "type": "string"
   }
  },
  "required": [
   "node_id"
  ],
  "type": "object"
 },
 "name": "get_node_timeline"
}
