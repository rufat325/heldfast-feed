{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find a court by name or location when the user asks for court identity, metadata, or a judge roster and its KnowJudges identity is unknown. For a named judge's courtroom presentation or practice rules, use get_courtroom_presentation_rules. Optionally narrow by jurisdiction or state. Returns at most 10 courts with names, state/jurisdiction, and canonical public URLs. No pagination or bulk listing is available. Use the returned court_url with get_court.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "jurisdiction": {
    "description": "Two-letter jurisdiction code, for example GA, DC, or US for national federal courts",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Court name or location search text",
    "minLength": 2,
    "type": "string"
   },
   "state": {
    "description": "State name or postal abbreviation",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_court",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "jurisdiction": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "jurisdiction",
     "state"
    ],
    "type": "object"
   },
   "limit": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "court_url": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "state": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "court_url"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   }
  },
  "required": [
   "query",
   "filters",
   "limit",
   "results"
  ],
  "type": "object"
 }
}
