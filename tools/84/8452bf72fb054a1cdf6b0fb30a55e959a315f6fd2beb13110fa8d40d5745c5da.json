{
 "description": "Add a player (human or AI) to the session",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "aiPersona": {
    "additionalProperties": false,
    "description": "AI persona configuration (for AI players)",
    "properties": {
     "personalityNotes": {
      "description": "Additional personality notes for the AI",
      "type": "string"
     },
     "playstyle": {
      "description": "AI playstyle",
      "enum": [
       "tactical",
       "roleplay",
       "cautious",
       "reckless"
      ],
      "type": "string"
     },
     "talkativeness": {
      "default": 5,
      "description": "How much the AI talks in-character (0-10)",
      "maximum": 10,
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "playstyle"
    ],
    "type": "object"
   },
   "characterId": {
    "description": "Character ID to link (optional)",
    "type": "string"
   },
   "controlType": {
    "description": "Human or AI controlled",
    "enum": [
     "human",
     "ai"
    ],
    "type": "string"
   },
   "id": {
    "description": "Unique player ID",
    "type": "string"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "role": {
    "description": "Player role (gm, pc, or spectator)",
    "enum": [
     "gm",
     "pc",
     "spectator"
    ],
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "id",
   "name",
   "role",
   "controlType"
  ],
  "type": "object"
 },
 "name": "create_player"
}
