{
 "description": "List, read, create, delete, duplicate or reorder the pages of a website. To edit a page's CONTENT use update_page_blocks. create: pass starter=\"terms\" or \"privacy\" for a ready-to-edit legal page (title/slug auto-set).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list",
     "get",
     "create",
     "delete",
     "duplicate",
     "reorder"
    ],
    "type": "string"
   },
   "isHome": {
    "description": "create: set as the home page",
    "type": "boolean"
   },
   "limit": {
    "description": "list: max pages",
    "type": "number"
   },
   "offset": {
    "description": "list: pagination offset",
    "type": "number"
   },
   "pageId": {
    "description": "Page ID \u2014 required for get/delete/duplicate",
    "type": "string"
   },
   "pageIds": {
    "description": "reorder: page IDs in desired navigation order",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "slug": {
    "description": "create/duplicate: URL slug (e.g. \"/about\")",
    "type": "string"
   },
   "starter": {
    "description": "create: pre-fill a legal page template",
    "enum": [
     "terms",
     "privacy"
    ],
    "type": "string"
   },
   "title": {
    "description": "create/duplicate: page title (e.g. \"About Us\")",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_pages"
}
