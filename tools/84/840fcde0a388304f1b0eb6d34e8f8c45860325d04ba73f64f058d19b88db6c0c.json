{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "publishers/links, licence conditions/dates and pause reasons. Not dataset rows.",
 "inputSchema": {
  "$defs": {
   "Code": {
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$",
    "type": "string"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "dataset_id": {
    "$ref": "#/$defs/Code"
   },
   "license_status": {
    "enum": [
     "confirmed",
     "restricted",
     "unconfirmed",
     "paused"
    ]
   },
   "page_size": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "source_id": {
    "$ref": "#/$defs/Code"
   },
   "status": {
    "enum": [
     "ok",
     "paused",
     "unreadable",
     "not_published"
    ]
   }
  },
  "type": "object"
 },
 "name": "data_sources",
 "outputSchema": {
  "$defs": {
   "Links": {
    "additionalProperties": false,
    "properties": {
     "docs": {
      "type": "string"
     },
     "next": {
      "type": [
       "string",
       "null"
      ]
     },
     "open_in_browser": {
      "type": [
       "string",
       "null"
      ]
     },
     "self": {
      "type": "string"
     }
    },
    "required": [
     "self",
     "next",
     "open_in_browser",
     "docs"
    ],
    "type": "object"
   },
   "ResponseMeta": {
    "additionalProperties": true,
    "required": [
     "api_version",
     "content_language",
     "generated_at",
     "currency",
     "attribution",
     "disclaimer",
     "dataset",
     "page"
    ],
    "type": "object"
   },
   "Source": {
    "additionalProperties": true,
    "required": [
     "source_id",
     "name",
     "publisher",
     "url",
     "terms_url",
     "license",
     "attribution",
     "status",
     "paused_since",
     "notice",
     "dataset_ids"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/Source"
      },
      "type": "array"
     },
     "links": {
      "$ref": "#/$defs/Links"
     },
     "meta": {
      "$ref": "#/$defs/ResponseMeta"
     }
    },
    "required": [
     "meta",
     "data",
     "links"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "$ref": "#/$defs/Source"
     },
     "links": {
      "$ref": "#/$defs/Links"
     },
     "meta": {
      "$ref": "#/$defs/ResponseMeta"
     }
    },
    "required": [
     "meta",
     "data",
     "links"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "retry_after_s": {
        "type": [
         "integer",
         "null"
        ]
       },
       "retryable": {
        "type": "boolean"
       }
      },
      "required": [
       "code",
       "message",
       "retryable",
       "retry_after_s"
      ],
      "type": "object"
     },
     "request_id": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "error",
     "request_id"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
