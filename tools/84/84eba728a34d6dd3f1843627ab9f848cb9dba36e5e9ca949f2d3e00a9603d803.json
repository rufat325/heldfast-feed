{
 "description": "Check DNS propagation for a domain across 18+ global DNS servers (Cloudflare, Google, Quad9, OpenDNS, regional servers, and authoritative nameservers). Shows if DNS changes have propagated worldwide.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Domain name to check propagation for (e.g. example.com)",
    "type": "string"
   },
   "recordType": {
    "description": "DNS record type to check (e.g. A, AAAA, MX, NS, TXT, CNAME)",
    "enum": [
     "A",
     "AAAA",
     "AFSDB",
     "APL",
     "AXFR",
     "CAA",
     "CDNSKEY",
     "CDS",
     "CERT",
     "CNAME",
     "CSYNC",
     "DHCID",
     "DLV",
     "DNAME",
     "DNSKEY",
     "DS",
     "EUI48",
     "EUI64",
     "HINFO",
     "HIP",
     "HTTPS",
     "IPSECKEY",
     "IXFR",
     "KEY",
     "KX",
     "LOC",
     "MX",
     "NAPTR",
     "NS",
     "NSEC",
     "NSEC3",
     "NSEC3PARAM",
     "NXT",
     "OPENPGPKEY",
     "OPT",
     "PTR",
     "RP",
     "RRSIG",
     "SIG",
     "SMIMEA",
     "SOA",
     "SPF",
     "SRV",
     "SSHFP",
     "SVCB",
     "TA",
     "TKEY",
     "TLSA",
     "TSIG",
     "TXT",
     "URI",
     "ZONEMD"
    ],
    "type": "string"
   }
  },
  "required": [
   "domain",
   "recordType"
  ],
  "type": "object"
 },
 "name": "dns_propagation"
}
