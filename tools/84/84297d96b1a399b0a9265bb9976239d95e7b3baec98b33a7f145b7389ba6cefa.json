{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One integration by slug: what Tabflows does with that tool, its features and its page.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "slug": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_integration",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "additionalProperties": false,
    "properties": {
     "contextRead": {
      "additionalProperties": false,
      "properties": {
       "evidence": {
        "type": "string"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "evidence"
      ],
      "type": "object"
     },
     "executeWrites": {
      "additionalProperties": false,
      "properties": {
       "evidence": {
        "type": "string"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "evidence"
      ],
      "type": "object"
     },
     "preparedActions": {
      "additionalProperties": false,
      "properties": {
       "evidence": {
        "type": "string"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "evidence"
      ],
      "type": "object"
     }
    },
    "required": [
     "contextRead",
     "preparedActions",
     "executeWrites"
    ],
    "type": "object"
   },
   "category": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "features": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "longDescription": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "category",
   "description",
   "longDescription",
   "features",
   "capabilities",
   "url"
  ],
  "type": "object"
 },
 "title": "Get a Tabflows integration"
}
