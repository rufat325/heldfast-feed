{
 "description": "G\u00f6revleri, projeleri ve ili\u015fkili verileri JSON veya CSV format\u0131nda dosyaya d\u0131\u015fa aktar\u0131r. Yedekleme ve veri payla\u015f\u0131m\u0131 i\u00e7in kullan\u0131l\u0131r.",
 "inputSchema": {
  "properties": {
   "date_range": {
    "description": "Tarih aral\u0131\u011f\u0131 filtresi",
    "properties": {
     "from": {
      "description": "Ba\u015flang\u0131\u00e7 tarihi (ISO 8601 format\u0131nda)",
      "format": "date-time",
      "type": "string"
     },
     "to": {
      "description": "Biti\u015f tarihi (ISO 8601 format\u0131nda)",
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object"
   },
   "format": {
    "default": "json",
    "description": "D\u0131\u015fa aktarma format\u0131 (json veya csv)",
    "enum": [
     "json",
     "csv"
    ],
    "type": "string"
   },
   "include_ai_context": {
    "default": false,
    "description": "AI context verilerini dahil et (varsay\u0131lan: false)",
    "type": "boolean"
   },
   "include_completed": {
    "default": true,
    "description": "Tamamlanm\u0131\u015f g\u00f6revleri dahil et (varsay\u0131lan: true)",
    "type": "boolean"
   },
   "include_dependencies": {
    "default": true,
    "description": "G\u00f6rev ba\u011f\u0131ml\u0131l\u0131klar\u0131n\u0131 dahil et (varsay\u0131lan: true)",
    "type": "boolean"
   },
   "include_templates": {
    "default": false,
    "description": "Template'leri dahil et (varsay\u0131lan: false)",
    "type": "boolean"
   },
   "output_path": {
    "description": "D\u0131\u015fa aktar\u0131lan dosyan\u0131n kaydedilece\u011fi yol",
    "type": "string"
   },
   "project_filter": {
    "description": "Sadece belirtilen projeleri d\u0131\u015fa aktar",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "output_path"
  ],
  "type": "object"
 },
 "name": "gorev_export"
}
