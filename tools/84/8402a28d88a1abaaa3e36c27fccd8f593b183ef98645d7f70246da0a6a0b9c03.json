{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "D\u00e9marre une VM KVM et attend optionnellement que SSH soit accessible",
 "inputSchema": {
  "properties": {
   "timeout": {
    "default": 300,
    "maximum": 600,
    "minimum": 10,
    "type": "number"
   },
   "vm_name": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   },
   "wait_ip": {
    "default": false,
    "type": "boolean"
   },
   "wait_ssh": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "vm_name"
  ],
  "type": "object"
 },
 "name": "vm_start"
}
