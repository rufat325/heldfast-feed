{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List SENS mail send requests in a period (GET /mail/v2/services/{serviceId}/requests). fromDateTime and toDateTime are required (ISO 8601 with offset).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dispatchType": {
    "description": "How the request was made",
    "enum": [
     "CONSOLE",
     "API"
    ],
    "type": "string"
   },
   "fromDateTime": {
    "description": "Period start, ISO 8601 with offset (e.g. 2026-09-01T00:00:00+09:00)",
    "type": "string"
   },
   "mailId": {
    "description": "Mail ID",
    "type": "string"
   },
   "pageNo": {
    "description": "Page number (0-based, default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Items per page (1-1000, default 10)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "recipientAddress": {
    "description": "Recipient address",
    "type": "string"
   },
   "requestId": {
    "description": "Exact request ID",
    "type": "string"
   },
   "senderAddress": {
    "description": "Sender address",
    "type": "string"
   },
   "serviceId": {
    "description": "Mail service ID in NRN form (e.g. ncp:mail:kr:1********2:main). Defaults to NCLOUD_SENS_MAIL_SERVICE_ID / NCLOUD_SENS_SERVICE_ID. Find it with ncloud_sens_list_projects (mailService.serviceId). A 'Forbidden' reply means that project's Mail channel is not enabled (useMail=false) \u2014 pick a project with useMail=true.",
    "type": "string"
   },
   "sort": {
    "description": "Sort as '{field},{direction}' (default 'createDateTime,desc')",
    "type": "string"
   },
   "status": {
    "description": "Request status",
    "enum": [
     "PREPARING",
     "READY",
     "RESERVED",
     "SENDING",
     "COMPLETED",
     "FAILED",
     "PARTIAL_FAILED",
     "CANCELED"
    ],
    "type": "string"
   },
   "templateNo": {
    "description": "Template number",
    "type": "integer"
   },
   "title": {
    "description": "Subject (partial match)",
    "type": "string"
   },
   "toDateTime": {
    "description": "Period end, ISO 8601 with offset",
    "type": "string"
   }
  },
  "required": [
   "fromDateTime",
   "toDateTime"
  ],
  "type": "object"
 },
 "name": "ncloud_sens_list_mail_requests"
}
