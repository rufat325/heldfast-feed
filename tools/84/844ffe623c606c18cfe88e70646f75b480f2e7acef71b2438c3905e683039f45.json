{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get the current user profile",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Current profile plus the re-verify nudge flag set when the default resume changed.",
  "properties": {
   "prefsVerifyPending": {
    "type": "boolean"
   },
   "profile": {
    "additionalProperties": false,
    "description": "Full user_profiles row (client-safe preferences) as returned by GET /profile.",
    "properties": {
     "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "phoneDialCode": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "preferences": {
      "anyOf": [
       {
        "additionalProperties": {},
        "description": "Open-ended job-preferences JSON; documented keys are stable, unknown keys are allowed and expected.",
        "properties": {
         "address": {
          "type": "string"
         },
         "dealBreakers": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "locations": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "mailingAddress": {
          "anyOf": [
           {
            "additionalProperties": {},
            "properties": {
             "city": {
              "type": "string"
             },
             "country": {
              "type": "string"
             },
             "formatted": {
              "type": "string"
             },
             "line1": {
              "type": "string"
             },
             "line2": {
              "type": "string"
             },
             "postalCode": {
              "type": "string"
             },
             "region": {
              "type": "string"
             },
             "source": {
              "type": "string"
             },
             "updatedAt": {
              "type": "string"
             }
            },
            "required": [
             "line1",
             "city",
             "region",
             "postalCode",
             "country"
            ],
            "type": "object"
           },
           {
            "type": "null"
           }
          ],
          "description": "Structured mailing address captured from address autocomplete; null when cleared."
         },
         "remote": {
          "type": "boolean"
         },
         "roles": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "salaryMax": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "salaryMin": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "resumeText": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resumeUrl": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "tonePreferences": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "userId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "id",
     "userId",
     "name",
     "email",
     "phone",
     "phoneDialCode",
     "resumeText",
     "resumeUrl",
     "preferences",
     "tonePreferences",
     "createdAt",
     "updatedAt"
    ],
    "type": "object"
   }
  },
  "required": [
   "profile",
   "prefsVerifyPending"
  ],
  "type": "object"
 },
 "title": "Get profile"
}
