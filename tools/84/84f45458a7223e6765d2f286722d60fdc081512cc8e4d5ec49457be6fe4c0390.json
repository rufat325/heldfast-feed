{
 "description": "Prepare content for transfer to another agent or a human reviewer.\n\n    `target_modes` accepts either a JSON list or an actual list of MIME types.\n    The result includes expiring artifact URLs, SHA-256 hashes, a manifest,\n    and a downloadable ZIP package.\n    ",
 "inputSchema": {
  "properties": {
   "content": {
    "title": "Content",
    "type": "string"
   },
   "filename": {
    "default": "artifact.md",
    "title": "Filename",
    "type": "string"
   },
   "media_type": {
    "default": "text/markdown",
    "title": "Media Type",
    "type": "string"
   },
   "target_modes": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Target Modes"
   },
   "ttl_hours": {
    "default": 24,
    "title": "Ttl Hours",
    "type": "integer"
   }
  },
  "required": [
   "content"
  ],
  "title": "prepare_artifactArguments",
  "type": "object"
 },
 "name": "prepare_artifact",
 "outputSchema": {
  "additionalProperties": true,
  "title": "prepare_artifactDictOutput",
  "type": "object"
 }
}
