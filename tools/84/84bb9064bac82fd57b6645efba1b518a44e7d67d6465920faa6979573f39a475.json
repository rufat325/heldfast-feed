{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Configure or list reactive interrupt triggers with priority preemption and cooldown guards (actions: register, list). Use register_trigger instead of abort_behavior when defining automatic condition-based interrupts rather than manually pausing or stopping a tree.\n\nReturns registered trigger configuration, ID, or trigger list.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Trigger operation: register, list",
    "enum": [
     "register",
     "list"
    ],
    "type": "string"
   },
   "behavior_name": {
    "description": "Behavior tree to activate when condition fires",
    "type": "string"
   },
   "condition_params": {
    "description": "Condition evaluation parameters",
    "type": "object"
   },
   "condition_type": {
    "description": "Condition type (e.g. hp_threshold, enemy_proximity)",
    "type": "string"
   },
   "cooldown_ms": {
    "description": "Minimum cooldown interval between fires",
    "type": "number"
   },
   "name": {
    "description": "Trigger name",
    "type": "string"
   },
   "priority": {
    "description": "Preemption priority",
    "type": "number"
   },
   "project": {
    "description": "Target project slug",
    "type": "string"
   },
   "trigger_id": {
    "description": "Trigger ID",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "register_trigger"
}
