 "description": "CreateSafeEnvelope opens a two-party SAFE signing envelope from cap-table-supplied data (the caller fetched it via company.GetSafeAgreement): it renders the signable SAFE PDF and inserts the company (order 1) + investor (order 2) signers. The investor's signing link is emailed to them; no tokens are returned to the caller.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "companyName": {
    "description": "Human-readable name (1-255 Unicode chars).",
    "properties": {
     "value": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "founderEmail": {
    "maxLength": 320,
    "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+)?$",
    "type": "string"
   },
   "founderUserId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "investors": {
    "items": {
     "properties": {
      "email": {
       "maxLength": 320,
       "pattern": "^([^@\\s]+@[^@\\s]+\\.[^@\\s]+)?$",
       "type": "string"
      },
      "name": {
       "maxLength": 255,
       "minLength": 1,
       "type": "string"
      },
      "signingOrder": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "provider": {
    "enum": [
     "SIGNATURE_PROVIDER_UNSPECIFIED",
     "SIGNATURE_PROVIDER_LOVIE_SIGN",
     "SIGNATURE_PROVIDER_DOCUSIGN"
    ],
    "type": "string"
   },
   "reminderIntervalDays": {
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "safeAgreementId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "stateOfIncorporation": {
    "maxLength": 64,
    "type": "string"
   },
   "valuationCap": {
    "maxLength": 30,
    "pattern": "^([0-9]+(\\.[0-9]{1,4})?)?$",
    "type": "string"
   }
  },
  "required": [
   "founderUserId",
   "companyName"
  ],
  "type": "object"
 },
 "name": "captable_send_safe_for_signature",
