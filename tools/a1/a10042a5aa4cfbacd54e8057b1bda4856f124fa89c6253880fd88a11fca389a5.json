       "type": "string"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    ]
   },
   "trim": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "inventory_stats",
 "title": "Count and summarize network inventory"
