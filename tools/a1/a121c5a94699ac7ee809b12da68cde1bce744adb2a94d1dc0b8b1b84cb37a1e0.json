{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for pickup or destination places. Use resolve_place on the selected result before planning a trip.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "countryCode": {
    "default": "gh",
    "description": "Country to search: \"gh\" for Ghana, or \"gb\" for England, Scotland and Wales",
    "pattern": "^[a-zA-Z]{2}$",
    "type": "string"
   },
   "near": {
    "description": "Coordinates used to bias nearby results",
    "properties": {
     "lat": {
      "description": "Latitude in decimal degrees",
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lng": {
      "description": "Longitude in decimal degrees",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lng"
    ],
    "type": "object"
   },
   "query": {
    "description": "Place name or address",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "radiusMeters": {
    "maximum": 50000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_places",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "complete": {
    "type": "boolean"
   },
   "placeCounts": {
    "additionalProperties": false,
    "properties": {
     "returned": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "total",
     "returned",
     "truncated"
    ],
    "type": "object"
   },
   "places": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "complete": {
       "type": "boolean"
      },
      "label": {
       "type": "string"
      },
      "location": {
       "additionalProperties": false,
       "properties": {
        "lat": {
         "description": "Latitude in decimal degrees",
         "maximum": 90,
         "minimum": -90,
         "type": "number"
        },
        "lng": {
         "description": "Longitude in decimal degrees",
         "maximum": 180,
         "minimum": -180,
         "type": "number"
        }
       },
       "required": [
        "lat",
        "lng"
       ],
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "placeId": {
       "type": "string"
      },
      "routeNameCounts": {
       "additionalProperties": false,
       "properties": {
        "returned": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "total": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "truncated": {
         "type": "boolean"
        }
       },
       "required": [
        "total",
        "returned",
        "truncated"
       ],
       "type": "object"
      },
      "routeNames": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "places",
   "complete",
   "placeCounts"
  ],
  "type": "object"
 },
 "title": "Search places"
}
