{
 "description": "Delete an option (404 if it does not exist)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Option name (letters, digits, _ and -; the server lowercases it)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "key"
  ],
  "type": "object"
 },
 "name": "mcp_delete_option"
}
