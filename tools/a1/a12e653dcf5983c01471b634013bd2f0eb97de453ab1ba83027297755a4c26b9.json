{
 "description": "Copy an entire spreadsheet/workbook (all sheets, formatting, charts, named ranges, etc.). Creates in the same folder as the original. Uses Google Drive API.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "newTitle": {
    "description": "Name for the copy (optional, defaults to \"Copy of [original]\")",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "spreadsheet-copy",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "description": "ISO datetime when operation completed",
        "type": "string"
       },
       "itemsChanged": {
        "description": "Successfully copied (always 1 on success)",
        "type": "number"
       },
       "itemsProcessed": {
        "description": "Total items attempted (always 1)",
        "type": "number"
       },
       "newId": {
        "description": "Copied spreadsheet ID",
        "type": "string"
       },
       "newTitle": {
        "description": "Title of the copied spreadsheet",
        "type": "string"
       },
       "operationSummary": {
        "description": "Summary of the copy operation",
        "type": "string"
       },
       "sourceId": {
        "description": "Source spreadsheet ID",
        "type": "string"
       },
       "sourceTitle": {
        "description": "Source spreadsheet title",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the copied spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "operationSummary",
       "itemsProcessed",
       "itemsChanged",
       "completedAt",
       "sourceId",
       "sourceTitle",
       "newId",
       "newTitle",
       "spreadsheetUrl"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
