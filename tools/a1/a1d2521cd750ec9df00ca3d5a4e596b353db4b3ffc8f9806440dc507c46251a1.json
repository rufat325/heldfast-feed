{
 "_meta": {
  "ui": {
   "resourceUri": "ui://ipadian/preview-v2.html"
  },
  "ui/resourceUri": "ui://ipadian/preview-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Render a complete self-contained HTML app in iPadian. Include inline CSS and JavaScript; external requests, libraries, browser storage and navigation permissions are unavailable inside the sandbox. Keep the same id when revising an app. This returns an unsaved draft; only the user\u2019s Save locally button stores it. Never claim the app was saved or published.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "maxLength": 500000,
    "minLength": 1,
    "type": "string"
   },
   "duoPosture": {
    "default": "unfolded",
    "enum": [
     "phone",
     "unfolded",
     "book"
    ],
    "type": "string"
   },
   "id": {
    "pattern": "^[a-zA-Z0-9_-]{1,80}$",
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "previewMode": {
    "default": "duo",
    "enum": [
     "iphone",
     "duo",
     "ipad",
     "headless"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "code"
  ],
  "type": "object"
 },
 "name": "preview_app",
 "title": "Preview an app in iPadian"
}
