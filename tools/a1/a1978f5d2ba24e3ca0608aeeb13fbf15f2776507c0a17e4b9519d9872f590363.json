{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List room types"
 },
 "description": "Use this when someone asks what kinds of rooms a hotel offers or how many guests each room type sleeps. Returns each room type's id, hotel, name and maximum guests, sorted by name, 20 per page by default. Not for whether a room type is free on given dates.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hotelId": {
    "description": "Only this hotel (24 lowercase hexadecimal characters); every hotel when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "limit": {
    "description": "Room types per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "offset": {
    "description": "Room types to skip, from 0 to 10000; defaults to 0. For the next page pass offset + limit",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_room_types",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when another page exists; request it with offset + limit",
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "exclusiveMinimum": 0,
      "maximum": 100,
      "type": "integer"
     },
     "offset": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
     },
     "returned": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "limit",
     "offset",
     "returned",
     "hasMore"
    ],
    "type": "object"
   },
   "roomTypes": {
    "description": "Room types sorted by name. Photos, public descriptions, rate-plan internals, channel mappings and credentials are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "hotelId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/roomTypes/items/properties/name"
      },
      "maxGuests": {
       "anyOf": [
        {
         "maximum": 100,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "hotelId",
      "name",
      "maxGuests",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "roomTypes",
   "page"
  ],
  "type": "object"
 },
 "title": "List room types"
}
