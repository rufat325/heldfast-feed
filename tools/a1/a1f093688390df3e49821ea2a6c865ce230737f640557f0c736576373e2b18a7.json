{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommend Steam games"
 },
 "description": "Steam games for someone who likes 1-3 given games, ranked by imho.run's recommender: the list imho.run's own tool shows for those games and filters. Use it instead of games_like when the user names several games, wants filters beyond free / co-op / Steam Deck (no PvP, no microtransactions, no grind, not too hard, no Early Access, release years, more niche or more popular), or says what they want in words: pass that as `preferences` ('cozy base building, no combat'); the result says which Steam tags it was read as. When the user reacts to the picks, call it again with `liked` / `disliked`: liked games join the seeds, disliked ones never come back. Each pick has a one-line reason naming the seed it is closest to (`similar_to`), price, Steam Deck status, year, reviews, the imho.run URL and the Steam URL, plus `tool_url` (these games in imho.run's tool). Not for naming a game from a description (find_game_by_description) or facts about one game (game_facts). Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "disliked": {
    "description": "Games the user disliked or already played: never recommended. Pass earlier picks the user rejected to get fresh ones.",
    "items": {
     "description": "Game name (typos and Russian names are fine), Steam appid or Steam store URL.",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "filters": {
    "additionalProperties": false,
    "description": "All optional. Leave out what the user did not ask for.",
    "properties": {
     "coop": {
      "description": "Only games with co-op.",
      "type": "boolean"
     },
     "coop_mode": {
      "description": "Kind of co-op (implies coop): online (Remote Play Together does not count), local same-screen / split-screen, or any.",
      "enum": [
       "online",
       "local",
       "any"
      ],
      "type": "string"
     },
     "deck": {
      "description": "Steam Deck verified, or playable-or-better.",
      "enum": [
       "verified",
       "playable"
      ],
      "type": "string"
     },
     "exclude": {
      "description": "Leave out: pvp (PvP-focused), microtransactions (in-app purchases / free-to-play), hard (Difficult / Souls-like), grind (MMO / looter grind), early_access, vr_only.",
      "items": {
       "enum": [
        "pvp",
        "microtransactions",
        "hard",
        "grind",
        "early_access",
        "vr_only"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "exclude_tags": {
      "description": "Steam tags to leave out, e.g. ['Horror', 'Anime'].",
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "free": {
      "description": "Only free-to-play games.",
      "type": "boolean"
     },
     "popularity_bias": {
      "description": "-1 = hidden gems / more niche, 0 = neutral, 1 = well-known / more popular. Rounded to steps of 0.5.",
      "maximum": 1,
      "minimum": -1,
      "type": "number"
     },
     "upcoming": {
      "description": "Also include unreleased games (no year_max default).",
      "type": "boolean"
     },
     "year_max": {
      "description": "Released in or before this year (default: this year).",
      "maximum": 2100,
      "minimum": 1970,
      "type": "integer"
     },
     "year_min": {
      "description": "Released in or after this year.",
      "maximum": 2100,
      "minimum": 1970,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "lang": {
    "default": "en",
    "description": "Language of the `why` lines.",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "liked": {
    "description": "Other games the user said they liked (e.g. from earlier answers). They fill free seed slots after `seeds` (3 in all); the rest are listed in `ignored`.",
    "items": {
     "description": "Game name (typos and Russian names are fine), Steam appid or Steam store URL.",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "n": {
    "default": 10,
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "preferences": {
    "description": "What the user wants or wants to avoid, in their words (any language), e.g. 'dragons and crafting, no horror, no grind'. Read as Steam tags.",
    "maxLength": 200,
    "type": "string"
   },
   "seeds": {
    "description": "1-3 games the user likes: names, Steam appids or Steam URLs.",
    "items": {
     "description": "Game name (typos and Russian names are fine), Steam appid or Steam store URL.",
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "seeds"
  ],
  "type": "object"
 },
 "name": "recommend",
 "outputSchema": {
