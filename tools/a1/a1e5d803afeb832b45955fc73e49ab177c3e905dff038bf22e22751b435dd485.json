{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a custom event to Google Analytics via Measurement Protocol.\n\nUse this for tracking custom user actions, conversions, or any GA4 event.\nEvents are processed asynchronously and appear in reports within minutes.\n\nCommon events: click, form_submit, video_play, file_download, custom_conversion",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client_id": {
    "description": "Client ID (UUID format recommended). Auto-generated if not provided.",
    "type": "string"
   },
   "events": {
    "description": "Events to send (can send multiple in one request)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Event name (e.g., \"purchase\", \"sign_up\")",
       "type": "string"
      },
      "params": {
       "additionalProperties": {},
       "description": "Event parameters (key-value pairs)",
       "type": "object"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "user_id": {
    "description": "Optional User ID for cross-device tracking",
    "type": "string"
   },
   "user_properties": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "value": {
       "type": [
        "string",
        "number"
       ]
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "description": "User properties (e.g., {subscription_tier: {value: \"premium\"}})",
    "type": "object"
   }
  },
  "required": [
   "events"
  ],
  "type": "object"
 },
 "name": "ga_send_event"
}
