{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the user-owned journal by words in any supported language, tag, personal date, or import source. Returns matching entry IDs and short excerpts. Use get_entry for full text. Follow nextCursor with identical filters until hasMore is false before claiming there are no older matches. total counts only this response. Journal resolution errors do not broaden the search to other books.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Continuation from a previous search; keep the same filters.",
    "maxLength": 300,
    "type": "string"
   },
   "fromDate": {
    "type": "string"
   },
   "includeAllBooks": {
    "description": "Default false: return only the user's own journal entries (their personal Journal book). Set true to return entries from ALL their books, including book-derived content (insights, excerpts, exercises generated from books in their library).",
    "type": "boolean"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "location": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sensitivity": {
    "maxLength": 30,
    "minLength": 1,
    "type": "string"
   },
   "sourceMemoryId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "sourceType": {
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 50,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "toDate": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_entries",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "duplicateSourceMemoryId": {
    "type": "boolean"
   },
   "entries": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "hasMore": {
    "type": "boolean"
   },
   "journalExists": {
    "type": "boolean"
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scanned": {
    "type": "number"
   },
   "scope": {
    "type": "string"
   },
   "total": {
    "type": "number"
   },
   "totalIsExact": {
    "type": "boolean"
   }
  },
  "required": [
   "entries",
   "total",
   "totalIsExact",
   "hasMore",
   "nextCursor",
   "scope",
   "journalExists",
   "scanned",
   "duplicateSourceMemoryId"
  ],
  "type": "object"
 },
 "title": "Search my journal"
}
