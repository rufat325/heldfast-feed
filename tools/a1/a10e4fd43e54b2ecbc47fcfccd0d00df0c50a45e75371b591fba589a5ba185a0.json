 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get combo fills"
 },
 "description": "Live Polymarket combo (multi-leg) taker fills with exact decimal-string economics, wallet identity and grade, legs, conjunction result and ingest coverage. Requires a Pro or Max API key. The listing holds executions priced at most 0.95; get_combo has a combo's complete history. sort recent pages with next_cursor; largest and payout page with next_offset. A continuation can end on an empty page.\n\nArgs:\n  - result (string, optional): CSV of pending, won, lost; all clears the filter\n  - legs (string, optional): CSV of 2, 3, 4, 5+; all clears the filter\n  - min_stake (integer, optional, default 0): Minimum collateral in whole USDC\n  - min_multiplier (integer, optional, default 0): 0 disables the filter; otherwise 2 to 1000000 shares per dollar at execution\n  - grades (string, optional): CSV of S, A, B, C, D, F; all clears the filter; ungraded wallets never match\n  - sports (string, optional): CSV of sport slugs such as nfl, nba, soccer, esports; all clears the filter; a combo matches when any leg is in a selected sport\n  - sort (string, optional): recent (default, newest first), largest (collateral), or payout (buy-fill shares, sells excluded)\n  - window (string, optional): 24h, 7d or all; defaults to all for recent and 24h for largest and payout\n  - limit (number, 1-200, default 50): Fills per page\n  - cursor (string, optional): next_cursor from the previous recent page\n  - offset (number, 0-5000, optional): next_offset from the previous largest or payout page\n\nReturns: data (fills), has_more, next_cursor, next_offset, limit, sort, window, coverage and meta.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "next_cursor from the previous page; recent ordering only",
    "type": "string"
   },
   "grades": {
    "description": "CSV of S, A, B, C, D, F; all clears the filter. Ungraded wallets never match",
    "type": "string"
   },
   "legs": {
    "description": "CSV of 2, 3, 4, 5+; all clears the filter. A combo matches any named pick count",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max fills per page (1-200, default 50)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "min_multiplier": {
    "description": "Minimum shares per dollar at execution: 0 (the default) disables the filter, otherwise 2 to 1000000",
    "maximum": 1000000,
    "minimum": 0,
    "not": {
     "const": 1
    },
    "type": "integer"
   },
   "min_stake": {
    "description": "Minimum collateral in whole USDC (default 0)",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "next_offset from the previous page; largest and payout ordering only",
    "maximum": 5000,
    "minimum": 0,
    "type": "integer"
   },
   "result": {
    "description": "CSV of pending, won, lost; all clears the filter",
    "type": "string"
   },
   "sort": {
    "description": "recent (the default) is newest first; largest ranks collateral; payout ranks buy-fill shares and excludes sells",
    "enum": [
     "recent",
     "largest",
     "payout"
    ],
    "type": "string"
   },
   "sports": {
    "description": "CSV of sport slugs such as nfl, nba, soccer, esports; all clears the filter. A combo matches when any leg is in a selected sport",
    "type": "string"
   },
   "window": {
    "description": "Defaults to all for recent and 24h for largest and payout",
    "enum": [
     "24h",
     "7d",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
