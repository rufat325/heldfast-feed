{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use the owner-authenticated My Apps onion-import form for private key files; MCP refuses onion_import key material in tool arguments. These legacy schema fields document the underlying operation, not permission to send secrets through MCP. Install an app from the Impreza catalog on a target VPS. Find app names with impreza_list_apps and the agent_id with impreza_list_servers. Put app-specific settings in vars. For a custom app outside the catalog, use impreza_deploy_custom instead.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "Target VPS agent_id.",
    "type": "string"
   },
   "app_name": {
    "description": "Catalog app name (e.g. \"vaultwarden\").",
    "type": "string"
   },
   "app_version": {
    "description": "Optional pinned version. Default: latest published.",
    "type": "string"
   },
   "domain": {
    "description": "Public hostname. Omit + onion:true for onion-only.",
    "type": "string"
   },
   "onion": {
    "description": "Also publish a Tor v3 hidden service mirror.",
    "type": "boolean"
   },
   "onion_import": {
    "additionalProperties": false,
    "description": "Provide BOTH C Tor key files, base64-encoded: hs_ed25519_secret_key (96 bytes) and hs_ed25519_public_key (64 bytes). One does not replace the other. Requires onion:true and preserves the existing onion address. Deploy-time only; impreza_add_onion does not import identities.",
    "properties": {
     "public_key_b64": {
      "type": "string"
     },
     "secret_key_b64": {
      "type": "string"
     }
    },
    "required": [
     "secret_key_b64",
     "public_key_b64"
    ],
    "type": "object"
   },
   "onion_profile": {
    "description": "Requires onion:true. Standard uses intro-point rate limiting; hardened adds tighter limits and max streams; max adds experimental proof-of-work. Default standard. No DDoS guarantee; max is refused when the host's Tor lacks the PoW module.",
    "enum": [
     "standard",
     "hardened",
     "max"
    ],
    "type": "string"
   },
   "standby": {
    "description": "Create a cold standby of reviewed Memos 0.31.0 or Uptime Kuma 2.5.5, without a public hostname or onion. Requires jurisdiction failover enabled. Omit domain, onion and vars.domain; then pair it with the primary on a different owned country.",
    "type": "boolean"
   },
   "vars": {
    "description": "App-specific manifest variables (KEY \u2192 value).",
    "type": "object"
   }
  },
  "required": [
   "app_name",
   "agent_id"
  ],
  "type": "object"
 },
 "name": "impreza_deploy_catalog_app",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "agent_id": {
      "type": "string"
     },
     "app_name": {
      "type": "string"
     },
     "app_version": {
      "type": "string"
     },
     "connection_info": {
      "type": [
       "object",
       "null"
      ]
     },
     "created_at": {
      "type": "string"
     },
     "credentials_note": {
      "type": "string"
     },
     "domain": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "last_error": {
      "type": [
       "string",
       "null"
      ]
     },
     "last_health_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "last_operation": {
      "type": [
       "object",
       "null"
      ]
     },
     "network_mode": {
      "type": "string"
     },
     "onion": {
      "type": [
       "string",
       "null"
      ]
     },
     "onion_exported_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "onion_profile": {
      "type": "string"
     },
     "runtime": {
      "type": "object"
     },
     "signup_window": {
      "type": [
       "object",
       "null"
      ]
     },
     "status": {
      "type": "string"
     },
     "vars": {
      "type": [
       "object",
       "array"
      ]
     }
    },
    "required": [
     "id",
     "runtime",
     "last_operation",
     "app_name",
     "app_version",
     "agent_id",
     "status",
     "domain",
     "onion",
     "onion_profile",
     "onion_exported_at",
     "network_mode",
     "connection_info",
     "vars",
     "signup_window",
     "created_at",
     "last_health_at",
     "last_error"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Deploy catalog app"
}
