    },
    "type": "array"
   },
   "subtasks": {
    "type": "boolean"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "team_id": {
    "type": "string"
   },
   "time_window": {
    "type": "string"
   },
   "watchers": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      }
     ]
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "clickup_filter_tasks"
}
