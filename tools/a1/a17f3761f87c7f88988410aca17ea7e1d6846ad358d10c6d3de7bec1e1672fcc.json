   "archived": {
    "type": "boolean"
   },
   "assignees": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      }
     ]
    },
    "type": "array"
   },
   "date_created_gt": {
    "type": "integer"
   },
   "date_created_lt": {
    "type": "integer"
   },
   "date_updated_gt": {
    "type": "integer"
   },
   "date_updated_lt": {
    "type": "integer"
   },
   "due_date_gt": {
    "type": "integer"
   },
   "due_date_lt": {
    "type": "integer"
   },
   "folder_ids": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      }
     ]
    },
    "type": "array"
   },
   "include_closed": {
    "type": "boolean"
   },
   "include_markdown_description": {
    "type": "boolean"
   },
   "list_ids": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      }
     ]
    },
    "type": "array"
   },
   "order_by": {
    "enum": [
     "id",
     "created",
     "updated",
     "due_date"
    ],
    "type": "string"
   },
   "page": {
    "minimum": 0,
    "type": "integer"
   },
   "response_format": {
    "default": "summary",
