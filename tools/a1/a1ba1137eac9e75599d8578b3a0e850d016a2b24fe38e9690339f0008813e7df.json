{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Julian Date Converter"
 },
 "description": "Convert explicit UTC civil timestamps to Julian day and back using the proleptic Gregorian calendar. See the noon epoch, time-scale convention and ordinal day. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "properties": {
     "direction": {
      "description": "Timestamp to JD",
      "enum": [
       "to-julian"
      ],
      "type": "string"
     },
     "value": {
      "description": "Explicit UTC civil timestamp.",
      "maxLength": 24,
      "minLength": 1,
      "type": "string"
     }
    }
   },
   {
    "properties": {
     "direction": {
      "description": "JD to timestamp",
      "enum": [
       "from-julian"
      ],
      "type": "string"
     },
     "value": {
      "description": "Julian day within years 0001\u20139999; upper boundary rejected by engine.",
      "maximum": 5373484.5,
      "minimum": 1721425.5,
      "type": "number"
     }
    },
    "required": [
     "direction"
    ]
   }
  ],
  "examples": [
   {
    "convention": "proleptic-gregorian-utc",
    "direction": "to-julian",
    "value": "1970-01-01T00:00:00Z"
   }
  ],
  "properties": {
   "convention": {
    "description": "UTC civil approximation to UT1; no leap seconds.",
    "enum": [
     "proleptic-gregorian-utc"
    ],
    "type": "string"
   },
   "direction": {
    "description": "Conversion direction; default to-julian.",
    "enum": [
     "to-julian",
     "from-julian"
    ],
    "type": "string"
   },
   "value": {
    "description": "UTC timestamp string, or a numeric JD for reverse conversion.",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "value"
  ],
  "type": "object"
 },
 "name": "julian_day_convert",
 "outputSchema": {
  "description": "Julian day, UTC civil timestamp, ordinal day and explicit convention.",
  "type": "object"
 },
 "title": "Julian Date Converter"
}
