{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare a category"
 },
 "description": "Full ranked comparison of paid endpoints in one category. Call list_categories for valid ids.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Category id, e.g. 'web-search'",
    "type": "string"
   },
   "hide_flags": {
    "description": "Warnings to leave out, e.g. [\"wallet-mismatch\", \"few-repeat-buyers\"]",
    "items": {
     "enum": [
      "wallet-mismatch",
      "price-mismatch",
      "few-repeat-buyers",
      "unusual-seller-traffic",
      "test-listing"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_price_usd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "platform": {
    "description": "Sub-category platform ids, any of, e.g. [\"instagram\",\"tiktok\"]. See list_categories",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rail": {
    "description": "Paid rails to include, e.g. [\"x402\"] for pay-per-call only (default both)",
    "items": {
     "enum": [
      "x402",
      "apify"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "recent": {
    "description": "true = only endpoints checked in the last 7 days",
    "type": "boolean"
   },
   "task": {
    "description": "Sub-category task ids, any of, e.g. [\"comments\"]. See list_categories",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "compare_category",
 "title": "Compare a category"
}
