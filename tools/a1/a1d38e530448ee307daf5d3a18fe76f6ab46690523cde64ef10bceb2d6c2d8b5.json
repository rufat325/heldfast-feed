{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add, update, or delete swatches in the active document. Note: Illustrator will be activated (brought to foreground) during execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "color": {
    "description": "Color for add/update (required for add)",
    "oneOf": [
     {
      "properties": {
       "c": {
        "description": "Cyan (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "k": {
        "description": "Black (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "m": {
        "description": "Magenta (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "type": {
        "const": "cmyk",
        "description": "Color type",
        "type": "string"
       },
       "y": {
        "description": "Yellow (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "type",
       "c",
       "m",
       "y",
       "k"
      ],
      "type": "object"
     },
     {
      "properties": {
       "b": {
        "description": "Blue (0-255)",
        "maximum": 255,
        "minimum": 0,
        "type": "number"
       },
       "g": {
        "description": "Green (0-255)",
        "maximum": 255,
        "minimum": 0,
        "type": "number"
       },
       "r": {
        "description": "Red (0-255)",
        "maximum": 255,
        "minimum": 0,
        "type": "number"
       },
       "type": {
        "const": "rgb",
        "description": "Color type",
        "type": "string"
       }
      },
      "required": [
       "type",
       "r",
       "g",
       "b"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "gray",
        "description": "Color type",
        "type": "string"
       },
       "value": {
        "description": "Gray value (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "none",
        "description": "Color type",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     }
    ]
   },
   "name": {
    "description": "Swatch name",
    "type": "string"
   }
  },
  "required": [
   "action",
   "name"
  ],
  "type": "object"
 },
 "name": "manage_swatches",
 "title": "Manage Swatches"
}
