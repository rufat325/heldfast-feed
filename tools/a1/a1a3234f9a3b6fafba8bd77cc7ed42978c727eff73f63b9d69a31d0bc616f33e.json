     },
     {
      "const": 20,
      "type": "number"
     },
     {
      "const": 30,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     }
    ],
    "description": "Planned current in amperes"
   },
   "distanceFeet": {
