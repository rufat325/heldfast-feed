    "enum": [
     "standard",
     "priority",
     "express"
    ],
    "type": "string"
   },
   "payment_protocol": {
    "description": "Optional payment path. Defaults to hosted checkout. Choose mpp to return a payment challenge for this same prepared order; buyer_email is required. Draft creation never pays.",
    "enum": [
     "hosted",
     "mpp"
    ],
    "type": "string"
   },
   "recipient_address_id": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
