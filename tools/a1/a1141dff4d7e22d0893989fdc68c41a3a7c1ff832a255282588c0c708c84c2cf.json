{
 "description": "Calculate the cryptographic hash (SHA-256, MD5, SHA-1) of a file or text string.",
 "inputSchema": {
  "oneOf": [
   {
    "required": [
     "text"
    ]
   },
   {
    "required": [
     "filePath"
    ]
   }
  ],
  "properties": {
   "algorithm": {
    "default": "sha256",
    "description": "Hashing algorithm. Defaults to 'sha256'.",
    "enum": [
     "sha256",
     "md5",
     "sha1"
    ],
    "type": "string"
   },
   "filePath": {
    "description": "Local path to a file to hash.",
    "type": "string"
   },
   "text": {
    "description": "Text content to hash.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "utility_file_hash"
}
