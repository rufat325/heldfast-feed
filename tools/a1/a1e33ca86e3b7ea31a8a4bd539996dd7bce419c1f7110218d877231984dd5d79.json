   },
   "dryRun": {
    "type": "boolean"
   },
   "failed": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "groupId": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attempts": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "data": {},
      "displayName": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "notification": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "status": {
       "enum": [
        "sent",
        "failed",
        "skipped",
        "would_send"
       ],
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "userId": {
       "type": "string"
      }
     },
     "required": [
      "target",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sent": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "skipped": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
