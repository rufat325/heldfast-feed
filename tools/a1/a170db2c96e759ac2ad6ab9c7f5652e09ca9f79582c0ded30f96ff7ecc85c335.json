{
 "annotations": {},
 "description": "Run data import from Object Storage to a Search Engine Service cluster",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Object Storage bucket name",
    "type": "string"
   },
   "filePath": {
    "description": "File path in the bucket",
    "type": "string"
   },
   "indexName": {
    "description": "Target index name",
    "type": "string"
   },
   "serviceGroupInstanceNo": {
    "description": "Cluster instance number",
    "type": "string"
   }
  },
  "required": [
   "serviceGroupInstanceNo",
   "bucketName",
   "filePath",
   "indexName"
  ],
  "type": "object"
 },
 "name": "ncloud_ses_run_import"
}
