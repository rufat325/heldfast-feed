{
 "description": "Validate user-entered tihai, tukra, or chakradhar structure using equation and timeline checks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "composition_input": {
    "properties": {
     "G": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "M": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "P": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "g": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "segments": {
      "items": {
       "properties": {
        "end_beat": {
         "minimum": 1,
         "type": "number"
        },
        "end_pulse": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        },
        "index": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        },
        "kind": {
         "enum": [
          "mukhra",
          "phrase",
          "gap",
          "macro_gap"
         ],
         "type": "string"
        },
        "length_beats": {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        "length_pulses": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        },
        "round_index": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "start_beat": {
         "minimum": 1,
         "type": "number"
        },
        "start_pulse": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "kind",
        "index",
        "round_index",
        "start_pulse",
        "end_pulse",
        "length_pulses",
        "start_beat",
        "end_beat",
        "length_beats"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "cycles": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "form": {
    "minLength": 1,
    "type": "string"
   },
   "jati": {
    "enum": [
     "tisra",
     "chatusra",
     "khanda",
     "misra"
    ],
    "type": "string"
   },
   "taal": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taal",
   "form",
   "jati",
   "cycles",
   "composition_input"
  ],
  "type": "object"
 },
 "name": "composition_validator",
 "title": "Composition Validator"
}
