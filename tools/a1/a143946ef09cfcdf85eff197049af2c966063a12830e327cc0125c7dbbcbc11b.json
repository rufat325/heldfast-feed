 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "source": {
    "description": "source (query param)",
    "type": "string"
   },
   "versionId": {
    "description": "versionId (path param)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "versionId"
  ],
  "type": "object"
 },
 "name": "crm_promoteAndPublish"
}
