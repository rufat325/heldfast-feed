{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Bible Book"
 },
 "description": "Get metadata for a single Bible book including chapter and verse counts. Accepts OSIS codes (\"Gen\"), USFM codes (\"GEN\"), full names (\"Genesis\"), and aliases (\"genesis\", \"1-maccabees\") \u2014 case-insensitive, hyphens/underscores tolerated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "book_code": {
    "description": "Book identifier. Examples: \"Gen\", \"GEN\", \"Genesis\", \"1Macc\", \"DanGr\"",
    "type": "string"
   }
  },
  "required": [
   "book_code"
  ],
  "type": "object"
 },
 "name": "bible.book",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "book": {
    "additionalProperties": false,
    "properties": {
     "abbr": {
      "type": "string"
     },
     "bookCode": {
      "type": "string"
     },
     "bookName": {
      "type": "string"
     },
     "bookOrder": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "canon": {
      "enum": [
       "ot",
       "deuterocanon",
       "nt"
      ],
      "type": "string"
     },
     "chapterCount": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "fullName": {
      "type": "string"
     },
     "verseCount": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "bookCode",
     "bookName",
     "fullName",
     "abbr",
     "bookOrder",
     "canon",
     "chapterCount",
     "verseCount"
    ],
    "type": "object"
   }
  },
  "required": [
   "book"
  ],
  "type": "object"
 },
 "title": "Get Bible Book"
}
