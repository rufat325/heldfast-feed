{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new calendar event. Can include attendees and optionally create a Google Meet link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attendees": {
    "description": "List of attendees",
    "items": {
     "additionalProperties": false,
     "properties": {
      "displayName": {
       "description": "Attendee display name",
       "type": "string"
      },
      "email": {
       "description": "Attendee email address",
       "type": "string"
      },
      "optional": {
       "description": "Whether attendance is optional",
       "type": "boolean"
      },
      "responseStatus": {
       "enum": [
        "needsAction",
        "declined",
        "tentative",
        "accepted"
       ],
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "calendarId": {
    "default": "primary",
    "description": "Calendar ID",
    "type": "string"
   },
   "conferenceDataVersion": {
    "description": "Set to 1 to create a Google Meet link",
    "type": "number"
   },
   "description": {
    "description": "Event description",
    "type": "string"
   },
   "end": {
    "additionalProperties": false,
    "description": "Event end time",
    "properties": {
     "date": {
      "description": "End date for all-day events (YYYY-MM-DD)",
      "type": "string"
     },
     "dateTime": {
      "description": "End datetime (RFC3339)",
      "type": "string"
     },
     "timeZone": {
      "description": "Timezone",
      "type": "string"
     }
    },
    "type": "object"
   },
   "location": {
    "description": "Event location",
    "type": "string"
   },
   "sendUpdates": {
    "default": "all",
    "description": "Who to send notifications to",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   },
   "start": {
    "additionalProperties": false,
    "description": "Event start time",
    "properties": {
     "date": {
      "description": "Start date for all-day events (YYYY-MM-DD)",
      "type": "string"
     },
     "dateTime": {
      "description": "Start datetime (RFC3339, e.g., \"2025-01-15T09:00:00-08:00\")",
      "type": "string"
     },
     "timeZone": {
      "description": "Timezone (e.g., \"America/Los_Angeles\")",
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "description": "Event title",
    "type": "string"
   }
  },
  "required": [
   "summary",
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "event_create",
 "title": "Create event"
}
