{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Measure history"
 },
 "description": "Get one measure over time, newest first: as first reported (default), as latest filed, or as known on as_of, each with its filing and whether it later changed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "description": "Only filings made on or before this date count, for every basis.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "basis": {
    "description": "first_reported (default), latest, or as_of (default when as_of is set).",
    "enum": [
     "first_reported",
     "latest",
     "as_of"
    ],
    "type": "string"
   },
   "company": {
    "description": "Ticker (AAPL), CIK or company name.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "concept": {
    "description": "Plain name (revenue, eps_diluted, assets; follows tag changes) or XBRL tag (Revenues).",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Default 20, newest first.",
    "maximum": 400,
    "minimum": 1,
    "type": "integer"
   },
   "periods": {
    "description": "annual (default), quarterly, or all (adds year-to-date).",
    "enum": [
     "annual",
     "quarterly",
     "all"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Default: the unit with most periods.",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "company",
   "concept"
  ],
  "type": "object"
 },
 "name": "history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "rows: one per period, newest first, in the order of columns.",
  "properties": {
   "basis": {
    "type": "string"
   },
   "columns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "company": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "concept": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "next_offset": {
    "type": "number"
   },
   "rows": {
    "items": {},
    "type": "array"
   },
   "snapshot": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "total": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Measure history"
}
