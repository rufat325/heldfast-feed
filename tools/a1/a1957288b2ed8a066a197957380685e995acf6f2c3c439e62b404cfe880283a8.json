{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "doctor.use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "The app Doctor conversation. Send version bsd-agent-doctor-v1 and one action: open (commandKey, optional owned subject), threads, conversation (threadId), quota, quote (commandKey, threadId, current sequence, text, optional responseStyle learning/technical/roast), memory (current confirmed notes), remember (commandKey, explicitly requested note/correction), forget (commandKey, note id/current revision, explicit confirmation), start (commandKey, quoteId), job or events (jobId), or cancel (commandKey, jobId). Keep each write commandKey stable on retry. Show the quote before start; a succeeded job carries the saved Doctor answer and the conversation stores it. Styles affect this reply only; omit to use the account default. Remember/forget require the customer explicitly asking to save, correct or remove that note; never infer mastery or save betting results as personal memory. The app enforces AI consent, tier, allowance, cost cap and worker admission. Do not claim an answer until the saved result is readable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "open",
     "threads",
     "conversation",
     "quota",
     "quote",
     "start",
     "job",
     "events",
     "cancel",
     "memory",
     "remember",
     "forget"
    ],
    "type": "string"
   },
   "after": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "before": {
    "maximum": 2001,
    "minimum": 1,
    "type": "integer"
   },
   "commandKey": {
    "description": "Stable key for one write action and all its retries.",
    "maxLength": 120,
    "minLength": 16,
    "type": "string"
   },
   "confirmation": {
    "const": "forget_for_future_consults",
    "type": "string"
   },
   "expectedRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "history": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "format": "uuid",
      "type": "string"
     },
     "kind": {
      "enum": [
       "import",
       "manual"
      ],
      "type": "string"
     }
    },
    "required": [
     "kind",
     "id"
    ],
    "type": "object"
   },
   "id": {
    "description": "Exact owned note ID to remove.",
    "format": "uuid",
    "type": "string"
   },
   "jobId": {
    "format": "uuid",
    "type": "string"
   },
   "note": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "enum": [
       "preference",
       "goal",
       "constraint",
       "context"
      ],
      "type": "string"
     },
     "confirmation": {
      "const": "save_for_future_consults",
      "type": "string"
     },
     "expectedRevision": {
      "minimum": 1,
      "type": "integer"
     },
     "expiresAt": {
      "format": "date-time",
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "format": "uuid",
      "type": "string"
     },
     "text": {
      "maxLength": 1000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "category",
     "text",
     "confirmation"
    ],
    "type": "object"
   },
   "quoteId": {
    "format": "uuid",
    "type": "string"
   },
   "reportId": {
    "format": "uuid",
    "type": [
     "string",
     "null"
    ]
   },
   "responseStyle": {
    "description": "This reply only. Omit to preserve the account default.",
    "enum": [
     "learning",
     "technical",
     "roast"
    ],
    "type": "string"
   },
   "sequence": {
    "description": "Current thread sequence from conversation.",
    "maximum": 1998,
    "minimum": 0,
    "type": "integer"
   },
   "text": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "threadId": {
    "format": "uuid",
    "type": "string"
   },
   "ticketId": {
    "format": "uuid",
    "type": [
     "string",
     "null"
    ]
   },
   "version": {
    "const": "bsd-agent-doctor-v1",
    "type": "string"
   }
  },
  "required": [
   "version",
   "action"
  ],
  "type": "object"
 },
 "name": "doctor_conversation",
 "securitySchemes": [
  {
   "scopes": [
    "doctor.use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Ask the Doctor"
