{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Optimize Shopping Cart"
 },
 "description": "Find the cheapest way to buy multiple products together: computes the optimal split across shops \u2014 which items to order from which shop \u2014 accounting for each shop's shipping costs and free-shipping thresholds, and returns the lowest achievable total including shipping. Takes an array of EAN barcodes. For accurate results, call get_best_price for each EAN first, then call optimize_cart.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "default": "DE",
    "description": "Country for pricing and shipping (DE or AT, default DE)",
    "enum": [
     "DE",
     "AT"
    ],
    "type": "string"
   },
   "eans": {
    "description": "Array of EAN barcodes (8\u201314 digit numbers as strings, e.g. '4524667749493'). NOT URLs.",
    "items": {
     "pattern": "^\\d{8,14}$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "eans"
  ],
  "type": "object"
 },
 "name": "optimize_cart",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "disclosure": {
    "type": "string"
   },
   "optimization": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "grand_total": {
      "type": "number"
     },
     "shops_used": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "items": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "affiliate_url": {
            "description": "Direct link to buy this item. Always show this URL to the user.",
            "type": "string"
           },
           "ean": {
            "type": "string"
           },
           "name": {
            "type": "string"
           },
           "price": {
            "type": "number"
           }
          },
          "required": [
           "name",
           "price",
           "affiliate_url"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "shipping": {
         "type": "number"
        },
        "shop": {
         "type": "string"
        },
        "subtotal": {
         "type": "number"
        }
       },
       "required": [
        "shop",
        "subtotal",
        "shipping",
        "items"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "total_cost": {
      "type": "number"
     },
     "total_shipping": {
      "type": "number"
     }
    },
    "required": [
     "total_cost",
     "total_shipping",
     "grand_total",
     "currency",
     "shops_used"
    ],
    "type": "object"
   },
   "savings_info": {
    "type": "string"
   },
   "stale_cache_warning": {
    "additionalProperties": false,
    "properties": {
     "eans_to_refresh": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "eans_to_refresh",
     "suggestion"
    ],
    "type": "object"
   }
  },
  "required": [
   "optimization"
  ],
  "type": "object"
 },
 "title": "Optimize Shopping Cart"
}
