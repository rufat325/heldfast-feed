{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Quickly extract clean, readable text, markdown, and links from a web page using Atlas's fast synchronous parser. Strips cookie banners, navigation clutter, and ads. Best for articles, documentation pages, and general web reading.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "formats": {
    "default": [
     "markdown"
    ],
    "description": "Content formats to include in the response. 'markdown' returns clean formatted content; 'links' includes discovered hyperlinks; 'text' returns raw stripped text.",
    "items": {
     "enum": [
      "markdown",
      "links",
      "text"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "max_output_chars": {
    "default": 30000,
    "description": "Maximum character budget for the returned content. If content exceeds this limit, it is cleanly truncated at paragraph boundaries with truncation notice.",
    "maximum": 200000,
    "minimum": 1000,
    "type": "integer"
   },
   "timeout_ms": {
    "default": 15000,
    "description": "Fetch and processing timeout in milliseconds.",
    "maximum": 30000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "description": "The absolute HTTP or HTTPS URL of the web page to scrape.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "atlas_scrape",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "text": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "markdown": {
    "type": "string"
   },
   "resource_uri": {
    "type": "string"
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "character_count": {
      "type": "number"
     },
     "read_time_seconds": {
      "type": "number"
     },
     "word_count": {
      "type": "number"
     }
    },
    "required": [
     "character_count",
     "word_count",
     "read_time_seconds"
    ],
    "type": "object"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "title",
   "stats",
   "truncated"
  ],
  "type": "object"
 }
}
