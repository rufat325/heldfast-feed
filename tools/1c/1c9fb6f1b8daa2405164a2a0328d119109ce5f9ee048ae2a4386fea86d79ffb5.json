{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Latest news"
 },
 "description": "Latest Croatian news from all major portals (deduplicated: one item per news story, with how many portals covered it). Filter by category (crime, politics, sport, economy, world, show, \u2026), portal slug, or period (from/to). Use sort=most_covered for the biggest stories of the moment, most_read for what people read, badge=breaking for what is urgent or big in Croatia and the major world events (or one badge: urgent, big, world, clickbait, sponsored). Returns title, description, Adios URL, source portal and its URL, time, categories, and signals (0-1: urgency, importance, world_event, clickbait, sponsored; in_croatia) with badges (urgent, big, world, clickbait, sponsored) for what to flag.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "badge": {
    "description": "Only stories with a badge: breaking (urgent, big and world together, as on Udarne vijesti), urgent, big, world, clickbait, sponsored.",
    "enum": [
     "breaking",
     "urgent",
     "big",
     "world",
     "clickbait",
     "sponsored"
    ],
    "type": "string"
   },
   "category": {
    "description": "Category: crime, politics, sport\u2026 (see /v1/categories).",
    "enum": [
     "general",
     "politics",
     "economy",
     "sport",
     "crime",
     "weather",
     "technology",
     "health",
     "entertainment",
     "show",
     "culture",
     "world",
     "lifestyle",
     "travel",
     "science",
     "education",
     "automotive"
    ],
    "type": "string"
   },
   "from": {
    "description": "From (YYYY-MM-DD or ISO time), within the plan's archive.",
    "type": "string"
   },
   "include_filler": {
    "description": "Filler (horoscopes, quizzes, reality shows, celebrity gossip, promos) is left out of every list; true brings it back.",
    "type": "boolean"
   },
   "limit": {
    "description": "How many results (default 20, at most what the plan allows).",
    "type": "integer"
   },
   "offset": {
    "description": "Skip this many (paging).",
    "type": "integer"
   },
   "provider": {
    "description": "Only one portal, by its slug (see /v1/providers).",
    "type": "string"
   },
   "sort": {
    "description": "newest (default), most_read or most_covered (most portals).",
    "enum": [
     "newest",
     "most_read",
     "most_covered"
    ],
    "type": "string"
   },
   "stories_only": {
    "description": "Only news that is part of a followed story (timeline).",
    "type": "boolean"
   },
   "to": {
    "description": "To (YYYY-MM-DD or ISO time).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_latest_news",
 "outputSchema": {
  "properties": {
   "data": {
    "items": {
     "properties": {
      "badges": {
       "default": null,
       "items": {
        "type": "string"
       },
       "type": [
        "array",
        "null"
       ]
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "clickbait_score": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "discovered_at": {
       "format": "date-time",
       "type": "string"
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "image_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "portals": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "published_at": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "signals": {
       "default": null,
       "properties": {
        "clickbait": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "importance": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "in_croatia": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "sponsored": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "urgency": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "world_event": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "source": {
       "properties": {
        "name": {
         "type": "string"
        },
        "slug": {
         "type": [
          "string",
          "null"
         ]
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "url"
       ],
       "type": "object"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "url",
      "source",
      "discovered_at",
      "categories",
      "portals"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "description": "count, plan, include_filler, the limits applied (e.g. radius_limited_to), and for a nearby search its center.",
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Latest news"
}
