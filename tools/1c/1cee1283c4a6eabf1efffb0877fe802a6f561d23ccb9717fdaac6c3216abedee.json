{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List workflow runs"
 },
 "description": "Use this when someone asks about recent or failed runs of a durable workflow in a Croncool project. Returns each run's id, workflow name, status, timings and error code, newest first by default, 20 per page with a cursor, filterable by workflow and status. Not for one run's steps.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same project, workflow, status and sort; absent for the first page",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Runs per page, from 1 to 100; defaults to 20",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Project id",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "newest (default) or oldest first",
    "enum": [
     "newest",
     "oldest"
    ],
    "type": "string"
   },
   "status": {
    "description": "Only runs in this status: pending, running, completed, failed or cancelled",
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "cancelled"
    ],
    "type": "string"
   },
   "workflowName": {
    "description": "Only runs of this workflow name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "list_workflow_runs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page with the same filters; null on the last page"
   },
   "runs": {
    "description": "Run identity, status, timings and machine error code. Workflow inputs, outputs and error messages are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "completedAt": {
       "$ref": "#/properties/runs/items/properties/creationTime"
      },
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "errorCode": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "startedAt": {
       "$ref": "#/properties/runs/items/properties/creationTime"
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "cancelled"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "workflowName": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "workflowName",
      "status",
      "creationTime",
      "startedAt",
      "completedAt",
      "errorCode"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "runs",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List workflow runs"
}
