{"_meta":{"securitySchemes":[{"scopes":["email"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Open a draft pull request"},"description":"Open any change as a draft PR on a new branch in one of the repos connected to Fictura. Optionally tie it to an issue. Nothing under .github/. Needs \"Let MCP keys open pull requests\".","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"base":{"description":"Target branch; default: the repo's default branch","maxLength":200,"minLength":1,"type":"string"},"body":{"maxLength":8000,"minLength":3,"type":"string"},"files":{"items":{"properties":{"content":{"description":"The whole new file","maxLength":1000000,"type":"string"},"delete":{"description":"Remove the file","type":"boolean"},"patch":{"description":"Unified diff for this file (git diff output). Preferred: smaller.","maxLength":400000,"type":"string"},"path":{"description":"Path from the repo root","maxLength":400,"minLength":1,"type":"string"}},"required":["path"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"issue_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"repo":{"description":"owner/repo","pattern":"^[A-Za-z0-9_.-]{1,100}\\/[A-Za-z0-9_.-]{1,100}$","type":"string"},"title":{"maxLength":200,"minLength":3,"type":"string"}},"required":["repo","title","body","files"],"type":"object"},"name":"create_pull_request","title":"Open a draft pull request"}
