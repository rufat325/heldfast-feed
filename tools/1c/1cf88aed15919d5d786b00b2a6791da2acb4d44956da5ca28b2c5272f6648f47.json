{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Semantic Search"
 },
 "description": "Search the Urantia Papers using semantic similarity (vector embeddings). Returns conceptually related results even without exact keyword matches.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include_bible_parallels": {
    "default": false,
    "description": "Include the top-10 Bible verses semantically nearest to each result (Urantia \u2192 Bible).",
    "type": "boolean"
   },
   "include_entities": {
    "default": false,
    "description": "Include entity mentions",
    "type": "boolean"
   },
   "include_urantia_parallels": {
    "default": false,
    "description": "Include the top-10 most-similar OTHER Urantia paragraphs for each result.",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 0,
    "description": "Page number (0-indexed)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "paper_id": {
    "description": "Filter to a specific paper ID",
    "type": "string"
   },
   "part_id": {
    "description": "Filter to a specific part ID (1-4)",
    "type": "string"
   },
   "q": {
    "description": "Alias for `query` (REST compatibility).",
    "type": "string"
   },
   "query": {
    "description": "Natural language query. Example: \"What is the meaning of life?\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search.semantic",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bibleParallels": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "bookCode": {
          "type": "string"
         },
         "chapter": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "chunkId": {
          "type": "string"
         },
         "embeddingModel": {
          "type": "string"
         },
         "rank": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "reference": {
          "type": "string"
         },
         "similarity": {
          "type": "number"
         },
         "source": {
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "verseEnd": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "verseStart": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "chunkId",
         "reference",
         "bookCode",
         "chapter",
         "verseStart",
         "verseEnd",
         "text",
         "similarity",
         "rank",
         "source",
         "embeddingModel"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "entities": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "type": {
          "enum": [
           "being",
           "place",
           "order",
           "race",
           "religion",
           "concept"
          ],
          "type": "string"
         }
        },
        "required": [
         "id",
         "name",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "labels": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "paperId": {
       "type": "string"
      },
      "paperTitle": {
       "type": "string"
      },
      "paragraphId": {
       "type": "string"
      },
      "partId": {
       "type": "string"
      },
      "sectionId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sectionTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "similarity": {
       "type": "number"
      },
      "sortId": {
       "type": "string"
      },
      "standardReferenceId": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "urantiaParallels": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "embeddingModel": {
          "type": "string"
         },
         "id": {
          "type": "string"
         },
         "paperId": {
          "type": "string"
         },
         "paperTitle": {
          "type": "string"
         },
         "rank": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "sectionTitle": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "similarity": {
          "type": "number"
         },
         "source": {
          "type": "string"
         },
         "standardReferenceId": {
          "type": "string"
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "standardReferenceId",
         "paperId",
         "paperTitle",
         "sectionTitle",
         "text",
         "similarity",
         "rank",
         "source",
         "embeddingModel"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "standardReferenceId",
      "sortId",
      "paperId",
      "sectionId",
      "partId",
      "paperTitle",
      "sectionTitle",
      "paragraphId",
      "text",
      "labels",
      "similarity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "limit": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "totalPages": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
