{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read Mailbox Inbox Attachment"
 },
 "description": "Fetch one attachment from an exact JMAP inbox message. Decodable text attachments are returned in attachment.text; other attachments are embedded resources. The input uses the attachment part ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Mailbox ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "message_id": {
    "description": "JMAP inbox message ID.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "part_id": {
    "description": "Attachment part ID from the inbox message response.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "message_id",
   "part_id"
  ],
  "type": "object"
 },
 "name": "shipmail_read_mailbox_inbox_attachment",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attachment": {
    "properties": {
     "blob_id": {
      "type": "string"
     },
     "content_type": {
      "type": "string"
     },
     "mailbox_id": {
      "type": "string"
     },
     "message_id": {
      "type": "string"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "object": {
      "type": "string"
     },
     "part_id": {
      "type": "string"
     },
     "size": {
      "type": "number"
     },
     "text": {
      "type": "string"
     }
    },
    "required": [
     "part_id",
     "blob_id",
     "name",
     "content_type",
     "size",
     "object",
     "mailbox_id",
     "message_id"
    ],
    "type": "object"
   }
  },
  "required": [
   "attachment"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Read Mailbox Inbox Attachment"
}
