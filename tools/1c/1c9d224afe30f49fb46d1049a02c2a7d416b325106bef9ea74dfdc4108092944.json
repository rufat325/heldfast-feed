{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List site domains"},"description":"List the custom domains of a hosted site, oldest first: the status (pending, active, failed or removing), the cause when a domain is not live, and the TXT and CNAME records to add at the DNS provider of the domain. The answer also gives how many domains one site can have.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"siteId":{"description":"Site id from list_sites","minLength":1,"type":"string"}},"required":["siteId"],"type":"object"},"name":"list_site_domains","outputSchema":{"properties":{"data":{"items":{"properties":{"activatedAt":{"type":["integer","null"]},"cause":{"anyOf":[{"enum":["proof_missing","proof_lost","certificate_pending","certificate_failed","route_missing","hostname_refused"],"type":"string"},{"type":"null"},{"type":"null"}]},"checkedAt":{"type":["integer","null"]},"createdAt":{"type":"integer"},"detail":{"type":["string","null"]},"hostname":{"type":"string"},"records":{"items":{"properties":{"name":{"type":"string"},"type":{"enum":["TXT","CNAME"],"type":"string"},"value":{"type":"string"}},"required":["type","name","value"],"type":"object"},"type":"array"},"siteId":{"type":"string"},"status":{"description":"`pending`: SHIP waits for the DNS proof or the certificate. `active`: the domain serves the site. `failed`: the proof went away or the certificate failed. `removing`: SHIP removes the domain.","enum":["pending","active","failed","removing"],"type":"string"}},"required":["hostname","siteId","status","cause","detail","records","createdAt","checkedAt","activatedAt"],"type":"object"},"type":"array"},"maxPerSite":{"minimum":1,"type":"integer"}},"required":["data","maxPerSite"],"type":"object"},"title":"List site domains"}
