{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Enable or disable PostgreSQL PITR on a managed provider. Deploy scope. Enabling creates a replication slot and stores base backups/WAL in the account bucket; storage usage increases. Disabling stops protection and drops the slot but retains stored objects. A stopped shipper can retain WAL on the server. No restore or traffic cutover. Hosted MCP requires an account credential without resource confinement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The managed PostgreSQL provider deployment, not the consuming app.",
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   },
   "drain_minutes": {
    "maximum": 60,
    "minimum": 5,
    "type": "integer"
   },
   "enabled": {
    "type": "boolean"
   },
   "keep_bases": {
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "deployment_id",
   "enabled"
  ],
  "type": "object"
 },
 "name": "impreza_configure_pitr",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "provider_deployment_id": {
      "type": "string"
     },
     "state": {
      "enum": [
       "enabling",
       "active",
       "degraded",
       "disabling",
       "disabled"
      ],
      "type": "string"
     },
     "updated": {
      "type": "boolean"
     }
    },
    "required": [
     "provider_deployment_id",
     "state",
     "updated"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Configure point-in-time recovery"
}
