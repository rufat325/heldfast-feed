{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Export the hidden-service identity as a versioned JSON key-pair bundle sealed on the customer's server to their X25519 recipient public key with a NaCl/libsodium anonymous sealed box. Generate the recipient keypair locally and keep the private key local; the platform receives ciphertext and cannot decrypt it. Returns command_id; collect the result exactly once with impreza_fetch_onion_key_export and decrypt it locally. Requires manage scope, customer confirmation and an agent with onion-custody-v1. If confirm_token is absent from this connection's input schema, use a connection that exposes it or a supported customer-portal flow. A quote or confirmation request is not completion. IRREVERSIBLE \u2014 takes two calls: the first returns a confirm_token and changes nothing, the second repeats the same arguments plus confirm_token and executes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "type": "boolean"
   },
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "recipient_pubkey": {
    "description": "Base64-encoded 32-byte X25519 public key.",
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "recipient_pubkey",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_export_onion_key",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "command_id": {
      "pattern": "^cmd_[A-Za-z0-9_-]{1,28}$",
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "command_id",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Export encrypted onion identity"
}
