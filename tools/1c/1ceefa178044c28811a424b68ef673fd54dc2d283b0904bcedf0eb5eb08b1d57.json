{
 "_meta": {
  "fastmcp": {
   "tags": [
    "events"
   ]
  }
 },
 "description": "Use when an agent needs events similar to a given event \u2014 cross-platform equivalents and topically-related markets, precomputed nightly from title embeddings. Best-first; empty list (never an error) when no similarities are known yet.",
 "inputSchema": {
  "properties": {
   "event_id": {
    "description": "Event id native to the source.",
    "title": "Event Id",
    "type": "string"
   },
   "limit": {
    "default": 8,
    "description": "Max similar events to return.",
    "title": "Limit",
    "type": "integer"
   },
   "source": {
    "description": "Platform id, e.g. kalshi.",
    "title": "Source",
    "type": "string"
   }
  },
  "required": [
   "source",
   "event_id"
  ],
  "type": "object"
 },
 "name": "get_event_similar",
 "outputSchema": {
  "properties": {
   "_meta": {
    "anyOf": [
     {
      "description": "Agent metadata for list/aggregate responses (no cite_as).",
      "properties": {
       "as_of": {
        "format": "date-time",
        "title": "As Of",
        "type": "string"
       },
       "attribution": {
        "default": "pdata.world \u2014 aggregated prediction-market data across 8 platforms",
        "title": "Attribution",
        "type": "string"
       },
       "canonical_url": {
        "title": "Canonical Url",
        "type": "string"
       },
       "docs": {
        "default": "https://api.pdata.world/docs",
        "title": "Docs",
        "type": "string"
       }
      },
      "required": [
       "canonical_url"
      ],
      "title": "ResponseMetaList",
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "event_id": {
    "title": "Event Id",
    "type": "string"
   },
   "excluded": {
    "default": false,
    "title": "Excluded",
    "type": "boolean"
   },
   "similar": {
    "default": [],
    "items": {
     "description": "One similar EVENT (event-grain \u2014 links to /events/{source}/{id}).",
     "properties": {
      "id": {
       "title": "Id",
       "type": "string"
      },
      "is_cross_platform_equiv": {
       "default": false,
       "title": "Is Cross Platform Equiv",
       "type": "boolean"
      },
      "lead": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Lead"
      },
      "market_count": {
       "default": 0,
       "title": "Market Count",
       "type": "integer"
      },
      "markets": {
       "default": [],
       "items": {
        "description": "One child market of a similar EVENT \u2014 the top few by 24h volume,\nused to render multi-market similar cards. Binary / synthetic / group\nevents leave `SimilarItemOut.markets` empty and fall back to the flat\nprob/\u0394/vol fields instead.",
        "properties": {
         "name": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "title": "Name"
         },
         "prob": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ],
          "title": "Prob"
         },
         "prob_24h_change": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ],
          "title": "Prob 24H Change"
         }
        },
        "title": "SimilarMarketMini",
        "type": "object"
       },
       "title": "Markets",
       "type": "array"
      },
      "prob": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Prob"
      },
      "prob_24h_change": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Prob 24H Change"
      },
      "score": {
       "title": "Score",
       "type": "number"
      },
      "source": {
       "title": "Source",
       "type": "string"
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Title"
      },
      "volume_24hr": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Volume 24Hr"
      }
     },
     "required": [
      "source",
      "id",
      "score"
     ],
     "title": "SimilarItemOut",
     "type": "object"
    },
    "title": "Similar",
    "type": "array"
   },
   "source": {
    "title": "Source",
    "type": "string"
   }
  },
  "required": [
   "source",
   "event_id"
  ],
  "title": "EventSimilarOut",
  "type": "object",
  "x-fastmcp-top-level-schema": "EventSimilarOut"
 }
}
