{
 "description": "Wood adhesive quantity: bond area x spread (g/m2, TDS presets like PVAc D3 175, EGP 250, finger-joint PUR 530) x application faces x waste allowance. Also computes bond area for edge-glued panels (joints from board width) and face lamination lay-ups.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bond_area_m2": {
    "description": "Total bond-line area, m2",
    "minimum": 0,
    "type": "number"
   },
   "density_gcm3": {
    "description": "Glue density g/cm3 to get litres (PVAc ~1.08)",
    "minimum": 0,
    "type": "number"
   },
   "edge_panel": {
    "description": "Edge-glued panel dimensions instead of a direct area",
    "properties": {
     "board_width_mm": {
      "description": "Sawn lamella width - joint count = ceil(width/board)-1",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "panel_length_mm": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "panel_thickness_mm": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "panel_width_mm": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "panels": {
      "default": 1,
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "panel_length_mm",
     "panel_width_mm",
     "board_width_mm",
     "panel_thickness_mm"
    ],
    "type": "object"
   },
   "face_lam": {
    "description": "Face lamination lay-up instead of a direct area",
    "properties": {
     "layers": {
      "maximum": 9007199254740991,
      "minimum": 2,
      "type": "integer"
     },
     "length_mm": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "sets": {
      "default": 1,
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "width_mm": {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "length_mm",
     "width_mm",
     "layers"
    ],
    "type": "object"
   },
   "faces": {
    "default": "1",
    "description": "1 = single-face, 2 = both mating faces",
    "enum": [
     "1",
     "2"
    ],
    "type": "string"
   },
   "price_per_kg": {
    "description": "Glue price per kg",
    "minimum": 0,
    "type": "number"
   },
   "spread_gsm": {
    "description": "Spread rate g/m2 (PVAc D3 one face ~175, EGP ~250, finger PUR ~530)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "waste_pct": {
    "default": 5,
    "description": "Application/squeeze-out waste, %",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "spread_gsm"
  ],
  "type": "object"
 },
 "name": "glue_consumption"
}
