{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Start a thread in a text or announcement channel: standalone, branched from a message when message_id is given, or private (invite-only) when asked. For a post in a forum channel, use create_forum_post instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "auto_archive_minutes": {
    "description": "Inactivity timeout: 60, 1440, 4320, or 10080. Default 1440.",
    "enum": [
     60,
     1440,
     4320,
     10080
    ],
    "type": "number"
   },
   "channel": {
    "description": "Parent channel name or ID.",
    "type": "string"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "message_id": {
    "description": "Branch the thread from this message.",
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "private": {
    "description": "Invite-only thread; only works standalone.",
    "type": "boolean"
   },
   "slowmode_seconds": {
    "maximum": 21600,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "channel",
   "name"
  ],
  "type": "object"
 },
 "name": "create_thread",
 "title": "Create thread"
}
