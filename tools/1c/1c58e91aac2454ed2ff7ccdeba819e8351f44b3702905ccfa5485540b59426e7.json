{
 "description": "Move a card to another column (moving into the column flagged is_done completes it; a 'done' comment does not).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "board_column_id": {
    "description": "Target column id from viralhunt_board_context.",
    "type": "integer"
   },
   "card_id": {
    "type": "integer"
   },
   "position": {
    "description": "Position inside the column (0 = top).",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "card_id",
   "board_column_id"
  ],
  "type": "object"
 },
 "name": "viralhunt_move_card"
}
