{
 "description": "Build practice quiz or certification-style mock from the configured quiz bank with answer key and rubric.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "board": {
    "type": "string"
   },
   "certification_level": {
    "type": "string"
   },
   "count": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "practice_quiz",
     "cert_mock"
    ],
    "type": "string"
   },
   "seed": {
    "type": "string"
   },
   "taal": {
    "type": "string"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "assessment_builder",
 "title": "Assessment Builder"
}
