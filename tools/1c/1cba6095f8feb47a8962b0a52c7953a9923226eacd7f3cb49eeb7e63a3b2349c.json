{
 "description": "Update an existing check item (rename, state, or position).",
 "inputSchema": {
  "properties": {
   "cardId": {
    "description": "ID of the card",
    "type": "string"
   },
   "checkItemId": {
    "description": "ID of the item to update",
    "type": "string"
   },
   "name": {
    "description": "New name (optional)",
    "type": "string"
   },
   "pos": {
    "description": "New position (optional)",
    "type": "string"
   },
   "state": {
    "description": "State (optional)",
    "enum": [
     "complete",
     "incomplete"
    ],
    "type": "string"
   }
  },
  "required": [
   "cardId",
   "checkItemId"
  ],
  "type": "object"
 },
 "name": "update_checkitem"
}
