{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Domain expiry"
 },
 "description": "Reports a domain's registration expiry from WHOIS with the remaining days, plus registrar, creation and update dates and the EPP status codes that reveal redemption or pending delete. Covers the registration, not the TLS certificate (check_ssl). tldSupported=false means the TLD has no queryable WHOIS server, not that the domain is unregistered. Anonymous, rate-limited per IP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Domain name, e.g. deinkunde.com",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "domain_expiry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "createdAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "daysUntilExpiry": {
    "type": [
     "number",
     "null"
    ]
   },
   "domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "expiresAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "found": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "ok": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "registrar": {
    "type": [
     "string",
     "null"
    ]
   },
   "statuses": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "tld": {
    "type": [
     "string",
     "null"
    ]
   },
   "tldSupported": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "updatedAt": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "title": "Domain expiry"
}
