{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Verify a reversible AST patch against source, apply or undo it, and return a minimal stale-guarded UTF-8 source edit without writing files.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "inverse": {
    "default": false,
    "description": "Apply inverse operations to undo the patch.",
    "type": "boolean"
   },
   "patch": {
    "additionalProperties": false,
    "description": "Version 1 reversible AST patch (maximum 1000000 JSON bytes and 1000 operations per direction)",
    "properties": {
     "afterFingerprint": {
      "type": "string"
     },
     "beforeFingerprint": {
      "type": "string"
     },
     "changes": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "kind": {
         "enum": [
          "add",
          "remove",
          "replace"
         ],
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "summary": {
         "type": "string"
        },
        "target": {
         "type": "string"
        }
       },
       "required": [
        "kind",
        "path",
        "target",
        "summary"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "forward": {
      "items": {},
      "maxItems": 1000,
      "type": "array"
     },
     "inverse": {
      "items": {},
      "maxItems": 1000,
      "type": "array"
     },
     "version": {
      "maximum": 255,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "version",
     "forward",
     "inverse",
     "beforeFingerprint",
     "afterFingerprint"
    ],
    "type": "object"
   },
   "source": {
    "description": "Document source (maximum 1000000 UTF-8 bytes)",
    "type": "string"
   }
  },
  "required": [
   "source",
   "patch"
  ],
  "type": "object"
 },
 "name": "carve_apply_reversible_ast_patch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "ast": {},
   "direction": {
    "enum": [
     "forward",
     "inverse"
    ],
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "sourcePatch": {
    "additionalProperties": false,
    "properties": {
     "edits": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "minLength": 1,
         "type": "string"
        },
        "end": {
         "description": "Exclusive UTF-8 byte offset",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "kind": {
         "enum": [
          "formatting",
          "syntax-migration",
          "quick-fix",
          "refactor"
         ],
         "type": "string"
        },
        "replacement": {
         "type": "string"
        },
        "start": {
         "description": "Inclusive UTF-8 byte offset",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "start",
        "end",
        "replacement",
        "kind",
        "code"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "sourceBytes": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "sourceFingerprint": {
      "pattern": "^fnv1a64:[0-9a-f]{16}$",
      "type": "string"
     },
     "unresolved": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "minLength": 1,
         "type": "string"
        },
        "end": {
         "description": "Exclusive UTF-8 byte offset",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "kind": {
         "enum": [
          "formatting",
          "syntax-migration",
          "quick-fix",
          "refactor"
         ],
         "type": "string"
        },
        "message": {
         "minLength": 1,
         "type": "string"
        },
        "replacement": {
         "type": "string"
        },
        "start": {
         "description": "Inclusive UTF-8 byte offset",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "start",
        "end",
        "replacement",
        "kind",
        "code",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "version": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "version",
     "sourceFingerprint",
     "sourceBytes",
     "edits",
     "unresolved"
    ],
    "type": "object"
   }
  },
  "required": [
   "direction",
   "ast",
   "source",
   "sourcePatch"
  ],
  "type": "object"
 },
 "title": "Preview reversible AST patch as source edits"
}
