{
 "description": "Create a new in-app product (managed product)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultDescription": {
    "description": "Default product description",
    "type": "string"
   },
   "defaultLanguage": {
    "description": "Default language (e.g. en-US)",
    "type": "string"
   },
   "defaultPriceCurrencyCode": {
    "description": "Currency code (e.g. USD)",
    "type": "string"
   },
   "defaultPriceMicros": {
    "description": "Price in micros (e.g. 990000 for $0.99)",
    "type": "string"
   },
   "defaultTitle": {
    "description": "Default product title",
    "type": "string"
   },
   "packageName": {
    "description": "Android package name",
    "type": "string"
   },
   "purchaseType": {
    "default": "managedUser",
    "enum": [
     "managedUser",
     "subscription"
    ],
    "type": "string"
   },
   "sku": {
    "description": "Product SKU (unique identifier)",
    "type": "string"
   },
   "status": {
    "default": "active",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "sku",
   "defaultLanguage",
   "defaultTitle",
   "defaultDescription",
   "defaultPriceCurrencyCode",
   "defaultPriceMicros"
  ],
  "type": "object"
 },
 "name": "google_create_iap"
}
