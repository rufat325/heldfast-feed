       "type": "string"
      }
     },
     "required": [
      "device_hint",
      "output_type",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "source": {
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "snapshots"
  ],
  "type": "object"
 },
 "name": "analyze_network_path",
