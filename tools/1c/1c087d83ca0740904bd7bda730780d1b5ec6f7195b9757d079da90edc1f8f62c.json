       "enum": [
        "cdp",
        "lldp",
        "route",
        "traceroute"
       ],
       "type": "string"
      },
      "remote_interface": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
