{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get room offers (quote)"
 },
 "description": "Quote a stay: bookable offers with total price and units available per room for given dates and guests. Use before creating a booking. Beds24: GET /inventory/rooms/offers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentCode": {
    "type": "string"
   },
   "arrival": {
    "description": "Arrival date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departure": {
    "description": "Departure date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "includeTexts": {
    "description": "Include descriptive texts in these 2-letter languages, e.g. [\"en\"].",
    "items": {
     "maxLength": 2,
     "minLength": 2,
     "type": "string"
    },
    "type": "array"
   },
   "numAdults": {
    "description": "Number of adults.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "numChildren": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offerIds": {
    "description": "One or more offer ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "page": {
    "description": "Page number beyond the first (2, 3, ...). Check pages.nextPageExists in the previous response.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "propertyIds": {
    "description": "One or more property ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "roomIds": {
    "description": "One or more room ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "arrival",
   "departure",
   "numAdults"
  ],
  "type": "object"
 },
 "name": "beds24_get_room_offers",
 "title": "Get room offers (quote)"
}
