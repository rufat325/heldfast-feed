{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add a student"
 },
 "description": "Adds a student to the trainer's account, like \"Adicionar aluno\" in the app: the student gets an e-mail invite to install the app and see workouts. Name and e-mail are required; goal, weight, height, birth date and sex are optional. Respects the student limit of the trainer's plan.",
 "inputSchema": {
  "properties": {
   "birth_date": {
    "description": "YYYY-MM-DD.",
    "maxLength": 10,
    "type": "string"
   },
   "email": {
    "description": "Student e-mail (the invite goes there).",
    "maxLength": 255,
    "type": "string"
   },
   "goal": {
    "description": "Goal, e.g. hipertrofia, emagrecimento.",
    "maxLength": 255,
    "type": "string"
   },
   "height_cm": {
    "description": "Height in cm.",
    "type": "number"
   },
   "name": {
    "description": "Student full name.",
    "maxLength": 255,
    "type": "string"
   },
   "phone": {
    "description": "Phone with area code.",
    "maxLength": 30,
    "type": "string"
   },
   "sex": {
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "weight_kg": {
    "description": "Weight in kg.",
    "type": "number"
   }
  },
  "required": [
   "name",
   "email"
  ],
  "type": "object"
 },
 "name": "create_student",
 "securitySchemes": [
  {
   "scopes": [
    "mcp:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add a student"
}
