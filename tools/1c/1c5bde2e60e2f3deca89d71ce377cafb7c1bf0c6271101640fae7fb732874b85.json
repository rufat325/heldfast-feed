{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Carrier, tracking number and tracking link for each shipment of an order, and the delivery estimate.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "order_id": {
    "description": "order_id returned by purchase.",
    "type": "string"
   }
  },
  "required": [
   "order_id"
  ],
  "type": "object"
 },
 "name": "track_order",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "delivery_estimate_business_days": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "max": {
        "type": [
         "number",
         "null"
        ]
       },
       "min": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "min",
       "max"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null when the order ended (cancelled, refunded, rejected, expired or delivered)."
   },
   "next_step": {
    "description": "What the agent should do next, in plain language.",
    "type": "string"
   },
   "order_id": {
    "type": "string"
   },
   "order_url": {
    "type": "string"
   },
   "shipments": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "carrier": {
       "type": [
        "string",
        "null"
       ]
      },
      "tracking_number": {
       "type": [
        "string",
        "null"
       ]
      },
      "tracking_url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "carrier",
      "tracking_number",
      "tracking_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "AWAITING_PAYMENT",
     "PAID",
     "VALIDATING",
     "SUBMITTING",
     "SUBMITTED",
     "IN_PRODUCTION",
     "SHIPPED",
     "DELIVERED",
     "QUOTE_EXPIRED",
     "PAYMENT_FAILED",
     "REJECTED",
     "SUBMISSION_FAILED",
     "CANCELLED",
     "REFUND_PENDING",
     "REFUNDED",
     "DISPUTED"
    ],
    "type": "string"
   },
   "tracking_available": {
    "type": "boolean"
   }
  },
  "required": [
   "order_id",
   "status",
   "next_step",
   "order_url",
   "shipments",
   "delivery_estimate_business_days",
   "tracking_available"
  ],
  "type": "object"
 },
 "title": "Track shipment"
}
