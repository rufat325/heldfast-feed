{
 "description": "Create multiple QR codes in a single request (up to 50). Each item supports the same options as create_qr_code. The quota check is all-or-nothing: if the batch would exceed your plan limit, no QR codes are created. Ideal for generating QR codes for product catalogs, event lists, or batch operations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "description": "Array of QR codes to create. Max 50 per request.",
    "items": {
     "properties": {
      "background_color": {
       "description": "Hex color for background.",
       "pattern": "^#[0-9A-Fa-f]{6}$",
       "type": "string"
      },
      "corner_style": {
       "description": "Corner shape.",
       "enum": [
        "square",
        "extra-rounded",
        "dot"
       ],
       "type": "string"
      },
      "dot_style": {
       "description": "Dot shape.",
       "enum": [
        "square",
        "rounded",
        "dots",
        "classy-rounded"
       ],
       "type": "string"
      },
      "expires_at": {
       "description": "ISO 8601 expiration date.",
       "type": "string"
      },
      "foreground_color": {
       "description": "Hex color for dots.",
       "pattern": "^#[0-9A-Fa-f]{6}$",
       "type": "string"
      },
      "format": {
       "default": "svg",
       "description": "Image format.",
       "enum": [
        "svg",
        "png"
       ],
       "type": "string"
      },
      "label": {
       "description": "Optional label.",
       "type": "string"
      },
      "logo_url": {
       "description": "Logo URL or data URI.",
       "type": "string"
      },
      "scheduled_at": {
       "description": "ISO 8601 activation date for scheduled_url.",
       "type": "string"
      },
      "scheduled_url": {
       "description": "Replacement URL activated at scheduled_at.",
       "format": "uri",
       "type": "string"
      },
      "target_url": {
       "description": "The destination URL.",
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "target_url"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "bulk_create_qr_codes"
}
