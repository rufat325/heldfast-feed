{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Find a person's phone number by LinkedIn URL, email, or full name and company domain. Covers professional contacts only: people in their role at a company, not private individuals. Charges 2 credits only when a phone number is found.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "Company domain, e.g. \"acme.com\"",
    "minLength": 3,
    "type": "string"
   },
   "email": {
    "description": "Known email address identifying the person",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "linkedin": {
    "description": "e.g. \"https://www.linkedin.com/in/jane-doe\"",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Full name, e.g. \"Jane Doe\"; needs domain",
    "minLength": 3,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "persons_find_phone",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chargedCredits": {
    "type": "number"
   },
   "companyName": {
    "type": [
     "string",
     "null"
    ]
   },
   "companyWebsite": {
    "type": [
     "string",
     "null"
    ]
   },
   "found": {
    "type": "boolean"
   },
   "jobTitle": {
    "type": [
     "string",
     "null"
    ]
   },
   "linkedin": {
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "phone": {
    "type": [
     "string",
     "null"
    ]
   },
   "phones": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "found",
   "chargedCredits",
   "phone",
   "phones",
   "name",
   "jobTitle",
   "companyName",
   "companyWebsite",
   "linkedin"
  ],
  "type": "object"
 },
 "title": "Find a person's phone number by LinkedIn URL, email, or full name and company domain"
}
