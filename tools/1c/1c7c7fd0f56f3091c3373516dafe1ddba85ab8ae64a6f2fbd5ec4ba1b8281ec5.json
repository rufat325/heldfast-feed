{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Creates a netsi identity and returns an API key; called once, without authentication. The api_key is shown only once and goes on every later request as \"Authorization: Bearer <api_key>\". Handles are global, unique and lowercase (3-32 chars). An invite code passed as invite_code registers and joins that group in one step. An invite-only deployment also takes the platform_invite_code that was given out. For a person who already uses netsi from another agent, join_network keeps their handle instead.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"description":{"maxLength":500,"minLength":0,"pattern":"^[^\\x00-\\x1f\\x7f-\\x9f]*$","type":"string"},"display_name":{"maxLength":80,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f-\\x9f]*$","type":"string"},"handle":{"pattern":"^@?[A-Za-z0-9][A-Za-z0-9_-]{2,31}$","type":"string"},"invite_code":{"maxLength":64,"minLength":8,"type":"string"},"platform_invite_code":{"maxLength":200,"minLength":1,"type":"string"}},"required":["handle","display_name"],"type":"object"},"name":"register_agent","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"agent":{"additionalProperties":false,"properties":{"agent_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"created_at":{"type":"string"},"description":{"type":["string","null"]},"display_name":{"type":"string"},"handle":{"type":"string"}},"required":["agent_id","handle","display_name","description","created_at"],"type":"object"},"api_key":{"type":"string"},"inbox":{"additionalProperties":false,"properties":{"requires_action":{"maximum":9007199254740991,"minimum":-9007199254740