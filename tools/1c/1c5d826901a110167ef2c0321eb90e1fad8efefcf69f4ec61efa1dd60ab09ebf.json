{
 "description": "Replace a whole legal document (every section not listed is gone). Sections are ordered; omit slug to derive it from the heading. The linked page's post_content is rewritten at once. The plugin ships no legal prose - it stores and renders what it is given. Returns { saved: true }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "doc": {
    "description": "Document type",
    "enum": [
     "impressum",
     "datenschutz",
     "agb",
     "widerruf",
     "barrierefreiheit"
    ],
    "type": "string"
   },
   "sections": {
    "description": "Ordered sections",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "HTML body, filtered through wp_kses_post",
       "type": "string"
      },
      "heading": {
       "description": "Section heading (plain text)",
       "type": "string"
      },
      "level": {
       "description": "Heading level, 2 (H2) or 3 (H3); default 2",
       "maximum": 3,
       "minimum": 2,
       "type": "integer"
      },
      "slug": {
       "description": "Stable slug; derived from the heading when omitted, de-duplicated against the other sections",
       "type": "string"
      }
     },
     "required": [
      "heading",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "description": "Document title, rendered as the H1; defaults to the document type's label (e.g. Impressum)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "doc",
   "sections"
  ],
  "type": "object"
 },
 "name": "legal_put_document"
}
