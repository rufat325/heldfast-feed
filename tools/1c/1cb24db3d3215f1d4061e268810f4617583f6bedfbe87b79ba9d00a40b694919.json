{
 "description": "Create an electronic invoice (Factura Electr\u00f3nica) via AFIP",
 "inputSchema": {
  "properties": {
   "amount_iva": {
    "description": "IVA tax amount",
    "type": "number"
   },
   "amount_net": {
    "description": "Net taxable amount",
    "type": "number"
   },
   "amount_total": {
    "description": "Total invoice amount",
    "type": "number"
   },
   "concept": {
    "description": "Concept (1=Products, 2=Services, 3=Both)",
    "type": "number"
   },
   "currency": {
    "description": "Currency code (PES=ARS, DOL=USD)",
    "type": "string"
   },
   "doc_number": {
    "description": "Document number of the customer",
    "type": "number"
   },
   "doc_type": {
    "description": "Document type (80=CUIT, 86=CUIL, 96=DNI, 99=Consumer Final)",
    "type": "number"
   },
   "invoice_type": {
    "description": "Invoice type code (1=A, 6=B, 11=C, etc.)",
    "type": "number"
   },
   "items": {
    "description": "Invoice line items",
    "items": {
     "properties": {
      "description": {
       "description": "Item description",
       "type": "string"
      },
      "iva_rate": {
       "description": "IVA rate (21, 10.5, 27, 0)",
       "type": "number"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      },
      "unit_price": {
       "description": "Unit price",
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity",
      "unit_price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "point_of_sale": {
    "description": "Punto de venta number",
    "type": "number"
   }
  },
  "required": [
   "point_of_sale",
   "invoice_type",
   "concept",
   "doc_type",
   "doc_number",
   "amount_total"
  ],
  "type": "object"
 },
 "name": "create_invoice"
}
