{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search published jobs on the Workable job board.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Restrict to a single company by id",
    "type": "string"
   },
   "day_range": {
    "description": "Restrict to jobs posted in the last N days",
    "minimum": 0,
    "type": "integer"
   },
   "employment_type": {
    "description": "Filter by employment types",
    "items": {
     "enum": [
      "full",
      "part",
      "contract",
      "temporary",
      "internship"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "location": {
    "description": "City, region, or country to filter by",
    "type": "string"
   },
   "pageToken": {
    "description": "Opaque cursor returned as nextPageToken from a previous call; pass with the same filters to fetch the next page",
    "type": "string"
   },
   "query": {
    "description": "Free-text search across job title, description, skills, company, name",
    "type": "string"
   },
   "workplace": {
    "description": "Filter by workplace types",
    "items": {
     "enum": [
      "on_site",
      "hybrid",
      "remote"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_jobs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefits": {
       "type": "string"
      },
      "company": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": [
          "string",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "department": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "employmentType": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "remote": {
       "type": "boolean"
      },
      "requirements": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "uid": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "workplace": {
       "enum": [
        "on_site",
        "hybrid",
        "remote"
       ],
       "type": "string"
      }
     },
     "required": [
      "title",
      "location"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextPageToken": {
    "type": "string"
   },
   "totalItems": {
    "type": "number"
   }
  },
  "required": [
   "totalItems",
   "jobs"
  ],
  "type": "object"
 },
 "title": "Search jobs"
}
