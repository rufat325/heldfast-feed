{
 "description": "Apply surgical edits to an existing workflow without rewriting it. Operations: setName, addNode, removeNode, updateNode, addConnection, removeConnection. Fetches the current workflow, applies the ops, and saves.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Workflow ID",
    "type": "string"
   },
   "operations": {
    "description": "List of edits to apply in order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "node": {
       "additionalProperties": {},
       "type": "object"
      },
      "op": {
       "enum": [
        "setName",
        "addNode",
        "removeNode",
        "updateNode",
        "addConnection",
        "removeConnection"
       ],
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "type": "object"
      },
      "source": {
       "type": "string"
      },
      "sourceOutput": {
       "type": "number"
      },
      "target": {
       "type": "string"
      },
      "targetInput": {
       "type": "number"
      },
      "typeVersion": {
       "type": "number"
      }
     },
     "required": [
      "op"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "validate": {
    "description": "Validate before saving (default true)",
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "operations"
  ],
  "type": "object"
 },
 "name": "n8n_update_workflow_partial"
}
