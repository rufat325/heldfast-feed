{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Everything due or happening for the signed-in student across all ELMS (Canvas) courses in a date range (default: the next 14 days): assignments, quizzes, announcements, events and notes, with submission status. The best single \"what's due\" feed. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "end_date": {
    "description": "Last day to include (default: 14 days from today)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "start_date": {
    "description": "First day to include (default: today)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "elms_get_planner",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "In date order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "completed": {
       "description": "Marked complete in the planner",
       "type": "boolean"
      },
      "course_id": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "course_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "description": "When it is due or happens",
       "type": [
        "string",
        "null"
       ]
      },
      "graded": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "id": {
       "description": "Id of the assignment, announcement, quiz, ... this item is about",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "late": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "missing": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "points_possible": {
       "type": [
        "number",
        "null"
       ]
      },
      "submitted": {
       "description": "Submission status for assignments; null otherwise",
       "type": [
        "boolean",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "type": {
       "enum": [
        "announcement",
        "assignment",
        "discussion_topic",
        "quiz",
        "wiki_page",
        "planner_note",
        "calendar_event",
        "assessment_request"
       ],
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "type",
      "id",
      "title",
      "date",
      "course_id",
      "course_name",
      "points_possible",
      "submitted",
      "graded",
      "missing",
      "late",
      "completed",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "title": "Get ELMS planner"
}
