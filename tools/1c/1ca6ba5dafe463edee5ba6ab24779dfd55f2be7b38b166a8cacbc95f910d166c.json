{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud Insight event rule group for monitoring alerts. Links existing monitor groups (targets) and metrics groups (rule templates) and optional notification recipients.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asgPolicyList": {
    "description": "Auto Scaling group policies",
    "items": {
     "additionalProperties": false,
     "properties": {
      "autoScalingGroupNo": {
       "description": "Auto Scaling group number",
       "type": "number"
      },
      "autoScalingPolicyNo": {
       "description": "Auto Scaling policy number",
       "type": "number"
      },
      "policyName": {
       "description": "Auto Scaling policy name",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "dryRun": {
    "description": "If true, returns a preview without creating the rule group (default: false)",
    "type": "boolean"
   },
   "groupDesc": {
    "description": "Description (<= 300 chars)",
    "type": "string"
   },
   "groupName": {
    "description": "Name of the rule group (1-1000 chars)",
    "type": "string"
   },
   "metricsGroupKey": {
    "description": "Metrics group (rule template) IDs to apply (at least one)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "monitorGroupKey": {
    "description": "Monitor group (target group) IDs to monitor (at least one)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "personalNotificationRecipients": {
    "description": "Personal notification recipients",
    "items": {
     "$ref": "#/properties/recipientNotifications/items"
    },
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key) for the target service",
    "type": "string"
   },
   "recipientNotifications": {
    "description": "Notification recipient groups",
    "items": {
     "additionalProperties": false,
     "properties": {
      "enableNotiWhenEventClose": {
       "description": "Send a notification when the event closes",
       "type": "boolean"
      },
      "groupName": {
       "description": "Notification recipient group name",
       "type": "string"
      },
      "groupNum": {
       "description": "Notification recipient group number",
       "type": "number"
      },
      "notifyTypes": {
       "description": "Notification methods (SMS, EMAIL)",
       "items": {
        "enum": [
         "SMS",
         "EMAIL"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "reminderTime": {
       "description": "Reminder interval in minutes (5-720)",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "suspendRuleItems": {
    "description": "Rule items to suspend ([{resourceId, metricGroupItemId}])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "metricGroupItemId": {
       "description": "Metric item ID",
       "type": "string"
      },
      "resourceId": {
       "description": "Monitoring target ID",
       "type": "string"
      }
     },
     "required": [
      "resourceId",
      "metricGroupItemId"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "prodKey",
   "groupName",
   "metricsGroupKey",
   "monitorGroupKey"
  ],
  "type": "object"
 },
 "name": "ncloud_create_rule_group"
}
