{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "News nearby"
 },
 "description": "News near a place in Croatia or near coordinates, within a radius in km: e.g. place=\"Zadar\", radius_km=50 gives everything in and around Zadar. Accepts Croatian place names in any grammatical case (\"u Zadru\", \"Splitu\", \"Dugo Selo\") or lat/lon. Filter by kinds (fire, crash, crime, storm, \u2026) or urgent_only. Each result has the distance, place name, kind, how many portals reported it and every portal's link. Use for \"what's happening near me / in <town>\".",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "hours": {
    "description": "How many hours back (default 24, at most 720).",
    "type": "integer"
   },
   "include_filler": {
    "description": "Filler (horoscopes, quizzes, reality shows, celebrity gossip, promos) is left out of every list; true brings it back.",
    "type": "boolean"
   },
   "kinds": {
    "description": "Kinds of map stories, e.g. fire,crash,crime (see /v1/categories).",
    "items": {
     "enum": [
      "waste",
      "fire",
      "fire-out",
      "crash",
      "crime",
      "explosion",
      "quake",
      "flood",
      "storm",
      "rescue",
      "missing",
      "protest",
      "politics",
      "economy",
      "sport",
      "culture",
      "world",
      "other"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "lat": {
    "description": "Latitude (instead of a place).",
    "type": "number"
   },
   "limit": {
    "description": "How many results (default 20, at most what the plan allows).",
    "type": "integer"
   },
   "lon": {
    "description": "Longitude.",
    "type": "number"
   },
   "place": {
    "description": "A place in Croatia, however written: \"Zadar\", \"u Zadru\", \"Dugo Selo\", \"otok Krk\".",
    "type": "string"
   },
   "radius_km": {
    "description": "Radius in km (default 25, at most what the plan allows).",
    "type": "number"
   },
   "sort": {
    "description": "distance (default), newest or importance.",
    "enum": [
     "distance",
     "newest",
     "importance"
    ],
    "type": "string"
   },
   "urgent_only": {
    "description": "Only what matters: fires, crashes, explosions, earthquakes, floods, storms, rescues, missing people and big stories.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_nearby_news",
 "outputSchema": {
  "properties": {
   "data": {
    "items": {
     "properties": {
      "distance_km": {
       "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
       "type": [
        "string",
        "number",
        "null"
       ]
      },
      "first_reported_at": {
       "format": "date-time",
       "type": "string"
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "image_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "kind": {
       "type": "string"
      },
      "kind_name": {
       "type": "string"
      },
      "latitude": {
       "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
       "type": [
        "string",
        "number"
       ]
      },
      "longitude": {
       "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
       "type": [
        "string",
        "number"
       ]
      },
      "place": {
       "type": "string"
      },
      "portals": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "precision": {
       "type": "string"
      },
      "reports": {
       "items": {
        "properties": {
         "published_at": {
          "format": "date-time",
          "type": "string"
         },
         "source": {
          "type": "string"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "source",
         "title",
         "url",
         "published_at"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "source": {
       "type": "string"
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "urgent": {
       "type": "boolean"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "url",
      "source",
      "portals",
      "first_reported_at",
      "kind",
      "kind_name",
      "urgent",
      "place",
      "precision",
      "latitude",
      "longitude",
      "reports"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "description": "count, plan, include_filler, the limits applied (e.g. radius_limited_to), and for a nearby search its center.",
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "News nearby"
}
