{
 "_meta": {
  "openai/toolInvocation/invoked": "Done: Get YouTube video transcript",
  "openai/toolInvocation/invoking": "Get YouTube video transcript..."
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch the full transcript of a YouTube video URL or ID as plain text, timestamped segments, SRT or VTT, optionally in a chosen or translated language. Use when the user asks to summarize, quote, search, or analyze a YouTube video, since the model cannot watch video. Takes one video per call. Returns one result with title, channel, language, whether captions are auto-generated, whether it fell back to another language, text and segments; a video without captions or one YouTube blocks comes back as status \"error\" with a code and retryable flag.",
 "inputSchema": {
  "properties": {
   "fallbackToAnyLanguage": {
    "description": "When none of the languages exist, return the video's original-language transcript (languageFallback: true) instead of an error. Defaults to true",
    "type": "boolean"
   },
   "format": {
    "description": "segments = timestamped JSON plus text (default), text = plain text only, srt/vtt = subtitle file",
    "enum": [
     "segments",
     "text",
     "srt",
     "vtt"
    ],
    "type": "string"
   },
   "languages": {
    "description": "Language codes in priority order, e.g. [\"en\", \"pt-BR\"]; a code also matches its regional variants. Defaults to [\"en\"]",
    "items": {
     "maxLength": 12,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "translateTo": {
    "description": "Translate the transcript into this language code when YouTube offers it",
    "maxLength": 12,
    "type": "string"
   },
   "video": {
    "description": "YouTube video URL (watch, youtu.be, shorts, embed, live) or 11-character video ID",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "video"
  ],
  "type": "object"
 },
 "name": "get_transcript",
 "outputSchema": {
  "properties": {
   "cache": {
    "description": "How the result was served: HIT or STALE from a cache tier, MISS or BYPASS when it was fetched now.",
    "properties": {
     "ageSeconds": {
      "type": "number"
     },
     "source": {
      "enum": [
       "worker",
       "origin",
       "coalesced"
      ],
      "type": "string"
     },
     "status": {
      "enum": [
       "HIT",
       "STALE",
       "MISS",
       "BYPASS"
      ],
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "ttlSeconds": {
      "type": "number"
     }
    },
    "required": [
     "status",
     "tier",
     "ageSeconds",
     "ttlSeconds"
    ],
    "type": "object"
   },
   "results": {
    "description": "One row for the video: the transcript, or an error with a code.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": true,
       "properties": {
        "channelName": {
         "type": [
          "string",
          "null"
         ]
        },
        "format": {
         "enum": [
          "segments",
          "text",
          "srt",
          "vtt"
         ],
         "type": "string"
        },
        "isGenerated": {
         "type": "boolean"
        },
        "language": {
         "type": "string"
        },
        "languageCode": {
         "type": "string"
        },
        "languageFallback": {
         "type": "boolean"
        },
        "segmentCount": {
         "type": "number"
        },
        "segments": {
         "items": {
          "properties": {
           "duration": {
            "type": "number"
           },
           "start": {
            "type": "number"
           },
           "text": {
            "type": "string"
           }
          },
          "required": [
           "text",
           "start",
           "duration"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "status": {
         "const": "ok"
        },
        "subtitles": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "title": {
         "type": [
          "string",
          "null"
         ]
        },
        "translatedFrom": {
         "type": [
          "string",
          "null"
         ]
        },
        "videoId": {
         "type": "string"
        }
       },
       "required": [
        "status",
        "videoId",
        "languageCode",
        "isGenerated",
        "languageFallback",
        "format",
        "text",
        "segmentCount"
       ],
       "type": "object"
      },
      {
       "additionalProperties": true,
       "properties": {
        "error": {
         "additionalProperties": true,
         "properties": {
          "code": {
           "type": "string"
          },
          "message": {
           "type": "string"
          },
          "retryable": {
           "type": "boolean"
          }
         },
         "required": [
          "code",
          "message",
          "retryable"
         ],
         "type": "object"
        },
        "status": {
         "const": "error"
        },
        "videoId": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "status",
        "error"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "cache"
  ],
  "type": "object"
 },
 "title": "Get YouTube video transcript"
}
