{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Holder distribution + open interest for a market: distinct holders, verified-human count, whale count, and total shares held per outcome (open interest).",
 "inputSchema": {
  "$defs": {
   "EvmAddress": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "properties": {
   "address": {
    "$ref": "#/$defs/EvmAddress",
    "description": "Market contract address."
   },
   "chainId": {
    "description": "Chain id; probes enabled chains if omitted.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "problee_get_market_holders",
 "outputSchema": {
  "$defs": {
   "DiscoverMarketHoldersResponse": {
    "additionalProperties": false,
    "properties": {
     "chainId": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "holders": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "marketAddress": {
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "type": "string"
     },
     "openInterest": {
      "additionalProperties": false,
      "properties": {
       "outcome1": {
        "minimum": 0,
        "type": "number"
       },
       "outcome2": {
        "minimum": 0,
        "type": "number"
       },
       "outcome3": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "outcome1",
       "outcome2",
       "outcome3"
      ],
      "type": "object"
     },
     "verifiedHolders": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "whales": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "chainId",
     "marketAddress",
     "holders",
     "verifiedHolders",
     "whales",
     "openInterest"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverMarketHoldersResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Holder distribution + open interest for a market"
}
