{
 "description": "Look up a WordPress.org plugin's install base, downloads, ratings, and support stats by slug; public API, no credentials or API key needed",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "downloadDays": {
    "default": 30,
    "description": "Days of daily download history to fetch; 0 skips it",
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "includeVersionDistribution": {
    "default": true,
    "description": "Also fetch the share of active installs on each plugin version",
    "type": "boolean"
   },
   "slug": {
    "description": "WordPress.org plugin slug, e.g. akismet",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "wporg_plugin",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeInstalls": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "activeInstallsIsBucketed": {
    "type": "boolean"
   },
   "added": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dailyDownloads": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "date": {
         "type": "string"
        },
        "downloads": {
         "type": "number"
        }
       },
       "required": [
        "date",
        "downloads"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "downloadLink": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "downloadSummary": {
    "anyOf": [
     {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "downloaded": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "lastUpdated": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "numRatings": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "possiblyLagging": {
    "type": "boolean"
   },
   "rating": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "ratings": {
    "anyOf": [
     {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "requires": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "requiresPhp": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "slug": {
    "type": "string"
   },
   "supportThreads": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "supportThreadsResolved": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tested": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "version": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "versionCount": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "versionDistribution": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "percentage": {
         "type": "number"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "version",
        "percentage"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "slug",
   "name",
   "version",
   "activeInstalls",
   "downloaded",
   "numRatings",
   "rating",
   "supportThreads",
   "supportThreadsResolved",
   "tested",
   "added",
   "lastUpdated",
   "requires",
   "requiresPhp",
   "downloadLink",
   "versionCount",
   "activeInstallsIsBucketed",
   "ratings",
   "dailyDownloads",
   "downloadSummary",
   "versionDistribution",
   "tags",
   "possiblyLagging",
   "notes"
  ],
  "type": "object"
 }
}
