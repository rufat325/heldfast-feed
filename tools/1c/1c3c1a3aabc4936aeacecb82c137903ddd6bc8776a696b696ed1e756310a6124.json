 "description": "Searches the competitive briefs Debriefing publishes on debriefing.io about named companies, newest first. Each brief is dated and every finding cites a public source. Filter by words in the brief and by company name, slug, or domain. With no arguments, lists the newest briefs. Needs no Debriefing account. Returns the page URL of each brief.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "A company name, slug, or domain, such as Crayon or crayon.co",
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to find in the brief, such as pricing or launch",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_public_briefs",
