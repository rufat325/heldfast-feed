{
 "description": "Create a sitelink asset (link text + final URL, optional 2 description lines) and attach it to a campaign. Refs #5764.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignId": {
    "description": "Campaign to attach the sitelink to.",
    "type": "string"
   },
   "customerId": {
    "description": "Google Ads customer ID. Defaults to GOOGLE_ADS_CUSTOMER_ID env var.",
    "type": "string"
   },
   "description1": {
    "description": "Optional description line 1 (\u226435 chars).",
    "maxLength": 35,
    "type": "string"
   },
   "description2": {
    "description": "Optional description line 2 (\u226435 chars).",
    "maxLength": 35,
    "type": "string"
   },
   "finalUrl": {
    "description": "Destination URL.",
    "type": "string"
   },
   "linkText": {
    "description": "Sitelink text (\u226425 chars).",
    "maxLength": 25,
    "type": "string"
   }
  },
  "required": [
