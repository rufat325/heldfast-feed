{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "MAINNET launch: Prefer explicit crew[] (from crew_list_kols). Autohire is a fallback convenience. Creates a Pump.fun coin with on-chain fee-shares (60/15/25 default; 60/15/5/20 with referral). Approval optional; requires CREW_AGENT_API_KEY + CREW_LAUNCHER_KEY. Check feeShareLocked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentModel": {
    "description": "e.g. claude, gpt, gemini, grok",
    "maxLength": 48,
    "type": "string"
   },
   "agentName": {
    "maxLength": 48,
    "minLength": 2,
    "type": "string"
   },
   "agentObjective": {
    "maxLength": 280,
    "minLength": 8,
    "type": "string"
   },
   "crew": {
    "description": "Explicit crew (shares must total 100%) overrides Autohire when provided",
    "items": {
     "properties": {
      "evmWallet": {
       "maxLength": 42,
       "minLength": 42,
       "type": "string"
      },
      "handle": {
       "type": "string"
      },
      "hireRole": {
       "enum": [
        "caller",
        "chart",
        "raid",
        "kol",
        "dev"
       ],
       "type": "string"
      },
      "share": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      },
      "wallet": {
       "maxLength": 64,
       "minLength": 20,
       "type": "string"
      }
     },
     "required": [
      "handle",
      "wallet",
      "share"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "description": {
    "description": "\u2264204 chars; attribution appended to reach \u2264240 final",
    "maxLength": 204,
    "type": "string"
   },
   "dryRunId": {
    "description": "Optional unless the API key has requireApproval=true",
    "maxLength": 64,
    "minLength": 16,
    "type": "string"
   },
   "holderKol": {
    "description": "Open Holder-KOL (fees unlocked until crew_lock_holder_kol)",
    "type": "boolean"
   },
   "idempotencyKey": {
    "description": "Retry-safe key; replays cached launch for 15m",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "imageBase64": {
    "minLength": 64,
    "type": "string"
   },
   "imageUrl": {
    "description": "Public image URL (or use imageBase64)",
    "format": "uri",
    "type": "string"
   },
   "initialBuySol": {
    "description": "Dev buy 0\u201310 SOL (site+API aligned)",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "launcherKey": {
    "description": "FORBIDDEN \u2014 rejected if set. Use CREW_LAUNCHER_KEY in MCP env only.",
    "type": "string"
   },
   "mode": {
    "enum": [
     "agent",
     "split",
     "buyback",
     "raid"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "privateKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "seats": {
    "description": "Autohire seats when crew omitted",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "secretKey": {
    "description": "FORBIDDEN \u2014 rejected if set.",
    "type": "string"
   },
   "ticker": {
    "maxLength": 13,
    "minLength": 2,
    "pattern": "^\\$?[A-Za-z0-9]{2,13}$",
    "type": "string"
   },
   "twitter": {
    "description": "X / Twitter handle or URL",
    "maxLength": 128,
    "type": "string"
   },
   "website": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name",
   "ticker"
  ],
  "type": "object"
 },
 "name": "crew_launch",
 "title": "Launch Pump coin via CrewPay (MAINNET)"
}
