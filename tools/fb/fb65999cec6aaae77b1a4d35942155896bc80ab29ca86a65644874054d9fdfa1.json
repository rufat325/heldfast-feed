{
 "description": "Shorten many URLs in one call. Returns the created links plus any per-URL errors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folder_id": {
    "description": "Place all created links in this folder id (optional)",
    "type": "integer"
   },
   "urls": {
    "description": "Destination URLs to shorten (up to 500)",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "shorten_urls_bulk"
}
