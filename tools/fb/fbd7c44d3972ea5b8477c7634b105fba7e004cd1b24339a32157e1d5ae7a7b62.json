   "rule_id": {
    "description": "The rule to delete.",
    "pattern": "^\\d{1,18}$",
    "type": "string"
   }
  },
  "required": [
   "rule_id"
  ],
  "type": "object"
 },
 "name": "delete_alert_rule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "deleted": {
    "type": "boolean"
   }
  },
  "required": [
   "deleted"
  ],
  "type": "object"
 },
 "title": "Delete an alert rule"
}
