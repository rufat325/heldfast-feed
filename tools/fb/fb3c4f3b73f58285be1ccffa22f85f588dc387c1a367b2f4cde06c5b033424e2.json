{
 "description": "Resolve governance terms for a specific URL path using aps.txt path overrides.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "apsTxt": {
    "description": "aps.txt JSON content",
    "type": "string"
   },
   "path": {
    "description": "URL path to resolve (e.g. /blog/my-article)",
    "type": "string"
   }
  },
  "required": [
   "apsTxt",
   "path"
  ],
  "type": "object"
 },
 "name": "resolve_path_terms"
}
