          ]
         },
         "then": {
          "properties": {
           "divergence_regime": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
           },
           "target_requirement_id": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
           },
           "validity_domain": {
            "maxLength": 1000,
            "minLength": 1,
            "type": "string"
           }
          }
         }
        }
       ],
       "properties": {
        "divergence_regime": {
         "maxLength": 1000,
         "type": [
          "string",
          "null"
         ]
        },
        "is_proxy": {
         "type": "boolean"
        },
        "target_requirement_id": {
         "maxLength": 500,
         "type": [
          "string",
          "null"
         ]
        },
        "validity_domain": {
         "maxLength": 1000,
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "is_proxy",
        "target_requirement_id",
        "validity_domain",
        "divergence_regime"
       ],
       "type": "object"
      },
      "quantity": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "unit": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "objective_id",
      "quantity",
      "unit",
      "direction",
      "priority",
      "proxy"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "physical_validation_plan": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "acceptance_criterion": {
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "authority_required": {
       "const": true
      },
      "measured_quantity": {
