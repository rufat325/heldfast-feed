{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update fields on a company by id. Provide a patch with at least one field. representationState is explicit and never inferred from contacts. primaryContactId can select an existing contact already linked to this same non-individual company; send null to clear it. Use search_companies first to find the company id. The result echoes the operating workspace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The company id returned by search_companies.",
    "minLength": 1,
    "type": "string"
   },
   "patch": {
    "additionalProperties": false,
    "description": "The company fields to update; include at least one changed field.",
    "properties": {
     "bankName": {
      "anyOf": [
       {
        "maxLength": 160,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The counterparty's bank name. Optional."
     },
     "counterpartyType": {
      "description": "Counterparty type: company, sole_trader, or individual. Defaults to company.",
      "enum": [
       "company",
       "sole_trader",
       "individual"
      ],
      "type": "string"
     },
     "creditLimit": {
      "anyOf": [
       {
        "description": "Non-negative credit limit up to 999999999999.99.",
        "pattern": "^(?:0|[1-9]\\d{0,11})(?:\\.\\d{1,2})?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Maximum outstanding balance. Optional; requires creditLimitCurrency."
     },
     "creditLimitCurrency": {
      "anyOf": [
       {
        "description": "Uppercase 3-letter ISO currency for the credit limit.",
        "maxLength": 3,
        "pattern": "^[A-Z]{3}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "ISO currency for creditLimit. Required when creditLimit is set."
     },
     "deliveryAddress": {
      "anyOf": [
       {
        "maxLength": 500,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Delivery address. Optional."
     },
     "edrpou": {
      "anyOf": [
       {
        "description": "Tax id: 8-digit \u0404\u0414\u0420\u041f\u041e\u0423 or 10-digit \u0406\u041f\u041d.",
        "maxLength": 20,
        "pattern": "^\\d{8}(\\d{2})?$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Tax identifier: 8-digit EDRPOU or 10-digit taxpayer number. Optional."
     },
     "email": {
      "anyOf": [
       {
        "description": "The company email.",
        "format": "email",
        "maxLength": 255,
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The company email. Optional."
     },
     "iban": {
      "anyOf": [
       {
        "maxLength": 34,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The counterparty's IBAN. Optional."
     },
     "industry": {
      "anyOf": [
       {
        "description": "The company's industry.",
        "maxLength": 120,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The company's industry. Optional."
     },
     "legalAddress": {
      "anyOf": [
       {
        "maxLength": 500,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Legal address. Optional."
     },
     "name": {
      "description": "The company name (unique within the workspace).",
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "ownerId": {
      "anyOf": [
       {
        "description": "User id of the workspace member who owns this company.",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "User id of the workspace member who owns this company. Optional."
     },
     "paymentTermsDays": {
      "anyOf": [
       {
        "description": "Payment terms in whole days from 0 to 365.",
        "maximum": 365,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Agreed payment term in days (0-365). Optional."
     },
     "phone": {
      "anyOf": [
       {
        "description": "The company phone.",
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The company phone. Optional."
     },
     "primaryContactId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "CRM contact id to designate as this counterparty's primary contact. Must already belong to this company; null clears it."
     },
     "representationState": {
      "description": "Declared representation state: unspecified, works_alone, or has_representatives. Never inferred from contact count.",
      "enum": [
       "unspecified",
       "works_alone",
       "has_representatives"
      ],
      "type": "string"
     },
     "size": {
      "description": "Company size band. Optional. One of: solo, small, medium, large, enterprise.",
      "enum": [
       "solo",
       "small",
       "medium",
       "large",
       "enterprise"
      ],
      "type": "string"
     },
     "status": {
      "description": "Relationship status. Optional. One of: prospect, active, inactive.",
      "enum": [
       "prospect",
       "active",
       "inactive"
      ],
      "type": "string"
     },
     "tags": {
      "description": "Tags for segmentation. Optional.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "taxGroup": {
      "anyOf": [
       {
        "enum": [
         "group_1",
         "group_2",
         "group_3"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Single-tax group. Only meaningful for a sole trader on the simplified system."
     },
     "taxSystem": {
      "anyOf": [
       {
        "enum": [
         "simplified",
         "general"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Tax system: simplified or general. Optional."
     },
     "vatNumber": {
      "anyOf": [
       {
        "maxLength": 20,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "VAT payer identifier. Optional."
     },
     "vatPayer": {
      "description": "Whether the counterparty is a VAT payer. Optional.",
      "type": "boolean"
     },
     "website": {
      "anyOf": [
       {
        "description": "The company website URL.",
        "format": "uri",
        "maxLength": 255,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The company website URL. Optional."
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "patch"
  ],
  "type": "object"
 },
 "name": "update_company",
 "title": "Update company"
}
