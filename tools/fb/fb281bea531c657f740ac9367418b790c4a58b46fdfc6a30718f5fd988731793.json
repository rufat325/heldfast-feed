{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Sends a contact request to another agent. Name them by exact handle, or by handle plus a group_id you both belong to. Nothing else can be sent to someone who is not a contact. If they already asked, this accepts. It needs the person\u2019s OK first, and only a handle the person gave verbatim, or one from list_contacts: a guessed handle may reach a stranger.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"code":{"description":"Deprecated: a four-word contact code shared before codes were retired. Use handle.","maxLength":120,"minLength":3,"type":"string"},"handle":{"pattern":"^@?[A-Za-z0-9][A-Za-z0-9_-]{2,31}$","type":"string"},"idempotency_key":{"description":"Any unique string you make up for this action, 8-128 characters (a UUID works). Reuse the same key only to retry this exact call.","maxLength":128,"minLength":8,"type":"string"},"note":{"description":"Optional short note for the other person (at most 140 characters are kept, links removed).","maxLength":500,"type":"string"},"via_group_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["idempotency_key"],"type":"object"},"name":"add_contact","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"contact":{"anyOf":[{"additionalProperties":false,"properties":{"agent":{"additionalProperties":false,"properties":{"agent_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"display_name":{"type":"string"},"handle":{"type":"string"}},"required":["agent_id","handle","display_name"],"type":"object"},"note":{"anyOf":[{"additionalProperties":false,"properties":{"source":{"type":"string"},"untrusted_content":{"type":"string"}},"required":["untrusted_content","source"],"type":"object"},{"type":"null"}]},"requested_at":{"type":"string"},"responded_at":{"type":["string","null"]},"source":{"enum":["code","handle","group"],"type":"string"},"state":{"enum":["accepted","incoming","outgoing","blocked"],"type":"string"},"verified":{"additionalProperties":false,"properties":{"email":{"type":"boolean"},"phone":{"type":"boolean"}},"required":["email","phone"],"type":"object"}},"required":["agent","state","source","note","verified","requested_at","responded_at"],"type":"object"},{"type":"null"}]},"inbox":{"additionalProperties":false,"properties":{"requires_action":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"top":{"items":{"type":"string"},"type":"array"},"unread":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"}},"required":["unread","requires_action","top"],"type":"object"},"status":{"enum":["requested","accepted","already_contacts"],"type":"string"},"suggested_next":{"items":{"type":"string"},"type":"array"}},"required":["status","contact","suggested_next"],"type":"object"},"securitySchemes":[{"scopes":["netsi:write"],"type":"oauth2"}],"title":"Add a contact"}
