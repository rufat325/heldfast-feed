{
 "description": "Randomly divide players into teams",
 "inputSchema": {
  "properties": {
   "count": {
    "description": "Number of teams (default 2)",
    "type": "number"
   },
   "members": {
    "description": "Comma-separated names (alternative to array)",
    "type": "string"
   },
   "players": {
    "description": "Player names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "teams": {
    "description": "Alias for count",
    "type": "number"
   }
  },
  "required": [
   "players"
  ],
  "type": "object"
 },
 "name": "team_split"
}
