     "timesheets",
     "field_service",
     "helpdesk",
     "planning",
     "website",
     "ecommerce",
     "pos",
     "marketing",
     "email_marketing",
     "events",
     "appointments",
     "hr",
     "payroll",
     "recruitment",
     "expenses",
     "documents",
     "sign",
     "rental",
     "subscriptions",
     "fleet",
     "repair",
     "studio",
     "knowledge",
     "spreadsheet_bi"
    ],
    "type": "string"
   },
   "city": {
    "description": "City name, e.g. M\u00fcnchen, Munich, Wien, Z\u00fcrich",
