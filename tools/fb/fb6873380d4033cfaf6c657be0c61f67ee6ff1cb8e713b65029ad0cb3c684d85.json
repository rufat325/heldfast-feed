{
 "description": "Search the Odoo implementation partners in Germany, Austria and Switzerland, ranked by a published formula (tier, references, certified experts, retention). Filter by country, city, tier, app specialism or industry focus.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "app": {
    "description": "Odoo app the partner highlights as a specialism",
