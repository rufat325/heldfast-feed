{
 "description": "Side-by-side comparison of 2-10 models by provider/slug: context window, input/output price per 1M tokens, modalities, status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "models": {
    "description": "Models to compare",
    "items": {
     "properties": {
      "provider": {
       "description": "Provider slug, e.g. 'openai'",
       "minLength": 1,
       "type": "string"
      },
      "slug": {
       "description": "Model slug, e.g. 'gpt-4o'",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "provider",
      "slug"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "models"
  ],
  "type": "object"
 },
 "name": "compare_models",
 "title": "Compare models"
}
