{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List tables on the selected TAP service before choosing an exact table for ADQL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "service": {
    "description": "Known Starfetch TAP service preset selected for this workflow; use this or url.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Explicit TAP base URL selected for this workflow; use this or service.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "starfetch_tap_tables",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "schema": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "baseUrl": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "service": {
        "type": "string"
       }
      },
      "required": [
       "baseUrl"
      ],
      "type": "object"
     }
    },
    "required": [
     "target",
     "count"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "List TAP tables"
}
