{
 "_meta": {
  "openai/outputTemplate": "ui://widget/clypmint-calendar.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "clypmint",
     "clypmint.publish"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://widget/clypmint-calendar.html"
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Schedule a video"
 },
 "description": "Choose connectionId from get_social_accounts when multiple accounts are connected. Never guess which account the user intends. Schedule a selected video output for external publication to connected accounts at postAt. Requires the approved edit version, caption, destination platforms, IANA timezone and platform-specific choices. Returns a publishing receipt and calendar card; pending acknowledgement is distinct from a confirmed schedule. Repeating operationId with identical arguments returns the original receipt.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "caption": {
    "maxLength": 2000,
    "type": "string"
   },
   "connectionId": {
    "pattern": "^(primary|sc_[a-f0-9]{24})$",
    "type": "string"
   },
   "expectedEditId": {
    "maxLength": 200,
    "type": "string"
   },
   "operationId": {
    "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
    "type": "string"
   },
   "outputId": {
    "pattern": "^[a-z0-9-]{1,80}$",
    "type": "string"
   },
   "platformOptions": {
    "additionalProperties": false,
    "properties": {
     "TIKTOK": {
      "additionalProperties": false,
      "properties": {
       "consent": {
        "const": true,
        "type": "boolean"
       },
       "disableComments": {
        "type": "boolean"
       },
       "disableDuet": {
        "type": "boolean"
       },
       "disableStitch": {
        "type": "boolean"
       },
       "isAiGenerated": {
        "type": "boolean"
       },
       "isBrandContent": {
        "type": "boolean"
       },
       "isOrganicBrandContent": {
        "type": "boolean"
       },
       "privacy": {
        "enum": [
         "SELF_ONLY",
         "PUBLIC_TO_EVERYONE",
         "MUTUAL_FOLLOW_FRIENDS",
         "FOLLOWER_OF_CREATOR"
        ],
        "type": "string"
       }
      },
      "required": [
       "privacy",
       "disableComments",
       "disableDuet",
       "disableStitch",
       "isAiGenerated",
       "isBrandContent",
       "isOrganicBrandContent",
       "consent"
      ],
      "type": "object"
     },
     "YOUTUBE": {
      "additionalProperties": false,
      "properties": {
       "containsSyntheticMedia": {
        "type": "boolean"
       },
       "madeForKids": {
        "type": "boolean"
       },
       "privacy": {
        "enum": [
         "PUBLIC",
         "PRIVATE",
         "UNLISTED"
        ],
        "type": "string"
       }
      },
      "required": [
       "privacy",
       "madeForKids"
      ],
      "type": "object"
     }
    },
    "type": "object"
   },
   "platforms": {
    "items": {
     "enum": [
      "INSTAGRAM",
      "TIKTOK",
      "YOUTUBE"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "postAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "timezone": {
    "maxLength": 100,
    "type": "string"
   },
   "videoId": {
    "pattern": "^prj_[A-Za-z0-9][A-Za-z0-9_-]{7,95}$",
    "type": "string"
   }
  },
  "required": [
   "videoId",
   "outputId",
   "platforms",
   "caption",
   "postAt",
   "timezone",
   "operationId",
   "expectedEditId"
  ],
  "type": "object"
 },
 "name": "schedule_post",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Clypmint schedule_post result. Error results carry error; successful requests expose the identifiers and state available for the next step. Signed media stays in private metadata.",
  "properties": {
   "available": {
    "type": "boolean"
   },
   "code": {
    "type": [
     "string",
     "null"
    ]
   },
   "cost": {
    "additionalProperties": true,
    "type": "object"
   },
   "dry_run": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "import_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "output_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "plan_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "state": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "type": [
     "string",
     "integer",
     "null"
    ]
   },
   "studio_url": {
    "format": "uri",
    "type": "string"
   },
   "style_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "version_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "video_id": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "clypmint",
    "clypmint.publish"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Schedule a video"
}
