 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "get_my_mcp_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "additionalProperties": false,
    "properties": {
     "limited_fields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "upgrade_url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "tier",
     "limited_fields"
    ],
    "type": "object"
   },
   "auth_method": {
    "enum": [
     "anonymous",
     "api_key",
     "oauth"
    ],
    "type": "string"
   },
   "authenticated": {
    "type": "boolean"
   },
   "data_status": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "const": false,
      "type": "boolean"
     },
     "message": {
      "type": "string"
     },
     "missing": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "complete",
     "missing"
    ],
    "type": "object"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "data_through": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "quota": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "limit": {
        "exclusiveMinimum": 0,
        "type": "integer"
       },
       "remaining": {
        "minimum": 0,
        "type": "integer"
       },
       "resets_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "used": {
        "minimum": 0,
        "type": "integer"
       },
       "window": {
        "const": "rolling_24_hours",
        "type": "string"
