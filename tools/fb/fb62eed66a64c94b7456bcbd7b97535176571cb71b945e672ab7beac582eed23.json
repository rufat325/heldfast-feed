      },
      "required": [
       "window",
       "limit",
       "used",
       "remaining",
       "resets_at"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "tier": {
    "type": "string"
   }
  },
  "required": [
   "authenticated",
   "auth_method",
   "tier",
   "quota"
  ],
  "type": "object"
 },
 "title": "My MCP Status"
}
