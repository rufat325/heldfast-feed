{
 "description": "List new AMM pairs/pools created in the last N minutes (Uniswap V2, PancakeSwap, SushiSwap factories). For discovery bots and yield scouts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Chain to scan (default: all)",
    "enum": [
     "ethereum",
     "bsc",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max pairs to return (default: 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "window_minutes": {
    "description": "Time window in minutes (default: 5)",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "fresh_markets"
}
