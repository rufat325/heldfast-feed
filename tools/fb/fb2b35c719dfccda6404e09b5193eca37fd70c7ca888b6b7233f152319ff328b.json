{
 "description": "Find queries served by multiple pages to prioritize consolidation and internal-linking decisions",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endDate": {
    "description": "End date in YYYY-MM-DD; defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "minImpressions": {
    "description": "Minimum impressions per query-page row; defaults to 10",
    "minimum": 0,
    "type": "number"
   },
   "siteUrl": {
    "description": "Search Console property to analyze",
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "description": "Start date in YYYY-MM-DD; defaults to the latest 28-day window",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "query_cannibalization",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groups": {
    "description": "Queries with multiple ranking pages",
    "items": {
     "additionalProperties": false,
     "properties": {
      "pages": {
       "description": "Pages ranking for the query",
       "items": {
        "additionalProperties": false,
        "properties": {
         "clicks": {
          "description": "Search clicks",
          "type": "number"
         },
         "impressions": {
          "description": "Search impressions",
          "type": "number"
         },
         "page": {
          "description": "Competing page URL",
          "type": "string"
         },
         "position": {
          "description": "Average search position",
          "type": "number"
         }
        },
        "required": [
         "page",
         "impressions",
         "clicks",
         "position"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "query": {
       "description": "Query served by multiple pages",
       "type": "string"
      }
     },
     "required": [
      "query",
      "pages"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "siteUrl": {
    "description": "Search Console property analyzed",
    "type": "string"
   },
   "truncated": {
    "description": "Whether Search Console held more than 5000 rows for this window, so the list was computed from the top rows only",
    "type": "boolean"
   },
   "window": {
    "additionalProperties": false,
    "description": "Analysis window",
    "properties": {
     "endDate": {
      "description": "Inclusive window end date",
      "type": "string"
     },
     "startDate": {
      "description": "Inclusive window start date",
      "type": "string"
     }
    },
    "required": [
     "startDate",
     "endDate"
    ],
    "type": "object"
   }
  },
  "required": [
   "siteUrl",
   "window",
   "truncated",
   "groups"
  ],
  "type": "object"
 }
}
