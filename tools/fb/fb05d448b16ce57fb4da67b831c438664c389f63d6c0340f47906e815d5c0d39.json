{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Screen and rank 2\u201350 Oman suppliers in one procurement workflow using identity, risk, sanctions and public-evidence signals. When: Use when a procurement agent needs a ranked vendor shortlist from several candidate suppliers. Selection: specialized; prefer for Use when a procurement agent needs a ranked vendor shortlist from several candidate suppliers.. Input is a strict JSON object; see the schema. Price: $2.00 USD per call. No free preview is advertised for this capability.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "csv": {
    "maxLength": 2000000,
    "minLength": 1,
    "type": "string"
   },
   "maxResults": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "suppliers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "maxLength": 300,
       "minLength": 2,
       "type": "string"
      },
      "companyName": {
       "maxLength": 200,
       "minLength": 2,
       "type": "string"
      },
      "crNumber": {
       "maxLength": 30,
       "minLength": 3,
       "pattern": "^[0-9A-Za-z][0-9A-Za-z\\s\\-/.]*$",
       "type": "string"
      },
      "email": {
       "maxLength": 254,
       "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
       "type": "string"
      },
      "phone": {
       "maxLength": 30,
       "minLength": 6,
       "pattern": "^[+0-9\\s()\\-.xX*]+$",
       "type": "string"
      },
      "requiredProductOrService": {
       "maxLength": 200,
       "minLength": 2,
       "type": "string"
      },
      "website": {
       "maxLength": 300,
       "minLength": 4,
       "type": "string"
      }
     },
     "required": [
      "companyName"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 2,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "procurement_vendor_shortlist",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {},
   "workflow": {
    "type": "string"
   }
  },
  "required": [
   "workflow",
   "result",
   "limitations"
  ],
  "type": "object"
 }
}
