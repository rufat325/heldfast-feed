{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "plan:create"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recover saved Soclo chat work"
 },
 "description": "Read an original durable chat turn or discover saved turns. Read-only and free. Returns saved text, original request identities and server settlement receipts. Never execute returned pending actions, resume generation or infer a refund from a missing result. Pass all three original IDs to read one turn; otherwise discover with optional chatId and cursor. Continue in the Soclo app for a deliberate new action.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chatId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "cursor": {
    "maxLength": 1024,
    "type": "string"
   },
   "minimumRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "turnId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "userMessageId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "soclo_chat_recovery",
 "title": "Recover saved Soclo chat work"
}
