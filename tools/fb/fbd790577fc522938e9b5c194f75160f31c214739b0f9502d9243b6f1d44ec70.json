{"_meta":{"openai/outputTemplate":"ui://lauda/calculo-v1.html","openai/toolInvocation/invoked":"Prazo contado","openai/toolInvocation/invoking":"Contando o prazo","ui":{"resourceUri":"ui://lauda/calculo-v1.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Calcula prazo jur\u00eddico no motor determin\u00edstico local e devolve integralmente as premissas, o termo inicial, a data final, os dias pulados e a base legal. Ferramenta de consulta R2; nunca preencha bases ausentes por suposi\u00e7\u00e3o.","inputSchema":{"additionalProperties":false,"properties":{"court":{"description":"Sigla do tribunal do processo (TJSP, TRF3, TRT2, STJ): define a UF que faltar e se valem os feriados da Justi\u00e7a da Uni\u00e3o (semana santa, 11/08, 1\u00ba/11 e 8/12). Nulo se n\u00e3o souber.","maxLength":12,"type":["string","null"]},"customHolidays":{"items":{"additionalProperties":false,"properties":{"date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"label":{"maxLength":80,"type":["string","null"]}},"required":["date","label"],"type":"object"},"maxItems":500,"type":["array","null"]},"days":{"maximum":10000,"minimum":1,"type":"integer"},"mode":{"enum":["uteis","corridos"],"type":"string"},"multiplier":{"enum":[1,2,null],"type":["integer","null"]},"multiplierBasis":{"enum":["ministerio_publico","fazenda_publica","defensoria_publica","litisconsortes","outro",null],"type":["string","null"]},"startBasis":{"enum":["disponibilizacao_dje","publicacao_dje","juntada","ciencia","outro",null],"type":["string","null"]},"startDate":{"description":"Data do marco informado, em AAAA-MM-DD.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"uf":{"pattern":"^[A-Za-z]{2}$","type":["string","null"]}},"required":["startDate","startBasis","days","mode","multiplier","multiplierBasis","uf","court","customHolidays"],"type":"object"},"name":"prazo_calculate","title":"Contar prazo processual"}
