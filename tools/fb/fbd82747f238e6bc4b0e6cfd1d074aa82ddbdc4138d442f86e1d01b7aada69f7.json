 "description": "Queue a hardening profile for an owned Tor v3 onion service without changing its address. Standard uses intro-point rate limiting; hardened adds tighter limits and max streams; max adds experimental proof-of-work. This is one layer of protection, never a DDoS guarantee; max is refused if the host's Tor lacks the PoW module. Returns 404 without an onion service and 422 without agent onion-profile-v1 support. An agent update must be explicitly requested by the customer. Requires manage scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "profile": {
    "enum": [
     "standard",
     "hardened",
     "max"
    ],
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "profile"
  ],
  "type": "object"
 },
 "name": "impreza_set_onion_profile",
