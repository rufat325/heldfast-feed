{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "List bounded page targets from an approved user-owned loopback Chrome DevTools Protocol endpoint. Only targets whose current URL matches an approved exact origin are returned; URL credentials, query values, and fragments are redacted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "allowed_origins": [
     "https://app.example.test"
    ],
    "approved": true,
    "cdp_endpoint": "http://127.0.0.1:9222",
    "limit": 100,
    "offset": 0
   }
  ],
  "properties": {
   "allowed_origins": {
    "description": "Value for allowed origins.",
    "items": {
     "maxLength": 2048,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "approved": {
    "const": true,
    "description": "Explicit approval for browser observation",
    "type": "boolean"
   },
   "cdp_endpoint": {
    "description": "Approved literal loopback Chrome DevTools Protocol endpoint.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of results to return in this page.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based index of the first result to return.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "cdp_endpoint",
   "allowed_origins",
   "approved"
  ],
  "type": "object"
 },
 "name": "list_browser_targets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "browser": {
      "additionalProperties": false,
      "properties": {
       "js_version": {
        "type": "string"
       },
       "product": {
        "type": "string"
       },
       "protocol_version": {
        "type": "string"
       },
       "revision": {
        "type": "string"
       },
       "user_agent": {
        "type": "string"
       }
      },
      "required": [
       "product",
       "protocol_version",
       "revision",
       "user_agent",
       "js_version"
      ],
      "type": "object"
     },
     "excluded": {
      "additionalProperties": false,
      "properties": {
       "disallowed_origin": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "non_page": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unsupported_url": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "disallowed_origin",
       "unsupported_url",
       "non_page"
      ],
      "type": "object"
     },
     "limitations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "schema_version": {
      "const": 1,
      "type": "number"
     },
     "targets": {
      "additionalProperties": false,
      "properties": {
       "has_more": {
        "type": "boolean"
       },
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "attached": {
           "type": "boolean"
          },
          "origin": {
           "type": "string"
          },
          "target_id": {
           "type": "string"
          },
          "title": {
           "type": "string"
          },
          "type": {
           "type": "string"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "target_id",
          "type",
          "title",
          "url",
          "origin",
          "attached"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "limit": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "next_offset": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "offset": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "total": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "items",
       "offset",
       "limit",
       "total",
       "next_offset",
       "has_more"
      ],
      "type": "object"
     }
    },
    "required": [
     "schema_version",
     "browser",
     "targets",
     "excluded",
     "limitations"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "List Browser Targets"
}
