{
 "description": "Save a product as favorite for quick access. Persists in ~/.probo-connect/.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Short name to remember this favorite by, e.g. \"my-banner\"",
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "Optional note",
    "type": "string"
   },
   "productCode": {
    "description": "Probo product code",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "productCode"
  ],
  "type": "object"
 },
 "name": "saveFavorite"
}
