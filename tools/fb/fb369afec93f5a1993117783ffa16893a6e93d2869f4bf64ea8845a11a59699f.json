{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update form template"
 },
 "description": "Update an existing form template by ID. Requires form_templates:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "maxLength": 5000,
    "type": "string"
   },
   "id": {
    "description": "Form template ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "module": {
    "description": "Move the form to a workspace: facilities, infrastructure, or shared (both).",
    "enum": [
     "facilities",
     "infrastructure",
     "shared"
    ],
    "type": "string"
   },
   "name": {
    "description": "Form template name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "description": "Publication status (draft, published, or archived)",
    "enum": [
     "draft",
     "published",
     "archived"
    ],
    "type": "string"
   },
   "work_category_id": {
    "description": "Work category ID (look up with list_work_categories)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_form_template",
 "title": "Update form template"
}
