{
 "description": "Create a term in any taxonomy",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Term description, plain text (default empty)",
    "type": "string"
   },
   "name": {
    "description": "Term name",
    "type": "string"
   },
   "parent": {
    "description": "Parent term ID for hierarchical taxonomies (default 0 = none)",
    "minimum": 0,
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "URL slug (derived from the name if omitted)",
    "type": "string"
   },
   "taxonomy": {
    "description": "Taxonomy name (e.g. category, post_tag, product_cat)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "site",
   "taxonomy",
   "name"
  ],
  "type": "object"
 },
 "name": "mcp_create_term"
}
