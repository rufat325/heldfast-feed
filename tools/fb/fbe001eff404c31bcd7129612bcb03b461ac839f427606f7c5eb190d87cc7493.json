{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find a Work Email Address"
 },
 "description": "Find a person's work email address from their name and company website. Tries the usual patterns (first.last, flast, first, and so on), checks each one, and returns the first that is confirmed real, with how confident it is. Says so when the company accepts mail for any address and the guess cannot be confirmed. Use it to reach a specific person at a company. Price: $0.10 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "domain": {
    "description": "Company domain, e.g. \"acme.com\".",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "first_name": {
    "description": "Person's first name.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "last_name": {
    "description": "Person's last name.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "first_name",
   "last_name",
   "domain"
  ],
  "type": "object"
 },
 "name": "email_find",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "best_match": {
    "description": "The best address found, or null.",
    "type": [
     "string",
     "null"
    ]
   },
   "candidates_checked": {
    "description": "Each address tried and its result.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "email",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "confidence": {
    "description": "0 to 1.",
    "type": "number"
   },
   "domain": {
    "description": "The mail domain searched.",
    "type": "string"
   },
   "note": {
    "description": "How to read the answer.",
    "type": "string"
   },
   "supplier_calls": {
    "description": "Verification checks made.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "verified": {
    "description": "True if best_match was confirmed deliverable.",
    "type": "boolean"
   }
  },
  "required": [
   "domain",
   "best_match",
   "confidence",
   "note",
   "supplier_calls",
   "candidates_checked",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Find a Work Email Address"
}
