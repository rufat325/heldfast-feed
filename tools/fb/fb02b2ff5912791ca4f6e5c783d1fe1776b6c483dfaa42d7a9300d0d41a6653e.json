{
 "description": "Move Gmail messages to trash (recoverable).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ids": {
    "description": "Gmail message IDs to move to trash",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "message-move-to-trash",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "failureCount": {
        "description": "Number of messages that failed to move",
        "type": "number"
       },
       "results": {
        "description": "Individual results for each message",
        "items": {
         "additionalProperties": false,
         "properties": {
          "error": {
           "description": "Error message if operation failed",
           "type": "string"
          },
          "id": {
           "description": "Message ID",
           "type": "string"
          },
          "success": {
           "description": "Whether the operation succeeded",
           "type": "boolean"
          }
         },
         "required": [
          "id",
          "success"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "successCount": {
        "description": "Number of messages successfully moved to trash",
        "type": "number"
       },
       "totalRequested": {
        "description": "Total number of messages requested to trash",
        "type": "number"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "totalRequested",
       "successCount",
       "failureCount",
       "results"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
