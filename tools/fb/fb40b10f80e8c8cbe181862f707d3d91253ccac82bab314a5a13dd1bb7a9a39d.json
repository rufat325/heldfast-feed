{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Put a document back the way it was"
 },
 "description": "Restores a cover letter, tailored resume or answer to a recorded pre-edit version within its undo window. Arguments must match the recorded edit; arbitrary replacement text is refused. Resume restoration uses resumeRevisionId and restores the application's sendable copy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicationId": {
    "type": "string"
   },
   "asset": {
    "description": "Which asset the edit changed.",
    "enum": [
     "coverLetter",
     "resume",
     "answers"
    ],
    "type": "string"
   },
   "question": {
    "description": "The answer's question text; required for `answers`.",
    "maxLength": 2000,
    "type": "string"
   },
   "resumeRevisionId": {
    "description": "The tailored-resume revision to put back, from the `edit_resume` receipt. Required for `resume`.",
    "maxLength": 200,
    "type": "string"
   },
   "text": {
    "description": "The text that stood before the edit, from its receipt. Required for `coverLetter` and `answers`; a resume restore names a revision instead.",
    "maxLength": 50000,
    "type": "string"
   }
  },
  "required": [
   "applicationId",
   "asset"
  ],
  "type": "object"
 },
 "name": "restore_material",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionId": {
    "type": "string"
   },
   "cancel": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "type": "string"
       },
       "args": {}
      },
      "required": [
       "actionId",
       "args"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "createdAt": {
    "type": "string"
   },
   "handoff": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "destination": {
        "additionalProperties": false,
        "properties": {
         "destination": {
          "enum": [
           "matches",
           "browse",
           "applications",
           "messages",
           "profile",
           "billing",
           "help",
           "feedback",
           "job",
           "pack"
          ],
          "type": "string"
         },
         "params": {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         }
        },
        "required": [
         "destination"
        ],
        "type": "object"
       },
       "note": {
        "maxLength": 200,
        "type": "string"
       },
       "preserved": {
        "type": "boolean"
       },
       "reason": {
        "enum": [
         "needs_credentials",
         "needs_payment_details",
         "needs_consent",
         "needs_entitlement",
         "needs_prerequisite",
         "person_must_do"
        ],
        "type": "string"
       },
       "remaining": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "required": [
       "reason",
       "note",
       "destination",
       "remaining",
       "preserved"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "object": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "revisionAfter": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "revisionBefore": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "source": {
    "enum": [
     "site",
     "mcp"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "completed",
     "queued",
     "verifying",
     "failed",
     "cancelled",
     "handoff"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "taskId": {
    "type": "string"
   },
   "undo": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "type": "string"
       },
       "args": {},
       "until": {
        "type": "string"
       }
      },
      "required": [
       "until",
       "actionId",
       "args"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "webUrl": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "taskId",
   "actionId",
   "status",
   "object",
   "revisionBefore",
   "revisionAfter",
   "summary",
   "undo",
   "cancel",
   "handoff",
   "source",
   "createdAt",
   "webUrl"
  ],
  "type": "object"
 },
 "title": "Put a document back the way it was"
}
