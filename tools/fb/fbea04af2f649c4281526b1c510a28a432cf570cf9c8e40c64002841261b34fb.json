{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List one page of compact group members by default. Use view=all only when a complete, cached snapshot is required (read-only, capped at 10,000).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "groupId": {
    "description": "Exact group ID. Provide groupId or shortCode.",
    "type": "string"
   },
   "offset": {
    "description": "Starting member offset when view=page. Ignored when view=all.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Members to fetch when view=page. Ignored when view=all.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "roleId": {
    "description": "Only include members with this role.",
    "type": "string"
   },
   "shortCode": {
    "description": "Exact group short code. Provide groupId or shortCode.",
    "type": "string"
   },
   "sort": {
    "description": "VRChat group-member sort expression.",
    "type": "string"
   },
   "view": {
    "default": "page",
    "description": "page fetches one bounded API page; all explicitly loads and caches a rate-aware snapshot capped at 10,000 members.",
    "enum": [
     "page",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vrchat_group_members",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupId": {
    "type": "string"
   },
   "members": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "displayName": {
       "type": "string"
      },
      "userId": {
       "type": "string"
      }
     },
     "required": [
      "userId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "properties": {
     "items": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "offsetStart": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "pageSize": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "pages": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "pages",
     "items",
     "pageSize",
     "offsetStart",
     "truncated"
    ],
    "type": "object"
   },
   "returnedMembers": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "stale": {
    "type": "boolean"
   },
   "truncated": {
    "type": "boolean"
   },
   "view": {
    "enum": [
     "page",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "groupId",
   "view",
   "returnedMembers",
   "truncated",
   "stale",
   "members"
  ],
  "type": "object"
 }
}
