{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Start a Vooks catalog export"},"description":"Start an asynchronous export of every Vooks title matching the given filters, for bulk work that would otherwise be hundreds of searches. Returns a job id immediately; poll it with get_export_job. The idempotency_key makes a retry safe: calling again with the same key returns the original job rather than starting a second one.","inputSchema":{"properties":{"age":{"description":"Only export titles published for this age.","maximum":18,"minimum":0,"type":"integer"},"idempotency_key":{"description":"A key you choose, 8 to 200 characters. Reusing it returns the job it started instead of creating another.","maxLength":200,"minLength":8,"type":"string"},"language":{"description":"Only export titles in this narration language.","enum":["english","hindi","spanish"],"type":"string"},"topic":{"description":"Only export titles carrying this topic.","enum":["animals","fiction","fun","vocabulary-development","learning","sel","predicting","friendship","kindness","family","feelings","rhyme","feel-good-story","imagination","sequence-of-events","simple-sentences","teach","animal-characters","adventure","funny","problem-and-solution","self-awareness","nature","adjectives","friends","wholesome","verbs","ww-content","dialogue","humor","relationship-skills","ellipses","problem-solving","quotation-marks","repetition","rhyming-words","activities","helping-others","early-comprehension","main-character","perseverance","science","animal-story","courage","nonfiction","onomatopoeia","prepositional-phrases","entertain","narrative-nonfiction","heartwarming","confidence","helping","play","character-development","read-aloud","describing-pictures","empathy","school","sharing","silly","growing-up","identity","being-yourself","bedtime","exclamation-points","food","love","music","big-feelings","community","cooperation","facts","inform","informational-text","poetry","teamwork","asking-questions","build-empathy","colors","complex-sentences","inferencing","talking-animals","inspire","silly-story","third-person-narrative","concept-book","patterned-language","creativity","social-awareness","alliteration","diversity","prediction","compound-sentences","curiosity","caring","commas","together","trying-new-things","discovery","vocabulary-building","compare-and-contrast","dashes","emotions","farm","growing","pets","questions","read-aloud-favorite","self-esteem","stem","inspiring","math","plants","sequencing","winter"],"type":"string"}},"required":["idempotency_key"],"type":"object"},"name":"create_catalog_export","outputSchema":{"properties":{"job_id":{"description":"Pass this to get_export_job.","type":"string"},"poll_url":{"description":"The HTTP endpoint that reports the same status.","type":"string"},"status":{"description":"Always \"succeeded\": an export is computed from the committed index, not queued.","type":"string"}},"required":["job_id","status"],"type":"object"},"title":"Start a Vooks catalog export"}
