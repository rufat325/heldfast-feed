{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List your long-form X Articles with optional status filtering. Shows title, status, schedule, and the published article URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Results per page (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "draft",
     "scheduled",
     "publishing",
     "published",
     "failed"
    ],
    "type": "string"
   },
   "x_account_id": {
    "description": "Filter by X account ID (for multi-account users)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "opentweet_list_articles"
}
