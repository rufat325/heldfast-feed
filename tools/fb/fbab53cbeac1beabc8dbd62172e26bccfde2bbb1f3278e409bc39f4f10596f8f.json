{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "assignments:publish"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Preview changing a published assignment"
 },
 "description": "Creates an owner-bound confirmation preview for closing or reopening a published assignment, or changing class open/due dates. Links and submissions remain intact. Publication remains unchanged until approved preview execution.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "close",
     "reopen",
     "change_dates"
    ],
    "type": "string"
   },
   "assignmentId": {
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "changes": {
    "default": [],
    "description": "For change_dates only.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "classId": {
       "anyOf": [
        {
         "pattern": "^[a-f\\d]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Class id, or null for the anyone-with-the-link publication."
      },
      "dueAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "opensAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      }
     },
     "required": [
      "classId"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "timeZone": {
    "default": "America/New_York",
    "description": "The teacher's IANA time zone, e.g. America/Chicago, so the preview shows their local times.",
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "action",
   "changes",
   "timeZone"
  ],
  "type": "object"
 },
 "name": "prepare_update_publication",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "assignments:publish"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Preview changing a published assignment"
}
