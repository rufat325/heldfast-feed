{
 "description": "Read-only OHLCV/K-line history for a Robinhood Chain token; useful to distinguish fresh activity from sustained momentum.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "resolution": {
    "default": "5m",
    "enum": [
     "30s",
     "1m",
     "5m",
     "15m",
     "1h",
     "4h",
     "1d"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "agentcity_robinhood_token_kline"
}
