{
 "description": "Track local visibility for a domain across keywords and locations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain to track",
    "type": "string"
   },
   "keywords": {
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "locations": {
    "items": {
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "domain",
   "keywords",
   "locations"
  ],
  "type": "object"
 },
 "name": "agentseo_local_visibility_track",
 "title": "AgentSEO Local Visibility Track"
}
