    "description": "Actual gross weight in kilograms of ALL pieces together (the total, not one piece) \u2014 the dimensions are per piece.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "height_cm": {
    "description": "Height in centimetres",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "length_cm": {
    "description": "Length in centimetres",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "pieces": {
    "description": "Number of identical pieces (default: 1)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "width_cm": {
    "description": "Width in centimetres",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
