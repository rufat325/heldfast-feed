{
 "description": "R/IV agent.monitor \u2014 independent evidence-verification primitive for monitoring. Completed paid execution returns an RVO plus signed R/IV Verification Receipt.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cadence": {
    "default": "daily",
    "enum": [
     "daily",
     "weekly"
    ]
   },
   "materiality_rule": {
    "maxLength": 10000,
    "type": "string"
   },
   "public_urls": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "request_id": {
    "description": "Caller-generated idempotency key for this paid execution attempt.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "target": {
    "maxLength": 20000,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "target",
   "request_id"
  ],
  "type": "object"
 },
 "name": "agent.monitor",
 "outputSchema": {
  "$id": "https://rdiv-production-runtime-production.up.railway.app/schemas/riv-machine-result-v2.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "description": "Schema of a completed R/IV machine execution. Cryptographic receipt integrity does not independently establish the truth of any underlying conclusion. Free trials may use a separate contract.",
  "properties": {
   "cost": {
    "additionalProperties": true,
    "properties": {
     "amount": {
      "minimum": 0,
      "type": "number"
     },
     "currency": {
      "const": "USD"
     }
    },
    "required": [
     "currency",
     "amount"
    ],
    "type": "object"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "operationId": {
    "minLength": 1,
    "type": "string"
   },
   "operationVersion": {
    "minLength": 1,
    "type": "string"
   },
   "receipt": {
    "additionalProperties": true,
    "properties": {
     "issuedAt": {
      "format": "date-time",
      "type": "string"
     },
     "jobId": {
      "type": "string"
     },
     "operationId": {
      "type": "string"
     },
     "receiptId": {
      "type": "string"
     },
     "receiptVersion": {
      "type": "string"
     },
     "requestId": {
      "type": "string"
     },
     "resultHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "signature": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     }
    },
    "required": [
     "receiptVersion",
     "receiptId",
     "jobId",
     "requestId",
     "operationId",
     "resultHash",
     "issuedAt",
     "sha256",
     "signature"
    ],
    "type": "object"
   },
   "requestId": {
    "minLength": 1,
    "type": "string"
   },
   "result": {
    "additionalProperties": true,
    "description": "R/IV Verification Object with evidence, limitations, verdict and resultHash.",
    "properties": {
     "limitations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "operationId": {
      "type": "string"
     },
     "resultHash": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "verdict": {
      "type": "string"
     },
     "verificationId": {
      "type": "string"
     }
    },
    "required": [
     "operationId",
     "verificationId",
     "verdict",
     "limitations",
     "resultHash"
    ],
    "type": "object"
   },
   "schemaVersion": {
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "const": "COMPLETED"
   },
   "timestamps": {
    "additionalProperties": true,
    "properties": {
     "completedAt": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "completedAt"
    ],
    "type": "object"
   },
   "verdict": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "schemaVersion",
   "requestId",
   "jobId",
   "operationId",
   "operationVersion",
   "status",
   "verdict",
   "result",
   "receipt",
   "cost",
   "timestamps"
  ],
  "title": "R/IV Machine Verification Result v2 - authenticated paid execution",
  "type": "object",
  "x-riv-receipt-policy": {
   "integrity": "server-side HMAC verification required for v1 receipts",
   "meaning": "signed provenance and execution integrity; not evidence that an underlying claim is true"
  },
  "x-riv-status": "public-contract-v2-live-machine-completed-only"
 }
}
