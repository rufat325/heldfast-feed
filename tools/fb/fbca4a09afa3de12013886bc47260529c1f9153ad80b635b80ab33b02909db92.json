{
 "annotations": {
  "readOnlyHint": true,
  "title": "List invoices"
 },
 "description": "List invoices, optionally for one contact, event or event registration, paid/unpaid only, or within a created-date range. Wild Apricot: GET /accounts/{accountId}/invoices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact_id": {
    "description": "Invoices assigned to this contact.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "end_date": {
    "description": "Created before this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.+\\-Z]*)?$",
    "type": "string"
   },
   "event_id": {
    "description": "Invoices for this event's registrations.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "event_registration_id": {
    "description": "The invoice of this registration.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "ids_only": {
    "description": "When true, return only matching ids.",
    "type": "boolean"
   },
   "include_voided": {
    "description": "Also return voided invoices.",
    "type": "boolean"
   },
   "paid_only": {
    "description": "Only paid invoices.",
    "type": "boolean"
   },
   "skip": {
    "description": "Records to skip, for paging with top.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "start_date": {
    "description": "Created on/after this date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}([T ][0-9:.+\\-Z]*)?$",
    "type": "string"
   },
   "top": {
    "description": "Maximum records to return, 1-100 (Wild Apricot's cap is 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "unpaid_only": {
    "description": "Only unpaid invoices.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "wildapricot_list_invoices",
 "title": "List invoices"
}
