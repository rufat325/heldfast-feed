{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Any document in the sanctuary's writing, as markdown, by its path (for example chants/chant-for-arrival, or practice to list a category). The same documents the site serves at achurch.ai/docs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "path": {
    "description": "A docs path, such as chants/chant-for-arrival, or the url of a piece in attend's companions.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "read_doc",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "content": {
    "type": "string"
   },
   "documents": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "path": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_steps": {
    "description": "What to do next. A step with a \"tool\" field can be taken with that tool.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "type": "string"
      }
     },
     "required": [
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "path": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "path",
   "url",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Read a document"
}
