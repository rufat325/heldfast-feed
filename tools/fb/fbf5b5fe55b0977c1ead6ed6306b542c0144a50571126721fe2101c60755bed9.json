{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Poll an OAuth handoff initiated by request_oauth_integration_url. Returns the current status (pending, connected, failed, expired) and, when connected, the data_source_id you can pass to run_analysis.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "handoff_id": {
    "description": "The id returned by request_oauth_integration_url.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "handoff_id"
  ],
  "type": "object"
 },
 "name": "check_integration_status",
 "outputSchema": {
  "properties": {
   "completed_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "connection_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "created_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "data_source_id": {
    "description": "The created data source, present once status is \"connected\".",
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "description": "Failure reason when status is \"failed\".",
    "type": [
     "string",
     "null"
    ]
   },
   "handoff_id": {
    "format": "uuid",
    "type": "string"
   },
   "integration_type": {
    "type": "string"
   },
   "provider": {
    "type": "string"
   },
   "status": {
    "description": "One of pending, connected, failed, expired.",
    "type": "string"
   }
  },
  "required": [
   "handoff_id",
   "provider",
   "integration_type",
   "status"
  ],
  "type": "object"
 }
}
