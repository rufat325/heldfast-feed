{
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actions": {
    "description": "Ordered actions to execute sequentially",
    "items": {
     "properties": {
      "action": {
       "description": "The action to perform",
       "enum": [
        "mouse_click",
        "mouse_double_click",
        "mouse_move",
        "hover",
        "nudge",
        "mouse_drag",
        "scroll",
        "key_tap",
        "key_combo",
        "key_type",
        "paste",
        "set_baseline",
        "diff_check",
        "wait"
       ],
       "type": "string"
      },
      "amount": {
       "description": "Scroll amount (default 3)",
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "button": {
       "description": "Mouse button",
       "enum": [
        "left",
        "right",
        "middle"
       ],
       "type": "string"
      },
      "direction": {
       "description": "Scroll direction",
       "enum": [
        "up",
        "down",
        "left",
        "right"
       ],
       "type": "string"
      },
      "dx": {
       "description": "Relative X offset (nudge)",
       "maximum": 50,
       "minimum": -50,
       "type": "integer"
      },
      "dy": {
       "description": "Relative Y offset (nudge)",
       "maximum": 50,
       "minimum": -50,
       "type": "integer"
      },
      "key": {
       "description": "Key name or combo string (e.g. \"ctrl+c\")",
       "type": "string"
      },
      "keys": {
       "description": "Array of key names for combo",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ms": {
       "description": "Wait duration in ms (default 500)",
       "maximum": 10000,
       "minimum": 50,
       "type": "integer"
      },
      "text": {
       "description": "Text to type or paste",
       "type": "string"
      },
      "toX": {
       "description": "Drag target X",
       "maximum": 1279,
       "minimum": 0,
       "type": "integer"
      },
      "toY": {
       "description": "Drag target Y",
       "maximum": 799,
       "minimum": 0,
       "type": "integer"
      },
      "x": {
       "description": "X coordinate",
       "maximum": 1279,
       "minimum": 0,
       "type": "integer"
      },
      "y": {
       "description": "Y coordinate",
       "maximum": 799,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "actions"
  ],
  "type": "object"
 },
 "name": "action_queue"
}
