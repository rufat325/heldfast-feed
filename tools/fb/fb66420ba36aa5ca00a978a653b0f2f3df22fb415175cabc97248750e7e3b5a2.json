{
 "description": "Poll the status and retrieve results of a batch distill job. Free (0 credits).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiKey": {
    "description": "Thunderbit API key (tb_xxx). Optional if THUNDERBIT_API_KEY env var is set.",
    "type": "string"
   },
   "jobId": {
    "description": "Job ID returned from thunderbit_batch_distill_create",
    "type": "string"
   },
   "page": {
    "description": "Page number, 0-based (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (default 20, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "thunderbit_batch_distill_status",
 "title": "Check Batch Distill Status"
}
