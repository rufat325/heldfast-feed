    "properties": {
     "error": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ]
     },
     "meta": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "next": {
      "items": {},
      "type": "array"
     },
     "payment": {
      "additionalProperties": false,
      "properties": {
       "execution_status": {
        "enum": [
         "not_started",
         "succeeded",
         "failed",
         "unknown"
        ],
        "type": "string"
       },
       "status": {
        "enum": [
         "not_required",
         "required",
         "settled",
         "failed",
         "unknown"
        ],
        "type": "string"
       }
      },
      "required": [
       "status",
       "execution_status"
      ],
      "type": "object"
     },
     "result": {},
     "status": {
      "enum": [
       "succeeded",
       "failed",
       "partial",
       "outcome_unknown"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "result",
     "error",
     "meta",
     "payment",
     "next"
    ],
    "type": "object"
   },
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   },
   "meta": {
