{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Request a file export from a Box NAS to an Object Storage bucket (up to 10 files, 2 GB each; goes through export approval). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "boxId": {
    "description": "Box number (see ncloud_datafence_list_boxes)",
    "type": "integer"
   },
   "description": {
    "description": "Description of the export request (0-50 chars)",
    "maxLength": 50,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns the request without sending it",
    "type": "boolean"
   },
   "exportPurpose": {
    "description": "Purpose of the export (1-1000 chars)",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "fenceId": {
    "description": "Datafence number (see ncloud_datafence_get_datafence)",
    "type": "integer"
   },
   "fileDescription": {
    "description": "Description of the exported files (1-1000 chars)",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "sourceFilePathList": {
    "description": "Files to export (up to 10)",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "sourceNasInstanceNo": {
    "description": "Source NAS instance number (see ncloud_datafence_list_export_source_nas)",
    "type": "integer"
   },
   "targetBucketName": {
    "description": "Target bucket name",
    "type": "string"
   }
  },
  "required": [
   "fenceId",
   "boxId",
   "sourceNasInstanceNo",
   "sourceFilePathList",
   "targetBucketName",
   "fileDescription",
   "exportPurpose",
   "description"
  ],
  "type": "object"
 },
 "name": "ncloud_datafence_create_file_export"
}
