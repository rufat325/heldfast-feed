{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get details for a single course. Defaults to requesting `term` and `total_students`. Pass `include` to replace the default set with custom Canvas include[] fields (teachers, permissions, syllabus_body, sections, etc.).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "include": {
    "description": "Extra fields to include on the course (Canvas include[] param)",
    "items": {
     "enum": [
      "needs_grading_count",
      "syllabus_body",
      "public_description",
      "total_scores",
      "current_grading_period_scores",
      "grading_periods",
      "term",
      "account",
      "course_progress",
      "sections",
      "storage_quota_used_mb",
      "total_students",
      "passback_status",
      "favorites",
      "teachers",
      "observed_users",
      "tabs",
      "course_image",
      "banner_image",
      "concluded",
      "lti_context_id",
      "post_manually",
      "all_courses",
      "permissions"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "teacher_limit": {
    "description": "Limit on the number of teachers returned when include=teachers",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "course_id"
  ],
  "type": "object"
 },
 "name": "get_course",
 "title": "Get Course"
}
