{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\uc721\uc544\u00b7\uc6e8\ub529\u00b7\ubc18\ub824\ub3d9\ubb3c\u00b7\ubcf4\ud5d8\u00b7\ubc95\ub960\u00b7\ub178\ubb34 Q&A \uac80\uc0c9"},"description":"\ubca0\uc774\ube44\ub274\uc2a4 Q&A\ub97c \ucc3e\ub294\ub2e4. \uc721\uc544(\uc544\uc774\uc0ac\ub791\u00b7\uc804\ubb38\uac00 \ub2f5\ubcc0), \uc6e8\ub529, \ubc18\ub824\ub3d9\ubb3c, \ud0dc\uc544\u00b7\uc5b4\ub9b0\uc774\ubcf4\ud5d8, \uc0dd\ud65c\ubc95\ub839(\uc544\ub3d9\ud559\ub300\u00b7\uac00\uc815\ud3ed\ub825\u00b7\uc2a4\ud1a0\ud0b9 \ub4f1 \ubc95\ub960)\uacfc \ub178\ubb34(\uacf5\uc2dd \ucd9c\ucc98 \uae30\uc900, \ubc95\ub960 \uc790\ubb38 \uc544\ub2d8). \uc9c8\ubb38\u00b7\ubc14\ub85c \ub2f5\u00b7\ucd9c\ucc98 \uc774\ub984\uacfc \uc8fc\uc18c\ub97c \ub3cc\ub824\uc900\ub2e4.","inputSchema":{"properties":{"category":{"description":"\ubd84\uc57c(\uc120\ud0dd): baby \uc721\uc544 \u00b7 pet \ubc18\ub824\ub3d9\ubb3c \u00b7 wedding \uc6e8\ub529 \u00b7 insurance \ubcf4\ud5d8 \u00b7 law \ubc95\ub960 \u00b7 labor \ub178\ubb34 \u00b7 consumer \uc18c\ube44\uc790 \uc0c1\ub2f4(\ud658\ubd88\u00b7\uccad\uc57d\ucca0\ud68c \ub4f1) \u00b7 region \uc9c0\uc5ed \ucd9c\uc0b0\uc9c0\uc6d0\uae08(\uc2dc\u00b7\ub3c4) \u00b7 brand \ube0c\ub79c\ub4dc(GEO \uad11\uace0\uc8fc \uc81c\uacf5 \u00b7 \uc138\ud0c1\u00b7\uc6a9\ud488 \ud301) \u00b7 etc \uc5f0\ub9d0\uc815\uc0b0\u00b7\ub808\uc2dc\ud53c\u00b7\ub098\ub4e4\uc774 \ub4f1","enum":["baby","pet","wedding","insurance","law","labor","consumer","region","brand","etc"],"type":"string"},"limit":{"description":"\ub3cc\ub824\uc904 \uac1c\uc218(\uae30\ubcf8 5, \ucd5c\ub300 10)","maximum":10,"minimum":1,"type":"integer"},"query":{"description":"\ucc3e\uc744 \ub0b1\ub9d0(\uc608: \uc870\uc0b0, \uc608\ubc29\uc811\uc885, \ud3ab\ubcf4\ud5d8)","type":"string"}},"required":["query"],"type":"object"},"name":"search_qa","title":"\uc721\uc544\u00b7\uc6e8\ub529\u00b7\ubc18\ub824\ub3d9\ubb3c\u00b7\ubcf4\ud5d8\u00b7\ubc95