{
 "description": "Read-only hybrid semantic/keyword search over the Obsidian vault. Automatically refreshes the index after Markdown changes.",
 "inputSchema": {
  "properties": {
   "folder_exclude": {
    "type": "string"
   },
   "folder_include": {
    "type": "string"
   },
   "include_archived": {
    "default": false,
    "type": "boolean"
   },
   "include_sensitive": {
    "default": false,
    "description": "Requires OBSIDIAN_SEMANTIC_ALLOW_SENSITIVE=true on the server.",
    "type": "boolean"
   },
   "limit": {
    "default": 8,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "hybrid",
    "enum": [
     "hybrid",
     "semantic",
     "keyword"
    ],
    "type": "string"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_notes"
}
