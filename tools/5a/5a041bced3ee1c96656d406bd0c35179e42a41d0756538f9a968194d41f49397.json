{"_meta":{"securitySchemes":[{"scopes":["hairdora:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Book a salon appointment"},"description":"Use this when someone asks to book a client in at their salon. Returns the new appointment with its time, stylist and services; it takes the salon's usual length, chair and reminders, so the salon's reminder messages go to the client. Not for finding free slots.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"clientId":{"description":"Id of the client, from list_clients or create_client.","maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"durationMinutes":{"description":"Length in minutes. Leave it out for the salon's usual length.","maximum":480,"minimum":5,"type":"integer"},"note":{"description":"A note for the salon team.","maxLength":2000,"type":"string"},"providerIds":{"description":"Ids of the stylists who take it, from list_providers. Leave it out when the salon has one stylist or the user is the stylist.","items":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":5,"type":"array"},"requestId":{"description":"A unique id you choose for this booking, such as a UUID. Calling again with the same requestId returns the first booking instead of booking twice.","maxLength":64,"minLength":1,"pattern":"^[A-Za-z0-9_-]{1,64}$","type":"string"},"salonId":{"description":"Id of the salon, from list_salons. Leave it out when the user has one salon.","maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"serviceIds":{"description":"Ids of the services booked, from list_services.","items":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":20,"type":"array"},"startTime":{"description":"Start as an ISO 8601 time with the salon's UTC offset, such as 2026-11-20T10:00:00+01:00.","format":"date-time","maxLength":40,"type":"string"}},"required":["clientId","startTime","requestId"],"type":"object"},"name":"book_appointment","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"appointment":{"additionalProperties":false,"properties":{"clientId":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"endTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"id":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"lastEditTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"providerIds":{"items":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":10,"type":"array"},"reminderCount":{"maximum":100000,"minimum":0,"type":"integer"},"salonId":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"serviceCount":{"maximum":100000,"minimum":0,"type":"integer"},"services":{"items":{"additionalProperties":false,"properties":{"id":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"name":{"maxLength":200,"type":"string"},"price":{"anyOf":[{"maximum":1000000000,"minimum":-1000000000,"type":"number"},{"type":"null"}]}},"required":["id","name","price"],"type":"object"},"maxItems":20,"type":"array"},"startTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"status":{"anyOf":[{"enum":["REQUESTED","SCHEDULED","CLIENT_ARRIVED","NO_SHOW","CANCELED"],"type":"string"},{"type":"null"}]}},"required":["id","salonId","clientId","startTime","endTime","status","lastEditTime","providerIds","serviceCount","services","reminderCount"],"type":"object"},"status":{"enum":["booked","already_booked"],"type":"string"}},"required":["status","appointment"],"type":"object"},"title":"Book a salon appointment"}
