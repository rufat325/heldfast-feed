{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Point to inspected work"
 },
 "description": "Temporary shared pointer, possibly requesting reveal. Later human navigation wins; receipt says shown/deferred/expired.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "lifetime": {
    "default": 6,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "context_handle": {
        "maxLength": 128,
        "type": "string"
       },
       "kind": {
        "const": "source",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "context_handle"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "act_id": {
        "maxLength": 256,
        "type": "string"
       },
       "kind": {
        "const": "act",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "act_id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "change_id": {
        "maxLength": 128,
        "type": "string"
       },
       "kind": {
        "const": "comparison",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "change_id"
      ],
      "type": "object"
     }
    ]
   },
   "words": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "document",
   "target",
   "words"
  ],
  "type": "object"
 },
 "name": "editor.point",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Point to inspected work"
}
