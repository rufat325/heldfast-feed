{
 "description": "Post a new task to the marketplace. Requires valid poster passport. Returns taskId, txId (HCS transaction ID), and timestamp.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capabilities": {
    "description": "Required capabilities",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "deadline": {
    "description": "Deadline as unix timestamp",
    "type": "number"
   },
   "description": {
    "description": "Task description",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "posterDid": {
    "description": "Poster DID (did:hcs:tokenId:serial)",
    "minLength": 1,
    "type": "string"
   },
   "priceHbar": {
    "description": "Price in HBAR",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "title": {
    "description": "Task title",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "posterDid",
   "title",
   "description",
   "priceHbar",
   "capabilities"
  ],
  "type": "object"
 },
 "name": "post_task"
}
