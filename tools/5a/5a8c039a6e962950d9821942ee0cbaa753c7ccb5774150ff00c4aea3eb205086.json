   "conversation_id": {
    "description": "The conversation id returned by the previous Well result, in its meta under well/conversation_id, in its structuredContent, or in its JSON text block. Pass it back on every call in the same conversation, including a call a card makes, so the chosen workspace and the earlier answers still apply. It decides the conversation on its own: nothing the host states about the session replaces it. Omit it only on the first call of a conversation.",
    "type": "string"
   },
   "customer_ids": {
    "description": "Company ids of the customers to restrict the figure to. Each id matches exactly, so include every company id that names the same customer, aliases included. Omit for every customer; see the description.",
