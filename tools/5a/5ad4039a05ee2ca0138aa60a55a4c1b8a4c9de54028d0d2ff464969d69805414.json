{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create an image project"
 },
 "description": "Use this when someone wants a new Imagelato project to organize images and resize presets. Returns the new project's id, name and creation time and fires the project.created webhook. Each call creates another project. Not for adding a resize preset.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Project name, from 1 to 120 characters",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "add_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "additionalProperties": false,
    "properties": {
     "created": {
      "anyOf": [
       {
        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "anyOf": [
       {
        "maxLength": 120,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "name",
     "created"
    ],
    "type": "object"
   },
   "status": {
    "const": "created",
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Create an image project"
}
