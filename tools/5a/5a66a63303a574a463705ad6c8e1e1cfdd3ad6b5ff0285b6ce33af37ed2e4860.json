{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Quote a domain purchase"
 },
 "description": "Get the live price, protection terms and requirements for buying one listed domain, plus the checkout link to give the cardholder. Use read_for_sale_dns instead for a name that may not be listed here, and get_seller_listing for the seller's own view of a listing. Read-only. Never reveals the seller's floor and never evaluates an offer. Payment is a held card authorization on the seller's own account; the site brokers no sale. Only listed domains can be quoted.",
 "inputSchema": {
  "properties": {
   "domain": {
    "description": "The listed domain name to quote, such as example.com.",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "quote_domain_purchase",
 "outputSchema": {
  "properties": {
   "acceptsOffers": {
    "type": "boolean"
   },
   "appraisal": {
    "description": "Null when listed by DNS.",
    "properties": {
     "fairUsd": {
      "type": "number"
     },
     "highUsd": {
      "type": "number"
     },
     "lowUsd": {
      "type": "number"
     },
     "priceToFairRatio": {
      "type": "number"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "available": {
    "description": "False when the sale needs escrow, not card checkout.",
    "type": "boolean"
   },
   "buyerPaysCents": {
    "type": "integer"
   },
   "checkedAt": {
    "type": "string"
   },
   "checkout": {
    "properties": {
     "method": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "checkoutUrl": {
    "description": "Give this to the cardholder.",
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "escrow": {
    "type": [
     "object",
     "null"
    ]
   },
   "priceCents": {
    "type": "integer"
   },
   "protection": {
    "properties": {
     "autoReleaseCapCents": {
      "type": "integer"
     },
     "holdDays": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "verify": {
    "type": [
     "object",
     "null"
    ]
   }
  },
  "required": [
   "domain",
   "available",
   "priceCents",
   "buyerPaysCents",
   "checkoutUrl"
  ],
  "type": "object"
 },
 "title": "Quote a domain purchase"
}
