{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \ub0b4\uc6a9\uac80\uc99d\uae4c\uc9c0 \ub05d\ub098 \ubcc0\ud658\uc774 \uc644\ub8cc\ub41c \uc791\uc5c5\uc5d0\uc11c \uc81c\ucd9c\ud560 \uc6d0\ucc9c\uc138 \uc2e0\uace0 \ub300\uc0c1 \uc804\uccb4\ub97c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \ubcc0\ud658\uc774 \ub05d\ub098\uc9c0 \uc54a\uc558\uac70\ub098 \uc815\uc0c1 \ubcc0\ud658\ub41c \ub300\uc0c1\uc774 \uc5c6\uc73c\uba74 \uac70\uc808\ub429\ub2c8\ub2e4. \uc81c\ucd9c\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. submit \uc740 \uc774 \ub2e8\uacc4\uc758 job_id \ub97c source_job_id \ub85c \ubc1b\uc544 \ubbf8\ub9ac \ubcf8 \ub300\uc0c1\uc774 \uadf8\ub300\ub85c\uc77c \ub54c\ub9cc \uc81c\ucd9c\ud569\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 2\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"expected_snapshot_hash":{"description":"source_job_id \uc791\uc5c5 \uacb0\uacfc\uc758 snapshot_hash \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(\uc18c\ubb38\uc790 16\uc9c4\uc218 64\uc790\ub9ac). \uadf8 \uc791\uc5c5\uc758 \ub0b4\uc6a9\uacfc \ub9de\uc9c0 \uc54a\uc73c\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uc791\uc131 \ub0b4\uc6a9\uc774 \ubc14\ub00c\uc5c8\ub2e4\ub294 \uc624\ub958(409)\ub85c \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^[0-9a-f]{64}$","title":"Expected Snapshot Hash","type":"string"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"},"source_job_id":{"description":"\uc774\uc5b4\uc11c \uc9c4\ud589\ud560 \uc774\uc804 \ub2e8\uacc4 \uc791\uc5c5\uc758 job_id \ub97c \uadf8\ub300\ub85c \uc785\ub825\ud569\ub2c8\ub2e4(job_ \uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uc791\uc5c5 \ubc88\ud638). \ubcc0\ud658\uc774 \ub05d\ub098 \uc81c\ucd9c\ud560 \uc218 \uc788\ub294 \uc0c1\ud0dc\uc758 \uacb0\uacfc\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uae30\uad00\uc5d0\uc11c \uc81c\ucd9c \uac00\ub2a5\ud55c \ubcc0\ud658 \uacb0\uacfc\uac00 \uc5c6\uc73c\uba74 409 \ub85c \uac70\uc808\ud569\ub2c8\ub2e4. \uac19\uc740 \uc870\uc9c1\uacfc \ud658\uacbd, \uac19\uc740 \uae30\uad00 \uc5f0\uacb0\uc5d0\uc11c \uc131\uacf5\ud55c \uc6d0\ucc9c\uc138 \ud30c\uc77c\ubcc0\ud658 \uc791\uc5c5\uc774\uc5b4\uc57c \ud558\uace0 \uc544\ub2c8\uba74 \uc9c4\ud589\ud558\uc9c0 \uc54a\uace0 \uac70\uc808\ud569\ub2c8\ub2e4.","pattern":"^job_[0-9A-HJKMNP-TV-Z]{26}$","title":"Source Job Id","type":"string"}},"required":["source_job_id","expected_snapshot_hash"],"title":"PreviewRequest","type":"object"},"name":"hometax__tax__withholding__file_conversion__preview","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\ud648\ud0dd\uc2a4 \uc6d0\ucc9c\uc138 \uc804\uc790\ud30c\uc77c \ubcc0\ud658\uc2e0\uace0 \uc81c\ucd9c \uc804 \ubbf8\ub9ac\ubcf4\uae30"}
