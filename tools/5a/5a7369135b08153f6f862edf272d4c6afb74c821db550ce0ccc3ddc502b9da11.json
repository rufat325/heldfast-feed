{
 "description": "Replay a recording in the current session. Executes each step directly against the browser. Override {{placeholder}} params with the params object. Set onError='skip' to continue past failures.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "onError": {
    "description": "Error handling: stop (default) or skip.",
    "enum": [
     "stop",
     "skip"
    ],
    "type": "string"
   },
   "params": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Parameter overrides for {{placeholder}} values.",
    "type": "object"
   },
   "recording": {
    "description": "Recording JSON string (from session_export).",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID.",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "recording"
  ],
  "type": "object"
 },
 "name": "session_replay",
 "title": "Replay Session Recording"
}
