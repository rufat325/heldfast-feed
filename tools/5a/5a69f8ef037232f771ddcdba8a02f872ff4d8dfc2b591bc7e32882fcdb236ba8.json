{
 "description": "Calculate average damage per round (DPR) for an attack routine. Computes hit probability, critical hit chance, average damage, and turns to kill.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advantage": {
    "default": false,
    "description": "Whether attacks have advantage",
    "type": "boolean"
   },
   "attack_bonus": {
    "description": "Attack roll modifier (e.g. +7)",
    "type": "number"
   },
   "crit_range": {
    "default": 20,
    "description": "Minimum roll for critical hit (default 20)",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "damage_dice": {
    "description": "Damage dice notation (e.g. \"2d6+5\", \"1d8+3\")",
    "type": "string"
   },
   "disadvantage": {
    "default": false,
    "description": "Whether attacks have disadvantage",
    "type": "boolean"
   },
   "num_attacks": {
    "default": 1,
    "description": "Number of attacks per round",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "target_ac": {
    "description": "Target Armor Class",
    "maximum": 30,
    "minimum": 1,
    "type": "number"
   },
   "target_hp": {
    "description": "Target hit points (for turns-to-kill calculation)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "attack_bonus",
   "damage_dice",
   "target_ac"
  ],
  "type": "object"
 },
 "name": "simulate_damage"
}
