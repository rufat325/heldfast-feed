{
 "description": "Pre-commit, proof-carrying change safeguard. Given a natural-language task and current diff/files, returns compact edit contexts, bounded call-argument data-flow, blast radius, graph/architecture/duplicate/API ratchets, affected tests, and one PASS/BLOCKED/UNKNOWN verdict. Use this high-level workflow before manually composing lower-level checks. Package tests run only when explicitly requested and WEAVATRIX_ALLOW_TEST_RUNS=1.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "api_contract": {
    "additionalProperties": true,
    "properties": {
     "backend": {
      "type": "string"
     },
     "changed_files": {
      "items": {
       "type": "string"
      },
      "maxItems": 500,
      "type": "array"
     },
     "clients": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "method": {
      "enum": [
       "GET",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "HEAD",
       "OPTIONS"
      ],
      "type": "string"
     },
     "path": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "backend",
     "clients"
    ],
    "type": "object"
   },
   "base_ref": {
    "default": "HEAD",
    "maxLength": 200,
    "type": "string"
   },
   "data_flow_depth": {
    "default": 2,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "diff": {
    "maxLength": 2097152,
    "type": "string"
   },
   "duplicate_ratchet": {
    "default": true,
    "type": "boolean"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "impact_depth": {
    "default": 2,
    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "max_data_flow_edges": {
    "default": 30,
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "max_impact_nodes": {
    "default": 40,
    "maximum": 120,
    "minimum": 5,
    "type": "integer"
   },
   "max_symbols": {
    "default": 3,
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "output_format": {
    "default": "text",
    "description": "text returns only the concise TextContent summary; json also returns and mirrors the stable structuredContent envelope",
    "enum": [
     "text",
     "json"
    ],
    "type": "string"
   },
   "phase": {
    "default": "plan",
    "enum": [
     "plan",
     "verify"
    ],
    "type": "string"
   },
   "precision": {
    "default": "auto",
    "enum": [
     "auto",
     "graph",
     "lsp"
    ],
    "type": "string"
   },
   "run_tests": {
    "default": false,
    "type": "boolean"
   },
   "task": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "test_timeout_ms": {
    "default": 60000,
    "maximum": 300000,
    "minimum": 1000,
    "type": "integer"
   },
   "tests": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "args": {
       "items": {
        "maxLength": 300,
        "type": "string"
       },
       "maxItems": 40,
       "type": "array"
      },
      "script": {
       "maxLength": 120,
       "type": "string"
      }
     },
     "required": [
      "script"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "verified_change"
}
