 "description": "Requires the authenticated /mcp/me connection. Start a campaign from a product or store-visit brief. draft.v1 ranks observed league product presence, product nouns, place/screen evidence, category, cached Gemini Embedding 2 text cosine and keywords. Hits precede members and slotted precedes thin. It abstains when evidence does not fit and never pads. Optional visit carries place_type, area and radius_km; area/radius are campaign constraints, not measured reference distances. index_size is the whole index, eligible_candidates are fits. compose opens the signed-in composer with up to three formats. No model call or campaign write in this request.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "product": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "visit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "area": {
        "anyOf": [
         {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "city": {
        "anyOf": [
         {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "place_type": {
        "enum": [
         "cafe",
         "restaurant",
         "salon",
         "nail",
         "gym",
         "workshop",
         "clinic",
         "stay",
         "other"
        ],
        "type": "string"
       },
       "radius_km": {
        "anyOf": [
         {
          "exclusiveMinimum": 0,
          "maximum": 30,
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       }
      },
      "required": [
       "place_type"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "product"
  ],
  "type": "object"
 },
 "name": "shorti_campaign_draft",
