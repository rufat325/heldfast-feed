{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "profile.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update customer name, phone, and delivery address after signed-in browser approval.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "maxLength": 500,
    "minLength": 10,
    "type": "string"
   },
   "confirmation_id": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "phone": {
    "maxLength": 32,
    "minLength": 7,
    "type": "string"
   }
  },
  "required": [
   "name",
   "phone",
   "address"
  ],
  "type": "object"
 },
 "name": "update_profile",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "propertyNames": {
   "type": "string"
  },
  "type": "object"
 },
 "title": "Update Profile"
}
