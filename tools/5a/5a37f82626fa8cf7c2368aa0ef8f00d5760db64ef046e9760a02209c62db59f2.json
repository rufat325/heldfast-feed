{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Frontend Rules"
 },
 "description": "Finds frontend rules by keywords, category, and priority, returning paginated slugs, titles, and short summaries. Use it when the user requests relevant practices for a technology, concern, or pattern, such as web fonts or accessible forms.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://frontendchecklist.io/favicon.svg"
  }
 ],
 "inputSchema": {
  "properties": {
   "categories": {
    "description": "Only return rules in these categories.",
    "items": {
     "enum": [
      "html",
      "css",
      "javascript",
      "performance",
      "accessibility",
      "seo",
      "security",
      "images",
      "testing",
      "privacy",
      "pwa",
      "i18n"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "cursor": {
    "description": "Cursor from a previous response, to fetch the next page of results.",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results to return (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "priorities": {
    "description": "Only return rules with these priorities.",
    "items": {
     "enum": [
      "critical",
      "high",
      "medium",
      "low"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "Keywords to match, e.g. 'lazy loading images'. Omit to list rules by filters only.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_rules",
 "outputSchema": {
  "properties": {
   "nextCursor": {
    "type": "string"
   },
   "rules": {
    "items": {
     "properties": {
      "categories": {
       "items": {
        "enum": [
         "html",
         "css",
         "javascript",
         "performance",
         "accessibility",
         "seo",
         "security",
         "images",
         "testing",
         "privacy",
         "pwa",
         "i18n"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "primaryCategory": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "totalCount": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search Frontend Rules"
}
