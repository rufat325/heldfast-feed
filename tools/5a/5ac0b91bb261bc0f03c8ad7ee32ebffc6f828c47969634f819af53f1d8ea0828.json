{"annotations":{"openWorldHint":false,"readOnlyHint":true,"title":"Entry and exit pages"},"description":"Get entry pages (where sessions start) and exit pages (where sessions end). Shows which pages attract new visits and where users leave. Useful for identifying effective landing pages and high-exit pages that may need improvement. Optional filters segment by country, browser, os, device type, UTM source, or referrer.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"filter_browser":{"description":"Browser substring match (e.g. 'Chrome')","type":"string"},"filter_country":{"description":"2-letter country code (e.g. 'US')","type":"string"},"filter_device_type":{"description":"Device type: 'desktop' | 'mobile' | 'tablet'","type":"string"},"filter_os":{"description":"OS substring match (e.g. 'iOS')","type":"string"},"filter_referrer_contains":{"description":"Referrer substring (e.g. 'google')","type":"string"},"filter_utm_source":{"description":"Exact UTM source (e.g. 'twitter')","type":"string"},"limit":{"default":20,"description":"Max results (1-1000)","type":"number"},"period":{"default":"30d","description":"Time period","type":"string"},"site":{"description":"Site domain or UUID","type":"string"}},"required":["site"],"type":"object"},"name":"get_entry_exit_pages","title":"Entry and exit pages"}
