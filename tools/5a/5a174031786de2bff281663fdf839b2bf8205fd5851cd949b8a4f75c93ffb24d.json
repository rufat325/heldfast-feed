{
 "description": "Tune odoo.conf workers and memory limits.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "concurrentUsers": {
    "default": 25,
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "cpuCores": {
    "default": 4,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "profile": {
    "default": "production",
    "enum": [
     "production",
     "staging",
     "dev"
    ],
    "type": "string"
   },
   "proxyMode": {
    "default": true,
    "type": "boolean"
   },
   "sharedWithPostgres": {
    "default": false,
    "type": "boolean"
   },
   "totalRamMb": {
    "default": 8192,
    "maximum": 1048576,
    "minimum": 512,
    "type": "integer"
   },
   "version": {
    "default": 18,
    "enum": [
     15,
     16,
     17,
     18,
     19
    ],
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "odoo-conf-tuner",
 "title": "Odoo Worker & Memory Tuner"
}
