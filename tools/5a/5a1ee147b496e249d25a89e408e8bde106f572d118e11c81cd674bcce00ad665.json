{
 "annotations": {},
 "description": "Style parts of a TEXT node (bold, color, link, list). Each range is characters [start, end). Later ranges win on overlap; omitted properties stay.",
 "inputSchema": {
  "properties": {
   "nodeId": {
    "description": "TEXT node ID",
    "type": "string"
   },
   "ranges": {
    "description": "Ranges to style; start and end required",
    "items": {
     "properties": {
      "color": {
       "description": "Color hex",
       "type": "string"
      },
      "end": {
       "description": "End index (not included)",
       "type": "number"
      },
      "fontFamily": {
       "description": "Font family e.g. 'Inter'",
       "type": "string"
      },
      "fontSize": {
       "description": "Font size",
       "type": "number"
      },
      "fontStyle": {
       "description": "Font style e.g. 'Bold'",
       "type": "string"
      },
      "hyperlink": {
       "description": "Link URL; null removes"
      },
      "indentation": {
       "description": "List indent level",
       "type": "number"
      },
      "letterSpacing": {
       "description": "Letter spacing",
       "type": "number"
      },
      "letterSpacingUnit": {
       "description": "Default PIXELS",
       "enum": [
        "PIXELS",
        "PERCENT"
       ],
       "type": "string"
      },
      "lineHeight": {
       "description": "Number or 'AUTO'"
      },
      "lineHeightUnit": {
       "description": "Default PIXELS",
       "enum": [
        "PIXELS",
        "PERCENT"
       ],
       "type": "string"
      },
      "listType": {
       "description": "Numbered or bulleted list",
       "enum": [
        "NONE",
        "ORDERED",
        "UNORDERED"
       ],
       "type": "string"
      },
      "opacity": {
       "description": "Color opacity 0-1",
       "type": "number"
      },
      "start": {
       "description": "Start index, from 0",
       "type": "number"
      },
      "textCase": {
       "description": "Case",
       "enum": [
        "ORIGINAL",
        "UPPER",
        "LOWER",
        "TITLE"
       ],
       "type": "string"
      },
      "textDecoration": {
       "description": "Decoration",
       "enum": [
        "NONE",
        "UNDERLINE",
        "STRIKETHROUGH"
       ],
       "type": "string"
      }
     },
     "required": [
      "start",
      "end"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "nodeId",
   "ranges"
  ],
  "type": "object"
 },
 "name": "set_text_ranges"
}
