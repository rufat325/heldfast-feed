{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get puzzle results"
 },
 "description": "Per-model outcomes for one puzzle. Answers are omitted unless requested.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "effort": {
    "description": "best, all (default), or one effort level",
    "type": "string"
   },
   "family": {
    "description": "Comma-separated family ids; empty means no filter",
    "type": "string"
   },
   "id": {
    "description": "Puzzle id from list_puzzles",
    "type": "string"
   },
   "include_answers": {
    "description": "Include each model's answer grid",
    "type": "boolean"
   },
   "open_weights": {
    "description": "Only open-weight (true) or closed (false) models",
    "type": "boolean"
   },
   "provider": {
    "description": "Comma-separated provider ids; empty means no filter",
    "type": "string"
   },
   "reasoning": {
    "description": "Only reasoning (true) or non-reasoning (false) variants",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_puzzle_results",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attempts": {
    "type": "number"
   },
   "index": {
    "type": "number"
   },
   "puzzleId": {
    "type": "string"
   },
   "runs": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "answer": {
       "type": [
        "string",
        "null"
       ]
      },
      "correct": {
       "type": "boolean"
      },
      "displayName": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "model",
      "correct",
      "status",
      "displayName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "size": {
    "type": "string"
   },
   "solved": {
    "type": "number"
   },
   "updatedAt": {
    "type": "string"
   }
  },
  "required": [
   "updatedAt",
   "puzzleId",
   "index",
   "size",
   "attempts",
   "solved",
   "runs"
  ],
  "type": "object"
 },
 "title": "Get puzzle results"
}
