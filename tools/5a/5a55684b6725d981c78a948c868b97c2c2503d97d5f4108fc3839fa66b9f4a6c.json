{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Scroll browser page"
 },
 "description": "Scroll an explicitly addressed page by bounded integer pixel deltas. Use deltaX for horizontal and deltaY for vertical movement; this typed operation exposes no arbitrary JavaScript and remains serialized within the session.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deltaX": {
    "maximum": 1000000,
    "minimum": -1000000,
    "type": "integer"
   },
   "deltaY": {
    "maximum": 1000000,
    "minimum": -1000000,
    "type": "integer"
   },
   "pageId": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
   },
   "timeoutMs": {
    "exclusiveMinimum": 0,
    "maximum": 300000,
    "type": "integer"
   }
  },
  "required": [
   "sessionId",
   "pageId",
   "deltaX",
   "deltaY"
  ],
  "type": "object"
 },
 "name": "browser_scroll",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "completed": {
    "const": true,
    "type": "boolean"
   },
   "operationId": {
    "minLength": 1,
    "type": "string"
   },
   "pageId": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "operationId",
   "sessionId",
   "pageId",
   "completed"
  ],
  "type": "object"
 },
 "title": "Scroll browser page"
}
