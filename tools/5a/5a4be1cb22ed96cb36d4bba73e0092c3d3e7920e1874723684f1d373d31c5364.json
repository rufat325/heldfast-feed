{
 "_meta": {
  "openai/toolInvocation/invoked": "Files read",
  "openai/toolInvocation/invoking": "Reading files from your site"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Batched version of read_file. Pass up to 50 paths; each is fetched independently with the same per-file rules as read_file. The whole batch is capped at 8388608 bytes total \u2014 once that's exhausted, remaining paths fail with BATCH_BUDGET_EXCEEDED so the agent can re-request them in another call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxBytesPerFile": {
    "description": "Per-file cap. Default 1048576, hard max 5242880.",
    "exclusiveMinimum": 0,
    "maximum": 5242880,
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "paths": {
    "description": "Site-relative paths to read (1..50). Order is preserved in the response.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "siteId": {
    "type": "string"
   }
  },
  "required": [
   "paths"
  ],
  "type": "object"
 },
 "name": "read_files",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budgetExceededAt": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Index of the first path that was skipped due to the cumulative byte budget, or null if everything fit."
   },
   "files": {
    "description": "One entry per requested path, in the same order. Each entry is independent: a missing file or oversized file fails its own entry but does not abort the whole batch. If the cumulative byte budget is exhausted partway through, remaining entries fail with code BATCH_BUDGET_EXCEEDED.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "content": {
         "type": "string"
        },
        "encoding": {
         "enum": [
          "utf8",
          "base64"
         ],
         "type": "string"
        },
        "ok": {
         "const": true,
         "type": "boolean"
        },
        "path": {
         "type": "string"
        },
        "size": {
         "type": "number"
        }
       },
       "required": [
        "ok",
        "path",
        "size",
        "encoding",
        "content"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "error": {
         "additionalProperties": false,
         "properties": {
          "code": {
           "type": "string"
          },
          "details": {
           "additionalProperties": {},
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          },
          "message": {
           "type": "string"
          }
         },
         "required": [
          "code",
          "message"
         ],
         "type": "object"
        },
        "ok": {
         "const": false,
         "type": "boolean"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "ok",
        "path",
        "error"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "totalBytes": {
    "description": "Sum of bytes returned across successful entries.",
    "type": "number"
   }
  },
  "required": [
   "siteId",
   "name",
   "files",
   "totalBytes",
   "budgetExceededAt"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read multiple files from a deployed site in one call"
}
