    "description": "ISO-8601 block timestamp, null if pending.",
    "type": [
     "string",
     "null"
    ]
   },
   "to": {
    "description": "Recipient address (contract or EOA); null for contract creation.",
    "type": [
     "string",
     "null"
    ]
   },
   "ts": {
    "description": "ISO-8601 timestamp of this response.",
    "type": "string"
   },
   "value_eth": {
