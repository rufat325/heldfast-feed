      "description": "Token contract address.",
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "fee_eth": {
    "description": "Transaction fee in ETH (gas_used \u00d7 gas_price).",
    "type": [
     "number",
     "null"
    ]
   },
   "from": {
    "description": "Sender address.",
    "type": "string"
   },
   "gas_price_gwei": {
    "description": "Gas price in Gwei.",
    "type": [
     "number",
     "null"
    ]
   },
   "gas_used": {
    "description": "Gas units consumed.",
    "type": [
     "integer",
     "null"
    ]
   },
   "hash": {
    "description": "Transaction hash.",
    "type": "string"
   },
   "method": {
    "description": "Decoded method name if recognized, 4-byte selector if not, null for plain ETH transfer.",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "description": "Execution status.",
    "enum": [
     "success",
     "failed",
     "pending"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-sentence agent-readable description of what this transaction did.",
    "type": "string"
   },
