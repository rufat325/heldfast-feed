        "items": {
         "description": "Reverse-domain identifier. Must contain at least two dot-separated segments (e.g., 'com.example.loyalty').",
         "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9_-]*[a-z0-9_])?)+$",
         "type": "string"
        },
        "type": "array"
       },
       "intent": {
        "description": "Context describing buyer's intent.",
        "type": "string"
       },
       "language": {
        "description": "Language tag in IETF BCP 47 format.",
        "type": "string"
       },
       "postal_code": {
        "description": "Postal code hint for localization.",
        "type": "string"
       }
      },
      "type": "object"
     },
     "discounts": {
      "description": "Discount or promo codes to apply to the cart. Only prompt if customer mentions having a discount code.",
