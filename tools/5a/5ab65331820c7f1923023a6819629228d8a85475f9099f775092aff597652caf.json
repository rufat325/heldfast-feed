{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run the same focused transcript query across 2 to 5 YouTube videos and return timestamp-linked evidence for comparison. No YouTube API key is required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contextLines": {
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "language": {
    "description": "Optional caption language code",
    "type": "string"
   },
   "matchMode": {
    "enum": [
     "word",
     "substring"
    ],
    "type": "string"
   },
   "maxSegmentsPerVideo": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Phrase or word to find in every transcript",
    "minLength": 1,
    "type": "string"
   },
   "videos": {
    "description": "YouTube video IDs or URLs",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "videos",
   "query"
  ],
  "type": "object"
 },
 "name": "research-videos",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "label": {
          "type": "string"
         },
         "seconds": {
          "minimum": 0,
          "type": "number"
         },
         "sourceUrl": {
          "format": "uri",
          "type": "string"
         },
         "text": {
          "type": "string"
         },
         "timestamp": {
          "type": "string"
         }
        },
        "required": [
         "label",
         "timestamp",
         "seconds",
         "text",
         "sourceUrl"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "durationSeconds": {
       "minimum": 0,
       "type": "number"
      },
      "language": {
       "type": "string"
      },
      "matchMode": {
       "anyOf": [
        {
         "enum": [
          "word",
          "substring"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "nextOffset": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "offset": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "query": {
       "type": [
        "string",
        "null"
       ]
      },
      "returnedSegments": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "source": {
       "additionalProperties": false,
       "properties": {
        "channelId": {
         "type": [
          "string",
          "null"
         ]
        },
        "channelName": {
         "type": [
          "string",
          "null"
         ]
        },
        "channelUrl": {
         "anyOf": [
          {
           "format": "uri",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "thumbnailUrl": {
         "anyOf": [
          {
           "format": "uri",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "title": {
         "type": "string"
        },
        "videoId": {
         "type": "string"
        },
        "videoUrl": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "videoId",
        "title",
        "videoUrl",
        "channelId",
        "channelName",
        "channelUrl",
        "thumbnailUrl"
       ],
       "type": "object"
      },
      "sourceUrl": {
       "format": "uri",
       "type": "string"
      },
      "timeRange": {
       "additionalProperties": false,
       "properties": {
        "endSeconds": {
         "type": [
          "number",
          "null"
         ]
        },
        "startSeconds": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "required": [
        "startSeconds",
        "endSeconds"
       ],
       "type": "object"
      },
      "totalAvailableSegments": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "totalTranscriptSegments": {
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      },
      "truncated": {
       "type": "boolean"
      },
      "videoId": {
       "type": "string"
      }
     },
     "required": [
      "videoId",
      "sourceUrl",
      "source",
      "language",
      "query",
      "matchMode",
      "timeRange",
      "totalTranscriptSegments",
      "totalAvailableSegments",
      "returnedSegments",
      "offset",
      "truncated",
      "nextOffset",
      "durationSeconds",
      "citations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "videosRequested": {
    "maximum": 5,
    "minimum": 2,
    "type": "integer"
   }
  },
  "required": [
   "query",
   "videosRequested",
   "results"
  ],
  "type": "object"
 },
 "title": "Compare evidence across YouTube videos"
}
