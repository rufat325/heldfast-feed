{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get tour reviews"
 },
 "description": "Get the rating summary and written reviews for one TripWays tour by bokun_id. Written reviews come from travelers who booked on TripWays and carry first name, country, date, star rating, and text; the overall rating can also include ratings from other platforms. limit sets how many written reviews to return (1 to 10, default 5, newest first).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_id": {
    "pattern": "^[0-9]+$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "bokun_id"
  ],
  "type": "object"
 },
 "name": "get_tour_reviews",
 "outputSchema": {
  "properties": {
   "bokun_id": {
    "type": "string"
   },
   "error": {
    "description": "Present when ok is false. code: tour_not_found, destination_not_found, destination_ambiguous, or unpriced. message is written for the traveler.",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "rating": {
    "properties": {
     "count": {
      "type": "integer"
     },
     "low_confidence": {
      "description": "True when there are fewer than 10 reviews.",
      "type": "boolean"
     },
     "value": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "reviews": {
    "items": {
     "properties": {
      "author": {
       "description": "First name only.",
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "date": {
       "description": "YYYY-MM-DD.",
       "type": "string"
      },
      "rating": {
       "description": "1 to 5.",
       "type": "integer"
      },
      "text": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "site_reviews": {
    "description": "Reviews written on TripWays by travelers who booked.",
    "properties": {
     "average": {
      "type": "number"
     },
     "count": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Get tour reviews"
}
