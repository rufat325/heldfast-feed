{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"For a person who wants feedback on their CV. Checks it against the same rules the CV Chap Chap builder uses: complete contact details, a summary, at least two duties and dates for every job, education, at least five skills and nothing left in [brackets]. Returns each check with a fix. Reads only the CV it is given and stores nothing.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"cv":{"properties":{"certifications":{"default":[],"items":{"properties":{"issuer":{"maxLength":160,"type":"string"},"name":{"maxLength":160,"type":"string"},"year":{"maxLength":20,"type":"string"}},"required":["name"],"type":"object"},"maxItems":15,"type":"array"},"education":{"default":[],"items":{"properties":{"field":{"maxLength":160,"type":"string"},"institution":{"maxLength":160,"type":"string"},"qualification":{"description":"e.g. BCom Accounting, Diploma in Nursing","maxLength":160,"type":"string"},"year":{"description":"Graduation year or YYYY-MM","maxLength":20,"type":"string"}},"required":["institution"],"type":"object"},"maxItems":10,"type":"array"},"email":{"maxLength":200,"type":"string"},"experience":{"default":[],"items":{"properties":{"company":{"maxLength":160,"type":"string"},"current":{"type":"boolean"},"duties":{"default":[],"description":"What the person did, one line each","items":{"maxLength":400,"type":"string"},"maxItems":15,"type":"array"},"endDate":{"description":"YYYY-MM; leave empty when current","maxLength":20,"type":"string"},"jobTitle":{"maxLength":120,"type":"string"},"location":{"maxLength":120,"type":"string"},"startDate":{"description":"YYYY-MM","maxLength":20,"type":"string"}},"required":["jobTitle"],"type":"object"},"maxItems":15,"type":"array"},"fullName":{"description":"First and last name","maxLength":120,"type":"string"},"languages":{"default":[],"items":{"properties":{"level":{"enum":["basi