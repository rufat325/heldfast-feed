     },
     "schema_version": {
      "const": "2",
      "type": "string"
     },
     "state_ref": {
      "format": "uuid",
      "type": "string"
     },
     "state_token": {
      "maxLength": 128,
      "type": "string"
     }
    },
    "required": [
