    "format": "uuid",
    "type": [
     "string",
     "null"
    ]
   },
   "recover_task_ref": {
    "description": "Recover state using a previously gateway-issued task reference. Reads only; does not execute or parse.",
    "format": "uuid",
    "type": "string"
   },
   "request_id": {
    "format": "uuid",
    "type": "string"
   },
   "state": {
    "additionalProperties": false,
    "properties": {
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "focus": {
      "additionalProperties": false,
      "properties": {
       "entity_refs": {
        "items": {
         "format": "uuid",
         "type": "string"
        },
