{
 "annotations": {
  "destructiveHint": true,
  "title": "Update an invoice"
 },
 "description": "Edit an invoice; only the fields you pass change, but line_items (if passed) replace every existing line. Does not send anything. Invoice Ninja: PUT /api/v1/invoices/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "Document date, YYYY-MM-DD.",
    "type": "string"
   },
   "discount": {
    "description": "Document-level discount (amount or percent).",
    "type": "number"
   },
   "due_date": {
    "description": "Due date (valid-until for quotes), YYYY-MM-DD.",
    "type": "string"
   },
   "footer": {
    "description": "Footer text.",
    "type": "string"
   },
   "invoice_id": {
    "description": "The invoice's hashed id, e.g. \"Wpmbk5ezJn\".",
    "minLength": 1,
    "type": "string"
   },
   "is_amount_discount": {
    "description": "true = discount is an amount; false = a percentage.",
    "type": "boolean"
   },
   "line_items": {
    "description": "Line items. On update this REPLACES all existing lines.",
    "items": {
     "properties": {
      "cost": {
       "description": "Unit price.",
       "type": "number"
      },
      "discount": {
       "description": "Line discount (amount or percent, see is_amount_discount).",
       "type": "number"
      },
      "is_amount_discount": {
       "description": "true = discount is an amount; false = a percentage.",
       "type": "boolean"
      },
      "notes": {
       "description": "Line description.",
       "type": "string"
      },
      "product_key": {
       "description": "Product / item name (the product key).",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity.",
       "type": "number"
      },
      "tax_name1": {
       "description": "First tax name, e.g. VAT.",
       "type": "string"
      },
      "tax_name2": {
       "description": "Second tax name.",
       "type": "string"
      },
      "tax_rate1": {
       "description": "First tax rate in percent.",
       "type": "number"
      },
      "tax_rate2": {
       "description": "Second tax rate in percent.",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "number": {
    "description": "Document number. Omit to let Invoice Ninja assign the next one.",
    "type": "string"
   },
   "partial": {
    "description": "Deposit / partial amount due first.",
    "type": "number"
   },
   "partial_due_date": {
    "description": "Due date of the partial amount, YYYY-MM-DD.",
    "type": "string"
   },
   "po_number": {
    "description": "Purchase order number.",
    "type": "string"
   },
   "private_notes": {
    "description": "Internal notes, not shown to the client.",
    "type": "string"
   },
   "project_id": {
    "description": "Link to a project (hashed id).",
    "type": "string"
   },
   "public_notes": {
    "description": "Notes shown to the client.",
    "type": "string"
   },
   "tax_name1": {
    "description": "Document-level tax name.",
    "type": "string"
   },
   "tax_rate1": {
    "description": "Document-level tax rate in percent.",
    "type": "number"
   },
   "terms": {
    "description": "Terms text.",
    "type": "string"
   }
  },
  "required": [
   "invoice_id"
  ],
  "type": "object"
 },
 "name": "invoiceninja_update_invoice",
 "title": "Update an invoice"
}
