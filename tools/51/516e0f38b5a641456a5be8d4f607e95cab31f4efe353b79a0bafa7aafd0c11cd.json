{
 "description": "Rasterize one or more PDF pages to PNG, JPEG, or WebP images.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dpi": {
    "description": "Resolution (72-300)",
    "maximum": 300,
    "minimum": 72,
    "type": "number"
   },
   "format": {
    "description": "Output image format",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "pages": {
    "description": "Pages to render (e.g. \"1,3\")",
    "type": "string"
   },
   "pdf_base64": {
    "description": "Base64-encoded PDF file",
    "type": "string"
   }
  },
  "required": [
   "pdf_base64"
  ],
  "type": "object"
 },
 "name": "bytario_pdf_render_page"
}
