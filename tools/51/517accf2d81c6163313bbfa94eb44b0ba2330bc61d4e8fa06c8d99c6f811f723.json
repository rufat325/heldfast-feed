{
 "description": "Queue a single sequence step execution against a campaign contact. Always requires human approval before dispatch (per TAP send doctrine).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "follow",
     "like",
     "comment",
     "dm",
     "email",
     "portal_submit",
     "connect",
     "mail"
    ],
    "type": "string"
   },
   "body": {
    "type": "string"
   },
   "campaign_contact_id": {
    "format": "uuid",
    "type": "string"
   },
   "channel": {
    "enum": [
     "email",
     "instagram",
     "linkedin",
     "portal",
     "physical"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "scheduled_for": {
    "description": "ISO timestamp for dispatch",
    "format": "date-time",
    "type": "string"
   },
   "sequence_id": {
    "format": "uuid",
    "type": "string"
   },
   "step_index": {
    "description": "Step index within the sequence (default 0)",
    "type": "integer"
   },
   "subject": {
    "type": "string"
   }
  },
  "required": [
   "sequence_id",
   "campaign_contact_id",
   "channel",
   "action",
   "scheduled_for"
  ],
  "type": "object"
 },
 "name": "tap_queue_execution"
}
