    "type": "integer"
   },
   "query": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "sourceUrl": {
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "html",
   "sourceUrl",
   "query"
  ],
  "type": "object"
 },
