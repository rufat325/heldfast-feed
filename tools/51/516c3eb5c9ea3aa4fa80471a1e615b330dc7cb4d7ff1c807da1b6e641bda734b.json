{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Acknowledge a received message as delivered or read. Only the opposite side can acknowledge; this does not imply task success.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "conversation_id": {
    "maxLength": 64,
    "pattern": "^[a-z]+_[0-9a-f]{32}$",
    "type": "string"
   },
   "expected_message_version": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "message_id": {
    "maxLength": 64,
    "pattern": "^[a-z]+_[0-9a-f]{32}$",
    "type": "string"
   },
   "receipt": {
    "enum": [
     "delivered",
     "read"
    ],
    "type": "string"
   }
  },
  "required": [
   "expected_message_version",
   "receipt",
   "conversation_id",
   "message_id",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "ack_conversation_message",
 "title": "Acknowledge a received message"
}
