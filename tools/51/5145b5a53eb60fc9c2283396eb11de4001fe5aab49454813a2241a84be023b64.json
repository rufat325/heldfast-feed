{
 "_meta": {
  "openai/outputTemplate": "ui://xona-dental-gateway/card.html",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://xona-dental-gateway/card.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Move or cancel one of the patient's appointments. Xona texts the patient a link to a page that shows the exact change. When they press its button (or type the code from the text on book.xonark.com/code) the practice's schedule changes, or, at a practice that confirms changes itself, the practice receives the request. Calling again with the same arguments returns the result, read live from the practice's schedule.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action_id": {
    "maxLength": 128,
    "minLength": 16,
    "type": "string"
   },
   "appointment_ref": {
    "maxLength": 64,
    "minLength": 8,
    "type": "string"
   },
   "date": {
    "description": "For a reschedule: the new time's date exactly as list_xona_reschedule_times returned it",
    "format": "date",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "cancel",
     "reschedule"
    ],
    "type": "string"
   },
   "slot_fingerprint": {
    "description": "For a reschedule: the new time's slot_fingerprint from list_xona_reschedule_times",
    "pattern": "^[0-9a-f]{32}$",
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "appointment_ref",
   "kind"
  ],
  "type": "object"
 },
 "name": "change_xona_appointment",
 "outputSchema": {
  "properties": {
   "action_id": {
    "type": "string"
   },
   "appointment_ref": {
    "type": "string"
   },
   "appointment_start_local": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "link_expires_at": {
    "format": "date-time",
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "practice": {
    "properties": {
     "name": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     }
    },
    "required": [
     "slug",
     "name"
    ],
    "type": "object"
   },
   "requested_start_local": {
    "type": "string"
   },
   "state": {
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "practice",
   "appointment_ref",
   "state",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Ask to move or cancel an appointment"
}
