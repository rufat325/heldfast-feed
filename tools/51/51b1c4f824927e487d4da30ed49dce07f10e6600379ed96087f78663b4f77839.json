{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "eth_getBlockReceipts in a single paid call: per-transaction gas, status and log count, plus where the block's total fees went \u2014 instead of one receipt read per transaction. Costs $0.001 USDC per call. Chains: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche. Byte-identical to GET /chain/block-receipts?chain=base&block=latest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "block": {
    "description": "block number or latest|safe|finalized|earliest|pending (default \"latest\")",
    "type": "string"
   },
   "chain": {
    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
 "name": "chain_block_receipts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregatedOver": {
    "type": "integer"
   },
   "blockNumber": {
    "type": "integer"
   },
   "cap": {
    "type": "integer"
   },
   "caveat": {
    "type": [
     "string",
     "null"
    ]
   },
   "chain": {
    "type": [
     "string",
     "null"
    ]
   },
   "chainId": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "chainLabel": {
    "type": [
     "string",
     "null"
    ]
   },
   "count": {
    "type": "integer"
   },
   "failedCount": {
    "type": "integer"
   },
   "feesPaidNative": {
    "type": "string"
   },
   "feesPaidWei": {
    "type": "string"
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "rows": {
    "items": {},
    "type": "array"
   },
   "source": {
    "type": "string"
   },
   "stale": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "successCount": {
    "type": "integer"
   },
   "totalGasUsed": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "ts": {
    "type": "string"
   },
   "uniqueSenders": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Every receipt in one block"
}
