   },
   "modules": {
    "description": "Number of modules (default: 5)",
    "type": "number"
   },
   "style": {
    "description": "Teaching style (practical, theoretical, mixed)",
    "type": "string"
   },
   "topic": {
    "description": "Course topic or title",
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "course_generate"
}
