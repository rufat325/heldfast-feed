{
 "description": "Generate a complete course with AI. Creates modules, lessons, quizzes, and content.",
 "inputSchema": {
  "properties": {
   "audience": {
    "description": "Target audience (beginner, intermediate, advanced)",
    "type": "string"
   },
   "includeQuizzes": {
    "description": "Include quizzes (default: true)",
    "type": "boolean"
   },
   "lessonsPerModule": {
    "description": "Lessons per module (default: 3)",
