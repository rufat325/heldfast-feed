{
 "description": "Compare supplied SERP snapshots to detect rank churn, top-domain churn, feature changes, and target visibility movement.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device": {
    "default": "desktop",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "sensitivity": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "snapshots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "checked_at": {
       "minLength": 1,
       "type": "string"
      },
      "results": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "domain": {
          "maxLength": 180,
          "type": "string"
         },
         "position": {
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
         },
         "result_type": {
          "default": "organic",
          "enum": [
           "organic",
           "paid",
           "local_pack",
           "featured_snippet",
           "ai_overview",
           "people_also_ask",
           "video",
           "image",
           "news",
           "other"
          ],
          "type": "string"
         },
         "title": {
          "maxLength": 240,
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "position",
         "url"
        ],
        "type": "object"
       },
       "maxItems": 100,
       "minItems": 1,
       "type": "array"
      },
      "serp_features": {
       "default": [],
       "items": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 30,
       "type": "array"
      }
     },
     "required": [
      "checked_at",
      "results"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "minItems": 2,
    "type": "array"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   },
   "target_domains": {
    "default": [],
    "items": {
     "maxLength": 180,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   }
  },
  "required": [
   "keyword",
   "snapshots"
  ],
  "type": "object"
 },
 "name": "agentseo_serp_volatility",
 "title": "AgentSEO SERP Volatility Monitor"
}
