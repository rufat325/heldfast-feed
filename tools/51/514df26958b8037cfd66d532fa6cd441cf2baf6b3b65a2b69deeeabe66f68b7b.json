{
 "description": "Set or update the steps in a test scenario. Each step references an API endpoint via bindId (apiDetailId). Steps are fully replaced \u2014 pass the complete steps array. Supports 'http' steps (regular API calls) and 'if' conditional blocks (which have children instead of httpApiCase).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "scenarioId": {
    "description": "The test scenario ID",
    "type": "number"
   },
   "steps": {
    "description": "Complete array of steps to set on the scenario",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bindId": {
       "description": "API endpoint ID (apiDetailId)",
       "type": "number"
      },
      "bindType": {
       "default": "API",
       "type": "string"
      },
      "children": {
       "description": "Child steps for 'if' conditional blocks \u2014 pass child step objects as-is",
       "items": {
        "additionalProperties": {},
        "type": "object"
       },
       "type": "array"
      },
      "disable": {
       "default": false,
       "type": "boolean"
      },
      "httpApiCase": {
       "additionalProperties": false,
       "description": "Full HTTP request configuration for this step",
       "properties": {
        "apiDetailId": {
         "description": "API endpoint ID",
         "type": "number"
        },
        "auth": {
         "additionalProperties": {},
         "default": {},
         "description": "Auth configuration (e.g. bearer token)",
         "type": "object"
        },
        "method": {
         "description": "HTTP method (get, post, put, delete)",
         "type": "string"
        },
        "moduleId": {
         "description": "Module/folder ID of the API",
         "type": "number"
        },
        "name": {
         "default": "",
         "type": "string"
        },
        "parameters": {
         "additionalProperties": false,
         "description": "Request parameters (query, header, cookie, path)",
         "properties": {
          "cookie": {
           "default": [],
           "items": {
            "additionalProperties": {},
            "type": "object"
           },
           "type": "array"
          },
          "header": {
           "default": [],
           "items": {
            "additionalProperties": {},
            "type": "object"
           },
           "type": "array"
          },
          "path": {
           "default": [],
           "items": {
            "additionalProperties": {},
            "type": "object"
           },
           "type": "array"
          },
          "query": {
           "default": [],
           "items": {
            "additionalProperties": {},
            "type": "object"
           },
           "type": "array"
          }
         },
         "type": "object"
        },
        "path": {
         "description": "API path",
         "type": "string"
        },
        "postProcessors": {
         "$ref": "#/properties/steps/items/properties/httpApiCase/properties/preProcessors"
        },
        "preProcessors": {
         "default": [],
         "description": "Script processors (pre-request or post-response)",
         "items": {
          "additionalProperties": {},
          "type": "object"
         },
         "type": "array"
        },
        "projectId": {
         "description": "Project ID",
         "type": "number"
        },
        "requestBody": {
         "additionalProperties": false,
         "description": "Request body configuration",
         "properties": {
          "data": {
           "default": "",
           "type": "string"
          },
          "parameters": {
           "default": [],
           "items": {
            "additionalProperties": {},
            "type": "object"
           },
           "type": "array"
          },
          "type": {
           "default": "none",
           "type": "string"
          }
         },
         "type": "object"
        },
        "responseId": {
         "description": "Response definition ID (as string)",
         "type": "string"
        },
        "testSuiteId": {
         "description": "The scenario ID this step belongs to",
         "type": "number"
        },
        "type": {
         "default": "DEBUG_CASE",
         "type": "string"
        }
       },
       "required": [
        "method",
        "testSuiteId",
        "apiDetailId",
        "responseId",
        "projectId",
        "moduleId",
        "path"
       ],
       "type": "object"
      },
      "id": {
       "description": "Unique step ID (UUID)",
       "type": "string"
      },
      "isOpen": {
       "description": "Whether the block is expanded in the UI (used by 'if' blocks)",
       "type": "boolean"
      },
      "name": {
       "description": "Step name (e.g. API endpoint name)",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "default": {},
       "type": "object"
      },
      "syncMode": {
       "default": "MANUAL",
       "type": "string"
      },
      "type": {
       "default": "http",
       "description": "Step type (usually 'http')",
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "scenarioId",
   "steps"
  ],
  "type": "object"
 },
 "name": "update_test_scenario_steps"
}
