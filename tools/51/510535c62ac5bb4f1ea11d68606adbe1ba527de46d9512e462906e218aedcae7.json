{
 "description": "Search for restaurants on Yelp by location, cuisine, price range, and more.",
 "inputSchema": {
  "properties": {
   "location": {
    "description": "Location (city, neighborhood, or address)",
    "type": "string"
   },
   "openNow": {
    "description": "Only show places open now",
    "type": "boolean"
   },
   "priceRange": {
    "description": "Price range filter",
    "enum": [
     "$",
     "$$",
     "$$$",
     "$$$$"
    ],
    "type": "string"
   },
   "query": {
    "description": "Search query (e.g., 'sushi', 'italian')",
    "type": "string"
   },
   "sortBy": {
    "description": "Sort order",
    "enum": [
     "best_match",
     "rating",
     "review_count",
     "distance"
    ],
    "type": "string"
   }
  },
  "required": [
