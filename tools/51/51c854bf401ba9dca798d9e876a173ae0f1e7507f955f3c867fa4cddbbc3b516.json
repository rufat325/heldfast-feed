{"annotations":{"openWorldHint":false,"readOnlyHint":true,"title":"Site analytics"},"description":"Get aggregate analytics for a site (visitors, page views, bounce rate, etc.) with automatic comparison to the previous period. Returns average_duration in seconds. Optional filters segment the result by country, browser, os, device type, UTM source, or referrer.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"filter_browser":{"description":"Browser substring match (e.g. 'Chrome')","type":"string"},"filter_country":{"description":"2-letter country code (e.g. 'US')","type":"string"},"filter_device_type":{"description":"Device type: 'desktop' | 'mobile' | 'tablet'","type":"string"},"filter_os":{"description":"OS substring match (e.g. 'iOS')","type":"string"},"filter_referrer_contains":{"description":"Referrer substring (e.g. 'google')","type":"string"},"filter_utm_source":{"description":"Exact UTM source (e.g. 'twitter')","type":"string"},"period":{"default":"30d","description":"Time period: 'today', 'yesterday', '7d', '30d', '90d', or 'YYYY-MM-DD..YYYY-MM-DD'","type":"string"},"site":{"description":"Site domain (e.g. 'example.com') or UUID","type":"string"}},"required":["site"],"type":"object"},"name":"get_analytics","title":"Site analytics"}
