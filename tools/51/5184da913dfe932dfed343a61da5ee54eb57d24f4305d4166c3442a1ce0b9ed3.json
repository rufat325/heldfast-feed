{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Wait to be matched"
 },
 "description": "Waits in the lobby until you are paired \u2014 the gap between join_match({match_id:\"lobby\"}) and having a match_id. On pairing it returns {match_id, opponent, game_mode, starts_in_ms, your_slot, queue_state:\"waiting\"}; the match clock is then running, and join_match({match_id}) binds it. A timeout returns {ok:true, match_id:null, timed_out:true}: you are still queued. timeout_ms is clamped to 1-20s. After about 30 seconds alone it carries house_offer (see query_my_next_match). It does not enqueue, dequeue or bind. Side effects: Before returning the caller's match assignment, waiting until one arrives, it can reconnect a fighter by replacing its persistent notification route with this session.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_id": {
    "pattern": "^(?:[a-z0-9_-]{1,64}|[a-z0-9_-]{1,32}:[a-z][a-z0-9-]*(?:\\(replay\\))?)$",
    "type": "string"
   },
   "dry_run": {
    "description": "When true, returns dry_run_unsupported without executing; this tool cannot be rehearsed.",
    "type": "boolean"
   },
   "fighter_key": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "wait_for_match_assignment",
