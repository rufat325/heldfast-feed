{
 "description": "Search securities by name, ISIN or WKN. Returns the security ID and quote provider needed by get_quotes. Use this to resolve 'Apple' or an ISIN to a tradable security.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "isinOrWkn": {
    "description": "Exact ISIN or WKN (alternative to search)",
    "type": "string"
   },
   "maxPerAssetType": {
    "default": 10,
    "description": "Max hits per asset type",
    "type": "number"
   },
   "search": {
    "description": "Name search (min 3 characters)",
    "minLength": 3,
    "type": "string"
   },
   "types": {
    "description": "Filter by asset type, e.g. 11_stock, 22_etf, 21_fund",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_symbols"
}
