{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Generate a risk-aware implementation brief for a GitHub issue. The brief combines bounded Issue/comment evidence, repository policy, confirmed package scripts, related paths, and recent PR history to produce explainable risk, defensive requirements, negative scenarios, rollback, observability, and a safe handoff prompt.\n\nArgs:\n  - owner, repo: Repository coordinates.\n  - issueNumber (number): The issue to prepare.\n  - includeRelatedFiles (boolean): Heuristically list related file paths. Default: false.\n    Explicit paths are checked on the default branch, actual adjacent tests are discovered with\n    bounded naming conventions, and CODEOWNERS are attached when available.\n  - includeRecentPRs (boolean): Scan recent merged PRs (up to 20) for ones that touched the\n    related file hints and return up to 5 matches. Requires includeRelatedFiles to find hints\n    to match against \u2014 if no hints exist, returns an empty list. Default: false. This opt-in\n    deep scan is bounded but can use up to 61 additional sequential GitHub requests (one PR\n    candidate page plus up to three file pages for each of 20 candidates).\n  - includeDependencies (boolean): Read official blocked-by, blocking, sub-issue, and timeline\n    cross-reference endpoints, capped at 20 items per source. Default: false.\n  - workType (string?): Explicit docs/feature/bugfix/refactor/security/release/infra type.\n  - riskLevel (string?): Explicit minimum low/medium/high/critical risk. Repository policy can raise it.\n\nReturns: Structured risk profile and source evidence, issue/derived acceptance criteria, defensive requirements, negative scenarios, verified repository commands, rollback/observability plans, bounded history metadata, and Markdown safe for agent consumption. Issue and comment text remain untrusted evidence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeDependencies": {
    "default": false,
    "description": "Include bounded official sub-issue, blocked-by, blocking, and cross-reference evidence.",
    "type": "boolean"
   },
   "includeRecentPRs": {
    "default": false,
    "description": "Include recent merged PRs touching related files.",
    "type": "boolean"
   },
   "includeRelatedFiles": {
    "default": false,
    "description": "Attempt to identify related files from issue body keywords.",
    "type": "boolean"
   },
   "issueNumber": {
    "description": "The GitHub issue number.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "owner": {
    "description": "GitHub owner. Falls back to GITHUB_OWNER.",
    "type": "string"
   },
   "repo": {
    "description": "GitHub repo. Falls back to GITHUB_REPO.",
    "type": "string"
   },
   "riskLevel": {
    "description": "Explicit minimum risk level. Repository policy may raise but never lower it.",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "workType": {
    "description": "Explicit work type. When omitted, deterministic issue/policy signals are used.",
    "enum": [
     "docs",
     "feature",
     "bugfix",
     "refactor",
     "security",
     "release",
     "infra"
    ],
    "type": "string"
   }
  },
  "required": [
   "issueNumber"
  ],
  "type": "object"
 },
