{
 "annotations": {
  "readOnlyHint": true,
  "title": "List booking occurrences"
 },
 "description": "List every individual booking occurrence between two times \u2014 one-off bookings plus each expanded instance of recurring series. The right tool for calendars, room availability and utilisation. Without pagination the window may be at most 1 year. OfficeRnD: GET /bookings/occurrences.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "company": {
    "description": "Only items for this company _id.",
    "type": "string"
   },
   "cursor_next": {
    "description": "The cursorNext from the previous page. Omit for the first page.",
    "type": "string"
   },
   "cursor_prev": {
    "description": "The cursorPrev from a page, to go one page back.",
    "type": "string"
   },
   "from": {
    "description": "Window start (ISO 8601 date-time), e.g. 2026-10-01T00:00:00.000Z.",
    "minLength": 1,
    "type": "string"
   },
   "is_cancelled": {
    "description": "Only (non-)cancelled bookings.",
    "type": "boolean"
   },
   "is_tentative": {
    "description": "Only tentative (unconfirmed) or confirmed bookings.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size, 1-50 (OfficeRnD's max; default 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Only items for this location _id.",
    "type": "string"
   },
   "member": {
    "description": "Only items for this member _id.",
    "type": "string"
   },
   "resource": {
    "description": "One or more resource _ids.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "to": {
    "description": "Window end (ISO 8601 date-time), e.g. 2026-10-08T00:00:00.000Z.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "officernd_list_booking_occurrences",
 "title": "List booking occurrences"
}
