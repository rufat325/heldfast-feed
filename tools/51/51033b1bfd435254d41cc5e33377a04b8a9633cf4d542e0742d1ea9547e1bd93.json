{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List durable workflows"
 },
 "description": "Use this when someone asks which durable workflows a Croncool project runs, or how many runs are running, pending, completed, failed or cancelled. Returns each workflow's name, run counts by status and last run time for one project, 50 by default and 100 at most. Not for individual runs.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many workflows to return, from 1 to 100; defaults to 50",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Project id",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "list_workflows",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "description": "True when the project has more workflows than returned",
    "type": "boolean"
   },
   "workflows": {
    "description": "Run counts per workflow. Workflow inputs, outputs, error messages, callback configuration and secrets are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "cancelled": {
       "minimum": 0,
       "type": "integer"
      },
      "completed": {
       "minimum": 0,
       "type": "integer"
      },
      "failed": {
       "minimum": 0,
       "type": "integer"
      },
      "lastRunAt": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pending": {
       "minimum": 0,
       "type": "integer"
      },
      "running": {
       "minimum": 0,
       "type": "integer"
      },
      "total": {
       "minimum": 0,
       "type": "integer"
      },
      "workflowName": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "workflowName",
      "total",
      "running",
      "pending",
      "completed",
      "failed",
      "cancelled",
      "lastRunAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "workflows",
   "hasMore"
  ],
  "type": "object"
 },
 "title": "List durable workflows"
}
