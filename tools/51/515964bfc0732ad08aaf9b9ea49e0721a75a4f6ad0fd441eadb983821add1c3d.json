 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "How a school admits students"
 },
 "description": "Use this when a family asks how a specific school admits students or how hard it is to get in. Returns the school's admission method in full (what it asks of a family, and when), its programs with seats and who may apply, and \u2014 where NYC MySchools publishes them \u2014 seats vs. applicants per program with a competitiveness band that is Motley's own, not a DOE rating. Most middle schools, and all charter and private schools, have no applicant counts. The counts describe the whole applicant pool: never turn them into a family's odds, chance or percentage, even when asked for one. Needs a DBN; resolve a name with find-school first.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dbn": {
    "description": "School DBN (e.g. 02M475 for Stuyvesant, 13K430 for Brooklyn Tech). Resolve a school's name with find-school first; never guess one.",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "dbn"
  ],
  "type": "object"
 },
