{
 "description": "[alias of cuba_decreto] Record and query architecture/design decisions.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Decision action",
    "enum": [
     "record",
     "query",
     "list"
    ],
    "type": "string"
   },
   "allow_secret": {
    "description": "Refused when the text looks like a live credential (token, password, URL with embedded creds). Set true only for a false match \u2014 the text is then stored verbatim, in clear, and reachable by search, export and every client.",
    "type": "boolean"
   },
   "alternatives": {
    "description": "Options considered",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "chosen": {
    "description": "Option chosen",
    "type": "string"
   },
   "context": {
    "description": "Why this decision was needed",
    "type": "string"
   },
   "query": {
    "description": "Search text (for query action)",
    "type": "string"
   },
   "rationale": {
    "description": "Why this option was chosen",
    "type": "string"
   },
   "title": {
    "description": "Decision title (for record)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "memory_decreto"
}
