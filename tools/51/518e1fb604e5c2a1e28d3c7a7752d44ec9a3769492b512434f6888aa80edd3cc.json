{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Create a real iCalendar file from a brief with Start: YYYY-MM-DD HH:MM IANA/Zone, Duration: N minutes, Title: text, optionally preceded by a Markdown heading. Resolves timezone to UTC; refuses ambiguous/nonexistent DST times. createdAt must be UTC ISO seconds. Does not add any calendar event. Official documentation: https://creora.darwin.so/providers/files/docs","inputSchema":{"additionalProperties":false,"properties":{"createdAt":{"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$","type":"string"},"eventBrief":{"maxLength":131072,"minLength":1,"type":"string"}},"required":["eventBrief","createdAt"],"type":"object"},"name":"event_brief_to_ics","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{"additionalProperties":false,"properties":{"base64":{"contentEncoding":"base64","type":"string"},"mimeType":{"type":"string"},"name":{"type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"sizeBytes":{"maximum":262144,"minimum":1,"type":"integer"}},"required":["name","mimeType","sizeBytes","sha256","base64"],"type":"object"},"maxItems":16,"minItems":1,"type":"array"},"externalWrites":{"const":false},"sheetNames":{"items":{"type":"string"},"type":"array"},"sourceSha256":{"items":{"pattern":"^[a-f0-9]{64}$","type":"string"},"type":"array"}},"required":["artifacts","sourceSha256","sheetNames","externalWrites"],"type":"object"}}
