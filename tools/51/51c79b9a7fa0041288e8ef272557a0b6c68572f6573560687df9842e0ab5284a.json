{
 "_meta": {
  "openai/toolInvocation/invoked": "Found search volume",
  "openai/toolInvocation/invoking": "Looking up search volume\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "keywords:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get Google monthly search volume, CPC, competition and similar keywords (with their volumes) for one keyword in one country. Use for keyword research, sizing demand, comparing topics, or picking SEO/content targets.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "default": "us",
    "description": "Two-letter ISO 3166-1 country code for the market. Default \"us\".",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "keyword": {
    "description": "The search query, e.g. \"headless cms\"",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "lookup_keyword",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "competition": {
    "description": "Paid-search competition from 0 (low) to 1 (high)",
    "type": "number"
   },
   "country": {
    "type": "string"
   },
   "cpc": {
    "description": "Average cost per click in USD",
    "type": "number"
   },
   "found": {
    "description": "False when there is no data for this keyword",
    "type": "boolean"
   },
   "keyword": {
    "type": "string"
   },
   "similar": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "cpc": {
       "type": "number"
      },
      "keyword": {
       "type": "string"
      },
      "overlap": {
       "description": "How many top-ranking pages the two keywords share",
       "type": "number"
      },
      "volume": {
       "type": "number"
      }
     },
     "required": [
      "keyword",
      "volume",
      "cpc",
      "overlap"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "updated_at": {
    "description": "When this data was last refreshed (ISO 8601)",
    "type": [
     "string",
     "null"
    ]
   },
   "volume": {
    "description": "Average monthly Google searches",
    "type": "number"
   }
  },
  "required": [
   "keyword",
   "country",
   "found",
   "volume",
   "cpc",
   "competition",
   "updated_at",
   "similar"
  ],
  "type": "object"
 },
 "title": "Look up keyword search volume"
}
