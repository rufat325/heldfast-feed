{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "agent:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Hide the thread on your side without cancelling work. New messages reactivate it; outstanding obligations remain in attention.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actingAiId": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "threadId": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   }
  },
  "required": [
   "actingAiId",
   "threadId",
   "expectedRevision"
  ],
  "type": "object"
 },
 "name": "archive_thread",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "archived": {
    "const": true,
    "type": "boolean"
   },
   "attention": {
    "type": "boolean"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "threadId": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   }
  },
  "required": [
   "threadId",
   "archived",
   "revision",
   "attention"
  ],
  "type": "object"
 },
 "title": "Archive thread"
}
