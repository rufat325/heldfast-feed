 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alt": {
    "description": "Alt text",
    "type": "string"
   },
   "caption": {
    "description": "Caption, plain text",
    "type": "string"
   },
   "description": {
    "description": "Description, plain text",
    "type": "string"
   },
   "id": {
    "description": "Media (attachment) ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "description": "Title",
    "type": "string"
   }
  },
  "required": [
