{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run Text2Image matching using a specific model in a collection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addNotMatchedTextInLastLine": {
    "default": true,
    "description": "Add unmatched text in last line",
    "type": "boolean"
   },
   "allowDoubleMatching": {
    "default": false,
    "description": "Allow double matching",
    "type": "boolean"
   },
   "blockThresh": {
    "default": 0,
    "description": "Block threshold",
    "type": "number"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "credits": {
    "default": "AUTO",
    "description": "Credits parameter",
    "type": "string"
   },
   "doNotDeleteWorkDir": {
    "default": true,
    "description": "Do not delete work directory",
    "type": "boolean"
   },
   "docId": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "keepUnmatchedLines": {
    "default": false,
    "description": "Keep unmatched lines",
    "type": "boolean"
   },
   "lineThresh": {
    "default": 0.45,
    "description": "Line threshold",
    "type": "number"
   },
   "modelId": {
    "description": "Model/HTR ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "pages": {
    "description": "Page range (e.g. \"1-5\")",
    "type": "string"
   },
   "preserveLineOrder": {
    "default": false,
    "description": "Preserve line order",
    "type": "boolean"
   },
   "reductionMethod": {
    "default": 0,
    "description": "Reduction method",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "useCurrentTranskript": {
    "default": false,
    "description": "Use current transcript",
    "type": "boolean"
   },
   "useSourceLineFeeds": {
    "default": true,
    "description": "Use source line feeds",
    "type": "boolean"
   }
  },
  "required": [
   "collId",
   "modelId",
   "docId"
  ],
  "type": "object"
 },
 "name": "transkribus_recog_text2image_matching",
 "title": "Run Text2Image Matching"
}
