{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Which queues a RabbitMQ exchange delivers a message to, and why each binding matches or not: direct, topic (* and # words), fanout and headers (x-match all/any/all-with-x/any-with-x). Ported from RabbitMQ 4.0.5 and checked against its own tests. Unroutable means the message is dropped (or returned with mandatory). One difference: in headers, 1 and 1.0 are different values in RabbitMQ and equal here.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bindings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "arguments": {
       "additionalProperties": {
        "anyOf": [
         {
          "maxLength": 1000,
          "type": "string"
         },
         {
          "type": "number"
         },
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ]
       },
       "description": "headers: the binding arguments, x-match included",
       "type": "object"
      },
      "bindingKey": {
       "description": "direct/topic; ignored by fanout and headers",
       "maxLength": 1000,
       "type": "string"
      },
      "queue": {
       "maxLength": 255,
       "type": "string"
      }
     },
     "required": [
      "queue"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "type": "array"
   },
   "headers": {
    "additionalProperties": {
     "$ref": "#/properties/bindings/items/properties/arguments/additionalProperties"
    },
    "description": "headers exchange: the message headers",
    "type": "object"
   },
   "routingKey": {
    "maxLength": 1000,
    "type": "string"
   },
   "type": {
    "enum": [
     "direct",
     "topic",
     "fanout",
     "headers"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "bindings"
  ],
  "type": "object"
 },
 "name": "rabbit_route"
}
