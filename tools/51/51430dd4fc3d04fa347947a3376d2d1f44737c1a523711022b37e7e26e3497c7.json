{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Execute a compiled DWIN template through the private daily local cache and official arXiv API fallback. Results remain untrusted candidate evidence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exclude_phrases": {
    "default": [],
    "items": {
     "maxLength": 100,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "include_phrases": {
    "default": [],
    "items": {
     "maxLength": 100,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "max_results": {
    "default": 20,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "phrase_field": {
    "default": "all",
    "enum": [
     "all",
     "ti",
     "abs"
    ],
    "type": "string"
   },
   "since": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "sort_by": {
    "default": "submittedDate",
    "enum": [
     "relevance",
     "lastUpdatedDate",
     "submittedDate"
    ],
    "type": "string"
   },
   "sort_order": {
    "default": "descending",
    "enum": [
     "ascending",
     "descending"
    ],
    "type": "string"
   },
   "start": {
    "default": 0,
    "maximum": 30000,
    "minimum": 0,
    "type": "integer"
   },
   "template_id": {
    "maxLength": 64,
    "minLength": 2,
    "type": "string"
   },
   "until": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "template_id"
  ],
  "type": "object"
 },
 "name": "radar_search_template",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "search": {}
  },
  "required": [
   "search"
  ],
  "type": "object"
 },
 "title": "Search arXiv with an audited template"
}
