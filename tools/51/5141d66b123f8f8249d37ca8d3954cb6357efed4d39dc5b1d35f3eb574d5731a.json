  "properties": {
   "data": {
    "additionalProperties": {},
    "description": "Structured data payload",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "message": {
    "description": "Message body",
    "type": "string"
   },
   "priority": {
    "description": "Priority: low, normal, high, critical",
    "type": "string"
   },
   "subject": {
