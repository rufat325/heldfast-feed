{
 "description": "Search verified creator content on Nibgate. Returns content metadata (title, type, price, domain, reputation, unlock path). Use to discover what paid/free content exists.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search term across title, description, tags, site name, and domain.",
    "type": "string"
   },
   "skip": {
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "sort": {
    "description": "Sort order. Defaults to trending.",
    "enum": [
     "trending",
     "best-sellers",
     "hot-new"
    ],
    "type": "string"
   },
   "type": {
    "description": "Content type filter.",
    "enum": [
     "article",
     "music",
     "video",
     "image",
     "document",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "explore_content"
}
