{
 "description": "Get an Outlook message by ID with flexible field selection",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contentType": {
    "default": "text",
    "description": "Format for body content: text extracts plain text, html preserves HTML structure",
    "enum": [
     "text",
     "html"
    ],
    "type": "string"
   },
   "excludeThreadHistory": {
    "default": false,
    "description": "When true, removes quoted thread history from body content",
    "type": "boolean"
   },
   "fields": {
    "description": "Comma-separated fields to return. Omit for all fields. Available: id, threadId, subject, from, fromName, to, cc, bcc, date, snippet, body, isRead, isImportant, hasAttachments, attachmentCount, labelIds, folderName",
    "type": "string"
   },
   "id": {
    "description": "Outlook message ID to retrieve",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "message-get",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "item": {
        "additionalProperties": false,
        "properties": {
         "attachmentCount": {
          "description": "Number of attachments",
          "type": "number"
         },
         "attachments": {
          "description": "Detailed attachment information",
          "items": {
           "additionalProperties": false,
           "properties": {
            "filename": {
             "type": "string"
            },
            "id": {
             "type": "string"
            },
            "mimeType": {
             "type": "string"
            },
            "size": {
             "type": "number"
            }
           },
           "required": [
            "id",
            "filename",
            "mimeType"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "bcc": {
          "type": "string"
         },
         "body": {
          "type": "string"
         },
         "bodyContentType": {
          "enum": [
           "text",
           "html"
          ],
          "type": "string"
         },
         "cc": {
          "type": "string"
         },
         "date": {
          "description": "Date in RFC 2822 format",
          "type": "string"
         },
         "folderName": {
          "description": "Name of the folder/mailbox containing this message",
          "type": "string"
         },
         "from": {
          "type": "string"
         },
         "fromName": {
          "type": "string"
         },
         "hasAttachments": {
          "description": "Whether the message has file attachments",
          "type": "boolean"
         },
         "id": {
          "type": "string"
         },
         "isImportant": {
          "description": "Whether the message is marked as important/priority",
          "type": "boolean"
         },
         "isRead": {
          "description": "Whether the message has been read",
          "type": "boolean"
         },
         "labelIds": {
          "description": "Gmail label IDs or Outlook category IDs",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "receivedDateTime": {
          "description": "ISO datetime when message was received",
          "type": "string"
         },
         "snippet": {
          "description": "Short preview of the message body",
          "type": "string"
         },
         "subject": {
          "type": "string"
         },
         "threadId": {
          "description": "Thread/conversation ID for grouping related messages",
          "type": "string"
         },
         "to": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "item"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
