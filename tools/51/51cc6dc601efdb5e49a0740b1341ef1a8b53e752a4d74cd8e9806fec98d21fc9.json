{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks whether a GitHub repository follows open-source community best practices.\n- Evaluates 12 checks: README, LICENSE, SECURITY.md, CONTRIBUTING.md, CODE_OF_CONDUCT, issue/PR templates, branch protection, Dependabot, CI/CD, description, and topics.\n- Returns a weighted 0-100 score with A-F grade, per-check pass/fail/unknown status, and actionable suggestions for missing items.\n- Side effects: None. Read-only operation.\n- Rate limits: ~6 GitHub API calls per invocation.\n- Branch protection check requires admin access \u2014 returns \"unknown\" (not penalized) if token lacks permission.\n- Use this tool to audit repo quality and discoverability. For a computed health grade based on CI/security/activity, use 'get_health_score' instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "owner": {
    "description": "GitHub repository owner (e.g., 'facebook')",
    "type": "string"
   },
   "repo": {
    "description": "GitHub repository name (e.g., 'react')",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "check_best_practices",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkedAt": {
    "type": "string"
   },
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "status": {
       "enum": [
        "pass",
        "fail",
        "unknown"
       ],
       "type": "string"
      },
      "weight": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "status",
      "weight",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "failed": {
    "type": "number"
   },
   "grade": {
    "type": "string"
   },
   "passed": {
    "type": "number"
   },
   "repo": {
    "type": "string"
   },
   "score": {
    "type": "number"
   },
   "suggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "totalChecks": {
    "type": "number"
   },
   "unknown": {
    "type": "number"
   }
  },
  "required": [
   "repo",
   "score",
   "grade",
   "totalChecks",
   "passed",
   "failed",
   "unknown",
   "checks",
   "suggestions",
   "checkedAt"
  ],
  "type": "object"
 }
}
