  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate deadline success, mean duration and empirical p95 for up to 32 integer-minute tasks under independent bounded uniform duration variations. Seeded CPU sampling; not a real-world forecast guarantee.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "budget": {
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "durations": {
    "items": {
     "maximum": 1440,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "samples": {
    "maximum": 100000,
    "minimum": 100,
    "type": "integer"
   },
   "seed": {
    "maximum": 4294967295,
    "minimum": 0,
    "type": "integer"
   },
   "uncertainty": {
    "maximum": 0.5,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "durations",
   "budget",
   "samples",
   "seed",
   "uncertainty"
  ],
  "type": "object"
 },
 "name": "simulate_plan"
}
