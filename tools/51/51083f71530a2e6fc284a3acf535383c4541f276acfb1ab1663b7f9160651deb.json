{
 "description": "Write a file atomically inside the configured scope (writes to a temp file then renames).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "type": "string"
   },
   "createDirs": {
    "default": false,
    "type": "boolean"
   },
   "encoding": {
    "default": "utf-8",
    "enum": [
     "utf8",
     "utf-8",
     "ascii",
     "base64",
     "hex"
    ],
    "type": "string"
   },
   "path": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path",
   "content"
  ],
  "type": "object"
 },
 "name": "write_file",
 "title": "Write file"
}
