{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get daily contract usage list. Returns daily usage breakdown per contract for the specified date range (max 3 months).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractNo": {
    "description": "Contract number to filter",
    "type": "string"
   },
   "contractTypeCode": {
    "description": "Contract type code",
    "type": "string"
   },
   "isOrganization": {
    "description": "Query as Organization master (integrated view)",
    "type": "boolean"
   },
   "isPartner": {
    "description": "Query as Partner representative",
    "type": "boolean"
   },
   "memberNoList": {
    "description": "Member number list (master/partner only)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageNo": {
    "description": "Page number",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size (max 1000, default 1000)",
    "type": "number"
   },
   "productItemKindCode": {
    "description": "Product item kind code",
    "type": "string"
   },
   "productItemKindDetailCode": {
    "description": "Product item kind detail code (NCP billing classification change, 2026-06-25). Use 'VM' to query VM servers only (otherwise BM may be mixed in), 'BM' for Bare Metal only. Block Storage: BSTAD / BSTBS / BSTBS_BSTAD / CB1 / CB2 / FB1 / FB2.",
    "enum": [
     "VM",
     "BM",
     "BSTAD",
     "BSTBS",
     "BSTBS_BSTAD",
     "CB1",
     "CB2",
     "FB1",
     "FB2"
    ],
    "type": "string"
   },
   "regionCode": {
    "description": "Region code (KR, JPN, SGN, USWN, DEN)",
    "type": "string"
   },
   "useEndDay": {
    "description": "End day in yyyyMMdd format (e.g. 20240131, max 3 months range)",
    "type": "string"
   },
   "useStartDay": {
    "description": "Start day in yyyyMMdd format (e.g. 20240101)",
    "type": "string"
   }
  },
  "required": [
   "useStartDay",
   "useEndDay"
  ],
  "type": "object"
 },
 "name": "ncloud_get_contract_usage_list_by_daily"
}
