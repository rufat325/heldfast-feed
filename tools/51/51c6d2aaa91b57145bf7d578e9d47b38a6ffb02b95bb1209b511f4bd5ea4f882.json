{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Figma design-token scaffold with token rows, component-review rows, style preview metadata, adapter source, and access-token safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "webhook_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9063/figma",
    "type": "string"
   },
   "component_count": {
    "default": 8,
    "maximum": 256,
    "minimum": 0,
    "type": "integer"
   },
   "file_key": {
    "default": "figma_file_key",
    "type": "string"
   },
   "name": {
    "default": "figma_design_tokens",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Figma token scaffold.",
    "type": "string"
   },
   "team_label": {
    "default": "design_team",
    "type": "string"
   },
   "token_count": {
    "default": 32,
    "maximum": 512,
    "minimum": 1,
    "type": "integer"
   },
   "token_format": {
    "default": "style_dictionary",
    "enum": [
     "style_dictionary",
     "css_variables",
     "json_tokens"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_figma_design_tokens",
 "title": "Connect Figma design tokens"
}
