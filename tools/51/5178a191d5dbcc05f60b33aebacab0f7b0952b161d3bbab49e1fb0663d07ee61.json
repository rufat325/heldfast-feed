{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Houdini Engine/HDA/cache handoff scaffold with HDA manifests, parameter maps, cook-status ingest, and geometry cache notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "asset_format": {
    "default": "bgeo",
    "enum": [
     "bgeo",
     "usd",
     "alembic",
     "obj"
    ],
    "type": "string"
   },
   "cache_folder": {
    "default": "./houdini/cache",
    "type": "string"
   },
   "handoff_mode": {
    "default": "file_watch",
    "enum": [
     "file_watch",
     "hda_parameters",
     "websocket_json",
     "udp_cook_status"
    ],
    "type": "string"
   },
   "hda_file": {
    "default": "./houdini/show_asset.hda",
    "type": "string"
   },
   "name": {
    "default": "houdini_engine_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parameter_count": {
    "default": 12,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Houdini bridge.",
    "type": "string"
   },
   "receive_port": {
    "default": 9876,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "server_url": {
    "default": "ws://127.0.0.1:9876",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_houdini_engine_bridge",
 "title": "Connect Houdini Engine bridge"
}
