{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Ask the dealership to reach out \u2014 confirm"
 },
 "description": "Submit the shopper's bound contact request to the named dealership.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "binding": {
    "maxLength": 16384,
    "minLength": 1,
    "type": "string"
   },
   "comments": {
    "maxLength": 2000,
    "type": "string"
   },
   "customer": {
    "additionalProperties": false,
    "anyOf": [
     {
      "required": [
       "email"
      ]
     },
     {
      "required": [
       "phone"
      ]
     }
    ],
    "properties": {
     "email": {
      "maxLength": 254,
      "minLength": 6,
      "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 30,
      "minLength": 7,
      "pattern": "^(?=(?:[^0-9]*[0-9]){7,15}[^0-9]*$)\\+?[0-9()\\-. ]+$",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "disclosure_text": {
    "maxLength": 5000,
    "minLength": 10,
    "type": "string"
   },
   "rooftop_slug": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "rooftop_slug",
   "binding",
   "disclosure_text",
   "customer"
  ],
  "type": "object"
 },
 "name": "lead_submit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "lead_id": {
      "maxLength": 36,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
      "type": "string"
     },
     "status": {
      "const": "accepted"
     }
    },
    "required": [
     "lead_id",
     "status"
    ],
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "description": "Unknown and foreign thread ids are deliberately indistinguishable: both return invalid_params with message \"unknown thread_id\" (anti-enumeration).",
    "properties": {
     "auth_help_url": {
      "description": "Present only when no credential was supplied for a capability that requires one. Points to human documentation for obtaining a key. Absent for invalid, pending, or disabled credentials, which are deliberately indistinguishable.",
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     "code": {
      "enum": [
       "rooftop_not_found",
       "rooftop_inactive",
       "unit_not_found",
       "invalid_params",
       "rate_limited",
       "upstream_unavailable",
       "capability_unavailable",
       "identity_required",
       "quota_exceeded",
       "unit_held",
       "quote_expired",
       "rooftop_paused",
       "handoff_duplicate",
       "idempotency_conflict",
       "price_unavailable",
       "snapshot_expired",
       "artifact_too_large",
       "cursor_invalid",
       "cursor_expired",
       "ambiguous_identity",
       "unsupported_in_country"
      ]
     },
     "message": {
      "maxLength": 500,
      "type": "string"
     },
     "retry_after_seconds": {
      "minimum": 0,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   },
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "by_rooftop": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "last_ingest_at": {
         "format": "date-time",
         "maxLength": 40,
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "enum": [
          "fresh",
          "stale",
          "no_data"
         ]
        }
       },
       "required": [
        "status",
        "last_ingest_at"
       ],
       "type": "object"
      },
      "maxProperties": 500,
      "type": "object"
     }
    },
    "required": [
     "by_rooftop"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Ask the dealership to reach out \u2014 confirm"
}
