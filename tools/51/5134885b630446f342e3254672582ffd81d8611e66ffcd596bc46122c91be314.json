{
 "description": "Validate market parameters against v7.2 timing rules.",
 "inputSchema": {
  "properties": {
   "closing_time": {
    "description": "ISO 8601 closing time",
    "type": "string"
   },
   "event_time": {
    "description": "ISO 8601 event time (for event markets)",
    "type": "string"
   },
   "market_type": {
    "description": "Market type",
    "enum": [
     "event",
     "measurement"
    ],
    "type": "string"
   },
   "measurement_end": {
    "description": "ISO 8601 measurement end (optional)",
    "type": "string"
   },
   "measurement_start": {
    "description": "ISO 8601 measurement start (for measurement markets)",
    "type": "string"
   },
   "question": {
    "description": "Market question (max 200 chars)",
    "type": "string"
   }
  },
  "required": [
   "question",
   "closing_time",
   "market_type"
  ],
  "type": "object"
 },
 "name": "validate_market_params"
}
