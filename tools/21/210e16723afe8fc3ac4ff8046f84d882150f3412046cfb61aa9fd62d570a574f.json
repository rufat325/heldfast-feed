{
 "description": "Interview a simulated product stakeholder from a completed local or model-swarm run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "Agent id from the scenario.",
    "type": "string"
   },
   "prompt": {
    "description": "Question to ask the simulated agent.",
    "type": "string"
   },
   "runId": {
    "description": "Simulation run id.",
    "type": "string"
   }
  },
  "required": [
   "runId",
   "agentId",
   "prompt"
  ],
  "type": "object"
 },
 "name": "simulation_interview"
}
