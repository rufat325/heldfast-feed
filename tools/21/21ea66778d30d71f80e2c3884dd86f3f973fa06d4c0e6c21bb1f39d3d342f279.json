{
 "description": "Update annotation queue \u2014 Updates mutable queue metadata (`name`, `description`, `status`, `instructions`, `reviewers_required`, `score_config_names`). Fields not provided are left unchanged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "instructions": {
    "anyOf": [
     {
      "maxLength": 5000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "queueId": {
    "type": "string"
   },
   "reviewers_required": {
    "minimum": 1,
    "type": "integer"
   },
   "score_config_names": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "active",
     "completed",
     "archived"
    ],
    "type": "string"
   }
  },
  "required": [
   "queueId"
  ],
  "type": "object"
 },
 "name": "update_annotation_queue"
}
