{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Ticket"
 },
 "description": "Create a support ticket for a member issue.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "Member/account ID this ticket is about",
    "type": "string"
   },
   "category": {
    "description": "Ticket category",
    "enum": [
     "bug",
     "feature_request",
     "account",
     "billing",
     "general",
     "other"
    ],
    "type": "string"
   },
   "contactEmail": {
    "description": "Contact email if no account ID",
    "type": "string"
   },
   "contactName": {
    "description": "Contact name if no account ID",
    "type": "string"
   },
   "contactPhone": {
    "description": "Contact phone if no account ID",
    "type": "string"
   },
   "description": {
    "description": "Detailed description of the issue",
    "type": "string"
   },
   "priority": {
    "description": "Ticket priority",
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "source": {
    "description": "Where the ticket originated",
    "enum": [
     "portal",
     "email",
     "phone",
     "walk_in",
     "api",
     "mobile_app"
    ],
    "type": "string"
   },
   "subject": {
    "description": "Ticket subject/title",
    "type": "string"
   }
  },
  "required": [
   "subject"
  ],
  "type": "object"
 },
 "name": "create_ticket",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
