{
 "annotations": {
  "readOnlyHint": true,
  "title": "List campaigns"
 },
 "description": "List the account's campaigns (email sends). Paginated, with optional type/status/audience filters and sort. REST: GET /campaigns.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "count": {
    "description": "Records to return (Mailchimp `count`; default 10, max 1000).",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "list_id": {
    "description": "Restrict to campaigns sent to this audience (list) id.",
    "type": "string"
   },
   "offset": {
    "description": "Number of records to skip (Mailchimp `offset`, for pagination).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sortDir": {
    "description": "Sort direction ASC/DESC (Mailchimp `sort_dir`).",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "sortField": {
    "description": "Field to sort by (Mailchimp `sort_field`, e.g. date_created / create_time).",
    "type": "string"
   },
   "status": {
    "description": "Filter by campaign status (Mailchimp `status`).",
    "enum": [
     "save",
     "paused",
     "schedule",
     "sending",
     "sent"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by campaign type (Mailchimp `type`).",
    "enum": [
     "regular",
     "plaintext",
     "absplit",
     "rss",
     "variate"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mailchimp_list_campaigns",
 "title": "List campaigns"
}
