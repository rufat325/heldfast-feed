     "boolean",
     "null"
    ]
   },
   "port": {
    "type": [
     "number",
     "null"
    ]
   },
   "portsRequested": {
    "type": [
     "number",
     "null"
    ]
   },
   "results": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
