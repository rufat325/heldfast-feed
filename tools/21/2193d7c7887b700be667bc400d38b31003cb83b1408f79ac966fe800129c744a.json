{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a payment in YooKassa. Returns a confirmation URL. Supports one-step and two-step payments, receipts, and metadata. MOVES REAL MONEY (the payer is charged) \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "Payment amount in rubles (string '5000.00' for exactness, or a number)"
   },
   "capture": {
    "default": true,
    "description": "true = one-step (auto-capture), false = two-step (hold)",
    "type": "boolean"
   },
   "confirmation_type": {
    "default": "redirect",
    "description": "Confirmation type: redirect (needs return_url), embedded (widget), or qr",
    "enum": [
     "redirect",
     "embedded",
     "qr"
    ],
    "type": "string"
   },
   "currency": {
    "default": "RUB",
    "description": "Currency (ISO-4217, default RUB)",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "description": {
    "description": "Payment description (max 128 chars)",
    "maxLength": 128,
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Arbitrary metadata (key-value)",
    "type": "object"
   },
   "payment_method_type": {
    "description": "Payment method",
    "enum": [
     "bank_card",
     "sbp",
     "yoo_money",
     "sberbank",
     "tinkoff_bank",
     "mobile_balance",
     "cash",
     "installments"
    ],
    "type": "string"
   },
   "receipt_email": {
    "description": "Customer email for the receipt",
    "format": "email",
    "type": "string"
   },
   "receipt_items": {
    "description": "Items for a 54-FZ receipt (if issuing a receipt with the payment)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "anyOf": [
        {
         "$ref": "#/properties/amount/anyOf/0"
        },
        {
         "$ref": "#/properties/amount/anyOf/1"
        }
       ],
       "description": "Unit price"
      },
      "description": {
       "description": "Item/service name",
       "type": "string"
      },
      "measure": {
       "description": "Measure, tag 2108 (default 'piece'; required for FFD 1.2)",
       "type": "string"
      },
      "payment_mode": {
       "description": "Payment mode, tag 1214 (default 'full_payment')",
       "type": "string"
      },
      "payment_subject": {
       "description": "Payment subject, tag 1212 (default 'commodity')",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "vat_code": {
       "description": "VAT code: 1=no VAT, 2=0%, 3=10%, 4=20%, 5=10/110, 6=20/120",
       "maximum": 6,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "description",
      "quantity",
      "amount",
      "vat_code"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "receipt_tax_system_code": {
    "description": "Receipt tax system code, tag 1055 (only if the shop has multiple tax systems / FFD 1.2)",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "return_url": {
    "description": "URL to return the payer to after payment \u2014 REQUIRED when confirmation_type=redirect",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "description"
  ],
  "type": "object"
 },
 "name": "create_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create payment"
}
