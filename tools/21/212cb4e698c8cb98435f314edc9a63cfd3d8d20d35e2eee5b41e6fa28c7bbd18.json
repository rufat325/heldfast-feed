{
 "description": "Click at specific x,y coordinates on the TradingView window",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "button": {
    "description": "Mouse button (default left)",
    "enum": [
     "left",
     "right",
     "middle"
    ],
    "type": "string"
   },
   "double_click": {
    "description": "Double click (default false)",
    "type": "boolean"
   },
   "x": {
    "description": "X coordinate (pixels from left)",
    "type": "number"
   },
   "y": {
    "description": "Y coordinate (pixels from top)",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y"
  ],
  "type": "object"
 },
 "name": "ui_mouse_click"
}
