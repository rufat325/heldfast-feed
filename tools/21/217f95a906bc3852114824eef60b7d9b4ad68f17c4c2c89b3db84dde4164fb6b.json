{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Shows detailed package metadata from the npm registry. Works with npm, pnpm, and yarn (all query the same registry).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "field": {
    "description": "Query a single field (e.g., 'engines', 'peerDependencies', 'versions')",
    "maxLength": 255,
    "type": "string"
   },
   "package": {
    "description": "Package name to look up (e.g. 'express', 'lodash@4.17.21')",
    "maxLength": 255,
    "type": "string"
   },
   "packageManager": {
    "description": "Package manager to use. Auto-detected from lock files if not specified (pnpm-lock.yaml \u2192 pnpm, yarn.lock \u2192 yarn, otherwise npm).",
    "enum": [
     "npm",
     "pnpm",
     "yarn"
    ],
    "type": "string"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "registry": {
    "description": "Registry URL to query (maps to --registry, e.g., 'https://npm.pkg.github.com')",
    "maxLength": 65536,
    "type": "string"
   },
   "workspace": {
    "description": "Workspace for scoped queries (maps to --workspace for npm)",
    "maxLength": 255,
    "type": "string"
   }
  },
  "required": [
   "package"
  ],
  "type": "object"
 },
 "name": "info",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dependencies": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "dependencyCount": {
    "description": "Number of runtime dependencies (set in compact output)",
    "type": "number"
   },
   "description": {
    "type": "string"
   },
   "dist": {
    "additionalProperties": false,
    "properties": {
     "tarball": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "engines": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Node.js and other engine version requirements",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "homepage": {
    "type": "string"
   },
   "isDeprecated": {
    "description": "Whether the package is deprecated",
    "type": "boolean"
   },
   "keywords": {
    "description": "Package keywords for discovery",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "license": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "packageManager": {
    "description": "Package manager that was used (npm, pnpm, or yarn)",
    "enum": [
     "npm",
     "pnpm",
     "yarn"
    ],
    "type": "string"
   },
   "peerDependencies": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Peer dependencies that must be co-installed",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "repository": {
    "additionalProperties": false,
    "description": "Source code repository info",
    "properties": {
     "type": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "version": {
    "type": "string"
   },
   "versionCount": {
    "description": "Number of published versions (set in compact output)",
    "type": "number"
   },
   "versions": {
    "description": "All published versions",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "version",
   "description"
  ],
  "type": "object"
 },
 "title": "Package Info"
}
