 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "draftId": {
    "description": "The ID of the draft to retrieve",
    "type": "string"
   },
   "format": {
    "default": "full",
    "description": "Format of the message",
    "enum": [
     "minimal",
     "full",
     "raw",
     "metadata"
