{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Explain Google and Bing"
 },
 "description": "Explain what Google Search Console and Bing Webmaster Tools report, and what to do. Pick with mode: index_status = Index coverage and rich result statuses, with the fix. Needs rows[{url, coverageState, verdict, indexingState, robotsTxtState, pageFetchState}]. manual_action = A manual action, with the cleanup plan and reconsideration draft. Needs action. bing = Bing Webmaster crawl issues, and Bing against Google per query.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "The manual action as Search Console shows it.",
    "maxLength": 200,
    "type": "string"
   },
   "bing_queries": {
    "items": {
     "properties": {
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "impressions": {
       "minimum": 0,
       "type": "number"
      },
      "position": {
       "minimum": 0,
       "type": "number"
      },
      "query": {
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "query",
      "clicks"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "google_queries": {
    "items": {
     "properties": {
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "impressions": {
       "minimum": 0,
       "type": "number"
      },
      "position": {
       "minimum": 0,
       "type": "number"
      },
      "query": {
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "query",
      "clicks"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "issues": {
    "description": "Bing crawl or index issues.",
    "items": {
     "properties": {
      "issue": {
       "maxLength": 200,
       "type": "string"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "url",
      "issue"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default index_status.",
    "enum": [
     "index_status",
     "manual_action",
     "bing"
    ],
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "coverageState": {
       "description": "Coverage state or the reason from the Pages report, for example 'Crawled - currently not indexed'.",
       "maxLength": 2000,
       "type": "string"
      },
      "googleCanonical": {
       "maxLength": 2000,
       "type": "string"
      },
      "indexingState": {
       "maxLength": 2000,
       "type": "string"
      },
      "lastCrawlTime": {
       "maxLength": 2000,
       "type": "string"
      },
      "pageFetchState": {
       "maxLength": 2000,
       "type": "string"
      },
      "richResultsResult": {
       "description": "URL Inspection richResultsResult as returned (detectedItems with richResultType and item issues).",
       "type": "object"
      },
      "rich_issue": {
       "description": "The issue from the Enhancements report, for example Missing field \"price\".",
       "maxLength": 2000,
       "type": "string"
      },
      "rich_result_type": {
       "description": "From the Enhancements report export, for example Product snippets or FAQ.",
       "maxLength": 2000,
       "type": "string"
      },
      "rich_severity": {
       "description": "ERROR or WARNING.",
       "maxLength": 2000,
       "type": "string"
      },
      "robotsTxtState": {
       "maxLength": 2000,
       "type": "string"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      },
      "userCanonical": {
       "maxLength": 2000,
       "type": "string"
      },
      "verdict": {
       "description": "PASS, PARTIAL, FAIL or NEUTRAL.",
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "sample_urls": {
    "description": "Example URLs Google listed.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "site": {
    "description": "The site or Search Console property.",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "explain_google",
 "outputSchema": {
  "type": "object"
 },
 "title": "Explain Google and Bing"
}
