{"annotations":{"destructiveHint":false,"idempotentHint":false},"description":"Reply to an existing review thread. An unknown threadId fails with NOT_FOUND and posts nothing. Returns threadId and the created message (id, author { id, displayName }, content, ISO timestamp), plus trackChangesActive and writeMode. A timed-out reply is never resubmitted: it returns recoveredAfterTimeout when the thread shows exactly one new matching message from this account, else OUTCOME_UNKNOWN; do not retry it blindly.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"content":{"minLength":1,"type":"string"},"projectId":{"description":"Overleaf project ID","minLength":1,"type":"string"},"threadId":{"description":"Existing thread id from list_comments","minLength":1,"type":"string"}},"required":["projectId","threadId","content"],"type":"object"},"name":"reply_to_comment","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"message":{"additionalProperties":false,"properties":{"author":{"anyOf":[{"additionalProperties":false,"properties":{"displayName":{"type":"string"},"id":{"type":"string"}},"required":["id","displayName"],"type":"object"},{"type":"null"}]},"content":{"type":"string"},"id":{"type":"string"},"timestamp":{"type":"string"}},"required":["author","content"],"type":"object"},"recoveredAfterTimeout":{"const":true,"type":"boolean"},"threadId":{"type":"string"},"trackChangesActive":{"type":"boolean"},"writeMode":{"const":"untracked","type":"string"}},"required":["threadId","message","trackChangesActive","writeMode"],"type":"object"}}
