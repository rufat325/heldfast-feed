  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a user's first name, last name, or organization role by id. Email and workspace roles are not editable here; use update_workspace_member for workspace membership changes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "first_name": {
    "description": "New first name",
    "type": "string"
   },
   "last_name": {
    "description": "New last name",
    "type": "string"
   },
   "role": {
    "description": "New organization-level role",
    "enum": [
     "admin",
     "member"
    ],
    "type": "string"
   },
   "user_id": {
    "description": "The user ID to update",
    "type": "string"
   }
  },
  "required": [
   "user_id"
  ],
  "type": "object"
 },
 "name": "update_user",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
