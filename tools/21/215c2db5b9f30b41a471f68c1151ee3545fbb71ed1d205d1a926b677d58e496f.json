{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Gate a server against your rules"},"description":"Pass or fail for one server against the rules you name (at least one), with every rule it broke: minimum quality or trust, checks that must not fail (e.g. tools.hidden_text), quality or trust flags that must be absent, allowed connection classes, a verified owner. A blocked or deleted listing never passes. Call it before connecting.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"class":{"description":"Connection classes allowed","items":{"enum":["R0","R1","R2","L0","unknown"],"type":"string"},"maxItems":5,"type":"array"},"exclude_flags":{"items":{"enum":["multi-version-spam","duplicate-repo","no-repository","no-connection","deprecated","unreachable","blocked","deleted"],"type":"string"},"maxItems":8,"type":"array"},"exclude_quality_flags":{"description":"e.g. ['known-vulns', 'hidden-text']","items":{"enum":["known-vulns","outdated-mcp-sdk","hidden-text"],"type":"string"},"maxItems":3,"type":"array"},"min_quality":{"maximum":100,"minimum":0,"type":"integer"},"min_trust":{"maximum":100,"minimum":0,"type":"integer"},"name":{"description":"Official reverse-DNS name","minLength":1,"type":"string"},"no_fail":{"description":"Check ids that must not fail, e.g. ['tools.hidden_text', 'stability.rug_pull']","items":{"enum":["protocol.modern","protocol.stateless","protocol.transport","protocol.list_ttl","auth.prm","auth.as_metadata","auth.cimd","auth.secret_in_url","tools.descriptions","tools.description_length","tools.schemas","tools.annotations","tools.directory_hints","tools.token_cost","tools.api_dump","tools.hidden_text","stability.changes","stability.rug_pull","stability.new_links","deps.known_vulns","deps.mcp_sdk_version","deps.resolvable"],"type":"string"},"maxItems":22,"type":"array"},"owner_verified":{"description":"true: the owner must have proved the namespace","typ