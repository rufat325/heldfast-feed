{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Which mod crashed Minecraft"
 },
 "description": "Find the mod most likely behind a modded Minecraft crash (Fabric, NeoForge, Forge). Pass the whole crash report (crash-reports/*.txt) or logs/latest.log as text. Returns the crash kind, the suspect mods ranked with reasons, how sure it is, and a fix guide. The text is read and dropped, not stored.",
 "inputSchema": {
  "properties": {
   "text": {
    "description": "Crash report or latest.log, unedited.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "diagnose_crash",
 "outputSchema": {
  "properties": {
   "confidence": {
    "description": "How sure the first suspect is the cause.",
    "enum": [
     "HIGH",
     "MEDIUM",
     "LOW",
     "NONE"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "error": {
    "description": "The root exception and its message.",
    "type": "string"
   },
   "guide": {
    "description": "How to fix this kind of crash.",
    "type": "string"
   },
   "kind": {
    "enum": [
     "MIXIN_FAILED",
     "MISSING_CLASS",
     "OUT_OF_MEMORY",
     "MOD_LOADING",
     "GENERIC"
    ],
    "type": "string"
   },
   "loader": {
    "type": [
     "string",
     "null"
    ]
   },
   "mc": {
    "type": [
     "string",
     "null"
    ]
   },
   "signature": {
    "description": "Stable id of this crash shape.",
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "suspects": {
    "description": "Most likely first.",
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "lab_runs": {
       "description": "Lab runs of this mod on this MC version.",
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "score": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "kind",
   "confidence",
   "suspects",
   "guide",
   "source"
  ],
  "type": "object"
 },
 "title": "Which mod crashed Minecraft"
}
