{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true,
  "title": "Browse a business category"
 },
 "description": "Lists public directory entries in one business category, optionally narrowed to a locality/postcode/canton. Use search_swiss_directory instead for a free-text query.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "The business category slug (e.g. \"restaurant\", \"coiffeur\", \"sanitaer\"). Valid slugs are the slug values in categories, as returned by get_directory_entry, or a top-level group slug such as \"bau-handwerk\".",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "lang": {
    "description": "Response language: de, fr, it, or en. Defaults to de.",
    "enum": [
     "de",
     "fr",
     "it",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of results, 1-20.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Locality, postcode, or canton (e.g. \"Baden\", \"5400\", \"ZH\") to narrow the category to. Always put a place name here.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "browse_business_category",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
