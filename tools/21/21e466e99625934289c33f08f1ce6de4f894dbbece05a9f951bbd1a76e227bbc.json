erties":false,"properties":{"numReadonlySignedAccounts":{"maximum":32,"minimum":0,"type":"integer"},"numReadonlyUnsignedAccounts":{"maximum":255,"minimum":0,"type":"integer"},"numRequiredSignatures":{"maximum":32,"minimum":1,"type":"integer"}},"required":["numRequiredSignatures","numReadonlySignedAccounts","numReadonlyUnsignedAccounts"],"type":"object"},"instructions":{"items":{"additionalProperties":false,"properties":{"accountIndexes":{"items":{"maximum":255,"minimum":0,"type":"integer"},"maxItems":64,"type":"array"},"data":{"maxLength":8192,"pattern":"^[1-9A-HJ-NP-Za-km-z]*$","type":"string"},"programIdIndex":{"maximum":255,"minimum":0,"type":"integer"}},"required":["programIdIndex","accountIndexes","data"],"type":"object"},"maxItems":64,"minItems":1,"type":"array"},"loadedAddresses":{"additionalProperties":false,"properties":{"readonly":{"items":{"type":"string"},"maxItems":256,"type":"array"},"writable":{"items":{"type":"string"},"maxItems":256,"type":"array"}},"required":["writable","readonly"],"type":"object"},"messageVersion":{"enum":["legacy","v0"],"type":"string"},"network":{"const":"mainnet-beta","type":"string"},"recentBlockhash":{"type":"string"}},"required":["network","messageVersion","feePayer","recentBlockhash","header","accountKeys","addressTableLookups","loadedAddresses","instructions"],"type":"object"}},"required":["guard","transaction"],"type":"object"},"name":"solana_lending_guard"}
