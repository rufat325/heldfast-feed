{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Edit an existing study's slots, interview mode, languages, voice, link context, guide text, questions, or media. Use this after review_study or a failed simulation names a guide change, or when the link is disabled and you are about to share. You cannot change key_research_goal. Delete the study and call create_study for a new question. One locale turns the language picker off. Two or more turn it on. Query params on interview_link are ignored until enable_link_context is true. This does not simulate or share. Call simulate_interview again before sharing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ai_agent_intro_message": {
    "description": "Opening message the interviewer says to participants.",
    "type": "string"
   },
   "custom_link_variables": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "default_value": {
       "maxLength": 200,
       "type": "string"
      },
      "key": {
       "pattern": "^[a-z][a-z0-9_]{0,31}$",
       "type": "string"
      },
      "label": {
       "maxLength": 60,
       "type": "string"
      }
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "enable_link_context": {
    "type": "boolean"
   },
   "interview_mode": {
    "description": "How participants take the interview.",
    "enum": [
     "voice",
     "text",
     "voice_and_text"
    ],
    "type": "string"
   },
   "is_link_disabled": {
    "type": "boolean"
   },
   "key_learning_goals": {
    "description": "Learning goals that guide the interviewer.",
    "type": "string"
   },
   "languages": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "study_id": {
    "format": "uuid",
    "type": "string"
   },
   "study_media": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "Visual stimulus shown during all interview questions (web participants only)",
      "properties": {
       "description": {
        "description": "Alt text / context shown to participants",
        "maxLength": 500,
        "type": "string"
       },
       "type": {
        "description": "Media type: 'image' for direct image URLs (.png, .jpg, .gif, .webp) or 'prototype' for Figma prototype URLs",
        "enum": [
         "image",
         "prototype"
        ],
        "type": "string"
       },
       "url": {
        "description": "Public URL to the image or Figma prototype",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "type",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Visual stimulus shown during all interview questions (web participants only). Pass null to clear."
   },
   "target_interviews": {
    "description": "Total number of interview slots for this study.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "voice_gender": {
    "enum": [
     "female",
     "male"
    ],
    "type": "string"
   },
   "workflow_end_message": {
    "description": "Closing message shown when the interview ends.",
    "type": "string"
   },
   "workflow_questions": {
    "description": "Interview questions. Each item requires text.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "closedEndedType": {
       "enum": [
        "numeric",
        "categorical",
        "yes_no"
       ],
       "type": "string"
      },
      "customTransitionCondition": {
       "maxLength": 2000,
       "type": "string"
      },
      "followUpCount": {
       "maximum": 5,
       "minimum": -1,
       "type": "integer"
      },
      "followUpPrompt": {
       "maxLength": 2000,
       "type": "string"
      },
      "id": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "instructionType": {
       "enum": [
        "prompt",
        "static_text"
       ],
       "type": "string"
      },
      "isAdaptive": {
       "type": "boolean"
      },
      "isClosedEnded": {
       "type": "boolean"
      },
      "mediaDescription": {
       "maxLength": 4000,
       "type": "string"
      },
      "mediaImage": {
       "maxLength": 4000,
       "type": "string"
      },
      "mediaType": {
       "enum": [
        "none",
        "image",
        "video",
        "prototype"
       ],
       "type": "string"
      },
      "mediaUploadedFile": {
       "maxLength": 4000,
       "type": "string"
      },
      "mediaUrl": {
       "maxLength": 4000,
       "type": "string"
      },
      "order": {
       "minimum": 0,
       "type": "integer"
      },
      "text": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "study_id"
  ],
  "type": "object"
 },
 "name": "update_study",
 "title": "Update a study"
}
