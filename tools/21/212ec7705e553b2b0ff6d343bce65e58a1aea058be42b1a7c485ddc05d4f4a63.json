{
 "description": "Manage employees: list, get, search, create, update, terminate",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action",
    "enum": [
     "list",
     "get",
     "search",
     "create",
     "update",
     "terminate"
    ],
    "type": "string"
   },
   "birthday_on": {
    "description": "Birthday (YYYY-MM-DD)",
    "type": "string"
   },
   "confirm": {
    "description": "Confirm high-risk operation",
    "type": "boolean"
   },
   "email": {
    "description": "Email address",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "gender": {
    "description": "Gender",
    "enum": [
     "male",
     "female",
     "other"
    ],
    "type": "string"
   },
   "id": {
    "description": "Employee ID (for get/update/terminate)",
    "type": "number"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Items per page",
    "type": "number"
   },
   "location_id": {
    "description": "Filter by location ID (for list)",
    "type": "number"
   },
   "manager_id": {
    "description": "Manager ID",
    "type": "number"
   },
   "nationality": {
    "description": "Nationality",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "query": {
    "description": "Search query (for search)",
    "type": "string"
   },
   "team_id": {
    "description": "Filter by team ID (for list)",
    "type": "number"
   },
   "terminated_on": {
    "description": "Termination date (YYYY-MM-DD)",
    "type": "string"
   },
   "termination_reason": {
    "description": "Reason for termination",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "factorial_employees",
 "title": "FactorialHR Employees"
}
