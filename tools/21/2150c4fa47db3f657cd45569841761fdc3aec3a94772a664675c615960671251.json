{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a parked sales order"
 },
 "description": "Create a DRAFT sales order with status Parked (reserves no stock, posts nothing to accounting \u2014 a person places or completes it in Unleashed). Line totals, line tax, SubTotal, TaxTotal and Total are computed for you to satisfy Unleashed's validation (SubTotal = sum of line totals, TaxTotal = sum of line taxes, Total = SubTotal + TaxTotal). Unleashed: POST /SalesOrders.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "comments": {
    "description": "Order comments.",
    "maxLength": 2048,
    "type": "string"
   },
   "currencyCode": {
    "description": "Order currency code, e.g. NZD.",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "customerCode": {
    "description": "The customer's code.",
    "minLength": 1,
    "type": "string"
   },
   "exchangeRate": {
    "description": "Exchange rate to the base currency. Default 1.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "lines": {
    "description": "At least one order line.",
    "items": {
     "properties": {
      "productCode": {
       "description": "The product's code.",
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "description": "Order quantity.",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "unitPrice": {
       "description": "Unit price, exclusive of tax.",
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "productCode",
      "quantity",
      "unitPrice"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "orderDate": {
    "description": "Order date (YYYY-MM-DD). Default today.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "orderNumber": {
    "description": "Order number; generated by Unleashed if omitted.",
    "type": "string"
   },
   "requiredDate": {
    "description": "Required date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}(T[\\d:.]+Z?)?$",
    "type": "string"
   },
   "taxCode": {
    "description": "Tax code as configured in Unleashed, e.g. GST.",
    "type": "string"
   },
   "taxRate": {
    "description": "Tax rate as a fraction, e.g. 0.15 for 15%.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "warehouseCode": {
    "description": "The warehouse code to sell from.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "customerCode",
   "warehouseCode",
   "currencyCode",
   "taxRate",
   "lines"
  ],
  "type": "object"
 },
 "name": "unleashed_create_sales_order",
 "title": "Create a parked sales order"
}
