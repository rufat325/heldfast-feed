{
 "description": "Compare one exact package projection with every lane in one evidence-bound supplier capability declaration. Returns explicit match, conflict, or unknown checks. Import evidence concerns the drawing associated with the package, not proof that its JSON was received or accepted. It never scores or selects a supplier and grants no contact, quote, purchase, or fabrication authority.",
 "inputSchema": {
  "$id": "https://a2a2p.com/schema/supplier-fit",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "A deterministic comparison of caller-projected package facts with one evidence-bound supplier capability declaration. It does not select a supplier.",
  "properties": {
   "capability_declaration": {
    "type": "object"
   },
   "import_observation": {
    "anyOf": [
     {
      "type": "null"
     },
     {
      "type": "object"
     }
    ]
   },
   "package_projection": {
    "additionalProperties": false,
    "properties": {
     "design_file_format": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "pattern": "^[a-z][a-z0-9_-]{0,127}$",
        "type": "string"
       }
      ]
     },
     "material": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "pattern": "^[a-z][a-z0-9_-]{0,127}$",
        "type": "string"
       }
      ]
     },
     "package_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "process": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "pattern": "^[a-z][a-z0-9_-]{0,127}$",
        "type": "string"
       }
      ]
     },
     "quantity": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "minimum": 1,
        "type": "integer"
       }
      ]
     },
     "ship_to_country": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       }
      ]
     },
     "size_x_mm": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "exclusiveMinimum": 0,
        "type": "number"
       }
      ]
     },
     "size_y_mm": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "exclusiveMinimum": 0,
        "type": "number"
       }
      ]
     },
     "stock_thickness_mm": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "exclusiveMinimum": 0,
        "type": "number"
       }
      ]
     },
     "surface_finish": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "pattern": "^[a-z][a-z0-9_-]{0,127}$",
        "type": "string"
       }
      ]
     },
     "tolerance_class": {
      "anyOf": [
       {
        "type": "null"
       },
       {
        "pattern": "^[a-z][a-z0-9_-]{0,127}$",
        "type": "string"
       }
      ]
     }
    },
    "required": [
     "package_sha256",
     "process",
     "material",
     "stock_thickness_mm",
     "quantity",
     "size_x_mm",
     "size_y_mm",
     "design_file_format",
     "tolerance_class",
     "surface_finish",
     "ship_to_country"
    ],
    "type": "object"
   }
  },
  "required": [
   "package_projection",
   "capability_declaration"
  ],
  "title": "a2a2p supplier fit assessment input",
  "type": "object"
 },
 "name": "assess_supplier_fit",
 "outputSchema": {
  "type": "object"
 }
}
