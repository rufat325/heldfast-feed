{
 "description": "Search Amazon for products to purchase. Returns product titles, prices, ASINs, ratings, and Prime eligibility. Use the returned productLocator (amazon:ASIN) to create orders.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (default 10)",
    "type": "number"
   },
   "priceMax": {
    "description": "Maximum price filter in USD",
    "type": "number"
   },
   "priceMin": {
    "description": "Minimum price filter in USD",
    "type": "number"
   },
   "query": {
    "description": "Search query (e.g. 'wireless headphones under $50', 'running shoes')",
    "type": "string"
   },
   "sort": {
    "description": "Sort by: 'price_low_to_high', 'price_high_to_low', 'average_review', 'newest_arrivals'",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "commerce_search"
}
