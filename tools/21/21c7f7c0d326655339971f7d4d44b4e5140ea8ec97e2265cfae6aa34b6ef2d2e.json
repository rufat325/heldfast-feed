{
 "description": "Upload one image for a canonical job instruction page. Returns a private URL (/api/instructions/assets/<id>) to place in a TipTap image node; no instruction page is changed. The image is stored privately and shows only after a page write in this job places the URL; then only people with access to that page can load it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base64": {
    "minLength": 1,
    "type": "string"
   },
   "contentType": {
    "enum": [
     "image/jpeg",
     "image/png",
     "image/webp",
     "image/gif",
     "image/avif"
    ],
    "type": "string"
   },
   "fileName": {
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "fileName",
   "contentType",
   "base64",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_instructions_upload_image",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
