{
 "description": "Measure an account's Harvest-Now-Decrypt-Later exposure: has its signing PUBLIC KEY been revealed on-ledger, and which key? An r-address is a HASH of the pubkey; the pubkey is exposed only once the account signs a tx. Walks history OLDEST-first and classifies: master (IRREVERSIBLE \u2014 master key can't be rotated), regular / multisig (RECOVERABLE \u2014 rotate the key), or none (never signed = hash-only, not Shor-actionable). Reports balance-at-risk + honest truncation caveat. Read-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "r-address",
    "minLength": 25,
    "type": "string"
   },
   "maxPages": {
    "description": "history pages to scan (default 6 \u00d7 400 tx)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "hndl_exposure",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "type": "string"
   },
   "address": {
    "type": "string"
   },
   "balanceAtRiskDrops": {
    "type": "string"
   },
   "balanceDrops": {
    "type": "string"
   },
   "conclusive": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "exposed": {
    "type": "boolean"
   },
   "exposureClass": {
    "type": "string"
   },
   "firstExposureLedger": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "masterDisabled": {
    "type": "boolean"
   },
   "masterExposed": {
    "type": "boolean"
   },
   "multisigExposed": {
    "type": "boolean"
   },
   "network": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "recoverable": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   },
   "regularExposed": {
    "type": "boolean"
   },
   "scanned": {},
   "severity": {
    "type": "string"
   },
   "signedTxCount": {
    "type": "number"
   }
  },
  "required": [
   "scanned"
  ],
  "type": "object"
 }
}
