{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Generate AI activity/event ideas for a location and time range (creates draft events \u2014 async).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "activity_kind": {
    "description": "e.g. \"local_event\".",
    "type": "string"
   },
   "budget": {
    "description": "e.g. \"$50\".",
    "type": "string"
   },
   "category_ids": {
    "description": "Family-member category ids the activities are for.",
    "items": {
     "type": [
      "string",
      "number"
     ]
    },
    "type": "array"
   },
   "datetime_range_end": {
    "description": "ISO datetime.",
    "type": "string"
   },
   "datetime_range_start": {
    "description": "ISO datetime.",
    "type": "string"
   },
   "frameId": {
    "type": "string"
   },
   "physical_location": {
    "description": "Location, e.g. \"Charlotte, NC, USA\".",
    "type": "string"
   }
  },
  "required": [
   "category_ids",
   "physical_location",
   "datetime_range_start",
   "datetime_range_end"
  ],
  "type": "object"
 },
 "name": "skylight_generate_activity_ideas"
}
