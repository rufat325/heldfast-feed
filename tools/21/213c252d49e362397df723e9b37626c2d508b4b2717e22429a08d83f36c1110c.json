{
 "description": "Charge a credit or debit card (Stone acquiring)",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "Merchant account ID",
    "type": "string"
   },
   "amount": {
    "description": "Amount in cents",
    "type": "number"
   },
   "capture": {
    "description": "Auto-capture (default true). false = authorize only",
    "type": "boolean"
   },
   "card_token": {
    "description": "Previously tokenized card (use tokenize_card)",
    "type": "string"
   },
   "customer": {
    "description": "Customer details",
    "properties": {
     "document": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "description": {
    "description": "Charge description",
    "type": "string"
   },
   "installments": {
    "description": "Number of installments (default 1)",
    "type": "number"
   },
   "payment_method": {
    "description": "Card type",
    "enum": [
     "credit_card",
     "debit_card"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "amount",
   "card_token"
  ],
  "type": "object"
 },
 "name": "create_card_charge"
}
