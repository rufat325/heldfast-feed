 "description": "Walk a call chain and report where its timeout budget stops making sense. Reports an inner hop whose timeout is not shorter than its caller's, so the caller abandons the request first and the inner work completes into nothing; a worst case beyond the client deadline; a hop with no timeout at all; and retries configured at more than one layer, which multiply rather than add \u2014 three hops retrying three times each is twenty-seven requests at the bottom for one at the top. Pay 260000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client_deadline_ms": {
    "description": "How long the original caller waits.",
    "example": 3000,
    "maximum": 86400000,
    "minimum": 1,
    "type": "integer"
   },
   "hops": {
    "description": "The chain, outermost first, because that is the order a request travels. Nothing is fetched and nothing is executed, so an arbitrary configuration can be audited without access to the system it governs.",
    "example": [
     {
      "max_attempts": 3,
      "name": "edge-gateway",
      "timeout_ms": 1000
     },
     {
      "max_attempts": 3,
      "name": "orders-api",
      "timeout_ms": 1000
     },
     {
      "max_attempts": 3,
      "name": "orders-db",
      "timeout_ms": 2000
     }
    ],
    "items": {
     "properties": {
      "max_attempts": {
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
