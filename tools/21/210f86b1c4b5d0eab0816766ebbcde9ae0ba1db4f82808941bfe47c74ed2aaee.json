       "minimum": 1,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "client_deadline_ms",
   "hops"
  ],
  "type": "object"
 },
