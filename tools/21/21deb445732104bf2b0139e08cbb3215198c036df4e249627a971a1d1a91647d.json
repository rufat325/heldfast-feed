{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Prepare a Daski payment challenge"
 },
 "description": "Obtain a binding quote and create or reuse a draft order without submitting payment. Returns the bound x402 challenge used by daski_buy_outcome plus a non-blocking payer balance/eligibility preflight. The paid retry must carry the same providerAgentId, outcomeId, and request shown for approval.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "outcomeId": {
    "minLength": 1,
    "type": "string"
   },
   "payerAddress": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "providerAgentId": {
    "minLength": 1,
    "type": "string"
   },
   "request": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "providerAgentId",
   "outcomeId",
   "request"
  ],
  "type": "object"
 },
 "name": "daski_get_payment_challenge",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {},
  "type": "object"
 }
}
