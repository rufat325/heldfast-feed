{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new mailbox on a mail hosting. Two-phase commit: plan + token first, then apply with token. The password never appears in the plan output.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the prior plan response. Required on the apply phase only.",
    "format": "uuid",
    "type": "string"
   },
   "description": {
    "description": "Optional free-text description (\u2264 255 chars), shown in the manager UI.",
    "maxLength": 255,
    "type": "string"
   },
   "mail_hosting_id": {
    "description": "Mail hosting ID. Discover via infomaniak_list_mail_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mailbox_name": {
    "description": "Local part of the mailbox WITHOUT the @domain (e.g. 'info', NOT 'info@example.com'). Lowercase alphanumeric with dots, underscores or dashes; 1-64 chars.",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-z0-9._-]+$",
    "type": "string"
   },
   "password": {
    "allOf": [
     {
      "pattern": "[a-z]"
     },
     {
      "pattern": "[A-Z]"
     },
     {
      "pattern": "\\d"
     },
     {
      "pattern": "[^A-Za-z0-9]"
     }
    ],
    "description": "Initial mailbox password. Infomaniak policy: \u2265 8 chars, at least one lowercase, one uppercase, one digit and one special character. NEVER appears in the plan response \u2014 only in the apply call.",
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "mail_hosting_id",
   "mailbox_name",
   "password"
  ],
  "type": "object"
 },
 "name": "infomaniak_create_mailbox",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "description": {
        "type": "string"
       },
       "mail_hosting_id": {
        "type": "number"
       },
       "mailbox_name": {
        "type": "string"
       }
      },
      "required": [
       "mail_hosting_id",
       "mailbox_name"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "mail_hosting_id": {
      "type": "number"
     },
     "mailbox_name": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "mailbox_name",
     "mail_hosting_id",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
