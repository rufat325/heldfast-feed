{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a specific custom field by ID. `name` must always be supplied (the server replaces the field config).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowedValues": {
    "description": "Allowed values for select/multi-select field types",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "allowedValuesMode": {
    "description": "Whether one or multiple allowed values can be selected",
    "enum": [
     "single",
     "multiple"
    ],
    "type": "string"
   },
   "description": {
    "description": "Optional description for the field",
    "type": "string"
   },
   "id": {
    "description": "Unique identifier of the field",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Display name for the field",
    "type": "string"
   },
   "notApplicableValues": {
    "description": "Value(s) treated as not-applicable",
    "type": "string"
   },
   "otherValues": {
    "description": "Whether values outside allowedValues are permitted",
    "type": "boolean"
   },
   "privacyMode": {
    "description": "Privacy mode for the field",
    "type": "string"
   },
   "prompt": {
    "description": "AI prompt used to auto-populate the field",
    "type": "string"
   },
   "type": {
    "description": "Field type",
    "type": "string"
   }
  },
  "required": [
   "id",
   "name"
  ],
  "type": "object"
 },
 "name": "update_field",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Update Custom Field"
}
