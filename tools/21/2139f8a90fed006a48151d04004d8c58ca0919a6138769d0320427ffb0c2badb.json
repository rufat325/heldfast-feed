{
 "description": "Create a promotion/discount in VTEX",
 "inputSchema": {
  "properties": {
   "beginDateUtc": {
    "description": "Start date (ISO 8601)",
    "type": "string"
   },
   "endDateUtc": {
    "description": "End date (ISO 8601)",
    "type": "string"
   },
   "isActive": {
    "description": "Active status",
    "type": "boolean"
   },
   "name": {
    "description": "Promotion name",
    "type": "string"
   },
   "nominalDiscountValue": {
    "description": "Fixed discount amount",
    "type": "number"
   },
   "percentualDiscountValue": {
    "description": "Percentage discount (0-100)",
    "type": "number"
   },
   "type": {
    "description": "Promotion type",
    "enum": [
     "regular",
     "combo",
     "forThePriceOf",
     "progressive",
     "buyAndWin",
     "campaign"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "beginDateUtc",
   "endDateUtc"
  ],
  "type": "object"
 },
 "name": "create_promotion"
}
