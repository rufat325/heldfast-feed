{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a DRM site (policy binding, name, or FairPlay certificate)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fairPlayCert": {
    "additionalProperties": false,
    "description": "FairPlay Streaming certificate details",
    "properties": {
     "certFile": {
      "description": "FPS certificate (DER/CER file or HTTP URL)",
      "type": "string"
     },
     "privateEncryptedString": {
      "description": "Password string for the private key file",
      "type": "string"
     },
     "privateKey": {
      "description": "Private key (PEM file or HTTP URL)",
      "type": "string"
     },
     "secretKey": {
      "description": "ASK (Application Secret Key) string",
      "type": "string"
     }
    },
    "type": "object"
   },
   "policyId": {
    "description": "DRM policy ID (0 = Basic default, or a custom policy ID)",
    "type": "number"
   },
   "siteId": {
    "description": "Site ID to update",
    "type": "string"
   },
   "siteName": {
    "description": "Site name (3-20 chars: letters, numbers, '_')",
    "type": "string"
   }
  },
  "required": [
   "siteId",
   "policyId",
   "siteName"
  ],
  "type": "object"
 },
 "name": "ncloud_drm_update_site"
}
