{
 "_meta": {
  "openai/toolInvocation/invoked": "Catalogue searched",
  "openai/toolInvocation/invoking": "Searching\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search the MBD Travel catalogue"
 },
 "description": "Free-text search over published MBD Travel tours, experiences, hotels and the Dubai visa (examples: \"Japan tour\", \"Dubai desert safari\", \"Paris hotel\", \"Dubai visa\"; Turkish works too). Each result carries an id. Currency comes from the currency argument or the query (\"dollar\", \"AED\"), else EUR. A hotel result carries a price note, not a price. Flights, transfers, booking and payment are not in the index.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "Price currency.",
    "enum": [
     "EUR",
     "USD",
     "AED"
    ],
    "type": "string"
   },
   "language": {
    "description": "Result language; default tr.",
    "enum": [
     "tr",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum results per type; default 5.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Text to search.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "results": {
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "tur",
        "deneyim",
        "otel",
        "vize"
       ],
       "type": "string"
      },
      "price": {
       "properties": {
        "amount": {
         "description": "Minor units.",
         "type": "integer"
        },
        "basis": {
         "type": "string"
        },
        "currency": {
         "enum": [
          "EUR",
          "USD",
          "AED"
         ],
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency",
        "basis"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "snippet": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search the MBD Travel catalogue"
}
