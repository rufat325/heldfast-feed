{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Retrieves container logs as structured line arrays.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "container": {
    "description": "Container name or ID",
    "maxLength": 255,
    "type": "string"
   },
   "details": {
    "default": false,
    "description": "Show extra details provided to logs (default: false)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max lines in structured output. Truncates AFTER Docker returns lines (sets isTruncated=true). Use 'tail' to limit what Docker returns; use 'limit' to cap the structured response size.",
    "type": "number"
   },
   "since": {
    "description": "Show logs since timestamp (e.g., '10m', '2024-01-01')",
    "maxLength": 255,
    "type": "string"
   },
   "tail": {
    "default": 100,
    "description": "Number of lines to fetch from Docker (passed to --tail). This controls how many lines Docker returns from the end of the log. Default: 100.",
    "type": "number"
   },
   "timestamps": {
    "default": false,
    "description": "Show timestamps for each log line (default: false)",
    "type": "boolean"
   },
   "until": {
    "description": "Show logs until timestamp (e.g., '5m', '2024-01-02') for time-bounded queries",
    "maxLength": 255,
    "type": "string"
   }
  },
  "required": [
   "container"
  ],
  "type": "object"
 },
 "name": "logs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "head": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "isTruncated": {
    "type": "boolean"
   },
   "lines": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "stderrLines": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "stdoutLines": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tail": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Docker Logs"
}
