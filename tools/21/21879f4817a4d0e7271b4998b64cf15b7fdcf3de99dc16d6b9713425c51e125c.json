  "title": "chainpeek: how much of a coin sits on centralised exchanges, and is it flowing in or out (cached DefiLlama data)"
 },
 "description": "chainpeek: Use when an agent must judge selling pressure or check reserves before depositing: a coin's exchange inflow or outflow. For DEX volume use get_dex_volume. Returns how much of a coin sits on centralised exchanges and whether it is flowing in or out: per exchange the amount, USD value, share and the 1, 7 and 30-day change, totals and a daily history, from Tanod's cache of DefiLlama data. Cached DefiLlama data (refreshed every few hours), never live; the wallets are the exchanges' published or labelled wallets, so a rise means coins moved into them; symbols matched exactly; an unknown asset or exchange is a 422 and a missing or over-2-day-old cache a 503 (neither charged). Typically under 1 s (a local cache read). Price: USD 0.01. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/exchange-reserves-api.html",
 "inputSchema": {
  "properties": {
   "asset": {
    "description": "Token symbol held on exchanges, e.g. BTC, ETH, USDT, USDC (case-insensitive; matched exactly, so WBTC is not BTC).",
    "pattern": "^[A-Za-z0-9._$\\-]{1,20}$",
    "title": "Asset",
    "type": "string"
   },
   "days": {
    "default": 30,
    "description": "Length of the daily history of the total, in days (default 30, at most 90).",
    "maximum": 90,
    "minimum": 1,
    "title": "Days",
    "type": "integer"
   },
   "exchanges": {
    "anyOf": [
     {
      "items": {
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Exchange slugs or names to include, e.g. binance-cex, okx, bybit, kucoin (default: every tracked exchange, at most 20 names).",
    "title": "Exchanges"
   }
  },
  "required": [
   "asset"
  ],
  "title": "get_exchange_reservesArguments",
  "type": "object"
 },
