    "type": "string"
   },
   "riskTolerance": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "useGeminiNarrative": {
    "default": false,
    "description": "true \u304b\u3064 GOOGLE_GENAI_API_KEY \u304c\u3042\u308b\u3068\u304d\u3001Gemini \u3067\u30ab\u30fc\u30c9\u306b creativeAngle \u3068\u8cea\u554f\u5019\u88dc\u3092\u8ffd\u52a0",
    "type": "boolean"
   }
