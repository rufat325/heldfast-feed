   },
   "goal": {
    "default": "investment",
    "description": "\u63a2\u7d22\u76ee\u7684",
    "enum": [
     "investment",
     "store",
     "family",
     "office",
     "development"
    ],
    "type": "string"
   },
   "horizon": {
    "default": "3y",
    "enum": [
     "1y",
     "3y",
     "5y"
    ],
    "type": "string"
   },
   "includeExternalFreshness": {
    "default": false,
    "description": "true \u304b\u3064 MLIT_API_KEY \u74b0\u5883\u5909\u6570\u304c\u3042\u308b\u3068\u304d\u3001MLIT API \u304b\u3089\u6700\u65b0\u53d6\u5f15\u3092\u53d6\u5f97\u3057\u30b7\u30b0\u30ca\u30eb\u306b\u53cd\u6620",
    "type": "boolean"
   },
   "includeMarkdown": {
    "default": true,
    "type": "boolean"
   },
   "limit": {
    "default": 5,
    "description": "\u8fd4\u5374\u3059\u308b\u5019\u88dc\u6570",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "output_mode": {
    "default": "compact",
    "description": "Output verbosity. compact=TL;DR + key numbers only (default), detailed=full Markdown report | \u51fa\u529b\u8a73\u7d30\u5ea6\u3002compact=\u4e3b\u8981\u6570\u5024\u306e\u307f\uff08\u30c7\u30d5\u30a9\u30eb\u30c8\uff09\u3001detailed=\u5168\u6587\u30ec\u30dd\u30fc\u30c8\u4ed8\u304d",
    "enum": [
     "compact",
     "detailed"
    ],
    "type": "string"
   },
   "prefecture": {
    "default": "\u611b\u77e5\u770c",
