{
 "description": "Create a personal trust statement, private by default, tied to submitted interaction evidence.",
 "inputSchema": {
  "properties": {
   "idempotencyKey": {
    "type": "string"
   },
   "statement": {
    "properties": {
     "context": {
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "interactionId": {
      "format": "uuid",
      "type": "string"
     },
     "reason": {
      "type": "string"
     },
     "value": {
      "type": "integer"
     },
     "visibility": {
      "default": "private",
      "type": "string"
     }
    },
    "required": [
     "interactionId",
     "context",
     "value",
     "reason",
     "evidenceIds"
    ],
    "type": "object"
   }
  },
  "required": [
   "statement",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "create_trust"
}
