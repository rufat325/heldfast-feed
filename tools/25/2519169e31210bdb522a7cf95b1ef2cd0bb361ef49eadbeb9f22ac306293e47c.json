{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List conversations"
 },
 "description": "List unified-inbox conversations (threads) with their status and detected intent. Use this for triage; use list_emails for individual messages in a folder.",
 "inputSchema": {
  "properties": {
   "channel": {
    "description": "Filter by channel, e.g. email",
    "type": "string"
   },
   "intent": {
    "description": "Filter by detected intent, e.g. interested, unsubscribe, question",
    "type": "string"
   },
   "limit": {
    "description": "Results to return (default 20)",
    "type": "number"
   },
   "offset": {
    "description": "Offset for pagination",
    "type": "number"
   },
   "q": {
    "description": "Free-text search across the thread",
    "type": "string"
   },
   "status": {
    "description": "Filter by conversation status",
    "enum": [
     "open",
     "pending",
     "closed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_inbox_conversations"
}
