{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "plan:create"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Store a plan with chosen sources"
 },
 "description": "Store a host-authored plan with owner-selected Library/Brand Kit image ids and saved actor ids, using exact current versions, and record the supplied Jev-selected guides. MAIN checks owner, readiness, review and source bindings at import. Reuse the same selected reference id in each scene.referenceIds that must carry it. Pass the catalogueVersion and guides from soclo_host_plan_prepare unchanged. brandVisualMode carries the owner\u2019s visual Brand Kit choice: \"use\" (default) inherits Brand Kit visuals; \"exclude\" keeps brand facts in the prose while refusing automatic Brand Kit imagery \u2014 MAIN refuses an explicitly selected Brand Kit row under exclude, ordinary Library photos stay selectable, and changing the mode on a replay is a conflict. A first import must give every scene on-screen-text cue a \"render\" design. Spends no customer credits and makes no AI, quote, reservation, media generation or render call. When Soclo refuses a document it names the offending field in \"details\"; when the write reply is uncertain, reconcile under the same ids and content with soclo_host_plan_recover instead of retrying blindly. MAIN revalidates saved owner, actor and voice binding before importing and before new paid work; it never substitutes a newer default silently.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brandVisualMode": {
    "description": "For import_selected only: the owner\u2019s explicit visual Brand Kit choice. \"use\" (default) inherits Brand Kit visuals; \"exclude\" keeps every brand fact in the plan\u2019s prose while refusing automatic Brand Kit imagery \u2014 MAIN refuses an explicitly selected Brand Kit row under exclude, and ordinary Library photos stay selectable. Part of the stored plan identity: changing it on a replay is a conflict.",
    "enum": [
     "use",
     "exclude"
    ],
    "type": "string"
   },
   "catalogueVersion": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "clientRequestId": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    "type": "string"
   },
   "guides": {
    "description": "By default carry the exact guides returned by prepare into import/import_selected. Jev selected them from the brief; keep their certified revision and whole-entry digest. An unavailable selector may return [], allowing the host to proceed.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "entrySha256": {
       "pattern": "^[0-9a-f]{64}$",
       "type": "string"
      },
      "revision": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "skillId": {
       "maxLength": 240,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "skillId",
      "revision",
      "entrySha256"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "plan": {
    "additionalProperties": false,
    "properties": {
     "cast": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "sourceActorId": {
         "description": "Null for a new plan-only character; selected imports may name an actor id from selectedInput.actors.",
         "type": [
          "string",
          "null"
         ]
        },
        "voiceId": {
         "description": "Null for source-free plans. A selected plan may use only an exact selectedInput.voices[].id saved and bound to that cast member\u2019s actor.",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "sourceActorId",
        "name",
        "description",
        "voiceId"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "concept": {
      "type": "string"
     },
     "modelChoice": {
      "additionalProperties": false,
      "properties": {
       "modelId": {
        "description": "Preserve an explicit modelId in advanced mode; when no model was named, choose a suitable supported model.",
        "enum": [
         "wan3prime",
         "seedance25",
         "minimaxh3max",
         "kling3",
         "kling3pro",
         "veo31fast",
         "veo31",
         "veo31lite",
         "veo31lite720"
        ],
        "type": "string"
       },
       "productionNotes": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "modelId",
       "reason",
       "productionNotes"
      ],
      "type": "object"
     },
     "output": {
      "additionalProperties": false,
      "description": "A saved review selection; it replaces the request\u2019s resolution preference.",
      "properties": {
       "resolution": {
        "enum": [
         "480p",
         "720p",
         "768p",
         "1080p",
         "2k",
         "4k"
        ],
        "type": "string"
       }
      },
      "required": [
       "resolution"
      ],
      "type": "object"
     },
     "questions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "scenes": {
      "description": "One or more scenes.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "camera": {
         "description": "This shot\u2019s own camera prose, e.g. \"Close\" or \"Wide tracking shot\". The hard per-model limits (take seconds, scene seconds, aspect ratios, reference caps) are NOT opinions here: read them from action \"state\" cameraFacts for the chosen model.",
         "type": "string"
        },
        "castIds": {
         "description": "Must be ids of cast members declared in this plan.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "dialogue": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "delivery": {
            "enum": [
             "on_camera",
             "voiceover"
            ],
            "type": "string"
           },
           "performance": {
            "type": "string"
           },
           "speakerId": {
            "description": "Must be a cast member id, and for \"on_camera\" must also be in this scene\u2019s castIds.",
            "type": "string"
           },
           "text": {
            "type": "string"
           }
          },
          "required": [
           "speakerId",
           "delivery",
           "text",
           "performance"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "id": {
         "description": "Unique within the plan; letters, digits, \"_\" and \"-\" only.",
         "type": "string"
        },
        "onScreenText": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "render": {
            "description": "Required on a first import: Core refuses a newly authored plan whose on-screen text carries no render design. Optional when editing a saved plan, whose stored cues may predate this form.",
            "oneOf": [
             {
              "additionalProperties": false,
              "properties": {
               "placement": {
                "description": "Where and how the model should show the text in the generated shot.",
                "type": "string"
               },
               "timing": {
                "additionalProperties": false,
                "properties": {
                 "basis": {
                  "const": "planned-scene",
                  "type": "string"
                 },
                 "fromSeconds": {
                  "description": "Scene-relative start, non-negative.",
                  "type": "number"
                 },
                 "sceneSeconds": {
                  "description": "Must equal the scene\u2019s own seconds.",
                  "type": "number"
                 },
                 "toSeconds": {
                  "description": "Scene-relative end, later than fromSeconds and not past sceneSeconds.",
                  "type": "number"
                 }
                },
                "required": [
                 "basis",
                 "sceneSeconds",
                 "fromSeconds",
                 "toSeconds"
                ],
                "type": "object"
               },
               "version": {
                "const": "model-text.1",
                "type": "string"
               }
              },
              "required": [
               "version",
               "timing",
               "placement"
              ],
              "type": "object"
             },
             {
              "additionalProperties": false,
              "properties": {
               "layout": {
                "additionalProperties": false,
                "properties": {
                 "baselineYN": {
                  "type": "number"
                 },
                 "centerXN": {
                  "type": "number"
                 },
                 "color": {
                  "description": "Six-digit #RRGGBB.",
                  "type": "string"
                 },
                 "fontSizeHeightN": {
                  "type": "number"
                 }
                },
                "required": [
                 "centerXN",
                 "baselineYN",
                 "fontSizeHeightN",
                 "color"
                ],
                "type": "object"
               },
               "motion": {
                "oneOf": [
                 {
                  "additionalProperties": false,
                  "properties": {
                   "kind": {
                    "const": "hold",
                    "type": "string"
                   }
                  },
                  "required": [
                   "kind"
                  ],
                  "type": "object"
                 },
                 {
                  "additionalProperties": false,
                  "properties": {
                   "completeAtSeconds": {
                    "type": "number"
                   },
                   "kind": {
                    "const": "word-reveal",
                    "type": "string"
                   }
                  },
                  "required": [
                   "kind",
                   "completeAtSeconds"
                  ],
                  "type": "object"
                 },
                 {
                  "additionalProperties": false,
                  "properties": {
                   "kind": {
                    "const": "pop",
                    "type": "string"
                   },
                   "peakAfterSeconds": {
                    "type": "number"
                   },
                   "peakScale": {
                    "type": "number"
                   },
                   "revealAtSeconds": {
                    "type": "number"
                   },
                   "settleAfterSeconds": {
                    "type": "number"
                   },
                   "startScale": {
                    "type": "number"
                   },
                   "target": {
                    "enum": [
                     "whole-cue",
                     "last-word"
                    ],
                    "type": "string"
                   }
                  },
                  "required": [
                   "kind",
                   "target",
                   "revealAtSeconds",
                   "peakAfterSeconds",
                   "settleAfterSeconds",
                   "startScale",
                   "peakScale"
                  ],
                  "type": "object"
                 }
                ]
               },
               "timing": {
                "additionalProperties": false,
                "properties": {
                 "basis": {
                  "const": "planned-scene",
                  "type": "string"
                 },
                 "fromSeconds": {
                  "description": "Scene-relative start, non-negative.",
                  "type": "number"
                 },
                 "sceneSeconds": {
                  "description": "Must equal the scene\u2019s own seconds.",
                  "type": "number"
                 },
                 "toSeconds": {
                  "description": "Scene-relative end, later than fromSeconds and not past sceneSeconds.",
                  "type": "number"
                 }
                },
                "required": [
                 "basis",
                 "sceneSeconds",
                 "fromSeconds",
                 "toSeconds"
                ],
                "type": "object"
               },
               "version": {
                "const": "caption-design.1",
                "type": "string"
               }
              },
              "required": [
               "version",
               "timing",
               "layout",
               "motion"
              ],
              "type": "object"
             }
            ]
           },
           "text": {
            "type": "string"
           },
           "treatment": {
            "description": "How the text should look, in words.",
            "type": "string"
           }
          },
          "required": [
           "text",
           "treatment"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "referenceIds": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "seconds": {
         "description": "Positive. The whole plan\u2019s total must match durationSeconds when one is set.",
         "type": "number"
        },
        "sound": {
         "type": "string"
        },
        "title": {
         "type": "string"
        },
        "visual": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "seconds",
        "visual",
        "camera",
        "castIds",
        "referenceIds",
        "dialogue",
        "onScreenText",
        "sound"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "takePlan": {
      "additionalProperties": false,
      "description": "Seedance only: optional exact ordered take boundaries and filmed lengths. Omit to film each scene as its own take; never silently regroup an authored take.",
      "properties": {
       "takes": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "filmedSeconds": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "sceneIds": {
           "items": {
            "minLength": 1,
            "type": "string"
           },
           "minItems": 1,
           "type": "array"
          },
          "takeId": {
           "pattern": "^[a-zA-Z0-9_-]+$",
           "type": "string"
          }
         },
         "required": [
          "takeId",
          "sceneIds",
          "filmedSeconds"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       },
       "version": {
        "const": "soclo.take-plan.1",
        "type": "string"
       }
      },
      "required": [
       "version",
       "takes"
      ],
      "type": "object"
     },
     "title": {
      "type": "string"
     },
     "visualDirection": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "concept",
     "visualDirection",
     "modelChoice",
     "cast",
     "scenes",
     "questions"
    ],
    "type": "object"
   },
   "projectId": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    "type": "string"
   },
   "selectedInput": {
    "additionalProperties": false,
    "properties": {
     "actors": {
      "description": "Owner-selected saved actors in the requested order.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "actorVersion": {
         "description": "Exact current actorVersion from soclo_actors_current.",
         "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "id": {
         "description": "Owner actor id from soclo_actors_list/soclo_actors_current.",
         "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "referenceIds": {
         "description": "Empty; MAIN resolves actor images itself.",
         "items": {
          "type": "string"
         },
         "maxItems": 0,
         "type": "array"
        }
       },
       "required": [
        "id",
        "actorVersion",
        "name",
        "description",
        "referenceIds"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "brand": {
      "additionalProperties": false,
      "description": "Read the connected brand with soclo_brand_get and carry it here; do not invent brand facts.",
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "facts": {
        "description": "Brand facts the plan may rely on. Empty is allowed.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "name": {
        "type": "string"
       },
       "visualDirection": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "name",
       "facts",
       "visualDirection"
      ],
      "type": "object"
     },
     "brief": {
      "description": "The advert brief in the owner\u2019s own words. Required and non-blank.",
      "type": "string"
     },
     "constraints": {
      "additionalProperties": false,
      "properties": {
       "aspectRatio": {
        "description": "For example \"9:16\" or \"1:1\".",
        "type": "string"
       },
       "durationMode": {
        "description": "\"target\" requires a positive durationSeconds. Omitted keeps historical exact semantics.",
        "enum": [
         "target",
         "exact"
        ],
        "type": "string"
       },
       "durationSeconds": {
        "description": "Positive seconds, or null for no fixed length.",
        "type": [
         "number",
         "null"
        ]
       },
       "exactLines": {
        "description": "Lines that must appear word-for-word in the spoken dialogue.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "language": {
        "type": "string"
       },
       "productionNotes": {
        "type": "string"
       },
       "resolution": {
        "description": "Leave unset to use the chosen model\u2019s default resolution.",
        "enum": [
         "480p",
         "720p",
         "768p",
         "1080p",
         "2k",
         "4k"
        ],
        "type": "string"
       }
      },
      "required": [
       "aspectRatio",
       "durationSeconds",
       "language",
       "exactLines",
       "productionNotes"
      ],
      "type": "object"
     },
     "mode": {
      "description": "\"advanced\" keeps an explicit modelId; when no model is named, either mode uses automatic selection.",
      "enum": [
       "easy",
       "advanced"
      ],
      "type": "string"
     },
     "modelId": {
      "anyOf": [
       {
        "enum": [
         "wan3prime",
         "seedance25",
         "minimaxh3max",
         "kling3",
         "kling3pro",
         "veo31fast",
         "veo31",
         "veo31lite",
         "veo31lite720"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "A supported video model to preserve, or null/omitted for automatic model selection."
     },
     "references": {
      "description": "Exact checked image selections, preserved in owner order. References are per-take inputs: one distinct photo per scene is fine. One scene may cite at most nine references (no current provider accepts more); the chosen model may accept fewer per take and names the affected references when it refuses.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "type": "string"
        },
        "id": {
         "description": "Owner Library or Brand Kit image asset id.",
         "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
         "type": "string"
        },
        "kind": {
         "const": "image",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "mediaVersion": {
         "description": "Exact current asset updated_at; MAIN checks version and reviewed evidence.",
         "minLength": 1,
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "kind",
        "label",
        "role",
        "description",
        "mediaVersion"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "source": {
      "const": "manual",
      "description": "Always \"manual\" here. Autopilot is a server-owned source and is not importable by a host.",
      "type": "string"
     },
     "template": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "tileId": {
          "description": "The chosen look\u2019s tile id, exactly as the catalogue spells it.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         "tileVersion": {
          "description": "The tile version that id was chosen at.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "tileId",
         "tileVersion"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "The owner-facing look to plan against. Null or omitted means no template."
     },
     "voices": {
      "description": "Exact Soclo-hosted selection from soclo_hosted_voices_autoload after the owner hears its private audition and transcript. MAIN revalidates the original owner, actor and binding before new work.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "actorVoice": {
         "additionalProperties": false,
         "properties": {
          "actorId": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "actorVersion": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "bindingVersion": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "ownerId": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "revision": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "version": {
           "const": "actor-voice.1",
           "type": "string"
          },
          "voice": {
           "additionalProperties": false,
           "properties": {
            "accountScope": {
             "const": "soclo_hosted",
             "type": "string"
            },
            "description": {
             "maxLength": 1000,
             "minLength": 1,
             "type": "string"
            },
            "language": {
             "maxLength": 35,
             "minLength": 2,
             "type": "string"
            },
            "name": {
             "maxLength": 200,
             "minLength": 1,
             "type": "string"
            },
            "provider": {
             "const": "elevenlabs",
             "type": "string"
            },
            "voiceId": {
             "maxLength": 128,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "provider",
            "accountScope",
            "voiceId",
            "name",
            "description",
            "language"
           ],
           "type": "object"
          }
         },
         "required": [
          "version",
          "ownerId",
          "actorId",
          "actorVersion",
          "bindingVersion",
          "revision",
          "voice"
         ],
         "type": "object"
        },
        "id": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "language": {
         "maxLength": 35,
         "minLength": 2,
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "language",
        "actorVoice"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "brief",
     "source",
     "mode",
     "brand",
     "actors",
     "references",
     "voices",
     "constraints"
    ],
    "type": "object"
   }
  },
  "required": [
   "projectId",
