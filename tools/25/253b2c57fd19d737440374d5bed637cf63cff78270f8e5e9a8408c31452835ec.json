{
 "description": "Verify factual claims against memory. Returns CONFIRMED / CONTRADICTS / NOT FOUND per claim. Use before answering with facts about the user, projects, numbers, dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "claims": {
    "description": "Factual claims to verify",
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "mode": {
    "default": "auto",
    "description": "fast=lemmas only; full=+semantic; auto=default",
    "enum": [
     "fast",
     "full",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "claims"
  ],
  "type": "object"
 },
 "name": "memory_verify"
}
