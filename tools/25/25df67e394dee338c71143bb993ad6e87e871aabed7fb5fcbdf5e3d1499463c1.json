{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create an API key"},"description":"Creates an API key that acts as the caller on this API, the CLI, and the MCP server, named by `name`, which is trimmed and holds 1 to 32 characters. The key is returned only in this response. An OAuth access token gets 403, so an agent cannot create a key that outlives its grant.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"name":{"type":"string"}},"required":["name"],"type":"object"},"name":"createApiKey","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"properties":{"createdAt":{"type":"string"},"id":{"allOf":[{"pattern":"^[^A-Z]*$"}],"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$","type":"string"},"key":{"type":"string"},"name":{"anyOf":[{"type":"string"},{"type":"null"}]},"start":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["createdAt","id","name","start","key"],"type":"object"},"title":"Create an API key"}
