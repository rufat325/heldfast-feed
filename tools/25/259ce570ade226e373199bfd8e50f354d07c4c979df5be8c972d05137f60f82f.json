{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing draft",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "description": "Optional file attachments (base64-encoded)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "Base64-encoded file data",
       "type": "string"
      },
      "filename": {
       "description": "Attachment filename",
       "pattern": "^[^\\r\\n]*$",
       "type": "string"
      },
      "mimeType": {
       "description": "MIME type (e.g., application/pdf)",
       "pattern": "^[^\\r\\n]*$",
       "type": "string"
      }
     },
     "required": [
      "filename",
      "mimeType",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bcc": {
    "description": "BCC email address(es), comma-separated",
    "type": "string"
   },
   "body": {
    "description": "Email body (plain text). Used as the plain-text alternative when htmlBody is also provided.",
    "type": "string"
   },
   "cc": {
    "description": "CC email address(es), comma-separated",
    "type": "string"
   },
   "draftId": {
    "description": "The ID of the draft to update",
    "type": "string"
   },
   "from": {
    "description": "Sender email address (for send-as aliases)",
    "type": "string"
   },
   "htmlBody": {
    "description": "Optional HTML body. When set alongside body, the draft is multipart/alternative; when set alone, text/html.",
    "type": "string"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "threadId": {
    "description": "Thread to keep the draft in. Defaults to the draft's current thread, so reply drafts stay in their conversation.",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address(es), comma-separated",
    "type": "string"
   }
  },
  "required": [
   "draftId"
  ],
  "type": "object"
 },
 "name": "draft_update",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "message": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "threadId": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "threadId"
    ],
    "type": "object"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Update draft"
}
