{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a signal for lookahead"
 },
 "description": "Does a signal look ahead? plan gives cuts; rerun your code on the first cut rows for each, then compare. Rows that changed used later rows; the result names the pattern and horizon. No code is sent. A pass covers only these cuts: the columns are the caller's, and survivorship, vendor revisions or a leak no cut reaches leave no trace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "plan",
     "compare"
    ],
    "type": "string"
   },
   "columns": {
    "additionalProperties": {
     "properties": {},
     "type": "object"
    },
    "description": "compare: {name: {full: [all rows], prefixes: [[first cuts[i] rows], ...]}}, null for missing.",
    "type": "object"
   },
   "columns_file": {
    "description": "compare, on your machine: a JSON file {cuts, columns} instead.",
    "type": "string"
   },
   "cuts": {
    "description": "compare: plan's cuts.",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "observations": {
    "description": "plan: rows in the series.",
    "type": "integer"
   },
   "prefixes": {
    "description": "plan: cuts, default 5.",
    "type": "integer"
   },
   "seed": {
    "type": "integer"
   },
   "timestamps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tolerance": {
    "description": "Default 1e-9.",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "check_leakage",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "plan: cuts and seed. compare: verdict over all columns, flagged_columns, and per column its pattern, sentence and per-cut changes.",
  "properties": {
   "columns": {
    "properties": {},
    "type": "object"
   },
   "cuts": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "flagged_columns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "plain_reading": {
    "type": "string"
   },
   "seed": {
    "type": "number"
   },
   "source": {
    "properties": {},
    "type": "object"
   },
   "verdict": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Check a signal for lookahead"
}
