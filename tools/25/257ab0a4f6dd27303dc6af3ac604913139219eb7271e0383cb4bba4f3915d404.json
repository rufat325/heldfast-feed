{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a ticket"
 },
 "description": "Change a ticket's title, status, type, priority, impact or assigned technician. Only the fields you pass are sent. Atera: PUT /api/v3/tickets/{ticketId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "impact": {
    "enum": [
     "NoImpact",
     "SiteDown",
     "ServerIssue",
     "Minor",
     "Major",
     "Crisis"
    ],
    "type": "string"
   },
   "priority": {
    "enum": [
     "Low",
     "Medium",
     "High",
     "Critical"
    ],
    "type": "string"
   },
   "status": {
    "description": "Ticket status name, e.g. Open, Pending, Resolved or Closed (or a custom status).",
    "minLength": 1,
    "type": "string"
   },
   "technician_contact_id": {
    "description": "Reassign to this technician (TechnicianContactID).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "technician_email": {
    "description": "Reassign to the technician with this email.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "ticket_id": {
    "description": "The ticket's TicketID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "New title.",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "Incident",
     "Problem",
     "Request",
     "Change"
    ],
    "type": "string"
   }
  },
  "required": [
   "ticket_id"
  ],
  "type": "object"
 },
 "name": "atera_update_ticket",
 "title": "Update a ticket"
}
