{
 "annotations": {
  "title": "Go to goal"
 },
 "description": "Navigate to a goal using the pathfinder and block until arrival (or timeout). Supports block/near/xz/nearxz/y/getToBlock/lookAtBlock/placeBlock and composite_any/composite_all/invert (nested via `goals`). Cancellable; throws NO_PATH if unreachable, TIMEOUT if it takes too long.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "goalType": {
    "description": "Which kind of pathfinder goal to build",
    "enum": [
     "block",
     "near",
     "xz",
     "nearxz",
     "y",
     "getToBlock",
     "lookAtBlock",
     "placeBlock",
     "composite_any",
     "composite_all",
     "invert"
    ],
    "type": "string"
   },
   "goals": {
    "description": "Nested goals for composite_any/composite_all/invert",
    "items": {
     "properties": {
      "goalType": {
       "type": "string"
      },
      "range": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      },
      "z": {
       "type": "number"
      }
     },
     "required": [
      "goalType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "range": {
    "description": "Acceptable distance from the target (for near/nearxz/follow)",
    "type": "number"
   },
   "timeout": {
    "description": "Max ms to spend navigating (default 60000)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "x": {
    "description": "Target X (required for most goal types)",
    "type": "number"
   },
   "y": {
    "description": "Target Y",
    "type": "number"
   },
   "z": {
    "description": "Target Z",
    "type": "number"
   }
  },
  "required": [
   "goalType"
  ],
  "type": "object"
 },
 "name": "goto"
}
