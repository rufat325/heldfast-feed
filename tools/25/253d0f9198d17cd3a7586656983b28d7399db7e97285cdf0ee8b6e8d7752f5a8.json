{
 "description": "Compile a declarative RenderPlan into an mp4 via ffmpeg \u2014 deterministic, brand-aware, no generation keys needed. Clips (video/image/color) are concatenated in order; overlays and captions are burned in; optional music is mixed under clip audio. Returns the rendered asset id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "plan": {
    "properties": {
     "aspect": {
      "default": "9:16",
      "enum": [
       "9:16",
       "1:1",
       "4:5",
       "16:9"
      ],
      "type": "string"
     },
     "captions": {
      "default": [],
      "items": {
       "properties": {
        "endSec": {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        "startSec": {
         "minimum": 0,
         "type": "number"
        },
        "text": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text",
        "startSec",
        "endSec"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "clips": {
      "items": {
       "oneOf": [
        {
         "properties": {
          "asset": {
           "description": "Asset id or absolute path of a video file",
           "type": "string"
          },
          "fit": {
           "default": "cover",
           "enum": [
            "cover",
            "contain"
           ],
           "type": "string"
          },
          "kind": {
           "const": "video",
           "type": "string"
          },
          "muted": {
           "default": false,
           "type": "boolean"
          },
          "trimEndSec": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "trimStartSec": {
           "minimum": 0,
           "type": "number"
          }
         },
         "required": [
          "kind",
          "asset"
         ],
         "type": "object"
        },
        {
         "properties": {
          "asset": {
           "description": "Asset id or absolute path of an image file",
           "type": "string"
          },
          "durationSec": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "fit": {
           "default": "cover",
           "enum": [
            "cover",
            "contain"
           ],
           "type": "string"
          },
          "kind": {
           "const": "image",
           "type": "string"
          }
         },
         "required": [
          "kind",
          "asset",
          "durationSec"
         ],
         "type": "object"
        },
        {
         "properties": {
          "color": {
           "pattern": "^#[0-9a-fA-F]{6}$",
           "type": "string"
          },
          "durationSec": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "kind": {
           "const": "color",
           "type": "string"
          }
         },
         "required": [
          "kind",
          "color",
          "durationSec"
         ],
         "type": "object"
        }
       ]
      },
      "minItems": 1,
      "type": "array"
     },
     "fps": {
      "default": 30,
      "maximum": 60,
      "minimum": 12,
      "type": "integer"
     },
     "music": {
      "properties": {
       "asset": {
        "type": "string"
       },
       "loop": {
        "default": true,
        "type": "boolean"
       },
       "volumeDb": {
        "default": -8,
        "maximum": 6,
        "type": "number"
       }
      },
      "required": [
       "asset"
      ],
      "type": "object"
     },
     "overlays": {
      "default": [],
      "items": {
       "properties": {
        "endSec": {
         "description": "Defaults to the end of the video",
         "exclusiveMinimum": 0,
         "type": "number"
        },
        "preset": {
         "default": "title",
         "enum": [
          "title",
          "center",
          "lower-third",
          "caption"
         ],
         "type": "string"
        },
        "startSec": {
         "default": 0,
         "minimum": 0,
         "type": "number"
        },
        "text": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "quality": {
      "default": "standard",
      "enum": [
       "draft",
       "standard",
       "high"
      ],
      "type": "string"
     }
    },
    "required": [
     "clips"
    ],
    "type": "object"
   }
  },
  "required": [
   "plan"
  ],
  "type": "object"
 },
 "name": "render_video",
 "title": "Render video"
}
