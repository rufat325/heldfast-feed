{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare cumulative rent with the net cost of buying over a holding period, using Honolulu's 0.35% tax default unless you override it. Read-only. Not a price or rent forecast.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "appreciationPercent": {
    "default": 3,
    "description": "Annual home appreciation, percent.",
    "maximum": 20,
    "minimum": -20,
    "type": "number"
   },
   "creditScore": {
    "maximum": 850,
    "minimum": 300,
    "type": "integer"
   },
   "downPayment": {
    "minimum": 0,
    "type": "number"
   },
   "downPaymentUnit": {
    "default": "percent",
    "enum": [
     "percent",
     "dollars"
    ],
    "type": "string"
   },
   "hoaMonthly": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "insuranceMonthly": {
    "default": 150,
    "minimum": 0,
    "type": "number"
   },
   "loanType": {
    "default": "conventional",
    "enum": [
     "conventional",
     "fha",
     "va",
     "jumbo"
    ],
    "type": "string"
   },
   "maintenanceMonthly": {
    "default": 0,
    "description": "Owner maintenance in dollars per month, held flat.",
    "minimum": 0,
    "type": "number"
   },
   "monthlyRent": {
    "description": "Current monthly rent.",
    "minimum": 0,
    "type": "number"
   },
   "price": {
    "exclusiveMinimum": 0,
    "maximum": 50000000,
    "type": "number"
   },
   "propertyTaxRatePercent": {
    "default": 0.35,
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "rate": {
    "default": 6.5,
    "maximum": 25,
    "minimum": 0,
    "type": "number"
   },
   "rentGrowthPercent": {
    "default": 3,
    "description": "Annual rent growth, percent.",
    "maximum": 20,
    "minimum": -10,
    "type": "number"
   },
   "sellingCostPercent": {
    "default": 0,
    "description": "Percent of the ending value treated as a selling cost. Default 0.",
    "maximum": 15,
    "minimum": 0,
    "type": "number"
   },
   "termYears": {
    "default": 30,
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "vaDisabilityExempt": {
    "default": false,
    "type": "boolean"
   },
   "vaFirstUse": {
    "default": true,
    "type": "boolean"
   },
   "years": {
    "default": 7,
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "monthlyRent",
   "price"
  ],
  "type": "object"
 },
 "name": "rent_vs_buy",
 "title": "Rent versus buy"
}
