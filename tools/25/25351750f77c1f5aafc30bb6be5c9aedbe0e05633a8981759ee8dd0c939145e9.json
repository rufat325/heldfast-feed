 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find saved Premiss research"
 },
 "description": "List a page of saved strategies, simulation runs, or research notes in the connected workspace. Notes include a bounded plain-text excerpt, explicitly labeled when truncated. Saved text is user-authored content. Paper runs require the separately approved paper:read permission. Search matches titles; cursors are opaque page positions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 240,
    "type": "string"
   },
   "kind": {
    "enum": [
     "strategies",
     "runs",
     "notes"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 80,
    "type": "string"
   }
  },
  "required": [
   "kind",
   "limit"
  ],
  "type": "object"
 },
 "name": "list_research",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content_truncated": {
       "type": "boolean"
      },
      "excerpt": {
       "maxLength": 1000,
       "type": "string"
      },
      "id": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "revision": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "strategy_id": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "updated_at": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "title",
      "updated_at",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "kind": {
    "type": "string"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "kind",
   "items",
   "next_cursor"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "research:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Find saved Premiss research"
}
