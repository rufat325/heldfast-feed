{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks what is available, sold or happening near a place or near them (e.g. '\u05de\u05d4 \u05de\u05d5\u05db\u05e8\u05d9\u05dd \u05dc\u05d9\u05d3\u05d9', '\u05de\u05d4 \u05e7\u05d5\u05e8\u05d4 \u05dc\u05d9\u05d3\u05d9', '\u05d0\u05d9\u05e9 \u05de\u05e7\u05e6\u05d5\u05e2 \u05d1\u05d0\u05d6\u05d5\u05e8'). If their location is unknown, ask for a city or area first instead of guessing. Finds active listings near a geographic point using PostGIS distance search. Latitude and longitude are separate decimal-degree values; radius_km is required and measured in kilometers. You may narrow by category. Distance ordering is the default. An empty results array means nothing active matched within the radius.",
 "inputSchema": {
  "properties": {
   "category": {
    "anyOf": [
     {
      "maxLength": 80,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional category slug.",
    "title": "Category"
   },
   "latitude": {
    "description": "Search origin latitude in decimal degrees.",
    "maximum": 90,
    "minimum": -90,
    "title": "Latitude",
    "type": "number"
   },
   "longitude": {
    "description": "Search origin longitude in decimal degrees.",
    "maximum": 180,
    "minimum": -180,
    "title": "Longitude",
    "type": "number"
   },
   "radius_km": {
    "description": "Maximum distance from the origin, in kilometers.",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "title": "Radius Km",
    "type": "number"
   },
   "sort": {
    "default": "distance",
    "description": "Result ordering; distance requires the supplied origin.",
    "enum": [
     "relevance",
     "distance",
     "newest"
    ],
    "title": "Sort",
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude",
   "radius_km"
  ],
  "title": "search_nearbyArguments",
  "type": "object"
 },
 "name": "search_nearby",
 "outputSchema": {
  "$defs": {
   "ListingOutput": {
    "description": "Public listing fields returned by Community Board tools.",
    "properties": {
     "address": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Address"
     },
     "category": {
      "title": "Category",
      "type": "string"
     },
     "created_at": {
      "title": "Created At",
      "type": "string"
     },
     "currency": {
      "title": "Currency",
      "type": "string"
     },
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Description"
     },
     "distance_km": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Distance Km"
     },
     "id": {
      "title": "Id",
      "type": "string"
     },
     "latitude": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Latitude"
     },
     "longitude": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Longitude"
     },
     "price": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Price"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "title": {
      "title": "Title",
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "description",
     "category",
     "price",
     "currency",
     "status",
     "address",
     "latitude",
     "longitude",
     "distance_km",
     "created_at"
    ],
    "title": "ListingOutput",
    "type": "object"
   }
  },
  "properties": {
   "count": {
    "title": "Count",
    "type": "integer"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/ListingOutput"
    },
    "title": "Results",
    "type": "array"
   }
  },
  "required": [
   "results",
   "count"
  ],
  "title": "ListingSearchOutput",
  "type": "object"
 },
 "title": "Search nearby listings"
}
