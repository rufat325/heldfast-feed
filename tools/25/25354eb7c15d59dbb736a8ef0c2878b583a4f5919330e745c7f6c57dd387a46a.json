     "city": {
      "maxLength": 255,
      "type": "string"
     },
     "state": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "zip": {
      "maxLength": 10,
      "type": "string"
     }
    },
    "required": [
     "state"
    ],
    "type": "object"
   },
   "trade": {
    "description": "Trade code (plumbing, electrical, HVAC, etc.)",
    "type": "string"
   },
   "urgency": {
    "default": "routine",
    "enum": [
     "emergency",
     "urgent",
     "routine",
     "scheduled"
    ],
    "type": "string"
   }
  },
  "required": [
   "trade",
   "location"
  ],
  "type": "object"
 },
