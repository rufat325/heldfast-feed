{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search across all Metabase items (cards, dashboards, collections, tables)",
 "inputSchema": {
  "properties": {
   "collection_id": {
    "description": "Search within specific collection",
    "type": "number"
   },
   "limit": {
    "default": 50,
    "description": "Maximum results to return",
    "type": "number"
   },
   "models": {
    "description": "Filter by item types (default: all)",
    "items": {
     "enum": [
      "card",
      "dashboard",
      "collection",
      "table",
      "database",
      "pulse"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "Search query text",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "mb_search",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "number"
   },
   "results": {
    "items": {
     "properties": {
      "id": {
       "type": "number"
      },
      "model": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "model"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Metabase"
}
