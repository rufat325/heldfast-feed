{
 "description": "Informational LIVE rollout preview using the exact apply-time classifier: would-be per-assignment outcomes + counts. Counts can change the moment learners act; this never fences the apply. Zero writes; requires lms:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentIds": {
    "items": {
     "$ref": "#/properties/courseId"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "courseId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "expectedToContentHash": {
    "pattern": "^[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "jobId": {
    "$ref": "#/properties/courseId"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "assessmentReplaced": {
      "enum": [
       "RESET",
       "GRANDFATHER"
      ],
      "type": "string"
     },
     "completedAssignments": {
      "enum": [
       "SKIP"
      ],
      "type": "string"
     },
     "contentChanged": {
      "enum": [
       "CARRY",
       "RESET"
      ],
      "type": "string"
     },
     "openWork": {
      "enum": [
       "DEFER"
      ],
      "type": "string"
     }
    },
    "required": [
     "assessmentReplaced",
     "contentChanged",
     "openWork",
     "completedAssignments"
    ],
    "type": "object"
   },
   "toCourseVersionId": {
    "$ref": "#/properties/courseId"
   }
  },
  "required": [
   "courseId",
   "toCourseVersionId",
   "expectedToContentHash"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_rollout_preview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
