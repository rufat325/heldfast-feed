{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a Pollar person or organisation"
 },
 "description": "Fetches Pollar's profile for a person or organisation by slug (slugs come from list_trending_entities). With withTimeline, it also lists recent events that mention the subject. Returns the profile and a canonical Pollar URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "slug": {
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "person",
     "organization"
    ],
    "type": "string"
   },
   "withTimeline": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "type",
   "slug"
  ],
  "type": "object"
 },
 "name": "get_entity",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "desc": {
    "type": "string"
   },
   "imageUrl": {
    "type": "string"
   },
   "mentionCount": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "timeline": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "imageUrl": {
       "type": "string"
      },
      "lead": {
       "type": "string"
      },
      "publishedAt": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "publishedAt",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "enum": [
     "person",
     "organization"
    ],
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "wikipedia": {
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "slug",
   "url"
  ],
  "type": "object"
 },
 "title": "Get a Pollar person or organisation"
}
