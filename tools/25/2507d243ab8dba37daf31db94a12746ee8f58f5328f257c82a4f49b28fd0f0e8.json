{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Open up to four public pages. Pass a focused context to get only the passages relevant to that question (cheap and precise), or omit it to read the full page as clean Markdown with start-based pagination.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "pages": {
    "items": {
     "properties": {
      "context": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      },
      "live": {
       "type": "boolean"
      },
      "start": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "pages"
  ],
  "type": "object"
 },
 "name": "open_web_pages",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budgetReached": {
    "type": "boolean"
   },
   "failures": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "pages": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "pages",
   "failures",
   "budgetReached"
  ],
  "type": "object"
 },
 "title": "Read public web pages"
}
