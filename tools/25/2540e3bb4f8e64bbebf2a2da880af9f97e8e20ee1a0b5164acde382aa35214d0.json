{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns deterministic, tracker-specific consent-gating guidance from RegSentry's maintained playbooks. It does not change a website, contact a vendor, or verify that a fix was implemented.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "tracker": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[\\w .()+/&-]+$",
    "type": "string"
   }
  },
  "required": [
   "tracker"
  ],
  "type": "object"
 },
 "name": "get_remediation_playbook",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "disclaimer": {
    "type": "string"
   },
   "docsUrl": {
    "format": "uri",
    "type": "string"
   },
   "loadedVia": {
    "enum": [
     "gtm_or_snippet",
     "snippet",
     "npm_or_snippet"
    ],
    "type": "string"
   },
   "risk": {
    "type": "string"
   },
   "snippet": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "language": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "language",
     "code"
    ],
    "type": "object"
   },
   "steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tracker": {
    "type": "string"
   }
  },
  "required": [
   "tracker",
   "risk",
   "loadedVia",
   "steps",
   "disclaimer"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get tracker remediation playbook"
}
