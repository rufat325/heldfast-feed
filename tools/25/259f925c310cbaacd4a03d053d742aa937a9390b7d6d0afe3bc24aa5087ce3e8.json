{
 "description": "Create many WEEEK tasks in one call. Returns a per-item report; one bad name does not abort the batch.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tasks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assignee": {
       "$ref": "#/properties/tasks/items/properties/project"
      },
      "column": {
       "$ref": "#/properties/tasks/items/properties/project"
      },
      "description": {
       "type": "string"
      },
      "due": {
       "type": "string"
      },
      "project": {
       "type": [
        "string",
        "number"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "project"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "name": "weeek_create_tasks"
}
