        "name": {
         "type": "string"
        },
        "onAir": {
         "anyOf": [
          {
           "additionalProperties": {},
           "properties": {
            "frame": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "null"
              }
             ],
             "description": "The frame/<id> on air"
            }
           },
           "required": [
            "frame"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ],
         "description": "While it runs: frame, next, controls, sources"
        },
        "state": {
         "type": "string"
        },
        "stream": {
         "description": "The stream's id (stream_\u2026)",
         "type": "string"
        }
       },
       "required": [
        "stream",
        "name",
        "state",
        "onAir"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "summary": {
