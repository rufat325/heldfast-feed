  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "scene": {
    "description": "The scene (scn_\u2026), from list_scenes or create_scene.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "scene"
  ],
  "type": "object"
 },
 "name": "get_scene_state",
 "outputSchema": {
