{"_meta":{"openai/outputTemplate":"ui://bestprice/shopping-workspace-v8.html","openai/toolInvocation/invoked":"Basket plans ready.","openai/toolInvocation/invoking":"Rechecking the basket\u2026","openai/widgetDescription":"Shows current basket plans with quantities, merchants and known or unknown shipping. Does not place an order.","ui":{"resourceUri":"ui://bestprice/shopping-workspace-v8.html"},"ui/resourceUri":"ui://bestprice/shopping-workspace-v8.html"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Optimize a BestPrice basket"},"description":"Calculates read-only basket plans for exact grouped BestPrice product IDs delivered to a Greek postcode. Compares cheapest, fewer-merchant, and balanced reliability-and-cost plans within the requested merchant ceiling and rating floor. Returns public store names and cost breakdowns; unknown shipping leaves affected delivered totals null. Does not discover products, place orders, process payments, or expose merchant destination URLs.","icons":[{"mimeType":"image/svg+xml","sizes":["any"],"src":"https://www.bestprice.gr/images/logo.svg"},{"mimeType":"image/png","sizes":["1024x1024"],"src":"https://raw.githubusercontent.com/TheBestCo/bestprice-mcp/main/assets/bestprice-mcp-logo-1024.png"}],"inputSchema":{"additionalProperties":false,"properties":{"items":{"description":"One to twenty distinct grouped BestPrice products to plan together.","items":{"additionalProperties":false,"properties":{"product_id":{"description":"Exact grouped BestPrice product id returned by search_products.","pattern":"^bp_[0-9]{10}$","type":"string"},"quantity":{"default":1,"description":"Requested quantity of this exact product.","maximum":20,"minimum":1,"type":"integer"}},"required":["product_id"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"maximum_merchants":{"default":3,"description":"Maximum number of different merchants allowed in a basket plan.","maximum":8,"minimum":