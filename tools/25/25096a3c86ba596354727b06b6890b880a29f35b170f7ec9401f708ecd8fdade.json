{
 "description": "Webring members in ring order. Optional kind/category filters and limit/offset pagination.",
 "inputSchema": {
  "properties": {
   "category": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "agent",
     "mcp",
     "website"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "ring_list"
}
