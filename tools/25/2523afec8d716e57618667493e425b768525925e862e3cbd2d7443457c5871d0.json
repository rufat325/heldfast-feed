  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max": {
    "description": "Inclusive upper bound. Integer. Defaults to 100.",
    "type": "number"
   },
   "min": {
    "description": "Inclusive lower bound. Integer. Defaults to 1.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "random_int",
