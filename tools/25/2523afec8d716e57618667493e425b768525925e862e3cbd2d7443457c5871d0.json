{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Free verified random integer"
 },
 "description": "Return a uniformly distributed random integer in [min, max], derived from a signature-verified drand quicknet beacon mixed with a server secret and, when a public KiwiSDR receiver delivers one, a hash of live HF atmospheric noise. The response carries the drand round, the beacon signature, a per-request nonce, a commitment hash binding them to the value, a URL where the round can be re-verified, and a `physical` block stating whether noise went in and from where. Free and rate-limited.",
 "execution": {
  "taskSupport": "forbidden"
 },
