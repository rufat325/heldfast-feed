{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a provisioned user using RFC 7644 SCIM PatchOp operations. Each operation has op (add/remove/replace), an optional path, and a value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "operations": {
    "description": "PatchOp operations per RFC 7644 \u00a73.5.2 (e.g. { op: 'replace', path: 'active', value: false }).",
    "items": {
     "properties": {
      "op": {
       "enum": [
        "add",
        "remove",
        "replace"
       ],
       "type": "string"
      },
      "path": {
       "maxLength": 256,
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "op"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "org_id": {
    "description": "Organization ID.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "user_id": {
    "description": "SCIM user ID to update.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "org_id",
   "user_id",
   "operations"
  ],
  "type": "object"
 },
 "name": "atlasent_patch_scim_user",
 "title": "AtlaSent \u2014 Patch SCIM User"
}
