{
 "description": "Find entries in one agent's L5 that match a topic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_level": {
    "default": "public",
    "type": "string"
   },
   "agent": {
    "type": "string"
   },
   "include_private": {
    "default": false,
    "type": "boolean"
   },
   "topic": {
    "type": "string"
   }
  },
  "required": [
