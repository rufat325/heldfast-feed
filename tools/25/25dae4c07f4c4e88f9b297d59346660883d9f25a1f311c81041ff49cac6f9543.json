{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Permanently deletes footage files or one folder from the Huasheng library. This cannot be undone. List the library first, name exactly what will be removed, and let the host ask the user for confirmation before calling this tool.",
 "inputSchema": {
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "kind": {
       "enum": [
        "files"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "folder_id": false,
      "ids": {
       "minItems": 1
      }
     },
     "required": [
      "ids"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "kind": {
       "enum": [
        "folder"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "folder_id": {
       "minimum": 1,
       "type": "integer"
      },
      "ids": false
     },
     "required": [
      "folder_id"
     ]
    }
   }
  ],
  "properties": {
   "client_action_id": {
    "description": "MCP App only: submission id; reuse for the same click. Models omit.",
    "type": "string"
   },
   "folder_id": {
    "description": "Folder id when kind=folder",
    "minimum": 1,
    "type": "integer"
   },
   "ids": {
    "description": "Material ids when kind=files",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "kind": {
    "description": "What to delete",
    "enum": [
     "files",
     "folder"
    ],
    "type": "string"
   },
   "ui_lang": {
    "description": "MCP App only: follow-up language. Models omit.",
    "type": "string"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "name": "huasheng_delete_materials",
 "outputSchema": {
  "type": "object"
 },
 "title": "Permanently delete Huasheng footage"
}
