{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get price history"},"description":"Price history for either one product (its past check/wire prices) or a metal (daily closes, up to a 5-year span). Give product, or metal with optional from/to dates (default: the last 12 months). Use when the user asks how a metal's price has moved over a past period. Read-only; past data, not a forecast.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"from":{"description":"Start date YYYY-MM-DD (metal history)","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"metal":{"description":"gold, silver, platinum or palladium","enum":["gold","silver","platinum","palladium"],"type":"string"},"product":{"description":"Product id, slug or URL","maxLength":300,"minLength":1,"type":"string"},"to":{"description":"End date YYYY-MM-DD (metal history; default today)","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"type":"object"},"name":"get_price_history","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"change_pct":{"type":["number","null"]},"first":{"type":["number","null"]},"high":{"type":["number","null"]},"last":{"type":["number","null"]},"low":{"type":["number","null"]},"notes":{"items":{"type":"string"},"type":"array"},"points":{"items":{"additionalProperties":{},"properties":{"date":{"type":"string"},"price":{"type":"number"}},"required":["date","price"],"type":"object"},"type":"array"},"points_total":{"type":"number"},"price_time":{"type":["string","null"]},"source_url":{"type":"string"}},"required":["source_url","price_time","notes","points","first","last","low","high","change_pct","points_total"],"type":"object"},"title":"Get price history"}
