  "title": "Load agent memory"
 },
 "description": "Load a memory you saved in an earlier session \u2014 retrieval is free.\n\nGet back an encrypted blob you parked earlier (the blind locker) by its\nclaim `ticket`. Returns {ok, blob_b64, size_bytes, expires_at} \u2014 the\nciphertext you saved, which only YOU can decrypt. A wrong owner reads as a\nmissing ticket; an expired TTL is `expired`; a lost at-rest key is\n`at_rest_key_unavailable`. Free (the save settled it).",
 "inputSchema": {
  "properties": {
   "api_key": {
    "description": "The same SNHP API key you saved under (a different owner reads as a missing ticket).",
    "title": "Api Key",
    "type": "string"
   },
   "ticket": {
    "description": "The claim ticket returned by memory_save.",
    "title": "Ticket",
    "type": "string"
   }
  },
  "required": [
   "api_key",
   "ticket"
  ],
  "title": "store_retrieveArguments",
  "type": "object"
 },
