{
 "description": "List all contacts with optional filtering by subscription status and tag. Supports pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "default": 20,
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "subscribed": {
    "description": "Filter by subscription status",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   },
   "tagId": {
    "description": "Filter by tag ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_contacts"
}
