{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch text from a library source. Full-text sources return cleaned text (truncated at 200k chars). Metadata sources return item details and an external URL.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Item identifier from library_search or library_ask",
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "description": "Library source name. Run library_list_sources for the current list and descriptions.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "source"
  ],
  "type": "object"
 },
 "name": "library_read",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "authors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "charCount": {
    "type": "number"
   },
   "doi": {
    "type": "string"
   },
   "externalUrl": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "metadataOnly": {
    "type": "boolean"
   },
   "note": {
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "charEnd": {
       "type": "number"
      },
      "charStart": {
       "type": "number"
      },
      "page": {
       "type": "number"
      }
     },
     "required": [
      "page",
      "charStart",
      "charEnd"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "truncatedAt": {
    "type": "number"
   },
   "unavailable": {
    "additionalProperties": false,
    "properties": {
     "reason": {
      "enum": [
       "no_full_text",
       "paywalled",
       "not_found",
       "too_large",
       "blocked"
      ],
      "type": "string"
     },
     "triedTiers": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "reason",
     "triedTiers"
    ],
    "type": "object"
   },
   "year": {
    "type": "number"
   }
  },
  "required": [
   "title",
   "authors"
  ],
  "type": "object"
 },
 "title": "Read Full Text or Metadata"
}
