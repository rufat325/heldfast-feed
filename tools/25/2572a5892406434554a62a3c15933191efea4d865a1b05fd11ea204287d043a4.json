{
 "description": "Resolve country names or codes to ISO 3166-1 alpha-3 codes such as GHA and KEN.",
 "inputSchema": {
  "properties": {
   "names_or_codes": {
    "items": {
     "type": "string"
    },
    "title": "Names Or Codes",
    "type": "array"
   }
  },
  "required": [
   "names_or_codes"
  ],
  "title": "resolve_geographiesArguments",
  "type": "object"
 },
 "name": "resolve_geographies",
 "outputSchema": {
  "$defs": {
   "ResolvedGeography": {
    "properties": {
     "input": {
      "title": "Input",
      "type": "string"
     },
     "iso3": {
      "title": "Iso3",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     }
    },
    "required": [
     "input",
     "iso3",
     "name"
    ],
    "title": "ResolvedGeography",
    "type": "object"
   },
   "UnresolvedGeography": {
    "properties": {
     "error_code": {
      "const": "UNKNOWN_GEOGRAPHY",
      "default": "UNKNOWN_GEOGRAPHY",
      "title": "Error Code",
      "type": "string"
     },
     "input": {
      "title": "Input",
      "type": "string"
     },
     "message": {
      "title": "Message",
      "type": "string"
     }
    },
    "required": [
     "input",
     "message"
    ],
    "title": "UnresolvedGeography",
    "type": "object"
   }
  },
  "properties": {
   "resolved": {
    "items": {
     "$ref": "#/$defs/ResolvedGeography"
    },
    "title": "Resolved",
    "type": "array"
   },
   "unresolved": {
    "items": {
     "$ref": "#/$defs/UnresolvedGeography"
    },
    "title": "Unresolved",
    "type": "array"
   }
  },
  "title": "GeographyResolutionResponse",
  "type": "object"
 }
}
