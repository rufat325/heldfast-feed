 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Press language metrics"
 },
 "description": "Text length, lexical richness and readability by country/newspaper/year. Metrics are precomputed; readability is French-specific and excludes other languages. Missing values are disclosed. Compare distributions as descriptive evidence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Exact country name (accents optional)",
    "type": "string"
   },
   "date_from": {
    "description": "Inclusive date bounds: YYYY[-MM[-DD]]",
    "type": "string"
   },
   "date_to": {
    "type": "string"
   },
   "exact": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "description": "AND values. Fields: subject/spatial/author/language/country/newspaper/topic_id/min_prob/scored_by; country_raw=whole cell; polarity:<model>.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "group_by": {
    "description": "year (default) | newspaper | country",
    "type": "string"
   },
   "hijri_month": {
    "type": "string"
   },
   "hijri_year": {
    "type": "integer"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "keyword_aliases": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "keyword_mode": {
    "enum": [
     "literal",
     "all_terms"
    ],
    "type": "string"
   },
   "newspaper": {
    "description": "Newspaper/periodical substring",
    "type": "string"
   },
   "subject": {
    "description": "Exact tag",
    "type": "string"
   },
   "top_n": {
    "description": "Groups returned when grouping by newspaper (default 20, max 60)",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_lexical_metrics",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "group_by": {
    "type": "string"
   },
   "groups": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "metrics": {
    "additionalProperties": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "readability_excluded": {
    "type": "number"
   },
   "total_matches": {
    "type": "number"
   },
   "view": {
    "type": "string"
   }
  },
  "required": [
   "view",
   "group_by",
   "filters",
   "total_matches",
   "groups",
   "metrics"
  ],
  "type": "object"
 },
 "title": "Press language metrics"
}
