 },
 "description": "Reconcile two sets of JSON records joined on pointers you nominate. Reports keys present on one side only, keys duplicated on either side, and every value disagreement with its key and pointer. Arrays inside records compare as multisets by default and numbers compare exactly, so reordered lists and reformatted amounts are not false findings. Pay 180000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "compare_pointers": {
    "description": "Restrict comparison to these locations. Omit to compare the whole record.",
    "items": {
     "maxLength": 512,
     "type": "string"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "key_pointers": {
    "description": "Pointers whose values form the join key. A composite key is supported.",
    "example": [
     "/id"
    ],
    "items": {
     "maxLength": 512,
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "left": {
    "example": [
     {
      "id": "o-1",
      "labels": [
       "a",
       "b"
      ],
      "status": "shipped",
      "total": 42.5
     },
     {
      "id": "o-2",
      "labels": [],
      "status": "pending",
      "total": 19.99
     },
     {
      "id": "o-3",
      "labels": [],
      "status": "shipped",
      "total": 7
     }
    ],
    "items": {
     "description": "Any JSON value you supply. Nothing is fetched, so this works on payloads nothing could reach."
    },
    "maxItems": 500,
    "type": "array"
   },
   "right": {
    "example": [
     {
      "id": "o-1",
      "labels": [
       "b",
       "a"
      ],
      "status": "shipped",
      "total": 42.5
     },
     {
      "id": "o-2",
      "labels": [],
      "status": "PENDING",
      "total": 19.99
     },
     {
      "id": "o-4",
      "labels": [],
      "status": "shipped",
      "total": 3
     }
    ],
    "items": {
     "description": "Any JSON value you supply. Nothing is fetched, so this works on payloads nothing could reach."
    },
    "maxItems": 500,
    "type": "array"
   },
   "unordered_arrays": {
    "description": "Compare arrays inside records as multisets. Defaults to true, since element order in a record is rarely meaningful.",
    "type": "boolean"
   }
  },
  "required": [
   "left",
   "right",
   "key_pointers"
  ],
  "type": "object"
 },
 "name": "json_object_reconciliation",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "array_comparison": {
    "enum": [
     "positional",
     "multiset"
    ],
    "type": "string"
   },
   "assumptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "compared_pointers": {
    "items": {
     "type": "string"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "complete": {
    "description": "Whether everything supplied was examined. False means part of the input was not analysed, which is a different problem from input that is wrong.",
    "type": "boolean"
   },
   "duplicated_key_left_count": {
    "type": "integer"
   },
   "duplicated_key_right_count": {
    "type": "integer"
   },
   "finding_count": {
    "description": "The true total, even when the listing below is bounded.",
