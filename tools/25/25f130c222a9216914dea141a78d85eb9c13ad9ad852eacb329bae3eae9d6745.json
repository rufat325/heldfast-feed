      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings_by_code": {
    "description": "Counts per code, for triage without reading the list.",
    "type": "object"
   },
   "key_pointers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "left_keyed_count": {
    "description": "Distinct join keys found, which is lower than the record count when records share a key or lack one.",
    "type": "integer"
   },
   "left_record_count": {
    "type": "integer"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limits": {
    "type": "object"
   },
   "matched_key_count": {
    "type": "integer"
   },
   "not_examined": {
    "description": "Named reasons anything was left unexamined: a bound reached, an unsupported keyword, an unresolvable reference, or findings beyond the listing cap.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "observed_at": {
    "type": "string"
   },
   "only_in_left_count": {
    "type": "integer"
