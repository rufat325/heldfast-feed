   },
   "right_record_count": {
    "type": "integer"
   },
   "service_id": {
    "description": "Canonical service identifier.",
    "type": "string"
   },
   "service_version": {
    "description": "Version of the invoked service.",
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "service_id",
