{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Browse StyleKit's public asset catalogue by namespace and query. Use the returned kind/id pair with stylekit_get_asset.\n\nArgs:\n  - kind (optional): one public namespace such as animation, component-pattern, template, or experience-pack.\n  - query (optional): search public names, descriptions and tags.\n  - offset (number >=0, default 0): results to skip.\n  - limit (number 1-100, default 20): page size.\n\nReturns the full JSON page, including availability, contentLevel, license, attribution, source provenance, and kind counts. An empty page is a successful result. Private user kits and unpublished submissions are not listed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "Public asset namespace",
    "enum": [
     "style",
     "recipe",
     "animation",
     "background",
     "gradient",
     "shadow",
     "typography",
     "palette",
     "component-pattern",
     "spacing",
     "layout-grid",
     "design-principle",
     "visual-hierarchy",
     "type-scale",
     "archetype",
     "prompt",
     "template",
     "experience-pack"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Page size",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Results to skip",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search names, descriptions and tags",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "stylekit_list_assets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attribution": {
       "additionalProperties": false,
       "properties": {
        "author": {
         "type": "string"
        },
        "license": {
         "type": "string"
        },
        "source": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "source"
       ],
       "type": "object"
      },
      "availability": {
       "enum": [
        "bundled",
        "remote",
        "external",
        "restricted"
       ],
       "type": "string"
      },
      "capabilities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "contentLevel": {
       "enum": [
        "source",
        "metadata",
        "remote",
        "restricted"
       ],
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "style",
        "recipe",
        "animation",
        "background",
        "gradient",
        "shadow",
        "typography",
        "palette",
        "component-pattern",
        "spacing",
        "layout-grid",
        "design-principle",
        "visual-hierarchy",
        "type-scale",
        "archetype",
        "prompt",
        "template",
        "experience-pack"
       ],
       "type": "string"
      },
      "license": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "notes": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "nameZh": {
       "type": "string"
      },
      "sourceRef": {
       "type": "string"
      },
      "sourceUrls": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "websiteUrl": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "name",
      "description",
      "tags",
      "availability",
      "contentLevel"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fallbackReason": {
    "type": "string"
   },
   "hasMore": {
    "type": "boolean"
   },
   "kindCounts": {
    "additionalProperties": {
     "type": "number"
    },
    "type": "object"
   },
   "limit": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "schemaVersion": {
    "const": "1",
    "type": "string"
   },
   "source": {
    "enum": [
     "live",
     "bundled"
    ],
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "schemaVersion",
   "assets",
   "total",
   "offset",
   "limit",
   "hasMore",
   "kindCounts",
   "source"
  ],
  "type": "object"
 },
 "title": "List public StyleKit assets"
}
