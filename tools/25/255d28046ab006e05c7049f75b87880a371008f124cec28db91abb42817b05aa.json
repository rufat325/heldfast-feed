{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your tutorial projects"
 },
 "description": "Use this when someone asks which Tutorializer projects they have, or a project's id is needed. Returns each project's id, name, vanity id, domain and created and edited times, sorted by name, 25 per page by default. Not for a project's languages or voice settings.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Projects per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_projects",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "offset": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "projects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "domain": {
       "anyOf": [
        {
         "maxLength": 253,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "vanityId": {
       "anyOf": [
        {
         "maxLength": 63,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "vanityId",
      "domain",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "returned": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "projects",
   "offset",
   "returned",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List your tutorial projects"
}
