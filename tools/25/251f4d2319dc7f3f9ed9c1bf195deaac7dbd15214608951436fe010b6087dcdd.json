{
 "annotations": {},
 "description": "Provision certificates from Certificate Manager into a new Global Edge certificate slot for custom domains",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cipherProfile": {
    "description": "Cipher profile (STRICT not allowed with TLS_ALL_VERSIONS)",
    "enum": [
     "DEFAULT",
     "GENERAL",
     "STRICT"
    ],
    "type": "string"
   },
   "cmCertificateIds": {
    "description": "Certificate Manager certificate numbers",
    "items": {
     "type": "number"
    },
    "minItems": 1,
    "type": "array"
   },
   "serviceRegion": {
    "description": "Service region: KR_JP (one KR/JP certificate) or KR_JP_GLOBAL (one KR/JP + one global certificate)",
    "enum": [
     "KR_JP",
     "KR_JP_GLOBAL"
    ],
    "type": "string"
   },
   "tlsVersion": {
    "description": "Supported TLS versions (TLS_MIN_VERSION_1_2 recommended)",
    "enum": [
     "TLS_ALL_VERSIONS",
     "TLS_MIN_VERSION_1_2"
    ],
    "type": "string"
   }
  },
  "required": [
   "serviceRegion",
   "cmCertificateIds",
   "tlsVersion",
   "cipherProfile"
  ],
  "type": "object"
 },
 "name": "ncloud_edge_provision_certificate"
}
