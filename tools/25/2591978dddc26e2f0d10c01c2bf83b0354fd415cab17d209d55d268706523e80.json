{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Index-linked price adjustment"
 },
 "description": "Recalculate an index-linked contract price: base price and base date plus the indices it follows and their weights (the rest is fixed). Returns the adjusted price, each index's ratio and effect, and the formula. Essential plan (base dates up to 3 months back), Professional (24 months).",
 "inputSchema": {
  "properties": {
   "adjustment_date": {
    "description": "YYYY-MM-DD, default today",
    "type": "string"
   },
   "base_date": {
    "description": "YYYY-MM-DD the base price was agreed",
    "type": "string"
   },
   "base_price": {
    "minimum": 0,
    "type": "number"
   },
   "code": {
    "description": "Shortcut for one index (with weight)",
    "type": "string"
   },
   "components": {
    "description": "e.g. [{'code':'PP','weight':0.6},{'code':'GAS_TTF','weight':0.1}]",
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "weight": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "code",
      "weight"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "currency": {
    "description": "Currency of the contract price (label only)",
    "type": "string"
   },
   "weight": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "base_price",
   "base_date"
  ],
  "type": "object"
 },
 "name": "price_adjustment",
 "title": "Index-linked price adjustment"
}
