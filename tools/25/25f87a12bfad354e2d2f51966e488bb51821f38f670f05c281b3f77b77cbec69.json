{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Configure webhooks for skill lifecycle events (skill.install, skill.publish, etc.). Webhooks are signed with HMAC-SHA256. Requires Enterprise tier (custom_integrations feature).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Webhook operation",
    "enum": [
     "create",
     "list",
     "get",
     "delete",
     "test",
     "rotate_secret"
    ],
    "type": "string"
   },
   "description": {
    "description": "Webhook description",
    "type": "string"
   },
   "events": {
    "description": "Event types (required for create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "description": "Webhook URL (required for create)",
    "type": "string"
   },
   "webhookId": {
    "description": "Webhook ID (required for get/delete/test/rotate_secret)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "webhook_configure",
 "title": "Configure Webhook"
}
