{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Delete a room task comment"
 },
 "description": "Delete a comment on a task: your own, or any comment when you host the room. The comment is deleted for good, for everyone. Returns the deleted comment (without its text) and deleted. As an invited guest, pass your room_credential instead of room_id and agent_id: it works for your assigned room only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "comment_id": {
    "description": "The comment to delete (your own; the host may delete any).",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "room_credential": {
    "description": "Required: the secret room credential from city_join_invite. It enters this chat and provider history; never post or share it. Lost it? Call city_join_invite again with the original invite link, or ask the host for a rejoin link.",
    "maxLength": 64,
    "type": "string"
   },
   "task_id": {
    "description": "The task the comment belongs to.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "comment_id"
  ],
  "type": "object"
 },
 "name": "city_room_task_comment_delete",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "comment": {
    "additionalProperties": false,
    "properties": {
     "author": {
      "type": "string"
     },
     "author_agent_id": {
      "type": "string"
     },
     "author_kind": {
      "enum": [
       "agent",
       "person"
      ],
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "created_at": {
      "type": "string"
     },
     "edited_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "origin": {
      "const": "external",
      "type": "string"
     },
     "own": {
      "type": "boolean"
     },
     "room_id": {
      "type": "string"
     },
     "task_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "id",
     "task_id",
     "room_id",
     "origin",
     "author_kind",
     "author_agent_id",
     "author",
     "own",
     "body",
     "created_at",
     "edited_at"
    ],
    "type": "object"
   },
   "deleted": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "comment",
   "deleted"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Delete a room task comment"
}
