 "description": "Pesquisa fontes externas pelo SearXNG local, consulta URLs HTTPS com prote\u00e7\u00e3o SSRF/robots, extrai texto localmente e devolve proveni\u00eancia e refer\u00eancia cache\u00e1vel. Tamb\u00e9m expande uma ref j\u00e1 adquirida. Exige token de operador com escopo pesquisa:consultar.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "consulta": {
    "description": "consulta externa; use OU consulta OU ref, nunca ambos",
    "type": "string"
   },
   "detalhe_max_bytes": {
    "description": "bytes de texto ao expandir ref, padr\u00e3o 32768, teto 65536",
    "type": "integer"
   },
   "dominios": {
    "description": "filtro p\u00f3s-descoberta por dom\u00ednio DNS, por exemplo planalto.gov.br; subdom\u00ednios leg\u00edtimos s\u00e3o aceitos",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "limite_documentos": {
    "description": "fontes realmente consultadas, padr\u00e3o 2, teto 5",
    "type": "integer"
   },
   "limite_resultados": {
    "description": "candidatos de discovery, padr\u00e3o 10, teto 20",
    "type": "integer"
   },
   "offset": {
    "description": "offset em bytes UTF-8 ao expandir ref",
    "type": "integer"
   },
   "ref": {
    "description": "refer\u00eancia research:sha256:... devolvida por uma consulta anterior",
    "type": "string"
   }
  },
  "type": "object"
 },
