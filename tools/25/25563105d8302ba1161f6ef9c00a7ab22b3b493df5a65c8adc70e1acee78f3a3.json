{
 "_meta": {
  "ui": {
   "resourceUri": "chart://display",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "description": "Display interactive charts with support for multiple chart types: line, bar, area, pie, scatter, and composed charts. Use this to visualize data trends, comparisons, distributions, and relationships. Supports multiple charts in a single view with customizable layouts (vertical, horizontal, grid). Features include legends, tooltips, grid lines, dual Y-axes, and data export (JSON, CSV).",
 "inputSchema": {
  "properties": {
   "charts": {
    "description": "Array of chart configurations to display",
    "items": {
     "properties": {
      "data": {
       "description": "Array of data points for the chart",
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "dataKey": {
       "description": "Key for values (for pie charts)",
       "type": "string"
      },
      "height": {
       "default": 300,
       "description": "Height in pixels",
       "type": "number"
      },
      "nameKey": {
       "description": "Key for labels (for pie charts)",
       "type": "string"
      },
      "series": {
       "description": "Series configurations (for line, bar, area charts)",
       "items": {
        "properties": {
         "color": {
          "description": "Color for the series (hex or CSS color)",
          "type": "string"
         },
         "dataKey": {
          "description": "Key in data objects for this series",
          "type": "string"
         },
         "name": {
          "description": "Display name for the series",
          "type": "string"
         },
         "type": {
          "description": "Type for composed charts",
          "enum": [
           "line",
           "bar",
           "area"
          ],
          "type": "string"
         },
         "yAxisId": {
          "default": "left",
          "description": "Y-axis identifier (left or right)",
          "type": "string"
         }
        },
        "required": [
         "dataKey"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "showGrid": {
       "default": true,
       "description": "Show grid lines",
       "type": "boolean"
      },
      "showLegend": {
       "default": true,
       "description": "Show legend",
       "type": "boolean"
      },
      "showTooltip": {
       "default": true,
       "description": "Show tooltips on hover",
       "type": "boolean"
      },
      "stacked": {
       "default": false,
       "description": "Stack bars/areas (for bar and area charts)",
       "type": "boolean"
      },
      "title": {
       "description": "Title for this chart",
       "type": "string"
      },
      "type": {
       "description": "Type of chart to display",
       "enum": [
        "line",
        "bar",
        "area",
        "pie",
        "scatter",
        "composed"
       ],
       "type": "string"
      },
      "width": {
       "description": "Width in pixels (default: 100%)",
       "type": "number"
      },
      "xAxisKey": {
       "description": "Key for X-axis data (for line, bar, area, scatter charts)",
       "type": "string"
      }
     },
     "required": [
      "type",
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "layout": {
    "default": "vertical",
    "description": "Layout for multiple charts",
    "enum": [
     "vertical",
     "horizontal",
     "grid"
    ],
    "type": "string"
   },
   "title": {
    "description": "Overall title for the chart view",
    "type": "string"
   }
  },
  "required": [
   "charts"
  ],
  "type": "object"
 },
 "name": "display_chart",
 "title": "Display Chart"
}
