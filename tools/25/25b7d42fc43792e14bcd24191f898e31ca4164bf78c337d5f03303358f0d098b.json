{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Log an application"},"description":"Record a role in the candidate's tracker, for example once they confirm they applied on the employer's site. It records the outcome and sends nothing to the employer. Identify the role by job_id, or by company and role (with job_url if you have it). Safe to repeat: an existing row is updated, and it never moves backwards in the funnel. Call this only after the candidate has told you what happened.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"applied_at":{"description":"YYYY-MM-DD, when status is \"applied\".","format":"date","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$","type":"string"},"channel":{"description":"e.g. \"company site\", \"referral\".","maxLength":100,"minLength":1,"type":"string"},"company":{"maxLength":200,"minLength":1,"type":"string"},"interview_round":{"description":"With status \"interview\".","maximum":5,"minimum":1,"type":"integer"},"job_id":{"maxLength":300,"minLength":1,"type":"string"},"job_url":{"format":"uri","maxLength":2000,"type":"string"},"note":{"maxLength":1000,"minLength":1,"type":"string"},"role":{"maxLength":200,"minLength":1,"type":"string"},"status":{"description":"Where the application stands now.","enum":["saved","prepared","applied","referral_sent","oa","interview","offer","rejected"],"type":"string"}},"required":["status"],"type":"object"},"name":"track_application","title":"Log an application"}
