{
 "_meta": {
  "ui": {
   "resourceUri": "ui://vesremont/catalog"
  },
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "",
   "scopes": []
  },
  "vesremont.com/user-confirmation": false
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect one product selected by search_products: current price, aggregate warehouse stock and public characteristics. Use its internal product_id, not the SKU; get_products_batch reads several known IDs. Stock does not promise same-day pickup; unknown values remain null. Public; no OAuth required. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "product_id": {
    "description": "Internal numeric Vesremont product ID returned by catalog search or a product response, not the SKU/article or a basket item ID.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "availability": {
    "enum": [
     "in_stock",
     "backorder",
     "preorder",
     "out_of_stock",
     "unavailable",
     "unknown"
    ]
   },
   "brand": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
       },
       "name": {
        "maxLength": 300,
        "type": "string"
       },
       "url": {
        "anyOf": [
         {
          "format": "uri",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "characteristics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "maxLength": 150,
       "type": "string"
      },
      "value": {
       "maxLength": 300,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "maxLength": 4000,
    "type": "string"
   },
   "gtin": {
    "anyOf": [
     {
      "description": "Barcode from the published catalog field, if present. Not a product ID and not inferred from the name or URL.",
      "pattern": "^(?:[0-9]{8}|[0-9]{12,14})$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "images": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "maxLength": 300,
    "type": "string"
   },
   "orderable": {
    "type": "boolean"
   },
   "price": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "minimum": 0,
        "type": "number"
       },
       "currency": {
        "const": "RUB"
       },
       "discount_percent": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "old_amount": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "amount",
       "currency",
       "old_amount",
       "discount_percent"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "requestable": {
    "type": "boolean"
   },
   "section": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
       },
       "name": {
        "maxLength": 300,
        "type": "string"
       },
       "url": {
        "anyOf": [
         {
          "format": "uri",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "sku": {
    "maxLength": 150,
    "type": "string"
   },
   "stock": {
    "additionalProperties": false,
    "description": "Both fields are the aggregate across the store warehouse network. They do not promise pickup today or a delivery lead time.",
    "properties": {
     "local": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "total": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "local",
     "total"
    ],
    "type": "object"
   },
   "updated_at": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "id",
   "name",
   "url",
   "price",
   "stock",
   "orderable",
   "availability",
   "updated_at"
  ],
  "type": "object"
 }
}
