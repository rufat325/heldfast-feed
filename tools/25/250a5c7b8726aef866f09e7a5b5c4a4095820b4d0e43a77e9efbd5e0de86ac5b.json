{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate signed embedding URL for a dashboard or question",
 "inputSchema": {
  "properties": {
   "bordered": {
    "default": true,
    "description": "Show border around embed",
    "type": "boolean"
   },
   "exp_minutes": {
    "default": 10,
    "description": "Token expiration in minutes",
    "type": "number"
   },
   "params": {
    "description": "Locked parameter values for the embedding",
    "type": "object"
   },
   "preview": {
    "default": false,
    "description": "Include preview-mode frame styles",
    "type": "boolean"
   },
   "resource_id": {
    "description": "ID of the dashboard or question",
    "type": "number"
   },
   "resource_type": {
    "description": "Type of resource to embed",
    "enum": [
     "dashboard",
     "question"
    ],
    "type": "string"
   },
   "theme": {
    "default": "light",
    "description": "Embed theme",
    "enum": [
     "light",
     "night",
     "transparent"
    ],
    "type": "string"
   },
   "titled": {
    "default": true,
    "description": "Show title in embed",
    "type": "boolean"
   }
  },
  "required": [
   "resource_type",
   "resource_id"
  ],
  "type": "object"
 },
 "name": "mb_embed_url_generate",
 "title": "Generate Embed URL"
}
