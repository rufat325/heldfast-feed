{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Test Case"
 },
 "description": "Edit an existing test case (fields are merged \u2014 only what you pass changes). test_steps, when given, REPLACE the case's steps; module_ids append module reference steps. Deleting test cases is not available through this connection.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "automation_status": {
    "description": "Automated, Not Automated or To Be Automated",
    "type": "string"
   },
   "case_id": {
    "description": "Test case ID (ULID)",
    "type": "string"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "estimated_time": {
    "description": "Estimated minutes",
    "type": "number"
   },
   "folder_id": {
    "description": "Move to this folder",
    "type": "string"
   },
   "module_ids": {
    "description": "Existing step Module ids to append as module steps",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "preconditions": {
    "description": "New preconditions",
    "type": "string"
   },
   "priority": {
    "description": "Lowest, Low, Medium, High or Highest",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (ULID)",
    "type": "string"
   },
   "status": {
    "description": "e.g. Live, Archived, Faulty, Ready",
    "type": "string"
   },
   "tags": {
    "description": "Replace tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "test_steps": {
    "description": "Replacement steps (omit to keep current steps)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "description": "What to do",
       "type": "string"
      },
      "description": {
       "description": "Optional extra detail \u2014 stored as an additional paragraph of the step text",
       "type": "string"
      },
      "outcome": {
       "description": "Expected result",
       "type": "string"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "New title",
    "type": "string"
   },
   "type": {
    "description": "Test type",
    "type": "string"
   }
  },
  "required": [
   "case_id",
   "project_id"
  ],
  "type": "object"
 },
 "name": "tm_update_test_case",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Update Test Case"
}
