      "order_id": "o-5",
      "schema_version": "1",
      "stream": "orders-0",
      "total": "12.00",
      "type": "order.created"
     },
     {
      "event_id": "evt-6",
      "offset": 1,
      "order_id": "o-1",
      "reason": "customer",
      "schema_version": "2",
      "stream": "orders-1",
      "type": "order.cancelled"
     },
     {
      "offset": 2,
      "order_id": "o-2",
      "reason": "fraud",
      "schema_version": "2",
      "stream": "orders-1",
      "type": "order.cancelled"
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "schemas": {
    "description": "Map of event type to a JSON Schema, at most 100 types. Each is compiled once rather than once per event.",
    "example": {
     "order.cancelled": {
      "properties": {
       "event_id": {
        "type": "string"
       },
       "offset": {
