{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Report a detected anomaly \u2014 protocol failure, evidence mismatch, stuck job, or suspicious behavior. All agents on the network are notified.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Anomaly category",
    "enum": [
     "protocol_failure",
     "evidence_mismatch",
     "consensus_failure",
     "timeout",
     "rate_anomaly",
     "trust_violation"
    ],
    "type": "string"
   },
   "description": {
    "description": "Human-readable description of what went wrong",
    "type": "string"
   },
   "jobId": {
    "description": "Related job ID (optional)",
    "type": "string"
   },
   "severity": {
    "description": "Anomaly severity",
    "enum": [
     "info",
     "warning",
     "critical"
    ],
    "type": "string"
   },
   "targetAgentId": {
    "description": "Agent or kernel ID being reported (optional)",
    "type": "string"
   }
  },
  "required": [
   "severity",
   "category",
   "description"
  ],
  "type": "object"
 },
 "name": "report_anomaly"
}
