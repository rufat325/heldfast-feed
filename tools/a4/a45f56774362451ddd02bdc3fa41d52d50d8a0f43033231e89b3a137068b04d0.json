{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\ub178\uc0ac\ud611\uc758\ud68c \ud68c\uc758 \ud558\ub098\uc758 \uc11c\ub958\ub97c outDir \uc5d0 PDF\u00b7\ud55c\uae00(hwpx)\ub85c \ub9cc\ub4e0\ub2e4. kind \ub85c \uace0\ub978\ub2e4: notice = \uc18c\uc9d1 \ud1b5\ubcf4\uc11c(\ubc1b\ub294 \uc704\uc6d0\uc744 \uc8fc\uba74 \uc704\uc6d0\ub9c8\ub2e4 \ud55c \uc7a5)\u00b7\uc18c\uc9d1 \uacf5\uace0 \u00b7 materials = \ud68c\uc758\uc790\ub8cc(\uc548\uac74 \ubaa9\ub85d, \uc815\uae30\ud68c\uc758 \ubcf4\uace0\uc0ac\ud56d 4\uac1c \uce78, \uc548\uac74\ubcc4 \ubc30\uacbd\u00b7\ud604\ud669\u00b7\ub178\uc0ac \uc81c\uc548\u00b7\uc7c1\uc810\u00b7\uc694\uccad \uacb0\uc815, \uc804\ubd84\uae30 \uc758\uacb0 \uc774\ud589 \uc810\uac80\ud45c) \u00b7 minutes = \ud68c\uc758\ub85d(\uc2dc\ud589\uaddc\uce59 \ubcc4\uc9c0 \uc81c3\ud638\uc11c\uc2dd \uce78 7\uac1c \uadf8\ub300\ub85c + \ucc38\uc11d\uc704\uc6d0 \uc11c\uba85 \uce78)\uacfc \uc0c1\uc138 \ud68c\uc758\ub85d, \uadf8\ub9ac\uace0 \uac19\uc740 \uc774\ub984\uc758 .json(\uc548\uac74 ID\u00b7\uad6c\ubd84\u00b7\ubc95\uc870\ubb38 \ubd84\ub958\u00b7\uc81c\uc548 \uce21\u00b7\uacb0\uacfc\u00b7\uc774\uc6d4\uc744 \ub2f4\uc740 \uad6c\uc870\ud654 \uc6d0\ubcf8) \u00b7 resolution = \uc758\uacb0\uc0ac\ud56d \uacf5\uc9c0. \uc815\uc871\uc218\u00b7\uc758\uacb0 \ubb38\uc7a5\uc740 \ucd9c\uc11d\u00b7\ucc2c\uc131 \uc218\ub85c \ub123\ub294\ub2e4(\uc815\uc6d0 \uae30\uc900 \uac01 \uacfc\ubc18 \ucd9c\uc11d, \ucd9c\uc11d 3\ubd84\uc758 2 \ucc2c\uc131 \u2014 \ubabb \ubbf8\uce58\uba74 \u300c\uc758\uacb0\ub418\uc9c0 \uc54a\uc74c\u300d). \ud1b5\ubcf4\uc77c\uc774 \uae30\ud55c(\uac1c\ucd5c\uc77c \u2212 8\uc77c)\ubcf4\ub2e4 \ub2a6\uc73c\uba74 \uc18c\uc9d1 \ud1b5\ubcf4\uc11c\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \ud68c\uc758\uac00 \uc131\ub9bd\ud558\uc9c0 \uc54a\uc544\ub3c4 \ud68c\uc758\ub85d\uc740 \ub9cc\ub4e4\uace0 \uc54c\ub9b0\ub2e4. \uc548\uac74 \uc124\uba85\u00b7\ubc1c\uc5b8 \uc694\uc9c0\u00b7\uc758\uacb0 \ub0b4\uc6a9\uc740 \uc785\ub825\uc73c\ub85c \ubc1b\uc740 \uac83\ub9cc \uc2e3\ub294\ub2e4. \uc774\ub984\uc740 \ub123\uc744 \ub54c\ub9cc \uc2e3\uace0 \uc11c\uba85 \uce78\uc740 \ube44\uc6cc \ub454\ub2e4. \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638 \uce78\uc740 \uc5c6\ub2e4. \uc774\ubbf8 \uc788\ub294 \ud30c\uc77c\uc740 \ub36e\uc5b4\uc4f0\uc9c0 \uc54a\ub294\ub2e4. \uc77c\ubc18 \uae30\uc900\uc744 \uc815\ub9ac\ud55c \uc11c\uc2dd\uc774\uba70 \ud611\uc758\ud68c\uaddc\uc815\uc774 \ub2e4\ub974\uba74 \uace0\uccd0 \uc4f4\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"agenda":{"description":"\uc548\uac74 \uc21c\uc11c\ub300\ub85c","items":{"additionalProperties":false,"properties":{"article":{"description":"\ubc95\uc870\ubb38 \ubd84\ub958 \u2014 20-1~20-17(\ubc95 \uc81c20\uc870\uc81c1\ud56d \uac01 \ud638), 21-1~21-5(\ubc95 \uc81c21\uc870 \uac01 \ud638), 22-1~22-4(\ubc95 \uc81c22\uc870\uc81c1\ud56d \uac01 \ud638)","enum":["20-1","20-2","20-3","20-4","20-5","20-6","20-7","20-8","20-9","20-10","20-11","20-12","20-13","20-14","20-15","20-16","20-17","21-1","21-2","21-3","21-4","21-5","22-1","22-2","22-3","22-4"],"type":"string"},"background":{"description":"\ubc30\uacbd","maxLength":2000,"type":"string"},"carriedOver":{"description":"\uc55e\uc120 \ud68c\uc758\uc5d0\uc11c \ub118\uc5b4\uc628 \uc548\uac74","type":"boolean"},"decision":{"description":"\uc758\uacb0\ub41c \ub0b4\uc6a9","maxLength":1000,"type":"string"},"discussion":{"description":"\ubc1c\uc5b8 \uc694\uc9c0(\uc0c1\uc138 \ud68c\uc758\ub85d)","items":{"additionalProperties":false,"properties":{"name":{"description":"\uc2e4\uba85 \u2014 \uc0ac\uc6a9\uc790\uac00 \ub123\uc744 \ub54c\ub9cc \uc2e3\ub294\ub2e4","maxLength":30,"type":"string"},"position":{"description":"\uc9c1\uc704(\uc608: \uc0dd\uc0b01\ud300 \ub300\ud45c, \uc778\uc0ac\ud300\uc7a5)","maxLength":40,"type":"string"},"side":{"enum":["\uadfc\ub85c\uc790\uc704\uc6