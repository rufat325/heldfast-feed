{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read. Recommend newCardsPerDay from a deadline: ceil(remaining new cards / study days). Does not write. Send remainingNewCards, totalCards, or deckId. There is no silent default of 20.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "alreadyLearned": {
    "minimum": 0,
    "type": "integer"
   },
   "asOf": {
    "description": "UTC ISO-8601 timestamp ending in Z",
    "type": "string"
   },
   "bufferStudyDays": {
    "maximum": 3650,
    "minimum": 0,
    "type": "integer"
   },
   "currentNewCardsPerDay": {
    "maximum": 9999,
    "minimum": 0,
    "type": "integer"
   },
   "dayBoundaryHour": {
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "deadline": {
    "description": "YYYY-MM-DD or a UTC ISO-8601 timestamp ending in Z.",
    "type": "string"
   },
   "deckId": {
    "format": "uuid",
    "type": "string"
   },
   "remainingNewCards": {
    "minimum": 0,
    "type": "integer"
   },
   "skipWeekends": {
    "type": "boolean"
   },
   "studyDaysPerWeek": {
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   },
   "timezone": {
    "description": "IANA timezone such as UTC or America/Denver.",
    "type": "string"
   },
   "totalCards": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "deadline"
  ],
  "type": "object"
 },
 "name": "previewDeadlinePlan",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Preview deadline plan"
}
