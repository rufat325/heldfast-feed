{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit materials for a safe retry"
 },
 "description": "Opens a new editable material revision only after the API establishes that a failed application cannot still submit. Access is restricted to the Applications rollout cohort admitted by the API.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicationId": {
    "description": "Failed application ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "reopen_application_materials",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "The persisted material revision returned after an edit.",
  "properties": {
   "materials": {
    "additionalProperties": false,
    "description": "Revisioned, per-application material selection. Revision zero is the legacy fallback view; an Apply confirmation must persist a positive revision.",
    "properties": {
     "coverLetter": {
      "type": "string"
     },
     "coverLetterIncluded": {
      "type": "boolean"
     },
     "defaultResume": {
      "additionalProperties": false,
      "description": "Editable resume source and its matching rendered PDF. Both are scoped to one application.",
      "properties": {
       "html": {
        "type": "string"
       },
       "pdfBase64": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "html",
       "pdfBase64"
      ],
      "type": "object"
     },
     "locked": {
      "type": "boolean"
     },
     "resumeVariant": {
      "description": "The job-owned resume version selected for this application.",
      "enum": [
       "default",
       "tailored"
      ],
      "type": "string"
     },
     "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "tailoredResume": {
      "anyOf": [
       {
        "additionalProperties": false,
        "description": "Editable resume source and its matching rendered PDF. Both are scoped to one application.",
        "properties": {
         "html": {
          "type": "string"
         },
         "pdfBase64": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "html",
         "pdfBase64"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "revision",
     "resumeVariant",
     "coverLetter",
     "coverLetterIncluded",
     "locked",
     "defaultResume",
     "tailoredResume"
    ],
    "type": "object"
   }
  },
  "required": [
   "materials"
  ],
  "type": "object"
 },
 "title": "Edit materials for a safe retry"
}
