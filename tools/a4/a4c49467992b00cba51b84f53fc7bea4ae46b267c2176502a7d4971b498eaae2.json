{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List an anime's episodes (by mal_id) with titles, air dates and filler/recap flags. Paginated (~100 per page); use `page` for long-running series. Get the mal_id from search_anime.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "MyAnimeList numeric ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_anime_episodes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "episodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "aired": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "duration": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "filler": {
       "type": "boolean"
      },
      "image_url": {
       "type": "string"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "recap": {
       "type": "boolean"
      },
      "replies": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "score": {
       "type": "number"
      },
      "synopsis": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "title_japanese": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "episodes",
   "page"
  ],
  "type": "object"
 },
 "title": "Get anime episodes"
}
