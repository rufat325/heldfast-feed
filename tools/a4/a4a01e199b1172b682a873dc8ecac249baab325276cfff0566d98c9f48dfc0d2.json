{
 "description": "Update an existing geo target",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "areas": {
    "description": "Array of geographic areas",
    "items": {
     "additionalProperties": false,
     "properties": {
      "city": {
       "description": "City name",
       "type": "string"
      },
      "continent": {
       "description": "Continent name",
       "type": "string"
      },
      "country": {
       "description": "Two-letter country code",
       "type": "string"
      },
      "region": {
       "description": "Region/state",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "Geo target ID",
    "type": "number"
   },
   "inclusive": {
    "description": "If true, target users IN these areas; if false, EXCLUDE",
    "type": "boolean"
   },
   "name": {
    "description": "Geo target name",
    "type": "string"
   },
   "range": {
    "description": "Radius range",
    "type": "number"
   },
   "unit": {
    "description": "Distance unit",
    "enum": [
     "miles",
     "kilometers"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_geo_target"
}
