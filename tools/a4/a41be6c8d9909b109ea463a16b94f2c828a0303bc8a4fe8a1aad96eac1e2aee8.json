{
 "description": "Publish a generated Tableau workbook to Tableau Cloud or Tableau Server via REST API.",
 "inputSchema": {
  "properties": {
   "pat_name": {
    "description": "Personal Access Token name.",
    "type": "string"
   },
   "pat_secret": {
    "description": "Personal Access Token secret.",
    "type": "string"
   },
   "project_name": {
    "description": "Target project name on the Tableau site.",
    "type": "string"
   },
   "server_url": {
    "description": "Tableau Cloud/Server URL (e.g. 'https://prod-apnortheast-a.online.tableau.com').",
    "type": "string"
   },
   "site_id": {
    "description": "Tableau site ID (content URL).",
    "type": "string"
   },
   "workbook_path": {
    "description": "Absolute path to the .twbx file to publish.",
    "type": "string"
   }
  },
  "required": [
   "workbook_path",
   "server_url",
   "site_id",
   "project_name",
   "pat_name",
   "pat_secret"
  ],
  "type": "object"
 },
 "name": "publish_to_cloud"
}
