{
 "description": "Render one frame of a .riv animation or state machine to PNG. Returns the image inline and saves it to disk.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "animation": {
    "description": "Linear animation name",
    "type": "string"
   },
   "artboard": {
    "description": "Artboard name (default: first)",
    "type": "string"
   },
   "background": {
    "description": "CSS background color (default: transparent)",
    "type": "string"
   },
   "height": {
    "exclusiveMinimum": 0,
    "maximum": 4096,
    "type": "integer"
   },
   "outPath": {
    "description": "Output PNG path (default: alongside the .riv)",
    "type": "string"
   },
   "path": {
    "description": "Path to the .riv file",
    "type": "string"
   },
   "stateMachine": {
    "description": "State machine name (takes precedence)",
    "type": "string"
   },
   "time": {
    "description": "Seconds to advance before capturing (default 0)",
    "type": "number"
   },
   "width": {
    "exclusiveMinimum": 0,
    "maximum": 4096,
    "type": "integer"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "riv_render_frame",
 "title": "Render a single frame to PNG"
}
