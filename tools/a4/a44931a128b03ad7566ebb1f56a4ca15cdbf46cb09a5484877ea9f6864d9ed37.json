{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "[INSPECT] Read-only.\nSearch objects by type, material, visibility, name pattern, or custom property.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "hasGeometry": {
    "description": "Objects with/without geometry",
    "type": "boolean"
   },
   "limit": {
    "description": "Max results (default: 50, max: 200)",
    "type": "number"
   },
   "material": {
    "description": "Material name or type",
    "type": "string"
   },
   "minChildren": {
    "description": "Minimum number of children",
    "type": "number"
   },
   "namePattern": {
    "description": "Regex to match object names",
    "type": "string"
   },
   "property": {
    "description": "Custom property name to check",
    "type": "string"
   },
   "type": {
    "description": "Object type: Mesh, Group, InstancedMesh, Light, etc.",
    "type": "string"
   },
   "value": {
    "description": "Expected value of the custom property",
    "type": [
     "string",
     "number",
     "boolean"
    ]
   },
   "visible": {
    "description": "Filter by visibility",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "find_objects"
}
