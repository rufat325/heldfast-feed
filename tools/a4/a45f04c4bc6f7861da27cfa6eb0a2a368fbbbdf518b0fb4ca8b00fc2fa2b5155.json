{
 "description": "Search training sources and pairs by keyword or domain.\n\nExample: training_search({ query: \"CRM contacts\", table: \"pairs\" })\nExample: training_search({ domain: \"crm\", min_quality: 0.8 })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Filter by domain",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default: 20)",
    "type": "number"
   },
   "min_quality": {
    "description": "Minimum quality score",
    "type": "number"
   },
   "query": {
    "description": "Search keyword",
    "type": "string"
   },
   "table": {
    "description": "Which table to search (default: both)",
    "enum": [
     "sources",
     "pairs",
     "both"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "training_search"
}
