{
 "description": "Calculate MW, LHV and HHV of fuel gas from composition",
 "inputSchema": {
  "properties": {
   "HC": {
    "description": "List of fuel component formula strings, e.g. ['CH4', 'C2H6', 'H2', 'N2']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "HHV_unit": {
    "default": "Btu/lb",
    "description": "HHV output unit",
    "enum": [
     "Btu/lb",
     "Btu/lbm",
     "J/g",
     "J/kg",
     "cal/g",
     "cal/kg",
     "kJ/g",
     "kJ/kg",
     "kcal/g",
     "kcal/kg"
    ],
    "type": "string"
   },
   "LHV_unit": {
    "default": "Btu/lb",
    "description": "LHV output unit",
    "enum": [
     "Btu/lb",
     "Btu/lbm",
     "J/g",
     "J/kg",
     "cal/g",
     "cal/kg",
     "kJ/g",
     "kJ/kg",
     "kcal/g",
     "kcal/kg"
    ],
    "type": "string"
   },
   "MW_unit": {
    "default": "g/mol",
    "description": "MW output unit",
    "enum": [
     "g/gmol",
     "g/mol",
     "kg/kgmol",
     "kg/kmol",
     "lb/lbmol",
     "lb/mol"
    ],
    "type": "string"
   },
   "mole": {
    "description": "Mole fraction list corresponding to HC, e.g. [0.90, 0.05, 0.03, 0.02]",
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "HC",
   "mole"
  ],
  "type": "object"
 },
 "name": "FUELGAS"
}
