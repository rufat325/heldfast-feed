{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Generate Image"
 },
 "description": "Generate an AI image via kie.ai and return its public R2 URL. Use to mint reusable URLs for content blocks (image, gallery), product photos, or any field that takes an image URL \u2014 does NOT attach to a post by itself. Costs credits (see list_image_models). On poll timeout the job continues running; pass `jobId` from the response to merchant ai-media APIs to retrieve it later.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspectRatio": {
    "description": "Output aspect ratio (e.g. 16:9, 1:1)",
    "maxLength": 20,
    "type": "string"
   },
   "modelCode": {
    "description": "Image model code from list_image_models",
    "type": "string"
   },
   "negativePrompt": {
    "description": "Things to exclude from generation",
    "maxLength": 2000,
    "type": "string"
   },
   "pollIntervalMs": {
    "description": "Default 3000.",
    "maximum": 15000,
    "minimum": 1000,
    "type": "integer"
   },
   "pollTimeoutMs": {
    "description": "Default 60000.",
    "maximum": 120000,
    "minimum": 5000,
    "type": "integer"
   },
   "prompt": {
    "description": "Generation prompt",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "seed": {
    "description": "Random seed for reproducible output",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "prompt",
   "modelCode"
  ],
  "type": "object"
 },
 "name": "generate_image",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
