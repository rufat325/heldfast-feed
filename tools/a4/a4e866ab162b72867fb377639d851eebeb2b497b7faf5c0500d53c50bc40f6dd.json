{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search book titles"
 },
 "description": "Search the list of all books in the library by (part of) an English or Hebrew title, optionally within a category path. Returns canonical titles with their category.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category_path": {
    "description": "Limit to a category, e.g. \"Talmud/Bavli\".",
    "type": "string"
   },
   "contains": {
    "description": "Substring to match, e.g. \"Rashi\", \"Mishneh Torah\", \"\u05ea\u05d4\u05dc\u05d9\u05dd\".",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_book_titles",
 "title": "Search book titles"
}
