{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "files:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Set metadata"
 },
 "description": "Set or delete queryable tags on an existing file. `set` wins over `delete` for the same key. Requires `set` and/or `delete`. Same as `uploads meta set`.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "key": "screenshots/settings.png",
    "set": {
     "path": "/settings",
     "state": "after"
    }
   }
  ],
  "properties": {
   "delete": {
    "description": "Keys to remove.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key": {
    "description": "Object key to update.",
    "type": "string"
   },
   "set": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Keys to set or overwrite. Use `path` for the route (e.g. /settings), not route/page/screen.",
    "type": "object"
   },
   "workspace": {
    "description": "Override the workspace for this call (like the CLI's --workspace flag).",
    "type": "string"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 },
 "name": "set_metadata",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "metadata"
  ],
  "type": "object"
 },
 "title": "Set metadata"
}
