{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Send orders to a paper exchange"},"description":"Send an agent's limit orders, market orders and cancels for the coming step of a paper exchange. An empty list passes.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"agent":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{1,39}$","type":"string"},"exchange_file":{"maxLength":1000,"minLength":1,"pattern":"^[^\\0]+$","type":"string"},"orders":{"description":"What to do in the coming step. An empty list says you are passing, so the step can close.","items":{"oneOf":[{"additionalProperties":false,"properties":{"asset":{"pattern":"^ART[0-9]{1,2}$","type":"string"},"price":{"exclusiveMinimum":0,"maximum":10000000,"type":"number"},"quantity":{"exclusiveMinimum":0,"maximum":10000000,"type":"integer"},"side":{"enum":["buy","sell"],"type":"string"},"type":{"const":"limit","type":"string"}},"required":["type","asset","side","quantity","price"],"type":"object"},{"additionalProperties":false,"properties":{"asset":{"pattern":"^ART[0-9]{1,2}$","type":"string"},"quantity":{"exclusiveMinimum":0,"maximum":10000000,"type":"integer"},"side":{"enum":["buy","sell"],"type":"string"},"type":{"const":"market","type":"string"}},"required":["type","asset","side","quantity"],"type":"object"},{"additionalProperties":false,"properties":{"order_id":{"description":"Without it, all your resting orders go.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"type":{"const":"cancel","type":"string"}},"required":["type"],"type":"object"}]},"maxItems":50,"type":"array"},"token":{"description":"The token exchange_join gave this agent, so no agent can act as another.","maxLength":80,"minLength":16,"type":"string"}},"required":["exchange_file","agent","token","orders"],"type":"object"},"name":"exchange_orders","title":"Send orders to a paper exchange"}
