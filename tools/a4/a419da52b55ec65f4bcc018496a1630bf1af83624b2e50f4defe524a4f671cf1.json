{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Decompile one analyzed procedure by symbol name or provider-normalized address. Returns provider-specific pseudocode, never original source or cross-provider text equivalence, and may return null; request procedure_assembly when instruction precision matters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "procedure": "main"
   }
  ],
  "properties": {
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "procedure": {
    "description": "The procedure name or address",
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "procedure"
  ],
  "type": "object"
 },
 "name": "procedure_pseudo_code",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Procedure Pseudo Code"
}
