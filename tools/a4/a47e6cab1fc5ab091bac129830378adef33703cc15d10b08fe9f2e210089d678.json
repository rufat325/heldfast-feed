{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search runs with filter expression and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "experimentIds": {
    "description": "Experiment IDs (defaults to MLFLOW_EXPERIMENT_ID)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "extractFields": {
    "description": "Comma-separated dotted paths with `*` wildcard (e.g. 'runs.*.info.run_id'). Reduces response tokens.",
    "type": "string"
   },
   "filter": {
    "description": "Filter expression, e.g. \"metrics.rmse < 1\"",
    "type": "string"
   },
   "maxResults": {
    "default": 100,
    "description": "Max results (default 100)",
    "type": "number"
   },
   "orderBy": {
    "description": "Sort fields, e.g. ['metrics.rmse ASC']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageToken": {
    "type": "string"
   },
   "runViewType": {
    "enum": [
     "ACTIVE_ONLY",
     "DELETED_ONLY",
     "ALL"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-runs"
}
