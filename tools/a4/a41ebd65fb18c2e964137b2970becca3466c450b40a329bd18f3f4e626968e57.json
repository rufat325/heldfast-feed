{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a Studocu project and optionally configure its emoji and course. A numeric course_id is validated before project creation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "course_id": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "emoji": {
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 255,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create-project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "course_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "emoji": {
    "minLength": 1,
    "type": "string"
   },
   "institution_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "is_mobile": {
    "type": "boolean"
   },
   "project_id": {
    "description": "NOTE: These shared primitives are copied from the AI API spec and owned\nlocally by Agent OS to keep this contract decoupled.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "title": {
    "description": "Agent-displayable project title. Null Alpha names become \"Untitled project\".",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "title",
   "is_mobile",
   "emoji",
   "course_id",
   "institution_id"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create Studocu Project"
}
