{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Export a list as CSV"
 },
 "description": "Requires a Pro plan. Writes a CSV to your workspace's exports and returns a download link that works for 24 hours without signing in. Sources: `edition_exhibitors` (an edition's exhibitors, 1,000 rows per part; pass `next_cursor` back as `cursor` for the next part), `edition_sponsors` (up to 200), `prospects` (the find_prospects arguments, up to 1,000 companies), and `reveals` (Team plan and up: the people your workspace revealed, with the email and phone it revealed, 500 per part; not offered when the workspace keeps contacts out of AI conversations). Rows count against your plan's daily export allowance; the answer shows what is left. Needs the 'atlas.reveal' permission and a personal connection.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "`next_cursor` from the previous part (edition_exhibitors, reveals).",
    "maxLength": 1200,
    "type": "string"
   },
   "edition_id": {
    "description": "Edition uuid from get_event (edition_exhibitors, edition_sponsors).",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "prospects": {
    "additionalProperties": false,
    "description": "The find_prospects arguments (source prospects).",
    "properties": {
     "country": {
      "description": "ISO-3166 alpha-2 (TH, DE, JP \u2026).",
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     "exclude": {
      "items": {
       "additionalProperties": false,
       "description": "Either `event` (+ optional `years`) or `edition_id`.",
       "properties": {
        "edition_id": {
         "description": "Edition uuid from get_event.",
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "event": {
         "description": "Event slug or uuid from search_events.",
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "years": {
         "description": "Edition years of that event.",
         "items": {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
         },
         "maxItems": 5,
         "minItems": 1,
         "type": "array"
        }
       },
       "type": "object"
      },
      "maxItems": 5,
      "type": "array"
     },
     "include": {
      "items": {
       "additionalProperties": false,
       "description": "Either `event` (+ optional `years`) or `edition_id`.",
       "properties": {
        "edition_id": {
         "description": "Edition uuid from get_event.",
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "event": {
         "description": "Event slug or uuid from search_events.",
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "years": {
         "description": "Edition years of that event.",
         "items": {
          "maximum": 2100,
          "minimum": 1900,
          "type": "integer"
         },
         "maxItems": 5,
         "minItems": 1,
         "type": "array"
        }
       },
       "type": "object"
      },
      "maxItems": 5,
      "minItems": 1,
      "type": "array"
     },
     "role": {
      "default": "any",
      "enum": [
       "exhibitor",
       "any"
      ],
      "type": "string"
     }
    },
    "required": [
     "include"
    ],
    "type": "object"
   },
   "source": {
    "description": "What to export.",
    "enum": [
     "edition_exhibitors",
     "edition_sponsors",
     "prospects",
     "reveals"
    ],
    "type": "string"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "name": "export_list",
 "title": "Export a list as CSV"
}
