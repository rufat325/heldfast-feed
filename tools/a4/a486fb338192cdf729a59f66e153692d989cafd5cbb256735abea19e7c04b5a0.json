{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create contract"
 },
 "description": "Create a new contract. Requires contracts:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "annual_cost": {
    "description": "Annual cost",
    "minimum": 0,
    "type": "number"
   },
   "category": {
    "description": "Contract category (required)",
    "maxLength": 200,
    "type": "string"
   },
   "company_id": {
    "description": "Vendor ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "end_date": {
    "description": "End date (ISO 8601, required)",
    "type": "string"
   },
   "extendable": {
    "description": "Whether contract is extendable",
    "type": "boolean"
   },
   "purchase_order": {
    "description": "Purchase order reference",
    "maxLength": 200,
    "type": "string"
   },
   "quality_score": {
    "description": "Quality score (1-10)",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "start_date": {
    "description": "Start date (ISO 8601, required)",
    "type": "string"
   },
   "title": {
    "description": "Contract title (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "category",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "create_contract",
 "title": "Create contract"
}
