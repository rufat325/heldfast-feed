{
 "description": "Intercept and block/modify network requests",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to take",
    "enum": [
     "block",
     "modify"
    ],
    "type": "string"
   },
   "modifyResponse": {
    "description": "Response modifications (for action=\"modify\")",
    "properties": {
     "body": {
      "type": "string"
     },
     "headers": {
      "type": "object"
     },
     "status": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "pageId": {
    "description": "Page ID (uses active page if not specified)",
    "type": "string"
   },
   "urlPattern": {
    "description": "URL pattern to intercept (glob)",
    "type": "string"
   }
  },
  "required": [
   "urlPattern",
   "action"
  ],
  "type": "object"
 },
 "name": "intercept_network"
}
