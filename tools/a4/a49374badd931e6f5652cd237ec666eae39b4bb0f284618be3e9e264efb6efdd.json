{
 "description": "Get random entities from an RPG system for inspiration or encounter prep",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category to draw from (omit for any)",
    "type": "string"
   },
   "count": {
    "description": "Number of random picks 1-10 (default: 1)",
    "type": "number"
   },
   "game": {
    "description": "Game system slug",
    "type": "string"
   },
   "system": {
    "description": "Alias for game",
    "type": "string"
   }
  },
  "required": [
   "game"
  ],
  "type": "object"
 },
 "name": "rpg_random"
}
