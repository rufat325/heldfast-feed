{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Fetch generated read-only platform adapter content, currently Cursor rule adapters for skill packages.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "platform": {
    "description": "Target platform for the adapter (defaults to 'cursor').",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Slug of the skill to generate a platform adapter for.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "install.adapter",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "ok": {
    "type": "boolean"
   },
   "policy": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
