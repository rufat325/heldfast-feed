{
 "description": "Export OpenSCAD (SCAD) source code into an STL and return it as an embedded resource blob.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filename": {
    "description": "The name of the output STL file",
    "type": "string"
   },
   "scadCode": {
    "description": "The OpenSCAD code to render",
    "type": "string"
   }
  },
  "required": [
   "scadCode"
  ],
  "type": "object"
 },
 "name": "export_scad_stl",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "annotations": {
    "additionalProperties": false,
    "properties": {
     "audience": {
      "items": {
       "enum": [
        "user",
        "assistant"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "lastModified": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "priority": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "resource": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "_meta": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "mimeType": {
        "type": "string"
       },
       "text": {
        "type": "string"
       },
       "uri": {
        "type": "string"
       }
      },
      "required": [
       "uri",
       "text"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "_meta": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "blob": {
        "type": "string"
       },
       "mimeType": {
        "type": "string"
       },
       "uri": {
        "type": "string"
       }
      },
      "required": [
       "uri",
       "blob"
      ],
      "type": "object"
     }
    ]
   },
   "type": {
    "const": "resource",
    "type": "string"
   }
  },
  "required": [
   "type",
   "resource"
  ],
  "type": "object"
 },
 "title": "Export OpenSCAD source to an STL"
}
