{
 "description": "Create a waybill for delivery TO a recipient postomat via InternetDocument/save, using ServiceType DoorsPostomat or WarehousePostomat. OptionsSeat uses lower camel case fields such as weight and volumetricWidth.",
 "inputSchema": {
  "properties": {
   "request": {
    "description": "Nova Poshta payload for delivery to a recipient postomat. RecipientAddress must reference the recipient postomat.",
    "properties": {
     "CargoType": {
      "enum": [
       "Parcel",
       "Documents"
      ],
      "type": "string"
     },
     "CityRecipient": {
      "description": "Recipient city reference.",
      "minLength": 1,
      "type": "string"
     },
     "CitySender": {
      "description": "Sender city reference.",
      "minLength": 1,
      "type": "string"
     },
     "ContactRecipient": {
      "description": "Recipient contact reference.",
      "minLength": 1,
      "type": "string"
     },
     "ContactSender": {
      "description": "Sender contact reference.",
      "minLength": 1,
      "type": "string"
     },
     "Cost": {
      "description": "Declared value in UAH (maximum 10,000).",
      "maximum": 10000,
      "minimum": 0,
      "type": "number"
     },
     "DateTime": {
      "description": "Shipping date (dd.mm.yyyy).",
      "pattern": "^\\d{2}\\.\\d{2}\\.\\d{4}$",
      "type": "string"
     },
     "Description": {
      "maxLength": 36,
      "minLength": 1,
      "type": "string"
     },
     "OptionsSeat": {
      "description": "Cargo dimensions for every seat; required for postomat delivery.",
      "items": {
       "properties": {
        "cost": {
         "maximum": 10000,
         "minimum": 0,
         "type": "number"
        },
        "description": {
         "maxLength": 36,
         "minLength": 1,
         "type": "string"
        },
        "packRef": {
         "minLength": 1,
         "type": "string"
        },
        "specialCargo": {
         "enum": [
          "0",
          "1"
         ],
         "type": "string"
        },
        "volumetricHeight": {
         "exclusiveMinimum": 0,
         "maximum": 30,
         "type": "number"
        },
        "volumetricLength": {
         "exclusiveMinimum": 0,
         "maximum": 60,
         "type": "number"
        },
        "volumetricVolume": {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        "volumetricWidth": {
         "exclusiveMinimum": 0,
         "maximum": 40,
         "type": "number"
        },
        "weight": {
         "exclusiveMinimum": 0,
         "maximum": 20,
         "type": "number"
        }
       },
       "required": [
        "weight",
        "volumetricWidth",
        "volumetricLength",
        "volumetricHeight"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "PayerType": {
      "enum": [
       "Sender",
       "Recipient",
       "ThirdPerson"
      ],
      "type": "string"
     },
     "PaymentMethod": {
      "enum": [
       "Cash",
       "NonCash"
      ],
      "type": "string"
     },
     "Recipient": {
      "description": "Recipient counterparty reference.",
      "minLength": 1,
      "type": "string"
     },
     "RecipientAddress": {
      "description": "Recipient postomat reference.",
      "minLength": 1,
      "type": "string"
     },
     "RecipientWarehouseIndex": {
      "description": "Recipient postomat index.",
      "minLength": 1,
      "type": "string"
     },
     "RecipientsPhone": {
      "pattern": "^380\\d{9}$",
      "type": "string"
     },
     "SeatsAmount": {
      "minimum": 1,
      "type": "integer"
     },
     "Sender": {
      "description": "Sender counterparty reference.",
      "minLength": 1,
      "type": "string"
     },
     "SenderAddress": {
      "description": "Sender door or warehouse reference.",
      "minLength": 1,
      "type": "string"
     },
     "SenderWarehouseIndex": {
      "minLength": 1,
      "type": "string"
     },
     "SendersPhone": {
      "pattern": "^380\\d{9}$",
      "type": "string"
     },
     "ServiceType": {
      "enum": [
       "DoorsPostomat",
       "WarehousePostomat"
      ],
      "type": "string"
     },
     "Weight": {
      "description": "Total shipment weight in kg (maximum 20 kg).",
      "maximum": 20,
      "minimum": 0.1,
      "type": "number"
     }
    },
    "required": [
     "PayerType",
     "PaymentMethod",
     "DateTime",
     "CargoType",
     "Weight",
     "ServiceType",
     "SeatsAmount",
     "Description",
     "Cost",
     "CitySender",
     "Sender",
     "SenderAddress",
     "ContactSender",
     "SendersPhone",
     "CityRecipient",
     "Recipient",
     "RecipientAddress",
     "ContactRecipient",
     "RecipientsPhone",
     "OptionsSeat"
    ],
    "type": "object"
   }
  },
  "required": [
   "request"
  ],
  "type": "object"
 },
 "name": "waybill_create_to_postomat"
}
