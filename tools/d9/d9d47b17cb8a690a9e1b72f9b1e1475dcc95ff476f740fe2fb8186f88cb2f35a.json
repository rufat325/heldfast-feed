{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "After the human explicitly agrees to pay for the selected hunt, reserve the hunt and prepare a secure checkout URL. This creates a checkout session but does not charge the user and does not prove payment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_info": {
    "maxLength": 2000,
    "type": "string"
   },
   "domain": {
    "enum": [
     "AUTO",
     "HEAVY",
     "AG",
     "INDUSTRIAL",
     "CONSTRUCTION",
     "MARINE",
     "ELECTRONICS",
     "APPLIANCE",
     "POWERSPORTS",
     "AEROSPACE",
     "OTHER"
    ],
    "type": "string"
   },
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "location": {
    "maxLength": 240,
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "type": "string"
   },
   "offer_slug": {
    "enum": [
     "quick-hunt",
     "deep-hunt",
     "rescue-hunt"
    ],
    "type": "string"
   },
   "part_description": {
    "maxLength": 5000,
    "minLength": 5,
    "type": "string"
   },
   "phone": {
    "maxLength": 50,
    "type": "string"
   },
   "request_id": {
    "maxLength": 240,
    "type": "string"
   },
   "urgency": {
    "maxLength": 50,
    "type": "string"
   },
   "user_confirmed_payment": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "user_confirmed_payment",
   "offer_slug",
   "email",
   "part_description"
  ],
  "type": "object"
 },
 "name": "prepare_part_hunt_checkout",
 "title": "Prepare a human-confirmed FindMyPart checkout"
}
