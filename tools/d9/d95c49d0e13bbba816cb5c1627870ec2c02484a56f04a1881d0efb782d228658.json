  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the actual Human Standards guidance at a path returned by search_standards. For long documents, the response lists available sections; pass section to retrieve one focused section without truncation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "max_chars": {
    "default": 12000,
    "description": "Maximum content characters to return.",
    "maximum": 30000,
    "minimum": 2000,
    "type": "integer"
   },
   "path": {
    "description": "Document path returned by search_standards, such as /interaction-patterns/forms/.",
    "minLength": 1,
    "type": "string"
   },
   "section": {
    "description": "Optional H2 or H3 section title from available_sections.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "get_standard",
 "outputSchema": {
  "properties": {
   "available_sections": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "content": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "key_points": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "type": "string"
   },
   "references": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "requested_section": {
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "title",
   "path",
   "description",
   "content",
   "available_sections",
   "key_points",
   "references",
   "requested_section",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Read a Human Standard"
}
