{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Item details"
 },
 "description": "Get one wholesale item from apMZoomAI (\uc571\uc5e0\uc90cAI) by the id returned by search_products or get_new_arrivals: name, up to 3 photos, category, the stall's location in the Dongdaemun market (Seoul) and the apMZoomAI link. Returns an error if the item is no longer listed. No prices are provided; the link shows price and ordering details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Item id returned by search_products or get_new_arrivals.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000)$",
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Language for item names, labels and links: en, zh, ko, ja, vi, th, id or ms. Default en.",
    "enum": [
     "en",
     "zh",
     "ko",
     "ja",
     "vi",
     "th",
     "id",
     "ms"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lang": {
    "enum": [
     "en",
     "zh",
     "ko",
     "ja",
     "vi",
     "th",
     "id",
     "ms"
    ],
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "product": {
    "additionalProperties": false,
    "properties": {
     "category": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "images": {
      "items": {
       "type": "string"
      },
      "maxItems": 3,
      "type": "array"
     },
     "links": {
      "additionalProperties": false,
      "properties": {
       "product": {
        "type": "string"
       },
       "store": {
        "type": "string"
       }
      },
      "required": [
       "product",
       "store"
      ],
      "type": "object"
     },
     "listedAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "type": "string"
     },
     "stall": {
      "additionalProperties": false,
      "properties": {
       "building": {
        "type": "string"
       },
       "buildingKey": {
        "type": "string"
       },
       "door": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "floor": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "building",
       "buildingKey",
       "floor",
       "door"
      ],
      "type": "object"
     }
    },
    "required": [
     "id",
     "name",
     "images",
     "category",
     "stall",
     "listedAt",
     "links"
    ],
    "type": "object"
   }
  },
  "required": [
   "lang",
   "product",
   "note"
  ],
  "type": "object"
 },
 "title": "Item details"
}
