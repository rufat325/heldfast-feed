 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Event (Admin)"
 },
 "description": "ADMIN: Partially updates an existing school event - only the provided fields change; omitted fields keep their current values. Use for reschedules, capacity or price changes, and status transitions (cancelled/completed). Prefer cancel_event to cancel outright. Requires pac_cordinator or event_cordinator role. WRITE operation - confirm changes with the user. Get event_id from get_upcoming_events.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "New event description shown to parents",
    "type": "string"
   },
   "ends_at": {
    "description": "End time (e.g. 20:00)",
    "type": "string"
   },
   "event_date": {
    "description": "Event date, YYYY-MM-DD",
    "type": "string"
   },
   "event_id": {
    "description": "Event ID - from get_upcoming_events",
    "type": "string"
   },
   "location": {
    "description": "Event location (e.g. Gymnasium)",
    "type": "string"
   },
   "max_capacity": {
    "description": "Maximum number of attendees/tickets",
    "type": "integer"
   },
   "name": {
    "description": "New event name",
    "type": "string"
   },
   "starts_at": {
    "description": "Start time (e.g. 18:30)",
    "type": "string"
   },
   "status": {
    "description": "Event status - cancelled stops sales, completed closes the event",
    "enum": [
     "active",
     "cancelled",
     "completed"
    ],
    "type": "string"
   },
   "ticket_price_cents": {
    "description": "Ticket price in cents; 0 for free events",
    "type": "integer"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "update_event",
 "outputSchema": {
  "properties": {
   "eventDate": {
    "description": "Event date, YYYY-MM-DD",
    "type": "string"
   },
   "id": {
    "description": "Event ID",
    "type": "string"
   },
   "name": {
    "description": "Event name",
    "type": "string"
   },
   "status": {
    "description": "Event status after the update",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Update Event (Admin)"
}
