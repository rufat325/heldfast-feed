    ],
    "type": "object"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "anyOf": [
     {
      "const": "today",
      "type": "string"
     },
     {
      "const": "7d",
      "type": "string"
     },
     {
      "const": "30d",
      "type": "string"
     },
     {
      "const": "90d",
      "type": "string"
     },
     {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     }
    ],
    "default": "30d"
   },
   "site_id": {
    "format": "uuid",
    "type": "string"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "visitor_type": {
    "enum": [
     "new",
     "returning"
    ],
    "type": "string"
   }
  },
  "required": [
   "dimension"
  ],
  "type": "object"
 },
