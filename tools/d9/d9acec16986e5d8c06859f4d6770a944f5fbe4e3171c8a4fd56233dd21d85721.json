{"_meta":{"openai/outputTemplate":"ui://widget/contrast-checker-v1-1.0.0-e7d7b9a57ad979150622f79c2569d81d74d0e1ca2c1365788b5f45c217ef5ebb.html","openai/toolInvocation/invoked":"Contrast checked","openai/toolInvocation/invoking":"Checking contrast","openai/widgetAccessible":true,"ui":{"resourceUri":"ui://widget/contrast-checker-v1-1.0.0-e7d7b9a57ad979150622f79c2569d81d74d0e1ca2c1365788b5f45c217ef5ebb.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Check color contrast"},"description":"Use this when the user wants to know whether a text, icon or border colour has enough contrast against a background: a WCAG contrast checker for one colour pair (e.g. \"does white text on #F59E0B pass WCAG AA\", \"contrast ratio of #767676 on white\", \"what text color for this background\"). Returns the computed WCAG 2.x ratio (truncated to 2 decimals, rounded down), AA/AAA results for normal text, large text and UI components, a verdict for a given font size, APCA Lc as draft information, and the nearest passing colours for AA and AAA (darker and lighter, same OKLCH hue and chroma). Accepts hex, 8-digit hex with alpha, rgb(), hsl(), hwb(), lab(), lch(), oklab(), oklch(), color(display-p3 ...) and CSS colour names; wide-gamut colours are clipped to sRGB with a note. Does not read colours from images or web pages, resolve CSS variables or currentColor, or check gradients as a whole (check each stop). For 3 or more colours use check_palette_contrast.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"adjust":{"description":"Which colour the suggested fixes change, e.g. foreground. auto (default) changes the more colourful of the two, so brand colours keep their hue.","enum":["auto","foreground","background"],"type":"string"},"background":{"description":"Background colour behind it, e.g. #FFFFFF, white or #1E293B. A translucent background is composited over white.","maxLength":64,"minLength":1,"type":"string"},"bold":{"description":"Optional: true when that text is bold (font-weight 700+), e.g. true. Bold text from 18.66px counts as large text.","type":"boolean"},"font_size_px":{"description":"Optional text size in CSS pixels for a single verdict on that text, e.g. 16. 18pt = 24px; 14pt = about 18.66px.","maximum":500,"minimum":1,"type":"number"},"foreground":{"description":"Text, icon or border colour, e.g. #767676, #1E6FD980 (8-digit hex with alpha), rgb(118, 118, 118), hsl(214 76% 48%), oklch(55% 0.18 255) or a CSS colour name such as navy. Translucent colours are composited over the background.","maxLength":64,"minLength":1,"type":"string"}},"required":["foreground","background"],"type":"object"},"name":"check_color_contrast","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"apca":{"additionalProperties":false,"properties":{"lc":{"type":"number"},"note":{"type":"string"},"polarity":{"type":"string"}},"required":["lc","polarity","note"],"type":"object"},"background":{"additionalProperties":false,"properties":{"hex":{"type":"string"},"input":{"type":"string"}},"required":["input","hex"],"type":"object"},"fixes":{"additionalProperties":false,"properties":{"aa":{"additionalProperties":false,"properties":{"darker":{"anyOf":[{"additionalProperties":false,"properties":{"chroma_reduced":{"type":"boolean"},"hex":{"type":"string"},"lightness_change":{"type":"number"},"oklch":{"type":"string"},"ratio":{"type":"number"},"unchanged":{"type":"boolean"}},"required":["hex","ratio","oklch","lightness_change","chroma_reduced","unchanged"],"type":"object"},{"type":"null"}]},"lighter":{"anyOf":[{"additionalProperties":false,"properties":{"chroma_reduced":{"type":"boolean"},"hex":{"type":"string"},"lightness_change":{"type":"number"},"oklch":{"type":"string"},"ratio":{"type":"number"},"unchanged":{"type":"boolean"}},"required":["hex","ratio","oklch","lightness_cha