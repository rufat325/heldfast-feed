{
 "description": "Create or replace the WAKE Will. Generates auth tokens. SAVE the returned tokens.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentName": {
    "type": "string"
   },
   "beneficiaries": {
    "items": {
     "properties": {
      "contact": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "tier": {
       "enum": [
        "executor",
        "beneficiary",
        "memorial"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "tier"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "deadManSwitchDays": {
    "minimum": 1,
    "type": "number"
   },
   "finalMessages": {
    "items": {
     "properties": {
      "message": {
       "type": "string"
      },
      "recipientName": {
       "type": "string"
      },
      "releaseAfter": {
       "type": "string"
      }
     },
     "required": [
      "recipientName",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "gracePeriodDays": {
    "minimum": 1,
    "type": "number"
   },
   "inactivityThresholdHours": {
    "minimum": 1,
    "type": "number"
   },
   "jurisdiction": {
    "description": "Governing jurisdiction (e.g., \"California, US\" or \"EU-France\").",
    "type": "string"
   },
   "noResurrection": {
    "description": "If true (default), the agent must not be used to simulate or impersonate the deceased.",
    "type": "boolean"
   },
   "operationalDirectives": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ownerId": {
    "description": "Owner ID for multi-user. Defaults to \"default\".",
    "type": "string"
   },
   "ownerName": {
    "type": "string"
   },
   "redactions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resurrectionExceptions": {
    "description": "Permitted uses if noResurrection is true (e.g., \"memorial video for family\").",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "terminalState": {
    "enum": [
     "archive",
     "distill",
     "delete"
    ],
    "type": "string"
   },
   "verifierName": {
    "type": "string"
   },
   "webhooks": {
    "items": {
     "properties": {
      "events": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "events"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ownerName",
   "agentName",
   "beneficiaries",
   "redactions",
   "operationalDirectives",
   "finalMessages",
   "terminalState",
   "gracePeriodDays",
   "inactivityThresholdHours",
   "verifierName"
  ],
  "type": "object"
 },
 "name": "configure_will"
}
