{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a reservation"
 },
 "description": "Create a new reservation on a listing (it blocks the calendar and syncs to connected channels). Only channelId 2000 (direct, the default), 2002 (homeaway) or 2020 (partner) are accepted. To price it correctly, call hostaway_calculate_price first and pass its total as totalPrice. Overbooking protection is always left on. Hostaway: POST /v1/reservations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "adults": {
    "description": "Adults.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "arrivalDate": {
    "description": "Arrival date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "channelId": {
    "anyOf": [
     {
      "const": 2000,
      "type": "number"
     },
     {
      "const": 2002,
      "type": "number"
     },
     {
      "const": 2020,
      "type": "number"
     }
    ],
    "description": "2000 direct (default), 2002 homeaway, 2020 partner."
   },
   "checkInTime": {
    "description": "Check-in time (hour of day, 0-23).",
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "checkOutTime": {
    "description": "Check-out time (hour of day, 0-23).",
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "children": {
    "description": "Children.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "comment": {
    "description": "Free-text comment.",
    "type": "string"
   },
   "currency": {
    "description": "Currency code, e.g. USD.",
    "type": "string"
   },
   "departureDate": {
    "description": "Departure date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "doorCode": {
    "description": "Door / lock code for this stay.",
    "type": "string"
   },
   "doorCodeInstruction": {
    "description": "Door-code instructions.",
    "type": "string"
   },
   "doorCodeVendor": {
    "description": "Lock vendor.",
    "type": "string"
   },
   "guestAddress": {
    "description": "Guest street address.",
    "type": "string"
   },
   "guestCity": {
    "description": "Guest city.",
    "type": "string"
   },
   "guestCountry": {
    "description": "Guest country (ISO 3166 code, e.g. US).",
    "type": "string"
   },
   "guestEmail": {
    "description": "Guest email.",
    "type": "string"
   },
   "guestFirstName": {
    "description": "Guest first name.",
    "type": "string"
   },
   "guestLastName": {
    "description": "Guest last name.",
    "type": "string"
   },
   "guestName": {
    "description": "Guest full name.",
    "type": "string"
   },
   "guestNote": {
    "description": "Note from the guest.",
    "type": "string"
   },
   "guestZipCode": {
    "description": "Guest ZIP / postal code.",
    "type": "string"
   },
   "hostNote": {
    "description": "Internal host note (not shown to the guest).",
    "type": "string"
   },
   "infants": {
    "description": "Infants.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "listingMapId": {
    "description": "Listing id to book.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "numberOfGuests": {
    "description": "Total number of guests.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pets": {
    "description": "Pets.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "phone": {
    "description": "Guest phone, e.g. +15125551212.",
    "type": "string"
   },
   "totalPrice": {
    "description": "Total price of the stay.",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "listingMapId",
   "arrivalDate",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "hostaway_create_reservation",
 "title": "Create a reservation"
}
