{
 "description": "Create a QR code that opens a map location when scanned. Encodes geographic coordinates that map apps can parse.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "background_color": {
    "description": "Hex color for background.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "corner_style": {
    "description": "Corner shape.",
    "enum": [
     "square",
     "extra-rounded",
     "dot"
    ],
    "type": "string"
   },
   "dot_style": {
    "description": "Dot shape.",
    "enum": [
     "square",
     "rounded",
     "dots",
     "classy-rounded"
    ],
    "type": "string"
   },
   "foreground_color": {
    "description": "Hex color for dots.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "format": {
    "default": "svg",
    "description": "Image format.",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "frame_color": {
    "description": "Frame background color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "frame_style": {
    "description": "Frame style around QR.",
    "enum": [
     "none",
     "banner_bottom",
     "banner_top",
     "rounded"
    ],
    "type": "string"
   },
   "frame_text": {
    "description": "CTA text on frame (max 30 chars).",
    "maxLength": 30,
    "type": "string"
   },
   "frame_text_color": {
    "description": "Frame text color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "label": {
    "description": "Human-readable place name (shown on map).",
    "type": "string"
   },
   "latitude": {
    "description": "Geographic latitude (-90 to 90).",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "logo_url": {
    "description": "Logo URL or data URI.",
    "type": "string"
   },
   "longitude": {
    "description": "Geographic longitude (-180 to 180).",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "qr_label": {
    "description": "Label for this QR code (internal).",
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "create_location_qr"
}
