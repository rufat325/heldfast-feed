{
 "description": "Escape special characters in a string (newlines, tabs, quotes, backslashes)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "String to escape",
    "type": "string"
   },
   "mode": {
    "default": "json",
    "description": "Escape mode: json, js, regex, or shell",
    "enum": [
     "json",
     "js",
     "regex",
     "shell"
    ],
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "escape_string"
}
