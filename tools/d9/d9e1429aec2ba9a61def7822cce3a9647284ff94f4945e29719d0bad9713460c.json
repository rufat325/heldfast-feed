{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Find edges by curve type, length, radius, or dihedral angle. Returns IDs, curve types, lengths, radii, diameters. Use returned IDs in measure_distance or measure_geometry.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "file_path": {
    "description": "Path to STEP file on local filesystem.",
    "minLength": 1,
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "body_ids": {
      "items": {
       "description": "Body ID: \"body:N\".",
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "dihedral_angle": {
      "additionalProperties": false,
      "properties": {
       "max_degrees": {
        "maximum": 180,
        "minimum": 0,
        "type": "number"
       },
       "min_degrees": {
        "maximum": 180,
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "length": {
      "additionalProperties": false,
      "properties": {
       "max": {
        "minimum": 0,
        "type": "number"
       },
       "min": {
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "radius": {
      "additionalProperties": false,
      "properties": {
       "max": {
        "minimum": 0,
        "type": "number"
       },
       "min": {
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "type": {
      "description": "Edge curve type.",
      "enum": [
       "line",
       "circle",
       "ellipse",
       "bspline",
       "other"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "include": {
    "items": {
     "enum": [
      "basic",
      "bounds",
      "geometry",
      "adjacency",
      "topology",
      "quality"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "max_results": {
    "default": 100,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "enum": [
     "longest",
     "shortest",
     "largest_radius",
     "smallest_radius",
     "sharpest"
    ],
    "type": "string"
   },
   "summarize": {
    "additionalProperties": false,
    "properties": {
     "by": {
      "items": {
       "enum": [
        "type",
        "body",
        "length_range",
        "radius_range",
        "feature"
       ],
       "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
     },
     "stats": {
      "items": {
       "enum": [
        "count",
        "length",
        "radius",
        "diameter"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "unique": {
      "items": {
       "enum": [
        "radius",
        "diameter"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "find_edges"
}
