{
 "_meta": {
  "anthropic/maxResultSizeChars": 500000,
  "openai/outputTemplate": "ui://fxmacrodata/indicator-chart.html",
  "openai/toolInvocation/invoked": "Rendered COT chart",
  "openai/toolInvocation/invoking": "Loading COT chart\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "fxmacrodata.read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://fxmacrodata/indicator-chart.html",
   "resource_uri": "ui://fxmacrodata/indicator-chart.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://fxmacrodata/indicator-chart.html",
  "ui/resource_uri": "ui://fxmacrodata/indicator-chart.html",
  "ui/visibility": [
   "model",
   "app"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "COT Visual Artifact"
 },
 "description": "Returns weekly CFTC COT positioning data with MCP Apps chart metadata. By default it charts noncommercial net positioning; the `metric` parameter selects another COT field. Access: USD is available without an API key; every other currency returns subscription_required with a subscribe link.",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "3-letter ISO currency code for the FX futures contract (case-insensitive). Supported: AUD, CAD, CHF, EUR, GBP, JPY, NZD, USD, XAU.",
    "examples": [
     "eur",
     "jpy",
     "gbp",
     "aud"
    ],
    "type": "string"
   },
   "end_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Inclusive upper bound, YYYY-MM-DD.",
    "examples": [
     "2020-01-01",
     "2024-06-30"
    ]
   },
   "metric": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": "noncommercial_net",
    "description": "Field to plot from each COT row. Typical values: noncommercial_net, noncommercial_net_zscore, noncommercial_long, noncommercial_short, open_interest.",
    "examples": [
     "noncommercial_net",
     "noncommercial_net_zscore",
     "noncommercial_long",
     "open_interest"
    ]
   },
   "report": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "CFTC report type; omit for the Legacy futures-only report. One of: legacy_futures, legacy_combined, tff_futures, tff_combined, disaggregated_futures. With a TFF report, plot a TFF metric such as leveraged_funds_net or asset_manager_net.",
    "examples": [
     "tff_futures"
    ]
   },
   "start_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Inclusive lower bound, YYYY-MM-DD.",
    "examples": [
     "2020-01-01",
     "2024-06-30"
    ]
   }
  },
  "required": [
   "currency"
  ],
  "title": "cot_visual_artifactArguments",
  "type": "object"
 },
 "name": "cot_visual_artifact",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "fxmacrodata.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "COT Visual Artifact"
}
