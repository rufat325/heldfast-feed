{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List individual messages. Consider using gmail_threads_list instead to group related messages. Use gmail_message_get to fetch full content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeSpamTrash": {
    "default": false,
    "description": "Include messages from SPAM and TRASH",
    "type": "boolean"
   },
   "labelIds": {
    "description": "Only return messages with these label IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxResults": {
    "default": 10,
    "description": "Maximum number of messages to return",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Page token for pagination",
    "type": "string"
   },
   "q": {
    "description": "Gmail search query (e.g., \"from:someone@example.com\", \"is:unread\", \"subject:hello\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "messages_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "threadId": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "threadId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextPageToken": {
    "type": "string"
   },
   "resultSizeEstimate": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "List messages"
}
