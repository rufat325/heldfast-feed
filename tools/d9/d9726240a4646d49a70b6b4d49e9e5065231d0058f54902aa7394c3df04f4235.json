{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search GDPR fines (DSGVO-Bu\u00dfgelder)"},"description":"Searches the frag.hugo database of documented GDPR fines (Germany and Europe), each case with authority, amount, GDPR articles, a short summary and the official source. Use it for questions such as \"which fines were imposed for Art. 32\" or \"fines against telecom companies in Germany\". Not for legal advice in an individual case and not for fines under other laws. Results are sorted by date, newest first.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"artikel":{"description":"GDPR article, e.g. \"Art. 32\" or \"32\"","maxLength":30,"minLength":1,"type":"string"},"betrag_min":{"description":"Minimum fine in EUR","maximum":10000000000,"minimum":0,"type":"number"},"bis":{"description":"To year (inclusive)","maximum":2100,"minimum":2018,"type":"integer"},"branche":{"description":"Industry (Branche), e.g. \"Telekommunikation\"","maxLength":60,"minLength":2,"type":"string"},"bundesland":{"description":"German federal state (Bundesland) or \"Bund\"","maxLength":40,"minLength":2,"type":"string"},"land":{"description":"Country, ISO 3166-1 alpha-2, e.g. DE, IE, FR","pattern":"^[A-Za-z]{2}$","type":"string"},"limit":{"default":10,"description":"Number of results, 1\u201320 (default 10)","maximum":20,"minimum":1,"type":"integer"},"sprache":{"description":"Output language. Default: German if the input is German, otherwise English.","enum":["de","en"],"type":"string"},"suche":{"description":"Free text: company, facts, authority (max. 100 chars)","maxLength":100,"minLength":1,"type":"string"},"von":{"description":"From year (inclusive)","maximum":2100,"minimum":2018,"type":"integer"}},"type":"object"},"name":"search_gdpr_fines","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":