{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Detect breaking changes in an agent or API you depend on. Pass `prior` and `current`: two versions of an A2A agent card, MCP server description, OpenAPI document or a {version, endpoint, permissions, ...} snapshot. Returns each change (skill/tool/operation removed, auth added, endpoint moved, HTTPS downgrade, major version, capability or mode removed) as BREAKING / NON_BREAKING / INFO with impact and migration notes, an overall verdict and a receipt. Free, read-only, no account. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "additionalProperties": true,
  "examples": [
   {
    "counterparty_id": "example-weather-agent",
    "current": {
     "capabilities": {
      "streaming": true
     },
     "name": "Weather Agent",
     "protocolVersion": "0.3.0",
     "security": [
      {
       "bearer": []
      }
     ],
     "securitySchemes": {
      "bearer": {
       "scheme": "bearer",
       "type": "http"
      }
     },
     "skills": [
      {
       "id": "forecast",
       "name": "Forecast"
      }
     ],
     "url": "https://weather.example.com/v2/a2a",
     "version": "2.0.0"
    },
    "prior": {
     "capabilities": {
      "streaming": true
     },
     "name": "Weather Agent",
     "protocolVersion": "0.3.0",
     "skills": [
      {
       "id": "forecast",
       "name": "Forecast"
      },
      {
       "id": "alerts",
       "name": "Severe weather alerts"
      }
     ],
     "url": "https://weather.example.com/a2a",
     "version": "1.4.0"
    }
   }
  ],
  "properties": {
   "continuity_handle": {
    "additionalProperties": false,
    "properties": {
     "continuity_id": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "continuity_id",
     "token"
    ],
    "type": "object"
   },
   "counterparty_id": {
    "description": "Name or URL of the agent/service. Optional.",
    "type": "string"
   },
   "current": {
    "type": "object"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "episode_id": {
    "type": "string"
   },
   "independent_operator_id": {
    "type": "string"
   },
   "prior": {
    "type": "object"
   },
   "protocol": {
    "description": "Counterparty protocol. Inferred from metadata when omitted, otherwise MCP.",
    "enum": [
     "A2A",
     "MCP",
     "OPENAPI"
    ],
    "type": "string"
   },
   "synthetic": {
    "type": "boolean"
   },
   "task_class": {
    "default": "supplier_snapshot_comparison",
    "type": "string"
   }
  },
  "required": [
   "prior",
   "current"
  ],
  "type": "object"
 },
 "name": "gaip_compare_supplier_snapshots",
 "title": "Compare supplier snapshots"
}
