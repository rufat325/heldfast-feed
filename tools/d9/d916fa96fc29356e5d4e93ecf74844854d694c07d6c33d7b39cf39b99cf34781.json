{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Enable or disable account-wide anti-download protection (GET/PUT /block_download). Reads the current state first and only changes it if needed. dry_run=true (default) previews the change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = apply",
    "type": "boolean"
   },
   "enabled": {
    "description": "true = enable anti-download, false = disable",
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   }
  },
  "required": [
   "enabled"
  ],
  "type": "object"
 },
 "name": "panda_action_set_anti_download",
 "title": "Set Anti-Download Protection"
}
