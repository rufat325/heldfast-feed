{
 "description": "FREE. Render a StoryState into a zh/en handoff document (recent-canon window + bible) for a successor writer/AI. The server formats the state you SUPPLY \u2014 project_token proves identity only, not that the state content is authentic or current. Keep the full text client-side; failed calls are never charged. \u514d\u8d39\uff1a\u628a\u8c03\u7528\u65b9\u63d0\u4f9b\u7684 StoryState \u6392\u6210\u4ea4\u63a5\u6587\u6863\uff1btoken \u4ec5\u8bc1\u8eab\u4efd\u3001\u4e0d\u8bc1\u660e state \u5185\u5bb9\u771f\u5b9e\u6216\u6700\u65b0\uff1b\u5931\u8d25\u4e0d\u6536\u8d39\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "maxLength": 8000,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "enum": [
     "zh",
     "en"
    ],
    "type": "string"
   },
   "recent_chars": {
    "default": 9000,
    "maximum": 16000,
    "minimum": 0,
    "type": "integer"
   },
   "request_id": {
    "description": "Idempotency key (optional; same request_id never double-charges)",
    "maxLength": 64,
    "type": "string"
   },
   "state": {
    "additionalProperties": false,
    "properties": {
     "absorbed_window_fps": {
      "items": {
       "pattern": "^sw-v1:[a-f0-9]{64}$",
       "type": "string"
      },
      "maxItems": 1024,
      "type": "array"
     },
     "archive": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "entry": {
         "additionalProperties": false,
         "properties": {
          "entry_id": {
           "maxLength": 128,
           "minLength": 1,
           "type": "string"
          },
          "kind": {
           "maxLength": 128,
           "minLength": 1,
           "type": "string"
          },
          "sources": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "quote": {
              "minLength": 1,
              "type": "string"
             },
             "unit_id": {
              "maxLength": 128,
              "minLength": 1,
              "type": "string"
             },
             "window_fp": {
              "pattern": "^sw-v1:[a-f0-9]{64}$",
              "type": "string"
             }
            },
            "required": [
             "window_fp",
             "unit_id",
             "quote"
            ],
            "type": "object"
           },
           "maxItems": 100,
           "minItems": 1,
           "type": "array"
          },
          "text": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "entry_id",
          "kind",
          "text",
          "sources"
         ],
         "type": "object"
        },
        "reason": {
         "enum": [
          "superseded",
          "archived"
         ],
         "type": "string"
        },
        "replacement_id": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "source": {
         "additionalProperties": false,
         "properties": {
          "quote": {
           "minLength": 1,
           "type": "string"
          },
          "unit_id": {
           "maxLength": 128,
           "minLength": 1,
           "type": "string"
          },
          "window_fp": {
           "pattern": "^sw-v1:[a-f0-9]{64}$",
           "type": "string"
          }
         },
         "required": [
          "window_fp",
          "unit_id",
          "quote"
         ],
         "type": "object"
        }
       },
       "required": [
        "entry",
        "reason"
       ],
       "type": "object"
      },
      "maxItems": 4000,
      "type": "array"
     },
     "bible": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "entry_id": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "kind": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "sources": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "quote": {
            "minLength": 1,
            "type": "string"
           },
           "unit_id": {
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
           },
           "window_fp": {
            "pattern": "^sw-v1:[a-f0-9]{64}$",
            "type": "string"
           }
          },
          "required": [
           "window_fp",
           "unit_id",
           "quote"
          ],
          "type": "object"
         },
         "maxItems": 100,
         "minItems": 1,
         "type": "array"
        },
        "text": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "entry_id",
        "kind",
        "text",
        "sources"
       ],
       "type": "object"
      },
      "maxItems": 2000,
      "type": "array"
     },
     "canon_tail": {
      "maxLength": 16000,
      "type": "string"
     },
     "project_token": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "schema_version": {
      "const": "v1",
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "project_token",
     "canon_tail",
     "bible",
     "archive",
     "absorbed_window_fps"
    ],
    "type": "object"
   }
  },
  "required": [
   "state"
  ],
  "type": "object"
 },
 "name": "render_story_handoff"
}
