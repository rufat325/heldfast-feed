{
 "description": "Get a list of users from GetCourse LMS with optional filters by status and registration date. Supports async export polling for large datasets. Returns up to 50 users per request with full profile details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created_from": {
    "description": "Registration date from (YYYY-MM-DD)",
    "type": "string"
   },
   "created_to": {
    "description": "Registration date to (YYYY-MM-DD)",
    "type": "string"
   },
   "status": {
    "description": "Filter by user status",
    "enum": [
     "active",
     "in_base",
     "blocked"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_users"
}
