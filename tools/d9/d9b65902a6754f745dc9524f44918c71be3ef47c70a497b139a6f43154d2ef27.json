{
 "description": "Replace a range of lines in an HTML file with new content (most token-efficient edit \u2014 send only the changed lines)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_line": {
    "description": "Last line to replace (1-indexed, inclusive)",
    "minimum": 1,
    "type": "integer"
   },
   "file_path": {
    "type": "string"
   },
   "new_content": {
    "description": "Replacement content for the specified lines",
    "type": "string"
   },
   "start_line": {
    "description": "First line to replace (1-indexed)",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "file_path",
   "start_line",
   "end_line",
   "new_content"
  ],
  "type": "object"
 },
 "name": "edit_html_range"
}
