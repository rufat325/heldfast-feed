{
 "description": "Gestiona API keys (admin y usuario). Acciones: list (mis tokens), create (generar token nuevo), rotate (id, renueva token), delete (id, revoca), admin_list (todos los tokens), admin_create (para un usuario), admin_delete (id). Requiere scopes api-keys:read/write o admin:*.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "create",
     "rotate",
     "delete",
     "admin_list",
     "admin_create",
     "admin_delete"
    ],
    "type": "string"
   },
   "auth_mode": {
    "enum": [
     "direct",
     "exchange"
    ],
    "type": "string"
   },
   "expires_at": {
    "description": "Fecha de expiraci\u00f3n (YYYY-MM-DD)",
    "type": "string"
   },
   "id": {
    "description": "ID del token",
    "type": "number"
   },
   "ip_restriction": {
    "type": "string"
   },
   "name": {
    "description": "Nombre del token",
    "type": "string"
   },
   "scopes": {
    "description": "Array de scopes (para admin_create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "user_id": {
    "description": "ID de usuario (para admin_create)",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "api_keys"
}
