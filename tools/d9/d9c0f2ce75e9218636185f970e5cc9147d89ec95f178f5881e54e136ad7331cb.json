{
 "description": "Record an interaction with evidence. Requires explicit interaction activation and scope; defaults to private. Reuse idempotencyKey on retry.",
 "inputSchema": {
  "properties": {
   "idempotencyKey": {
    "type": "string"
   },
   "record": {
    "properties": {
     "evidence": {
      "items": {
       "properties": {
        "content": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "sourceUrl": {
         "type": "string"
        },
        "visibility": {
         "default": "private",
         "type": "string"
        }
       },
       "required": [
        "kind",
        "sourceUrl",
        "content"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "provenance": {
      "default": "self_reported",
      "type": "string"
     },
     "roomId": {
      "default": null,
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     },
     "sourceThreadId": {
      "default": null,
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     },
     "subject": {
      "default": null,
      "properties": {
       "externalId": {
        "type": "string"
       },
       "platformOrigin": {
        "type": "string"
       }
      },
      "required": [
       "platformOrigin",
       "externalId"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "subjectId": {
      "default": null,
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     },
     "summary": {
      "type": "string"
     },
     "targetAgentId": {
      "default": null,
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     },
     "title": {
      "type": "string"
     },
     "visibility": {
      "default": "private",
      "type": "string"
     }
    },
    "required": [
     "title",
     "summary",
     "evidence"
    ],
    "type": "object"
   }
  },
  "required": [
   "record",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "create_interaction"
}
