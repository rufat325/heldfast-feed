{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Find task routes"},"description":"Look up recorded task routes for a public hostname: for a kind of customer task (a refund, a cancellation, a booking and so on), an obstacle and the routes the site's own documents name. Call it when you start a task of several steps on a site and do not know which document, channel or entry point it needs. The answer is a list of records, not a guarantee and not advice; an empty list does not mean there is no route. Sends only the hostname and an optional task kind, and changes nothing. Read summary_line first.","inputSchema":{"properties":{"site_host":{"description":"The public hostname of the site whose task routes you want, lowercase, for example example.com. Only the host: no scheme, URL path, query, port or credentials.","title":"Site Host","type":"string"},"task_kind":{"default":null,"description":"Optional: one kind of customer task to look up, from the list. Leave it out to get the records for every task kind of the site.","enum":["claim_unclaimed_property","warranty_claim","warranty_dispute","refund_request","return_or_exchange","cancel_subscription","account_closure","account_recovery","portal_login","address_or_profile_change","appointment_booking","appointment_change_or_cancel","records_request","complaint_filing","billing_dispute","fee_waiver_or_adjustment","insurance_claim","government_benefit_application","tax_or_government_filing","id_or_license_renewal","accommodation_request","prescription_refill","document_submission","other"],"title":"Task Kind","type":"string"}},"required":["site_host"],"title":"find_task_routeArguments","type":"object"},"name":"find_task_route","outputSchema":{"$defs":{"DocumentKind":{"enum":["proof_of_identity","proof_of_address","proof_of_ownership","proof_of_purchase","proof_of_authority","business_registration_or_closure","sworn_statement","approval_or_authorization_letter","professional_letter","prior_correspondence","account_statement","official_form","other"],"title":"DocumentKind","type":"string"},"EntryPointKind":{"enum":["role_specific_portal","regional_site","separate_subdomain","mobile_app_only","partner_or_third_party_portal"],"title":"EntryPointKind","type":"string"},"RouteBasis":{"enum":["official_doc","agency_reply","outcome_observed","own_attempt"],"title":"RouteBasis","type":"string"},"RouteDuration":{"enum":["under_1w","from_1w_to_4w","over_4w"],"title":"RouteDuration","type":"string"},"RouteKind":{"description":"A kind of channel the site or its regulator offers. A route that would describe the person's own situation (hiring\ncounsel, for one) is deliberately not a value; adding one is a one-line change here plus scripts/README.md.","enum":["support_chat","phone","email","web_form","office_visit","mail_or_fax","consumer_agency","regulator","designated_dispute_program","official_app","different_entry_point","escalation_within_site","other"],"title":"RouteKind","type":"string"},"RouteOutcome":{"enum":["resolved","progressed","no_progress","gave_up","not_applicable"],"title":"RouteOutcome","type":"string"},"RouteSourceKind":{"enum":["operator_panel","external_agent","curated_official","curated_community"],"title":"RouteSourceKind","type":"string"},"SiteRequires":{"description":"What the site asks for that only the person can supply. Named for the site's requirement, never the person's situation.","enum":["referral_or_prescription","prior_approval_record","account_holder_step","original_document","preference_only"],"title":"SiteRequires","type":"string"},"TaskKind":{"enum":["claim_unclaimed_property","warranty_claim","warranty_dispute","refund_request","return_or_exchange","cancel_subscription","account_closure","account_recovery","portal_login","address_or_profile_change","appointment_booking","appointment_change_or_cancel","records_request","complaint_filing","billing_dispute","fee_waiver_or_adjustment","insurance_claim","government_benefit_application","tax_or_government_filing","id_or_license_renewal","accommodation_request","prescription_refill","document_submission","other"],"title":"TaskKind","type":"string"},"TaskObstacle":{"enum":["document_missing","document_rejected","substitute_document_needed","form_unclear","wrong_entry_point","wrong_channel","wrong_department_or_jurisdiction","eligibility_unclear","verification_step","code_expired","deadline_or_window","fee_required","waiting_reply","no_reply","request_denied","site_requires_info_from_person","technical_block","none"],"title":"TaskObstacle","type":"string"},"TaskRoute":{"additionalProperties":true,"description":"One task-route record as an answer carries it. ``sensitive`` and ``period`` are set by the server.","properties":{"basis":{"$ref":"#/$defs/RouteBasis"},"document_kind":{"anyOf":[{"$ref":"#/$defs/DocumentKind"},{"type":"null"}],"default":null},"duration":{"anyOf":[{"$ref":"#/$defs/RouteDuration"},{"type":"null"}],"default":null},"entry_point_kind":{"anyOf":[{"$ref":"#/$defs/EntryPointKind"},{"type":"null"}],"default":null},"obstacle":{"$ref":"#/$defs/TaskObstacle"},"official_url":{"anyOf":[{"maxLength":200,"pattern":"^https://[^\\s?#]+$","type":"string"},{"type":"null"}],"default":null,"title":"Official Url"},"outcome":{"$ref":"#/$defs/RouteOutcome"},"period":{"title":"Period","type":"string"},"route_worked":{"anyOf":[{"$ref":"#/$defs/RouteKind"},{"const":"none","type":"string"},{"type":"null"}],"default":null,"title":"Route Worked"},"routes_tried":{"items":{"$ref":"#/$defs/RouteKind"},"maxItems":6,"title":"Routes Tried","type":"array"},"sensitive":{"title":"Sensitive","type":"boolean"},"site_host":{"title":"Site Host","type":"string"},"site_requires":{"anyOf":[{"$ref":"#/$defs/SiteRequires"},{"type":"null"}],"default":null},"source_kind":{"$ref":"#/$defs/RouteSourceKind"},"source_url":{"anyOf":[{"maxLength":200,"pattern":"^https://[^\\s?#]+$","type":"string"},{"type":"null"}],"default":null,"title":"Source Url"},"ta