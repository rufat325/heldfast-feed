{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Give, take, or clear items"},"description":"Change a player's inventory or ender chest (players:write, online), or a container block (world:write). `give` adds an item where it fits: a player's overflow drops at their feet, a block's is lost (`dropped`). `set` replaces a slot, `take` removes amount from one, `clear_slot` empties one, and `clear` empties all, armor included. Slots: 0\u20138 hotbar, 9\u201335 main, 36\u201339 boots to helmet, 40 offhand, ender chest 0\u201326. A double chest has 54, left half first.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"action":{"enum":["give","set","take","clear_slot","clear"],"type":"string"},"amount":{"description":"For take: the whole stack when left out","maximum":6400,"minimum":1,"type":"integer"},"block":{"description":"Instead of a player","properties":{"world":{"default":"world","minLength":1,"type":"string"},"x":{"multipleOf":1,"type":"number"},"y":{"multipleOf":1,"type":"number"},"z":{"multipleOf":1,"type":"number"}},"required":["x","y","z"],"type":"object"},"container":{"default":"inventory","description":"For a player","enum":["inventory","enderchest"],"type":"string"},"item":{"description":"Give `type` or a full `item`","properties":{"amount":{"default":1,"maximum":6400,"minimum":1,"type":"integer"},"damage":{"minimum":0,"multipleOf":1,"type":"number"},"enchantments":{"additionalProperties":{"maximum":255,"minimum":1,"type":"integer"},"description":"Key to level","propertyNames":{"type":"string"},"type":"object"},"format":{"default":"plain","description":"`minimessage` reads tags like `<green>Hi`","enum":["plain","minimessage"],"type":"string"},"item":{"description":"Instead of type: command syntax, such as `minecraft:diamond_sword[enchantments={sharpness:5}]`","type":"string"},"lore":{"items":{"type":"string"},"type":"array"},"name":{"type":"string"},"type":{"description":"Item key, such as `minecraft:diamond_sword`","type":"string"},"unbreakable":{"type":"boolean"}},"type":"object"},"player":{"description":"Player name or UUID","minLength":1,"type":"string"},"slot":{"maximum":255,"minimum":0,"type":"integer"}},"required":["action"],"type":"object"},"name":"edit_items","title":"Give, take, or clear items"}
