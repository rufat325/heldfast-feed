{
 "description": "Remove a package version from the registry",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "force": {
    "description": "Force unpublish (required for entire package)",
    "type": "boolean"
   },
   "otp": {
    "description": "One-time password for 2FA",
    "type": "string"
   },
   "package": {
    "description": "Package name with optional version (e.g. pkg@1.0.0)",
    "type": "string"
   }
  },
  "required": [
   "package"
  ],
  "type": "object"
 },
 "name": "unpublish"
}
