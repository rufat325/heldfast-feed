{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Monte Carlo cost estimate"
 },
 "description": "Run a three-point (triangular) Monte Carlo simulation over cost line items. Use when a user needs a realistic range for a quote, budget or project cost instead of a single guess. Returns total-cost percentiles (p10/p50/p80/p90) and per-item breakdown.",
 "inputSchema": {
  "properties": {
   "items": {
    "description": "Cost line items with three-point estimates",
    "items": {
     "properties": {
      "high": {
       "description": "pessimistic cost",
       "type": "number"
      },
      "likely": {
       "description": "most likely cost",
       "type": "number"
      },
      "low": {
       "description": "optimistic cost",
       "type": "number"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "low",
      "likely",
      "high"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "iterations": {
    "description": "optional, 100-20000, default 5000",
    "type": "number"
   },
   "seed": {
    "description": "optional seed for reproducible output",
    "type": "number"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "monte_carlo_estimate",
 "title": "Monte Carlo cost estimate"
}
