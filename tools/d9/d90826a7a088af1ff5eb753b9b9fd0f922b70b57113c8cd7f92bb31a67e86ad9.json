{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record a suggested change. This does not change the schedule. kind waive_deposit and kind mark_deposit_paid need only a summary. kind move_payment_date requires dueOn and target; target later also requires paymentId. kind revise_deposit requires amountMinor. kind add_later_payment requires label, amountMinor, and dueOn. kind revise_client_script requires script.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amountMinor": {
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "dueOn": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "waive_deposit",
     "mark_deposit_paid",
     "move_payment_date",
     "revise_deposit",
     "add_later_payment",
     "revise_client_script"
    ],
    "type": "string"
   },
   "label": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "paymentId": {
    "$ref": "#/properties/scheduleId"
   },
   "scheduleId": {
    "format": "uuid",
    "type": "string"
   },
   "script": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "enum": [
     "deposit",
     "later"
    ],
    "type": "string"
   }
  },
  "required": [
   "scheduleId",
   "kind",
   "summary"
  ],
  "type": "object"
 },
 "name": "suggest_schedule_change",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "suggest schedule change"
}
