  "properties": {
   "delegatee": {
    "description": "Public key of the agent receiving authority",
    "type": "string"
   },
   "scope_categories": {
    "description": "Action categories (e.g., ['analysis', 'communication'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "description": "ISO 8601 expiration",
    "type": "string"
   }
  },
  "required": [
   "delegatee",
   "scope_categories",
   "valid_until"
  ],
  "type": "object"
 },
 "name": "create_v2_delegation"
}
