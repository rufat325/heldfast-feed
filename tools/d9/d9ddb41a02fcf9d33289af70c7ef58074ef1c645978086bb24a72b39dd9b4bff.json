{
 "description": "Generate a complete HTML head block \u2014 standard <meta>, OpenGraph, Twitter Card and Schema.org JSON-LD \u2014 from a small set of inputs (title, description, url, image, author, keywords, type). Returns ready-to-paste HTML plus an SEO score 0-100 with concrete warnings (title length, description length, missing OG image, etc.).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "image": {
    "type": "string"
   },
   "keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "locale": {
    "default": "en_US",
    "type": "string"
   },
   "site_name": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "twitter_card": {
    "default": "summary_large_image",
    "enum": [
     "summary",
     "summary_large_image"
    ],
    "type": "string"
   },
   "twitter_site": {
    "description": "@handle",
    "type": "string"
   },
   "type": {
    "default": "website",
    "enum": [
     "website",
     "article",
     "product",
     "profile"
    ],
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "meta_tags_generate"
}
