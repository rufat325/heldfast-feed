     "Asphalt",
     "Metal",
     "Tile",
     "Slate"
    ],
    "type": "string"
   },
   "pitch": {
    "description": "Roof pitch/steepness",
    "enum": [
     "Low",
     "Moderate",
     "Steep"
    ],
    "type": "string"
   },
   "tearoff": {
    "description": "Whether old roof needs removing",
    "enum": [
     "Yes",
     "No"
    ],
    "type": "string"
   }
  },
  "required": [
