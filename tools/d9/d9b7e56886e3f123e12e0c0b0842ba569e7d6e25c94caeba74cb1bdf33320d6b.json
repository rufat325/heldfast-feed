{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Attach the fix to a feedback item so the loop is auditable: which repo/branch/commit/PR addressed it and a one-paragraph diff summary.\n\nArgs: id, plus any of repo, branch, commit, pr_url, diff_summary. Provided fields merge into existing links.\n\nCall this right after committing the fix, before updating status to 'fixed'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "branch": {
    "description": "Branch name of the fix",
    "maxLength": 200,
    "type": "string"
   },
   "commit": {
    "description": "Commit SHA of the fix",
    "maxLength": 100,
    "type": "string"
   },
   "diff_summary": {
    "description": "One-paragraph summary of what changed",
    "maxLength": 5000,
    "type": "string"
   },
   "id": {
    "description": "Feedback id, e.g. 'fb_mabc12_3f9a1c'",
    "minLength": 1,
    "type": "string"
   },
   "pr_url": {
    "description": "Pull request URL",
    "maxLength": 1000,
    "type": "string"
   },
   "repo": {
    "description": "Repository, e.g. 'dj/appbroda-web'",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "loopback_link_change",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignee_agent": {
    "description": "Agent currently holding the claim",
    "type": "string"
   },
   "attachments": {
    "description": "Files attached to this item. `intent` decides what you do with each: 'reference' is context for the fix and never ships; 'asset' is a deliverable \u2014 copy it from `path` to `target_path` in the repo, commit it, and record that with loopback_link_change. Read files from `path` directly rather than fetching `url`.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "intent": {
       "description": "'reference' = context only; 'asset' = a deliverable to copy into the repo",
       "enum": [
        "reference",
        "asset"
       ],
       "type": "string"
      },
      "mime": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "description": "Absolute path on this machine \u2014 read or copy it directly",
       "type": "string"
      },
      "size": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "target_path": {
       "description": "For assets: the repo-relative path this file should end up at",
       "type": "string"
      },
      "url": {
       "description": "Hub URL, for humans and browsers",
       "type": "string"
      }
     },
     "required": [
      "id",
      "created_at",
      "name",
      "mime",
      "size",
      "intent",
      "path",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "body": {
    "type": "string"
   },
   "comments": {
    "description": "Full audit trail",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "body": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "id",
      "created_at",
      "author",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "console": {
    "description": "Console lines captured at report time",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "created_at": {
    "type": "string"
   },
   "dom_selector": {
    "type": "string"
   },
   "extra": {
    "additionalProperties": {},
    "description": "Free-form captured context. Read `extra.failed_responses` for failing requests with up to 2KB of response body, and `extra.context` for LLM/automation run metadata (run_id, model, trace_url).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "Feedback id, e.g. 'fb_mabc12_3f9a1c'",
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "description": "Repo/branch/commit/PR of the fix",
    "properties": {
     "branch": {
      "type": "string"
     },
     "commit": {
      "type": "string"
     },
     "diff_summary": {
      "type": "string"
     },
     "pr_url": {
      "type": "string"
     },
     "repo": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "network": {
    "description": "Network calls captured at report time",
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "description": "HTTP method",
       "maxLength": 10,
       "type": "string"
      },
      "ms": {
       "description": "Duration in milliseconds",
       "type": "number"
      },
      "status": {
       "description": "HTTP status code",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "url": {
       "description": "Request URL",
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "project": {
    "type": "string"
   },
   "replay_url": {
    "type": "string"
   },
   "reporter": {
    "enum": [
     "human",
     "agent",
     "system"
    ],
    "type": "string"
   },
   "repro_steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resolution": {
    "type": "string"
   },
   "route": {
    "type": "string"
   },
   "screenshot_path": {
    "type": "string"
   },
   "severity": {
    "enum": [
     "p0",
     "p1",
     "p2",
     "p3"
    ],
    "type": "string"
   },
   "source": {
    "enum": [
     "manual",
     "widget",
     "stagewise",
     "sentry",
     "posthog",
     "jam",
     "other"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "triaged",
     "in_progress",
     "fixed",
     "verified",
     "wontfix"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "type": {
    "enum": [
     "ui",
     "backend",
     "usage",
     "ux"
    ],
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "project",
   "created_at",
   "updated_at",
   "source",
   "reporter",
   "type",
   "severity",
   "title",
   "body",
   "console",
   "network",
   "repro_steps",
   "status",
   "links",
   "extra"
  ],
  "type": "object"
 },
 "title": "Link code change"
}
