{
 "description": "Create a new ad set in a Meta campaign with targeting options",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_account_id": {
    "description": "Meta ad account ID",
    "type": "string"
   },
   "age_max": {
    "default": 65,
    "description": "Maximum age",
    "type": "number"
   },
   "age_min": {
    "default": 18,
    "description": "Minimum age",
    "type": "number"
   },
   "campaign_id": {
    "description": "Campaign ID",
    "type": "string"
   },
   "countries": {
    "default": [
     "US"
    ],
    "description": "Target country codes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "daily_budget": {
    "description": "Daily budget in dollars",
    "type": "number"
   },
   "genders": {
    "description": "Genders: 1=Male, 2=Female",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "name": {
    "description": "Ad set name",
    "type": "string"
   },
   "optimization_goal": {
    "default": "LINK_CLICKS",
    "description": "Optimization goal",
    "enum": [
     "LINK_CLICKS",
     "IMPRESSIONS",
     "REACH",
     "LEAD_GENERATION",
     "OFFSITE_CONVERSIONS"
    ],
    "type": "string"
   }
  },
  "required": [
   "ad_account_id",
   "campaign_id",
   "name",
   "daily_budget"
  ],
  "type": "object"
 },
 "name": "meta_ads_create_ad_set"
}
