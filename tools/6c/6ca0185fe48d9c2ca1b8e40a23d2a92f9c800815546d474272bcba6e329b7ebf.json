{
 "description": "Create a relationship between two entities (e.g., \"Amin\" builds \"ModQuote\"). Relationships are bidirectional for querying but stored with a direction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "What established this relationship",
    "type": "string"
   },
   "from_entity_id": {
    "description": "Source entity ID",
    "type": "string"
   },
   "relationship_type": {
    "description": "Type of relationship (e.g., \"builds\", \"uses\", \"works_at\", \"prefers\")",
    "type": "string"
   },
   "strength": {
    "enum": [
     "certain",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "to_entity_id": {
    "description": "Target entity ID",
    "type": "string"
   }
  },
  "required": [
   "from_entity_id",
   "to_entity_id",
   "relationship_type"
  ],
  "type": "object"
 },
 "name": "memory_relate"
}
