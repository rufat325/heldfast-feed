 "description": "Read how one product's price and availability moved over the days a store has been tracked. Use it for questions like \"how has the price of this hoodie changed?\", \"when did this product go on sale?\", \"has this been out of stock?\". Pass the store's web address and the product's link, handle or title (or part of it). Returns per variant the price, the compare-at (was) price and availability on each day something changed, from the first snapshot to now. History starts when the store was first tracked; a store never asked about before has a single snapshot. Several matching products come back as a list of titles to choose from.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "product": {
    "description": "A product link, its handle, or its title (or part of it)",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "store": {
    "description": "Web address of the online store, such as \"allbirds.com\"",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "store",
   "product"
  ],
  "type": "object"
 },
