{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Get user reviews for a movie or TV show (author, that one reviewer's own 0-10 `rating` if they left one \u2014 a single person's score, not the aggregate `vote_average` and not an IMDb/RT/Metacritic value; it can be null, and the review text, clipped to ~1500 characters). Get the id from search_movies/search_tv.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"id":{"description":"TMDB numeric id.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"media_type":{"description":"Media type: 'movie' or 'tv'.","enum":["movie","tv"],"type":"string"},"page":{"description":"1-based page number for pagination (TMDB returns up to 20 results per page, max 500).","maximum":500,"minimum":1,"type":"integer"}},"required":["media_type","id"],"type":"object"},"name":"get_reviews","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"page":{"type":"number"},"results":{"items":{"additionalProperties":false,"properties":{"author":{"type":["string","null"]},"content":{"type":["string","null"]},"created_at":{"anyOf":[{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","type":"string"},{"type":"null"}],"default":null},"rating":{"type":["number","null"]},"url":{"type":["string","null"]}},"required":["author","rating","created_at","content","url"],"type":"object"},"type":"array"},"total_pages":{"type":"number"},"total_results":{"type":"number"}},"required":["results","page","total_pages","total_results"],"type":"object"},"title":"Get user reviews"}
