{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add a book to your library. Set status to \"reading\", \"wishlist\", \"to_check\", etc.",
 "inputSchema": {
  "properties": {
   "author": {
    "description": "Author name",
    "type": "string"
   },
   "notes": {
    "description": "Personal notes about the book",
    "type": "string"
   },
   "pages": {
    "description": "Total pages",
    "type": "integer"
   },
   "rating": {
    "description": "Rating 1-5",
    "enum": [
     1,
     2,
     3,
     4,
     5
    ],
    "type": "integer"
   },
   "status": {
    "description": "Reading status",
    "enum": [
     "wishlist",
     "reading",
     "to_check",
     "completed",
     "abandoned"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Book title",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_book",
 "title": "Create book"
}
