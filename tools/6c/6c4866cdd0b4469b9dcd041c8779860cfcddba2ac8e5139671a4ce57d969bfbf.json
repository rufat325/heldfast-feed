  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List models"
 },
 "description": "See which AI video or image models can make a video ad, animate a photo, produce a product clip or generate an image, with the credit cost of one generation. No account needed. The list is live; `count` is the number of models currently offered.",
 "inputSchema": {
  "properties": {
   "max_credits": {
    "description": "Only return models costing this many credits or fewer.",
    "type": "number"
   },
   "type": {
    "description": "Model family to list. Defaults to video.",
    "enum": [
     "video",
     "image"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_models",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Models returned after filtering.",
    "type": "number"
   },
   "models": {
    "items": {
     "properties": {
      "credits": {
       "description": "Cost of one generation at the model's default settings; estimate_credit_cost quotes other lengths.",
       "type": "number"
      },
      "id": {
       "description": "Pass this as model_id or model.",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "needs_start_image": {
       "description": "True when the model only animates an image: pass image_url to generate_video.",
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "name",
      "credits"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "type": {
    "enum": [
     "video",
     "image"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "count",
   "models"
  ],
  "type": "object"
 },
