{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search FRED series by full-text query across titles, tags, and notes. Returns matching series IDs with titles, units, frequency, and last-updated dates for use in follow-up observation or metadata calls. Supports post-search filtering by frequency, units, or seasonal adjustment status. To find series for a specific release, use fedreserve_get_release instead.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filter_value": {
    "description": "Value for filter_variable.",
    "type": "string"
   },
   "filter_variable": {
    "description": "Post-search filter dimension.",
    "enum": [
     "frequency",
     "units",
     "seasonal_adjustment"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset (FRED caps searchable results at 5000; offset must be \u2264 4999).",
    "maximum": 4999,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search terms.",
    "minLength": 1,
    "type": "string"
   },
   "search_type": {
    "description": "Search mode \u2014 full_text (default) or series_id.",
    "enum": [
     "full_text",
     "series_id"
    ],
    "type": "string"
   },
   "tag_names": {
    "description": "Semicolon-delimited list of tag names to filter by.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "fedreserve_search_series",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "count",
     "offset",
     "limit",
     "query",
     "series",
     "totalCount"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "active_filters": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Active filter dimensions and values, if any were applied.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "count": {
    "description": "Total matching series count.",
    "type": "number"
   },
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode.",
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "limit": {
    "description": "Limit applied.",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset applied.",
    "type": "number"
   },
   "query": {
    "description": "Search query that was executed.",
    "type": "string"
   },
   "series": {
    "description": "Matching series.",
    "items": {
     "additionalProperties": false,
     "description": "One matching FRED series.",
     "properties": {
      "frequency": {
       "description": "Data frequency.",
       "type": "string"
      },
      "id": {
       "description": "FRED series ID (e.g., UNRATE).",
       "type": "string"
      },
      "last_updated": {
       "description": "ISO 8601 date of last update.",
       "type": "string"
      },
      "popularity": {
       "description": "Popularity score (0\u2013100) when provided.",
       "type": "number"
      },
      "seasonal_adjustment": {
       "description": "Seasonal adjustment status.",
       "type": "string"
      },
      "title": {
       "description": "Series title.",
       "type": "string"
      },
      "units": {
       "description": "Units of measurement.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "units",
      "frequency",
      "seasonal_adjustment",
      "last_updated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalCount": {
    "description": "Total matching series count before pagination was applied.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search FRED Series"
}
