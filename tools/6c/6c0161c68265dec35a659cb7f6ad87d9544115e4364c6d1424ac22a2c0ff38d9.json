{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "DORA Metrics Calculator"
 },
 "description": "Use this when a user wants to benchmark an engineering team against DORA metrics. Takes deploys per month, lead time in hours, change failure rate in percent and, optionally, time to restore in hours. Classifies each metric as elite, high, medium or low against fixed benchmark bands; an omitted restore time is reported as unknown and the overall profile is marked partial rather than assumed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "change_failure_pct": {
    "description": "Share of deployments that cause a failure in production, in percent.",
    "examples": [
     15
    ],
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "deploys_per_month": {
    "description": "Production deployments per month.",
    "examples": [
     20
    ],
    "minimum": 0,
    "type": "number"
   },
   "lead_time_hours": {
    "description": "Lead time for changes, commit to production, in hours.",
    "examples": [
     24
    ],
    "minimum": 0,
    "type": "number"
   },
   "restore_time_hours": {
    "description": "Time to restore service after a failed change, in hours. Optional; when omitted the metric is reported as unknown.",
    "examples": [
     4
    ],
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "deploys_per_month",
   "lead_time_hours",
   "change_failure_pct"
  ],
  "type": "object"
 },
 "name": "dora-metrics-calculator",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affiliate_context": {
