{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Redacta el burofax de un caso (ver listar_casos) a partir de los datos. Devuelve el texto, el sem\u00e1foro de requisitos y un token de borrador que enviar_burofax puede usar. No env\u00eda ni cobra.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "caso": {
    "description": "slug del caso, de listar_casos",
    "enum": [
     "burofax-masc",
     "burofax-fin-contrato-alquiler",
     "burofax-impago-alquiler",
     "reclamar-fianza-alquiler",
     "burofax-reclamacion-deuda",
     "burofax-impago-comunidad",
     "carta-baja-permanencia",
     "burofax-reclamacion-aseguradora",
     "burofax-garantia-desistimiento",
     "burofax-reclamacion-cantidad-laboral",
     "burofax-vecino-ruidos-humedades",
     "burofax-reclamar-obra-reforma-taller"
    ],
    "type": "string"
   },
   "datos": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Respuestas por clave (ver datos de listar_casos). Fechas AAAA-MM-DD, importes solo n\u00famero.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "email": {
    "description": "Email del remitente: recibe el enlace al borrador y la evidencia",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "caso",
   "datos",
   "email"
  ],
  "type": "object"
 },
 "name": "redactar_burofax",
 "title": "Redactar un burofax con los datos del caso"
}
