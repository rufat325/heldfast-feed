{
 "description": "List discount codes in the workspace. Filter by enabled, type, or a code search; paginated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "enabled": {
    "type": "boolean"
   },
   "limit": {
    "default": 25,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "search": {
    "description": "Substring match on the code",
    "type": "string"
   },
   "type": {
    "enum": [
     "percentage",
     "fixed",
     "free_shipping"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_discounts"
}
