{
 "annotations": {
  "readOnlyHint": true,
  "title": "List reports"
 },
 "description": "List campaign reports (aggregate performance for sent campaigns). Paginated, with an optional type filter. REST: GET /reports.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "count": {
    "description": "Records to return (Mailchimp `count`; default 10, max 1000).",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "offset": {
    "description": "Number of records to skip (Mailchimp `offset`, for pagination).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "Filter reports by campaign type (Mailchimp `type`).",
    "enum": [
     "regular",
     "plaintext",
     "absplit",
     "rss",
     "variate"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mailchimp_list_reports",
 "title": "List reports"
}
