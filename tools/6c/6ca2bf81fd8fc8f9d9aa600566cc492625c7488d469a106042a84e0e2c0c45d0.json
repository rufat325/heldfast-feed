{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List authenticated Thalovant memory items.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiUrl": {
    "description": "Control-plane base URL. Configured credentials may only be used on their configured origin; defaults to https://api.thalovant.com.",
    "format": "uri",
    "type": "string"
   },
   "hubId": {
    "minLength": 1,
    "type": "string"
   },
   "includeDeleted": {
    "type": "boolean"
   },
   "includeExpired": {
    "type": "boolean"
   },
   "kind": {
    "enum": [
     "note",
     "preference",
     "fact"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Page size, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "loginScope": {
    "description": "Optional login scope used with THALOVANT_EMAIL and THALOVANT_PASSWORD.",
    "minLength": 1,
    "type": "string"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "ownerId": {
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "maxLength": 240,
    "minLength": 1,
    "type": "string"
   },
   "scope": {
    "enum": [
     "personal",
     "workspace",
     "hub"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "thalovant_list_memory_items",
 "title": "List Memory Items"
}
