{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Inspect BrowserMesh runtime"
 },
 "description": "Report bounded, read-only BrowserMesh version, launch state, effective configuration, and session counts without launching Chromium. Use this to diagnose setup and capacity safely; it never returns paths, launch arguments, environment values, browser state, or raw errors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "browser_runtime_info",
 "outputSchema": {
  "$defs": {
   "shared0": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "activeSessions": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "browserLaunchState": {
    "enum": [
     "not_started",
     "ready",
     "failed"
    ],
    "type": "string"
   },
   "browserProduct": {
    "const": "chromium",
    "type": "string"
   },
   "browserVersion": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "defaultTimeoutMs": {
    "$ref": "#/$defs/shared0"
   },
   "failedSessions": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "headless": {
    "type": "boolean"
   },
   "maxPagesPerSession": {
    "$ref": "#/$defs/shared0"
   },
   "maxSessions": {
    "$ref": "#/$defs/shared0"
   },
   "nodeVersion": {
    "minLength": 1,
    "type": "string"
   },
   "persistenceEnabled": {
    "type": "boolean"
   },
   "playwrightVersion": {
    "minLength": 1,
    "type": "string"
   },
   "resourceLimits": {
    "additionalProperties": false,
    "properties": {
     "persistence": {
      "additionalProperties": false,
      "properties": {
       "maxStateBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxStates": {
        "$ref": "#/$defs/shared0"
       },
       "maxTotalBytes": {
        "$ref": "#/$defs/shared0"
       }
      },
      "required": [
       "maxStates",
       "maxStateBytes",
       "maxTotalBytes"
      ],
      "type": "object"
     },
     "screenshot": {
      "additionalProperties": false,
      "properties": {
       "maxBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxDimensionPixels": {
        "$ref": "#/$defs/shared0"
       },
       "maxPixels": {
        "$ref": "#/$defs/shared0"
       }
      },
      "required": [
       "maxDimensionPixels",
       "maxPixels",
       "maxBytes"
      ],
      "type": "object"
     },
     "session": {
      "additionalProperties": false,
      "properties": {
       "maxMetadataBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxMetadataEntries": {
        "$ref": "#/$defs/shared0"
       },
       "maxMetadataKeyBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxMetadataKeyChars": {
        "$ref": "#/$defs/shared0"
       },
       "maxMetadataValueBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxMetadataValueChars": {
        "$ref": "#/$defs/shared0"
       },
       "maxNameBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxNameChars": {
        "$ref": "#/$defs/shared0"
       }
      },
      "required": [
       "maxNameChars",
       "maxNameBytes",
       "maxMetadataEntries",
       "maxMetadataKeyChars",
       "maxMetadataKeyBytes",
       "maxMetadataValueChars",
       "maxMetadataValueBytes",
       "maxMetadataBytes"
      ],
      "type": "object"
     },
     "visibleText": {
      "additionalProperties": false,
      "properties": {
       "maxBytes": {
        "$ref": "#/$defs/shared0"
       },
       "maxChars": {
        "$ref": "#/$defs/shared0"
       }
      },
      "required": [
       "maxChars",
       "maxBytes"
      ],
      "type": "object"
     }
    },
    "required": [
     "session",
     "screenshot",
     "visibleText",
     "persistence"
    ],
    "type": "object"
   },
   "serverVersion": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "serverVersion",
   "nodeVersion",
   "playwrightVersion",
   "browserProduct",
   "browserVersion",
   "browserLaunchState",
   "headless",
   "persistenceEnabled",
   "defaultTimeoutMs",
   "maxSessions",
   "maxPagesPerSession",
   "resourceLimits",
   "activeSessions",
   "failedSessions"
  ],
  "type": "object"
 },
 "title": "Inspect BrowserMesh runtime"
}
