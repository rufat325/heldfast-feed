{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free verification of an execution event and its unchanged receipt returned by issue_agent_receipt. Checks signature, scope and event commitment against this issuer. No wallet or new issuance required. Use verify_proof_receipt for the distinct common proof-envelope format. A valid signature does not independently prove execution; compare original bytes locally.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "event": {
    "additionalProperties": false,
    "description": "Commitment-only declaration of one execution step.",
    "properties": {
     "agentId": {
      "description": "Identifier of the declaring agent, not an independently verified identity.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "completedAt": {
      "description": "Declared completion in UTC with milliseconds, at or after start.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "inputHash": {
      "additionalProperties": false,
      "description": "SHA-256 of the exact input bytes, computed locally. Never send raw input.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Hash algorithm.",
        "type": "string"
       },
       "digest": {
        "description": "64 lowercase hexadecimal characters; SHA-256 of exact bytes.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "outcome": {
      "description": "Outcome declared by the caller; Datoka does not observe execution.",
      "enum": [
       "success",
       "error"
      ],
      "type": "string"
     },
     "outputHash": {
      "additionalProperties": false,
      "description": "SHA-256 of exact output bytes, computed locally. Never send raw output.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Hash algorithm.",
        "type": "string"
       },
       "digest": {
        "description": "64 lowercase hexadecimal characters; SHA-256 of exact bytes.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "runId": {
      "description": "Stable identifier for this execution run.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "startedAt": {
      "description": "Declared start time in UTC, with milliseconds.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "stepId": {
      "description": "Stable identifier of the step within the run.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "tool": {
      "description": "Tool or operation identifier declared by the caller.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "version": {
      "const": "datoka.agent.execution.v1",
      "description": "Declaration format version; preserve this literal.",
      "type": "string"
     }
    },
    "required": [
     "version",
     "agentId",
     "runId",
     "stepId",
     "tool",
     "outcome",
     "startedAt",
     "completedAt",
     "inputHash",
     "outputHash"
    ],
    "type": "object"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Signed Datoka receipt; verify against independently trusted keys.",
    "properties": {
     "algorithm": {
      "const": "Ed25519",
      "type": "string"
     },
     "body": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "issuedAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
        "type": "string"
       },
       "issuer": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
       },
       "keyId": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
       },
       "previous": {
        "anyOf": [
         {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "request": {
        "additionalProperties": false,
        "properties": {
         "chain": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
         },
         "eventType": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
         },
         "scope": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
         },
         "subject": {
          "additionalProperties": false,
          "properties": {
           "algorithm": {
            "const": "sha256",
            "type": "string"
           },
           "digest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
           },
           "encoding": {
            "enum": [
             "jcs",
             "bytes"
            ],
            "type": "string"
           }
          },
          "required": [
           "algorithm",
           "encoding",
           "digest"
          ],
          "type": "object"
         }
        },
        "required": [
         "scope",
         "chain",
         "eventType",
         "subject"
        ],
        "type": "object"
       },
       "sequence": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "version": {
        "const": "datoka.receipt.v1",
        "type": "string"
       }
      },
      "required": [
       "version",
       "id",
       "issuer",
       "keyId",
       "issuedAt",
       "request",
       "sequence",
       "previous"
      ],
      "type": "object"
     },
     "signature": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "type": "string"
     }
    },
    "required": [
     "body",
     "algorithm",
     "signature"
    ],
    "type": "object"
   }
  },
  "required": [
   "event",
   "receipt"
  ],
  "type": "object"
 },
 "name": "verify_agent_receipt",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "Identifier of the declaring agent, not an independently verified identity.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "attestation": {
    "const": "signed_declaration",
    "type": "string"
   },
   "receiptId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "runId": {
    "description": "Stable identifier for this execution run.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "scope": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "stepId": {
    "description": "Stable identifier of the step within the run.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "valid": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "receiptId",
   "scope",
   "agentId",
   "runId",
   "stepId",
   "attestation"
  ],
  "type": "object"
 },
 "title": "Verify Agent Receipt"
}
