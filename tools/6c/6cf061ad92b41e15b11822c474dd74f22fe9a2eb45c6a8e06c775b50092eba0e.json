{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate AI-powered platform-optimized content without publishing.\n\nUses AI to create platform-specific text, hashtags, and titles from a prompt or media URL.\nRespects brand voice profiles if configured.\n\nReturns generated content variants for each target platform. Use publish_content to publish the generated content, or publish_ai to generate and publish in one step.",
 "inputSchema": {
  "properties": {
   "contentOverrides": {
    "description": "Manual overrides for generated content",
    "properties": {
     "caption": {
      "description": "Override generated caption",
      "type": "string"
     },
     "hashtags": {
      "description": "Override generated hashtags",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "description": "Override generated title",
      "type": "string"
     }
    },
    "type": "object"
   },
   "generation": {
    "description": "Generation parameters for tone, style, and CTA",
    "properties": {
     "callToAction": {
      "description": "Call to action to include",
      "type": "string"
     },
     "style": {
      "description": "Content style",
      "enum": [
       "storytelling",
       "promotional",
       "educational",
       "entertaining"
      ],
      "type": "string"
     },
     "tone": {
      "description": "Content tone",
      "enum": [
       "professional",
       "casual",
       "energetic",
       "informative"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "hashtags": {
    "description": "Hashtag mode",
    "enum": [
     "on",
     "off",
     "platform_auto"
    ],
    "type": "string"
   },
   "mediaUrl": {
    "description": "Media URL to analyze for content generation",
    "type": "string"
   },
   "platforms": {
    "description": "Target platforms to generate content for",
    "items": {
     "enum": [
      "x",
      "linkedin",
      "linkedin-page",
      "facebook",
      "instagram",
      "threads",
      "bluesky",
      "mastodon",
      "nostr",
      "youtube",
      "tiktok",
      "lemmy",
      "discord",
      "slack",
      "telegram",
      "pinterest",
      "dribbble",
      "devto",
      "hashnode",
      "gmb",
      "whop",
      "producthunt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "prompt": {
    "description": "Creative prompt or topic for content generation",
    "type": "string"
   },
   "strictAi": {
    "description": "If true, fail instead of using fallback templates when AI is unavailable",
    "type": "boolean"
   }
  },
  "required": [
   "platforms"
  ],
  "type": "object"
 },
 "name": "generate_content",
 "title": "Generate AI Content"
}
