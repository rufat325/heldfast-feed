{
 "description": "Analyze deal outcomes to identify patterns, improve win rates, and refine sales strategy. Works with single deals or deal portfolios.",
 "inputSchema": {
  "properties": {
   "analysis_type": {
    "description": "Type of analysis",
    "enum": [
     "single_deal",
     "deal_portfolio",
     "competitor_analysis",
     "loss_pattern"
    ],
    "type": "string"
   },
   "competitor_won": {
    "description": "Competitor who won (if applicable)",
    "type": "string"
   },
   "deal_details": {
    "description": "Deal details - can be rough notes, CRM export, or structured data",
    "type": "string"
   },
   "deal_outcome": {
    "description": "Deal outcome for single deal analysis",
    "enum": [
     "won",
     "lost",
     "no_decision",
     "mixed"
    ],
    "type": "string"
   },
   "deal_value": {
    "description": "Deal value",
    "type": "number"
   },
   "loss_reason": {
    "description": "Stated loss reason (for lost deals)",
    "type": "string"
   },
   "multiple_deals": {
    "description": "For portfolio analysis: summary of multiple deals",
    "type": "string"
   },
   "sales_cycle_days": {
    "description": "Length of sales cycle",
    "type": "number"
   },
   "stakeholders_involved": {
    "description": "Key stakeholders and their positions",
    "type": "string"
   },
   "your_solution": {
    "description": "What you were selling",
    "type": "string"
   }
  },
  "required": [
   "analysis_type"
  ],
  "type": "object"
 },
 "name": "win_loss_analyzer"
}
