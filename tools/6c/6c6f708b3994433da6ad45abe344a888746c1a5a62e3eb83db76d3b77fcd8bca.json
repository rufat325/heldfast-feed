{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search ABCommunity resources"
 },
 "description": "Search ABCommunity's catalog of 12,000+ AI resources (MCP servers, tools, skills, APIs, libraries, frameworks). Filter by capabilities, resource type, supported client/platform, pricing, deployment (remote/local), open-source and verified status. Returns ranked resources with human-readable match quality and source links.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "description": "Capability keys, e.g. ['email.read','project.task.create']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deployment": {
    "enum": [
     "remote",
     "local"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "official": {
    "type": "boolean"
   },
   "open_source": {
    "type": "boolean"
   },
   "platform": {
    "description": "Supported client, e.g. claude, claude-code, cursor, vscode",
    "type": "string"
   },
   "pricing": {
    "description": "free | freemium | paid",
    "type": "string"
   },
   "query": {
    "description": "Free-text search query",
    "type": "string"
   },
   "resource_type": {
    "description": "e.g. mcp, tool, skill, api, library, framework",
    "type": "string"
   },
   "verified": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_resources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Search ABCommunity resources"
}
