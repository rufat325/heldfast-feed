{
 "description": "Create a HappyHorse task on RunAPI (text to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "enum": [
     "16:9",
     "9:16",
     "1:1",
     "4:3",
     "3:4"
    ],
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "duration_seconds": {
    "type": "number"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "happyhorse-1.0-r2v",
     "happyhorse-1.0-t2v",
     "happyhorse-character",
     "happyhorse-text-to-video"
    ],
    "type": "string"
   },
   "output_resolution": {
    "enum": [
     "720p",
     "1080p"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "reference_image_urls": {
    "items": {},
    "type": "array"
   },
   "seed": {
    "type": "number"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "text_to_video"
}
