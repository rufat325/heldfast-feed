{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Stocks"
 },
 "description": "Searches stocks by ticker or company name and returns canonical security identities.\n\nWHEN TO USE: The user asks to find stocks, a company name is ambiguous, or a workflow specifically needs the canonical CUSIP.\n\nWHEN NOT TO USE:\n  - Call analyze_stock directly for an ordinary ticker or CUSIP\n  - Use find_signals when screening across stocks rather than resolving a single name\n\nRETURNS: Up to the requested limit (maximum 10) of matching securities, each with CUSIP + ticker + issuer + sector + listing status.\n\nVERIFICATION: Cite record-level `source_url` filing or disclosure links when present.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_securities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "additionalProperties": false,
    "properties": {
     "limited_fields": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "tier": {
      "type": "string"
     },
     "upgrade_url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "tier",
     "limited_fields"
    ],
    "type": "object"
   },
   "data_status": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "const": false,
      "type": "boolean"
     },
     "message": {
      "type": "string"
     },
     "missing": {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "complete",
     "missing"
    ],
    "type": "object"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "data_through": {
      "type": [
       "string",
       "null"
      ]
     },
     "source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cusip": {
       "type": "string"
      },
      "issuer_name": {
       "type": "string"
      },
      "listing_status": {
       "type": [
        "string",
        "null"
       ]
      },
      "match_type": {
       "enum": [
        "exact_cusip",
        "exact_ticker",
        "exact_name",
        "prefix",
        "contains"
       ],
       "type": "string"
      },
      "sector": {
       "type": [
        "string",
        "null"
       ]
      },
      "ticker": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "cusip",
      "ticker",
      "issuer_name",
      "match_type",
      "sector",
      "listing_status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Stocks"
}
