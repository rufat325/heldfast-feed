{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Daily historical series for charting \u2014 one metal or the Goldback.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "base": {
    "default": "USD",
    "description": "A currency code from the live catalog at /api/currencies (ISO 4217 fiat plus BTC and the metal codes). Defaults to USD.",
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "Opaque continuation token returned by the same tool with exactly the same filters.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "days": {
    "default": 90,
    "description": "How many trailing days of history to return.",
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   },
   "format": {
    "default": "line",
    "description": "ohlc returns open/high/low/close rows; line returns closes.",
    "enum": [
     "line",
     "ohlc"
    ],
    "type": "string"
   },
   "limit": {
    "default": 90,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "metal": {
    "description": "The metal (or Goldback) whose history to return.",
    "enum": [
     "gold",
     "silver",
     "platinum",
     "palladium",
     "copper",
     "nickel",
     "goldback"
    ],
    "type": "string"
   }
  },
  "required": [
   "metal"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "base": {
        "minLength": 1,
        "type": "string"
       },
       "endDate": {
        "format": "date",
        "type": "string"
       },
       "format": {
        "const": "line",
        "type": "string"
       },
       "nextCursor": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "points": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "date": {
           "format": "date",
           "type": "string"
          },
          "price": {
           "type": "number"
          }
         },
         "required": [
          "date",
          "price"
         ],
         "type": "object"
        },
        "maxItems": 100,
        "type": "array"
       },
       "requestedDays": {
        "maximum": 3650,
        "minimum": 1,
        "type": "integer"
       },
       "series": {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "metal",
          "type": "string"
         },
         "metal": {
          "enum": [
           "gold",
           "silver",
           "platinum",
           "palladium",
           "copper",
           "nickel",
           "goldback"
          ],
          "type": "string"
         }
        },
        "required": [
         "kind",
         "metal"
        ],
        "type": "object"
       },
       "startDate": {
        "format": "date",
        "type": "string"
       },
       "unit": {
        "enum": [
         "troy_oz",
         "goldback"
        ],
        "type": "string"
       }
      },
      "required": [
       "series",
       "base",
       "unit",
       "requestedDays",
       "startDate",
       "endDate",
       "nextCursor",
       "format",
       "points"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "base": {
        "minLength": 1,
        "type": "string"
       },
       "endDate": {
        "format": "date",
        "type": "string"
       },
       "format": {
        "const": "ohlc",
        "type": "string"
       },
       "nextCursor": {
        "anyOf": [
         {
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "points": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "close": {
           "description": "Latest or session-close price in the result's shared base and unit.",
           "type": "number"
          },
          "date": {
           "format": "date",
           "type": "string"
          },
          "high": {
           "description": "Session high in the result's shared base and unit.",
           "type": "number"
          },
          "low": {
           "description": "Session low in the result's shared base and unit.",
           "type": "number"
          },
          "open": {
           "description": "Opening price in the result's shared base and unit.",
           "type": "number"
          }
         },
         "required": [
          "open",
          "high",
          "low",
          "close",
          "date"
         ],
         "type": "object"
        },
        "maxItems": 100,
        "type": "array"
       },
       "requestedDays": {
        "maximum": 3650,
        "minimum": 1,
        "type": "integer"
       },
       "series": {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "metal",
          "type": "string"
         },
         "metal": {
          "enum": [
           "gold",
           "silver",
           "platinum",
           "palladium",
           "copper",
           "nickel",
           "goldback"
          ],
          "type": "string"
         }
        },
        "required": [
         "kind",
         "metal"
        ],
        "type": "object"
       },
       "startDate": {
        "format": "date",
        "type": "string"
       },
       "unit": {
        "enum": [
         "troy_oz",
         "goldback"
        ],
        "type": "string"
       }
      },
      "required": [
       "series",
       "base",
       "unit",
       "requestedDays",
       "startDate",
       "endDate",
       "nextCursor",
       "format",
       "points"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Historical price series"
}
