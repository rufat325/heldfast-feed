    "type": "string"
   },
   "locale": {
    "description": "Locale code for localized URLs (e.g. 'en', 'pl', 'de')",
    "maxLength": 5,
    "type": "string"
   },
   "product_handle": {
    "description": "Product handle for competitor comparison (defaults to 'the-legacy-print')",
