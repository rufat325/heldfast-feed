{
 "annotations": {
  "openWorldHint": false,
  "title": "Memory Ingest"
 },
 "description": "Ingest a full document: automatically chunks it based on content type (text, markdown, code, legal), embeds each chunk, and stores with provenance. Use this for large documents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access_level": {
    "description": "Access classification level",
    "enum": [
     "public",
     "internal",
     "confidential",
     "restricted"
    ],
    "type": "string"
   },
   "author": {
    "description": "Who created this content",
    "type": "string"
   },
   "chunk_overlap": {
    "default": 50,
    "description": "Overlap between chunks in characters for context preservation",
    "maximum": 500,
    "minimum": 0,
    "type": "integer"
   },
   "chunk_size": {
    "default": 512,
    "description": "Target chunk size in characters (~4 chars per token)",
    "maximum": 4096,
    "minimum": 100,
    "type": "integer"
   },
   "content": {
    "description": "Full document content to ingest",
    "maxLength": 1000000,
    "minLength": 1,
    "type": "string"
   },
   "content_type": {
    "default": "text",
    "description": "Content type determines chunking strategy",
    "enum": [
     "text",
     "markdown",
     "code",
     "legal",
     "structured"
    ],
    "type": "string"
   },
   "department": {
    "description": "Department (e.g., legal, engineering, hr, sales, finance)",
    "type": "string"
   },
   "document_type": {
    "description": "Type of document (e.g., contract, policy, code, incident, decision)",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Domain-specific metadata (e.g., {contract_type: 'NDA', parties: ['A','B']})",
    "type": "object"
   },
   "namespace": {
    "description": "Namespace within scope (e.g., project name, team name)",
    "type": "string"
   },
   "scope": {
    "default": "global",
    "description": "Memory scope for isolation",
    "enum": [
     "global",
     "project",
     "user",
     "team",
     "department"
    ],
    "type": "string"
   },
   "source": {
    "description": "Origin of the content (e.g., file path, URL, system name)",
    "type": "string"
   },
   "tags": {
    "description": "Tags for categorization",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Document title",
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "memory_ingest"
}
