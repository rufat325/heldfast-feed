{
 "_meta": {
  "fastmcp": {
   "tags": [
    "news"
   ]
  }
 },
 "description": "Use when the user wants to see the news-feed view: markets that exhibited a probability spike in the chosen lookback window, scored by `|\u0394prob_pp| \u00d7 log10(1+USD-equivalent volume)`. Refreshed after each Polymarket ingest cycle, typically every 15-20 min. The `window=` param selects the lookback: 24 (default, \u226515pp), 12 (\u226512pp), or 2 (\u22652h, \u226510pp); `prob_change` is measured over that window. Includes a `prob_history` array (24h bucketed trajectory) per row regardless of window. Filterable by `source=` and `categories=` (CSV). Soft flags (`is_entertainment`/`is_microprediction`/`is_crypto`/`is_sports`/`is_weather`) default OFF; opt in with `include_*=true`.",
 "inputSchema": {
  "properties": {
   "categories": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Category filter (CSV). Examples: 'Politics', 'Sports', 'Crypto', 'Weather'. Maps to events.categories assignments.",
    "title": "Categories"
   },
   "include_crypto": {
    "default": false,
    "description": "Include crypto price-derivative markets (default: excluded).",
    "title": "Include Crypto",
    "type": "boolean"
   },
   "include_entertainment": {
    "default": false,
    "description": "Include entertainment markets (default: excluded for signal-to-noise).",
    "title": "Include Entertainment",
    "type": "boolean"
   },
   "include_microprediction": {
    "default": false,
    "description": "Include microprediction / hyperlocal markets (default: excluded).",
    "title": "Include Microprediction",
    "type": "boolean"
   },
   "include_resolved": {
    "default": false,
    "description": "Include resolved (closed) markets (default: excluded \u2014 news movers focus on live markets).",
    "title": "Include Resolved",
    "type": "boolean"
   },
   "include_sports": {
    "default": false,
    "description": "Include sports markets (default: excluded).",
    "title": "Include Sports",
    "type": "boolean"
   },
   "include_weather": {
    "default": false,
    "description": "Include weather markets (default: excluded).",
    "title": "Include Weather",
    "type": "boolean"
   },
   "min_score": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum spike score. Higher = more notable spikes only.",
    "title": "Min Score"
   },
   "ordering": {
    "default": "vol",
    "description": "Sort order. Allowed values: `vol` (volume-weighted score; default), `score` (raw spike score), `prob` (probability change magnitude).",
    "title": "Ordering",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "minimum": 1.0,
    "title": "Page",
    "type": "integer"
   },
   "page_size": {
    "default": 50,
    "description": "Items per page (1-200; default 50).",
    "maximum": 200.0,
    "minimum": 1.0,
    "title": "Page Size",
    "type": "integer"
   },
   "q": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Full-text search across market title and event title. Case-insensitive substring match.",
    "title": "Q"
   },
   "source": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Platform ID(s); single value or comma-separated list. Allowed: polymarket, kalshi, manifold, myriad, limitless, predict, opinion, gemini.",
    "title": "Source"
   },
   "window": {
    "description": "Lookback windows the carousel selector exposes (hours). An IntEnum\n(not Literal[2,12,24]) because FastAPI coerces a query STRING to an\nIntEnum member but NOT to an int literal \u2014 `?window=24` would 422\nagainst a Literal even though the Python default 24 validates.",
    "enum": [
     2,
     12,
     24
    ],
    "title": "SpikeWindow",
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_news_movers",
 "outputSchema": {
  "$defs": {
   "NewsCluster": {
    "description": "A cluster of news events that share a specific topical tag.\n\nBuilt per-source from the parent event's `tags` array (currently\nPolymarket-only \u2014 other sources don't reliably populate tags).\nPicked tag is the rarest globally that's also shared by at least\ntwo events in the news feed; the cluster's `cluster_label` is\nthat tag's `label` field as published by Polymarket.\n\n`events` is the member event list sorted by score desc. The\nFE renders the cluster as a 3-level structure:\n  cluster header \u2192 up to N events \u2192 each event's gainer/loser.",
    "properties": {
     "cluster_key": {
      "title": "Cluster Key",
      "type": "string"
     },
     "cluster_label": {
      "title": "Cluster Label",
      "type": "string"
     },
     "cluster_slug": {
      "title": "Cluster Slug",
      "type": "string"
     },
     "events": {
      "items": {
       "$ref": "#/$defs/NewsEventOut"
      },
      "title": "Events",
      "type": "array"
     },
     "image": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Image"
     },
     "kind": {
      "const": "cluster",
      "default": "cluster",
      "title": "Kind",
      "type": "string"
     },
     "score": {
      "title": "Score",
      "type": "number"
     },
     "source": {
      "title": "Source",
      "type": "string"
     },
     "src": {
      "enum": [
       "pm",
       "ka",
       "ma",
       "li",
       "op",
       "pr",
       "my",
       "gm"
      ],
      "title": "Src",
      "type": "string"
     },
     "total_vol_24hr": {
      "title": "Total Vol 24Hr",
      "type": "number"
     }
    },
    "required": [
     "cluster_key",
     "cluster_label",
     "cluster_slug",
     "source",
     "src",
     "total_vol_24hr",
     "score",
     "events"
