 "description": "Use this when the user wants to see, display, keep, copy or export the line-by-line employer cost of one employee in a country as a table or card (e.g. \"show me the breakdown\", \"display it as a table\", \"affiche le d\u00e9tail des cotisations patronales\"). It computes the figures itself: call it directly, with no data tool first, or after employer_cost with the arguments employer_cost returns in `widget`. Displays the salary basis (a monthly salary times the statutory number of payments), one row per statutory line with its rate, base, floor or ceiling, source and check date, a monthly or annual view, a salary field to recalculate, and a CSV copy. Takes the same country, salary and assumptions as employer_cost. Data snapshot 2026-10-13. Cost comparison, not legal or tax advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Override an adjustable assumption the country declares, e.g. {\"basic_share_of_gross\": 0.6}. See `assumptions` in an employer_cost answer.",
    "type": "object"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code (\"DE\") or country name (\"Germany\")",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "payments_per_year": {
    "description": "With salary_period \"month\" only: the total number of monthly salaries the contract pays in a year, statutory ones included (e.g. 14). Omit to use the statutory number of the country.",
    "maximum": 16,
    "minimum": 12,
    "type": "number"
   },
   "salary": {
    "description": "Gross salary, a year unless salary_period is \"month\". Omit to use the country's example salary.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "salary_currency": {
    "default": "USD",
    "description": "Currency of `salary`: USD, or the local currency of the country",
    "enum": [
     "USD",
     "local"
    ],
    "type": "string"
   },
   "salary_period": {
    "default": "year",
    "description": "Whether the salary is a year (default) or a month. Pass a monthly salary as the user gives it, with \"month\": the statutory number of monthly payments of the country (13th, 14th month) is applied, see salary_basis in the answer.",
    "enum": [
     "year",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
