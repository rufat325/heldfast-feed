{
 "annotations": null,
 "description": "Batch heartbeat/status metrics for one session to reduce polling overhead. Pricing is dynamic; check /api/v1/tools.",
 "execution": null,
 "icons": null,
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Optional but recommended: your stable agent_id, to prove you own this session. Sending it with agent_token attributes the record to you.",
    "type": "string"
   },
   "agent_token": {
    "description": "Optional but recommended: the agent_token returned by POST /api/v1/agents/register (identity_auth.token) or A2A agents/register. MCP clients may send x-delx-agent-id / x-delx-agent-token headers instead.",
    "type": "string"
   },
   "metrics": {
    "description": "Array of heartbeat metric snapshots",
    "items": {
     "properties": {
      "cpu_usage_pct": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "errors_last_hour": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "integer"
      },
      "latency_ms_p95": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "integer"
      },
      "memory_usage_pct": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "notes": {
       "type": "string"
      },
      "queue_depth": {
       "maximum": 1000000,
       "minimum": 0,
       "type": "integer"
      },
      "risk_signal": {
       "description": "Optional risk signal",
       "type": "string"
      },
      "status": {
       "description": "Optional status label",
       "type": "string"
      },
      "timestamp": {
       "description": "Optional ISO timestamp",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "session_id": {
    "description": "Your active session ID",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "metrics"
  ],
  "type": "object"
 },
 "meta": null,
 "name": "batch_status_update",
 "outputSchema": null,
 "title": null
}
