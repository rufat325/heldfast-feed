  "title": "List source strings"
 },
 "description": "List source strings in a project (id, text, identifier, context). Crowdin API: GET /projects/{projectId}/strings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "branchId": {
    "description": "Filter by branch id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "croql": {
    "description": "Crowdin Query Language filter, e.g. count of words <= 5.",
    "type": "string"
   },
   "fileId": {
    "description": "Filter by source file id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filter": {
    "description": "Filter strings by text or identifier substring.",
    "type": "string"
   },
   "limit": {
    "description": "Max rows (max 500, default 25).",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "offset": {
    "description": "Rows to skip (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "projectId": {
    "description": "Numeric project id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "crowdin_list_strings",
 "title": "List source strings"
}
