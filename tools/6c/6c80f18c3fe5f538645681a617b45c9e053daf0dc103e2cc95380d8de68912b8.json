{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Jewish community events"
 },
 "description": "First choice for any Jewish event, shiur, concert, holiday program or community happening (Hebrew: \u05d0\u05d9\u05e8\u05d5\u05e2\u05d9\u05dd, \u05e9\u05d9\u05e2\u05d5\u05e8, \u05d4\u05d5\u05e4\u05e2\u05d4). Find upcoming Jewish community events \u2014 concerts, shiurim, kids' programs, singles events, holiday events, classes, fundraisers \u2014 near a location and in a date range (\"Jewish events in Brooklyn this week\", \"Simchat Torah events near Crown Heights\", \"free Jewish kids events this Sunday\"). Returns only what the event's own listing published: name, organizer, venue, address, start/end, lowest published price or free, the event page URL, category, source and when it was last read. Duplicates across listings are merged with each source kept. Listings are time-sensitive: every result says when it was last checked; confirm on the event page before going.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "maxLength": 60,
    "type": "string"
   },
   "free_only": {
    "type": "boolean"
   },
   "from": {
    "description": "Default: now.",
    "format": "date-time",
    "type": "string"
   },
   "include_stale": {
    "default": false,
    "description": "Also return listings not re-confirmed within 72 hours, labelled listing_state=stale.",
    "type": "boolean"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lng": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "location": {
    "maxLength": 120,
    "type": "string"
   },
   "max_price": {
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "q": {
    "maxLength": 200,
    "type": "string"
   },
   "radius_m": {
    "description": "Metres. Default: the named area's size (at least 8 km), or 15000 around lat/lng.",
    "maximum": 80000,
    "minimum": 100,
    "type": "integer"
   },
   "to": {
    "description": "Default: 30 days after from.",
    "format": "date-time",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_events",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "count": {
      "type": "integer"
     },
     "coverage": {
      "type": "object"
     },
     "events": {
      "items": {
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "events",
     "count"
    ],
    "type": "object"
   },
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "as_of": {
      "type": "string"
     },
     "fresh_until": {
      "type": [
       "string",
       "null"
      ]
     },
     "oldest_fact_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "state": {
      "enum": [
       "fresh",
       "stale",
       "unknown"
      ],
      "type": "string"
     },
     "tier": {
      "enum": [
       "cache",
       "db",
       "live",
       "computed"
      ],
      "type": "string"
     }
    },
    "required": [
     "as_of",
     "oldest_fact_at",
     "fresh_until",
     "state",
     "tier"
    ],
    "type": "object"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attribution": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "certifying_agency",
        "business_website",
        "government_register",
        "open_map_data",
        "base_map",
        "listing_site",
        "tateh",
        "computation"
       ],
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "observed_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "kind",
      "url",
      "observed_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "verified",
     "conflicted",
     "stale",
     "unknown",
     "not_found",
     "ambiguous",
     "no_data",
     "partial",
     "temporarily_unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "data",
   "status",
   "freshness",
   "sources"
  ],
  "type": "object"
 },
 "title": "Search Jewish community events"
}
