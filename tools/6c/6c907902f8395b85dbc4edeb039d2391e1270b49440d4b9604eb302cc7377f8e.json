    "description": "Filter by destination bank country (ISO-2)",
    "type": "string"
   },
   "entity_type": {
    "description": "Filter by entity type",
    "enum": [
     "PERSONAL",
     "COMPANY"
    ],
    "type": "string"
   },
   "nickname": {
    "description": "Filter by friendly label",
    "type": "string"
   },
   "page_num": {
    "description": "Page index (0-based)",
    "type": "number"
   },
   "page_size": {
    "description": "Page size (default 20)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list_beneficiaries"
}
