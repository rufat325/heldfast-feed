{
 "description": "Append a task trace event (POST /v1/tasks/{task_id}/trace/events). Records only \u2014 no runtime veto.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advisory_claims": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Advisory scope claims; overreach vs contract write_set is recorded."
   },
   "decision": {
    "description": "Audit decision label e.g. \"allowed\".",
    "minLength": 1,
    "type": "string"
   },
   "delegation_id": {
    "description": "Delegation UUID from lithtrix_delegate.",
    "format": "uuid",
    "type": "string"
   },
   "evidence_json": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "additionalProperties": {},
        "type": "object"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional evidence blob."
   },
   "outcome": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Outcome label after action."
   },
   "proposed_action": {
    "description": "Audit label e.g. \"memory.put\".",
    "minLength": 1,
    "type": "string"
   },
   "scope_json": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "additionalProperties": {},
        "type": "object"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional scope snapshot."
   },
   "task_id": {
    "description": "Task UUID from lithtrix_delegate.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "proposed_action",
   "decision"
  ],
  "type": "object"
 },
 "name": "lithtrix_trace_append"
}
