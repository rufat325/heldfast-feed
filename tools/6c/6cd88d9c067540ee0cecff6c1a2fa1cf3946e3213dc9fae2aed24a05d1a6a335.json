{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a Studocu project title, emoji, or course. Use course_id null to clear the course and institution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "title"
    ]
   },
   {
    "required": [
     "emoji"
    ]
   },
   {
    "required": [
     "course_id"
    ]
   }
  ],
  "minProperties": 2,
  "properties": {
   "course_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "emoji": {
    "minLength": 1,
    "type": "string"
   },
   "project_id": {
    "description": "NOTE: These shared primitives are copied from the AI API spec and owned\nlocally by Agent OS to keep this contract decoupled.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "title": {
    "maxLength": 255,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "project_id"
  ],
  "type": "object"
 },
 "name": "update-project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "course_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "emoji": {
    "minLength": 1,
    "type": "string"
   },
   "institution_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "is_mobile": {
    "type": "boolean"
   },
   "project_id": {
    "description": "NOTE: These shared primitives are copied from the AI API spec and owned\nlocally by Agent OS to keep this contract decoupled.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "title": {
    "description": "Agent-displayable project title. Null Alpha names become \"Untitled project\".",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "title",
   "is_mobile",
   "emoji",
   "course_id",
   "institution_id"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
