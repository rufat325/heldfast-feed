{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Recent completed sales of an item on CSFloat, YouPin or Skinport with price, float, pattern (paint seed), stickers and keychains. Filter by float range or pattern. Requires an API key (Enterprise plan).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "float_max": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "float_min": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "limit": {
    "description": "Max sales returned (default 30)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "market_hash_name": {
    "minLength": 1,
    "type": "string"
   },
   "marketplace": {
    "enum": [
     "csfloat",
     "youpin",
     "skinport"
    ],
    "type": "string"
   },
   "paint_seed": {
    "description": "Pattern / paint seed filter",
    "items": {
     "type": "integer"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "market_hash_name"
  ],
  "type": "object"
 },
 "name": "get_recent_sales",
 "title": "Recent CS2 sales"
}
