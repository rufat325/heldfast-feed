{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true,"title":"Sky right now"},"description":"Shows where the Sun, Moon and planets are right now, or at a moment the person names, with the Moon's phase. Pass the person's time zone if you know it so times read on their clock. Astronomy only; it makes no personal prediction.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"bodies":{"items":{"enum":["Sun","Moon","Mercury","Venus","Mars","Jupiter","Saturn","Uranus","Neptune","Pluto","North Node","South Node"],"type":"string"},"maxItems":12,"minItems":1,"type":"array"},"instant":{"description":"A moment as an ISO 8601 time with Z or an offset, such as 2026-10-08T09:00:00+07:00 (years 1800\u20132199).","maxLength":29,"minLength":20,"type":"string"},"zone":{"description":"The person's time zone, such as Asia/Bangkok or America/New_York. Without it, times are in UTC.","maxLength":64,"minLength":1,"pattern":"^[A-Za-z][A-Za-z0-9_+-]*(?:\\/[A-Za-z0-9_+-]+){0,3}$","type":"string"}},"type":"object"},"name":"get_sky","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"calculation":{"additionalProperties":false,"properties":{"backend":{"properties":{"ephemeris":{"properties":{"name":{"const":"astronomy-engine"},"version":{"type":"string"}},"required":["name","version"],"type":"object"},"name":{"const":"@zodiacs/engine"},"version":{"type":"string"}},"required":["name","version","ephemeris"],"type":"object"},"cite":{"additionalProperties":false,"properties":{"engine":{"type":"string"},"receipt":{"type":"string"},"url":{"format":"uri","type":"string"},"version":{"type":"string"}},"required":["url","receipt","engine","version"],"type":"object"},"receipt":{"description":"The receipt for a calculati