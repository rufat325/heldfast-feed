{
 "description": "Capture screenshots of multiple URLs in a single request. Returns base64-encoded images. Maximum 5 URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dark_mode": {
    "description": "Enable dark mode emulation",
    "type": "boolean"
   },
   "disable_javascript": {
    "description": "Disable JavaScript execution on the page",
    "type": "boolean"
   },
   "format": {
    "description": "Image format (default: png)",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "full_page": {
    "description": "Capture full page scroll height",
    "type": "boolean"
   },
   "height": {
    "description": "Viewport height (default: 720)",
    "maximum": 2160,
    "minimum": 200,
    "type": "number"
   },
   "ignore_https_errors": {
    "description": "Ignore HTTPS/TLS certificate errors",
    "type": "boolean"
   },
   "latitude": {
    "description": "Geolocation latitude (-90 to 90)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "locale": {
    "description": "BCP 47 locale tag for the browser context (e.g., \"en-US\")",
    "type": "string"
   },
   "longitude": {
    "description": "Geolocation longitude (-180 to 180)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "timezone": {
    "description": "IANA timezone for the browser context (e.g., \"America/New_York\")",
    "type": "string"
   },
   "urls": {
    "description": "Array of URLs to screenshot (max 5)",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "wait_until": {
    "description": "Page load strategy (default: domcontentloaded). Use \"networkidle\" for SPAs.",
    "enum": [
     "commit",
     "domcontentloaded",
     "load",
     "networkidle"
    ],
    "type": "string"
   },
   "width": {
    "description": "Viewport width (default: 1280)",
    "maximum": 3840,
    "minimum": 320,
    "type": "number"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "batch_screenshot"
}
