{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search public catalog metadata and complete or selected passages with multilingual embeddings. Queries may be in any language. Evidence is grouped by bibliographic work and identifies one selected analysis language, original/translation status, source and coverage. Optional lexicalQueries provide BM25 terms in the selected analysis language. Catalog descriptions are not author quotations; partial book selection cannot establish thematic absence. Listing tools provide exhaustive bibliographies.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "authorIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "baselReferencePrefix": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "baselReferences": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "downloadFormats": {
      "items": {
       "enum": [
        "epub",
        "pdf",
        "mobi"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "full": {
      "type": "boolean"
     },
     "hasDownload": {
      "type": "boolean"
     },
     "hasExtractedText": {
      "type": "boolean"
     },
     "inOriginalLanguage": {
      "type": "boolean"
     },
     "includeSemantic": {
      "type": "boolean"
     },
     "isIndexed": {
      "type": "boolean"
     },
     "journalIds": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "journalScope": {
      "enum": [
       "original",
       "edition",
       "any"
      ],
      "type": "string"
     },
     "labelIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "originalLanguages": {
      "items": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "originalYearFrom": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "originalYearTo": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publicationIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "publicationLanguages": {
      "items": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "publicationTypes": {
      "items": {
       "enum": [
        "Mainwork",
        "Translation",
        "Anthology",
        "Article",
        "Contribution",
        "Preface",
        "Epilogue",
        "Letter",
        "EditedWork",
        "Excerpt"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "publicationYearFrom": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publicationYearTo": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publisherIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "reference": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "title": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "topicIds": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "translatorIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "workIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "workTypes": {
      "items": {
       "enum": [
        "Mainwork",
        "Translation",
        "Anthology",
        "Article",
        "Contribution",
        "Preface",
        "Epilogue",
        "Letter",
        "EditedWork"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "lexicalQueries": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "language": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "text": {
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "language",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "limit": {
    "default": 10,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_works",
 "title": "Find works by topic"
}
