{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "qr:manage"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a dynamic QR code for a public HTTP(S) destination. Supply a UUID request_key to safely retry authenticated creation. Anonymous creation is limited; ALWAYS show its returned claim_url to the user. Account creation uses existing plan limits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "design": {
    "properties": {
     "bg": {
      "pattern": "^#[a-f0-9]{6}$",
      "type": "string"
     },
     "fg": {
      "pattern": "^#[a-f0-9]{6}$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "destination": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "label": {
    "maxLength": 200,
    "type": "string"
   },
   "request_key": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "destination"
  ],
  "type": "object"
 },
 "name": "create_qr"
}
