{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Live Station channel for live streaming. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cdnDomain": {
    "description": "Existing Global Edge domain (required when createCdn=false)",
    "type": "string"
   },
   "cdnInstanceNo": {
    "description": "Existing Global Edge instance ID (required when createCdn=false)",
    "type": "number"
   },
   "cdnProfileId": {
    "description": "Global Edge profile ID",
    "type": "number"
   },
   "cdnRegionType": {
    "description": "CDN service region (required when createCdn=true)",
    "enum": [
     "KOREA",
     "JAPAN",
     "GLOBAL"
    ],
    "type": "string"
   },
   "channelName": {
    "description": "Channel name (3-20 chars, Korean/English/numbers/_)",
    "type": "string"
   },
   "createCdn": {
    "description": "Whether to create a new CDN (true) or use existing (false)",
    "type": "boolean"
   },
   "drmEnabledYn": {
    "default": false,
    "description": "Whether to enable Multi DRM",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating the channel",
    "type": "boolean"
   },
   "envType": {
    "default": "REAL",
    "description": "Channel environment type",
    "enum": [
     "REAL",
     "DEV",
     "STAGE"
    ],
    "type": "string"
   },
   "immediateOnAir": {
    "default": false,
    "description": "Auto-recording on stream start",
    "type": "boolean"
   },
   "isStreamFailOver": {
    "default": false,
    "description": "Whether to enable streaming redundancy",
    "type": "boolean"
   },
   "outputProtocol": {
    "default": "HLS",
    "description": "Output protocol: HLS, LL_HLS (low-latency), or HLS,DASH (both)",
    "enum": [
     "HLS",
     "LL_HLS",
     "HLS,DASH"
    ],
    "type": "string"
   },
   "qualitySetId": {
    "description": "Image quality setting ID (from quality settings list)",
    "type": "number"
   },
   "recordBucketName": {
    "description": "Recording storage bucket (required if recordType=AUTO_UPLOAD)",
    "type": "string"
   },
   "recordFilePath": {
    "description": "Recording storage path (required if recordType=AUTO_UPLOAD)",
    "type": "string"
   },
   "recordFormat": {
    "description": "Recording file format (required if recordType=AUTO_UPLOAD)",
    "enum": [
     "MP4",
     "HLS",
     "ALL"
    ],
    "type": "string"
   },
   "recordType": {
    "default": "NO_RECORD",
    "description": "Recording storage type",
    "enum": [
     "NO_RECORD",
     "AUTO_UPLOAD",
     "MANUAL_UPLOAD"
    ],
    "type": "string"
   },
   "timemachineMin": {
    "description": "Time machine allowance in minutes (360, required if useDvr=true)",
    "type": "number"
   },
   "useDvr": {
    "description": "Time machine (DVR) setting: true to enable rewind",
    "type": "boolean"
   }
  },
  "required": [
   "channelName",
   "createCdn",
   "cdnProfileId",
   "qualitySetId",
   "useDvr"
  ],
  "type": "object"
 },
 "name": "ncloud_livestation_create_channel"
}
