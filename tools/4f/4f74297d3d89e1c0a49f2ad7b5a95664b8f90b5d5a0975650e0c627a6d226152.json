{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Replaces the table of contents with the ordered list supplied; an empty list removes it.\n\n        Only the table of contents: every other reader setting stays with foliade_update_catalogue.\n        ",
 "inputSchema": {
  "$defs": {
   "Chapter": {
    "additionalProperties": false,
    "properties": {
     "page": {
      "minimum": 1,
      "title": "Page",
      "type": "integer"
     },
     "titre": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Titre",
      "type": "string"
     }
    },
    "required": [
     "titre",
     "page"
    ],
    "title": "Chapter",
    "type": "object"
   }
  },
  "properties": {
   "catalogue_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Catalogue Id",
    "type": "string"
   },
   "chapters": {
    "items": {
     "$ref": "#/$defs/Chapter"
    },
    "maxItems": 300,
    "title": "Chapters",
    "type": "array"
   },
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   }
  },
  "required": [
   "catalogue_id",
   "chapters",
   "expected_revision"
  ],
  "title": "set_chaptersArguments",
  "type": "object"
 },
 "name": "foliade_set_chapters",
 "title": "Configure the catalogue table of contents"
}
