{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new network interface. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessControlGroupNoList": {
    "description": "List of ACG numbers to apply",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating",
    "type": "boolean"
   },
   "networkInterfaceDescription": {
    "description": "Network interface description",
    "type": "string"
   },
   "networkInterfaceName": {
    "description": "Network interface name",
    "type": "string"
   },
   "privateIp": {
    "description": "Private IP address to assign",
    "type": "string"
   },
   "subnetNo": {
    "description": "Subnet number to create the network interface in",
    "type": "string"
   }
  },
  "required": [
   "subnetNo",
   "accessControlGroupNoList"
  ],
  "type": "object"
 },
 "name": "ncloud_create_network_interface"
}
