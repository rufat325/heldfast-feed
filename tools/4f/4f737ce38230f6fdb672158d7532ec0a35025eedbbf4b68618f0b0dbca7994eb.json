{
 "description": "Search Analytics con 1-3 dimensiones, filtros y paginaci\u00f3n; Google puede limitar filas.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dimensions": {
    "items": {
     "enum": [
      "date",
      "query",
      "page",
      "country",
      "device",
      "searchAppearance"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "endDate": {
    "description": "Fecha YYYY-MM-DD.",
    "format": "date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dimension": {
       "enum": [
        "query",
        "page",
        "country",
        "device",
        "searchAppearance"
       ],
       "type": "string"
      },
      "expression": {
       "type": "string"
      },
      "operator": {
       "enum": [
        "contains",
        "equals",
        "notContains",
        "notEquals",
        "includingRegex",
        "excludingRegex"
       ],
       "type": "string"
      }
     },
     "required": [
      "dimension",
      "operator",
      "expression"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "limit": {
    "maximum": 25000,
    "minimum": 1,
    "type": "integer"
   },
   "siteUrl": {
    "description": "URL exacta de la propiedad verificada.",
    "type": "string"
   },
   "startDate": {
    "description": "Fecha YYYY-MM-DD.",
    "format": "date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "startRow": {
    "maximum": 50000,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "enum": [
     "web",
     "image",
     "video",
     "news",
     "discover",
     "googleNews"
    ],
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "gsc_query_advanced"
}
