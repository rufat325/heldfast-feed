{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find a game by description"
 },
 "description": "Identify a game from a description of what the user remembers (plot, look, platform, era). Returns ranked candidates with a reason each, a `confidence`, and `find_game_url`: imho.run's /find-game page with the description filled in (the user presses the button; nothing runs by itself). Pass what the user said about the platform, the release years and the camera as `platform`, `year_min` / `year_max` and `perspective` instead of leaving them only in the text. When `confidence` is not high or no result fits, give the user `find_game_url` so they can add details there. Slow (LLM) and rate-limited: use it only when the user does not know the title; for games similar to a known game use games_like or recommend. Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "What the user remembers about the game, in their words.",
    "maxLength": 3000,
    "minLength": 12,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "perspective": {
    "description": "Camera: first person, third person, top-down or side view.",
    "enum": [
     "first",
     "third",
     "top_down",
     "side"
    ],
    "type": "string"
   },
   "platform": {
    "description": "Where the user played it, if they said (a platform family).",
    "enum": [
     "pc",
     "playstation",
     "xbox",
     "nintendo",
     "sega",
     "mobile",
     "browser",
     "arcade"
    ],
    "type": "string"
   },
   "year_max": {
    "description": "Latest plausible release year, if the user gave an era.",
    "maximum": 2035,
    "minimum": 1970,
    "type": "integer"
   },
   "year_min": {
    "description": "Earliest plausible release year, if the user gave an era.",
    "maximum": 2035,
    "minimum": 1970,
    "type": "integer"
   }
  },
  "required": [
   "description"
  ],
  "type": "object"
 },
 "name": "find_game_by_description",
