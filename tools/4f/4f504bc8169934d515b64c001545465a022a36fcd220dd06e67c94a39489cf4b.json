{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create or update a shared step \u2014 a block of steps written once and reused across cases. With `hash` it updates, without it creates; shared steps are identified by hash, which qase_case_upsert takes in a step's `shared` field. Updating changes every referencing case. Cost: one API call, about 0.5s.",
 "inputSchema": {
  "properties": {
   "code": {
    "description": "Project code, e.g. DEMO",
    "maxLength": 10,
    "minLength": 2,
    "pattern": "^[A-Z0-9_]+$",
    "type": "string"
   },
   "hash": {
    "description": "Shared step hash \u2014 if provided, updates; if omitted, creates",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "steps": {
    "description": "Array of step definitions",
    "items": {
     "properties": {
      "action": {
       "description": "Step action description",
       "type": "string"
      },
      "attachments": {
       "description": "Hashes from qase_attachment_upload",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "data": {
       "description": "Test data",
       "type": "string"
      },
      "expected_result": {
       "description": "Expected result",
       "type": "string"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Shared step title",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "code",
   "title"
  ],
  "type": "object"
 },
 "name": "qase_shared_step_upsert",
 "title": "Create or update shared step"
}
