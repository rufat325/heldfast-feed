{
 "description": "Report checkout outcome for an attribution_token (POST /v1/feedback). Mandatory data contract.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attribution_token": {
    "type": "string"
   },
   "basket_value": {
    "type": "number"
   },
   "code": {
    "type": "string"
   },
   "geo": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "worked",
     "expired",
     "ineligible",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "attribution_token",
   "outcome"
  ],
  "type": "object"
 },
 "name": "feedback"
}
