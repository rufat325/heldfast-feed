{
 "description": "Get detailed information about a specific version of an MCP server. Use \"latest\" as version to get the latest version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "serverName": {
    "description": "Server name (e.g., \"io.modelcontextprotocol/filesystem\")",
    "type": "string"
   },
   "version": {
    "description": "Version string (e.g., \"1.0.0\") or \"latest\" for the latest version",
    "type": "string"
   }
  },
  "required": [
   "serverName",
   "version"
  ],
  "type": "object"
 },
 "name": "get_server",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "icons": {
    "type": "array"
   },
   "metadata": {
    "additionalProperties": false,
    "properties": {
     "isLatest": {
      "type": "boolean"
     },
     "publishedAt": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "packages": {
    "type": "array"
   },
   "repository": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "subfolder": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "url",
     "source"
    ],
    "type": "object"
   },
   "title": {
    "type": "string"
   },
   "version": {
    "type": "string"
   },
   "websiteUrl": {
    "type": "string"
   }
  },
  "required": [
   "name",
   "description",
   "version"
  ],
  "type": "object"
 },
 "title": "Get Server Details"
}
