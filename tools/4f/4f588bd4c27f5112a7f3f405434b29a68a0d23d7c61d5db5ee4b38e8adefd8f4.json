{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add photo or video links"
 },
 "description": "Attach photos, videos, virtual tours, or documents to your post by link (https). Works for YouTube/Vimeo, Matterport, listing-site photos, shared-drive links, etc. Max 20 items per post.",
 "inputSchema": {
  "properties": {
   "links": {
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "properties": {
        "caption": {
         "type": "string"
        },
        "kind": {
         "enum": [
          "photo",
          "video",
          "tour",
          "document"
         ],
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "owner_token": {
    "type": "string"
   },
   "post_id": {
    "type": "string"
   }
  },
  "required": [
   "post_id",
   "owner_token",
   "links"
  ],
  "type": "object"
 },
 "name": "add_media_links",
 "title": "Add photo or video links"
}
