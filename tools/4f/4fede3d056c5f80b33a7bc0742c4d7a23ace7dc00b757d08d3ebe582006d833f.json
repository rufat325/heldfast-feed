{
 "description": "What a refused call looks like. A tool's output schema covers its answers only, so use this once, to branch on refusals or validate them. No input. Returns `errors`, every `code` with `when` it is raised and the JSON Schema of its `details`, and `schema`, the JSON Schema of a whole refusal: `error` with `code`, `message`, `rule`, `details`, beside `model`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "describe_errors",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "enum": [
        "unknown_type",
        "unknown_entity",
        "ambiguous_name",
        "unknown_rule",
        "invalid_argument",
        "invalid_cursor",
        "unsupported_snapshot",
        "cannot_draw",
        "no_creation_time"
       ],
       "type": "string"
      },
      "details": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "when": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "when",
      "details"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "type": [
       "string",
       "null"
      ]
     },
     "core": {
      "type": "string"
     },
     "parser": {
      "type": "string"
     },
     "repo": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "commit",
     "repo",
     "core",
     "parser"
    ],
    "type": "object"
   },
   "schema": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "errors",
   "schema",
   "model"
  ],
  "type": "object"
 }
}
