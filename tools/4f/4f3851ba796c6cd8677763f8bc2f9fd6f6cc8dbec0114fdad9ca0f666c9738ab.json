 },
 "description": "Export authorizations as CSV or JSON. Supports date range and status filtering. Maximum 10,000 records.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), then call this tool again. start_login does NOT open this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Export format (default: json)",
    "enum": [
     "csv",
     "json"
    ],
    "type": "string"
   },
   "from": {
    "description": "Start date filter (ISO 8601)",
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "pending",
     "active",
     "expired",
     "revoked",
     "denied"
    ],
    "type": "string"
   },
   "to": {
    "description": "End date filter (ISO 8601)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "export_authorizations"
}
