{
 "description": "Generate a text description of an image using Ideogram V3. Accepts a local file path.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "describe_model_version": {
    "description": "Model version to use (default: V_3)",
    "enum": [
     "V_2",
     "V_3"
    ],
    "type": "string"
   },
   "image": {
    "description": "Local file path of the image to describe",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "image"
  ],
  "type": "object"
 },
 "name": "ideogram_describe"
}
