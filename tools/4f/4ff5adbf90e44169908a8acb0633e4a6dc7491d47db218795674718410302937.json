{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Invite a user to your current instance. Requires only the target userId; resolves your current location automatically. If you only have a display name, run vrchat_friends_search first to get userId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "messageSlot": {
    "maximum": 11,
    "minimum": 0,
    "type": "integer"
   },
   "userId": {
    "type": "string"
   }
  },
  "required": [
   "userId"
  ],
  "type": "object"
 },
 "name": "vrchat_invite_user_to_me",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "instanceId": {
    "type": "string"
   },
   "location": {
    "type": "string"
   },
   "notification": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "status": {
    "const": "sent",
    "type": "string"
   },
   "userId": {
    "type": "string"
   },
   "worldId": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "userId",
   "worldId",
   "instanceId",
   "location"
  ],
  "type": "object"
 }
}
