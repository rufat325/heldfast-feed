{
 "description": "CNC spindle RPM and feed rate from tool diameter, flute count, chip load and cutting speed. Works for routers and mills, metric and imperial.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chip_load": {
    "description": "Chip load per tooth (mm or inch)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "cutting_speed": {
    "description": "Cutting speed Vc (m/min or ft/min)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "flutes": {
    "default": 2,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "machine": {
    "default": "router",
    "enum": [
     "router",
     "mill"
    ],
    "type": "string"
   },
   "tool_diameter": {
    "description": "Cutter diameter (mm or inch)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "unit": {
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   }
  },
  "required": [
   "unit",
   "tool_diameter",
   "chip_load",
   "cutting_speed"
  ],
  "type": "object"
 },
 "name": "cnc_feeds_speeds"
}
