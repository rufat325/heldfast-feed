{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Route conditions"
 },
 "description": "Returns up to five days of public route conditions, anchored to the route high point, with catalog gain, source provenance, and timestamps. An optional activity input selects one of the route's activities listed by search_objectives. Days can carry the avalanche center, bulletin state and forecast link (danger ratings are not served), forecast uncertainty, the corn harvest window, and rock conditions where the forecast page shows them for the activity, and the document carries the route's permit entry and trailhead road access. With the markdown format, these sections appear in structuredContent only. For what the whole trip looks like, get_trip_brief returns the forecast page sections in one call. Informational only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activity": {
    "description": "Optional activity mode for the route forecast. Accepted values are the route's activities entries from search_objectives. When omitted, the route's default visible activity is used.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Text representation; structured data is included in either format.",
    "enum": [
     "json",
     "markdown"
    ],
    "type": "string"
   },
   "route_id": {
    "description": "Route identifier returned by search_objectives.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Public objective slug returned by search_objectives.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug",
   "route_id"
  ],
  "type": "object"
 },
