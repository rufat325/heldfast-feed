","type":"object"}},"properties":{"candidates":{"items":{"$ref":"#/$defs/LiftoverCandidate"},"title":"Candidates","type":"array"},"errors":{"items":{"$ref":"#/$defs/Issue"},"title":"Errors","type":"array"},"from_genome":{"title":"From Genome","type":"string"},"input":{"title":"Input","type":"string"},"status":{"description":"RESOLVED, AMBIGUOUS, UNRESOLVED, INVALID, NOT_RECOGNIZED or UNSUPPORTED","title":"Status","type":"string"},"to_genome":{"title":"To Genome","type":"string"},"warnings":{"items":{"$ref":"#/$defs/Issue"},"title":"Warnings","type":"array"}},"required":["input","from_genome","to_genome","status","candidates","warnings","errors"],"title":"LiftoverResult","type":"object"}}
