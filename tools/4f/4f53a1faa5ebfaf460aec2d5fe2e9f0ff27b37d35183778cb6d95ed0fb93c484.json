{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use AFTER match_offer identifies TOWI, or when the user explicitly wants evidence-control QA on a supplied research packet. Evaluates caller-supplied sources for provenance completeness, evidence-state mix, primary-source coverage, modeled/disputed records, contradictions and readiness for the requested evidence standard. It performs no external research, outreach, publication, payment or consequential recommendation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "decision_context": {
    "maxLength": 2000,
    "type": "string"
   },
   "evidence": {
    "default": [],
    "items": {
     "properties": {
      "claim": {
       "maxLength": 3000,
       "type": "string"
      },
      "confidence_score": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "contradiction_note": {
       "maxLength": 2000,
       "type": "string"
      },
      "evidence_id": {
       "maxLength": 120,
       "type": "string"
      },
      "evidence_state": {
       "enum": [
        "verified_primary",
        "verified_secondary",
        "reported",
        "modeled",
        "provisional",
        "disputed",
        "retracted"
       ],
       "type": "string"
      },
      "geography": {
       "maxLength": 300,
       "type": "string"
      },
      "limitations": {
       "maxLength": 2000,
       "type": "string"
      },
      "publication_date": {
       "maxLength": 80,
       "type": "string"
      },
      "publisher": {
       "maxLength": 300,
       "type": "string"
      },
      "source_title": {
       "maxLength": 500,
       "type": "string"
      },
      "source_type": {
       "enum": [
        "primary_official",
        "peer_reviewed",
        "technical_report",
        "dataset",
        "filing",
        "meeting_record",
        "news",
        "expert_input",
        "field_observation",
        "model_output",
        "other"
       ],
       "type": "string"
      },
      "source_url": {
       "format": "uri",
       "maxLength": 2000,
       "type": "string"
      },
      "tags": {
       "items": {
        "maxLength": 120,
        "type": "string"
       },
       "maxItems": 20,
       "type": "array"
      }
     },
     "type": "object"
    },
    "maxItems": 40,
    "type": "array"
   },
   "evidence_standard": {
    "default": "decision_grade",
    "enum": [
     "rapid_scan",
     "decision_grade",
     "publication_grade"
    ],
    "type": "string"
   },
   "geography": {
    "maxLength": 300,
    "type": "string"
   },
   "research_question": {
    "maxLength": 4000,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "research_question"
  ],
  "type": "object"
 },
 "name": "audit_towi_evidence_packet",
 "title": "Audit a research evidence packet with TOWI"
}
