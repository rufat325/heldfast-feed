{
 "description": "Manage server groups for atomic connect/disconnect of sets of servers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Action: list, create, delete, add_server, remove_server, connect (all in group), disconnect (all in group), show (details)",
    "enum": [
     "list",
     "create",
     "delete",
     "add_server",
     "remove_server",
     "connect",
     "disconnect",
     "show"
    ],
    "type": "string"
   },
   "args": {
    "description": "Command arguments (for add_server with stdio)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "command": {
    "description": "Explicit command for the server (for add_server with stdio)",
    "type": "string"
   },
   "description": {
    "description": "Group description (optional, for create)",
    "type": "string"
   },
   "name": {
    "description": "Group name (required for all actions except list)",
    "type": "string"
   },
   "slug": {
    "description": "Server slug to add/remove from a group",
    "type": "string"
   },
   "transportType": {
    "description": "Transport type (for add_server)",
    "enum": [
     "stdio",
     "sse",
     "websocket",
     "streamable-http"
    ],
    "type": "string"
   },
   "url": {
    "description": "Server URL (for add_server with SSE/WS/HTTP)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mcp_groups"
}
