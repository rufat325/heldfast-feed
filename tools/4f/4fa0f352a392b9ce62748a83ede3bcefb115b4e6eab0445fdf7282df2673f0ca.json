{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Keyword Search Volume"
 },
 "description": "See how many people search Google for each phrase per month, what advertisers pay per click, and how competitive it is. Give up to 100 phrases in one call. Use it to pick keywords for a website, blog post, or ad campaign. Price: $0.15 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "keywords": {
    "description": "Search phrases to look up (up to 100).",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "language": {
    "description": "Language code, default \"en\".",
    "maxLength": 10,
    "minLength": 2,
    "type": "string"
   },
   "location": {
    "description": "Country, default \"United States\" (or the connection's default location). A city or state is reduced to its country.",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "keywords"
  ],
  "type": "object"
 },
 "name": "keyword_volume",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "language": {
    "description": "Language code used.",
    "type": "string"
   },
   "location": {
    "description": "Country the volumes are for.",
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "competition": {
       "description": "low, medium or high.",
       "type": [
        "string",
        "null"
       ]
      },
      "competition_index": {
       "description": "Advertiser competition, 0 to 1.",
       "type": [
        "number",
        "null"
       ]
      },
      "cpc_usd": {
       "description": "Average cost per click for advertisers.",
       "type": [
        "number",
        "null"
       ]
      },
      "keyword": {
       "type": "string"
      },
      "monthly_searches": {
       "description": "Average monthly Google searches.",
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "keyword",
      "monthly_searches",
      "cpc_usd",
      "competition",
      "competition_index"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "location",
   "language",
   "results",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Keyword Search Volume"
}
