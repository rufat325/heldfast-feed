{
 "description": "Create a Grok Imagine task on RunAPI (image to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "anyOf": [
     {
      "const": "2:3",
      "type": "string"
     },
     {
      "const": "3:2",
      "type": "string"
     },
     {
      "const": "1:1",
      "type": "string"
     },
     {
      "const": "16:9",
      "type": "string"
     },
     {
      "const": "9:16",
      "type": "string"
     },
     {
      "const": "auto",
      "type": "string"
     }
    ],
    "description": "Output aspect ratio."
   },
   "callback_url": {
    "description": "Webhook URL for terminal Task delivery.",
    "type": "string"
   },
   "duration_seconds": {
    "description": "Output duration in seconds.",
    "maximum": 30,
    "minimum": 6,
    "type": "number"
   },
   "enable_safety_checker": {
    "description": "Enable content safety checks.",
    "type": "boolean"
   },
   "index": {
    "description": "Zero-based source image index; used only with source_task_id.",
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "grok-imagine-image-to-video",
     "grok-imagine-video-1.5-fast",
     "grok-imagine-video-1.5-preview"
    ],
    "type": "string"
   },
   "motion_style": {
    "description": "Video motion style; spicy requires source_task_id.",
    "type": "string"
   },
   "output_resolution": {
    "anyOf": [
     {
      "const": "480p",
      "type": "string"
     },
     {
      "const": "720p",
      "type": "string"
     },
     {
      "const": "1080p",
      "type": "string"
     }
    ],
    "description": "Output resolution."
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Optional video generation prompt.",
    "maxLength": 5000,
    "type": "string"
   },
   "reference_image_urls": {
    "description": "Not accepted by this model.",
    "items": {},
    "type": "array"
   },
   "source_image_url": {
    "description": "Public source image URL; provide this or source_task_id, but not both.",
    "type": "string"
   },
   "source_task_id": {
    "description": "Prior Grok Imagine text-to-image Task ID; provide this or source_image_url, but not both.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "image_to_video"
}
