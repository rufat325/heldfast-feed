{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set note controls"
 },
 "description": "Change allowed note metadata with exact previous values. Archive/Trash are reversible; Skills and permanent deletion remain human-only. Reminders are device-owned.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "archived": {
    "type": "boolean"
   },
   "colour": {
    "enum": [
     "",
     "red",
     "orange",
     "yellow",
     "green",
     "teal",
     "blue",
     "purple",
     "pink",
     "brown"
    ],
    "type": "string"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "note_ref": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "pinned": {
    "type": "boolean"
   },
   "reminder": {
    "additionalProperties": false,
    "properties": {
     "at": {
      "maximum": 8640000000000000,
      "minimum": 1,
      "type": "integer"
     },
     "every": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
     },
     "repeat": {
      "enum": [
       "daily",
       "weekly",
       "monthly",
       "yearly",
       "weekdays",
       "custom"
      ],
      "type": "string"
     },
     "snoozeMinutes": {
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
     },
     "unit": {
      "enum": [
       "days",
       "weeks",
       "months",
       "years"
      ],
      "type": "string"
     }
    },
    "required": [
     "at"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "section": {
    "maxLength": 48,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 64,
    "type": "array"
   },
   "trashed": {
    "type": "boolean"
   },
   "turn_id": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "document",
   "note_ref"
  ],
  "type": "object"
 },
 "name": "notes.set",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Set note controls"
}
