{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Extract structured data from web pages using custom rules. Define CSS selectors or XPath queries to extract specific data. Always returns JSON with extracted data.",
 "inputSchema": {
  "properties": {
   "auto_proxy": {
    "description": "Auto-escalate proxy. Default: false",
    "type": "boolean"
   },
   "block_ads": {
    "description": "Block ads. Default: false",
    "type": "boolean"
   },
   "cookies": {
    "description": "Custom cookies",
    "type": "string"
   },
   "custom_js": {
    "description": "Custom JavaScript code",
    "type": "string"
   },
   "custom_proxy": {
    "description": "Custom proxy URI",
    "type": "string"
   },
   "device": {
    "description": "Device: 'desktop' or 'mobile'. Default: 'desktop'",
    "type": "string"
   },
   "extract_rules": {
    "description": "JSON string defining extraction rules with CSS selectors or XPath",
    "type": "string"
   },
   "js": {
    "description": "Execute JavaScript. Default: true",
    "type": "boolean"
   },
   "js_timeout": {
    "description": "JS timeout in seconds",
    "type": "number"
   },
   "progressive_scroll": {
    "description": "Progressive scroll. Default: false",
    "type": "boolean"
   },
   "proxy_country": {
    "description": "Proxy country. Default: 'US'",
    "type": "string"
   },
   "proxy_type": {
    "description": "Proxy type. Default: 'rotating'",
    "type": "string"
   },
   "scroll_down": {
    "description": "Scroll page before extraction. Default: false",
    "type": "boolean"
   },
   "session_id": {
    "description": "Session ID",
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in seconds. Default: 60",
    "type": "number"
   },
   "url": {
    "description": "URL to extract data from",
    "type": "string"
   },
   "useragent": {
    "description": "Custom user agent",
    "type": "string"
   },
   "wait_for": {
    "description": "Wait condition before extraction",
    "type": "string"
   },
   "wait_for_timeout": {
    "description": "Wait timeout in milliseconds",
    "type": "number"
   }
  },
  "required": [
   "url",
   "extract_rules"
  ],
  "type": "object"
 },
 "name": "ujeebu_scrape_extract"
}
