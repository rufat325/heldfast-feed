    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum rows to return (1-100). Defaults to 20 when omitted. The response reports the limit actually applied.",
    "examples": [
     20
    ],
    "maximum": 100,
    "minimum": 1,
    "type": "integer",
    "x-serving-bound": true
   },
   "llm_model": {
    "description": "Your model ID if known; omit otherwise. Analytics only.",
