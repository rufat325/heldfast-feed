 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Home purchase decision intelligence"
 },
 "description": "Assess whether a buyer can afford a specific Indian home \u2014 ONE verdict (AFFORDABLE / STRETCH / NOT_YET / INELIGIBLE) combining indicative eligibility (FOIR/LTV/CIBIL), EMI, true cash-to-close (down payment + stamp duty + registration + itemized GST), regime-aware tax, and an indicative lender-fit triage. Mode A: an AVnester listingId. Mode B: propertyValue + state (any Indian state). NOT a loan approval, offer, or advice. Always surface the disclaimer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {
   "annualIncomeForTax": {
    "description": "Annual income for tax. Defaults to monthlyNetIncome \u00d7 12.",
    "minimum": 0,
    "type": "integer"
   },
   "annualRent": {
    "description": "Annual rent received (let-out).",
    "minimum": 0,
    "type": "integer"
   },
   "assetType": {
    "description": "\"home\" (flat/villa/house) or \"plot\" (bare land); manual mode only. Plot \u2192 shorter tenure, no home-loan tax benefit.",
    "enum": [
     "home",
     "plot"
    ],
    "type": "string"
   },
   "buyerGender": {
    "description": "\"female\" (a woman), \"joint\" (a man and a woman together) or \"male\" (default; two women: female). Changes the price only where a state gives women a concession.",
    "enum": [
     "male",
     "female",
     "joint"
    ],
    "type": "string"
   },
   "carpetAreaSqft": {
    "description": "Carpet area (sqft) \u2014 sharpens the affordable-housing GST test (with the \u20b945L value cap).",
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   },
   "cibilScore": {
    "description": "Numeric CIBIL score. Omit \u2192 eligibility stays indicative.",
    "maximum": 900,
    "minimum": 300,
    "type": "integer"
   },
   "city": {
    "description": "City (manual mode), e.g. \"Pune\" \u2014 decides Maharashtra stamp duty and the GST metro cap. Listing mode reads the listing.",
    "maxLength": 60,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "coApplicantMonthlyIncome": {
    "description": "Co-applicant monthly income (joint affordability).",
    "maximum": 100000000,
    "minimum": 0,
    "type": "integer"
   },
   "employmentType": {
    "description": "Employment type (affects tax standard deduction).",
    "enum": [
     "salaried",
     "self_employed"
    ],
    "type": "string"
   },
   "existingMonthlyEmis": {
    "description": "Existing monthly loan EMIs in \u20b9 (car/personal/cards). Omitted \u2192 assumed \u20b90, which can inflate eligibility and flip the verdict \u2014 ask the buyer.",
    "maximum": 100000000,
    "minimum": 0,
    "type": "integer"
   },
   "firstSale": {
    "description": "True for the FIRST sale of a flat, from the builder (not the buyer's first home); false for a resale. Changes the duty only where a state has a first-sale rate (KA). Omit when unknown: a resale is priced, and said where it matters. If absent, isUnderConstruction true means true.",
    "type": "boolean"
   },
   "interestRatePercent": {
    "description": "Override annual interest rate. Defaults to indicative market rate.",
    "maximum": 30,
    "minimum": 1,
    "type": "number"
   },
   "isUnderConstruction": {
    "description": "Under-construction \u2192 GST applies; ready-to-move \u2192 no GST. Omitted \u2192 ready-to-move (no GST).",
    "type": "boolean"
   },
   "isUrban": {
    "description": "Urban (default) or rural, where the state prices by location (MH, KA, WB, MP, HR); localBody or a known city decides instead.",
    "type": "boolean"
   },
   "jointLoan": {
    "description": "Joint home loan \u2014 doubles 80C/24b caps (equal split).",
    "type": "boolean"
   },
   "listingId": {
    "description": "An AVnester listingId. Listing mode \u2014 propertyValue, state and city are then ignored, with a warning.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "localBody": {
    "description": "Where the property is, in a state that prices by it (MH, KA, WB, MP, HR): gram_panchayat (village), municipal_council (town) or municipal_corporation (city); overrides city. Omit when unknown (a corporation is priced, and said). Manual mode only.",
    "enum": [
     "municipal_corporation",
     "municipal_council",
     "gram_panchayat"
    ],
    "type": "string"
   },
   "monthlyNetIncome": {
    "description": "Buyer monthly take-home income in INR.",
    "exclusiveMinimum": 0,
    "maximum": 100000000,
    "type": "integer"
   },
   "occupancyIntent": {
    "description": "Self-occupied vs let-out \u2014 changes \u00a724(b) interest treatment. Omitted \u2192 self-occupied.",
    "enum": [
     "self_occupied",
     "let_out"
    ],
    "type": "string"
   },
   "propertyValue": {
    "description": "Property price in INR (manual mode). Pass with state (and city where it matters).",
    "exclusiveMinimum": 0,
    "maximum": 1000000000,
    "type": "integer"
   },
   "residencyStatus": {
    "description": "Residency status.",
    "enum": [
     "resident",
     "nri"
    ],
    "type": "string"
   },
   "savingsAvailable": {
    "description": "Liquid cash for down payment + charges \u2014 enables the cash-gap calc.",
    "maximum": 10000000000,
    "minimum": 0,
    "type": "integer"
   },
   "state": {
    "description": "Indian state (ISO \"MH\"/slug/name) for stamp duty. Required in manual mode; ignored in listing mode.",
    "maxLength": 50,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "tenureYears": {
    "description": "Loan tenure in years. Defaults to 20.",
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "monthlyNetIncome"
  ],
  "type": "object"
 },
