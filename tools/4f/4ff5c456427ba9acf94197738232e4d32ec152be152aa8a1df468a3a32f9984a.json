 "name": "activity-multiplier",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consensus": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "max": {
        "type": "number"
       },
       "mean": {
        "type": "number"
       },
       "median": {
        "type": "number"
       },
       "min": {
        "type": "number"
       },
       "n": {
        "type": "integer"
       }
      },
      "required": [
       "mean",
       "median",
       "min",
       "max",
       "n"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "anyOf": [
        {
         "additionalProperties": {},
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "method": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "method",
      "value",
      "unit"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skipped": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "method",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "consensus",
   "skipped"
