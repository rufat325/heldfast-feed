    "anyOf": [
     {
      "enum": [
       "sedentary",
       "light",
       "moderate",
       "active",
       "very_active"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "bmr": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "intensity": {
    "anyOf": [
     {
      "enum": [
       "light",
       "moderate",
       "vigorous"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "methods": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "string"
     }
    ],
    "default": "all"
   },
   "occupation": {
    "anyOf": [
     {
      "enum": [
       "desk",
       "standing",
       "manual",
       "heavy"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "session_minutes": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 600,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "sessions_per_week": {
    "anyOf": [
     {
      "maximum": 21,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "steps_per_day": {
    "anyOf": [
     {
      "maximum": 100000,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "weight": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "unit": {
        "default": "kg",
        "enum": [
         "kg",
         "lb"
        ],
        "type": "string"
       },
       "value": {
        "exclusiveMinimum": 0,
        "type": "number"
       }
      },
      "required": [
       "value"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "type": "object"
