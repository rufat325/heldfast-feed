    "description": "\u0441\u0435\u043a\u0440\u0435\u0442 \u0437\u0430\u044f\u0432\u043a\u0438, \u0432\u044b\u0434\u0430\u043d\u043d\u044b\u0439 request_api_key",
    "type": "string"
   }
  },
