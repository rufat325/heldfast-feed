{
 "description": "Get a comprehensive profile of a package version: licenses, vulnerabilities, OpenSSF scorecard, GitHub stats, and dependency count \u2014 all in one call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "default": "npm",
    "description": "Package ecosystem (default: npm)",
    "enum": [
     "npm",
     "pypi",
     "go",
     "maven",
     "cargo",
     "nuget",
     "rubygems",
     "pub"
    ],
    "type": "string"
   },
   "name": {
    "description": "Package name",
    "type": "string"
   },
   "version": {
    "description": "Package version",
    "type": "string"
   }
  },
  "required": [
   "name",
   "version"
  ],
  "type": "object"
 },
 "name": "hound_inspect"
}
