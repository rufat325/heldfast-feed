{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Bolot Studio FAQs and store policies. Covers product questions, sizing, finishes, shipping, returns, and ordering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 or alpha-3 country code for locale-aware policy URLs (e.g. 'PL', 'DE', 'GB', 'DEU', 'GBR')",
    "maxLength": 3,
    "type": "string"
   },
   "locale": {
    "description": "Locale code for localized policy URLs (e.g. 'en', 'pl', 'de')",
    "maxLength": 5,
    "type": "string"
   },
   "query": {
    "description": "Search query (e.g. 'returns', 'shipping to Germany', 'matte vs glossy', 'desk stand')",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_policies_and_faqs",
