    "type": "boolean"
   },
   "fraction": {
    "description": "Only the douars of this fraction, by its 10-digit code.",
    "pattern": "^\\d{10}$",
    "type": "string"
   },
   "unit": {
    "description": "A commune, by code or slug.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "unit"
  ],
  "type": "object"
 },
