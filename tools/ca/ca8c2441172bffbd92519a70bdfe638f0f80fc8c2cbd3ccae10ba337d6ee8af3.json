{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get live RIED.TAXI price"
 },
 "description": "Returns RIED.TAXI's current price for one journey, calculated by the ried.taxi backend (the only valid price source). Read-only: it never books or reserves anything. Returns quote_id (valid 30 min), status priced | manual_quote_required | not_offered, and the resolved pickup/destination - show those names to the customer. If the result is ambiguous_place, ask the customer which place they mean and resend with the postcode.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "child_seats": {
    "description": "Ages of children needing a seat. Means manual_quote_required.",
    "maxLength": 100,
    "type": "string"
   },
   "destination_address": {
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "flight_number": {
    "maxLength": 12,
    "type": "string"
   },
   "large_suitcases": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "passengers": {
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "pickup_address": {
    "description": "Street address, hotel, town with postcode, or airport name/code (MUC, SZG, LNZ, VIE).",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "pickup_date": {
    "description": "YYYY-MM-DD (Europe/Vienna).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "pickup_time": {
    "description": "HH:MM, 24h, Europe/Vienna.",
    "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "special_requirements": {
    "maxLength": 300,
    "type": "string"
   },
   "stops": {
    "description": "Intermediate stops. Any stop means manual_quote_required.",
    "items": {
     "maxLength": 200,
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   }
  },
  "required": [
   "pickup_address",
   "destination_address",
   "passengers"
  ],
  "type": "object"
 },
 "name": "ried_taxi_get_quote",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "candidates": {
    "type": "array"
   },
   "currency": {
    "type": "string"
   },
   "destination_resolved": {
    "properties": {
     "country": {
      "type": "string"
     },
     "is_airport": {
      "type": "boolean"
     },
     "lat": {
      "type": "number"
     },
     "lon": {
      "type": "number"
     },
     "match": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "included": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "pickup_resolved": {
    "properties": {
     "country": {
      "type": "string"
     },
     "is_airport": {
      "type": "boolean"
     },
     "lat": {
      "type": "number"
     },
     "lon": {
      "type": "number"
     },
     "match": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "price_eur": {
    "type": [
     "number",
     "null"
    ]
   },
   "price_type": {
    "enum": [
     "fixed_published",
     "fixed_calculated",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "promotion": {
    "type": "null"
   },
   "quote_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "priced",
     "manual_quote_required",
     "not_offered"
    ],
    "type": "string"
   },
   "valid_until": {
    "type": "string"
   },
   "waiting_rules": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Get live RIED.TAXI price"
}
