{
 "description": "List WooCommerce customers (users with the given role)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "description": "Page number (default 1)",
    "type": "integer"
   },
   "per_page": {
    "description": "Customers per page (default 20)",
    "type": "integer"
   },
   "role": {
    "description": "User role (default customer)",
    "type": "string"
   },
   "search": {
    "description": "Search in login, email, URL, display name (wildcard both sides)",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_list_customers"
}
