{"description":"Opens a URL in headless Chromium, optionally runs interaction steps, and reports which React components rendered, how often, why (props/state/context/parent) and which renders were wasted. Render counts are deterministic: use this before and after a change to verify a performance fix.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"outFile":{"description":"Optional path to write the full JSON report","type":"string"},"runs":{"default":1,"maximum":10,"minimum":1,"type":"integer"},"steps":{"default":[],"description":"Interactions to perform after load. Renders during them go to phase \"interaction\".","items":{"oneOf":[{"properties":{"action":{"const":"click","type":"string"},"selector":{"minLength":1,"type":"string"}},"required":["action","selector"],"type":"object"},{"properties":{"action":{"const":"hover","type":"string"},"selector":{"minLength":1,"type":"string"}},"required":["action","selector"],"type":"object"},{"properties":{"action":{"const":"fill","type":"string"},"selector":{"minLength":1,"type":"string"},"value":{"type":"string"}},"required":["action","selector","value"],"type":"object"},{"properties":{"action":{"const":"type","type":"string"},"delayMs":{"maximum":1000,"minimum":0,"type":"integer"},"selector":{"minLength":1,"type":"string"},"value":{"type":"string"}},"required":["action","selector","value"],"type":"object"},{"properties":{"action":{"const":"press","type":"string"},"key":{"minLength":1,"type":"string"},"selector":{"type":"string"}},"required":["action","key"],"type":"object"},{"properties":{"action":{"const":"waitFor","type":"string"},"selector":{"minLength":1,"type":"string"},"state":{"enum":["visible","hidden","attached","detached"],"type":"string"}},"required":["action","selector"],"type":"object"},{"properties":{"action":{"const":"select","type":"string"},"selector":{"minLength":1,"type":"string"},"value":{"type":"string"}},"required":["action","selector","value"],"type":"object"},{"properties":{"action":{"const":"drag","type":"string"},"dx":{"type":"number"},"dy":{"type":"number"},"selector":{"minLength":1,"type":"string"},"steps":{"maximum":200,"minimum":1,"type":"integer"},"to":{"minLength":1,"type":"string"}},"required":["action","selector"],"type":"object"},{"properties":{"action":{"const":"wait","type":"string"},"ms":{"maximum":60000,"minimum":0,"type":"integer"}},"required":["action","ms"],"type":"object"},{"properties":{"action":{"const":"scroll","type":"string"},"selector":{"type":"string"},"y":{"type":"number"}},"required":["action","y"],"type":"object"},{"properties":{"action":{"const":"goto","type":"string"},"path":{"minLength":1,"type":"string"}},"required":["action","path"],"type":"object"},{"properties":{"action":{"const":"expect","type":"string"},"count":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"selector":{"minLength":1,"type":"string"},"text":{"type":"string"}},"required":["action","selector"],"type":"object"},{"properties":{"action":{"const":"phase","type":"string"},"name":{"pattern":"^[a-z0-9][a-z0-9-_]*$","type":"string"}},"required":["action","name"],"type":"object"}]},"type":"array"},"timings":{"default":false,"description":"Also measure JavaScript ms per phase (varies between runs, unlike render counts): use it to tell the user how much faster an interaction got.","type":"boolean"},"top":{"default":15,"description":"Components shown per phase","maximum":100,"minimum":1,"type":"integer"},"url":{"description":"Page to profile, e.g. http://localhost:5173/products","format":"uri","type":"string"}},"required":["url"],"type":"object"},"name":"profile_url","title":"Profile React renders of a URL"}
