{"annotations":{"readOnlyHint":true},"description":"Returns reference log entries as structured data, useful for recovery operations. Also supports checking if a reflog exists.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"action":{"default":"show","description":"Reflog action: show (list entries) or exists (check if reflog exists)","enum":["show","exists"],"type":"string"},"all":{"description":"Show all refs' reflogs (--all)","type":"boolean"},"compact":{"default":true,"description":"Prefer compact output","type":"boolean"},"grepReflog":{"description":"Filter reflog by message pattern (--grep-reflog)","maxLength":255,"type":"string"},"maxCount":{"default":20,"description":"Number of entries to return (default: 20)","type":"number"},"path":{"description":"Repository path. Authoritative \u2014 when omitted, the server uses its own process working directory (its launch dir, not the caller's cwd). Callers in a git worktree or other directory MUST pass this explicitly to avoid operating on the wrong repo.","maxLength":4096,"type":"string"},"ref":{"description":"Which ref to show (default: HEAD)","maxLength":255,"type":"string"},"reverse":{"description":"Show entries in reverse order (--reverse)","type":"boolean"},"since":{"description":"Filter entries after this date (--since)","maxLength":255,"type":"string"},"skip":{"description":"Skip N entries for pagination (--skip)","type":"number"},"until":{"description":"Filter entries before this date (--until)","maxLength":255,"type":"string"}},"type":"object"},"name":"reflog","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"entries":{"anyOf":[{"items":{"additionalProperties":false,"properties":{"action":{"enum":["commit","commit-initial","commit-amend","checkout","merge","rebase","rebase-finish","rebase-abort","rebase-pick","rebase-reword","rebase-edit","rebas