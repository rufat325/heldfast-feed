{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Runs the same engine as https://entogo.ca/tools/ev-charging-service-capacity-calculator/: code load (NEC 2023 / NEC 2026 / CEC 2024 Section 86) for a set of Level 2 and DC fast chargers, EMS-managed load when an energy management system is declared, planning-basis load with site diversity, recommended transformer kVA and service / switchboard rating, and a GREEN / YELLOW / RED verdict against an existing service when one is given. Planning estimate only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chargers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dcfcBasis": {
       "enum": [
        "input_kw",
        "input_a",
        "output_kw"
       ],
       "type": "string"
      },
      "phase": {
       "enum": [
        1,
        3
       ],
       "type": "number"
      },
      "qty": {
       "maximum": 500,
       "minimum": 1,
       "type": "integer"
      },
      "ratingA": {
       "description": "L2 only: nameplate amperes (alternative to ratingKw)",
       "exclusiveMinimum": 0,
       "maximum": 800,
       "type": "number"
      },
      "ratingKw": {
       "description": "L2: nameplate kW; DCFC: kW per dcfcBasis (default output kW)",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      },
      "type": {
       "enum": [
        "L2",
        "DCFC"
       ],
       "type": "string"
      },
      "voltage": {
       "description": "Charger supply voltage (default: L2 208 V, DCFC = service voltage)",
       "maximum": 34500,
       "minimum": 120,
       "type": "integer"
      }
     },
     "required": [
      "type",
      "qty"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "code": {
    "default": "NEC_2023",
    "description": "Governing code edition",
    "enum": [
     "NEC_2023",
     "NEC_2026",
     "CEC_2024"
    ],
    "type": "string"
   },
   "ems": {
    "additionalProperties": false,
    "properties": {
     "limitKw": {
      "description": "Maximum load the EMS enforces",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "listingConfirmed": {
      "default": "unknown",
      "description": "Is the EMS a listed / compliant system?",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "strategy": {
      "enum": [
       "none",
       "static_limit",
       "dynamic_alms",
       "integral_evse_control",
       "dc_power_block_limit"
      ],
      "type": "string"
     }
    },
    "required": [
     "strategy"
    ],
    "type": "object"
   },
   "existingService": {
    "additionalProperties": false,
    "description": "Give the existing service to get a GREEN / YELLOW / RED verdict",
    "properties": {
     "loadMethod": {
      "enum": [
       "utility_demand_data",
       "30_day_metering",
       "12_month_peak_demand",
       "calculated_load",
       "nameplate_estimate"
      ],
      "type": "string"
     },
     "peakDemandA": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "peakDemandKw": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "serviceRatingA": {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "serviceRatingA"
    ],
    "type": "object"
   },
   "servicePhase": {
    "default": 3,
    "enum": [
     1,
     3
    ],
    "type": "number"
   },
   "serviceVoltage": {
    "default": 480,
    "description": "Service line-to-line voltage, e.g. 208, 480, 600",
    "maximum": 34500,
    "minimum": 120,
    "type": "integer"
   },
   "siteType": {
    "default": "workplace",
    "enum": [
     "fleet_depot",
     "workplace",
     "retail_dcfc",
     "multifamily",
     "truck_charging",
     "public_l2"
    ],
    "type": "string"
   }
  },
  "required": [
   "chargers"
  ],
  "type": "object"
 },
 "name": "estimate_ev_charging_capacity",
 "title": "Estimate EV-charging service capacity"
}
