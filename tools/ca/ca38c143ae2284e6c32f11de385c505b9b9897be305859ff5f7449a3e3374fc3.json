{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Global Edge CDN edge with origin, caching, and distribution settings. Sub-objects not exposed as parameters use sensible defaults (no edge logging, no edge auth, no caching rules, no header policies, WHITELIST access control with empty lists). For full control use ncloud_edge_edit_edge after creation. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessControlGeoPolicies": {
    "description": "ISO 3166-1 alpha-2 country codes for access control",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "accessControlIpPolicies": {
    "description": "Client IPs or CIDR blocks for access control",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "accessControlRefererPolicies": {
    "description": "Referer domains for access control",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "accessControlType": {
    "default": "WHITELIST",
    "description": "Access control policy type",
    "enum": [
     "WHITELIST",
     "BLACKLIST"
    ],
    "type": "string"
   },
   "cacheAge": {
    "default": 7,
    "description": "Cache max-age (1 second to 365 days)",
    "type": "number"
   },
   "cacheAgeType": {
    "default": "DAYS",
    "description": "Cache max-age unit",
    "enum": [
     "SECONDS",
     "MINUTES",
     "HOURS",
     "DAYS"
    ],
    "type": "string"
   },
   "cacheKeyHostname": {
    "default": "INCOMING_HOST_HEADER",
    "description": "Cache key hostname type",
    "enum": [
     "INCOMING_HOST_HEADER",
     "ORIGIN_HOSTNAME"
    ],
    "type": "string"
   },
   "cacheKeyIgnoreQueryStringType": {
    "default": "ALL_ALLOWED",
    "description": "How query strings are used in the cache key",
    "enum": [
     "ALL_IGNORED",
     "ALL_ALLOWED",
     "ALLOW_SPECIFIC_STRING"
    ],
    "type": "string"
   },
   "cacheKeyQueryStrings": {
    "description": "Query strings allowed in the cache key (required for ALLOW_SPECIFIC_STRING)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cacheRevalidateType": {
    "default": "IF_POSSIBLE",
    "description": "Stale object revalidation type",
    "enum": [
     "IF_POSSIBLE",
     "ALWAYS"
    ],
    "type": "string"
   },
   "cacheRuleDefinitionType": {
    "default": "CACHING",
    "description": "Default caching option",
    "enum": [
     "CACHING",
     "BYPASS_CACHE",
     "ORIGIN_CACHE_CONTROL_HEADER"
    ],
    "type": "string"
   },
   "certificateSlotId": {
    "description": "Certificate slot ID (required for CUSTOM_DOMAIN served over HTTPS; see ncloud_edge_list_certificates)",
    "type": "number"
   },
   "cors": {
    "default": false,
    "description": "Add CORS headers (managed rule)",
    "type": "boolean"
   },
   "customHostHeader": {
    "description": "Host header value (required when forwardHostHeaderType is CUSTOM)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating the edge",
    "type": "boolean"
   },
   "edgeLoggingBucketName": {
    "description": "Enable edge logging into this Object Storage bucket (omit to disable logging)",
    "type": "string"
   },
   "edgeLoggingBucketPrefix": {
    "description": "Log path prefix inside the logging bucket",
    "type": "string"
   },
   "edgeLoggingRegion": {
    "description": "Region of the edge-logging bucket (default KR)",
    "enum": [
     "KR",
     "USWN",
     "SGN",
     "JPN",
     "DEN"
    ],
    "type": "string"
   },
   "edgeName": {
    "description": "Edge name (3-35 chars: letters, digits, '-', '_')",
    "type": "string"
   },
   "forwardHostHeaderType": {
    "default": "INCOMING_HOST_HEADER",
    "description": "Host header forwarding type",
    "enum": [
     "INCOMING_HOST_HEADER",
     "ORIGIN_HOSTNAME",
     "CUSTOM"
    ],
    "type": "string"
   },
   "hsts": {
    "default": false,
    "description": "Enable HSTS",
    "type": "boolean"
   },
   "http2": {
    "default": true,
    "description": "Enable HTTP/2",
    "type": "boolean"
   },
   "httpCompression": {
    "default": true,
    "description": "Enable Gzip/Brotli compression",
    "type": "boolean"
   },
   "largeFileOptimization": {
    "default": true,
    "description": "Enable large file optimization",
    "type": "boolean"
   },
   "negativeTtl": {
    "default": true,
    "description": "Cache origin error responses (negative TTL)",
    "type": "boolean"
   },
   "originBucketName": {
    "description": "Origin bucket name (required for OBJECT_STORAGE)",
    "type": "string"
   },
   "originCustomLocation": {
    "description": "Origin domain name (required for LOAD_BALANCER, API_GATEWAY, or CUSTOM)",
    "type": "string"
   },
   "originPath": {
    "description": "Origin path appended to origin requests, e.g. /static/",
    "type": "string"
   },
   "originPort": {
    "default": 80,
    "description": "Origin port number",
    "type": "number"
   },
   "originProtocolType": {
    "default": "HTTP",
    "description": "Origin protocol type",
    "enum": [
     "HTTP",
     "HTTPS"
    ],
    "type": "string"
   },
   "originRegion": {
    "$ref": "#/properties/edgeLoggingRegion",
    "description": "Origin region (required for OBJECT_STORAGE or LOAD_BALANCER)"
   },
   "originType": {
    "description": "Origin server type",
    "enum": [
     "OBJECT_STORAGE",
     "LOAD_BALANCER",
     "API_GATEWAY",
     "CUSTOM"
    ],
    "type": "string"
   },
   "profileId": {
    "description": "Profile ID to create the edge under",
    "type": "number"
   },
   "protocolType": {
    "description": "Service protocol: HTTPS or ALL (HTTP+HTTPS)",
    "enum": [
     "HTTPS",
     "ALL"
    ],
    "type": "string"
   },
   "regionType": {
    "description": "Service region: KOREA, JAPAN, or GLOBAL",
    "enum": [
     "KOREA",
     "JAPAN",
     "GLOBAL"
    ],
    "type": "string"
   },
   "removeVaryHeader": {
    "default": true,
    "description": "Remove Vary headers (other than Accept-Encoding) before caching",
    "type": "boolean"
   },
   "serviceDomainName": {
    "description": "Domain name (required for NCP_DOMAIN_CUSTOM or CUSTOM_DOMAIN)",
    "type": "string"
   },
   "serviceDomainType": {
    "description": "Service domain type",
    "enum": [
     "NCP_DOMAIN_AUTO",
     "NCP_DOMAIN_CUSTOM",
     "CUSTOM_DOMAIN"
    ],
    "type": "string"
   },
   "trueClientIpHeader": {
    "default": false,
    "description": "Forward the client IP header to the origin",
    "type": "boolean"
   }
  },
  "required": [
   "profileId",
   "edgeName",
   "protocolType",
   "regionType",
   "serviceDomainType",
   "originType"
  ],
  "type": "object"
 },
 "name": "ncloud_edge_create_edge"
}
