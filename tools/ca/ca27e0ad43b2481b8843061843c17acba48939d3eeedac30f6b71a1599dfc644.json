{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Save a blueprint to the local store for reuse: apply it to other servers with execute_build_plan or track drift with diff_blueprint. Names are unique.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "blueprint": {
    "properties": {
     "categories": {
      "items": {
       "properties": {
        "channels": {
         "items": {
          "properties": {
           "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
           },
           "nsfw": {
            "type": "boolean"
           },
           "posting_roles": {
            "description": "With read_only: role names that may still post.",
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "private_to": {
            "description": "Role names that can see this channel. Everyone else is denied view.",
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "read_only": {
            "description": "Deny sending for everyone; for rules and announcements.",
            "type": "boolean"
           },
           "slowmode_seconds": {
            "maximum": 21600,
            "minimum": 0,
            "type": "integer"
           },
           "topic": {
            "maxLength": 1024,
            "type": "string"
           },
           "type": {
            "description": "Default text.",
            "enum": [
             "text",
             "voice",
             "forum",
             "stage",
             "announcement"
            ],
            "type": "string"
           }
          },
          "required": [
           "name"
          ],
          "type": "object"
         },
         "maxItems": 50,
         "type": "array"
        },
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "private_to": {
         "description": "Role names that can see the whole category.",
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "name",
        "channels"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "channels": {
      "description": "Top-level channels outside any category.",
      "items": {
       "properties": {
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "nsfw": {
         "type": "boolean"
        },
        "posting_roles": {
         "description": "With read_only: role names that may still post.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "private_to": {
         "description": "Role names that can see this channel. Everyone else is denied view.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "read_only": {
         "description": "Deny sending for everyone; for rules and announcements.",
         "type": "boolean"
        },
        "slowmode_seconds": {
         "maximum": 21600,
         "minimum": 0,
         "type": "integer"
        },
        "topic": {
         "maxLength": 1024,
         "type": "string"
        },
        "type": {
         "description": "Default text.",
         "enum": [
          "text",
          "voice",
          "forum",
          "stage",
          "announcement"
         ],
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 500,
      "type": "array"
     },
     "name": {
      "description": "Optional label for saving or referencing this blueprint.",
      "maxLength": 100,
      "type": "string"
     },
     "roles": {
      "description": "Highest role first, the way the server settings list them. A build creates them in this order and that order is the hierarchy.",
      "items": {
       "properties": {
        "color": {
         "pattern": "^#?[0-9a-fA-F]{6}$",
         "type": "string"
        },
        "hoist": {
         "description": "Show members with this role separately in the sidebar.",
         "type": "boolean"
        },
        "mentionable": {
         "type": "boolean"
        },
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "permissions": {
         "description": "Extra permission names beyond the preset.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "preset": {
         "description": "Vetted permission bundle. Administrator is never included.",
         "enum": [
          "none",
          "member",
          "moderator",
          "admin"
         ],
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 250,
      "type": "array"
     },
     "theme": {
      "description": "Freeform note recording the intent and naming style.",
      "maxLength": 500,
      "type": "string"
     }
    },
    "type": "object"
   },
   "description": {
    "maxLength": 300,
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "blueprint"
  ],
  "type": "object"
 },
 "name": "save_blueprint",
 "title": "Save blueprint"
}
