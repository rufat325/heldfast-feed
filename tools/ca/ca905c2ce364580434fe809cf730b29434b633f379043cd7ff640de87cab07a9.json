{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a plan against broker limits and impact"
 },
 "description": "Check a trading plan before it trades: broker order-rate and minimum-order limits, 2026 US day-trading rules, square-root market impact with crowding, and the capital where costs eat the return. Checks the plan as described against published broker limits and a market-impact model; it never contacts a broker or sees an account.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account": {
    "enum": [
     "cash",
     "margin"
    ],
    "type": "string"
   },
   "adv_usd": {
    "description": "Daily dollar volume of a typical holding.",
    "type": "number"
   },
   "asset_class": {
    "enum": [
     "us_equity",
     "crypto",
     "futures",
     "fx",
     "options"
    ],
    "type": "string"
   },
   "broker": {
    "description": "Default other.",
    "enum": [
     "alpaca",
     "ibkr",
     "other"
    ],
    "type": "string"
   },
   "capital_usd": {
    "type": "number"
   },
   "copies": {
    "description": "Agents trading the same signal at once; default 1.",
    "type": "integer"
   },
   "daily_volatility": {
    "description": "Of a typical holding, e.g. 0.02.",
    "maximum": 1,
    "type": "number"
   },
   "expected_gross_return": {
    "description": "Annual, before costs; adds capacity.",
    "minimum": -1,
    "type": "number"
   },
   "impact_coefficient": {
    "description": "Square-root law Y; default 1.",
    "type": "number"
   },
   "minutes_per_rebalance": {
    "description": "Default 1.",
    "type": "number"
   },
   "orders_per_minute_limit": {
    "description": "If the broker's is not on file.",
    "type": "number"
   },
   "orders_per_rebalance": {
    "type": "integer"
   },
   "rebalances_per_year": {
    "type": "number"
   },
   "spread_and_fees_bps": {
    "description": "Per trade; default 0.",
    "minimum": 0,
    "type": "number"
   },
   "turnover_per_year": {
    "description": "Buys plus sells a year / capital.",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "capital_usd",
   "orders_per_rebalance",
   "rebalances_per_year",
   "turnover_per_year",
   "adv_usd",
   "daily_volatility"
  ],
  "type": "object"
 },
 "name": "check_feasibility",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "verdict summarizes the checks; each check has a status (ok, warning, blocking, unknown), its finding and numbers; to_change lists what to fix.",
  "properties": {
   "checks": {
    "items": {},
    "type": "array"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "plain_reading": {
    "type": "string"
   },
   "sources": {
    "properties": {},
    "type": "object"
   },
   "to_change": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "verdict": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Check a plan against broker limits and impact"
}
