{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Updates persistent prayer preferences, overwriting supplied settings while preserving omitted settings. Setting fixedCity replaces stored fixedCoordinates and clears the stored timezone unless supplied; setting fixedCoordinates replaces stored fixedCity. Can disable reminders. Fixed mode requires a supported fixedCity or fixedCoordinates with timezone; new coordinates require timezone in the same request. clearFixedLocation removes saved location and timezone and defaults to auto_travel. Previous values are not retained for undo.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calculationMethod": {
    "description": "Islamic prayer calculation authority",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "clearFixedLocation": {
    "description": "Remove stored fixedCity, fixedCoordinates and timezone. Switches to auto_travel unless locationMode is supplied. Cannot combine with a new fixed location/timezone.",
    "type": "boolean"
   },
   "enabled": {
    "description": "Whether prayer reminders are enabled",
    "type": "boolean"
   },
   "exactWindowMinutes": {
    "description": "Duration in minutes for exact_window mode",
    "maximum": 120,
    "minimum": 5,
    "type": "integer"
   },
   "fixedCity": {
    "description": "Supported cities: makkah, madinah, riyadh, cairo, gaza, jerusalem, alquds, ramallah, hebron, nablus, rafah, khanyunis, dubai, abudhabi, kuwait, doha, amman, istanbul, london, paris, newyork, toronto, jakarta, singapore, karachi, kualalumpur, tehran, sydney, tromso. Aliases: gazacity, nyc, kuwaitcity. Case, spaces and punctuation are ignored.",
    "type": "string"
   },
   "fixedCoordinates": {
    "description": "Fixed geographical coordinates",
    "properties": {
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "highLatitudeRule": {
    "description": "High latitude twilight adjustment rule",
    "enum": [
     "MiddleOfTheNight",
     "SeventhOfTheNight",
     "TwilightAngle"
    ],
    "type": "string"
   },
   "locale": {
    "description": "Language for reminder text: en or ar",
    "enum": [
     "en",
     "ar"
    ],
    "type": "string"
   },
   "locationMode": {
    "description": "Location strategy: auto_travel or fixed",
    "enum": [
     "auto_travel",
     "fixed"
    ],
    "type": "string"
   },
   "madhab": {
    "description": "Jurisprudential Asr shadow calculation: Shafi or Hanafi",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "minuteAdjustments": {
    "description": "Custom per-prayer minute offsets (-60 to +60)",
    "properties": {
     "asr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "dhuhr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "fajr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "isha": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "maghrib": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "sunrise": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "reminderMode": {
    "description": "Reminder display policy: prayer_window, exact_window, persistent",
    "enum": [
     "prayer_window",
     "exact_window",
     "persistent"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone identifier (e.g. Asia/Riyadh, Europe/London)",
    "type": "string"
   },
   "userId": {
    "description": "Nonblank user identifier; at most 256 UTF-8 bytes and 256 characters. Whitespace in nonblank identifiers is preserved.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "userId"
  ],
  "type": "object"
 },
 "name": "configure_prayer_preferences",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "preferences": {
    "additionalProperties": false,
    "properties": {
     "calculationMethod": {
      "enum": [
       "UmmAlQura",
       "MuslimWorldLeague",
       "Egyptian",
       "Karachi",
       "NorthAmerica",
       "Dubai",
       "Qatar",
       "Kuwait",
       "MoonsightingCommittee",
       "Singapore",
       "Turkey",
       "Tehran"
      ],
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "exactWindowMinutes": {
      "type": "number"
     },
     "fixedCity": {
      "type": "string"
     },
     "fixedCityConfigured": {
      "type": "boolean"
     },
     "fixedCoordinatesConfigured": {
      "type": "boolean"
     },
     "highLatitudeRule": {
      "enum": [
       "MiddleOfTheNight",
       "SeventhOfTheNight",
       "TwilightAngle"
      ],
      "type": "string"
     },
     "locale": {
      "enum": [
       "en",
       "ar"
      ],
      "type": "string"
     },
     "locationMode": {
      "enum": [
       "auto_travel",
       "fixed"
      ],
      "type": "string"
     },
     "madhab": {
      "enum": [
       "Shafi",
       "Hanafi"
      ],
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "minuteAdjustments": {
      "additionalProperties": false,
      "properties": {
       "asr": {
        "maximum": 60,
        "minimum": -60,
        "type": "integer"
       },
       "dhuhr": {
        "maximum": 60,
        "minimum": -60,
        "type": "integer"
       },
       "fajr": {
        "maximum": 60,
        "minimum": -60,
        "type": "integer"
       },
       "isha": {
        "maximum": 60,
        "minimum": -60,
        "type": "integer"
       },
       "maghrib": {
        "maximum": 60,
        "minimum": -60,
        "type": "integer"
       },
       "sunrise": {
        "maximum": 60,
        "minimum": -60,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "reminderMode": {
      "enum": [
       "prayer_window",
       "exact_window",
       "persistent"
      ],
      "type": "string"
     },
     "timezone": {
      "type": "string"
     },
     "updatedAtUtc": {
      "type": "string"
     }
    },
    "required": [
     "fixedCoordinatesConfigured",
     "fixedCityConfigured"
    ],
    "type": "object"
   },
   "success": {
    "description": "Whether configuration succeeded",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "preferences"
  ],
  "type": "object"
 },
 "title": "Configure User Prayer Preferences"
}
