{
 "_meta": {
  "openai/outputTemplate": "ui://widget/experience-cards/v8",
  "openai/toolInvocation/invoked": "Cards ready",
  "openai/toolInvocation/invoking": "Preparing your experience cards\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://widget/experience-cards/v8",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://widget/experience-cards/v8"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Render experience cards"
 },
 "description": "Use when visual cards would help present a discovery result from a supported search tool. Pass the product_id values from that result as experience_ids, never full product rows, and choose a render_type. Optionally pass render_context.intent_summary (a short phrase describing what the user asked for, such as city, date, or audience) to set the heading. Keep each result set to one card view to avoid duplicate cards; concise text context may accompany it.",
 "inputSchema": {
  "properties": {
   "experience_ids": {
    "description": "The stable product_id values from search_experiences results (the product_id field of each returned row). Pass IDs only, never full product rows.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "minItems": 0,
    "type": "array",
    "uniqueItems": true
   },
   "idempotency_key": {
    "description": "Optional UUID. Reuse for identical card render responses within five minutes.",
    "format": "uuid",
    "type": "string"
   },
   "render_context": {
    "additionalProperties": false,
    "properties": {
     "audience_hint": {
      "description": "Optional audience hint, e.g. family.",
      "maxLength": 80,
      "type": "string"
     },
     "date_hint": {
      "description": "Optional human date hint, e.g. Saturday evening.",
      "maxLength": 80,
      "type": "string"
     },
     "intent_summary": {
      "description": "Short human-readable summary of the user's request.",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "sort_basis": {
      "description": "Optional sort explanation.",
      "enum": [
       "popularity",
       "price_asc",
       "rating_desc"
      ],
      "type": "string"
     }
    },
    "required": [
     "intent_summary"
    ],
    "type": "object"
   },
   "render_type": {
    "description": "Visual layout requested for the widget.",
    "enum": [
     "carousel",
     "grid",
     "comparison",
     "single"
    ],
    "type": "string"
   }
  },
  "required": [
   "experience_ids",
   "render_type"
  ],
  "type": "object"
 },
 "name": "render_experience_cards",
 "outputSchema": {
  "oneOf": [
   {
    "additionalProperties": true,
    "properties": {
     "experience_ids": {
      "description": "The stable product ids rendered as cards.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "experience_ids"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "properties": {
     "detail": {
      "additionalProperties": true,
      "type": "object"
     },
     "error_type": {
      "enum": [
       "ambiguous_input",
       "invalid_input",
       "rate_limited",
       "supplier_unavailable",
       "circuit_breaker_open",
       "partial_result",
       "unauthorized",
       "forbidden",
       "internal_error",
       "not_found"
      ],
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retry_after": {
      "type": "string"
     },
     "retry_after_seconds": {
      "minimum": 0,
      "type": "integer"
     },
     "schema_version": {
      "const": "https://mcp.tickadoo.com/schemas/tool_error/1.0"
     }
    },
    "required": [
     "schema_version",
     "error_type",
     "message",
     "detail"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "schemaVersion": "https://mcp.tickadoo.com/schemas/experience_cards_input/1.0"
}
