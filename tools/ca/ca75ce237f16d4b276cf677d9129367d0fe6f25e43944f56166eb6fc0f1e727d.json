  "properties": {
   "orderId": {
    "description": "The order identifier from checkout.",
    "type": "string"
   },
   "token": {
    "description": "The buyer token from checkout, or the seller's manage token. Treat as a secret.",
    "type": "string"
   }
  },
  "required": [
   "orderId",
   "token"
  ],
  "type": "object"
 },
 "name": "get_order_status",
