{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Store Resource"
 },
 "description": "Store GeoJSON, CZML, or JSON once and return a compact resourceId for later tool calls.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "JSON-serializable resource payload."
   },
   "kind": {
    "description": "Resource kind.",
    "enum": [
     "geojson",
     "czml",
     "json"
    ],
    "type": "string"
   },
   "resourceId": {
    "description": "Optional caller-provided resource ID.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "description": "Target browser session ID for multi-browser routing (optional)",
    "type": "string"
   },
   "ttlSeconds": {
    "default": 1800,
    "description": "Lifetime in seconds.",
    "maximum": 86400,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "kind",
   "data"
  ],
  "type": "object"
 },
 "name": "storeResource",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "createdAt": {
    "type": "string"
   },
   "expiresAt": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "geojson",
     "czml",
     "json"
    ],
    "type": "string"
   },
   "resourceId": {
    "type": "string"
   },
   "sizeBytes": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "resourceId",
   "kind",
   "sizeBytes",
   "createdAt",
   "expiresAt"
  ],
  "type": "object"
 }
}
