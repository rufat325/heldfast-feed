{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List every Impreza-managed VPS the customer owns (and any external bring-your-own server they registered), each with what it has LEFT \u2014 free disk, free memory, CPU load. Use to find the right `agent_id` before calling `impreza_deploy_custom`, and to pick WHICH server: a customer with two boxes usually has room on one and not the other. Returns hostname + IP + status (online/offline/draining/revoked) plus a `capacity` object per server (null when that server never reported; `stale: true` when its last heartbeat is over 15 minutes old, which means the box went quiet rather than idle).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "impreza_list_servers",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "servers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "agent_id": {
         "type": "string"
        },
        "agent_update": {
         "type": "object"
        },
        "capacity": {
         "type": [
          "object",
          "null"
         ]
        },
        "failover_location": {
         "oneOf": [
          {
           "type": "null"
          },
          {
           "additionalProperties": false,
           "properties": {
            "country_basis": {
             "enum": [
              "verified",
              "operator_verified",
              "declared"
             ],
             "type": "string"
            },
            "country_code": {
             "pattern": "^[A-Z]{2}$",
             "type": "string"
            },
            "country_notice": {
             "type": [
              "string",
              "null"
             ]
            }
           },
           "required": [
            "country_code",
            "country_basis",
            "country_notice"
           ],
           "type": "object"
          }
         ]
        },
        "hostname": {
         "type": [
          "string",
          "null"
         ]
        },
        "last_seen_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "origin": {
         "type": "string"
        },
        "registered_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "service_id": {
         "type": [
          "integer",
          "null"
         ]
        },
        "status": {
         "type": "string"
        },
        "tor": {
         "type": [
          "object",
          "null"
         ]
        },
        "update_policy": {
         "type": "object"
        },
        "version": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "agent_id",
        "hostname",
        "origin",
        "service_id",
        "status",
        "version",
        "update_policy",
        "agent_update",
        "last_seen_at",
        "registered_at",
        "tor",
        "capacity"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "servers",
     "total"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "List servers"
}
