{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a team user, resolving the role by name (or original_name/ID) to its role_id (POST /users). dry_run=true (default) previews. Validates the email format up front.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = create",
    "type": "boolean"
   },
   "email": {
    "description": "User email",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "name": {
    "description": "User's display name",
    "minLength": 1,
    "type": "string"
   },
   "phone": {
    "description": "Optional phone number",
    "type": "string"
   },
   "role_ref": {
    "description": "Role name or ID (e.g. 'viewer', 'editor')",
    "type": "string"
   }
  },
  "required": [
   "name",
   "email",
   "role_ref"
  ],
  "type": "object"
 },
 "name": "panda_action_provision_user",
 "title": "Provision Team User"
}
