{
 "_meta": {
  "openai/outputTemplate": "ui://widget/aviasurf-airport-compare.html",
  "openai/toolInvocation/invoked": "Aviasurf results ready",
  "openai/toolInvocation/invoking": "Searching Aviasurf\u2026",
  "ui": {
   "resourceUri": "ui://widget/aviasurf-airport-compare.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare indicative airport prices"
 },
 "description": "Compare cached indicative fare samples in an interactive airport comparison across airports of the origin city, destination city, or both. Prices are per adult. Always link the returned search_url from a short label in the answer language, for example \"Check live prices on Aviasurf\"; never paste the raw URL as text. Outbound and inbound are calculated separately. Missing prices mean no cached observation, not that no flight exists.",
 "inputSchema": {
  "additionalProperties": false,
  "not": {
   "required": [
    "depart_date",
    "depart_month"
   ]
  },
  "properties": {
   "currency": {
    "description": "Three-letter output currency. Set it only when the user explicitly requests a currency; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "depart_date": {
    "description": "Optional exact departure date. Omit both date fields for the cheapest observations across the cached horizon; do not combine with depart_month.",
    "format": "date",
    "type": "string"
   },
   "depart_month": {
    "description": "Optional departure month. Omit both date fields for the cheapest observations across the cached horizon; do not combine with depart_date.",
    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
    "type": "string"
   },
   "destination": {
    "description": "Destination city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "direct": {
    "default": false,
    "description": "Request nonstop observations only.",
    "type": "boolean"
   },
   "direction": {
    "default": "outbound",
    "description": "Compare outbound routes, inbound routes, or both independently.",
    "enum": [
     "outbound",
     "inbound",
     "both"
    ],
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language locale for airport and airline names and response text.",
    "pattern": "^[A-Za-z]{2}(?:-[A-Za-z]{2})?$",
    "type": "string"
   },
   "market": {
    "description": "Two-letter country market. Set it only when the user explicitly requests a country market or local Aviasurf site; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "origin": {
    "description": "Origin city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "return_date": {
    "description": "Optional return date for outbound price comparisons.",
    "format": "date",
    "type": "string"
   },
   "side": {
    "default": "both",
    "description": "Expand airports on the origin side, destination side, or both.",
    "enum": [
     "origin",
     "destination",
     "both"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
