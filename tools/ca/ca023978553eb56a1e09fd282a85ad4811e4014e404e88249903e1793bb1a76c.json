{
 "description": "Generate trade documents for a shipment: Commercial Invoice (CI), Packing List (PL), or Certificate of Origin (C/O). Returns a structured JSON document ready for export/PDF generation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "description": "Currency code (default: USD)",
    "type": "string"
   },
   "destinationCountry": {
    "description": "Destination country (ISO 2-letter code, e.g. 'US')",
    "type": "string"
   },
   "documentType": {
    "description": "Type of trade document to generate",
    "enum": [
     "commercial_invoice",
     "packing_list",
     "certificate_of_origin"
    ],
    "type": "string"
   },
   "exporterName": {
    "description": "Exporter/seller company name",
    "type": "string"
   },
   "hsCode": {
    "description": "HS code (6+ digits)",
    "type": "string"
   },
   "importerName": {
    "description": "Importer/buyer company name",
    "type": "string"
   },
   "originCountry": {
    "description": "Country of origin (ISO 2-letter code, e.g. 'CN')",
    "type": "string"
   },
   "productName": {
    "description": "Product name/description",
    "type": "string"
   },
   "quantity": {
    "description": "Number of units",
    "type": "number"
   },
   "unitPrice": {
    "description": "Price per unit in USD",
    "type": "number"
   },
   "weight": {
    "description": "Total weight in kg",
    "type": "number"
   }
  },
  "required": [
   "documentType",
   "exporterName",
   "importerName",
   "originCountry",
   "destinationCountry",
   "productName",
   "quantity",
   "unitPrice"
  ],
  "type": "object"
 },
 "name": "generate_document"
}
