{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get one signing request by its native:<id>: status, timestamps, the masked signer and the evidence chain's length and head hash (never the events, the signer's email or prefill values). Requires agreements:read. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "requestId": {
    "pattern": "^native:[A-Za-z0-9_-]{1,64}$",
    "type": "string"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_requests_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "request": {
      "additionalProperties": false,
      "properties": {
       "assignmentId": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "chain": {
        "additionalProperties": false,
        "properties": {
         "headHash": {
          "anyOf": [
           {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "length": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "length",
         "headHash"
        ],
        "type": "object"
       },
       "completedAt": {
        "anyOf": [
         {
          "format": "date-time",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "contractId": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "createdAt": {
        "format": "date-time",
        "type": "string"
       },
       "documentId": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "jobId": {
        "anyOf": [
         {
          "maxLength": 64,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastRemindedAt": {
        "anyOf": [
         {
          "format": "date-time",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "queuedAt": {
        "anyOf": [
         {
          "format": "date-time",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "requestId": {
        "pattern": "^native:[A-Za-z0-9_-]{1,64}$",
        "type": "string"
       },
       "sentAt": {
        "anyOf": [
         {
          "format": "date-time",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "signer": {
        "additionalProperties": false,
        "properties": {
         "displayName": {
          "maxLength": 120,
          "type": "string"
         }
        },
        "required": [
         "displayName"
        ],
        "type": "object"
       },
       "status": {
        "enum": [
         "QUEUED",
         "SENT",
         "VIEWED",
         "CONSENTED",
         "SIGNED",
         "COMPLETED",
         "DECLINED",
         "VOIDED",
         "FAILED"
        ],
        "type": "string"
       },
       "updatedAt": {
        "format": "date-time",
        "type": "string"
       },
       "versionId": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "versionNumber": {
        "exclusiveMinimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "requestId",
       "documentId",
       "versionId",
       "versionNumber",
       "jobId",
       "contractId",
       "assignmentId",
       "status",
       "signer",
       "queuedAt",
       "sentAt",
       "lastRemindedAt",
       "completedAt",
       "createdAt",
       "updatedAt",
       "chain"
      ],
      "type": "object"
     }
    },
    "required": [
     "request"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
