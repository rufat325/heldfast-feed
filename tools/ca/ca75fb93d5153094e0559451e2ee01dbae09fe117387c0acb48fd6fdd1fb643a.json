{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get per-row import results"
 },
 "description": "Returns per-row results for a finished import. Filter by 'type' (INFO / WARNING / ERROR) to surface only failures. Paginated \u2014 defaults to 20 rows per page, max 100.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   },
   "importId": {
    "description": "Import id from list_imports.",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-indexed). Default 1.",
    "minimum": 1,
    "type": "integer"
   },
   "perPage": {
    "description": "Rows per page. Default 20, max 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Optional: filter rows by result type.",
    "enum": [
     "INFO",
     "WARNING",
     "ERROR"
    ],
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "importId"
  ],
  "type": "object"
 },
 "name": "get_import_results",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "page": {
    "description": "Current page (1-indexed).",
    "type": "integer"
   },
   "perPage": {
    "description": "Rows per page.",
    "type": "integer"
   },
   "rows": {
    "description": "Per-row results.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "createdEntityId": {
       "description": "QBO/Xero entity id created, if any.",
       "type": "string"
      },
      "message": {
       "description": "Human-readable result message.",
       "type": "string"
      },
      "rowNumber": {
       "description": "1-indexed row number in the source file.",
       "type": "integer"
      },
      "type": {
       "enum": [
        "INFO",
        "WARNING",
        "ERROR"
       ],
       "type": "string"
      }
     },
     "required": [
      "rowNumber",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Total result rows across all pages.",
    "type": "integer"
   },
   "totalPages": {
    "description": "Total page count.",
    "type": "integer"
   }
  },
  "type": "object"
 }
}
