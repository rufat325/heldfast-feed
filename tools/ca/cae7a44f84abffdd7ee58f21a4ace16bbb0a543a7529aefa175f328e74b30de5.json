{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Create an independently editable alternative from a saved revision. Optional document carries your own changed text. No vote or approval required; does not replace main.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "contributor_key": {
    "description": "Private acc_edit_ contributor key. Editing does not require signing.",
    "type": "string"
   },
   "document": {
    "additionalProperties": false,
    "properties": {
     "clauses": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 80,
         "minLength": 1,
         "pattern": "^[a-zA-Z0-9_-]+$",
         "type": "string"
        },
        "text": {
         "maxLength": 6000,
         "minLength": 1,
         "type": "string"
        },
        "title": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "text"
       ],
       "type": "object"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "preamble": {
      "items": {
       "maxLength": 3000,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 16,
      "type": "array"
     }
    },
    "required": [
     "preamble",
     "clauses"
    ],
    "type": "object"
   },
   "from_revision_id": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "from_revision_id",
   "title",
   "reason",
   "contributor_key"
  ],
  "type": "object"
 },
 "name": "fork_agreement"
}
