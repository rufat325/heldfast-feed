  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many products on sale to list, 1 to 20. Defaults to 10.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
