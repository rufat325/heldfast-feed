{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find missing translations"
 },
 "description": "Use this when someone asks which strings are not translated yet, or how complete each language is. Returns completion percentages and up to 25 missing keys per locale, for one locale or up to 10, compared with the default locale. Nothing is translated or written. Not for filling in the missing translations.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "One locale code to check; omit to check the configured locales",
    "maxLength": 35,
    "minLength": 1,
    "type": "string"
   },
   "localeLimit": {
    "description": "How many configured locales to check when language is omitted, from 1 to 10; defaults to 10",
    "exclusiveMinimum": 0,
    "maximum": 10,
    "type": "integer"
   },
   "project": {
    "description": "Project id or name",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "scanLimit": {
    "description": "Strings to scan per locale, from 1 to 2000; defaults to 1000",
    "exclusiveMinimum": 0,
    "maximum": 2000,
    "type": "integer"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "find_missing_translations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultLocale": {
    "anyOf": [
     {
      "maxLength": 35,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "locales": {
    "description": "One row per checked locale with its completion and up to 25 missing keys; status partial means a scan cap was reached",
    "items": {
     "additionalProperties": false,
     "properties": {
      "analysisIncomplete": {
       "type": "boolean"
      },
      "completionPercent": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "language": {
       "maxLength": 35,
       "minLength": 1,
       "type": "string"
      },
      "missingKeyCount": {
       "maximum": 2000,
       "minimum": 0,
       "type": "integer"
      },
      "missingKeys": {
       "items": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 25,
       "type": "array"
      },
      "missingKeysTruncated": {
       "type": "boolean"
      },
      "targetPhrasesScanned": {
       "maximum": 2000,
       "minimum": 0,
       "type": "integer"
      },
      "targetScanTruncated": {
       "type": "boolean"
      },
      "totalKeys": {
       "maximum": 2000,
       "minimum": 0,
       "type": "integer"
      },
      "translatedKeys": {
       "maximum": 2000,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "language",
      "totalKeys",
      "translatedKeys",
      "missingKeyCount",
      "completionPercent",
      "targetPhrasesScanned",
      "targetScanTruncated",
      "analysisIncomplete",
      "missingKeys",
      "missingKeysTruncated"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "localesTruncated": {
    "type": "boolean"
   },
   "project": {
    "anyOf": [
     {
      "maxLength": 128,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scanLimit": {
    "exclusiveMinimum": 0,
    "maximum": 2000,
    "type": "integer"
   },
   "sourcePhrasesScanned": {
    "maximum": 2000,
    "minimum": 0,
    "type": "integer"
   },
   "sourceScanTruncated": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "complete",
     "incomplete",
     "partial",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project",
   "defaultLocale",
   "sourcePhrasesScanned",
   "scanLimit",
   "sourceScanTruncated",
   "localesTruncated",
   "locales"
  ],
  "type": "object"
 },
 "title": "Find missing translations"
}
