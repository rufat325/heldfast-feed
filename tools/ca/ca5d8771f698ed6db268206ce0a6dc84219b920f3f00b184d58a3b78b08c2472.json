eMatchesBacktest","source"],"type":"object"},"schedulePolicyId":{"description":"Used with action=\"status\". Required for action=\"status\".","format":"uuid","type":"string"},"source":{"default":"user_instruction","description":"Used with action=\"create\".","enum":["generated","refined","user_instruction","manual_override","imported","system"],"type":"string"},"strategyId":{"description":"Used with action=\"create\". Required for action=\"create\".","format":"uuid","type":"string"}},"required":["action"],"type":"object"},"name":"manage_schedule","title":"Preview a schedule or save a schedule draft"}
