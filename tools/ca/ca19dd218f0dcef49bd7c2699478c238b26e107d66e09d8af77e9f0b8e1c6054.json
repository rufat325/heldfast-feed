     "actif": {
      "default": null,
      "title": "Actif",
      "type": "boolean"
     },
     "destinataire": {
      "default": null,
      "maxLength": 200,
      "minLength": 1,
      "title": "Destinataire",
      "type": "string"
     },
     "email": {
      "default": null,
      "maxLength": 320,
      "title": "Email",
      "type": "string"
     },
     "note": {
      "default": null,
      "maxLength": 240,
      "title": "Note",
      "type": "string"
     }
    },
    "title": "LinkPatch",
    "type": "object"
   }
  },
  "properties": {
   "catalogue_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Catalogue Id",
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "link_id": {
    "minimum": 1,
    "title": "Link Id",
    "type": "integer"
   },
   "patch": {
    "$ref": "#/$defs/LinkPatch"
   }
  },
  "required": [
   "catalogue_id",
   "link_id",
   "patch",
   "expected_revision"
  ],
  "title": "update_tracking_linkArguments",
  "type": "object"
 },
 "name": "foliade_update_tracking_link",
