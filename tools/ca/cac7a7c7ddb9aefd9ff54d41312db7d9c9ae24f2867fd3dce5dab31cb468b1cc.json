{
 "description": "List conversations with optional filters for contact, assignee, status, and search.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "after": {
    "description": "Cursor for pagination",
    "type": "string"
   },
   "assignedTo": {
    "description": "Filter by assigned user ID",
    "type": "string"
   },
   "contactId": {
    "description": "Filter by contact ID",
    "type": "string"
   },
   "id": {
    "description": "Filter by conversation ID",
    "type": "string"
   },
   "limit": {
    "description": "Max results to return",
    "type": "string"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "searchString": {
    "description": "Search conversations by keyword",
    "type": "string"
   },
   "sort": {
    "description": "Sort field",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction (asc or desc)",
    "type": "string"
   },
   "startAfterDate": {
    "description": "Return conversations after this date (epoch ms)",
    "type": "string"
   },
   "status": {
    "description": "Conversation status filter (all, read, unread, starred)",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_list_conversations"
}
