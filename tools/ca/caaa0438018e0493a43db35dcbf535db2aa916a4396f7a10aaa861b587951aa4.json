{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the source code surrounding a `DebugSource` from a previous scan. Returns \u00b1contextLines around `source.lineNumber`, the absolute file path, and the line range actually returned (clamped to file bounds). Use this before proposing a fix so your edits land in the right component \u2014 do not guess at the surrounding code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contextLines": {
    "description": "Lines of context above and below the target line. Default 20.",
    "maximum": 200,
    "minimum": 0,
    "type": "integer"
   },
   "source": {
    "additionalProperties": false,
    "description": "A `DebugSource` from a previous scan response.",
    "properties": {
     "columnNumber": {
      "minimum": 0,
      "type": "integer"
     },
     "fileName": {
      "minLength": 1,
      "type": "string"
     },
     "lineNumber": {
      "exclusiveMinimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "fileName",
     "lineNumber"
    ],
    "type": "object"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "name": "audioeye_get_source_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "endLine": {
    "type": "integer"
   },
   "filePath": {
    "type": "string"
   },
   "outOfBounds": {
    "type": "boolean"
   },
   "snippet": {
    "type": "string"
   },
   "startLine": {
    "type": "integer"
   },
   "totalLines": {
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "filePath",
   "startLine",
   "endLine",
   "totalLines",
   "snippet",
   "truncated",
   "outOfBounds"
  ],
  "type": "object"
 }
}
