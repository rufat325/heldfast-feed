{"_meta":{"securitySchemes":[{"scopes":["recipes:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Use after a structured recipe is saved and the user asks to attach its photos. Use the returned canonical stage/action ID and latest content revision. Supply a transferable host file descriptor or accessible HTTPS image URL, only with established reuse permission. Do not scrape private chats or claim access to search thumbnails. This saves no new recipe and uses no image-generation credits. Poll get_instruction_image for completion. If transfer is unavailable, offer RecipeBee upload. A failed photo never requires resaving the recipe.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"alt_text":{"maxLength":500,"type":"string"},"caption":{"maxLength":500,"type":"string"},"expected_revision":{"maximum":9007199254740991,"minimum":1,"type":"integer"},"file":{"additionalProperties":false,"properties":{"download_url":{"format":"uri","maxLength":4096,"type":"string"},"file_id":{"maxLength":512,"minLength":1,"type":"string"},"file_name":{"anyOf":[{"maxLength":512,"type":"string"},{"type":"null"}]},"mime_type":{"anyOf":[{"maxLength":255,"type":"string"},{"type":"null"}]}},"required":["download_url","file_id"],"type":"object"},"image_url":{"format":"uri","maxLength":4096,"type":"string"},"recipe_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"reuse_permission":{"description":"Use only when the user owns the image or has established permission to save and use it. A search result or attribution alone does not establish permission.","enum":["user_owned","permission_granted","licensed"],"type":"string"},"target_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"target_type":{"enum":["instruction_section","step"],"type":"string"}},"required":["recipe_id","expected_revision","target_type","target_id","reuse_permission"],"type":"object"},"name":"attach_instruction_image","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"operation":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"persisted":{"type":"boolean"}},"required":["operation","persisted"],"type":"object"},"securitySchemes":[{"scopes":["recipes:write"],"type":"oauth2"}],"title":"Attach instructional photo"}
