{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List every MariaDB database attached to a web hosting (with disk usage and any running operations).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_list_databases",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "databases": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "application": {
       "anyOf": [
        {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "anyOf": [
            {
             "not": {}
            },
            {
             "anyOf": [
              {
               "additionalProperties": false,
               "properties": {
                "id": {
                 "type": [
                  "string",
                  "number"
                 ]
                },
                "location": {
                 "type": "string"
                },
                "name": {
                 "type": "string"
                },
                "type": {
                 "type": "string"
                }
               },
               "type": "object"
              },
              {
               "type": "null"
              }
             ]
            }
           ]
          }
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "backups": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "disk_used": {
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "operation_in_progress": {
       "type": "boolean"
      },
      "permissions": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "rights": {
          "additionalProperties": false,
          "properties": {
           "admin": {
            "type": "boolean"
           },
           "read": {
            "type": "boolean"
           },
           "write": {
            "type": "boolean"
           }
          },
          "type": "object"
         },
         "user": {
          "type": "string"
         }
        },
        "required": [
         "user"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hosting_id": {
    "type": "number"
   }
  },
  "required": [
   "hosting_id",
   "count",
   "databases"
  ],
  "type": "object"
 }
}
