{
 "description": "Create an encounter matching the specified parameters. Uses available monsters from the world pack.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "difficulty": {
    "description": "How challenging the encounter should be",
    "enum": [
     "easy",
     "medium",
     "hard",
     "deadly"
    ],
    "type": "string"
   },
   "excludeMonsterIds": {
    "description": "Exclude these monsters",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includeMonsterIds": {
    "description": "Force specific monsters",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "locationId": {
    "description": "Use location-appropriate content",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "theme": {
    "description": "Theme like 'ambush', 'negotiation', 'chase'",
    "type": "string"
   },
   "type": {
    "default": "combat",
    "description": "Type of encounter",
    "enum": [
     "combat",
     "social",
     "puzzle",
     "environmental"
    ],
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "difficulty"
  ],
  "type": "object"
 },
 "name": "generate_encounter"
}
