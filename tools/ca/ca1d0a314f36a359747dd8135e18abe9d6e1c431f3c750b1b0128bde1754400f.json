{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Connect API and SDKs"
 },
 "description": "Keyword search across Connect REST endpoints and SDK methods. Space-separated keywords, all must match (AND). Results sorted by relevance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "description": "What to search (default: all).",
    "enum": [
     "endpoint",
     "operation",
     "all"
    ],
    "type": "string"
   },
   "language": {
    "description": "Restrict SDK matches to one language. REST endpoints always searched.",
    "enum": [
     "node",
     "python",
     "php",
     "dotnet",
     "java",
     "go",
     "ruby"
    ],
    "type": "string"
   },
   "maxResults": {
    "description": "Max results (default: 20).",
    "type": "number"
   },
   "query": {
    "description": "Space-separated keywords (AND logic).",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "searchConnect",
 "title": "Search Connect API and SDKs"
}
