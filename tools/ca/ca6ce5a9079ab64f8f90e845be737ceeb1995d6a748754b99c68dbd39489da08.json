{
 "description": "Generate a memorable passphrase from random words (XKCD-style).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capitalize": {
    "default": true,
    "description": "Capitalize first letter of each word",
    "type": "boolean"
   },
   "count": {
    "default": 3,
    "description": "Number of passphrases",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "separator": {
    "default": "-",
    "description": "Word separator",
    "type": "string"
   },
   "words": {
    "default": 4,
    "description": "Number of words",
    "maximum": 10,
    "minimum": 3,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "generate_passphrase"
}
