{
 "annotations": {},
 "description": "Upload (put) an object to an Object Storage bucket. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Content to upload as the object body",
    "type": "string"
   },
   "bucketName": {
    "description": "Name of the bucket",
    "type": "string"
   },
   "contentType": {
    "description": "Content-Type header for the object (e.g., 'text/plain', 'application/json')",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually uploading",
    "type": "boolean"
   },
   "key": {
    "description": "Object key (path) to upload to",
    "type": "string"
   }
  },
  "required": [
   "bucketName",
   "key",
   "body"
  ],
  "type": "object"
 },
 "name": "ncloud_put_object"
}
