{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "What the Modkeel lab saw a mod do"
 },
 "description": "Real runs of a Minecraft mod in the Modkeel lab: the Minecraft versions where it ran on a server or client, or crashed, and the mods it ran with. By mod id (e.g. sodium, create), not display name.",
 "inputSchema": {
  "properties": {
   "mc": {
    "description": "Minecraft version, e.g. 1.21.1 or 26.2. Omit for all versions.",
    "type": "string"
   },
   "mod_id": {
    "description": "Mod id, e.g. sodium.",
    "type": "string"
   }
  },
  "required": [
   "mod_id"
  ],
  "type": "object"
 },
 "name": "mod_lab_runs",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Snapshot date and license of the lab data; attribute when quoting.",
    "properties": {
     "built": {
      "type": "string"
     },
     "license": {
      "type": "object"
     }
    },
    "type": "object"
   },
   "mc": {
    "type": [
     "string",
     "null"
    ]
   },
   "mod": {
    "type": "string"
   },
   "pairs": {
    "description": "env: server, client or clash.",
    "items": {
     "properties": {
      "detail": {
       "type": "string"
      },
      "env": {
       "type": "string"
      },
      "mc": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "with": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "runs": {
    "description": "env: server, client or crashes.",
    "items": {
     "properties": {
      "detail": {
       "type": "string"
      },
      "env": {
       "type": "string"
      },
      "mc": {
       "type": "string"
      },
      "sha1": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "tested": {
    "description": "False: the lab never ran this mod.",
    "type": "boolean"
   }
  },
  "required": [
   "mod",
   "tested",
   "runs",
   "pairs",
   "data"
  ],
  "type": "object"
 },
 "title": "What the Modkeel lab saw a mod do"
}
