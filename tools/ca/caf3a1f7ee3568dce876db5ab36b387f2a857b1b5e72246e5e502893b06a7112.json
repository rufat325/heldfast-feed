{
 "description": "List the snapshot documents already in the snapshot directory, newest first: when each was taken, the window it covers, and how many properties, apps, packages and plugins it holds. This is what says whether there is an earlier snapshot to compare against and what to name as from and to; a file that does not parse is listed with its error rather than hidden; read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 50,
    "description": "Maximum snapshots to return, newest first",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_snapshots",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "directory": {
    "type": "string"
   },
   "snapshots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "surfaces": {
       "additionalProperties": false,
       "properties": {
        "apps": {
         "type": "number"
        },
        "packages": {
         "type": "number"
        },
        "properties": {
         "type": "number"
        },
        "slugs": {
         "type": "number"
        }
       },
       "required": [
        "properties",
        "apps",
        "packages",
        "slugs"
       ],
       "type": "object"
      },
      "takenAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "windowDays": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "path",
      "takenAt",
      "windowDays",
      "surfaces"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "directory",
   "total",
   "truncated",
   "snapshots"
  ],
  "type": "object"
 }
}
