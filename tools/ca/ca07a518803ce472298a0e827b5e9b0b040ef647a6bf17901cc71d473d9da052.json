{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search GitHub Actions logs"
 },
 "description": "Search GitHub Actions log lines from Depot runners, newest match first (job, workflow, step, timestamp, body, lineId). Defaults to the last hour (max window 30 days). Filter by repository, workflow, runner label, action or compute id. Depot: GithubActionsService/SearchGithubActionsLogs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actions": {
    "description": "Actions to include, e.g. actions/checkout.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "compute_id": {
    "description": "A single Depot compute id.",
    "type": "string"
   },
   "end_at": {
    "description": "Window end, RFC 3339 (e.g. 2026-09-18T00:00:00Z).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "page_size": {
    "description": "Page size, 1-1000.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page_token": {
    "description": "Cursor from the previous response's nextPageToken. Omit for the first page.",
    "type": "string"
   },
   "query": {
    "description": "Text to match in log bodies, e.g. \"timeout\". Empty returns unfiltered lines.",
    "type": "string"
   },
   "repositories": {
    "description": "Connected repositories in owner/name format, e.g. [\"acme/widgets\"]. Empty = all.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runner_labels": {
    "description": "Runner labels to include.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start_at": {
    "description": "Window start, RFC 3339 (e.g. 2026-09-17T00:00:00Z).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "workflows": {
    "description": "Workflow names to include.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "depot_gha_search_logs",
 "title": "Search GitHub Actions logs"
}
