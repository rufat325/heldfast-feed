{
 "description": "Compare pricing across multiple SaaS products side-by-side. Supports team-size cost calculation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "products": {
    "description": "Product slugs to compare, e.g. ['notion', 'asana', 'linear']",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   },
   "team_size": {
    "description": "Number of seats to calculate total cost",
    "type": "number"
   }
  },
  "required": [
   "products"
  ],
  "type": "object"
 },
 "name": "compare_products"
}
