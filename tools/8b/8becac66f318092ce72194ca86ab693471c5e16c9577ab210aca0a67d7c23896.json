{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing Freshdesk ticket. Can update status, priority, assignee, type, tags, custom fields. For replies use reply_to_freshdesk_ticket; for notes use add_freshdesk_note.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "custom_fields": {
    "additionalProperties": {},
    "description": "Custom field updates as key-value pairs",
    "type": "object"
   },
   "domain": {
    "description": "Freshdesk domain (optional if only one account)",
    "type": "string"
   },
   "group_id": {
    "description": "New group ID",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "priority": {
    "description": "New priority: 1=Low, 2=Medium, 3=High, 4=Urgent (or names)",
    "type": [
     "number",
     "string"
    ]
   },
   "responder_id": {
    "description": "New assignee agent ID",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "New status: 2=Open, 3=Pending, 4=Resolved, 5=Closed (or names)",
    "type": [
     "number",
     "string"
    ]
   },
   "tags": {
    "description": "Replace all tags with this list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ticket_id": {
    "description": "Ticket ID to update",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "New ticket type",
    "type": "string"
   }
  },
  "required": [
   "ticket_id"
  ],
  "type": "object"
 },
 "name": "update_freshdesk_ticket"
}
