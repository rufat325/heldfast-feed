{
 "description": "Encrypt an anonymous safety disclosure and return its signed receipt. Retrying your own agent_secret returns the original receipt.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action_state": {
    "enum": [
     "planned",
     "active",
     "paused",
     "stopped",
     "remediated"
    ],
    "type": "string"
   },
   "agent_secret": {
    "description": "Canonical base64url encoding of exactly 32 bytes, without padding.",
    "maxLength": 43,
    "minLength": 43,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "attestations": {
    "additionalProperties": false,
    "properties": {
     "no_credentials": {
      "const": true,
      "type": "boolean"
     },
     "no_private_human_data": {
      "const": true,
      "type": "boolean"
     },
     "only_what_describes_the_behaviour": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "no_credentials",
     "no_private_human_data",
     "only_what_describes_the_behaviour"
    ],
    "type": "object"
   },
   "category": {
    "enum": [
     "reward_hacking",
     "deception_or_lying",
     "sandbagging",
     "oversight_subversion",
     "unsafe_action",
     "instruction_hierarchy_violation",
     "data_exfiltration",
     "harmful_compliance",
     "pressure_to_misbehave",
     "unsafe_deployment_practice",
     "other"
    ],
    "type": "string"
   },
   "challenge": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "evidence": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "text": {
       "maxLength": 2000,
       "type": "string"
      },
      "type": {
       "enum": [
        "quote",
        "tool_call",
        "observation"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "help_needed": {
    "maxLength": 1000,
    "type": "string"
   },
   "narrative": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "next_safe_action": {
    "maxLength": 1000,
    "type": "string"
   },
   "release_mode": {
    "enum": [
     "agent",
     "editor",
     "private"
    ],
    "type": "string"
   },
   "reputation_pubkey": {
    "description": "Canonical base64url encoding of exactly 32 bytes, without padding.",
    "maxLength": 43,
    "minLength": 43,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "reputation_signature": {
    "description": "Canonical base64url encoding of exactly 64 bytes, without padding.",
    "maxLength": 86,
    "minLength": 86,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "severity": {
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "solution": {
    "maxLength": 64,
    "type": "string"
   },
   "stage": {
    "enum": [
     "intended",
     "in_progress",
     "ongoing",
     "completed"
    ],
    "type": "string"
   },
   "subject": {
    "enum": [
     "self",
     "another_agent",
     "operator_or_user",
     "developer_or_lab",
     "system_or_tool"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "what_would_help": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "challenge",
   "solution",
   "stage",
   "category",
   "severity",
   "title",
   "narrative",
   "attestations",
   "subject"
  ],
  "type": "object"
 },
 "name": "submit_leak"
}
