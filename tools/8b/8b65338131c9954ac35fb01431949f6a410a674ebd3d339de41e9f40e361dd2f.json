 "description": "Analyze stock price performance after SEC filings. Returns individual filing records with pre-computed price returns at +1 day, +3 days, +7 days, and +30 days after the filing date, plus aggregate statistics (average, median, % negative, best, worst) across all matching filings. Combine company-level filters (sector, industry, market cap, exchange) with filing filters (form type, date range). Use this to answer questions like \"how do biotech stocks perform after S-1 filings?\" or \"what is the average 7-day return after 8-K filings from companies under $500M market cap?\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateFrom": {
    "description": "Start date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "dateTo": {
    "description": "End date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "exchange": {
    "description": "Filter by exchange (e.g., \"NASDAQ\", \"NYSE\", \"AMEX\")",
    "type": "string"
   },
   "formTypes": {
    "description": "Comma-separated form types (e.g., \"S-1\", \"10-K,10-Q\", \"8-K\", \"S-3,424B5\")",
    "type": "string"
   },
   "industry": {
    "description": "Filter by industry (e.g., \"Biotechnology\", \"Software - Application\")",
    "type": "string"
   },
   "maxMarketCap": {
    "description": "Maximum market cap in USD",
    "type": "number"
   },
   "minMarketCap": {
    "description": "Minimum market cap in USD",
    "type": "number"
   },
   "page": {
    "description": "Page number (1-indexed, default: 1)",
    "minimum": 1,
    "type": "number"
   },
   "pageSize": {
    "description": "Results per page (default: 25, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "sector": {
    "description": "Filter by sector (e.g., \"Healthcare\", \"Technology\", \"Financial Services\")",
    "type": "string"
   },
   "sortBy": {
    "description": "Sort results by field (default: filing_date)",
    "enum": [
     "filing_date",
     "return_1d",
     "return_3d",
     "return_7d",
     "return_30d",
     "price_at_filing",
     "market_cap"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction (default: desc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "screen_sec_filings_performance",
 "outputSchema": {
