{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Describe one operation, including its input schema and risk. For write operations, pass the exact intended input to receive an approval with its ID, status, URL, and expiry.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "description": "Exact intended input. Required to obtain approval for a write operation.",
    "properties": {
     "body": {
      "additionalProperties": {},
      "type": "object"
     },
     "params": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "operation_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "operation_id"
  ],
  "type": "object"
 },
 "name": "describe_operation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approval": {
    "additionalProperties": false,
    "properties": {
     "approval_url": {
      "format": "uri",
      "type": "string"
     },
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "status": {
      "const": "pending",
      "type": "string"
     }
    },
    "required": [
     "approval_url",
     "expires_at",
     "id",
     "status"
    ],
    "type": "object"
   },
   "operation": {
    "additionalProperties": false,
    "properties": {
     "confirmation_required": {
      "type": "boolean"
     },
     "description": {
      "type": "string"
     },
     "input_schema": {
      "additionalProperties": {},
      "type": "object"
     },
     "method": {
      "enum": [
       "DELETE",
       "GET",
       "PATCH",
       "POST",
       "PUT"
      ],
      "type": "string"
     },
     "operation_id": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "risk": {
      "items": {
       "enum": [
        "read",
        "write",
        "destructive",
        "external_effect"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "confirmation_required",
     "description",
     "method",
     "operation_id",
     "path",
     "risk",
     "summary",
     "input_schema"
    ],
    "type": "object"
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 }
}
