{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compare up to 12 warp angles, sequentially, at one fixed seed and cloth configuration.\n\n        When omitted, seed is suggested once for the first angle. Results rank by\n        coverage descending, then percentage above lock ascending, then maximum\n        shear ascending. This is a stated comparison rule, not a global optimum.\n        Runs use the requested/preset pitch, never a hidden coarse approximation.\n        Export the chosen result promptly: backend result IDs are temporary.\n        ",
 "inputSchema": {
  "properties": {
   "angles": {
    "items": {
     "type": "number"
    },
    "maxItems": 12,
    "minItems": 1,
    "title": "Angles",
    "type": "array"
   },
   "fabric_id": {
    "default": "carbon-twill-3k",
    "title": "Fabric Id",
    "type": "string"
   },
   "hole_area": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Hole Area"
   },
   "lock_angle": {
    "anyOf": [
     {
      "exclusiveMaximum": 90,
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Lock Angle"
   },
   "mesh_id": {
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "title": "Mesh Id",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 50,
    "minimum": -50,
    "title": "Offset",
    "type": "number"
   },
   "pitch": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Pitch"
   },
   "seed": {
    "anyOf": [
     {
      "items": {
       "type": "number"
      },
      "maxItems": 3,
      "minItems": 3,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Seed"
   },
   "workspace_id": {
    "pattern": "^[0-9a-f]{48}$",
    "title": "Workspace Id",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "mesh_id",
   "angles"
  ],
  "title": "compare_drapesArguments",
  "type": "object"
 },
 "name": "compare_drapes",
 "outputSchema": {
  "additionalProperties": true,
  "title": "compare_drapesDictOutput",
  "type": "object"
 }
}
