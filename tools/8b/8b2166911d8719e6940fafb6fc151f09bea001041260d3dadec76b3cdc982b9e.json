{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Find similar papers"},"description":"Ranks papers by their citation links to the seeds, which surfaces related work that keyword search misses. Give 1\u2013500 seed papers (DOIs, OpenAlex IDs or PMIDs); returns the papers most similar to them by citation links, sorted by score. Method: fast similarity, Adamic/Adar plus Salton co-citation on a depth-1 citation graph. With 2\u201315 seeds, each seed is ranked separately and the rankings are merged by reciprocal rank, so papers that rank well for several seeds come out on top; above 15, it uses Adamic/Adar against a synthetic paper that cites all the seeds. Seeds are left out of the results, and scores rank within one result set. limit is at most 100. Unresolved seeds are listed in diagnostics.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"limit":{"default":25,"maximum":100,"minimum":1,"type":"integer"},"seeds":{"description":"1\u2013500 seed papers: DOIs, OpenAlex IDs (W\u2026) or PMIDs. Duplicates count once.","items":{"maxLength":300,"minLength":1,"type":"string"},"maxItems":500,"minItems":1,"type":"array"}},"required":["seeds"],"type":"object"},"name":"find_similar_papers","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"diagnostics":{"additionalProperties":false,"properties":{"advisories":{"items":{"type":"string"},"type":"array"},"unresolved_seeds":{"items":{"additionalProperties":false,"properties":{"input":{"type":"string"},"reason":{"type":"string"}},"required":["input","reason"],"type":"object"},"type":"array"}},"required":["advisories"],"type":"object"},"inciteful_url":{"type":["string","null"]},"provenance":{"additionalProperties":false,"properties":{"coverage_note":{"type":"string"},"data_source":{"type":"string"},"effective_limit":{"type":["number","null"]},"filters":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"graph":{"additionalProperties":false,"properties":{"citations":{"type":["number","null"]},"depth":{"type":["number","null"]},"highly_cited_not_expanded":{"type":["number","null"]},"note":{"type":"string"},"papers":{"type":["number","null"]},"prune_threshold":{"type":["number","null"]},"seeds_not_expanded":{"type":["number","null"]}},"required":["papers","citations","depth","prune_threshold","highly_cited_not_expanded","seeds_not_expanded"],"type":"object"},"graph_snapshot":{"type":["string","null"]},"hops":{"items":{"type":"number"},"type":"array"},"method":{"type":"string"},"papers_searched":{"type":"number"},"recent_tier":{"type":["string","null"]},"retrieved_at":{"type":"string"},"seeds":{"items":{"additionalProperties":false,"properties":{"input":{"type":"string"},"openalex_id":{"type":"string"}},"required":["input","openalex_id"],"type":"object"},"type":"array"},"server_version":{"type":"string"},"sql_executed":{"type":["string","null"]},"tool":{"type":"string"},"total":{"type":["number","null"]}},"required":["retrieved_at","tool","server_version","data_source","graph_snapshot","recent_tier","coverage_note","seeds","graph","method","filters","sql_executed","effective_limit"],"type":"object"},"rows":{"items":{"additionalProperties":false,"properties":{"authors":{"items":{"type":"string"},"type":"array"},"doi":{"type":["string","null"]},"inciteful_url":{"type":"string"},"journal":{"type":["string","null"]},"num_cited_by":{"type":["number","null"]},"num_citing":{"type":["number","null"]},"paper_id":{"type":"string"},"published_year":{"type":["number","null"]},"score":{"type":"number"},"title":{"type":["string","null"]}},"required":["paper_id","doi","title","published_year","journal","authors","num_cited_by","num_citing","inciteful_url","score"],"type":"object"},"type":"array"},"truncated":{"type":"boolean"}},"required":["rows","truncated","provenance","inciteful_url"],"type":"object"},"title":"Find similar papers"}
