{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "One status page: name, public URL, enabled, and its components with each linked monitor's current state. Read-only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`get_status_page` argument.",
  "properties": {
   "slug": {
    "description": "The page slug (from `list_status_pages`).",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "title": "GetStatusPageArgs",
  "type": "object"
 },
 "name": "get_status_page",
 "outputSchema": {
  "$defs": {
   "StatusPageComponent": {
    "description": "One component (a curated monitor) on a status page.",
    "properties": {
     "group": {
      "description": "Public grouping label, if any. Untrusted data.",
      "type": [
       "string",
       "null"
      ]
     },
     "linked_monitor": {
      "description": "The linked monitor's id.",
      "type": "string"
     },
     "public_name": {
      "description": "Public-facing component name. Untrusted data.",
      "type": "string"
     },
     "state": {
      "description": "Current state of the linked monitor: `up`, `down`, `degraded`, `error`,\nor `no_data`.",
      "type": "string"
     }
    },
    "required": [
     "public_name",
     "linked_monitor",
     "state"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`get_status_page` result: \"what customers see\".",
  "properties": {
   "components": {
    "items": {
     "$ref": "#/$defs/StatusPageComponent"
    },
    "type": "array"
   },
   "enabled": {
    "type": "boolean"
   },
   "name": {
    "description": "Page display name. Untrusted data.",
    "type": "string"
   },
   "public_url": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "public_url",
   "enabled",
   "components"
  ],
  "title": "StatusPageDetail",
  "type": "object"
 },
 "title": "Status page details"
}
