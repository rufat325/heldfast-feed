{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search execution history by tags, free text query, or success status. Find what commands were run, what worked, and learn from past experiments. Query searches across command, context, and output fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Pagination cursor",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum results to return",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "orderBy": {
    "default": "recent",
    "description": "Sort order",
    "enum": [
     "recent",
     "oldest"
    ],
    "type": "string"
   },
   "query": {
    "description": "Free text search in command, context, and output",
    "type": "string"
   },
   "skillName": {
    "description": "Filter by related skill name",
    "type": "string"
   },
   "success": {
    "description": "Filter by success status",
    "type": "boolean"
   },
   "tags": {
    "description": "Filter by tags (e.g., test, build)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "search_execution_logs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "logs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "command": {
       "type": "string"
      },
      "context": {
       "type": [
        "string",
        "null"
       ]
      },
      "createdAt": {
       "type": "string"
      },
      "durationMs": {
       "type": [
        "number",
        "null"
       ]
      },
      "exitCode": {
       "type": [
        "number",
        "null"
       ]
      },
      "id": {
       "type": "number"
      },
      "output": {
       "type": [
        "string",
        "null"
       ]
      },
      "skillName": {
       "type": [
        "string",
        "null"
       ]
      },
      "success": {
       "type": "boolean"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "workingDirectory": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "command",
      "workingDirectory",
      "context",
      "output",
      "exitCode",
      "success",
      "durationMs",
      "skillName",
      "tags",
      "createdAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "type": "string"
   },
   "suggestedTags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "logs"
  ],
  "type": "object"
 },
 "title": "Search Execution Logs"
}
