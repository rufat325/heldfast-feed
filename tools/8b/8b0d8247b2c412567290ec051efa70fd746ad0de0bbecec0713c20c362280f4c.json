{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Usgs Earthquake Feed"
 },
 "description": "USGS official earthquake summary feed by period and minimum magnitude. period: hour|day|week|month. min_mag: 1.0|2.5|4.5|significant. Returns all events worldwide above the threshold within the period, with magnitude, location, depth, and event detail URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "min_mag": {
    "description": "Minimum magnitude threshold (default '2.5')",
    "enum": [
     "1.0",
     "2.5",
     "4.5",
     "significant"
    ],
    "type": "string"
   },
   "period": {
    "description": "Time window (default 'day')",
    "enum": [
     "hour",
     "day",
     "week",
     "month"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "usgs_earthquake_feed"
}
