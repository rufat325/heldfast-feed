{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "\u26a0\ufe0f Destructive: Remove port monitoring plugin(s) from a server instance. Set confirm=true to execute.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "default": false,
    "description": "Must be true to actually execute the destructive operation",
    "type": "boolean"
   },
   "instanceNo": {
    "description": "Server instance number",
    "type": "string"
   },
   "portList": {
    "description": "Port numbers to remove",
    "items": {
     "type": "number"
    },
    "minItems": 1,
    "type": "array"
   },
   "type": {
    "description": "Target type (default 'vpcserver')",
    "enum": [
     "vpcserver",
     "classicserver",
     "cloudhadoop"
    ],
    "type": "string"
   }
  },
  "required": [
   "instanceNo",
   "portList"
  ],
  "type": "object"
 },
 "name": "ncloud_remove_port_plugin"
}
