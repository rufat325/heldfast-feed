{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Troubleshoot Guided Workflow"},"description":"Structured failure analysis and test plan generation with memory integration for troubleshooting session tracking and intelligent ADR/research suggestion capabilities - provide JSON failure info to get specific test commands","inputSchema":{"properties":{"adrDirectory":{"default":"docs/adrs","description":"ADR directory path","type":"string"},"enableAdrSuggestion":{"default":true,"description":"Enable automatic ADR suggestion based on recurring failures","type":"boolean"},"enableMemoryIntegration":{"default":true,"description":"Enable memory entity storage for troubleshooting session tracking and pattern recognition","type":"boolean"},"enablePatternRecognition":{"default":true,"description":"Enable automatic pattern recognition and failure classification","type":"boolean"},"enableResearchGeneration":{"default":true,"description":"Enable automatic research question generation for persistent problems","type":"boolean"},"failure":{"description":"Structured failure information (required for analyze_failure and generate_test_plan)","properties":{"context":{"description":"Additional context about the failure (optional)","properties":{"frequency":{"description":"How often this failure occurs (optional)","type":"string"},"impact":{"description":"Impact level of the failure (optional)","enum":["low","medium","high","critical"],"type":"string"},"recentChanges":{"description":"Recent changes that might be related (optional)","type":"string"},"reproducible":{"description":"Whether the failure is reproducible (optional)","type":"boolean"}},"type":"object"},"failureDetails":{"description":"Detailed failure information","properties":{"affectedFiles":{"description":"Files involved in the failure (optional)","items":{"type":"string"},"type":"array"},"command":{"description":"Command that failed (optional)","type":"string"},"en