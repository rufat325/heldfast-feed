{
 "description": "Build an unsigned transaction to transfer native tokens or ERC-20/SIP-010 tokens on any supported chain (requires Pro \u2014 you're on Free)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Amount as a string (e.g. '1.5')",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "chain": {
    "enum": [
     "celo",
     "base",
     "stacks"
    ],
    "type": "string"
   },
   "from": {
    "description": "Sender address",
    "type": "string"
   },
   "to": {
    "description": "Recipient address",
    "type": "string"
   },
   "tokenAddress": {
    "description": "ERC-20/SIP-010 contract address. Omit for native transfer.",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "from",
   "to",
   "amount"
  ],
  "type": "object"
 },
 "name": "prepare_transfer"
}
