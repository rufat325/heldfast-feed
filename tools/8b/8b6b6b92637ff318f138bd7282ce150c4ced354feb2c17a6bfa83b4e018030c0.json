{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"KEY TOOL FOR TRIAGE. Scans a whole folder (Inbox by default) and aggregates messages by sender: count, unread, latest message, and for the `top` senders the available unsubscribe method (oneClick / https / mailto). Sorted by volume. The scan is cached for the session. Follow up with mail_unsubscribe(lastMessageId) and mail_bulk_by_sender(address).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"folder":{"description":"Folder to analyse. Default: inbox","type":"string"},"since":{"description":"Only count messages received since this date","pattern":"^\\d{4}-\\d{2}-\\d{2}(T[\\d:]+(\\.\\d+)?Z?)?$","type":"string"},"top":{"default":50,"description":"Number of senders to return (max 200)","maximum":200,"minimum":1,"type":"integer"}},"type":"object"},"name":"mail_senders_summary","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"scanned":{"type":"number"},"senders":{"items":{"additionalProperties":false,"properties":{"address":{"type":"string"},"count":{"type":"number"},"domain":{"type":"string"},"lastMessageId":{"type":"string"},"lastReceived":{"type":"string"},"lastSubject":{"type":"string"},"name":{"type":"string"},"unreadCount":{"type":"number"},"unsubscribe":{"additionalProperties":false,"properties":{"https":{"type":"string"},"mailto":{"type":"string"},"mailtoBody":{"type":"string"},"mailtoSubject":{"type":"string"},"oneClick":{"type":"boolean"}},"required":["oneClick"],"type":"object"}},"required":["address","name","domain","count","unreadCount","lastReceived","lastSubject","lastMessageId"],"type":"object"},"type":"array"},"totalSenders":{"type":"number"}},"required":["scanned","totalSenders","senders"],"type":"object"},"title":"Summary by sender"}
