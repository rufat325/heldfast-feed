{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search bounded NATS/JetStream messages.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contextId": {
    "type": "string"
   },
   "correlationId": {
    "type": "string"
   },
   "cursor": {
    "description": "Resume cursor from a previous nextCursor.",
    "type": "string"
   },
   "fromTs": {
    "description": "Window start in epoch milliseconds.",
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "description": "Required maximum number of results.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "maxScan": {
    "description": "Maximum messages scanned before returning a cursor (default 10000).",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "requestId": {
    "type": "string"
   },
   "stream": {
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "toTs": {
    "description": "Window end in epoch milliseconds.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "contextId",
   "stream",
   "limit"
  ],
  "type": "object"
 },
 "name": "natstrail.search_messages"
}
