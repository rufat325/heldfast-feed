{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Stock History"
 },
 "description": "Get historical stock price data - open, high, low, close, and volume (OHLCV). Supports intraday (1-minute) through multi-year (5-year, max) ranges. Use this for \"how has AAPL performed this year?\", \"show me the price chart for Tesla\", \"what was the stock price last month?\", \"historical performance\", or any stock price history question.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "interval": {
    "description": "Data interval (default: \"1d\")",
    "enum": [
     "1m",
     "5m",
     "15m",
     "1d",
     "1wk",
     "1mo"
    ],
    "type": "string"
   },
   "period": {
    "description": "Time range (default: \"1mo\")",
    "enum": [
     "1d",
     "5d",
     "1mo",
     "3mo",
     "6mo",
     "1y",
     "2y",
     "5y",
     "max"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Stock ticker symbol (e.g., \"AAPL\")",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "stock_history"
}
