{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "watch:manage"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a Remode Hunt"
 },
 "description": "Edit criteria for an existing Hunt using its returned watch_id. Read get_watch_updates first. Use operation add to preserve existing criteria when the shopper asks for another lane; remove to drop a lane; replace only for an explicit complete change. Removing lower_price also deletes its saved price target; disclose that consequence before the change. No size or budget editing is supported here. Never change a Hunt unless the user asks, and read its state after a timeout or conflict before deciding whether to retry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "operation": {
    "description": "Use add for 'also find second-hand', remove to drop a criterion, or replace for an explicitly requested full change. Defaults to replace for existing clients. Removing lower_price also removes its saved price target.",
    "enum": [
     "add",
     "remove",
     "replace"
    ],
    "type": "string"
   },
   "preferences": {
    "description": "Criteria to add, remove or replace. For replace, send the complete desired set; omitted criteria are removed.",
    "items": {
     "enum": [
      "lower_price",
      "second_hand"
     ],
     "type": "string"
    },
    "maxItems": 2,
    "minItems": 1,
    "type": "array"
   },
   "watch_id": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "watch_id",
   "preferences"
  ],
  "type": "object"
 },
 "name": "update_watch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ok": {
    "const": true,
    "type": "boolean"
   },
   "watch": {
    "additionalProperties": false,
    "properties": {
     "active": {
      "type": "boolean"
     },
     "currency": {
      "type": "string"
     },
     "image_url": {
      "type": "string"
     },
     "last_checked_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "preferences": {
      "items": {
       "enum": [
        "lower_price",
        "second_hand"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "price": {
      "type": "string"
     },
     "region": {
      "type": "string"
     },
     "requested_terms": {
      "additionalProperties": false,
      "properties": {
       "color": {
        "maxLength": 40,
        "type": "string"
       },
       "condition": {
        "enum": [
         "new",
         "pre_owned",
         "any"
        ],
        "type": "string"
       },
       "evidence": {
        "const": "stored_mandate",
        "type": "string"
       },
       "price_target": {
        "oneOf": [
         {
          "additionalProperties": false,
          "properties": {
           "amount": {
            "exclusiveMinimum": 0,
            "maximum": 10000000,
            "type": "number"
           },
           "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
           },
           "mode": {
            "const": "absolute",
            "type": "string"
           }
          },
          "required": [
           "mode",
           "amount",
           "currency"
          ],
          "type": "object"
         },
         {
          "additionalProperties": false,
          "properties": {
           "amount": {
            "exclusiveMinimum": 0,
            "maximum": 10000000,
            "type": "number"
           },
           "currency": {
            "pattern": "^[A-Z]{3}$",
            "type": "string"
           },
           "mode": {
            "const": "percent_off",
            "type": "string"
           },
           "percent_off": {
            "exclusiveMaximum": 100,
            "exclusiveMinimum": 0,
            "type": "number"
           }
          },
          "required": [
           "mode",
           "amount",
           "currency",
           "percent_off"
          ],
          "type": "object"
         }
        ]
       },
       "size": {
        "maxLength": 24,
        "type": "string"
       }
      },
      "required": [
       "evidence"
      ],
      "type": "object"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updated_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "url": {
      "type": "string"
     },
     "watch_id": {
      "type": "string"
     }
    },
    "required": [
     "watch_id",
     "status",
     "active",
     "title",
     "url",
     "image_url",
     "price",
     "currency",
     "region",
     "preferences",
     "last_checked_at",
     "updated_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "watch"
  ],
  "type": "object"
 },
 "title": "Update a Hunt"
}
