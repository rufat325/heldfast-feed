{
 "description": "Get first row from Google Sheet. Returns columns array and isEmpty flag.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "render": {
    "description": "How to render cell values. FORMATTED_VALUE (default): calculated with formatting. UNFORMATTED_VALUE: calculated without formatting. FORMULA: show formula text instead of result.",
    "enum": [
     "FORMATTED_VALUE",
     "UNFORMATTED_VALUE",
     "FORMULA"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid"
  ],
  "type": "object"
 },
 "name": "columns-get",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "columns": {
        "description": "First row values (column names) or empty if no rows",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "isEmpty": {
        "description": "True if sheet has zero rows",
        "type": "boolean"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "columns",
       "isEmpty"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
