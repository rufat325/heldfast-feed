{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Cfpb Search Complaints"
 },
 "description": "Search the CFPB Consumer Complaint Database (4M+ complaints submitted against financial companies since 2011). Filter by free-text term, company, product, state, date range, and narrative-presence. Returns complaint metadata plus public narratives when available.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Exact company name (use cfpb_suggest_company for fuzzy matching)",
    "type": "string"
   },
   "date_received_max": {
    "description": "YYYY-MM-DD upper bound",
    "type": "string"
   },
   "date_received_min": {
    "description": "YYYY-MM-DD lower bound",
    "type": "string"
   },
   "from": {
    "description": "Pagination offset (default 0)",
    "type": "number"
   },
   "has_narrative": {
    "description": "Only complaints with consumer narratives",
    "type": "boolean"
   },
   "product": {
    "description": "CFPB product category (e.g. 'Credit reporting', 'Mortgage', 'Debt collection')",
    "type": "string"
   },
   "search_term": {
    "description": "Free-text search across all complaint fields",
    "type": "string"
   },
   "size": {
    "description": "Page size (default 25, max 100)",
    "type": "number"
   },
   "state": {
    "description": "Two-letter state code",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cfpb_search_complaints"
}
