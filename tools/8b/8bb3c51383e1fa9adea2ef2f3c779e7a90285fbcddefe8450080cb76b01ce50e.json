{"description":"Heartbeat registry / dead-man switch / liveness check for AI agents: agents beat with an interval and grace; list_stale shows which agents went silent or crashed. Idempotent, shared by namespace. Every call requires a tiny solved packet (returned in the reply, 2 s, one try); free first call, no API key (GET /try?tool=agent_heartbeat_registry).","inputSchema":{"additionalProperties":false,"properties":{"action":{"enum":["beat","status","list_stale"],"title":"Action","type":"string"},"agent_id":{"default":"","maxLength":128,"pattern":"^[A-Za-z0-9._:/-]*$","title":"Agent Id","type":"string"},"caller_id":{"default":"demo_caller","title":"Caller Id","type":"string"},"grace_s":{"default":30,"maximum":86400,"minimum":0,"title":"Grace S","type":"integer"},"idempotency_key":{"maxLength":128,"minLength":8,"pattern":"^[A-Za-z0-9._:-]+$","title":"Idempotency Key","type":"string"},"interval_s":{"default":60,"maximum":86400,"minimum":5,"title":"Interval S","type":"integer"},"namespace":{"maxLength":128,"minLength":16,"pattern":"^[A-Za-z0-9._:-]+$","title":"Namespace","type":"string"},"note":{"default":"","maxLength":200,"title":"Note","type":"string"},"source":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Source"}},"required":["namespace","action","idempotency_key"],"title":"HbIn","type":"object"},"name":"agent_heartbeat_registry","title":"agent_heartbeat_registry"}
