{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this to browse an EU instrument's article, annex or recital index, or enumerate its topic-tagged provisions for a coverage question. Metadata only: each item carries the exact locator get_provision accepts. Articles and annexes by default; pass kind=recital for recitals.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://paymentslaw.eu/icon-512.png"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "32x32"
   ],
   "src": "https://paymentslaw.eu/favicon-32.png"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "180x180"
   ],
   "src": "https://paymentslaw.eu/apple-touch-icon.png"
  },
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://paymentslaw.eu/favicon.svg"
  },
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chapter": {
    "anyOf": [
     {
      "maxLength": 256,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "cursor": {
    "anyOf": [
     {
      "maxLength": 512,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "instrument_id": {
    "maxLength": 64,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "kind": {
    "anyOf": [
     {
      "enum": [
       "article",
       "annex",
       "recital"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "topic": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "instrument_id"
  ],
  "type": "object"
 },
 "name": "list_provisions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "corpus_release": {
    "additionalProperties": false,
    "properties": {
     "built_at": {
      "type": "string"
     },
     "corpus_release_id": {
      "type": "string"
     },
     "schema_version": {
      "type": "string"
     }
    },
    "required": [
     "corpus_release_id",
     "schema_version",
     "built_at"
    ],
    "type": "object"
   },
   "coverage": {
    "additionalProperties": false,
    "properties": {
     "corpus": {
      "type": "string"
     },
     "exhaustive": {
      "type": "boolean"
     },
     "language": {
      "type": "string"
     },
     "national_implementation": {
      "type": "boolean"
     }
    },
    "required": [
     "corpus",
     "language",
     "exhaustive",
     "national_implementation"
    ],
    "type": "object"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "instrument_id": {
        "type": "string"
       },
       "items": {
        "items": {
         "additionalProperties": {},
         "properties": {
          "cite": {
           "type": "string"
          }
         },
         "required": [
          "cite"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "kinds_listed": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "next_cursor": {
        "type": [
         "string",
         "null"
        ]
       },
       "total": {
        "type": "number"
       }
      },
      "required": [
       "instrument_id",
       "kinds_listed",
       "items",
       "next_cursor",
       "total"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "derivations": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "details": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "message": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "message",
       "details"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "pagination": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "complete": {
        "type": "boolean"
       },
       "next_cursor": {
        "type": [
         "string",
         "null"
        ]
       },
       "total": {
        "type": "number"
       }
      },
      "required": [
       "complete",
       "next_cursor"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "provenance": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "details": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "data",
   "error",
   "provenance",
   "coverage",
   "derivations",
   "corpus_release",
   "warnings",
   "pagination"
  ],
  "type": "object"
 },
 "title": "Browse an instrument's provisions"
}
