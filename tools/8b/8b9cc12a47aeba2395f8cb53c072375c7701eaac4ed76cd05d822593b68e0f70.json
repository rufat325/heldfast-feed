{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Check a transaction already submitted by the payer on the checkout network. Never sends funds. Use the rail and checkoutId returned by request_checkout.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "checkoutId": {
    "pattern": "^[a-zA-Z0-9_-]{8,128}$",
    "type": "string"
   },
   "rail": {
    "enum": [
     "BASE_USDC",
     "TRON_USDT"
    ],
    "type": "string"
   },
   "txHash": {
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   }
  },
  "required": [
   "checkoutId",
   "rail",
   "txHash"
  ],
  "type": "object"
 },
 "name": "verify_checkout_payment",
 "title": "Verify Checkout Payment"
}
