{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Contract Testing: Create Webhook"
 },
 "description": "Create a new webhook to trigger on contract events.\n\n**Toolset:** Webhooks\n\n**Parameters:**\n- description (string) *required*: Human-readable description of the webhook\n- events (array) *required*: Events that trigger this webhook\n- request (object) *required*: HTTP request to send when triggered\n- consumer (object): Restrict to a specific consumer (omit for all)\n- provider (object): Restrict to a specific provider (omit for all)\n- enabled (boolean): Whether the webhook is enabled (default: true)\n- teamUuid (string): UUID of the owning team (null for global)",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "consumer": {
    "description": "Restrict to a specific consumer (omit for all)",
    "properties": {
     "name": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "description": {
    "description": "Human-readable description of the webhook",
    "type": "string"
   },
   "enabled": {
    "default": true,
    "description": "Whether the webhook is enabled",
    "type": "boolean"
   },
   "events": {
    "description": "Events that trigger this webhook",
    "items": {
     "properties": {
      "name": {
       "description": "Event name (e.g. 'contract_content_changed', 'provider_verification_published')",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "provider": {
    "description": "Restrict to a specific provider (omit for all)",
    "properties": {
     "name": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "request": {
    "description": "HTTP request to send when triggered",
    "properties": {
     "body": {
      "description": "Request body to send"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "HTTP headers to include",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "method": {
      "const": "POST",
      "description": "HTTP method (must be POST)",
      "type": "string"
     },
     "password": {
      "description": "Password for basic auth",
      "type": "string"
     },
     "url": {
      "description": "URL to send the webhook request to",
      "format": "uri",
      "type": "string"
     },
     "username": {
      "description": "Username for basic auth",
      "type": "string"
     }
    },
    "required": [
     "method",
     "url"
    ],
    "type": "object"
   },
   "teamUuid": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "UUID of the owning team (null for global)"
   }
  },
  "required": [
   "description",
   "events",
   "request"
  ],
  "type": "object"
 },
 "name": "contract-testing_create_webhook",
 "title": "Contract Testing: Create Webhook"
}
