{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search and rank travel inventory for AI agents. Use for hotels/accommodations now; car rentals are supported when Booking.com Demand credentials are configured. Attractions and transfers use provider beta endpoints. Returns a recommended option, alternatives, price signals and a booking route when the provider supplies one.",
 "inputSchema": {
  "properties": {
   "adults": {
    "default": 2,
    "type": "integer"
   },
   "airport": {
    "type": "string"
   },
   "booker_country": {
    "default": "jp",
    "type": "string"
   },
   "cabin_class": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "checkin": {
    "type": "string"
   },
   "checkout": {
    "type": "string"
   },
   "children": {
    "default": 0,
    "type": "integer"
   },
   "city": {
    "type": "integer"
   },
   "country": {
    "type": "string"
   },
   "currency": {
    "default": "JPY",
    "type": "string"
   },
   "departure_date": {
    "description": "YYYY-MM-DD for flight search.",
    "type": "string"
   },
   "destination": {
    "description": "IATA airport code for flight search.",
    "type": "string"
   },
   "max_connections": {
    "default": 1,
    "type": "integer"
   },
   "origin": {
    "description": "IATA airport code for flight search.",
    "type": "string"
   },
   "return_date": {
    "description": "Optional YYYY-MM-DD return date.",
    "type": "string"
   },
   "rooms": {
    "default": 1,
    "type": "integer"
   },
   "rows": {
    "default": 20,
    "type": "integer"
   },
   "search_query": {
    "type": "string"
   },
   "vertical": {
    "default": "accommodation",
    "enum": [
     "accommodation",
     "flight",
     "car",
     "attraction",
     "transfer"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "travel_shopping_intelligence",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Travel Shopping Intelligence"
}
