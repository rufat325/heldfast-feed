{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Entities with their frontmatter's short facts, in address order or newest first. Use to browse, or for what runs on a date, came last or has a value; to find by words use search. Input: optional `type`, `owner`, `order`, `on`, `by`, `where`, `fields`, `limit`, `cursor`. Returns `entities` with `fields`, and `page`; follow `page.nextCursor` while `page.hasMore`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "by": {
    "description": "A date field, such as start or decided, to order by in the direction order names",
    "type": "string"
   },
   "cursor": {
    "description": "`page.nextCursor` from the previous answer, sent with the same arguments; omit it for the first page.",
    "type": "string"
   },
   "fields": {
    "description": "Fields to add by name beside the short ones every entity carries, such as an array",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Entries per page: 50 by default, clamped to 1\u2013200, so 0 returns one entry and 1000 returns 200.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "on": {
    "description": "A date, YYYY, YYYY-MM or YYYY-MM-DD: keep the entities whose period, start to end, holds it; an absent end is still running",
    "type": "string"
   },
   "order": {
    "description": "address, where the pages sit, by default; newest or oldest, by when each entity came into the model, or by the date `by` names",
    "enum": [
     "address",
     "newest",
     "oldest"
    ],
    "type": "string"
   },
   "owner": {
    "description": "An owner's id or address, to keep its entities",
    "type": "string"
   },
   "type": {
    "description": "A type, to keep its entities; leave it out to list every type",
    "type": "string"
   },
   "where": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Field values to keep, ignoring case, by field name; a reference matches by the name its page writes",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "list_entities",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "entities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "fields": {
       "additionalProperties": {
        "anyOf": [
         {
          "type": [
           "string",
           "number",
           "boolean"
          ]
         },
         {
          "items": {
           "type": [
            "string",
            "number",
            "boolean"
           ]
          },
          "type": "array"
         }
        ]
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "owner": {
       "type": [
        "string",
        "null"
       ]
      },
      "tagline": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "name",
      "tagline",
      "owner",
      "fields"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "type": [
       "string",
       "null"
      ]
     },
     "core": {
      "type": "string"
     },
     "parser": {
      "type": "string"
     },
     "repo": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "commit",
     "repo",
     "core",
     "parser"
    ],
    "type": "object"
   },
   "page": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     },
     "returned": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "total",
     "returned",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   },
   "type": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "type",
   "entities",
   "page",
   "model"
  ],
  "type": "object"
 }
}
