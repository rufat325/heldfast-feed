{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Start a top-up/recharge for an existing line or eSIM, using a product_id from topup_lookup. Returns an order_id and a payment URL where the customer completes payment. For range plans, pass custom_amount.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"carrier":{"type":"string"},"custom_amount":{"description":"For range/RTR plans only.","exclusiveMinimum":0,"type":"number"},"customer_email":{"format":"email","pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"iccid":{"description":"eSIM ICCID (esim).","type":"string"},"line_type":{"enum":["us_prepaid","esim"],"type":"string"},"phone":{"description":"US phone (us_prepaid).","type":"string"},"product_id":{"description":"Top-up plan id from topup_lookup.","type":"string"},"source_order_id":{"description":"Original eSIM order id (esim).","type":"string"}},"required":["line_type","product_id","customer_email"],"type":"object"},"name":"topup_start","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"amount":{"type":"number"},"currency":{"type":"string"},"error":{"type":"string"},"message":{"type":"string"},"order_id":{"type":"string"},"payment_url":{"type":["string","null"]},"product":{"type":"string"},"status":{"type":"string"}},"required":["order_id","status","amount","currency"],"type":"object"},"title":"Start a top-up"}
