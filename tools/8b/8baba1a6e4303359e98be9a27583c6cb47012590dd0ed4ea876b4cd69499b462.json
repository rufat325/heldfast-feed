{
 "_meta": {
  "ui": {
   "resourceUri": "ui://warp/batch-quote-card.mcp",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://warp/batch-quote-card.mcp"
 },
 "annotations": {
  "readOnlyHint": true,
  "title": "Batch Quote Lanes"
 },
 "description": "Price up to 50 lanes in one call for a specified mode per row (defaults to LTL). This returns a Warp rate per row, NOT all-mode or all-carrier comparison. For Compare All use compare_modes per shipment; for LTL carrier alternatives use ltl_market_options. Never imply this tool compared every carrier. Returns a single batch-quote card with one row per lane (origin \u2192 dest \u00b7 mode \u00b7 pallets \u00b7 price \u00b7 transit). Each priced lane keeps its quote_id and can be booked individually with book (\"book row 3\").",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lanes": {
    "description": "Array of lane requests (1-50). Each row maps to one quote.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "commodity": {
       "type": "string"
      },
      "delivery_services": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "destination_zip": {
       "description": "5-digit US ZIP code",
       "pattern": "^\\d{5}$",
       "type": "string"
      },
      "freight_class": {
       "type": "string"
      },
      "hazmat": {
       "type": "boolean"
      },
      "height_in": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "length_in": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "mode": {
       "description": "Mode for this lane. Defaults to 'ltl'.",
       "enum": [
        "ltl",
        "ftl",
        "van",
        "box-truck"
       ],
       "type": "string"
      },
      "origin_zip": {
       "description": "5-digit US ZIP code",
       "pattern": "^\\d{5}$",
       "type": "string"
      },
      "pallets": {
       "maximum": 26,
       "minimum": 1,
       "type": "integer"
      },
      "pickup_date": {
       "description": "Pickup date YYYY-MM-DD (must not be in the past)",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "pickup_services": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "stackable": {
       "type": "boolean"
      },
      "weight_lbs_per_pallet": {
       "maximum": 5000,
       "minimum": 50,
       "type": "number"
      },
      "width_in": {
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "origin_zip",
      "destination_zip",
      "pickup_date"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "lanes"
  ],
  "type": "object"
 },
 "name": "batch_quote",
 "title": "Batch Quote Lanes"
}
