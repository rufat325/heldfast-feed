{
 "description": "List supported Open RPC image or video models. Use this before generate_image, edit_image, or generate_video to choose the model value and inspect constraints.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "type": {
    "description": "Model type to list.",
    "enum": [
     "image",
     "video"
    ],
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "list_models",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Human-readable summary.",
    "type": "string"
   },
   "models": {
    "description": "Supported models with model IDs, model keys, commands, and constraints.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "const": true,
    "description": "Whether model discovery completed successfully.",
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "models",
   "message"
  ],
  "type": "object"
 }
}
