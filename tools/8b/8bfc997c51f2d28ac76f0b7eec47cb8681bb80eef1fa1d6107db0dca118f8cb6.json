{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update PM schedule"
 },
 "description": "Update an existing PM schedule by ID. Requires pm_schedules:write scope. When changing location, resolve top-down: list_sites \u2192 list_buildings (by site_id) \u2192 list_locations (by building_id). Provide all three IDs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_id": {
    "description": "Asset ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "asset_ids": {
    "description": "Assets this schedule covers - use instead of asset_id when there is more than one.",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "type": "string"
    },
    "type": "array"
   },
   "auto_generate_wo": {
    "description": "Auto-generate work orders",
    "type": "boolean"
   },
   "building_id": {
    "description": "Building ID - resolve second via list_buildings filtered by site_id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "custom_interval_weeks": {
    "description": "Custom interval in weeks (when frequency is CUSTOM)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "estimated_cost": {
    "description": "Estimated cost",
    "minimum": 0,
    "type": "number"
   },
   "estimated_hours": {
    "description": "Estimated hours",
    "minimum": 0,
    "type": "number"
   },
   "floating": {
    "description": "Floating schedule (due date based on completion)",
    "type": "boolean"
   },
   "form_template_id": {
    "description": "Form template ID to attach to every work order this generates - resolve via list_form_templates. Use a PUBLISHED template: generation resolves the current published version of the form, so a draft attaches nothing until it is published.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "frequency": {
    "description": "Frequency",
    "enum": [
     "DAILY",
     "WEEKLY",
     "MONTHLY",
     "QUARTERLY",
     "SEMI_ANNUAL",
     "ANNUAL",
     "FIVE_YEARLY",
     "CUSTOM"
    ],
    "type": "string"
   },
   "grace_period_days": {
    "description": "Grace period in days",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "PM schedule ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "infrastructure_asset_ids": {
    "description": "Infrastructure features this schedule covers - resolve via list_infrastructure_assets. One schedule over several features generates one work order per cycle covering all of them. Mutually exclusive with asset/location/system targets.",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "type": "string"
    },
    "type": "array"
   },
   "lead_time_days": {
    "description": "Lead time in days",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "location_id": {
    "description": "Location ID - resolve last via list_locations filtered by building_id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "location_ids": {
    "description": "Locations this schedule covers - use instead of location_id when there is more than one. Sending location_id alone replaces this with that single id.",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "type": "string"
    },
    "type": "array"
   },
   "meter_based": {
    "description": "Whether this PM triggers at meter intervals",
    "type": "boolean"
   },
   "meter_interval": {
    "description": "Meter interval - trigger every N units",
    "minimum": 0,
    "type": "number"
   },
   "meter_unit": {
    "description": "Meter unit (km, miles, hours, cycles)",
    "maxLength": 50,
    "type": "string"
   },
   "next_due": {
    "description": "Next due date (ISO 8601)",
    "type": "string"
   },
   "safety_requirements": {
    "description": "Safety requirements",
    "type": "string"
   },
   "schedule_type": {
    "description": "Schedule type",
    "maxLength": 100,
    "type": "string"
   },
   "site_id": {
    "description": "Site ID - resolve first via list_sites",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "start_date": {
    "description": "Start date (ISO 8601)",
    "type": "string"
   },
   "status": {
    "description": "Schedule status",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   },
   "system_ids": {
    "description": "Systems this schedule covers. Systems have no singular field; this array is the only way to associate them.",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "type": "string"
    },
    "type": "array"
   },
   "tasks": {
    "description": "Checklist of tasks for this PM schedule",
    "items": {
     "properties": {
      "completed": {
       "description": "Whether the task is completed",
       "type": "boolean"
      },
      "description": {
       "description": "Task description",
       "type": "string"
      },
      "id": {
       "description": "Unique task ID",
       "type": "string"
      }
     },
     "required": [
      "id",
      "description",
      "completed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "PM schedule title",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "work_category": {
    "description": "Work category label",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_pm_schedule",
 "title": "Update PM schedule"
}
