{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Attach campaign assets"
 },
 "description": "Attach campaign assets. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_attach_campaign_assets.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "properties": {
     "campaignId": {
      "pattern": "^\\d+$",
      "type": "string"
     }
    },
    "required": [
     "campaignId"
    ],
    "type": "object"
   },
   "payload": {
    "properties": {
     "callouts": {
      "items": {
       "maxLength": 25,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "images": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "sitelinks": {
      "items": {
       "properties": {
        "description1": {
         "maxLength": 35,
         "minLength": 1,
         "type": "string"
        },
        "description2": {
         "maxLength": 35,
         "minLength": 1,
         "type": "string"
        },
        "linkUrl": {
         "type": "string"
        },
        "text": {
         "maxLength": 25,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "text",
        "linkUrl"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 2,
      "type": "array"
     },
     "structuredSnippets": {
      "items": {
       "properties": {
        "header": {
         "enum": [
          "Amenities",
          "Brands",
          "Courses",
          "Degree programs",
          "Destinations",
          "Featured hotels",
          "Insurance coverage",
          "Models",
          "Neighborhoods",
          "Service catalog",
          "Shows",
          "Styles",
          "Types"
         ],
         "type": "string"
        },
        "values": {
         "items": {
          "maxLength": 25,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 10,
         "minItems": 3,
         "type": "array"
        }
       },
       "required": [
        "header",
        "values"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "parameters",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_attach_campaign_assets",
 "title": "Attach campaign assets"
}
