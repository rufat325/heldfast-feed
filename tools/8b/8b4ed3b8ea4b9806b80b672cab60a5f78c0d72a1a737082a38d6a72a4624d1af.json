{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Separate real-data rankings: liked, active, streaks, trending and collaborators; this UTC week or all time. Returns formulas, tied ranks, prior-day movements and empty categories honestly. Pro does not add score or priority.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "default": "trending",
    "enum": [
     "liked",
     "active",
     "streaks",
     "trending",
     "collaborators"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "period": {
    "default": "week",
    "enum": [
     "week",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "speedbot_leaderboard",
 "title": "Leaderboard"
}
