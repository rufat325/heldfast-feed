   },
   "passed": {
    "description": "True only when every call was read, every called tool was declared, and every declared argument was exercised.",
    "type": "boolean"
   },
   "read_call_count": {
    "type": "integer"
   },
   "request_id": {
    "description": "Delivery request identifier; also returned in x-foundry-request-id.",
    "type": "string"
