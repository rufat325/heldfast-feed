      },
      "servers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "severity": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings_by_code": {
    "type": "object"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limits": {
