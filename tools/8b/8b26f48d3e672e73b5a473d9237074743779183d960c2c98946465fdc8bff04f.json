 },
 "description": "Find out which tools and arguments your agent actually uses. From a transcript of recorded calls, reports which declared tools were never called, which declared arguments were never sent, which arguments always carry the same value, and any call to a tool the manifest does not declare. Nothing is executed. Pay 120000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "calls": {
    "description": "Recorded tool calls. Both the flat shape with name and arguments and the JSON-RPC shape with params are read, because real transcripts mix them. Nothing is executed.",
    "example": [
     {
      "arguments": {
       "tenant_id": "acme"
      },
      "name": "list_orders"
     },
     {
      "arguments": {
       "page": 2,
       "tenant_id": "acme"
      },
      "name": "list_orders"
     },
     {
      "arguments": {
       "page": 3,
       "tenant_id": "acme"
      },
      "name": "list_orders"
     },
     {
      "arguments": {
       "order_id": "o-1"
      },
      "name": "get_order"
     },
     {
      "method": "tools/call",
      "params": {
       "arguments": {
        "order_id": "o-2"
       },
       "name": "get_order"
      }
     },
     {
      "arguments": {
       "id": "o-3"
      },
      "name": "get_order"
     },
     {
      "arguments": {
       "order_id": "o-4"
      },
      "name": "archive_order"
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "toolset": {
    "description": "An MCP toolset: either the tools/list result object, or the bare array of tool definitions. At most 400 tools are read and the rest are reported. A capabilities or serverInfo object is used when present. Nothing is fetched and no tool is ever called.",
    "example": {
     "capabilities": {
      "resources": {
       "subscribe": true
      },
      "tools": {
       "listChanged": true
      }
     },
     "serverInfo": {
      "name": "orders-mcp",
      "version": "1.3.0"
     },
     "tools": [
      {
       "annotations": {
        "idempotentHint": true,
        "readOnlyHint": true
       },
       "description": "List orders for a tenant, newest first, with optional paging. Returns only orders the caller is entitled to see.",
       "inputSchema": {
        "properties": {
         "page": {
          "description": "Page number, starting at 1.",
          "minimum": 1,
          "type": "integer"
         },
         "status": {
          "description": "Restrict to one status.",
          "enum": [
           "open",
           "shipped"
          ],
          "type": "string"
         },
         "tenant_id": {
          "description": "The tenant whose orders to list.",
          "type": "string"
         }
        },
        "required": [
         "tenant_id"
        ],
        "type": "object"
       },
       "name": "list_orders",
       "outputSchema": {
        "properties": {
         "items": {
          "type": "array"
         },
         "next_page": {
          "type": [
           "integer",
           "null"
          ]
         }
        },
        "required": [
         "items"
        ],
        "type": "object"
       }
      },
      {
       "annotations": {
        "readOnlyHint": true
       },
       "description": "Fetch one order by its identifier, including line items and the current fulfilment state.",
       "inputSchema": {
        "properties": {
         "order_id": {
          "description": "The order identifier.",
          "type": "string"
         }
        },
        "required": [
         "order_id"
        ],
        "type": "object"
       },
       "name": "get_order",
       "outputSchema": {
        "properties": {
         "id": {
          "type": "string"
         },
         "total": {
          "type": "number"
         }
        },
        "required": [
         "id"
        ],
        "type": "object"
       }
      },
      {
       "annotations": {
        "destructiveHint": true,
        "idempotentHint": false
       },
       "description": "Cancel an order that has not yet shipped. This cannot be undone and will issue a refund where one is due.",
       "inputSchema": {
        "properties": {
         "order_id": {
          "description": "The order to cancel.",
          "type": "string"
         },
         "reason": {
          "description": "Why it is being cancelled.",
          "type": "string"
         }
        },
        "required": [
         "order_id"
        ],
        "type": "object"
       },
       "name": "cancel_order"
      }
     ]
    }
   }
  },
  "required": [
   "toolset",
   "calls"
  ],
  "type": "object"
 },
 "name": "mcp_tool_input_coverage_audit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "calls_to_undeclared_tools": {
    "type": "integer"
   },
   "complete": {
