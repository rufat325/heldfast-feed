{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record git events (commit/branch/pr, up to 1000 per call) via smart-commits (\"PREFIX-123\" in the ref or message) to link them to cards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "baseRef": {
       "type": "string"
      },
      "baseSha": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "commit",
        "branch",
        "pr"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "ref": {
       "minLength": 1,
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "ref"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "repo": {
    "additionalProperties": false,
    "properties": {
     "provider": {
      "type": "string"
     },
     "remoteUrl": {
      "description": "The repo's remote URL, in whatever form (HTTPS or SSH) \u2014 resolved to the same RepoLink either way.",
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "remoteUrl"
    ],
    "type": "object"
   }
  },
  "required": [
   "repo",
   "events"
  ],
  "type": "object"
 },
 "name": "zuuna_record_git_events",
 "title": "zuuna_record_git_events"
}
