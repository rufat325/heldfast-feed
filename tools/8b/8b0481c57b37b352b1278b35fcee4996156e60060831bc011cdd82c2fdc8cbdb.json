{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update global container settings. Idempotent: returns no_change if nothing differs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "ramHighMb": {
    "description": "RAM high-water mark in MB",
    "minimum": 1,
    "type": "integer"
   },
   "registryUrl": {
    "description": "Container registry URL",
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "vethInterface": {
    "description": "Veth interface name for container networking",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "manage_container_config",
 "title": "Manage Container Config"
}
