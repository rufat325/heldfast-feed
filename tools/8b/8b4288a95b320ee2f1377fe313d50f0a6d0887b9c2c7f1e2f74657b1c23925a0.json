{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Attach artwork from a link"},"description":"Fetches the file at an https link (a Canva, Figma or design tool export, Dropbox or Drive download link, a signed storage URL) up to 700 MB and attaches it like attach_artwork: target (cart_line, quote_line or order_item with its id, design, side), url, and file_name when the link's own name has no extension. A link that opens a web page instead of the file is refused, and so is a file whose contents do not match its extension. For a Canva export, name it canva-<designId>.pdf with the Canva design id: Printdash recognises Canva files by that name (they arrive at finished size by design, so the bleed notice is dropped and the studio checks bleed). Needs a signed-in Printdash account: called without one, the connection asks the customer to sign in on printdash.io.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"file_name":{"description":"The name to store it under, with its extension, when the link's own name has none. For a Canva export: canva-<designId>.pdf.","maxLength":200,"type":"string"},"target":{"description":"Where the artwork goes.","properties":{"design":{"description":"Which design (1 to N) on a job with several designs. Omit on a one-design job.","maximum":500,"minimum":1,"type":"integer"},"id":{"description":"The line_id or item_id.","maxLength":64,"minLength":1,"type":"string"},"kind":{"description":"cart_line (line_id from get_cart), quote_line (line_id from get_quote) or order_item (item_id from get_order).","enum":["cart_line","quote_line","order_item"],"type":"string"},"side":{"description":"front (default) or back, on a double-sided job.","enum":["front","back"],"type":"string"}},"required":["kind","id"],"type":"object"},"url":{"description":"An https link that downloads the file itself (not a page showing it).","maxLength":4096,"minLength":1,"type":"string"}},"required":["target","url"],"type":"object"},"name":"attach_artwork_from_url","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"attached":{"const":true,"type":"boolean"},"checks":{"additionalProperties":false,"properties":{"notices":{"items":{"additionalProperties":false,"properties":{"detail":{"type":["string","null"]},"guide":{"anyOf":[{"additionalProperties":false,"properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["url","label"],"type":"object"},{"type":"null"}]},"id":{"type":"string"},"level":{"description":"attention: production would come back to the customer about it. info: handled, for their information.","enum":["attention","info"],"type":"string"},"title":{"type":"string"}},"required":["id","level","title","detail","guide"],"type":"object"},"type":"array"},"status":{"enum":["checked","partial","pending","no_artwork"],"type":"string"}},"required":["status","notices"],"type":"object"},"complete":{"description":"Designs with every face they need.","type":"number"},"design":{"type":"number"},"designs":{"description":"Which file and page is each design's front and back, as the site resolves them.","items":{"additionalProperties":false,"properties":{"back":{"anyOf":[{"additionalProperties":false,"properties":{"file_index":{"type":"number"},"page":{"type":"number"}},"required":["file_index","page"],"type":"object"},{"type":"null"}]},"design":{"type":"number"},"front":{"anyOf":[{"additionalProperties":false,"properties":{"file_index":{"type":"number"},"page":{"type":"number"}},"required":["file_index","page"],"type":"object"},{"type":"null"}]},"label":{"type":"string"}},"required":["design","label","front","back"],"type":"object"},"type":"array"},"file":{"additionalProperties":false,"properties":{"bytes":{"type":"number"},"content_type":{"type":"string"},"index":{"type":"number"},"name":{"type":"string"}},"required":["index","name","content_type","bytes"],"type":"object"},"files":{"items":{"additionalProperties":false,"properties":{"content_type":{"type":"string"},"has_preview":{"type":"boolean"},"index":{"type":"number"},"name":{"type":"string"},"preview_url":{"type":["string","null"]}},"required":["index","name","content_type","has_preview","preview_url"],"type":"object"},"type":"array"},"next":{"type":"string"},"order_item_status":{"additionalProperties":false,"properties":{"status":{"type":"string"},"status_label":{"type":["string","null"]}},"required":["status","status_label"],"type":"object"},"preview":{"additionalProperties":false,"properties":{"back_url":{"type":["string","null"]},"pages":{"type":["number","null"]},"status":{"enum":["ready","rendering","none","unavailable"],"type":"string"},"url":{"type":["string","null"]}},"required":["status","url","back_url","pages"],"type":"object"},"replaced":{"items":{"type":"string"},"type":"array"},"side":{"enum":["front","back"],"type":"string"},"target":{"additionalProperties":false,"properties":{"id":{"type":"string"},"kind":{"enum":["cart_line","quote_line","order_item"],"type":"string"},"order_number":{"type":"string"},"product":{"type":"string"},"quote_number":{"type":"string"}},"required":["kind","id","product"],"type":"object"},"total":{"type":"number"},"uploader_url":{"type":"string"}},"required":["attached","target","file","design","side","replaced","files","designs","complete","total","preview","checks","uploader_url","next"],"type":"object"},"securitySchemes":[{"scopes":["openid","email","profile","offline_access"],"type":"oauth2"}],"title":"Attach artwork from a link"}
