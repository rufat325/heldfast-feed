{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create a brand"},"description":"Start a brand with a name, and the masters you drew so far if you have them. It starts as a private draft; nothing is public until an owner approves it. The slug comes from the name when you leave it out, and becomes the brand's address: ideare.app/b/<slug>. Costs no credits.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"idempotencyKey":{"description":"A key you make up for this call. Send the SAME one again after a lost answer to get the first answer back, with nothing spent twice.","maxLength":200,"minLength":8,"type":"string"},"masters":{"additionalProperties":{},"properties":{"name":{"maxLength":80,"minLength":1,"type":"string"},"schemaVersion":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["schemaVersion","name"],"type":"object"},"name":{"maxLength":80,"minLength":1,"type":"string"},"origin":{"additionalProperties":false,"properties":{"idea":{"maxLength":500,"type":"string"},"kind":{"enum":["idea","link","files","try","import"],"type":"string"},"picks":{"additionalProperties":{"type":["string","number"]},"propertyNames":{"type":"string"},"type":"object"},"run":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"seed":{"maxLength":100,"type":"string"},"url":{"format":"uri","maxLength":2000,"type":"string"}},"required":["kind"],"type":"object"},"slug":{"pattern":"^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$","type":"string"}},"required":["name"],"type":"object"},"name":"create_brand","title":"Create a brand"}
