{
 "description": "Encode a 32-byte puzzle hash to a bech32m xch/txch address. Use `network` to select mainnet (xch) or testnet11 (txch). Local computation only \u2014 no RPC.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "network": {
    "default": "mainnet",
    "description": "Chia network: 'mainnet' (default) or 'testnet11'",
    "enum": [
     "mainnet",
     "testnet11"
    ],
    "type": "string"
   },
   "puzzle_hash": {
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   }
  },
  "required": [
   "puzzle_hash"
  ],
  "type": "object"
 },
 "name": "puzzle_hash_to_address"
}
