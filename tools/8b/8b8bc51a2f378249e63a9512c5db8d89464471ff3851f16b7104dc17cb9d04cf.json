{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List Circles with optional filters. Archived Circles are excluded by default; pass status=\"archived\" to surface them. Returns paginated results.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), then call this tool again. start_login does NOT open this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environment": {
    "description": "Filter by environment (production or test)",
    "enum": [
     "production",
     "test"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Items per page (default 20, max 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default 1)",
    "exclusiveMinimum": 0,
    "maximum": 10000,
    "type": "integer"
   },
   "profile_id": {
    "description": "Filter by bound public profile (sub-account)",
    "pattern": "^[0-9a-fA-F]{24}$",
    "type": "string"
   },
   "status": {
    "description": "Filter by status (archived excluded unless requested)",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_circles"
}
