        "invalid_plan_shape",
        "source_binding_mismatch",
        "unknown_entity_reference",
        "upstream_validation_failed"
       ]
      },
      "rejected_plan_digest": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "sequence": {
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      }
     },
