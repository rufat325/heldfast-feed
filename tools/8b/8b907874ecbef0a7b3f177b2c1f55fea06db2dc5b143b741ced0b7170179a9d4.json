{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Export citations"},"description":"Build BibTeX or RIS citations for up to 100 papers (DOI, OpenAlex ID, PMID or PMCID) from their OpenAlex records, with entry types, years, volume, issue, pages and escaping. Each row holds one entry; join the entries with a blank line to make a .bib or .ris file. Inputs it cannot match are listed in unresolved.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"format":{"enum":["bibtex","ris"],"type":"string"},"ids":{"description":"1\u2013100 DOIs, OpenAlex IDs, PMIDs or PMCIDs.","items":{"maxLength":300,"minLength":1,"type":"string"},"maxItems":100,"minItems":1,"type":"array"}},"required":["ids","format"],"type":"object"},"name":"export_citations","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"diagnostics":{"additionalProperties":false,"properties":{"advisories":{"items":{"type":"string"},"type":"array"},"unresolved_seeds":{"items":{"additionalProperties":false,"properties":{"input":{"type":"string"},"reason":{"type":"string"}},"required":["input","reason"],"type":"object"},"type":"array"}},"required":["advisories"],"type":"object"},"format":{"enum":["bibtex","ris"],"type":"string"},"rows":{"items":{"additionalProperties":false,"properties":{"doi":{"type":["string","null"]},"entry":{"type":"string"},"openalex_id":{"type":"string"}},"required":["openalex_id","doi","entry"],"type":"object"},"type":"array"},"truncated":{"type":"boolean"},"unresolved":{"items":{"additionalProperties":false,"properties":{"input":{"type":"string"},"reason":{"enum":["not_found","unavailable"],"type":"string"}},"required":["input","reason"],"type":"object"},"type":"array"}},"required":["format","rows","unresolved","truncated"],"type":"object"},"title":"Export citations"}
