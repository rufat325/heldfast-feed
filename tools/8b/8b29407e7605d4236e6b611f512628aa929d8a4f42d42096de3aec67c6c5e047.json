{
 "annotations": {
  "destructiveHint": true,
  "title": "Update an item or folder"
 },
 "description": "Change fields on an existing item or folder \u2014 e.g. set a new quantity after a stock count, rename it, or relocate a folder via parent_id. Only the fields you pass change; pass null to clear a nullable field. Sending tags or custom_attribute_values replaces them. WRITE. Sortly: PUT /api/v1/items/{item_id} (returns 204).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "custom_attribute_values": {
    "description": "Custom field values. Look up ids with sortly_list_custom_fields first.",
    "items": {
     "properties": {
      "custom_attribute_id": {
       "description": "Custom field id, from sortly_list_custom_fields.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "value": {
       "description": "Value to store; null clears it.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "custom_attribute_id",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "item_id": {
    "description": "The item's or folder's numeric id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "label_url": {
    "description": "Value encoded in the primary QR code / barcode.",
    "type": [
     "string",
     "null"
    ]
   },
   "label_url_extra": {
    "description": "Value encoded in the secondary code.",
    "type": [
     "string",
     "null"
    ]
   },
   "label_url_extra_type": {
    "anyOf": [
     {
      "enum": [
       "org.gs1.UPC-E",
       "org.iso.Code39",
       "org.iso.Code39Mod43",
       "org.gs1.EAN-13",
       "org.gs1.EAN-8",
       "com.intermec.Code93",
       "org.iso.Code128",
       "org.iso.PDF417",
       "org.iso.Aztec",
       "org.iso.QRCode",
       "org.ansi.Interleaved2of5",
       "org.iso.DataMatrix",
       "com.sortly.textEntry"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Symbology of the secondary code."
   },
   "label_url_type": {
    "anyOf": [
     {
      "enum": [
       "org.gs1.UPC-E",
       "org.iso.Code39",
       "org.iso.Code39Mod43",
       "org.gs1.EAN-13",
       "org.gs1.EAN-8",
       "com.intermec.Code93",
       "org.iso.Code128",
       "org.iso.PDF417",
       "org.iso.Aztec",
       "org.iso.QRCode",
       "org.ansi.Interleaved2of5",
       "org.iso.DataMatrix",
       "com.sortly.textEntry"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Symbology of the primary code."
   },
   "measured_quantity": {
    "description": "New measured amount for a measured item.",
    "properties": {
     "value": {
      "description": "The measured amount (the unit is fixed at creation).",
      "type": "number"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "min_quantity": {
    "description": "Minimum level; a Quantity alert can fire when stock reaches it.",
    "type": [
     "number",
     "null"
    ]
   },
   "name": {
    "description": "New name.",
    "maxLength": 190,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Free-text notes.",
    "type": [
     "string",
     "null"
    ]
   },
   "parent_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Move into this folder (null = root). To move PART of an item's stock use sortly_move_item."
   },
   "photo_ids": {
    "description": "Ids of photos already in the account to attach.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "price": {
    "description": "Unit price.",
    "type": [
     "number",
     "null"
    ]
   },
   "quantity": {
    "description": "How many you have.",
    "type": [
     "number",
     "null"
    ]
   },
   "tags": {
    "description": "Tag names, e.g. [\"furniture\", \"used\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "item_id"
  ],
  "type": "object"
 },
 "name": "sortly_update_item",
 "title": "Update an item or folder"
}
