{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Associate an existing owned application with a component in an environment. Roles are labels, not validation of its engine. Does not deploy, copy variables or change networking. Explicitly detach before moving. Requires unrestricted account credentials.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "component": {
    "pattern": "^[a-z][a-z0-9-]{0,47}$",
    "type": "string"
   },
   "deployment_id": {
    "type": "string"
   },
   "environment_id": {
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   },
   "role": {
    "enum": [
     "web",
     "worker",
     "database",
     "cache"
    ],
    "type": "string"
   }
  },
  "required": [
   "environment_id",
   "deployment_id",
   "component",
   "role"
  ],
  "type": "object"
 },
 "name": "impreza_attach_environment_service",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "component": {
      "type": "string"
     },
     "deployment_id": {
      "type": "string"
     },
     "environment_id": {
      "type": "string"
     },
     "project_id": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "role": {
      "enum": [
       "web",
       "worker",
       "database",
       "cache"
      ],
      "type": "string"
     }
    },
    "required": [
     "project_id",
     "environment_id",
     "component",
     "role",
     "deployment_id",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
