{
 "_meta": {
  "openai/outputTemplate": "ui://widget/generation.html",
  "openai/toolInvocation/invoked": "Pratinjau filter",
  "openai/toolInvocation/invoking": "Merender pratinjau filter\u2026",
  "ui.resourceUri": "ui://widget/generation.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Show what a filter would look like BEFORE creating it: the Studio renders its sample photo (or the operator's own preview photo, if they set one in the dashboard) through the exact pipeline the booth uses, and returns an image URL. Free and read-only \u2014 call it whenever the operator is designing a filter, adjust the numbers from their reaction ('warmer', 'less contrast'), preview again, and call create_filter with the same adjustments only once they are happy. Some adjustments (shadows, highlights, whites, blacks, clarity, dehaze, vibrance, texture) are applied by the booth but cannot be shown here; the result lists them as notPreviewed so you can say so. Nothing is created by this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adjustments": {
    "additionalProperties": false,
    "description": "Only include what the operator asked to change. An omitted adjustment keeps its neutral value; sending every field at its neutral value creates a filter that does nothing.",
    "properties": {
     "blacks": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "blur": {
      "description": "0 = off, in pixels",
      "maximum": 10,
      "minimum": 0,
      "type": "number"
     },
     "brightness": {
      "description": "100 = unchanged",
      "maximum": 200,
      "minimum": 0,
      "type": "number"
     },
     "clarity": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "contrast": {
      "description": "100 = unchanged",
      "maximum": 200,
      "minimum": 0,
      "type": "number"
     },
     "dehaze": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "exposure": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "grain": {
      "description": "0 = off",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "grayscale": {
      "description": "0 = off, 100 = black and white",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "highlights": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "hueRotate": {
      "description": "0 = unchanged, in degrees",
      "maximum": 360,
      "minimum": 0,
      "type": "number"
     },
     "saturation": {
      "description": "100 = unchanged, 0 = grey",
      "maximum": 200,
      "minimum": 0,
      "type": "number"
     },
     "sepia": {
      "description": "0 = off",
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "shadows": {
      "description": "0 = unchanged, positive = lifted",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "temperature": {
      "description": "0 = unchanged, positive = warmer",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "tint": {
      "description": "0 = unchanged, positive = magenta",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "vibrance": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     },
     "vignette": {
      "description": "0 = off",
      "maximum": 200,
      "minimum": 0,
      "type": "number"
     },
     "whites": {
      "description": "0 = unchanged",
      "maximum": 100,
      "minimum": -100,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "adjustments"
  ],
  "type": "object"
 },
 "name": "preview_filter",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adjustments": {
    "additionalProperties": {
     "type": "number"
    },
    "type": "object"
   },
   "kind": {
    "const": "filter-preview",
    "type": "string"
   },
   "notPreviewed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "previewUrl": {
    "type": "string"
   },
   "previewed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sample": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "previewUrl",
   "previewed",
   "notPreviewed",
   "sample",
   "adjustments",
   "note"
  ],
  "type": "object"
 },
 "title": "Preview a photo filter"
}
