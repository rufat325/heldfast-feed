{
 "description": "Generate a QR code as PNG or SVG from a link or text. Nothing leaves the machine.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dark": {
    "description": "Module color. Default #000000",
    "type": "string"
   },
   "level": {
    "description": "Error correction. Default M",
    "enum": [
     "L",
     "M",
     "Q",
     "H"
    ],
    "type": "string"
   },
   "light": {
    "description": "Background color. Default #ffffff",
    "type": "string"
   },
   "margin": {
    "description": "Quiet zone in modules. Default 4",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "out": {
    "description": "Absolute output path ending in .png or .svg",
    "type": "string"
   },
   "size": {
    "description": "PNG side length in pixels, quiet zone included. The result is exactly this wide unless it is smaller than the code itself. Default 512",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "text": {
    "description": "Link or text to encode",
    "type": "string"
   }
  },
  "required": [
   "text",
   "out"
  ],
  "type": "object"
 },
 "name": "qr_make",
 "title": "Make QR code"
}
