{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Pay for an order"
 },
 "description": "Pay for an unpaid order with a Stripe shared payment token (spt_\u2026) the user approved, scoped to at least the order amount in USD. On success the order is paid and goes to print. Use only after the user approved the purchase.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "order_id": {
    "description": "Order id from create_postcard or create_letter, ord_\u2026",
    "type": "string"
   },
   "shared_payment_token": {
    "description": "Stripe shared payment token, spt_\u2026",
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "shared_payment_token"
  ],
  "type": "object"
 },
 "name": "pay_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "certified": {
    "description": "none, certified or certified_return_receipt",
    "type": "string"
   },
   "checkout_url": {
    "description": "Where the user pays; null once paid or cancelled",
    "type": [
     "string",
     "null"
    ]
   },
   "discount": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "display": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "display",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "First-order discount, already taken off price; null when none applies"
   },
   "id": {
    "description": "Order id, ord_\u2026",
    "type": "string"
   },
   "object": {
    "enum": [
     "postcard",
     "letter"
    ],
    "type": "string"
   },
   "order_url": {
    "description": "Order status page",
    "type": "string"
   },
   "preview_url": {
    "description": "Exact print preview",
    "type": "string"
   },
   "price": {
    "additionalProperties": false,
    "properties": {
     "amount_cents": {
      "type": "number"
     },
     "currency": {
      "type": "string"
     },
     "display": {
      "type": "string"
     }
    },
    "required": [
     "amount_cents",
     "currency",
     "display"
    ],
    "type": "object"
   },
   "product": {
    "description": "Product id, e.g. postcard_4x6 or letter_certified",
    "type": "string"
   },
   "product_name": {
    "type": "string"
   },
   "status": {
    "description": "awaiting_payment, paid, printing, mailed, cancelled or refunded",
    "type": "string"
   },
   "status_detail": {
    "description": "Plain-English status to show the user",
    "type": "string"
   },
   "tracking": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "number": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "number",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "USPS tracking, for Certified Mail once printed"
   }
  },
  "required": [
   "id",
   "object",
   "product",
   "product_name",
   "certified",
   "status",
   "status_detail",
   "price",
   "checkout_url",
   "order_url",
   "preview_url",
   "tracking",
   "discount"
  ],
  "type": "object"
 },
 "title": "Pay for an order"
}
