{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Hyperliquid vaults ranked by net deposits (deposits minus withdrawals) over the last 7 days, with depositor counts. Keyless calls see the last 24 hours; a free key from https://ironflow.sh/key gives the full 7 days.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of vaults (default 10, max 1000)",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_vault_leaderboard",
 "outputSchema": {
  "description": "Vaults ranked by net deposits",
  "properties": {
   "data": {
    "description": "Vaults",
    "items": {
     "description": "One vault",
     "properties": {
      "net_flow": {
       "description": "Deposits minus withdrawals, USDC"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      },
      "total_deposits": {
       "description": "USDC deposited in the window"
      },
      "total_withdrawals": {
       "description": "USDC withdrawn in the window"
      },
      "unique_users": {
       "description": "Distinct depositors and withdrawers"
      },
      "vault": {
       "description": "Vault address"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "window_days": {
    "description": "Days covered (keyless: 1); absent when served by the Builder endpoint"
   }
  },
  "type": "object"
 }
}
