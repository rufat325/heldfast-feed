{
 "description": "Get first row from CSV file (streaming, no memory overhead). Returns columns array and isEmpty flag.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "sourceUri": {
    "description": "CSV file URI (file://, http://, https://)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sourceUri"
  ],
  "type": "object"
 },
 "name": "csv-get-columns",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "columns": {
        "description": "First row values (column names) or empty if no rows",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "isEmpty": {
        "description": "True if CSV has zero rows",
        "type": "boolean"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "columns",
       "isEmpty"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
