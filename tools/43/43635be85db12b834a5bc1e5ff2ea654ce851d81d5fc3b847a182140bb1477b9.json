{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Send a document via email to one or more recipients.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addresses": {
    "description": "Comma-separated email addresses",
    "type": "string"
   },
   "id": {
    "description": "The document ID to send",
    "type": "number"
   },
   "message": {
    "description": "Email body message",
    "type": "string"
   },
   "subject": {
    "description": "Email subject line",
    "type": "string"
   },
   "use_archive_version": {
    "description": "Send the archive version (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "addresses",
   "subject",
   "message"
  ],
  "type": "object"
 },
 "name": "email_document"
}
