{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:library"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save an upload as a Library item"
 },
 "description": "Finalize an uploaded file into an immutable saved Library asset. Without confirm: true it returns a preview and saves nothing; pass confirm: true after the owner approved the exact item. Needs the separate manage:library grant. Finalize retains its original UUID clientRequestId and app-native upload_finalize receipt. After interruption read soclo_library_finalize_status with the original ids; never substitute ids or repeat blindly. Debits no customer credits.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bucket": {
    "enum": [
     "media",
     "brand-assets"
    ],
    "type": "string"
   },
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "durationMs": {
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "height": {
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "kind": {
    "enum": [
     "clip",
     "audio",
     "brand_asset",
     "edit",
     "image",
     "video",
     "ai_image",
     "ai_video"
    ],
    "type": "string"
   },
   "mimeType": {
    "enum": [
     "image/png",
     "image/jpeg",
     "image/webp",
     "image/gif",
     "video/mp4",
     "video/webm",
     "video/quicktime",
     "audio/mpeg",
     "audio/mp4",
     "audio/wav",
     "audio/x-wav",
     "audio/ogg",
     "audio/webm"
    ],
    "type": "string"
   },
   "source": {
    "enum": [
     "generated",
     "edited",
     "uploaded",
     "imported"
    ],
    "type": "string"
   },
   "subject": {
    "maxLength": 1000,
    "type": "string"
   },
   "tags": {
    "items": {
     "enum": [
      "product",
      "place",
      "people",
      "work",
      "price-list",
      "other"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   },
   "uploadId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "width": {
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "uploadId",
   "mimeType",
   "clientRequestId",
   "kind",
   "source"
  ],
  "type": "object"
 },
 "name": "soclo_library_finalize",
 "title": "Save an upload as a Library item"
}
