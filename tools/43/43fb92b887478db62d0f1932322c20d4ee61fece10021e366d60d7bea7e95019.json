{
 "_meta": {
  "com.electionsmcp/schema_version": "f314c3a00e656e5b26c433b0ca02b45d2e7056a958771cf8de94278cadc5db9a"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read precinct-level election returns and normalized early-voting, absentee/mail, election-day, and provisional breakdowns across 87.7M precinct rows (linked to mapsmcp_precinct_id) from RoutPoint v2.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contest_id": {
    "description": "Optional RoutPoint contest identifier for single-contest precinct returns.",
    "type": "integer"
   },
   "county_fips": {
    "description": "Optional 5-digit county FIPS code.",
    "type": "string"
   },
   "district": {
    "description": "Optional legislative or congressional district code.",
    "type": "string"
   },
   "election_date": {
    "description": "Optional election date in YYYY-MM-DD format.",
    "type": "string"
   },
   "election_id": {
    "description": "Optional RoutPoint election identifier.",
    "type": "integer"
   },
   "election_type": {
    "description": "Optional election stage (default general).",
    "enum": [
     "general",
     "primary",
     "runoff",
     "special",
     "municipal",
     "recall"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum rows to return (default 100, max 500).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "mapsmcp_precinct_id": {
    "description": "Optional MapsMCP precinct UUID filter.",
    "type": "string"
   },
   "office": {
    "description": "Optional office name filter.",
    "type": "string"
   },
   "office_level": {
    "description": "Optional canonical office level.",
    "enum": [
     "president",
     "us_senate",
     "us_house",
     "governor",
     "lt_governor",
     "state_senate",
     "state_assembly",
     "state_house"
    ],
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset (default 0).",
    "minimum": 0,
    "type": "integer"
   },
   "party": {
    "description": "Optional party filter.",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state postal code (e.g. \"TX\", \"NC\", \"GA\", \"PA\").",
    "type": "string"
   },
   "workspace_scope": {
    "description": "Optional workspace for THIS call: use an exact personal/team ID from list_workspaces. Repeat on each call; it does not change the connection default. Must agree with MCP metadata and the effective HTTP workspace selector (header, otherwise connector URL). OAuth connections can only use their granted workspace. Membership and campaign permissions still apply.",
    "maxLength": 64,
    "minLength": 3,
    "pattern": "^[uw]-[a-z0-9](?:[a-z0-9-]{0,61})$",
    "type": "string"
   },
   "year": {
    "description": "Optional election year (e.g. 2024, 2022, 2026).",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_precinct_election_returns"
}
