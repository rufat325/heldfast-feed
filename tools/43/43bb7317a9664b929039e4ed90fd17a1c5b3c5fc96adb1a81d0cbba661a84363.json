{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks with code, character by character, that an address (and memo/tag) someone is about to send to is exactly one of the account's Ripio app (Wallet) deposit addresses, on a network that credits the asset, and flags mistyped copies. Pass the address as pasted from where it will actually be used, plus the asset and network the sender will use. Ripio Trade addresses are not checked.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "The address exactly as pasted.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "asset": {
    "description": "Ripio ticker, e.g. USDT, BTC or AAPLx.",
    "pattern": "^[A-Za-z0-9]{1,15}$",
    "type": "string"
   },
   "memo": {
    "description": "Memo/tag as pasted, for networks that use one (XRP, Stellar, TON).",
    "maxLength": 100,
    "type": "string"
   },
   "network": {
    "description": "The network as the sender names it: code, name or token standard, e.g. tron, \"BNB Chain\", TRC20, BEP-20.",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "ripio_verify_deposit_address",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address_networks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "asset": {
    "type": "string"
   },
   "credited_via": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expected_memo": {
    "type": "string"
   },
   "near_miss": {
    "additionalProperties": false,
    "properties": {
     "differing_positions": {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     "distance": {
      "type": "number"
     }
    },
    "required": [
     "distance"
    ],
    "type": "object"
   },
   "not_credited_via": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "verified",
     "wrong_network",
     "memo_mismatch",
     "near_miss",
     "not_yours",
     "conflicting"
    ],
    "type": "string"
   },
   "verdict": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "verdict",
   "address_networks",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Verify a Ripio deposit address"
}
