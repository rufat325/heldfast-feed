 "description": "Find catalogue listings using an explicit blood-test, panel or health-check name and an optional Irish location. Returns sourced comparison facts only; it does not assess symptoms or clinical suitability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "eircode": {
    "description": "Irish Eircode or routing key supplied by the user.",
    "maxLength": 20,
    "type": "string"
   },
   "includeBroader": {
    "description": "Include broader mixed panels when the user explicitly requests them.",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum number of listings, default 4.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Irish town or Eircode routing code already supplied by the user.",
    "maxLength": 200,
    "type": "string"
   },
   "query": {
    "description": "Explicit blood test, panel or health-check wording. Use an empty string when the user has not named one; never infer a test from symptoms.",
    "maxLength": 500,
    "type": "string"
   },
   "town": {
    "description": "Irish town or city supplied by the user.",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
