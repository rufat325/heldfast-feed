{
 "description": "Add a significant account/process to the review scope, with its objective category and assertions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "area": {
    "description": "Significant account or process.",
    "minLength": 1,
    "type": "string"
   },
   "assertions": {
    "default": [],
    "items": {
     "enum": [
      "completeness",
      "existence-occurrence",
      "accuracy",
      "valuation",
      "obligations-rights",
      "presentation-disclosure"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "inScope": {
    "default": true,
    "type": "boolean"
   },
   "objectiveCategory": {
    "enum": [
     "operations",
     "reporting",
     "compliance"
    ],
    "type": "string"
   },
   "rationale": {
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "area",
   "objectiveCategory"
  ],
  "type": "object"
 },
 "name": "add_scope_item",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "scopeItem": {}
  },
  "required": [
   "scopeItem"
  ],
  "type": "object"
 },
 "title": "Add a scope item"
}
