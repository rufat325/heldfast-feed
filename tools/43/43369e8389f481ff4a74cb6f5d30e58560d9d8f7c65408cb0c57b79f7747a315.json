{
 "description": "Press keyboard keys or shortcuts (e.g., Enter, Escape, Alt+S, Ctrl+Z)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "key": {
    "description": "Key to press (e.g., \"Enter\", \"Escape\", \"Tab\", \"a\", \"ArrowUp\")",
    "type": "string"
   },
   "modifiers": {
    "description": "Modifier keys to hold (e.g., [\"ctrl\", \"shift\"])",
    "items": {
     "enum": [
      "ctrl",
      "alt",
      "shift",
      "meta"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "key"
  ],
  "type": "object"
 },
 "name": "ui_keyboard"
}
