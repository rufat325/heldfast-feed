{
 "_meta": {
  "openai/outputTemplate": "ui://aicontentdrop/ad-results.html",
  "openai/toolInvocation/invoked": "Done.",
  "openai/toolInvocation/invoking": "Looking at competitor ads\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "preferredSize": {
    "height": 480,
    "width": 420
   },
   "resourceUri": "ui://aicontentdrop/ad-results.html"
  },
  "ui/resourceUri": "ui://aicontentdrop/ad-results.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search competitor ads"
 },
 "description": "Search live competitor ads by keyword on Meta or TikTok: advertiser, copy, hook, call to action, media and run time per ad. Costs no credits. When live data is not available the rows are samples, marked demo: true with a note; never present those as real ads. SIGN-IN REQUIRED: connect this server with OAuth (the host prompts for it), or add an API key header \"Authorization: Bearer acd_live_\u2026\" created at https://aicontentdrop.com/settings/integrations.",
 "inputSchema": {
  "properties": {
   "keyword": {
    "description": "What to search for: a product, a category or a competitor, 1-200 characters.",
    "type": "string"
   },
   "limit": {
    "description": "Rows to return, 1-20; defaults to 10.",
    "type": "number"
   },
   "platform": {
    "description": "Defaults to meta.",
    "enum": [
     "meta",
     "tiktok"
    ],
    "type": "string"
   },
   "sort": {
    "description": "impressions (default) ranks by reach; recent by start date.",
    "enum": [
     "impressions",
     "recent"
    ],
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "search_competitor_ads",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Rows returned.",
    "type": "number"
   },
   "demo": {
    "description": "True when results are sample rows because live data was not available.",
    "type": "boolean"
   },
   "keyword": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "note": {
    "description": "Present only when demo is true: why, and what the rows are.",
    "type": "string"
   },
   "platform": {
    "enum": [
     "meta",
     "tiktok"
    ],
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "ad_copy": {
       "description": "The ad's primary text.",
       "type": [
        "string",
        "null"
       ]
      },
      "ad_ref": {
       "description": "Opaque reference to the ad's source listing; copy it back unchanged when saving. Null when the source gave none.",
       "type": [
        "string",
        "null"
       ]
      },
      "ad_url": {
       "description": "The public listing or post, when known.",
       "type": [
        "string",
        "null"
       ]
      },
      "advertiser_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "cta_text": {
       "type": [
        "string",
        "null"
       ]
      },
      "demo": {
       "description": "True for a sample row: not a real ad. Never present a sample as live data.",
       "type": "boolean"
      },
      "engagement_score": {
       "type": [
        "number",
        "null"
       ]
      },
      "estimated_spend": {
       "description": "As reported by the source, e.g. a monthly range; absent for most platforms.",
       "type": [
        "string",
        "null"
       ]
      },
      "hook_text": {
       "description": "The headline or opening line.",
       "type": [
        "string",
        "null"
       ]
      },
      "media_type": {
       "enum": [
        "video",
        "image",
        "carousel",
        null
       ],
       "type": [
        "string",
        "null"
       ]
      },
      "media_url": {
       "description": "The creative (video or image), when the source exposes one.",
       "type": [
        "string",
        "null"
       ]
      },
      "platform": {
       "enum": [
        "meta",
        "tiktok"
       ],
       "type": "string"
      },
      "running_days": {
       "description": "Days the ad has been running, when known.",
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "ad_ref",
      "platform",
      "advertiser_name",
      "ad_copy",
      "media_url",
      "media_type",
      "estimated_spend",
      "engagement_score",
      "running_days",
      "hook_text",
      "cta_text",
      "ad_url",
      "demo"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sort": {
    "enum": [
     "impressions",
     "recent"
    ],
    "type": "string"
   },
   "total_found": {
    "description": "Rows the search produced before limit.",
    "type": "number"
   }
  },
  "required": [
   "keyword",
   "platform",
   "sort",
   "count",
   "total_found",
   "demo",
   "results",
   "next_step"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "openid",
    "email",
    "profile",
    "offline_access"
   ],
   "type": "oauth2"
  }
 ]
}
