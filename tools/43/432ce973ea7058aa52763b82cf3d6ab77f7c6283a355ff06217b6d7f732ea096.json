 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save customer-authored song understanding"
 },
 "description": "Saves finished song understanding against the current analysisId, assetId and understandingRevision. Accepts lyrics/description, language, themes and required words/lines arrays in the timed-transcription shape; empty arrays represent unavailable genuine timing. Source text alone supplies no lip-sync timing or voice ownership. voiceAnswer represents the customer's all_me, other_voices or skipped decision. Preserves measured audio facts and returns canonical understanding with a new revision. Stale input is refused. No transcription/planning model or credit charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Customer-approved song meaning/description. Absence retains the existing value; an empty string clears it.",
    "maxLength": 4000,
    "type": "string"
   },
   "expectedAnalysisId": {
    "description": "Current analysisId from studio_song_status.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expectedAssetId": {
    "description": "Current assetId from studio_song_status analysis: the existing uploaded master, not a new or remote audio source.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expectedUnderstandingRevision": {
    "description": "Opaque current understandingRevision from studio_song_status.",
    "maxLength": 64,
    "minLength": 64,
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "language": {
    "description": "Customer-supplied language, null when unknown. Absence retains the existing language.",
    "maxLength": 35,
    "minLength": 1,
    "type": [
     "string",
     "null"
    ]
   },
   "lines": {
    "description": "TimedLine text/startMs/endMs, requiring supplied timed words. An empty array leaves section line-sync empty; prose alone supplies no timing.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "endMs": {
       "description": "Actual timestamp on the uploaded master song in whole milliseconds, from supplied timing data.",
       "maximum": 2147483647,
       "minimum": 0,
       "type": "integer"
      },
      "startMs": {
       "description": "Actual timestamp on the uploaded master song in whole milliseconds, from supplied timing data.",
       "maximum": 2147483647,
       "minimum": 0,
       "type": "integer"
      },
      "text": {
       "description": "The customer-supplied word or line at this measured timestamp.",
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "text",
      "startMs",
      "endMs"
     ],
     "type": "object"
    },
    "maxItems": 600,
    "type": "array"
   },
   "lyrics": {
    "description": "Customer-supplied source lyrics with original line breaks. Absence retains existing lyrics; an empty string clears them.",
    "maxLength": 24000,
    "type": "string"
   },
   "projectId": {
    "description": "Project whose currently uploaded master song is being described.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "themes": {
    "description": "Optional song themes. Absence retains existing themes; [] clears them.",
    "items": {
     "description": "One non-lyrical customer-approved song theme.",
     "maxLength": 180,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "voiceAnswer": {
    "description": "The customer\u2019s voice-answer decision. Absence leaves ownership unconfirmed. Shape: {answer: \"all_me\"} | {answer: \"skipped\"} | {answer: \"other_voices\", spans: list of {startMs: integer, endMs: integer, label?: string, role?: \"feature\"|\"dj\"|\"adlib\"|\"unknown\", overlapsArtist?: boolean}}",
    "properties": {
     "answer": {
      "enum": [
       "all_me",
       "skipped",
       "other_voices"
      ],
      "type": "string"
     }
    },
    "required": [
     "answer"
    ],
    "type": "object"
   },
   "words": {
    "description": "Existing TimedWord shape: text/startMs/endMs. Genuine customer-supplied master timing only; [] when unknown. IDs are assigned by the canonical app normalizer.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "endMs": {
       "description": "Actual timestamp on the uploaded master song in whole milliseconds, from supplied timing data.",
       "maximum": 2147483647,
       "minimum": 0,
       "type": "integer"
      },
      "startMs": {
       "description": "Actual timestamp on the uploaded master song in whole milliseconds, from supplied timing data.",
       "maximum": 2147483647,
       "minimum": 0,
       "type": "integer"
      },
      "text": {
       "description": "The customer-supplied word or line at this measured timestamp.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "text",
      "startMs",
      "endMs"
     ],
     "type": "object"
    },
    "maxItems": 4000,
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "expectedAnalysisId",
   "expectedAssetId",
   "expectedUnderstandingRevision",
   "words",
   "lines"
  ],
  "type": "object"
 },
