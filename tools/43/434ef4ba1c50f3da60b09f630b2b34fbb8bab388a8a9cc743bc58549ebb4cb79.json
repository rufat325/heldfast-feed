{
 "description": "[Wicked Memory] Store a memory (free, fair-use rate limited). A real embedding is computed at write time. Run memory_prepare with operation 'store' and these same arguments first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Text to remember (max 16 KB).",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Free-form JSON object (max 8 KB).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "nonce": {
    "description": "From memory_prepare (single use).",
    "type": "string"
   },
   "signature": {
    "description": "Your wallet's signature over memory_prepare's message_to_sign.",
    "type": "string"
   },
   "source": {
    "description": "Which agent/session wrote this.",
    "type": "string"
   },
   "tags": {
    "description": "Up to 20 short tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timestamp": {
    "description": "From memory_prepare.",
    "type": "string"
   },
   "wallet": {
    "description": "Your agent's 0x wallet address.",
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "content",
   "timestamp",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "memory_store"
}
