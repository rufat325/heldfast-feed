{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false
 },
 "description": "Execute a governed MartinLoop coding run after MCP workflow admission is satisfied. Use when the user has authorized implementation, bug fixing, tests, or refactoring and doctor/estimate/plan/preflight receipts match this task. Do not use for question-only diagnosis or when policy, budget, credentials, or scope still need consent. Next: read martin_dossier and verifier evidence.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowedPaths": {
    "description": "Repo-relative path globs Martin may modify.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deniedPaths": {
    "description": "Repo-relative path globs Martin must never modify.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "engine": {
    "description": "Which agent CLI to use. Defaults to claude.",
    "enum": [
     "claude",
     "codex",
     "gemini",
     "openai"
    ],
    "type": "string"
   },
   "maxIterations": {
    "description": "Maximum number of loop attempts.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxTokens": {
    "description": "Maximum total tokens across all attempts.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxUsd": {
    "description": "Hard budget ceiling in USD.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "model": {
    "description": "Optional model override passed to the CLI.",
    "type": "string"
   },
   "objective": {
    "description": "The coding task to complete. Be specific about what needs to change.",
    "type": "string"
   },
   "projectId": {
    "description": "Project identifier for telemetry.",
    "type": "string"
   },
   "providerExecutionTimeoutMs": {
    "description": "Hard timeout for each provider coding process in milliseconds.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "verificationPlan": {
    "description": "Commands that must all exit 0 for the task to be considered complete.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "verifyTimeoutMs": {
    "description": "Hard timeout for each verifier command in milliseconds.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "workingDirectory": {
    "description": "Optional repo-root override resolved under the MCP workspace root. Must stay within that safe root.",
    "type": "string"
   },
   "workspaceId": {
    "description": "Workspace identifier for telemetry.",
    "type": "string"
   }
  },
  "required": [
   "objective"
  ],
  "type": "object"
 },
 "name": "martin_run",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "attempts": {
    "type": "integer"
   },
   "budget": {
    "additionalProperties": false,
    "properties": {
     "maxIterations": {
      "type": "integer"
     },
     "maxTokens": {
      "type": "integer"
     },
     "maxUsd": {
      "type": "number"
     },
     "softLimitUsd": {
      "type": "number"
     }
    },
    "required": [
     "maxUsd",
     "softLimitUsd",
     "maxIterations"
    ],
    "type": "object"
   },
   "costUsd": {
    "type": "number"
   },
   "engine": {
    "type": "string"
   },
   "inspection": {
    "additionalProperties": true,
    "properties": {
     "artifacts": {
      "additionalProperties": true,
      "properties": {
       "highlights": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "artifactId": {
           "type": "string"
          },
          "kind": {
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "uri": {
           "type": "string"
          }
         },
         "required": [
          "artifactId",
          "kind",
          "label",
          "uri"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "kinds": {
        "additionalProperties": {
         "type": "integer"
        },
        "type": "object"
       },
       "totalCount": {
        "type": "integer"
       }
      },
      "required": [
       "totalCount",
       "kinds",
       "highlights"
      ],
      "type": "object"
     },
     "ledgerPath": {
      "type": "string"
     },
     "loop": {
      "additionalProperties": true,
      "properties": {
       "activeAttemptId": {
        "description": "ID of the currently active attempt, when a run is in progress.",
        "type": "string"
       },
       "attempts": {
        "type": "integer"
       },
       "avoidedUsd": {
        "type": "number"
       },
       "costUsd": {
        "type": "number"
       },
       "createdAt": {
        "type": "string"
       },
       "lastAttempt": {
        "additionalProperties": true,
        "type": "object"
       },
       "lifecycleState": {
        "type": "string"
       },
       "loopId": {
        "type": "string"
       },
       "objective": {
        "type": "string"
       },
       "pressure": {
        "type": "string"
       },
       "remainingBudgetUsd": {
        "type": "number"
       },
       "remainingIterations": {
        "type": "integer"
       },
       "remainingTokens": {
        "type": "integer"
       },
       "shouldStop": {
        "type": "boolean"
       },
       "status": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "updatedAt": {
        "type": "string"
       }
      },
      "required": [
       "loopId",
       "title",
       "objective",
       "status",
       "lifecycleState",
       "attempts",
       "costUsd",
       "avoidedUsd",
       "pressure",
       "shouldStop",
       "remainingBudgetUsd",
       "remainingIterations"
      ],
      "type": "object"
     },
     "loopRecordPath": {
      "type": "string"
     },
     "runDirectory": {
      "type": "string"
     },
     "runsRoot": {
      "type": "string"
     },
     "verification": {
      "additionalProperties": true,
      "properties": {
       "completedAt": {
        "type": "string"
       },
       "eventCount": {
        "type": "integer"
       },
       "latestAttemptIndex": {
        "type": "integer"
       },
       "ledgerEventCount": {
        "type": "integer"
       },
       "status": {
        "enum": [
         "passed",
         "failed",
         "contradicted",
         "not_run"
        ],
        "type": "string"
       },
       "steps": {
        "items": {
         "additionalProperties": true,
         "properties": {
          "command": {
           "type": "string"
          },
          "detail": {
           "type": "string"
          },
          "exitCode": {
           "type": "integer"
          },
          "fastFail": {
           "type": "boolean"
          },
          "launched": {
           "type": "boolean"
          },
          "timedOut": {
           "type": "boolean"
          }
         },
         "required": [
          "command",
          "launched"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "summary": {
        "type": "string"
       },
       "warnings": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "status",
       "eventCount",
       "ledgerEventCount",
       "warnings"
      ],
      "type": "object"
     }
    },
    "required": [
     "runsRoot",
     "runDirectory",
     "loopRecordPath",
     "ledgerPath",
     "loop",
     "verification",
     "artifacts"
    ],
    "type": "object"
   },
   "lifecycleState": {
    "type": "string"
   },
   "loopId": {
    "type": "string"
   },
   "pressure": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "remainingBudgetUsd": {
    "type": "number"
   },
   "remainingIterations": {
    "type": "integer"
   },
   "remainingTokens": {
    "type": "integer"
   },
   "shouldStop": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   },
   "verificationPassed": {
    "type": "boolean"
   },
   "workingDirectory": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "lifecycleState",
   "reason",
   "attempts",
   "costUsd",
   "verificationPassed",
   "loopId",
   "pressure",
   "shouldStop",
   "remainingBudgetUsd",
   "remainingIterations",
   "engine",
   "workingDirectory",
   "budget",
   "inspection"
  ],
  "type": "object"
 }
}
