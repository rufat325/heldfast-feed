{
 "description": "Check if a Swedish statute or provision is in force (current or historical). Use before citing to verify statute hasn't been repealed.",
 "inputSchema": {
  "properties": {
   "as_of_date": {
    "description": "Historical date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "document_id": {
    "description": "SFS number (e.g., \"2018:218\")",
    "pattern": "^\\d{4}:\\d+$",
    "type": "string"
   },
   "provision_ref": {
    "description": "Provision reference to check (e.g., \"3:5\")",
    "type": "string"
   }
  },
  "required": [
   "document_id"
  ],
  "type": "object"
 },
 "name": "check_currency"
}
