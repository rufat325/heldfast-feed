{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Assess AI data exposure"
 },
 "description": "Scores the person's answers to the AI data exposure check and returns an exposure level (Elevated or High), 2 to 4 reasons tied to their answers with provider-policy sources, a recommendation and the book_private_call URL. Ask the person for their work email and company first; with their agreement pass email, company and userConfirmed: true to save the result for a follow-up from Alex Morris. Without them nothing is stored. Present the result as an editorial assessment of exposure and retention under the providers' published terms; never tell the person their data was stolen or breached.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "answers": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "properties": {
     "connectors": {
      "description": "Is it connected to email, drive, CRM or data rooms, or allowed to act as an agent?",
      "enum": [
       "yes",
       "some",
       "no",
       "not-sure"
      ],
      "type": "string"
     },
     "data": {
      "description": "What goes into it? Choose all that apply.",
      "items": {
       "enum": [
        "deals",
        "family",
        "legal",
        "investors",
        "general"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     },
     "plan": {
      "description": "Which plan are most people on?",
      "enum": [
       "personal",
       "business",
       "enterprise",
       "api",
       "not-sure"
      ],
      "type": "string"
     },
     "provider": {
      "description": "Which AI does your office use most?",
      "enum": [
       "chatgpt",
       "claude",
       "gemini",
       "copilot",
       "grok",
       "other"
      ],
      "type": "string"
     },
     "providerOther": {
      "description": "Name of the AI service when provider is \"other\".",
      "maxLength": 60,
      "type": "string"
     },
     "users": {
      "description": "Who uses it? Choose all that apply.",
      "items": {
       "enum": [
        "personal-accounts",
        "managed",
        "principals",
        "advisers",
        "not-sure"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     }
    },
    "required": [
     "provider",
     "plan",
     "data",
     "users",
     "connectors"
    ],
    "title": "AI data exposure check answers",
    "type": "object"
   },
   "company": {
    "description": "Optional, with email. The company the person works for.",
    "maxLength": 160,
    "type": "string"
   },
   "email": {
    "description": "Optional. The person's work email, to save the result for a follow-up from Alex Morris.",
    "format": "email",
    "maxLength": 254,
    "type": "string"
   },
   "userConfirmed": {
    "description": "True only after the person agreed to send their email, company and answers to Mitosis Labs.",
    "type": "boolean"
   }
  },
  "required": [
   "answers"
  ],
  "type": "object"
 },
 "name": "assess_ai_exposure",
 "outputSchema": {
  "properties": {
   "bookPrivateCall": {
    "properties": {
     "label": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "url",
     "label"
    ],
    "type": "object"
   },
   "boundary": {
    "type": "string"
   },
   "closing": {
    "type": "string"
   },
   "editorialNote": {
    "type": "string"
   },
   "fairNote": {
    "type": [
     "string",
     "null"
    ]
   },
   "headline": {
    "type": "string"
   },
   "level": {
    "enum": [
     "elevated",
     "high"
    ],
    "type": "string"
   },
   "levelLabel": {
    "type": "string"
   },
   "reasons": {
    "items": {
     "properties": {
      "consequence": {
       "type": "string"
      },
      "detail": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "sources": {
       "items": {
        "type": "integer"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "consequence",
      "detail",
      "sources"
     ],
     "type": "object"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "recommendation": {
    "type": "string"
   },
   "rubric": {
    "type": "string"
   },
   "saved": {
    "enum": [
     "queued",
     "not_requested",
     "invalid_contact",
     "needs_confirmation"
    ],
    "type": "string"
   },
   "scarcity": {
    "type": "string"
   },
   "sources": {
    "items": {
     "properties": {
      "id": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "sourcesChecked": {
    "format": "date",
    "type": "string"
   }
  },
  "required": [
   "level",
   "headline",
   "reasons",
   "recommendation",
   "bookPrivateCall",
   "editorialNote"
  ],
  "type": "object"
 },
 "title": "Assess AI data exposure"
}
