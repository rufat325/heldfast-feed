{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Pause, resume, or reschedule a research series"
 },
 "description": "Edits a series: `enabled: false` pauses the schedule (true resumes), interval / scheduleTime / scheduleTimezone / dayOfWeek move the cadence, name and follow-up / auto-analyze settings change any time. The instrument (questions, scorer) is editable only while no wave has fielded \u2014 after that the server refuses with `invalid`, and the answer is a new series. Series ids come from prism_series_list. May return `needs_confirmation`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adaptiveFollowUps": {
    "type": "boolean"
   },
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation envelope.",
    "type": "string"
   },
   "autoAnalyzeTarget": {
    "anyOf": [
     {
      "maximum": 1000,
      "minimum": 2,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "dayOfWeek": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "enabled": {
    "description": "false pauses, true resumes.",
    "type": "boolean"
   },
   "interval": {
    "enum": [
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "metricId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "questions": {
    "description": "Replacement instrument \u2014 only before the first wave fields.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "allowOther": {
       "type": "boolean"
      },
      "anchorLast": {
       "maximum": 5,
       "minimum": 1,
       "type": "integer"
      },
      "contextImageUrl": {
       "maxLength": 1000,
       "type": "string"
      },
      "contextText": {
       "maxLength": 2000,
       "type": "string"
      },
      "exclusiveLast": {
       "type": "boolean"
      },
      "highLabel": {
       "type": "string"
      },
      "kanoRole": {
       "enum": [
        "functional",
        "dysfunctional"
       ],
       "type": "string"
      },
      "loopId": {
       "maxLength": 40,
       "type": "string"
      },
      "loopItem": {
       "maxLength": 200,
       "type": "string"
      },
      "loopPresentation": {
       "enum": [
        "paged",
        "grid"
       ],
       "type": "string"
      },
      "loopRotate": {
       "type": "boolean"
      },
      "lowLabel": {
       "type": "string"
      },
      "maxSelections": {
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "maxdiffId": {
       "maxLength": 40,
       "type": "string"
      },
      "numberMax": {
       "type": "number"
      },
      "numberMin": {
       "type": "number"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "otherLabel": {
       "maxLength": 60,
       "type": "string"
      },
      "placeholder": {
       "type": "string"
      },
      "prefix": {
       "type": "string"
      },
      "probe": {
       "maxLength": 500,
       "type": "string"
      },
      "prompt": {
       "type": "string"
      },
      "qid": {
       "maxLength": 40,
       "type": "string"
      },
      "rotate": {
       "type": "boolean"
      },
      "scaleMax": {
       "maximum": 20,
       "minimum": 2,
       "type": "integer"
      },
      "scaleMin": {
       "maximum": 10,
       "minimum": 0,
       "type": "integer"
      },
      "screenOutOptions": {
       "items": {
        "maxLength": 200,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "showIf": {
       "properties": {
        "anyOf": {
         "items": {
          "maxLength": 200,
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        },
        "gte": {
         "type": "number"
        },
        "lte": {
         "type": "number"
        },
        "qid": {
         "maxLength": 40,
         "type": "string"
        }
       },
       "required": [
        "qid"
       ],
       "type": "object"
      },
      "susIndex": {
       "maximum": 10,
       "minimum": 1,
       "type": "integer"
      },
      "type": {
       "enum": [
        "word",
        "text",
        "choice",
        "multi",
        "rank",
        "maxdiff",
        "scale",
        "number",
        "completion"
       ],
       "type": "string"
      },
      "vwRole": {
       "enum": [
        "too_cheap",
        "cheap",
        "expensive",
        "too_expensive"
       ],
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   },
   "scheduleTime": {
    "description": "HH:MM.",
    "type": "string"
   },
   "scheduleTimezone": {
    "description": "IANA zone.",
    "type": "string"
   },
   "scorer": {
    "anyOf": [
     {
      "properties": {
       "kind": {
        "enum": [
         "scale_mean",
         "nps",
         "top_2_box",
         "choice_share"
        ],
        "type": "string"
       },
       "minN": {
        "default": 5,
        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
       },
       "option": {
        "maxLength": 200,
        "type": "string"
       },
       "questionIndex": {
        "maximum": 39,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "kind",
       "questionIndex"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "seriesId": {
    "description": "Series id (from prism_series_list).",
    "type": "string"
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this; tokens with a default can override per call. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "seriesId"
  ],
  "type": "object"
 },
 "name": "prism_series_update",
 "title": "Pause, resume, or reschedule a research series"
}
