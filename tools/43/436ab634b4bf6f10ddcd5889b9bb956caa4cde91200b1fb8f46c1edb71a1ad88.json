{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Finds broken or redirected pages in a sitemap sample. Use it when the user asks whether pages of an online store or website are broken or redirected, or for a broken link in the sitemap, for example \"are any pages of shop.example.com broken?\", \"check my sitemap for 404s\" or \"do my product pages redirect?\". Pass the domain. Reads the sitemap (for a sitemap index, the product, page, collection and blog sitemaps first) and checks up to 40 addresses spread across it, on that host only, returning counts by status, and for each broken, unreachable or redirected address its status and final address. It is a sample, not every page; it uses HEAD requests at low concurrency, skips addresses that robots.txt disallows for Agent Tools, and makes at most 46 requests. Do not use it for private or local addresses, to read page content, or to monitor a site over time.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain of a public store or website, for example shop.example.com. Only the host is used. A full address is accepted and reduced to its host.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "link_sample_check",
 "outputSchema": {
  "properties": {
   "domain": {
    "type": "string"
   },
   "failure": {
    "type": "string"
   },
   "issues": {
    "items": {
     "properties": {
      "failure": {
       "type": "string"
      },
      "finalUrl": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "broken",
        "unreachable",
        "redirect"
       ],
       "type": "string"
      },
      "redirects": {
       "type": "integer"
      },
      "status": {
       "type": "integer"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "kind"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "origin": {
    "type": "string"
   },
   "reachable": {
    "type": "boolean"
   },
   "requestsMade": {
    "type": "integer"
   },
   "robots": {
    "properties": {
     "httpStatus": {
      "type": "integer"
     },
     "sitemaps": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "enum": [
       "found",
       "missing",
       "unreachable"
      ],
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "sitemap": {
    "properties": {
     "childSitemapsRead": {
      "type": "integer"
     },
     "found": {
      "type": "boolean"
     },
     "kind": {
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "url": {
      "type": "string"
     },
     "urlsListed": {
      "type": "integer"
     }
    },
    "required": [
     "found"
    ],
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "statuses": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "summary": {
    "properties": {
     "broken": {
      "type": "integer"
     },
     "notChecked": {
      "type": "integer"
     },
     "ok": {
      "type": "integer"
     },
     "redirected": {
      "type": "integer"
     },
     "sampled": {
      "type": "integer"
     },
     "skippedByRobots": {
      "type": "integer"
     },
     "unreachable": {
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "domain",
   "reachable",
   "notice",
   "source"
  ],
  "type": "object"
 },
 "title": "Check a sitemap sample for broken links"
}
