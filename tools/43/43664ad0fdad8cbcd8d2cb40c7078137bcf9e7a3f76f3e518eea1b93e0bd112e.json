{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Starts Docker Compose services and returns structured status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "build": {
    "default": false,
    "description": "Build images before starting (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "detach": {
    "default": true,
    "description": "Run in background (default: true)",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Run in dry-run mode without actually starting services (default: false)",
    "type": "boolean"
   },
   "file": {
    "description": "Compose file path (default: docker-compose.yml)",
    "maxLength": 4096,
    "type": "string"
   },
   "forceRecreate": {
    "default": false,
    "description": "Force recreate containers even if config has not changed (default: false)",
    "type": "boolean"
   },
   "noDeps": {
    "default": false,
    "description": "Do not start linked/dependent services (default: false)",
    "type": "boolean"
   },
   "noRecreate": {
    "default": false,
    "description": "Do not recreate containers if they already exist (default: false)",
    "type": "boolean"
   },
   "path": {
    "description": "Directory containing docker-compose.yml",
    "maxLength": 4096,
    "type": "string"
   },
   "pull": {
    "description": "Pull image policy: \"always\", \"missing\", or \"never\" (--pull)",
    "enum": [
     "always",
     "missing",
     "never"
    ],
    "type": "string"
   },
   "removeOrphans": {
    "default": false,
    "description": "Remove containers for services not defined in the Compose file (default: false)",
    "type": "boolean"
   },
   "renewAnonVolumes": {
    "default": false,
    "description": "Recreate anonymous volumes instead of reusing previous data (default: false)",
    "type": "boolean"
   },
   "scale": {
    "additionalProperties": {
     "maximum": 9007199254740991,
     "minimum": 0,
     "type": "integer"
    },
    "description": "Per-service scale map, mapped to repeated --scale service=num",
    "propertyNames": {
     "maxLength": 255,
     "type": "string"
    },
    "type": "object"
   },
   "services": {
    "default": [],
    "description": "Specific services to start (default: all)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "timeout": {
    "description": "Timeout in seconds for container startup",
    "type": "number"
   },
   "wait": {
    "default": false,
    "description": "Wait for services to be running/healthy (default: false)",
    "type": "boolean"
   },
   "waitTimeout": {
    "description": "Maximum time in seconds to wait for services when using --wait",
    "type": "number"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "compose-up",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "networksCreated": {
    "type": "number"
   },
   "serviceStates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "services": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   },
   "volumesCreated": {
    "type": "number"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Docker Compose Up"
}
