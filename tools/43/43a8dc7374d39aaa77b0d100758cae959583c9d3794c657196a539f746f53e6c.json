{
 "_meta": {
  "ui": {
   "resourceUri": "ui://impreza/deploy-wizard"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List apps available in the Impreza curated catalog. Optional filters: category and search. For a custom app outside the catalog, use impreza_deploy_custom.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Optional category filter.",
    "type": "string"
   },
   "search": {
    "description": "Optional case-insensitive search term.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "impreza_list_apps",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "apps": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "category": {
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "display_name": {
         "type": "string"
        },
        "icon_url": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "readme_url": {
         "type": "string"
        },
        "requirements": {
         "type": "object"
        },
        "supports": {
         "type": "object"
        },
        "tags": {
         "type": "array"
        },
        "vars": {
         "type": "array"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "display_name",
        "version",
        "category",
        "tags",
        "description",
        "icon_url",
        "readme_url",
        "requirements",
        "supports",
        "vars"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "apps",
     "total"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Browse app catalog"
}
