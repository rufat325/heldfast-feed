{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List business entities, row filters most queries need (such as leaving out deleted rows), table and column descriptions, and relations that the catalog does not declare as foreign keys. Filter by entity or table. Omit both to return every annotation loaded from MCP_CUSTOM_TOOLS. An unknown entity name falls back to names that partly match it, and when nothing matches, the result lists the loaded entity names.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entity": {
    "description": "Entity name, for example sales_order",
    "type": "string"
   },
   "table": {
    "description": "Table name, or SCHEMA.TABLE",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_business_context",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "available_entities": {
    "description": "Every loaded entity name, when nothing matched the filters",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "available_tables": {
    "description": "Every annotated SCHEMA.TABLE, when the table filter matched nothing",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "columns": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "description": {
       "type": "string"
      },
      "entity": {
       "type": "string"
      },
      "filters": {
       "description": "Row filters most queries on this table need, such as leaving out deleted rows",
       "items": {
        "additionalProperties": false,
        "properties": {
         "columns": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "reason": {
          "type": "string"
         },
         "sql": {
          "type": "string"
         }
        },
        "required": [
         "sql",
         "columns"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "relations": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "cardinality": {
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "join": {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         "table": {
          "type": "string"
         }
        },
        "required": [
         "table",
         "join"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "table": {
       "type": "string"
      }
     },
     "required": [
      "table"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "hint": {
    "description": "What to call next when the filters did not match exactly",
    "type": "string"
   },
   "partial_match": {
    "description": "True when no entity had the requested name and data holds entities whose names partly match it",
    "type": "boolean"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Get Business Context"
}
