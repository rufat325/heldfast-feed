{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "wapiworld:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check webhook delivery health"
 },
 "description": "Use this when someone asks whether their Wapiworld webhooks are working, failing or were switched off. Returns each subscription's endpoint scheme and host, events, active state, consecutive failures and an auto-disabled flag after 20 failures, 25 per page by default. Works only with an operator OAuth session, not an API key. Not for changing a webhook.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The page.nextCursor of the previous page with the same projectId; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Webhook subscriptions per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "projectId": {
    "description": "Only this project",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_webhook_subscriptions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "description": "Pass nextCursor as cursor, with the same filters, for the next page; null on the last page",
    "properties": {
     "count": {
      "minimum": 0,
      "type": "integer"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "count",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   },
   "webhookSubscriptions": {
    "description": "Delivery health per subscription; autoDisabled marks an endpoint switched off after 20 consecutive failures. The signing secret, delivery paths, queries and fragments are never returned: hook paths often embed a credential.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "active": {
       "type": "boolean"
      },
      "autoDisabled": {
       "type": "boolean"
      },
      "consecutiveFailures": {
       "minimum": 0,
       "type": "integer"
      },
      "creationTime": {
       "$ref": "#/properties/webhookSubscriptions/items/properties/lastDeliveryTime"
      },
      "endpointHost": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "events": {
       "items": {
        "maxLength": 64,
        "type": "string"
       },
       "maxItems": 20,
       "type": "array"
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastDeliveryTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "projectId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "projectId",
      "endpointHost",
      "events",
      "active",
      "consecutiveFailures",
      "autoDisabled",
      "lastDeliveryTime",
      "creationTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "webhookSubscriptions",
   "page"
  ],
  "type": "object"
 },
 "title": "Check webhook delivery health"
}
