{
 "description": "Generate compact, URL-safe Nano IDs. Use this instead of inventing IDs \u2014 they must be truly random. One per line.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alphabet": {
    "default": "default",
    "description": "Character set preset.",
    "enum": [
     "default",
     "alphanumeric",
     "lowercase",
     "uppercase",
     "numbers",
     "hexadecimal",
     "nolookalikes",
     "safe"
    ],
    "type": "string"
   },
   "count": {
    "default": 1,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "length": {
    "default": 21,
    "maximum": 256,
    "minimum": 2,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "nano_id",
 "title": "Generate Nano ID(s)"
}
