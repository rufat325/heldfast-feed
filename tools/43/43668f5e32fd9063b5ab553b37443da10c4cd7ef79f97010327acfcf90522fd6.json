{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Khi c\u1ea7n t\u1ea1o nhi\u1ec1u \u0111\u1ecba ch\u1ec9 m\u1ed9t l\u1ea7n (v\u00ed d\u1ee5 m\u1ed7i nh\u00e2n vi\u00ean m\u1ed9t h\u1ed9p), t\u1ea1o h\u00e0ng lo\u1ea1t trong quota g\u00f3i; l\u1ed7i t\u1eebng h\u1ed9p kh\u00f4ng h\u1ee7y c\u1ea3 batch. / Use to create many inboxes at once.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_ids": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "pattern": "^[a-z0-9](?:[a-z0-9._-]{0,62}[a-z0-9])?$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "domain": {
    "type": "string"
   },
   "forward_to": {
    "maxLength": 320,
    "pattern": "^[^\\s@<>,;]+@[^\\s@<>,;]+\\.[^\\s@<>,;]+$",
    "type": "string"
   },
   "mode": {
    "enum": [
     "redirect",
     "store",
     "ai"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_ids"
  ],
  "type": "object"
 },
 "name": "mail_inbox_batch",
 "title": "T\u1ea1o nhi\u1ec1u h\u1ed9p agent"
}
