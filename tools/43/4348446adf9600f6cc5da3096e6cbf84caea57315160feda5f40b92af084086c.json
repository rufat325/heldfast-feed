{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Quote Workholding"
 },
 "description": "Locating nests, clamped fixtures and soft jaws from dimensions or a supported straight-extrusion STL. Quote the exact customer-reviewed configuration and revision as one complete set. Consumes one quote allowance. Reuse idempotencyKey for retries. Returns a browser link for customer checkout; individual-part update and checkout are blocked.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accessToken": {
    "description": "Guest token returned by printing.sessions.start. Optional when Authorization already carries a permanent key or guest token.",
    "maxLength": 138,
    "minLength": 34,
    "type": "string"
   },
   "configuration": {
    "additionalProperties": false,
    "description": "Workbench configuration including geometry, materials, quantity and order options.",
    "properties": {
     "clampBoltOffset": {
      "maximum": 28,
      "minimum": 10,
      "type": "number"
     },
     "clampOverlap": {
      "maximum": 15,
      "minimum": 3,
      "type": "number"
     },
     "clampThickness": {
      "maximum": 16,
      "minimum": 6,
      "type": "number"
     },
     "clampWidth": {
      "maximum": 40,
      "minimum": 14,
      "type": "number"
     },
     "clampY": {
      "maximum": 140,
      "minimum": -140,
      "type": "number"
     },
     "clearance": {
      "maximum": 2,
      "minimum": 0.05,
      "type": "number"
     },
     "depth": {
      "maximum": 80,
      "minimum": 1,
      "type": "number"
     },
     "fixtureType": {
      "enum": [
       "nest",
       "clamped",
       "soft-jaws"
      ],
      "type": "string"
     },
     "floor": {
      "maximum": 40,
      "minimum": 1,
      "type": "number"
     },
     "fulfillmentMethod": {
      "enum": [
       "shipping",
       "pickup",
       "courier"
      ],
      "type": "string"
     },
     "holes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "counterbore": {
         "maximum": 30,
         "minimum": 5,
         "type": "number"
        },
        "diameter": {
         "maximum": 20,
         "minimum": 3,
         "type": "number"
        },
        "recess": {
         "maximum": 116,
         "minimum": 1,
         "type": "number"
        },
        "x": {
         "maximum": 160,
         "minimum": -160,
         "type": "number"
        },
        "y": {
         "maximum": 160,
         "minimum": -160,
         "type": "number"
        }
       },
       "required": [
        "x",
        "y",
        "diameter",
        "counterbore",
        "recess"
       ],
       "type": "object"
      },
      "maxItems": 12,
      "type": "array"
     },
     "jawBore": {
      "maximum": 20,
      "minimum": 3,
      "type": "number"
     },
     "jawCounterbore": {
      "maximum": 32,
      "minimum": 5,
      "type": "number"
     },
     "jawGap": {
      "maximum": 30,
      "minimum": 0.5,
      "type": "number"
     },
     "jawGrip": {
      "maximum": 60,
      "minimum": 2,
      "type": "number"
     },
     "jawHeight": {
      "maximum": 100,
      "minimum": 30,
      "type": "number"
     },
     "jawHoleHeight": {
      "maximum": 80,
      "minimum": 10,
      "type": "number"
     },
     "jawHoleSpacing": {
      "maximum": 250,
      "minimum": 20,
      "type": "number"
     },
     "jawLength": {
      "maximum": 300,
      "minimum": 50,
      "type": "number"
     },
     "jawMount": {
      "enum": [
       "kurt-dx6",
       "custom"
      ],
      "type": "string"
     },
     "jawRecess": {
      "maximum": 35,
      "minimum": 2,
      "type": "number"
     },
     "jawThickness": {
      "maximum": 100,
      "minimum": 15,
      "type": "number"
     },
     "materialId": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "offsetX": {
      "maximum": 160,
      "minimum": -160,
      "type": "number"
     },
     "offsetY": {
      "maximum": 160,
      "minimum": -160,
      "type": "number"
     },
     "outline": {
      "items": {
       "items": {
        "maximum": 320,
        "minimum": -320,
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      },
      "maxItems": 256,
      "type": "array"
     },
     "partHeight": {
      "maximum": 150,
      "minimum": 3,
      "type": "number"
     },
     "partLength": {
      "maximum": 280,
      "minimum": 8,
      "type": "number"
     },
     "partWidth": {
      "maximum": 280,
      "minimum": 8,
      "type": "number"
     },
     "preset": {
      "enum": [
       "custom",
       "smw-m6",
       "smw-half",
       "kurt"
      ],
      "type": "string"
     },
     "productionSpeed": {
      "enum": [
       "standard",
       "rush"
      ],
      "type": "string"
     },
     "quantity": {
      "maximum": 150,
      "minimum": 1,
      "type": "integer"
     },
     "rotation": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "shape": {
      "enum": [
       "bracket",
       "rectangle",
       "round",
       "custom"
      ],
      "type": "string"
     },
     "stockLength": {
      "maximum": 300,
      "minimum": 25,
      "type": "number"
     },
     "stockWidth": {
      "maximum": 320,
      "minimum": 25,
      "type": "number"
     }
    },
    "required": [
     "fixtureType",
     "jawMount",
     "jawLength",
     "jawHeight",
     "jawThickness",
     "jawGrip",
     "jawGap",
     "jawHoleSpacing",
     "jawHoleHeight",
     "jawBore",
     "jawCounterbore",
     "jawRecess",
     "clampWidth",
     "clampThickness",
     "clampOverlap",
     "clampBoltOffset",
     "clampY",
     "shape",
     "partLength",
     "partWidth",
     "partHeight",
     "stockLength",
     "stockWidth",
     "floor",
     "depth",
     "clearance",
     "rotation",
     "offsetX",
     "offsetY",
     "preset",
     "materialId",
     "quantity",
     "fulfillmentMethod",
     "productionSpeed",
     "holes",
     "outline"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "description": "Stable unique key for retrying this complete-set quote.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "reviewConfirmed": {
    "const": true,
    "description": "The complete current configuration, mounting pattern and setup notes were reviewed. Geometry checks do not certify clamping strength or the machining setup.",
    "type": "boolean"
   },
   "reviewedRevision": {
    "description": "Exact revision returned by preparation and reviewed by the customer.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "configuration",
   "reviewedRevision",
   "reviewConfirmed",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "quote_workholding",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "build": {
      "additionalProperties": true,
      "description": "Complete-set quote and authoritative server totals, returned after quoting.",
      "type": "object"
     },
     "reviewUrl": {
      "description": "Private design review link for the customer.",
      "format": "uri",
      "type": "string"
     },
     "revision": {
      "description": "Hash of the exact normalized design and quantity.",
      "type": "string"
     },
     "success": {
      "const": true,
      "description": "Confirms the operation succeeded.",
      "type": "boolean"
     },
     "warnings": {
      "description": "Design and manufacturing limitations to review.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "success",
     "revision",
     "reviewUrl"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "A structured AIURION tool error.",
    "properties": {
     "error": {
      "additionalProperties": true,
      "description": "Machine-readable error details.",
      "properties": {
       "code": {
        "description": "Stable error code.",
        "type": "string"
       },
       "message": {
        "description": "Human-readable error message.",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "success": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "success",
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Quote Workholding"
}
