{
 "description": "Search npm packages by query. Returns name, version, description, and keywords.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "description": "Search query (e.g. 'react state management')",
    "type": "string"
   },
   "size": {
    "default": 10,
    "description": "Number of results (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search"
}
