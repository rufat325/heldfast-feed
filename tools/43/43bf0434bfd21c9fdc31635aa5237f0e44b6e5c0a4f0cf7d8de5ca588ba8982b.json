{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create/update a Sulvo advanced report (adUnit, dimensions, or customData), run immediately (emailed) or on a recurring schedule. Requires SULVO_API_KEY (with the reports:write scope) in the server environment. Note: advanced reports are delivered by email, not returned inline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adRoots": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dimensions": {
    "items": {
     "enum": [
      "country",
      "device",
      "os"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "domains": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "end": {
    "type": "string"
   },
   "frequency": {
    "description": "Required when immediateRun is false.",
    "enum": [
     "daily",
     "weekly",
     "biweekly",
     "monthly"
    ],
    "type": "string"
   },
   "immediateRun": {
    "description": "true to run now (emailed), false to only schedule (requires frequency).",
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "outputFormat": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json",
     "csv"
    ],
    "type": "string"
   },
   "reportId": {
    "description": "Provide to update an existing saved report.",
    "type": "string"
   },
   "reportType": {
    "description": "Advanced report type.",
    "enum": [
     "adUnit",
     "dimensions",
     "customData"
    ],
    "type": "string"
   },
   "start": {
    "type": "string"
   },
   "timeZone": {
    "description": "IANA timezone for scheduled delivery.",
    "type": "string"
   },
   "toAddress": {
    "description": "Email address the report is delivered to.",
    "format": "email",
    "type": "string"
   },
   "utmHourlyBreakdown": {
    "type": "boolean"
   },
   "utms": {
    "description": "customData (UTM) reports only.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "reportType",
   "toAddress",
   "immediateRun"
  ],
  "type": "object"
 },
 "name": "save_sulvo_advanced_report"
}
