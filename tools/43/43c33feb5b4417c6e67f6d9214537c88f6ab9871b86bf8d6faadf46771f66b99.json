{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Deterministically resolve a folder and submit each eligible video (CONVERTED, 5min\u20135h) for AI Shorts generation (POST /shorts/import-video). Each job consumes Shorts processing. dry_run=true (default) previews eligible videos. DRM-protected videos are rejected by the API and surfaced per-video.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "default": "vertical",
    "description": "Output aspect ratio",
    "enum": [
     "vertical",
     "horizontal",
     "square"
    ],
    "type": "string"
   },
   "contexts": {
    "default": [
     "engajamento"
    ],
    "description": "AI context hints (e.g. 'engajamento','educacional','humor')",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = submit",
    "type": "boolean"
   },
   "duration_preset": {
    "default": "30-60",
    "description": "Clip duration range in seconds",
    "enum": [
     "30-60",
     "60-90",
     "90-180"
    ],
    "type": "string"
   },
   "folder_ref": {
    "description": "Folder name, ID, or dashboard URL",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   }
  },
  "required": [
   "folder_ref"
  ],
  "type": "object"
 },
 "name": "panda_action_generate_shorts_from_folder",
 "title": "Generate Shorts from Folder"
}
