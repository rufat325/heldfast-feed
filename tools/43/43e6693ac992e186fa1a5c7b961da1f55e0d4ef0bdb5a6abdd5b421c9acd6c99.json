{"description":"Wake-on-LAN magic packet (UDP broadcast). Mutating: dry-run returns confirmToken; re-call with token to execute.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"confirmToken":{"type":"string"},"mac":{"pattern":"^([0-9a-fA-F]{2}[:-]){5}[0-9a-fA-F]{2}$","type":"string"},"port":{"default":9,"maximum":65535,"minimum":1,"type":"integer"}},"required":["mac"],"type":"object"},"name":"lan.wol"}
