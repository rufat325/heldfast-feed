{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add or remove a RouterOS logging action target. Idempotent by name. add throws VALIDATION if type is missing; returns already_exists if name found. remove returns not_found gracefully. Supports dry-run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "remove"
    ],
    "type": "string"
   },
   "diskFileName": {
    "description": "Disk log file name without extension (for type=disk)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "name": {
    "description": "Log action name \u2014 idempotency key",
    "type": "string"
   },
   "remote": {
    "description": "Remote syslog server address (for type=remote)",
    "type": "string"
   },
   "remotePort": {
    "description": "Remote syslog server port (for type=remote)",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "type": {
    "description": "Action type: memory, disk, remote, echo, email (required on add)",
    "enum": [
     "memory",
     "disk",
     "remote",
     "echo",
     "email"
    ],
    "type": "string"
   }
  },
  "required": [
   "action",
   "name"
  ],
  "type": "object"
 },
 "name": "manage_log_action",
 "title": "Manage Log Action"
}
