{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Weekly median price series for one card (representative grade, up to 26 weeks) plus 30d/90d change percentages (only shown when statistically confident). Reads POKEKA market data only; server-side request logging is disclosed in the privacy policy; does not modify user data.",
 "inputSchema": {
  "properties": {
   "card_id": {
    "description": "Card id from search_card / slang_lookup.",
    "type": "string"
   },
   "weeks": {
    "description": "How many recent weeks (default 26, max 26).",
    "maximum": 26,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
 "name": "card_price_history",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "card_id": {
    "type": "string"
   },
   "change_pct_30d": {
    "type": "number"
   },
   "change_pct_90d": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "point_count": {
    "type": "number"
   },
   "series": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "median_usd": {
       "type": "number"
      },
      "n_sales": {
       "type": "number"
      },
      "week": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "weeks_requested": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Card price history"
}
