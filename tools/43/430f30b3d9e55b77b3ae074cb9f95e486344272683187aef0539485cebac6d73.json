{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a new blog"
 },
 "description": "Use this when someone asks to start a new blog in Polyblog with a given name and languages. Returns the new blog's id, name, domain and languages; the name becomes the public <name>.polyblog.io subdomain, so a name already taken fails. Not for adding a post to an existing blog.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "articlesFormat": {
    "description": "Format for the blog's posts: markdown or html",
    "enum": [
     "markdown",
     "html"
    ],
    "type": "string"
   },
   "defaultLocale": {
    "description": "Main language, an ISO 639-1 code such as en",
    "maxLength": 50,
    "type": "string"
   },
   "description": {
    "description": "Short description of what the blog is about, up to 600 characters",
    "maxLength": 600,
    "type": "string"
   },
   "locales": {
    "description": "Every language the blog publishes in, ISO 639-1 codes such as en and it",
    "items": {
     "$ref": "#/properties/defaultLocale"
    },
    "maxItems": 100,
    "type": "array"
   },
   "name": {
    "description": "Blog name, which becomes the public <name>.polyblog.io subdomain and has to be globally unique",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_blog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blog": {
    "additionalProperties": false,
    "properties": {
     "coverUrl": {
      "$ref": "#/properties/blog/properties/logoUrl"
     },
     "created": {
      "anyOf": [
       {
        "maxLength": 100,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "customDomain": {
      "anyOf": [
       {
        "maxLength": 300,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "defaultLocale": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "edited": {
      "$ref": "#/properties/blog/properties/created"
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "locales": {
      "items": {
       "maxLength": 50,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "localesTruncated": {
      "type": "boolean"
     },
     "logoUrl": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "name",
     "customDomain",
     "logoUrl",
     "defaultLocale",
     "locales",
     "localesTruncated",
     "coverUrl",
     "created",
     "edited"
    ],
    "type": "object"
   },
   "status": {
    "const": "created",
    "type": "string"
   }
  },
  "required": [
   "status",
   "blog"
  ],
  "type": "object"
 },
 "title": "Create a new blog"
}
