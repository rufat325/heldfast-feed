{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks about one liquidity pool, such as \"volume and fee APR for WETH and USDC on Ethereum\" or \"is this pool APR a spike?\". Pass a pool id, or chain plus token_a and token_b (symbols or token addresses). Optionally pass a price range, holding_days, and gas or exit amounts for the fee-versus-IL estimate. Returns 1-day and 7-day volume and fee APR, TVL, an APR flag with a reason, a risk checklist with warnings, price trend, token risk flags when a public source covers them, and an informational position-type label. A pool contract address is not in the index: the answer says needs_tokens and what to pass instead. Not financial advice, and it does not recommend entering or leaving a position.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "capital_usd": {
    "description": "Position size, so gas and exit cost can be compared with fees. Not stored as a record of who asked",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "chain": {
    "description": "Chain name or short alias, such as ethereum, base, arbitrum, optimism, polygon, bsc, avalanche, or solana",
    "maxLength": 40,
    "minLength": 2,
    "type": "string"
   },
   "exit_cost_usd": {
    "description": "Other exit cost, such as a withdrawal fee, in the same currency as capital_usd",
    "minimum": 0,
    "type": "number"
   },
   "gas_usd": {
    "description": "Gas you expect to pay to enter and exit, in the same currency as capital_usd",
    "minimum": 0,
    "type": "number"
   },
   "holding_days": {
    "description": "Holding window for the fee-versus-IL estimate. Requires price_lower, price_upper, and price_now",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "pool_address": {
    "description": "Pool contract address. The open yields index does not list pool contract addresses; pass token addresses or a pool id instead if this cannot be matched",
    "maxLength": 80,
    "minLength": 8,
    "type": "string"
   },
   "pool_id": {
    "description": "DefiLlama pool id (a UUID), from find_active_pools or a previous answer",
    "maxLength": 80,
    "minLength": 8,
    "type": "string"
   },
   "price_lower": {
    "description": "Lower price of the range, in quote per base",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "price_now": {
    "description": "Current price in the same units as the range",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "price_upper": {
    "description": "Upper price of the range, in quote per base",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "token_a": {
    "description": "Token symbol or contract address",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "token_b": {
    "description": "The other token's symbol or contract address",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
