{"annotations":{"readOnlyHint":false},"description":"Creates a commit with the given message. Returns structured data with hash, message, and change statistics. Pass `path` to target a specific repo or worktree \u2014 when omitted, operates on the server's own working directory, not the caller's (see #876).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"all":{"description":"Auto-stage tracked modified/deleted files (-a/--all)","type":"boolean"},"allowEmpty":{"description":"Allow commit with no changes (--allow-empty)","type":"boolean"},"amend":{"default":false,"description":"Amend the previous commit","type":"boolean"},"author":{"description":"Override author (--author), e.g. 'Name <email>'","maxLength":255,"type":"string"},"cleanup":{"description":"Control message whitespace handling (--cleanup), e.g. strip, whitespace, verbatim, scissors, default","maxLength":255,"type":"string"},"date":{"description":"Override author date (--date)","maxLength":255,"type":"string"},"dryRun":{"description":"Preview commit without executing (--dry-run)","type":"boolean"},"fixup":{"description":"Create fixup commit for autosquash (--fixup=<commit>)","maxLength":255,"type":"string"},"gpgSign":{"description":"GPG sign the commit (-S/--gpg-sign)","type":"boolean"},"message":{"description":"Commit message","maxLength":72000,"type":"string"},"noEdit":{"description":"Keep existing message with --amend (--no-edit)","type":"boolean"},"noVerify":{"description":"Bypass pre-commit and commit-msg hooks (--no-verify)","type":"boolean"},"path":{"description":"Repository path. Authoritative \u2014 when omitted, the server uses its own process working directory (its launch dir, not the caller's cwd). Callers in a git worktree or other directory MUST pass this explicitly to avoid operating on the wrong repo.","maxLength":4096,"type":"string"},"resetAuthor":{"description":"Reset author info on amended commits (--reset-author)","type":"boolean"},"reuseMessage":{"description":"Reuse message from existing commit (-C <commit>)","maxLength":255,"type":"string"},"signoff":{"description":"Add Signed-off-by trailer (-s/--signoff)","type":"boolean"},"trailer":{"description":"Trailer strings to append (--trailer), e.g. 'Signed-off-by: Name <email>'","items":{"maxLength":255,"type":"string"},"maxItems":1000,"type":"array"}},"required":["message"],"type":"object"},"name":"commit","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"deletions":{"type":"number"},"filesChanged":{"type":"number"},"hash":{"type":"string"},"hashShort":{"type":"string"},"insertions":{"type":"number"},"message":{"type":"string"}},"required":["hash","hashShort","message","filesChanged","insertions","deletions"],"type":"object"},"title":"Git Commit"}
