     "inbound",
     "outbound",
     "both"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "allow",
     "block"
    ],
    "type": "string"
   },
   "pattern": {
    "description": "Email address or bare domain (e.g. \"spam.example\").",
    "type": "string"
   }
  },
  "required": [
