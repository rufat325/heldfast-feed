{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the project's compile-format definitions (from Settings/compile.xml) and its taxonomy: the named compile formats and their section-layout counts, the current output file type, label and status definitions (with colors), saved collections, and user-defined section types. Use this to discover what compile formats and metadata categories a project defines before compiling or organizing. Read-only; does not run a compile. If a project has never been compiled, hasCompileSettings is false and only the taxonomy is returned. Requires an open project (call open_project first).",
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "get_compile_settings",
 "outputSchema": {
  "properties": {
   "collections": {
    "description": "Saved collections (binder, saved searches, groups).",
    "items": {
     "properties": {
      "color": {
       "description": "Normalized-RGB color string, if set.",
       "type": "string"
      },
      "hex": {
       "description": "Color as #RRGGBB, if parseable.",
       "type": "string"
      },
      "id": {
       "description": "Collection UUID.",
       "type": "string"
      },
      "title": {
       "description": "Collection name.",
       "type": "string"
      },
      "type": {
       "description": "Collection kind (Binder, RecentSearch, ...).",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "compileFormats": {
    "description": "Named compile formats the project defines.",
    "items": {
     "properties": {
      "font": {
       "description": "Font override, if any.",
       "type": "string"
      },
      "hasFrontMatter": {
       "description": "Whether the format injects default front/back matter.",
       "type": "boolean"
      },
      "id": {
       "description": "Format identifier.",
       "type": "string"
      },
      "sectionLayoutCount": {
       "description": "Number of section-type to layout assignments.",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "currentFileType": {
    "description": "Default output file type of the last-used compile (e.g. \"pdf\").",
    "type": "string"
   },
   "hasCompileSettings": {
    "description": "False when Settings/compile.xml is absent or unreadable.",
    "type": "boolean"
   },
   "labels": {
    "description": "Label definitions with colors.",
    "items": {
     "properties": {
      "color": {
       "description": "Normalized-RGB color string, if set.",
       "type": "string"
      },
      "hex": {
       "description": "Color as #RRGGBB, if parseable.",
       "type": "string"
      },
      "id": {
       "description": "Label id.",
       "type": "string"
      },
      "title": {
       "description": "Label name.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "options": {
    "description": "Global compile options.",
    "properties": {
     "removeAnnotations": {
      "description": "Strip inline annotations on compile.",
      "type": "boolean"
     },
     "removeComments": {
      "description": "Strip comments on compile.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "sectionTypes": {
    "description": "User-defined section types (Scene, Chapter, Part Heading, ...).",
    "items": {
     "properties": {
      "id": {
       "description": "Section-type UUID.",
       "type": "string"
      },
      "name": {
       "description": "Human-readable name.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "statuses": {
    "description": "Status definitions.",
    "items": {
     "properties": {
      "id": {
       "description": "Status id.",
       "type": "string"
      },
      "title": {
       "description": "Status name.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "hasCompileSettings",
   "compileFormats"
  ],
  "type": "object"
 },
 "title": "Get Compile & Taxonomy Settings"
}
