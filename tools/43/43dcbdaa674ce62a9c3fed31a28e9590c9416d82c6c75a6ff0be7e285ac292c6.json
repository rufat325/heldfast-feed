{
 "description": "List executed trades for an order book",
 "inputSchema": {
  "properties": {
   "book": {
    "description": "Order book symbol (e.g. btc_mxn)",
    "type": "string"
   },
   "limit": {
    "description": "Number of results (default 25, max 100)",
    "type": "number"
   },
   "marker": {
    "description": "Pagination marker",
    "type": "string"
   },
   "sort": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "required": [
   "book"
  ],
  "type": "object"
 },
 "name": "list_trades"
}
