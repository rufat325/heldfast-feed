{
 "description": "Search Target products by query with optional filters",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category filter (e.g., 'electronics', 'clothing')",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results (default: 10, max: 24)",
    "type": "number"
   },
   "max_price": {
    "description": "Maximum price filter",
    "type": "number"
   },
   "min_price": {
    "description": "Minimum price filter",
    "type": "number"
   },
   "query": {
    "description": "Search term",
    "type": "string"
   },
   "sort_by": {
    "description": "Sort order",
    "enum": [
     "relevance",
     "price_low",
     "price_high",
     "newest",
     "bestselling"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products"
}
