{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare two searches using real catalogue results; does NOT certify identical products.",
 "inputSchema": {
  "properties": {
   "country": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Two-letter country code, e.g. US or UZ.",
    "title": "Country"
   },
   "max_price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 100000000,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Maximum price in USD; excludes taxes and shipping.",
    "title": "Max Price"
   },
   "query_a": {
    "maxLength": 200,
    "minLength": 2,
    "title": "Query A",
    "type": "string"
   },
   "query_b": {
    "maxLength": 200,
    "minLength": 2,
    "title": "Query B",
    "type": "string"
   }
  },
  "required": [
   "query_a",
   "query_b"
  ],
  "title": "compare_dealsArguments",
  "type": "object"
 },
 "name": "compare_deals"
}
