{
 "description": "Get all Ordinals inscriptions owned by a Bitcoin address. Returns inscription IDs, numbers, content types, and sat rarity.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Bitcoin address (bc1p..., bc1q..., 1..., 3...)",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (max 60)",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_address_inscriptions"
}
