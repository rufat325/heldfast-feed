{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Extract a book's text as a capped, fenced excerpt; pass the returned nextCursor token verbatim to walk the whole book, or jump to a char position with offset (e.g. a search passage's charStart). Set structure=true for a chapter map with per-chapter cursors. To find text inside a book, use calibre_search scope=book.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookId": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "cursor": {
    "description": "Opaque continuation token from a previous response (nextCursor or a chapter cursor). Pass it verbatim \u2014 do not construct one.",
    "type": "string"
   },
   "format": {
    "type": "string"
   },
   "id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "library": {
    "type": "string"
   },
   "maxChars": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "offset": {
    "description": "Char position to start reading from \u2014 e.g. a search passage's charStart. Mutually exclusive with cursor.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sentenceAware": {
    "type": "boolean"
   },
   "structure": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "calibre_get_content",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "backend": {
    "type": "string"
   },
   "chapters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "approxTokens": {
       "type": "number"
      },
      "cursor": {
       "type": "string"
      },
      "endChar": {
       "type": "number"
      },
      "heading": {
       "type": "string"
      },
      "n": {
       "type": "number"
      },
      "startChar": {
       "type": "number"
      }
     },
     "required": [
      "n",
      "heading",
      "startChar",
      "endChar",
      "approxTokens",
      "cursor"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "detector": {
    "type": "string"
   },
   "format": {
    "type": "string"
   },
   "hasMore": {
    "type": "boolean"
   },
   "hasToc": {
    "type": "boolean"
   },
   "nextCursor": {
    "type": "string"
   },
   "offset": {
    "type": "number"
   },
   "text": {
    "type": "string"
   },
   "totalChars": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Read book text"
}
