{
 "description": "List all linked mcp-gmail accounts with their aliases and active status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "account-list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "accounts": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "alias": {
           "type": "string"
          },
          "email": {
           "type": "string"
          },
          "isActive": {
           "type": "boolean"
          }
         },
         "required": [
          "email",
          "isActive"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "message": {
        "type": "string"
       },
       "service": {
        "type": "string"
       },
       "totalAccounts": {
        "type": "number"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "service",
       "accounts",
       "totalAccounts",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
