{
 "description": "Comprehensive risk assessment for an AI agent deployment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentName": {
    "description": "Name of the AI agent",
    "type": "string"
   },
   "complianceRisk": {
    "description": "Compliance risk score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "deploymentContext": {
    "description": "Context of deployment",
    "type": "string"
   },
   "ethicalRisk": {
    "description": "Ethical risk score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "operationalRisk": {
    "description": "Operational risk score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "securityRisk": {
    "description": "Security risk score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "agentName",
   "operationalRisk",
   "ethicalRisk",
   "securityRisk",
   "complianceRisk",
   "deploymentContext"
  ],
  "type": "object"
 },
 "name": "risk_assessment"
}
