{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a TikTok Live-style event scaffold with sanitized event rows, gift tiers, moderation policy, adapter source, and auth/client safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "websocket_json",
     "polling_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "ws://127.0.0.1:9080/tiktok-live",
    "type": "string"
   },
   "creator_label": {
    "default": "show_creator",
    "type": "string"
   },
   "event_count": {
    "default": 16,
    "maximum": 1024,
    "minimum": 1,
    "type": "integer"
   },
   "gift_tier_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 0,
    "type": "integer"
   },
   "moderation_level": {
    "default": "filtered",
    "enum": [
     "display_only",
     "filtered",
     "approval_required"
    ],
    "type": "string"
   },
   "name": {
    "default": "tiktok_live_events_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the TikTok scaffold.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_tiktok_live_events_bus",
 "title": "Connect TikTok Live events bus"
}
