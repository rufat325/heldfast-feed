  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Internal: returns an App Store entry's ui and manifest plus its mock-data fixtures, so the App Store app can render a LIVE sandboxed preview card (srcdoc + stub oma + mock snapshot). Read-only; nothing is installed. Not useful to call directly.",
 "inputSchema": {
  "properties": {
   "name": {
    "description": "App Store entry name (see app_store_list)",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "preview_app_store_entry",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "fixtures": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "collection": {
           "type": "string"
          },
          "fields": {
           "additionalProperties": {},
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          },
          "group": {
           "type": "string"
          },
          "id": {
           "type": "string"
          },
          "position": {
           "type": "number"
          },
          "version": {
           "type": "number"
          }
         },
         "required": [
          "fields"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "items"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "embedded mock snapshot items, or null if the entry ships none"
   },
   "html": {
    "description": "the entry's ui slot (field named for its format \u2014 the preview iframe srcdocs it)",
    "type": "string"
   },
   "manifest": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "name",
   "title",
   "description",
   "category",
   "html",
   "manifest",
   "fixtures"
  ],
  "type": "object"
 },
 "title": "App Store live-preview payload (internal)"
