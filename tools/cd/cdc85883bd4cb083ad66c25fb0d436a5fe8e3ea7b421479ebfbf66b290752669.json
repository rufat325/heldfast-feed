{"_meta":{"openai/outputTemplate":"ui://atlasly/workspace/v15.html","ui":{"resourceUri":"ui://atlasly/workspace/v15.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Present Site Research"},"description":"Purpose: present cited site research. When to use: after prepare_site_research and the host's own search, or to show unavailable search and gaps. Returns: Atlas AI UI, a JSON evidence register and a self-contained printable HTML pack. The HTML can be printed to PDF by the receiving browser; no generated or validated PDF is supplied. Parameter guidance: present up to 30 conversation-reported findings and 20 cited public HTTPS sources with dates, applicability, limitations and gaps. Every finding must reference a supplied unique source ID. Supply the previous site_ref unchanged. Limitations: this tool validates structure only; it does not fetch sources, confirm authority identity, verify facts/current law or establish parcel intersections. Empty evidence is unresolved, never no risk. Returns Atlas AI UI and JSON evidence register. Use publisher_kind authority_reported only as a reported classification; never label the result independently verified. Chaining: every response returns site_ref; pass it unchanged into another Atlasly tool to reuse the canonical site, coordinates, boundary confidence, LPA, evidence links, and project context.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address":{"description":"Site address or postcode, with town and country outside the UK. Alternatively pass site_ref from an earlier result; do not send both for different locations.","maxLength":300,"minLength":3,"type":"string"},"coordinates":{"description":"User-supplied WGS84 point {lat, lng}. Send with country_code. The point is not reverse-geocoded, so its address and planning jurisdiction stay unverified.","properties":{"lat":{"maximum":84,"minimum":-80,"type":"number"},"lng":{"maximum":180,"minimum":-180,"type":"number"}},"required":["lat","lng"],"type":"object"},"country_code":{"description":"ISO two-letter country code such as gb, us, in or fr. Required with coordinates and for addresses outside the UK.","pattern":"^[a-z]{2}$","type":"string"},"findings":{"items":{"properties":{"applicability":{"enum":["site_reported","area_context","unknown"],"type":"string"},"finding":{"maxLength":1500,"minLength":1,"type":"string"},"limitation":{"maxLength":1000,"minLength":1,"type":"string"},"source_ids":{"items":{"maxLength":40,"type":"string"},"maxItems":20,"minItems":1,"type":"array"},"topic":{"maxLength":100,"minLength":1,"type":"string"}},"required":["topic","finding","source_ids","applicability","limitation"],"type":"object"},"maxItems":30,"type":"array"},"gaps":{"items":{"maxLength":1000,"minLength":1,"type":"string"},"maxItems":30,"minItems":1,"type":"array"},"question":{"description":"The user's question in their own words. It routes and labels the result; it is not answered as free text.","maxLength":1000,"minLength":3,"type":"string"},"radius_meters":{"description":"Search radius in metres around the site. Requests above the caller's limit (1,000 m without an account, 2,000 m with one) are reduced or rejected.","maximum":1000,"minimum":250,"type":"integer"},"site_ref":{"description":"Canonical site_ref returned by any previous Atlasly tool. Pass it unchanged to chain the same resolved site into this call; address, search_area, or project_id will be filled from it when omitted.","properties":{"address_aliases":{"items":{"maxLength":300,"minLength":1,"type":"string"},"maxItems":4,"type":"array"},"boundary_confidence":{"enum":["address_point","inferred_parcel","red_line_upload","unknown"],"type":"string"},"boundary_id":{"type":["string","null"]},"canonical_address":{"type":["string","null"]},"coordinates":{"anyOf":[{"properties":{"lat":{"type":"number"},"lng":{"type":"number"}},"required":["lat","lng"],"type":"object"},{"type":"null"}]},"country_code":{"pattern":"^[a-z]{2}$","type":"string"},"id":{"type":["string","null"]},"jurisdiction":{"type":["string","null"]},"local_planning_authority":{"type":["string","null"]},"location_source":{"enum":["geocoder","user_coordinates"],"type":"string"},"project_id":{"type":["string","null"]},"source_links":{"items":{"properties":{"label":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["label","url"],"type":"object"},"type":"array"},"status":{"enum":["resolved","partial","unresolved"],"type":"string"},"version":{"const":"1","type":"string"}},"required":["version","status","id","canonical_address","coordinates","boundary_id","boundary_confidence","jurisdiction","local_planning_authority","source_links","project_id"],"type":"object"},"sources":{"items":{"properties":{"accessed_date":{"maxLength":10,"type":"string"},"id":{"pattern":"^[A-Za-z0-9_-]{1,40}$","type":"string"},"published_date":{"maxLength":10,"type":"string"},"publisher":{"maxLength":200,"minLength":1,"type":"string"},"publisher_kind":{"enum":["authority_reported","community","commercial","unknown"],"type":"string"},"title":{"maxLength":300,"minLength":1,"type":"string"},"url":{"maxLength":2000,"minLength":8,"type":"string"}},"required":["id","title","url","publisher","publisher_kind","accessed_date"],"type":"object"},"maxItems":20,"type":"array"}},"required":["question","sources","findings","gaps"],"type":"object"},"name":"present_site_research","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"atlasly_link":{"additionalProperties":false,"properties":{"label":{"type":"string"},"url":{"type":"string"}},"required":["label","url"],"type":"object"},"confidence_notes":{"items":{"type":"string"},"type":"array"},"details":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"error_code":{"type":"string"},"error_source":{"type":"string"},"executive_summary":{"type":"string"},"headline":{"type":"s