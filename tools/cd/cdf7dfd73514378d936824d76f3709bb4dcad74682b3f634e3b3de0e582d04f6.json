{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a person"
 },
 "description": "Update a contact's fields. CAUTION: `tags` REPLACES all tags unless mergeTags is true; `phones` and `emails` REPLACE the full list (send existing ones too). Setting contacted=true pauses action plans. source/sourceUrl cannot be changed after creation. FUB: PUT /v1/people/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addresses": {
    "items": {
     "properties": {
      "city": {
       "type": "string"
      },
      "code": {
       "description": "Postal/ZIP code, as a string.",
       "type": "string"
      },
      "country": {
       "type": "string"
      },
      "state": {
       "description": "Abbreviated state code, e.g. \"CA\".",
       "type": "string"
      },
      "street": {
       "type": "string"
      },
      "type": {
       "description": "e.g. \"home\", \"work\", \"mailing\".",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "assignedLenderId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "assignedLenderName": {
    "type": "string"
   },
   "assignedPondId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "assignedTo": {
    "description": "Full name of the agent.",
    "type": "string"
   },
   "assignedUserId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "background": {
    "description": "Background notes (multi-line).",
    "type": "string"
   },
   "contacted": {
    "type": "boolean"
   },
   "customFields": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "null"
     ]
    },
    "description": "Account custom fields, keyed by their API name (e.g. {\"customBirthday\": \"1990-02-16\"}). See the `name` column of fub_list_custom_fields. null clears a value.",
    "propertyNames": {
     "pattern": "^custom[A-Za-z0-9_]+$",
     "type": "string"
    },
    "type": "object"
   },
   "emails": {
    "items": {
     "properties": {
      "isPrimary": {
       "type": "boolean"
      },
      "type": {
       "description": "e.g. \"home\", \"work\".",
       "type": "string"
      },
      "value": {
       "description": "The email address.",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "firstName": {
    "type": "string"
   },
   "id": {
    "description": "The person id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "lastName": {
    "type": "string"
   },
   "mergeTags": {
    "description": "Merge `tags` into the existing tags instead of replacing them.",
    "type": "boolean"
   },
   "phones": {
    "items": {
     "properties": {
      "isPrimary": {
       "type": "boolean"
      },
      "type": {
       "description": "e.g. \"mobile\", \"home\", \"work\".",
       "type": "string"
      },
      "value": {
       "description": "The phone number, e.g. 888-555-1234.",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "price": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "stage": {
    "description": "Stage name (see fub_list_stages).",
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeframeId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "fub_update_person",
 "title": "Update a person"
}
