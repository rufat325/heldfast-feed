{
 "description": "Compare up to three products on one workload: monthly cost range, chosen plan,\n    capabilities, limits and caveats.",
 "inputSchema": {
  "$defs": {
   "AntiBotLevel": {
    "enum": [
     "low",
     "medium",
     "high",
     "unknown"
    ],
    "title": "AntiBotLevel",
    "type": "string"
   },
   "Workload": {
    "additionalProperties": false,
    "description": "Monthly scraping workload. Unset optional fields fall back to visible assumptions.",
    "properties": {
     "anti_bot_level": {
      "$ref": "#/$defs/AntiBotLevel",
      "default": "unknown"
     },
     "average_browser_seconds": {
      "anyOf": [
       {
        "exclusiveMinimum": 0.0,
        "maximum": 3600.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Average Browser Seconds"
     },
     "average_page_size_kb": {
      "anyOf": [
       {
        "maximum": 102400.0,
        "minimum": 1.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Average Page Size Kb"
     },
     "country_required": {
      "default": true,
      "title": "Country Required",
      "type": "boolean"
     },
     "domain_class": {
      "anyOf": [
       {
        "maxLength": 40,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Target category with special pricing, e.g. 'amazon'.",
      "title": "Domain Class"
     },
     "expected_success_rate": {
      "anyOf": [
       {
        "maximum": 1.0,
        "minimum": 0.5,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Expected Success Rate"
     },
     "javascript_ratio": {
      "anyOf": [
       {
        "maximum": 1.0,
        "minimum": 0.0,
        "type": "number"
       },
       {
        "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
        "type": "string"
       }
      ],
      "default": "0",
      "title": "Javascript Ratio"
     },
     "monthly_billing_only": {
      "default": false,
      "title": "Monthly Billing Only",
      "type": "boolean"
     },
     "peak_concurrency": {
      "default": 10,
      "maximum": 100000,
      "minimum": 1,
      "title": "Peak Concurrency",
      "type": "integer"
     },
     "successful_pages_per_month": {
      "maximum": 1000000000,
      "minimum": 1,
      "title": "Successful Pages Per Month",
      "type": "integer"
     },
     "target_country": {
      "anyOf": [
       {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target Country"
     }
    },
    "required": [
     "successful_pages_per_month"
    ],
    "title": "Workload",
    "type": "object"
   }
  },
  "properties": {
   "products": {
    "description": "Up to 3 as \"provider/product\"",
    "items": {
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "title": "Products",
    "type": "array"
   },
   "workload": {
    "$ref": "#/$defs/Workload"
   }
  },
  "required": [
   "products",
   "workload"
  ],
  "title": "compare_productsArguments",
  "type": "object"
 },
 "name": "compare_products",
 "outputSchema": {
  "additionalProperties": true,
  "title": "compare_productsDictOutput",
  "type": "object"
 }
}
