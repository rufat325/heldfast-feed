{
 "description": "Create a new work item in Karbon. WorkType and status values are tenant-specific \u2014 call get_tenant_settings first if unsure.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "AssigneeEmailAddress": {
    "description": "Email address of the Karbon user assigned to this work",
    "type": "string"
   },
   "ClientKey": {
    "description": "Key of the client this work is for (ContactKey, OrganizationKey, or ClientGroupKey)",
    "type": "string"
   },
   "ClientType": {
    "enum": [
     "Contact",
     "Organization",
     "ClientGroup"
    ],
    "type": "string"
   },
   "DeadlineDate": {
    "type": "string"
   },
   "Description": {
    "type": "string"
   },
   "DueDate": {
    "description": "ISO 8601 date or date-time",
    "type": "string"
   },
   "EstimatedBudget": {
    "type": "number"
   },
   "PrimaryStatus": {
    "enum": [
     "Planned",
     "ReadyToStart",
     "InProgress",
     "Waiting",
     "Completed"
    ],
    "type": "string"
   },
   "SecondaryStatus": {
    "description": "Tenant-specific status label from get_tenant_settings",
    "type": "string"
   },
   "StartDate": {
    "description": "ISO 8601 date or date-time, e.g. 2026-08-01",
    "type": "string"
   },
   "Title": {
    "maxLength": 200,
    "type": "string"
   },
   "WorkTemplateKey": {
    "description": "Create from a work template (see list_work_templates)",
    "type": "string"
   },
   "WorkType": {
    "description": "Tenant-specific work type label, e.g. 'Tax Return'",
    "type": "string"
   }
  },
  "required": [
   "Title",
   "ClientKey",
   "ClientType",
   "AssigneeEmailAddress",
   "StartDate"
  ],
  "type": "object"
 },
 "name": "create_work_item",
 "title": "Create work item"
}
