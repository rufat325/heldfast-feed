  "title": "Reserved Instance Breakeven Calculator"
 },
 "description": "Use this when a user asks whether to buy Reserved Instances or stay on On-Demand, or how long an RI takes to pay for itself. Takes On-Demand and RI monthly costs plus optional upfront fees (0 when omitted). Judges the 1-year and 3-year terms separately and returns each break-even month and net saving. It recommends a term only when that term saves money over its own length, and prefers 3 years only when it beats three 1-year terms over 36 months at current prices.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "od_monthly": {
    "description": "On-Demand cost per month in USD.",
    "examples": [
     450
    ],
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "ri_1yr_monthly": {
    "description": "1-year Reserved Instance cost per month in USD, excluding the upfront fee.",
    "examples": [
     280
    ],
    "minimum": 0,
    "type": "number"
   },
   "ri_1yr_upfront": {
    "description": "1-year upfront fee in USD; 0 when omitted (no-upfront RI).",
    "examples": [
     0
    ],
    "minimum": 0,
    "type": "number"
   },
   "ri_3yr_monthly": {
    "description": "3-year Reserved Instance cost per month in USD, excluding the upfront fee.",
    "examples": [
     180
    ],
    "minimum": 0,
    "type": "number"
   },
   "ri_3yr_upfront": {
    "description": "3-year upfront fee in USD; 0 when omitted (no-upfront RI).",
    "examples": [
     0
    ],
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
