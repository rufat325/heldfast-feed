 "_meta": {
  "openai/outputTemplate": "ui://sendit/widget/upload-session.html",
  "openai/toolInvocation/invoked": "Upload status retrieved",
  "openai/toolInvocation/invoking": "Checking upload status...",
  "openai/widgetAccessible": true,
