{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add one or more test steps to a specific version of a test case. Each step has stepDetails (required), expectedResult, and testData. Returns the created step objects with their IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Test case ID",
    "type": [
     "string",
     "number"
    ]
   },
   "steps": {
    "description": "Steps to create",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expectedResult": {
       "type": "string"
      },
      "stepDetails": {
       "description": "Step action/description",
       "type": "string"
      },
      "testData": {
       "type": "string"
      }
     },
     "required": [
      "stepDetails"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "versionNo": {
    "description": "Test case version number",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "versionNo",
   "steps"
  ],
  "type": "object"
 },
 "name": "qtm4j_create_test_steps",
 "title": "Create Test Steps"
}
