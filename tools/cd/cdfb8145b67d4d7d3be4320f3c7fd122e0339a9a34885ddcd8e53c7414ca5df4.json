{
 "description": "Download a licensed dataset export you own (open-label:read): the deterministic fingerprinted export in json, hf-jsonl, csv, or parquet. Canary rows ride every format (leak tracing survives), and manifestSha256 verifies the per-row hashes. Content returns base64-encoded \u2014 decode and write to disk.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "json",
     "hf-jsonl",
     "csv",
     "parquet"
    ],
    "type": "string"
   },
   "licenseId": {
    "type": "string"
   }
  },
  "required": [
   "licenseId"
  ],
  "type": "object"
 },
 "name": "opentrain_download_dataset_export",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "contentBase64": {
    "type": "string"
   },
   "contentType": {
    "type": "string"
   },
   "manifestSha256": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "apiBaseUrl",
   "contentType",
   "manifestSha256",
   "contentBase64"
  ],
  "type": "object"
 }
}
