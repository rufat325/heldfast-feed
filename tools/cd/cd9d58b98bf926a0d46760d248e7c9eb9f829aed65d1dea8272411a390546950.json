{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List Config Groups for CDSS (Kafka configuration templates) for a given Kafka version",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kafkaVersionCode": {
    "description": "Kafka version code (from ncloud_cdss_get_kafka_versions)",
    "type": "number"
   },
   "pageNo": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size (default: 10)",
    "type": "number"
   }
  },
  "required": [
