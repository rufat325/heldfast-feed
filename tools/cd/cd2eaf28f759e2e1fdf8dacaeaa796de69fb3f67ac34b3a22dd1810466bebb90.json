{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Quick turnover estimate (start here)"
 },
 "description": "Estimates what it costs to turn over a US rental unit after move-out; the first tool for a turnover estimate. Inputs: a 5-digit ZIP, bedrooms, bathrooms and the issues in plain English (e.g. \"stained carpet in both bedrooms\"), which may come from the user's photos; optional unit type, size, year built. Returns a priced make-ready estimate: repair tasks by trade with low/expected/high costs for the ZIP, priorities, refer-outs to licensed professionals, assumptions and links. Issues the matcher cannot place are read by an AI model; the answer is then a draft that lists what was read (reading). Not for: diagnosing hazards, legal advice on deposits, remodel bids, properties outside the US.\nThe same findings under the same ruleset give the same result; AI never sets a number.",
 "inputSchema": {
  "$defs": {
   "PriceTier": {
    "description": "Purchasing channel. Library prices are pm_vendor (a PM buying turns from a local vendor).",
    "enum": [
     "bulk_contract",
     "pm_vendor",
     "retail_one_off"
    ],
    "type": "string"
   },
   "Profile": {
    "enum": [
     "minimum",
     "standard",
     "premium"
    ],
    "type": "string"
   },
   "UnitType": {
    "enum": [
     "apartment",
     "single_family",
     "townhome",
     "condo",
     "duplex",
     "manufactured"
    ],
    "type": "string"
   }
  },
  "examples": [
   {
    "bathrooms": 1,
    "bedrooms": 2,
    "issues": [
     "stained carpet in both bedrooms",
     "nail holes everywhere",
     "oven is filthy"
    ],
    "zip": "43215"
   }
  ],
  "properties": {
   "audit": {
    "default": false,
    "description": "Also return the run record and input/result hashes (an audit trail). Default false.",
    "type": "boolean"
   },
   "bathrooms": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
      "type": "string"
     }
    ],
    "description": "Half baths count as 0.5."
   },
   "bedrooms": {
    "description": "0 for a studio.",
    "type": "integer"
   },
   "carpet": {
    "description": "Is there wall-to-wall carpet?",
    "type": "boolean"
   },
   "client_refs": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Your own reference ids (e.g. unit_id, job_id). Echoed back, never used.",
    "type": "object"
   },
   "detail": {
    "default": "summary",
    "description": "summary (default, small) or full (every line).",
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "expect_ruleset": {
    "description": "Optional. The ruleset version you built against, as results carry it in provenance.ruleset_version (e.g. 'sd-2026.11.14'), or its sha256: hash. If the rules have changed since, the call fails (nothing computed, nothing charged) and says what is in force now, so you upgrade on your own schedule. Leave it out to answer under the current rules.",
    "type": "string"
   },
   "issues": {
    "description": "What was found in plain English, e.g. ['stained carpet in both bedrooms', 'nail holes everywhere', 'oven is filthy']. Read like pasted notes: an entry may hold several conditions ('carpet stained, nail holes'; one finding each); a room before or after the condition sets the location ('Bedroom 2 carpet torn', 'mold in bathroom'); a written count sets the quantity ('3 blinds broken'); an entry saying there is no work ('no mold', 'leak fixed by tenant') is reported as not billed.",
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "price_tier": {
    "$ref": "#/$defs/PriceTier",
    "default": "pm_vendor",
    "description": "bulk_contract (portfolio contract prices) | pm_vendor (default: a property manager buying turns from local vendors) | retail_one_off (an owner hiring one contractor).",
    "type": "string"
   },
   "profile": {
    "$ref": "#/$defs/Profile",
    "default": "standard",
    "description": "minimum (rent-ready basics) | standard | premium (higher finish).",
    "type": "string"
   },
   "retain": {
    "default": true,
    "description": "Optional (contract 0.5.1). false: keep none of this request's text, so the AI reader's answer for the issues is not stored either. By default the text is kept with contact details and access codes removed, to improve matching; the estimate is the same either way.",
    "type": "boolean"
   },
   "serve_pinned": {
    "default": false,
    "description": "Optional, with expect_ruleset. True asks us to answer under the ruleset version you named even when the rules have changed since, from that version's signed bundle; the result says so in served_from_bundle. We refuse a version older than 12 months, one a later correction or law change replaced for your state, or one we have no bundle for. Default false: the call fails whenever the rules have changed.",
    "type": "boolean"
   },
   "sq_ft": {
    "description": "Interior sq ft.",
    "maximum": 20000,
    "minimum": 150,
    "type": "integer"
   },
   "unit_type": {
    "$ref": "#/$defs/UnitType",
    "default": "apartment",
    "description": "Single-family homes and townhomes get house-sized defaults (floor area, locks).",
    "type": "string"
   },
   "year_built": {
    "description": "Drives lead-paint (pre-1978) handling.",
    "maximum": 2100,
    "minimum": 1700,
    "type": "integer"
   },
   "zip": {
    "description": "The user's 5-digit US ZIP code. If it is missing or not exactly 5 digits, ask the user; never guess, pad or correct it.",
    "type": "string"
   }
  },
  "required": [
   "zip",
   "bedrooms",
   "bathrooms"
  ],
  "type": "object"
 },
