    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "readOnlyHint": true,
  "title": "Assert My Life Experiences"
 },
 "description": "Record what a person says they have done outside school and work (family, clubs, sports, faith, travel, self-taught projects, challenges) in their evidence package, each placed in a Selfie dimension by the KSA classifier or left unresolved, never defaulted. These are the person's own statements, kept apart from formal education. Nothing is stored: the answer returns the package for the agent to keep.",
 "inputSchema": {
  "properties": {
   "entries": {
    "description": "1 to 20 life experiences",
    "items": {
     "properties": {
      "activity": {
       "description": "What the person did, in their words",
       "type": "string"
      },
      "category": {
       "enum": [
        "passions",
        "sports",
        "clubs",
        "faith",
        "family",
        "selftaught",
        "travel",
        "challenges",
        "other"
       ],
       "type": "string"
      },
      "difficulty": {
       "enum": [
        "remember",
        "understand",
        "apply",
        "analyze",
        "evaluate",
        "create"
       ],
       "type": "string"
      },
      "elaboration": {
       "type": "string"
      },
      "life_period": {
       "enum": [
        "childhood",
        "adolescence",
        "emerging_adult",
        "early_adult",
        "midlife",
        "experienced",
        "later_life"
       ],
       "type": "string"
      },
      "weight": {
       "enum": [
        "occasional",
        "regular",
        "central"
       ],
       "type": "string"
      }
     },
     "required": [
      "category",
      "activity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "package": {
    "description": "The goldribbon_package_v1 object an earlier GoldRibbon answer returned. Keep it for the person and send it back whole; GoldSeam keeps no copy.",
    "type": "object"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
 "name": "assert_my_life_experiences",
 "outputSchema": {
  "properties": {
   "contract": {
    "type": "string"
   },
   "counts": {
    "description": "entries, added, unresolved",
    "type": "object"
   },
   "entries": {
    "description": "Each entry with its dimension, placement, facets and placed_by",
    "type": "array"
   },
   "limits": {
    "description": "What this answer could not do, each { code, statement }",
    "type": "array"
   },
   "next_actions": {
    "items": {
     "properties": {
      "arguments": {
       "type": "object"
      },
      "label": {
       "type": "string"
      },
      "tool": {
       "description": "A GoldSeam service",
       "type": "string"
      }
     },
     "required": [
      "label",
      "tool",
      "arguments"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "package": {
    "description": "The person's package, with this service's part filled",
    "type": "object"
   },
   "statement": {
    "type": "string"
   }
  },
  "required": [
   "contract",
   "statement"
  ],
  "type": "object"
 },
 "title": "Assert My Life Experiences"
}
