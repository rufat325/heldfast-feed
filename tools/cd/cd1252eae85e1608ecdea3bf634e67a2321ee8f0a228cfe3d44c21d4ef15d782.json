{
 "description": "Accept extracted strings, push them to i1n, translate to all active languages, and pull updated types. Pass an array of {key, value, namespace?} objects.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "languages": {
    "description": "Optional comma-separated target language codes. If omitted, translates to all active languages.",
    "maxLength": 500,
    "type": "string"
   },
   "strings": {
    "description": "Array of strings to extract and translate",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "description": "Translation key (e.g. 'common.greeting')",
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "namespace": {
       "description": "Optional namespace (defaults to 'default')",
       "maxLength": 200,
       "type": "string"
      },
      "value": {
       "description": "Source language value (e.g. 'Hello, world!')",
       "maxLength": 50000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "strings"
  ],
  "type": "object"
 },
 "name": "i1n_extract_and_translate"
}
