{
 "description": "PageSpeed Insights score + Core Web Vitals for a site's homepage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "site slug (from list_sites)",
    "type": "string"
   },
   "strategy": {
    "description": "mobile (default) or desktop",
    "enum": [
     "mobile",
     "desktop"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "speed"
}
