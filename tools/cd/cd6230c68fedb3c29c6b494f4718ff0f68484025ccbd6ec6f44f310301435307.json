{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a booking"
 },
 "description": "Change an existing booking: dates, room/unit, guest counts, guest details, notes, flag, price, or status (e.g. confirmed, or cancelled to cancel \u2014 reversible by setting it back). Only the fields you pass change. Optionally add info items (code/text pairs). Changes sync to channels where allowed. Beds24: POST /bookings with the booking id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addInfoItems": {
    "description": "Info items to ADD to the booking (existing ones are untouched).",
    "items": {
     "properties": {
      "code": {
       "minLength": 1,
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "address": {
    "type": "string"
   },
   "arrival": {
    "description": "Arrival date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "arrivalTime": {
    "description": "Expected arrival time (free text).",
    "type": "string"
   },
   "bookingId": {
    "description": "The booking id to change.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "city": {
    "type": "string"
   },
   "comments": {
    "description": "Guest comments.",
    "type": "string"
   },
   "company": {
    "type": "string"
   },
   "country": {
    "description": "Free text country.",
    "type": "string"
   },
   "country2": {
    "description": "2-letter country code, e.g. DE.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "departure": {
    "description": "Departure (check-out) date, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "deposit": {
    "type": "number"
   },
   "email": {
    "type": "string"
   },
   "firstName": {
    "type": "string"
   },
   "flagColor": {
    "description": "Flag colour, 6-character hex (e.g. ff0000) or empty string to clear.",
    "pattern": "^([0-9a-fA-F]{6})?$",
    "type": "string"
   },
   "flagText": {
    "type": "string"
   },
   "lang": {
    "description": "Guest language, 2-letter code, e.g. en.",
    "type": "string"
   },
   "lastName": {
    "type": "string"
   },
   "mobile": {
    "type": "string"
   },
   "notes": {
    "description": "Internal host notes.",
    "type": "string"
   },
   "notifyGuest": {
    "description": "Email the guest an updated confirmation.",
    "type": "boolean"
   },
   "numAdult": {
    "description": "Number of adults.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "numChild": {
    "description": "Number of children.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "phone": {
    "type": "string"
   },
   "postcode": {
    "type": "string"
   },
   "price": {
    "description": "Total booking price.",
    "type": "number"
   },
   "reference": {
    "description": "Your own reference.",
    "maxLength": 100,
    "type": "string"
   },
   "roomId": {
    "description": "Room (room type) id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "state": {
    "type": "string"
   },
   "status": {
    "description": "Booking status.",
    "enum": [
     "confirmed",
     "request",
     "new",
     "cancelled",
     "black",
     "inquiry"
    ],
    "type": "string"
   },
   "tax": {
    "type": "number"
   },
   "title": {
    "description": "Guest title, e.g. Mr, Ms.",
    "type": "string"
   },
   "unitId": {
    "description": "Specific unit within the room type.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "bookingId"
  ],
  "type": "object"
 },
 "name": "beds24_update_booking",
 "title": "Update a booking"
}
