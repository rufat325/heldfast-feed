{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.feed-page-compare",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare supplied feed identity, price, currency and availability with selected JSON-LD product evidence; preserve conflicts and unknown fields. Optional availabilityProfile google_merchant applies Google feed mappings; generic is the default. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "availabilityProfile": {
      "description": "Default generic preserves existing vocabulary distinctions. google_merchant maps non-vehicle Schema.org availability to Google feed categories; not an eligibility check.",
      "enum": [
       "generic",
       "google_merchant"
      ],
      "type": "string"
     },
     "feed": {
      "additionalProperties": false,
      "properties": {
       "availability": {
        "maxLength": 100,
        "type": "string"
       },
       "currency": {
        "pattern": "^[A-Z]{3}$",
        "type": "string"
       },
       "gtin": {
        "pattern": "^\\d{8,14}$",
        "type": "string"
       },
       "mpn": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "price": {
        "maxLength": 30,
        "type": "string"
       },
       "sku": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [],
      "type": "object"
     },
     "html": {
      "maxLength": 100000,
      "type": "string"
     },
     "offerUrl": {
      "maxLength": 2048,
      "type": "string"
     },
     "pageUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "html",
     "feed"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "commerce_feed_page_compare",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "availabilityProfile": {
    "enum": [
     "generic",
     "google_merchant"
    ],
    "type": "string"
   },
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "feedValue": {
       "type": [
        "string",
        "null"
       ]
      },
      "field": {
       "type": "string"
      },
      "pageValues": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "reason": {
       "type": "string"
      },
      "status": {
       "enum": [
        "match",
        "mismatch",
        "ambiguous",
        "unknown",
        "not_supplied"
       ],
       "type": "string"
      }
     },
     "required": [
      "field",
      "feedValue",
      "pageValues",
      "status",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "evidence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "offerSources": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "offerBlock": {
           "type": "number"
          },
          "offerPointer": {
           "type": "string"
          },
          "productBlock": {
           "type": "number"
          },
          "productPointer": {
           "type": "string"
          }
         },
         "required": [
          "productBlock",
          "productPointer",
          "offerBlock",
          "offerPointer"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "originalAvailability": {
        "items": {
         "type": [
          "string",
          "null"
         ]
        },
        "type": "array"
       },
       "productSources": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "block": {
           "type": "number"
          },
          "pointer": {
           "type": "string"
          }
         },
         "required": [
          "block",
          "pointer"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "productSources",
       "offerSources",
       "originalAvailability"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "identityStatus": {
    "enum": [
     "match",
     "mismatch",
     "unknown"
    ],
    "type": "string"
   },
   "scope": {
    "type": "string"
   },
   "selection": {
    "additionalProperties": false,
    "properties": {
     "reason": {
      "type": "string"
     },
     "selectedId": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "enum": [
       "selected",
       "ambiguous",
       "no_product"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "reason",
     "selectedId"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "match",
     "mismatch",
     "identity_mismatch",
     "inconclusive"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "status",
   "identityStatus",
   "availabilityProfile",
   "selection",
   "checks",
   "evidence",
   "warnings",
   "scope"
  ],
  "type": "object"
 }
}
