 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Shipmail resource ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "shipmail_rotate_webhook_secret",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "previous_secret_expires_at": {
    "type": "string"
   },
   "secret": {
    "type": "string"
   }
  },
  "required": [
   "secret",
   "previous_secret_expires_at"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Rotate Webhook Secret"
}
