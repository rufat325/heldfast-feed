{
 "description": "Update an existing plan. Endpoint: PUT /plans/:id",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "Plan ID",
    "type": "string"
   },
   "interval": {
    "type": "number"
   },
   "interval_type": {
    "enum": [
     "weeks",
     "months"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "payable_with": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "value_cents": {
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_plan"
}
