{"_meta":{"xdata.kr/credential":{"providers":[],"register_url":null,"required":false,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\uace0\uac1d\uc774 \uc785\ub825\ud55c \uad11\uace0\ube44, \ub9e4\ucd9c, \uc2e0\uaddc \uc720\ub8cc \uace0\uac1d \uc218, \uae30\uc5ec\uc774\uc775\uc73c\ub85c ROAS(\uad11\uace0\ube44 \ub300\ube44 \ub9e4\ucd9c), \ub9c8\ucf00\ud305 ROI(\ud3ec\ud568 \ube44\uc6a9 \ub300\ube44 \uae30\uc5ec\uc774\uc775), CAC(\uc2e0\uaddc \uc720\ub8cc \uace0\uac1d 1\uba85\ub2f9 \uad11\uace0\ube44)\ub97c \uacc4\uc0b0\ud569\ub2c8\ub2e4. \ud544\uc218 \uc785\ub825\uc740 \ubcf4\uace0 \uae30\uac04\uacfc \uad11\uace0\ube44\ubfd0\uc774\uace0, \ub098\uba38\uc9c0\ub294 \ub123\uc740 \ub9cc\ud07c \uacc4\uc0b0\ud558\uba70 \uc5c6\ub294 \uc9c0\ud45c\ub294 \uac12 \ub300\uc2e0 \uc0ac\uc720\ub97c \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uc785\ub825\ud55c \uc22b\uc790\ub85c \uacc4\uc0b0\ub9cc \ud558\uace0 \ub9e4\ucd9c \uc6d0\uc7a5\uc744 \ubcf4\uad00\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc678\ubd80 \uae30\uad00\uc774\ub098 \uad11\uace0 \uacc4\uc815\uc744 \ubd80\ub974\uc9c0 \uc54a\uc73c\uba70 \ub85c\uadf8\uc778\uc774\ub098 \uc5f0\ub3d9\uc774 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"ad_cost":{"description":"\ubcf4\uace0 \uae30\uac04 \uad11\uace0\ube44(ROAS \ubd84\ubaa8, CAC \ubd84\uc790)","properties":{"amount_minor":{"description":"\ucd5c\uc18c \ub2e8\uc704 \uc815\uc218 \uae08\uc561(\uc6d0\ud654\ub294 \uc6d0 \ub2e8\uc704)","type":"integer"},"currency":{"description":"\ud1b5\ud654 \ucf54\ub4dc(ISO 4217, \uc608: KRW)","minLength":1,"type":"string"}},"required":["currency","amount_minor"],"type":"object"},"contribution_profit":{"description":"\uace0\uac1d\uc774 \uc815\uc758\ud55c \uae30\uc5ec\uc774\uc775(\ub9c8\ucf00\ud305 ROI \ubd84\uc790)","properties":{"amount_minor":{"description":"\ucd5c\uc18c \ub2e8\uc704 \uc815\uc218 \uae08\uc561(\uc6d0\ud654\ub294 \uc6d0 \ub2e8\uc704)","type":"integer"},"currency":{"description":"\ud1b5\ud654 \ucf54\ub4dc(ISO 4217, \uc608: KRW)","minLength":1,"type":"string"}},"required":["currency","amount_minor"],"type":"object"},"customer_revenue":{"description":"\uace0\uac1d\uc774 \uc9c1\uc811 \ub123\ub294 \ub9e4\ucd9c. \uae30\uac04\uacfc \ud1b5\ud654\uac00 \ubcf4\uace0\uc640 \ub2e4\ub974\uba74 \ub9e4\ucd9c \uc9c0\ud45c\ub294 \uac12 \ub300\uc2e0 \uc0ac\uc720\ub97c \ub3cc\ub824\uc900\ub2e4","properties":{"amount_minor":{"description":"\ucd5c\uc18c \ub2e8\uc704 \uc815\uc218 \uae08\uc561(\uc6d0\ud654\ub294 \uc6d0 \ub2e8\uc704)",