{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Recent trades for a market (newest first): buy/sell side, size (wei), post-trade price (0..1), and the trader wallet.",
 "inputSchema": {
  "$defs": {
   "EvmAddress": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "properties": {
   "address": {
    "$ref": "#/$defs/EvmAddress",
    "description": "Market contract address."
   },
   "chainId": {
    "description": "Chain id; probes enabled chains if omitted.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "problee_get_market_trades",
 "outputSchema": {
  "$defs": {
   "DiscoverMarketTradesResponse": {
    "additionalProperties": false,
    "properties": {
     "trades": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "$ref": "#/$defs/WeiString"
        },
        "id": {
         "type": "string"
        },
        "price": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "publicationState": {
         "anyOf": [
          {
           "enum": [
            "pending",
            "published",
            "finalized"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "side": {
         "type": "string"
        },
        "timestamp": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "trader": {
         "$ref": "#/$defs/EvmAddress"
        },
        "txHash": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "txHash",
        "timestamp",
        "side",
        "trader",
        "amount",
        "price"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "trades"
    ],
    "type": "object"
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "WeiString": {
    "pattern": "^\\d+$",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverMarketTradesResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Recent trades for a market (newest first)"
}
