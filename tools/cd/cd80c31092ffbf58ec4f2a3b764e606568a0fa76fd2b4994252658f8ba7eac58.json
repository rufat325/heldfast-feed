{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "This listing's requirements vs. the renter, line by line"
 },
 "description": "For one listing URL from search_listings: what the landlord requires, what the renter filled in, and the gap on each line \u2014 income, credit, SSN, deposit, pets, co-signer, documents. Each line carries the landlord's own sentence it was read from, plus where the rule came from and when we fetched it. Requires the renter's own PutRoots account (the comparison is against qualifications they filled in). It returns no overall verdict, by design.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "listing_url": {
    "description": "The listing's url, exactly as returned by search_listings.",
    "type": "string"
   }
  },
  "required": [
   "listing_url"
  ],
  "type": "object"
 },
 "name": "listing_requirements",
