       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "required": {
       "description": "What the landlord wrote (null = not stated).",
       "type": [
        "string",
        "null"
       ]
      },
      "src": {
       "description": "The landlord's own sentence this line was read from.",
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "enum": [
        "meets",
        "info",
        "gap",
        "unknown_user",
        "unknown_landlord"
       ],
       "type": "string"
      },
      "yours": {
       "description": "What the renter filled in (null = not filled in).",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "key",
      "label",
      "status",
      "required",
      "yours",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "listing": {
