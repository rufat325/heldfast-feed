{
 "description": "Return one Answer contract v0 record with citations for a known slug. Never fabricates content for unknown slugs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Answer slug from answers/index.json.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_answer",
 "outputSchema": {
  "properties": {
   "answer": {
    "type": "string"
   },
   "citations": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "code": {
    "enum": [
     "not_found"
    ],
    "type": "string"
   },
   "home": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "question": {
    "type": "string"
   },
   "shortAnswer": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "id",
   "slug",
   "question",
   "answer",
   "citations",
   "url"
  ],
  "type": "object"
 }
}
