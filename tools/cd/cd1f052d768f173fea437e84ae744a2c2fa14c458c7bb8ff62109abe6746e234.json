{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Best Price by EAN"
 },
 "description": "Look up a single product by its EAN barcode and return the price at every shop that carries it, sorted cheapest-first, with stock status and direct purchase links.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "default": "DE",
    "description": "Country for pricing (DE or AT, default DE)",
    "enum": [
     "DE",
     "AT"
    ],
    "type": "string"
   },
   "ean": {
    "description": "EAN barcode (8\u201314 digits, e.g. '4524667749493')",
    "pattern": "^\\d{8,14}$",
    "type": "string"
   },
   "reference_shop": {
    "description": "Shop id or display name to compare against. When set, the response states how much cheaper the cheapest shop is vs. this shop.",
    "type": "string"
   }
  },
  "required": [
   "ean"
  ],
  "type": "object"
 },
 "name": "get_best_price",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cheapest_price": {
    "type": "number"
   },
   "cheapest_shop": {
    "type": "string"
   },
   "disclosure": {
    "type": "string"
   },
   "ean": {
    "type": "string"
   },
   "next_step": {
    "additionalProperties": false,
    "properties": {
     "eans": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "hint": {
      "type": "string"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool",
     "hint"
    ],
    "type": "object"
   },
   "prices": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affiliate_url": {
       "description": "Direct link to buy at this shop. Always show this URL to the user.",
       "type": "string"
      },
      "availability": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "shop": {
       "type": "string"
      }
     },
     "required": [
      "shop",
      "price",
      "currency",
      "affiliate_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "product_name": {
    "type": "string"
   },
   "reference_comparison": {
    "additionalProperties": false,
    "properties": {
     "reference_price": {
      "type": "number"
     },
     "reference_shop": {
      "type": "string"
     },
     "saving": {
      "type": "number"
     },
     "saving_percent": {
      "type": "number"
     }
    },
    "required": [
     "reference_shop",
     "reference_price",
     "saving"
    ],
    "type": "object"
   }
  },
  "required": [
   "ean",
   "product_name",
   "prices",
   "cheapest_shop",
   "cheapest_price"
  ],
  "type": "object"
 },
 "title": "Get Best Price by EAN"
}
