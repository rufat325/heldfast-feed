{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants an overview of a US car, such as \"give me a report on a 2016 Honda Civic\". Pass a VIN, or the year, make and model. Returns NHTSA 5-star crash ratings per variant, the number of recalls and the newest ones, the number of owner complaints with the components named most often, and EPA fuel economy. Complaint texts and VIN fragments are never returned; complaints are not confirmed defects. Not a valuation, history report or advice.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "make": {
    "description": "Manufacturer, such as \"Honda\"",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "description": "Model name without trim, such as \"CR-V\"",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "vin": {
    "description": "Instead of year, make and model: a 17-character VIN, decoded first",
    "pattern": "^[A-HJ-NPR-Za-hj-npr-z0-9]{17}$",
    "type": "string"
   },
   "year": {
    "description": "Model year, such as 2018",
    "maximum": 2100,
    "minimum": 1950,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_vehicle_report",
 "outputSchema": {
  "properties": {
   "complaints": {
    "properties": {
     "count": {
      "type": "integer"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "not_found",
       "unavailable"
      ],
      "type": "string"
     },
     "top_components": {
      "items": {
       "properties": {
        "component": {
         "type": "string"
        },
        "count": {
         "type": "integer"
        }
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "fuel_economy": {
    "properties": {
     "available": {
      "type": "integer"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "not_found",
       "unavailable"
      ],
      "type": "string"
     },
     "variants": {
      "items": {
       "properties": {
        "annual_fuel_cost_usd": {
         "type": [
          "number",
          "null"
         ]
        },
        "co2_tailpipe_g_per_mile": {
         "type": [
          "number",
          "null"
         ]
        },
        "efficiency": {
         "properties": {
          "city": {
           "type": [
            "number",
            "null"
           ]
          },
          "combined": {
           "type": [
            "number",
            "null"
           ]
          },
          "highway": {
           "type": [
            "number",
            "null"
           ]
          },
          "unit": {
           "enum": [
            "mpg",
            "mpge"
           ],
           "type": "string"
          }
         },
         "type": "object"
        },
        "ev_range_miles": {
         "type": [
          "number",
          "null"
         ]
        },
        "fuel": {
         "type": [
          "string",
          "null"
         ]
        },
        "kwh_per_100_miles": {
         "type": [
          "number",
          "null"
         ]
        },
        "transmission": {
         "type": [
          "string",
          "null"
         ]
        },
        "variant": {
         "type": "string"
        },
        "vehicle_class": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "recalls": {
    "properties": {
     "message": {
      "type": "string"
     },
     "newest": {
      "items": {
       "properties": {
        "campaign": {
         "type": "string"
        },
        "component": {
         "type": [
          "string",
          "null"
         ]
        },
        "date": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "status": {
      "enum": [
       "ok",
       "not_found",
       "unavailable"
      ],
      "type": "string"
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "safety_ratings": {
    "properties": {
     "message": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "not_found",
       "unavailable"
      ],
      "type": "string"
     },
     "variants": {
      "items": {
       "properties": {
        "front_crash": {
         "type": [
          "string",
          "null"
         ]
        },
        "overall": {
         "type": [
          "string",
          "null"
         ]
        },
        "rollover": {
         "type": [
          "string",
          "null"
         ]
        },
        "side_crash": {
         "type": [
          "string",
          "null"
         ]
        },
        "variant": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "invalid",
     "not_found",
     "unavailable"
    ],
    "type": "string"
   },
   "vehicle": {
    "properties": {
     "decoded_from_vin": {
      "type": "boolean"
     },
     "make": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "trim": {
      "type": [
       "string",
       "null"
      ]
     },
     "year": {
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "status",
   "notice"
  ],
  "type": "object"
 },
 "title": "Get a vehicle report"
}
