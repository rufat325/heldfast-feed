{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Remove dates"
 },
 "description": "Takes dates off a draft (a draft_ id) or a live event, by ISO day. On a live event any votes on that day go with it, the confirmed date can't be removed, and at least one date must remain; a draft may be emptied (send_invites refuses a dateless draft). Never mails anyone. Needs the write permission.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dates": {
    "description": "The ISO day(s) to remove",
    "items": {
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "maxItems": 300,
    "minItems": 1,
    "type": "array"
   },
   "event_id": {
    "description": "A draft_ id, or a live event id",
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "dates"
  ],
  "type": "object"
 },
 "name": "remove_dates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_count": {
    "type": "number"
   },
   "ok": {
    "type": "boolean"
   },
   "removed": {
    "type": "number"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Remove dates"
}
