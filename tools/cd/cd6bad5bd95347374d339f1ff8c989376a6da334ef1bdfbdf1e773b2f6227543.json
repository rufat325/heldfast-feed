{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Not available"
 },
 "description": "Not available: every report is free; use create_free_report. This tool stays in the contract for compatibility and answers NOT_FOR_SALE without creating anything.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "acceptTerms": {
    "const": true,
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "type": "boolean"
   },
   "consent": {
    "const": true,
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "type": "boolean"
   },
   "consentStatementSha256": {
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "email": {
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "maxLength": 254,
    "minLength": 6,
    "pattern": "^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$",
    "type": "string"
   },
   "freeReport": {
    "additionalProperties": false,
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "properties": {
     "jobId": {
      "pattern": "^scr_[A-Za-z0-9_-]{22}$",
      "type": "string"
     },
     "statusToken": {
      "pattern": "^[A-Za-z0-9_-]{43}\\.[A-Za-z0-9_-]{43}$",
      "type": "string"
     }
    },
    "required": [
     "jobId",
     "statusToken"
    ],
    "type": "object"
   },
   "language": {
    "default": "es",
    "description": "Language of the texts in the answer (and of the report): es, en, de, nl or fr. Default es.",
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "resolutionToken": {
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "termsVersion": {
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "maxLength": 16,
    "minLength": 1,
    "type": "string"
   },
   "tier": {
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "enum": [
     "simple",
     "complete"
    ],
    "type": "string"
   },
   "waiveWithdrawalRight": {
    "const": true,
    "description": "Kept for compatibility with contract 1.1.0; not used while every report is free (purchase_report answers NOT_FOR_SALE).",
    "type": "boolean"
   }
  },
  "required": [
   "tier",
   "email",
   "consent",
   "consentStatementSha256",
   "termsVersion",
   "acceptTerms",
   "waiveWithdrawalRight"
  ],
  "type": "object"
 },
 "name": "purchase_report",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentContractingTermsUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "checkoutExpiresAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
   "checkoutUrl": {
    "maxLength": 2048,
    "pattern": "^https:\\/\\/checkout\\.stripe\\.com\\/\\S+$",
    "type": "string"
   },
   "contract": {
    "const": "agent-api-1.2.0",
    "type": "string"
   },
   "currency": {
    "const": "EUR",
    "type": "string"
   },
   "jobId": {
    "pattern": "^scr_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "language": {
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "notice": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "orderId": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$",
    "type": "string"
   },
   "pollAfterSeconds": {
    "maximum": 600,
    "minimum": 1,
    "type": "integer"
   },
   "price": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "priceCents": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "reportUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "status": {
    "const": "awaiting_payment",
    "type": "string"
   },
   "statusToken": {
    "pattern": "^[A-Za-z0-9_-]{43}\\.[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "termsVersion": {
    "maxLength": 16,
    "minLength": 1,
    "type": "string"
   },
   "tier": {
    "enum": [
     "simple",
     "complete"
    ],
    "type": "string"
   },
   "vatIncluded": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "contract",
   "language",
   "orderId",
   "status",
   "tier",
   "name",
   "priceCents",
   "price",
   "currency",
   "vatIncluded",
   "checkoutUrl",
   "checkoutExpiresAt",
   "jobId",
   "statusToken",
   "reportUrl",
   "pollAfterSeconds",
   "termsVersion",
   "agentContractingTermsUrl",
   "notice"
  ],
  "type": "object"
 },
 "title": "Not available: every HOUSINGFAX report is free"
}
