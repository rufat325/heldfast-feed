{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The canonical change ledger for Robinhood Chain or one project: releases, ships, status moves, contract deployments and upgrades, verification, sources, scheduled unlocks \u2014 one event per change, with its own time and precision, when HEY first knew, and its evidence. Browse newest first; to follow along pass after=c1.0 (or a kept cursor) and keep each answer's cursor. A retraction means HEY no longer makes that claim. Facts, never causes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Sync forward from this cursor (c1.0 is the start).",
    "maxLength": 64,
    "type": "string"
   },
   "before": {
    "description": "Browse older than this cursor.",
    "maxLength": 64,
    "type": "string"
   },
   "contract": {
    "description": "<chainId>:<address>.",
    "pattern": "^\\d{1,10}:0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "detectedSince": {
    "description": "ISO instant: start a sync at the first event HEY recorded at or after it.",
    "maxLength": 40,
    "type": "string"
   },
   "domain": {
    "items": {
     "enum": [
      "build",
      "contract",
      "market",
      "token",
      "research",
      "lock",
      "market_integrity"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Default 30.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "project": {
    "description": "A project slug.",
    "maxLength": 120,
    "type": "string"
   },
   "since": {
    "description": "ISO date: events whose own time is at or after it (events with no source time are left out).",
    "maxLength": 40,
    "type": "string"
   },
   "type": {
    "items": {
     "enum": [
      "build.release",
      "build.code_activity",
      "build.ship",
      "build.status_changed",
      "build.dormant",
      "build.resumed",
      "build.accelerating",
      "build.slowing",
      "contract.deployed",
      "contract.followup_deployed",
      "contract.implementation_changed",
      "contract.source_verified",
      "contract.source_unverified",
      "contract.interface_changed",
      "contract.usage_changed",
      "contract.method_first_observed",
      "contract.method_resumed",
      "market.status_changed",
      "market.liquidity_moved",
      "market.volume_spike",
      "market.distribution_changed",
      "token.launch_stage_changed",
      "token.verification_changed",
      "research.published",
      "research.builder_verified",
      "research.owner_verified",
      "research.source_added",
      "research.source_unavailable",
      "research.source_restored",
      "research.source_changed",
      "research.narrative_assigned",
      "lock.unlock_due",
      "lock.observed",
      "lock.withdrawn",
      "market_integrity.event"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "until": {
    "maxLength": 40,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_changes",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "api": {
    "type": "string"
   },
   "data": {},
   "schema": {
    "const": "hey.mcp-api-answer",
    "type": "string"
   }
  },
  "required": [
   "schema",
   "api"
  ],
  "type": "object"
 },
 "title": "What changed"
}
