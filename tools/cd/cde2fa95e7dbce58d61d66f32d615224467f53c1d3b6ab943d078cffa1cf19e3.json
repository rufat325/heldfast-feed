{
 "description": "Import CSV to sheet range. Overwrites existing data at startRange. Use rows-csv-append for database-style appends with deduplication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "sourceHasHeaders": {
    "default": true,
    "description": "First row is headers (metadata) - exclude from data range. Set to false to include first row as data.",
    "type": "boolean"
   },
   "sourceUri": {
    "description": "CSV file URI (file://, http://, https://)",
    "minLength": 1,
    "type": "string"
   },
   "startRange": {
    "default": "A1",
    "description": "Top-left cell where CSV data starts (default: A1)",
    "minLength": 1,
    "type": "string"
   },
   "valueInputOption": {
    "default": "USER_ENTERED",
    "description": "How to interpret values (RAW = exact, USER_ENTERED = parse formulas/dates)",
    "enum": [
     "RAW",
     "USER_ENTERED"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "sourceUri"
  ],
  "type": "object"
 },
 "name": "values-csv-update",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Sheet title",
        "type": "string"
       },
       "sheetUrl": {
        "description": "Sheet URL",
        "type": "string"
       },
       "spreadsheetTitle": {
        "description": "Spreadsheet title",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "Spreadsheet URL",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "updatedCells": {
        "description": "Number of cells updated",
        "type": "number"
       },
       "updatedColumns": {
        "description": "Number of columns updated",
        "type": "number"
       },
       "updatedRange": {
        "description": "A1 notation range that was updated",
        "type": "string"
       },
       "updatedRows": {
        "description": "Number of rows updated",
        "type": "number"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "spreadsheetTitle",
       "spreadsheetUrl",
       "sheetTitle",
       "sheetUrl",
       "updatedRange",
       "updatedRows",
       "updatedColumns",
       "updatedCells"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
