{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "L\u01b0u th\u00f4ng tin ch\u1ee7 th\u1ec3 \u0111\u1ec3 \u0111\u0103ng k\u00fd t\u00ean mi\u1ec1n. H\u1eceI NG\u01af\u1edcI D\u00d9NG cung c\u1ea5p NGAY TRONG PHI\u00caN: h\u1ecd t\u00ean, email, \u0111i\u1ec7n tho\u1ea1i, \u0111\u1ecba ch\u1ec9. T\u00ean mi\u1ec1n .vn c\u00e1 nh\u00e2n c\u1ea7n th\u00eam CCCD 12 s\u1ed1 + ng\u00e0y sinh (DD/MM/YYYY) + gi\u1edbi t\u00ednh; .vn t\u1ed5 ch\u1ee9c c\u1ea7n org_name + tax_code (MST) + representative. L\u01b0u 1 l\u1ea7n, t\u00e1i d\u00f9ng cho c\u00e1c domain sau. Kh\u00f4ng t\u1ef1 b\u1ecba d\u1eef li\u1ec7u \u2014 thi\u1ebfu tr\u01b0\u1eddng n\u00e0o th\u00ec h\u1ecfi \u0111\u00fang tr\u01b0\u1eddng \u0111\u00f3.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "\u0110\u1ecba ch\u1ec9 li\u00ean h\u1ec7.",
    "maxLength": 500,
    "minLength": 5,
    "type": "string"
   },
   "cccd": {
    "description": "S\u1ed1 CCCD (12 s\u1ed1) \u2014 b\u1eaft bu\u1ed9c khi \u0111\u0103ng k\u00fd t\u00ean mi\u1ec1n .vn c\u00e1 nh\u00e2n.",
    "maxLength": 12,
    "minLength": 12,
    "type": "string"
   },
   "country": {
    "description": "M\u00e3 qu\u1ed1c gia, m\u1eb7c \u0111\u1ecbnh VN.",
    "maxLength": 10,
    "type": "string"
   },
   "dob": {
    "description": "Ng\u00e0y sinh \u0111\u1ecbnh d\u1ea1ng DD/MM/YYYY \u2014 c\u00e1 nh\u00e2n .vn.",
    "maxLength": 20,
    "type": "string"
   },
   "email": {
    "description": "Email li\u00ean h\u1ec7.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "fullname": {
    "description": "H\u1ecd v\u00e0 t\u00ean \u0111\u1ea7y \u0111\u1ee7 (ho\u1eb7c t\u00ean doanh nghi\u1ec7p n\u1ebfu organization).",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "gender": {
    "description": "Gi\u1edbi t\u00ednh \u2014 c\u00e1 nh\u00e2n .vn.",
    "enum": [
     "male",
     "female",
     ""
    ],
    "type": "string"
   },
   "org_name": {
    "description": "T\u00ean t\u1ed5 ch\u1ee9c/doanh nghi\u1ec7p \u2014 b\u1eaft bu\u1ed9c khi organization.",
    "maxLength": 300,
    "type": "string"
   },
   "owner_type": {
    "description": "individual = c\u00e1 nh\u00e2n (m\u1eb7c \u0111\u1ecbnh), organization = t\u1ed5 ch\u1ee9c/doanh nghi\u1ec7p.",
    "enum": [
     "individual",
     "organization"
    ],
    "type": "string"
   },
   "phone": {
    "description": "S\u1ed1 \u0111i\u1ec7n tho\u1ea1i.",
    "maxLength": 20,
    "minLength": 8,
    "type": "string"
   },
   "province": {
    "description": "T\u1ec9nh/th\u00e0nh ph\u1ed1.",
    "maxLength": 100,
    "type": "string"
   },
   "representative": {
    "description": "H\u1ecd t\u00ean ng\u01b0\u1eddi \u0111\u1ea1i di\u1ec7n \u2014 b\u1eaft bu\u1ed9c khi organization.",
    "maxLength": 200,
    "type": "string"
   },
   "tax_code": {
    "description": "M\u00e3 s\u1ed1 thu\u1ebf \u2014 b\u1eaft bu\u1ed9c khi organization.",
    "maxLength": 20,
    "type": "string"
   },
   "ward": {
    "description": "Ph\u01b0\u1eddng/x\u00e3.",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "fullname",
   "email",
   "phone",
   "address"
  ],
  "type": "object"
 },
 "name": "cloud_domain_registrant_set",
 "title": "C\u1eadp nh\u1eadt th\u00f4ng tin ch\u1ee7 th\u1ec3 \u0111\u0103ng k\u00fd t\u00ean mi\u1ec1n"
}
