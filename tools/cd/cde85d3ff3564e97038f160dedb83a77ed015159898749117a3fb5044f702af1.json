{
 "description": "Return one canon-v1 record (constructs, relationships, open divergences, provenance, source works) for a known slug. Never fabricates content for unknown slugs; returns close-match slugs instead.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Canon slug from canons/index.json.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_canon",
 "outputSchema": {
  "properties": {
   "action_statement": {
    "type": "string"
   },
   "closeMatches": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "code": {
    "enum": [
     "not_found"
    ],
    "type": "string"
   },
   "constructs": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "coverage": {
    "type": "object"
   },
   "guide_url": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "open_divergences": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "provenance": {
    "type": "object"
   },
   "relationships": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "source_works": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "constructs",
   "url"
  ],
  "type": "object"
 }
}
