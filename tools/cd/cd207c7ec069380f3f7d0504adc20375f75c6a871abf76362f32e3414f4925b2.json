{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get Weekly Summary"
 },
 "description": "Get a summarized health report for a given week \u2014 average recovery, HRV, RHR, sleep duration and quality, workout count and strain, plus recovery trend direction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "week_start": {
    "description": "Start of the week to summarize. Accepts ISO 8601 or relative expressions like \"last week\", \"this week\". Defaults to most recent Monday.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_weekly_summary",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "recovery": {
    "additionalProperties": false,
    "properties": {
     "average_hrv": {
      "type": "number"
     },
     "average_rhr": {
      "type": "number"
     },
     "average_score": {
      "type": "number"
     },
     "max_score": {
      "type": "number"
     },
     "min_score": {
      "type": "number"
     },
     "trend": {
      "enum": [
       "improving",
       "declining",
       "stable"
      ],
      "type": "string"
     }
    },
    "required": [
     "average_score",
     "min_score",
     "max_score",
     "average_hrv",
     "average_rhr",
     "trend"
    ],
    "type": "object"
   },
   "sleep": {
    "additionalProperties": false,
    "properties": {
     "average_duration_hours": {
      "type": "number"
     },
     "average_efficiency_pct": {
      "type": "number"
     },
     "average_performance_pct": {
      "type": "number"
     }
    },
    "required": [
     "average_duration_hours",
     "average_performance_pct",
     "average_efficiency_pct"
    ],
    "type": "object"
   },
   "strain": {
    "additionalProperties": false,
    "properties": {
     "average_daily_strain": {
      "type": "number"
     },
     "max_daily_strain": {
      "type": "number"
     }
    },
    "required": [
     "average_daily_strain",
     "max_daily_strain"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "week_end": {
    "type": "string"
   },
   "week_start": {
    "type": "string"
   },
   "workouts": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "type": "number"
     },
     "sport_breakdown": {
      "additionalProperties": {
       "type": "number"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "total_calories_kj": {
      "type": "number"
     },
     "total_strain": {
      "type": "number"
     }
    },
    "required": [
     "count",
     "total_strain",
     "total_calories_kj",
     "sport_breakdown"
    ],
    "type": "object"
   }
  },
  "required": [
   "week_start",
   "week_end",
   "recovery",
   "sleep",
   "workouts",
   "strain"
  ],
  "type": "object"
 }
}
