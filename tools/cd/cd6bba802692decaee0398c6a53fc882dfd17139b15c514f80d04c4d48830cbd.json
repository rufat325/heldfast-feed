{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"Postgres commits (code-history index), newest first, like git log. range: a rev (its first-parent line), A..B, or all (default: every branch; each commit once, branches = where its change landed). Filters: message, author (also credit trailers), paths, since/until, changed_lines (-G), occurrences (-S). complete=false when -G/-S matched over 300,000 lines.","inputSchema":{"properties":{"author":{"description":"Regex","type":"string"},"budget_ms":{"description":"ms, 100-15000, default 10000","type":"number"},"changed_lines":{"description":"Regex (git log -G)","type":"string"},"limit":{"description":"Commits (1-200, default 30)","type":"number"},"message":{"description":"Regex over the commit message","type":"string"},"occurrences":{"description":"String (git log -S)","type":"string"},"offset":{"description":"Commits to skip","type":"number"},"paths":{"description":"Path prefixes the commit touched","items":{"type":"string"},"type":"array"},"range":{"description":"A rev, A..B, or all (default)","type":"string"},"repository":{"description":"Only postgres","type":"string"},"since":{"description":"YYYY-MM-DD (committed on or after)","type":"string"},"until":{"description":"YYYY-MM-DD (committed before)","type":"string"}},"type":"object"},"name":"search_commits"}
