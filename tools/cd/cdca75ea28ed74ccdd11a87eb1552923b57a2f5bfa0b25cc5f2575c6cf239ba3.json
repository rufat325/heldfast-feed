 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List conversions"
 },
 "description": "Your individual conversions (default: last 90 days) with status, commission, currency and subid, plus a per-subid rollup. Requires your own Clickwise affiliate API key on the MCP connection (X-API-Key header or Authorization: Bearer); acts only on your account.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date_from": {
    "description": "YYYY-MM-DD",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "YYYY-MM-DD",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 100,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "pending",
     "approved",
     "declined"
    ],
    "type": "string"
   },
   "subid": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_conversions",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "List conversions"
