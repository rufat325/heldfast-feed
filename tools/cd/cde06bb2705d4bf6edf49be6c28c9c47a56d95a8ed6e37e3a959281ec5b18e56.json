{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Deposits, withdrawals and swaps (source \"wallet\", default) or Ripio Trade statement entries (source \"trade\"), newest first, in one normalized shape. Card transactions, in-app buys/sells and bill payments are not available from Ripio's API. Pass next_cursor back as cursor for older items. Dates are UTC; on Wallet, from/to filter the returned page only; on Ripio Trade a from/to range can span up to 182 days.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "Only this asset, e.g. \"USDT\".",
    "pattern": "^[A-Za-z0-9]{2,12}$",
    "type": "string"
   },
   "cursor": {
    "description": "next_cursor from a previous call.",
    "type": "string"
   },
   "from": {
    "anyOf": [
     {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
     },
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     }
    ],
    "description": "UTC date (YYYY-MM-DD) or ISO 8601 date-time."
   },
   "rail": {
    "description": "Wallet only.",
    "enum": [
     "bank",
     "pix",
     "crypto",
     "ripio"
    ],
    "type": "string"
   },
   "source": {
    "description": "Default \"wallet\".",
    "enum": [
     "wallet",
     "trade"
    ],
    "type": "string"
   },
   "to": {
    "anyOf": [
     {
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
     },
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     }
    ],
    "description": "UTC date (YYYY-MM-DD) or ISO 8601 date-time."
   },
   "type": {
    "description": "\"trade\" exists only in source \"trade\"; \"swap\" only in \"wallet\".",
    "enum": [
     "deposit",
     "withdrawal",
     "swap",
     "trade"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ripio_list_activity",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "coverage_notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": "string"
      },
      "asset": {
       "type": "string"
      },
      "counterparty": {
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "direction": {
       "enum": [
        "in",
        "out",
        "internal"
       ],
       "type": "string"
      },
      "fee": {
       "type": "string"
      },
      "fee_asset": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "rail": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "unreadable": {
       "items": {
        "enum": [
         "amount",
         "asset"
        ],
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "date",
      "type",
      "direction",
      "asset",
      "amount",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": "string"
   },
   "source": {
    "enum": [
     "wallet",
     "trade"
    ],
    "type": "string"
   }
  },
  "required": [
   "source",
   "items",
   "coverage_notes"
  ],
  "type": "object"
 },
 "title": "Ripio activity"
}
