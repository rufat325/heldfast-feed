{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Core Discovery over explicit candidate contexts"
 },
 "description": "Runs the real @nec/discovery discoverNetworks (classification by @nec/core only) over 1..16 EXPLICIT, complete, already-derived candidate contexts you supply (network + ResolverManifest + CapabilitySnapshot in nec-wire-json-v1 form) and Core DiscoveryRequirements. Returns the Core-built, Core-verified DiscoverNetworksResult with digests and per-candidate eligible/conditional/ineligible copied from Core. The outcome depends ONLY on the supplied snapshots; this server observes nothing and does NOT choose, rank or recommend a network. Any resolver-specific evidence preflight is external to this tool. Invalid or incoherent contexts fail closed with a coded error.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "candidates": {
    "description": "1..16 EXPLICIT, complete, already-derived candidate contexts. No default or demo candidates exist.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "environment": {
       "description": "Presentation-only label; never evidence. Must not contradict the fixed profile for a listed network (e.g. zkSYS eip155:57057 is testnet only).",
       "enum": [
        "mainnet",
        "testnet"
       ],
       "type": "string"
      },
      "id": {
       "description": "Opaque presentation id (NEC identifier grammar), unique in the request.",
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "manifest": {
       "additionalProperties": {},
       "description": "The COMPLETE Core ResolverManifest behind snapshot.resolver (nec-wire-json-v1).",
       "properties": {
        "digest": {
         "description": "sha256:<64 hex>; verified by @nec/core.",
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "implementation": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "networkFamilies": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "sourceRequirements": {
         "items": {
          "additionalProperties": {},
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         "type": "array"
        },
        "supportedCapabilities": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "version",
        "digest",
        "networkFamilies",
        "implementation",
        "supportedCapabilities",
        "sourceRequirements"
       ],
       "type": "object"
      },
      "network": {
       "additionalProperties": {},
       "description": "Core NetworkFingerprint in nec-wire-json-v1 form. MUST be canonically identical to snapshot.network (full fingerprint equality; same networkId alone is insufficient).",
       "properties": {
        "networkId": {
         "description": "CAIP-2 style network id, e.g. eip155:84532 or solana:EtWTRABZaYq6iMfeYKouRu166VU2xqa1.",
         "type": "string"
        },
        "observedAt": {
         "additionalProperties": {},
         "description": "NetworkAnchor: { timestamp?, blockNumber? (decimal string), blockId? }.",
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        }
       },
       "required": [
        "networkId",
        "observedAt"
       ],
       "type": "object"
      },
      "snapshot": {
       "additionalProperties": {},
       "description": "The COMPLETE Core CapabilitySnapshot for exactly this network, in nec-wire-json-v1 form (every blockNumber is a canonical decimal STRING). Produce it with a public resolver BEFORE derivation (e.g. deriveOpStackBeforeFoundation(...).snapshot) and encodeNecWireJson('capability-snapshot', ...).",
       "properties": {
        "artifactDigest": {
         "type": "string"
        },
        "evidence": {
         "items": {
          "additionalProperties": {},
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         "type": "array"
        },
        "evidenceCapabilities": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "executionCapabilities": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "generatedAt": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "network": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "resolver": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "schemaVersion": {
         "const": "0.1",
         "type": "string"
        }
       },
       "required": [
        "schemaVersion",
        "id",
        "generatedAt",
        "network",
        "evidenceCapabilities",
        "executionCapabilities",
        "evidence",
        "resolver",
        "artifactDigest"
       ],
       "type": "object"
      }
     },
     "required": [
      "id",
      "environment",
      "network",
      "manifest",
      "snapshot"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "minItems": 1,
    "type": "array"
   },
   "generatedAt": {
    "description": "Explicit result time, exactly YYYY-MM-DDTHH:mm:ss.sssZ. The server reads no clock.",
    "maxLength": 64,
    "type": "string"
   },
   "requestId": {
    "description": "Becomes DiscoverNetworksResult.requestId (NEC identifier grammar, e.g. 'disc-1').",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "requirements": {
    "additionalProperties": false,
    "description": "Core DiscoveryRequirements (validated by @nec/core).",
    "properties": {
     "metadata": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "networkAllowlist": {
      "description": "Core request semantics: unlisted candidates are reported ineligible.",
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     },
     "networkDenylist": {
      "description": "Core request semantics: listed candidates are reported ineligible.",
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     },
     "requirements": {
      "description": "Required unsatisfied/unknown => ineligible; desired unsatisfied/unknown => conditional (Core semantics).",
      "items": {
       "additionalProperties": false,
       "properties": {
        "capability": {
         "description": "Closed Core capability vocabulary.",
         "enum": [
          "execution",
          "observedEffects",
          "dataBinding",
          "settlement",
          "finality",
          "executionModel",
          "accountModel",
          "gasModel",
          "simulation",
          "batching"
         ],
         "type": "string"
        },
        "strength": {
         "enum": [
          "required",
          "desired"
         ],
         "type": "string"
        }
       },
       "required": [
        "capability",
        "strength"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     }
    },
    "required": [
     "requirements"
    ],
    "type": "object"
   },
   "scope": {
    "additionalProperties": false,
    "description": "Optional presentation scope; removes candidates from the result, never changes a classification.",
    "properties": {
     "candidateIds": {
      "description": "Exact presentation ids.",
      "items": {
       "maxLength": 256,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 16,
      "minItems": 1,
      "type": "array"
     },
     "environments": {
      "items": {
       "enum": [
        "mainnet",
        "testnet"
       ],
       "type": "string"
      },
      "maxItems": 2,
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "requestId",
   "generatedAt",
   "requirements",
   "candidates"
  ],
  "type": "object"
 },
 "name": "discover_network_candidates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "classification": {
       "enum": [
        "eligible",
        "conditional",
        "ineligible"
       ],
       "type": "string"
      },
      "environment": {
       "enum": [
        "mainnet",
        "testnet"
       ],
       "type": "string"
      },
      "environmentLabelSource": {
       "const": "caller",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "networkId": {
       "type": "string"
      },
      "resolver": {
       "additionalProperties": false,
       "properties": {
        "digest": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "version",
        "digest"
       ],
       "type": "object"
      },
      "suppliedSnapshot": {
       "additionalProperties": false,
       "properties": {
        "artifactDigest": {
         "type": "string"
        },
        "declaredObservationKind": {
         "type": [
          "string",
          "null"
         ]
        },
        "evidenceSourceIds": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "generatedAt": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "networkObservedAt": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "artifactDigest",
        "generatedAt",
        "networkObservedAt",
        "declaredObservationKind",
        "evidenceSourceIds"
       ],
       "type": "object"
      }
     },
     "required": [
      "id",
      "environment",
      "environmentLabelSource",
      "networkId",
      "resolver",
      "classification",
      "suppliedSnapshot"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "coreResult": {
    "additionalProperties": {},
    "description": "THE Core DiscoverNetworksResult (nec-wire-json-v1).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "coreVerification": {
    "additionalProperties": false,
    "properties": {
     "builtAndVerifiedBy": {
      "type": "string"
     },
     "resultArtifactDigest": {
      "type": "string"
     },
     "reverifiedAtMcpBoundary": {
      "const": true,
      "type": "boolean"
     },
     "wireProfile": {
      "type": "string"
     }
    },
    "required": [
     "builtAndVerifiedBy",
     "reverifiedAtMcpBoundary",
     "resultArtifactDigest",
     "wireProfile"
    ],
    "type": "object"
   },
   "liveObservation": {
    "const": false,
    "type": "boolean"
   },
   "networkChoice": {
    "type": "string"
   },
   "qualification": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "schema": {
    "const": "ne-mcp-discovery/v0.1",
    "type": "string"
   },
   "scope": {
    "additionalProperties": false,
    "properties": {
     "candidateIds": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "environments": {
      "anyOf": [
       {
        "items": {
         "enum": [
          "mainnet",
          "testnet"
         ],
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "inScopeCandidateIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "outOfScopeCandidateIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "candidateIds",
     "environments",
     "inScopeCandidateIds",
     "outOfScopeCandidateIds"
    ],
    "type": "object"
   },
   "verificationContextRefs": {
    "additionalProperties": false,
    "properties": {
     "capabilitySnapshots": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "digest": {
         "type": "string"
        },
        "id": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "digest"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "resolverManifests": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "digest": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "version": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "version",
        "digest"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "capabilitySnapshots",
     "resolverManifests"
    ],
    "type": "object"
   }
  },
  "required": [
   "schema",
   "liveObservation",
   "networkChoice",
   "qualification",
   "coreVerification",
   "candidates",
   "scope",
   "verificationContextRefs",
   "coreResult"
  ],
  "type": "object"
 },
 "title": "Core Discovery over explicit candidate contexts"
}
