  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Import tickets from CSV string. Only 'title' column is required; missing score columns default to 1. Tags column optional (comma-separated prefix:value). Columns other than title, description, benefit, penalty, estimate, risk, tags (and the calculated value, cost, priority) are rejected.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "csv": {
    "description": "CSV content",
    "type": "string"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "required": [
   "csv"
  ],
  "type": "object"
 },
 "name": "import_csv",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "imported": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "imported"
  ],
  "type": "object"
 }
}
