{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List automated tasks"
 },
 "description": "Lists the current user\u2019s unexpired automated tasks in the connected organisation, optionally for an innovation. Recovers task IDs after a lost response or conversation. Returns recorded status summaries without polling upstream analyses. Tasks and findings expire 30 days after creation. Pagination can return an empty page with a continuation cursor. Professional service requests are separate.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pass next_cursor from the previous list_tasks response unchanged",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "invention_id": {
    "description": "Optional innovation identifier",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_tasks",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "next_cursor": {
    "anyOf": [
     {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Opaque continuation cursor; pass unchanged to list_tasks, even when the page is empty."
   },
   "tasks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "expires_at": {
       "type": "string"
      },
      "invention_id": {
       "type": "string"
      },
      "progress": {
       "additionalProperties": false,
       "properties": {
        "completed": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "total": {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "completed",
        "total"
       ],
       "type": "object"
      },
      "status": {
       "enum": [
        "queued",
        "running",
        "succeeded",
        "partially_succeeded",
        "failed"
       ],
       "type": "string"
      },
      "task_id": {
       "type": "string"
      },
      "type": {
       "const": "innovation_feedback",
       "type": "string"
      }
     },
     "required": [
      "task_id",
      "type",
      "invention_id",
      "status",
      "progress",
      "created_at",
      "expires_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tasks",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "List automated tasks"
}
