{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a user-defined custom schema in Cloud Insight.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cw_key": {
    "description": "Product key (cw_key) of the schema to update",
    "type": "string"
   },
   "fields": {
    "description": "Updated schema field definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dimension": {
       "description": "Whether this field is a dimension",
       "type": "boolean"
      },
      "fieldName": {
       "description": "Field name",
       "type": "string"
      },
      "fieldType": {
       "description": "Field data type",
       "enum": [
        "STRING",
        "INTEGER",
        "LONG",
        "FLOAT"
       ],
       "type": "string"
      }
     },
     "required": [
      "fieldName",
      "fieldType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prodName": {
    "description": "Product name of the schema to update",
    "type": "string"
   }
  },
  "required": [
   "prodName",
   "cw_key",
   "fields"
  ],
  "type": "object"
 },
 "name": "ncloud_update_product_schema"
}
