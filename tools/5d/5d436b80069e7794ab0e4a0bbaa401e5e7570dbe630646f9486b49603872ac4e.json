      "type": "integer"
     }
    },
    "type": "object"
   },
   "recent": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "actor": {
       "type": "string"
      },
      "confidence": {
       "type": "string"
      },
      "scope": {
       "type": "string"
      },
      "threat_id": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_actors": {
    "items": {},
    "type": "array"
   }
