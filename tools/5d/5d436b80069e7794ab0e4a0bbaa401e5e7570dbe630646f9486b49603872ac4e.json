  "title": "Attribution Coverage"
 },
 "description": "Corpus-level attribution honesty: how many threats are genuinely assessed vs merely actor-labelled at ingest vs uncovered, broken down by confidence, scope and reason code, plus the research backlog, contradictions, top actors and the research clock (last real assessment, not last nightly intake).",
 "inputSchema": {
  "properties": {
   "actor": {
    "description": "Optional \u2014 scope the `recent` list to one actor.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_attribution_coverage",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "by_confidence": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "by_reason": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "by_scope": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "corpus": {
    "additionalProperties": true,
    "properties": {
     "attributed": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "unattributed": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "engine": {
    "additionalProperties": true,
    "properties": {
     "assessed": {
      "type": "integer"
     },
     "contradicted": {
      "type": "integer"
     },
     "latest_assessment_at": {
      "description": "The RESEARCH clock \u2014 deliberately distinct from the nightly intake, so a dead research lane cannot read as fresh.",
