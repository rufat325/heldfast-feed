{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "knowledge:context:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://memostem/onboarding.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://memostem/onboarding.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Start MemoStem"
 },
 "description": "Start MemoStem when no topic is named. Show a localized welcome App before login, or the connected owner's topic labels and empty-state guidance. Pass the conversation language as locale when known. No drafts are created.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "anyOf": [
     {
      "maxLength": 512,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "locale": {
    "maxLength": 64,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "start_memostem",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "enum": [
     "ko",
     "en"
    ],
    "type": "string"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "connection_required",
     "permission_required",
     "topics",
     "empty"
    ],
    "type": "string"
   },
   "topics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "status",
   "locale",
   "topics",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Start MemoStem"
}
