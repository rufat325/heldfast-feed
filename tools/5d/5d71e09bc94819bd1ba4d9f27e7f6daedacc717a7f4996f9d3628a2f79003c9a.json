{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Swiss public transport connections or next departures (official timetable data).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "arrival": {
    "default": false,
    "description": "Interpret `when` as arrival time.",
    "type": "boolean"
   },
   "destination": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Destination; omit for a departure board."
   },
   "limit": {
    "default": 3,
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "origin": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Departure station or place, e.g. 'Z\u00fcrich HB'."
   },
   "when": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ISO date-time (Europe/Zurich), e.g. 2026-10-01T08:30; default now."
   }
  },
  "type": "object"
 },
 "name": "public_transport",
 "outputSchema": {
  "properties": {
   "citations": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "data": {
    "type": "object"
   },
   "guidance": {
    "type": "string"
   },
   "missing_context": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "needs_context",
     "not_covered",
     "not_found",
     "source_error"
    ]
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "summary"
  ],
  "type": "object"
 },
 "title": "Public transport timetable"
}
