{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change DB user information (authority, password, hostIp) for a Cloud DB for MySQL instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudMysqlInstanceNo": {
    "description": "Cloud MySQL instance number",
    "type": "string"
   },
   "cloudMysqlUserList": {
    "description": "List of users to modify",
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "description": "User authority: READ (select only), CRUD (insert/select/update/delete), DDL (CRUD + create/drop/alter table)",
       "enum": [
        "READ",
        "CRUD",
        "DDL"
       ],
       "type": "string"
      },
      "hostIp": {
       "description": "Host IP for MySQL access (e.g. '%', '1.1.1.1', '1.1.1.%')",
       "type": "string"
      },
      "isSystemTableAccess": {
       "description": "System table access (default: true)",
       "type": "boolean"
      },
      "name": {
       "description": "DB user name to modify",
       "type": "string"
      },
      "password": {
       "description": "New password (8-20 chars, must include letter+number+special char). Optional \u2014 omit to keep current password.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "hostIp",
      "authority"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "regionCode": {
    "description": "Region code (default: first region)",
    "type": "string"
   }
  },
  "required": [
   "cloudMysqlInstanceNo",
   "cloudMysqlUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_change_mysql_users"
}
