{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. Every Genesis402 endpoint with price, title, path and parameters, from the live /.well-known/x402 manifest. Call first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter": {
    "description": "Optional keyword to filter by name, title or tag, e.g. defi, sec, xrpl, wallet.",
    "maxLength": 60,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "genesis402_catalog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "endpoints": {
    "description": "Matching endpoints with price and parameters.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "name": {
       "type": "string"
      },
      "parameters": {},
      "path": {
       "type": "string"
      },
      "price_usd": {
       "type": [
        "number",
        "null"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "path",
      "price_usd"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matched": {
    "description": "Endpoints matching the filter.",
    "type": "number"
   },
   "origin": {
    "description": "The rail's origin URL.",
    "type": "string"
   },
   "payer_mode": {
    "description": "QUOTE_ONLY, HOSTED, or LIVE with its cap.",
    "type": "string"
   },
   "total_endpoints": {
    "description": "Endpoints in the live manifest.",
    "type": "number"
   }
  },
  "required": [
   "origin",
   "total_endpoints",
   "matched",
   "payer_mode",
   "endpoints"
  ],
  "type": "object"
 },
 "title": "List endpoints and prices (free)"
}
