{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Region on-demand snapshot"
 },
 "description": "Paid (0.10 USDC per call). Current on-demand list price of every instance type in a region.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "provider": {
    "description": "Cloud provider. One of `aws`, `gcp`, `azure`.",
    "enum": [
     "aws",
     "gcp",
     "azure"
    ],
    "type": "string"
   },
   "region": {
    "description": "Region slug as listed by /catalog (for example `us-east-1` for AWS, `us-central1` for GCP, `us-east` for Azure). Azure slugs map to `eastus`, `westus2`, `westeurope`. Example: us-east-1",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "region"
  ],
  "type": "object"
 },
 "name": "ondemand_snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "prices": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "instance": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "since": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "provider": {
    "type": "string"
   },
   "region": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Region on-demand snapshot"
}
