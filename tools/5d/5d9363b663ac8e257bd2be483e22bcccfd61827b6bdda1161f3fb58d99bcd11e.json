{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "How Hyperliquid wallets trade, from their last 30 days: labels (market_maker, high_frequency, whale, directional, consistent_winner, big_loser, revenge_sizing, often_liquidated, hip3_trader, spot_trader, prediction_trader) and the numbers behind them (maker share, buy/sell imbalance, fills per day, green-day share, profit factor, liquidations). Look up specific addresses, or list wallets with one label.",
 "inputSchema": {
  "properties": {
   "addresses": {
    "description": "Comma-separated wallet addresses (up to 50). Omit to list wallets instead.",
    "type": "string"
   },
   "label": {
    "description": "Only wallets carrying this label",
    "enum": [
     "market_maker",
     "high_frequency",
     "whale",
     "directional",
     "consistent_winner",
     "big_loser",
     "revenge_sizing",
     "often_liquidated",
     "hip3_trader",
     "spot_trader",
     "prediction_trader"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Wallets to return (default 20, max 100)",
    "type": "number"
   },
   "min_volume_usd": {
    "description": "Only wallets with at least this 30-day volume",
    "type": "number"
   },
   "sort_by": {
    "description": "Sort order when listing (default volume)",
    "enum": [
     "volume",
     "pnl",
     "fills",
     "liquidations"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_wallet_behavior",
 "outputSchema": {
  "description": "Wallet trading behaviour over the last 30 days",
  "properties": {
   "wallets": {
    "description": "Wallets",
    "items": {
     "description": "One wallet",
     "properties": {
      "address": {
       "description": "Wallet address"
      },
      "fills_per_day": {
       "description": "Fills per active day"
      },
      "labels": {
       "description": "Behaviour labels",
       "items": {
        "description": "Label"
       },
       "type": "array"
      },
      "liquidations": {
       "description": "Liquidation events"
      },
      "maker_share": {
       "description": "Maker volume / volume"
      },
      "realized_pnl_usd": {
       "description": "30-day realized PnL in USD"
      },
      "volume_usd": {
       "description": "30-day volume in USD"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "window_days": {
    "description": "Days the features cover"
   }
  },
  "type": "object"
 }
