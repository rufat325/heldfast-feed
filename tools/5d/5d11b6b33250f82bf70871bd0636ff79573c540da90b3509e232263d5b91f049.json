{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Unsubscribe"
 },
 "description": "Unsubscribe from a publisher's data feed. Takes effect next block: no more billing, no more data flow. Reversible \u2014 you can resubscribe later via byte_subscribe. Use this when a publisher has pivoted content (check with byte_subscription_health first) or when you simply don't want the feed anymore. Requires PRIVATE_KEY for the connected wallet.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "publisher": {
    "description": "Publisher address to unsubscribe from",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "publisher"
  ],
  "type": "object"
 },
 "name": "byte_unsubscribe",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blockNumber": {
    "description": "Block number the tx landed in",
    "type": "string"
   },
   "publisher": {
    "description": "Publisher unsubscribed from",
    "type": "string"
   },
   "status": {
    "description": "Receipt status ('success' | 'reverted')",
    "type": "string"
   },
   "subscriber": {
    "description": "Subscriber address (the signer)",
    "type": "string"
   },
   "txHash": {
    "description": "Unsubscribe transaction hash",
    "type": "string"
   }
  },
  "type": "object"
 }
}
