{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Calculate from discovered supplier facts"
 },
 "description": "Evaluates supplier-events-v3 project facts against the exact discovered rule and question identities. Returns independent notice and lien outcomes with sources and an exact nested input echo. Only calculated outcomes contain deadline dates; review candidates remain unresolved. Stale identities return 409, unavailable reviewed sources return 503. Public, stateless and read-only; no key, stored records, sent notices or filed liens.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "events": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "answer": {
       "enum": [
        "yes",
        "no",
        "unknown"
       ],
       "type": "string"
      },
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      }
     },
     "required": [
      "answer"
     ],
     "type": "object"
    },
    "description": "Discovered event IDs only; missing means unknown. Date only for yes and only where the question permits it. Invoice dates are not furnishing dates.",
    "propertyNames": {
     "pattern": "^[a-z][a-z0-9_]{0,79}$",
     "type": "string"
    },
    "type": "object"
   },
   "hired_by": {
    "enum": [
     "owner",
     "contractor",
     "subcontractor"
    ],
    "type": "string"
   },
   "project_type": {
    "enum": [
     "commercial",
     "residential",
     "public"
    ],
    "type": "string"
   },
   "questions_identity": {
    "additionalProperties": false,
    "description": "Exact questions_identity from discovery.",
    "properties": {
     "question_set_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "questions_version": {
      "const": "supplier-questions-v1",
      "type": "string"
     }
    },
    "required": [
     "questions_version",
     "question_set_hash"
    ],
    "type": "object"
   },
   "rules_source": {
    "additionalProperties": false,
    "description": "Exact rules_source from discovery for this scope.",
    "properties": {
     "implementation_manifest_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "reviewed_commit": {
      "pattern": "^[0-9a-f]{40}$",
      "type": "string"
     },
     "schema_version": {
      "enum": [
       "state-rules-v1",
       "state-rules-v2"
      ],
      "type": "string"
     },
     "source_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "source_version": {
      "type": "string"
     },
     "supplier_engine_version": {
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "source_version",
     "source_hash",
     "reviewed_commit",
     "supplier_engine_version",
     "implementation_manifest_hash"
    ],
    "type": "object"
   },
   "state": {
    "description": "Project jurisdiction: state or DC.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   }
  },
  "required": [
   "state",
   "project_type",
   "hired_by",
   "rules_source",
   "questions_identity",
   "events"
  ],
  "type": "object"
 },
 "name": "calculate_supplier_deadlines_v3",
 "title": "Calculate from discovered supplier facts"
}
