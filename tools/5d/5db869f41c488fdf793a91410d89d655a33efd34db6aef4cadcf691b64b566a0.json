{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Only matches in play right now \u2014 each with current score and minute (empty when nothing is live). Use during matches for in-play state; for a full day's schedule including upcoming and finished, use get_today. tz/lang/flavor affect formatting only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "flavor": {
    "description": "Commentary flair: off, subtle, full (default: full)",
    "enum": [
     "off",
     "subtle",
     "full"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Locale for dates, provider attribution, and commentary: en, es, pt, fr (the summary scaffold stays English; other locales fall back to en)",
    "type": "string"
   },
   "tz": {
    "description": "IANA timezone for kickoff times, e.g. America/Mexico_City",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_live",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "degraded": {
    "type": "boolean"
   },
   "matches": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "away": {
       "$ref": "#/properties/matches/items/properties/home"
      },
      "group": {
       "type": [
        "string",
        "null"
       ]
      },
      "home": {
       "additionalProperties": true,
       "properties": {
        "code": {
         "type": "string"
        },
        "flag": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "kickoff": {
       "type": "string"
      },
      "minute": {
       "type": [
        "number",
        "null"
       ]
      },
      "score": {
       "anyOf": [
        {
         "additionalProperties": true,
         "properties": {
          "away": {
           "type": "number"
          },
          "home": {
           "type": "number"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "shootout": {
       "$ref": "#/properties/matches/items/properties/score/anyOf/0"
      },
      "stage": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "venue": {
       "type": "string"
      },
      "winnerCode": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "responseTruncated": {
    "type": "boolean"
   },
   "responseTruncation": {
    "type": "string"
   },
   "source": {
    "type": [
     "string",
     "null"
    ]
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "degraded",
   "source",
   "count",
   "truncated",
   "matches"
  ],
  "type": "object"
 },
 "title": "Live matches"
}
