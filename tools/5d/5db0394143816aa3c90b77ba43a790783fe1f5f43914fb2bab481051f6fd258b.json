{
 "description": "Send a single AT command to the modem and capture the response. Requires root. Use adb_at_detect to find the correct port, or specify it manually.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "command": {
    "description": "AT command to send (e.g., 'AT+CSQ', 'ATI', 'AT+COPS?')",
    "type": "string"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "force": {
    "default": false,
    "description": "Bypass dangerous command safety check",
    "type": "boolean"
   },
   "port": {
    "description": "Modem device node (e.g., '/dev/umts_router'). If omitted, auto-detects.",
    "type": "string"
   },
   "timeout": {
    "default": 5000,
    "description": "Response timeout in ms (1000-30000, default 5000)",
    "maximum": 30000,
    "minimum": 1000,
    "type": "number"
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "adb_at_send"
}
