{
 "description": "Search PubMed for biomedical literature. Returns title, authors, journal, year, DOI, abstract, and PMID for each result.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "max_results": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "PubMed search query",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query",
   "max_results"
  ],
  "type": "object"
 },
 "name": "search_pubmed",
 "title": "Search Pubmed"
}
