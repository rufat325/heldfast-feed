{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: return the nodes AND the connections (wiring) under a network root, flagging obvious structural issues. Returns {nodeCount, connectionCount, issues[], topology}. Use this when you need how nodes are wired together; use get_td_nodes/find_td_nodes when you only need the node list without connections, or snapshot_td_graph when you also want each node's parameters captured for diffing. Token economy: point it at a specific network root rather than the project root, and leave recursion off unless you need nested networks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "root_path": {
    "default": "/project1",
    "description": "Network root to map.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_td_topology",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "connectionCount": {
    "description": "Total number of wires (connections) between those nodes.",
    "type": "number"
   },
   "issues": {
    "description": "Plain-language structural problems detected, e.g. dangling or orphaned nodes.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "nodeCount": {
    "description": "Total number of nodes found under the root.",
    "type": "number"
   },
   "path": {
    "description": "The network root that was mapped, echoing the request.",
    "type": "string"
   },
   "topology": {
    "additionalProperties": false,
    "description": "The full graph: the node list and the connection list.",
    "properties": {
     "connections": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "source_output": {
         "default": 0,
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "source_path": {
         "type": "string"
        },
        "target_input": {
         "default": 0,
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "target_path": {
         "type": "string"
        }
       },
       "required": [
        "source_path",
        "source_output",
        "target_path",
        "target_input"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nodes": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "already_existed": {
         "type": "boolean"
        },
        "name": {
         "default": "",
         "type": "string"
        },
        "nodeX": {
         "type": "number"
        },
        "nodeY": {
         "type": "number"
        },
        "operator_id": {
         "type": "string"
        },
        "parameter_warnings": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "path": {
         "type": "string"
        },
        "type": {
         "default": "",
         "type": "string"
        },
        "viewer": {
         "type": "boolean"
        }
       },
       "required": [
        "path",
        "type",
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "nodes",
     "connections"
    ],
    "type": "object"
   }
  },
  "required": [
   "path",
   "nodeCount",
   "connectionCount",
   "issues",
   "topology"
  ],
  "type": "object"
 },
 "title": "Get network topology"
}
