{
 "description": "Get function info, xrefs, basic blocks or source location for an address",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Information to get",
    "enum": [
     "function",
     "xrefs_to",
     "xrefs_from",
     "basic_blocks",
     "source",
     "mnemonic_brief"
    ],
    "type": "string"
   },
   "query": {
    "default": "cip",
    "description": "Address to look up (or mnemonic for mnemonic_brief)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_analysis"
}
