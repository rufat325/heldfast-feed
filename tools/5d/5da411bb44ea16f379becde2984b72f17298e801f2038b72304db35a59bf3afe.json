{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. A basket vault's value (NAV), holdings, current vs target weights and whether it needs rebalancing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Vault address.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "stocks_vault",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "constituents": {
    "description": "Holdings with current weights",
    "items": {},
    "type": "array"
   },
   "mintFeeBps": {
    "description": "Mint fee",
    "type": "number"
   },
   "nav": {
    "description": "NAV in dollars",
    "type": "number"
   },
   "navUsdc": {
    "description": "Net asset value (USDC, 6 decimals)",
    "type": "string"
   },
   "owner": {
    "description": "Owner",
    "type": "string"
   },
   "rebalanceBandBps": {
    "description": "Rebalance band",
    "type": "number"
   },
   "rebalanceNeeded": {
    "description": "True when weights drifted past the band",
    "type": "boolean"
   },
   "strategist": {
    "description": "Strategist",
    "type": "string"
   },
   "totalSupply": {
    "description": "Shares outstanding",
    "type": "string"
   },
   "vault": {
    "description": "Vault address",
    "type": "string"
   },
   "weightsBps": {
    "description": "Target weights in basis points",
    "items": {},
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Stock vault state"
}
