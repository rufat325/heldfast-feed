{
 "description": "Change Stripe express checkout through cvrt-woo-helper. Only the keys given change. locations maps a button type (apple_google_pay, link, amazon_pay) to the pages it shows on (product, cart, checkout). 409 when the Stripe Gateway plugin is inactive.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "express_checkout": {
    "description": "Express checkout buttons on/off",
    "type": "boolean"
   },
   "locations": {
    "additionalProperties": false,
    "description": "Pages per button type",
    "properties": {
     "amazon_pay": {
      "$ref": "#/properties/locations/properties/apple_google_pay"
     },
     "apple_google_pay": {
      "items": {
       "enum": [
        "product",
        "cart",
        "checkout"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "link": {
      "$ref": "#/properties/locations/properties/apple_google_pay"
     }
    },
    "type": "object"
   },
   "scripts_checkout_only": {
    "description": "Load Stripe.js only on the checkout page",
    "type": "boolean"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_helper_update_stripe"
}
