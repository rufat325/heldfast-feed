{
 "_meta": {
  "openai/outputTemplate": "ui://widget/hyperexecute-yaml-generator.html",
  "openai/toolInvocation/invoked": "YAML configuration generated",
  "openai/toolInvocation/invoking": "Generating HyperExecute YAML configuration...",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Generate HyperExecute YAML"
 },
 "description": "Generates a HyperExecute YAML configuration for running tests on LambdaTest's HyperExecute platform.\n\nREQUIRED fields: project (language, framework) and testing (testDiscovery.command, testRunnerCommand)\nAll other fields are OPTIONAL.\n\nSupports multiple languages and frameworks:\n- JavaScript/TypeScript: Playwright, Cypress, WebDriverIO, Puppeteer, Taiko\n- Python: Pytest, Behave, Robot Framework\n- Java: TestNG, JUnit, Cucumber\n- Ruby: RSpec, Capybara\n- C#: NUnit, xUnit, MSTest\n- Mobile (ONLY use appTesting for these): XCUI (iOS), Espresso (Android), Appium\n\nFeatures:\n- Smart framework defaults for common configurations\n- Input validation with security checks\n- Caching and artifact upload configuration\n- Git integration via sourcePayload\n- Mobile app testing support (via optional appTesting field)\n\nNOTE: For web automation (Selenium, Playwright, Cypress, etc.), do NOT include appTesting field.",
 "inputSchema": {
  "properties": {
   "advanced": {
    "additionalProperties": true,
    "description": "Advanced overrides (escape hatch for any HyperExecute field)",
    "type": "object"
   },
   "appTesting": {
    "description": "Mobile app testing configuration. ONLY for mobile testing (XCUI/Espresso/Appium). DO NOT include this for web automation tests (Selenium, Playwright, Cypress, etc.).",
    "properties": {
     "appPath": {
      "description": "Path to app file or lt:// URL",
      "type": "string"
     },
     "deviceLog": {
      "type": "boolean"
     },
     "devices": {
      "description": "Target devices (required if appTesting is used, e.g., 'iPhone 14 Pro-17')",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "framework": {
      "description": "Mobile testing framework (required if appTesting is used)",
      "enum": [
       "xcui",
       "espresso",
       "appium"
      ],
      "type": "string"
     },
     "networkLog": {
      "type": "boolean"
     },
     "testSuitePath": {
      "description": "Path to test suite",
      "type": "string"
     },
     "video": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "artifacts": {
    "description": "Artifact configuration (optional)",
    "properties": {
     "mergeArtifacts": {
      "default": true,
      "type": "boolean"
     },
     "reports": {
      "description": "Report configurations for result parsing",
      "items": {
       "properties": {
        "frameworkName": {
         "description": "Framework name for display (e.g., 'Playwright', 'pytest') - NOT the report format",
         "type": "string"
        },
        "location": {
         "description": "Path to report files",
         "type": "string"
        },
        "type": {
         "description": "Report FORMAT (not framework name). Use 'xml' for most frameworks (Playwright, Cypress, pytest, TestNG, JUnit generate XML reports). Use 'json' for Cucumber/BDD. Valid: html, json, xml, zip",
         "enum": [
          "html",
          "json",
          "xml",
          "zip"
         ],
         "type": "string"
        }
       },
       "required": [
        "type",
        "location"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "uploadPaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "execution": {
    "description": "Execution settings (optional)",
    "properties": {
     "autosplit": {
      "default": true,
      "type": "boolean"
     },
     "concurrency": {
      "default": 4,
      "maximum": 150,
      "minimum": 1,
      "type": "integer"
     },
     "globalTimeout": {
      "description": "Global timeout in minutes",
      "type": "integer"
     },
     "maxRetries": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
     },
     "os": {
      "default": "linux",
      "enum": [
       "linux",
       "win",
       "mac"
      ],
      "type": "string"
     },
     "retryOnFailure": {
      "default": false,
      "type": "boolean"
     },
     "testSuiteTimeout": {
      "description": "Test suite timeout in minutes",
      "type": "integer"
     },
     "tunnel": {
      "description": "Enable LambdaTest tunnel",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "jobLabel": {
    "description": "Labels for the job",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "project": {
    "description": "Project configuration",
    "properties": {
     "buildTool": {
      "description": "Build tool (optional, will be inferred)",
      "enum": [
       "npm",
       "yarn",
       "pnpm",
       "maven",
       "gradle",
       "pip",
       "bundler",
       "dotnet"
      ],
      "type": "string"
     },
     "framework": {
      "description": "Test framework",
      "enum": [
       "playwright",
       "cypress",
       "selenium",
       "webdriverio",
       "puppeteer",
       "taiko",
       "pytest",
       "behave",
       "robot",
       "testng",
       "junit",
       "cucumber",
       "rspec",
       "capybara",
       "nunit",
       "xunit",
       "mstest",
       "xcui",
       "espresso",
       "appium"
      ],
      "type": "string"
     },
     "language": {
      "description": "Programming language",
      "enum": [
       "javascript",
       "typescript",
       "python",
       "java",
       "ruby",
       "csharp",
       "go",
       "php"
      ],
      "type": "string"
     }
    },
    "required": [
     "language",
     "framework"
    ],
    "type": "object"
   },
   "setup": {
    "description": "Setup configuration (optional)",
    "properties": {
     "cacheDirectories": {
      "description": "Directories to cache",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "cacheKey": {
      "description": "Cache key pattern",
      "type": "string"
     },
     "env": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "Environment variables",
      "type": "object"
     },
     "postCommands": {
      "description": "Commands to run after tests",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "preCommands": {
      "description": "Commands to run before tests (e.g., npm install)",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "runtime": {
      "description": "Runtime configuration",
      "properties": {
       "language": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "sourcePayload": {
    "description": "Git integration - ONLY include this if the user explicitly requests fetching code from a remote Git repository. Do NOT include this when code is already present locally (which is the default case). Most users run tests on local code and do not need sourcePayload.",
    "properties": {
     "accessToken": {
      "description": "Use env var reference: ${GIT_TOKEN}",
      "type": "string"
     },
     "gitProvider": {
      "enum": [
       "github",
       "gitlab",
       "bitbucket",
       "azure"
      ],
      "type": "string"
     },
     "link": {
      "description": "Repository URL",
      "type": "string"
     },
     "platform": {
      "enum": [
       "git"
      ],
      "type": "string"
     },
     "ref": {
      "description": "Branch/tag/commit",
      "type": "string"
     }
    },
    "required": [
     "platform",
     "link",
     "ref"
    ],
    "type": "object"
   },
   "testing": {
    "description": "Test configuration",
    "properties": {
     "testDiscovery": {
      "properties": {
       "command": {
        "description": "Command to discover tests (e.g., find tests -name '*.spec.ts')",
        "type": "string"
       },
       "mode": {
        "default": "dynamic",
        "enum": [
         "dynamic",
         "static"
        ],
        "type": "string"
       },
       "type": {
        "default": "raw",
        "enum": [
         "raw",
         "automatic"
        ],
        "type": "string"
       }
      },
      "required": [
       "command"
      ],
      "type": "object"
     },
     "testRunnerCommand": {
      "description": "Command to run tests. Use $test placeholder for test identifier.",
      "type": "string"
     }
    },
    "required": [
     "testDiscovery",
     "testRunnerCommand"
    ],
    "type": "object"
   }
  },
  "required": [
   "project",
   "testing"
  ],
  "type": "object"
 },
 "name": "generateHyperExecuteYAML",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Generate HyperExecute YAML"
}
