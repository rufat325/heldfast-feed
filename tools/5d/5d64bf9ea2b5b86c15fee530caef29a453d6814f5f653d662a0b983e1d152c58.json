{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get one law, regulation, standard, framework or guidance, and the TCLP content citing it.\n\n    Versions are not tracked yet, so every citation has `staleness: \"unpinned\"`:\n    the content cites the instrument without naming a version. There is no\n    description yet; do not supply one from your own knowledge, and do not state\n    the instrument's legal effect.\n\n    Args:\n        work_id: The instrument's `work_id`, from `find_legal_resources` or from a\n            search result's \"references\".\n        citing_limit: Maximum citing content items to return (1\u2013100, default 20).\n\n    Returns:\n        JSON with \"resource\", \"citing\" (each with id, title, url, content_type,\n        edge, staleness) and \"citing_total\". `edge` (governs, references,\n        describes) says how the content relates to the instrument; it is not a\n        statement of the instrument's legal effect.\n    ",
 "inputSchema": {
  "properties": {
   "citing_limit": {
    "default": 20,
    "title": "Citing Limit",
    "type": "integer"
   },
   "work_id": {
    "title": "Work Id",
    "type": "string"
   }
  },
  "required": [
   "work_id"
  ],
  "title": "get_legal_resourceArguments",
  "type": "object"
 },
 "name": "get_legal_resource",
