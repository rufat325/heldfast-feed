{
 "description": "Create a new Meta Ads campaign. Created PAUSED for safety \u2014 no money spent until you activate it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_account_id": {
    "description": "Meta ad account ID",
    "type": "string"
   },
   "daily_budget": {
    "description": "Daily budget in dollars",
    "type": "number"
   },
   "lifetime_budget": {
    "description": "Lifetime budget in dollars (alternative to daily)",
    "type": "number"
   },
   "name": {
    "description": "Campaign name",
    "type": "string"
   },
   "objective": {
    "description": "Campaign objective",
    "enum": [
     "OUTCOME_TRAFFIC",
     "OUTCOME_ENGAGEMENT",
     "OUTCOME_LEADS",
     "OUTCOME_SALES",
     "OUTCOME_AWARENESS"
    ],
    "type": "string"
   }
  },
  "required": [
   "ad_account_id",
   "name",
   "objective"
  ],
  "type": "object"
 },
 "name": "meta_ads_create_campaign"
}
