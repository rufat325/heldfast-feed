{
 "description": "Audit sitemap coverage, orphan-page candidates, important URLs, canonical/indexability noise, and internal-link gaps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "crawl_urls": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonical_url": {
       "format": "uri",
       "type": "string"
      },
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "impressions": {
       "minimum": 0,
       "type": "number"
      },
      "inbound_internal_links": {
       "minimum": 0,
       "type": "integer"
      },
      "indexable": {
       "default": true,
       "type": "boolean"
      },
      "source": {
       "maxLength": 80,
       "type": "string"
      },
      "status_code": {
       "maximum": 599,
       "minimum": 100,
       "type": "integer"
      },
      "title": {
       "maxLength": 180,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "important_urls": {
    "default": [],
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "internal_links": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "anchor": {
       "maxLength": 160,
       "type": "string"
      },
      "source_url": {
       "format": "uri",
       "type": "string"
      },
      "target_url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "source_url",
      "target_url"
     ],
     "type": "object"
    },
    "maxItems": 20000,
    "type": "array"
   },
   "max_sitemap_children": {
    "default": 3,
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "sitemap_url": {
    "format": "uri",
    "type": "string"
   },
   "sitemap_xml": {
    "maxLength": 2000000,
    "minLength": 80,
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "agentseo_site_sitemap_audit",
 "title": "AgentSEO Sitemap Audit"
}
