{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Liste tous les backups disponibles (par type ou tous)",
 "inputSchema": {
  "properties": {
   "all": {
    "default": false,
    "type": "boolean"
   },
   "detailed": {
    "default": false,
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "sort": {
    "default": "date",
    "enum": [
     "date",
     "type",
     "size"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "timeshift",
     "borg",
     "vm-snapshot",
     "manual"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "backup_list"
}
