{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find launch directories"
 },
 "description": "Filter 1,666 startup, SaaS and AI directories by category, minimum Ahrefs DR, link type (dofollow/nofollow), price and badge-swap requirement. Returns submit URLs. Link type and price are \"unknown\" where nobody has verified them yet - treat those as unverified, not as free or dofollow.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Directory category",
    "enum": [
     "AI Tools",
     "Community",
     "Design Tools",
     "Developer Tools",
     "General Directory",
     "Launchpad",
     "Marketing Tools",
     "Marketplace",
     "Open Source",
     "SaaS Tools",
     "Software Discovery",
     "Software Reviews",
     "Tech / Startups"
    ],
    "type": "string"
   },
   "exclude_badge_exchange": {
    "default": false,
    "description": "Drop directories whose free listing requires their badge on your site",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Results per page",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "link_type": {
    "default": "any",
    "description": "dofollow = verified followed link",
    "enum": [
     "any",
     "dofollow",
     "nofollow"
    ],
    "type": "string"
   },
   "min_dr": {
    "default": 0,
    "description": "Minimum Ahrefs Domain Rating",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Skip this many results (pagination)",
    "minimum": 0,
    "type": "integer"
   },
   "pricing": {
    "default": "any",
    "description": "free_or_freemium = there is a no-cost route",
    "enum": [
     "any",
     "free",
     "free_or_freemium",
     "paid"
    ],
    "type": "string"
   },
   "query": {
    "description": "Match against directory name or domain, e.g. \"hunt\" or \"betalist\"",
    "type": "string"
   },
   "sort": {
    "default": "dr",
    "description": "dr = strongest first",
    "enum": [
     "dr",
     "name"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_launch_directories",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "dataUpdatedAt": {
    "description": "Date link type and price were last swept (YYYY-MM-DD). DR has its own date per row.",
    "type": "string"
   },
   "directories": {
    "items": {
     "properties": {
      "badgeExchange": {
       "description": "The free listing asks for their badge on your site",
       "type": "boolean"
      },
      "category": {
       "type": "string"
      },
      "domain": {
       "type": "string"
      },
      "dr": {
       "description": "Ahrefs Domain Rating; 0 means no data, not worthless",
       "type": "integer"
      },
      "drCheckedAt": {
       "description": "Day the DR was last checked (YYYY-MM-DD); null = value from the last list sweep",
       "type": [
        "string",
        "null"
       ]
      },
      "linkType": {
       "enum": [
        "dofollow",
        "nofollow",
        "unknown"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "note": {
       "description": "Hand-written verdict, present on curated picks only",
       "type": "string"
      },
      "pricing": {
       "enum": [
        "free",
        "freemium",
        "paid",
        "unknown"
       ],
       "type": "string"
      },
      "submitUrl": {
       "description": "Where to submit or list",
       "type": "string"
      }
     },
     "required": [
      "name",
      "domain",
      "submitUrl",
      "dr",
      "linkType",
      "pricing",
      "category",
      "badgeExchange",
      "drCheckedAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "offset": {
    "type": "integer"
   },
   "total": {
    "description": "Matches before pagination",
    "type": "integer"
   }
  },
  "required": [
   "total",
   "offset",
   "directories",
   "dataUpdatedAt",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Find launch directories"
}
