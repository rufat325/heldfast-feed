{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing prompt and create a new archived version. Only provided fields change, and publish_prompt is what makes the new version active. For multi-message chat prompts pass messages (preferred) or a JSON-encoded array as string.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collection_id": {
    "description": "Move to a different collection",
    "type": "string"
   },
   "dry_run": {
    "description": "When true, validate without updating",
    "type": "boolean"
   },
   "functions": {
    "description": "New function definitions",
    "items": {
     "properties": {
      "description": {
       "description": "Function description",
       "type": "string"
      },
      "name": {
       "description": "Function name",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "description": "Function parameters schema",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_raw_template": {
    "description": "Enable or disable raw structural-template rendering",
    "type": "boolean"
   },
   "messages": {
    "description": "Structured chat template alias for updates. Serialized to the legacy string format before the prompt is updated.",
    "items": {
     "additionalProperties": {},
     "description": "Structured chat message in a prompt template",
     "properties": {
      "content": {
       "description": "Message content blocks",
       "items": {
        "additionalProperties": {},
        "description": "Content block within a structured chat message",
        "properties": {
         "text": {
          "description": "Text content for text-based blocks",
          "type": "string"
         },
         "type": {
          "description": "Content block type",
          "type": "string"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "role": {
       "description": "Message role in the chat template",
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "description": "New model identifier",
    "type": "string"
   },
   "name": {
    "description": "New display name for the prompt",
    "type": "string"
   },
   "parameters": {
    "additionalProperties": {},
    "description": "New default values for template variables",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "prompt_id": {
    "description": "Prompt ID or slug to update",
    "type": "string"
   },
   "string": {
    "description": "Legacy prompt template string. Use plain text for single-message prompts, or a JSON-encoded messages array string for multi-message chat prompts.",
    "type": "string"
   },
   "template_metadata": {
    "additionalProperties": {},
    "description": "New metadata",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "tool_choice": {
    "description": "New tool choice strategy",
    "properties": {
     "function_name": {
      "description": "Required when mode is 'function'; ignored otherwise",
      "type": "string"
     },
     "mode": {
      "description": "Tool choice mode: auto lets the model decide, none disables tool use, function forces one function by name",
      "enum": [
       "auto",
       "none",
       "function"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode"
    ],
    "type": "object"
   },
   "tools": {
    "description": "New tool definitions",
    "items": {
     "properties": {
      "function": {
       "description": "Function definition",
       "properties": {
        "description": {
         "description": "Function description",
         "type": "string"
        },
        "name": {
         "description": "Function name",
         "type": "string"
        },
        "parameters": {
         "additionalProperties": {},
         "description": "Function parameters schema",
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "type": {
       "const": "function",
       "description": "Tool type",
       "type": "string"
      }
     },
     "required": [
      "type",
      "function"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "version_description": {
    "description": "Description for this version",
    "type": "string"
   },
   "virtual_key": {
    "description": "New virtual key slug",
    "type": "string"
   }
  },
  "required": [
   "prompt_id"
  ],
  "type": "object"
 },
 "name": "update_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
