{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show keyword rank history"
 },
 "description": "Use this when someone asks how their app's ranking for a keyword has changed over time in one store and country. Returns the app's rank on each date AppSkyline stored a search snapshot, newest first, up to 365 rows; tracked keywords are re-checked weekly. Not for today's live rank.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "country": {
    "description": "Two-letter store country code such as US or IT (required)",
    "maxLength": 10,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Snapshots to return, newest first, from 1 to 365; defaults to 365",
    "exclusiveMinimum": 0,
    "maximum": 365,
    "type": "integer"
   },
   "store": {
    "description": "Store to read: ios-app-store, macos-app-store, google-play or microsoft-store; the app needs an id on that store",
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "term": {
    "description": "Search term to read history for, 1 to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "appId",
   "store",
   "term",
   "country"
  ],
  "type": "object"
 },
 "name": "get_keyword_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "app": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "country": {
    "anyOf": [
     {
      "maxLength": 10,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "returned": {
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "snapshots": {
    "description": "One row per stored search snapshot, newest first; rank is null when the app was not in that snapshot",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "anyOf": [
        {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "rank": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 200,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "resultsScanned": {
       "maximum": 200,
       "minimum": 0,
       "type": "integer"
      },
      "resultsTruncated": {
       "type": "boolean"
      }
     },
     "required": [
      "date",
      "rank",
      "resultsScanned",
      "resultsTruncated"
     ],
     "type": "object"
    },
    "maxItems": 365,
    "type": "array"
   },
   "status": {
    "enum": [
     "found",
     "app-not-found",
     "store-not-configured",
     "no-history"
    ],
    "type": "string"
   },
   "store": {
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "term": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "totalSnapshots": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "totalSnapshotsIsLowerBound": {
    "type": "boolean"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "app",
   "store",
   "term",
   "country",
   "snapshots",
   "returned",
   "totalSnapshots",
   "totalSnapshotsIsLowerBound",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Show keyword rank history"
}
