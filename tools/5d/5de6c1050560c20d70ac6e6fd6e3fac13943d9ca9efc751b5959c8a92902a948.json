{
 "description": "Replace cell content with text parsed from inline markdown. Supports [label](url) links, bare URLs, **bold**, *italic*, ~~strikethrough~~ \u2014 the only way to put MULTIPLE clickable links in one cell. Block syntax (headers, lists, tables) and other unsupported markdown is written as literal text. Writes text cells only \u2014 no formula or number coercion. For whole-cell formatting (colors, borders, number formats) use cells-format.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "requests": {
    "description": "Array of cell markdown requests. Batch multiple cells for efficiency.",
    "items": {
     "properties": {
      "cell": {
       "description": "Single-cell A1 reference (e.g., \"I2\"). Multi-cell ranges (e.g., \"A1:B2\") are rejected as a per-request failure.",
       "minLength": 1,
       "type": "string"
      },
      "text": {
       "description": "Cell content as inline markdown: [label](url) links, bare URLs, **bold**, *italic*, ~~strikethrough~~. Block syntax and other unsupported markdown is written as literal text.",
       "type": "string"
      }
     },
     "required": [
      "cell",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "gid",
   "requests"
  ],
  "type": "object"
 },
 "name": "values-markdown-update",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "cells": {
        "description": "Cells successfully written",
        "items": {
         "additionalProperties": false,
         "properties": {
          "cell": {
           "description": "A1 reference of the cell that was written",
           "type": "string"
          },
          "linkCount": {
           "description": "Number of clickable links written into the cell",
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "text": {
           "description": "Resolved plain text written to the cell (markdown syntax stripped/literalized)",
           "type": "string"
          }
         },
         "required": [
          "cell",
          "text",
          "linkCount"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "failedCells": {
        "description": "Only populated if some cells failed",
        "items": {
         "additionalProperties": false,
         "properties": {
          "cell": {
           "description": "A1 reference that failed",
           "type": "string"
          },
          "error": {
           "description": "Why the cell failed (e.g., not a single-cell reference)",
           "type": "string"
          }
         },
         "required": [
          "cell",
          "error"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Title of the updated sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the updated sheet",
        "type": "string"
       },
       "successCount": {
        "description": "Number of cells successfully written",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "sheetTitle",
       "sheetUrl",
       "successCount",
       "cells"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
