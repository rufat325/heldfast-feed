{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update the TLS version and cipher profile of a Global Edge certificate slot",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cipherProfile": {
    "description": "Cipher profile (STRICT not allowed with TLS_ALL_VERSIONS)",
    "enum": [
     "DEFAULT",
     "GENERAL",
     "STRICT"
    ],
    "type": "string"
   },
   "slotId": {
    "description": "Certificate slot ID",
    "type": "number"
   },
   "tlsVersion": {
    "description": "Supported TLS versions",
    "enum": [
     "TLS_ALL_VERSIONS",
     "TLS_MIN_VERSION_1_2"
    ],
    "type": "string"
   }
  },
  "required": [
   "slotId",
   "tlsVersion",
   "cipherProfile"
  ],
  "type": "object"
 },
 "name": "ncloud_edge_update_certificate_tls"
}
