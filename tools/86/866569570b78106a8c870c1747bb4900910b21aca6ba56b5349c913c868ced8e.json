{
 "_meta": {
  "openai/toolInvocation/invoked": "Badge check complete",
  "openai/toolInvocation/invoking": "Checking badge eligibility\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to show a site's Agent Readiness badge on that site. Scores the site if needed, then returns the HTML snippet for sites at grade C or better (bronze, silver or gold), or the reason and the first fixes when the site is not eligible. Returns HTML to paste; it installs nothing and runs no script.",
 "inputSchema": {
  "properties": {
   "url": {
    "description": "Public http(s) address, for example example.com",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "get_badge_embed",
 "outputSchema": {
  "else": {
   "required": [
    "reason",
    "fixFirst",
    "reportUrl"
   ]
  },
  "if": {
   "properties": {
    "eligible": {
     "const": true
    }
   }
  },
  "properties": {
   "badgePage": {
    "format": "uri",
    "type": "string"
   },
   "eligible": {
    "type": "boolean"
   },
   "fixFirst": {
    "items": {
     "properties": {
      "fix": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "fix"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "grade": {
    "type": "string"
   },
   "host": {
    "type": "string"
   },
   "html": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "reportUrl": {
    "format": "uri",
    "type": "string"
   },
   "score": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "tier": {
    "type": "string"
   },
   "watchIt": {
    "type": "string"
   }
  },
  "required": [
   "eligible",
   "host",
   "score",
   "grade"
  ],
  "then": {
   "required": [
    "tier",
    "html",
    "note",
    "badgePage"
   ]
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get the badge embed"
}
