{
 "description": "Create UI blocks using frappe-ui and Tailwind CSS patterns",
 "inputSchema": {
  "properties": {
   "block_type": {
    "description": "Type of UI block to create",
    "enum": [
     "hero",
     "features",
     "pricing",
     "contact",
     "footer",
     "navbar",
     "sidebar",
     "card",
     "form"
    ],
    "type": "string"
   },
   "customization": {
    "description": "Specific customization requirements",
    "type": "string"
   },
   "theme": {
    "default": "light",
    "description": "Theme for the block",
    "enum": [
     "light",
     "dark",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "block_type"
  ],
  "type": "object"
 },
 "name": "frappe_create_ui_block"
}
