{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Confirm bulk automation rule changes"
 },
 "description": "Switch rules on, off or delete them. First use mode=preview with rule_ids or filter. Show the affected rules and skipped rules to the user and get explicit confirmation BEFORE applying. Then use mode=apply with only the exact rule_ids returned by preview; never reapply the filter. Pick a step rules are skipped when switching on. Warn that shared pipeline rules change for every job on that pipeline, including jobs outside the filter.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "on",
     "off",
     "delete"
    ],
    "type": "string"
   },
   "filter": {
    "additionalProperties": false,
    "properties": {
     "department_id": {
      "minLength": 1,
      "type": "string"
     },
     "email": {
      "minLength": 1,
      "type": "string"
     },
     "is_active": {
      "type": "boolean"
     },
     "job_id": {
      "minLength": 1,
      "type": "string"
     },
     "pipeline_id": {
      "minLength": 1,
      "type": "string"
     },
     "trigger": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "enum": [
     "preview",
     "apply"
    ],
    "type": "string"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "rule_ids": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "action",
   "mode"
  ],
  "type": "object"
 },
 "name": "yardstick_automation_rules_bulk",
 "title": "Confirm bulk automation rule changes"
}
