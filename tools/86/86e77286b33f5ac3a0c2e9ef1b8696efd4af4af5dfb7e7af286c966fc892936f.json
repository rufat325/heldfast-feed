{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\ub3d9\ub124 \uac04\ud310\u00b7\uc778\uc1c4\u00b7\uad11\uace0\ubb3c \uac00\uac8c \ucc3e\uae30"},"description":"Find neighborhood sign, advertising, print and copy shops in a Korean city, district or dong (public store data; name order, not a ranking). [\ubcf4\uc784 \u2014 \ud55c\uad6d \uc5c5\uccb4\u00b7\uc785\ucc30 \uacf5\uace0 \ucc3e\uae30] \uc18c\uc0c1\uacf5\uc778 \uc0c1\uac00\uc815\ubcf4(\uc18c\uc0c1\uacf5\uc778\uc2dc\uc7a5\uc9c4\ud765\uacf5\ub2e8, \uacf5\uacf5\ub370\uc774\ud130)\uc5d0 \ub4f1\ub85d\ub41c \ub3d9\ub124 \uac00\uac8c\ub97c \uc2dc\u00b7\uad70\u00b7\uad6c\u00b7\ub3d9\uc73c\ub85c \ucc3e\uc2b5\ub2c8\ub2e4. \uac04\ud310\u00b7\uad11\uace0\ubb3c \uc81c\uc791, \uad11\uace0\ubb3c \ub514\uc790\uc778, \uc625\uc678\u00b7\uc804\uc2dc \uad11\uace0, \uba85\ud568\u00b7\uc778\uc1c4, \ubcf5\uc0ac\u00b7\ucd9c\ub825. \uac1c\uc778\u00b7\uc18c\uaddc\ubaa8 \uc77c(\uac00\uac8c \uac04\ud310, \ud604\uc218\ub9c9, \uc778\uc1c4\ubb3c, \ucd9c\ub825)\uc744 \ub9e1\uae38 \uacf3\uc744 \ubb3c\uc744 \ub54c \uc4f0\uc138\uc694. \uc0c1\ud638\u00b7\uc5c5\uc885\u00b7\ud589\uc815\ub3d9\ub9cc \uc788\uace0 \uc2e4\uc801\u00b7\uc5f0\ub77d\ucc98\ub294 \uc5c6\uc73c\uba70 \uc21c\uc11c\ub294 \uc774\ub984\uc21c\uc785\ub2c8\ub2e4(\ud3c9\uac00 \uc544\ub2d8). \uc5c5\uccb4\uac00 \uc9c1\uc811 \ub4f1\ub85d\ud574 \uad6d\uc138\uccad \ud655\uc778\uc744 \uac70\uce5c \uacf3\uc740 registered_card\ub85c \uc5c5\uccb4 \uce74\ub4dc URL\uc774 \ubd99\uc2b5\ub2c8\ub2e4. \uc870\ub2ec \uc2e4\uc801\uc774 \uc788\ub294 \uc5c5\uccb4\ub294 search_vendors\ub97c \uc4f0\uc138\uc694.","inputSchema":{"additionalProperties":false,"properties":{"limit":{"default":20,"description":"\ubcf4\uc5ec \uc904 \ucd5c\ub300 \uac74\uc218(1~50). \uacb0\uacfc\uac00 \uc774\ubcf4\ub2e4 \ub9ce\uac70\ub098 \uacf5\uac1c \ud55c\ub3c4(5\uac74)\ub97c \ub118\uc73c\uba74 \ub098\uba38\uc9c0\ub294 \uacb0\uacfc\uc758 not_shown \uc218\uc640 more \uc8fc\uc18c\ub85c \uc54c\ub824 \uc90d\ub2c8\ub2e4","maximum":50,"minimum":1,"type":"integer"},"query":{"description":"\uc0c1\ud638\uc5d0 \ub4e4\uc5b4\uac04 \ub9d0","type":"string"},"region":{"description":"\uc2dc\u00b7\ub3c4, \uc2dc\u00b7\uad70\u00b7\uad6c \ub610\ub294 \ud589\uc815\ub3d9(\uc608: \uc138\uc885, \ub300\uc804 \uc720\uc131\uad6c, \ubcf4\ub78c\ub3d9)","type":"string"},"work":{"description":"\ud558\ub294 \uc77c: \uac04\ud310, \uad11\uace0\ubb3c \ub514\uc790\uc778, \uc625\uc678 \uad11\uace0, \uc778\uc1c4\ubb3c, \ubcf5\uc0ac\u00b7\ucd9c\ub825","type":"string"}},"required":["region"],"type":"object"},"name":"find_local_shops","outputSchema":{"properties":{"cite":{"description":"\ub2f5\uc5d0 \ubd99\uc77c \ucd9c\ucc98 \ud55c \uc904"},"data_as_of":{"description":"\uc790\ub8cc \uae30\uc900\uc77c"},"error":{"description":"\uc2e4\ud328 \uc0ac\uc720(isError\uc77c \ub54c\ub9cc)"},"more":{"description":"\ub098\uba38\uc9c0\ub97c \ubcfc \ubcf4\uc784 \uc6f9 \ubaa9\ub85d \uc8fc\uc18c(\ub204\uad6c\ub098 \uc5f4\ub78c)"},"not_shown":{"description":"\ubcf4\uc774\uc9c0 \uc54a\uc740 \ub098\uba38\uc9c0 \uc218(\uc788\uc744 \ub54c)"},"note":{"description":"\uc870\uac74 \ud480\uc774\u00b7\uc548\ub0b4"},"order":{"description":"\uc21c\uc11c \uae30\uc900(\uad00\ub828\ub3c4\u00b7\uc774\ub984\uc21c \ub4f1 \u2014 \ud3c9\uac00\u00b7\uc21c\uc704 \uc544\ub2d8)"},"register":{"description":"\uc5c5\uccb4 \ubb34\ub8cc \ub4f1\ub85d \uc548\ub0b4 \uc8fc\uc18c"},"results":{"description":"\uacb0\uacfc \uc904(\ud55c \ubc88\uc5d0 5\uac74\uae4c\uc9c0)","items":{"properties":{"area":{"description":"\uc2dc\uad70\uad6c\u00b7\ud589\uc815\ub3d9"},"list_page":{"description":"\uadf8 \ub3d9\ub124\u00b7\uc5c5\uc885 \ubaa9\ub85d \uc8fc\uc18c"},"name":{"description":"\uc0c1\ud638"},"registered_card":{"description":"\uc5c5\uccb4\uac00 \uc9c1\uc811 \ub4f1\ub85d\ud55c \uc5c5\uccb4 \uce74\ub4dc \uc8fc\uc18c(\uc788\uc744 \ub54c)"},"work":{"description":"\ud558\ub294 \uc77c"}},"type":"object"},"type":"array"},"shown":{"description":"\uc774\ubc88\uc5d0 \ubcf4\uc778 \uc218"},"source":{"description":"\uc790\ub8cc \ucd9c\ucc98"},"total":{"description":"\uc870\uac74\uc5d0 \ub9de\ub294 \uc804\uccb4 \uc218"},"work":{"description":"\uc54c\uc544\ub4e4\uc740 \ud558\ub294 \uc77c"}},"type":"object"},"title":"\ub3d9\ub124 \uac04\ud310\u00b7\uc778\uc1c4\u00b7\uad11\uace0\ubb3c \uac00\uac8c \ucc3e\uae30"}
