 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commitSha": {
    "description": "Git commit SHA",
    "type": "string"
   },
   "deployedBy": {
    "description": "Who deployed (name, email, or system)",
    "type": "string"
   },
   "description": {
    "description": "Deployment description or changelog",
    "type": "string"
   },
   "environment": {
    "description": "Environment, e.g. \"production\", \"staging\"",
    "type": "string"
   },
   "targetId": {
    "description": "The target ID",
    "type": "string"
   },
   "version": {
    "description": "Version string, e.g. \"v2.4.1\"",
    "type": "string"
   }
  },
  "required": [
