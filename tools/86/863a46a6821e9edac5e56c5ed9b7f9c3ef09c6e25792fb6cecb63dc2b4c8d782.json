  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find Signals"
 },
 "description": "Screens for stocks or fund moves matching a signal type. Use this when the user wants a list, not a single stock.\n\nWHEN TO USE: User asks for a screen, list, or \"what's interesting right now\". Types:\n  - convergence: stocks with institutional coverage where 2+ available filing-source signals align\n  - conviction: highest-conviction recent moves\n  - double_downs: positions increased while price fell\n  - new_positions: fresh entries this quarter\n  - smart_money_buying: stocks with strictly positive conviction-weighted institutional sentiment\n  - early_birds: first-mover funds discovering new positions\n\nExamples:\n  - \"Show me stocks where smart money is converging\"\n  - \"What are the highest conviction buys this quarter?\"\n  - \"Which funds are doubling down into price weakness?\"\n\nWHEN NOT TO USE:\n  - Use analyze_stock when the user names a specific stock\n\nPARAMETERS: sector applies only to convergence; quarter is unavailable for convergence and otherwise defaults to the newest default-ready 13F quarter; min_score is unavailable for early_birds. smart_money_buying always requires conviction_weighted_sentiment > 0, even when min_score is omitted or zero. Unsupported combinations are rejected, never ignored.\n\nRETURNS: A cursor-paginated ranked list with the relevant score and source metrics, a filing period for quarter-bound types, and an exact total when the underlying dataset supports one. Convergence is a mixed-source snapshot; because its backing view exposes no exact common data-through date, provenance returns null and data_status states that limitation.\n\nVERIFICATION: Cite record-level `source_url` filing or disclosure links when present.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "required": [
      "sector"
     ]
    },
    "then": {
     "properties": {
      "type": {
       "const": "convergence"
      }
     }
    }
   },
   {
    "if": {
     "required": [
      "quarter"
     ]
    },
    "then": {
     "properties": {
      "type": {
       "not": {
        "const": "convergence"
       }
      }
     }
    }
   },
   {
    "if": {
     "required": [
      "min_score"
     ]
    },
    "then": {
     "properties": {
      "type": {
       "not": {
        "const": "early_birds"
       }
      }
     }
    }
   }
  ],
  "properties": {
   "cursor": {
    "maxLength": 500,
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "quarter": {
    "pattern": "^\\d{4}-Q[1-4]$",
    "type": "string"
   },
   "sector": {
    "maxLength": 50,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 &/\\-]+$",
    "type": "string"
   },
   "type": {
    "description": "Signal taxonomy; convergence includes only aligned 2+ source composites with institutional coverage, and smart_money_buying requires conviction_weighted_sentiment > 0.",
    "enum": [
     "convergence",
     "conviction",
     "double_downs",
     "new_positions",
     "smart_money_buying",
     "early_birds"
    ],
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
