{
 "description": "Start a NEW Codex session seeded with the previous worker's prompt, status, and recent events. To continue the same session instead, use resume_codex_worker.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptance": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "additionalProperties": false,
         "properties": {
          "baseline": {
           "additionalProperties": false,
           "properties": {
            "failures": {
             "items": {
              "additionalProperties": false,
              "properties": {
               "kind": {
                "enum": [
                 "failure",
                 "error"
                ],
                "type": "string"
               },
               "signature": {
                "minLength": 1,
                "type": "string"
               },
               "test_id": {
                "minLength": 1,
                "type": "string"
               }
              },
              "required": [
               "test_id",
               "kind",
               "signature"
              ],
              "type": "object"
             },
             "type": "array"
            },
            "identity": {
             "additionalProperties": {
              "minLength": 1,
              "type": "string"
             },
             "properties": {
              "base_commit": {
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "base_commit"
             ],
             "type": "object"
            },
            "required": {
             "items": {
              "minLength": 1,
              "type": "string"
             },
             "type": "array"
            }
           },
           "required": [
            "identity",
            "failures",
            "required"
           ],
           "type": "object"
          },
          "command": {
           "minLength": 1,
           "type": "string"
          },
          "reportPath": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "command",
          "reportPath",
          "baseline"
         ],
         "type": "object"
        }
       ]
      },
      "maxItems": 10,
      "type": "array"
     }
    ]
   },
   "acceptanceTimeoutMs": {
    "maximum": 1800000,
    "minimum": 1000,
    "type": "integer"
   },
   "allowedCommands": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "baseRef": {
    "minLength": 1,
    "type": "string"
   },
   "context": {
    "items": {
     "properties": {
      "path": {
       "minLength": 1,
       "type": "string"
      },
      "sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "contracts": {
    "items": {
     "maxLength": 2000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "cwd": {
    "type": "string"
   },
   "externalOutputs": {
    "items": {
     "properties": {
      "path": {
       "minLength": 1,
       "type": "string"
      },
      "sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "followup_prompt": {
    "minLength": 1,
    "type": "string"
   },
   "forbid": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "goal": {
    "properties": {
     "objective": {
      "minLength": 1,
      "type": "string"
     },
     "tokenBudget": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "objective"
    ],
    "type": "object"
   },
   "maxRunMs": {
    "maximum": 86400000,
    "minimum": 1000,
    "type": "integer"
   },
   "maxTotalMs": {
    "maximum": 604800000,
    "minimum": 1000,
    "type": "integer"
   },
   "model": {
    "type": "string"
   },
   "networkAccess": {
    "type": "boolean"
   },
   "ownedPaths": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "reasoningEffort": {
    "default": "high",
    "enum": [
     "minimal",
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "sandbox": {
    "enum": [
     "read-only",
     "workspace-write",
     "danger-full-access"
    ],
    "type": "string"
   },
   "session_id": {
    "minLength": 1,
    "type": "string"
   },
   "session_note": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "session_title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "task_id": {
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "writableRoots": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "task_id",
   "followup_prompt"
  ],
  "type": "object"
 },
 "name": "create_codex_followup_worker",
 "title": "Create Codex follow-up worker"
}
