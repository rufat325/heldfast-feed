{
 "description": "Recursive manifest diff that requires explicit versions and flags sensitive changes without a version advance; 0.002 USDC.",
 "inputSchema": {
  "examples": [
   {
    "current": {
     "tools": [],
     "version": "1.1"
    },
    "previous": {
     "tools": [],
     "version": "1.0"
    }
   }
  ],
  "properties": {
   "current": {
    "required": [
     "version"
    ],
    "type": "object"
   },
   "previous": {
    "required": [
     "version"
    ],
    "type": "object"
   }
  },
  "required": [
   "previous",
   "current"
  ],
  "type": "object"
 },
 "name": "manifest_version_diff"
}
