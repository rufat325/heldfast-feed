{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "qa",
 "description": "Validate that an LLM output matches an expected format: JSON, Markdown, code block, bullet list, numbered list, table, YAML, XML, or custom regex. Essential for structured output testing.",
 "inputSchema": {
  "properties": {
   "expected_format": {
    "description": "Expected format",
    "enum": [
     "json",
     "markdown_heading",
     "code_block",
     "bullet_list",
     "numbered_list",
     "table",
     "yaml",
     "xml",
     "regex"
    ],
    "type": "string"
   },
   "output": {
    "description": "The LLM output to validate",
    "type": "string"
   },
   "regex_pattern": {
    "description": "Custom regex pattern (only when expected_format is \"regex\")",
    "type": "string"
   }
  },
  "required": [
   "output",
   "expected_format"
  ],
  "type": "object"
 },
 "name": "llm_format_check",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "checks": {},
   "expected_format": {},
   "failed": {},
   "passed": {},
   "total_checks": {
    "type": "number"
   },
   "valid": {
    "type": "boolean"
   }
  },
  "type": "object"
 }
}
