{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate lead time (created\u2192done) and cycle time (wip\u2192done) per ticket, plus their averages (whole days; null where there is no value). Prerequisite: assign state:wip and state:done tags to tickets.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "report_times",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "averageCycleTimeDays": {
    "type": [
     "number",
     "null"
    ]
   },
   "averageLeadTimeDays": {
    "type": [
     "number",
     "null"
    ]
   },
   "tickets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cycleTimeDays": {
       "type": [
        "number",
        "null"
       ]
      },
      "leadTimeDays": {
       "type": [
        "number",
        "null"
       ]
      },
      "ticketId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticketTitle": {
       "type": "string"
      }
     },
     "required": [
      "ticketId",
      "ticketTitle",
      "leadTimeDays",
      "cycleTimeDays"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tickets",
   "averageLeadTimeDays",
   "averageCycleTimeDays"
  ],
  "type": "object"
 }
}
