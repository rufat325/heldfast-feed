{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "One course in a term from the UMD Schedule of Classes, with every section: instructors, seat counts, meeting days, times, rooms and delivery method. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "course_id": {
    "description": "Course id, e.g. \"CMSC131\" or \"ENGL101X\"",
    "pattern": "^[A-Za-z]{4}\\d{3}[A-Za-z]?$",
    "type": "string"
   },
   "term_id": {
    "description": "Four-digit year followed by \"01\" (Spring), \"05\" (Summer), \"08\" (Fall) or \"12\" (Winter), e.g. \"202608\" for Fall 2026",
    "pattern": "^\\d{4}(01|05|08|12)$",
    "type": "string"
   }
  },
  "required": [
   "term_id",
   "course_id"
  ],
  "type": "object"
 },
 "name": "testudo_soc_get_course",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "course": {
    "additionalProperties": false,
    "description": "The course and its sections",
    "properties": {
     "additional_information": {
      "description": "The catalog's \"Additional information\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "also_offered_as": {
      "description": "The catalog's \"Also offered as\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "corequisite": {
      "description": "The catalog's \"Corequisite\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "credit_only_granted_for": {
      "description": "The catalog's \"Credit only granted for\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "credits": {
      "additionalProperties": false,
      "description": "Credits the course is worth",
      "properties": {
       "max": {
        "description": "Maximum credits; equals min for a fixed-credit course",
        "type": "number"
       },
       "min": {
        "description": "Minimum credits",
        "type": "number"
       }
      },
      "required": [
       "min",
       "max"
      ],
      "type": "object"
     },
     "cross_listed_with": {
      "description": "The catalog's \"Cross-listed with\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "description": {
      "description": "Catalog description; null if none",
      "type": [
       "string",
       "null"
      ]
     },
     "formerly": {
      "description": "The catalog's \"Formerly\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "gen_ed": {
      "description": "General education requirements the course fulfills",
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "description": "General education code, e.g. \"FSAW\"",
         "type": "string"
        },
        "name": {
         "description": "Category and requirement, e.g. \"Fundamental Studies - Academic Writing\"",
         "type": "string"
        }
       },
       "required": [
        "code",
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "grading_methods": {
      "description": "Grading methods allowed, e.g. \"Regular\", \"Pass-Fail\", \"Audit\", \"Sat-Fail\"",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "description": "Course id, e.g. \"CMSC131\" or \"ENGL101X\"",
      "pattern": "^[A-Za-z]{4}\\d{3}[A-Za-z]?$",
      "type": "string"
     },
     "individual_instruction": {
      "description": "true for individual-instruction courses (independent study, research) where the department must be contacted to register",
      "type": "boolean"
     },
     "notes": {
      "description": "Term-specific notes for the course, e.g. special-topics blurbs or placement advice",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "permission_required": {
      "description": "true when the department must grant permission to register",
      "type": "boolean"
     },
     "prerequisite": {
      "description": "The catalog's \"Prerequisite\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "recommended": {
      "description": "The catalog's \"Recommended\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "restriction": {
      "description": "The catalog's \"Restriction\" note; null if there is none",
      "type": [
       "string",
       "null"
      ]
     },
     "sections": {
      "description": "Sections offered this term",
      "items": {
       "additionalProperties": false,
       "properties": {
        "delivery": {
         "description": "How the section is taught",
         "enum": [
          "face_to_face",
          "online",
          "blended"
         ],
         "type": "string"
        },
        "id": {
         "description": "Section id, e.g. \"0101\"",
         "pattern": "^[A-Za-z0-9]{4}$",
         "type": "string"
        },
        "instructors": {
         "description": "Instructor names; empty when still to be announced",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "meetings": {
         "description": "Weekly meetings of the section",
         "items": {
          "additionalProperties": false,
          "properties": {
           "building": {
            "description": "Building code, e.g. \"IRB\" (see testudo_soc_get_building); null for online or unassigned meetings",
            "type": [
             "string",
             "null"
            ]
           },
           "days": {
            "description": "Days the meeting is held, e.g. [\"M\", \"W\", \"F\"]",
            "items": {
             "enum": [
              "M",
              "Tu",
              "W",
              "Th",
              "F",
              "Sa",
              "Su"
             ],
             "type": "string"
            },
            "type": "array"
           },
           "end_time": {
            "description": "End time as printed, e.g. \"10:50am\"; null if not set",
            "type": [
             "string",
             "null"
            ]
           },
           "room": {
            "description": "Room number, e.g. \"0324\"; \"ONLINE\" for online meetings; null if unassigned",
            "type": [
             "string",
             "null"
            ]
           },
           "start_time": {
            "description": "Start time as printed, e.g. \"10:00am\"; null if not set",
            "type": [
             "string",
             "null"
            ]
           },
           "time_on_elms": {
            "description": "true when the meeting has no fixed time and the section says \"Class time/details on ELMS\"",
            "type": "boolean"
           },
           "type": {
            "description": "\"lecture\" for the main meeting, else \"discussion\" or \"lab\"",
            "enum": [
             "lecture",
             "discussion",
             "lab"
            ],
            "type": "string"
           }
          },
          "required": [
           "type",
           "days",
           "start_time",
           "end_time",
           "building",
           "room",
           "time_on_elms"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "notes": {
         "description": "Section notes, e.g. \"Restricted to students in Freshmen Connection.\"",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "seats": {
         "additionalProperties": false,
         "description": "Seat counts as of the last refresh, not real time",
         "properties": {
          "open": {
           "description": "Open seats",
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "total": {
           "description": "Total seats",
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "waitlist": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ],
           "description": "Students on the waitlist; null if not shown"
          }
         },
         "required": [
          "total",
          "open",
          "waitlist"
         ],
         "type": "object"
        }
       },
       "required": [
        "id",
        "instructors",
        "delivery",
        "seats",
        "meetings",
        "notes"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "syllabus_count": {
      "description": "Number of past syllabi in the syllabus repository (see testudo_soc_list_syllabi)",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "title": {
      "description": "Course title, e.g. \"Object-Oriented Programming I\"",
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "credits",
     "grading_methods",
     "gen_ed",
     "permission_required",
     "individual_instruction",
     "description",
     "prerequisite",
     "corequisite",
     "recommended",
     "restriction",
     "credit_only_granted_for",
     "formerly",
     "cross_listed_with",
     "also_offered_as",
     "additional_information",
     "notes",
     "syllabus_count",
     "sections"
    ],
    "type": "object"
   },
   "seats_as_of": {
    "description": "When the seat counts on this page were last refreshed, as YYYY-MM-DDTHH:MM in US Eastern time (roughly hourly); null if the page does not say",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "seats_as_of",
   "course"
  ],
  "type": "object"
 },
 "title": "Get a course with its sections"
}
