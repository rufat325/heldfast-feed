{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Locate citation positions in AI answer"
 },
 "description": "Locate where each cited URL appears in the AI's raw answer text. Calls check_citations, finds the first mention of each citation's URL (or hostname) in raw_answer, and bins by char position into early/middle/late thirds. Surfaces whether your URL is cited up-front or buried near the end. Returns 'unknown' for engines without raw_answer (Bing, Brave).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "engine": {
    "default": "auto",
    "description": "AI engine to query. web_rank engines (bing_serp, brave_serp) lack raw_answer and will return position 'unknown'.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "brave",
     "google_ai_mode",
     "auto"
    ],
    "type": "string"
   },
   "max_results": {
    "default": 10,
    "description": "Max citations to locate.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query whose AI answer to measure citation positions on.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "signals_answer_box",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "answer_chars": {
    "description": "Total length of the engine's raw answer in characters.",
    "type": "number"
   },
   "buckets": {
    "additionalProperties": false,
    "description": "Count of citations per position bucket.",
    "properties": {
     "early": {
      "type": "number"
     },
     "late": {
      "type": "number"
     },
     "middle": {
      "type": "number"
     },
     "unknown": {
      "type": "number"
     }
    },
    "required": [
     "early",
     "middle",
     "late",
     "unknown"
    ],
    "type": "object"
   },
   "citations_total": {
    "description": "Total citations returned by the engine.",
    "type": "number"
   },
   "engine": {
    "description": "Engine used.",
    "type": "string"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "positions": {
    "description": "Per-citation position in the AI answer.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "first_mention_char": {
       "description": "Character offset of first mention in raw_answer.",
       "type": [
        "number",
        "null"
       ]
      },
      "position": {
       "description": "Third of the answer where the URL first appears.",
       "enum": [
        "early",
        "middle",
        "late",
        "unknown"
       ],
       "type": "string"
      },
      "rank": {
       "type": "number"
      },
      "title": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "rank",
      "first_mention_char",
      "position"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "The query that was tested.",
    "type": "string"
   }
  },
  "required": [
   "query",
   "engine",
   "fetched_at",
   "answer_chars",
   "citations_total",
   "positions",
   "buckets"
  ],
  "type": "object"
 }
}
