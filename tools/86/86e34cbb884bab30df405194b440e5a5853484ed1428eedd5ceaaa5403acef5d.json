{"_meta":{"openai/outputTemplate":"ui://teasa/story-v1.html","securitySchemes":[{"type":"noauth"},{"scopes":["roleplay"],"type":"oauth2"}],"ui":{"resourceUri":"ui://teasa/story-v1.html"}},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Start a saved Teasa conversation for a story selected by the user. Explicitly supply the selected translation language; this controls the opening and every model reply even when the original story has another source language. No browser authorization or signup required: without OAuth or guestSession, creates a free guest and returns guestSession. Retain it privately; pass it on ALL subsequent tools, retries and pages. Guest access lasts 24 hours. Reuse requestId with guestSession for retries; if cards.nextPage is present, repeat start_story with the same requestId, language and that page. Returns the opening, branchId and branchVersion. No inference is charged for the opening.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"guestSession":{"description":"Restricted guest credential returned by start_story. Retain privately and pass on every later call, retry and page. Never put it in a URL.","pattern":"^[a-f0-9]{64}$","type":"string"},"language":{"description":"Required reading and reply language: en=English, ja=Japanese, ko=Korean, zh=Chinese, es=Spanish. Use the user-selected translation or their requested conversation language, not the story source language. Pass the same language from search_stories to start_story, including retries and pages.","enum":["en","ja","ko","zh","es"],"type":"string"},"output":{"default":"image","enum":["image","text","app"],"type":"string"},"page":{"default":0,"maximum":1000,"minimum":0,"type":"integer"},"publicationId":{"maxLength":180,"minLength":1,"pattern":"^[\\w:.-]+$","type":"string"},"requestId":{"maxLength":100,"minLength":8,"type":"string"}},"required":["p