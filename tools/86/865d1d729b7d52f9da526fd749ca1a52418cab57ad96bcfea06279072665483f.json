{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Indicative buy/sell quote for a listed meme coin from GET /api/quote. Does not execute. Next step: memeswap_build. Quotes can expire; request a fresh quote before build.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Positive decimal string",
    "pattern": "^\\d*\\.?\\d+$",
    "type": "string"
   },
   "chain": {
    "maxLength": 32,
    "minLength": 2,
    "pattern": "^[a-z0-9][a-z0-9_-]*$",
    "type": "string"
   },
   "from": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "slippageBps": {
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "token": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   }
  },
  "required": [
   "chain",
   "side",
   "token",
   "amount"
  ],
  "type": "object"
 },
 "name": "memeswap_quote"
}
