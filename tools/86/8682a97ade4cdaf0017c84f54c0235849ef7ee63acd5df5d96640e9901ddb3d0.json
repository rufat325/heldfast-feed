{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find actual Las Vegas showtimes on one date, optionally within a clock-time window, show category, budget, party ages, and distance from a hotel/landmark slug or coordinates. Supports upcoming-only, explicit arrival buffer, sort and show pagination. Structured performances include source freshness and general booking links; availability is unknown. Dates use the catalogue evening date, including post-midnight shows.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "arrival_buffer_minutes": {
    "description": "Explicit total travel/arrival buffer from now, not a routing estimate",
    "maximum": 720,
    "minimum": 0,
    "type": "integer"
   },
   "category": {
    "description": "Show category; defaults to all",
    "enum": [
     "all",
     "major",
     "comedy",
     "magic",
     "music",
     "variety",
     "cirque",
     "sports",
     "adult"
    ],
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD; defaults to today in America/Los_Angeles",
    "type": "string"
   },
   "date_mode": {
    "description": "evening (default) includes rollover times; calendar includes previous-evening rollover on the requested calendar date",
    "enum": [
     "evening",
     "calendar"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "description": "Max shows; defaults to 20",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "max_price": {
    "description": "USD catalogue starting-price ceiling, not a ticket quote",
    "minimum": 0,
    "type": "number"
   },
   "near": {
    "description": "Tonight slug or prefixed id to use as a map center",
    "type": "string"
   },
   "offset": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "party_ages": {
    "items": {
     "maximum": 120,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 20,
    "type": "array"
   },
   "performance_offset": {
    "description": "Offset within each returned show schedule",
    "maximum": 2160,
    "minimum": 0,
    "type": "integer"
   },
   "radius_miles": {
    "description": "Used with near; defaults to 3 miles",
    "maximum": 25.0,
    "minimum": 0.1,
    "type": "number"
   },
   "sort": {
    "description": "Defaults to time; unknown values sort last",
    "enum": [
     "time",
     "distance",
     "price",
     "name"
    ],
    "type": "string"
   },
   "starts_after": {
    "description": "Inclusive HH:MM",
    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "starts_before": {
    "description": "Inclusive HH:MM",
    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "unknown_policy": {
    "description": "Unknown price/currency or minimum age with applicable filters; defaults to exclude",
    "enum": [
     "exclude",
     "include"
    ],
    "type": "string"
   },
   "upcoming_only": {
    "description": "Only starts at or after server Vegas now; defaults to false",
    "type": "boolean"
   }
  },
  "required": [],
  "type": "object"
 },
