{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List roles"
 },
 "description": "List all roles in a server (excluding @everyone), highest-first, with color, position, member count, and permissions. Read-only. Returns { roles: [...] }. Use discord_get_role_members to see who holds a given role.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "guild_id"
  ],
  "type": "object"
 },
 "name": "discord_list_roles",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "roles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "type": "string"
      },
      "hoist": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "memberCount": {
       "type": "number"
      },
      "mentionable": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "permissions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "position": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "color",
      "position",
      "memberCount",
      "permissions",
      "hoist",
      "mentionable"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "roles"
  ],
  "type": "object"
 }
}
