{
 "description": "Generate and schedule multiple posts across a date range in the background.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (uses active brand if omitted)",
    "type": "string"
   },
   "days": {
    "description": "Number of days to fill",
    "maximum": 90,
    "minimum": 1,
    "type": "number"
   },
   "frequency": {
    "default": "daily",
    "description": "Posting frequency",
    "enum": [
     "daily",
     "every_other",
     "every_third",
     "weekdays"
    ],
    "type": "string"
   },
   "platform": {
    "description": "Platform: x | linkedin | instagram | threads | facebook",
    "type": "string"
   },
   "postsPerDay": {
    "default": 1,
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "times": {
    "default": "09:00",
    "description": "Comma-separated posting times, e.g. '09:00,14:00'",
    "type": "string"
   },
   "voice": {
    "description": "Voice profile ID",
    "type": "string"
   }
  },
  "required": [
   "platform",
   "days"
  ],
  "type": "object"
 },
 "name": "generate_bulk_posts"
}
