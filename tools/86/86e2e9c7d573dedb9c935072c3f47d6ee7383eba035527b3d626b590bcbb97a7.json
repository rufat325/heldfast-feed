{
 "description": "Create an email follow-up sequence. Steps are an array of { delay_seconds, subject, body, type } where type defaults to 'email'. Optionally bind to a CRM workflow id so the same logic runs in the CRM.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "account_id": {
    "type": "string"
   },
   "ai_generate": {
    "description": "If true and steps is empty, AI drafts a 3-step welcome sequence from the goal",
    "type": "boolean"
   },
   "crm_location_id": {
    "type": "string"
   },
   "crm_workflow_id": {
    "type": "string"
   },
   "from_email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "from_name": {
    "type": "string"
   },
   "goal": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "steps": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "account_id",
   "name"
  ],
  "type": "object"
 },
 "name": "rc_sequence_create"
}
