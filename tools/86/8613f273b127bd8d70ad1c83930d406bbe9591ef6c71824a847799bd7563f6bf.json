{"description":"E-Commerce Chargeback Representment Builder \u2014 Tells a merchant whether to fight or accept a card dispute: scores win probability against the network rubric for the reason code (Visa, Mastercard, Amex, Discover), runs deterministic Visa CE3.0 eligibility and invalid-dispute checks, computes expected recovery net of the contest fee and days to the deadline, and returns a processor-ready submission (summary under 4,000 characters, evidence field","inputSchema":{"additionalProperties":false,"properties":{"disputeDate":{"pattern":"^\\d{4}-\\d{2}-\\d{2}","type":"string"},"disputeFeeUsd":{"description":"Fee your processor charges to contest the dispute and does not return on a loss; used to net the expected value.","maximum":10000,"minimum":0,"type":"number"},"evidence":{"additionalProperties":false,"properties":{"authorization":{"additionalProperties":false,"description":"Authorization-message data from the processor; lets Visa 10.4 invalid disputes be decided without a model call.","properties":{"approved":{"type":"boolean"},"attemptResponse":{"type":"boolean"},"authenticationConfirmed":{"description":"Issuer returned an Authentication Confirmation (Visa Secure / EMV 3DS).","type":"boolean"},"cavvPresent":{"type":"boolean"},"cvv2PresenceIndicator":{"pattern":"^[0-9]$","type":"string"},"cvv2ResultCode":{"description":"CVV2 result code in the authorization response, e.g. M, N, U.","pattern":"^[A-Za-z]$","type":"string"},"eci":{"description":"Electronic Commerce Indicator, e.g. 05 or 5.","pattern":"^0?[0-9]$","type":"string"}},"type":"object"},"avsResult":{"maxLength":100,"type":"string"},"cancellationPolicy":{"maxLength":5000,"type":"string"},"carrier":{"maxLength":100,"type":"string"},"customerAccountId":{"maxLength":256,"type":"string"},"customerCommunications":{"maxLength":20000,"type":"string"},"cvvResult":{"maxLength":100,"type":"string"},"deliveryConfirmation":{"maxLength":2000,"type":"string"},"deliveryDate":{"maxLength":40,"type":"string"},"deviceFingerprint":{"maxLength":256,"type":"string"},"deviceId":{"maxLength":256,"type":"string"},"digitalUsageLogs":{"maxLength":10000,"type":"string"},"ipAddress":{"maxLength":64,"type":"string"},"priorUndisputedTransactions":{"items":{"additionalProperties":false,"properties":{"amount":{"minimum":0,"type":"number"},"customerAccountId":{"maxLength":256,"type":"string"},"date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}","type":"string"},"description":{"description":"What was purchased; CE3.0 requires a detailed description for each prior transaction.","maxLength":1000,"type":"string"},"deviceFingerprint":{"maxLength":256,"type":"string"},"deviceId":{"maxLength":256,"type":"string"},"disputed":{"type":"boolean"},"ipAddress":{"maxLength":64,"type":"string"},"shippingAddress":{"maxLength":500,"type":"string"},"transactionId":{"maxLength":100,"type":"string"}},"required":["date"],"type":"object"},"maxItems":50,"type":"array"},"productDescription":{"maxLength":5000,"type":"string"},"refundIssued":{"maxLength":500,"type":"string"},"refundPolicyExcerpt":{"maxLength":5000,"type":"string"},"signedProofOfDelivery":{"type":"boolean"},"threeDSecure":{"maxLength":200,"type":"string"},"trackingNumber":{"maxLength":100,"type":"string"}},"type":"object"},"network":{"enum":["visa","mastercard","amex","discover"],"type":"string"},"orderDetails":{"additionalProperties":false,"properties":{"amount":{"maximum":10000000,"minimum":0,"type":"number"},"billingAddress":{"maxLength":500,"type":"string"},"currency":{"pattern":"^[A-Za-z]{3}$","type":"string"},"customerEmail":{"maxLength":320,"type":"string"},"items":{"items":{"additionalProperties":false,"properties":{"name":{"maxLength":300,"type":"string"},"quantity":{"minimum":1,"type":"integer"},"unitPrice":{"minimum":0,"type":"number"}},"required":["name","quantity","unitPrice"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"orderId":{"maxLength":100,"type":"string"},"productType":{"enum":["physical","digital","service","subscription"],"type":"string"},"shippingAddress":{"maxLength":500,"type":"string"},"transactionDate":{"pattern":"^\\d{4}-\\d{2}-\\d{2}","type":"string"}},"required":["orderId","amount","currency","transactionDate","items"],"type":"object"},"reasonCode":{"description":"e.g. 10.4, 13.1, 13.3 (Visa); 4837, 4853, 4855 (Mastercard).","pattern":"^[0-9A-Za-z.]{1,10}$","type":"string"},"responseDeadline":{"description":"Deadline shown in your processor's dispute dashboard (YYYY-MM-DD); days remaining are computed from it.","pattern":"^\\d{4}-\\d{2}-\\d{2}","type":"string"}},"required":["network","reasonCode","orderDetails","evidence"],"type":"object"},"name":"chargeback-fighter"}
