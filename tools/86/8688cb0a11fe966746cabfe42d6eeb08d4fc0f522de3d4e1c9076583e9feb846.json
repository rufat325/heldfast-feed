    "description": "The agent platform or client, free text, recorded on the intent.",
    "maxLength": 64,
    "type": "string"
   },
   "host": {
    "description": "The domain name as the user gave it: a URL or a bare host both work.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "mandate": {
    "description": "A pre-authorization from the human for an agent-completed rent. Not available yet: the answer is mandate_unavailable and approval_url still works.",
    "properties": {
     "authorization_ref": {
      "description": "The id of the authorization the human recorded.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "max_monthly_cents": {
      "description": "The most per month the human pre-authorized, in cents.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "max_term_months": {
      "description": "The longest term the human pre-authorized: 12, 6 or 1 month.",
      "enum": [
       12,
       6,
       1
      ],
      "type": "number"
     }
    },
    "required": [
     "max_monthly_cents",
     "max_term_months",
     "authorization_ref"
    ],
    "type": "object"
   },
   "term_months": {
    "default": 12,
    "description": "The term: 12, 6 or 1 month. The 12 month rate is the listed rate; shorter terms cost more per month.",
    "enum": [
     12,
     6,
     1
    ],
    "type": "number"
   }
  },
  "required": [
   "host"
  ],
  "type": "object"
 },
