{
 "_meta": {
  "openai/toolInvocation/invoked": "Artifact read",
  "openai/toolInvocation/invoking": "Reading the Artifact\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get an Artifact"
 },
 "description": "Read one Artifact: title, who can open it, the Version viewers see (published_version_id, null while a publication is still being prepared), and its URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact_id": {
    "description": "The Artifact id (art_\u2026).",
    "pattern": "^art_[a-zA-Z0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "artifact_id"
  ],
  "type": "object"
 },
 "name": "get_artifact",
 "outputSchema": {
  "properties": {
   "artifact_id": {
    "type": "string"
   },
   "audience_mode": {
    "description": "Who can open it: owner, users, org, or public.",
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "discoverability": {
    "enum": [
     "unlisted",
     "listed"
    ],
    "type": "string"
   },
   "group_id": {
    "type": "string"
   },
   "icon": {
    "type": "string"
   },
   "icon_image_url": {
    "description": "The page icon set with icon_image; null for the Bisque icon.",
    "type": [
     "string",
     "null"
    ]
   },
   "latest_version_id": {
    "type": "string"
   },
   "organization_id": {
    "type": "string"
   },
   "published_version_id": {
    "description": "The Version viewers see; null until a publication is ready.",
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "type": "string"
   },
   "type": {
    "enum": [
     "html",
     "markdown",
     "presentation"
    ],
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   },
   "url": {
    "description": "The viewer page.",
    "type": "string"
   },
   "viewer_version_mode": {
    "enum": [
     "latest",
     "pinned"
    ],
    "type": "string"
   }
  },
  "required": [
   "artifact_id",
   "type",
   "title",
   "audience_mode",
   "discoverability",
   "published_version_id",
   "url"
  ],
  "type": "object"
 },
 "title": "Get an Artifact"
}
