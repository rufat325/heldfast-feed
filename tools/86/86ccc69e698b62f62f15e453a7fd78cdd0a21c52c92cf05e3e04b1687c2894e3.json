{
 "description": "Return one story (text flow) from an IDML file: its plain text plus indexed runs with paragraph/character styles. Use the run indices with idml_set_text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "path": {
    "description": "Path to the .idml file",
    "type": "string"
   },
   "storyId": {
    "description": "Story Self id, e.g. \"u123\" (from idml_summarize)",
    "type": "string"
   }
  },
  "required": [
   "path",
   "storyId"
  ],
  "type": "object"
 },
 "name": "idml_get_story"
}
