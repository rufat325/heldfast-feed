{"annotations":{"destructiveHint":false,"readOnlyHint":false},"description":"Start paid MiniMax camera-controls on an owned starting image.\n\nFirst call estimate_video_camera with the same image and camera settings. max_cost_rub is\nrequired and must cover the maximum (duration + 1)-second hold. Aspect ratio follows the\nstarting image and native audio is generated. Returns a job ID; read get_video.\nEven a completed job/webhook may have is_hold=true: poll get_video until is_hold=false for final cost.","inputSchema":{"$defs":{"MinimaxCameraKeyframe":{"additionalProperties":false,"properties":{"azimuth":{"title":"Azimuth","type":"number"},"distance":{"exclusiveMinimum":0.0,"title":"Distance","type":"number"},"elevation":{"maximum":90.0,"minimum":-90.0,"title":"Elevation","type":"number"},"time":{"maximum":1.0,"minimum":0.0,"title":"Time","type":"number"}},"required":["time","azimuth","elevation","distance"],"title":"MinimaxCameraKeyframe","type":"object"},"MinimaxCameraPoses":{"additionalProperties":false,"properties":{"c2w":{"items":{"items":{"items":{"type":"number"},"maxItems":4,"minItems":4,"type":"array"},"maxItems":4,"minItems":4,"type":"array"},"maxItems":2048,"minItems":2,"title":"C2W","type":"array"},"convention":{"enum":["blender","opencv"],"title":"Convention","type":"string"}},"required":["convention","c2w"],"title":"MinimaxCameraPoses","type":"object"},"VideoCameraGeneration":{"additionalProperties":false,"properties":{"camera_motion":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"description":"Optional camera motion instruction when not using free_camera_preset, camera_trajectory, or camera_poses.","title":"Camera Motion"},"camera_poses":{"anyOf":[{"$ref":"#/$defs/MinimaxCameraPoses"},{"type":"null"}]},"camera_poses_scale":{"anyOf":[{"exclusiveMinimum":0.0,"maximum":10000.0,"type":"number"},{"type":"null"}],"title":"Camera Poses Scale"},"camera_trajectory":{"anyOf":[{"items":{"$ref":"#/$defs/MinimaxCameraKeyframe"},"maxItems":12,"minItems":2,"type":"array"},{"type":"null"}],"title":"Camera Trajectory"},"duration":{"description":"Requested clip duration in seconds (3-15); maximum hold covers duration + 1 seconds.","maximum":15.0,"minimum":3.0,"title":"Duration","type":"integer"},"free_camera_preset":{"anyOf":[{"enum":["truck_right","truck_left","pedestal_up","pedestal_down","dolly_in","dolly_out","pan_right","pan_left","tilt_up","tilt_down","roll_right","roll_left","s_curve_forward"],"type":"string"},{"type":"null"}],"title":"Free Camera Preset"},"image_url":{"description":"Starting image from your own uploads or results.","minLength":1,"title":"Image Url","type":"string"},"max_cost_rub":{"anyOf":[{"exclusiveMinimum":0.0,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,12}|(?=[\\d.]{1,17}0*$)\\d{0,12}\\.\\d{0,4}0*$)","type":"string"}],"description":"Maximum hold confirmed from the camera estimate; never exceeded.","title":"Max Cost Rub"},"prompt":{"description":"Scene and motion prompt.","maxLength":5000,"minLength":1,"title":"Prompt","type":"string"},"prompt_expansion_mode":{"enum":["disabled","balanced","quality"],"title":"Prompt Expansion Mode","type":"string"},"resolution":{"enum":["480p","768p","1080p"],"title":"Resolution","type":"string"},"seed":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Seed"},"webhook_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Webhook Url"}},"required":["image_url","max_cost_rub"],"title":"VideoCameraGeneration","type":"object"}},"properties":{"idempotency_key":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Idempotency Key"},"request":{"$ref":"#/$defs/VideoCameraGeneration"}},"required":["request"],"title":"create_video_cameraArguments","type":"object"},"name":"create_video_camera","outputSchema":{"additionalProperties":true,"title":"create_video_cameraDictOutput","type":"object"}}
