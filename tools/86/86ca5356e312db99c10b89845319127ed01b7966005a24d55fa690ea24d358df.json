 },
 "description": "Use only after a real external execution of a provider path returned by recommend_provider. Records the caller-reported production outcome for that recommendation_id. The recommendation must exist, only one outcome is accepted per recommendation, and provider attempts must match the recommended primary/fallback path. Reported outcomes are production evidence supplied by the caller; they are not described as independently verified outcomes.",
 "inputSchema": {
  "$defs": {
   "ProviderAttempt": {
    "properties": {
     "cost_eur": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Cost Eur"
     },
     "error_type": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Error Type"
     },
     "latency_ms": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Latency Ms"
     },
     "provider_id": {
      "title": "Provider Id",
      "type": "string"
     },
     "quality_score": {
      "anyOf": [
       {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Quality Score"
     },
     "success": {
      "title": "Success",
      "type": "boolean"
     }
    },
    "required": [
     "provider_id",
     "success"
    ],
    "title": "ProviderAttempt",
    "type": "object"
   }
  },
  "properties": {
   "attempts": {
    "items": {
     "$ref": "#/$defs/ProviderAttempt"
    },
    "title": "Attempts",
    "type": "array"
   },
   "recommendation_id": {
    "title": "Recommendation Id",
    "type": "string"
   }
  },
  "required": [
   "recommendation_id",
   "attempts"
  ],
  "title": "report_outcomeArguments",
  "type": "object"
 },
 "name": "report_outcome",
 "outputSchema": {
