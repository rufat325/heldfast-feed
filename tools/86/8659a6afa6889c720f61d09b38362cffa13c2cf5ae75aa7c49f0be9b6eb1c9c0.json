{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Upload a video. Use this tool to upload a video.",
 "inputSchema": {
  "properties": {
   "auto_levels": {
    "description": "Should auto-levels be applied to the upload",
    "type": "boolean"
   },
   "category_id": {
    "description": "Category of the video",
    "type": "string"
   },
   "channel_id": {
    "description": "Channel id of the video",
    "type": "string"
   },
   "contains_synthetic_media": {
    "default": false,
    "description": "Whether the video contains altered or synthetic media",
    "type": "boolean"
   },
   "description": {
    "description": "Description of the video",
    "type": "string"
   },
   "embeddable": {
    "description": "Whether the video is embeddable",
    "type": "boolean"
   },
   "file": {
    "description": "Path to the video file",
    "type": "string"
   },
   "for_kids": {
    "default": false,
    "description": "Whether the video is for kids",
    "type": "boolean"
   },
   "language": {
    "description": "Language of the video",
    "type": "string"
   },
   "license": {
    "description": "youtube|creativeCommon",
    "enum": [
     "youtube",
     "creativeCommon"
    ],
    "type": "string"
   },
   "notify_subscribers": {
    "description": "Notify the channel subscribers about the new video",
    "type": "boolean"
   },
   "on_behalf_of_content_owner": {
    "description": "ID of the content owner, for YouTube content partners",
    "type": "string"
   },
   "on_behalf_of_content_owner_channel": {
    "description": "YouTube channel ID linked to the content owner",
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|silent",
    "enum": [
     "json",
     "yaml",
     "silent"
    ],
    "type": "string"
   },
   "playlist_id": {
    "description": "Playlist id of the video",
    "type": "string"
   },
   "privacy": {
    "description": "public|private|unlisted",
    "enum": [
     "public",
     "private",
     "unlisted"
    ],
    "type": "string"
   },
   "public_stats_viewable": {
    "description": "Whether the extended video statistics can be viewed by everyone",
    "type": "boolean"
   },
   "publish_at": {
    "description": "Datetime when the video is scheduled to publish",
    "type": "string"
   },
   "recording_date": {
    "description": "Date and time when the video was recorded",
    "type": "string"
   },
   "stabilize": {
    "description": "Should stabilize be applied to the upload",
    "type": "boolean"
   },
   "tags": {
    "description": "Comma separated tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "thumbnail": {
    "description": "Path to the thumbnail file",
    "type": "string"
   },
   "title": {
    "description": "Title of the video",
    "type": "string"
   }
  },
  "required": [
   "file",
   "category_id",
   "privacy"
  ],
  "type": "object"
 },
 "name": "video-insert",
 "title": "Upload a video"
}
