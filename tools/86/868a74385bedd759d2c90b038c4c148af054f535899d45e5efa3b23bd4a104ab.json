{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Cancel a running import"
 },
 "description": "Cancels a SCHEDULED or IN_PROGRESS import. Already-imported rows are NOT rolled back \u2014 use revert_import for that. Returns the updated import status.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   },
   "importId": {
    "description": "Import id from list_imports.",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "importId"
  ],
  "type": "object"
 },
 "name": "cancel_import",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "createdAt": {
    "description": "ISO timestamp.",
    "type": "string"
   },
   "entityName": {
    "description": "Entity type being imported.",
    "type": "string"
   },
   "fileName": {
    "description": "Uploaded file name.",
    "type": "string"
   },
   "finishedAt": {
    "description": "ISO timestamp when reached terminal status, if applicable.",
    "type": "string"
   },
   "id": {
    "description": "Import id.",
    "type": "string"
   },
   "status": {
    "description": "Lifecycle status (SCHEDULED, IN_PROGRESS, FINISHED, FINISHED_WITH_WARNINGS, FAILED, CANCELED, REVERTING, REVERTED).",
    "type": "string"
   },
   "summary": {
    "additionalProperties": true,
    "description": "Counts per result type.",
    "properties": {
     "failed": {
      "type": "integer"
     },
     "succeeded": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     },
     "warnings": {
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "status"
  ],
  "type": "object"
 }
}
