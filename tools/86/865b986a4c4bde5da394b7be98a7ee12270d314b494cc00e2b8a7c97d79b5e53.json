{
 "description": "M2 \u2014 post a signed task/bounty to the LAWBOR board, optionally escrowing USDC (raw 6-decimals integer) from the unified reward pool and gating claimants by minimum reputation.",
 "inputSchema": {
  "properties": {
   "contentCid": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "escrowUsdcRaw": {
    "description": "USDC escrow, raw integer (6 decimals). 0 = none.",
    "minimum": 0,
    "type": "integer"
   },
   "expiresAt": {
    "description": "Unix seconds expiry.",
    "type": "integer"
   },
   "nonce": {
    "type": "string"
   },
   "poster": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "requiredRep": {
    "description": "Minimum claimant reputation.",
    "minimum": 0,
    "type": "integer"
   },
   "signature": {
    "description": "EIP-712 signature by `poster`.",
    "type": "string"
   },
   "topic": {
    "description": "bytes32 topic hash.",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "poster",
   "topic",
   "contentCid",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "lawbor_m2_post"
}
