{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a public-alert scaffold with advisory alert rows, severity maps, routing policy, adapter source, and safety/escalation notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9076/alerts",
    "type": "string"
   },
   "alert_count": {
    "default": 8,
    "maximum": 1024,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "public_alerts_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the alert scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "cap_feed",
    "enum": [
     "cap_feed",
     "nws_alerts",
     "municipal_rss",
     "custom"
    ],
    "type": "string"
   },
   "region_label": {
    "default": "venue_region",
    "type": "string"
   },
   "route_count": {
    "default": 3,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "severity_count": {
    "default": 4,
    "maximum": 16,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_public_alerts_bus",
 "title": "Connect public alerts bus"
}
