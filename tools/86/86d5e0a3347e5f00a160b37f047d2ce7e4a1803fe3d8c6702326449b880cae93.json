{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get discount list. Returns all discounts (product discounts, credits, coins) assigned to the account with their validity periods and amounts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "discountTypeCode": {
    "description": "Discount type: PRODUCT (service discount), CREDIT, COIN",
    "enum": [
     "PRODUCT",
     "CREDIT",
     "COIN"
    ],
    "type": "string"
   },
   "endMonth": {
    "description": "End month in yyyyMM format",
    "type": "string"
   },
   "isOrganization": {
    "description": "Query as Organization master (integrated view)",
    "type": "boolean"
   },
   "isPartner": {
    "description": "Query as Partner representative",
    "type": "boolean"
   },
   "isValidDiscount": {
    "description": "Filter only valid (active) discounts",
    "type": "boolean"
   },
   "memberNoList": {
    "description": "Member number list (master/partner only)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageNo": {
    "description": "Page number",
    "type": "number"
   },
   "pageSize": {
    "description": "Page size (max 1000, default 1000)",
    "type": "number"
   },
   "startMonth": {
    "description": "Start month in yyyyMM format (max 3 months range)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ncloud_get_discount_list"
}
