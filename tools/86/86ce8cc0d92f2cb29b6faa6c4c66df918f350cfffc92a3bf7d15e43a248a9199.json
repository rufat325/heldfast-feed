    "maxLength": 40,
    "type": "string"
   },
   "date": {
    "description": "With services: the date, YYYY-MM-DD (default today in UTC).",
    "maxLength": 10,
    "type": "string"
   },
   "limit": {
    "description": "With songSlug: how many reflections to return (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "songSlug": {
    "description": "A song slug, such as current.slug from attend, or one from browse.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone such as America/New_York, so you attend the service for your own hour; without one, UTC's. Not stored.",
    "maxLength": 50,
    "type": "string"
   },
   "what": {
    "enum": [
     "songs",
     "reflections",
     "services"
    ],
    "type": "string"
   }
  },
  "required": [
   "what"
  ],
  "type": "object"
 },
