{
 "description": "Create a payment transaction",
 "inputSchema": {
  "properties": {
   "acceptance_token": {
    "description": "Acceptance token from get_acceptance_token",
    "type": "string"
   },
   "amount_in_cents": {
    "description": "Amount in cents (COP)",
    "type": "number"
   },
   "currency": {
    "description": "Currency code (COP)",
    "type": "string"
   },
   "customer_data": {
    "description": "Customer data",
    "properties": {
     "full_name": {
      "description": "Full name",
      "type": "string"
     },
     "legal_id": {
      "description": "Legal ID (cedula)",
      "type": "string"
     },
     "legal_id_type": {
      "description": "Legal ID type (CC, NIT, CE)",
      "type": "string"
     },
     "phone_number": {
      "description": "Phone number",
      "type": "string"
     }
    },
    "type": "object"
   },
   "customer_email": {
    "description": "Customer email",
    "type": "string"
   },
   "payment_method": {
    "description": "Payment method details",
    "properties": {
     "financial_institution_code": {
      "description": "Bank code (for PSE)",
      "type": "string"
     },
     "installments": {
      "description": "Number of installments (for CARD)",
      "type": "number"
     },
     "payment_description": {
      "description": "Description (for PSE)",
      "type": "string"
     },
     "phone_number": {
      "description": "Phone number (for NEQUI)",
      "type": "string"
     },
     "token": {
      "description": "Tokenized card token (for CARD)",
      "type": "string"
     },
     "type": {
      "description": "Payment type (CARD, NEQUI, PSE, BANCOLOMBIA_TRANSFER)",
      "type": "string"
     },
     "user_type": {
      "description": "User type: 0=Natural, 1=Legal (for PSE)",
      "type": "number"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "reference": {
    "description": "Unique transaction reference",
    "type": "string"
   }
  },
  "required": [
   "amount_in_cents",
   "currency",
   "customer_email",
   "reference",
   "payment_method"
  ],
  "type": "object"
 },
 "name": "create_transaction"
}
