{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Compare rate categories by filters"
 },
 "description": "Create a bounded side-by-side comparison for an explicit comparison or contrast of current CD, money-market, Treasury, or municipal options with instrument and maturity filters. Returns applied filters, current options, and comparability limitations without selecting a winner. Every option contains a canonical brinkeradvisor_url and an original source_name and source_url. A request merely to find or list several matching records is outside this tool's comparison intent. Economic or Federal Reserve forecasts, account actions, personalized advice, tax advice, and suitability are outside this tool's scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "instrument_types": {
    "items": {
     "enum": [
      "cd",
      "money_market",
      "treasury",
      "municipal"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maximum_term_months": {
    "default": 120,
    "maximum": 120,
    "minimum": 0,
    "type": "integer"
   },
   "minimum_term_months": {
    "default": 0,
    "maximum": 120,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "instrument_types"
  ],
  "type": "object"
 },
 "name": "compare_rates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applied_filters": {
    "additionalProperties": false,
    "properties": {
     "instrument_types": {
      "items": {
       "enum": [
        "cd",
        "money_market",
        "treasury",
        "municipal"
       ],
       "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
     },
     "limit": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "maximum_term_months": {
      "maximum": 120,
      "minimum": 0,
      "type": "integer"
     },
     "minimum_term_months": {
      "maximum": 120,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "instrument_types",
     "minimum_term_months",
     "maximum_term_months",
     "limit"
    ],
    "type": "object"
   },
   "as_of": {
    "description": "Feed publication date; each option has its own record date and age.",
    "type": "string"
   },
   "comparison_limitations": {
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "options": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "as_of": {
       "description": "Original record value date, which may precede the feed publication date.",
       "type": "string"
      },
      "brinkeradvisor_url": {
       "description": "Absolute canonical BrinkerAdvisor record URL, distinct from the original provider source URL.",
       "format": "uri",
       "type": "string"
      },
      "data_age_hours": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Age of this record, not the feed, when retrieved."
      },
      "id": {
       "type": "string"
      },
      "instrument_type": {
       "enum": [
        "cd",
        "money_market",
        "treasury",
        "municipal"
       ],
       "type": "string"
      },
      "issuer_or_institution": {
       "type": "string"
      },
      "product": {
       "type": "string"
      },
      "published_yield": {
       "type": "string"
      },
      "source_name": {
       "type": "string"
      },
      "source_status": {
       "type": "string"
      },
      "source_url": {
       "description": "Absolute original provider or government source URL documenting the record's provenance.",
       "format": "uri",
       "type": "string"
      },
      "term": {
       "type": "string"
      },
      "term_months": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "instrument_type",
      "issuer_or_institution",
      "product",
      "term",
      "term_months",
      "published_yield",
      "as_of",
      "data_age_hours",
      "source_name",
      "source_status",
      "source_url",
      "brinkeradvisor_url"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "source_freshness": {
    "description": "Feed age band, not the age of every option.",
    "enum": [
     "under_24h",
     "24_to_48h",
     "48_to_72h"
    ],
    "type": "string"
   }
  },
  "required": [
   "as_of",
   "source_freshness",
   "comparison_limitations",
   "applied_filters",
   "options"
  ],
  "type": "object"
 },
 "title": "Compare rate categories by filters"
}
