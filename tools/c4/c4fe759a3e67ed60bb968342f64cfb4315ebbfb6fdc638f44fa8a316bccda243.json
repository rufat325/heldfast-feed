{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "List recent Martin runs from the run store with lightweight filters for status, lifecycle, engine metadata, and recency.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adapterId": {
    "description": "Filter by attempt adapter ID.",
    "type": "string"
   },
   "lifecycleState": {
    "description": "Filter by lifecycle state.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of runs to return. Defaults to 20.",
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Filter by attempt model.",
    "type": "string"
   },
   "runsDir": {
    "description": "Optional runs-root override.",
    "type": "string"
   },
   "status": {
    "description": "Filter by loop status.",
    "type": "string"
   },
   "updatedAfter": {
    "description": "Optional ISO-8601 timestamp for recency filtering.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_list_runs",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "filters": {
    "additionalProperties": true,
    "type": "object"
   },
   "latestRun": {
    "additionalProperties": true,
    "properties": {
     "activeAttemptId": {
      "description": "ID of the currently active attempt, when a run is in progress.",
      "type": "string"
     },
     "attempts": {
      "type": "integer"
     },
     "avoidedUsd": {
      "type": "number"
     },
     "costUsd": {
      "type": "number"
     },
     "createdAt": {
      "type": "string"
     },
     "lastAttempt": {
      "additionalProperties": true,
      "type": "object"
     },
     "lifecycleState": {
      "type": "string"
     },
     "loopId": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "pressure": {
      "type": "string"
     },
     "remainingBudgetUsd": {
      "type": "number"
     },
     "remainingIterations": {
      "type": "integer"
     },
     "remainingTokens": {
      "type": "integer"
     },
     "shouldStop": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "loopId",
     "title",
     "objective",
     "status",
     "lifecycleState",
     "attempts",
     "costUsd",
     "avoidedUsd",
     "pressure",
     "shouldStop",
     "remainingBudgetUsd",
     "remainingIterations"
    ],
    "type": "object"
   },
   "lifecycleBreakdown": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "loopCount": {
    "type": "integer"
   },
   "recentRuns": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "activeAttemptId": {
       "description": "ID of the currently active attempt, when a run is in progress.",
       "type": "string"
      },
      "attempts": {
       "type": "integer"
      },
      "avoidedUsd": {
       "type": "number"
      },
      "costUsd": {
       "type": "number"
      },
      "createdAt": {
       "type": "string"
      },
      "lastAttempt": {
       "additionalProperties": true,
       "type": "object"
      },
      "lifecycleState": {
       "type": "string"
      },
      "loopId": {
       "type": "string"
      },
      "objective": {
       "type": "string"
      },
      "pressure": {
       "type": "string"
      },
      "remainingBudgetUsd": {
       "type": "number"
      },
      "remainingIterations": {
       "type": "integer"
      },
      "remainingTokens": {
       "type": "integer"
      },
      "shouldStop": {
       "type": "boolean"
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "loopId",
      "title",
      "objective",
      "status",
      "lifecycleState",
      "attempts",
      "costUsd",
      "avoidedUsd",
      "pressure",
      "shouldStop",
      "remainingBudgetUsd",
      "remainingIterations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "runsRoot": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "statusBreakdown": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "runsRoot",
   "filters",
   "loopCount",
   "recentRuns",
   "statusBreakdown",
   "lifecycleBreakdown",
   "warnings"
  ],
  "type": "object"
 }
}
