{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "$0.01 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/exclusions/screen. Screens a person or business name, or an NPI, against the HHS-OIG exclusion list (LEIE, Medicare and Medicaid): potential matches only, each with name score, reasons, NPI, state, specialty, exclusion type and date. Not a determination: confirm a match on the OIG online search with the SSN or EIN. Empty candidates is a paid 200. Not for employment or credit decisions. List dates and code meanings: GET /v1/exclusions/lists (free).",
 "inputSchema": {
  "additionalProperties": false,
  "description": "A name or an NPI to screen; state only adds a reason and re-ranks.",
  "properties": {
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "lists": {
    "anyOf": [
     {
      "items": {
       "const": "leie",
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Lists to screen. Default: every loaded list.",
    "title": "Lists"
   },
   "min_score": {
    "default": 85,
    "description": "Name score floor, 70-100.",
    "maximum": 100,
    "minimum": 70,
    "title": "Min Score",
    "type": "integer"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "A person or a business. Required unless npi is given.",
    "examples": [
     "Future Pharmacy"
    ],
    "title": "Name"
   },
   "npi": {
    "anyOf": [
     {
      "pattern": "^[0-9]{10}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "10-digit National Provider Identifier: an exact key.",
    "examples": [
     "1528216520"
    ],
    "title": "Npi"
   },
   "state": {
    "anyOf": [
     {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "US state or territory code: a match ranks a candidate higher.",
    "examples": [
     "PA"
    ],
    "title": "State"
   }
  },
  "title": "ExclusionsScreenRequest",
  "type": "object"
 },
 "name": "exclusions_screen",
 "outputSchema": {
  "$defs": {
   "ExclusionsCandidate": {
    "properties": {
     "exclusion_date": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Exclusion Date"
     },
     "exclusion_type": {
      "title": "Exclusion Type",
      "type": "string"
     },
     "general": {
      "title": "General",
      "type": "string"
     },
     "kind": {
      "enum": [
       "person",
       "entity"
      ],
      "title": "Kind",
      "type": "string"
     },
     "list": {
      "const": "leie",
      "title": "List",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "npi": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Npi"
     },
     "reasons": {
      "items": {
       "enum": [
        "exact_name",
        "fuzzy_name",
        "name_without_middle",
        "name_cut_at_30",
        "npi",
        "state"
       ],
       "type": "string"
      },
      "title": "Reasons",
      "type": "array"
     },
     "score": {
      "title": "Score",
      "type": "integer"
     },
     "specialty": {
      "title": "Specialty",
      "type": "string"
     },
     "state": {
      "title": "State",
      "type": "string"
     },
     "waiver_date": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Waiver Date"
     },
     "waiver_state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Waiver State"
     }
    },
    "required": [
     "list",
     "name",
     "kind",
     "score",
     "reasons",
     "npi",
     "state",
     "general",
     "specialty",
     "exclusion_type",
     "exclusion_date",
     "waiver_date",
     "waiver_state"
    ],
    "title": "ExclusionsCandidate",
    "type": "object"
   }
  },
  "properties": {
   "candidates": {
    "items": {
     "$ref": "#/$defs/ExclusionsCandidate"
    },
    "title": "Candidates",
    "type": "array"
   },
   "coverage": {
    "title": "Coverage",
    "type": "string"
   },
   "data_as_of": {
    "title": "Data As Of",
    "type": "string"
   },
   "source": {
    "title": "Source",
    "type": "string"
   },
   "total_candidates": {
    "title": "Total Candidates",
    "type": "integer"
   },
   "truncated": {
    "title": "Truncated",
    "type": "boolean"
   }
  },
  "required": [
   "candidates",
   "total_candidates",
   "truncated",
   "data_as_of",
   "coverage",
   "source"
  ],
  "title": "ExclusionsScreenResponse",
  "type": "object"
 }
}
