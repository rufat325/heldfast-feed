{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a task"
 },
 "description": "Create a task on a contact, assigned to a user (assignedUserId or assignedTo is required). FUB: POST /v1/tasks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignedTo": {
    "description": "Full name of the user to assign (or give assignedUserId).",
    "type": "string"
   },
   "assignedUserId": {
    "description": "User id to assign (or give assignedTo).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "dueDate": {
    "description": "YYYY-MM-DD.",
    "type": "string"
   },
   "dueDateTime": {
    "description": "With time, e.g. 2026-11-16T15:00:00-05:00.",
    "type": "string"
   },
   "isCompleted": {
    "type": "boolean"
   },
   "name": {
    "description": "Task name.",
    "type": "string"
   },
   "personId": {
    "description": "The person id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "remindSecondsBefore": {
    "description": "Reminder lead time; only for tasks with a due time.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "enum": [
     "Follow Up",
     "Call",
     "Text",
     "Email",
     "Appointment",
     "Showing",
     "Closing",
     "Open House",
     "Thank You"
    ],
    "type": "string"
   }
  },
  "required": [
   "personId"
  ],
  "type": "object"
 },
 "name": "fub_create_task",
 "title": "Create a task"
}
