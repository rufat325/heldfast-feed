{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Trace a workflow run"
 },
 "description": "Use this when someone asks why a durable workflow run failed or where it is stuck. Returns the run's status, timings and error code plus its steps with status, attempt, timings and error code, 50 steps by default and 200 at most. Not for listing runs.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Project id that owns the run",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "runId": {
    "description": "Workflow run id",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "stepLimit": {
    "description": "How many steps to return, from 1 to 200; defaults to 50",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "runId"
  ],
  "type": "object"
 },
 "name": "get_workflow_run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "run": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "$ref": "#/properties/run/anyOf/0/properties/creationTime"
       },
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "errorCode": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 128,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "startedAt": {
        "$ref": "#/properties/run/anyOf/0/properties/creationTime"
       },
       "status": {
        "anyOf": [
         {
          "enum": [
           "pending",
           "running",
           "completed",
           "failed",
           "cancelled"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "workflowName": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "workflowName",
       "status",
       "creationTime",
       "startedAt",
       "completedAt",
       "errorCode"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   },
   "steps": {
    "description": "Step status, attempt, timings and machine error code. Workflow inputs, outputs, error messages, deployment details and ownership fields are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "attempt": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "completedAt": {
       "$ref": "#/properties/run/anyOf/0/properties/creationTime"
      },
      "creationTime": {
       "$ref": "#/properties/run/anyOf/0/properties/creationTime"
      },
      "errorCode": {
       "$ref": "#/properties/run/anyOf/0/properties/errorCode"
      },
      "startedAt": {
       "$ref": "#/properties/run/anyOf/0/properties/creationTime"
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "pending",
          "running",
          "completed",
          "failed",
          "retrying"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "stepId": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "stepName": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "stepId",
      "stepName",
      "status",
      "attempt",
      "creationTime",
      "startedAt",
      "completedAt",
      "errorCode"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   },
   "stepsTruncated": {
    "description": "True when the run has more steps than were returned",
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "run",
   "steps",
   "stepsTruncated"
  ],
  "type": "object"
 },
 "title": "Trace a workflow run"
}
