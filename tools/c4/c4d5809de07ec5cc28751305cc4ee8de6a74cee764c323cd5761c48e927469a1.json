{
 "annotations": {},
 "description": "Manually invoke a Cloud Functions trigger",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "params": {
    "additionalProperties": {},
    "description": "Runtime parameters to pass to the trigger",
    "type": "object"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   },
   "triggerName": {
    "description": "Name of the trigger to invoke",
    "type": "string"
   }
  },
  "required": [
   "triggerName"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_invoke_trigger"
}
