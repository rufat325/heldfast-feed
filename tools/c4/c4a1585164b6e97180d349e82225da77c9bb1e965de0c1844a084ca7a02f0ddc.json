{
 "description": "Transform an image with a new prompt while preserving characteristics. Control influence with image_weight (0-100); takes the style and character references, style codes, preset, palette and an exact resolution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "description": "Output aspect ratio",
    "enum": [
     "1x1",
     "16x9",
     "9x16",
     "4x3",
     "3x4",
     "3x2",
     "2x3",
     "4x5",
     "5x4",
     "1x2",
     "2x1",
     "1x3",
     "3x1",
     "10x16",
     "16x10"
    ],
    "type": "string"
   },
   "character_reference_image": {
    "description": "Local image file of a character to keep consistent (one image; Ideogram bills character references at its own rate)",
    "minLength": 1,
    "type": "string"
   },
   "character_reference_mask": {
    "description": "Grayscale mask of the character reference (same dimensions); needs character_reference_image",
    "minLength": 1,
    "type": "string"
   },
   "color_palette": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "name": {
        "description": "A preset palette",
        "enum": [
         "EMBER",
         "FRESH",
         "JUNGLE",
         "MAGIC",
         "MELON",
         "MOSAIC",
         "PASTEL",
         "ULTRAMARINE"
        ],
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "members": {
        "description": "Explicit colours, most dominant first",
        "items": {
         "additionalProperties": false,
         "properties": {
          "color_hex": {
           "description": "The colour, #RRGGBB",
           "pattern": "^#[0-9A-Fa-f]{6}$",
           "type": "string"
          },
          "color_weight": {
           "description": "Its share of the palette (0.05-1)",
           "maximum": 1,
           "minimum": 0.05,
           "type": "number"
          }
         },
         "required": [
          "color_hex"
         ],
         "type": "object"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "members"
      ],
      "type": "object"
     }
    ],
    "description": "A preset palette by name, or explicit colours with weights (not both)"
   },
   "image": {
    "description": "Local file path of the source image to remix",
    "minLength": 1,
    "type": "string"
   },
   "image_weight": {
    "description": "Original image influence (0-100, default: 50)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "magic_prompt": {
    "description": "Auto-enhance prompts (default: AUTO)",
    "enum": [
     "AUTO",
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "negative_prompt": {
    "description": "What to exclude",
    "type": "string"
   },
   "num_images": {
    "description": "Number of variations (1-8, default: 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "description": "New creative direction",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "rendering_speed": {
    "description": "Speed/quality tradeoff (default: DEFAULT)",
    "enum": [
     "FLASH",
     "TURBO",
     "DEFAULT",
     "QUALITY"
    ],
    "type": "string"
   },
   "resolution": {
    "description": "Exact output resolution (one of Ideogram's 69 sizes); not with aspect_ratio",
    "enum": [
     "512x1536",
     "576x1408",
     "576x1472",
     "576x1536",
     "640x1344",
     "640x1408",
     "640x1472",
     "640x1536",
     "704x1152",
     "704x1216",
     "704x1280",
     "704x1344",
     "704x1408",
     "704x1472",
     "736x1312",
     "768x1088",
     "768x1216",
     "768x1280",
     "768x1344",
     "800x1280",
     "832x960",
     "832x1024",
     "832x1088",
     "832x1152",
     "832x1216",
     "832x1248",
     "864x1152",
     "896x960",
     "896x1024",
     "896x1088",
     "896x1120",
     "896x1152",
     "960x832",
     "960x896",
     "960x1024",
     "960x1088",
     "1024x832",
     "1024x896",
     "1024x960",
     "1024x1024",
     "1088x768",
     "1088x832",
     "1088x896",
     "1088x960",
     "1120x896",
     "1152x704",
     "1152x832",
     "1152x864",
     "1152x896",
     "1216x704",
     "1216x768",
     "1216x832",
     "1248x832",
     "1280x704",
     "1280x768",
     "1280x800",
     "1312x736",
     "1344x640",
     "1344x704",
     "1344x768",
     "1408x576",
     "1408x640",
     "1408x704",
     "1472x576",
     "1472x640",
     "1472x704",
     "1536x512",
     "1536x576",
     "1536x640"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Reproducibility seed",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "style_codes": {
    "description": "8-character hexadecimal style codes from Ideogram",
    "items": {
     "pattern": "^[0-9A-Fa-f]{8}$",
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "style_preset": {
    "description": "A named style preset as Ideogram lists them",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "style_reference_images": {
    "description": "Local image files whose style the result follows (up to 3, 25 MB each)",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "style_type": {
    "description": "Visual style (the API default is GENERAL when omitted)",
    "enum": [
     "AUTO",
     "GENERAL",
     "REALISTIC",
     "DESIGN",
     "FICTION"
    ],
    "type": "string"
   }
  },
  "required": [
   "image",
   "prompt"
  ],
  "type": "object"
 },
 "name": "ideogram_remix"
}
