{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "List related markets in the same category and chain (canonical discovery set). Useful for context around a market before trading or creating.",
 "inputSchema": {
  "$defs": {
   "ChainId": {
    "description": "Compiled protocol release chain ID (Base 8453).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "EvmAddress": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "properties": {
   "address": {
    "$ref": "#/$defs/EvmAddress",
    "description": "Anchor market contract address."
   },
   "chainId": {
    "$ref": "#/$defs/ChainId",
    "description": "Chain id for the market address."
   },
   "limit": {
    "description": "Max related markets (1\u201320, default 4).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "address",
   "chainId"
  ],
  "type": "object"
 },
