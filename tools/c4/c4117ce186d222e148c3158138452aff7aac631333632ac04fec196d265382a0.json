{
 "_meta": {
  "ui": {
   "resourceUri": "ui://yachtfinder/answer-v1.html"
  },
  "ui/resourceUri": "ui://yachtfinder/answer-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "One yacht's facts"
 },
 "description": "One yacht's facts from YachtFinder: builder, year, length, status, the broker's asking price (never a sale price), YachtFinder's estimate where her page shows one, her published AIS position with its time, where her listing says she is, and her page on yachtfinder.co, with the source and date of each fact. Takes her name (add builder or length_m when several yachts share it) or her yachtfinder.co/y/ link.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "builder": {
    "description": "Her builder, to choose between yachts of the same name.",
    "maxLength": 60,
    "type": "string"
   },
   "length_m": {
    "description": "Her length in metres, to choose between yachts of the same name.",
    "maximum": 200,
    "minimum": 0,
    "type": "number"
   },
   "yacht": {
    "description": "Her name, e.g. \"Lady Lara\", or her yachtfinder.co/y/ link or the id from another answer.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "yacht"
  ],
  "type": "object"
 },
 "name": "yacht_facts",
 "outputSchema": {
  "properties": {
   "data_as_of": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "When YachtFinder last rebuilt the catalogue this answer was read from (ISO 8601)."
   },
   "found": {
    "enum": [
     "one",
     "several"
    ],
    "type": "string"
   },
   "matches": {
    "items": {
     "properties": {
      "asking_price_usd": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "The broker's asking price in US dollars; null when none is published. Never a sale price. Where she asks in another currency (price_as_listed), this is YachtFinder's conversion of that ask, about this much."
      },
      "builder": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "description": "Her address on yachtfinder.co (the last part of url); yacht_facts accepts it.",
       "type": "string"
      },
      "last_asking_price_usd": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "For a reported-sold or not-for-sale yacht, her last asking price. Not a sale price."
      },
      "length_m": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "listed_location": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "our_estimate_usd": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "YachtFinder's model estimate, only where her page shows one. Not an appraisal, not a sale price."
      },
      "position": {
       "anyOf": [
        {
         "properties": {
          "distance_km": {
           "type": "number"
          },
          "in_port": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "latitude": {
           "type": "number"
          },
          "longitude": {
           "type": "number"
          },
          "seen_at": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "price_as_listed": {
       "anyOf": [
        {
         "properties": {
          "amount": {
           "type": "number"
          },
          "currency": {
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Her asking price as the broker lists it, when that is not in US dollars (the dollar figure above is then converted). Null for a dollar ask."
      },
      "price_on_application": {
       "type": "boolean"
      },
      "status": {
       "enum": [
        "for sale",
        "for charter",
        "reported sold",
        "not for sale"
       ],
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "weeks_heard": {
       "anyOf": [
        {
         "properties": {
          "heard": {
           "type": "integer"
          },
          "of": {
           "type": "integer"
          },
          "season_url": {
           "type": "string"
          },
          "sentence": {
           "type": "string"
          },
          "since": {
           "type": "string"
          },
          "weeks": {
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "The weeks since `since` (UTC Monday weeks, the last one not over) that YachtFinder's AIS archive heard her: one letter a week, h heard, u our archive did not hear her (our gap, not where she was), x our archive was down. Null where we have none for her."
      },
      "year": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "status",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "type": "string"
   },
   "yacht": {
    "type": "object"
   }
  },
  "required": [
   "summary",
   "data_as_of",
   "source",
   "notes",
   "found"
  ],
  "type": "object"
 },
 "title": "One yacht's facts"
}
