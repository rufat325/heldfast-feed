{
 "description": "Ask the oracle a yes/no question with likelihood modifier",
 "inputSchema": {
  "properties": {
   "likelihood": {
    "description": "How likely is yes? (default: even)",
    "enum": [
     "certain",
     "likely",
     "even",
     "unlikely",
     "impossible"
    ],
    "type": "string"
   },
   "question": {
    "description": "Yes/no question",
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "oracle_ask"
}
