  "additionalProperties": false,
  "properties": {
   "topic": {
    "description": "The score or topic in the family's words: 'safety', 'family fit', 'school rating', 'schools', 'affordability', 'getting around', 'character', 'air quality', 'things to do' \u2014 or 'bias' / 'fairness' for how the scores relate to neighborhood income.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
