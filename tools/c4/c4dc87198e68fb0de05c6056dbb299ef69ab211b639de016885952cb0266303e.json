{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Returns a snapshot of container resource usage (CPU, memory, network/block I/O, PIDs) as structured data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all": {
    "default": false,
    "description": "Show all containers including stopped (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "containers": {
    "description": "Container names or IDs to filter (default: all running containers)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "type": "array"
   },
   "noTrunc": {
    "default": false,
    "description": "Do not truncate container IDs (default: false)",
    "type": "boolean"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "stats",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "containers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "blockIO": {
       "type": "string"
      },
      "blockRead": {
       "type": "number"
      },
      "blockWrite": {
       "type": "number"
      },
      "cpuPercent": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "memoryLimit": {
       "type": "string"
      },
      "memoryLimitBytes": {
       "type": "number"
      },
      "memoryPercent": {
       "type": "number"
      },
      "memoryUsage": {
       "type": "string"
      },
      "memoryUsageBytes": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "netIO": {
       "type": "string"
      },
      "netIn": {
       "type": "number"
      },
      "netOut": {
       "type": "number"
      },
      "pids": {
       "type": "number"
      },
      "state": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "cpuPercent",
      "memoryPercent",
      "pids"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "containers"
  ],
  "type": "object"
 },
 "title": "Docker Stats"
}
