{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Prepare Enclosure"
 },
 "description": "Prepare or revise an enclosure from KiCad PCB text or dimensions. Returns exact parameters, review revision, warnings and editable customer review URL. Uses a guest token but no quote allowance. No manufacturing or purchase occurs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accessToken": {
    "description": "Guest token returned by printing.sessions.start. Optional when Authorization already carries a permanent key or guest token.",
    "maxLength": 138,
    "minLength": 34,
    "type": "string"
   },
   "kicadPcb": {
    "description": "KiCad 6\u20139 .kicad_pcb UTF-8 text. Sent to AIURION for parsing; raw PCB text is not stored in the draft or review link. Use parameters instead for dimensions.",
    "maxLength": 10485760,
    "minLength": 1,
    "type": "string"
   },
   "parameters": {
    "additionalProperties": false,
    "description": "Workbench geometry parameters. Use the returned normalized values for review and quoting.",
    "properties": {
     "activeTemplate": {
      "const": "enclosure",
      "type": "string"
     },
     "basePlateThicknessMm": {
      "maximum": 8,
      "minimum": 2,
      "type": "number"
     },
     "cornerRadiusMm": {
      "maximum": 18,
      "minimum": 0,
      "type": "number"
     },
     "diagonalVentAngleDeg": {
      "maximum": 45,
      "minimum": 10,
      "type": "number"
     },
     "diagonalVentLengthMm": {
      "maximum": 44,
      "minimum": 8,
      "type": "number"
     },
     "diagonalVentSpacingMm": {
      "maximum": 20,
      "minimum": 1,
      "type": "number"
     },
     "diagonalVentWidthMm": {
      "maximum": 10,
      "minimum": 1,
      "type": "number"
     },
     "driveEnclosureFromPcb": {
      "type": "boolean"
     },
     "fastenerMode": {
      "enum": [
       "none",
       "heat_set"
      ],
      "type": "string"
     },
     "heightMm": {
      "maximum": 160,
      "minimum": 12,
      "type": "number"
     },
     "holeDiameterMm": {
      "maximum": 12,
      "minimum": 1,
      "type": "number"
     },
     "includeLid": {
      "const": true,
      "type": "boolean"
     },
     "includeLidLip": {
      "type": "boolean"
     },
     "includePcb": {
      "type": "boolean"
     },
     "ioCutouts": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "diameterMm": {
         "maximum": 160,
         "minimum": 2,
         "type": "number"
        },
        "heightMm": {
         "maximum": 160,
         "minimum": 2,
         "type": "number"
        },
        "offsetMm": {
         "maximum": 130,
         "minimum": -130,
         "type": "number"
        },
        "shape": {
         "enum": [
          "rectangle",
          "circle"
         ],
         "type": "string"
        },
        "verticalOffsetMm": {
         "maximum": 80,
         "minimum": -80,
         "type": "number"
        },
        "wall": {
         "enum": [
          "front",
          "back",
          "left",
          "right"
         ],
         "type": "string"
        },
        "widthMm": {
         "maximum": 260,
         "minimum": 2,
         "type": "number"
        }
       },
       "required": [
        "shape",
        "wall",
        "offsetMm",
        "verticalOffsetMm",
        "widthMm",
        "heightMm",
        "diameterMm"
       ],
       "type": "object"
      },
      "maxItems": 12,
      "type": "array"
     },
     "lengthMm": {
      "maximum": 260,
      "minimum": 40,
      "type": "number"
     },
     "lidFitClearanceMm": {
      "const": 0.08,
      "type": "number"
     },
     "lidLipDepthMm": {
      "maximum": 150,
      "minimum": 0,
      "type": "number"
     },
     "lidScrewHolesEnabled": {
      "type": "boolean"
     },
     "lidScrewPlacement": {
      "enum": [
       "external"
      ],
      "type": "string"
     },
     "lidScrewSize": {
      "enum": [
       "m2",
       "m3"
      ],
      "type": "string"
     },
     "lidThicknessMm": {
      "maximum": 8,
      "minimum": 3,
      "type": "number"
     },
     "materialId": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "pcbHoleSpacingX": {
      "maximum": 240,
      "minimum": 10,
      "type": "number"
     },
     "pcbHoleSpacingY": {
      "maximum": 200,
      "minimum": 10,
      "type": "number"
     },
     "pcbLengthMm": {
      "maximum": 240,
      "minimum": 20,
      "type": "number"
     },
     "pcbMountingHoles": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "diameterMm": {
         "maximum": 12,
         "minimum": 0.1,
         "type": "number"
        },
        "x": {
         "maximum": 120,
         "minimum": -120,
         "type": "number"
        },
        "y": {
         "maximum": 100,
         "minimum": -100,
         "type": "number"
        }
       },
       "required": [
        "x",
        "y",
        "diameterMm"
       ],
       "type": "object"
      },
      "maxItems": 32,
      "type": [
       "array",
       "null"
      ]
     },
     "pcbScrewSize": {
      "enum": [
       "m2",
       "m3"
      ],
      "type": "string"
     },
     "pcbThicknessMm": {
      "maximum": 10,
      "minimum": 0.1,
      "type": "number"
     },
     "pcbWallClearanceMm": {
      "maximum": 24,
      "minimum": 0,
      "type": "number"
     },
     "pcbWidthMm": {
      "maximum": 200,
      "minimum": 20,
      "type": "number"
     },
     "portCount": {
      "maximum": 12,
      "minimum": 0,
      "type": "integer"
     },
     "riserHeightMm": {
      "maximum": 150,
      "minimum": 0,
      "type": "number"
     },
     "standoffCount": {
      "maximum": 32,
      "minimum": 0,
      "type": "integer"
     },
     "ventEnabled": {
      "type": "boolean"
     },
     "ventPattern": {
      "enum": [
       "slots"
      ],
      "type": "string"
     },
     "ventSlotCount": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "ventSlotLengthMm": {
      "maximum": 260,
      "minimum": 0,
      "type": "number"
     },
     "ventSlotRotationDeg": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "ventSlotSpacingMm": {
      "maximum": 32,
      "minimum": 1,
      "type": "number"
     },
     "ventSlotWidthMm": {
      "maximum": 24,
      "minimum": 1,
      "type": "number"
     },
     "voronoiCellSizeMm": {
      "maximum": 22,
      "minimum": 6,
      "type": "number"
     },
     "voronoiMaxOverhangDeg": {
      "const": 45,
      "type": "number"
     },
     "voronoiSeed": {
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     },
     "voronoiWallEnabled": {
      "type": "boolean"
     },
     "voronoiWallTarget": {
      "enum": [
       "all"
      ],
      "type": "string"
     },
     "voronoiWebMm": {
      "maximum": 5,
      "minimum": 1,
      "type": "number"
     },
     "wallMm": {
      "maximum": 8,
      "minimum": 1.6,
      "type": "number"
     },
     "wallPattern": {
      "enum": [
       "none",
       "diagonal_vents",
       "voronoi"
      ],
      "type": "string"
     },
     "widthMm": {
      "maximum": 220,
      "minimum": 30,
      "type": "number"
     }
    },
    "type": "object"
   },
   "quantity": {
    "description": "Number of complete sets to prepare or quote.",
    "maximum": 150,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "prepare_enclosure",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "build": {
      "additionalProperties": true,
      "description": "Complete-set quote and authoritative server totals, returned after quoting.",
      "type": "object"
     },
     "reviewUrl": {
      "description": "Private design review link for the customer.",
      "format": "uri",
      "type": "string"
     },
     "revision": {
      "description": "Hash of the exact normalized design and quantity.",
      "type": "string"
     },
     "success": {
      "const": true,
      "description": "Confirms the operation succeeded.",
      "type": "boolean"
     },
     "warnings": {
      "description": "Design and manufacturing limitations to review.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "success",
     "revision",
     "reviewUrl"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "A structured AIURION tool error.",
    "properties": {
     "error": {
      "additionalProperties": true,
      "description": "Machine-readable error details.",
      "properties": {
       "code": {
        "description": "Stable error code.",
        "type": "string"
       },
       "message": {
        "description": "Human-readable error message.",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "success": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "success",
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Prepare Enclosure"
}
