  "readOnlyHint": true,
  "title": "Get campaign leads"
 },
 "description": "Returns the leads of any campaign by campaignId, with the same fields as fetch_leads, including score and scoreExplanation. It covers campaigns not started in this session, which fetch_leads cannot reach because fetch_leads requires a jobId from a find_leads call in the same session. Passing `leadIds` resolves the reply buckets from get_campaign_stats back into named people.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "campaignId": {
    "description": "Campaign id, as returned by list_campaigns or fetch_leads",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "leadIds": {
    "description": "Optional; when set, only these leads are returned, e.g. positiveLeadIds from get_campaign_stats",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "How many leads to return (default 50)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "campaignId"
  ],
  "type": "object"
 },
