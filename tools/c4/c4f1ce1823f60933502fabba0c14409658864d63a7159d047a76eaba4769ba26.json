     {
      "additionalProperties": false,
      "properties": {
       "anchorId": {
        "type": "string"
       },
       "kind": {
        "const": "relative",
        "type": "string"
       },
       "relation": {
        "enum": [
         "near",
         "at"
        ],
        "type": "string"
       }
      },
      "required": [
