{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Lists one session's tool calls with outcome, exit code, failure category, a redacted stderr excerpt, the command and program, and the turn index. Each call says whether the main agent or a subagent run made it. Filter by outcome, failure category, tool kind (shell, file-write, web, mcp, subagent, ...), tool name, shell program, turn, origin (main or subagent) or one subagent run; page with offset/limit (`total` counts every match). For a VS Code Agent Host session without a Copilot CLI event log the list is empty and toolCallsUnavailableReason says why: the calls are unknown, not zero.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"failureCategory":{"description":"Keep only these failure categories.","items":{"enum":["command-not-found","wrong-directory","invalid-arguments","tool-input-invalid","file-not-found","permission-denied","timeout","network","dependency-missing","git-state","test-or-build-failure","user-rejected","blocked-by-policy","already-exists","other-nonzero-exit","unclassified"],"type":"string"},"type":"array"},"kind":{"description":"Keep only these tool kinds, e.g. [\"shell\"] or [\"web\",\"mcp\"].","items":{"enum":["shell","file-read","file-write","search","web","mcp","subagent","other"],"type":"string"},"type":"array"},"limit":{"description":"Maximum calls to return (default 50).","exclusiveMinimum":0,"maximum":1000,"type":"integer"},"offset":{"description":"Skip this many matching calls (default 0).","maximum":9007199254740991,"minimum":0,"type":"integer"},"origin":{"description":"Keep only calls by the main agent or by subagents, e.g. [\"subagent\"]. Default: both.","items":{"enum":["main","subagent"],"type":"string"},"type":"array"},"program":{"description":"Shell program, e.g. \"npm\" or \"git\".","type":"string"},"provider":{"description":"Log provider id, e.g. \"claude-code\", \"vscode\", \"pi-agent\", \"mitmproxy\" (see list_log_providers). Defaults to the provider active in the web app.","type":"string"},"runId":{"description":"Only calls made by this subagent run (its origin.runId).","pattern":"^[A-Za-z0-9_-]{1,128}$","type":"string"},"sessionId":{"description":"Session id from list_sessions.","minLength":1,"type":"string"},"status":{"description":"Keep only these outcomes, e.g. [\"error\",\"interrupted\",\"denied\"].","items":{"enum":["success","error","interrupted","denied","unknown","canceled"],"type":"string"},"type":"array"},"tool":{"description":"Exact tool name, e.g. \"Bash\" or \"run_in_terminal\".","type":"string"},"turnIndex":{"description":"Only this 0-based turn.","maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["sessionId"],"type":"object"},"name":"list_tool_calls","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"calls":{"items":{"additionalProperties":false,"properties":{"call":{"additionalProperties":false,"properties":{"argsSummary":{"type":"string"},"durationMs":{"type":"number"},"filesTouched":{"items":{"type":"string"},"type":"array"},"id":{"type":"string"},"kind":{"enum":["shell","file-read","file-write","search","web","mcp","subagent","other"],"type":"string"},"name":{"type":"string"},"origin":{"oneOf":[{"additionalProperties":false,"properties":{"kind":{"const":"main","type":"string"}},"required":["kind"],"type":"object"},{"additionalProperties":false,"properties":{"depth":{"maximum":8,"minimum":1,"type":"integer"},"kind":{"const":"subagent","type":"string"},"label":{"pattern":"^(runSubagent-[A-Za-z0-9_ -]{1,64}|searchSubagent|Agent(-[A-Za-z0-9_.: -]{1,64})?|task(-[A-Za-z0-9_.: -]{1,64})?|search_code_subagent)$","type":"string"},"parentRunId":{"pattern":"^[A-Za-z0-9_-]{1,128}$","type":"string"},"runId":{"pattern":"^[A-Za-z0-9_-]{1,128}$","type":"string"},"startedByCallId":{"pattern":"^[A-Za-z0-9_.:-]{1,128}$","type":"string"}},"required":["kind","runId","label","depth"],"type":"object"}]},"outcome":{"additionalProperties":false,"properties":{"classificationEvidence":{"additionalProperties":false,"properties":{"excerpt":{"maxLength":200,"type":"string"},"ruleId":{"type":"string"}},"required":["ruleId","excerpt"],"type":"object"},"exitCode":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"failureCategory":{"enum":["command-not-found","wrong-directory","invalid-arguments","tool-input-invalid","file-not-found","permission-denied","timeout","network","dependency-missing","git-state","test-or-build-failure","user-rejected","blocked-by-policy","already-exists","other-nonzero-exit","unclassified"],"type":"string"},"reason":{"type":"string"},"status":{"enum":["success","error","interrupted","denied","unknown","canceled"],"type":"string"}},"required":["status"],"type":"object"},"roundIndex":{"type":"number"},"shell":{"additionalProperties":false,"properties":{"command":{"type":"string"},"cwd":{"type":"string"},"program":{"type":"string"}},"required":["command"],"type":"object"},"startedAt":{"type":"string"},"tokenCount":{"anyOf":[{"additionalProperties":false,"properties":{"estimated":{"type":"boolean"},"known":{"const":true,"type":"boolean"},"value":{"type":"number"}},"required":["known","value"],"type":"object"},{"additionalProperties":false,"properties":{"known":{"const":false,"type":"boolean"},"reason":{"type":"string"}},"required":["known","reason"],"type":"object"}]}},"required":["name","argsSummary"],"type":"object"},"turnIndex":{"type":"number"}},"required":["turnIndex","call"],"type":"object"},"type":"array"},"offset":{"type":"number"},"toolCallsUnavailableReason":{"type":"string"},"total":{"type":"number"}},"required":["total","offset","calls"],"type":"object"},"title":"List classified tool calls"}
