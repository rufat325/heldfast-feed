{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Bulk update projects, portfolios or goals: fields, comment and links at once.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "comment": {
    "description": "Comment to add to every entity",
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to confirm this destructive/bulk operation",
    "type": "boolean"
   },
   "entityType": {
    "description": "Entity type: \"project\", \"portfolio\" or \"goal\"",
    "enum": [
     "project",
     "portfolio",
     "goal"
    ],
    "type": "string"
   },
   "fields": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "links": {
    "description": "Links to add to every entity",
    "items": {
     "properties": {
      "entity": {
       "type": "string"
      },
      "relationship": {
       "type": "string"
      }
     },
     "required": [
      "relationship",
      "entity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "metaEntities": {
    "description": "Entity ids to update",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "entityType",
   "metaEntities"
  ],
  "type": "object"
 },
 "name": "bulk_update_entities"
}
