{
 "annotations": {
  "title": "Flee from point"
 },
 "description": "Continuously move away from a world point until at least `distance` blocks away (dynamic goal).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "distance": {
    "description": "Minimum distance to keep from the point",
    "type": "number"
   },
   "x": {
    "description": "X world coordinate (integer for blocks)",
    "type": "number"
   },
   "y": {
    "description": "Y world coordinate (integer for blocks)",
    "type": "number"
   },
   "z": {
    "description": "Z world coordinate (integer for blocks)",
    "type": "number"
   }
  },
  "required": [
   "x",
   "y",
   "z",
   "distance"
  ],
  "type": "object"
 },
 "name": "flee_from"
}
