{
 "description": "Export the merged lexicon in a format for another tool: 'claude-md' (markdown for CLAUDE.md / system prompts), 'markdown', 'text', 'wispr', 'superwhisper', 'whisper-prompt', 'openai', 'macos', 'espanso', 'deepgram', 'assemblyai', 'azure', 'google', 'csv', or raw 'json'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "categories": {
    "description": "Only include these categories.",
    "items": {
     "enum": [
      "brand",
      "person",
      "product",
      "acronym",
      "identifier",
      "place",
      "other"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "format": {
    "enum": [
     "wispr",
     "superwhisper",
     "whisper-prompt",
     "macos",
     "claude-md",
     "csv",
     "json",
     "deepgram",
     "espanso",
     "assemblyai",
     "azure",
     "google",
     "openai",
     "text",
     "markdown"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Cap the number of terms exported.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "format"
  ],
  "type": "object"
 },
 "name": "export_lexicon",
 "title": "Export the lexicon"
}
