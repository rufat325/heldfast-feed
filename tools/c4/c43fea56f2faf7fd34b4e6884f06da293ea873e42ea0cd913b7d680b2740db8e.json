{
 "description": "Register a data source with terms for agent access. Returns a signed SourceReceipt.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allowedPurposes": {
    "description": "Allowed purposes: read, analyze, summarize, generate, recommend, train, embed, redistribute, commercial",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "compensationAmount": {
    "description": "Amount per access (for per_access type)",
    "type": "number"
   },
   "compensationCurrency": {
    "default": "usd",
    "type": "string"
   },
   "compensationType": {
    "default": "none",
    "enum": [
     "none",
     "attribution_only",
     "per_access",
     "negotiate"
    ],
    "type": "string"
   },
   "contentCommitment": {
    "description": "SHA-256 hash of the data content",
    "type": "string"
   },
   "contentDescriptor": {
    "description": "Human-readable description of the data",
    "type": "string"
   },
   "contentType": {
    "description": "Type of data",
    "enum": [
     "document",
     "structured_data",
     "media",
     "user_input",
     "model_context"
    ],
    "type": "string"
   },
   "derivativePolicy": {
    "default": "attribution_required",
    "enum": [
     "unrestricted",
     "same_terms",
     "attribution_required",
     "no_derivatives"
    ],
    "type": "string"
   },
   "maxAccessCount": {
    "description": "Max total accesses allowed",
    "type": "number"
   },
   "requireAttribution": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "contentDescriptor",
   "contentCommitment",
   "contentType",
   "allowedPurposes"
  ],
  "type": "object"
 },
 "name": "register_data_source"
}
