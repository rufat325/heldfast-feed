{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Publica\u00e7\u00f5es do DJEN (intima\u00e7\u00f5es)"},"description":"[Avan\u00e7ado: exige BITBUSCA_API_KEY] Busca intima\u00e7\u00f5es e publica\u00e7\u00f5es do Di\u00e1rio de Justi\u00e7a Eletr\u00f4nico Nacional (desde 2021) por OAB, n\u00famero do processo, parte, advogado ou palavras. Use ler_publicacao(id, data) para o texto completo, ficha_processo(numero) para os movimentos e calcular_prazo (gr\u00e1tis; evento \"djen\" com a data de disponibiliza\u00e7\u00e3o, campo \"data\") para o vencimento.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"advogado":{"description":"Nome do advogado.","maxLength":150,"type":"string"},"ate":{"$ref":"#/properties/de","description":"Data final (AAAA-MM-DD)."},"cursor":{"description":"\"proximoCursor\" da resposta anterior.","maxLength":40,"type":"string"},"de":{"description":"Data inicial (AAAA-MM-DD).","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"limite":{"description":"Itens por p\u00e1gina (padr\u00e3o 20).","maximum":50,"minimum":1,"type":"integer"},"oab":{"description":"OAB, ex.: 123456/SP.","maxLength":20,"type":"string"},"palavras":{"description":"Palavras no texto (aceita \"frase\", OR e -exclus\u00e3o).","maxLength":300,"type":"string"},"parte":{"description":"Nome da parte (empresa ou pessoa, como aparece na publica\u00e7\u00e3o).","maxLength":150,"type":"string"},"processo":{"description":"N\u00famero CNJ do processo (20 d\u00edgitos).","maxLength":40,"type":"string"},"tribunais":{"description":"Siglas separadas por v\u00edrgula (ex.: TJSP,TRT2).","maxLength":400,"type":"string"}},"type":"object"},"name":"buscar_publicacoes_djen","title":"Publica\u00e7\u00f5es do DJEN (intima\u00e7\u00f5es)"}
