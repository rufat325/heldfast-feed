 "description": "Add a Tor v3 hidden service (.onion mirror) to a deployment currently running clearnet-only. The agent publishes it alongside the existing clearnet route and persists its address. Catalog apps must declare supports.onion; custom deployments always support it. Use onion_profile for standard intro-point rate limiting, hardened limits and max streams, or max with experimental proof-of-work. Default standard. This is no DDoS guarantee; max is refused if the host lacks the PoW module. Change the profile later with impreza_set_onion_profile.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "onion_profile": {
    "enum": [
     "standard",
     "hardened",
     "max"
    ],
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_add_onion",
