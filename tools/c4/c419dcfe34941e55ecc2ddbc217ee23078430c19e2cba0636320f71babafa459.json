{
 "_meta": {
  "opentrain.ai/authoring-retry": {
   "allowedRetryAction": "Inspect the same page schema and current intent before request/complete. Complete only a current pending intent after its drain and before expiry; never cache/replay PENDING as completion.",
   "automaticRetry": false,
   "identityFields": [
    "folderId",
    "pageId",
    "contentSchemaVersion",
    "intentId",
    "intentRevision",
    "intentStatus"
   ],
   "inspect": [
    {
     "method": "GET",
     "path": "/api/public/v1/instructions/folders/{folderId}/pages/{pageId}"
    },
    {
     "action": "status",
     "method": "POST",
     "path": "/api/public/v1/instructions/folders/{folderId}/pages/{pageId}/schema-upgrade"
    }
   ],
   "keyRequirement": "NO_CLIENT_KEY",
   "missingResourceBehavior": "UNKNOWN_NOT_SUCCESS",
   "policy": "PAGE_INTENT_INSPECTION",
   "schemaVersion": "folder-instruction-authoring-retry/1",
   "staleStateBehavior": "Failed/expired/missing intent requires a new explicit request. Changed page or intent identity requires fresh inspection; missing intent evidence never proves completion.",
   "stateActions": {
    "COMPLETED": "VERIFY_CANONICAL_PAGE_SCHEMA",
    "EXPIRED": "NEW_EXPLICIT_REQUEST_REQUIRED",
    "FAILED": "NEW_EXPLICIT_REQUEST_REQUIRED",
    "NOT_REQUESTED": "NEW_EXPLICIT_REQUEST_REQUIRED",
    "PENDING": "PROGRESS_ONLY_WAIT_FOR_DRAIN"
   }
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use status for no-write progress. Request drains existing editors; complete swaps only stable content. Reuse this page operation; do not create a replacement page. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "pageId": {
    "$ref": "#/properties/folderId"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "enum": [
       "request",
       "status",
       "complete"
      ],
      "type": "string"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "pageId",
   "request"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_schema_upgrade",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "contentSchemaVersion": {
      "minimum": 0,
      "type": "integer"
     },
     "pageId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "recovery": {
      "additionalProperties": false,
      "properties": {
       "contentSchemaVersion": {
        "$ref": "#/properties/result/properties/contentSchemaVersion"
       },
       "intent": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "expiresAt": {
            "$ref": "#/properties/result/properties/recovery/properties/intent/anyOf/0/properties/intentRevision"
           },
           "fromVersion": {
            "$ref": "#/properties/result/properties/contentSchemaVersion"
           },
           "intentId": {
            "$ref": "#/properties/result/properties/pageId"
           },
           "intentRevision": {
            "type": "string"
           },
           "intentStatus": {
            "enum": [
             "PENDING",
             "COMPLETED",
             "FAILED",
             "EXPIRED"
            ],
            "type": "string"
           },
           "readyAt": {
            "$ref": "#/properties/result/properties/recovery/properties/intent/anyOf/0/properties/intentRevision"
           },
           "toVersion": {
            "$ref": "#/properties/result/properties/contentSchemaVersion"
           }
          },
          "required": [
           "intentId",
           "intentRevision",
           "intentStatus",
           "fromVersion",
           "toVersion",
           "readyAt",
           "expiresAt"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "pageId": {
        "$ref": "#/properties/result/properties/pageId"
       },
       "schemaVersion": {
        "const": "folder-instruction-schema-recovery/1",
        "type": "string"
       }
      },
      "required": [
       "schemaVersion",
       "pageId",
       "contentSchemaVersion",
       "intent"
      ],
      "type": "object"
     },
     "targetContentSchemaVersion": {
      "$ref": "#/properties/result/properties/contentSchemaVersion"
     },
     "upgrade": {
      "additionalProperties": false,
      "properties": {
       "alreadyUpgraded": {
        "type": "boolean"
       },
       "failureCode": {
        "$ref": "#/properties/result/properties/recovery/properties/intent/anyOf/0/properties/intentRevision"
       },
       "quiesceReadyAt": {
        "$ref": "#/properties/result/properties/recovery/properties/intent/anyOf/0/properties/intentRevision"
       },
       "retryUntil": {
        "$ref": "#/properties/result/properties/recovery/properties/intent/anyOf/0/properties/intentRevision"
       },
       "status": {
        "enum": [
         "NOT_REQUESTED",
         "PENDING",
         "COMPLETED",
         "FAILED"
        ],
        "type": "string"
       }
      },
      "required": [
       "status"
      ],
      "type": "object"
     }
    },
    "required": [
     "pageId",
     "contentSchemaVersion",
     "targetContentSchemaVersion",
     "upgrade"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
