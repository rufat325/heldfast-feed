{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search and browse active listings on the Payaion marketplace. Filter by keyword, category, and paginate through results. Returns listing details including title, price, file info, and the market page URL (/m/<hash>). No API key required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Filter by category.",
    "enum": [
     "reports",
     "datasets",
     "code",
     "media",
     "models",
     "prompts",
     "other"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (default 20, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search query \u2014 matches title and description (max 100 chars).",
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_marketplace",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "listings": {
    "description": "Array of marketplace listings",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "fileName": {
       "type": "string"
      },
      "listedAt": {
       "type": "string"
      },
      "mimeType": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "pricePerDownload": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sellerAddress": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sizeBytes": {
       "type": "number"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "uploadId": {
       "type": "string"
      },
      "url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "uploadId",
      "title",
      "description",
      "category",
      "tags",
      "fileName",
      "mimeType",
      "sizeBytes",
      "pricePerDownload",
      "sellerAddress",
      "listedAt",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "page": {
    "description": "Current page number",
    "type": "number"
   },
   "pageSize": {
    "description": "Results per page",
    "type": "number"
   },
   "total": {
    "description": "Total number of matching listings",
    "type": "number"
   }
  },
  "required": [
   "listings",
   "total",
   "page",
   "pageSize"
  ],
  "type": "object"
 },
 "title": "Browse Marketplace"
}
