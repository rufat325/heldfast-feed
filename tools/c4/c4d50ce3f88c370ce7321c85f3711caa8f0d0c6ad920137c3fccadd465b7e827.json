{
 "description": "Query Google Search Console search analytics and return ranked clicks, impressions, CTR, and position",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregationType": {
    "description": "How Search Console aggregates rows",
    "enum": [
     "auto",
     "byProperty",
     "byPage"
    ],
    "type": "string"
   },
   "dataState": {
    "description": "full = finalized data (default, ~2-3 day lag); all = include recent partial data",
    "enum": [
     "full",
     "all"
    ],
    "type": "string"
   },
   "dimensionFilterGroups": {
    "description": "Search Console dimension filters",
    "items": {
     "properties": {
      "filters": {
       "items": {
        "properties": {
         "dimension": {
          "enum": [
           "query",
           "page",
           "country",
           "device",
           "date",
           "searchAppearance"
          ],
          "type": "string"
         },
         "expression": {
          "minLength": 1,
          "type": "string"
         },
         "operator": {
          "default": "equals",
          "enum": [
           "equals",
           "notEquals",
           "contains",
           "notContains",
           "includingRegex",
           "excludingRegex"
          ],
          "type": "string"
         }
        },
        "required": [
         "dimension",
         "expression"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "groupType": {
       "default": "and",
       "enum": [
        "and"
       ],
       "type": "string"
      }
     },
     "required": [
      "filters"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dimensions": {
    "default": [
     "query"
    ],
    "description": "Dimensions used to group results",
    "items": {
     "enum": [
      "query",
      "page",
      "country",
      "device",
      "date",
      "searchAppearance"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "endDate": {
    "description": "End date in YYYY-MM-DD; defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "maxTableRows": {
    "default": 25,
    "description": "Cap rows shown in the text table; structured rows are always complete. 0 = summary only.",
    "maximum": 25000,
    "minimum": 0,
    "type": "integer"
   },
   "rowLimit": {
    "default": 25,
    "description": "Maximum rows to return",
    "maximum": 25000,
    "minimum": 1,
    "type": "integer"
   },
   "siteUrl": {
    "description": "Search Console property, such as https://example.com/ or sc-domain:example.com",
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "description": "Start date in YYYY-MM-DD; defaults to 28 days ago",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "startRow": {
    "default": 0,
    "description": "Zero-based row to start from, for paging through a large result",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "description": "Result type. discover is the Discover feed and googleNews is the Google News app and news.google.com, not the News tab in Search. Both support fewer dimensions than web: neither reports a query dimension",
    "enum": [
     "web",
     "image",
     "video",
     "news",
     "discover",
     "googleNews"
    ],
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "search_analytics",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dimensions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "endDate": {
    "type": "string"
   },
   "firstIncompleteDate": {
    "type": "string"
   },
   "rowCount": {
    "type": "number"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clicks": {
       "type": "number"
      },
      "ctr": {
       "type": "number"
      },
      "impressions": {
       "type": "number"
      },
      "keys": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "position": {
       "type": "number"
      },
      "rank": {
       "type": "number"
      }
     },
     "required": [
      "rank",
      "keys",
      "clicks",
      "impressions",
      "ctr",
      "position"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "siteUrl": {
    "type": "string"
   },
   "startDate": {
    "type": "string"
   },
   "startRow": {
    "type": "number"
   },
   "truncated": {
    "description": "More rows follow this page. False does not mean the result is complete: Search Console returns top rows subject to its own internal limits",
    "type": "boolean"
   }
  },
  "required": [
   "siteUrl",
   "startDate",
   "endDate",
   "dimensions",
   "rowCount",
   "startRow",
   "truncated",
   "rows"
  ],
  "type": "object"
 }
}
