{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Data Flow workflow. A workflow defines the data pipeline with nodes (source, filter, sink) and edges connecting them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Workflow description",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview without creating",
    "type": "boolean"
   },
   "edges": {
    "description": "List of edges connecting nodes",
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "description": "Source node ID",
       "type": "string"
      },
      "to": {
       "description": "Target node ID",
       "type": "string"
      }
     },
     "required": [
      "from",
      "to"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Workflow name",
    "type": "string"
   },
   "nodes": {
    "description": "List of nodes in the workflow",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Node ID (unique within workflow)",
       "type": "string"
      },
      "name": {
       "description": "Node name",
       "type": "string"
      },
      "properties": {
       "additionalProperties": {},
       "description": "Node-specific properties",
       "type": "object"
      },
      "type": {
       "description": "Node type (e.g. SOURCE, FILTER, SINK)",
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "ncloud_dataflow_create_workflow"
}
