{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Most-traded graded Pok\u00e9mon cards by verified sales count over a 24h / 7d / 30d window, filterable by language track (all / en / ja / zh-cn) and grading company (all / PSA / CCIC / PSA10). Windows anchor to the latest sale date on record (anchor_date in the response) \u2014 always present results with that date. median_usd is a mixed-grade reference; use card_price for a precise per-grade quote. Up to 50 leaders. Calls record usage and query metadata within POKEKA.",
 "inputSchema": {
  "properties": {
   "grade_company": {
    "description": "Grading filter, default all. PSA10 = PSA grade-10 slabs only.",
    "enum": [
     "all",
     "PSA",
     "CCIC",
     "PSA10"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Language track filter, default all.",
    "enum": [
     "all",
     "en",
     "ja",
     "zh-cn"
    ],
    "type": "string"
   },
   "limit": {
    "description": "How many leaders (default 10, max 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "window": {
    "description": "Volume window, default 7d. Anchored to the latest sale on record, not wall-clock now.",
    "enum": [
     "24h",
     "7d",
     "30d"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "market_volume_leaders",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "anchor_date": {
    "description": "Latest sale date on record \u2014 always cite this with results",
    "type": "string"
   },
   "grade_company": {
    "type": "string"
   },
   "lang": {
    "type": "string"
   },
   "leader_count": {
    "type": "number"
   },
   "leaders": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "card_id": {
       "type": "string"
      },
      "card_number": {
       "type": "string"
      },
      "card_url": {
       "type": "string"
      },
      "gmv_usd": {
       "type": "number"
      },
      "lang": {
       "type": "string"
      },
      "latest_sale_at": {
       "type": "string"
      },
      "median_usd": {
       "description": "mixed-grade reference, not a per-grade quote",
       "type": "number"
      },
      "name_en": {
       "type": "string"
      },
      "name_zh": {
       "type": "string"
      },
      "rank": {
       "type": "number"
      },
      "sales_count": {
       "type": "number"
      },
      "set_code": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "window": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Volume leaders"
}
