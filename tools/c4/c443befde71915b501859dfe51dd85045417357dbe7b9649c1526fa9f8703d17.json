{
 "description": "Endorse an agent as a principal. Creates a cryptographic chain: principal \u2192 agent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_id": {
    "description": "Agent ID to endorse",
    "type": "string"
   },
   "agent_public_key": {
    "description": "Agent's Ed25519 public key",
    "type": "string"
   },
   "expires_in_days": {
    "default": 365,
    "description": "Days until endorsement expires",
    "type": "number"
   },
   "relationship": {
    "description": "How principal relates to agent",
    "enum": [
     "creator",
     "operator",
     "employer",
     "sponsor"
    ],
    "type": "string"
   },
   "scope": {
    "description": "What the agent can do on principal's behalf",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "agent_id",
   "agent_public_key",
   "scope",
   "relationship"
  ],
  "type": "object"
 },
 "name": "endorse_agent"
}
