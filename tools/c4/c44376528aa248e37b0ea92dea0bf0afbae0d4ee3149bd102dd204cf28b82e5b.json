{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search TerpLink events by keyword, date range, hosting organization, category, theme or perk. Upcoming and ongoing events only unless include_past is set. Times are ISO 8601. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "benefits": {
    "description": "Only events offering these perks",
    "items": {
     "enum": [
      "Credit",
      "Free Food",
      "Free Stuff"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "category_ids": {
    "description": "Only events in categories (see terplink_list_event_categories) with any of these ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "ends_before": {
    "description": "Only events ending before this date",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "include_past": {
    "default": false,
    "description": "Also return events that have already ended (default false)",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return, 1-50 (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of records to skip, for pagination (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "organization_ids": {
    "description": "Only events hosted by organizations with any of these ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "query": {
    "description": "Words to match in the name or description",
    "minLength": 1,
    "type": "string"
   },
   "starts_after": {
    "description": "Only events starting on or after this date",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "themes": {
    "description": "Only events with any of these themes",
    "items": {
     "enum": [
      "Arts",
      "Athletics",
      "CommunityService",
      "Cultural",
      "Fundraising",
      "GroupBusiness",
      "Social",
      "Spirituality",
      "ThoughtfulLearning",
      "Unknown"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "terplink_search_events",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "Soonest-ending first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefits": {
       "description": "Perks advertised, e.g. \"Free Food\"",
       "items": {
        "enum": [
         "Credit",
         "Free Food",
         "Free Stuff"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "categories": {
       "description": "Category names",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "description": "Description as plain text",
       "type": [
        "string",
        "null"
       ]
      },
      "ends_on": {
       "description": "End, ISO 8601",
       "type": "string"
      },
      "id": {
       "description": "Event id, for terplink_get_event",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "image_url": {
       "description": "Event image",
       "type": [
        "string",
        "null"
       ]
      },
      "location": {
       "description": "Location as entered, e.g. \"Stamp 1234\" or \"Online\"",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Event name",
       "type": "string"
      },
      "organization": {
       "additionalProperties": false,
       "description": "The hosting organization",
       "properties": {
        "id": {
         "description": "Organization id",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "description": "Organization name",
         "type": "string"
        }
       },
       "required": [
        "id",
        "name"
       ],
       "type": "object"
      },
      "rsvp_total": {
       "description": "RSVPs so far",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "starts_on": {
       "description": "Start, ISO 8601",
       "type": "string"
      },
      "theme": {
       "description": "Theme the host picked",
       "enum": [
        "Arts",
        "Athletics",
        "CommunityService",
        "Cultural",
        "Fundraising",
        "GroupBusiness",
        "Social",
        "Spirituality",
        "ThoughtfulLearning",
        "Unknown"
       ],
       "type": "string"
      },
      "url": {
       "description": "Public TerpLink page",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "location",
      "starts_on",
      "ends_on",
      "organization",
      "theme",
      "categories",
      "benefits",
      "rsvp_total",
      "image_url",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Events matching the query",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "events"
  ],
  "type": "object"
 },
 "title": "Search events"
}
