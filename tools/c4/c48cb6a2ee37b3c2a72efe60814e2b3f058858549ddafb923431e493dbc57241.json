{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete one uploaded DeepSeek image by `file_id`. This permanently removes that provider-side file reference.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "file_id": {
    "pattern": "^file-api-[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "file_id"
  ],
  "type": "object"
 },
 "name": "delete_file",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "deleted": {
    "type": "boolean"
   },
   "error_type": {
    "enum": [
     "deepseek_api_error",
     "tool_execution_error"
    ],
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "object": {
    "const": "file",
    "type": "string"
   },
   "retryable": {
    "type": "boolean"
   },
   "status": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "suggestion": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
