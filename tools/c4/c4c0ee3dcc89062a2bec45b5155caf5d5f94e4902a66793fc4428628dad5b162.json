{
 "description": "Generate cryptographic hash of input text (MD5, SHA-1, SHA-256, SHA-512)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "algorithm": {
    "default": "sha256",
    "description": "Hash algorithm",
    "enum": [
     "md5",
     "sha1",
     "sha256",
     "sha512"
    ],
    "type": "string"
   },
   "encoding": {
    "default": "hex",
    "description": "Output encoding",
    "enum": [
     "hex",
     "base64"
    ],
    "type": "string"
   },
   "input": {
    "description": "Text to hash",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "generate_hash"
}
