{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One node with its description, conditions, source, level and its links grouped by type, each with a link id (Lxxxx) to cite. Filter with link_types, direction and limit.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "src": "https://agile-today.org/icon.svg"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "direction": {
    "enum": [
     "in",
     "out",
     "both"
    ],
    "type": "string"
   },
   "id": {
    "maxLength": 100,
    "type": "string"
   },
   "lang": {
    "description": "Answer language, default en",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "link_types": {
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "explain_node",
 "title": "Explain a node"
}
