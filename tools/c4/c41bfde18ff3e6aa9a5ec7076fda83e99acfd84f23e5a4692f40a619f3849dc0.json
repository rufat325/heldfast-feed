{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Report a deployment's progress (building|succeeded|failed|...) or update the one in flight. Idempotent on (environment, externalId) \u2014 repeat callbacks from the same CI run update ONE row. groupId binds it to a release/board pipeline; omitted, it is still recorded workspace-wide.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildFinishedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "environment": {
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "externalId": {
    "description": "The CI run's own id \u2014 the idempotency key.",
    "maxLength": 200,
    "type": "string"
   },
   "finishedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "groupId": {
    "anyOf": [
     {
      "description": "Group id, from zuuna_list_groups.",
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Group id, from zuuna_list_groups."
   },
   "releaseId": {
    "type": "string"
   },
   "runUrl": {
    "maxLength": 500,
    "type": "string"
   },
   "sha": {
    "maxLength": 64,
    "type": "string"
   },
   "startedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "state": {
    "description": "A deployment state, e.g. building|succeeded|failed.",
    "minLength": 1,
    "type": "string"
   },
   "tag": {
    "maxLength": 100,
    "type": "string"
   },
   "url": {
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "environment",
   "state"
  ],
  "type": "object"
 },
 "name": "zuuna_report_deployment",
 "title": "zuuna_report_deployment"
}
