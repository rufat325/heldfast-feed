{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "UCP: producten opzoeken op id"
 },
 "description": "Haal producten op via hun UCP-id (sp-p-<id> of sp-v-<id>, ook kale post-id) in UCP-vorm; elke variant draagt inputs[] met de gevraagde id. Onbekende id's worden gemeld, niet geweigerd.",
 "inputSchema": {
  "properties": {
   "catalog": {
    "properties": {
     "attribution": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "vrije string-map (utm_source, gclid, \u2026), wordt gelogd",
      "type": "object"
     },
     "context": {
      "description": "address_country (NL/BE/DE/FR/ES) of language kiest de markt; anders de markt van de site.",
      "properties": {
       "address_country": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "language": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "filters": {
      "properties": {
       "categories": {
        "description": "bijv. creatine, eiwitten, pre-workout",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "price": {
        "properties": {
         "max": {
          "description": "in centen",
          "type": "integer"
         },
         "min": {
          "type": "integer"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "ids": {
      "items": {
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "ids"
    ],
    "type": "object"
   },
   "markt": {
    "default": "nl",
    "description": "Markt/land voor prijzen, links en codes (standaard nl).",
    "enum": [
     "nl",
     "be",
     "de",
     "fr",
     "es"
    ],
    "type": "string"
   },
   "meta": {
    "description": "meta[\"ucp-agent\"].profile = URL van het UCP-profiel van het platform (spec: verplicht; wij loggen het en weigeren niet).",
    "properties": {
     "ucp-agent": {
      "properties": {
       "profile": {
        "format": "uri",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "catalog"
  ],
  "type": "object"
 },
 "name": "lookup_catalog",
 "outputSchema": {
  "description": "UCP lookup-antwoord, zie https://ucp.dev/2026-08-25/schemas/shopping/catalog_lookup.json#/$defs/lookup_response",
  "properties": {
   "messages": {
    "type": "array"
   },
   "policies": {
    "type": "array"
   },
   "products": {
    "type": "array"
   },
   "ucp": {
    "type": "object"
   }
  },
  "required": [
   "ucp",
   "products"
  ],
  "type": "object"
 },
 "title": "UCP: producten opzoeken op id"
}
