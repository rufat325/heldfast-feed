{
 "description": "Update an existing product (name, price, description, etc).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "New description",
    "type": "string"
   },
   "name": {
    "description": "New product name",
    "type": "string"
   },
   "price": {
    "description": "New price in dollars",
    "type": "number"
   },
   "product_id": {
    "description": "The product ID to update",
    "type": "string"
   },
   "store_id": {
    "description": "The store ID",
    "type": "string"
   }
  },
  "required": [
   "store_id",
   "product_id"
  ],
  "type": "object"
 },
 "name": "update_product"
}
