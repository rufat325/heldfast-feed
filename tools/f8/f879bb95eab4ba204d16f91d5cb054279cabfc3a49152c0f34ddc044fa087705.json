{
 "description": "Batch update multiple cell ranges. RAW=exact values, USER_ENTERED=parsed like user input. Use a1-notation prompt for range syntax. For multiple clickable links or rich text inside a single cell, use values-markdown-update.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "includeData": {
    "description": "Whether to include updated cell values in the response",
    "type": "boolean"
   },
   "requests": {
    "description": "Array of value update requests",
    "items": {
     "properties": {
      "majorDimension": {
       "description": "Whether values represent rows or columns",
       "enum": [
        "ROWS",
        "COLUMNS"
       ],
       "type": "string"
      },
      "range": {
       "description": "A1 notation range defining the bounded target area. Data dimensions must match range dimensions. Example: D1:D100 requires exactly 100 rows of data. Use open-ended ranges like D1:D to write any number of rows.",
       "minLength": 1,
       "type": "string"
      },
      "values": {
       "description": "2D array of values. Row count must match range height, column count must match range width. Use null to skip a cell (preserve existing value), empty string \"\" to clear it.",
       "items": {
        "items": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "number"
          },
          {
           "const": null,
           "type": "number"
          },
          {
           "const": null,
           "type": "number"
          },
          {
           "type": "boolean"
          },
          {
           "type": "null"
          }
         ]
        },
        "type": "array"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "range",
      "values",
      "majorDimension"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "valueInputOption": {
    "description": "How input data should be interpreted (RAW = exact values, USER_ENTERED = parsed like user input)",
    "enum": [
     "RAW",
     "USER_ENTERED"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "requests",
   "valueInputOption",
   "includeData"
  ],
  "type": "object"
 },
 "name": "values-batch-update",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Title of the updated sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the updated sheet",
        "type": "string"
       },
       "spreadsheetTitle": {
        "description": "Title of the updated spreadsheet",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the updated spreadsheet",
        "type": "string"
       },
       "totalUpdatedCells": {
        "description": "Total number of cells updated across all requests",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "totalUpdatedColumns": {
        "description": "Total number of columns updated across all requests",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "totalUpdatedRows": {
        "description": "Total number of rows updated across all requests",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "updatedData": {
        "description": "Detailed information about updated data (if includeData was true)",
        "items": {
         "additionalProperties": false,
         "properties": {
          "majorDimension": {
           "description": "Dimension of the updated data",
           "enum": [
            "ROWS",
            "COLUMNS"
           ],
           "type": "string"
          },
          "range": {
           "description": "A1 notation range that was updated",
           "type": "string"
          },
          "values": {
           "description": "Updated values (if includeData was true)",
           "items": {
            "items": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "number"
              },
              {
               "const": null,
               "type": "number"
              },
              {
               "const": null,
               "type": "number"
              },
              {
               "type": "boolean"
              },
              {
               "type": "null"
              }
             ]
            },
            "type": "array"
           },
           "type": "array"
          }
         },
         "required": [
          "range",
          "majorDimension"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "updatedRanges": {
        "description": "A1 notation ranges that were updated",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "spreadsheetTitle",
       "spreadsheetUrl",
       "sheetTitle",
       "sheetUrl",
       "totalUpdatedRows",
       "totalUpdatedColumns",
       "totalUpdatedCells",
       "updatedRanges"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
