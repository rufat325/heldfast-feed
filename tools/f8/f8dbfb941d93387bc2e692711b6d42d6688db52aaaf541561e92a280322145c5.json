{
 "_meta": {
  "agents-x402/paymentRequired": true,
  "agents-x402/priceUSD": 1
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Up to 10 CNPJs in one paid call (one payment, a third off): br_company_dossier for each. Per-item errors are reported inline in results[]; the call fails (and is not charged) only when no item succeeds. Signed answer (Ed25519 attestation), verifiable at /v1/verify.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cnpjs": {
    "description": "1 to 10 CNPJs.",
    "items": {
     "description": "Brazilian CNPJ, 14 characters, with or without punctuation (e.g. 00.000.000/0001-91).",
     "maxLength": 18,
     "minLength": 14,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "cnpjs"
  ],
  "type": "object"
 },
 "name": "br_batch_dossier",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cached": {
    "type": "boolean"
   },
   "count": {
    "type": "number"
   },
   "data_freshness": {
    "type": "string"
   },
   "failed": {
    "type": "number"
   },
   "generated_at": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Re-read this answer free for 10 minutes with br_replay.",
    "properties": {
     "replay_token": {
      "type": "string"
     },
     "replay_until": {
      "type": "string"
     }
    },
    "required": [
     "replay_token",
     "replay_until"
    ],
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cnpj_input": {
       "type": "string"
      },
      "data": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "error": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "message"
       ],
       "type": "object"
      },
      "ok": {
       "type": "boolean"
      }
     },
     "required": [
      "cnpj_input",
      "ok"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "fetched_at": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url",
      "fetched_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "succeeded": {
    "type": "number"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Short summary in English and Portuguese.",
    "properties": {
     "en": {
      "type": "string"
     },
     "pt": {
      "type": "string"
     }
    },
    "required": [
     "en",
     "pt"
    ],
    "type": "object"
   }
  },
  "required": [
   "count",
   "succeeded",
   "failed",
   "results",
   "summary",
   "sources",
   "data_freshness",
   "generated_at",
   "cached"
  ],
  "type": "object"
 }
}
