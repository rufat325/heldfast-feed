{
 "description": "Get full chat history with pagination support",
 "inputSchema": {
  "properties": {
   "fromMe": {
    "description": "Filter only sent messages",
    "type": "boolean"
   },
   "instance": {
    "description": "Instance name",
    "type": "string"
   },
   "limit": {
    "description": "Number of messages (default 50)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset (message index)",
    "type": "number"
   },
   "remoteJid": {
    "description": "Chat JID (e.g. 5511999999999@s.whatsapp.net)",
    "type": "string"
   }
  },
  "required": [
   "instance",
   "remoteJid"
  ],
  "type": "object"
 },
 "name": "get_chat_history"
}
