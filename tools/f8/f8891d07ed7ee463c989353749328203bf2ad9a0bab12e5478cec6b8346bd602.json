{
 "description": "Prepare an unsigned ERC-20 token deployment transaction on Celo or Base (requires Team \u2014 you're on Free)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "EVM chain to deploy on",
    "enum": [
     "celo",
     "base"
    ],
    "type": "string"
   },
   "decimals": {
    "default": 18,
    "maximum": 18,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Token name (e.g. 'My Token')",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "ownerAddress": {
    "description": "Address that will receive the initial supply",
    "type": "string"
   },
   "symbol": {
    "description": "Token symbol (e.g. 'MTK')",
    "maxLength": 10,
    "minLength": 1,
    "type": "string"
   },
   "totalSupply": {
    "description": "Total supply (e.g. '1000000')",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "name",
   "symbol",
   "totalSupply",
   "ownerAddress"
  ],
  "type": "object"
 },
 "name": "deploy_token"
}
