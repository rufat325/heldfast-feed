{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Runs vision OCR on an already-uploaded wire payment proof (wire confirmation, bank statement, or transfer receipt \u2014 NOT an invoice) for a security and returns the extracted fields plus a verification verdict (verified | needs_review | mismatch). Nothing is persisted. Flow: call GetOcrUploadURL with kind=WIRE_PROOF, PUT the file bytes to the returned upload_url, then call this with the returned source_s3_uri. Only a 'verified' verdict can back a wire in RecordCapTableWire.",
 "inputSchema": {
  "properties": {
   "agentCode": {
    "maxLength": 100,
    "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$",
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "securityId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "sourceS3Uri": {
    "maxLength": 2048,
    "minLength": 1,
    "pattern": "^s3://[a-z0-9.-]+/.+$",
    "type": "string"
   }
  },
  "required": [
   "companyId",
   "securityId"
  ],
  "type": "object"
 },
 "name": "cap_table_extract_wire_payment_proof",
 "outputSchema": {
  "properties": {
   "ocrConfidence": {
    "type": "string"
   },
   "proof": {
    "anyOf": [
     {
      "properties": {
       "amount": {
        "type": "string"
       },
       "bankName": {
        "type": "string"
       },
       "currencyCode": {
        "type": "string"
       },
       "documentType": {
        "type": "string"
       },
       "isPaymentProof": {
        "type": "boolean"
       },
       "recipientAccountLast4": {
        "type": "string"
       },
       "recipientName": {
        "type": "string"
       },
       "reference": {
        "type": "string"
       },
       "senderName": {
        "type": "string"
       },
       "transferDate": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "sourceS3Uri": {
    "type": "string"
   },
   "verification": {
    "anyOf": [
     {
      "properties": {
       "amountMatches": {
        "type": "boolean"
       },
       "isPaymentProof": {
        "type": "boolean"
       },
       "nameMatches": {
        "type": "boolean"
       },
       "reasons": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "status": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Extract Wire Payment Proof"
}
