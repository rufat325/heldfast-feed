{
 "annotations": {
  "destructiveHint": true,
  "title": "Create an account"
 },
 "description": "Create a constituent account: an INDIVIDUAL (a person) or a COMPANY (with company_name, plus an optional primary contact). Neon's Account Match may merge it into an existing account with the same name and email, so check neon_list_accounts by email first. Returns the new id. Neon: POST /accounts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address_line1": {
    "description": "Primary address, line 1.",
    "type": "string"
   },
   "address_line2": {
    "description": "Primary address, line 2.",
    "type": "string"
   },
   "city": {
    "description": "City.",
    "type": "string"
   },
   "company_name": {
    "description": "Company name \u2014 required when type is COMPANY.",
    "type": "string"
   },
   "country_id": {
    "description": "Country id (see neon_list_properties name=countries).",
    "type": "string"
   },
   "email": {
    "description": "Primary email (primaryContact.email1).",
    "type": "string"
   },
   "email2": {
    "description": "Secondary email (primaryContact.email2).",
    "type": "string"
   },
   "first_name": {
    "description": "First name (primaryContact.firstName).",
    "type": "string"
   },
   "job_title": {
    "description": "Job title (primaryContact.title).",
    "type": "string"
   },
   "last_name": {
    "description": "Last name.",
    "type": "string"
   },
   "middle_name": {
    "description": "Middle name.",
    "type": "string"
   },
   "no_solicitation": {
    "description": "Mark the account as do-not-solicit.",
    "type": "boolean"
   },
   "phone": {
    "description": "Phone number (stored on the primary address as phone1).",
    "type": "string"
   },
   "phone_type": {
    "description": "Phone type.",
    "enum": [
     "Home",
     "Work",
     "Mobile",
     "Other"
    ],
    "type": "string"
   },
   "preferred_name": {
    "description": "Preferred name.",
    "type": "string"
   },
   "source_id": {
    "description": "Source id (see neon_list_properties name=sources).",
    "type": "string"
   },
   "state_province_code": {
    "description": "State/province code, e.g. CA.",
    "type": "string"
   },
   "type": {
    "description": "Individual person or company account.",
    "enum": [
     "INDIVIDUAL",
     "COMPANY"
    ],
    "type": "string"
   },
   "zip_code": {
    "description": "ZIP / postal code.",
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "neon_create_account",
 "title": "Create an account"
}
