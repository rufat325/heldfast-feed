{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full text (Markdown) of one case study, project or note by its slug, as listed by list_items. Case studies and projects also exist in French.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "kind": {
    "enum": [
     "work",
     "projects",
     "notes"
    ],
    "type": "string"
   },
   "lang": {
    "default": "en",
    "enum": [
     "en",
     "fr"
    ],
    "type": "string"
   },
   "slug": {
    "description": "e.g. api-led-luxury-retail, mulewatch",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "slug"
  ],
  "type": "object"
 },
 "name": "get_item",
 "title": "Read a case study, project or note"
}
