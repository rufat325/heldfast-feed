{"_meta":{"securitySchemes":[{"scopes":["mcp:read","mcp:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Save a workspace address, or replace an existing entry by id. Identical new addresses are deduplicated. Existing orders and rule snapshots are unchanged. Requires production write access. Workspace authentication required.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"address":{"additionalProperties":false,"properties":{"city":{"maxLength":100,"minLength":1,"pattern":"^[^\\r\\n]*$","type":"string"},"company":{"maxLength":100,"pattern":"^[^\\r\\n]*$","type":"string"},"country":{"const":"US","default":"US","type":"string"},"line1":{"maxLength":100,"minLength":1,"pattern":"^[^\\r\\n]*$","type":"string"},"line2":{"maxLength":100,"pattern":"^[^\\r\\n]*$","type":"string"},"name":{"maxLength":100,"minLength":1,"pattern":"^[^\\r\\n]*$","type":"string"},"postal":{"pattern":"^\\d{5}(-\\d{4})?$","type":"string"},"state":{"pattern":"^[A-Za-z]{2}$","type":"string"}},"required":["name","line1","city","state","postal"],"type":"object"},"id":{"maxLength":128,"minLength":1,"pattern":"^[A-Za-z0-9_-]+$","type":"string"}},"required":["address"],"type":"object"},"name":"save_address","securitySchemes":[{"scopes":["mcp:read","mcp:write"],"type":"oauth2"}],"title":"Save Address"}
