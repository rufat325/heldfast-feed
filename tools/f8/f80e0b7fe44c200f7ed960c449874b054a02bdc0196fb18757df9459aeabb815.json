  "additionalProperties": true,
  "properties": {
   "betCount": {
    "type": "number"
   },
   "cashStake": {
    "type": "number"
   },
   "coinObjectIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "coinType": {
    "type": "string"
   },
   "config": {
    "additionalProperties": true,
    "type": "object"
   },
   "leftPoint": {
    "type": "number"
   },
   "metadata": {
    "additionalProperties": true,
    "type": "object"
   },
   "mode": {
