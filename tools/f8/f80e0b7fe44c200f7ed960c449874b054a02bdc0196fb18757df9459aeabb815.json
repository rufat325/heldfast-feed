    "type": "string"
   },
   "network": {
    "default": "testnet",
    "type": "string"
   },
   "outOfRange": {
    "type": "boolean"
   },
   "owner": {
    "type": "string"
   },
   "partner": {
    "type": "string"
   },
   "rightPoint": {
    "type": "number"
   },
   "stake": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "build_range_transaction"
}
