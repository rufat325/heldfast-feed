{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Return a visual observation"
 },
 "description": "Supplies the editor's rendered observation for an exact pending visual request.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "editorKey": {
    "description": "The editor key from private tool-result _meta.rapier, held by the host and editor alone.",
    "maxLength": 512,
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "fact": {
    "additionalProperties": false,
    "properties": {
     "documentId": {
      "maxLength": 256,
      "type": "string"
     },
     "drawing": {
      "additionalProperties": true,
      "type": "object"
     },
     "image": {
      "additionalProperties": false,
      "properties": {
       "data": {
        "maxLength": 2796204,
        "type": "string"
       },
       "height": {
        "maximum": 4096,
        "minimum": 1,
        "type": "integer"
       },
       "mimeType": {
        "const": "image/png",
        "type": "string"
       },
       "width": {
        "maximum": 4096,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "mimeType",
       "data",
       "width",
       "height"
      ],
      "type": "object"
     },
     "outcome": {
      "enum": [
       "ok",
       "refused"
      ],
      "type": "string"
     },
     "reason": {
      "maxLength": 128,
      "type": "string"
     },
     "revision": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "scope": {
      "enum": [
       "viewport",
       "page",
       "focus",
       "selection"
      ],
      "type": "string"
     },
     "sourceRange": {
      "additionalProperties": false,
      "properties": {
       "end": {
        "maximum": 26214400,
        "minimum": 0,
        "type": "integer"
       },
       "objectId": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_-]+$",
        "type": "string"
       },
       "start": {
        "maximum": 26214400,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "start",
       "end"
      ],
      "type": [
       "object",
       "null"
      ]
     }
    },
    "required": [
     "documentId",
     "revision",
     "scope",
     "outcome"
    ],
    "type": "object"
   },
   "visualId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document",
   "editorKey",
   "expectedRevision",
   "visualId",
   "fact"
  ],
  "type": "object"
 },
 "name": "document.visual_ack",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "ok",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "representation": {
    "enum": [
     "source",
     "visual"
    ],
    "type": "string"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Return a visual observation"
}
