   "campaign_id": {
    "description": "Campaign id from create_campaign.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "confirm": {
    "description": "Must be true, after the user explicitly agreed to start sending.",
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Optional. Reuse the same value when retrying; one is generated when omitted.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "limit": {
    "description": "Optional cap on contacts enrolled by this launch.",
    "maximum": 1000000,
    "minimum": 1,
    "type": "integer"
   },
   "workspace_id": {
    "description": "Workspace id. Optional: defaults to the workspace picked at sign-in or bound to the API key.",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "campaign_id",
   "confirm"
  ],
  "type": "object"
 },
