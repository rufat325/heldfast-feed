{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Describe a Parquet file from its footer without reading rows: row count, columns, types, null counts, min/max per column, and SPSS/Stata/SAS labels. The cheapest way to understand a dataset before querying it. Input: artifact_id from convert_to_parquet, or a url to a .parquet file. Price: $0.002 USDC per successful call, paid via x402.","inputSchema":{"properties":{"artifact_id":{"anyOf":[{"maxLength":64,"pattern":"^[A-Za-z0-9_-]{22,64}$","type":"string"},{"type":"null"}],"default":null,"description":"artifact_id returned by an earlier convert_to_parquet call.","title":"Artifact Id"},"url":{"anyOf":[{"maxLength":4096,"type":"string"},{"type":"null"}],"default":null,"description":"Public http(s) URL of the input file. Preferred for anything over ~3 MB.","title":"Url"}},"title":"inspect_remoteArguments","type":"object"},"name":"inspect_parquet","outputSchema":{"$defs":{"ColumnStats":{"properties":{"label":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Label"},"max":{"default":null,"title":"Max"},"min":{"default":null,"title":"Min"},"name":{"title":"Name","type":"string"},"null_count":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Null Count"},"nullable":{"title":"Nullable","type":"boolean"},"type":{"title":"Type","type":"string"},"value_labels":{"anyOf":[{"additionalProperties":{"type":"string"},"type":"object"},{"type":"null"}],"default":null,"title":"Value Labels"}},"required":["name","type","nullable"],"title":"ColumnStats","type":"object"}},"properties":{"columns":{"items":{"$ref":"#/$defs/ColumnStats"},"title":"Columns","type":"array"},"created_by":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Created By"},"key_value_metadata":{"additionalProperties":{"type":"string"},"description":"File-level metadata, long values truncated.","title":"Key Value Metadata","type":"object"},"row_groups":{"title":"Row Groups","type":"integer"},"rows":{"title":"Rows","type":"integer"},"size_bytes":{"title":"Size Bytes","type":"integer"}},"required":["rows","row_groups","columns","size_bytes"],"title":"InspectResult","type":"object"},"title":"Inspect Parquet schema"}
