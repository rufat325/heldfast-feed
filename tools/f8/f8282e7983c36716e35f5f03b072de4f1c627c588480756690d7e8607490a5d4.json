{
 "description": "Analyze backlink anchor text groups and classify branded, commercial, generic, URL, risky, broken, or lost anchor patterns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anchor_filter": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "backlinks_status_type": {
    "default": "live",
    "enum": [
     "live",
     "all",
     "lost"
    ],
    "type": "string"
   },
   "dofollow_only": {
    "default": false,
    "type": "boolean"
   },
   "exclude_internal_backlinks": {
    "default": true,
    "type": "boolean"
   },
   "include_indirect_links": {
    "default": true,
    "type": "boolean"
   },
   "include_subdomains": {
    "default": true,
    "type": "boolean"
   },
   "internal_list_limit": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_backlinks": {
    "maximum": 10000000,
    "minimum": 1,
    "type": "integer"
   },
   "min_referring_domains": {
    "maximum": 10000000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 20000,
    "minimum": 0,
    "type": "integer"
   },
   "rank_scale": {
    "default": "one_hundred",
    "enum": [
     "one_hundred",
     "one_thousand"
    ],
    "type": "string"
   },
   "sort_by": {
    "default": "backlinks",
    "enum": [
     "backlinks",
     "rank",
     "referring_domains",
     "spam_score",
     "broken_backlinks"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_backlinks_anchors",
 "title": "AgentSEO Backlinks Anchors"
}
