{
 "description": "Find ASTRA traffic counting stations near a geographic coordinate in Switzerland. Returns nearby stations with traffic volume data.",
 "inputSchema": {
  "properties": {
   "lat": {
    "description": "Latitude in WGS84 (e.g. 47.3769 for Z\u00fcrich)",
    "type": "number"
   },
   "lon": {
    "description": "Longitude in WGS84 (e.g. 8.5417 for Z\u00fcrich)",
    "type": "number"
   },
   "radius": {
    "description": "Search radius in meters (default: 5000)",
    "type": "number"
   }
  },
  "required": [
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "get_traffic_nearby"
}
