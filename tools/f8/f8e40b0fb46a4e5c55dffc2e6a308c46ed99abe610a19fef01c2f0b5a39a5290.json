{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Get a fresh guest shelf link"
 },
 "description": "Issue a new short-lived, one-time mobile or desktop web link for the existing guest shelf. Use only when the person asks to open or recover that shelf. Pass the private workspace_token as a tool argument; never show or put it in a URL. This adds no card and makes the previous view link invalid.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "workspace_token": {
    "pattern": "^mgw_[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "workspace_token"
  ],
  "type": "object"
 },
 "name": "refresh_guest_knowledge_shelf_link",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "card_count": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "card_limit": {
    "const": 10,
    "type": "number"
   },
   "expires_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "review_url": {
    "format": "uri",
    "type": "string"
   },
   "status": {
    "enum": [
     "guest_pending",
     "account_required"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "card_count",
   "card_limit",
   "review_url",
   "expires_at"
  ],
  "type": "object"
 },
 "title": "Get a fresh guest shelf link"
}
