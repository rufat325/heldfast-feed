{
 "description": "List messages. If inbox_id is omitted, uses the default inbox.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "inbox_id": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "string"
     }
    ],
    "description": "Inbox ID (optional, uses default inbox)"
   },
   "limit": {
    "description": "Max messages to return (default 20)",
    "type": "number"
   },
   "unread": {
    "description": "Only show unread messages",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_messages"
}
