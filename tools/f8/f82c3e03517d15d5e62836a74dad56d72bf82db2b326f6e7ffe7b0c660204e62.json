{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a calendar event on a Skylight frame.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "all_day": {
    "type": "boolean"
   },
   "category_ids": {
    "description": "Family-member category ids to assign the event to (see skylight_list_categories / skylight_resolve_member).",
    "items": {
     "type": [
      "string",
      "number"
     ]
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "ends_at": {
    "description": "ISO 8601 end.",
    "type": "string"
   },
   "frameId": {
    "type": "string"
   },
   "invited_emails": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location": {
    "type": "string"
   },
   "rrule": {
    "description": "iCalendar RRULE for recurrence.",
    "type": "string"
   },
   "starts_at": {
    "description": "ISO 8601 start.",
    "type": "string"
   },
   "summary": {
    "description": "Event title.",
    "type": "string"
   },
   "timezone": {
    "type": "string"
   }
  },
  "required": [
   "summary"
  ],
  "type": "object"
 },
 "name": "skylight_create_event"
}
