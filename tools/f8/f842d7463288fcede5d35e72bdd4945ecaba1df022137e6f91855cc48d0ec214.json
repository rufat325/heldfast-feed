{
 "_meta": {
  "openai/outputTemplate": "ui://widget/incidents-v2",
  "openai/toolInvocation/invoked": "Incident map ready.",
  "openai/toolInvocation/invoking": "Fetching live incidents\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://widget/incidents-v2"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Merged live incidents from all feeds plus manual reports. Filter by region key, category, group, severity, source, or bbox. Results come from a shared ~15-minute snapshot; real-time refresh requires an API key with that entitlement (details: cityalert.live/developers).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bbox": {
    "description": "[minLon, minLat, maxLon, maxLat]",
    "items": {
     "type": "number"
    },
    "maxItems": 4,
    "minItems": 4,
    "type": "array"
   },
   "category": {
    "description": "Incident category",
    "enum": [
     "crime",
     "fire",
     "disaster",
     "weather",
     "unrest",
     "health",
     "infra",
     "alert",
     "report"
    ],
    "type": "string"
   },
   "detail": {
    "description": "Response detail. 'full' (default): every field incl. description, neighbourhood and reporter/vote metadata. 'compact': id/type/title/coords/time/severity/url only \u2014 about half the tokens, for list-style answers.",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   },
   "groups": {
    "description": "Normalized subtypes to include, e.g. ['violent','property','collision','wildfire']. See group keys in the /api/incidents OpenAPI doc.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max incidents to return (default 50)",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "minSeverity": {
    "description": "Minimum severity (low < medium < high < critical)",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "q": {
    "description": "Case-insensitive substring match on type/title/neighbourhood",
    "maxLength": 100,
    "type": "string"
   },
   "refresh": {
    "description": "Re-fetch upstream feeds instead of returning the shared ~15-minute snapshot. Only honored for API keys with real-time entitlement; ignored otherwise.",
    "type": "boolean"
   },
   "region": {
    "description": "Focus-region key, e.g. 'vancouver' (see list_regions)",
    "type": "string"
   },
   "source": {
    "description": "Feed source, e.g. 'usgs', 'gdacs', 'eccc', 'vpd', 'bcws', 'vernon-media', 'manual'",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_incidents",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "delayMinutes": {
    "type": "number"
   },
   "delayed": {
    "type": "boolean"
   },
   "feeds": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "type": "number"
     },
     "failed": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "error": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "count",
     "failed"
    ],
    "type": "object"
   },
   "incidents": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "approximate": {
       "type": "boolean"
      },
      "category": {
       "type": "string"
      },
      "confirms": {
       "type": "number"
      },
      "count": {
       "type": "number"
      },
      "description": {
       "type": "string"
      },
      "flags": {
       "type": "number"
      },
      "group": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "lat": {
       "type": "number"
      },
      "lon": {
       "type": "number"
      },
      "nhood": {
       "type": "string"
      },
      "region": {
       "type": "string"
      },
      "reporter": {
       "additionalProperties": false,
       "properties": {
        "confirmed": {
         "type": "number"
        },
        "handle": {
         "type": "string"
        },
        "reports": {
         "type": "number"
        },
        "role": {
         "anyOf": [
          {
           "enum": [
            "curator",
            "moderator"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "handle",
        "role",
        "reports",
        "confirmed"
       ],
       "type": "object"
      },
      "resolves": {
       "type": "number"
      },
      "severity": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "sources": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "pending",
        "active",
        "resolved",
        "hidden"
       ],
       "type": "string"
      },
      "time": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "source",
      "category",
      "type",
      "title",
      "lat",
      "lon",
      "time",
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "region": {
    "type": "string"
   },
   "returned": {
    "type": "number"
   },
   "textTruncated": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "returned",
   "incidents",
   "feeds"
  ],
  "type": "object"
 },
 "title": "Get live incidents"
}
