{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List comments. Use this tool to list comments by IDs.",
 "inputSchema": {
  "properties": {
   "ids": {
    "description": "IDs of comments",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max_results": {
    "default": 5,
    "description": "The maximum number of items that should be returned, 0 for no limit",
    "minimum": 0,
    "type": "number"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|table",
    "enum": [
     "json",
     "yaml",
     "table"
    ],
    "type": "string"
   },
   "parent_id": {
    "description": "Returns replies to the specified comment",
    "type": "string"
   },
   "parts": {
    "default": [
     "id",
     "snippet"
    ],
    "description": "Comma separated parts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "text_format": {
    "default": "html",
    "description": "textFormatUnspecified|html|plainText",
    "enum": [
     "textFormatUnspecified",
     "html",
     "plainText"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "comment-list",
 "title": "List comments"
}
