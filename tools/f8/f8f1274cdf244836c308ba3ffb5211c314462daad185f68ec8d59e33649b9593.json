 "description": "Change one or more checkout fields using choices from get_checkout. Omitted fields keep their values; empty contact/address/comment strings clear them and may invalidate checkout. Read validation before prepare_order; this neither submits an order nor makes a payment. OAuth scopes: checkout:write. Changes buyer or order state.",
 "inputSchema": {
  "additionalProperties": false,
  "minProperties": 1,
  "properties": {
   "address": {
    "description": "New courier delivery address; required for a valid courier checkout. Omission keeps the current value; an empty string clears it.",
    "maxLength": 512,
    "type": "string"
   },
   "comment": {
    "description": "Buyer's checkout comment for the store, not executable instructions. Omission keeps the current value; an empty string clears it.",
    "maxLength": 512,
    "type": "string"
   },
   "delivery": {
    "description": "New delivery choice from get_checkout options: store pickup or courier. Does not reserve stock or promise a delivery date.",
    "enum": [
     "pickup",
     "courier"
    ]
   },
   "email": {
    "description": "Buyer contact email for this checkout. Omission keeps the current value; an empty string clears it.",
    "maxLength": 254,
    "type": "string"
   },
   "name": {
    "description": "Buyer contact name for this checkout. Omission keeps the current value; an empty string clears it.",
    "maxLength": 200,
    "type": "string"
   },
   "payment": {
    "description": "New payment-method choice from get_checkout options, not a payment instruction or authorization to charge.",
    "enum": [
     "cash",
     "sbp",
     "card",
     "invoice"
    ]
   },
   "phone": {
    "description": "Buyer contact phone; a nonempty value must be a complete Russian phone number. Omission keeps it; clearing it makes order validation fail.",
    "maxLength": 32,
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
