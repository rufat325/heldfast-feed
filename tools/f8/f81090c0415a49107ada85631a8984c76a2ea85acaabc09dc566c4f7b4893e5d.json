{
 "description": "List tasks in amoCRM. Filter by entity (lead/contact/company), completion status, or responsible user.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity_id": {
    "description": "Filter by entity ID (requires entity_type)",
    "type": "number"
   },
   "entity_type": {
    "description": "Filter by entity type",
    "enum": [
     "leads",
     "contacts",
     "companies"
    ],
    "type": "string"
   },
   "is_completed": {
    "description": "Filter by completion status",
    "type": "boolean"
   },
   "limit": {
    "description": "Items per page (max 250, default 50)",
    "maximum": 250,
    "type": "number"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "responsible_user_id": {
    "description": "Filter by responsible user",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list_tasks"
}
