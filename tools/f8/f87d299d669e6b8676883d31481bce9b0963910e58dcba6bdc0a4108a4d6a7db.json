{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a live stream. Use this tool to create a live stream.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Description of the live stream",
    "type": "string"
   },
   "frame_rate": {
    "description": "Frame rate of the video stream (30fps, 60fps, variable)",
    "enum": [
     "30fps",
     "60fps",
     "variable"
    ],
    "type": "string"
   },
   "ingestion_type": {
    "description": "Ingestion type (rtmp, dash, webrtc, hls)",
    "enum": [
     "rtmp",
     "dash",
     "webrtc",
     "hls"
    ],
    "type": "string"
   },
   "on_behalf_of_content_owner": {
    "description": "ID of the content owner, for YouTube content partners",
    "type": "string"
   },
   "on_behalf_of_content_owner_channel": {
    "description": "Channel ID for content owner operations",
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|silent",
    "enum": [
     "json",
     "yaml",
     "silent"
    ],
    "type": "string"
   },
   "parts": {
    "default": [
     "snippet",
     "cdn",
     "status"
    ],
    "description": "Comma separated parts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resolution": {
    "description": "Resolution of the video stream (240p, 360p, 480p, 720p, 1080p, 1440p, 2160p, variable)",
    "enum": [
     "240p",
     "360p",
     "480p",
     "720p",
     "1080p",
     "1440p",
     "2160p",
     "variable"
    ],
    "type": "string"
   },
   "title": {
    "description": "Title of the live stream",
    "type": "string"
   }
  },
  "required": [
   "title",
   "ingestion_type",
   "resolution"
  ],
  "type": "object"
 },
 "name": "liveStream-insert",
 "title": "Create a live stream"
}
