{
 "description": "Search posts by keyword (shortcut; wp_list_posts has every filter)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "integer"
   },
   "per_page": {
    "default": 10,
    "description": "Results per page (max 100)",
    "type": "integer"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "search"
  ],
  "type": "object"
 },
 "name": "wp_search_posts"
}
