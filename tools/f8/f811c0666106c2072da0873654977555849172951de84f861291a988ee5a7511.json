{
 "description": "Creates daily or session-based vibe coding session logs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "codeContexts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "codeBlocks": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "filename": {
          "type": "string"
         },
         "language": {
          "default": "text",
          "type": "string"
         }
        },
        "required": [
         "code"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "conversationSummary": {
       "type": "string"
      },
      "sessionId": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "sessionId",
      "timestamp",
      "codeBlocks",
      "conversationSummary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "designDecisions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alternatives": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "category": {
       "default": "other",
       "enum": [
        "architecture",
        "library",
        "pattern",
        "implementation",
        "other"
       ],
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "rationale": {
       "type": "string"
      },
      "timestamp": {
       "default": "2026-09-27T06:57:27.796Z",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "description",
      "rationale"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "duration": {
    "type": "number"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "format": {
      "default": "markdown",
      "enum": [
       "markdown",
       "json"
      ],
      "type": "string"
     },
     "logType": {
      "default": "session",
      "enum": [
       "daily",
       "session"
      ],
      "type": "string"
     },
     "outputPath": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "summary"
  ],
  "type": "object"
 },
 "name": "muse_create_session_log"
}
