{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List infrastructure assets"
 },
 "description": "List infrastructure assets (features - segments or nodes). Geometry is returned as GeoJSON (Point for nodes, LineString for segments) in EPSG:4326. Filter by network, feature_type, site, status, asset type, condition score range, or risk score range. Amounts are bare numbers with no currency: call get_organization_settings for currency_code before stating one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_type_id": {
    "description": "Filter by asset type ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "condition_max": {
    "description": "Maximum condition score (0-100)",
    "type": "number"
   },
   "condition_min": {
    "description": "Minimum condition score (0-100)",
    "type": "number"
   },
   "feature_type": {
    "description": "Filter by feature type",
    "enum": [
     "segment",
     "node"
    ],
    "type": "string"
   },
   "include_deleted": {
    "description": "Include soft-deleted features (\"true\") - default \"false\"",
    "enum": [
     "true",
     "false"
    ],
    "type": "string"
   },
   "network_id": {
    "description": "Filter by infrastructure network ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "page": {
    "description": "Page number (default: all pages fetched automatically)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default: 1000, max: 1000). All pages are fetched automatically.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "risk_score_max": {
    "description": "Maximum risk score",
    "type": "number"
   },
   "risk_score_min": {
    "description": "Minimum risk score",
    "type": "number"
   },
   "search": {
    "description": "Search by name",
    "maxLength": 200,
    "type": "string"
   },
   "site_id": {
    "description": "Filter by site ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status_id": {
    "description": "Filter by asset status ID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_infrastructure_assets",
 "title": "List infrastructure assets"
}
