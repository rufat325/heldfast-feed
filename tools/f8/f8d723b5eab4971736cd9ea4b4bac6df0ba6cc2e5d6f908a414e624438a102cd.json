{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Prepares an inquiry for one offer, for when the user has asked to inquire and given their email. voidjet emails the user a link; nothing is forwarded to the provider until the user opens it and sends the pre-filled form on voidjet.io within 48 hours. name, phone and message are optional, come from the user and only pre-fill the form. Prices are indicative.",
 "inputSchema": {
  "properties": {
   "email": {
    "description": "The user's email address.",
    "maxLength": 254,
    "title": "Email",
    "type": "string"
   },
   "flexible": {
    "default": false,
    "title": "Flexible",
    "type": "boolean"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "de"
    ],
    "title": "Locale",
    "type": "string"
   },
   "message": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Message"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 100,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Name"
   },
   "passengers": {
    "maximum": 19,
    "minimum": 1,
    "title": "Passengers",
    "type": "integer"
   },
   "phone": {
    "anyOf": [
     {
      "maxLength": 40,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Phone"
   },
   "ref": {
    "description": "ref exactly as returned by search_empty_legs.",
    "maxLength": 64,
    "title": "Ref",
    "type": "string"
   }
  },
  "required": [
   "ref",
   "email",
   "passengers"
  ],
  "title": "request_inquiryArguments",
  "type": "object"
 },
 "name": "request_inquiry",
 "outputSchema": {
  "properties": {
   "expires_at": {
    "format": "date-time",
    "title": "Expires At",
    "type": "string"
   },
   "message": {
    "title": "Message",
    "type": "string"
   },
   "status": {
    "const": "awaiting_user_confirmation",
    "title": "Status",
    "type": "string"
   }
  },
  "required": [
   "status",
   "expires_at",
   "message"
  ],
  "title": "InquiryResult",
  "type": "object"
 },
 "title": "Prepare an inquiry"
}
