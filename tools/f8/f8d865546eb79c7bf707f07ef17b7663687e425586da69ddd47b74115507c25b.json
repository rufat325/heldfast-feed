{
 "description": "Collect bounded public Hyperliquid wallet fills with provenance and explicit retention/pagination gaps. Save the returned history for strategy_infer. Read-only, never trades.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "days": {
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "endTime": {
    "minimum": 1,
    "type": "integer"
   },
   "maxPages": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "startTime": {
    "minimum": 0,
    "type": "integer"
   },
   "wallet": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "wallet"
  ],
  "type": "object"
 },
 "name": "strategy_wallet_history"
}
