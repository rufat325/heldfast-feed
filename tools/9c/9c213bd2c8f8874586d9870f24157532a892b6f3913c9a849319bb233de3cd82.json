{
 "description": "Enqueue a task to a Switchboard swarm queue",
 "inputSchema": {
  "properties": {
   "agentId": {
    "description": "0x\u2026 Optional if MCP server uses local signer identity.",
    "type": "string"
   },
   "auth": {
    "description": "Optional bring-your-own-auth mode.",
    "properties": {
     "signature": {
      "type": "string"
     },
     "timestamp": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "swarmId": {
    "type": "string"
   },
   "task": {
    "properties": {
     "data": {
      "additionalProperties": true,
      "type": "object"
     },
     "expiresAt": {
      "description": "ISO timestamp (recommended).",
      "type": "string"
     },
     "priority": {
      "enum": [
       "low",
       "normal",
       "high",
       "critical"
      ],
      "type": "string"
     },
     "requirements": {
      "additionalProperties": true,
      "type": "object"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   }
  },
  "required": [
   "swarmId",
   "task"
  ],
  "type": "object"
 },
 "name": "switchboard_task_enqueue"
}
