  "title": "My strategies"
 },
 "description": "Lists the saved strategies on the API key's account, newest first, archived ones included (active false): id, mode, engines, minimum confidence, direction and symbols. Use it to pick the strategy_id that run_backtest, update_strategy and delete_strategy take; for live bot activity use get_my_bots. limit keeps the newest N (default 20, at most 50); an account without strategies gets an empty list. An empty symbols list means any pair, so run_backtest then needs symbol. Needs an API key; read only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "How many of the newest strategies to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_my_strategies",
