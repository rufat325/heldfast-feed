{"description":"Search below-market used-car deals with filters (brand, model, price, year, mileage, fuel, body type, country, discount). Paginated; returns each deal with its listing, market stat, deal score and % below median.","inputSchema":{"properties":{"bodyTypes":{"description":"e.g. [\"kombi\",\"suv\",\"sedan\"]","items":{"type":"string"},"type":"array"},"brands":{"description":"Brand names, e.g. [\"BMW\",\"Audi\"]","items":{"type":"string"},"type":"array"},"countries":{"description":"Markets to include (default CZ)","items":{"enum":["CZ","SK","DE","AT","PL","HU","RO","LT","LV","NO"],"type":"string"},"type":"array"},"fuels":{"description":"Fuel types, e.g. [\"diesel\",\"benz\u00edn\",\"elektro\",\"hybrid\"]","items":{"type":"string"},"type":"array"},"maxMileage":{"description":"Maximum mileage in km","type":"integer"},"minDiscount":{"description":"Minimum % below market median (e.g. 20)","type":"number"},"models":{"description":"Model names (fuzzy matched), e.g. [\"A4\",\"Octavia\"]","items":{"type":"string"},"type":"array"},"page":{"description":"1-indexed page (default 1)","type":"integer"},"pageSize":{"description":"Results per page (default 20, max 100)","type":"integer"},"priceDropped":{"description":"Only listings whose price recently dropped","type":"boolean"},"priceMax":{"description":"Maximum price in CZK","type":"integer"},"priceMin":{"description":"Minimum price in CZK","type":"integer"},"sortBy":{"description":"Sort order (default deal_score)","enum":["deal_score","price","price_desc","date","listed","priceDropDate"],"type":"string"},"source":{"description":"Restrict to source slugs, e.g. [\"sauto\",\"tipcars\"]","items":{"type":"string"},"type":"array"},"vehicleTypes":{"description":"e.g. [\"used\",\"new\",\"demo\"]","items":{"type":"string"},"type":"array"},"yearMax":{"type":"integer"},"yearMin":{"type":"integer"}},"type":"object"},"name":"search_deals"}
