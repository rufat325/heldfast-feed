{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new MLflow experiment",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "artifactLocation": {
    "description": "Artifact storage location URI",
    "type": "string"
   },
   "name": {
    "description": "Experiment name (must be unique)",
    "type": "string"
   },
   "tags": {
    "description": "Tags to set on the experiment",
    "items": {
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create-experiment"
}
