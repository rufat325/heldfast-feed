    "properties": {
     "brand_id": {
      "anyOf": [
       {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "section_id": {
      "anyOf": [
       {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "section_id",
     "brand_id"
    ],
    "type": "object"
   },
   "filters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "maxLength": 150,
       "type": "string"
      },
      "max": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "min": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "selected_max": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "selected_min": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "selected_values": {
       "items": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
       },
       "type": "array"
      },
      "type": {
       "enum": [
        "select",
        "range"
       ]
      },
      "values": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "minimum": 0,
          "type": "integer"
         },
         "id": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
         },
         "label": {
          "maxLength": 300,
          "type": "string"
         },
         "selected": {
          "type": "boolean"
         }
        },
        "required": [
         "id",
         "label",
         "count",
         "selected"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "code",
      "label",
      "type",
      "min",
      "max",
      "selected_min",
      "selected_max",
      "selected_values",
      "values"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "filters",
   "context"
  ],
  "type": "object"
 }
}
