{
 "_meta": {
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "",
   "scopes": []
  },
  "vesremont.com/user-confirmation": false
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read available filter groups, values and ranges before a filtered search_products call. Supply a real section_id or brand_id and keep the same catalog context; use returned characteristic IDs, never invented IDs. This returns filter metadata, not product results. Public; no OAuth required. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "section_id"
    ]
   },
   {
    "required": [
     "brand_id"
    ]
   }
  ],
  "properties": {
   "brand_id": {
    "description": "Restrict to this brand ID returned by search_brands or product data, not its display name.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "filters": {
    "additionalProperties": false,
    "description": "Storefront catalog filters. Combine with the current section/brand context; REST encodes this object as one JSON query value.",
    "properties": {
     "charats_id": {
      "description": "Selected characteristic value IDs from contextual catalog filters. Do not invent IDs.",
      "items": {
       "description": "Selected characteristic value ID from get_catalog_filters, not the characteristic group ID.",
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 20,
      "type": "array",
      "uniqueItems": true
     },
     "price": {
      "additionalProperties": false,
      "description": "Catalog unit-price bounds in RUB, not basket totals or delivery charges. Supply at least one bound.",
      "minProperties": 1,
      "properties": {
       "max": {
        "description": "Maximum catalog unit price in RUB. If supplied, it must be greater than zero and not below min.",
        "maximum": 9999999999.99,
        "minimum": 0,
        "multipleOf": 0.01,
        "type": "number"
       },
       "min": {
        "description": "Minimum catalog unit price in RUB. Omit for no lower price restriction.",
        "maximum": 9999999999.99,
        "minimum": 0,
        "multipleOf": 0.01,
        "type": "number"
       }
      },
      "required": [],
      "type": "object"
     },
     "range_id": {
      "additionalProperties": {
       "additionalProperties": false,
       "description": "Both bounds for one real numeric characteristic; use its returned range ID as the map key.",
       "properties": {
        "max": {
         "description": "Upper bound in the same characteristic units as min. Must not be below min.",
         "maximum": 9999999999.99,
         "minimum": 0,
         "multipleOf": 0.01,
         "type": "number"
        },
        "min": {
         "description": "Lower bound in the characteristic units returned by get_catalog_filters. Must not exceed max.",
         "maximum": 9999999999.99,
         "minimum": 0,
         "multipleOf": 0.01,
         "type": "number"
        }
       },
       "required": [
        "min",
        "max"
       ],
       "type": "object"
      },
      "description": "Map of numeric characteristic range IDs to min/max bounds. Use the numeric part of returned range:<id>; price uses price, not range ID 1.",
      "maxProperties": 20,
      "propertyNames": {
       "pattern": "^(?:[2-9]|[1-9][0-9]{1,9})$"
      },
      "type": "object"
     },
     "section_ids": {
      "description": "Match any of these catalog sections (OR). Use real section IDs; do not combine with section_id.",
      "items": {
       "description": "One real catalog section ID, not a product or characteristic ID.",
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     }
    },
    "required": [],
    "type": "object"
   },
   "section_id": {
    "description": "Restrict to this real catalog section. Do not combine with filters.section_ids.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_catalog_filters",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "context": {
