{
 "description": "Add an expression to the watch list. The expression will be evaluated each time the process pauses.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "expression": {
    "description": "The expression to watch (e.g., \"x\", \"obj.prop\")",
    "type": "string"
   },
   "sessionId": {
    "description": "The debug session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "expression"
  ],
  "type": "object"
 },
 "name": "debugger_add_watch"
}
