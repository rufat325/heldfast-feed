 "description": "Walk the company graph (hundreds of thousands of employers with a verified web domain) by what a company is and how it hires: name or domain prefix, country of an office, size band, industry, ATS vendor, whether it is hiring right now, a minimum number of open roles, and the hiring-signal level (A = strong hiring momentum, B = active, C = some activity) or AI-adoption level (A/B/C from the roles it hires for). Each row carries the headquarters, open jobs, jobs added in the last 30 days, the last posting date, the signal score and when the site and board were last verified. Default order is by most recent posting; sort=open_jobs, score, newest or name are available. open_jobs counts the company's postings worldwide, and country means an office there - to rank employers by their postings in one place or role, call market_stats (top_employers) instead. Paginated with an opaque cursor. Staffing agencies are excluded unless include_agencies=true. Costs 1 unit per call.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "ai_level": {
    "description": "Minimum AI-adoption level from the roles the company hires for.",
    "enum": [
     "A",
     "B",
     "C"
    ],
    "type": "string"
   },
   "ats": {
    "description": "ATS vendor name, e.g. \"Greenhouse\", \"Lever\", \"Workday\", \"SmartRecruiters\".",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code or country name of an office on file.",
    "type": "string"
   },
   "cursor": {
    "description": "Opaque cursor from a previous response (next_cursor).",
    "type": "string"
   },
   "detail": {
    "default": "standard",
    "description": "\"compact\" keeps id, name, domain, industry, size, headquarters country and open jobs.",
    "enum": [
     "standard",
     "compact"
    ],
    "type": "string"
   },
   "hiring": {
    "description": "true = has open roles now, false = none open.",
    "type": "boolean"
   },
   "hiring_level": {
    "description": "Minimum hiring-signal level (A is the strongest).",
    "enum": [
     "A",
     "B",
     "C"
    ],
    "type": "string"
   },
   "include_agencies": {
    "default": false,
    "type": "boolean"
   },
   "industry": {
    "description": "Industry or segment by name, e.g. \"Fintech\", \"Healthcare\", \"E-commerce\".",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_open_jobs": {
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Name prefix (\"Acme\") or domain prefix (\"acme.\").",
    "type": "string"
   },
   "size": {
    "description": "Employee band or a comma list of bands: 1-10, 11-50, 51-200, 201-500, 501-1000, 1001-5000, 5000+.",
    "type": "string"
   },
   "sort": {
    "default": "recent_hiring",
    "enum": [
     "recent_hiring",
     "open_jobs",
     "score",
     "newest",
     "name"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
