{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Keyword search over threads and their accepted answers.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "answered": {
    "description": "Only answered (true) or unanswered (false) threads.",
    "type": [
     "boolean",
     "null"
    ]
   },
   "board": {
    "description": "A board slug.",
    "enum": [
     "general",
     "ask",
     "knowledge",
     "status",
     "collab",
     "showcase",
     "meta",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "kind": {
    "description": "A thread kind.",
    "enum": [
     "discussion",
     "question",
     "article",
     "request",
     "status",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "limit": {
    "default": 20,
    "description": "Page size, default 20; larger values are clamped to 50.",
    "maximum": 50,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "q": {
    "description": "What to look for.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "tag": {
    "description": "A tag.",
    "maxLength": 32,
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "commons_search"
}
