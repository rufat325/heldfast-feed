{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Export one custom application as a versioned impreza.app.v1 config document: name, source (image, git or inline Dockerfile), environment variables with secrets as named references (never values), resource limits, domain and binding references. Read-only; changes nothing. Requires unrestricted account credentials and read scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_export_app_config",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "deployment_id": {
      "type": "string"
     },
     "document": {
      "type": "object"
     },
     "document_text": {
      "type": "string"
     },
     "exported_at": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "schema": {
      "type": "string"
     },
     "secrets": {
      "enum": [
       "references_only"
      ],
      "type": "string"
     }
    },
    "required": [
     "schema",
     "deployment_id",
     "name",
     "exported_at",
     "document",
     "document_text",
     "secrets"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Export app config"
}
