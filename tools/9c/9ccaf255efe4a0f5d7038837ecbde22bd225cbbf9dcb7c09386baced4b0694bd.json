{
 "description": "Inspect URLs' Google index status and resubmit the covering sitemap for the ones not indexed, the supported bulk recrawl nudge (write; supports dryRun)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "concurrency": {
    "default": 3,
    "description": "Concurrent URL Inspection requests",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "dryRun": {
    "default": false,
    "description": "If true, inspect and report without resubmitting the sitemap",
    "type": "boolean"
   },
   "feedpath": {
    "description": "Sitemap to resubmit when unindexed URLs are found; defaults to sitemapUrl",
    "format": "uri",
    "type": "string"
   },
   "maxUrls": {
    "default": 20,
    "description": "Maximum sitemap URLs to inspect",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "siteUrl": {
    "description": "Search Console property containing the URLs",
    "minLength": 1,
    "type": "string"
   },
   "sitemapUrl": {
    "description": "Sitemap to read URLs from; also the default sitemap to resubmit",
    "format": "uri",
    "type": "string"
   },
   "urls": {
    "description": "Explicit URLs to check; omit to read them from sitemapUrl",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "request_recrawl",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checked": {
    "type": "number"
   },
   "dryRun": {
    "type": "boolean"
   },
   "failed": {
    "type": "number"
   },
   "indexed": {
    "type": "number"
   },
   "notIndexed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "coverageState": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "coverageState"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "resubmit": {
    "additionalProperties": false,
    "properties": {
     "feedpath": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "performed": {
      "type": "boolean"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "performed",
     "feedpath",
     "reason"
    ],
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "coverageState": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "error": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "indexed": {
       "type": "boolean"
      },
      "lastCrawlTime": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      },
      "verdict": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "url",
      "coverageState",
      "verdict",
      "indexed",
      "lastCrawlTime",
      "error"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "siteUrl": {
    "type": "string"
   },
   "totalDiscovered": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "siteUrl",
   "checked",
   "indexed",
   "notIndexed",
   "failed",
   "totalDiscovered",
   "truncated",
   "resubmit",
   "results"
  ],
  "type": "object"
 }
}
