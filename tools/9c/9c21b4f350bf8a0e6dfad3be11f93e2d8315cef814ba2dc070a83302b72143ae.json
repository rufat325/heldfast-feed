{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the reviewed MCP directory. Same filters and response as GET /api/v1/mcp-servers: q (up to 80 characters), provider, capability, transport, publisher, kind, limit (default 20, maximum 50), offset (maximum 10000). Filters combine with AND; missing evidence never matches a capability. Alphabetical name/slug ordering. Reads our catalog without calling listed servers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "enum": [
     "web-search",
     "scraping-extraction",
     "browser-automation",
     "proxy-management",
     "provider-discovery",
     "price-comparison"
    ],
    "type": "string"
   },
   "kind": {
    "enum": [
     "provider-integration",
     "service-integration",
     "directory"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "provider": {
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "publisher": {
    "enum": [
     "official",
     "community"
    ],
    "type": "string"
   },
   "q": {
    "maxLength": 80,
    "type": "string"
   },
   "transport": {
    "enum": [
     "stdio",
     "streamable-http",
     "sse"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_mcp_servers",
 "title": "Find provider MCP servers"
}
