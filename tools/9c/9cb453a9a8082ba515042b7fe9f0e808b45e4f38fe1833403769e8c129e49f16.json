{
 "annotations": {
  "readOnlyHint": true,
  "title": "List group channel members"
 },
 "description": "List the members of a group channel. Platform API: GET /group_channels/{channel_url}/members. Returns { members[], next }.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "channel_url": {
    "description": "Group channel URL (percent-encoded automatically).",
    "type": "string"
   },
   "limit": {
    "description": "Page size, 1-100. Default 10.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "member_state_filter": {
    "description": "Filter by invitation/join state (e.g. joined, invited, invited_by_friend).",
    "type": "string"
   },
   "operator_filter": {
    "description": "Filter by operator status. Default all.",
    "enum": [
     "all",
     "operator",
     "nonoperator"
    ],
    "type": "string"
   },
   "order": {
    "description": "Sort order of members.",
    "enum": [
     "member_nickname_alphabetical",
     "operator_then_member_alphabetical"
    ],
    "type": "string"
   },
   "show_delivery_receipt": {
    "description": "Include each member's delivery receipt.",
    "type": "boolean"
   },
   "show_read_receipt": {
    "description": "Include each member's read receipt.",
    "type": "boolean"
   },
   "token": {
    "description": "Pagination token from a previous response's `next`.",
    "type": "string"
   }
  },
  "required": [
   "channel_url"
  ],
  "type": "object"
 },
 "name": "sendbird_list_group_channel_members",
 "title": "List group channel members"
}
