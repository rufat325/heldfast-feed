{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Read a filing section"},"description":"Use when someone asks what a filing says in a section, wants its section index, or needs a sourced excerpt. A metric row label with a section returns a table row, its definition or footnote, and the SEC page. A phrase with a section or attachment filename returns one matching sentence and its printed SEC page. The API URL opens the primary filing's sections. A regular section lookup returns up to 20,000 characters and reports truncation.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"attachment":{"description":"Exact HTML filename listed for an exhibit under this accession. Used with contains.","pattern":"^[a-z0-9][a-z0-9._-]{0,119}\\.html?$","type":"string"},"contains":{"description":"A distinctive phrase in the original wording. Requires either a section or an attachment filename.","maxLength":180,"minLength":6,"type":"string"},"filing_id":{"pattern":"^\\d{1,10}-\\d{18}$","type":"string"},"max_characters":{"default":12000,"maximum":20000,"minimum":500,"type":"integer"},"metric":{"description":"Exact metric row label as filed, for example ARPU. Requires a section.","maxLength":80,"minLength":1,"type":"string"},"section":{"pattern":"^[a-z0-9-]{1,80}$","type":"string"}},"required":["filing_id"],"type":"object"},"name":"read_filing_section","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"api_url":{"type":"string"},"citation":{"additionalProperties":false,"properties":{"accession":{"type":"string"},"attachment":{"type":"string"},"filingDate":{"type":"string"},"form":{"type":"string"},"page":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"reportDate":{"type":"string"},"section":{"type":"string"},"url":{"type":"string"}},"required":["accession","filingDate","reportDate","url","page","section","form"],"type":"object"},"definition":{"type":["string","null"]},"docs_url":{"type":"string"},"error":{"maxLength":80,"type":"string"},"excerpt":{"type":"string"},"footnote":{"type":["string","null"]},"http_status":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"id":{"type":"string"},"index_only":{"type":"boolean"},"message":{"type":"string"},"meta":{"additionalProperties":{"type":["string","number","boolean","null"]},"propertyNames":{"type":"string"},"type":"object"},"parserVersion":{"type":"string"},"product":{"const":"filings","type":"string"},"retry_after":{"maxLength":80,"type":"string"},"section_found":{"type":"boolean"},"sections":{"items":{"additionalProperties":false,"properties":{"chars":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"id":{"type":"string"},"markdown":{"maxLength":20000,"type":"string"},"returned_characters":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"title":{"type":"string"},"truncated":{"type":"boolean"}},"required":["id","title","chars"],"type":"object"},"maxItems":80,"type":"array"},"sections_truncated":{"type":"boolean"},"sourceUrl":{"type":"string"},"status":{"enum":["success","tool_error","internal_error"],"type":"string"},"table":{"additionalProperties":false,"properties":{"periods":{"items":{"type":"string"},"type":"array"},"row":{"items":{"type":"string"},"type":"array"}},"required":["periods","row"],"type":"object"},"title":{"type":"string"},"topics":{"items":{"type":"string"},"type":"array"},"usage":{"additionalProperties":{"type":"string"},"propertyNames":{"type":"string"},"type":"object"}},"required":["status","docs_url"],"type":"object"},"title":"Read a filing section"}
