{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "analytics:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://agent-analytics/funnel-v4"
  },
  "ui/resourceUri": "ui://agent-analytics/funnel-v4"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Funnel analysis: track where users drop off across a sequence of events (e.g. page_view \u2192 signup \u2192 purchase). Returns per-step user counts, conversion rates, and average time between steps. Anonymous preview is limited to agentanalytics-demo synthetic read-only data; sign in for your own projects.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "breakdown": {
    "description": "Property key to segment by (e.g. 'variant', 'country'). Extracted from step 1 events.",
    "type": "string"
   },
   "breakdown_limit": {
    "default": 10,
    "description": "Max breakdown groups (default 10, max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "conversion_window_hours": {
    "default": 168,
    "description": "Max hours from step 1 to last step (default: 168 = 7 days)",
    "maximum": 8760,
    "minimum": 1,
    "type": "number"
   },
   "count_by": {
    "default": "user_id",
    "description": "Count by users or sessions",
    "enum": [
     "user_id",
     "session_id"
    ],
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "since": {
    "default": "30d",
    "description": "Lookback period (e.g. '30d', '90d', or ISO date)",
    "type": "string"
   },
   "steps": {
    "description": "Funnel steps (2-8), each with an event name and optional filters",
    "items": {
     "properties": {
      "event": {
       "description": "Event name for this step",
       "type": "string"
      },
      "filters": {
       "description": "Optional property filters for this step",
       "items": {
        "properties": {
         "op": {
          "description": "Filter operator",
          "enum": [
           "eq",
           "neq",
           "contains"
          ],
          "type": "string"
         },
         "property": {
          "description": "Property key to filter on",
          "type": "string"
         },
         "value": {
          "description": "Filter value",
          "type": "string"
         }
        },
        "required": [
         "property",
         "op",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "event"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "project",
   "steps"
  ],
  "type": "object"
 },
 "name": "analytics_funnel",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "analytics:read"
   ],
   "type": "oauth2"
  }
 ]
}
