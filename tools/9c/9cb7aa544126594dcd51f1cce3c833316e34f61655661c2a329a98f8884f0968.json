{
 "description": "EU AI Act compliance check. Evaluates an AI system against EU AI Act requirements.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "EU AI Act risk category",
    "enum": [
     "minimal",
     "limited",
     "high",
     "unacceptable"
    ],
    "type": "string"
   },
   "dataGovernance": {
    "description": "Whether data governance measures are implemented",
    "type": "boolean"
   },
   "hasAccuracyMetrics": {
    "description": "Whether accuracy and robustness metrics are tracked",
    "type": "boolean"
   },
   "hasDocumentation": {
    "description": "Whether technical documentation exists",
    "type": "boolean"
   },
   "hasHumanOversight": {
    "description": "Whether human oversight is implemented",
    "type": "boolean"
   },
   "hasRiskManagement": {
    "description": "Whether risk management system is in place",
    "type": "boolean"
   },
   "hasTransparency": {
    "description": "Whether transparency obligations are met",
    "type": "boolean"
   },
   "systemName": {
    "description": "Name of the AI system",
    "type": "string"
   }
  },
  "required": [
   "systemName",
   "category",
   "hasHumanOversight",
   "hasDocumentation",
   "hasRiskManagement",
   "dataGovernance",
   "hasTransparency",
   "hasAccuracyMetrics"
  ],
  "type": "object"
 },
 "name": "compliance_check"
}
