ng"},"evidence":{"anyOf":[{"$ref":"#/$defs/Evidence"},{"type":"null"}],"default":null},"failure_code":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Failure Code"},"from":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"From"},"id":{"title":"Id","type":"string"},"one_time_order_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"One Time Order Id"},"pages_sent":{"title":"Pages Sent","type":"integer"},"quality":{"default":"fine","title":"Quality","type":"string"},"quote_id":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Quote Id"},"receipt_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Once the fax has ended: the dashboard page with its receipt, for a signed-in person.","title":"Receipt Url"},"route":{"title":"Route","type":"string"},"route_paused":{"default":false,"title":"Route Paused","type":"boolean"},"sender_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Sender Name"},"state":{"enum":["queued","active","partial","failed","unknown","delivered"],"title":"State","type":"string"},"to":{"title":"To","type":"string"}},"required":["id","environment","state","to","route","document_id","billable_pages","cover_pages","pages_sent","amount_micro","captured_micro","currency","attempt_count","created_at"],"title":"FaxJob","type":"object"}},"additionalProperties":false,"properties":{"attempts":{"anyOf":[{"items":{"$ref":"#/$defs/Attempt"},"type":"array"},{"type":"null"}],"default":null,"title":"Attempts"},"details":{"default":null,"description":"The API's error details, when a refusal carries any, cut to the keys in DETAIL_KEYS. A field it names (details.field) is this tool's argument.","title":"Details"},"error_code":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Error Code"},"fax":{"anyOf":[{"$ref":"#/$defs/FaxJob"},{"type":"null"}],"default":null,"description":"The job; once delivered or partial, fax.evidence