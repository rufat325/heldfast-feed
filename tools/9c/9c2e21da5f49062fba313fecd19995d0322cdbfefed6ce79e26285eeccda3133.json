{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get fax status"},"description":"Read one outbound fax's delivery state and attempts. Use after send_approved_fax or list_faxes. Use get_review_status for a human approval decision and read_inbound_fax for a received fax. Returns queued, active, delivered, partial, failed or unknown, plus carrier evidence when delivered or partial. Evidence is not legal proof of acceptance. Repeated polls are safe and free, with no send or approval side effects. Scope: fax:read.","inputSchema":{"additionalProperties":false,"properties":{"fax_id":{"description":"Outbound fax id from send_approved_fax or list_faxes. Format: fax_ followed by 32 lowercase hexadecimal characters. Required, no default. This is a delivery job, not an approval request or inbox item.","examples":["fax_0123456789abcdef0123456789abcdef"],"pattern":"^fax_[0-9a-f]{32}$","title":"Fax Id","type":"string"}},"required":["fax_id"],"title":"get_fax_statusArguments","type":"object"},"name":"get_fax_status","outputSchema":{"$defs":{"Attempt":{"additionalProperties":false,"properties":{"attempt_number":{"title":"Attempt Number","type":"integer"},"evidence":{"anyOf":[{"$ref":"#/$defs/Evidence"},{"type":"null"}],"default":null},"failure_code":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Failure Code"},"pages_sent":{"title":"Pages Sent","type":"integer"},"status":{"title":"Status","type":"string"}},"required":["attempt_number","status","pages_sent"],"title":"Attempt","type":"object"},"Evidence":{"additionalProperties":false,"description":"What the carrier reported about a delivered or partial fax, without its raw payload, its call ids\nand its signature material. The keys differ by carrier: each one keeps what it reports.","properties":{"completed_at":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Completed At"},"from":{"anyOf":[{"type":"string"},{"type":"null"}],"defa