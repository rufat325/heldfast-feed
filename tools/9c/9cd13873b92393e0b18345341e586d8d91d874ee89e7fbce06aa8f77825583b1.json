{
 "description": "Equip an item from inventory to an equipment slot. Automatically unequips existing item if slot is occupied (unless disabled).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "characterId": {
    "description": "Character ID",
    "type": "string"
   },
   "itemId": {
    "description": "Item instance ID to equip",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "slot": {
    "description": "Equipment slot to use",
    "enum": [
     "mainHand",
     "offHand",
     "head",
     "body",
     "hands",
     "feet",
     "accessory1",
     "accessory2"
    ],
    "type": "string"
   },
   "unequipExisting": {
    "default": true,
    "description": "Automatically unequip existing item in slot",
    "type": "boolean"
   }
  },
  "required": [
   "sessionId",
   "characterId",
   "itemId",
   "slot"
  ],
  "type": "object"
 },
 "name": "equip_item"
}
