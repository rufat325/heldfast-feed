{
 "_meta": {
  "openai/outputTemplate": "ui://esimoa/plans.html",
  "openai/toolInvocation/invoked": "Compared plans",
  "openai/toolInvocation/invoking": "Comparing plans\u2026",
  "ui": {
   "resourceUri": "ui://esimoa/plans.html"
