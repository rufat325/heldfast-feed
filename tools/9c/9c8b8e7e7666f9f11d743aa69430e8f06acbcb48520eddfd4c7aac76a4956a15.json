{
 "description": "Create a bank transfer (TED/DOC) via Celcoin",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Recipient account number",
    "type": "string"
   },
   "accountType": {
    "description": "CC=Checking, CP=Savings, PG=Payment",
    "enum": [
     "CC",
     "CP",
     "PG"
    ],
    "type": "string"
   },
   "amount": {
    "description": "Amount in BRL",
    "type": "number"
   },
   "bankCode": {
    "description": "Recipient bank code (ISPB or COMPE)",
    "type": "string"
   },
   "branch": {
    "description": "Recipient branch number",
    "type": "string"
   },
   "description": {
    "description": "Transfer description",
    "type": "string"
   },
   "recipientDocument": {
    "description": "Recipient CPF/CNPJ",
    "type": "string"
   },
   "recipientName": {
    "description": "Recipient name",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "bankCode",
   "branch",
   "account",
   "accountType",
   "recipientName",
   "recipientDocument"
  ],
  "type": "object"
 },
 "name": "create_transfer"
}
