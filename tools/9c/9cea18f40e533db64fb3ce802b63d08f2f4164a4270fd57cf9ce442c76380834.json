{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an enrichment template",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "answerType": {
      "description": "The expected format of the answer",
      "enum": [
       "open_text",
       "number",
       "boolean",
       "list",
       "percentage",
       "currency",
       "url",
       "contacts",
       "contact_posts",
       "contact_engagements",
       "json_schema"
      ],
      "example": "open_text",
      "type": "string"
     },
     "description": {
      "description": "Optional description of what this template does",
      "example": "Identifies which CRM system a company is using",
      "maxLength": 1000,
      "type": "string"
     },
     "name": {
      "description": "User-friendly name for the template",
      "example": "CRM Detection",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "outputSchema": {
      "additionalProperties": {},
      "description": "JSON Schema defining the expected output structure. Required when answerType is \"json_schema\".\n",
      "properties": {},
      "type": "object"
     },
     "qualificationCriteria": {
      "additionalProperties": {},
      "description": "Qualification criteria mapping answer values based on answerType",
      "properties": {},
      "type": "object"
     },
     "question": {
      "description": "The research question to ask about companies",
      "example": "Which CRM are they using?",
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     "weight": {
      "description": "The importance/weight of the signal",
      "enum": [
       "important",
       "nice_to_have",
       "not_important"
      ],
      "example": "important",
      "type": "string"
     }
    },
    "type": "object"
   },
   "templateId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "templateId",
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "enrichment_templates-update"
}
