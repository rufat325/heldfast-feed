{
 "description": "Upload a screenshot (reserves slot, then uploads binary)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileName": {
    "description": "File name (e.g. screen1.png)",
    "type": "string"
   },
   "filePath": {
    "description": "Local path to the screenshot image",
    "type": "string"
   },
   "fileSize": {
    "description": "File size in bytes",
    "type": "number"
   },
   "screenshotSetId": {
    "description": "Screenshot Set ID",
    "type": "string"
   }
  },
  "required": [
   "screenshotSetId",
   "filePath",
   "fileName",
   "fileSize"
  ],
  "type": "object"
 },
 "name": "apple_upload_screenshot"
}
