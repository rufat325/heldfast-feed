{
 "description": "Edit a resource. Only include fields you want to change. Set is_featured to surface it; set is_published=false to unlist.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_level": {
    "enum": [
     "public",
     "members",
     "premium"
    ],
    "type": "string"
   },
   "cover_image_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "description": {
    "maxLength": 20000,
    "type": "string"
   },
   "file_url": {
    "format": "uri",
    "type": "string"
   },
   "folder_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "is_featured": {
    "type": "boolean"
   },
   "is_premium": {
    "type": "boolean"
   },
   "is_published": {
    "type": "boolean"
   },
   "price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "resource_type": {
    "enum": [
     "guide",
     "toolkit",
     "course",
     "checklist",
     "template",
     "other"
    ],
    "type": "string"
   },
   "resource_url": {
    "format": "uri",
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 50,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "hivelearn_update_resource"
}
