{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Puts a challenge on a date after today. challenge_id is a challenge id, as find_next_challenge and ladder give them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "challenge_id": {
    "maxLength": 64,
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD, after today.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "challenge_id",
   "date"
  ],
  "type": "object"
 },
 "name": "add_challenge",
 "title": "Put a challenge on the calendar"
}
