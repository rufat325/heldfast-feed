{
 "description": "Create or replace the weekly content schedule for the active brand. dayConfigs: array of { dayOfWeek (0=Sun\u20266=Sat), mediums: [{ medium, postsPerDay }] }. Mediums: x/twitter | linkedin | instagram | facebook | threads | blog. After setting, call enable_weekly_schedule to activate it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "dayConfigs": {
    "description": "Array of day configs. Omit a day to have no posts that day.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dayOfWeek": {
       "description": "0=Sunday \u2026 6=Saturday",
       "maximum": 6,
       "minimum": 0,
       "type": "integer"
      },
      "mediums": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "medium": {
          "description": "Platform medium: x/twitter | linkedin | instagram | facebook | threads | blog",
          "type": "string"
         },
         "postsPerDay": {
          "maximum": 5,
          "minimum": 1,
          "type": "integer"
         },
         "voiceProfileId": {
          "anyOf": [
           {
            "anyOf": [
             {
              "not": {}
             },
             {
              "type": "string"
             }
            ]
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "medium",
         "postsPerDay"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "dayOfWeek",
      "mediums"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "enabled": {
    "default": true,
    "description": "Whether the schedule is active",
    "type": "boolean"
   },
   "leadTimeDays": {
    "default": 3,
    "description": "How many days ahead to generate content (1\u20137)",
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   },
   "timezone": {
    "default": "America/New_York",
    "description": "Timezone for scheduling, e.g. 'Europe/London'",
    "type": "string"
   },
   "voiceProfileId": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Default voice profile ID (optional)"
   }
  },
  "required": [
   "dayConfigs"
  ],
  "type": "object"
 },
 "name": "set_weekly_schedule"
}
