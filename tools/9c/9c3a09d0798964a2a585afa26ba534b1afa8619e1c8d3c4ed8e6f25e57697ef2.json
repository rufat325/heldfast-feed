{
 "description": "Analyze component source code to detect which library is used, identify patterns, and get migration suggestions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "analyzePatterns": {
    "default": true,
    "description": "Analyze component patterns and structure",
    "type": "boolean"
   },
   "code": {
    "description": "Component source code to analyze",
    "type": "string"
   },
   "detectLibrary": {
    "default": true,
    "description": "Detect which component library is being used",
    "type": "boolean"
   },
   "filePath": {
    "description": "File path for context (e.g., src/components/Button.tsx)",
    "type": "string"
   },
   "suggestMigration": {
    "default": false,
    "description": "Suggest migration path to a target library",
    "type": "boolean"
   },
   "targetLibrary": {
    "description": "Target library for migration suggestions",
    "enum": [
     "shadcn",
     "radix",
     "headlessui",
     "material",
     "primevue",
     "none"
    ],
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "analyze_component_library"
}
