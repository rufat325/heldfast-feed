{
 "description": "Request a one-time virtual credit card for an automated purchase. ONLY call when card input fields are visible on the checkout page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page_url": {
    "description": "Current checkout page URL",
    "type": "string"
   },
   "reasoning": {
    "description": "Agent reasoning for the payment",
    "type": "string"
   },
   "requested_amount": {
    "description": "Amount to authorize",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "target_vendor": {
    "description": "Human-readable vendor name (e.g. 'AWS', 'Wikipedia')",
    "type": "string"
   }
  },
  "required": [
   "requested_amount",
   "target_vendor",
   "reasoning"
  ],
  "type": "object"
 },
 "name": "request_virtual_card"
}
