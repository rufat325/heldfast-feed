{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Search for a term and replace it within a specific collection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "docId": {
    "description": "Limit to a specific document ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filter": {
    "description": "Filter string",
    "type": "string"
   },
   "legacy": {
    "default": false,
    "description": "Use legacy search",
    "type": "boolean"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "replaceTerm": {
    "description": "Replacement term",
    "type": "string"
   },
   "rows": {
    "default": 10,
    "description": "Number of results",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "searchTerm": {
    "description": "Term to search for",
    "type": "string"
   },
   "start": {
    "default": 0,
    "description": "Start offset",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Search type",
    "type": "string"
   }
  },
  "required": [
   "collId",
   "searchTerm",
   "replaceTerm"
  ],
  "type": "object"
 },
 "name": "transkribus_search_replace_in_collection",
 "title": "Search and Replace in Collection"
}
