{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Context Window Planner"
 },
 "description": "Use when a user needs to know whether a document plus prompt plus output fits within a model's context window, or wants a strategy recommendation (truncate/summarize/rag/chunk).",
 "inputSchema": {
  "examples": [
   {
    "doc_tokens": 18000,
    "model_context_window": 200000
   }
  ],
  "properties": {
   "doc_tokens": {
    "description": "Primary document/content tokens",
    "minimum": 0,
    "type": "number"
   },
   "expected_out_tokens": {
    "description": "Reserved output budget (default 1000)",
    "minimum": 0,
    "type": "number"
   },
   "model_context_window": {
    "description": "Target model context size",
    "minimum": 1,
    "type": "number"
   },
   "overhead_tokens": {
    "description": "System prompt + few-shot + history (default 2000)",
    "minimum": 0,
    "type": "number"
   },
   "strategy_hint": {
    "description": "Preferred strategy (optional)",
    "enum": [
     "truncate",
     "summarize",
     "rag",
     "chunk"
    ],
    "type": "string"
   }
  },
  "required": [
   "doc_tokens",
   "model_context_window"
  ],
  "type": "object"
 },
 "name": "context-window-planner",
 "title": "Context Window Planner"
}
