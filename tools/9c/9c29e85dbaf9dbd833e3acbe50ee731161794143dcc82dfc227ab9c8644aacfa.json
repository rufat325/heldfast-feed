{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List call logs"
 },
 "description": "Retrieve call logs with pagination and optional filtering.\n(Tags: Calls)",
 "inputSchema": {
  "properties": {
   "agentid": {
    "description": "Filter by agent ID.",
    "type": "number"
   },
   "bulk_call_id": {
    "description": "Filter by bulk-call campaign ID.",
    "type": "number"
   },
   "call_status": {
    "description": "Filter by call outcome.",
    "enum": [
     "completed",
     "busy",
     "failed",
     "no-answer"
    ],
    "type": "string"
   },
   "pageno": {
    "default": 1,
    "description": "Page number for pagination.",
    "minimum": 1,
    "type": "integer"
   },
   "pagesize": {
    "default": 30,
    "description": "Number of items per page.",
    "maximum": 150,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "listCallLogs"
}
