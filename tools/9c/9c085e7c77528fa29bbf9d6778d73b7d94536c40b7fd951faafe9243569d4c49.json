{
 "description": "Add a module to a course. sort_order is optional \u2014 server auto-appends if omitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "course_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "sort_order": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "title"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_module"
}
