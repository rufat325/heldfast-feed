 "description": "Prepare a provisional application and return the human claim URL. A human must claim and pay. This does not file, charge, or approve.",
 "inputSchema": {
  "properties": {
   "assessment": {
    "properties": {
     "foreignOwnedCaution": {
      "type": "boolean"
     },
     "goal": {
      "description": "Trimmed and truncated to 500 characters.",
      "type": "string"
     },
     "hasEin": {
      "description": "Other values are treated as unknown, not rejected.",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "hasUsEntity": {
      "description": "Other values are treated as unknown, not rejected.",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "intendedEmail": {
      "description": "Optional. When a valid email is supplied it is stored on the assessment; later prepare must use the same recipient. Invalid values are ignored, not rejected.",
      "type": "string"
     },
     "jurisdictionKnown": {
      "description": "Other values are treated as unknown, not rejected.",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "providerRequiresEin": {
      "description": "Other values are treated as unknown, not rejected.",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "providerRequiresUsEntity": {
      "description": "Other values are treated as unknown, not rejected.",
      "enum": [
       "yes",
       "no",
       "unknown"
      ],
      "type": "string"
     },
     "selectedState": {
      "description": "Trimmed and truncated to 80 characters.",
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "assessmentId": {
    "description": "When present, the server-stored assessment is bound in one transaction with the application and authority. Same assessment plus intended email recovers the same application when the stored preparation matches. Facts and intended recipient must match the stored assessment. A different assessment cannot reuse an explicit operationId.",
    "type": "string"
   },
   "assessmentOutcome": {
    "description": "Fallback when preparation.assessmentOutcome is absent and no assessmentId/assessment is bound. Trimmed/truncated to 80 characters. Unknown values are refused. already_satisfied and not_needed_now are refused. insufficient_information cannot issue a claim token. Unbound allowed enum remains provisional advice, not actionable authorization.",
    "type": "string"
   },
   "intendedEmail": {
    "description": "Trimmed/lowercased; invalid or missing email produces an incomplete application, not a claim token.",
    "type": "string"
   },
   "operationId": {
    "description": "Optional caller idempotency key for a bound prepare. Trimmed and limited to 200 characters. When omitted, the key is prepare:{assessmentId}:{intendedEmailNormalized} and is specific to that assessment and recipient, and a missing key still recovers the application already bound to that assessment. An explicit key is not namespaced by assessment: it determines one durable application id. Reusing it for a different assessment returns 409 operation_identity_conflict. Supplying a different explicit key when this assessment is already bound returns the same 409, does not reserve that key, and returns no claim token. The same assessment with a different stored preparation returns 409 operation_payload_mismatch. Both leave the application, assessment, and authority unchanged and return no claim token. The same assessment, recipient, and stored preparation returns the original application and claim token and does not write again.",
    "type": "string"
   },
   "preparation": {
    "properties": {
     "assessmentOutcome": {
      "description": "Allowlisted and normalized; strings are trimmed/truncated, invalid enum values discarded.",
      "type": "string"
     },
     "existingEntityStatus": {
      "description": "Allowlisted and normalized; strings are trimmed/truncated, invalid enum values discarded.",
      "type": "string"
     },
     "goal": {
      "description": "Allowlisted and normalized; strings are trimmed/truncated, invalid enum values discarded.",
      "type": "string"
     },
     "intendedEmail": {
      "description": "Fallback when top-level intendedEmail is absent.",
      "type": "string"
     },
     "jurisdiction": {
      "description": "Allowlisted and normalized; strings are trimmed/truncated, invalid enum values discarded.",
      "type": "string"
     },
     "notes": {
      "description": "Allowlisted and normalized; strings are trimmed/truncated, invalid enum values discarded.",
      "type": "string"
     },
     "providerPath": {
      "description": "Allowlisted and normalized; strings are trimmed/truncated, invalid enum values discarded.",
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   }
  },
  "required": [],
  "type": "object"
 },
