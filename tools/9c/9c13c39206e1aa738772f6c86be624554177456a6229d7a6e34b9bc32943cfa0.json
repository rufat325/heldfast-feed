{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Where the test email landed at each seed mailbox. Poll about once a minute while status is waiting. placement is inbox, spam, promotions, social, updates or forums, or missing while the email has not arrived; score is the inbox share from 0 to 10 once the test is completed. rspamd is the content filter verdict with its matched rules, when a seed reports one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "testId": {
    "description": "testId returned by deliverability_create_test",
    "pattern": "^dlt-[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "testId"
  ],
  "type": "object"
 },
 "name": "deliverability_get_test",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "closesAt": {
    "type": "string"
   },
   "rspamd": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "type": "string"
       },
       "requiredScore": {
        "type": "number"
       },
       "score": {
        "type": "number"
       },
       "symbols": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "description": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "score": {
           "type": "number"
          }
         },
         "required": [
          "name",
          "score"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "score",
       "requiredScore",
       "action",
       "symbols"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "score": {
    "type": [
     "number",
     "null"
    ]
   },
   "seeds": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "type": "string"
      },
      "placement": {
       "type": "string"
      },
      "provider": {
       "type": "string"
      }
     },
     "required": [
      "email",
      "provider",
      "placement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "waiting",
     "completed"
    ],
    "type": "string"
   },
   "testId": {
    "type": "string"
   }
  },
  "required": [
   "testId",
   "status",
   "closesAt",
   "score",
   "seeds",
   "rspamd"
  ],
  "type": "object"
 },
 "title": "Where the test email landed at each seed mailbox"
}
