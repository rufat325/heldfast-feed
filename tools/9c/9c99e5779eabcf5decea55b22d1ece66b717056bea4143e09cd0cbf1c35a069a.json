{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use first to read published service scope, required ride facts and local timeZone; no price or availability is confirmed.\n\nOptional offerKey selects an existing published offer's configured location; omit for the default scope.\n\nHTTP uses no-store. Re-read before quoting; no freshness window is promised. This read does not consume the quote rate-limit budget.\n\nCorrect invalid_request input; unavailable means scope could not be read. Use get_customer_policy for rules, quote_ride for price, or prepare_offer for an explicitly requested offer.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "default": "en",
    "description": "Use the customer's requested language for text and booking links: en by default, de for German. Preserve it on retries; pickup times stay in the provider time zone.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "offerKey": {
    "description": "Optional existing published provider offer key. Selects its configured service location; not booking authority.",
    "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_service_options",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "const": "invalid_request",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "const": "unavailable",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "hourlyRideFacts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "location": {
      "additionalProperties": false,
      "properties": {
       "countryCode": {
        "type": "string"
       },
       "key": {
        "type": "string"
       },
       "label": {
        "type": "string"
       }
      },
      "required": [
       "key",
       "countryCode",
       "label"
      ],
      "type": "object"
     },
     "nextAction": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "requiredRideFacts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "returnRideFacts": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "services": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "availability": {
         "const": "requires_offer_review",
         "type": "string"
        },
        "key": {
         "type": "string"
        },
        "tripTypes": {
         "items": {
          "enum": [
           "one_way",
           "return"
          ],
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "key",
        "tripTypes",
        "availability"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "status": {
      "const": "available",
      "type": "string"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "provider",
     "timeZone",
     "bookingUrl",
     "services",
     "requiredRideFacts",
     "returnRideFacts",
     "hourlyRideFacts",
     "nextAction"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Chauffeur service options"
}
