{
 "description": "Restore a will from a backup snapshot. Executor-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "backupId": {
    "description": "Backup ID from list_backups.",
    "type": "number"
   },
   "ownerId": {
    "type": "string"
   },
   "token": {
    "type": "string"
   }
  },
  "required": [
   "token",
   "backupId"
  ],
  "type": "object"
 },
 "name": "restore_backup"
}
