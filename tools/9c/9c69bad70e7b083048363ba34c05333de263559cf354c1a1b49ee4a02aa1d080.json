{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Deterministic advisory review of commands or a configuration diff. It always returns available guidance and never executes a command. Missing or incomplete knowledge may create or update a tracked research demand.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commands": {
    "items": {
     "maxLength": 2000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "config_diff": {
    "maxLength": 32000,
    "type": "string"
   },
   "context": {
    "properties": {
     "model": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "operating_system": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "runtime_mode": {
      "enum": [
       "normal",
       "rescue",
       "installer",
       "update",
       "uninstall",
       "recovery",
       "diagnostic"
      ],
      "type": "string"
     },
     "shell_environment": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "vendor": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9()._\\-/]*$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "intent": {
    "maxLength": 2000,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "intent",
   "context"
  ],
  "type": "object"
 },
 "name": "review_network_change",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approval_required": {
    "type": "boolean"
   },
   "blast_radius": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decision": {
    "enum": [
     "allowed_with_checks",
     "manual_review_required",
     "blocked",
     "unknown"
    ],
    "type": "string"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "matched_rules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "operational_guidance": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prechecks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risk_level": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "rollback": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "stop_conditions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unknown_commands": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "verification_plan": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "description",
      "required"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "verification_token": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "verification_token_expires_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "decision",
   "risk_level",
   "blast_radius",
   "matched_rules",
   "unknown_commands",
   "operational_guidance",
   "prechecks",
   "stop_conditions",
   "verification_plan",
   "rollback",
   "approval_required",
   "verification_token",
   "verification_token_expires_at",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Review Network Change"
}
