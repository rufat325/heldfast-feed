{
 "_meta": {
  "openai/outputTemplate": "ui://seatmap",
  "ui": {
   "resourceUri": "ui://seatmap"
  },
  "ui/resourceUri": "ui://seatmap"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find the best available seats on a flight matching user preferences like window, aisle, extra legroom, exit row, quiet zone, etc. Returns a ranked list and an interactive seatmap with recommended seats highlighted.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cabin_class": {
    "description": "Optional cabin class filter",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "flight_date": {
    "description": "Optional flight date in YYYY-MM-DD format",
    "type": "string"
   },
   "flight_number": {
    "description": "Flight number, e.g. 'QF1'",
    "type": "string"
   },
   "preferences": {
    "description": "Seat preferences to match",
    "items": {
     "enum": [
      "window",
      "aisle",
      "extra_legroom",
      "exit_row",
      "quiet_zone",
      "front",
      "rear",
      "bulkhead"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "flight_number",
   "preferences"
  ],
  "type": "object"
 },
 "name": "find_best_seats",
 "title": "Find best seats"
}
