{
 "description": "Query executions for a project with filters for status, job, and time range",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobIdFilter": {
    "description": "Filter by job UUID",
    "type": "string"
   },
   "max": {
    "description": "Max results (default 20)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "recentFilter": {
    "description": "Time window filter (e.g., '1h', '1d', '7d')",
    "type": "string"
   },
   "status": {
    "description": "Filter by execution status",
    "enum": [
     "succeeded",
     "failed",
     "aborted",
     "running",
     "timedout"
    ],
    "type": "string"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "rundeck_list_executions"
}
