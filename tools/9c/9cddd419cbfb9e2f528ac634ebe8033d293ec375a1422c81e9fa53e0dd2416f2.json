{
 "description": "Get info about a specific hex coordinate (terrain, neighbours, distance)",
 "inputSchema": {
  "properties": {
   "game": {
    "description": "Game context for terrain lookup",
    "type": "string"
   },
   "q": {
    "description": "Hex Q coordinate (column)",
    "type": "number"
   },
   "r": {
    "description": "Hex R coordinate (row)",
    "type": "number"
   },
   "seed": {
    "description": "Map seed (to look up terrain from a generated map)",
    "type": "string"
   }
  },
  "required": [
   "q",
   "r"
  ],
  "type": "object"
 },
 "name": "hex_get_info"
}
