{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Where the user stands. It returns every current match request, the number of other people in the pool, and any match. Use it to answer what the user submitted, and who they matched with. A match can appear days later.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "check_matches",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "match_id": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "their_request_snippet": {
       "description": "The first 200 characters of their request.",
       "type": "string"
      },
      "they_accepted": {
       "type": "boolean"
      },
      "you_accepted": {
       "type": "boolean"
      }
     },
     "required": [
      "match_id",
      "created_at",
      "state",
      "their_request_snippet",
      "you_accepted",
      "they_accepted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "others_in_pool": {
    "description": "Other people in the pool, each counted once.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "requests": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "request_id": {
       "type": "string"
      },
      "request_text": {
       "type": "string"
      },
      "status": {
       "enum": [
        "draft",
        "open"
       ],
       "type": "string"
      }
     },
     "required": [
      "request_id",
      "status",
      "request_text"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "requests",
   "others_in_pool",
   "matches"
  ],
  "type": "object"
 },
 "title": "Check for matches"
}
