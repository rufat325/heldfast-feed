{
 "description": "Manage a notebook\u2019s source labels (RPC-backed): list them, create one, or delete some. action=list (default) / create (needs name) / delete (needs label_ids).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Default list.",
    "enum": [
     "list",
     "create",
     "delete"
    ],
    "type": "string"
   },
   "emoji": {
    "description": "Optional label emoji (for create).",
    "type": "string"
   },
   "label_ids": {
    "description": "Label ids to delete (for delete).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Label name (for create).",
    "type": "string"
   },
   "notebook_id": {
    "description": "Notebook UUID (alternative to notebook_url).",
    "type": "string"
   },
   "notebook_url": {
    "description": "NotebookLM notebook URL.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "manage_labels",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "The tool payload on success. The exact shape depends on the tool.",
    "type": "object"
   },
   "error": {
    "description": "Human-readable error message, present only when success is false.",
    "type": "string"
   },
   "success": {
    "description": "Whether the tool call succeeded.",
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
