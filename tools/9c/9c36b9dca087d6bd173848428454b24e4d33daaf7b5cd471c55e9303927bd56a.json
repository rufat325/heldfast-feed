{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete a tutorial video"
 },
 "description": "Use this when someone wants one rendered tutorial video permanently deleted. Returns the deleted video id; the record and its video file in Tutorializer storage are erased, so restoring it means uploading or rendering again. Not for deleting the whole tutorial.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "videoId": {
    "description": "Video to delete",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "videoId"
  ],
  "type": "object"
 },
 "name": "delete_video",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "const": "deleted",
    "type": "string"
   },
   "videoId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "status",
   "videoId"
  ],
  "type": "object"
 },
 "title": "Delete a tutorial video"
}
