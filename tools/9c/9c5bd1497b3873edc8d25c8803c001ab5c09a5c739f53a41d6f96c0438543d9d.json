{
 "description": "Human-in-the-loop approval for a proposal that returned HITL_REQUIRED. Cannot approve BLOCKED / hard-rule failures (spec \u00a76.3 / \u00a76.5).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string"
     },
     "asset": {
      "type": "string"
     },
     "confidence": {
      "type": [
       "number",
       "null"
      ]
     },
     "notional": {
      "type": "number"
     },
     "rationale": {
      "type": "string"
     }
    },
    "required": [
     "action",
     "asset",
     "notional"
    ],
    "type": "object"
   },
   "approver": {
    "description": "Human approver identity (email or handle)",
    "type": "string"
   },
   "committed_today": {
    "type": "number"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "allowed_actions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "daily_cap": {
      "type": "number"
     },
     "hitl_threshold": {
      "type": "number"
     },
     "max_notional": {
      "type": "number"
     },
     "min_confidence": {
      "type": "number"
     },
     "per_asset_limits": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "max_notional",
     "daily_cap",
     "hitl_threshold",
     "min_confidence"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "policy",
   "approver"
  ],
  "type": "object"
 },
 "name": "approve_spend"
}
