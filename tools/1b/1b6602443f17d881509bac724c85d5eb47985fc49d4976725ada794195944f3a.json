{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search original IELTS-style writing practice questions (Academic Task 1 and 2, General Training Task 1 and 2). Returns task IDs for get_practice_task. Not official exam questions.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "Academic Task 2",
     "General Training Task 1",
     "Academic Task 1",
     "General Task 2"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to match in the title, topic or question.",
    "maxLength": 200,
    "type": "string"
   },
   "questionType": {
    "enum": [
     "opinion",
     "discussion",
     "balance",
     "solutions",
     "causesEvaluation",
     "twoPart",
     "charts",
     "maps",
     "processes",
     "formalLetter",
     "semiFormalLetter",
     "informalLetter"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_practice",
 "title": "Find writing practice"
}
