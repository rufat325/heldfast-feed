{
 "description": "Render markdown as a PNG or JPEG image. Use when sharing a visual preview in chat (Telegram, Discord, Slack) where HTML can't be sent directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Image format (default: png)",
    "enum": [
     "png",
     "jpeg"
    ],
    "type": "string"
   },
   "markdown": {
    "description": "The markdown content to render",
    "type": "string"
   },
   "quality": {
    "description": "JPEG quality 1-100 (default: 90)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "section": {
    "description": "Render only a specific heading section",
    "type": "string"
   },
   "theme": {
    "description": "Theme name (default, dark, serif, minimal)",
    "type": "string"
   },
   "title": {
    "description": "Document title",
    "type": "string"
   },
   "width": {
    "description": "Viewport width in pixels (default: 1200, max: 2400)",
    "maximum": 2400,
    "minimum": 320,
    "type": "integer"
   }
  },
  "required": [
   "markdown"
  ],
  "type": "object"
 },
 "name": "render_to_image"
}
