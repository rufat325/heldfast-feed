{
 "description": "Permanently delete sheets from a spreadsheet. Cannot delete the last remaining sheet.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gids": {
    "description": "Sheet grid IDs to permanently delete",
    "items": {
     "description": "Sheet ID (from URL gid={gid})",
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "gids"
  ],
  "type": "object"
 },
 "name": "sheet-delete",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "completedAt": {
        "description": "ISO timestamp when operation completed",
        "type": "string"
       },
       "failures": {
        "description": "Details of any sheets that failed to delete",
        "items": {
         "additionalProperties": false,
         "properties": {
          "error": {
           "description": "Error message explaining the failure",
           "type": "string"
          },
          "gid": {
           "description": "Grid ID of sheet that failed to delete",
           "type": "string"
          }
         },
         "required": [
          "gid",
          "error"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "itemsChanged": {
        "description": "Number of sheets successfully deleted",
        "type": "number"
       },
       "itemsProcessed": {
        "description": "Total sheets attempted to delete",
        "type": "number"
       },
       "operationSummary": {
        "description": "Human-readable summary of the operation",
        "type": "string"
       },
       "recoverable": {
        "const": false,
        "description": "Whether deletion can be undone (always false)",
        "type": "boolean"
       },
       "spreadsheetUrl": {
        "description": "URL to view the spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "operationSummary",
       "itemsProcessed",
       "itemsChanged",
       "completedAt",
       "recoverable",
       "id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
