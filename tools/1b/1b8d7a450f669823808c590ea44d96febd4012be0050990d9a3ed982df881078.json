{
 "_meta": {
  "ui": {
   "resourceUri": "ui://wcway/toilets"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find public toilets near a place"
 },
 "description": "Use this when the user asks for the nearest public toilet, or for toilets near a street, station or town. Returns up to 20 toilets sorted by distance, with walk time, access rule, fee, open now, closing time, wheelchair access and a map link. Do not use it for toilet products or plumbing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "changing_table": {
    "description": "Only toilets with a changing table.",
    "type": "boolean"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code. Narrows the place lookup.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "free": {
    "description": "Only toilets known to be free of charge.",
    "type": "boolean"
   },
   "lat": {
    "description": "Latitude, WGS84. Send with lon, if you already know the coordinates.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "lon": {
    "description": "Longitude, WGS84.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "no_purchase_needed": {
    "description": "Only toilets that need no purchase.",
    "type": "boolean"
   },
   "open_now": {
    "description": "Drop toilets that are closed now. Toilets with unknown hours stay and show open_now unknown.",
    "type": "boolean"
   },
   "place": {
    "description": "Street, station, landmark or town from the user message, for example Darmstadt Hauptbahnhof.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "wheelchair": {
    "description": "Only wheelchair-accessible toilets.",
    "type": "boolean"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "find_toilets_near",
