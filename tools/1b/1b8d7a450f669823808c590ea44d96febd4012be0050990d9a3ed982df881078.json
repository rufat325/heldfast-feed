          {
           "additionalProperties": false,
           "properties": {
            "closes_at": {
             "description": "Local closing time with UTC offset, from the hours of the business. Null when unknown or when it never closes.",
             "type": [
              "string",
              "null"
             ]
            },
            "conditions": {
             "anyOf": [
              {
               "enum": [
                "everyone",
                "customers"
               ],
               "type": "string"
              },
              {
               "type": "null"
              }
             ],
             "description": "What the business says about who may use the toilet. everyone: free for everyone. customers: customers only. Null when the business said nothing. It is the word of the business, not a checked fact."
            },
            "name": {
             "description": "Business name that the partner gave and a moderator approved.",
             "type": "string"
            },
            "open_now": {
             "anyOf": [
              {
               "type": "boolean"
              },
              {
               "const": "unknown"
              }
             ],
             "description": "Open state from the hours of the business and its live switch, at the toilet's local time. false: the business closed the toilet for now, or its hours say closed. unknown: the business gave no usable hours."
            },
            "opening_hours": {
             "description": "Opening hours that the business entered, in OpenStreetMap opening_hours syntax. Null when it entered none.",
             "type": [
              "string",
              "null"
             ]
            },
            "tier": {
             "enum": [
              "basic",
              "plus"
             ],
             "type": "string"
