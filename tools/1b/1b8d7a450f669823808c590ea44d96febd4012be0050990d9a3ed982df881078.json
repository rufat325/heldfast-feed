           },
           "required": [
            "name",
            "tier",
            "conditions",
            "opening_hours",
            "open_now",
            "closes_at"
           ],
           "type": "object"
          }
         ],
         "description": "Set when the business behind the toilet pays for a Verified Partner listing. It buys visibility and a label. It never changes the order of the results. Show it as a label only. Conditions, opening_hours and open_now are statements of the business. The toilet's own fields (access, opening_hours, open_now) stay as they are."
        },
        "provenance": {
         "additionalProperties": false,
         "description": "Where the facts come from. People can correct every fact. A value that most people vote for replaces the source value. Every fact comes from the source, unless decided lists it.",
