{"_meta":{"ui":{"resourceUri":"ui://loops/diagram.html"},"ui/resourceUri":"ui://loops/diagram.html"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false},"description":"Create a new causal loop diagram from a title, optional one-sentence context and a batch of commands, and store it on a shared link. Draw the 1-3 loops at the heart of the story, at most about 12 variables, with neutral measurable names. Returns the diagram, its loops (computed by the tool), what changed and the \"Open and edit\" link: always give that link to the person. Commands (applied in order, valid ones kept, rejected ones returned with reasons so you can fix them): addVariable {tempId, name, description}, updateVariable, removeVariable, addLink {from, to, polarity \"+\"|\"-\", delay?, explanation}, updateLink, removeLink, updateLoop {loop: variable ids in link order or a label, name, description}, setTitle, setContext. Refer to new variables by a tempId you choose (t1, t2) and to existing ones by id (v3, l4). You never position anything.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"commands":{"items":{"oneOf":[{"properties":{"description":{"maxLength":500,"type":"string"},"name":{"maxLength":80,"type":"string"},"op":{"const":"addVariable","type":"string"},"tempId":{"pattern":"^t[1-9]\\d{0,9}$","type":"string"}},"required":["op","name"],"type":"object"},{"properties":{"description":{"maxLength":500,"type":"string"},"name":{"maxLength":80,"type":"string"},"op":{"const":"updateVariable","type":"string"},"variable":{"pattern":"^[vt][1-9]\\d{0,9}$","type":"string"}},"required":["op","variable"],"type":"object"},{"properties":{"op":{"const":"removeVariable","type":"string"},"variable":{"pattern":"^[vt][1-9]\\d{0,9}$","type":"string"}},"required":["op","variable"],"type":"object"},{"properties":{"delay":{"type":"boolean"},"explanation":{"maxLength":500,"type":"string"},"from":{"pattern":"^[vt][1-9]\\d{0,9}$","type":"string"},"op":{"const":"addLink","type":"string"},"polarity":{"enum":["+","-"],"type":"string"},"to":{"pattern":"^[vt][1-9]\\d{0,9}$","type":"string"}},"required":["op","from","to","polarity"],"type":"object"},{"properties":{"delay":{"type":"boolean"},"explanation":{"maxLength":500,"type":"string"},"link":{"pattern":"^l[1-9]\\d{0,9}$","type":"string"},"op":{"const":"updateLink","type":"string"},"polarity":{"enum":["+","-"],"type":"string"}},"required":["op","link"],"type":"object"},{"properties":{"link":{"pattern":"^l[1-9]\\d{0,9}$","type":"string"},"op":{"const":"removeLink","type":"string"}},"required":["op","link"],"type":"object"},{"properties":{"description":{"maxLength":500,"type":"string"},"loop":{"anyOf":[{"pattern":"^[RB][1-9]\\d{0,9}$","type":"string"},{"items":{"pattern":"^[vt][1-9]\\d{0,9}$","type":"string"},"maxItems":60,"minItems":2,"type":"array"}]},"name":{"maxLength":80,"type":"string"},"op":{"const":"updateLoop","type":"string"}},"required":["op","loop"],"type":"object"},{"properties":{"op":{"const":"setContext","type":"string"},"text":{"maxLength":1000,"type":"string"}},"required":["op","text"],"type":"object"},{"properties":{"op":{"const":"setTitle","type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["op","title"],"type":"object"}]},"maxItems":200,"type":"array"},"context":{"maxLength":1000,"type":"string"},"title":{"maxLength":80,"minLength":1,"type":"string"}},"required":["title","commands"],"type":"object"},"name":"create_diagram","title":"Create diagram"}
