{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage the active scene and its narrative framing. Mutating actions persist to the Novel and are audited; read-only actions do not mutate state. Revert the most recent mutation with manage_history (action: undo). set derives the description from location only when description is omitted. Use when: setting scene state (description, location, type), the narrative directive, party presence, AI autonomy, or when offering choices or resolving an oracle roll. Do NOT use when: recording a story beat \u2014 use manage_story (action: record).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "set, directive, presence, autonomy, choices, or oracle.",
    "enum": [
     "set",
     "directive",
     "presence",
     "autonomy",
     "choices",
     "oracle"
    ],
    "type": "string"
   },
   "adventure_scene": {
    "description": "Adventure-scene waypoint anchor; empty or null clears (set).",
    "type": [
     "string",
     "null"
    ]
   },
   "allow_freeform": {
    "description": "Allow free-form response (choices).",
    "type": "boolean"
   },
   "atmosphere": {
    "description": "Atmosphere (set).",
    "type": "string"
   },
   "beat": {
    "description": "Story-beat tag (set).",
    "enum": [
     "setup",
     "escalation",
     "turning_point",
     "climax",
     "resolution",
     "denouement"
    ],
    "type": "string"
   },
   "choices": {
    "description": "List of choices (choices).",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "confirmation": {
    "description": "Confirmation mode (autonomy).",
    "enum": [
     "auto",
     "confirm",
     "prompt"
    ],
    "type": "string"
   },
   "context": {
    "additionalProperties": {},
    "description": "Context for the choice (choices).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "creativity": {
    "description": "Creativity (autonomy).",
    "enum": [
     "predictable",
     "standard",
     "chaotic"
    ],
    "type": "string"
   },
   "description": {
    "description": "Scene description (set).",
    "type": "string"
   },
   "directive": {
    "description": "Narrative directive (directive).",
    "type": "string"
   },
   "entity_ids": {
    "description": "Entities present (presence).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fast_forward": {
    "description": "Narrative fast-forward (set).",
    "properties": {
     "changes": {
      "description": "NPC changes during the skip.",
      "items": {
       "properties": {
        "condition": {
         "type": "string"
        },
        "disposition": {
         "type": "string"
        },
        "location": {
         "type": "string"
        },
        "npc_id": {
         "type": "string"
        }
       },
       "required": [
        "npc_id"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "interval": {
      "description": "The time interval to skip.",
      "type": "string"
     },
     "skip_countdowns": {
      "description": "Do not advance countdowns during the skip.",
      "type": "boolean"
     }
    },
    "required": [
     "interval"
    ],
    "type": "object"
   },
   "level": {
    "description": "Autonomy level (autonomy).",
    "enum": [
     "full",
     "mechanical_prompt",
     "manual"
    ],
    "type": "string"
   },
   "likelihood": {
    "description": "Likelihood tier (oracle).",
    "enum": [
     "almost_certain",
     "likely",
     "50_50",
     "unlikely",
     "small_chance"
    ],
    "type": "string"
   },
   "location": {
    "description": "Scene location (set).",
    "type": "string"
   },
   "prompt": {
    "description": "Choice prompt (choices).",
    "type": "string"
   },
   "question": {
    "description": "Question to resolve (oracle).",
    "type": "string"
   },
   "safety": {
    "description": "Safety tier (autonomy).",
    "enum": [
     "safe",
     "moderate",
     "hardcore"
    ],
    "type": "string"
   },
   "scene_type": {
    "anyOf": [
     {
      "enum": [
       "combat",
       "social",
       "exploration",
       "neutral"
      ],
      "type": "string"
     },
     {
      "items": {
       "enum": [
        "combat",
        "social",
        "exploration",
        "neutral"
       ],
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Scene-type tag or array (set)."
   },
   "seed": {
    "description": "Deterministic seed (oracle).",
    "type": "string"
   },
   "skip_transition_hook": {
    "description": "Skip the scene-transition hook (set).",
    "type": "boolean"
   },
   "time_of_day": {
    "description": "Time of day (set).",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_scene",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Machine-readable result status: OK, NEED_INPUT, WARNING, PARTIAL, or an error category (REQ-002, REQ-548c).",
    "type": "string"
   },
   "text": {
    "description": "Human-readable text envelope mirroring the structured result (REQ-001, REQ-548a).",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Scene Management"
}
