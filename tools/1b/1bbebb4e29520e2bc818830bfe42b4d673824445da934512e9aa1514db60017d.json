{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Mate"
 },
 "description": "Use this when you need to author a mate-graph relationship into the source, selected by `relation` (default 'mate'):\n- 'mate' \u2014 a typed mate between two connectors ({ name, a, b, type, pose?, limitsDeg?, limitsMm? }).\n- 'coupling' \u2014 couple a driven mate to a source mate by ratio ({ driven, source, ratio, offset? }).\n- 'transmission' \u2014 a physical drive path across mates ({ name, kind, sourceMate, drivenMates, path, ... }).\nAll durably edit source and need { code, assembly_binding }. Params other than `relation` are forwarded verbatim; each relation fails closed on its own missing required params.",
 "inputSchema": {
  "allOf": [
   {
    "if": {
     "anyOf": [
      {
       "not": {
        "required": [
         "relation"
        ]
       }
      },
      {
       "properties": {
        "relation": {
         "const": "mate"
        }
       },
       "required": [
        "relation"
       ]
      }
     ]
    },
    "then": {
     "required": [
      "name",
      "a",
      "b",
      "type"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "relation": {
       "const": "coupling"
      }
     },
     "required": [
      "relation"
     ]
    },
    "then": {
     "required": [
      "driven",
      "source",
      "ratio"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "relation": {
       "const": "transmission"
      }
     },
     "required": [
      "relation"
     ]
    },
    "then": {
     "required": [
      "name",
      "kind",
      "sourceMate",
      "drivenMates",
      "path"
     ]
    }
   }
  ],
  "properties": {
   "a": {
    "description": "relation:'mate' \u2014 connector ref \"<partName>.<connectorName>\".",
    "type": "string"
   },
   "actuator": {
    "description": "relation:'transmission' \u2014 optional actuator.",
    "type": "string"
   },
   "assembly_binding": {
    "description": "JS identifier bound to assembly(...).",
    "type": "string"
   },
   "b": {
    "description": "relation:'mate' \u2014 connector ref \"<partName>.<connectorName>\".",
    "type": "string"
   },
   "code": {
    "description": "The .kcad.ts source code.",
    "type": "string"
   },
   "driven": {
    "description": "relation:'coupling' \u2014 driven mate name.",
    "type": "string"
   },
   "drivenMates": {
    "description": "relation:'transmission' \u2014 driven mate names.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "input": {
    "description": "relation:'transmission' \u2014 optional input.",
    "type": "string"
   },
   "kind": {
    "description": "relation:'transmission' \u2014 transmission kind.",
    "enum": [
     "direct-horn",
     "link-rod",
     "four-bar",
     "gear-pair",
     "belt",
     "tendon"
    ],
    "type": "string"
   },
   "limitsDeg": {
    "description": "relation:'mate' \u2014 optional [minDeg, maxDeg].",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "limitsMm": {
    "description": "relation:'mate' \u2014 optional [minMm, maxMm].",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "name": {
    "description": "relation:'mate'|'transmission' \u2014 name unique within the assembly.",
    "type": "string"
   },
   "notes": {
    "description": "relation:'transmission' \u2014 optional notes.",
    "type": "string"
   },
   "offset": {
    "description": "relation:'coupling' \u2014 optional pose offset.",
    "type": "number"
   },
   "output": {
    "description": "relation:'transmission' \u2014 optional output.",
    "type": "string"
   },
   "path": {
    "description": "relation:'transmission' \u2014 drive path.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pose": {
    "description": "relation:'mate' \u2014 optional mate pose."
   },
   "ratio": {
    "description": "relation:'coupling' \u2014 driven pose = source pose * ratio + offset.",
    "type": "number"
   },
   "relation": {
    "description": "Which relationship to author (default 'mate').",
    "enum": [
     "mate",
     "coupling",
     "transmission"
    ],
    "type": "string"
   },
   "source": {
    "description": "relation:'coupling' \u2014 source mate name.",
    "type": "string"
   },
   "sourceMate": {
    "description": "relation:'transmission' \u2014 source mate name.",
    "type": "string"
   },
   "type": {
    "description": "relation:'mate' \u2014 mate type.",
    "enum": [
     "fastened",
     "revolute",
     "prismatic",
     "cylindrical",
     "planar",
     "ball",
     "pin_slot"
    ],
    "type": "string"
   }
  },
  "required": [
   "code",
   "assembly_binding"
  ],
  "type": "object"
 },
 "name": "add_mate",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "binding_name": {
    "description": "JS const name bound to the new construct (when one was created).",
    "type": "string"
   },
   "diagnostics": {
    "description": "Diagnostics from re-evaluating the modified source.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "description": "Failure message (present when ok is false).",
    "type": "string"
   },
   "new_code": {
    "description": "Modified .kcad.ts source (present on success). Caller persists it.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the edit applied and re-evaluated cleanly.",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Add Mate"
}
