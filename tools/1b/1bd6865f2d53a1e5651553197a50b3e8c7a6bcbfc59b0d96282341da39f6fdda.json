{
 "description": "Create a customer",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "billing": {
    "additionalProperties": false,
    "description": "Billing address; only the given keys are set",
    "properties": {
     "address_1": {
      "type": "string"
     },
     "address_2": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "company": {
      "type": "string"
     },
     "country": {
      "description": "ISO 3166-1 alpha-2 country code, e.g. DE",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "first_name": {
      "type": "string"
     },
     "last_name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "postcode": {
      "type": "string"
     },
     "state": {
      "description": "State/county code, e.g. BY",
      "type": "string"
     }
    },
    "type": "object"
   },
   "email": {
    "description": "Customer email",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "password": {
    "description": "Password (write-only, never returned; default: generated by WooCommerce)",
    "type": "string"
   },
   "shipping": {
    "additionalProperties": false,
    "description": "Shipping address; only the given keys are set",
    "properties": {
     "address_1": {
      "$ref": "#/properties/billing/properties/address_1"
     },
     "address_2": {
      "$ref": "#/properties/billing/properties/address_2"
     },
     "city": {
      "$ref": "#/properties/billing/properties/city"
     },
     "company": {
      "$ref": "#/properties/billing/properties/company"
     },
     "country": {
      "$ref": "#/properties/billing/properties/country"
     },
     "first_name": {
      "$ref": "#/properties/billing/properties/first_name"
     },
     "last_name": {
      "$ref": "#/properties/billing/properties/last_name"
     },
     "phone": {
      "$ref": "#/properties/billing/properties/phone"
     },
     "postcode": {
      "$ref": "#/properties/billing/properties/postcode"
     },
     "state": {
      "$ref": "#/properties/billing/properties/state"
     }
    },
    "type": "object"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "username": {
    "description": "Login name (default: generated by WooCommerce)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "email"
  ],
  "type": "object"
 },
 "name": "woo_create_customer"
}
