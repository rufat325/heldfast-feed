{
 "description": "Rename a navigation menu (the menu's description and parent are kept)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Menu ID",
    "type": "integer"
   },
   "name": {
    "description": "New menu name",
    "minLength": 1,
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id",
   "name"
  ],
  "type": "object"
 },
 "name": "mcp_update_menu"
}
