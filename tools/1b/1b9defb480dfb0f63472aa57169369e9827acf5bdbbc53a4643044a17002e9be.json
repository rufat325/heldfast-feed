{
 "description": "Update an alert configuration. Only the fields you provide are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channel": {
    "enum": [
     "email",
     "webhook",
     "slack"
    ],
    "type": "string"
   },
   "consecutiveFailuresThreshold": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "cooldownMinutes": {
    "maximum": 10080,
    "minimum": 0,
    "type": "integer"
   },
   "enabled": {
    "type": "boolean"
   },
   "id": {
    "type": "string"
   },
   "jobId": {
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_alert"
}
