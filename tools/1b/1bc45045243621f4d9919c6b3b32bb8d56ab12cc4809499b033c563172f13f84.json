{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Find POIs nearby or along a walking/driving route, compare available images, and return ranked photo spots with scores, camera headings, reasons and source links. Costs $2.00 USDC on Base per call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "featureCombination": {
    "description": "AND/all or OR/any across OSM feature requirements; default all.",
    "enum": [
     "all",
     "any"
    ],
    "type": "string"
   },
   "geographicCombination": {
    "description": "AND/all or OR/any across geographic requirements; default all.",
    "enum": [
     "all",
     "any"
    ],
    "type": "string"
   },
   "geographicKinds": {
    "description": "Spatial requirements; combination is controlled by geographicCombination.",
    "items": {
     "enum": [
      "lake",
      "sea",
      "river",
      "peak",
      "forest",
      "waterside"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   },
   "lat": {
    "description": "Latitude of the search center.",
    "maximum": 85,
    "minimum": -85,
    "type": "number"
   },
   "limit": {
    "description": "Deprecated compatibility field; ignored. All verified matching places are returned.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "lon": {
    "description": "Longitude of the search center.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "osmFeatures": {
    "description": "OSM physical features and attributes; combined using featureCombination. Tagged features use exact/existence filters; intersections use road topology.",
    "items": {
     "$ref": "#/properties/searchProgram/anyOf/0/properties/steps/items/properties/osmFeatures/items"
    },
    "maxItems": 6,
    "type": "array"
   },
   "photoStyles": {
    "description": "Optional desired photo moods.",
    "items": {
     "enum": [
      "nature",
      "urban",
      "vintage",
      "iconic",
      "artistic",
      "waterside",
      "minimal",
      "adventure"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "poiQueries": {
    "description": "Arbitrary POI categories or business names, e.g. coffee shops.",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   },
   "preferences": {
    "description": "Additional photography preferences.",
    "maxLength": 500,
    "type": "string"
   },
   "query": {
    "description": "Natural-language request. Explicit text overrides conflicting structured parameters.",
    "maxLength": 1000,
    "type": "string"
   },
   "radius": {
    "description": "Search radius in meters; default 1000.",
    "maximum": 20000,
    "minimum": 100,
    "type": "integer"
   },
   "requirements": {
    "description": "Condition ledger for compiled programs: required, preferred or forbidden; retrieval step IDs scope conditions to each logical branch.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expression": {
       "maxLength": 400,
       "minLength": 1,
       "type": "string"
      },
      "route": {
       "enum": [
        "places",
        "geography",
        "features",
        "visual"
       ],
       "type": "string"
      },
      "stepIds": {
       "items": {
        "type": "string"
       },
       "maxItems": 8,
       "type": "array"
      },
      "strength": {
       "enum": [
        "required",
        "preferred",
        "forbidden"
       ],
       "type": "string"
      }
     },
     "required": [
      "expression",
      "strength",
      "route",
      "stepIds"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "type": "array"
   },
   "route": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "corridorMeters": {
        "maximum": 2000,
        "minimum": 100,
        "type": "integer"
       },
       "destination": {
        "$ref": "#/properties/route/anyOf/0/properties/origin/anyOf/0"
       },
       "origin": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "label": {
            "anyOf": [
             {
              "maxLength": 350,
              "type": "string"
             },
             {
              "type": "null"
             }
            ]
           },
           "lat": {
            "anyOf": [
             {
              "maximum": 85,
              "minimum": -85,
              "type": "number"
             },
             {
              "type": "null"
             }
            ]
           },
           "lon": {
            "anyOf": [
             {
              "maximum": 180,
              "minimum": -180,
              "type": "number"
             },
             {
              "type": "null"
             }
            ]
           },
           "query": {
            "anyOf": [
             {
              "maxLength": 200,
              "minLength": 1,
              "type": "string"
             },
             {
              "type": "null"
             }
            ]
           }
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "travelMode": {
        "enum": [
         "walk",
         "drive"
        ],
        "type": "string"
       }
      },
      "required": [
       "destination"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional real road route. Default walking, 300 m corridor; up to 200 km. Origin omitted uses lat/lon. Destination accepts address or coordinates. Up to 50 photographic locations along the route."
   },
   "scoringIntent": {
    "description": "Visual subject, style and requirements for matching and scoring.",
    "maxLength": 1000,
    "type": "string"
   },
   "searchBranches": {
    "description": "OR across independently constrained target groups; AND between target, geography and features inside a group. When set, leave top-level poiQueries/geographicKinds/osmFeatures empty.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "featureCombination": {
       "enum": [
        "all",
        "any"
       ],
       "type": "string"
      },
      "geographicCombination": {
       "enum": [
        "all",
        "any"
       ],
       "type": "string"
      },
      "geographicKinds": {
       "items": {
        "enum": [
         "lake",
         "sea",
         "river",
         "peak",
         "forest",
         "waterside"
        ],
        "type": "string"
       },
       "maxItems": 6,
       "type": "array"
      },
      "osmFeatures": {
       "items": {
        "$ref": "#/properties/searchProgram/anyOf/0/properties/steps/items/properties/osmFeatures/items"
       },
       "maxItems": 6,
       "type": "array"
      },
      "poiQueries": {
       "items": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 4,
       "type": "array"
      },
      "visualIntent": {
       "maxLength": 1000,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 6,
    "type": "array"
   },
   "searchProgram": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "output": {
        "maxLength": 40,
        "minLength": 1,
        "type": "string"
       },
       "steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "combination": {
           "enum": [
            "all",
            "any"
           ],
           "type": "string"
          },
          "discoveryHints": {
           "type": "boolean"
          },
          "exclude": {
           "type": "boolean"
          },
          "geographicKinds": {
           "items": {
            "enum": [
             "lake",
             "sea",
             "river",
             "peak",
             "forest",
             "waterside"
            ],
            "type": "string"
           },
           "maxItems": 6,
           "type": "array"
          },
          "id": {
           "pattern": "^[a-zA-Z][a-zA-Z0-9_]{0,39}$",
           "type": "string"
          },
          "inputs": {
           "items": {
            "maxLength": 40,
            "type": "string"
           },
           "maxItems": 6,
           "type": "array"
          },
          "osmFeatures": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "filters": {
              "items": {
               "additionalProperties": false,
               "properties": {
                "key": {
                 "maxLength": 80,
                 "minLength": 1,
                 "pattern": "^[A-Za-z0-9_:.-]+$",
                 "type": "string"
                },
                "required": {
                 "type": "boolean"
                },
                "value": {
                 "anyOf": [
                  {
                   "maxLength": 160,
                   "type": "string"
                  },
                  {
                   "type": "null"
                  }
                 ]
                }
               },
               "required": [
                "key"
               ],
               "type": "object"
              },
              "maxItems": 6,
              "type": "array"
             },
             "kind": {
              "enum": [
               "tagged",
               "intersection"
              ],
              "type": "string"
             },
             "label": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
             },
             "numericFilters": {
              "items": {
               "additionalProperties": false,
               "properties": {
                "key": {
                 "maxLength": 80,
                 "minLength": 1,
                 "pattern": "^[A-Za-z0-9_:.-]+$",
                 "type": "string"
                },
                "maximum": {
                 "type": [
                  "number",
                  "null"
                 ]
                },
                "minimum": {
                 "type": [
                  "number",
                  "null"
                 ]
                }
               },
               "required": [
                "key"
               ],
               "type": "object"
              },
              "maxItems": 4,
              "type": "array"
             },
             "proximityMeters": {
              "maximum": 500,
              "minimum": 0,
              "type": "integer"
             }
            },
            "required": [
             "label"
            ],
            "type": "object"
           },
           "maxItems": 6,
           "type": "array"
          },
          "queries": {
           "items": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 4,
           "type": "array"
          },
          "tool": {
           "enum": [
            "search_places",
            "search_geography",
            "search_features",
            "sample_geography",
            "feature_points",
            "filter_geography",
            "filter_features",
            "union",
            "intersection",
            "area_imagery",
            "point_imagery",
            "collect_images",
            "score_images",
            "rank_results"
           ],
           "type": "string"
          },
          "visualIntent": {
           "maxLength": 1000,
           "type": "string"
          },
          "weights": {
           "items": {
            "maximum": 4,
            "minimum": 1,
            "type": "integer"
           },
           "maxItems": 6,
           "type": "array"
          }
         },
         "required": [
          "id",
          "tool"
         ],
         "type": "object"
        },
        "maxItems": 24,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "steps",
       "output"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Validated data-flow program over search/spatial/set, collect_images, score_images and rank_results tools. Leave all other target/spatial fields empty; global center/radius/styles are shared. Up to 24 steps and 8 source queries."
   }
  },
  "required": [
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "discover_photo_spots",
 "title": "Discover photo spots nearby or along a route"
}
