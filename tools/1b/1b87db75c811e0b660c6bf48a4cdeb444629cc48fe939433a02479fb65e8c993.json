{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a mandate"
 },
 "description": "Creates a mandate and the out-of-band approval link for the owner. Never: Activate production. Free.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "business": {
    "additionalProperties": false,
    "properties": {
     "contact": {
      "maxLength": 200,
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "trade": {
      "maxLength": 60,
      "type": "string"
     }
    },
    "type": "object"
   },
   "channel": {
    "additionalProperties": false,
    "properties": {
     "number_e164": {
      "pattern": "^\\+[1-9]\\d{6,14}$",
      "type": "string"
     },
     "type": {
      "const": "whatsapp",
      "type": "string"
     }
    },
    "required": [
     "type",
     "number_e164"
    ],
    "type": "object"
   },
   "delegate": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "vendor": {
      "maxLength": 60,
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "expires_in_days": {
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "paid_by": {
    "description": "Who pays the platform fees. business (default): billed to the business. agent: from your own credit; send your jfa_ key.",
    "enum": [
     "business",
     "agent"
    ],
    "type": "string"
   },
   "sandbox": {
    "description": "true: a test mandate with sample data, approved at once, no fees, valid one day. The whole flow runs, payment is simulated, nothing reaches a real business.",
    "type": "boolean"
   },
   "scopes": {
    "items": {
     "enum": [
      "flow.propose",
      "intake.classify",
      "job.create",
      "assign",
      "schedule",
      "proof.seal",
      "invoice.issue",
      "payment.collect"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "delegate",
   "scopes"
  ],
  "type": "object"
 },
 "name": "mandate_create",
 "title": "Create a mandate"
}
