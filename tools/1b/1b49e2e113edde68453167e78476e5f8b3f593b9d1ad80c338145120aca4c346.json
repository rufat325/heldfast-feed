{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read a PITR restore review and its saved receipt. Read scope. Accepted means queued, not recovered or verified. Follow receipt.phase to verified or failed before using the new database. Hosted MCP requires an account credential without resource confinement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pitr_plan_id": {
    "pattern": "^ppl_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "pitr_plan_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_pitr_restore",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "base": {
      "type": "object"
     },
     "cutover": {
      "type": "string"
     },
     "database_provider": {
      "type": "object"
     },
     "expires_at": {
      "type": "string"
     },
     "last_drain_at": {
      "type": "string"
     },
     "operation": {
      "type": "string"
     },
     "phases": {
      "type": "string"
     },
     "plan_id": {
      "type": "string"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "target": {
      "type": "object"
     },
     "target_time": {
      "type": "string"
     },
     "wal_segments_available": {
      "type": "integer"
     }
    },
    "required": [
     "plan_id",
     "review_digest",
     "expires_at",
     "status",
     "receipt",
     "operation",
     "target_time",
     "database_provider",
     "base",
     "wal_segments_available",
     "last_drain_at",
     "target",
     "phases",
     "cutover"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Read point-in-time restore review"
}
