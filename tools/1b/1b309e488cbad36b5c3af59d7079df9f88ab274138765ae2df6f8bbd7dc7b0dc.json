{
 "description": "Get a full calendar of daily flight prices (~60 days). Single API call, no scanning. Shows cheapest dates at a glance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cabinClass": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "departureDate": {
    "description": "A date within the month to search (YYYY-MM-DD). Google returns ~60 days of prices around this date.",
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "origin": {
    "description": "Departure airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "get_calendar_heatmap"
}
