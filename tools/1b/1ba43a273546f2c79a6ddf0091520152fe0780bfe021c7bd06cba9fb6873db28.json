{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a customer"
 },
 "description": "WRITE: update fields on an existing customer. Only the fields you pass change. Balances, credit limit and custom fields are not settable here. Kickserv: PATCH /{account}/customers/{customer_number}.xml.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
