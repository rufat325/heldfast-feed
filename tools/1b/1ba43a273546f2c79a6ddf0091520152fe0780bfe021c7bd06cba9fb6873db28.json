   "account_number": {
    "description": "Your own account number for the customer.",
    "maxLength": 64,
    "type": "string"
   },
   "alt_contact": {
    "description": "Alternate contact name.",
    "maxLength": 255,
    "type": "string"
   },
   "alt_phone_number": {
    "description": "Alternate phone number.",
    "maxLength": 64,
    "type": "string"
   },
   "billing_address": {
    "description": "Billing address (where invoices go), line 1.",
    "maxLength": 255,
    "type": "string"
   },
   "billing_address_2": {
    "description": "Billing address line 2.",
    "maxLength": 255,
    "type": "string"
   },
   "billing_city": {
    "description": "Billing city.",
    "maxLength": 128,
    "type": "string"
   },
   "billing_country": {
    "description": "Billing country.",
    "maxLength": 64,
    "type": "string"
   },
   "billing_state": {
    "description": "Billing state.",
    "maxLength": 64,
    "type": "string"
   },
   "billing_zip_code": {
    "description": "Billing ZIP/postal code.",
    "maxLength": 32,
    "type": "string"
   },
   "company": {
    "description": "True if the customer is a company rather than a person.",
    "type": "boolean"
   },
   "company_name": {
    "description": "Company name.",
    "maxLength": 255,
    "type": "string"
   },
   "contact": {
    "description": "Primary contact name.",
    "maxLength": 255,
    "type": "string"
   },
   "customer_number": {
    "description": "Customer number to update.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "customer_source_id": {
    "description": "Customer source (lead source) id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "customer_type_id": {
