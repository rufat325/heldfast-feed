    "description": "Email address.",
    "format": "email",
    "maxLength": 255,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "fax": {
    "description": "Fax number.",
    "maxLength": 64,
    "type": "string"
   },
   "first_name": {
    "description": "Contact first name.",
    "maxLength": 255,
    "type": "string"
   },
   "is_active": {
    "description": "False to mark the customer inactive (reversible).",
    "type": "boolean"
   },
   "last_name": {
    "description": "Contact last name.",
    "maxLength": 255,
    "type": "string"
   },
   "mobile": {
    "description": "Mobile number.",
    "maxLength": 64,
    "type": "string"
   },
   "name": {
    "description": "New customer name.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "notify_via_email": {
    "description": "Send the customer email notifications.",
    "type": "boolean"
   },
   "notify_via_sms": {
    "description": "Send the customer SMS notifications.",
    "type": "boolean"
   },
   "phone_number": {
    "description": "Phone number.",
    "maxLength": 64,
    "type": "string"
   },
   "service_address": {
    "description": "Service address (where the work happens), line 1.",
    "maxLength": 255,
    "type": "string"
   },
   "service_address_2": {
    "description": "Service address line 2.",
    "maxLength": 255,
    "type": "string"
   },
   "service_city": {
    "description": "Service city.",
    "maxLength": 128,
    "type": "string"
   },
   "service_country": {
    "description": "Service country (2-letter code).",
    "maxLength": 64,
    "type": "string"
   },
   "service_state": {
    "description": "Service state (2-letter abbreviation in the US).",
    "maxLength": 64,
    "type": "string"
   },
   "service_zip_code": {
    "description": "Service ZIP/postal code.",
    "maxLength": 32,
    "type": "string"
   },
