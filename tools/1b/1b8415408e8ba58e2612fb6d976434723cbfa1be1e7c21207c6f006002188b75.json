     "FASHION",
     "JEWELRY"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Workspace ID",
    "type": "string"
   }
  },
  "required": [
   "workspaceId"
  ],
  "type": "object"
 },
 "name": "list_templates"
}
