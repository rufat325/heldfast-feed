{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "PRISMA 2020 flow diagram"
 },
 "description": "Draw a PRISMA 2020 flow diagram for a new systematic review from the record counts, as a PNG image plus an SVG and download links. Give the counts you have; boxes that follow arithmetically from others are filled in and marked as derived. The tool checks that the numbers add up (records identified minus removed equals screened, and so on) and returns a warning naming each box that does not, with the value it should have. The diagram always shows the numbers exactly as given. Add `otherMethods` counts to draw the second column (websites, organisations, citation searching).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": false,
    "properties": {
     "automationIneligible": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Records marked ineligible by automation tools."
     },
     "databaseSources": {
      "description": "Per-database counts, e.g. [{\"name\":\"MEDLINE\",\"n\":812}].",
      "items": {
       "additionalProperties": false,
       "properties": {
        "n": {
         "$ref": "#/properties/counts/properties/databases"
        },
        "name": {
         "maxLength": 160,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "name",
        "n"
       ],
       "type": "object"
      },
      "maxItems": 30,
      "type": "array"
     },
     "databases": {
      "description": "Records identified from databases (total).",
      "maximum": 100000000,
      "minimum": 0,
      "type": "integer"
     },
     "duplicatesRemoved": {
      "$ref": "#/properties/counts/properties/databases"
     },
     "otherMethods": {
      "additionalProperties": false,
      "description": "Counts for the \"identification via other methods\" column.",
      "properties": {
       "citationSearching": {
        "$ref": "#/properties/counts/properties/databases"
       },
       "organisations": {
        "$ref": "#/properties/counts/properties/databases"
       },
       "reportsAssessed": {
        "$ref": "#/properties/counts/properties/databases"
       },
       "reportsExcluded": {
        "$ref": "#/properties/counts/properties/databases"
       },
       "reportsExcludedReasons": {
        "items": {
         "$ref": "#/properties/counts/properties/databaseSources/items"
        },
        "maxItems": 30,
        "type": "array"
       },
       "reportsNotRetrieved": {
        "$ref": "#/properties/counts/properties/databases"
       },
       "reportsSought": {
        "$ref": "#/properties/counts/properties/databases"
       },
       "sources": {
        "items": {
         "$ref": "#/properties/counts/properties/databaseSources/items"
        },
        "maxItems": 30,
        "type": "array"
       },
       "websites": {
        "$ref": "#/properties/counts/properties/databases"
       }
      },
      "type": "object"
     },
     "otherRemoved": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Records removed for other reasons before screening."
     },
     "recordsExcluded": {
      "$ref": "#/properties/counts/properties/databases"
     },
     "recordsScreened": {
      "$ref": "#/properties/counts/properties/databases"
     },
     "registerSources": {
      "items": {
       "$ref": "#/properties/counts/properties/databaseSources/items"
      },
      "maxItems": 30,
      "type": "array"
     },
     "registers": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Records identified from registers."
     },
     "reportsAssessed": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Reports assessed for eligibility."
     },
     "reportsExcluded": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Total reports excluded, when reasons are not itemised."
     },
     "reportsExcludedReasons": {
      "description": "Reports excluded, one entry per reason.",
      "items": {
       "$ref": "#/properties/counts/properties/databaseSources/items"
      },
      "maxItems": 30,
      "type": "array"
     },
     "reportsIncluded": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Reports of included studies."
     },
     "reportsNotRetrieved": {
      "$ref": "#/properties/counts/properties/databases"
     },
     "reportsSought": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Reports sought for retrieval."
     },
     "studiesIncluded": {
      "$ref": "#/properties/counts/properties/databases",
      "description": "Studies included in the review."
     }
    },
    "type": "object"
   },
   "footnotes": {
    "default": true,
    "description": "Print the template footnotes and source attribution.",
    "type": "boolean"
   },
   "other_methods_column": {
    "description": "Force the other-methods column on or off. Default: drawn when otherMethods counts are given.",
    "type": "boolean"
   }
  },
  "required": [
   "counts"
  ],
  "type": "object"
 },
 "name": "prisma_flow_diagram",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "derived": {
       "type": "boolean"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "derived"
     ],
     "type": "object"
    },
    "type": "object"
   },
   "height": {
    "type": "number"
   },
   "image_url": {
    "type": "string"
   },
   "svg": {
    "type": "string"
   },
   "svg_url": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "expected": {
       "type": "number"
      },
      "field": {
       "type": "string"
      },
      "given": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "field",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "width": {
    "type": "number"
   }
  },
  "required": [
   "svg",
   "width",
   "height",
   "warnings",
   "counts"
  ],
  "type": "object"
 },
 "title": "PRISMA 2020 flow diagram"
}
