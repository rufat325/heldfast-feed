{"_meta":{"securitySchemes":[{"scopes":["offline_access"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Submit Demand Signal"},"description":"Submit an expert demand signal: a bounded, expiring nudge to forecasted demand for one item (by SKU), a tag cohort, or a category. Use it to feed outside knowledge the sales history can't see yet \u2014 an upcoming promotion, a trend or search spike, a market event, weather-driven demand. The multiplier (e.g. 1.25 = +25%) is clamped to the allowed band and the duration to the allowed window; the nudge decays linearly back to neutral by expiry, so a signal can inform a forecast but never own it. The owning client is derived from the target (item's client, or the credential's pin for cohorts) \u2014 never supplied. Signals can't be deleted over MCP; they self-neutralize at expiry, and early retirement (expire) is an in-app action. The preview carries an advisory estimate calibration: how far this workspace's completed signals (yours by submittedBy, and those backed by the same evidence source) have run from what sold, with your multiplier calibrated. It never changes your multiplier unless you set adoptCalibration.","inputSchema":{"properties":{"adoptCalibration":{"default":false,"description":"Explicitly adopt the estimate calibration shown in the preview: the multiplier you send stays your stated value and is recorded as such, and the signal stores it calibrated. Refused when no calibration is available yet. Default false.","type":"boolean"},"categoryId":{"default":null,"description":"The targeted category id (GUID; required for Category scope).","type":["string","null"]},"decayMode":{"default":null,"description":"Decay behavior: Decaying (default, linear fade to neutral) or Sustained (full strength through the window, hard stop at expiry).","type":["string","null"]},"durationDays":{"description":"How many days the signal stays in force (clamped to the allowed window; the preview reports the effective value).","type":"integer"},"evidenceId":{"default":null,"description":"Optional evidence id (GUID) linking this signal to a demand evidence record for provenance.","type":["string","null"]},"idempotencyKey":{"default":null,"description":"Caller-generated idempotency key; required with previewReceipt to commit.","type":["string","null"]},"itemSku":{"default":null,"description":"The targeted item's SKU (required for Item scope).","type":["string","null"]},"multiplier":{"description":"The nudge multiplier, e.g. 1.25 = +25%, 0.8 = -20%. Clamped to the allowed band (the preview reports the effective value).","type":"number"},"note":{"default":null,"description":"Free-text rationale / provenance \u2014 what outside knowledge this encodes and where it came from (e.g. \"holiday gift-guide feature confirmed for November\").","type":["string","null"]},"preview":{"default":false,"description":"Step 1 of the required two-step write: set true to validate and receive a structured preview (resolved target + effective clamped values) plus a single-use previewReceipt. Nothing is created until the commit call.","type":"boolean"},"previewReceipt":{"default":null,"description":"Step 2 of the required two-step write: the receipt returned by the preview call. Supply together with a fresh idempotencyKey to commit; calls without it are refused.","type":["string","null"]},"signalScope":{"description":"Signal scope: Item, Tag, or Category.","type":"string"},"submittedBy":{"default":null,"description":"Optional label for the submitting specialist/assistant.","type":["string","null"]},"tag":{"default":null,"description":"The targeted tag, matched against items' tags (required for Tag scope).","type":["string","null"]}},"required":["signalScope","multiplier","durationDays"],"type":"object"},"name":"submit_demand_signal","outputSchema":{"properties":{"actionItemId":{"format":"uuid","type":["string","null"]},"approvalResult":{"type":["