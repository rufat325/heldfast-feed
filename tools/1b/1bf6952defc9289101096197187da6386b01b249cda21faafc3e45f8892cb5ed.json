{
 "description": "Read persisted simulation events in stream order. Paginated \u2014 use offset/limit to page through long runs instead of materializing the full event log.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 200,
    "description": "Maximum events to return (default 200).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Skip this many events from the start.",
    "minimum": 0,
    "type": "integer"
   },
   "runId": {
    "description": "Simulation run id.",
    "type": "string"
   }
  },
  "required": [
   "runId"
  ],
  "type": "object"
 },
 "name": "simulation_stream"
}
