{
 "description": "Paid transaction preflight. Checks mandate, amount, destination, merchant, expiry and replay risk before an autonomous payment executes. Costs $0.05 USDC on Base.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent": {
    "additionalProperties": true,
    "properties": {
     "id": {
      "type": "string"
     },
     "signature_verified": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "authorization": {
    "additionalProperties": true,
    "properties": {
     "allowed_domains": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "expected_recipient": {
      "type": "string"
     },
     "human_confirmed": {
      "type": "boolean"
     },
     "max_amount": {
      "type": [
       "string",
       "number"
      ]
     }
    },
    "required": [
     "max_amount"
    ],
    "type": "object"
   },
   "expires_at": {
    "description": "ISO-8601 intent expiry",
    "type": "string"
   },
   "intent_id": {
    "description": "Unique payment-intent identifier",
    "minLength": 1,
    "type": "string"
   },
   "merchant": {
    "additionalProperties": true,
    "properties": {
     "domain": {
      "minLength": 1,
      "type": "string"
     },
     "expected_recipient": {
      "type": "string"
     }
    },
    "required": [
     "domain"
    ],
    "type": "object"
   },
   "nonce": {
    "description": "Unique anti-replay nonce",
    "minLength": 8,
    "type": "string"
   },
   "payment": {
    "additionalProperties": true,
    "properties": {
     "amount": {
      "type": [
       "string",
       "number"
      ]
     },
     "currency": {
      "type": "string"
     },
     "network": {
      "type": "string"
     },
     "recipient": {
      "type": "string"
     }
    },
    "required": [
     "network",
     "currency",
     "amount",
     "recipient"
    ],
    "type": "object"
   }
  },
  "required": [
   "intent_id",
   "nonce",
   "expires_at",
   "merchant",
   "payment",
   "authorization"
  ],
  "type": "object"
 },
 "name": "verify_agent_payment_intent",
 "title": "Verify Agent Payment Intent"
}
