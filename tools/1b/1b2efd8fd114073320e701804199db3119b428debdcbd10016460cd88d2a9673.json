{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Suspend specific scaling processes for an Auto Scaling Group",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoScalingGroupNo": {
    "description": "Auto Scaling Group number",
    "type": "string"
   },
   "scalingProcessCodeList": {
    "description": "List of scaling process codes to suspend",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "autoScalingGroupNo",
   "scalingProcessCodeList"
  ],
  "type": "object"
 },
 "name": "ncloud_suspend_processes"
}
