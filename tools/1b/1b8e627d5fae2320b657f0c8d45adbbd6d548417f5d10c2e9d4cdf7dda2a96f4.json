{
 "description": "Push externally-tracked Kogan stats (impressions, clicks, conversions, quantity sold, sales) into AdButler for a set of ad items over a time window. Kogan marketplace accounts only \u2014 requires the Kogan self-serve feature; other accounts receive a feature-not-enabled error.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Per-ad-item stat rows to record",
    "items": {
     "additionalProperties": false,
     "properties": {
      "ad_item_id": {
       "description": "Numeric ad item ID, or a Value Catcher composite ID \"seller_id,sku,wallet_id,zone_id\" (e.g. \"KoganSeller,OVMIASDBDWA,3,104446)\"",
       "type": [
        "number",
        "string"
       ]
      },
      "clicks": {
       "description": "Clicks in the window (default 0)",
       "type": "number"
      },
      "conversions": {
       "description": "Conversions in the window (default 0)",
       "type": "number"
      },
      "impressions": {
       "description": "Impressions in the window (default 0)",
       "type": "number"
      },
      "quantity_sold": {
       "description": "Units sold in the window (default 0)",
       "type": "number"
      },
      "sales": {
       "description": "Sales value in the window (default 0.00)",
       "type": "number"
      }
     },
     "required": [
      "ad_item_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "description": "Time window the stat rows cover",
    "properties": {
     "from": {
      "description": "Window start, ISO-8601 (e.g. \"2026-02-06T00:00:00+11:00\")",
      "type": "string"
     },
     "timezone": {
      "description": "Timezone of the window (e.g. \"Australia/Melbourne\")",
      "type": "string"
     },
     "to": {
      "description": "Window end, ISO-8601",
      "type": "string"
     }
    },
    "required": [
     "from",
     "to",
     "timezone"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 },
 "name": "sync_kogan_stats"
}
