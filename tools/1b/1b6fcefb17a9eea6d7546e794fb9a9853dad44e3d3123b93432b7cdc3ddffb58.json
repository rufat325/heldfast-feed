{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new profile with optional display name, bio, avatar, business info, and theme settings.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), then call this tool again. start_login does NOT open this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avatar_url": {
    "description": "Avatar as base64 data URI or URL (~75KB limit)",
    "maxLength": 100000,
    "type": "string"
   },
   "bio": {
    "description": "Profile bio",
    "maxLength": 500,
    "type": "string"
   },
   "business_name": {
    "description": "Business name",
    "maxLength": 100,
    "type": "string"
   },
   "display_name": {
    "description": "Display name",
    "maxLength": 100,
    "type": "string"
   },
   "is_business": {
    "description": "Whether this is a business profile",
    "type": "boolean"
   },
   "is_primary": {
    "description": "Set as primary profile",
    "type": "boolean"
   },
   "is_public": {
    "description": "Whether the profile is publicly visible",
    "type": "boolean"
   },
   "theme": {
    "additionalProperties": false,
    "description": "Profile theme settings",
    "properties": {
     "background_color": {
      "description": "Background color (hex)",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "background_type": {
      "description": "Background type",
      "enum": [
       "solid",
       "gradient"
      ],
      "type": "string"
     },
     "font_style": {
      "description": "Font style",
      "enum": [
       "default",
       "modern",
       "classic"
      ],
      "type": "string"
     },
     "gradient_end": {
      "description": "Gradient end color",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "gradient_start": {
      "description": "Gradient start color",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     },
     "primary_color": {
      "description": "Primary color (hex)",
      "pattern": "^#[0-9A-Fa-f]{6}$",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "create_profile"
}
