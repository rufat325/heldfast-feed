{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get a specific permission by ID on a file or shared drive.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileId": {
    "description": "The ID of the file or shared drive",
    "type": "string"
   },
   "permissionId": {
    "description": "The ID of the permission",
    "type": "string"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   },
   "useDomainAdminAccess": {
    "default": false,
    "description": "Issue the request as a domain administrator",
    "type": "boolean"
   }
  },
  "required": [
   "fileId",
   "permissionId"
  ],
  "type": "object"
 },
 "name": "permission_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "deleted": {
    "type": "boolean"
   },
   "displayName": {
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "emailAddress": {
    "type": "string"
   },
   "expirationTime": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "pendingOwner": {
    "type": "boolean"
   },
   "permissionDetails": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "inherited": {
       "type": "boolean"
      },
      "inheritedFrom": {
       "type": "string"
      },
      "permissionType": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "photoLink": {
    "type": "string"
   },
   "role": {
    "enum": [
     "owner",
     "organizer",
     "fileOrganizer",
     "writer",
     "commenter",
     "reader"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "user",
     "group",
     "domain",
     "anyone"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "type",
   "role"
  ],
  "type": "object"
 },
 "title": "Get permission"
}
