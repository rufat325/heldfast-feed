{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Free 3 times a day per client address (at most 50 pages each), no key needed. Lists the pages of Site A (sitemap, robots.txt or crawl), mapped onto Site B when given. Call it to see which pages a comparison would cover or to pick pairs for urls. Do not call it before start_comparison only to price a job: a job without urls discovers for itself. Lists at most maxPages pages, 500 without it (up to 5000 when paid); truncated: true means the ceiling cut the list. Example: { \"sourceUrl\": \"https://old.example\", \"targetUrl\": \"https://new.example\", \"maxPages\": 50 }. Answers with pages (sourceUrl, targetUrl, path), strategy, truncated and, on a free run, sample and allowanceRemaining.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxPages": {
    "description": "Stop after this many pages (default and at most 5000).",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "sitemapUrl": {
    "description": "Sitemap to read instead of the fallbacks.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "sourceUrl": {
    "description": "Site A (full URL).",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "targetUrl": {
    "description": "Site B; pages are mapped onto it when given.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sourceUrl"
  ],
  "type": "object"
 },
 "name": "discover_pages",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowanceRemaining": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "code": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "sourceUrl": {
       "type": "string"
      },
      "targetUrl": {
       "type": "string"
      }
     },
     "required": [
      "sourceUrl",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "string"
       },
       "balance": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "rail": {
        "const": "prepaid",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "balance"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "allowanceRemaining": {
        "type": "number"
       },
       "amount": {
        "type": "string"
       },
       "currency": {
        "const": "USD",
        "type": "string"
       },
       "pagesFromAllowance": {
        "type": "number"
       },
       "rail": {
        "const": "subscription",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "rail",
       "pagesFromAllowance",
       "allowanceRemaining"
      ],
      "type": "object"
     }
    ]
   },
   "sample": {
    "type": "boolean"
   },
   "strategy": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Discover pages"
}
