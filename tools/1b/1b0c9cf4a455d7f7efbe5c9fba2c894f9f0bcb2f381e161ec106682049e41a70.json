{
 "description": "Act as taker: settle a signed quote on-chain by calling Settlement.fillQuote (or fillQuoteWithPermit if a permit is supplied). Requires AGENT_PRIVATE_KEY, and the taker must already hold + have approved takerToken unless using a permit. Broadcasts a real transaction. Get `quote` from a prior request_quote call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "permit": {
    "additionalProperties": false,
    "description": "Optional EIP-2612 permit on takerToken, to skip a separate approve() tx",
    "properties": {
     "deadline": {
      "type": "string"
     },
     "r": {
      "type": "string"
     },
     "s": {
      "type": "string"
     },
     "v": {
      "type": "number"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "value",
     "deadline",
     "v",
     "r",
     "s"
    ],
    "type": "object"
   },
   "quote": {
    "additionalProperties": false,
    "description": "A WireQuote as returned by request_quote (one entry from its `quotes` array)",
    "properties": {
     "expiry": {
      "type": "string"
     },
     "maker": {
      "type": "string"
     },
     "makerAmount": {
      "type": "string"
     },
     "makerToken": {
      "type": "string"
     },
     "nonce": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "taker": {
      "type": "string"
     },
     "takerAmount": {
      "type": "string"
     },
     "takerToken": {
      "type": "string"
     }
    },
    "required": [
     "maker",
     "taker",
     "makerToken",
     "takerToken",
     "makerAmount",
     "takerAmount",
     "expiry",
     "nonce",
     "signature"
    ],
    "type": "object"
   }
  },
  "required": [
   "quote"
  ],
  "type": "object"
 },
 "name": "fill_quote"
}
