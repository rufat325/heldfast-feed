 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Build Packing List"
 },
 "description": "Generate a context-aware packing checklist for a camping trip.\n\nReturns categorized items from the gear catalog, adjusted for campground\namenities, activities, weather, and group size.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activities": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Planned activities (hiking, fishing, swimming, kayaking, biking, beach)"
   },
   "adults": {
    "default": 2,
    "description": "Number of adults (default 2)",
    "type": "integer"
   },
   "campground_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional CUID to personalize based on campground amenities"
   },
   "children": {
    "default": 0,
    "description": "Number of children (default 0)",
    "type": "integer"
   },
   "has_pets": {
    "default": false,
    "description": "Whether bringing pets (default false)",
    "type": "boolean"
   },
   "nights": {
    "default": 2,
    "description": "Number of nights (default 2)",
    "type": "integer"
   },
   "season": {
    "anyOf": [
     {
      "enum": [
       "spring",
       "summer",
       "fall",
       "winter"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "spring, summer, fall, or winter (optional)"
   },
   "trip_type": {
    "default": "car_camping",
    "description": "car_camping, backpacking, rv, or glamping (default car_camping)",
    "enum": [
     "car_camping",
     "backpacking",
     "rv",
     "glamping"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "build_packing_list",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Build Packing List"
}
