{
 "description": "Partially update a Rolli Agent schedule. Unspecified fields are left unchanged. next_run_at is recalculated if any recurrence parameter changes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "available_credits": {
    "description": "New reasoning effort: 1=low, 2=medium, 3=high, 4=max",
    "maximum": 4,
    "minimum": 1,
    "type": "integer"
   },
   "ends_at": {
    "description": "New end ISO 8601 timestamp",
    "type": "string"
   },
   "id": {
    "description": "Schedule UUID",
    "format": "uuid",
    "type": "string"
   },
   "max_post": {
    "description": "New posts-per-platform limit",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mode": {
    "description": "New investigation mode",
    "enum": [
     "trend_briefing",
     "monitoring",
     "competitive_intel"
    ],
    "type": "string"
   },
   "name": {
    "description": "New schedule name",
    "type": "string"
   },
   "notify_email": {
    "description": "New notification email",
    "type": "string"
   },
   "notify_slack_channel_id": {
    "description": "New Slack channel ID",
    "type": "string"
   },
   "notify_slack_webhook": {
    "description": "New Slack webhook URL",
    "type": "string"
   },
   "platforms": {
    "description": "New platforms array",
    "items": {
     "enum": [
      "twitter",
      "reddit",
      "bluesky",
      "youtube",
      "threads",
      "facebook"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "question": {
    "description": "New question",
    "type": "string"
   },
   "recurrence_day_of_month": {
    "description": "1\u201331 for monthly schedules",
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "recurrence_day_of_week": {
    "description": "0\u20136 for weekly schedules",
    "maximum": 6,
    "minimum": 0,
    "type": "integer"
   },
   "recurrence_time": {
    "description": "New time of day in HH:MM format",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "recurrence_timezone": {
    "description": "New IANA timezone",
    "type": "string"
   },
   "recurrence_type": {
    "description": "New cadence",
    "enum": [
     "daily",
     "weekly",
     "monthly",
     "once"
    ],
    "type": "string"
   },
   "starts_at": {
    "description": "New start ISO 8601 timestamp",
    "type": "string"
   },
   "time_window": {
    "description": "New time window",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_agent_schedule"
}
