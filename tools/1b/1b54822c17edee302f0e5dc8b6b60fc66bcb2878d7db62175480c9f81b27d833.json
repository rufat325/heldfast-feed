 "description": "Judge a sequence of Avro schema versions against a named compatibility mode: BACKWARD, FORWARD or FULL, each with its transitive form, or NONE. A transitive mode compares every version against every earlier one; a per-step mode compares only the immediate predecessor, and the gap that leaves is stated rather than hidden. Every comparison performed is listed with its directional result, so a caller can see what was checked as well as the verdict. Pay 180000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "mode": {
    "description": "The mode to enforce. NONE compares nothing and is reported as having compared nothing, which is not a pass.",
    "enum": [
     "BACKWARD",
     "BACKWARD_TRANSITIVE",
     "FORWARD",
     "FORWARD_TRANSITIVE",
     "FULL",
     "FULL_TRANSITIVE",
     "NONE"
    ],
    "example": "BACKWARD_TRANSITIVE",
    "type": "string"
   },
   "versions": {
    "description": "The versions in order, oldest first. The order supplied is the order judged.",
    "example": [
     {
      "id": "v1",
      "schema": {
       "fields": [
        {
         "name": "id",
         "type": "string"
        },
