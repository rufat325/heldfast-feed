        }
       ],
       "name": "Event",
       "namespace": "shop",
       "type": "record"
      }
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "A label used in findings, such as a version number.",
       "maxLength": 64,
       "type": "string"
      },
      "schema": {
       "description": "One version. An Avro schema, as a JSON object or as JSON text, at most 262144 bytes. Nothing is fetched and no registry is consulted, so the documents supplied are the whole input.",
       "type": [
        "object",
        "string"
       ]
      }
     },
     "required": [
