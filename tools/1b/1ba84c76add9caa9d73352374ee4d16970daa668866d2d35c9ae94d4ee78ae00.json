  "properties": {
   "modelID": {
    "description": "Model identifier (e.g. \"claude-sonnet-4-20250514\", \"gpt-4o\")",
    "type": "string"
   },
   "type": {
    "description": "AI provider type",
    "enum": [
     "anthropic",
     "openai",
     "google",
     "xai"
    ],
    "type": "string"
   },
   "useOpenAIOAuth": {
    "description": "Use ChatGPT OAuth instead of API key (OpenAI only)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "shrimp_update_provider",
