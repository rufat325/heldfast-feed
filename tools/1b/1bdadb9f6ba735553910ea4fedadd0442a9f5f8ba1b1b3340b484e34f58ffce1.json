{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List event exhibitors"
 },
 "description": "Filter and page an event's published exhibitor booths, with supplier profile links when available. Category and name filters are case-insensitive; booth assignments should be confirmed with the exhibitor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Organiser category, e.g. Payment",
    "maxLength": 80,
    "type": "string"
   },
   "event_slug": {
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Exhibitor name or booth text",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "event_slug"
  ],
  "type": "object"
 },
 "name": "list_exhibitors",
 "title": "List event exhibitors"
}
