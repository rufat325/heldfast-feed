{
 "description": "Set local metadata for a known Agent-Q Firmware device. 'label' is human-readable local metadata, not a security boundary and not device authority. Pass null to clear the label. Updates local Agent-Q process state only; does not contact Firmware.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "pattern": "^[A-Za-z0-9_.-]{1,128}$",
    "type": "string"
   },
   "label": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "deviceId",
   "label"
  ],
  "type": "object"
 },
 "name": "set_device_metadata",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deviceId": {
    "pattern": "^[A-Za-z0-9_.-]{1,128}$",
    "type": "string"
   },
   "label": {
    "anyOf": [
     {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "source": {
    "const": "metadata",
    "type": "string"
   }
  },
  "required": [
   "source",
   "deviceId",
   "label"
  ],
  "type": "object"
 },
 "title": "Set device metadata"
}
