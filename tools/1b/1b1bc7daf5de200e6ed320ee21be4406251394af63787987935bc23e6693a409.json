{
 "description": "Inject or replace a live stylesheet in the Firefox window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "css": {
    "description": "CSS rules to inject.",
    "type": "string"
   },
   "id": {
    "default": "mcp-injected-style",
    "description": "Identifier for the style.",
    "type": "string"
   },
   "target": {
    "description": "Target scope: chrome for browser UI, or content for web pages.",
    "enum": [
     "chrome",
     "content"
    ],
    "type": "string"
   }
  },
  "required": [
   "css",
   "target"
  ],
  "type": "object"
 },
 "name": "inject_theme_css"
}
