{
 "description": "List tradable assets. direction=from lists sell assets; direction=to requires fromNetwork/fromSymbol (and fromAddress for tokens) and lists buy assets. Enriches with wallet address and balance when possible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "enum": [
     "from",
     "to"
    ],
    "type": "string"
   },
   "fromAddress": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "fromNetwork": {
    "type": "string"
   },
   "fromSymbol": {
    "type": "string"
   },
   "networks": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "page": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "search": {
    "type": "string"
   },
   "wallet": {
    "type": "string"
   }
  },
  "required": [
   "direction"
  ],
  "type": "object"
 },
 "name": "list_swap_assets",
 "title": "List swap assets"
}
