{
 "description": "Update a coupon; only the given fields change",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Discount amount as decimal string (default \"0\")",
    "type": "string"
   },
   "code": {
    "description": "Coupon code",
    "type": "string"
   },
   "date_expires": {
    "description": "Expiry date (YYYY-MM-DD)",
    "type": "string"
   },
   "discount_type": {
    "description": "Discount type (default fixed_cart)",
    "enum": [
     "fixed_cart",
     "percent",
     "fixed_product"
    ],
    "type": "string"
   },
   "excluded_product_ids": {
    "description": "Products the coupon does not apply to",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "free_shipping": {
    "description": "Grants free shipping (default false)",
    "type": "boolean"
   },
   "id": {
    "description": "Coupon ID",
    "type": "integer"
   },
   "individual_use": {
    "description": "Cannot be combined with other coupons (default false)",
    "type": "boolean"
   },
   "maximum_amount": {
    "description": "Maximum cart subtotal as decimal string",
    "type": "string"
   },
   "minimum_amount": {
    "description": "Minimum cart subtotal as decimal string",
    "type": "string"
   },
   "product_ids": {
    "description": "Products the coupon applies to",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "usage_limit": {
    "description": "Total usage limit",
    "type": "integer"
   },
   "usage_limit_per_user": {
    "description": "Usage limit per customer",
    "type": "integer"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "woo_update_coupon"
}
