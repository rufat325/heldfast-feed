 },
 "description": "Inspect the consenting buyer's existing basket before changing its lines; rechecks current prices and stock and returns item_id for update_cart_item or remove_cart_item. Use get_checkout for delivery, payment and contact choices, not this tool. OAuth scopes: cart:read. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "required": [],
  "type": "object"
 },
 "name": "get_cart",
