        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "product_id": {
       "minimum": 0,
       "type": "integer"
      },
      "quantity": {
       "type": "number"
      },
      "stock": {
       "additionalProperties": false,
       "description": "Both fields are the aggregate across the store warehouse network. They do not promise pickup today or a delivery lead time.",
       "properties": {
        "local": {
         "anyOf": [
          {
           "minimum": 0,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "total": {
         "anyOf": [
          {
           "minimum": 0,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
