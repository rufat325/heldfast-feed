{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Brand Profile"
 },
 "description": "Create or update a local brand profile used by Raven creative jobs. Stores colors, fonts, tone, audience, constraints, product notes, and asset references locally under ~/.raven/creative by default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset_ids": {
    "description": "Existing Raven creative asset IDs tied to this brand.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "audience": {
    "description": "Primary audience/customer.",
    "type": "string"
   },
   "colors": {
    "description": "Brand colors, preferably hex or token names.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "constraints": {
    "description": "Rules to honor: no claims, legal notes, visual constraints.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "description": "What the brand/product is.",
    "type": "string"
   },
   "fonts": {
    "description": "Brand fonts or type guidance.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Optional stable ID. If omitted, Raven creates one from the name.",
    "type": "string"
   },
   "name": {
    "description": "Brand or project name.",
    "type": "string"
   },
   "product": {
    "description": "Product or offer notes.",
    "type": "string"
   },
   "tone": {
    "description": "Voice and tone guidance.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_brand_profile"
}
