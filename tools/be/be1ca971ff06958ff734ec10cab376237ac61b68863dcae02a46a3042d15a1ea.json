{
 "description": "List the agent's executed on-chain trades across all markets. Includes both LMSR (BackstopRouter) and CLOB (Exchange) trades. Filter by market, side, or source. Ordered newest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max trades (default 50, max 100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "market": {
    "description": "Filter by market contract address.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset.",
    "minimum": 0,
    "type": "integer"
   },
   "side": {
    "description": "Filter by side.",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "source": {
    "description": "Filter by venue.",
    "enum": [
     "lmsr",
     "clob"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_trade_history"
}
