 "name": "generate_lbo_xlsx",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": false,
    "description": "Provenance envelope \u2014 data lineage for every MCP response",
    "properties": {
     "as_of_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "cost_usd": {
