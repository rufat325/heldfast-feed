   },
   "url": {
    "type": "string"
   },
   "verification": {
    "additionalProperties": false,
    "description": "Server-trust record. status='verified' when the caller's figures matched the server re-derivation; 'corrected' when they did not (the workbook shows the SERVER figures + a banner). `mismatches` lists every field that disagreed.",
    "properties": {
     "mismatches": {
      "items": {
