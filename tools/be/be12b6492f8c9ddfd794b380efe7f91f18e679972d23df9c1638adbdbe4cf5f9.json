          "default_action",
          "pricing_page",
          "contact_sales"
         ],
         "type": "object"
        },
        "requested_value": {},
        "returned_value": {},
        "subcode": {
         "type": "string"
        }
       },
       "required": [
        "code",
        "subcode",
        "limit_type",
        "current_plan",
        "remediation"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "payg_override": {
      "additionalProperties": false,
      "description": "Set when this single response was paid for via the agent-pay PAYG flow \u2014 the rate-limit / depth-limit checks were bypassed for this call only.",
      "properties": {
