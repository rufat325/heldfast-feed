{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a monitor",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "checks": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "filters": {
         "additionalProperties": {},
         "description": "Signal checks \u2014 structured filters (type-specific).",
         "properties": {},
         "type": "object"
        },
        "kind": {
         "enum": [
          "enrichment",
          "signal"
         ],
         "type": "string"
        },
        "prompt": {
         "description": "Signal checks \u2014 natural-language intent the AI turns into filters.",
         "type": "string"
        },
        "templateId": {
         "description": "Enrichment checks \u2014 the template holding the question.",
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        "type": {
         "description": "Signal checks \u2014 the occurrence type to watch for (verb-past vocabulary).",
         "enum": [
          "job_posted",
          "social_posted",
          "funding_raised",
          "investment_made",
          "ipo_announced",
          "ipo_stage_changed",
          "repo_engaged",
          "ipo_rumoured",
          "tender_published"
         ],
         "type": "string"
        }
       },
       "required": [
        "kind"
       ],
       "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     },
     "schedule": {
      "additionalProperties": {},
      "properties": {
       "cronExpression": {
        "description": "Alternative to frequency; minimum interval 24h.",
        "type": "string"
       },
       "frequency": {
        "enum": [
         "daily",
         "weekly",
         "monthly"
        ],
        "type": "string"
       },
       "timezone": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "target": {
      "additionalProperties": {},
      "properties": {
       "entity": {
        "description": "List targets \u2014 what the list contains.",
        "enum": [
         "company",
         "contact"
        ],
        "type": "string"
       },
       "listId": {
        "description": "List targets \u2014 the watched list.",
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "type": {
        "enum": [
         "list",
         "market"
        ],
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     "webhook": {
      "allOf": [
       {
        "additionalProperties": {},
        "properties": {
         "interval": {
          "enum": [
           "daily",
           "weekly"
          ],
          "type": "string"
         },
         "intervalSignalLimit": {
          "description": "Maximum signals to deliver per polling interval. Each run delivers at most this many. Over a billing cycle the monitor delivers at most this value times the number of runs its interval allows in the cycle, then waits for the next cycle. When runs overlap, for example a manual trigger during a scheduled run, the cycle total can exceed this by at most one run's limit per overlapping run. For ipo_stage_changed, ipo_rumoured, repo_engaged and tender_published, which Saber checks on its own schedule (every few minutes, or every hour for tender_published), the limit bounds each check rather than each interval, and the billing-cycle bound is the effective ceiling.",
          "maximum": 10000,
          "minimum": 1,
          "type": "integer"
         },
         "url": {
          "description": "Delivery endpoint. Omit it to create a monitor with no delivery: signals are still detected, stored and charged, and are read back from GET /v1/monitors/{monitorId}/signals instead of being POSTed. A url-less webhook block is still accepted, and is how a caller sets interval and intervalSignalLimit without configuring delivery.",
          "format": "uri",
          "type": "string"
         }
        },
        "type": "object"
       },
       {
        "additionalProperties": {},
        "properties": {
         "secret": {
          "description": "Optional HMAC signing secret for deliveries; never echoed back.",
          "maxLength": 200,
          "type": "string",
          "writeOnly": true
         }
        },
        "type": "object"
       }
      ],
      "description": "Discovery monitors \u2014 delivery webhook."
     }
    },
    "required": [
     "checks"
    ],
    "type": "object"
   }
  },
  "required": [
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "monitors-create"
}
