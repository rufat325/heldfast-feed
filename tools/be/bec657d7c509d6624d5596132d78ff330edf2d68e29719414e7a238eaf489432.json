{
 "description": "Check multiple values against their baselines in a single request. Returns individual results plus a summary of flagged/normal items. Max 100 items per batch.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "Array of items to check (1-100)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "description": "Baseline category",
       "type": "string"
      },
      "company_size": {
       "description": "Company size segment",
       "type": "string"
      },
      "region": {
       "description": "Geographic region",
       "type": "string"
      },
      "unit": {
       "description": "Unit of measurement",
       "type": "string"
      },
      "value": {
       "description": "Numeric value to check",
       "type": "number"
      }
     },
     "required": [
      "category",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "batch_check"
}
