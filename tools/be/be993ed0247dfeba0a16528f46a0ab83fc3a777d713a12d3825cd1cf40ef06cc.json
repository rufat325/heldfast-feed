{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a connection block"
 },
 "description": "Minimal connection block for the preferred remote (or package) with ${SECRET} placeholders, formatted for a target client. Secrets are never accepted or returned.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "Official reverse-DNS name",
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "description": "Output format (default mcpServers)",
    "enum": [
     "mcpServers",
     "vscode",
     "cursor",
     "claude-code-cli",
     "codex-toml",
     "opencode",
     "gemini",
     "goose"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_connection",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "autonomous": {
    "type": "boolean"
   },
   "class": {
    "description": "R0 remote no auth, R1 static secret, R2 OAuth, L0 local package",
    "enum": [
     "R0",
     "R1",
     "R2",
     "L0",
     "unknown"
    ],
    "type": "string"
   },
   "connection": {
    "description": "The block for the target client: an object for JSON targets, a string for text ones"
   },
   "content_type": {
    "enum": [
     "application/json",
     "text/plain"
    ],
    "type": "string"
   },
   "human_steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key": {
    "description": "Suggested name for the server in the client configuration",
    "type": "string"
   },
   "kind": {
    "enum": [
     "remote",
     "package",
     "bundle"
    ],
    "type": "string"
   },
   "next_actions": {
    "description": "Follow-up calls: action is the tool, arguments are ready to pass ({placeholders} are yours to fill)",
    "items": {
     "additionalProperties": {},
     "properties": {
      "action": {
       "type": "string"
      },
      "arguments": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "placeholders": {
    "type": "string"
   },
   "secrets": {
    "description": "Placeholders to replace with values you hold",
    "items": {
     "additionalProperties": {},
     "properties": {
      "name": {
       "type": "string"
      },
      "where": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "where"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "server": {
    "type": "string"
   },
   "target": {
    "type": "string"
   }
  },
  "required": [
   "server",
   "key",
   "kind",
   "class",
   "autonomous",
   "human_steps",
   "target",
   "content_type",
   "connection",
   "secrets",
   "placeholders",
   "next_actions"
  ],
  "type": "object"
 },
 "title": "Get a connection block"
}
