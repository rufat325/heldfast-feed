  "readOnlyHint": true,
  "title": "chainpeek: price a Uniswap V3 swap at up to five sizes: price impact, best fee tier and pool, gap to the candle"
 },
 "description": "chainpeek: Check a Uniswap V3 swap at up to five sizes: price impact and candle gap. For one quote use get_swap_quote. Returns a Uniswap V3 swap quoted at each of up to five `sizes`, smallest first: `amount_out`, `effective_price`, `price_impact_pct` against the smallest size, the best `fee_tier` and `pool`, `gas_estimate`; plus a `reference` with the latest 5-minute candle close (WETH/USDC, cbBTC/USDC on Base) and `reference_gap_pct` to the smallest size's price. A size that cannot be quoted is an `error` row; none quotable is a 422 or 503 (not charged). Impact is against the smallest size, not the market. Single pool, exact input; not a firm price. Bad input is a 422 (not charged). Typically 1-3 s. Price: USD 0.005. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/uniswap-quote-api.html",
 "inputSchema": {
  "properties": {
   "chain": {
    "description": "Chain to quote on (Uniswap V3): ethereum or base.",
    "enum": [
     "ethereum",
     "base"
    ],
    "title": "Chain",
    "type": "string"
   },
   "fee_tiers": {
    "anyOf": [
     {
      "items": {
       "enum": [
        100,
        500,
        3000,
        10000
       ],
       "type": "integer"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Uniswap V3 fee tiers to consider (100, 500, 3000, 10000). Default: all four.",
    "title": "Fee Tiers"
   },
   "sizes": {
    "description": "1 to 5 amounts of token_in as positive decimal strings in token_in units, e.g. [\"1\", \"10\", \"100\"]. Distinct; answered smallest first.",
    "items": {
     "maxLength": 160,
     "pattern": "^(0|[1-9][0-9]{0,77})(\\.[0-9]{1,77})?$",
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "title": "Sizes",
    "type": "array"
   },
   "token_in": {
    "description": "Token sold (0x + 40 hex).",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "Token In",
    "type": "string"
   },
   "token_out": {
    "description": "Token bought (0x + 40 hex).",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "title": "Token Out",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "token_in",
   "token_out",
   "sizes"
  ],
  "title": "pre_trade_checkArguments",
  "type": "object"
 },
