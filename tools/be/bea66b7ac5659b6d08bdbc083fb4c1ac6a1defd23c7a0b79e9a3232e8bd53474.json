{
 "_meta": {
  "openai/outputTemplate": "ui://careclinic/tracker-card-v2.html",
  "openai/toolInvocation/invoked": "Account access ready",
  "openai/toolInvocation/invoking": "Checking account access\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "careclinic.wellness.read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://careclinic/tracker-card-v2.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://careclinic/tracker-card-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the connected CareClinic account\u2019s plan and basic-versus-full insight entitlement.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "careclinic_account",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "account": {
    "additionalProperties": false,
    "properties": {
     "insightLevel": {
      "enum": [
       "basic",
       "full"
      ],
      "type": "string"
     },
     "isPremium": {
      "type": "boolean"
     },
     "planLabel": {
      "maxLength": 80,
      "type": "string"
     }
    },
    "required": [
     "isPremium",
     "insightLevel"
    ],
    "type": "object"
   },
   "accountLinks": {
    "additionalProperties": false,
    "properties": {
     "app": {
      "format": "uri",
      "type": "string"
     },
     "web": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "web"
    ],
    "type": "object"
   },
   "kind": {
    "const": "account",
    "type": "string"
   },
   "premiumInfoUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "account",
   "premiumInfoUrl"
  ],
  "type": "object"
 },
 "title": "Get CareClinic account access"
}
