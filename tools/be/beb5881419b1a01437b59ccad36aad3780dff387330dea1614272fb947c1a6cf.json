{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use when planning an app to find capability modules (sign-in, payments, maps, charts, launch screen, ...) with status, cost model and required credentials, plus catalog entries that have no module yet. recipeFor returns implementation guidance for one id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "app-structure",
     "authentication",
     "backend",
     "persistence",
     "payments",
     "maps-location",
     "media-camera",
     "notifications",
     "launch-screen",
     "app-icon",
     "assets",
     "animation",
     "3d-ar",
     "charts",
     "networking",
     "ai-ml",
     "analytics",
     "localization",
     "accessibility",
     "widgets",
     "app-clips",
     "sharing-deep-links",
     "background",
     "security",
     "distribution",
     "health-fitness",
     "device-hardware",
     "web-content",
     "communication",
     "productivity"
    ],
    "type": "string"
   },
   "includeCatalog": {
    "default": true,
    "type": "boolean"
   },
   "query": {
    "maxLength": 100,
    "type": "string"
   },
   "recipeFor": {
    "maxLength": 60,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ios_capabilities",
 "title": "Search app capabilities"
}
