{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Download and mirror a publicly accessible website, including HTML pages and required frontend assets, and return a machine-readable manifest and optional downloadable archive. When: Use when an agent needs an offline mirror of a public website and its frontend assets. Selection: specialized; prefer for Use when an agent needs an offline mirror of a public website and its frontend assets.. Input is a strict JSON object; see the schema. Price: $0.75 USD per call. A free preview is available through preview_capability before payment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "adjustExtensions": {
    "default": true,
    "type": "boolean"
   },
   "convertLinks": {
    "default": true,
    "type": "boolean"
   },
   "includeAssets": {
    "default": true,
    "type": "boolean"
   },
   "maxDepth": {
    "default": 3,
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "maxFiles": {
    "default": 2000,
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "maxSizeMb": {
    "default": 100,
    "maximum": 1024,
    "minimum": 1,
    "type": "integer"
   },
   "output": {
    "default": "archive_and_manifest",
    "enum": [
     "manifest",
     "archive",
     "archive_and_manifest"
    ],
    "type": "string"
   },
   "sameDomainOnly": {
    "default": true,
    "type": "boolean"
   },
   "timeoutSeconds": {
    "default": 120,
    "maximum": 900,
    "minimum": 5,
    "type": "integer"
   },
   "url": {
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "website_download",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "archive": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "available": {
        "const": true,
        "type": "boolean"
       },
       "downloadUrl": {
        "type": "string"
       },
       "fileId": {
        "type": "string"
       },
       "format": {
        "const": "zip",
        "type": "string"
       },
       "sizeBytes": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "available",
       "format",
       "sizeBytes",
       "fileId",
       "downloadUrl"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "assetsDownloaded": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "durationMs": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "finalUrl": {
    "type": "string"
   },
   "manifest": {
    "additionalProperties": false,
    "properties": {
     "files": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "contentType": {
         "type": [
          "string",
          "null"
         ]
        },
        "localPath": {
         "type": "string"
        },
        "sizeBytes": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "type": {
         "enum": [
          "html",
          "css",
          "javascript",
          "image",
          "font",
          "json",
          "document",
          "media",
          "other"
         ],
         "type": "string"
        }
       },
       "required": [
        "localPath",
        "type",
        "contentType",
        "sizeBytes"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "files"
    ],
    "type": "object"
   },
   "pagesDownloaded": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sourceUrl": {
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "totalFiles": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "totalSizeBytes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "success",
   "sourceUrl",
   "finalUrl",
   "pagesDownloaded",
   "assetsDownloaded",
   "totalFiles",
   "totalSizeBytes",
   "durationMs",
   "archive",
   "manifest",
   "warnings"
  ],
  "type": "object"
 }
}
