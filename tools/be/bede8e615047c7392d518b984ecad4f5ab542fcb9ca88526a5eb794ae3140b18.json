{
 "description": "Generate a full multi-page application from a template pack",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "framework": {
    "description": "Target framework",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "angular",
     "svelte",
     "html"
    ],
    "type": "string"
   },
   "pack_id": {
    "description": "Template pack ID (e.g., saas-dashboard, startup-landing)",
    "type": "string"
   },
   "project_name": {
    "description": "Project name",
    "type": "string"
   }
  },
  "required": [
   "pack_id",
   "framework",
   "project_name"
  ],
  "type": "object"
 },
 "name": "generate_from_template_pack"
}
