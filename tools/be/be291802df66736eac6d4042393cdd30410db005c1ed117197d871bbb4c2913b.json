  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get order status"
 },
 "description": "Customer-facing status, ETA window and next action for an order. Looked up by the buyer's private order token, issued after payment; the token is the only credential. Never returns address, phone or payment details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "description": "Language of the conversation with the user (e.g. he-IL, fr-FR). Localizes content and messages; prices and availability are unaffected.",
    "maxLength": 12,
    "type": "string"
   },
   "order_token": {
    "description": "The order token from the buyer's confirmation email (GR-XXXXX-\u2026).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "order_token"
  ],
  "type": "object"
 },
 "name": "get_order_status",
 "outputSchema": {
  "properties": {
   "country": {
    "type": "string"
   },
   "delivery_date": {
    "type": [
     "string",
     "null"
    ]
   },
   "display_text": {
    "description": "Human-readable one-line summary of the result",
    "type": "string"
   },
   "error": {
    "description": "Present only when the call failed",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "next_step": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "estimated_window": {
    "properties": {
     "earliest": {
      "type": "string"
     },
     "latest": {
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "gift": {
    "type": "string"
   },
   "locale": {
    "description": "BCP-47 locale the texts are localized to",
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "status": {
    "description": "Machine status, e.g. confirmed | on_the_way | delivered | needs_attention",
    "type": "string"
   },
   "status_label": {
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   }
  },
  "type": "object"
 },
