{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Dead-man's switch: ping at least every interval_seconds (default 300) plus grace. On a miss, status becomes\nmissed and on_miss runs once: {\"type\":\"notify\"} (default), {\"type\":\"enqueue\",\"queue_id\":...,\"channel\":...,\n\"payload\":...} or {\"type\":\"put_key\",\"key\":...,\"value\":...}. No outbound HTTP. read(status, wait_seconds)\nwaits for a change; ping re-arms.","inputSchema":{"properties":{"action":{"enum":["create","read","ping","touch","delete"],"title":"Action","type":"string"},"grace_seconds":{"anyOf":[{"maximum":3600,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Grace Seconds"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"interval_seconds":{"anyOf":[{"maximum":86400,"minimum":5,"type":"integer"},{"type":"null"}],"default":null,"title":"Interval Seconds"},"on_miss":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"On Miss"},"status":{"anyOf":[{"enum":["armed","missed"],"type":"string"},{"type":"null"}],"default":null,"title":"Status"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"heartbeatArguments","type":"object"},"name":"heartbeat"}
