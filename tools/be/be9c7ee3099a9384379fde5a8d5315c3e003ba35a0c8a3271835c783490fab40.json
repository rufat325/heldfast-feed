{
 "description": "Parses a CIDR block and reports its network address, address range, and address count. An address with host bits set (e.g. 10.14.32.17/21) is normalized to its network address in the result.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cidr": {
    "description": "an IPv4 or IPv6 CIDR block, e.g. 10.14.32.17/21",
    "type": "string"
   }
  },
  "required": [
   "cidr"
  ],
  "type": "object"
 },
 "name": "network_cidr_info",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "addresses": {
    "type": "string"
   },
   "cidr": {
    "type": "string"
   },
   "firstAddress": {
    "type": "string"
   },
   "lastAddress": {
    "type": "string"
   },
   "network": {
    "type": "string"
   },
   "prefixLength": {
    "type": "integer"
   },
   "version": {
    "type": "integer"
   }
  },
  "required": [
   "cidr",
   "network",
   "firstAddress",
   "lastAddress",
   "prefixLength",
   "version",
   "addresses"
  ],
  "type": "object"
 }
}
