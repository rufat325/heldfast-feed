{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create or update a voice agent's test suite. Requires the OWNER or ADMIN role. Upserts. Send the full scenarios array you want to keep \u2014 it replaces the stored one, it is not merged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "description": "ID of the voice agent (from list_voice_agents)",
    "minLength": 1,
    "type": "string"
   },
   "autoRunOnInstructionSave": {
    "type": "boolean"
   },
   "autoRunOnKbUpdate": {
    "type": "boolean"
   },
   "maxCostPerRun": {
    "minimum": 0,
    "type": "number"
   },
   "scenarios": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "enum": [
        "greeting",
        "kb_retrieval",
        "off_topic",
        "edge_case",
        "custom"
       ],
       "type": "string"
      },
      "criteria": {
       "description": "Defaults to an empty array.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "criterionId": {
          "type": "string"
         },
         "evaluationPrompt": {
          "description": "What the LLM judge is asked to evaluate.",
          "type": "string"
         },
         "expectedToolName": {
          "description": "For type=tool_called: the tool name to look for in the transcript's tool calls.",
          "type": "string"
         },
         "isCritical": {
          "type": "boolean"
         },
         "maxWords": {
          "description": "For type=response_length: fails if any agent response exceeds this word count.",
          "type": "integer"
         },
         "mustMatch": {
          "description": "For type=regex_match: true (default) requires a match, false requires none.",
          "type": "boolean"
         },
         "name": {
          "type": "string"
         },
         "regexPattern": {
          "description": "For type=regex_match: JS regex source, no slashes.",
          "type": "string"
         },
         "type": {
          "description": "Defaults to llm_judged. The other three route through a deterministic code check before the LLM judge runs.",
          "enum": [
           "llm_judged",
           "response_length",
           "regex_match",
           "tool_called"
          ],
          "type": "string"
         },
         "weight": {
          "maximum": 10,
          "minimum": 1,
          "type": "number"
         }
        },
        "required": [
         "name",
         "evaluationPrompt"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "isEnabled": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "scenarioId": {
       "type": "string"
      },
      "userMessages": {
       "description": "The scripted turns sent to the agent.",
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "name",
      "userMessages"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scheduledCron": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "agentId"
  ],
  "type": "object"
 },
 "name": "update_voice_test_suite",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Update Voice Test Suite"
}
