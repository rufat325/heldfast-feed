 "description": "Key dates for the current semester from UMD Dining Services: when dining plans go live, holiday and break hours, closures and Dining Dollar expiry. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "dining_get_calendar",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "Events in the order the page lists them",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Date as YYYY-MM-DD",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "time": {
       "description": "\"ALL DAY\" or a clock time as printed, e.g. \"10:00AM\"",
       "type": "string"
      },
      "weekday": {
       "enum": [
        "M",
        "Tu",
        "W",
        "Th",
        "F",
        "Sa",
        "Su"
       ],
       "type": "string"
      }
     },
     "required": [
      "date",
      "weekday",
      "time",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "The calendar heading, e.g. \"Fall 2026 - Subject to Change\"",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "title",
   "events"
  ],
  "type": "object"
 },
 "title": "Get dining calendar"
}
