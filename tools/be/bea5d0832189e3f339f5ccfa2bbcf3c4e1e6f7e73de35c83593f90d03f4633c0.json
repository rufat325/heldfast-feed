{
 "description": "Update the content of a specific section within a side page.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "New section content (HTML or markdown)",
    "type": "string"
   },
   "instructions": {
    "description": "AI-guided edit instructions for this section",
    "type": "string"
   },
   "sectionId": {
    "description": "Section ID from view_side_page",
    "type": "string"
   },
   "sideKey": {
    "description": "Side page key",
    "type": "string"
   },
   "slug": {
    "description": "Parent landing page slug",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "sideKey",
   "sectionId"
  ],
  "type": "object"
 },
 "name": "set_side_page_section"
}
