{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Staking rewards calculator"
 },
 "description": "Turn a quoted staking rate into a final balance and rewards earned. For an APR rate, choose daily or monthly compounding; for an APY rate, compounding is already included. Returns the final balance, rewards earned and the effective APY. Figures are treated as GBP. Source: https://hopi.co.uk/staking-calculator/",
 "inputSchema": {
  "properties": {
   "compounding": {
    "default": "daily",
    "description": "Compounding frequency for APR (default daily)",
    "enum": [
     "daily",
     "monthly"
    ],
    "type": "string"
   },
   "principal": {
    "description": "Amount staked",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "rate": {
    "description": "Quoted rate as a percentage (0 to 1000)",
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   },
   "rateType": {
    "default": "apr",
    "description": "Whether the rate is APR (needs compounding) or APY (default apr)",
    "enum": [
     "apr",
     "apy"
    ],
    "type": "string"
   },
   "years": {
    "description": "Term in years (above 0, up to 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "number"
   }
  },
  "required": [
   "principal",
   "rate",
   "years"
  ],
  "type": "object"
 },
 "name": "hopi_staking_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "compounding": {
    "type": [
     "string",
     "null"
    ]
   },
   "effectiveApyPercent": {
    "type": "number"
   },
   "finalBalance": {
    "type": "number"
   },
   "finalBalanceString": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "rateType": {
    "type": "string"
   },
   "rewards": {
    "type": "number"
   },
   "rewardsString": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Staking rewards calculator"
}
