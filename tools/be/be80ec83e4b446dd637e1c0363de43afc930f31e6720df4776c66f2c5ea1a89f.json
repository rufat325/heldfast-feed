   "notes": {
    "description": "optional rough notes to clean up and anchor to the transcript",
    "type": "string"
   },
   "title": {
    "description": "optional meeting title",
    "type": "string"
   },
   "transcript": {
    "description": "the meeting/call transcript text (one line per utterance is ideal)",
    "type": "string"
   }
  },
  "required": [
   "transcript"
  ],
  "type": "object"
 },
