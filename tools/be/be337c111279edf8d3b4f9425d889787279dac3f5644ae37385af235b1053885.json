{
 "description": "Create a Home Assistant backup",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "addons": {
    "description": "For partial backup: add-on slugs to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "folders": {
    "description": "For partial backup: folders to include (e.g. ['config', 'share'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Backup name. Defaults to timestamp.",
    "type": "string"
   },
   "partial": {
    "default": false,
    "description": "Create a partial backup instead of full backup",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "ha_create_backup"
}
