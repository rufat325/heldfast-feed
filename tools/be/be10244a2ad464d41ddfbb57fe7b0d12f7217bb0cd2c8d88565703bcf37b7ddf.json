{
 "description": "Create a Pix payment via Celcoin",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Amount in BRL",
    "type": "number"
   },
   "description": {
    "description": "Payment description",
    "type": "string"
   },
   "endToEndId": {
    "description": "End-to-end ID (optional)",
    "type": "string"
   },
   "pixKey": {
    "description": "Recipient Pix key",
    "type": "string"
   },
   "pixKeyType": {
    "description": "Pix key type",
    "enum": [
     "CPF",
     "CNPJ",
     "EMAIL",
     "PHONE",
     "EVP"
    ],
    "type": "string"
   },
   "recipientDocument": {
    "description": "Recipient CPF/CNPJ",
    "type": "string"
   },
   "recipientName": {
    "description": "Recipient name",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "pixKey",
   "pixKeyType"
  ],
  "type": "object"
 },
 "name": "create_pix_payment"
}
