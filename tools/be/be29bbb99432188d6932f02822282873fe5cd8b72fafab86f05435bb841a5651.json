{"_meta":{"openai/outputTemplate":"ui://headcountlabs/job-cards-v4.html","openai/toolInvocation/invoked":"Found jobs","openai/toolInvocation/invoking":"Searching jobs","openai/widgetAccessible":true,"securitySchemes":[{"type":"noauth"}],"ui":{"resourceUri":"ui://headcountlabs/job-cards-v4.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Search current job postings by keyword, title, company, place, pay and date. Call list_fields for filter names. Country and employment_type accept comma-separated values or arrays. Pages return up to 50 jobs (limit, default 10), or 10 when descriptions is \"full\". Pass next_cursor as cursor for the next page. One search shows up to 250 jobs; narrow filters or use count_jobs for how many match. sort is relevance or updated. Default results are compact summaries (employer, title, locations, pay, dates, urls, snippet). Pass view: \"full\", fields, or get_job for more. descriptions: \"snippet\" (default) previews text; \"full\" returns whole descriptions. title matches a phrase in order; title_advanced matches words with AND, OR and NOT.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"cursor":{"description":"The next_cursor from the previous result, to see the next page.","maxLength":4096,"minLength":1,"type":"string"},"descriptions":{"default":"snippet","description":"snippet (default): a short preview of each description, up to 50 jobs per page. full: the whole text, up to 10 jobs per page.","enum":["snippet","full"],"type":"string"},"fields":{"anyOf":[{"maxLength":200,"minLength":1,"type":"string"},{"items":{"enum":["job_id","currentness","stale","company_id","employer_name","title","description","work_arrangement","locations","job_first_seen_at","curated_at","job_updated_at","postings","company","normalized"],"type":"string"},"minItems":1,"type":"array"}],"description":"Top-level job properties as a comma-separated string or field array; job_id is always included."},"filters":{"additionalProperties":false,"default":{},"properties":{"active":{"$ref":"#/properties/filters/properties/title_advanced"},"application_check":{"$ref":"#/properties/filters/properties/title_advanced"},"application_check_since":{"$ref":"#/properties/filters/properties/title_advanced"},"city":{"anyOf":[{"$ref":"#/properties/filters/properties/q/anyOf/0"},{"$ref":"#/properties/filters/properties/q/anyOf/1"},{"$ref":"#/properties/filters/properties/q/anyOf/2"},{"$ref":"#/properties/filters/properties/q/anyOf/3"}],"description":"City name."},"company":{"anyOf":[{"$ref":"#/properties/filters/properties/q/anyOf/0"},{"$ref":"#/properties/filters/properties/q/anyOf/1"},{"$ref":"#/properties/filters/properties/q/anyOf/2"},{"$ref":"#/properties/filters/properties/q/anyOf/3"}],"description":"Company name."},"company_id":{"$ref":"#/properties/filters/properties/title_advanced"},"company_linked":{"$ref":"#/properties/filters/properties/title_advanced"},"country":{"anyOf":[{"maxLength":16384,"type":"string"},{"items":{"maxLength":200,"type":"string"},"type":"array"}],"description":"One or more two-letter country codes, comma-separated or as an array (US,CA)."},"curated_since":{"$ref":"#/properties/filters/properties/title_advanced"},"curated_until":{"$ref":"#/properties/filters/properties/title_advanced"},"currentness":{"$ref":"#/properties/filters/properties/title_advanced"},"description":{"$ref":"#/properties/filters/properties/title_advanced"},"description_advanced":{"$ref":"#/properties/filters/properties/title_advanced"},"employment_type":{"anyOf":[{"maxLength":16384,"type":"string"},{"items":{"maxLength":200,"type":"string"},"type":"array"}],"description":"One or more employment type values, comma-separated or as an array."},"exclude_source":{"$ref":"#/properties/filters/properties/title_advanced"},"first_seen_since":{"anyOf":[{"$ref":"#/properties/fi