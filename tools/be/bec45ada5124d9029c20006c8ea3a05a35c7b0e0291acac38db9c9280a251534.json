{
 "description": "Turn live SERP intent into a writer- and agent-ready page outline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device": {
    "default": "desktop",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "include_title_options": {
    "default": true,
    "type": "boolean"
   },
   "keyword": {
    "description": "Target keyword",
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "outline_depth": {
    "default": "standard",
    "enum": [
     "brief",
     "standard",
     "detailed"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand or domain",
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "agentseo_content_serp_outline",
 "title": "AgentSEO SERP Outline"
}
