{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Paid URL: 0.10 USDC per call on Base; 10 signed-wallet free calls shared over rolling 30 days. Read the backend 402 body for x402 terms. Verifies an EOA payment signature and observes Base USDC nonce, balance and chain time. Does not simulate, submit, settle, reserve or authorize resource access.\nOperating boundary: Direct access uses x402 Base USDC settlement or the verified-wallet free tier. Verifies an EOA payment signature and observes Base USDC nonce, balance and chain time. Does not simulate, submit, settle, reserve or authorize resource access. The API access fee is separate from any inspected payment or recorded invoice amount.\nPOST /api/x402-payment-gateway. Existing product credentials, signed mandates, and single-use action grants remain required where applicable. This adapter grants no authority and never supplies server credentials. This current money service follows its published inspection, policy evaluation or private invoice contract. Payment is an API access fee and grants no spending authority.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "mode": {
    "const": "inspect_x402_authorization"
   },
   "payment": {
    "additionalProperties": false,
    "properties": {
     "accepted": {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
        "type": "string"
       },
       "asset": {
        "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
        "type": "string"
       },
       "extra": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "const": "USD Coin"
         },
         "version": {
          "const": "2"
         }
        },
        "required": [
         "name",
         "version"
        ],
        "type": "object"
       },
       "maxTimeoutSeconds": {
        "maximum": 3600,
        "minimum": 1,
        "type": "integer"
       },
       "network": {
        "const": "eip155:8453"
       },
       "payTo": {
        "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
        "type": "string"
       },
       "scheme": {
        "const": "exact"
       }
      },
      "required": [
       "scheme",
       "network",
       "amount",
       "asset",
       "payTo",
       "maxTimeoutSeconds",
       "extra"
      ],
      "type": "object"
     },
     "payload": {
      "additionalProperties": false,
      "properties": {
       "authorization": {
        "additionalProperties": false,
        "properties": {
         "from": {
          "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
          "type": "string"
         },
         "nonce": {
          "pattern": "^0x[0-9a-fA-F]{64}(?![\\s\\S])",
          "type": "string"
         },
         "to": {
          "pattern": "^0x[0-9a-fA-F]{40}(?![\\s\\S])",
          "type": "string"
         },
         "validAfter": {
          "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
          "type": "string"
         },
         "validBefore": {
          "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
          "type": "string"
         },
         "value": {
          "pattern": "^(0|[1-9][0-9]{0,77})(?![\\s\\S])",
          "type": "string"
         }
        },
        "required": [
         "from",
         "to",
         "value",
         "validAfter",
         "validBefore",
         "nonce"
        ],
        "type": "object"
       },
       "signature": {
        "pattern": "^0x[0-9a-fA-F]{130}(?![\\s\\S])",
        "type": "string"
       }
      },
      "required": [
       "signature",
       "authorization"
      ],
      "type": "object"
     },
     "resource": {
      "additionalProperties": false,
      "properties": {
       "description": {
        "maxLength": 256,
        "type": "string"
       },
       "mimeType": {
        "const": "application/json"
       },
       "url": {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "url",
       "description",
       "mimeType"
      ],
      "type": "object"
     },
     "x402Version": {
      "const": 2
     }
    },
    "required": [
     "x402Version",
     "resource",
     "accepted",
     "payload"
    ],
    "type": "object"
   },
   "target_product": {
    "enum": [
     "diligenceops-paid-run",
     "agent-daily-operator-brief",
     "mcp-diligence-rail",
     "agent-work-order-rail",
     "agent-paid-workflow",
     "unified-agent-checkout",
     "agent-allowance-console",
     "agent-work-order-exchange",
     "proof-relay",
     "delegated-authority",
     "x402-payment-gateway",
     "payment-authority-inspector",
     "agent-invoice-rail",
     "agent-budget-guard"
    ]
   }
  },
  "required": [
   "mode",
   "target_product",
   "payment"
  ],
  "type": "object"
 },
 "name": "wever_x402-payment-gateway",
 "title": "x402 Payment Gateway"
}
