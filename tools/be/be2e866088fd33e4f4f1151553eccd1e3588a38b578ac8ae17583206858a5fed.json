{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate sidereal gochara"
 },
 "description": "Calculates deterministic transit placements for an explicit instant and maps them to whole-sign houses from a supplied natal Lagna.",
 "inputSchema": {
  "properties": {
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "natalLagnaSign": {
    "maximum": 11,
    "minimum": 0,
    "type": "integer"
   },
   "place": {
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "type": "string"
   },
   "timezoneOffset": {
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "date",
   "time",
   "place",
   "latitude",
   "longitude",
   "timezoneOffset",
   "natalLagnaSign"
  ],
  "type": "object"
 },
 "name": "calculate_gochara",
 "outputSchema": {
  "properties": {
   "engine": {
    "type": "object"
   },
   "instantJulianDay": {
    "type": "number"
   },
   "natalLagnaSign": {
    "type": "integer"
   },
   "placements": {
    "type": "array"
   }
  },
  "required": [
   "instantJulianDay",
   "engine",
   "natalLagnaSign",
   "placements"
  ],
  "type": "object"
 },
 "title": "Calculate sidereal gochara"
}
