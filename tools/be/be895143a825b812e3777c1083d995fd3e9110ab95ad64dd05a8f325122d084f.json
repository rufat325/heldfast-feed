{
 "_meta": {
  "openai/toolInvocation/invoked": "Checked listings",
  "openai/toolInvocation/invoking": "Checking listings\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check product listings"
 },
 "description": "Use this when the user is comparing several product listings, such as search results or the same item at different stores, and wants trust signals on each. Pass up to 20 products, each with what you already read from its listing: title (required) and, when shown, brand, price, listPrice, currency, url, seller, category, rating, reviewCount, details, plus your own id to match results. Returns, in input order, the same findings as check_product for each; a product that can't be checked carries an error and message instead. Signals only, never a buy or avoid verdict. Does not browse the web. Not for banking, health, government or email pages.",
 "inputSchema": {
  "properties": {
   "detail": {
    "description": "Include each finding's full probability distribution. Default false.",
    "type": "boolean"
   },
   "includeBrand": {
    "description": "Also report on the brand the listing names (its brand field), with findings on the brand itself. Default true.",
    "type": "boolean"
   },
   "products": {
    "description": "Products, 1-20.",
    "items": {
     "description": "A product as seen on a store listing. Only title is required; each extra field sharpens the read.",
     "properties": {
      "brand": {
       "description": "Brand or maker, if the listing names one.",
       "maxLength": 200,
       "type": "string"
      },
      "category": {
       "description": "Product category, e.g. \"Headphones\".",
       "maxLength": 300,
       "type": "string"
      },
      "currency": {
       "description": "ISO 4217 code for price and listPrice. Default USD.",
       "pattern": "^[A-Za-z]{3}$",
       "type": "string"
      },
      "details": {
       "description": "Key specs or bullet points as plain text. Longer text is trimmed.",
       "maxLength": 20000,
       "type": "string"
      },
      "id": {
       "description": "Your own id for this product (e.g. an ASIN or list index); echoed back.",
       "maxLength": 100,
       "type": "string"
      },
      "listPrice": {
       "description": "The seller's \"was\" / \"list\" / \"typical\" price, if shown.",
       "maximum": 10000000,
       "minimum": 0,
       "type": "number"
      },
      "price": {
       "description": "What the buyer would pay now, as a number.",
       "maximum": 10000000,
       "minimum": 0,
       "type": "number"
      },
      "rating": {
       "description": "Average star rating out of 5.",
       "maximum": 5,
       "minimum": 0,
       "type": "number"
      },
      "reviewCount": {
       "description": "Number of ratings or reviews.",
       "maximum": 1000000000,
       "minimum": 0,
       "type": "integer"
      },
      "seller": {
       "description": "Seller or store name, if different from the site.",
       "maxLength": 300,
       "type": "string"
      },
      "title": {
       "description": "Product title exactly as the listing shows it.",
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "description": "Listing URL. Only its domain is used.",
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "products"
  ],
  "type": "object"
 },
