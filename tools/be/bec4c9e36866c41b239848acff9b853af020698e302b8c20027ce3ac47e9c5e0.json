{
 "_meta": {
  "openai/outputTemplate": "ui://rapier/editor",
  "openai/toolInvocation/invoked": "Rapier is ready",
  "openai/toolInvocation/invoking": "Opening Rapier",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://rapier/editor",
   "visibility": [
    "model",
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Open Rapier"
 },
 "description": "Open/create Markdown or a Note, or import an authorized host file. Returns revision, up to 32 KiB text and editor_url when available. Keep document private; expires after 30 idle days.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "createToken": {
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "maxLength": 256,
    "type": "string"
   },
   "file": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "maxLength": 256,
      "type": "string"
     },
     "resourceUri": {
      "maxLength": 8192,
      "type": "string"
     }
    },
    "required": [
     "name",
     "resourceUri"
    ],
    "type": "object"
   },
   "filename": {
    "maxLength": 256,
    "type": "string"
   },
   "note": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "sync": {
    "type": "boolean"
   },
   "text": {
    "maxLength": 67108864,
    "type": "string"
   },
   "title": {
    "maxLength": 256,
    "type": "string"
   },
   "url": {
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "open",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "act": {
    "type": [
     "object",
     "null"
    ]
   },
   "complete": {
    "type": "boolean"
   },
   "document": {
    "maxLength": 256,
    "type": "string"
   },
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "revision": {
    "type": [
     "integer",
     "string"
    ]
   },
   "text": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Open Rapier"
}
