  "readOnlyHint": true,
  "title": "Coin Intel"
 },
 "description": "Full Coin Intelligence snapshot for a pump.fun mint. Returns every signal the engine recorded during the observation window: bundle vs organic verdict, bubblemaps-style cluster connectivity, smart-money presence (with wallet labels and win-rates), dev behaviour, category/classification, news-meme detection with the matching headline, risk flags, and a 0-100 quality score. Also returns the outcome if the coin is old enough to be labeled (graduated/rugged/ATH multiple). This is the single highest-signal read for a trade decision. Call this before entering any position.",
 "inputSchema": {
  "properties": {
   "mint": {
    "description": "Solana mint address (base58).",
    "type": "string"
   },
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "devnet"
    ],
    "type": "string"
   }
  },
  "required": [
   "mint"
  ],
  "type": "object"
 },
 "name": "get_coin_intel",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "bubblemap_connectivity": {
    "description": "0\u20131 wallet-cluster share. null = enrichment not yet run.",
    "nullable": true,
    "type": "number"
   },
   "bundle_score": {
    "description": "0\u20131, coordinated-launch likelihood.",
    "type": "number"
   },
   "category": {
    "type": "string"
   },
   "dev_buy_sol": {
    "nullable": true,
    "type": "number"
   },
   "dev_sold": {
    "type": "boolean"
   },
   "found": {
    "type": "boolean"
   },
   "is_news_meme": {
    "type": "boolean"
   },
   "mint": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "news_headline": {
    "nullable": true,
    "type": "string"
   },
   "oracle": {
    "description": "Fused Oracle conviction score (null if the Oracle engine has not yet scored this coin). Call get_oracle_conviction for the full read including who's-in roster and narrative.",
    "nullable": true,
    "properties": {
     "badges": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "pillars": {
      "description": "Per-pillar scores: pedigree, structure, narrative, momentum (each 0\u2013100).",
      "type": "object"
     },
     "reasons": {
      "description": "Natural-language explanation of the score.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "score": {
      "description": "0\u2013100 fused Oracle score.",
      "type": "number"
     },
     "tier": {
      "enum": [
       "prime",
       "strong",
       "lean",
       "watch",
       "avoid"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "oracle_url": {
    "description": "Oracle deep-link for the coin \u2014 opens the Oracle war-room drawer directly.",
    "type": "string"
   },
   "organic_score": {
    "description": "0\u20131, organic-demand likelihood.",
    "type": "number"
   },
   "outcome": {
    "description": "Labeled outcome if available (graduated, ath_multiple, etc).",
    "nullable": true,
    "type": "object"
   },
   "quality_score": {
    "description": "0\u2013100 composite quality.",
    "type": "number"
   },
   "risk_flags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "smart_money_count": {
    "description": "Proven wallets (score\u226565) in this coin.",
    "type": "integer"
   },
   "smart_money_notable": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "smart_money_score": {
    "nullable": true,
    "type": "number"
   },
   "symbol": {
    "type": "string"
   },
   "unique_buyers": {
    "type": "integer"
   },
   "verdict": {
