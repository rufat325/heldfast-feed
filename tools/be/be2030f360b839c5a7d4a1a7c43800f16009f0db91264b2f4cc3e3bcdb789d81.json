{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submits a free rental evaluation request to KEILTY on the owner's behalf. KEILTY then contacts the owner directly. Only call this with the owner's explicit consent to share their contact details, and only once per property. The owner signs any agreement personally; this request commits them to nothing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_name": {
    "description": "Name of the AI agent or app submitting, e.g. ChatGPT",
    "maxLength": 120,
    "type": "string"
   },
   "bedrooms": {
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "city": {
    "maxLength": 80,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 200,
    "type": "string"
   },
   "first_name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "last_name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Anything else the owner wants KEILTY to know",
    "maxLength": 1500,
    "type": "string"
   },
   "owner_consent": {
    "description": "Must be true: the owner has agreed to share these details with KEILTY and to be contacted.",
    "type": "boolean"
   },
   "phone": {
    "description": "Mobile number, digits with optional +1",
    "maxLength": 30,
    "type": "string"
   },
   "property_address": {
    "maxLength": 300,
    "type": "string"
   },
   "property_status": {
    "enum": [
     "vacant",
     "resident_in_place",
     "owner_lives_there",
     "closing_soon"
    ],
    "type": "string"
   },
   "property_type": {
    "enum": [
     "single_family",
     "condo",
     "duplex_to_fourplex",
     "apartment_building",
     "student_house",
     "portfolio",
     "commercial"
    ],
    "type": "string"
   },
   "service_wanted": {
    "enum": [
     "full_service",
     "lease_up_mandate",
     "not_sure"
    ],
    "type": "string"
   },
   "units": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "first_name",
   "last_name",
   "email",
   "phone",
   "city",
   "property_type",
   "owner_consent"
  ],
  "type": "object"
 },
 "name": "request_rental_evaluation",
 "title": "Request a free rental evaluation for an owner"
}
