     "type": "string"
    },
    "type": "array"
   },
   "omit_io": {
    "default": false,
    "description": "Drop the inputs/outputs lists from the result to save context.",
    "type": "boolean"
   },
   "path": {
    "description": "Full path of the node to inspect.",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
