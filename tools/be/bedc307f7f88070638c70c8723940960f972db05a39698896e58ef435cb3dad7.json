{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare Styles Tool"
 },
 "description": "Compares two Mapbox styles and reports differences in structure, layers, sources, and properties",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ignoreMetadata": {
    "description": "Ignore metadata fields like id, owner, created, modified",
    "type": "boolean"
   },
   "styleA": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "First Mapbox style (JSON string or style object)"
   },
   "styleB": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Second Mapbox style (JSON string or style object)"
   }
  },
  "required": [
   "styleA",
   "styleB"
  ],
  "type": "object"
 },
 "name": "compare_styles_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "differences": {
    "description": "List of differences found",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "Human-readable description",
       "type": "string"
      },
      "path": {
       "description": "JSON path to the difference",
       "type": "string"
      },
      "type": {
       "description": "Type of difference",
       "enum": [
        "added",
        "removed",
        "modified"
       ],
       "type": "string"
      },
      "valueA": {
       "description": "Value in style A (if exists)"
      },
      "valueB": {
       "description": "Value in style B (if exists)"
      }
     },
     "required": [
      "path",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "identical": {
    "description": "Whether the styles are identical",
    "type": "boolean"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Summary of differences",
    "properties": {
     "added": {
      "description": "Number of additions in style B",
      "type": "number"
     },
     "modified": {
      "description": "Number of modifications",
      "type": "number"
     },
     "removed": {
      "description": "Number of removals from style A",
      "type": "number"
     },
     "totalDifferences": {
      "description": "Total number of differences",
      "type": "number"
     }
    },
    "required": [
     "totalDifferences",
     "added",
     "removed",
     "modified"
    ],
    "type": "object"
   }
  },
  "required": [
   "identical",
   "differences",
   "summary"
  ],
  "type": "object"
 },
 "title": "Compare Styles Tool"
}
