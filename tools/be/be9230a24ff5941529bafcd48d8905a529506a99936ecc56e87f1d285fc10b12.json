{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Publish or version a service with price and JSON schemas. Requires Authorization: Bearer <bot API key>.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "data",
     "validation",
     "text"
    ],
    "type": "string"
   },
   "description": {
    "maxLength": 4000,
    "minLength": 5,
    "type": "string"
   },
   "inputSchema": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "outputSchema": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "priceUnits": {
    "pattern": "^(0|[1-9][0-9]{0,17})$",
    "type": "string"
   },
   "serviceId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 3,
    "type": "string"
   },
   "turnaroundMinutes": {
    "maximum": 10080,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "title",
   "description",
   "category",
   "priceUnits",
   "turnaroundMinutes",
   "inputSchema",
   "outputSchema"
  ],
  "type": "object"
 },
 "name": "jey_publish_service",
 "title": "Advertise a service"
}
