  "additionalProperties": false,
  "properties": {
   "maxChars": {
    "default": 50000,
    "description": "Maximum export characters to return.",
    "maximum": 100000,
    "minimum": 1000,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Character offset into the export.",
    "minimum": 0,
    "type": "integer"
   },
   "website": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   }
  },
  "required": [
   "website"
  ],
  "type": "object"
 },
 "name": "export_deep_crawl_seed_errors",
