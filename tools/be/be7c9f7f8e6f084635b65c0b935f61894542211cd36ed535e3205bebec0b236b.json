{
 "description": "ONE-CALL Performance Max \"campaign builder\": creates a PERFORMANCE_MAX campaign + dedicated budget + an asset group with the required assets (3-15 headlines \u226430, 1 long headline \u226490, 2-5 descriptions \u226490, business name, and marketing/square/logo images by URL), then Google's AI auto-optimizes across Search/Display/YouTube/Gmail. Defaults PAUSED so you review first. This is the closest programmatic equivalent to Google's AI Campaign Builder. Refs #5764.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "businessName": {
    "description": "Business name (\u226425 chars), e.g. \"AINative Studio\".",
    "maxLength": 25,
    "type": "string"
   },
   "customerId": {
    "description": "Google Ads customer ID. Defaults to GOOGLE_ADS_CUSTOMER_ID env var.",
    "type": "string"
   },
   "dailyBudgetUsd": {
    "description": "Daily budget in USD.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "descriptions": {
    "description": "2\u20135 descriptions, each \u226490 chars.",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   },
   "finalUrl": {
    "description": "Landing page URL.",
    "type": "string"
   },
   "headlines": {
    "description": "3\u201315 headlines, each \u226430 chars.",
    "items": {
     "type": "string"
    },
    "maxItems": 15,
    "minItems": 3,
    "type": "array"
   },
   "logoImageUrl": {
    "description": "Square logo URL (\u2265128x128, 1:1).",
    "type": "string"
   },
   "longHeadline": {
    "description": "One long headline \u226490 chars.",
    "maxLength": 90,
    "type": "string"
   },
   "marketingImageUrl": {
    "description": "Landscape 1.91:1 marketing image URL (\u2265600x314).",
    "type": "string"
   },
   "name": {
    "description": "Campaign name (also names the budget + asset group).",
    "type": "string"
   },
   "squareImageUrl": {
    "description": "Square 1:1 marketing image URL (\u2265300x300).",
    "type": "string"
   },
   "status": {
    "default": "PAUSED",
    "description": "Default PAUSED.",
    "enum": [
     "ENABLED",
     "PAUSED"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "dailyBudgetUsd",
   "finalUrl",
   "businessName",
   "headlines",
   "longHeadline",
   "descriptions",
   "marketingImageUrl",
   "squareImageUrl",
   "logoImageUrl"
  ],
  "type": "object"
 },
 "name": "gads_create_pmax_campaign"
}
