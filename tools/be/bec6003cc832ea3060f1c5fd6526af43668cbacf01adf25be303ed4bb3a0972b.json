{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan a cluster"
 },
 "description": "Every way of splitting the training across a cluster that fits, least demanding first. Prices data, tensor, pipeline and expert parallelism, the four ZeRO stages, sequence parallelism and the three recompute settings. Memory is the claim and it is arithmetic; which plan is fastest is not claimed, so each one carries a note about what it costs to run.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "B": {
    "description": "Micro-batch size.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "S": {
    "description": "Source length, for an encoder-decoder: the second sequence its encoder runs along. Defaults to the document's own S; ignored by a design that declares none.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "T": {
    "description": "Sequence length. Defaults to the document's own T.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "concurrency": {
    "description": "Concurrent sequences when serving.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   },
   "dp": {
    "description": "Data parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "dtype": {
    "description": "Training dtype. Default bf16.",
    "enum": [
     "fp32",
     "bf16",
     "fp16",
     "fp8"
    ],
    "type": "string"
   },
   "ep": {
    "description": "Expert parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gpus": {
    "description": "How many devices there are.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gpus_per_node": {
    "description": "Bounds the tensor-parallel degree. Default 8.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "hardware": {
    "description": "Hardware id: h100-sxm, h200-sxm, b200, a100-80, rtx5080 or rtx4090. Default h100-sxm.",
    "type": "string"
   },
   "headroom": {
    "description": "Fraction of device memory left free. Default 0.1.",
    "exclusiveMinimum": 0,
    "maximum": 0.9,
    "type": "number"
   },
   "limit": {
    "description": "How many plans to return. Default 8.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "mfu": {
    "description": "Model FLOPs utilization, 0..1.",
    "exclusiveMinimum": 0,
    "maximum": 1,
    "type": "number"
   },
   "optimizer": {
    "enum": [
     "adamw",
     "adamw8bit",
     "muon",
     "sgd_momentum",
     "sgd",
     "bf16_adam"
    ],
    "type": "string"
   },
   "packing": {
    "description": "Training rows packed with documents, for a design whose mask keeps them apart (doc(b, q) == doc(b, kv)). Moves the training figures and the cost, not serving.",
    "properties": {
     "mean": {
      "description": "Mean document length, in tokens.",
      "minimum": 1,
      "type": "number"
     },
     "spread": {
      "description": "Coefficient of variation of the lengths: 0, the default, is fixed; 1 is exponential.",
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "mean"
    ],
    "type": "object"
   },
   "pp": {
    "description": "Pipeline parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "recompute": {
    "enum": [
     "none",
     "selective",
     "full"
    ],
    "type": "string"
   },
   "tokens": {
    "description": "Training token budget. Defaults to Chinchilla-optimal.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "tp": {
    "description": "Tensor parallel degree.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "zero": {
    "description": "ZeRO/FSDP sharding stage.",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "design_id",
   "gpus"
  ],
  "type": "object"
 },
 "name": "tensorcad_plan",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "budget_bytes": {
    "type": "number"
   },
   "closest": {
    "additionalProperties": false,
    "properties": {
     "per_gpu_bytes": {
      "type": "number"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "summary",
     "per_gpu_bytes"
    ],
    "type": "object"
   },
   "considered": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "design_id": {
    "type": "string"
   },
   "fits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dp": {
       "type": "number"
      },
      "ep": {
       "type": "number"
      },
      "notes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "per_gpu_bytes": {
       "type": "number"
      },
      "pp": {
       "type": "number"
      },
      "recompute": {
       "type": "string"
      },
      "sequence_parallel": {
       "type": "boolean"
      },
      "summary": {
       "type": "string"
      },
      "tp": {
       "type": "number"
      },
      "used": {
       "type": "number"
      },
      "zero": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "summary",
      "dp",
      "tp",
      "pp",
      "ep",
      "zero",
      "sequence_parallel",
      "recompute",
      "per_gpu_bytes",
      "used",
      "notes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hardware": {
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "design_id",
   "revision",
   "hardware",
   "budget_bytes",
   "considered",
   "fits",
   "notes"
  ],
  "type": "object"
 },
 "title": "Plan a cluster"
}
