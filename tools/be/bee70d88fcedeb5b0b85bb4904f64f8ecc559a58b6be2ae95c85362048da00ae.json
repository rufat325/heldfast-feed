{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Market snapshot"
 },
 "description": "Returns the most recent 4h candles for one scanned symbol, a summary of those inside the last 24h, and the scanner's status. Use it when you need the candle series or data freshness (data_age_seconds); for just the price and window statistics, get_ticker is lighter. limit counts candles back from the newest (100 is about 16 days); the summary covers only returned candles within 24h, so a small limit narrows it. Read from the scanner's in-memory buffer, not a live exchange call: a symbol outside the scanned universe returns an error, and one whose candles are not loaded yet (e.g. just after a restart) returns an error saying to retry after the next scan. No key needed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 100,
    "description": "Most recent candles returned.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "symbol": {
    "description": "Pair to read, e.g. ETHUSDT. Must be in the scanned universe.",
    "maxLength": 24,
    "minLength": 6,
    "pattern": "^[A-Z0-9]{2,20}USDT$",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_market_snapshot",
 "outputSchema": {
  "properties": {
   "candle_count": {
    "description": "Candles returned.",
    "type": [
     "integer",
     "null"
    ]
   },
   "candles": {
    "description": "The most recent limit candles.",
    "items": {
     "description": "One candle.",
     "properties": {
      "close": {
       "description": "Close.",
