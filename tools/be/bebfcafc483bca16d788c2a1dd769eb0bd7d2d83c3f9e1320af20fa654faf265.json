{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Assess backlog health: high/low priority ratio, open ticket count, total cost. highToLowRatio is null when no open ticket is low priority, also when there are no open tickets.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "threshold": {
    "description": "High priority threshold, greater than 0 (default 1.5), compared with the exact value/cost, not the rounded priority",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "report_health",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "doneTickets": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "highPriorityCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "highToLowRatio": {
    "type": [
     "number",
     "null"
    ]
   },
   "lowPriorityCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "openTickets": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "totalBacklogCost": {
    "type": "number"
   },
   "totalTickets": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "totalTickets",
   "doneTickets",
   "openTickets",
   "highPriorityCount",
   "lowPriorityCount",
   "highToLowRatio",
   "totalBacklogCost"
  ],
  "type": "object"
 }
}
