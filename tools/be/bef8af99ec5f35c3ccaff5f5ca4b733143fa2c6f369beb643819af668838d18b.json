{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Start a synthetic asynchronous sandbox job that exercises the Idempotency-Key and 202-then-poll pattern of the write API without touching real auctions, ads or money. Poll it with get_sandbox_job.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "description": "Client-chosen key; the same key always returns the same jobId.",
    "maxLength": 255,
    "minLength": 1,
    "pattern": "^[\\x21-\\x7e]+$",
    "type": "string"
   }
  },
  "required": [
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "create_sandbox_job",
 "outputSchema": {
  "anyOf": [
   {
    "properties": {
     "jobId": {
      "pattern": "^sbx_[0-9a-f]{16}$",
      "type": "string"
     },
     "result": {
      "properties": {
       "data": {
        "additionalProperties": false,
        "properties": {
         "advertiser": {
          "type": "string"
         },
         "canonicalUrl": {
          "format": "uri",
          "type": "string"
         },
         "contentType": {
          "enum": [
           "paid_advertisement",
           "house_advertisement"
          ],
          "type": "string"
         },
         "day": {
          "description": "Settled auction date in UTC, YYYY-MM-DD.",
          "format": "date",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "headline": {
          "type": "string"
         }
        },
        "required": [
         "day",
         "headline",
         "description",
         "advertiser",
         "canonicalUrl",
         "contentType"
        ],
        "type": "object"
       },
       "sandbox": {
        "const": true
       }
      },
      "required": [
       "sandbox",
       "data"
      ],
      "type": "object"
     },
     "sandbox": {
      "const": true
     },
     "status": {
      "enum": [
       "queued",
       "completed"
      ],
      "type": "string"
     },
     "statusUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "sandbox",
     "jobId",
     "status",
     "statusUrl"
    ],
    "type": "object"
   },
   {
    "properties": {
     "detail": {
      "type": "string"
     },
     "docs": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "type",
     "title",
     "status",
     "detail"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Create sandbox job"
}
