{
 "_meta": {
  "openai/outputTemplate": "ui://widget/hapticpaper.html",
  "openai/toolInvocation/invoked": "Worker operation complete",
  "openai/toolInvocation/invoking": "Managing workers",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "workers:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "description": "Find and view worker profiles. Actions: search, get_profile. Use this to find talent or check worker details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Find and view worker profiles. Actions: search (requires taskDescription), get_profile (requires workerId), update_profile, manage_skills, manage_certifications.",
  "properties": {
   "action": {
    "description": "Action to perform on the workers resource",
    "enum": [
     "search",
     "get_profile",
     "update_profile",
     "manage_skills",
     "manage_certifications"
    ],
    "type": "string"
   },
   "availabilityStatus": {
    "description": "Current availability",
    "enum": [
     "available",
     "busy",
     "offline"
    ],
    "type": "string"
   },
   "bio": {
    "description": "Worker bio",
    "type": "string"
   },
   "certExpiresAt": {
    "type": "string"
   },
   "certIssuedAt": {
    "type": "string"
   },
   "certIssuer": {
    "type": "string"
   },
   "certName": {
    "type": "string"
   },
   "hourlyRate": {
    "description": "Hourly rate in USD",
    "type": "number"
   },
   "itemId": {
    "description": "ID of skill/cert/license to delete",
    "format": "uuid",
    "type": "string"
   },
   "limit": {
    "description": "Max number of records",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "type": "string"
     },
     "radiusMiles": {
      "default": 10,
      "type": "number"
     }
    },
    "required": [
     "address"
    ],
    "type": "object"
   },
   "maxRate": {
    "description": "Maximum hourly rate",
    "minimum": 0,
    "type": "number"
   },
   "minRating": {
    "description": "Minimum star rating",
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "proficiencyLevel": {
    "type": "string"
   },
   "skillName": {
    "type": "string"
   },
   "skills": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "subAction": {
    "description": "Add or delete sub-item",
    "enum": [
     "add",
     "delete"
    ],
    "type": "string"
   },
   "taskDescription": {
    "description": "Description of what needs to be done",
    "type": "string"
   },
   "workerId": {
    "description": "Worker ID to retrieve profile",
    "format": "uuid",
    "type": "string"
   },
   "yearsExperience": {
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "workers",
 "title": "Manage Workers"
}
