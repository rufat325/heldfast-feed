{
 "description": "Calculate D&D 5e overland travel time, pace effects, and forced march consequences. Uses SRD travel rules for pace, terrain, and exhaustion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "distance_miles": {
    "description": "Distance to travel in miles",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "hours_per_day": {
    "default": 8,
    "description": "Hours of travel per day (forced march beyond 8)",
    "maximum": 24,
    "minimum": 1,
    "type": "number"
   },
   "mounted": {
    "default": false,
    "description": "Whether the party is mounted (gallop available for 1 hour)",
    "type": "boolean"
   },
   "pace": {
    "default": "normal",
    "description": "Travel pace",
    "enum": [
     "slow",
     "normal",
     "fast"
    ],
    "type": "string"
   },
   "terrain": {
    "default": "normal",
    "description": "Terrain type (difficult terrain halves speed)",
    "enum": [
     "normal",
     "difficult"
    ],
    "type": "string"
   }
  },
  "required": [
   "distance_miles"
  ],
  "type": "object"
 },
 "name": "travel_calculator"
}
