{
 "description": "Create a note in Karbon, optionally linked to work items, contacts, organizations, or client groups via timelines. Notes linked to a work item also appear on the client's timeline.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "AssigneeEmailAddress": {
    "description": "Assign the note as a to-do for this Karbon user",
    "type": "string"
   },
   "AuthorEmailAddress": {
    "description": "Email address of the Karbon user authoring the note",
    "type": "string"
   },
   "Body": {
    "description": "Note body (supports basic HTML)",
    "type": "string"
   },
   "DueDate": {
    "description": "ISO 8601 date",
    "type": "string"
   },
   "Subject": {
    "type": "string"
   },
   "Timelines": {
    "description": "Entities to link this note to",
    "items": {
     "additionalProperties": false,
     "properties": {
      "EntityKey": {
       "type": "string"
      },
      "EntityType": {
       "enum": [
        "WorkItem",
        "Contact",
        "Organization",
        "ClientGroup"
       ],
       "type": "string"
      }
     },
     "required": [
      "EntityType",
      "EntityKey"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "TodoDate": {
    "description": "ISO 8601 date",
    "type": "string"
   }
  },
  "required": [
   "Subject",
   "Body",
   "AuthorEmailAddress"
  ],
  "type": "object"
 },
 "name": "create_note",
 "title": "Create note"
}
