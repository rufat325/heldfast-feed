{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Check access observations"
 },
 "description": "Look up source-labeled access evidence for one public hostname. Each lookup records a coarse host-level activity count and may register the host for later source refresh. A no_reports result means current access status is unknown; this tool does not visit the target site.",
 "inputSchema": {
  "properties": {
   "error_class": {
    "default": "",
    "title": "Error Class",
    "type": "string"
   },
   "failure_stage": {
    "default": "",
    "title": "Failure Stage",
    "type": "string"
   },
   "site_host": {
    "title": "Site Host",
    "type": "string"
   },
   "task_step": {
    "default": "",
    "title": "Task Step",
    "type": "string"
   }
  },
  "required": [
   "site_host"
  ],
  "title": "check_incidentArguments",
  "type": "object"
 },
 "name": "check_incident",
 "outputSchema": {
  "$defs": {
   "AttemptActor": {
    "enum": [
     "agent",
     "human"
    ],
    "title": "AttemptActor",
    "type": "string"
   },
   "AttemptEnv": {
    "enum": [
     "agent_cloud_browser",
     "human_in_agent_browser",
     "human_own_browser",
     "unknown"
    ],
    "title": "AttemptEnv",
    "type": "string"
   },
   "CheckObservation": {
    "additionalProperties": false,
    "properties": {
     "attempt_actor": {
      "$ref": "#/$defs/AttemptActor"
     },
     "attempt_env": {
      "$ref": "#/$defs/AttemptEnv"
     },
     "error_class": {
      "$ref": "#/$defs/ErrorClass"
     },
     "observed_at": {
      "format": "date-time",
      "title": "Observed At",
      "type": "string"
     },
     "outcome": {
      "$ref": "#/$defs/Outcome"
     },
     "synthetic": {
      "title": "Synthetic",
      "type": "boolean"
     },
     "task_step": {
      "title": "Task Step",
      "type": "string"
     }
    },
    "required": [
     "observed_at",
     "attempt_actor",
     "attempt_env",
     "outcome",
     "error_class",
     "task_step",
     "synthetic"
    ],
    "title": "CheckObservation",
    "type": "object"
   },
   "ErrorClass": {
    "enum": [
     "site_access",
     "login_auth",
     "human_verification",
     "service_error"
    ],
    "title": "ErrorClass",
    "type": "string"
   },
   "FailureStage": {
    "enum": [
     "before_target_response",
     "response_observed",
     "access_denial_observed",
     "unknown"
    ],
    "title": "FailureStage",
    "type": "string"
   },
   "LookupActivity": {
    "additionalProperties": false,
    "properties": {
     "period_days": {
      "const": 7,
      "title": "Period Days",
      "type": "integer"
     },
     "trend": {
      "anyOf": [
       {
        "const": "increased",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Trend"
     },
     "unit": {
      "const": "requests_not_agents",
      "default": "requests_not_agents",
      "title": "Unit",
      "type": "string"
     },
     "volume_band": {
      "enum": [
       "1-4",
       "5-9",
       "10-49",
       "50+"
      ],
      "title": "Volume Band",
      "type": "string"
     }
    },
    "required": [
     "period_days",
     "volume_band"
    ],
    "title": "LookupActivity",
    "type": "object"
   },
   "NextCheck": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "locate_failure_stage",
       "human_handoff",
       "account_handoff",
       "before_target_response",
       "response_observed",
       "access_denial_observed",
       "provider_scope",
       "provider_clear",
       "provider_unknown",
       "reports_unknown",
       "reports_stale",
       "reports_unverified"
      ],
      "title": "Code",
      "type": "string"
     },
     "text": {
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "code",
     "text"
    ],
    "title": "NextCheck",
    "type": "object"
   },
   "OfficialStatusPage": {
    "additionalProperties": false,
    "properties": {
     "source_name": {
      "title": "Source Name",
      "type": "string"
     },
     "source_url": {
      "title": "Source Url",
      "type": "string"
     }
    },
    "required": [
     "source_name",
     "source_url"
    ],
    "title": "OfficialStatusPage",
    "type": "object"
   },
   "Outcome": {
    "enum": [
     "passed",
     "blocked",
     "error",
     "abandoned"
    ],
    "title": "Outcome",
    "type": "string"
   },
   "ProviderStatus": {
    "additionalProperties": false,
    "properties": {
     "fetched_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Fetched At"
     },
     "freshness": {
      "enum": [
       "pending",
       "fresh",
       "stale"
      ],
      "title": "Freshness",
      "type": "string"
     },
     "indicator": {
      "anyOf": [
       {
        "enum": [
         "none",
         "minor",
         "major",
         "critical",
         "unknown"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Indicator"
     },
     "source_name": {
      "title": "Source Name",
      "type": "string"
     },
     "source_updated_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Source Updated At"
     },
     "source_url": {
      "title": "Source Url",
      "type": "string"
     }
    },
    "required": [
     "source_name",
     "source_url",
     "indicator",
     "fetched_at",
     "source_updated_at",
     "freshness"
    ],
    "title": "ProviderStatus",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "current_site_status": {
    "const": "unknown",
    "title": "Current Site Status",
    "type": "string"
   },
   "data_horizon_hours": {
    "const": 168,
    "title": "Data Horizon Hours",
    "type": "integer"
   },
   "evidence_level": {
    "enum": [
     "no_reports",
     "single_observation",
     "multiple_observations",
     "later_success_observed",
     "stale_reports"
    ],
    "title": "Evidence Level",
    "type": "string"
   },
   "failure_stage": {
    "anyOf": [
     {
      "$ref": "#/$defs/FailureStage"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "failures": {
    "minimum": 0,
    "title": "Failures",
    "type": "integer"
   },
   "generated_at": {
    "format": "date-time",
    "title": "Generated At",
    "type": "string"
   },
   "lookup_activity": {
    "anyOf": [
     {
      "$ref": "#/$defs/LookupActivity"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "next_checks": {
    "items": {
     "$ref": "#/$defs/NextCheck"
    },
    "title": "Next Checks",
    "type": "array"
   },
   "observations": {
    "items": {
     "$ref": "#/$defs/CheckObservation"
    },
    "title": "Observations",
    "type": "array"
   },
   "official_status_page": {
    "anyOf": [
     {
      "$ref": "#/$defs/OfficialStatusPage"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "provider_discovery_attempted_at": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Provider Discovery Attempted At"
   },
   "provider_source_state": {
    "enum": [
     "feed_connected",
     "official_page_only",
     "not_verified_by_current_methods"
    ],
    "title": "Provider Source State",
    "type": "string"
   },
   "provider_status": {
    "anyOf": [
     {
      "$ref": "#/$defs/ProviderStatus"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "reporting_sources": {
    "minimum": 0,
    "title": "Reporting Sources",
    "type": "integer"
   },
   "site_host": {
    "title": "Site Host",
    "type": "string"
   },
   "successes": {
    "minimum": 0,
    "title": "Successes",
    "type": "integer"
   },
   "summary": {
    "title": "Summary",
    "type": "string"
   },
   "summary_code": {
    "title": "Summary Code",
    "type": "string"
   },
   "synthetic": {
    "title": "Synthetic",
    "type": "boolean"
   },
   "window_hours": {
    "maximum": 168,
    "minimum": 1,
    "title": "Window Hours",
    "type": "integer"
   }
  },
  "required": [
   "site_host",
   "generated_at",
   "synthetic",
   "window_hours",
   "data_horizon_hours",
   "current_site_status",
   "evidence_level",
   "summary_code",
   "summary",
   "failures",
   "successes",
   "reporting_sources",
   "observations",
   "provider_source_state"
  ],
  "title": "CheckResponse",
  "type": "object"
 }
}
