  "properties": {
   "attachmentId": {
    "description": "Attachment id",
    "type": [
     "string",
     "number"
    ]
   },
   "filename": {
    "description": "Stored file name (auto-resolved if omitted)",
    "type": "string"
   },
   "issueId": {
    "description": "Issue key or id",
    "type": "string"
   }
  },
  "required": [
   "issueId",
   "attachmentId"
  ],
  "type": "object"
 },
 "name": "download_issue_attachment"
}
