 },
 "description": "SuggestConnections reports providers the company is evidently already paying for, judged from its own transactions, and skips any it has already connected. Read-only \u2014 it writes nothing. Connect one with StartConnection.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connection_suggest_connections",
 "outputSchema": {
  "properties": {
   "suggestions": {
    "items": {
     "properties": {
      "displayName": {
       "type": "string"
      },
      "matchedTransactionCount": {
       "type": "integer"
      },
      "matchedTransactionIds": {
       "items": {
        "description": "UUID value wrapper.",
        "properties": {
         "value": {
          "format": "uuid",
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "provider": {
       "enum": [
        "PROVIDER_UNSPECIFIED",
        "PROVIDER_PLAID",
        "PROVIDER_STRIPE",
        "PROVIDER_RAMP",
        "PROVIDER_GOOGLE_ADS",
        "PROVIDER_META_ADS",
        "PROVIDER_MERCURY",
        "PROVIDER_GMAIL",
        "PROVIDER_SLACK",
        "PROVIDER_TIKTOK_ADS",
        "PROVIDER_SHOPIFY",
        "PROVIDER_HUBSPOT",
        "PROVIDER_X_ADS",
        "PROVIDER_DOCUSIGN"
       ],
       "type": "string"
      },
      "rationale": {
       "type": "string"
      },
      "sampleCounterpartyName": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Suggest Connections"
}
