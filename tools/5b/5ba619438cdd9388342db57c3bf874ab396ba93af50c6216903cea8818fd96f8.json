{
 "description": "Describe gRPC services, methods, or message symbols using server reflection or local .proto files.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "request metadata headers",
    "type": "object"
   },
   "import_paths": {
    "description": "proto import paths",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "plaintext": {
    "description": "use plaintext HTTP/2 instead of TLS",
    "type": "boolean"
   },
   "proto_files": {
    "description": "paths to .proto files",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "symbol": {
    "description": "fully-qualified symbol to describe, for example helloworld.Greeter/SayHello or package.Service",
    "type": "string"
   },
   "target": {
    "description": "host:port, for example localhost:50051",
    "type": "string"
   },
   "timeout_ms": {
    "description": "timeout in milliseconds",
    "type": "integer"
   },
   "use_reflection": {
    "description": "use gRPC server reflection",
    "type": "boolean"
   }
  },
  "required": [
   "target",
   "plaintext",
   "use_reflection"
  ],
  "type": "object"
 },
 "name": "grpc_describe",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "symbols": {
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   }
  },
  "required": [
   "description",
   "symbols"
  ],
  "type": "object"
 }
}
