{
 "annotations": {
  "readOnlyHint": true,
  "title": "Query any Deputy resource"
 },
 "description": "Run a Resource API search on any business object (leave types, pay rules, public holidays, memos, events, shift templates, pay lines, availability, sales data, \u2026). `search` is Deputy's clause map, e.g. {\"s1\":{\"field\":\"Employee\",\"data\":12,\"type\":\"eq\"}}; operators: eq ne gt lt ge le is 'is not' in 'not in' starts contains. Use deputy_describe_resource to see an object's fields and joins. Read-only. Deputy: POST /api/v1/resource/{Object}/QUERY.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "join": {
    "description": "Related objects to expand inline, e.g. [\"TimesheetObject\"] on TimesheetPayReturn.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max": {
    "description": "Page size, 1-500 (Deputy's cap). Default 100.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "object": {
    "description": "Resource API object. Deputy names: Company = location, OperationalUnit = area, Roster = shift, LeaveRules = leave types, TimesheetPayReturn = approved pay lines.",
    "enum": [
     "Address",
     "Category",
     "Comment",
     "Company",
     "CompanyPeriod",
     "Contact",
     "Country",
     "CustomField",
     "CustomFieldData",
     "Employee",
     "EmployeeAgreement",
     "EmployeeAgreementHistory",
     "EmployeeAppraisal",
     "EmployeeAvailability",
     "EmployeeContractedHours",
     "EmployeeHistory",
     "EmployeePaycycle",
     "EmployeePaycycleReturn",
     "EmployeeRole",
     "EmployeeWorkplace",
     "EmploymentCondition",
     "EmploymentContract",
     "EmploymentContractLeaveRules",
     "Event",
     "Journal",
     "Leave",
     "LeaveAccrual",
     "LeavePayLine",
     "LeaveRules",
     "Memo",
     "OperationalUnit",
     "PayPeriod",
     "PayRules",
     "PublicHoliday",
     "Roster",
     "RosterOpen",
     "RosterSwap",
     "RosterTemplate",
     "SalesData",
     "Schedule",
     "ShiftTemplate",
     "State",
     "StressProfile",
     "Task",
     "TaskGroup",
     "TaskSetup",
     "Team",
     "Timesheet",
     "TimesheetExport",
     "TimesheetPayReturn",
     "TimesheetPayReturnDetail",
     "TrainingModule",
     "TrainingRecord"
    ],
    "type": "string"
   },
   "search": {
    "additionalProperties": {
     "properties": {
      "data": {
       "description": "Comparison value; type depends on the field."
      },
      "field": {
       "description": "Field name, e.g. Employee, Date, StartTime.",
       "type": "string"
      },
      "type": {
       "description": "Comparison operator.",
       "enum": [
        "eq",
        "ne",
        "gt",
        "lt",
        "ge",
        "le",
        "is",
        "is not",
        "in",
        "not in",
        "starts",
        "contains"
       ],
       "type": "string"
      }
     },
     "required": [
      "field",
      "data",
      "type"
     ],
     "type": "object"
    },
    "description": "Clauses keyed by any id (s1, s2, \u2026). All must match.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "sort": {
    "additionalProperties": {
     "enum": [
      "asc",
      "desc"
     ],
     "type": "string"
    },
    "description": "Field \u2192 asc/desc, e.g. {\"Id\":\"desc\"}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "start": {
    "description": "Pagination offset (0-based). Pass the previous page's next_start.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "object"
  ],
  "type": "object"
 },
 "name": "deputy_query_resource",
 "title": "Query any Deputy resource"
}
