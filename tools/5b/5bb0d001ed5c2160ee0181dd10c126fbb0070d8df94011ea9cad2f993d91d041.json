{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get one release"},"description":"One release by id (e.g. 'claude-code-2.1.183', canonical 'claude-code@2.1.183') or by tool + version ('latest' allowed). detail=full (the default for a bare id lookup, as before) includes complete release notes; brief/standard omit them unless include_raw_notes is true.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"detail":{"description":"brief (default) omits infographics and raw notes; standard adds evidence and links; full adds complete release notes.","enum":["brief","standard","full"],"type":"string"},"id":{"description":"Canonical (tool@version) or legacy (tool-version) release id","type":"string"},"include_raw_notes":{"description":"Include the full upstream notes in any detail mode","type":"boolean"},"tool":{"description":"Tool id (fuzzy), used with version","type":"string"},"version":{"description":"Semver or 'latest'","type":"string"}},"type":"object"},"name":"get_release","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"dataset_updated_at":{"type":["string","null"]},"estimated_tokens":{"type":"integer"},"freshness_note":{"type":["string","null"]},"next_cursor":{"type":["string","null"]},"object":{"type":"string"},"omitted":{"additionalProperties":{"type":"integer"},"type":"object"},"release":{"additionalProperties":true,"properties":{"changes_available":{"type":"boolean"},"date":{"type":"string"},"id":{"type":"string"},"tool":{"type":"string"},"version":{"type":"string"}},"required":["id","tool","version","date"],"type":"object"},"truncated":{"type":"boolean"}},"required":["object","truncated","next_cursor","release"],"type":"object"},"title":"Get one release"}
