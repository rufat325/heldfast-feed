{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a refund event to Google Analytics.\n\nEcommerce event for full or partial refunds. Omit 'items' for a full refund;\ninclude them (with quantities) for a partial refund. Use the same transaction_id\nas the original purchase.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client_id": {
    "type": "string"
   },
   "currency": {
    "description": "Currency code",
    "type": "string"
   },
   "items": {
    "description": "Refunded items (only for partial refunds)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "affiliation": {
       "type": "string"
      },
      "coupon": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "discount": {
       "type": "number"
      },
      "index": {
       "type": "number"
      },
      "item_brand": {
       "type": "string"
      },
      "item_category": {
       "type": "string"
      },
      "item_category2": {
       "type": "string"
      },
      "item_category3": {
       "type": "string"
      },
      "item_category4": {
       "type": "string"
      },
      "item_category5": {
       "type": "string"
      },
      "item_id": {
       "type": "string"
      },
      "item_list_id": {
       "type": "string"
      },
      "item_list_name": {
       "type": "string"
      },
      "item_name": {
       "type": "string"
      },
      "item_variant": {
       "type": "string"
      },
      "location_id": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "quantity": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "transaction_id": {
    "description": "Transaction ID of the original purchase",
    "type": "string"
   },
   "user_id": {
    "type": "string"
   },
   "user_properties": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "value": {
       "type": [
        "string",
        "number"
       ]
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "description": "User properties (e.g., {subscription_tier: {value: \"premium\"}})",
    "type": "object"
   },
   "value": {
    "description": "Refunded amount",
    "type": "number"
   }
  },
  "required": [
   "transaction_id"
  ],
  "type": "object"
 },
 "name": "ga_send_refund"
}
