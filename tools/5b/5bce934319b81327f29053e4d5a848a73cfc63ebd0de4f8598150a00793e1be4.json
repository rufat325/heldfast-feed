{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Fill Input"
 },
 "description": "Clear an input field and set its value. Preferred over browser_type when replacing the full value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "selector": {
    "description": "CSS selector of the input element",
    "type": "string"
   },
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   },
   "value": {
    "description": "Value to fill in",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "selector",
   "value"
  ],
  "type": "object"
 },
 "name": "browser_fill"
}
