{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Apply an incremental SpecEvolution diff to a model, preserving live state. Returns the new version. Fails (isError) if the evolved spec is invalid, if expectedVersion no longer matches, or if a schema change would strand existing state. Prefer targeted diffs (upsertSchemaNodes/upsertSchemaDefs, upsertComponents, upsertConstants) over resending a whole section (newSchema/newViewDefinition/newConstants).",
 "inputSchema": {
  "properties": {
   "evolution": {
    "description": "A SpecEvolution document: newVersion/expectedVersion plus per-section upsert/remove lists. Schema tiers: upsertSchemaDefs/removeSchemaDefs (by $defs name), upsertSchemaNodes/removeSchemaNodes (by canonical data path), or newSchema (wholesale). View tiers: upsertViews/removeViews/newDefaultView, upsertComponents/removeComponents, or newViewDefinition. Constants: upsertConstants/removeConstants or newConstants.",
    "properties": {
     "backfill": {
      "type": "object"
     },
     "expectedVersion": {
      "type": "string"
     },
     "newConstants": {
      "type": "object"
     },
     "newDefaultView": {
      "type": "string"
     },
     "newLibrary": {
      "properties": {
       "define": {
        "type": "string"
       },
       "signatures": {
        "type": "object"
       }
      },
      "required": [
       "define"
      ],
      "type": "object"
     },
     "newSchema": {
      "type": "object"
     },
     "newVersion": {
      "type": "string"
     },
     "newViewDefinition": {
      "type": "object"
     },
     "removeComponents": {
      "items": {
       "properties": {
        "componentId": {
         "type": "string"
        },
        "viewId": {
         "type": "string"
        }
       },
       "required": [
        "viewId",
        "componentId"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "removeConstants": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeConstraints": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeDefaultValues": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeDerivations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeEffects": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeMetaDerivations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeSchemaDefs": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeSchemaNodes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "removeViews": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "upsertComponents": {
      "items": {
       "properties": {
        "beforeId": {
         "type": "string"
        },
        "component": {
         "type": "object"
        },
        "parentId": {
         "type": "string"
        },
        "viewId": {
         "type": "string"
        }
       },
       "required": [
        "viewId",
        "component"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertConstants": {
      "type": "object"
     },
     "upsertConstraints": {
      "items": {
       "properties": {
        "expr": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "policy": {
         "enum": [
          "rollback",
          "flag"
         ],
         "type": "string"
        }
       },
       "required": [
        "id",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertDefaultValues": {
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "expr": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertDerivations": {
      "items": {
       "properties": {
        "evaluation": {
         "enum": [
          "eager",
          "lazy"
         ],
         "type": "string"
        },
        "expr": {
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertEffects": {
      "items": {
       "properties": {
        "afterMs": {
         "type": "string"
        },
        "at": {
         "type": "string"
        },
        "dedupeKey": {
         "type": "string"
        },
        "emit": {
         "type": "string"
        },
        "executor": {
         "enum": [
          "caller",
          "server",
          "llm",
          "timer"
         ],
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "payload": {
         "type": "object"
        },
        "policy": {
         "type": "object"
        },
        "prompt": {
         "type": "string"
        },
        "request": {
         "type": "object"
        },
        "requests": {
         "type": "string"
        },
        "response": {
         "type": "object"
        },
        "responseSchema": {
         "type": "object"
        },
        "statusPath": {
         "type": "string"
        },
        "trigger": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "executor",
        "trigger"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertMetaDerivations": {
      "items": {
       "properties": {
        "expr": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "property": {
         "type": "string"
        }
       },
       "required": [
        "path",
        "property",
        "expr"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertSchemaDefs": {
      "type": "object"
     },
     "upsertSchemaNodes": {
      "items": {
       "properties": {
        "path": {
         "type": "string"
        },
        "required": {
         "type": "boolean"
        },
        "schema": {
         "type": "object"
        }
       },
       "required": [
        "path",
        "schema"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "upsertViews": {
      "items": {
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "The model id.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "evolution"
  ],
  "type": "object"
 },
 "name": "evolve_spec",
 "outputSchema": {
  "properties": {
   "id": {
    "description": "The evolved model id.",
    "type": "string"
   },
   "version": {
    "description": "The model's new version after evolution.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Evolve spec"
}
