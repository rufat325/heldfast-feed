{
 "description": "[tourradar] Use this when the user asks about available departure dates, pricing for specific dates, or needs to validate if a departure date is available.\n\nReturns a list of departures for a specific tour within a date range, including availability status, pricing, and booking information.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "currency": {
    "description": "Currency to return prices in. Use this only when the user explicitly asks for a specific currency. Otherwise the user's default (based on location) is used.",
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "AUD",
     "NZD",
     "CAD"
    ],
    "type": "string"
   },
   "dateRange": {
    "description": "Returns only departure dates in the desired range",
    "properties": {
     "end": {
      "description": "End date of the range",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
     },
     "start": {
      "description": "Start date of the range",
      "format": "date",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
      "type": "string"
     }
    },
    "required": [
     "start",
     "end"
    ],
    "type": "object"
   },
   "page": {
    "default": 1,
    "description": "Page number. Default is 1",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tourId": {
    "description": "Tour ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "tourId",
   "dateRange"
  ],
  "type": "object"
 },
 "name": "tourradar_b2b-tour-departures"
}
