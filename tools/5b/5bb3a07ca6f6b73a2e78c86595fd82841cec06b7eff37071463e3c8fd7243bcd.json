    "type": "string"
   },
   "method": {
    "default": "add_monsters",
    "description": "How to adjust difficulty",
    "enum": [
     "add_monsters",
     "remove_monsters",
     "adjust_hp",
     "add_minions"
    ],
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "targetDifficulty": {
