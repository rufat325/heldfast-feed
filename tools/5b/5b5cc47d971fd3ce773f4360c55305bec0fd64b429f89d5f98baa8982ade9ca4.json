  "properties": {
   "accountArr": {
    "description": "Account ARR",
    "type": "number"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "executiveSponsorStrength": {
    "description": "Executive sponsor strength, weight 20",
    "enum": [
     "positive",
     "flat",
     "negative"
    ],
    "type": "string"
   },
   "productAdoptionTrend": {
    "description": "Product adoption / usage trend, weight 30",
    "enum": [
     "positive",
     "flat",
     "negative"
    ],
    "type": "string"
   },
   "realisedValueVsGoals": {
    "description": "Realised value vs. goals, weight 30",
    "enum": [
     "positive",
     "flat",
     "negative"
    ],
    "type": "string"
   },
   "supportSentimentTrend": {
    "description": "Support sentiment / ticket trend, weight 20",
    "enum": [
     "positive",
     "flat",
     "negative"
    ],
    "type": "string"
   }
  },
  "required": [
   "productAdoptionTrend",
   "executiveSponsorStrength",
   "supportSentimentTrend",
   "realisedValueVsGoals",
   "accountArr"
  ],
  "type": "object"
 },
