{"_meta":{"securitySchemes":[{"scopes":["account:read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Manage Mail Campaign Draft"},"description":"Creates or updates a draft mail campaign, or pauses or resumes a campaign. Free. Create with one audience (property_ids, contact_ids or list_ids) to make a draft. Create with no audience to save a Ready campaign that properties can be added to later with dealmachine_mail_campaign_add_properties. Set accepts_properties to true on create to keep adding properties to a campaign with an audience after it is sent. Pause works on Active campaigns, and on Ready campaigns that accept properties; an ended campaign cannot be paused or resumed.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"accepts_properties":{"description":"Create only. true keeps the campaign open to new properties after it is sent. Defaults to false with an audience; a campaign with no audience always accepts properties","type":"boolean"},"address_to":{"enum":["owner","resident"],"type":"string"},"campaign_id":{"description":"Required except for create","type":"string"},"contact_email":{"anyOf":[{"format":"email","pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},{"type":"null"}]},"contact_ids":{"items":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"type":"array"},"contact_name":{"anyOf":[{"maxLength":255,"type":"string"},{"type":"null"}]},"contact_phone":{"anyOf":[{"maxLength":50,"type":"string"},{"type":"null"}]},"description":{"anyOf":[{"maxLength":5000,"type":"string"},{"type":"null"}]},"list_ids":{"items":{"type":"string"},"type":"array"},"name":{"maxLength":255,"minLength":1,"type":"string"},"operation":{"enum":["create","update","pause","resume"],"type":"string"},"property_ids":{"description":"D