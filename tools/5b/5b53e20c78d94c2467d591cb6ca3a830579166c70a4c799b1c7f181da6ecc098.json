{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the links on a web page as absolute URLs, each flagged as internal (same site) or external, with anchor text, title, rel and nofollow status. Supports scope filtering, de-duplication and a result limit \u2014 useful for crawling a documentation tree, auditing outbound links or finding next pages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "deduplicate": {
    "default": true,
    "description": "Collapse repeated URLs to a single entry.",
    "type": "boolean"
   },
   "includeAnchors": {
    "default": false,
    "description": "Include in-page fragment links such as \"#section\".",
    "type": "boolean"
   },
   "limit": {
    "default": 200,
    "description": "Maximum number of links to return.",
    "maximum": 2000,
    "minimum": 1,
    "type": "integer"
   },
   "scope": {
    "default": "all",
    "description": "Restrict results to same-site links, off-site links, or return both.",
    "enum": [
     "all",
     "internal",
     "external"
    ],
    "type": "string"
   },
   "timeoutMs": {
    "description": "Request timeout in milliseconds (1000-120000).",
    "maximum": 120000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "description": "Absolute http(s) URL of the page to fetch.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "extract_links",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "externalCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "fromCache": {
    "type": "boolean"
   },
   "internalCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "internal": {
       "type": "boolean"
      },
      "nofollow": {
       "type": "boolean"
      },
      "rel": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "text": {
       "type": "string"
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "text",
      "title",
      "rel",
      "internal",
      "nofollow"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requestedUrl": {
    "type": "string"
   },
   "returned": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "totalFound": {
    "description": "Links matching the scope before the limit was applied.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "requestedUrl",
   "status",
   "totalFound",
   "returned",
   "internalCount",
   "externalCount",
   "truncated",
   "links",
   "fromCache"
  ],
  "type": "object"
 },
 "title": "Extract page links"
}
