    "description": "Returned tcg_, cat_ or catv_ ID from an authenticated catalogue response.",
    "pattern": "^(?:tcg_[a-f0-9]{32}|cat_[a-f0-9]{64}|catv_[a-f0-9]{64})$",
    "type": "string"
   },
   "catalogue_card_id": {
    "description": "Required parent cat_ ID for a catv_ image; omit for other IDs.",
    "pattern": "^cat_[a-f0-9]{64}$",
    "type": "string"
   },
   "face": {
    "description": "Zero-based Magic face index, only with tcg_ IDs; copy from the returned image path.",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "size": {
    "default": "large",
    "enum": [
     "small",
     "large"
    ],
    "type": "string"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
