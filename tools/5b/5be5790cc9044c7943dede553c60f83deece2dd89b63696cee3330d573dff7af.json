{
 "description": "Permanently redact regions of a PDF on-device using Omitly. Removes the underlying text and image data (not a black box over it), verifies nothing survives in each region, and returns a signed audit log. The file is never uploaded \u2014 redaction happens locally.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "outputPath": {
    "description": "absolute path to write the redacted PDF",
    "type": "string"
   },
   "pdfPath": {
    "description": "absolute path to the source PDF",
    "type": "string"
   },
   "regions": {
    "description": "regions to remove",
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "page": {
       "description": "0-based page index",
       "minimum": 0,
       "type": "integer"
      },
      "reason": {
       "description": "audit-log reason, e.g. 'PII: SSN'",
       "type": "string"
      },
      "width": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "x": {
       "description": "left, in PDF points (origin bottom-left)",
       "type": "number"
      },
      "y": {
       "description": "bottom, in PDF points",
       "type": "number"
      }
     },
     "required": [
      "page",
      "x",
      "y",
      "width",
      "height"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "pdfPath",
   "outputPath",
   "regions"
  ],
  "type": "object"
 },
 "name": "redact_pdf",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audit": {
    "additionalProperties": false,
    "properties": {
     "disclosures": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "license": {
      "type": "string"
     },
     "licensedTo": {
      "type": [
       "string",
       "null"
      ]
     },
     "metadataScrubbed": {
      "type": "boolean"
     },
     "regions": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "bbox": {
         "additionalProperties": false,
         "properties": {
          "height": {
           "type": "number"
          },
          "width": {
           "type": "number"
          },
          "x": {
           "type": "number"
          },
          "y": {
           "type": "number"
          }
         },
         "required": [
          "x",
          "y",
          "width",
          "height"
         ],
         "type": "object"
        },
        "page": {
         "type": "integer"
        },
        "reason_code": {
         "type": "string"
        },
        "timestamp": {
         "type": "string"
        },
        "verification": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "result": {
             "const": "pass",
             "type": "string"
            }
           },
           "required": [
            "result"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "detail": {
             "type": "string"
            },
            "result": {
             "const": "fail",
             "type": "string"
            }
           },
           "required": [
            "result",
            "detail"
           ],
           "type": "object"
          }
         ]
        }
       },
       "required": [
        "page",
        "bbox",
        "timestamp",
        "reason_code",
        "verification"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "verdict": {
      "enum": [
       "pass",
       "fail"
      ],
      "type": "string"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "verdict",
     "regions",
     "warnings",
     "metadataScrubbed",
     "license",
     "licensedTo",
     "disclosures"
    ],
    "type": "object"
   },
   "output": {
    "type": "string"
   },
   "regionCount": {
    "minimum": 1,
    "type": "integer"
   },
   "verdict": {
    "enum": [
     "pass",
     "fail"
    ],
    "type": "string"
   }
  },
  "required": [
   "output",
   "regionCount",
   "verdict",
   "audit"
  ],
  "type": "object"
 }
}
