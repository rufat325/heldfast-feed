{
 "description": "Validate a draft URL or markdown against live SERP expectations before publishing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device": {
    "default": "desktop",
    "enum": [
     "desktop",
     "mobile"
    ],
    "type": "string"
   },
   "draft_markdown": {
    "description": "Draft markdown when no URL exists",
    "maxLength": 50000,
    "minLength": 100,
    "type": "string"
   },
   "draft_url": {
    "description": "Draft or staged page URL",
    "format": "uri",
    "type": "string"
   },
   "keyword": {
    "description": "Target keyword",
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "qa_depth": {
    "default": "standard",
    "enum": [
     "standard",
     "strict"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand, domain, or product",
    "type": "string"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "agentseo_content_draft_qa",
 "title": "AgentSEO Content Draft QA"
}
