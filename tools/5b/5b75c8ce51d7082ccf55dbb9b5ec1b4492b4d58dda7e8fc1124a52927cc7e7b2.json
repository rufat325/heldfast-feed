{
 "description": "Create a PDFGate webhook subscription. The response includes a signing secret \u2014 store it securely to verify incoming event signatures.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Optional label to identify this webhook",
    "type": "string"
   },
   "eventTypes": {
    "description": "Event types to subscribe to",
    "items": {
     "enum": [
      "envelope.sent",
      "envelope.completed",
      "envelope.expired",
      "envelope.voided",
      "envelope.deleted",
      "envelope.recipient.signed",
      "envelope.recipient.activated",
      "envelope.document.completed"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "url": {
    "description": "The HTTPS endpoint that will receive webhook events",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "eventTypes"
  ],
  "type": "object"
 },
 "name": "create_webhook"
}
