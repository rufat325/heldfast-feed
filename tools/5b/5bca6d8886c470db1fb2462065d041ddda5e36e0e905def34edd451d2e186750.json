{
 "_meta": {
  "ui": {
   "resourceUri": "ui://compose-preview/viewer"
  },
  "ui/resourceUri": "ui://compose-preview/viewer"
 },
 "description": "See one design on several devices in ONE picture: a contact sheet with a captioned cell per device \u00d7 theme \u00d7 font scale, plus each cell's device, size and box on the sheet. Nothing is saved \u2014 the design's environment is swapped on a scratch copy for each cell. Name `devices` by preset (phone_small, phone, phone_landscape, foldable_folded, foldable_unfolded, tablet_portrait, tablet_landscape, wear_small_round, wear_large_round, wear_square, tv_1080p) or as {widthDp, heightDp, label?, round?}; or a `formFactor` (phone, foldable, tablet, wear, tv, adaptive) for its default set; with neither you get the design's own form factor \u2014 phone, foldable and tablet for a mobile catalog, the round watches for Wear. Add `themes: [\"light\",\"dark\"]` and `fontScales: [1, 2]` to cross them; at most 16 cells. The sheet is a short-lived signed https link kept under 3.5 MB, so a chat surface can show it inline; `inline: true` puts the bytes in the reply as well.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "designId": {
    "type": "string"
   },
   "devices": {
    "description": "Devices to draw. Omit for the form factor's defaults.",
    "items": {
     "anyOf": [
      {
       "enum": [
        "phone_small",
        "phone",
        "phone_landscape",
        "foldable_folded",
        "foldable_unfolded",
        "tablet_portrait",
        "tablet_landscape",
        "wear_small_round",
        "wear_large_round",
        "wear_square",
        "tv_1080p"
       ],
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "formFactor": {
         "type": "string"
        },
        "heightDp": {
         "maximum": 4096,
         "minimum": 1,
         "type": "integer"
        },
        "id": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "round": {
         "type": "boolean"
        },
        "widthDp": {
         "maximum": 4096,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "widthDp",
        "heightDp"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "fontScales": {
    "description": "Defaults to the design's own font scale.",
    "items": {
     "maximum": 3.0,
     "minimum": 0.5,
     "type": "number"
    },
    "type": "array"
   },
   "formFactor": {
    "description": "A default device set, instead of `devices`.",
    "enum": [
     "phone",
     "foldable",
     "tablet",
     "wear",
     "tv",
     "adaptive"
    ],
    "type": "string"
   },
   "inline": {
    "description": "Also return the PNG as an image block. Defaults to false; a host with no public origin always does.",
    "type": "boolean"
   },
   "revision": {
    "description": "A past revision. Omit for the current one.",
    "type": "integer"
   },
   "themes": {
    "description": "Defaults to the design's own theme.",
    "items": {
     "enum": [
      "light",
      "dark"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   }
  },
  "required": [
   "designId"
  ],
  "type": "object"
 },
 "name": "ui_builder_render_design_matrix",
