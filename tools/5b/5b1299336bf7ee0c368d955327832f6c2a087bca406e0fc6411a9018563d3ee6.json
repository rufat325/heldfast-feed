{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimated price (USD) of Harel 'Passport First Class' travel insurance for a trip, per traveller and total, from Harel's official 2026 tariff. Also says if the trip exceeds the maximum days for an age.",
 "inputSchema": {
  "properties": {
   "ages": {
    "description": "Age of each traveller",
    "items": {
     "maximum": 95,
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "baggage": {
    "type": "boolean"
   },
   "cancel": {
    "description": "Trip cancellation up to $5,000 (basic) or $10,000 (extended)",
    "enum": [
     "none",
     "basic",
     "extended"
    ],
    "type": "string"
   },
   "days": {
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "extreme": {
    "type": "boolean"
   },
   "preexisting": {
    "description": "Add the pre-existing medical condition extension",
    "type": "boolean"
   },
   "usa": {
    "description": "Destination includes the USA",
    "type": "boolean"
   },
   "winter": {
    "type": "boolean"
   }
  },
  "required": [
   "ages",
   "days"
  ],
  "type": "object"
 },
 "name": "quote_trip",
 "title": "Estimate a Harel travel-insurance premium"
}
