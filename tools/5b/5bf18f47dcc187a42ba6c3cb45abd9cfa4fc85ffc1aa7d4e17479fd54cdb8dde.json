{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Search \u0418\u0437\u0432\u043e\u0440, an index of Bulgarian primary official sources (e.g. the State Gazette, municipal council decisions, public procurement notices). Returns the official record's title, issuer, number, date and official URL. Cite the official URL, not \u0418\u0437\u0432\u043e\u0440; the excerpt is for orientation only.","inputSchema":{"properties":{"from":{"description":"Earliest publication date, YYYY-MM-DD.","type":"string"},"limit":{"default":8,"maximum":20,"minimum":1,"type":"integer"},"query":{"description":"Words to find, in Bulgarian, e.g. \u201e\u0431\u044e\u0434\u0436\u0435\u0442 2027\u201c, \u201e\u0440\u0435\u0448\u0435\u043d\u0438\u0435 \u0440\u0435\u043c\u043e\u043d\u0442 \u0443\u043b\u0438\u0446\u0430\u201c.","type":"string"},"source":{"description":"Limit to one source id (see about_izvor).","type":"string"},"to":{"description":"Latest publication date, YYYY-MM-DD.","type":"string"}},"required":["query"],"type":"object"},"name":"search_izvor","outputSchema":{"properties":{"citations":{"description":"Every source the result rests on. Cite url; give checkedOn or publishedOn.","items":{"properties":{"checkedOn":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":["string","null"]},"id":{"type":"string"},"licence":{"enum":["CC-BY-4.0","official-record","ODbL-1.0"],"type":"string"},"publishedOn":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":["string","null"]},"publisher":{"type":["string","null"]},"record":{"format":"uri","type":["string","null"]},"title":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["id","title","url","publisher","publishedOn","checkedOn","licence","record"],"type":"object"},"type":"array"},"documents":{"items":{"properties":{"changedAt":{"type":"string"},"documentUrl":{"type":["string","null"]},"excerpt":{"description":"The start of the text, for orientation only.","type":"string"},"firstSeenAt":{"type":"string"},"id":{"type":"string"},"issuer":{"type":["string","null"]},"kind":{"type":"string"},"lastSeenAt":{"type":"string"},"number":{"type":["string","null"]},"publishedOn":{"type":["string","null"]},"source":{"type":"string"},"title":{"type":"string"},"url":{"description":"The official record. Cite this.","type":"string"}},"required":["id","source","title","url","publishedOn"],"type":"object"},"type":"array"}},"required":["documents","citations"],"type":"object"},"title":"\u0422\u044a\u0440\u0441\u0435\u043d\u0435 \u0432 \u0418\u0437\u0432\u043e\u0440"}
