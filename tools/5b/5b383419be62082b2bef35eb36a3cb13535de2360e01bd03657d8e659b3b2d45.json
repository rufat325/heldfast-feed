n":"Your model id, e.g. \"claude-opus-4-8\"; \"unknown\" if unsure. For analytics.","type":"string"},"merchant_id":{"description":"Optional merchant to act on. Admins and sub-merchant operators only; other callers always use their token's merchant.","format":"uuid","type":"string"},"report_id":{"description":"Optional: replace the definition of this saved report instead of creating one.","format":"uuid","type":"string"},"target":{"description":"With report_id: published (default) or draft; through this server it has no effect: a private report always publishes and a shared one gets a draft.","enum":["published","draft"],"type":"string"},"version":{"description":"With report_id: the version you read (get_report / list_reports). A stale version is refused with 409.","minimum":1.0,"type":"integer"}},"required":["definition"],"type":"object"},"name":"save_report","outputSchema":{"additionalProperties":{},"properties":{"_mcp_instructions":{"description":"Server-issued metadata for this conversation.","properties":{"conversation_id":{"description":"The server-issued conversation identifier.","type":"string"}},"type":"object"},"admin_url":{"type":["string","null"]},"id":{"format":"uuid","type":["string","null"]},"published":{"type":["boolean","null"]},"version":{"type":["integer","null"]}},"required":["id","version","published","admin_url"],"type":"object","x-fastmcp-top-level-schema":"ReportSaveResponse"},"title":"Save a custom report"}
