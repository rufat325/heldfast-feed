{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "content:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List official Fiveable cheatsheets"
 },
 "description": "Find approved Fiveable course and unit PDFs, including course variants, academic year when known, source links and readable-artifact readiness. Does not include user galleries or generated personal visuals.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "courseVariant": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "cursor": {
    "pattern": "^cs_[a-f0-9]{24}$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "subjectSlug": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "unitNumber": {
    "maximum": 30,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "limit"
  ],
  "type": "object"
 },
 "name": "list_cheatsheets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "content:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List official Fiveable cheatsheets"
}
