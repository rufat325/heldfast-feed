{
 "description": "Update an existing n8n workflow. Send the full updated workflow JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "server_name": {
    "description": "Server name. Uses default if omitted.",
    "type": "string"
   },
   "workflow_id": {
    "description": "n8n workflow ID to update",
    "type": "string"
   },
   "workflow_json": {
    "description": "Full workflow JSON as string",
    "type": "string"
   }
  },
  "required": [
   "workflow_id",
   "workflow_json"
  ],
  "type": "object"
 },
 "name": "n8n_update_workflow"
}
