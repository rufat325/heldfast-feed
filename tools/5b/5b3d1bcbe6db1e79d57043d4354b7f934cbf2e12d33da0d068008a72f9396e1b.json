{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Configure the new-member onboarding flow on a Community server: prompts with options that grant channels and roles, the default channels every member sees, and the enabled state. Discord's app asks for at least seven default channels when configuring this by hand; the API has been observed to accept fewer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "default_channels": {
    "description": "Channel names or IDs every new member gets.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "enabled": {
    "type": "boolean"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "mode": {
    "description": "default counts only default channels toward the constraints; advanced counts prompt option channels too.",
    "enum": [
     "default",
     "advanced"
    ],
    "type": "string"
   },
   "prompts": {
    "items": {
     "properties": {
      "options": {
       "items": {
        "properties": {
         "channels": {
          "description": "Channels this option grants.",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "description": {
          "maxLength": 100,
          "type": "string"
         },
         "roles": {
          "description": "Roles this option grants.",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "title": {
          "maxLength": 50,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "title"
        ],
        "type": "object"
       },
       "maxItems": 50,
       "minItems": 1,
       "type": "array"
      },
      "required": {
       "type": "boolean"
      },
      "single_select": {
       "type": "boolean"
      },
      "title": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "description": "Default multiple_choice.",
       "enum": [
        "multiple_choice",
        "dropdown"
       ],
       "type": "string"
      }
     },
     "required": [
      "title",
      "options"
     ],
     "type": "object"
    },
    "maxItems": 15,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "update_onboarding",
 "title": "Update onboarding"
}
