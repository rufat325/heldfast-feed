 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Project total deal cycle length by adding stakeholder count and compliance/procurement gates to a base single-buyer cycle. See the full version at https://rahuldsarker.co/calculators/sales-cycle-length-forecaster",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "baseCycleDays": {
    "description": "Base cycle length for a single buyer, in days",
    "type": "number"
   },
   "complianceGate": {
    "description": "Compliance/procurement gate: none (0 days), security (security review, 15 days), securityLegal (security + legal, 30 days), or full (security + legal + procurement, 50 days)",
    "enum": [
     "none",
     "security",
     "securityLegal",
     "full"
    ],
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "daysPerExtraStakeholder": {
    "description": "Days added per extra stakeholder beyond the first",
    "type": "number"
   },
   "decisionMakers": {
    "description": "Number of decision-makers involved",
    "type": "number"
   }
  },
  "required": [
   "baseCycleDays",
   "decisionMakers",
   "daysPerExtraStakeholder",
   "complianceGate"
  ],
  "type": "object"
 },
 "name": "sales_cycle_length_forecaster",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
