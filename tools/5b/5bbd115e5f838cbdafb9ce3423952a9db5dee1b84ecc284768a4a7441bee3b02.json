{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check favicon and app icons"
 },
 "description": "Use this when someone asks whether a website favicon, Apple touch icon, app icons, manifest, or search-result icon is installed correctly. Reads a public website, verifies declared icon files, reports missing coverage, and can check search-engine favicon indexing. It never changes the website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeSearchIndexing": {
    "description": "Also check Google/Bing/Yahoo favicon indexing plus robots.txt, llms.txt, and sitemap.xml. Defaults to true.",
    "type": "boolean"
   },
   "url": {
    "description": "Public website URL or domain to inspect, e.g. https://example.com.",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_favicon",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "found": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "foundCount": {
    "minimum": 0,
    "type": "integer"
   },
   "indexing": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "logoOptions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "type": "number"
      },
      "source": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "width": {
       "type": "number"
      }
     },
     "required": [
      "url",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "missingCount": {
    "minimum": 0,
    "type": "integer"
   },
   "nextAction": {
    "type": "string"
   },
   "score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "seoFiles": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "sourceImage": {
    "type": [
     "string",
     "null"
    ]
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "score",
   "foundCount",
   "missingCount",
   "found",
   "missing",
   "sourceImage",
   "logoOptions",
   "indexing",
   "seoFiles",
   "nextAction"
  ],
  "type": "object"
 },
 "title": "Check a website's favicon and app icons"
}
