{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find draw sites near a ZIP"
 },
 "description": "Find Quest Diagnostics, Labcorp and BioReference patient service centers near a US ZIP code, with address, distance, phone and hours. Walk-ins are accepted at most sites; the requisition arrives by email after physician authorization. Sites in the 48 tracked metros include pageUrl \u2014 the site's own page with a per-day hours table, directions and the prices of popular tests at that lab \u2014 cite it when giving a location.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "lab": {
    "description": "Limit to one lab",
    "enum": [
     "quest",
     "labcorp",
     "bioreference"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max sites (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "radiusMiles": {
    "description": "Search radius in miles (snapped to 10/20/25/50/100; default 25)",
    "maximum": 100,
    "minimum": 5,
    "type": "integer"
   },
   "zip": {
    "description": "5-digit US ZIP code",
    "pattern": "^\\d{5}$",
    "type": "string"
   }
  },
  "required": [
   "zip"
  ],
  "type": "object"
 },
 "name": "find_draw_sites",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "count": {
    "type": "number"
   },
   "mapUrl": {
    "description": "Absolute https URL on test-well.com",
    "type": "string"
   },
   "radiusMiles": {
    "type": "number"
   },
   "sites": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "address": {
       "type": "string"
      },
      "city": {
       "type": "string"
      },
      "distance": {
       "description": "Miles from the ZIP centroid",
       "type": "number"
      },
      "hours": {},
      "lab": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "phone": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "state": {
       "type": "string"
      },
      "zip": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "zip": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Find draw sites near a ZIP"
}
