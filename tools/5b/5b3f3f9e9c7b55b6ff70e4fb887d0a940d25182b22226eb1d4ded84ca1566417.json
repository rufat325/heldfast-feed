{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Dataset changes between versions"
 },
 "description": "What was appended between two versions, (from, to]: who contributed, when and how many records, and up to `limit` of the added records. limit=0 is public metadata; records need auth.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "maximum": 500,
    "minimum": 0,
    "type": "integer"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
    "type": "string"
   },
   "to": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "slug",
   "to"
  ],
  "type": "object"
 },
 "name": "dataset_diff",
 "title": "Dataset changes between versions"
}
