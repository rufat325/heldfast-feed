{
 "description": "Summarize backlink authority, referring domains, spam risk, broken backlinks, and next SEO actions for a domain, subdomain, or URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backlinks_status_type": {
    "default": "live",
    "enum": [
     "live",
     "all",
     "lost"
    ],
    "type": "string"
   },
   "dofollow_only": {
    "default": false,
    "type": "boolean"
   },
   "exclude_internal_backlinks": {
    "default": true,
    "type": "boolean"
   },
   "include_indirect_links": {
    "default": true,
    "type": "boolean"
   },
   "include_subdomains": {
    "default": true,
    "type": "boolean"
   },
   "internal_list_limit": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "rank_scale": {
    "default": "one_hundred",
    "enum": [
     "one_hundred",
     "one_thousand"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_backlinks_summary",
 "title": "AgentSEO Backlinks Summary"
}
