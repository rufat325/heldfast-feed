{
 "description": "Gestiona anuncios. Acciones: list (page, limit), get (id), create, update (id), delete (id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "end_date": {
    "type": "string"
   },
   "id": {
    "description": "ID del anuncio",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "read_by": {
    "type": "string"
   },
   "share_with": {
    "type": "string"
   },
   "share_with_specific": {
    "type": "string"
   },
   "start_date": {
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "announcements"
}
