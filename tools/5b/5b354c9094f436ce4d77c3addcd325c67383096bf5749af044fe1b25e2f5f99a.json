{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update configuration of a Live Station channel (CDN, quality, recording, DVR settings)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channelId": {
    "description": "Channel ID to update",
    "type": "string"
   },
   "channelName": {
    "description": "New channel name (3-20 chars)",
    "type": "string"
   },
   "drmEnabledYn": {
    "description": "Whether to enable Multi DRM",
    "type": "boolean"
   },
   "immediateOnAir": {
    "description": "Auto-recording on stream start",
    "type": "boolean"
   },
   "isStreamFailOver": {
    "description": "Whether to enable streaming redundancy",
    "type": "boolean"
   },
   "qualitySetId": {
    "description": "New image quality setting ID",
    "type": "number"
   },
   "recordBucketName": {
    "description": "Recording storage bucket",
    "type": "string"
   },
   "recordFilePath": {
    "description": "Recording storage path",
    "type": "string"
   },
   "recordFormat": {
    "description": "Recording file format",
    "enum": [
     "MP4",
     "HLS",
     "ALL"
    ],
    "type": "string"
   },
   "recordType": {
    "description": "Recording storage type",
    "enum": [
     "NO_RECORD",
     "AUTO_UPLOAD",
     "MANUAL_UPLOAD"
    ],
    "type": "string"
   },
   "timemachineMin": {
    "description": "Time machine allowance in minutes (360)",
    "type": "number"
   },
   "useDvr": {
    "description": "Time machine (DVR) setting",
    "type": "boolean"
   }
  },
  "required": [
   "channelId"
  ],
  "type": "object"
 },
 "name": "ncloud_livestation_update_channel"
}
