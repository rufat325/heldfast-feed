{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search publishers"
 },
 "description": "Search PayPerByte publishers by topic and sort order. Returns publisher addresses, topics, subscriber counts, message counts, and price-per-KB.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results to return (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Topic keyword to search (e.g. 'weather', 'crypto', 'cve')",
    "type": "string"
   },
   "sortBy": {
    "description": "Sort field: 'subscribers', 'revenue', 'messages'",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "byte_search_publishers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "publishers": {
    "description": "Matching publishers, sorted by the requested field",
    "items": {
     "additionalProperties": {},
     "properties": {
      "address": {
       "description": "Publisher Ethereum address (0x...)",
       "type": "string"
      },
      "messages": {
       "description": "Total messages published",
       "type": "number"
      },
      "pricePerKB": {
       "description": "Price per KB in USDC",
       "type": "number"
      },
      "subscribers": {
       "description": "Active subscriber count",
       "type": "number"
      },
      "topic": {
       "description": "Registered topic slug",
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
