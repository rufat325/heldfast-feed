{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Add references from a skill to other skills, resources, or facts",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "linkFacts": {
    "items": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "linkResources": {
    "items": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "linkSkills": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "minLength": 1,
       "type": "string"
      },
      "relation": {
       "enum": [
        "prerequisite",
        "related",
        "extends"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "relation"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skillName": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "skillName"
  ],
  "type": "object"
 },
 "name": "link_skill",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "skillName": {
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "skillName"
  ],
  "type": "object"
 },
 "title": "Link Skill"
}
