{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the values currently tracked by one usage-limit policy with each value key and current usage. Filter by active or exhausted state, search text, and pagination before resetting one counter.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "current_page": {
    "description": "Zero-based page number",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "limit_id": {
    "description": "Usage-limit policy UUID",
    "minLength": 1,
    "type": "string"
   },
   "page_size": {
    "description": "Number of entities per page",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "search": {
    "description": "Search tracked values",
    "type": "string"
   },
   "status": {
    "description": "Filter by enforcement state",
    "enum": [
     "active",
     "exhausted"
    ],
    "type": "string"
   }
  },
  "required": [
   "limit_id"
  ],
  "type": "object"
 },
 "name": "list_usage_limit_entities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
