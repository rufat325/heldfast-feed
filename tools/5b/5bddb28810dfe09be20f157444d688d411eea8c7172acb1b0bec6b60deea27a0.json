{
 "description": "Get details of a specific course by its Blackboard ID (e.g. _529580_1)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "courseId": {
    "description": "Blackboard course ID like _529580_1",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   }
  },
  "required": [
   "courseId"
  ],
  "type": "object"
 },
 "name": "blackboard_get_course"
}
