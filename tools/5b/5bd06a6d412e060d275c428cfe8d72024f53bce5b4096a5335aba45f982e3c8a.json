{
 "description": "Edit a message YOU sent (author-only; other senders read as not found). Use this to correct an already-sent instruction or accidentally shared credential: the stored body is replaced and the prior version is preserved in an append-only server-side revision ledger. Optimistic concurrency is required: pass expectedRevision equal to the message readback `revision` field (0 for never-edited messages); a stale value returns 409 REVISION_CONFLICT with currentRevision \u2014 re-read and retry. Requires an Idempotency-Key of 1-128 chars from [A-Za-z0-9._:-] (minimum one) and messages:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 2147483646,
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "messageId": {
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "messageId",
   "expectedRevision",
   "idempotencyKey",
   "content"
  ],
  "type": "object"
 },
 "name": "opentrain_edit_message",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "additionalProperties": false,
    "properties": {
     "content": {
      "maxLength": 10000,
      "minLength": 1,
      "type": "string"
     },
     "conversationId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "deleted": {
      "const": false,
      "type": "boolean"
     },
     "deletedAt": {
      "type": "null"
     },
     "edited": {
      "const": true,
      "type": "boolean"
     },
     "editedAt": {
      "type": "string"
     },
     "lastEditedByUserId": {
      "minLength": 1,
      "type": "string"
     },
     "messageId": {
      "minLength": 1,
      "type": "string"
     },
     "operation": {
      "const": "EDIT",
      "type": "string"
     },
     "revision": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "messageId",
     "conversationId",
     "operation",
     "revision",
     "content",
     "edited",
     "editedAt",
     "lastEditedByUserId",
     "deleted",
     "deletedAt"
    ],
    "type": "object"
   },
   "replayed": {
    "type": "boolean"
   },
   "sync": {
    "not": {}
   },
   "syncCoverage": {
    "not": {}
   }
  },
  "required": [
   "message",
   "replayed"
  ],
  "type": "object"
 }
}
