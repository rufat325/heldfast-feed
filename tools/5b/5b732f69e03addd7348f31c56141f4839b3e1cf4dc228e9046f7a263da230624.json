{
 "description": "Scaffold an entire course in one call: course + modules + lesson placeholders (title/description only, no content yet). After this, loop over the returned lesson ids with hivelearn_update_lesson_content to fill in video/document URLs. This is the preferred first step when authoring a new course from a plan.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "type": "string"
   },
   "description_format": {
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "description_json": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "difficulty": {
    "anyOf": [
     {
      "enum": [
       "beginner",
       "intermediate",
       "advanced"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "instructor_avatar_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "instructor_name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "modules": {
    "description": "Ordered list of modules; each with optional lesson placeholders",
    "items": {
     "properties": {
      "lessons": {
       "items": {
        "properties": {
         "description": {
          "type": "string"
         },
         "title": {
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "title"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "title": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "thumbnail_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "title": {
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "enum": [
     "all_members",
     "admin_only"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "modules"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_course_outline"
}
