{
 "description": "Start authorization and origin-control proof for up to five exact read-only HTTPS GET paths. Serve the returned proof JSON at proof_url before verifying. Private read_token must be generated and saved by the caller.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "origin": {
    "format": "uri",
    "type": "string"
   },
   "owner_authorized": {
    "const": true,
    "type": "boolean"
   },
   "paths": {
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "read_only_paths": {
    "const": true,
    "type": "boolean"
   },
   "read_token": {
    "maxLength": 128,
    "minLength": 32,
    "type": "string"
   }
  },
  "required": [
   "origin",
   "paths",
   "owner_authorized",
   "read_only_paths",
   "read_token"
  ],
  "type": "object"
 },
 "name": "enroll_target"
}
