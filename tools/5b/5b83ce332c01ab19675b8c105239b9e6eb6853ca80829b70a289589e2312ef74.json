{
 "description": "\u65e5\u672c\u306e\u4e0d\u52d5\u7523\u7af6\u58f2\u7269\u4ef6\u3092\u691c\u7d22 (BIT, bit.courts.go.jp \u7531\u6765\u306e\u69cb\u9020\u5316\u30c7\u30fc\u30bf). Search Japanese court real-estate auctions (BIT). Distinct from the subsidies module above. Filters: prefecture (\u6771\u4eac\u90fd etc.), court_code, property_type (land / detached_house / apartment / other), price range, bid_period_only (active bid window now). Returns case_id, court, address, sale_base_price_jpy, bid_period, opening_date, photos. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bid_period_only": {
    "description": "Only listings whose bid period intersects today",
    "type": "boolean"
   },
   "court_code": {
    "description": "5-digit BIT court id (\u672c\u5e81=11, \u652f\u90e8=21,31,...)",
    "type": "string"
   },
   "keyword": {
    "description": "Japanese keyword over title/address/structure",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_price_jpy": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "min_price_jpy": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "prefecture": {
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "property_type": {
    "enum": [
     "land",
     "detached_house",
     "apartment",
     "other"
    ],
    "type": "string"
   },
   "sort": {
    "enum": [
     "opening_date_asc",
     "price_asc",
     "price_desc",
     "newest"
    ],
    "type": "string"
   },
   "status": {
    "description": "Default = active",
    "enum": [
     "active",
     "sold",
     "withdrawn",
     "postponed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_auctions"
}
