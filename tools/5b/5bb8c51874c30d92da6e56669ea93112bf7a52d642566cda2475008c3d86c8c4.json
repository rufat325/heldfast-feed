{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch a public HTTPS page and return bounded citation-ready evidence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "idempotency_key": {
    "description": "Stable key used to make a paid retry idempotent.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "max_chars": {
    "description": "Maximum characters to return.",
    "maximum": 24000,
    "minimum": 2000,
    "type": "integer"
   },
   "query": {
    "description": "Optional phrase to locate in the page.",
    "maxLength": 200,
    "type": "string"
   },
   "url": {
    "description": "Public HTTPS page URL to fetch.",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "web_evidence",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Citation-ready bounded evidence fetched from a public HTTPS page.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "contentType": {
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "error": {},
   "extensions": {},
   "extraction": {
    "type": "string"
   },
   "fetchedAt": {
    "type": "string"
   },
   "finalUrl": {
    "format": "uri",
    "type": "string"
   },
   "links": {
    "items": {},
    "type": "array"
   },
   "matches": {
    "items": {},
    "type": "array"
   },
   "resource": {},
   "sourceHash": {
    "type": "string"
   },
   "status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Web evidence"
}
