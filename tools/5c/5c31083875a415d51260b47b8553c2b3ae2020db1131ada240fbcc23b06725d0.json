{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Climate and disaster risk of a place"
 },
 "description": "Climate and disaster risk overview of one place or property in a single answer: this week's forecast risk by day, natural hazards happening nearby, the headline long-term exposures (heat, river and coastal flooding, sea level rise, water stress, drought, heavy rain, wildfire, climate zone) and the risk profile of the country it lies in.\n\nUse it first for an open question about one place (\"is it safe there\", \"what are the risks\", \"should I worry about floods or heat\"). For one specific question call the matching tool, which answers it in full: get_forecast, get_hazards_near, get_climate_profile or get_country_profile. To compare places, call get_climate_profile once per place.\n\nGive latitude and longitude, or a place name, which is resolved to its best match and reported back. Returns the forecast days, the hazard events, the headline climate layers with their sources, the country summary and criora_url, the place on the Criora map.",
 "inputSchema": {
  "properties": {
   "latitude": {
    "anyOf": [
     {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Latitude of the place asked about, in degrees, WGS84. Give it with longitude, or give place instead",
    "title": "Latitude"
   },
   "longitude": {
    "anyOf": [
     {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Longitude of the place asked about, in degrees, WGS84. Give it with latitude, or give place instead",
    "title": "Longitude"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "A place name or address, used only when latitude and longitude are not given. It is resolved to its best match by a geocoder shared by every user and limited to one lookup a second, so pass coordinates when you have them",
    "title": "Place"
   }
  },
  "title": "assess_placeArguments",
  "type": "object"
 },
