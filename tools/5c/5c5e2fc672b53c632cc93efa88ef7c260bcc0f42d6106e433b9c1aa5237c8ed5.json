{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a draft order"
 },
 "description": "Create an order as a DRAFT \u2014 nothing is charged or produced. It must be confirmed later in the Printful dashboard, where the charge is shown. Each item needs one of variant_id (+ files), sync_variant_id, external_variant_id, warehouse_product_variant_id or product_template_id (+ variant_id). Printful: POST /orders (never with confirm).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "external_id": {
    "description": "Your own order id; the order is then also addressable as @<external_id>.",
    "type": "string"
   },
   "gift": {
    "description": "Gift message for the packing slip.",
    "properties": {
     "message": {
      "description": "Gift message text.",
      "type": "string"
     },
     "subject": {
      "description": "Gift message title.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "items": {
    "description": "Order items.",
    "items": {
     "properties": {
      "external_id": {
       "description": "Your line-item id.",
       "type": "string"
      },
      "external_variant_id": {
       "description": "Your platform's variant id for a Sync Variant.",
       "type": "string"
      },
      "files": {
       "description": "Print files (needed with a plain catalog variant_id).",
       "items": {
        "properties": {
         "filename": {
          "description": "File name.",
          "type": "string"
         },
         "id": {
          "description": "Id of a file already in the File Library. Give url or id.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "options": {
          "description": "Additional file options.",
          "items": {
           "properties": {
            "id": {
             "description": "Option id, e.g. stitch_color or thread_colors.",
             "type": "string"
            },
            "value": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "number"
              },
              {
               "type": "boolean"
              },
              {
               "items": {
                "type": "string"
               },
               "type": "array"
              }
             ],
             "description": "Option value."
            }
           },
           "required": [
            "id",
            "value"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "type": {
          "description": "Placement / role of the file, e.g. default, front, back, preview (see the catalog product's files).",
          "type": "string"
         },
         "url": {
          "description": "Public URL of the print file. Give url or id.",
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Display name on the packing slip.",
       "type": "string"
      },
      "options": {
       "description": "Product options, e.g. embroidery thread colors.",
       "items": {
        "properties": {
         "id": {
          "description": "Option id, e.g. stitch_color or thread_colors.",
          "type": "string"
         },
         "value": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "type": "boolean"
           },
           {
            "items": {
             "type": "string"
            },
            "type": "array"
           }
          ],
          "description": "Option value."
         }
        },
        "required": [
         "id",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "product_template_id": {
       "description": "Product Template to generate print files from (variant_id is then required).",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "quantity": {
       "description": "Quantity (max 1000 per item).",
       "maximum": 1000,
       "minimum": 1,
       "type": "integer"
      },
      "retail_price": {
       "description": "Retail price shown on the packing slip, e.g. \"29.99\".",
       "type": "string"
      },
      "sku": {
       "description": "Your SKU.",
       "type": "string"
      },
      "sync_variant_id": {
       "description": "Sync Variant id from your Printful store.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "variant_id": {
       "description": "Catalog variant id (then give files).",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "warehouse_product_variant_id": {
       "description": "Warehouse product variant id.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "packing_slip": {
    "description": "Custom packing slip.",
    "properties": {
     "custom_order_id": {
      "description": "Your own order id to print instead of Printful's.",
      "type": "string"
     },
     "email": {
      "description": "Customer-service email.",
      "type": "string"
     },
     "logo_url": {
      "description": "Logo / sticker URL (printed monochrome).",
      "type": "string"
     },
     "message": {
      "description": "Custom packing-slip message.",
      "type": "string"
     },
     "phone": {
      "description": "Customer-service phone.",
      "type": "string"
     },
     "store_name": {
      "description": "Store name override for the return address.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "recipient": {
    "description": "Ship-to address (name, address1, city, country_code, zip are normally needed).",
    "properties": {
     "address1": {
      "description": "Address line 1.",
      "type": "string"
     },
     "address2": {
      "description": "Address line 2.",
      "type": "string"
     },
     "city": {
      "description": "City.",
      "type": "string"
     },
     "company": {
      "description": "Company name.",
      "type": "string"
     },
     "country_code": {
      "description": "Two-letter ISO country code, e.g. US.",
      "type": "string"
     },
     "email": {
      "description": "Email address.",
      "type": "string"
     },
     "name": {
      "description": "Full name.",
      "type": "string"
     },
     "phone": {
      "description": "Phone number.",
      "type": "string"
     },
     "state_code": {
      "description": "State code \u2014 required for US, CA and AU.",
      "type": "string"
     },
     "tax_number": {
      "description": "Tax number (required for Brazil: CPF/CNPJ).",
      "type": "string"
     },
     "zip": {
      "description": "ZIP / postal code.",
      "type": "string"
     }
    },
    "required": [
     "country_code"
    ],
    "type": "object"
   },
   "retail_costs": {
    "description": "Retail costs to show on the packing slip.",
    "properties": {
     "currency": {
      "description": "3-letter currency code.",
      "type": "string"
     },
     "discount": {
      "type": "string"
     },
     "shipping": {
      "type": "string"
     },
     "subtotal": {
      "type": "string"
     },
     "tax": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "shipping": {
    "description": "Shipping method id from printful_calculate_shipping_rates (default STANDARD).",
    "type": "string"
   },
   "store_id": {
    "description": "Store id (numeric) for an ACCOUNT-level token; overrides PRINTFUL_STORE_ID. Not needed with a store-level token.",
    "type": "string"
   }
  },
  "required": [
   "recipient",
   "items"
  ],
  "type": "object"
 },
 "name": "printful_create_draft_order",
 "title": "Create a draft order"
}
