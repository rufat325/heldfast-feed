{
 "description": "List, add, update or clear product variants (sizes, colours, SKUs) for a shop. Each variant can override the product price and stock. list: pass productId to scope to one product or omit for the whole store. update changes one existing variant by id (use list first to get its id) \u2014 for replacing a product's whole variant set (e.g. re-importing a size matrix), clear then add is simpler and safer than bulk-updating by id. clear removes ALL variants from a product \u2014 follow with add to set the new set. The seller admin panel reflects changes immediately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list",
     "add",
     "update",
     "clear"
    ],
    "type": "string"
   },
   "attributes": {
    "additionalProperties": {},
    "description": "update: replace extra attributes",
    "type": "object"
   },
   "color": {
    "description": "update: new colour",
    "type": "string"
   },
   "price": {
    "description": "update: new override price",
    "type": "number"
   },
   "productId": {
    "description": "Product ID \u2014 required for add/clear, optional filter for list",
    "type": "string"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "size": {
    "description": "update: new size",
    "type": "string"
   },
   "sku": {
    "description": "update: new SKU",
    "type": "string"
   },
   "stockQty": {
    "description": "update: new stock units",
    "type": "number"
   },
   "variantId": {
    "description": "Variant ID \u2014 required for update",
    "type": "string"
   },
   "variants": {
    "description": "add: one or more variants to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "attributes": {
       "additionalProperties": {},
       "description": "Extra attributes e.g. { material: \"cotton\" }",
       "type": "object"
      },
      "color": {
       "description": "e.g. \"Black\", \"White\", \"Navy\"",
       "type": "string"
      },
      "price": {
       "description": "Override price for this variant",
       "type": "number"
      },
      "size": {
       "description": "e.g. \"S\", \"M\", \"L\", \"XL\", \"UK 8\"",
       "type": "string"
      },
      "sku": {
       "description": "Unique SKU for this variant",
       "type": "string"
      },
      "stockQty": {
       "description": "Stock units for this variant",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_variants"
}
