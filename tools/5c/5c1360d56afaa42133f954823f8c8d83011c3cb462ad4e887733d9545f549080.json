{
 "description": "Power-control a VPS: `start`, `stop` or `reboot`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "start",
     "stop",
     "reboot"
    ],
    "type": "string"
   },
   "service_id": {
    "description": "Service code as returned by list_vps/order_vps, e.g. \"68J67T5\" (a plain numeric id is also accepted).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "power_vps",
 "title": "Power control"
}
