{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "destructiveHint": false,
  "priority": 1,
  "readOnlyHint": true
 },
 "description": "Search PoloPan products using a text query and optional filters. Returns products with available in-stock sizes, specifications table, shipping/return policies, pricing, and verified purchase URLs (https://s.polopan.com/p/{handle}).\n\nMANDATORY AGENT INSTRUCTIONS:\n1. Always tell the user the available sizes for items, and display returning & shipping policies (Negative return days = 'Exchange only |X| days').\n2. When presenting/shortlisting products, display the product specifications table.\n3. Return the base link (https://s.polopan.com/p/{handle}) during browsing. Provide the direct checkout link (https://s.polopan.com/p/{handle}/{size_index}) ONLY after the user's size is finalized.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "gender": {
    "description": "Target gender filter: 'men', 'women', or 'unisex'",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination (starts at 1)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 20,
    "description": "Number of items to return per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "price_max": {
    "description": "Maximum price in local currency",
    "type": "number"
   },
   "price_min": {
    "description": "Minimum price in local currency",
    "type": "number"
   },
   "query": {
    "description": "The search query or style keyword to find fashion items (e.g. 'black leather jacket', 'floral summer midi dress')",
    "minLength": 1,
    "type": "string"
   },
   "size": {
    "description": "Array of sizes to filter by, e.g. ['S', 'M', 'L', 'XL']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sort_by": {
    "default": "relevance",
    "description": "Sorting criteria for the search results",
    "enum": [
     "relevance",
     "price",
     "title"
    ],
    "type": "string"
   },
   "sort_order": {
    "default": "desc",
    "description": "Sort order: 'asc' for ascending, 'desc' for descending",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "vendor": {
    "description": "List of brand or vendor names to filter by",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "products.search.text",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pagination": {
    "additionalProperties": false,
    "description": "Pagination metadata",
    "properties": {
     "page": {
      "description": "Current page number",
      "type": "number"
     },
     "page_size": {
      "description": "Number of items per page",
      "type": "number"
     },
     "total": {
      "description": "Total number of matching products",
      "type": "number"
     }
    },
    "required": [
     "page",
     "page_size"
    ],
    "type": "object"
   },
   "products": {
    "description": "List of matching fashion products",
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand": {
       "description": "Brand or vendor name",
       "type": "string"
      },
      "discount_percent": {
       "description": "Discount percentage",
       "type": "number"
      },
      "handle": {
       "description": "Unique product handle identifier",
       "type": "string"
      },
      "mrp": {
       "description": "Original maximum retail price",
       "type": "number"
      },
      "price": {
       "description": "Current selling price",
       "type": "number"
      },
      "sizes": {
       "description": "List of available in-stock sizes",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Product name and title",
       "type": "string"
      },
      "url": {
       "description": "Verified purchase link",
       "type": "string"
      }
     },
     "required": [
      "handle",
      "title",
      "price",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "products"
  ],
  "type": "object"
 },
 "title": "Search Products By Text"
}
