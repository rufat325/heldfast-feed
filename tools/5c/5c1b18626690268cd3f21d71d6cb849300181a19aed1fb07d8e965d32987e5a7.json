{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish the events to an MQTT broker. Publish only: the server does not subscribe. Send url (mqtt://host:1883 or mqtts://host:8883), enabled, topic_prefix, username, password, qos 0 or 1, retain. Anything left out stays. Events must be on (update_settings with events.enabled=true) and only the kinds meant for everyday listeners are published, never settings, users or keys. The password is kept in memory and never shown again. test=true publishes one message to <prefix>/test. Requires admin. Then call run_query with schema=settings and read mqtt.status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "enabled": {
    "description": "true connects and publishes, false disconnects.",
    "type": [
     "boolean",
     "string"
    ]
   },
   "password": {
    "description": "Broker password. Empty clears it. Never returned.",
    "maxLength": 500,
    "type": "string"
   },
   "qos": {
    "description": "0 at most once, 1 at least once.",
    "maximum": 1,
    "minimum": 0,
    "type": "integer"
   },
   "retain": {
    "description": "Ask the broker to keep the last message of each topic.",
    "type": [
     "boolean",
     "string"
    ]
   },
   "test": {
    "description": "Also publish one test message to <prefix>/test.",
    "type": "boolean"
   },
   "topic_prefix": {
    "description": "Topics are <prefix>/<event type>, for example mcp-ticket-demo/events/timer.tick.",
    "maxLength": 100,
    "type": "string"
   },
   "url": {
    "description": "Broker, for example mqtt://localhost:1883. No user name or password in the URL.",
    "maxLength": 300,
    "type": "string"
   },
   "username": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "set_mqtt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": "string"
   },
   "mqtt": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "hasPassword": {
      "type": "boolean"
     },
     "qos": {
      "type": "number"
     },
     "retain": {
      "type": "boolean"
     },
     "status": {
      "additionalProperties": false,
      "properties": {
       "connectedAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "error": {
        "type": "string"
       },
       "failed": {
        "type": "number"
       },
       "lastAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "lastTopic": {
        "type": "string"
       },
       "published": {
        "type": "number"
       },
       "queued": {
        "type": "number"
       },
       "state": {
        "type": "string"
       }
      },
      "required": [
       "state",
       "error",
       "published",
       "failed",
       "queued",
       "lastAt",
       "lastTopic",
       "connectedAt"
      ],
      "type": "object"
     },
     "topicPrefix": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "username": {
      "type": "string"
     }
    },
    "required": [
     "enabled",
     "url",
     "topicPrefix",
     "username",
     "qos",
     "retain",
     "hasPassword"
    ],
    "type": "object"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "test": {
    "additionalProperties": false,
    "properties": {
     "error": {
      "type": "string"
     },
     "ok": {
      "type": "boolean"
     },
     "queued": {
      "type": "boolean"
     },
     "topic": {
      "type": "string"
     }
    },
    "required": [
     "ok"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "next"
  ],
  "type": "object"
 }
}
