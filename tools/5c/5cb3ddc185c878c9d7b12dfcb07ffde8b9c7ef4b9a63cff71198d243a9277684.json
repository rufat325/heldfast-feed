{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Change a store you own: name, address, robot spot, hours, radius, visibility, alert channels, loading notes, perishables setting or external_ref; status pauses (paused) and resumes (live) a store. A pending store becomes live only through the activation check. Changing a live store's address or robot spot returns it to pending.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "minProperties": 2,
  "properties": {
   "address": {
    "maxLength": 400,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "alert_channels": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "relay",
        "webhook",
        "sms",
        "voice"
       ],
       "type": "string"
      },
      "target": {
       "maxLength": 400,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "kind",
      "target"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "external_ref": {
    "maxLength": 200,
    "minLength": 1,
    "type": [
     "string",
     "null"
    ]
   },
   "hours": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "close": {
       "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
       "type": "string"
      },
      "day": {
       "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
       ],
       "type": "string"
      },
      "open": {
       "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$",
       "type": "string"
      }
     },
     "required": [
      "day",
      "open",
      "close"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "type": "array"
   },
   "loading_notes": {
    "maxLength": 2000,
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "perishables_after_hours": {
    "enum": [
     "return_at_opening",
     "dispose"
    ],
    "type": "string"
   },
   "radius_miles": {
    "exclusiveMinimum": 0,
    "maximum": 5,
    "type": "number"
   },
   "robomart_version": {
    "enum": [
     "2026-09-04",
     "2026-09-06",
     "2026-10-06"
    ],
    "type": "string"
   },
   "robot_spot": {
    "additionalProperties": false,
    "properties": {
     "lat": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lng": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "note": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "required": [
     "lat",
     "lng"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "live",
     "paused"
    ],
    "type": "string"
   },
   "store_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "visibility": {
    "enum": [
     "private",
     "open"
    ],
    "type": "string"
   }
  },
  "required": [
   "store_id"
  ],
  "type": "object"
 },
 "name": "update_store",
 "title": "Update a store"
}
