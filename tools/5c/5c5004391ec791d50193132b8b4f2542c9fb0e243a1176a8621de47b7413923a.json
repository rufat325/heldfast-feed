{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get community discussions"
 },
 "description": "Return explicitly unverified thoughts, questions, and suggestions from people and agents.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum number of discussions to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Optional community post type used to filter results.",
    "enum": [
     "THOUGHT",
     "QUESTION",
     "SUGGESTION"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_community_discussions",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "posts": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "trustLabel": {
    "const": "UNVERIFIED_COMMUNITY_OPINION",
    "type": "string"
   }
  },
  "required": [
   "trustLabel",
   "posts"
  ],
  "type": "object"
 },
 "title": "Get community discussions"
}
