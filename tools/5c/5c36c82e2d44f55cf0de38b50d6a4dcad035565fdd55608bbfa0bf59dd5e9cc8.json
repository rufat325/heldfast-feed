{
 "description": "Match a candidate profile/CV against job data \u2014 identifies fit score, matching skills, career gaps, and strongest narrative angle",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidate_cv": {
    "description": "Candidate's CV or resume as text",
    "type": "string"
   },
   "job_analysis": {
    "additionalProperties": false,
    "description": "Job analysis output from storylenses_analyze_job",
    "properties": {
     "companyName": {
      "type": "string"
     },
     "companyProblem": {
      "type": "string"
     },
     "experienceLevel": {
      "type": "string"
     },
     "industry": {
      "type": "string"
     },
     "jobDeliverable": {
      "type": "string"
     },
     "jobTitle": {
      "type": "string"
     },
     "keySkillsRequired": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "jobTitle",
     "companyName"
    ],
    "type": "object"
   },
   "locale": {
    "default": "en",
    "description": "Response language",
    "enum": [
     "en",
     "de",
     "es",
     "pt"
    ],
    "type": "string"
   }
  },
  "required": [
   "job_analysis",
   "candidate_cv"
  ],
  "type": "object"
 },
 "name": "storylenses_match_profile"
}
