{
 "description": "Traverse the wikilink graph: links (outgoing) | backlinks | neighbors (both directions, to depth).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "depth": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "from": {
    "type": "string"
   },
   "relation": {
    "enum": [
     "links",
     "backlinks",
     "neighbors"
    ],
    "type": "string"
   }
  },
  "required": [
   "from",
   "relation"
  ],
  "type": "object"
 },
 "name": "graph_query"
}
