{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Rename a rule, enable or disable it, or replace its keyword list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "enabled": {
    "type": "boolean"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "keywords": {
    "description": "Replaces the keyword list on keyword rules.",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "rule": {
    "description": "Rule name or ID.",
    "type": "string"
   }
  },
  "required": [
   "rule"
  ],
  "type": "object"
 },
 "name": "update_automod_rule",
 "title": "Update AutoMod rule"
}
