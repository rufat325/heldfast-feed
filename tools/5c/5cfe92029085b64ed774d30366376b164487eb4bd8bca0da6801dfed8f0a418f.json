{
 "description": "List immutable historical assessment attempts for one LMS assignment in chronological order: lifecycle timestamps, exact course/release/module/form pins, mastery run identity, result-release state, and the honest grade projection. Filter with lessonKey; paginate with cursor/limit (max 100). Never returns answer keys, pass thresholds, or attempt policies. Requires lms:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "lessonKey": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "assignmentId"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_list_attempt_evidence",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "description": "The enrollment key: a Project To-do assignment id, or `proposal:<jobOfferId>` for an application-stage screening enrollment (the same key `review`/`grades`/`release-result`/`decision` accept).",
    "minLength": 1,
    "type": "string"
   },
   "attempts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attemptId": {
       "minLength": 1,
       "type": "string"
      },
      "attemptNumber": {
       "minimum": 1,
       "type": "integer"
      },
      "formVersionId": {
       "minLength": 1,
       "type": "string"
      },
      "lessonKey": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "mastery": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "runId": {
           "anyOf": [
            {
             "minLength": 1,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "runNumber": {
           "anyOf": [
            {
             "minimum": 1,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "runStatus": {
           "anyOf": [
            {
             "minLength": 1,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "runId",
          "runNumber",
          "runStatus"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "pins": {
       "additionalProperties": false,
       "properties": {
        "courseId": {
         "anyOf": [
          {
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "courseTitle": {
         "type": [
          "string",
          "null"
         ]
        },
        "courseVersionId": {
         "anyOf": [
          {
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "courseVersionNumber": {
         "anyOf": [
          {
           "minimum": 1,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "lessonKey": {
         "anyOf": [
          {
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "moduleKey": {
         "anyOf": [
          {
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "releaseId": {
         "anyOf": [
          {
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "courseId",
        "courseVersionId",
        "courseVersionNumber",
        "courseTitle",
        "releaseId",
        "moduleKey",
        "lessonKey"
       ],
       "type": "object"
      },
      "projection": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "earnedPoints": {
           "type": [
            "number",
            "null"
           ]
          },
          "passed": {
           "type": [
            "boolean",
            "null"
           ]
          },
          "possiblePoints": {
           "type": [
            "number",
            "null"
           ]
          },
          "state": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "state",
          "earnedPoints",
          "possiblePoints",
          "passed"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "resultReleaseState": {
       "enum": [
        "NOT_APPLICABLE",
        "HELD",
        "RELEASED"
       ],
       "type": "string"
      },
      "resultReleasedAt": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "startedAt": {
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "minLength": 1,
       "type": "string"
      },
      "submittedAt": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "attemptId",
      "lessonKey",
      "attemptNumber",
      "status",
      "startedAt",
      "submittedAt",
      "formVersionId",
      "pins",
      "mastery",
      "resultReleaseState",
      "resultReleasedAt",
      "projection"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "assignmentId",
   "attempts",
   "nextCursor"
  ],
  "type": "object"
 }
}
