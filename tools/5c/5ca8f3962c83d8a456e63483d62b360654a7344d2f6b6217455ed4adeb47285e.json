{
 "description": "Runs the local rule checks, then asks a FluxOS node to verify the specification exactly as it would at registration (image reachable, architecture, ports, name availability). Returns the node-formatted spec on success.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "network": {
    "default": true,
    "description": "Also verify on a FluxOS node.",
    "type": "boolean"
   },
   "spec": {
    "properties": {
     "compose": {
      "items": {
       "properties": {
        "commands": {
         "default": [],
         "description": "Container Cmd, max 20 strings.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "containerData": {
         "description": "Persisted path, e.g. \"r:/data\" (r: = replicated across instances).",
         "type": "string"
        },
        "containerPorts": {
         "default": [],
         "description": "Ports the container listens on, parallel to ports.",
         "items": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "type": "array"
        },
        "cpu": {
         "description": "Cores, 0.1 to 15 in 0.1 steps.",
         "type": "number"
        },
        "description": {
         "maxLength": 256,
         "type": "string"
        },
        "domains": {
         "default": [],
         "description": "Custom domain per port, \"\" for none. Parallel to ports.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "environmentParameters": {
         "default": [],
         "description": "\"KEY=value\" strings, max 20.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "hdd": {
         "description": "GB, 1 to 820.",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "description": "Component name. Defaults to the app name.",
         "maxLength": 63,
         "type": "string"
        },
        "ports": {
         "default": [],
         "description": "Public ports. Prefer 31000-39999.",
         "items": {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         "type": "array"
        },
        "ram": {
         "description": "MB, 100 to 59000 in steps of 100.",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "repoauth": {
         "default": "",
         "description": "\"user:token\" for a private registry, else \"\".",
         "type": "string"
        },
        "repotag": {
         "description": "Docker image with an explicit tag, e.g. \"nginx:1.27-alpine\".",
         "type": "string"
        }
       },
       "required": [
        "repotag",
        "containerData",
        "cpu",
        "ram",
        "hdd"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "minItems": 0,
      "type": "array"
     },
     "contacts": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "description": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "enterprise": {
      "default": "",
      "type": "string"
     },
     "expire": {
      "default": 88000,
      "description": "Term in blocks; 88000 = 1 month.",
      "maximum": 1056000,
      "minimum": 1,
      "type": "integer"
     },
     "geolocation": {
      "default": [],
      "description": "e.g. [\"acEU\"] allow Europe, [\"a!cAS\"] deny Asia.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "instances": {
      "default": 3,
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "name": {
      "maxLength": 63,
      "minLength": 1,
      "type": "string"
     },
     "nodes": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "owner": {
      "description": "Flux ID. Defaults to the configured FLUX_ID_PRIVATE_KEY identity.",
      "type": "string"
     },
     "staticip": {
      "default": false,
      "type": "boolean"
     },
     "version": {
      "const": 8,
      "default": 8,
      "type": "number"
     }
    },
    "required": [
     "name",
     "description",
     "compose"
    ],
    "type": "object"
   }
  },
  "required": [
   "spec"
  ],
  "type": "object"
 },
 "name": "flux_validate_spec",
 "title": "Validate a specification locally and on the network"
}
