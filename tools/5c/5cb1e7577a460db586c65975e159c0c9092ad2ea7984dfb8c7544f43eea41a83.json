{
 "description": "Report a payment to the CRM billing webhook. Activates or deactivates a marketplace app for a location based on payment status. Required for external billing (SaaS subscriptions through Stripe).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Payment amount in dollars",
    "type": "number"
   },
   "auth_type": {
    "description": "Billing scope: location or company",
    "enum": [
     "location",
     "company"
    ],
    "type": "string"
   },
   "company_id": {
    "description": "CRM company ID (for agency-level billing)",
    "type": "string"
   },
   "location_id": {
    "description": "CRM location ID (for location-level billing)",
    "type": "string"
   },
   "payment_id": {
    "description": "External payment ID (e.g. Stripe pi_xxx)",
    "type": "string"
   },
   "payment_type": {
    "description": "Payment type (default: one_time)",
    "enum": [
     "one_time",
     "recurring"
    ],
    "type": "string"
   },
   "status": {
    "description": "Payment status",
    "enum": [
     "COMPLETED",
     "FAILED"
    ],
    "type": "string"
   },
   "subscription_id": {
    "description": "External subscription ID (e.g. Stripe sub_xxx)",
    "type": "string"
   }
  },
  "required": [
   "auth_type",
   "amount",
   "status"
  ],
  "type": "object"
 },
 "name": "crm_report_billing"
}
