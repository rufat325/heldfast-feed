{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A team's next match, live-resolved: a confirmed knockout tie (Round of 32 onward) is read from the live overlay, group fixtures from the bundled schedule. Use a 3-letter code, e.g. MEX, BRA, USA. Falls back to the bundled schedule if the provider is unreachable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "flavor": {
    "description": "Commentary flair: off, subtle, full (default: full)",
    "enum": [
     "off",
     "subtle",
     "full"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Locale for dates, provider attribution, and commentary: en, es, pt, fr (the summary scaffold stays English; other locales fall back to en)",
    "type": "string"
   },
   "team": {
    "description": "3-letter team code, e.g. MEX",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "tz": {
    "description": "IANA timezone for kickoff times, e.g. America/Mexico_City",
    "type": "string"
   }
  },
  "required": [
   "team"
  ],
  "type": "object"
 },
 "name": "get_next_fixture",
