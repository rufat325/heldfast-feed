{
 "description": "Enable or disable synchronize-panes for a window.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "host": {
    "description": "SSH host alias (optional). Uses default host if set.",
    "type": "string"
   },
   "on": {
    "description": "Whether to enable synchronize-panes.",
    "type": "boolean"
   },
   "target": {
    "description": "Window target (session:window or window id).",
    "type": "string"
   }
  },
  "required": [
   "target",
   "on"
  ],
  "type": "object"
 },
 "name": "tmux_set_sync_panes",
 "title": "Toggle synchronize-panes"
}
