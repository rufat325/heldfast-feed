{
 "description": "Fetch historical OHLCV candle data for a given exchange, symbol, and timeframe",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exchange": {
    "description": "Exchange name (binance, bybit, okx)",
    "type": "string"
   },
   "limit": {
    "default": 200,
    "description": "Number of candles to fetch (default 200, max 2000)",
    "type": "number"
   },
   "symbol": {
    "description": "Trading pair symbol (e.g., BTCUSDT)",
    "type": "string"
   },
   "timeframe": {
    "description": "Candle timeframe (1m, 5m, 15m, 1h, 4h, 1d)",
    "type": "string"
   }
  },
  "required": [
   "exchange",
   "symbol",
   "timeframe"
  ],
  "type": "object"
 },
 "name": "query_candles"
}
