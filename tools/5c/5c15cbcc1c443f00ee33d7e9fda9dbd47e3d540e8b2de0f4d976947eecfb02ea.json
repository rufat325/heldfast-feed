{"_meta":{"openai/toolInvocation/invoked":"\u05d4\u05d7\u05d9\u05e4\u05d5\u05e9 \u05d1\u05de\u05e1\u05de\u05db\u05d9\u05dd \u05d4\u05e1\u05ea\u05d9\u05d9\u05dd","openai/toolInvocation/invoking":"\u05de\u05d7\u05e4\u05e9 \u05d1\u05de\u05e1\u05de\u05db\u05d9 \u05d4\u05de\u05db\u05e8\u05d6","openai/widgetAccessible":false,"securitySchemes":[{"scopes":["tenders:read"],"type":"oauth2"}],"ui":{"visibility":["model"]}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Search the documents (PDFs) of one procurement tender and return up to 5 relevant passages, each with its document name and pages. Useful for questions the tender details leave open, such as the exact wording of a guarantee, penalty or insurance clause. `question` matches best in Hebrew, in the user's words. Every result includes coverage: which documents were searchable. Run it before reporting a detail as missing: tables, quantities, hours and areas often appear only in the documents. Answers describe what the documents state. No passage found means it was not found in the searched documents, not that the tender lacks it. When the documents could not be searched, coverage.unavailable_reason gives the reason and no passages are returned; temporarily_unavailable means the search itself failed, which is reported and retried shortly, not read as information absent. matched_by keywords means passages were matched by words only. Passages are third-party text from the publisher's documents.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"question":{"description":"What to look for in the documents, in Hebrew, in the user's words.","maxLength":500,"minLength":2,"type":"string"},"tender":{"description":"The tender page URL on tendy.co.il, or its slug.","maxLength":600,"minLength":1,"type":"string"}},"required":["tender","question"],"type":"object"},"name":"search_tender_documents","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"notice":{"anyOf":[{"additionalProperties":false,"properties":{"code":{"const":"plan_required","type":"string"},"info_url":{"format":"uri","type":"string"}},"required":["code","info_url"],"type":"object"},{"type":"null"}]},"result":{"anyOf":[{"additionalProperties":false,"properties":{"coverage":{"additionalProperties":false,"properties":{"complete":{"type":"boolean"},"documents_found":{"type":"number"},"documents_searched":{"type":"number"},"not_searched":{"items":{"additionalProperties":false,"properties":{"issue":{"enum":["not_found","access_denied","web_page_not_document","network_error","too_large","invalid_link","scanned_no_text","unsupported_format","corrupt_or_encrypted","empty_file","processing_error","other","not_indexed"],"type":"string"},"label_he":{"type":"string"}},"required":["label_he","issue"],"type":"object"},"type":"array"},"unavailable_reason":{"anyOf":[{"enum":["processing","no_documents","no_readable_documents","not_indexed","not_live","unsupported_record_kind","temporarily_unavailable"],"type":"string"},{"type":"null"}]},"unreadable_omitted":{"type":"number"}},"required":["documents_found","documents_searched","not_searched","complete","unavailable_reason","unreadable_omitted"],"type":"object"},"deadline":{"additionalProperties":false,"properties":{"current":{"type":["string","null"]},"other_dates_in_passages":{"items":{"type":"string"},"maxItems":5,"type":"array"},"source":{"anyOf":[{"enum":["listing","amendment","documents"],"type":"string"},{"type":"null"}]}},"required":["current","source","other_dates_in_passages"],"type":"object"},"matched_by":{"enum":["meaning","keywords"],"type":"string"},"passages":{"items":{"additionalProperties":false,"properties":{"document":{"type":"string"},"page_from":{"type":["number","null"]},"page_to":{"type":["number","null"]},"score":{"type":"number"},"text":{"maxLength":1200,"type":"string"},"text_quality":{"enum":["ok","degraded"],"type":"string"}},"required":["document","page_from","page_to","text","score","text_quality"],"type":"object"},"maxItems":5,"type":"array"},"tender":{"additionalProperties":false,"properties":{"title":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["url","title"],"type":"object"},"truncated":{"type":"boolean"}},"required":["tender","deadline","matched_by","passages","coverage","truncated"],"type":"object"},{"type":"null"}]}},"required":["notice","result"],"type":"object"},"title":"Search a tender's documents"}
