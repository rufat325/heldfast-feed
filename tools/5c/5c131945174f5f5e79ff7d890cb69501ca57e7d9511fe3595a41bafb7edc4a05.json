{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List or search manga serialization magazines/publishers (e.g. Weekly Shonen Jump) with their MAL IDs and manga counts. Use `q` to search by name, or look up an ID here for search_manga's `magazines` filter.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "letter": {
    "description": "Restrict results to entries whose title starts with this single letter.",
    "maxLength": 1,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "order_by": {
    "description": "Field to order by.",
    "enum": [
     "mal_id",
     "name",
     "count"
    ],
    "type": "string"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Filter by name.",
    "type": "string"
   },
   "sort": {
    "description": "Sort direction.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_magazines",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page"
  ],
  "type": "object"
 },
 "title": "Get manga magazines"
}
