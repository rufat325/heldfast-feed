{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the claimant or posting operator view using a locally signed GET /v1/bounties/{id}/status proof. Owner acceptance remains unpaid; payout is owner-run and off.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bounty_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    "type": "string"
   },
   "did": {
    "pattern": "^did:voidly:[1-9A-HJ-NP-Za-km-z]{1,32}$",
    "type": "string"
   },
   "nonce": {
    "pattern": "^[0-9a-f]{32}$",
    "type": "string"
   },
   "signature": {
    "pattern": "^[A-Za-z0-9+/]{86}==$",
    "type": "string"
   },
   "timestamp": {
    "pattern": "^[0-9]{10}$",
    "type": "string"
   }
  },
  "required": [
   "bounty_id",
   "did",
   "timestamp",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "voidly_bounty_status",
 "title": "Read private bounty status"
}
