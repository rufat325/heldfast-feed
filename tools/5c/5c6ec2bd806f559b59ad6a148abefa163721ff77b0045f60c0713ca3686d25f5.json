{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "interview"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks for the verdict, score or research status of one of their GoNoGo projects, for example after finishing an interview with Alex. Returns the GO / NO-GO verdict and score, or that the research is still running; the full reports are on the project page. Do not use to start a new interview.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "project_id": {
    "pattern": "^[A-Za-z0-9]{10,40}$",
    "type": "string"
   }
  },
  "required": [
   "project_id"
  ],
  "type": "object"
 },
 "name": "get_project_result",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "research": {
      "type": "string"
     },
     "score": {
      "type": [
       "number",
       "null"
      ]
     },
     "status": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "verdict": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "name",
     "description",
     "status",
     "verdict",
     "score",
     "research",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "interview"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Result of a GoNoGo project"
}
