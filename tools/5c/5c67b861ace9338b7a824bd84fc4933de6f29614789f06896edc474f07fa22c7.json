{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Rename a webhook, change its avatar, or move it to another channel.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "avatar_url": {
    "format": "uri",
    "type": "string"
   },
   "channel": {
    "description": "Move the webhook to this channel.",
    "type": "string"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "webhook": {
    "description": "Webhook name or ID.",
    "type": "string"
   }
  },
  "required": [
   "webhook"
  ],
  "type": "object"
 },
 "name": "update_webhook",
 "title": "Update webhook"
}
