{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return a deterministic ranked shortlist of all relevant classification concepts and codelists. Ranking supports user choice; it is not an automatic selection. Include answer options and context.",
 "inputSchema": {
  "properties": {
   "answer_options": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Answer Options"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "question_text": {
    "title": "Question Text",
    "type": "string"
   },
   "survey_context": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Survey Context"
   }
  },
  "required": [
   "question_text"
  ],
  "title": "recommend_classificationsArguments",
  "type": "object"
 },
 "name": "recommend_classifications",
 "outputSchema": {
  "$defs": {
   "ClassificationRecommendation": {
    "properties": {
     "classification_id": {
      "title": "Classification Id",
      "type": "string"
     },
     "classification_version": {
      "title": "Classification Version",
      "type": "string"
     },
     "codelist_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Codelist Id"
     },
     "codelist_title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Codelist Title"
     },
     "concept": {
      "title": "Concept",
      "type": "string"
     },
     "confidence": {
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "title": "Confidence",
      "type": "string"
     },
     "matched_evidence": {
      "items": {
       "type": "string"
      },
      "title": "Matched Evidence",
      "type": "array"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "reason": {
      "title": "Reason",
      "type": "string"
     },
     "score": {
      "title": "Score",
      "type": "number"
     },
     "source_title": {
      "title": "Source Title",
      "type": "string"
     },
     "source_url": {
      "title": "Source Url",
      "type": "string"
     },
     "usage_mode": {
      "title": "Usage Mode",
      "type": "string"
     }
    },
    "required": [
     "classification_id",
     "name",
     "concept",
     "score",
     "confidence",
     "matched_evidence",
     "reason",
     "usage_mode",
     "classification_version",
     "source_title",
     "source_url"
    ],
    "title": "ClassificationRecommendation",
    "type": "object"
   }
  },
  "properties": {
   "next_action": {
    "title": "Next Action",
    "type": "string"
   },
   "recommendations": {
    "items": {
     "$ref": "#/$defs/ClassificationRecommendation"
    },
    "title": "Recommendations",
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "title": "Warnings",
    "type": "array"
   }
  },
  "required": [
   "recommendations",
   "next_action"
  ],
  "title": "RecommendationResponse",
  "type": "object"
 },
 "title": "Recommend classifications"
}
