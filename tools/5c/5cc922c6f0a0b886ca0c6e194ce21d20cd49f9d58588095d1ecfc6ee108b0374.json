{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search leads"
 },
 "description": "Search/list leads. All filters optional; returns a page of leads. Copper REST: POST /leads/search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_ids": {
    "description": "Filter to leads owned by these user ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "city": {
    "description": "City filter.",
    "type": "string"
   },
   "country": {
    "description": "Country filter.",
    "type": "string"
   },
   "customer_source_ids": {
    "description": "Filter by customer-source ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "emails": {
    "description": "Filter to leads with any of these email addresses.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Lead-name filter (substring match).",
    "type": "string"
   },
   "page_number": {
    "description": "1-based page number to fetch (default 1).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (default 20, max 200).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "sort_by": {
    "description": "Field to sort by, e.g. 'name', 'date_created' (default 'name').",
    "type": "string"
   },
   "sort_direction": {
    "description": "Sort direction \u2014 'asc' or 'desc' (default asc).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "state": {
    "description": "State/region filter.",
    "type": "string"
   },
   "tags": {
    "description": "Filter to leads carrying any of these tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "copper_search_leads",
 "title": "Search leads"
}
