{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "POST /v1/merchants/me/sessions - creates a payment session as if from the dashboard UI. Use this for ad-hoc human-triggered sessions; for programmatic integrations prefer sessions_create_s2s (no JWT renewal).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Total amount in display currency, decimal string.",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "expiresInSec": {
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "lineItems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "quantity": {
       "minimum": 1,
       "type": "integer"
      },
      "total": {
       "pattern": "^\\d+(\\.\\d+)?$",
       "type": "string"
      },
      "unitPrice": {
       "pattern": "^\\d+(\\.\\d+)?$",
       "type": "string"
      }
     },
     "required": [
      "name",
      "quantity",
      "unitPrice",
      "total"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "merchantName": {
    "type": "string"
   },
   "paymentOptionSymbols": {
    "items": {
     "enum": [
      "USDe",
      "USDT",
      "USDC"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "successUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "amount"
  ],
  "type": "object"
 },
 "name": "sessions_create_dashboard",
 "title": "Create a session via the dashboard JWT"
}
