{
 "description": "Create a recurring subscription for a customer (VTEX Subscriptions)",
 "inputSchema": {
  "properties": {
   "customerEmail": {
    "description": "Customer email",
    "type": "string"
   },
   "items": {
    "description": "Items in the subscription (skuId + quantity)",
    "items": {
     "properties": {
      "quantity": {
       "type": "number"
      },
      "skuId": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "nextPurchaseDate": {
    "description": "ISO 8601 datetime of next purchase",
    "type": "string"
   },
   "plan": {
    "description": "Plan / frequency settings",
    "properties": {
     "frequency": {
      "properties": {
       "interval": {
        "type": "number"
       },
       "periodicity": {
        "enum": [
         "daily",
         "weekly",
         "monthly",
         "yearly"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "validity": {
      "properties": {
       "begin": {
        "type": "string"
       },
       "end": {
        "description": "Optional end date",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "purchaseSettings": {
    "description": "Purchase settings (currencyCode, paymentMethod, etc.)",
    "type": "object"
   },
   "shippingAddress": {
    "description": "Shipping address. Must include addressId or full address fields.",
    "type": "object"
   },
   "title": {
    "description": "Subscription title",
    "type": "string"
   }
  },
  "required": [
   "customerEmail",
   "plan",
   "shippingAddress",
   "purchaseSettings",
   "items"
  ],
  "type": "object"
 },
 "name": "create_subscription"
}
