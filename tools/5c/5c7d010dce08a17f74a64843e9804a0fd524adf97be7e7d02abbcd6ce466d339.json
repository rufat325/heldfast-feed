{
 "description": "Update an existing note on a contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "body": {
    "description": "Updated note content / body text",
    "type": "string"
   },
   "contactId": {
    "description": "The contact ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "noteId": {
    "description": "The note ID to update",
    "type": "string"
   },
   "userId": {
    "description": "ID of the user updating the note",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "contactId",
   "noteId"
  ],
  "type": "object"
 },
 "name": "crm_update_contact_note"
}
