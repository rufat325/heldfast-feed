{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants their own picture, words or logo printed on a T-shirt, hoodie, sweatshirt or tote bag and delivered, as a gift or for themselves. Finds products by free text, category, colour and size. Returns product_id, image_url (a product photo, or null), colours, sizes and print placements. No account needed. Not for mugs, posters, caps, stickers or embroidery.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "t-shirt",
     "long-sleeve",
     "sweatshirt",
     "hoodie",
     "tote-bag"
    ],
    "type": "string"
   },
   "color": {
    "description": "Only products available in this colour, e.g. \"black\".",
    "type": "string"
   },
   "query": {
    "description": "Free-text description, e.g. \"heavyweight black t-shirt\" or \"hoodie\".",
    "maxLength": 200,
    "type": "string"
   },
   "size": {
    "description": "Only products available in this size, e.g. \"XL\".",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "note": {
    "type": "string"
   },
   "products": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "category": {
       "type": "string"
      },
      "colors": {
       "description": "Colour ids to pass as color.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "decoration_method": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "image_url": {
       "description": "A product photo, or null when none is approved yet.",
       "type": [
        "string",
        "null"
       ]
      },
      "model": {
       "type": "string"
      },
      "placements": {
       "description": "Placement ids to pass as placement.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "printed_in_regions": {
       "description": "Regions where this product is printed, e.g. [\"EU\", \"US\"].",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "product_id": {
       "description": "Use in get_product, validate_artwork and quote.",
       "type": "string"
      },
      "production_business_days": {
       "additionalProperties": {},
       "properties": {
        "max": {
         "type": [
          "number",
          "null"
         ]
        },
        "min": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "required": [
        "min",
        "max"
       ],
       "type": "object"
      },
      "sizes": {
       "description": "Size values to pass as size.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "product_id",
      "title",
      "image_url",
      "brand",
      "model",
      "category",
      "description",
      "decoration_method",
      "colors",
      "sizes",
      "placements",
      "printed_in_regions",
      "production_business_days"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "products",
   "count",
   "note"
  ],
  "type": "object"
 },
 "title": "Search printable products"
}
