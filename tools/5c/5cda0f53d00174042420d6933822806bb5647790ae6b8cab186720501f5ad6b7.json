{
 "description": "Update an existing custom value for a location.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "customValueId": {
    "description": "The custom value ID to update",
    "type": "string"
   },
   "locationId": {
    "description": "The location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "name": {
    "description": "Custom value name / label",
    "type": "string"
   },
   "value": {
    "description": "The custom value content",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId",
   "customValueId"
  ],
  "type": "object"
 },
 "name": "crm_update_custom_value"
}
