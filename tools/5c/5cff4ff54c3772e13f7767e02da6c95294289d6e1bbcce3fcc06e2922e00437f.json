{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/web.page-pack",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Pack supplied HTML into bounded readable blocks with source, truncation and size estimates. No model, fetching or guaranteed token savings. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "html": {
      "maxLength": 100000,
      "type": "string"
     },
     "maxChars": {
      "default": 6000,
      "maximum": 12000,
      "minimum": 256,
      "type": "integer"
     },
     "sourceUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "web_page_pack",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "contentChars": {
    "type": "number"
   },
   "measurement": {
    "additionalProperties": false,
    "properties": {
     "estimateMethod": {
      "type": "string"
     },
     "estimatedInputTokens": {
      "type": "number"
     },
     "estimatedPayloadTokens": {
      "type": "number"
     },
     "inputBytes": {
      "type": "number"
     },
     "payloadBytes": {
      "type": "number"
     }
    },
    "required": [
     "inputBytes",
     "payloadBytes",
     "estimatedInputTokens",
     "estimatedPayloadTokens",
     "estimateMethod"
    ],
    "type": "object"
   },
   "omittedChars": {
    "type": "number"
   },
   "scope": {
    "type": "string"
   },
   "selection": {
    "type": "string"
   },
   "sourceUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "sourceUrl",
   "title",
   "content",
   "contentChars",
   "truncated",
   "omittedChars",
   "selection",
   "scope",
   "measurement"
  ],
  "type": "object"
 }
}
