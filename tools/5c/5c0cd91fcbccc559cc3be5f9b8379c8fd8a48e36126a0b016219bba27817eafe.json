{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get the audit log"
 },
 "description": "Who changed what on one day: the account audit log (timestamp, product, resource, action, actor and a diff). Paginate with continuation_token. bunny.net: GET /user/audit/{date}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actor_id": {
    "description": "Only changes by these actors.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "continuation_token": {
    "description": "ContinuationToken from the previous page.",
    "type": "string"
   },
   "date": {
    "description": "The day to read, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Max entries, 1-10000. Default 100.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "order": {
    "description": "Sort by time.",
    "enum": [
     "Ascending",
     "Descending"
    ],
    "type": "string"
   },
   "product": {
    "description": "Only these products.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resource_id": {
    "description": "Only these resource IDs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resource_type": {
    "description": "Only these resource types.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "bunny_get_audit_log",
 "title": "Get the audit log"
}
