{
 "description": "Create a sale in Conta Azul",
 "inputSchema": {
  "properties": {
   "customer_id": {
    "description": "Customer UUID",
    "type": "string"
   },
   "emission": {
    "description": "Emission date (YYYY-MM-DD)",
    "type": "string"
   },
   "notes": {
    "description": "Sale notes",
    "type": "string"
   },
   "products": {
    "description": "Sale line items",
    "items": {
     "properties": {
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "value": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "Sale status",
    "enum": [
     "COMMITTED",
     "PENDING"
    ],
    "type": "string"
   }
  },
  "required": [
   "customer_id",
   "emission",
   "status",
   "products"
  ],
  "type": "object"
 },
 "name": "create_sale"
}
