       "type": "string"
      },
      "to": {
       "description": "The name of the entity where the relation ends",
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "relationType"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
