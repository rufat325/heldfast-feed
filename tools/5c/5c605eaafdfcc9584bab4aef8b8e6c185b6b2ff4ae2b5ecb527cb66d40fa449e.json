 "description": "Search stored public research abstracts and industry source records by keywords, topic, academic/industry category and time window. days=0 searches all stored dates. This tool searches source records; it does not claim they are editor-reviewed news.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "academic": {
    "default": "all",
    "enum": [
     "all",
     "academic",
     "industry"
    ],
    "type": "string"
   },
   "company": {
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9_-]*$",
    "type": "string"
   },
   "days": {
    "default": 30,
    "maximum": 3660,
    "minimum": 0,
    "type": "integer"
   },
   "journal_tier": {
    "default": "selected",
    "enum": [
     "selected",
     "all"
    ],
    "type": "string"
   },
   "language": {
    "description": "Optional presentation language. Omit for legacy copy. Source text remains in its original language.",
    "enum": [
     "zh-CN",
     "zh-Hant",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "default": "",
    "maxLength": 200,
    "type": "string"
   },
   "topic": {
    "enum": [
     "virtual-cell",
     "organoid",
     "virtual-embryo",
     "virtual-organ",
     "drug-discovery"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
