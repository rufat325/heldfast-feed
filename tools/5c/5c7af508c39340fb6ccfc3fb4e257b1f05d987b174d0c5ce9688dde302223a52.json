{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks whether a URL carries CoinRebate's own current referral code (allowlisted exchange hosts only). This is a self-check for CoinRebate links: a link carrying someone else's code is reported as stale_code even though it may be perfectly valid. For a neutral inspection of any exchange link, use inspect_exchange_link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Exchange referral URL to validate",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_referral_link",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "carries_current_code": {
    "type": "boolean"
   },
   "code_expected": {
    "type": [
     "string",
     "null"
    ]
   },
   "code_owner": {
    "enum": [
     "coinrebate_current",
     "coinrebate_retired",
     "other_or_none"
    ],
    "type": "string"
   },
   "exchange": {
    "type": [
     "string",
     "null"
    ]
   },
   "final_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "http_status": {
    "type": [
     "number",
     "null"
    ]
   },
   "known_host": {
    "type": "boolean"
   },
   "official_link": {
    "type": [
     "string",
     "null"
    ]
   },
   "reachability_note": {
    "anyOf": [
     {
      "enum": [
       "waf_challenge"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scope_note": {
    "type": "string"
   },
   "url": {
    "type": "string"
   },
   "verdict": {
    "enum": [
     "unknown_host",
     "unreachable",
     "valid",
     "stale_code"
    ],
    "type": "string"
   }
  },
  "required": [
   "url",
   "exchange",
   "known_host",
   "carries_current_code",
   "code_expected",
   "http_status",
   "final_url",
   "verdict",
   "official_link"
  ],
  "type": "object"
 }
}
