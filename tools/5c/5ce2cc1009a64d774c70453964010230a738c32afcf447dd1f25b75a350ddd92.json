{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start PyLaia HTR model training for a collection. By default, sends training parameters matching the Transkribus UI defaults (textFeatsCfg with TextFeats preprocessing, use_masked_conv=True, max_epochs=100). Without these defaults, the server uses different preprocessing (trpPreprocPars) which produces significantly worse models. Set noTrainingDefaults=true to send no training parameters (server defaults).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "baseModelId": {
    "description": "Base model ID for transfer learning",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "batch_size": {
    "description": "Batch size (default: 24). Shortcut for trainCtcPars --batch_size.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "createModelPars": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Model architecture parameters as key-value pairs (e.g. {\"--rnn_units\": \"512\"}). Merged with UI defaults (use_masked_conv=True, cnn_poolsize=\"2 2 0 2\", etc.). Only specify parameters you want to override.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "customAbbrevsTraining": {
    "description": "Enable custom abbreviations training",
    "type": "boolean"
   },
   "customTagTraining": {
    "description": "Enable custom tag training",
    "type": "boolean"
   },
   "description": {
    "description": "Description of the model",
    "type": "string"
   },
   "imgType": {
    "description": "Image type",
    "type": "string"
   },
   "language": {
    "description": "Language code (e.g. \"rus\", \"deu\", \"eng\")",
    "type": "string"
   },
   "learning_rate": {
    "description": "Learning rate (default: 3.0E-4). Shortcut for trainCtcPars --learning_rate.",
    "type": "number"
   },
   "max_epochs": {
    "description": "Maximum training epochs (default: 100). Shortcut for trainCtcPars --max_epochs.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "max_nondecreasing_epochs": {
    "description": "Early stopping patience (default: 20). Shortcut for trainCtcPars --max_nondecreasing_epochs.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "modelName": {
    "description": "Name for the new model",
    "type": "string"
   },
   "noTrainingDefaults": {
    "description": "If true, do NOT apply UI-default training parameters. The server will use its own defaults (which differ from the UI and may produce worse models).",
    "type": "boolean"
   },
   "omitLinesByTag": {
    "description": "Tags of lines to omit from training",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "provider": {
    "default": "PyLaia",
    "description": "Training provider (default: \"PyLaia\")",
    "type": "string"
   },
   "reverseText": {
    "description": "Whether to reverse text direction",
    "type": "boolean"
   },
   "testList": {
    "description": "Test page list",
    "items": {
     "properties": {
      "docId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "pageId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "docId",
      "pageId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "testListFile": {
    "description": "Absolute path to JSON file containing test page list array of {docId, pageId} objects. Example: /tmp/transkribus-training/test_list.json",
    "type": "string"
   },
   "textFeatsCfg": {
    "description": "TextFeats preprocessing config override. Merged with UI defaults (normheight=64, deslope/deslant=true, enh=true). Only specify fields you want to change.",
    "properties": {
     "deslant": {
      "type": "boolean"
     },
     "deslope": {
      "type": "boolean"
     },
     "enh": {
      "type": "boolean"
     },
     "enh_prm": {
      "type": "number"
     },
     "enh_win": {
      "type": "number"
     },
     "fcontour": {
      "type": "boolean"
     },
     "fcontour_dilate": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "format": {
      "type": "string"
     },
     "fpgram": {
      "type": "boolean"
     },
     "maxwidth": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "momentnorm": {
      "type": "boolean"
     },
     "normheight": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "normxheight": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "padding": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "stretch": {
      "type": "boolean"
     },
     "type": {
      "type": "string"
     },
     "verbose": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "trainCtcPars": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "CTC training parameters as key-value pairs (e.g. {\"--max_epochs\": \"200\"}). Merged with UI defaults (max_epochs=100, learning_rate=3.0E-4, batch_size=24, etc.). Only specify parameters you want to override.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "trainList": {
    "description": "Training page list",
    "items": {
     "properties": {
      "docId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "pageId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "docId",
      "pageId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trainListFile": {
    "description": "Absolute path to JSON file containing training page list array of {docId, pageId} objects. Example: /tmp/transkribus-training/train_list.json",
    "type": "string"
   },
   "trainProperties": {
    "description": "Enable training properties",
    "type": "boolean"
   }
  },
  "required": [
   "collId"
  ],
  "type": "object"
 },
 "name": "transkribus_pylaia_train",
 "title": "Train PyLaia Model"
}
