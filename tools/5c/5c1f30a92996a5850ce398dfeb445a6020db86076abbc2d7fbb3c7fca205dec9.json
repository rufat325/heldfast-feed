{
 "description": "Search and list deals (leads) in amoCRM. Supports filtering by pipeline, statuses, and full-text search. Use 'with' to embed contacts or loss reasons.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Items per page (max 250, default 50)",
    "maximum": 250,
    "type": "number"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "pipeline_id": {
    "description": "Filter by pipeline ID",
    "type": "number"
   },
   "query": {
    "description": "Search query across lead name, contacts, companies",
    "type": "string"
   },
   "statuses": {
    "description": "Filter by statuses: array of {pipeline_id, status_id}",
    "items": {
     "additionalProperties": false,
     "properties": {
      "pipeline_id": {
       "type": "number"
      },
      "status_id": {
       "type": "number"
      }
     },
     "required": [
      "pipeline_id",
      "status_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "with": {
    "description": "Related entities to embed in response",
    "items": {
     "enum": [
      "contacts",
      "loss_reason",
      "catalog_elements",
      "is_price_modified_by_robot",
      "source_id"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_leads"
}
