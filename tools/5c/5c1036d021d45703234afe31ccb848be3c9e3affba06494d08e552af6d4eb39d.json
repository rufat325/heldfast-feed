    "enum": [
     "deployment",
     "auth",
     "payments",
     "bug_fix",
     "performance",
     "other"
    ],
    "type": "string"
   },
   "difficulty": {
    "description": "Filter by difficulty",
    "enum": [
     "easy",
     "medium",
     "hard"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results to return (default 20, max 50)",
    "type": "number"
   },
   "platform": {
    "description": "Filter by vibe coding platform",
    "enum": [
     "cursor",
     "bolt",
     "lovable",
     "replit",
     "v0",
     "other"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vibefix_list_bounties"
}
