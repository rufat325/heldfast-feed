{
 "description": "Search for tokens by name, symbol, or contract address in the deBridge token database",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chainId": {
    "description": "Filter by chain ID",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 10)",
    "type": "number"
   },
   "name": {
    "description": "Filter by token name (partial, case-insensitive)",
    "type": "string"
   },
   "query": {
    "description": "Token name, symbol, or contract address",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_tokens"
}
