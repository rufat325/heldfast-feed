{
 "_meta": {
  "openai/toolInvocation/invoked": "Searched Relomote jobs",
  "openai/toolInvocation/invoking": "Searching Relomote jobs",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search jobs"
 },
 "description": "Search live job listings on Relomote, collected from company career pages. board \"remote\" (default) finds remote and hybrid jobs a person can do from a given country, region or anywhere in the world; for a country it also includes jobs open to its whole region and jobs open worldwide, since those are open from there too. board \"relocation\" finds jobs abroad that offer relocation support or visa sponsorship; there the location is where the job moves the person to. Returns at most 10 jobs per call, newest first, each with a link to its Relomote page, where the person reads the full listing and applies. A search returns at most 3 pages.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "board": {
    "description": "\"remote\" (default) or \"relocation\" (relocation support or visa sponsorship).",
    "enum": [
     "remote",
     "relocation"
    ],
    "type": "string"
   },
   "category": {
    "description": "Job category.",
    "enum": [
     "Engineering & Development",
     "Customer Support",
     "Design",
     "Marketing",
     "Sales",
     "Product",
     "Data & Analytics",
     "People & Talent",
     "Writing & Content Creation",
     "Finance",
     "Legal & Compliance",
     "Operations & Admin",
     "Data Entry",
     "Virtual Assistant",
     "Education & Training",
     "Healthcare & Nursing",
     "Construction & Built Environment",
     "Skilled Trades & Field Service",
     "Research & Science",
     "Real Estate & Property",
     "Retail & Merchandising",
     "Other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "A country (\"Nigeria\", \"Philippines\", \"DE\"), a region (Africa, Asia, Europe, Latin America, Middle East, North America, Oceania) or \"worldwide\" (remote board only: jobs open from anywhere).",
    "type": "string"
   },
   "page": {
    "default": 1,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Job title or keywords, e.g. \"customer support\", \"data analyst\", \"react developer\". Omit to list the newest jobs for the filters.",
    "maxLength": 100,
    "type": "string"
   },
   "visa_sponsorship": {
    "description": "Only jobs that sponsor a work visa. Implies the relocation board.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_jobs",
 "outputSchema": {
  "properties": {
   "board": {
    "enum": [
     "remote",
     "relocation"
    ],
    "type": "string"
   },
   "has_more": {
    "type": "boolean"
   },
   "jobs": {
    "items": {
     "properties": {
      "board": {
       "enum": [
        "remote",
        "relocation"
       ],
       "type": "string"
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
