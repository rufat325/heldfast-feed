       "type": [
        "string",
        "null"
       ]
      },
      "logo_url": {
       "description": "The company's logo, a 128px image.",
       "type": [
        "string",
        "null"
       ]
      },
      "posted": {
       "description": "YYYY-MM-DD",
       "type": "string"
      },
      "relocation_support": {
