{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List organizational conditions (identity, label, guide count, causal-role counts). Filter by draft domain, subdomain, or causal_role (driver|mediator|outcome). Names and counts only \u2014 no addresses, no passages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "causal_role": {
    "description": "driver | mediator | outcome. Unknown values match nothing.",
    "type": "string"
   },
   "domain": {
    "description": "Draft domain slug, e.g. organizational-structure-and-culture.",
    "type": "string"
   },
   "id": {
    "description": "Exact condition_identity_id. When set, other filters are ignored.",
    "type": "string"
   },
   "limit": {
    "description": "Cap rows returned. Default 100, max 500.",
    "type": "number"
   },
   "q": {
    "description": "Substring match on the condition label.",
    "type": "string"
   },
   "subdomain": {
    "description": "Draft sub-domain slug, e.g. organizational-learning-and-improvement.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_conditions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address_status": {
    "const": "draft",
    "type": "string"
   },
   "api_version": {
    "type": "string"
   },
   "conditions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "causal_roles": {
       "additionalProperties": false,
       "properties": {
        "driver": {
         "type": "number"
        },
        "mediator": {
         "type": "number"
        },
        "outcome": {
         "type": "number"
        }
       },
       "required": [
        "driver",
        "mediator",
        "outcome"
       ],
       "type": "object"
      },
      "condition_identity_id": {
       "type": "string"
      },
      "domain": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "guide_corroboration_count": {
       "type": "number"
      },
      "label": {
       "type": "string"
      },
      "subdomain": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "condition_identity_id",
      "label",
      "guide_corroboration_count",
      "causal_roles",
      "domain",
      "subdomain"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "filters": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "taxonomy": {
    "additionalProperties": false,
    "properties": {
     "domains": {
      "type": "number"
     },
     "identities": {
      "type": "number"
     },
     "subdomains": {
      "type": "number"
     }
    },
    "required": [
     "domains",
     "subdomains",
     "identities"
    ],
    "type": "object"
   },
   "total_matching": {
    "type": "number"
   }
  },
  "required": [
   "api_version",
   "address_status",
   "filters",
   "count",
   "total_matching",
   "taxonomy",
   "conditions"
  ],
  "type": "object"
 },
 "title": "List organizational conditions"
}
