{
 "_meta": {
  "openai/outputTemplate": "ui://croncool/job-detail-v2.html",
  "openai/toolInvocation/invoked": "Croncool job ready.",
  "openai/toolInvocation/invoking": "Loading Croncool job\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://croncool/job-detail-v2.html"
  },
  "ui/resourceUri": "ui://croncool/job-detail-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get cron job details"
 },
 "description": "Use this when someone asks about one cron job's schedule or target, or whether it is enabled and last succeeded. Returns the job's name, cron expression, type, target origin, HTTP method, content type, enabled state and last run status and time, or not-found. Not for running the job.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "jobId": {
    "description": "Job id (uuid)",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "get_job",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "job": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "contentType": {
        "anyOf": [
         {
          "maxLength": 120,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "enabled": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "expression": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "httpMethod": {
        "anyOf": [
         {
          "maxLength": 16,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 128,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastExecutionStatus": {
        "anyOf": [
         {
          "enum": [
           "success",
           "failure"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastExecutionTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "projectId": {
        "anyOf": [
         {
          "maxLength": 128,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "targetOrigin": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "type": {
        "anyOf": [
         {
          "maxLength": 60,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "projectId",
       "name",
       "expression",
       "type",
       "targetOrigin",
       "httpMethod",
       "contentType",
       "enabled",
       "lastExecutionTime",
       "lastExecutionStatus",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null when not found, including another organization's job. Request payloads and credential-bearing URL paths, queries, fragments and userinfo are never returned."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "job"
  ],
  "type": "object"
 },
 "title": "Get cron job details"
}
