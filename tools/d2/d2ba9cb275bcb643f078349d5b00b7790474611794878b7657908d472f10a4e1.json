{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update custom field definition"
 },
 "description": "Update an existing custom field definition by ID. Requires custom_fields:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "display_order": {
    "description": "Display order",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "entity_type": {
    "description": "Entity type",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "field_label": {
    "description": "Display label",
    "maxLength": 200,
    "type": "string"
   },
   "field_name": {
    "description": "Field name / key",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "field_options": {
    "description": "Options for select-type fields",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "field_type": {
    "description": "Field data type",
    "enum": [
     "text",
     "number",
     "date",
     "boolean",
     "select"
    ],
    "type": "string"
   },
   "id": {
    "description": "Custom field definition ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "is_required": {
    "description": "Whether the field is required",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_custom_field_definition",
 "title": "Update custom field definition"
}
