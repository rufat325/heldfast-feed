{
 "description": "Score a prospect against your Ideal Customer Profile (ICP). Returns a fit score, tier, breakdown, and disqualification flags.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "icp": {
    "additionalProperties": false,
    "properties": {
     "mustHaveAttributes": {
      "description": "Deal-breaker requirements",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "niceToHaveAttributes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "targetCompanySizes": {
      "items": {
       "enum": [
        "1-10",
        "11-50",
        "51-200",
        "201-500",
        "501-1000",
        "1000+"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "targetGeographies": {
      "description": "Countries or regions",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "targetIndustries": {
      "description": "Industries you sell into",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "targetTitles": {
      "description": "Job titles of decision makers",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "targetIndustries",
     "targetCompanySizes",
     "targetTitles",
     "targetGeographies"
    ],
    "type": "object"
   },
   "prospect": {
    "additionalProperties": false,
    "properties": {
     "attributes": {
      "description": "Known attributes of this prospect",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "companySize": {
      "enum": [
       "1-10",
       "11-50",
       "51-200",
       "201-500",
       "501-1000",
       "1000+"
      ],
      "type": "string"
     },
     "contactTitle": {
      "type": "string"
     },
     "geography": {
      "type": "string"
     },
     "industry": {
      "type": "string"
     }
    },
    "required": [
     "industry",
     "companySize",
     "contactTitle",
     "geography"
    ],
    "type": "object"
   }
  },
  "required": [
   "icp",
   "prospect"
  ],
  "type": "object"
 },
 "name": "score_icp"
}
