{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Add a custom pattern-based tech debt rule.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Debt category",
    "enum": [
     "dependency",
     "code-quality",
     "architecture",
     "documentation",
     "testing",
     "security",
     "performance",
     "maintainability"
    ],
    "type": "string"
   },
   "flags": {
    "description": "Optional: regex flags (g, i, m, s, etc.)",
    "type": "string"
   },
   "id": {
    "description": "Unique identifier for the rule",
    "type": "string"
   },
   "languages": {
    "description": "Optional: apply only to specific languages",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "description": "Issue title/message",
    "type": "string"
   },
   "pattern": {
    "description": "Regex pattern to match",
    "type": "string"
   },
   "severity": {
    "description": "Issue severity level",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "suggestion": {
    "description": "Optional: how to fix the issue",
    "type": "string"
   }
  },
  "required": [
   "id",
   "pattern",
   "message",
   "severity",
   "category"
  ],
  "type": "object"
 },
 "name": "add_custom_rule"
}
