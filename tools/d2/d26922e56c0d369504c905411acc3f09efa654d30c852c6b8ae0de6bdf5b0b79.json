{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get profile"
 },
 "description": "Returns the authenticated account's profile, resume text, preferences and profileIdentityVersion snapshot. resumeUrl is null when the stored resume file is inline rather than a link; resumeText carries its contents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Current profile plus the re-verify nudge flag set when the default resume changed.",
  "properties": {
   "prefsVerifyPending": {
    "type": "boolean"
   },
   "profile": {
    "additionalProperties": false,
    "description": "Full user_profiles row (client-safe preferences) as returned by GET /profile.",
    "properties": {
     "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "mailingCountryHint": {
      "anyOf": [
       {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "type": "string"
     },
     "nameStatus": {
      "enum": [
       "pending",
       "resolved"
      ],
      "type": "string"
     },
     "phone": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "phoneDialCode": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "preferences": {
      "anyOf": [
       {
        "additionalProperties": {},
        "description": "Open-ended job-preferences JSON; documented keys are stable, unknown keys are allowed and expected.",
        "properties": {
         "acceptedWorkModes": {
          "items": {
           "enum": [
            "remote",
            "hybrid",
            "onsite"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "address": {
          "type": "string"
         },
         "applicationProfile": {
          "additionalProperties": false,
          "description": "User-confirmed, country-specific work authorization and sponsorship answers used by onboarding and application adapters.",
          "properties": {
           "eligibility": {
            "additionalProperties": false,
            "properties": {
             "countries": {
              "items": {
               "additionalProperties": false,
               "properties": {
                "authorized": {
                 "type": "boolean"
                },
                "basis": {
                 "enum": [
                  "citizen",
                  "permanent_resident",
                  "asylee_or_refugee",
                  "temporary_work_auth",
                  "not_authorized"
                 ],
                 "type": "string"
                },
                "code": {
                 "description": "ISO-3166-1 alpha-2 country code",
                 "pattern": "^[A-Z]{2}$",
                 "type": "string"
                },
                "requiresSponsorship": {
                 "type": "boolean"
                }
               },
               "required": [
                "code",
                "authorized",
                "requiresSponsorship",
                "basis"
               ],
               "type": "object"
              },
              "maxItems": 20,
              "type": "array"
             }
            },
            "required": [
             "countries"
            ],
            "type": "object"
           }
          },
          "required": [
           "eligibility"
          ],
          "type": "object"
         },
         "coverLettersEnabled": {
          "type": "boolean"
         },
         "dealBreakers": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "functions": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "locations": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "mailingAddress": {
          "anyOf": [
           {
            "additionalProperties": {},
            "properties": {
             "city": {
              "type": "string"
             },
             "country": {
              "type": "string"
             },
             "formatted": {
              "type": "string"
             },
             "line1": {
              "type": "string"
             },
             "line2": {
              "type": "string"
             },
             "postalCode": {
              "type": "string"
             },
             "region": {
              "type": "string"
             },
             "regionCode": {
              "type": "string"
             },
             "source": {
              "type": "string"
             },
             "updatedAt": {
              "type": "string"
             }
            },
            "required": [
             "line1",
             "city",
             "region",
             "postalCode",
             "country"
            ],
            "type": "object"
           },
           {
            "type": "null"
           }
          ],
          "description": "Structured mailing address captured from address autocomplete; null when cleared."
         },
         "preferredLocations": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "preferredPlaces": {
          "items": {
           "additionalProperties": false,
           "description": "Resolved city, region, and country metadata for a preferred work location.",
           "properties": {
            "city": {
             "anyOf": [
              {
               "maxLength": 120,
               "minLength": 1,
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "countryCode": {
             "pattern": "^[A-Z]{2}$",
             "type": "string"
            },
            "label": {
             "maxLength": 160,
             "minLength": 1,
             "type": "string"
            },
            "lat": {
             "anyOf": [
              {
               "maximum": 90,
               "minimum": -90,
               "type": "number"
              },
              {
               "type": "null"
              }
             ]
            },
            "lng": {
             "anyOf": [
              {
               "maximum": 180,
               "minimum": -180,
               "type": "number"
              },
              {
               "type": "null"
              }
             ]
            },
            "placeId": {
             "anyOf": [
              {
               "maxLength": 256,
               "minLength": 1,
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "region": {
             "anyOf": [
              {
               "maxLength": 120,
               "minLength": 1,
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "regionCode": {
             "anyOf": [
              {
               "maxLength": 12,
               "minLength": 1,
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "resolverVersion": {
             "anyOf": [
              {
               "maxLength": 64,
               "minLength": 1,
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "source": {
             "enum": [
              "google_places",
              "gazetteer"
             ],
             "type": "string"
            }
           },
           "required": [
            "label",
            "city",
            "region",
            "regionCode",
            "countryCode",
            "lat",
            "lng",
            "source"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "remote": {
          "type": "boolean"
         },
         "remotePreference": {
          "anyOf": [
           {
            "enum": [
             "REMOTE",
             "ONSITE"
            ],
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "roles": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "salaryMax": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "salaryMin": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "willingToRelocate": {
          "type": "boolean"
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "profileIdentityVersion": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "resumeText": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resumeUrl": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "tonePreferences": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "updatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
      "type": "string"
     },
     "userId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "id",
     "userId",
     "name",
     "email",
     "phone",
     "phoneDialCode",
     "resumeText",
     "resumeUrl",
     "profileIdentityVersion",
     "preferences",
     "tonePreferences",
     "createdAt",
     "updatedAt",
     "nameStatus"
    ],
    "type": "object"
   }
  },
  "required": [
   "profile",
   "prefsVerifyPending"
  ],
  "type": "object"
 },
 "title": "Get profile"
}
