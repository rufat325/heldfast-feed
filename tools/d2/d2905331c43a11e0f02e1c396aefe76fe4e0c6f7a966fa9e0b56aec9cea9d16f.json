{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Assign a profile to many objects at once",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "objectIds": {
      "description": "Capped at 500 per request. Paginate larger lists by issuing\nmultiple requests.\n",
      "example": [
       "acme.com",
       "stripe.com",
       "framer.com"
      ],
      "items": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 500,
      "minItems": 1,
      "type": "array"
     },
     "objectType": {
      "enum": [
       "company",
       "contact"
      ],
      "type": "string"
     },
     "profileId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "profileId",
     "objectType",
     "objectIds"
    ],
    "type": "object"
   }
  },
  "required": [
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "scoring-assignment-bulk-create"
}
