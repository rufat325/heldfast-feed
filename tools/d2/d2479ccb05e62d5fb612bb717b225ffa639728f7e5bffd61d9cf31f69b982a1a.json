{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set GPS coordinates on one or more photos. Each photo path is paired with a lat/lng.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lats": {
    "description": "Latitudes (parallel to paths)",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "lngs": {
    "description": "Longitudes (parallel to paths)",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "myMapId": {
    "description": "Custom map ID to scope to",
    "type": "number"
   },
   "paths": {
    "description": "File paths in Nextcloud storage",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "paths",
   "lats",
   "lngs"
  ],
  "type": "object"
 },
 "name": "place_map_photos",
 "title": "Place Map Photos"
}
