{
 "description": "Create a QR code that adds a calendar event when scanned. Encodes a standard iCalendar VEVENT that calendar apps can import.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "background_color": {
    "description": "Hex color for background.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "corner_style": {
    "description": "Corner shape.",
    "enum": [
     "square",
     "extra-rounded",
     "dot"
    ],
    "type": "string"
   },
   "description": {
    "description": "Event description.",
    "type": "string"
   },
   "dot_style": {
    "description": "Dot shape.",
    "enum": [
     "square",
     "rounded",
     "dots",
     "classy-rounded"
    ],
    "type": "string"
   },
   "end": {
    "description": "Event end date-time in ISO 8601 format.",
    "type": "string"
   },
   "foreground_color": {
    "description": "Hex color for dots.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "format": {
    "default": "svg",
    "description": "Image format.",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "frame_color": {
    "description": "Frame background color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "frame_style": {
    "description": "Frame style around QR.",
    "enum": [
     "none",
     "banner_bottom",
     "banner_top",
     "rounded"
    ],
    "type": "string"
   },
   "frame_text": {
    "description": "CTA text on frame (max 30 chars).",
    "maxLength": 30,
    "type": "string"
   },
   "frame_text_color": {
    "description": "Frame text color.",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "label": {
    "description": "Label for this QR code.",
    "type": "string"
   },
   "location": {
    "description": "Event location.",
    "type": "string"
   },
   "logo_url": {
    "description": "Logo URL or data URI.",
    "type": "string"
   },
   "start": {
    "description": "Event start date-time in ISO 8601 format (e.g. 2026-03-15T09:00:00Z).",
    "type": "string"
   },
   "summary": {
    "description": "Event title/summary.",
    "type": "string"
   }
  },
  "required": [
   "summary",
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "create_event_qr"
}
