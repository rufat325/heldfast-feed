 "description": "Records the company facts the intake asks for: legal name, entity type, the state (or, for a non-US company, the country) it was incorporated in, the formation date, the company's own address (and registered_address_source NEED_ASSISTANCE when that address is Lovie's mailbox), and \u2014 for a US company \u2014 its registered agent's name and address. entity_type is C_CORP, S_CORP, LLC or OTHER for a US company and LLC or OTHER for a non-US one; any other pairing reads as unanswered. entity_type_other optionally describes an OTHER and is cleared for any other type. Only the paths named in the field mask are written, and each one lands attributed to the person who answered. The employer identification number is accepted but never required \u2014 a company formed days ago will not have one for weeks, and its absence does not hold the intake up.",
 "inputSchema": {
  "properties": {
   "onboarding": {
    "properties": {
     "companyId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "countryOfIncorporation": {
      "maxLength": 2,
      "pattern": "^([A-Z]{2})?$",
      "type": "string"
     },
     "createdAt": {
      "format": "date-time",
      "type": "string"
     },
     "documents": {
      "items": {
       "properties": {
        "contentType": {
         "maxLength": 100,
         "pattern": "^[a-zA-Z0-9/.+-]*$",
         "type": "string"
        },
        "fileName": {
         "maxLength": 255,
         "type": "string"
        },
        "id": {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        "kind": {
         "enum": [
          "EQUITY_ONBOARDING_DOCUMENT_KIND_UNSPECIFIED",
          "EQUITY_ONBOARDING_DOCUMENT_KIND_CERTIFICATE_OF_INCORPORATION",
          "EQUITY_ONBOARDING_DOCUMENT_KIND_EIN_LETTER"
         ],
         "type": "string"
        },
        "sizeBytes": {
         "minimum": 0,
         "type": "integer"
        },
        "uploadedAt": {
         "format": "date-time",
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     },
     "einNumber": {
      "maxLength": 10,
      "pattern": "^([0-9]{2}-[0-9]{7})?$",
      "type": "string"
     },
     "entityType": {
      "maxLength": 20,
      "pattern": "^(C_CORP|LLC|S_CORP|OTHER)?$",
      "type": "string"
     },
     "entityTypeOther": {
      "maxLength": 100,
      "type": "string"
     },
     "formationDate": {
      "maxLength": 10,
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "formationId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "id": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "legalName": {
      "description": "Human-readable name (1-255 Unicode chars).",
      "properties": {
       "value": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "nonUs": {
      "type": "boolean"
     },
     "prefillPercent": {
      "maximum": 100,
      "minimum": 0,
      "type": "integer"
     },
     "provenance": {
      "items": {
       "properties": {
        "confidence": {
         "type": "number"
        },
        "confirmedAt": {
         "format": "date-time",
         "type": "string"
        },
        "fieldPath": {
         "maxLength": 200,
         "minLength": 1,
         "pattern": "^[a-z0-9_]+(\\[[0-9a-f-]+\\])?(\\.[a-z0-9_]+(\\[[0-9a-f-]+\\])?)*$",
         "type": "string"
        },
        "origin": {
         "enum": [
          "PROVENANCE_ORIGIN_UNSPECIFIED",
          "PROVENANCE_ORIGIN_INVITE",
          "PROVENANCE_ORIGIN_FORMATION",
          "PROVENANCE_ORIGIN_CAP_TABLE",
          "PROVENANCE_ORIGIN_IDENTITY_PROFILE",
          "PROVENANCE_ORIGIN_EXTRACTED_DOCUMENT",
          "PROVENANCE_ORIGIN_PROVIDER",
          "PROVENANCE_ORIGIN_USER",
          "PROVENANCE_ORIGIN_DEFAULT"
         ],
         "type": "string"
        },
        "sourceDocumentId": {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        "sourceFormationId": {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        "sourceLabel": {
         "maxLength": 120,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "registeredAddress": {
      "properties": {
       "city": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       "county": {
        "maxLength": 100,
        "type": "string"
       },
       "state": {
        "maxLength": 100,
        "type": "string"
       },
       "street1": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "street2": {
        "maxLength": 200,
        "type": "string"
       },
       "zipCode": {
        "maxLength": 20,
        "type": "string"
       }
      },
      "type": "object"
     },
     "registeredAddressSource": {
      "enum": [
       "ADDRESS_SOURCE_UNSPECIFIED",
       "ADDRESS_SOURCE_OWN",
       "ADDRESS_SOURCE_NEED_ASSISTANCE"
      ],
      "type": "string"
     },
     "registeredAgentAddress": {
      "properties": {
       "city": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       "county": {
        "maxLength": 100,
        "type": "string"
       },
       "state": {
        "maxLength": 100,
        "type": "string"
       },
       "street1": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "street2": {
        "maxLength": 200,
        "type": "string"
       },
       "zipCode": {
        "maxLength": 20,
        "type": "string"
       }
      },
      "type": "object"
     },
     "registeredAgentName": {
      "description": "Human-readable name (1-255 Unicode chars).",
      "properties": {
       "value": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "sections": {
      "items": {
       "properties": {
        "blockers": {
         "items": {
          "type": "string"
         },
         "maxItems": 10,
         "type": "array"
        },
        "handoffUrl": {
         "maxLength": 2048,
         "pattern": "^(https?://.*)?$",
         "type": "string"
        },
        "key": {
         "maxLength": 60,
         "minLength": 1,
         "pattern": "^[a-z0-9-]+$",
         "type": "string"
        },
        "label": {
         "maxLength": 120,
         "type": "string"
        },
        "state": {
         "enum": [
          "SECTION_STATE_UNSPECIFIED",
          "SECTION_STATE_NOT_STARTED",
          "SECTION_STATE_WORKING",
          "SECTION_STATE_COMPLETE"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 12,
      "type": "array"
     },
     "stateOfIncorporation": {
      "maxLength": 2,
      "pattern": "^([A-Z]{2})?$",
      "type": "string"
     },
     "status": {
      "enum": [
       "EQUITY_ONBOARDING_STATUS_UNSPECIFIED",
       "EQUITY_ONBOARDING_STATUS_DRAFT",
       "EQUITY_ONBOARDING_STATUS_COLLECTING",
       "EQUITY_ONBOARDING_STATUS_SUBMITTED",
       "EQUITY_ONBOARDING_STATUS_ABANDONED"
      ],
      "type": "string"
     },
     "submittedAt": {
      "format": "date-time",
      "type": "string"
     },
     "suggestedEin": {
      "maxLength": 10,
      "pattern": "^([0-9]{2}-[0-9]{7})?$",
      "type": "string"
     },
     "updatedAt": {
      "format": "date-time",
      "type": "string"
     }
    },
    "type": "object"
   },
   "updateMask": {
    "description": "Comma-separated field paths.",
    "type": "string"
   }
  },
  "required": [
   "onboarding",
   "updateMask"
  ],
  "type": "object"
 },
