{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Poll a TAP async job until completion, timeout, or terminal failure. This is an explicit wait and never starts a background job.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "backoff": {
    "description": "Increase the poll interval.",
    "type": "boolean"
   },
   "intervalMs": {
    "description": "Poll interval in milliseconds.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "jobIdOrUrl": {
    "description": "TAP async job id or absolute job URL.",
    "minLength": 1,
    "type": "string"
   },
   "maxIntervalMs": {
    "description": "Maximum backoff interval in milliseconds.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "service": {
    "description": "Known Starfetch TAP service preset selected for this workflow; use this or url.",
    "minLength": 1,
    "type": "string"
   },
   "timeoutMs": {
    "description": "Wait timeout in milliseconds.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "url": {
    "description": "Explicit TAP base URL selected for this workflow; use this or service.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobIdOrUrl"
  ],
  "type": "object"
 },
 "name": "starfetch_tap_job_wait",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "errorUrl": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "phase": {
      "type": "string"
     },
     "resultUrl": {
      "type": "string"
     }
    },
    "required": [
     "phase"
    ],
    "type": "object"
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "job": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "url"
      ],
      "type": "object"
     },
     "observedPhases": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "baseUrl": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "service": {
        "type": "string"
       }
      },
      "required": [
       "baseUrl"
      ],
      "type": "object"
     },
     "timeoutMs": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "target",
     "job",
     "observedPhases",
     "timeoutMs"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "Wait for TAP async job"
}
