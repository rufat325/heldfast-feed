        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "YachtFinder's model estimate, only where her page shows one. Not an appraisal, not a sale price."
      },
      "position": {
       "anyOf": [
        {
         "properties": {
          "distance_km": {
           "type": "number"
          },
          "in_port": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "latitude": {
           "type": "number"
          },
          "longitude": {
           "type": "number"
          },
          "seen_at": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
