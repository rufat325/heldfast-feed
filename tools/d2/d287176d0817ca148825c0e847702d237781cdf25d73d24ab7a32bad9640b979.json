{
 "_meta": {
  "ui": {
   "resourceUri": "ui://yachtfinder/answer-v1.html"
  },
  "ui/resourceUri": "ui://yachtfinder/answer-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Yachts near a place"
 },
 "description": "List the yachts whose latest AIS position, as yachtfinder.co publishes it, lies within a radius of a named harbor or anchorage (e.g. \"Port Hercule\", \"Antibes\", \"Off Monaco\") or of a latitude and longitude. By default only positions from the last 24 hours. Each yacht comes with the time of her fix, her distance from the place, whether the harbor's page counts her in port, and a link to her page. A yacht whose position the site does not publish is never listed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "latitude": {
    "description": "Latitude of the place to search (a harbor, an anchorage or a position at sea), in decimal degrees. Not the user's own location.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "longitude": {
    "description": "Longitude of the place to search, in decimal degrees. Not the user's own location.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "place": {
    "description": "A harbor, harbor town or anchorage by name. Give this, or latitude and longitude.",
    "maxLength": 80,
    "type": "string"
   },
   "radius_km": {
    "description": "Default 2 km for a harbor, 3 km for an anchorage, 10 km for a coordinate.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "number"
   },
   "seen_within_hours": {
    "default": 24,
    "description": "Only positions this recent. Default 24.",
    "maximum": 2880,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "default": "any",
    "enum": [
     "for_sale",
     "for_charter",
     "reported_sold",
     "not_for_sale",
     "any"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "yachts_near",
 "outputSchema": {
  "properties": {
   "data_as_of": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "When YachtFinder last rebuilt the catalogue this answer was read from (ISO 8601)."
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "place": {
    "properties": {
     "anchorages": {
      "description": "The anchorages counted.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "harbors": {
      "description": "The harbors counted.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "kind": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "radius_km": {
      "type": "number"
     },
     "read_as": {
      "description": "How the place was read: harbor, town (all its harbors), town coast or region (the harbors and anchorages followed in it), coast, place, anchorage or coordinate.",
      "type": "string"
     },
     "seen_within_hours": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "properties": {
      "asking_price_usd": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "The broker's asking price in US dollars; null when none is published. Never a sale price. Where she asks in another currency (price_as_listed), this is YachtFinder's conversion of that ask, about this much."
      },
      "builder": {
       "anyOf": [
