         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "price_as_listed": {
       "anyOf": [
        {
         "properties": {
          "amount": {
           "type": "number"
          },
          "currency": {
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Her asking price as the broker lists it, when that is not in US dollars (the dollar figure above is then converted). Null for a dollar ask."
      },
      "price_on_application": {
       "type": "boolean"
      },
      "status": {
       "enum": [
        "for sale",
        "for charter",
        "reported sold",
        "not for sale"
       ],
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "weeks_heard": {
       "anyOf": [
        {
         "properties": {
          "heard": {
           "type": "integer"
          },
          "of": {
           "type": "integer"
          },
          "season_url": {
           "type": "string"
          },
          "sentence": {
           "type": "string"
          },
          "since": {
           "type": "string"
          },
          "weeks": {
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "The weeks since `since` (UTC Monday weeks, the last one not over) that YachtFinder's AIS archive heard her: one letter a week, h heard, u our archive did not hear her (our gap, not where she was), x our archive was down. Null where we have none for her."
      },
      "year": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "status",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "type": "string"
   },
   "total_matches": {
    "type": "integer"
   }
  },
  "required": [
   "summary",
   "data_as_of",
   "source",
   "notes",
   "place",
   "total_matches",
   "results"
  ],
  "type": "object"
 },
 "title": "Yachts near a place"
