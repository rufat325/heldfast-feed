  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Match inventory to buyers"
 },
 "description": "The clients in YOUR agency's CRM whose saved search fits one listing:\nwho to call about it. Works for your own listings and for shared MLS\nlistings your agency can sell.\n\nOnly online listings can be matched (a saved search only ever shows\nonline stock); a draft returns an explanation. Clients are listed\nwith their assigned agent, pipeline stage and the search they\nmatched on. Use get_contact on any of them for the full picture.\n\nRequires a linked PropertyList account (or an agency API key); only the calling agency's\nclients that the caller may see in the CRM.\n",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "property_reference": {
    "description": "Listing reference, e.g. PL12345.",
    "type": "string"
   }
  },
  "required": [
   "property_reference"
  ],
  "type": "object"
 },
 "name": "match_inventory_to_buyers",
 "outputSchema": {
  "properties": {
   "clients": {
    "items": {
     "properties": {
      "alerts_on": {
       "type": "boolean"
      },
      "assigned_agents": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "contact_id": {
       "type": "integer"
      },
      "matched_search": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "pipelines": {
       "type": "object"
      }
     },
     "required": [
      "contact_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "property_reference": {
    "type": "string"
   },
   "searches_checked": {
    "type": "integer"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "property_reference",
   "total",
   "clients"
  ],
  "type": "object"
 },
 "securitySchemes": [
