{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Map one provider-normalized virtual address to its original nonnegative file offset. Unmapped addresses fail explicitly, and providers without an authoritative mapping API return typed capability unavailability.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "address": "0x1000"
   }
  ],
  "properties": {
   "address": {
    "description": "A provider-normalized address; default memory uses 0x-prefixed hexadecimal",
    "type": "string"
   },
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "address_to_file_offset",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "type": "string"
     },
     "file_offset": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "address",
     "file_offset"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Address To File Offset"
}
