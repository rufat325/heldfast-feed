{
 "description": "Create a new catalog zone for product/retail ad serving",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advertiser_cost_type": {
    "description": "Billing model",
    "enum": [
     "CPM",
     "CPC"
    ],
    "type": "string"
   },
   "auction_type": {
    "description": "Auction type",
    "enum": [
     "FIRST_PRICE",
     "SECOND_PRICE"
    ],
    "type": "string"
   },
   "bid_floor": {
    "description": "Default bid floor",
    "type": "number"
   },
   "bid_floor_cpc": {
    "description": "CPC bid floor",
    "type": "number"
   },
   "bid_floor_cpm": {
    "description": "CPM bid floor",
    "type": "number"
   },
   "catalog_id": {
    "description": "Catalog ID",
    "type": "number"
   },
   "click_cooldown_period": {
    "description": "Click cooldown period in seconds (1-86400)",
    "type": "number"
   },
   "conversion_lookback_period": {
    "description": "Conversion lookback period in seconds (1-7776000)",
    "type": "number"
   },
   "name": {
    "description": "Zone name",
    "type": "string"
   },
   "publisher": {
    "description": "Publisher ID",
    "type": "number"
   }
  },
  "required": [
   "name",
   "catalog_id"
  ],
  "type": "object"
 },
 "name": "create_catalog_zone"
}
