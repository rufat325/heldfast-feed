           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by email body content (partial match)"
     },
     "categories": {
      "anyOf": [
       {
        "enum": [
         "work",
         "personal",
         "family",
         "travel",
         "important",
         "urgent"
        ],
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "items": {
           "enum": [
            "work",
            "personal",
            "family",
            "travel",
            "important",
            "urgent"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "items": {
           "enum": [
            "work",
            "personal",
            "family",
            "travel",
            "important",
            "urgent"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "items": {
           "enum": [
            "work",
            "personal",
            "family",
            "travel",
            "important",
            "urgent"
           ],
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by Outlook system categories (work, personal, family, travel, important, urgent)"
     },
     "cc": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by CC recipient email address (partial match, case-insensitive)"
     },
     "date": {
      "additionalProperties": false,
      "description": "Filter by date range",
      "properties": {
       "$gte": {
        "description": "Messages on or after this date (YYYY-MM-DD)",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       "$lt": {
        "description": "Messages before this date (YYYY-MM-DD)",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       }
      },
      "type": "object"
     },
     "exactPhrase": {
      "description": "Exact phrase matching - words must appear together in exact order (strict matching). Outlook uses KQL.",
      "minLength": 1,
      "type": "string"
     },
     "from": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by sender email address or name (partial match, case-insensitive)"
     },
     "hasAttachment": {
      "description": "Filter messages with file attachments",
      "type": "boolean"
     },
     "importance": {
      "description": "Filter by message importance level (high, normal, low)",
      "enum": [
       "high",
       "normal",
       "low"
      ],
      "type": "string"
     },
     "isRead": {
      "description": "Filter by read status (true = read, false = unread)",
      "type": "boolean"
     },
     "kqlQuery": {
      "description": "Raw KQL (Keyword Query Language) syntax for advanced use cases. Bypasses schema validation - use sparingly.",
      "minLength": 1,
      "type": "string"
     },
     "label": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by user-created categories (case-sensitive). Use outlook-categories-list to see available categories"
     },
     "subject": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by subject line (partial match, case-insensitive)"
     },
     "text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Search in both subject AND body (convenience shortcut)"
     },
     "to": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "$all": {
          "description": "AND within field - matches if ALL values match",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$any": {
          "description": "OR within field - matches if ANY value matches",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "$none": {
          "description": "NOT within field - matches if NONE match",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "type": "object"
       }
      ],
      "description": "Filter by recipient email address (partial match, case-insensitive)"
     }
    },
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contentType": {
    "default": "text",
    "description": "Format for body content: text extracts plain text, html preserves HTML structure",
    "enum": [
     "text",
     "html"
    ],
    "type": "string"
   },
   "excludeThreadHistory": {
    "default": false,
    "description": "When true, removes quoted thread history from body content",
    "type": "boolean"
   },
   "filename": {
    "default": "outlook-messages.csv",
    "description": "Output filename (default: outlook-messages.csv)",
    "minLength": 1,
    "type": "string"
   },
   "maxItems": {
    "default": 10000,
    "description": "Maximum messages to export (default: 10000, max: 50000)",
    "exclusiveMinimum": 0,
    "maximum": 50000,
    "type": "integer"
   },
   "query": {
    "anyOf": [
     {
      "$ref": "#/$defs/__schema0"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Structured query object or JSON string for filtering messages. Use query-syntax prompt for reference and kqlQuery for KQL syntax."
   }
  },
  "type": "object"
 },
 "name": "messages-export-csv",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "filename": {
        "description": "Stored filename",
        "type": "string"
       },
       "rowCount": {
        "description": "Number of messages exported",
        "type": "number"
       },
       "truncated": {
        "description": "Whether export was truncated at maxItems",
        "type": "boolean"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "uri": {
        "description": "File URI (file:// or http://)",
        "type": "string"
       }
      },
      "required": [
       "uri",
       "filename",
       "rowCount",
       "truncated",
       "type"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
