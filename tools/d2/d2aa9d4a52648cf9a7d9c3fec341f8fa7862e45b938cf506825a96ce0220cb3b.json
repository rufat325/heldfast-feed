{
 "description": "Create an interview AND send the candidate a real invitation email immediately. Only use when the user explicitly wants the invitation sent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assessment_id": {
    "type": "number"
   },
   "candidate_email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "candidate_name": {
    "type": "string"
   },
   "custom_features": {
    "anyOf": [
     {
      "properties": {
       "seniorityLevelId": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "time_limit_minutes": {
    "anyOf": [
     {
      "default": 30,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "assessment_id",
   "candidate_name",
   "candidate_email"
  ],
  "type": "object"
 },
 "name": "invite_candidate",
 "title": "Invite candidate"
}
