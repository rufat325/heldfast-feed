{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Open a new position on an instrument. Provide exactly one of `amount` (USD) or `units` (share/coin count). Respects the configured trading mode (demo or real).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Investment amount in USD (mutually exclusive with `units`)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "instrumentId": {
    "description": "Instrument ID to trade",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "isBuy": {
    "description": "true = Buy/Long, false = Sell/Short",
    "type": "boolean"
   },
   "leverage": {
    "description": "Leverage multiplier (1, 2, 5, 10, etc.; max 400)",
    "maximum": 400,
    "minimum": 1,
    "type": "integer"
   },
   "stopLossRate": {
    "description": "Stop-loss price",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "takeProfitRate": {
    "description": "Take-profit price",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "units": {
    "description": "Number of units / shares / coins (mutually exclusive with `amount`)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "instrumentId",
   "isBuy"
  ],
  "type": "object"
 },
 "name": "etoro_open_position",
 "title": "Open position"
}
