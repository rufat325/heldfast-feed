{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Upload a file to a course. Content must be base64-encoded. Canvas performs a multi-step upload internally.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "Base64-encoded file content",
    "type": "string"
   },
   "content_type": {
    "description": "MIME type, e.g. \"application/pdf\" or \"image/png\"",
    "type": "string"
   },
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "name": {
    "description": "File name including extension",
    "type": "string"
   },
   "parent_folder_path": {
    "description": "Destination folder path within the course, e.g. \"subfolder/nested\"",
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "name",
   "content",
   "content_type"
  ],
  "type": "object"
 },
 "name": "upload_file",
 "title": "Upload File"
}
