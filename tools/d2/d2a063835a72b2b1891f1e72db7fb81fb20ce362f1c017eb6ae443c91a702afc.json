{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"DKIM Checker"},"description":"Look up a DKIM public key at <selector>._domainkey.<domain> and validate it. Detects key revocation (empty p=), RSA key length (KEY_TOO_SHORT below 1024, KEY_WEAK below 2048), SHA-1 hash deprecation, and t=y test mode. For selector1/selector2 it also checks a Microsoft 365 CNAME target carries the token Microsoft builds for the domain (M365_DKIM_CNAME_MISMATCH), even when no key resolves. Returns an `analysis` block with the per-key facts (key_type, key_bits, key_strength, revoked, test_mode, hash_algs, m365_cname). Read-only.","inputSchema":{"additionalProperties":false,"properties":{"domain":{"description":"Apex domain to inspect, e.g. \"google.com\". No scheme, no path.","maxLength":253,"pattern":"^(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.)+[a-z]{2,}$","type":"string"},"selector":{"description":"DKIM selector, e.g. \"google\", \"selector1\", \"20230601\".","maxLength":63,"pattern":"^[a-zA-Z0-9._-]{1,63}$","type":"string"}},"required":["domain","selector"],"type":"object"},"name":"check_dkim","outputSchema":{"properties":{"analysis":{"type":"object"},"error":{"properties":{"code":{"type":"string"},"message":{"type":"string"},"retriable":{"type":"boolean"},"retry_after":{"type":"integer"}},"required":["code","message","retriable"],"type":"object"},"findings":{"items":{"properties":{"code":{"pattern":"^[A-Z][A-Z0-9_]+$","type":"string"},"explanation":{"type":"string"},"remediation":{"type":"string"},"severity":{"enum":["info","warn","error"],"type":"string"},"title":{"type":"string"},"value":{"type":"string"}},"required":["code","severity","title"],"type":"object"},"type":"array"},"grade":{"enum":["A","B","C","D","F"],"type":"string"},"grade_reasons":{"items":{"type":"string"},"type":"array"},"input":{"type":"object"},"provenance":{"properties":{"operated_by":{"type":"string"}},"required":["operated_by"],"type":"object"},"records":{"items":{"properties":{"data":{"type":"string"},"name":{"type":"string"},"ttl":{"type":"integer"},"type":{"type":"string"}},"required":["name","type","ttl","data"],"type":"object"},"type":"array"},"resolvers":{"type":"array"},"schema_version":{"const":2,"type":"integer"},"status":{"enum":["pass","warn","fail","info","error"],"type":"string"},"timestamp":{"type":"string"},"tool":{"type":"string"},"tool_version":{"type":"string"},"verdict":{"type":"string"}},"required":["tool","tool_version","schema_version","input","status","findings","timestamp","provenance"],"type":"object"},"title":"DKIM Checker"}
