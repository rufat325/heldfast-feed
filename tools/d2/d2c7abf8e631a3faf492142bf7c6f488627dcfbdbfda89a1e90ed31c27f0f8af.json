{
 "description": "Register an outgoing webhook endpoint. Send16 POSTs event JSON to this URL with an HMAC-SHA256 signature. Outgoing webhooks are a plan feature.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "enabled": {
    "description": "Whether the endpoint is active (default true)",
    "type": "boolean"
   },
   "events": {
    "description": "Event types to subscribe to",
    "items": {
     "enum": [
      "contact.created",
      "contact.updated",
      "contact.deleted",
      "contact.subscribed",
      "contact.unsubscribed",
      "campaign.sent",
      "campaign.completed",
      "email.delivered",
      "email.opened",
      "email.clicked",
      "email.bounced",
      "email.complained",
      "form.submitted"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "A label for this endpoint",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "HTTPS endpoint to receive events",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name",
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "create_webhook"
}
