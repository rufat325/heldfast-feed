  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeHeadings": {
    "default": true,
    "description": "Include the h1-h6 outline.",
    "type": "boolean"
   },
   "includeHttpHeaders": {
    "default": true,
    "description": "Include response headers (lower-cased keys).",
    "type": "boolean"
   },
   "includeJsonLd": {
    "default": true,
    "description": "Include parsed JSON-LD blocks.",
    "type": "boolean"
   },
   "timeoutMs": {
    "description": "Request timeout in milliseconds (1000-120000).",
    "maximum": 120000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "description": "Absolute http(s) URL of the page to fetch.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "extract_metadata",
