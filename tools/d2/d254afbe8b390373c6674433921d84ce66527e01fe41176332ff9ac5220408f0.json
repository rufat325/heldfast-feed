{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "keywords:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Show which seodata.dev plan this connection uses and how many keyword lookups are left today and this month.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "get_usage",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "daily": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "limit": {
        "type": "number"
       },
       "used": {
        "type": "number"
       }
      },
      "required": [
       "used",
       "limit"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "monthly": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "limit": {
        "type": "number"
       },
       "used": {
        "type": "number"
       }
      },
      "required": [
       "used",
       "limit"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "plan": {
    "enum": [
     "anonymous",
     "free",
     "unlimited"
    ],
    "type": "string"
   },
   "remaining": {
    "description": "Lookups left before the next limit; null = unlimited",
    "type": [
     "number",
     "null"
    ]
   },
   "signed_in_as": {
    "type": [
     "string",
     "null"
    ]
   },
   "upgrade_url": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "plan",
   "signed_in_as",
   "remaining",
   "daily",
   "monthly",
   "upgrade_url"
  ],
  "type": "object"
 },
 "title": "Check seodata.dev quota"
}
