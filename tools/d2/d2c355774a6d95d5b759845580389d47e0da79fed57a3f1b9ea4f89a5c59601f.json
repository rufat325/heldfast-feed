{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List project risks"
 },
 "description": "List project risks (risk register). Filter by project, status, category, probability, or impact.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Filter by risk category",
    "enum": [
     "technical",
     "financial",
     "schedule",
     "resource",
     "external"
    ],
    "type": "string"
   },
   "impact": {
    "description": "Filter by impact level",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default: all pages fetched automatically)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default: 1000, max: 1000). All pages are fetched automatically.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "probability": {
    "description": "Filter by probability",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Filter by project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "search": {
    "description": "Search by name",
    "maxLength": 200,
    "type": "string"
   },
   "status": {
    "description": "Filter by risk status",
    "enum": [
     "identified",
     "analyzing",
     "mitigating",
     "resolved",
     "accepted"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_project_risks",
 "title": "List project risks"
}
