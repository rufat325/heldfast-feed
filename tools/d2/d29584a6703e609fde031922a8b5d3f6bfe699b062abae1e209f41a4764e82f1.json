    "description": "Total carbs in grams",
    "type": "integer"
   },
   "entries": {
    "description": "Food-by-food line items. Each: {name, calories, protein_g, carbs_g, fat_g, fiber_g, sugar_g, sodium_mg, consumed_at \"HH:MM\"}",
