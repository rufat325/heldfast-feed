{
 "_meta": {
  "openai/outputTemplate": "ui://giftroam/app.html@v8",
  "openai/resultCanProduceWidget": true,
  "openai/toolInvocation/invoked": "Checkout link ready",
  "openai/toolInvocation/invoking": "Preparing secure checkout\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://giftroam/app.html@v8",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://giftroam/app.html@v8"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a checkout link"
 },
 "description": "Create a signed, single-purpose checkout link (30-minute expiry) for one gift to one country. The schema has no recipient fields on purpose: name, address, phone, delivery details and payment are collected on the secure page. Returns an order summary with the link. Retries with the same idempotency_key return the same link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Destination country, ISO-3166 alpha-2.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "delivery_date": {
    "description": "Requested delivery date YYYY-MM-DD; omit for as-soon-as-possible.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "gift_card_text": {
    "description": "Card message (\u2264180 chars) if the user already gave one.",
    "maxLength": 180,
    "type": "string"
   },
   "gift_id": {
    "description": "A gift_id from search results.",
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Client-generated key; retries with the same key return the same link.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "locale": {
    "description": "Language of the conversation with the user (e.g. he-IL, fr-FR). Localizes content and messages; prices and availability are unaffected. The checkout page opens in this language.",
    "maxLength": 12,
    "type": "string"
   },
   "quantity": {
    "const": 1,
    "default": 1,
    "description": "Always 1 in v1.",
    "type": "number"
   }
  },
  "required": [
   "gift_id",
   "country",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_checkout",
 "outputSchema": {
  "properties": {
   "checkout_url": {
    "description": "Single-purpose secure checkout link on checkout.giftroam.com (30-minute expiry)",
    "type": "string"
   },
   "display_text": {
    "description": "Human-readable one-line summary of the result",
    "type": "string"
   },
   "error": {
    "description": "Present only when the call failed",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "next_step": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "expires_at": {
    "type": "string"
   },
   "locale": {
    "description": "BCP-47 locale the texts are localized to",
    "type": "string"
   },
   "summary": {
    "properties": {
     "country": {
      "type": "string"
     },
     "delivery_date": {
      "type": "string"
     },
     "estimated_window": {
      "properties": {
       "earliest": {
        "type": "string"
       },
       "latest": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "gift": {
      "type": "string"
     },
     "gift_message": {
      "type": [
       "string",
       "null"
      ]
     },
     "notes": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "price": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "orders:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create a checkout link"
}
