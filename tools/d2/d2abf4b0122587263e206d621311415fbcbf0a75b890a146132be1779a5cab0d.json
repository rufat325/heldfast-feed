{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a price alert. You can switch to threshold-free notify_on_drop / notify_on_rise, change thresholds, or toggle is_active. At least one setting must remain. Requires a Pricewatcha API key (pwk_live_...) from https://pricewatcha.com/profile#api-keys. On failure, returns a structured error object with fields error.code, error.message, error.http_status, error.retry_recommended, and error.retry_after_seconds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alert_id": {
    "description": "Alert ID to update",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "api_key": {
    "description": "Pricewatcha API key (pwk_live_...)",
    "minLength": 1,
    "type": "string"
   },
   "is_active": {
    "type": "boolean"
   },
   "max_threshold_price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Max threshold, or null to clear."
   },
   "min_threshold_price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Min threshold, or null to clear."
   },
   "name": {
    "maxLength": 128,
    "type": "string"
   },
   "notify_email": {
    "type": "boolean"
   },
   "notify_on_drop": {
    "description": "Notify on any price drop. No threshold required.",
    "type": "boolean"
   },
   "notify_on_rise": {
    "description": "Notify on any price increase. No threshold required.",
    "type": "boolean"
   },
   "webhook_url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "api_key",
   "alert_id"
  ],
  "type": "object"
 },
 "name": "update_price_alert",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "alert_id": {
    "type": "integer"
   },
   "created_at": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "is_active": {
    "type": "boolean"
   },
   "last_triggered_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "max_threshold_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "min_threshold_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "notify_email": {
    "type": "boolean"
   },
   "notify_on_drop": {
    "type": "boolean"
   },
   "notify_on_rise": {
    "type": "boolean"
   },
   "product_id": {
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   },
   "webhook_url": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "alert_id",
   "product_id",
   "notify_on_drop",
   "notify_on_rise",
   "currency",
   "notify_email",
   "is_active",
   "created_at",
   "updated_at"
  ],
  "type": "object"
 },
 "title": "Update price alert"
}
