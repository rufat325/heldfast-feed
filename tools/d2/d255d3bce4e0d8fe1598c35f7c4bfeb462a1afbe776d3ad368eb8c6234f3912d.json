{
 "description": "List companies (sub-accounts) under a CRM agency with optional search and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "companyId": {
    "description": "Parent company / agency ID",
    "type": "string"
   },
   "email": {
    "description": "Filter by company email address",
    "type": "string"
   },
   "isSearchable": {
    "description": "Whether to enable search mode",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum number of companies to return",
    "type": "number"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "order": {
    "description": "Sort order: 'asc' or 'desc'",
    "type": "string"
   },
   "skip": {
    "description": "Number of records to skip for pagination",
    "type": "number"
   }
  },
  "required": [
   "access_token",
   "companyId"
  ],
  "type": "object"
 },
 "name": "crm_list_companies"
}
