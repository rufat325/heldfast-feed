 "description": "[Candidates] List the merchant's candidates.\n\nPaginated list of a merchant's candidates (the admin-portal candidates list), scoped to your token's merchant (or a merchant_id override). Capped at 1000 records per page.",
 "inputSchema": {
  "properties": {
   "conversation_id": {
    "description": "Pass the exact conversation_id from the server's previous response, unchanged. The server provides it on the first call \u2014 never invent one, and do not issue parallel tool calls until you have it. Keep passing the same conversation_id for the rest of the conversation, including after later user messages or on a different task; do not reset it when the user starts a new request.",
    "type": "string"
   },
   "filter_emoji": {
    "description": "Filter by the candidate emoji marker.",
    "type": "string"
   },
   "filter_text": {
    "description": "Search on candidate name, email, external id, phone and CV skills. Every word must match (case and accents ignored; longer words tolerate typos). Without order_by, the best matches come first.",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum number of records to return (1\u20131000).",
    "example": 50,
    "maximum": 1000.0,
    "minimum": 1.0,
    "type": "integer"
   },
   "merchant_id": {
    "description": "Optional merchant to scope to. Admins and sub-merchant operators only; other callers always use their token's merchant.",
    "example": "28106cba-1c27-4e53-b149-32113e5e8e31",
    "format": "uuid",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "description": "Number of records to skip from the start of the result set.",
    "example": 0,
    "minimum": 0.0,
    "type": "integer"
   },
   "order_by": {
    "default": "created_at_newest",
    "description": "Sort order of the result set.",
    "enum": [
     "name_accending",
     "name_decending",
     "created_at_newest",
     "created_at_oldest"
    ],
    "example": "created_at_newest",
    "type": "string"
   },
   "source": {
    "description": "Filter by how the candidate entered: invited or self-registered. Omit for both.",
    "enum": [
     "invited",
     "registered"
    ],
    "example": "registered",
    "type": "string"
   },
   "tab": {
    "description": "Filter candidates by recent activity. Omit (or empty) to include all.",
    "enum": [
     "interview",
     "pre-screening",
     "no-action",
     "leads",
     ""
    ],
    "example": "interview",
    "type": "string"
   }
  },
  "required": [],
