{
 "description": "Edit a problem or move it out of the active set \u2014 the retire/solve/merge loop that keeps the set near twelve. When closing (status solved/retired), write a resolution saying WHY plus, for a retirement, the explicit RE-OPEN trigger: a retired problem is parked with a wake condition, not deleted. A merge is a retirement whose resolution names the absorbing problem. Reopen later by setting status back to open.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "framing": {
    "description": "New framing (the 'instance of what?' reframe)",
    "type": "string"
   },
   "id": {
    "description": "Problem id",
    "type": "integer"
   },
   "resolution": {
    "description": "Why it left the open set + the re-open trigger in prose (write one whenever closing; for a merge, name the absorbing problem)",
    "type": "string"
   },
   "statement": {
    "description": "New fuller description",
    "type": "string"
   },
   "status": {
    "description": "open (reopen) | solved | retired",
    "enum": [
     "open",
     "solved",
     "retired"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Replace the tag list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "New short name",
    "type": "string"
   },
   "wakeCondition": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "all": {
        "description": "Ripe when EVERY atom is ripe. A `manual` atom here means: once the numeric atoms are ripe, surface as 'manual check due' instead of auto-firing.",
        "items": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "description": "Threshold \u2014 the atom is ripe when current >= gte",
             "exclusiveMinimum": 0,
             "type": "number"
            },
            "signal": {
             "const": "sparkCount",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "signal": {
             "const": "resolvedSparkCount",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "signal": {
             "const": "openProblemCount",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "onOrAfter": {
             "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
             "type": "string"
            },
            "signal": {
             "const": "date",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "onOrAfter"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "path": {
             "type": "string"
            },
            "signal": {
             "const": "fileLines",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "path",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "path": {
             "type": "string"
            },
            "pattern": {
             "type": "string"
            },
            "signal": {
             "const": "fileMatches",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "path",
            "pattern",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "dir": {
             "type": "string"
            },
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "signal": {
             "const": "fileCount",
             "type": "string"
            },
            "suffix": {
             "type": "string"
            }
           },
           "required": [
            "signal",
            "dir",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "note": {
             "type": "string"
            },
            "signal": {
             "const": "manual",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "note"
           ],
           "type": "object"
          }
         ]
        },
        "minItems": 1,
        "type": "array"
       },
       "any": {
        "description": "Ripe when AT LEAST ONE atom is ripe",
        "items": {
         "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items"
        },
        "minItems": 1,
        "type": "array"
       },
       "summary": {
        "description": "One-line human statement of the trigger",
        "type": "string"
       }
      },
      "required": [
       "summary"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Structured, COMPUTABLE re-open trigger \u2014 the machine half of the resolution prose. The ambient digest evaluates it every session and surfaces ripeness (see wake_status). Parked problems only; pass null to clear; reopening always clears it."
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_problem",
 "title": "Update / retire / solve a problem"
}
