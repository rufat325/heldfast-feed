{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a customer"
 },
 "description": "Update a customer's name, email, legal type, tags, default discount or marketing consent. Only the fields you pass change. Booqable: PUT /api/4/customers/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_id": {
    "description": "The customer id (UUID).",
    "minLength": 1,
    "type": "string"
   },
   "discount_percentage": {
    "description": "Default discount % applied to this customer's new orders.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "email": {
    "description": "Email address used for communication.",
    "type": "string"
   },
   "email_marketing_consented": {
    "description": "Whether the customer consented to email marketing.",
    "type": "boolean"
   },
   "legal_type": {
    "description": "person or commercial.",
    "enum": [
     "person",
     "commercial"
    ],
    "type": "string"
   },
   "name": {
    "description": "Person or company name.",
    "minLength": 1,
    "type": "string"
   },
   "tag_list": {
    "description": "Tags (case-insensitive).",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "customer_id"
  ],
  "type": "object"
 },
 "name": "booqable_update_customer",
 "title": "Update a customer"
}
