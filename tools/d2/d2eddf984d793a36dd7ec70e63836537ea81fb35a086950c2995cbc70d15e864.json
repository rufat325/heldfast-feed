{"description":"Google AdSense earnings & performance report: estimated earnings, impressions, clicks, CTR and RPM with dimension breakdowns.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"accountId":{"description":"Specific AdSense account ID (default: auto-select)","type":"string"},"dateRange":{"description":"Preset date range (default: LAST_7_DAYS)","enum":["TODAY","YESTERDAY","THIS_WEEK","LAST_WEEK","THIS_MONTH","LAST_MONTH","LAST_7_DAYS","LAST_30_DAYS"],"type":"string"},"dimensions":{"description":"Breakdown dimensions","items":{"enum":["DATE","WEEK","MONTH","DOMAIN_NAME","COUNTRY_NAME","PLATFORM_TYPE_NAME","AD_UNIT_ID","AD_UNIT_NAME","CUSTOM_CHANNEL_ID","CUSTOM_CHANNEL_NAME","PRODUCT_NAME","PRODUCT_CODE","URL_CHANNEL_ID"],"type":"string"},"type":"array"},"endDate":{"description":"Custom end date YYYY-MM-DD (requires startDate)","type":"string"},"metrics":{"description":"Metrics to report (default: earnings, page views, impressions, clicks, RPM)","items":{"enum":["ESTIMATED_EARNINGS","PAGE_VIEWS","IMPRESSIONS","CLICKS","PAGE_VIEWS_CTR","PAGE_VIEWS_RPM","IMPRESSIONS_CTR","IMPRESSIONS_RPM"],"type":"string"},"type":"array"},"orderBy":{"description":"Sort order as \"+METRIC\" (ascending) or \"-METRIC\" (descending), e.g. \"-ESTIMATED_EARNINGS\"","type":"string"},"rowLimit":{"description":"Max rows to return (default: 100, max: 200)","type":"number"},"startDate":{"description":"Custom start date YYYY-MM-DD (requires endDate, overrides dateRange)","type":"string"}},"type":"object"},"name":"adsense_report"}
