{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Which drugs an HLA typing carries a published pharmacogenomic association for. Looks each allele up in hla-pgx-open (CPIC guidelines + PharmGKB clinical annotations, CC BY-SA, snapshot date in every answer) after normalizing the name first, so any era or shorthand works (A*3101, B*5701, HLA-B*15:02:01G) and every conversion leaves a flag. Returns per allele the current name, the two-field form, the flags and the associations (source, drug, evidence level, CPIC testing recommendation, implication, recommendation, guideline or annotation URL, PMIDs), plus summary.actionable: the CPIC level-A, allele-positive rows. Guideline lookup over published CPIC and PharmGKB associations, keyed by two-field HLA allele. Decision support only; not a medical device. After an allogeneic transplant the recipient's blood carries the donor's genome, and which genome should drive an HLA-mediated drug alert is an open question (NCT06856226); this lookup reports both and decides nothing. Allele strings only, no patient identifiers.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "alleles": {
    "description": "A flat list of reported allele names instead of a typing. Send exactly one of typing or alleles.",
    "items": {
     "maxLength": 64,
     "type": "string"
    },
    "maxItems": 96,
    "type": "array"
   },
   "typing": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "description": "locus -> up to 4 reported allele names. Allele strings only: never patient names, medical record numbers, dates of birth, or accession or case identifiers.",
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "pgx_lookup",
 "outputSchema": {
  "properties": {
   "alleles": {
    "items": {
     "properties": {
      "allele_2field": {
       "type": "string"
      },
      "associations": {
       "items": {
        "description": "One published association for the allele, as hla-pgx-open records it (CPIC or PharmGKB).",
        "properties": {
         "allele": {
          "type": "string"
         },
         "allele_status": {
          "description": "positive / negative / carrier, or empty when the source's label is not a status.",
          "type": "string"
         },
         "annotation_url": {
          "type": "string"
         },
         "citations_pmid": {
          "type": "string"
         },
         "classification": {
          "type": "string"
         },
         "clinpgx_level": {
          "type": "string"
         },
         "drug": {
          "type": "string"
         },
         "drug_id": {
          "type": "string"
         },
         "evidence_level": {
          "type": "string"
         },
         "gene": {
          "type": "string"
         },
         "guideline_name": {
          "type": "string"
         },
         "guideline_url": {
          "type": "string"
         },
         "implication": {
          "type": "string"
         },
         "pgx_testing": {
          "type": "string"
         },
         "phenotype_category": {
          "type": "string"
         },
         "population": {
          "type": "string"
         },
         "recommendation": {
          "type": "string"
         },
         "score": {
          "type": "string"
         },
         "source": {
          "enum": [
           "cpic",
           "pharmgkb"
          ],
          "type": "string"
         },
         "source_allele_label": {
          "type": "string"
         },
         "source_record_id": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "current_name": {
       "type": "string"
      },
      "flags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "reported": {
       "type": "string"
      }
     },
     "required": [
      "reported",
      "current_name",
      "allele_2field",
      "flags",
      "associations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "attribution": {
    "type": "string"
   },
   "license": {
    "type": "string"
   },
   "pgx_snapshot": {
    "description": "The hla-pgx-open snapshot the answer came from (UTC date and git commit).",
