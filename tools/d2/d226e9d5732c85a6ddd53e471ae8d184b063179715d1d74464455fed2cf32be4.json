{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "research:read",
     "research:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save a research note"
 },
 "description": "Save a NEW private note in the connected workspace, with optional exact owned strategy/run evidence references. The note is user-authored content. Does not publish or send it anywhere.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "note": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "request_key": {
    "description": "Idempotency UUID identifying one requested write and its unchanged arguments.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "maxLength": 128,
    "type": "string"
   },
   "run_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "strategy_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "request_key",
   "title",
   "note"
  ],
  "type": "object"
 },
 "name": "save_research_note",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "app_url": {
    "format": "uri",
    "type": "string"
   },
   "note_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "saved": {
    "const": true,
    "type": "boolean"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "note_id",
   "title",
   "saved",
   "app_url"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "research:read",
    "research:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Save a research note"
}
