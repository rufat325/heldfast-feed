{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether a car, truck or motorcycle has recalls, such as \"does my 2018 Honda Accord have any recalls?\". Pass the model year, make and model. Returns the NHTSA safety recalls for that year, make and model, newest first, with the component, summary, consequence, the manufacturer's remedy and whether NHTSA says to stop driving or park outside. Recalls are by model, not by VIN, so it cannot say whether one car's repair is still open; send the user to nhtsa.gov/recalls with their VIN for that. US vehicles only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Most recalls to return, newest first (default 10)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "make": {
    "description": "Manufacturer, such as \"Honda\"",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "description": "Model name, such as \"Accord\"",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Model year, such as 2018",
    "maximum": 2100,
    "minimum": 1950,
    "type": "integer"
   }
  },
  "required": [
   "year",
   "make",
   "model"
  ],
  "type": "object"
 },
 "name": "check_vehicle_recalls",
 "outputSchema": {
  "properties": {
   "message": {
    "type": "string"
   },
   "moreAvailable": {
    "type": "boolean"
   },
   "notice": {
    "type": "string"
   },
   "recalls": {
    "items": {
     "properties": {
      "campaignNumber": {
       "type": "string"
      },
      "component": {
       "type": [
        "string",
        "null"
       ]
      },
      "consequence": {
       "type": [
        "string",
        "null"
       ]
      },
      "manufacturer": {
       "type": [
        "string",
        "null"
       ]
      },
      "overTheAirUpdate": {
       "type": "boolean"
      },
      "parkIt": {
       "type": "boolean"
      },
      "parkOutside": {
       "type": "boolean"
      },
      "remedy": {
       "type": [
        "string",
        "null"
       ]
      },
      "reportedOn": {
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "campaignNumber"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "not_found",
     "unavailable"
    ],
    "type": "string"
   },
   "totalRecalls": {
    "type": "integer"
   },
   "vehicle": {
    "properties": {
     "make": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "year": {
      "type": "integer"
     }
    },
    "required": [
     "year",
     "make",
     "model"
    ],
    "type": "object"
   }
  },
  "required": [
   "status",
   "vehicle",
   "notice"
  ],
  "type": "object"
 },
 "title": "Check vehicle recalls"
}
