{
 "description": "Style shapes in Google Slides",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "backgroundColor": {
    "description": "Background color (RGBA values 0-1)",
    "properties": {
     "alpha": {
      "type": "number"
     },
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "objectId": {
    "description": "Shape object ID",
    "type": "string"
   },
   "outlineColor": {
    "description": "Outline color (RGB values 0-1)",
    "properties": {
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "outlineDashStyle": {
    "description": "Outline dash style",
    "enum": [
     "SOLID",
     "DOT",
     "DASH",
     "DASH_DOT",
     "LONG_DASH",
     "LONG_DASH_DOT"
    ],
    "type": "string"
   },
   "outlineWeight": {
    "description": "Outline thickness in points",
    "type": "number"
   },
   "presentationId": {
    "description": "Presentation ID",
    "type": "string"
   }
  },
  "required": [
   "presentationId",
   "objectId"
  ],
  "type": "object"
 },
 "name": "styleGoogleSlidesShape"
}
