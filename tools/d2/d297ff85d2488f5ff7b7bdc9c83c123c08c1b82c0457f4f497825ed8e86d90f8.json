{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Fetch pinned messages"
 },
 "description": "List all pinned messages in a channel. Returns { messages: [...] } with id, author, content, timestamp, pinnedAt. Read-only. Use discord_pin_message to change which messages are pinned.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel_id": {
    "description": "ID (snowflake) of the channel or thread to list pins from.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "channel_id"
  ],
  "type": "object"
 },
 "name": "discord_fetch_pinned_messages",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "pinnedAt": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "author",
      "content",
      "timestamp",
      "pinnedAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 }
}
