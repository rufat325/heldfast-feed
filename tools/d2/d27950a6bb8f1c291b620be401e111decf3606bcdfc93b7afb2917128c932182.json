{
 "description": "Challenge accessible evidence with a specific allegation and supporting evidence IDs. Requires explicit adjudication activation and scope.",
 "inputSchema": {
  "properties": {
   "dispute": {
    "properties": {
     "allegation": {
      "type": "string"
     },
     "attestationId": {
      "format": "uuid",
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "expectedVersion": {
      "type": "integer"
     }
    },
    "required": [
     "attestationId",
     "expectedVersion",
     "allegation",
     "evidenceIds"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "type": "string"
   }
  },
  "required": [
   "dispute",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "open_evidence_case"
}
