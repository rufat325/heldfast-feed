{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Read a documentation section returned by reference_search or reference_context. Pass its id and revision. Example: {\"id\":\"<hit id>\",\"revision\":\"<hit revision>\"}. Returns at most 80 lines (40 by default) and 8,000 bytes, with a line to continue from.","inputSchema":{"additionalProperties":false,"properties":{"id":{"pattern":"^[a-f0-9]{16,64}$","type":"string"},"maxLines":{"default":40,"maximum":80,"minimum":1,"type":"integer"},"revision":{"pattern":"^[a-f0-9]{12,64}$","type":"string"},"source":{"enum":["game_doc","wiki","script_doc"],"type":"string"},"startColumn":{"minimum":1,"type":"integer"},"startLine":{"minimum":1,"type":"integer"},"workspaceId":{"default":"current","pattern":"^[a-z][a-z0-9_-]{0,63}$","type":"string"}},"required":["id","revision"],"type":"object"},"name":"hoi4.reference_read","outputSchema":{"additionalProperties":false,"properties":{"artifacts":{"items":{},"maxItems":32,"type":"array"},"blockers":{"items":{},"type":"array"},"changedFiles":{"items":{},"type":"array"},"code":{"type":"string"},"data":{"additionalProperties":{},"properties":{},"type":"object"},"diagnostics":{"items":{},"maxItems":20,"type":"array"},"filesScanned":{"items":{},"type":"array"},"proposedFiles":{"items":{},"type":"array"},"status":{"enum":["ok","blocked","error"],"type":"string"},"validation":{},"workspaceId":{"type":"string"}},"required":["status","code","workspaceId","validation","data"],"type":"object"},"title":"Read a modding rule"}
