{
 "description": "The type at a token on a line, like an editor hover; generic calls show their instantiated types. Use when hover_by_name can't name the token: callback parameters, expressions, repeated names.",
 "inputSchema": {
  "properties": {
   "backend": {
    "description": "Default typescript7; retry with typescript6 if it fails or looks wrong",
    "enum": [
     "typescript6",
     "typescript7"
    ]
   },
   "column": {
    "description": "1-based column; alternative to text",
    "minimum": 1,
    "type": "integer"
   },
   "file": {
    "description": "TS/JS file: absolute, or relative to the server's cwd",
    "type": "string"
   },
   "full": {
    "description": "Untruncated types (no \"... 12 more ...\"), all overloads",
    "type": "boolean"
   },
   "include_cost": {
    "description": "Count type instantiations; typescript6 only",
    "type": "boolean"
   },
   "include_docs": {
    "description": "Also return JSDoc/TSDoc",
    "type": "boolean"
   },
   "line": {
    "description": "1-based line",
    "minimum": 1,
    "type": "integer"
   },
   "max_chars": {
    "description": "Text cap per type (default 4000 chars; 0: none)",
    "minimum": 0,
    "type": "integer"
   },
   "occurrence": {
    "description": "Which match of text on the line (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "project": {
    "description": "tsconfig.json; default: the nearest one above file",
    "type": "string"
   },
   "text": {
    "description": "Token copied from the line, e.g. \"useState\"; whole identifiers match first. Instead of column",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "file",
   "line"
  ],
  "type": "object"
 },
 "name": "hover",
 "outputSchema": {
  "properties": {
   "error": {
    "properties": {
     "candidates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "FILE_NOT_FOUND",
       "SYMBOL_NOT_FOUND",
       "TYPESCRIPT_ERROR",
       "INTERNAL_ERROR"
      ]
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "result": {
    "properties": {
     "alternatives": {
      "items": {
       "properties": {
        "column": {
         "type": "number"
        },
        "kind": {
         "type": "string"
        },
        "line": {
         "type": "number"
        }
       },
       "required": [
        "line",
        "column"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "column": {
      "type": "number"
     },
     "cost": {
      "properties": {
       "instantiations": {
        "type": "number"
       },
       "types": {
        "type": "number"
       }
      },
      "required": [
       "instantiations",
       "types"
      ],
      "type": "object"
     },
     "display": {
      "type": "string"
     },
     "documentation": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "line": {
      "type": "number"
     },
     "name": {
      "type": "string"
     },
     "overloads": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "position": {
      "properties": {
       "column": {
        "type": "number"
       },
       "line": {
        "type": "number"
       }
      },
      "required": [
       "line",
       "column"
      ],
      "type": "object"
     },
     "returnType": {
      "type": "string"
     },
     "signature": {
      "type": "string"
     },
     "unionMembers": {
      "type": "number"
     }
    },
    "required": [
     "signature",
     "line",
     "column",
     "kind"
    ],
    "type": "object"
   },
   "version": {
    "const": 1
   }
  },
  "required": [
   "version",
   "ok"
  ],
  "type": "object"
 }
}
