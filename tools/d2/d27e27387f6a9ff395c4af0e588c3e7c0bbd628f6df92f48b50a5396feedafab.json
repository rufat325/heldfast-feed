 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "article": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "An article number. With it, the card is that article's comparison; without it and without articles, the instrument's change inventory."
   },
   "articles": {
    "anyOf": [
     {
      "items": {
       "maxLength": 32,
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Several article numbers: one card holding those articles as a filtered inventory, each opening its comparison in place. Not with article."
   },
   "from_version_id": {
    "anyOf": [
     {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional; both ids or neither. Where the instrument has one published pair, that pair is shown. A version id, or an alias the instrument defines: proposal, compromise, council, published."
   },
   "instrument_id": {
    "description": "Registry id of the instrument, e.g. \"psr\".",
    "maxLength": 64,
    "pattern": "^[A-Za-z0-9]+(?:[ ._-][A-Za-z0-9]+)*$",
    "type": "string"
   },
   "to_version_id": {
    "anyOf": [
     {
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "With from_version_id, the later text of the pair: both ids or neither. The same ids and aliases."
   }
  },
  "required": [
   "instrument_id"
  ],
  "type": "object"
 },
