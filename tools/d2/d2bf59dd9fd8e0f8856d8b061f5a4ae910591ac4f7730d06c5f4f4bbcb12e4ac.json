{
 "description": "Generate an assembled bug analysis prompt with specified technology stacks and severity level",
 "inputSchema": {
  "properties": {
   "bug_context": {
    "description": "Optional bug description or context",
    "type": "string"
   },
   "severity": {
    "description": "Bug severity level",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "technology_stack": {
    "description": "Technology stacks involved in the bug",
    "items": {
     "enum": [
      "node.js",
      "javascript",
      "typescript",
      "python",
      "java",
      "c#",
      "go",
      "rust",
      "php",
      "ruby",
      "swift",
      "kotlin",
      "react",
      "angular",
      "vue",
      "express",
      "nestjs",
      "django",
      "flask",
      "spring",
      "laravel",
      "rails",
      "mongodb",
      "postgresql",
      "mysql",
      "redis",
      "docker",
      "kubernetes",
      "aws",
      "azure",
      "gcp"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "technology_stack",
   "severity"
  ],
  "type": "object"
 },
 "name": "generate_bug_analysis_prompt"
}
