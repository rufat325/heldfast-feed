{
 "description": "Update an existing pipeline's name, stages, or funnel visibility.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "name": {
    "description": "Pipeline name",
    "type": "string"
   },
   "pipelineId": {
    "description": "Pipeline ID to update",
    "type": "string"
   },
   "showInFunnel": {
    "description": "Whether to show this pipeline in the funnel view",
    "type": "boolean"
   },
   "stages": {
    "description": "Array of stage objects with name and position",
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "access_token",
   "pipelineId"
  ],
  "type": "object"
 },
 "name": "crm_update_pipeline"
}
