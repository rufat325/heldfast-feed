{
 "description": "Search and filter the celestial object catalog by type, constellation, magnitude, angular size, or catalog membership. Returns a formatted table of matching objects sorted by brightness.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalog": {
    "description": "Filter by catalog membership",
    "enum": [
     "messier",
     "caldwell",
     "ngc",
     "ic"
    ],
    "type": "string"
   },
   "constellation": {
    "description": "IAU constellation abbreviation (e.g. Ori, And, Sgr)",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results (default 20, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "maxMagnitude": {
    "description": "Maximum (faintest) visual magnitude to include",
    "type": "number"
   },
   "minMagnitude": {
    "description": "Minimum (brightest) visual magnitude to include",
    "type": "number"
   },
   "minSize": {
    "description": "Minimum angular size in arcminutes",
    "type": "number"
   },
   "type": {
    "description": "Object type code (e.g. G=Galaxy, PN=Planetary Nebula, OCl=Open Cluster)",
    "enum": [
     "*",
     "**",
     "*Ass",
     "OCl",
     "GCl",
     "Cl+N",
     "G",
     "GPair",
     "GTrpl",
     "GGroup",
     "PN",
     "HII",
     "DrkN",
     "EmN",
     "Neb",
     "RfN",
     "SNR",
     "Nova",
     "Other"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_objects"
}
