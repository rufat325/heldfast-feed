{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create share list"
 },
 "description": "Create a public shortlist URL of 1 to 20 experiences that expires after 30 days. Returns a private deletionToken; never show it publicly. Offers are limited to reviewed physical tours and admissions. Editorial destinations do not guarantee app inventory. Digital-only and unreviewed products are unavailable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "default": "EUR",
    "description": "Display currency for prices.",
    "enum": [
     "EUR",
     "USD",
     "GBP"
    ],
    "type": "string"
   },
   "experienceIds": {
    "description": "1 to 20 experience ids.",
    "items": {
     "description": "Reviewed physical-experience id from search_experiences. Unreviewed ids are rejected.",
     "pattern": "^[A-Za-z0-9_-]{1,80}$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "experienceIds"
  ],
  "type": "object"
 },
 "name": "create_share_list",
 "outputSchema": {
  "anyOf": [
   {
    "properties": {
     "deletionToken": {
      "description": "Private. Needed to delete the list. Do not publish.",
      "type": "string"
     },
     "expiresAt": {
      "format": "date-time",
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "id",
     "url",
     "deletionToken",
     "expiresAt"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "availableTools": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "type": "string"
     },
     "docs": {
      "format": "uri",
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "retryAfterSeconds": {
      "type": "integer"
     },
     "status": {
      "type": "integer"
     }
    },
    "required": [
     "code",
     "message",
     "status"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Create share list"
}
