{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Docs"
 },
 "description": "Search the doc registry for documents by type, tags, keyword, or pending actions. Returns summaries, not full content. Use for context gathering in plan, strategy review, and idea dedup.",
 "inputSchema": {
  "properties": {
   "has_pending_actions": {
    "description": "Only docs with unresolved action items.",
    "type": "boolean"
   },
   "keyword": {
    "description": "Search title and summary text.",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default: 10).",
    "type": "number"
   },
   "since_cycle": {
    "description": "Docs updated since this cycle.",
    "type": "number"
   },
   "status": {
    "description": "Filter by status. Defaults to \"active\".",
    "type": "string"
   },
   "tags": {
    "description": "Filter by tags (OR match).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Filter by doc type (e.g. \"research\", \"architecture\").",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "doc_search"
}
