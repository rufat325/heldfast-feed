{
 "description": "Search a Lettio mailbox by free-text query (matches sender, subject and body).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Which configured account to use.",
    "type": "string"
   },
   "limit": {
    "description": "How many results (default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Text to search for.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_emails"
}
