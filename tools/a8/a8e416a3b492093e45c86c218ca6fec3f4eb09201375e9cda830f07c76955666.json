 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Import a finished Film script"
 },
 "description": "Imports finished screenplay-style Film text, with SCENE headings, NAME: dialogue and optional visualWorld. Preserves scenes, dialogue and speaker names, caps Film at five minutes and reports uncast speakers. Identical retries return the same plan. A visualWorld is required for quoting. No Brix36 planning model or credit charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cast": {
    "description": "Optional: artist names to cast, in slot order. Names must be the customer's own artists.",
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 6,
    "type": "array"
   },
   "expectedRevisionId": {
    "description": "The revisionId from studio_sections_read, or null only when no storyboard exists.",
    "maxLength": 64,
    "minLength": 1,
    "type": [
     "string",
     "null"
    ]
   },
   "language": {
    "description": "The selected Film language. The host validates its actual model capability; text is not translated.",
    "maxLength": 35,
    "minLength": 2,
    "type": "string"
   },
   "projectId": {
    "description": "From studio_video_start with kind 'film'.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "script": {
    "description": "The finished script, exactly as written. Its language is preserved as-is.",
    "maxLength": 100000,
    "minLength": 1,
    "type": "string"
   },
   "visualWorld": {
    "additionalProperties": false,
    "description": "Board-wide visual facts. Optional characters, vehicles, locations, props and never are arrays of up to 12 non-empty strings, each at most 300 characters. Combined rendered fields are limited to 2,400 characters including labels, separators and newlines after trimming. Scene-specific costume and visual direction belong to scene text.",
    "properties": {
     "artist": {
      "description": "A non-empty concrete visual fact; 300 characters at most.",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "type": "string"
     },
     "characters": {
      "items": {
       "description": "A non-empty concrete visual fact; 300 characters at most.",
       "maxLength": 300,
       "minLength": 1,
       "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "light": {
      "description": "A non-empty concrete visual fact; 300 characters at most.",
      "maxLength": 300,
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "type": "string"
     },
     "locations": {
      "items": {
       "description": "A non-empty concrete visual fact; 300 characters at most.",
       "maxLength": 300,
       "minLength": 1,
       "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "never": {
      "items": {
       "description": "A non-empty concrete visual fact; 300 characters at most.",
       "maxLength": 300,
       "minLength": 1,
       "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "palette": {
      "description": "Optional creator-selected palette: 0\u20135 unique uppercase #RRGGBB colours.",
      "items": {
       "pattern": "^#[0-9A-F]{6}$",
       "type": "string"
      },
      "maxItems": 5,
      "type": "array",
      "uniqueItems": true
     },
     "props": {
      "items": {
       "description": "A non-empty concrete visual fact; 300 characters at most.",
       "maxLength": 300,
       "minLength": 1,
       "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
