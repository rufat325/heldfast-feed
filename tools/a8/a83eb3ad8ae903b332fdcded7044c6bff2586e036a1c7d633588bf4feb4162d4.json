{
 "description": "Return the normalized license, caveats, risk level and attribution text for an image id returned by search_images.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "image_id": {
    "type": "string"
   },
   "need_modification": {
    "default": true,
    "description": "Exclude ND licenses (you may crop/resize/overlay)",
    "type": "boolean"
   },
   "no_attribution_only": {
    "default": false,
    "description": "Only return images that need no attribution (CC0/PD/Pixabay/Pexels)",
    "type": "boolean"
   },
   "no_share_alike": {
    "default": true,
    "description": "Exclude SA licenses",
    "type": "boolean"
   },
   "usage": {
    "default": "commercial",
    "description": "commercial excludes CC NC licenses",
    "enum": [
     "commercial",
     "editorial"
    ],
    "type": "string"
   }
  },
  "required": [
   "image_id"
  ],
  "type": "object"
 },
 "name": "get_license",
 "title": "Get full license details for an image"
}
