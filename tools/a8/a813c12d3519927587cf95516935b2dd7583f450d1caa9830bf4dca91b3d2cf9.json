{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Atur atau tambah cahaya. `id` yang sudah ada akan DITIMPA, jadi tool ini juga cara mengubah matahari bawaan. Adegan tanpa satu pun cahaya berkekuatan > 0 ditolak saat terbit \u2014 ia akan terbit HITAM, dan layar hitam tanpa pesan adalah kegagalan yang paling mahal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bayangan": {
    "type": "boolean"
   },
   "hapus": {
    "default": false,
    "type": "boolean"
   },
   "id": {
    "pattern": "^[A-Za-z0-9._-]{1,64}$",
    "type": "string"
   },
   "jenis": {
    "enum": [
     "lingkungan",
     "arah",
     "titik",
     "sorot"
    ],
    "type": "string"
   },
   "kuat": {
    "maximum": 200,
    "minimum": 0,
    "type": "number"
   },
   "posisi": {
    "items": {
     "type": "number"
    },
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "ruang": {
    "default": "utama",
    "description": "Nama ruang kerja; tiap ruang punya adegan.blend sendiri.",
    "pattern": "^[A-Za-z0-9._-]{1,64}$",
    "type": "string"
   },
   "warna": {
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "rupa_adegan_cahaya"
}
