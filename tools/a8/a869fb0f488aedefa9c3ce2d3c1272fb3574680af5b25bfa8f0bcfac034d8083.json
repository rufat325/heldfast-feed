{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Scan books for metadata problems: missing fields, raw-filename titles, invalid ISBNs, author-sort mismatches, series gaps. Defaults to the whole library; narrow with ids/query/filter (a bundle name) or specific checks. Read-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "checks": {
    "items": {
     "enum": [
      "missing_metadata",
      "raw_filename_title",
      "isbn_invalid",
      "author_sort_mismatch",
      "series_gaps"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "cursor": {
    "type": "string"
   },
   "filter": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "ids": {
    "items": {
     "anyOf": [
      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      {
       "minLength": 1,
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "library": {
    "type": "string"
   },
   "limit": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "query": {
    "maxLength": 512,
    "type": "string"
   },
   "readability": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "calibre_quality_report",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "booksScanned": {
    "type": "number"
   },
   "byCheck": {
    "additionalProperties": {
     "type": "number"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "capped": {
    "type": "boolean"
   },
   "count": {
    "type": "number"
   },
   "nextCursor": {
    "type": "string"
   },
   "offset": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Quality report"
}
