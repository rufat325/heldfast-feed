{
 "description": "Rough sizing \u2014 convert between finished (planed, kiln-dried) and rough-sawn dimensions before drying and planing. Adds planing allowance (default 2.5 mm/face) + saw kerf (default 2.2 mm band) and applies WH-2021 Eq. 4-9 shrinkage. Direction: tangential (board width) or radial (board thickness).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "custom_fsp_pct": {
    "description": "Custom FSP %, default 30",
    "minimum": 0,
    "type": "number"
   },
   "custom_shrink_od_pct": {
    "description": "Custom S_od % (used if no species)",
    "minimum": 0,
    "type": "number"
   },
   "direction": {
    "enum": [
     "tangential",
     "radial"
    ],
    "type": "string"
   },
   "finished_mc_pct": {
    "description": "Target finished MC, %",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "finished_mm": {
    "description": "Finished dimension mm (forward mode)",
    "minimum": 0,
    "type": "number"
   },
   "kerf_mm": {
    "description": "Saw kerf, mm (default 2.2 band)",
    "minimum": 0,
    "type": "number"
   },
   "mode": {
    "default": "forward",
    "enum": [
     "forward",
     "reverse"
    ],
    "type": "string"
   },
   "planing_mm": {
    "description": "Planing allowance per face, mm (default 2.5)",
    "minimum": 0,
    "type": "number"
   },
   "rough_mm": {
    "description": "Rough-sawn dimension mm (reverse mode)",
    "minimum": 0,
    "type": "number"
   },
   "sawn_mc_pct": {
    "description": "MC at which the wood is sawn, %",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "species": {
    "description": "Species key for shrinkage (e.g. 'white-oak')",
    "type": "string"
   }
  },
  "required": [
   "finished_mc_pct",
   "sawn_mc_pct",
   "direction"
  ],
  "type": "object"
 },
 "name": "rough_sizing"
}
