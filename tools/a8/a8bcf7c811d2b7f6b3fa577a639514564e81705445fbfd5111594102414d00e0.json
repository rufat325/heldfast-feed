{
 "description": "Get growing degree days (GDD) for given latitude and longitude.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base_temperature": {
    "default": 50,
    "description": "Base temperature threshold",
    "type": "number"
   },
   "end_date": {
    "description": "End date in YYYY-MM-DD format",
    "type": "string"
   },
   "latitude": {
    "description": "Latitude of the location",
    "type": "number"
   },
   "longitude": {
    "description": "Longitude of the location",
    "type": "number"
   },
   "lower_cutoff": {
    "description": "Lower cutoff temperature",
    "type": "number"
   },
   "start_date": {
    "description": "Start date in YYYY-MM-DD format",
    "type": "string"
   },
   "unit": {
    "default": "F",
    "description": "Temperature unit: 'F' or 'C'",
    "enum": [
     "F",
     "C"
    ],
    "type": "string"
   },
   "upper_cutoff": {
    "description": "Upper cutoff temperature",
    "type": "number"
   }
  },
  "required": [
   "latitude",
   "longitude",
   "start_date",
   "end_date"
  ],
  "type": "object"
 },
 "name": "growing_degree_days"
}
