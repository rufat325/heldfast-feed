{
 "description": "Gestiona equipos. Acciones: list (page, limit), get (id), create, update (id), delete (id), members (id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "members"
    ],
    "type": "string"
   },
   "id": {
    "description": "ID del equipo",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "members": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "teams"
}
