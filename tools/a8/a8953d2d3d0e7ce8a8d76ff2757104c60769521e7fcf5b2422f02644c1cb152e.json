{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare two retained snapshots. No longer observed does not mean reinstated; enrichment-only changes are excluded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque next_cursor from an earlier change page.",
    "type": [
     "string",
     "null"
    ]
   },
   "from_generation": {
    "description": "Older retained snapshot UUID to compare.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum changes to return, up to the service page limit.",
    "format": "uint",
    "maximum": 50,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "to_generation": {
    "description": "Newer retained snapshot UUID; omit for the current snapshot.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "from_generation"
  ],
  "type": "object"
 },
 "name": "exclusion_changes",
 "outputSchema": {
  "$defs": {
   "ExclusionChange": {
    "properties": {
     "change": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "change"
    ],
    "type": "object"
   },
   "JsonObject": {
    "description": "Source-specific JSON map. The envelope is stable; map keys vary by official source.",
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from_coverage": {
    "$ref": "#/$defs/JsonObject"
   },
   "from_generation": {
    "type": "string"
   },
   "items": {
    "items": {
     "$ref": "#/$defs/ExclusionChange"
    },
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "to_coverage": {
    "$ref": "#/$defs/JsonObject"
   },
   "to_generation": {
    "type": "string"
   }
  },
  "required": [
   "from_generation",
   "to_generation",
   "from_coverage",
   "to_coverage",
   "items",
   "meaning"
  ],
  "type": "object"
 },
 "title": "Review exclusion changes"
}
