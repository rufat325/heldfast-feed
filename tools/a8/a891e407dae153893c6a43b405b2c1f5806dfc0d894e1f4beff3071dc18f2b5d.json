{
 "annotations": {},
 "description": "Reset password for a Data Forest account",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Account unique identifier (Base62-encoded UUID)",
    "maxLength": 22,
    "type": "string"
   },
   "password": {
    "description": "New password (letters + numbers + special chars, 8-20 chars)",
    "maxLength": 20,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "id",
   "password"
  ],
  "type": "object"
 },
 "name": "ncloud_dataforest_reset_password"
}
