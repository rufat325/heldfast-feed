{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List accepted org users with id, name, email, role, and timestamps. Use this to find a user_id before get_user, update_user, delete_user, or add_workspace_member; use list_user_invites for pending invitations. Enterprise-gated. Returns 403 on non-Enterprise Portkey plans.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "current_page": {
    "description": "Zero-based page number; the first page is 0",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "email": {
    "description": "Filter by exact email",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "page_size": {
    "description": "Number of results per page (max 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "role": {
    "description": "Filter by organisation role",
    "enum": [
     "admin",
     "member",
     "owner"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_all_users",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
