{
 "description": "Create a VayaPin business profile from enriched data.\nRequires business basics (name, country, coordinates) and website content (markdown URL or direct content).\nThis is a convenience wrapper for submit_job with type=spiderVayapin.",
 "inputSchema": {
  "properties": {
   "business_address": {
    "description": "Full business address",
    "type": "string"
   },
   "business_name": {
    "description": "Business name for the VayaPin profile",
    "type": "string"
   },
   "business_phone": {
    "description": "Business phone number",
    "type": "string"
   },
   "country_code": {
    "description": "2-letter ISO country code (e.g., \"DK\", \"US\", \"DE\")",
    "type": "string"
   },
   "domain": {
    "description": "Website domain (e.g., \"example.com\")",
    "type": "string"
   },
   "emails_verified": {
    "description": "Verified emails from SpiderVerify [{email, status, source}]",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "facebook": {
    "description": "Facebook page URL",
    "type": "string"
   },
   "gmaps_link": {
    "description": "Google Maps URL",
    "type": "string"
   },
   "instagram": {
    "description": "Instagram profile URL",
    "type": "string"
   },
   "latitude": {
    "description": "Latitude from Google Maps",
    "type": "number"
   },
   "linkedin": {
    "description": "LinkedIn page URL",
    "type": "string"
   },
   "logo": {
    "description": "Logo image URL",
    "type": "string"
   },
   "longitude": {
    "description": "Longitude from Google Maps",
    "type": "number"
   },
   "markdown_compendium": {
    "description": "Direct markdown content (alternative to markdown_url)",
    "type": "string"
   },
   "markdown_url": {
    "description": "URL to crawled website markdown file (from SpiderSite/SpiderMedia)",
    "type": "string"
   },
   "original_website": {
    "description": "Original website URL",
    "type": "string"
   },
   "test": {
    "description": "Route to test queue (default: false)",
    "type": "boolean"
   },
   "twitter": {
    "description": "Twitter/X profile URL",
    "type": "string"
   },
   "workspace": {
    "description": "Tenant to target (cli_\u2026). Omit to use the active/bound workspace. list_workspaces shows the options.",
    "type": "string"
   }
  },
  "required": [
   "business_name",
   "country_code",
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "submit_vayapin"
}
