{
 "annotations": {
  "readOnlyHint": true,
  "title": "List raw events"
 },
 "description": "List individual click, lead and sale events rather than aggregates \u2014 the row-level detail behind the analytics. Dub: GET /events.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customerId": {
    "description": "Only this customer's events.",
    "type": "string"
   },
   "end": {
    "description": "ISO-8601 end of an absolute range.",
    "type": "string"
   },
   "event": {
    "description": "Which event type to list.",
    "enum": [
     "clicks",
     "leads",
     "sales"
    ],
    "type": "string"
   },
   "interval": {
    "description": "Relative time window. Use start/end instead for an absolute range.",
    "enum": [
     "24h",
     "7d",
     "30d",
     "90d",
     "1y",
     "mtd",
     "qtd",
     "ytd",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Page size, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "linkId": {
    "description": "Only this link's events.",
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "start": {
    "description": "ISO-8601 start of an absolute range.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "dub_list_events",
 "title": "List raw events"
}
