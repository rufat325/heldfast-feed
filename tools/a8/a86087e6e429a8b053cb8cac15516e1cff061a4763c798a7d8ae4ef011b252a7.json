 },
 "description": "Accounts receivable or accounts payable aging: the open balances per customer or supplier, split into not yet due, 1-30, 31-60, 61-90 and over 90 days past due, with totals. Reads the items open now; as_of_date only decides how overdue each one counts as. Items whose source sent no due date are aged from their issue date and counted in aged_from_issue_count. Read-only.",
 "inputSchema": {
  "properties": {
   "asOfDate": {
    "maxLength": 10,
    "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "currencyCode": {
    "maxLength": 3,
    "pattern": "^([A-Z]{3})?$",
    "type": "string"
   },
   "side": {
    "enum": [
     "AGING_SIDE_RECEIVABLE",
     "AGING_SIDE_PAYABLE"
    ],
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "accounting_get_aging_report",
 "outputSchema": {
  "properties": {
   "agedFromIssueCount": {
    "type": "integer"
   },
   "asOfDate": {
    "type": "string"
   },
   "currencyCode": {
    "type": "string"
   },
   "rows": {
    "items": {
     "properties": {
      "notYetDue": {
       "type": "string"
      },
      "overdue1To30": {
       "type": "string"
      },
      "overdue31To60": {
       "type": "string"
      },
      "overdue61To90": {
       "type": "string"
      },
      "overdue90Plus": {
       "type": "string"
      },
      "partyName": {
       "type": "string"
      },
      "total": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "totals": {
    "anyOf": [
     {
      "properties": {
       "notYetDue": {
        "type": "string"
       },
       "overdue1To30": {
        "type": "string"
       },
       "overdue31To60": {
        "type": "string"
       },
       "overdue61To90": {
        "type": "string"
       },
       "overdue90Plus": {
        "type": "string"
       },
       "partyName": {
        "type": "string"
       },
       "total": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Get Aging Report"
}
