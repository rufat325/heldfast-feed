{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validazione offline di un codice fiscale italiano. Per le persone fisiche (16 caratteri) verifica il carattere di controllo, gestisce l'omocodia ed estrae sesso, data di nascita (anno con secolo dedotto) e codice catastale del comune. Per le persone giuridiche (11 cifre) applica il controllo della partita IVA.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "codice_fiscale": {
    "description": "Codice fiscale, 16 caratteri o 11 cifre, es. 'RSSMRA85T10A562S'",
    "type": "string"
   }
  },
  "required": [
   "codice_fiscale"
  ],
  "type": "object"
 },
 "name": "valida_codice_fiscale",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dati": {
    "additionalProperties": {},
    "properties": {
     "anno_ambiguo": {
      "type": "boolean"
     },
     "codice_catastale": {
      "type": "string"
     },
     "data_nascita": {
      "description": "YYYY-MM-DD; il secolo \u00e8 dedotto",
      "type": "string"
     },
     "luogo_nascita": {
      "type": "string"
     },
     "nato_estero": {
      "type": "boolean"
     },
     "omocodia": {
      "type": "boolean"
     },
     "provincia_nascita": {
      "type": "string"
     },
     "sesso": {
      "enum": [
       "M",
       "F"
      ],
      "type": "string"
     }
    },
    "required": [
     "sesso",
     "data_nascita",
     "anno_ambiguo",
     "codice_catastale",
     "nato_estero",
     "omocodia"
    ],
    "type": "object"
   },
   "errore": {
    "type": "string"
   },
   "input": {
    "type": "string"
   },
   "normalizzato": {
    "type": "string"
   },
   "tipo": {
    "enum": [
     "persona_fisica",
     "persona_giuridica"
    ],
    "type": "string"
   },
   "valido": {
    "type": "boolean"
   }
  },
  "required": [
   "input",
   "normalizzato",
   "valido"
  ],
  "type": "object"
 },
 "title": "Valida codice fiscale"
}
