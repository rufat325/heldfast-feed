{
 "description": "Save a complete order configuration as a reusable template. Persists in ~/.probo-connect/. Use placeOrderFromTemplate to re-order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "additionalOptions": {
    "additionalProperties": false,
    "description": "Additional order options",
    "properties": {
     "callbackUrl": {
      "anyOf": [
       {
        "format": "uri",
        "type": "string"
       },
       {
        "items": {
         "format": "uri",
         "type": "string"
        },
        "type": "array"
       }
      ],
      "description": "Callback URL(s) for order status updates"
     },
     "contactEmail": {
      "description": "Contact email for the order",
      "format": "email",
      "type": "string"
     },
     "deliveryDate": {
      "description": "Specific delivery date (YYYY-MM-DD)",
      "type": "string"
     },
     "deliveryDatePreset": {
      "description": "Delivery date preset (e.g., \"cheapest\")",
      "type": "string"
     },
     "errorEmails": {
      "anyOf": [
       {
        "format": "email",
        "type": "string"
       },
       {
        "items": {
         "format": "email",
         "type": "string"
        },
        "type": "array"
       }
      ],
      "description": "Email address(es) for error notifications"
     },
     "orderId": {
      "description": "Custom order ID (alphanumeric, underscore, hyphen)",
      "pattern": "^[\\w-]+$",
      "type": "string"
     },
     "shippingMethodCode": {
      "description": "Specific shipping method code (e.g., \"onb-express\")",
      "type": "string"
     },
     "shippingMethodPreset": {
      "description": "Shipping method preset (e.g., \"cheapest\")",
      "type": "string"
     }
    },
    "type": "object"
   },
   "address": {
    "additionalProperties": false,
    "description": "Default delivery address (optional)",
    "properties": {
     "address_addition": {
      "description": "House number addition",
      "type": "string"
     },
     "address_city": {
      "description": "City",
      "type": "string"
     },
     "address_company_name": {
      "description": "Company name (required by Probo API)",
      "type": "string"
     },
     "address_country": {
      "description": "Country code (ISO 3166-1 alpha-2)",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "address_email": {
      "description": "Email address",
      "format": "email",
      "type": "string"
     },
     "address_first_name": {
      "description": "First name",
      "type": "string"
     },
     "address_house_number": {
      "description": "House number",
      "type": [
       "string",
       "number"
      ]
     },
     "address_last_name": {
      "description": "Last name",
      "type": "string"
     },
     "address_postal_code": {
      "description": "Postal code",
      "type": "string"
     },
     "address_street": {
      "description": "Street name",
      "type": "string"
     },
     "address_telephone_number": {
      "description": "Phone number",
      "type": "string"
     }
    },
    "required": [
     "address_company_name",
     "address_first_name",
     "address_street",
     "address_postal_code",
     "address_city",
     "address_country"
    ],
    "type": "object"
   },
   "name": {
    "description": "Template name, e.g. \"weekly-banner-order\"",
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Optional notes about this template",
    "type": "string"
   },
   "products": {
    "description": "Products with code/customer_code, options, files",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "code": {
         "description": "Probo product code",
         "minLength": 2,
         "type": "string"
        },
        "files": {
         "description": "Product files",
         "items": {
          "additionalProperties": false,
          "description": "Product file",
          "properties": {
           "amount": {
            "description": "Times to print",
            "minimum": 1,
            "type": "number"
           },
           "fill": {
            "description": "Fill canvas",
            "type": "boolean"
           },
           "fill_even": {
            "description": "Fill proportionally",
            "type": "boolean"
           },
           "id": {
            "description": "External file ID",
            "minimum": 1,
            "type": "number"
           },
           "mirror": {
            "description": "Mirror image",
            "type": "boolean"
           },
           "page": {
            "description": "Page number",
            "minimum": 1,
            "type": "number"
           },
           "rotation": {
            "description": "Rotation in degrees",
            "enum": [
             0,
             90,
             180,
             270
            ],
            "type": "number"
           },
           "side": {
            "description": "Print side",
            "enum": [
             "front",
             "back"
            ],
            "type": "string"
           },
           "tiling": {
            "description": "Tiling mode",
            "enum": [
             "none",
             "horizontal",
             "vertical"
            ],
            "type": "string"
           },
           "uri": {
            "description": "URL to print file (.pdf, .jpg, .png)",
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "id": {
         "description": "Product ID",
         "type": [
          "number",
          "string"
         ]
        },
        "options": {
         "description": "Product options",
         "items": {
          "additionalProperties": false,
          "description": "Product configuration option",
          "properties": {
           "code": {
            "description": "Option code",
            "type": "string"
           },
           "value": {
            "description": "Option value",
            "type": [
             "string",
             "number",
             "boolean"
            ]
           }
          },
          "required": [
           "code"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "reference": {
         "description": "Product reference",
         "maxLength": 255,
         "type": "string"
        },
        "uploader": {
         "description": "Use uploader after submitting",
         "type": "boolean"
        },
        "uploaders": {
         "description": "Product uploaders",
         "items": {
          "additionalProperties": false,
          "description": "Product uploader",
          "properties": {
           "external_id": {
            "description": "External uploader ID",
            "type": "number"
           },
           "id": {
            "description": "Uploader ID",
            "type": "number"
           }
          },
          "required": [
           "id",
           "external_id"
          ],
          "type": "object"
         },
         "type": "array"
        }
       },
       "required": [
        "code"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "customer_code": {
         "description": "Customer API product code",
         "minLength": 2,
         "type": "string"
        },
        "files": {
         "description": "Product files",
         "items": {
          "$ref": "#/properties/products/items/anyOf/0/properties/files/items"
         },
         "type": "array"
        },
        "id": {
         "description": "Product ID",
         "type": [
          "number",
          "string"
         ]
        },
        "options": {
         "description": "Product options",
         "items": {
          "$ref": "#/properties/products/items/anyOf/0/properties/options/items"
         },
         "type": "array"
        },
        "reference": {
         "description": "Product reference",
         "maxLength": 255,
         "type": "string"
        },
        "uploader": {
         "description": "Use uploader after submitting",
         "type": "boolean"
        },
        "uploaders": {
         "description": "Product uploaders",
         "items": {
          "$ref": "#/properties/products/items/anyOf/0/properties/uploaders/items"
         },
         "type": "array"
        }
       },
       "required": [
        "customer_code"
       ],
       "type": "object"
      }
     ],
     "description": "Order product (by Probo code or customer code)"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "name",
   "products"
  ],
  "type": "object"
 },
 "name": "saveOrderTemplate"
}
