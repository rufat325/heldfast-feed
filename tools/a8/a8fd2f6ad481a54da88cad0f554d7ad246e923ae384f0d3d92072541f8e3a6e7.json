{
 "description": "Consume units of a player's purchased product from the backoffice (e.g. refund-by-hand, support fixes). Atomic: fails with insufficient_amount if the player has fewer units. The player's game gets a live `purchase` event.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Units to consume (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "appId": {
    "description": "The app public ID",
    "type": "string"
   },
   "productName": {
    "description": "Product id (A-Z a-z 0-9 _ -, max 64)",
    "type": "string"
   },
   "userId": {
    "description": "The player's `_id` from neblla_list_users",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "userId",
   "productName"
  ],
  "type": "object"
 },
 "name": "neblla_consume_purchase"
}
