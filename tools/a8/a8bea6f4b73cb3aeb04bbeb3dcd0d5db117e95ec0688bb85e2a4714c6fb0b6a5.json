   "end": {
    "description": "Window end, ISO8601 datetime.",
    "type": "string"
   },
   "include": {
    "description": "Related resources to embed, e.g. [\"patient\",\"provider\"] (sent as include[]).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location_id": {
    "description": "Restrict to a single location id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "page": {
    "description": "Page number (pagination).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "patient_id": {
    "description": "Filter to one patient.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
