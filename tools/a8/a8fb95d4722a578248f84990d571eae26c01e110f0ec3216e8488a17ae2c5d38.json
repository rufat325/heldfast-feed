{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only prioritization of saved Martin runs that need attention. Use when the user says a prior attempt failed, asks what to fix next, or resumes an interrupted session. Do not use for a brand-new objective with no relevant run history. Next: inspect the selected run or dossier before retrying.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adapterId": {
    "description": "Filter by attempt adapter ID.",
    "type": "string"
   },
   "includeHealthy": {
    "description": "When true, include healthy runs instead of only attention-worthy findings.",
    "type": "boolean"
   },
   "lifecycleState": {
    "description": "Filter by lifecycle state.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of runs to triage. Defaults to 20.",
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Filter by attempt model.",
    "type": "string"
   },
   "runsDir": {
    "description": "Optional runs-root override.",
    "type": "string"
   },
   "status": {
    "description": "Filter by loop status.",
    "type": "string"
   },
   "updatedAfter": {
    "description": "Optional ISO-8601 timestamp for recency filtering.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_triage_runs",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "evaluatedRuns": {
    "type": "integer"
   },
   "filters": {
    "additionalProperties": true,
    "type": "object"
   },
   "findingCount": {
    "type": "integer"
   },
   "findings": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "loop": {
       "additionalProperties": true,
       "properties": {
        "activeAttemptId": {
         "description": "ID of the currently active attempt, when a run is in progress.",
         "type": "string"
        },
        "attempts": {
         "type": "integer"
        },
        "avoidedUsd": {
         "type": "number"
        },
        "costUsd": {
         "type": "number"
        },
        "createdAt": {
         "type": "string"
        },
        "lastAttempt": {
         "additionalProperties": true,
         "type": "object"
        },
        "lifecycleState": {
         "type": "string"
        },
        "loopId": {
         "type": "string"
        },
        "objective": {
         "type": "string"
        },
        "pressure": {
         "type": "string"
        },
        "remainingBudgetUsd": {
         "type": "number"
        },
        "remainingIterations": {
         "type": "integer"
        },
        "remainingTokens": {
         "type": "integer"
        },
        "shouldStop": {
         "type": "boolean"
        },
        "status": {
         "type": "string"
        },
        "title": {
         "type": "string"
        },
        "updatedAt": {
         "type": "string"
        }
       },
       "required": [
        "loopId",
        "title",
        "objective",
        "status",
        "lifecycleState",
        "attempts",
        "costUsd",
        "avoidedUsd",
        "pressure",
        "shouldStop",
        "remainingBudgetUsd",
        "remainingIterations"
       ],
       "type": "object"
      },
      "reasonCodes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "suggestedPrompts": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "suggestedResources": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      },
      "verification": {
       "additionalProperties": true,
       "properties": {
        "completedAt": {
         "type": "string"
        },
        "eventCount": {
         "type": "integer"
        },
        "latestAttemptIndex": {
         "type": "integer"
        },
        "ledgerEventCount": {
         "type": "integer"
        },
        "status": {
         "enum": [
          "passed",
          "failed",
          "contradicted",
          "not_run"
         ],
         "type": "string"
        },
        "steps": {
         "items": {
          "additionalProperties": true,
          "properties": {
           "command": {
            "type": "string"
           },
           "detail": {
            "type": "string"
           },
           "exitCode": {
            "type": "integer"
           },
           "fastFail": {
            "type": "boolean"
           },
           "launched": {
            "type": "boolean"
           },
           "timedOut": {
            "type": "boolean"
           }
          },
          "required": [
           "command",
           "launched"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "summary": {
         "type": "string"
        },
        "warnings": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "status",
        "eventCount",
        "ledgerEventCount",
        "warnings"
       ],
       "type": "object"
      }
     },
     "required": [
      "severity",
      "summary",
      "reasonCodes",
      "loop",
      "verification",
      "suggestedResources",
      "suggestedPrompts"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "runsRoot": {
    "type": "string"
   },
   "severityBreakdown": {
    "additionalProperties": {
     "type": "integer"
    },
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "runsRoot",
   "filters",
   "evaluatedRuns",
   "findingCount",
   "severityBreakdown",
   "findings",
   "warnings"
  ],
  "type": "object"
 }
}
