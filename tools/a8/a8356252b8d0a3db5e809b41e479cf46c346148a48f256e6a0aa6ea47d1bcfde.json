  "title": "chainpeek: DEX trading volume by protocol and by chain over 24 hours, 7 days and 30 days (cached DefiLlama data)"
 },
 "description": "chainpeek: Get DEX volume by protocol and chain. For TVL use get_protocol_tvl. Returns DEX volume over 24 hours, 7 days and 30 days with change: a DEX's chains, a chain's largest DEXs, a DEX on a chain, or the market total and the largest DEXs, from Tanod's cache of DefiLlama data. Input: optional `protocol`, optional `chain` and `limit`; give one, both or neither. Cached DefiLlama data (refreshed every few hours), never live; `as_of` shows its age; chain tables cover the 25 chains with the most volume; an unknown name is a 422 with suggestions and a missing or over-2-day-old cache a 503 (neither charged). Informational only. Typically under 1 s (a local cache read). Price: USD 0.004. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/defi-data-api.html",
 "inputSchema": {
  "properties": {
   "chain": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^.*[A-Za-z0-9].*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Chain name among the 25 chains with the most DEX volume, e.g. Solana, Ethereum, Base, BSC. With protocol: that DEX's volume on the chain. Alone: the chain and its largest DEXs.",
    "title": "Chain"
   },
   "limit": {
    "default": 10,
    "description": "Rows in a ranking or a breakdown, 1-50 (default 10).",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "protocol": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^.*[A-Za-z0-9].*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "DEX name or slug, e.g. uniswap, uniswap-v3, curve-dex, pancakeswap-amm (a parent such as uniswap sums its versions). Omit for a chain or the overview.",
    "title": "Protocol"
   }
  },
  "title": "get_dex_volumeArguments",
  "type": "object"
 },
