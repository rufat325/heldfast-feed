{"description":"Use for supplier identity and VAT reconciliation, not the full signed five-gate invoice decision. Reconciles the claimed legal name, company registration number and VAT number against the Irish Companies Registration Office (IE) and the EU VIES VAT service, and returns an advisory RELEASE, REVIEW, BLOCK or INSUFFICIENT_EVIDENCE decision with per-check results and reason codes plus verification_id. Use decide_supplier_payment for the signed invoice/PO/GRN workflow, individual check tools for one check, and get_verification only to retrieve this stored result. This creates a verification and may call external sources; it never executes or authorises a bank payment. Requires explicit x402 service-fee approval or an authorized bearer token; do not automatically retry paid calls.","inputSchema":{"$defs":{"AssertionsInput":{"additionalProperties":false,"properties":{"amount_within_po":{"title":"Amount Within Po","type":"boolean"},"assertion_source":{"anyOf":[{"enum":["SAP","D365","ORACLE","NETSUITE","OTHER"],"type":"string"},{"type":"null"}],"default":null,"title":"Assertion Source"},"currency_matched":{"title":"Currency Matched","type":"boolean"},"invoice_supplier_matched":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Invoice Supplier Matched"},"po_matched":{"title":"Po Matched","type":"boolean"},"supplier_approved":{"title":"Supplier Approved","type":"boolean"}},"required":["supplier_approved","po_matched","amount_within_po","currency_matched"],"title":"AssertionsInput","type":"object"},"CallbackInput":{"additionalProperties":false,"properties":{"authentication_reference":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Authentication Reference"},"url":{"title":"Url","type":"string"}},"required":["url"],"title":"CallbackInput","type":"object"},"EvidenceInput":{"additionalProperties":false,"properties":{"content_uri":{"anyOf":[{"maxLength":2048,"type":"string"},{"type":"null"}],"default":null,"ti