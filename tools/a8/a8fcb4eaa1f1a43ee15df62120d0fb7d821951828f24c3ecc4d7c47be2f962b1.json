     "hr",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "description": "How many results (default 10, at most what the plan allows).",
    "type": "integer"
   },
   "q": {
    "description": "Search: product, brand, store, hazard.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_product_recalls",
