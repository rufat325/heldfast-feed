  "title": "Product recalls"
 },
 "description": "Product recalls and food/consumer safety warnings in Croatia (Adios Radar: HAPIH, EU RASFF, Safety Gate): product, brand, stores, risk, reason, link. Search by product, brand, store or hazard; lang=en for English.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lang": {
    "description": "hr (default) or en.",
