      "brand": {
       "type": [
        "string",
        "null"
       ]
      },
      "cancelled": {
       "type": "boolean"
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "hazard": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "image_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "products": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "published_at": {
       "format": "date-time",
       "type": "string"
      },
      "reason": {
       "type": [
        "string",
        "null"
       ]
      },
      "risk": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "stores": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "summary",
      "published_at",
      "risk",
      "type",
      "stores",
      "products",
      "source",
      "cancelled",
      "url"
     ],
     "type": "object"
