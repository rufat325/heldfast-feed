{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add competencies to an interview plan draft"
 },
 "description": "Add competencies to a draft exactly as written \u2014 deterministic, no AI generation. Requires confirmed outcomes; the resulting stage must stay within 25 competencies. Optional source_stage {stage: competencies, version} returns 409 when stale.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.add_competencies",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "competency": {
         "maxLength": 300,
         "type": "string"
        },
        "definition": {
         "maxLength": 5000,
         "type": "string"
        },
        "description": {
         "maxLength": 5000,
         "type": "string"
        },
        "details": {
         "maxLength": 5000,
         "type": "string"
        },
        "id": {
         "maxLength": 128,
         "type": "string"
        },
        "name": {
         "maxLength": 300,
         "type": "string"
        },
        "title": {
         "maxLength": 300,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 25,
      "minItems": 1,
      "type": "array"
     },
     "source_stage": {
      "additionalProperties": false,
      "properties": {
       "stage": {
        "const": "competencies",
        "type": "string"
       },
       "version": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "stage"
      ],
      "type": "object"
     }
    },
    "required": [
     "items"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_add_competencies",
 "title": "Add competencies to an interview plan draft"
}
