{
 "description": "Create a new WordPress user",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Biographical info",
    "type": "string"
   },
   "email": {
    "description": "Email address",
    "format": "email",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "locale": {
    "description": "Locale, e.g. de_DE ('' = site default); must be an installed language",
    "type": "string"
   },
   "meta": {
    "additionalProperties": {},
    "description": "Registered user meta fields (show_in_rest) as key/value",
    "type": "object"
   },
   "name": {
    "description": "Display name",
    "type": "string"
   },
   "nickname": {
    "description": "Nickname",
    "type": "string"
   },
   "password": {
    "description": "Password (write-only, never returned)",
    "type": "string"
   },
   "roles": {
    "description": "Roles, e.g. ['editor'] (replaces the current roles)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "URL slug (user_nicename)",
    "type": "string"
   },
   "url": {
    "description": "Website URL",
    "type": "string"
   },
   "username": {
    "description": "Username (login name, cannot be changed later)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "username",
   "email",
   "password"
  ],
  "type": "object"
 },
 "name": "wp_create_user"
}
