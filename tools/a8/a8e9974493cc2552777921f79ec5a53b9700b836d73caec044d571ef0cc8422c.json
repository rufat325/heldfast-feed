{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get campaign recipient activity"
 },
 "description": "Per-recipient activity for a campaign by type: Sent, Opened, LinkClicked, Unsubscribed, Bounced, Complained, or Activity (all). Paged (default 50, max 1000) and filterable by date. NOTE: Moosend rate-limits this endpoint to 2 calls per 60 seconds per API key. Moosend: GET /campaigns/{CampaignID}/stats/{Type}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "campaign_id": {
    "description": "Campaign ID (a GUID, from moosend_list_campaigns).",
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "Start date, DD-MM-YYYY. Default: the send date.",
    "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1. Default 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page, 1-1000.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "End date, DD-MM-YYYY. Default: today.",
    "pattern": "^\\d{2}-\\d{2}-\\d{4}$",
    "type": "string"
   },
   "type": {
    "description": "Activity type. Default Sent.",
    "enum": [
     "Sent",
     "Opened",
     "LinkClicked",
     "Unsubscribed",
     "Bounced",
     "Complained",
     "Activity"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "moosend_get_campaign_activity",
 "title": "Get campaign recipient activity"
}
