{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Schedule a maintenance window on a status page with affected components",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "completedDescription": {
    "description": "Description shown when maintenance is completed",
    "type": "string"
   },
   "componentsAffected": {
    "description": "List of affected components",
    "items": {
     "properties": {
      "id": {
       "description": "Component ID",
       "type": "string"
      },
      "status": {
       "description": "Component status during maintenance",
       "enum": [
        "operational",
        "degraded_performance",
        "partial_outage",
        "major_outage",
        "under_maintenance"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "inProgressDescription": {
    "description": "Description shown when maintenance is in progress",
    "type": "string"
   },
   "notifySubscribers": {
    "description": "Whether to notify page subscribers",
    "type": "boolean"
   },
   "pageId": {
    "description": "The status page ID",
    "type": "string"
   },
   "scheduledDescription": {
    "description": "Description shown when maintenance is scheduled",
    "type": "string"
   },
   "startDate": {
    "description": "Scheduled start date (ISO 8601 format)",
    "type": "string"
   },
   "title": {
    "description": "Title of the maintenance window",
    "type": "string"
   }
  },
  "required": [
   "pageId",
   "title",
   "componentsAffected"
  ],
  "type": "object"
 },
 "name": "create-status-page-maintenance"
}
