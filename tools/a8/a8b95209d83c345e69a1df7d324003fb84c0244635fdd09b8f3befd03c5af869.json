{
 "description": "Read an Ultra discussion as a thread: discussion topic, top-level posts, and replies. Embedded Blackboard images, audio, video, and files are included in embeddedFiles; supported media are also returned as resource_link blocks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "courseId": {
    "description": "Blackboard course ID",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "discussionId": {
    "description": "Discussion ID from blackboard_list_discussions",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "maxDepth": {
    "description": "Reply nesting depth to follow (default 1)",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "messageLimit": {
    "description": "Maximum top-level posts to read (default 10)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "replyLimit": {
    "description": "Maximum replies per message to read (default 10)",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Message status filter (default Published)",
    "enum": [
     "Published",
     "Deleted",
     "Draft"
    ],
    "type": "string"
   }
  },
  "required": [
   "courseId",
   "discussionId"
  ],
  "type": "object"
 },
 "name": "blackboard_get_discussion_thread"
}
