{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create work order schedule"
 },
 "description": "Schedule a work order for a technician on a date (one entry of a day plan). stop_order gives the position in the technician's day; leave it unset for an unordered calendar entry. Requires work_order_schedules:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "duration_minutes": {
    "description": "Planned duration in minutes",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "scheduled_date": {
    "description": "Date (YYYY-MM-DD, required)",
    "type": "string"
   },
   "scheduled_end_time": {
    "description": "End time (HH:MM)",
    "type": "string"
   },
   "scheduled_start_time": {
    "description": "Start time (HH:MM)",
    "type": "string"
   },
   "scheduling_notes": {
    "description": "Scheduling notes",
    "type": "string"
   },
   "stop_order": {
    "description": "1-based stop position in the day plan",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "technician_id": {
    "description": "Technician Clerk user ID (required)",
    "minLength": 1,
    "type": "string"
   },
   "travel_time_minutes": {
    "description": "Travel time from previous stop",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "work_order_id": {
    "description": "Work order ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "work_order_id",
   "technician_id",
   "scheduled_date"
  ],
  "type": "object"
 },
 "name": "create_work_order_schedule",
 "title": "Create work order schedule"
}
