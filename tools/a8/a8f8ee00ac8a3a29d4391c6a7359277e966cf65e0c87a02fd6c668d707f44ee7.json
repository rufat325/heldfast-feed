{
 "description": "Cancel an unpaid reservation. Paid visits are not cancelled here. Requires the agent bearer token.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "session_id": {
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "cancel_booking",
 "outputSchema": {
  "$defs": {
   "BookingStatus": {
    "properties": {
     "consultation_id": {
      "format": "int64",
      "type": "integer"
     },
     "paid": {
      "type": "boolean"
     },
     "public_token": {
      "type": "string"
     },
     "start_utc": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "ticket_id": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "consultation_id",
     "public_token",
     "status",
     "start_utc",
     "paid"
    ],
    "type": "object"
   },
   "PriceQuote": {
    "properties": {
     "currency": {
      "type": "string"
     },
     "duration_label": {
      "type": "string"
     },
     "minutes": {
      "format": "int32",
      "type": "integer"
     },
     "price_cents": {
      "format": "int64",
      "type": "integer"
     },
     "price_label": {
      "type": "string"
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "minutes",
     "duration_label",
     "price_cents",
     "price_label",
     "currency",
     "source"
    ],
    "type": "object"
   },
   "SessionState": {
    "enum": [
     "AI_TRIAGE",
     "AI_TROUBLESHOOTING",
     "HUMAN_REQUESTED",
     "AWAITING_TIME_SELECTION",
     "AWAITING_CUSTOMER_CONFIRMATION",
     "AWAITING_PAYMENT",
     "BOOKED",
     "TECHNICIAN_ASSIGNED",
     "SESSION_READY",
     "IN_PROGRESS",
     "COMPLETED",
     "CANCELLED"
    ],
    "type": "string"
   },
   "SlotOffer": {
    "properties": {
     "label": {
      "type": "string"
     },
     "minutes": {
      "format": "int32",
      "type": "integer"
     },
     "start_utc": {
      "type": "string"
     }
    },
    "required": [
     "start_utc",
     "label",
     "minutes"
    ],
    "type": "object"
   },
   "TriageResult": {
    "properties": {
     "agents_pay_crypto_for_human_requests": {
      "default": true,
      "description": "Always true. An agent that asks for a human pays that task in crypto.",
      "type": "boolean"
     },
     "asked_os": {
      "default": false,
      "type": "boolean"
     },
     "category": {
      "type": "string"
     },
     "confidence": {
      "format": "float",
      "type": "number"
     },
     "customer_summary": {
      "type": "string"
     },
     "device_type": {
      "type": "string"
     },
     "error_messages": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "estimated_minutes": {
      "format": "int32",
      "type": "integer"
     },
     "human_required": {
      "type": "boolean"
     },
     "offered_slots": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "operating_system": {
      "type": "string"
     },
     "remote_support_possible": {
      "type": "boolean"
     },
     "severity": {
      "type": "string"
     },
     "steps_already_attempted": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "subcategory": {
      "type": "string"
     },
     "suggested_next_action": {
      "type": "string"
     },
     "symptoms": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "technician_summary": {
      "type": "string"
     },
     "ticket_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "urgency": {
      "type": "string"
     }
    },
    "required": [
     "category",
     "subcategory",
     "device_type",
     "operating_system",
     "symptoms",
     "error_messages",
     "steps_already_attempted",
     "severity",
     "urgency",
     "remote_support_possible",
     "human_required",
     "estimated_minutes",
     "customer_summary",
     "technician_summary",
     "suggested_next_action",
     "confidence"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "booking": {
    "anyOf": [
     {
      "$ref": "#/$defs/BookingStatus"
     },
     {
      "type": "null"
     }
    ]
   },
   "checkout_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "payment_status": {
    "type": "string"
   },
   "price": {
    "anyOf": [
     {
      "$ref": "#/$defs/PriceQuote"
     },
     {
      "type": "null"
     }
    ]
   },
   "session_id": {
    "format": "uuid",
    "type": "string"
   },
   "slots": {
    "items": {
     "$ref": "#/$defs/SlotOffer"
    },
    "type": "array"
   },
   "speaker": {
    "type": "string"
   },
   "state": {
    "$ref": "#/$defs/SessionState"
   },
   "triage": {
    "$ref": "#/$defs/TriageResult"
   }
  },
  "required": [
   "session_id",
   "state",
   "speaker",
   "message",
   "triage",
   "slots",
   "payment_status"
  ],
  "type": "object"
 }
}
