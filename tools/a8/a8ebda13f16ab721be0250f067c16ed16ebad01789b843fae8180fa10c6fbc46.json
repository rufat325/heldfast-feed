{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search public sexpreparat.ru content in the selected language. All query words must match; results include localized source URLs. Up to six words are used.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "kind": {
    "enum": [
     "razdel",
     "section",
     "article",
     "digest",
     "question",
     "post"
    ],
    "type": "string"
   },
   "lang": {
    "default": "ru",
    "description": "Language of content and source URLs. Missing fields fall back to Russian with explicit field_languages.",
    "enum": [
     "ru",
     "en",
     "de",
     "zh-hans",
     "es",
     "tr"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "root": {
    "description": "Root section slug from list_sections.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search"
}
