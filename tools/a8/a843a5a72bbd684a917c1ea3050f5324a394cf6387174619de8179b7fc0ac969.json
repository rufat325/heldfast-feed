{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true
 },
 "description": "Schedule multiple tweets at once. Each tweet must already exist as a draft. Provide an array of post IDs with their scheduled dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "community_id": {
    "description": "Optional X Community ID to post to",
    "type": "string"
   },
   "schedules": {
    "description": "Array of {post_id, scheduled_date} pairs (max 50)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "post_id": {
       "description": "The tweet/post ID",
       "type": "string"
      },
      "scheduled_date": {
       "description": "ISO 8601 date-time (e.g. \"2026-03-15T09:00:00Z\")",
       "type": "string"
      }
     },
     "required": [
      "post_id",
      "scheduled_date"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "share_with_followers": {
    "description": "Share community posts with followers too",
    "type": "boolean"
   },
   "x_account_id": {
    "description": "Target X account ID (for multi-account users)",
    "type": "string"
   }
  },
  "required": [
   "schedules"
  ],
  "type": "object"
 },
 "name": "opentweet_batch_schedule"
}
