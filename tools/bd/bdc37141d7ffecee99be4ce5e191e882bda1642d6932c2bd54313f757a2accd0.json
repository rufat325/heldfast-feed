{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Email Hub users in this agent\u2019s linked organization (never addresses outside the org). to=all or { user_id } / { role } / { email } matching agent_organization members. Optional actions (Hub URLs only), severity, idempotency_key. Channel is email.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actions": {
    "description": "Optional buttons, max 3. Hosts outside Conduit are rejected.",
    "items": {
     "properties": {
      "title": {
       "description": "Button label, e.g. View Invoices",
       "type": "string"
      },
      "type": {
       "description": "Button style (default primary)",
       "enum": [
        "primary",
        "danger",
        "ghost"
       ],
       "type": "string"
      },
      "url": {
       "description": "https URL on hub.aiconduit.app, aiconduit.app, or mcp.aiconduit.app, or a Hub path like /invoices",
       "type": "string"
      }
     },
     "required": [
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "agent_id": {
    "description": "Linked agent sending the message",
    "type": "string"
   },
   "body": {
    "description": "Plain-text body, max 4000 characters. Conduit wraps HTML; do not send markup.",
    "type": "string"
   },
   "channel": {
    "description": "Delivery channel. Email only \u2014 omit or pass email",
    "type": "string"
   },
   "dry_run": {
    "description": "If true, resolve recipients and from-address without sending or storing",
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Replay key \u2014 same agent + key returns the original notify_id without sending again",
    "type": "string"
   },
   "order_id": {
    "description": "Optional order correlation",
    "type": "string"
   },
   "search_id": {
    "description": "Optional search correlation",
    "type": "string"
   },
   "session_token": {
    "description": "Session token from agent_authenticate \u2014 required whenever agent_id is passed",
    "type": "string"
   },
   "severity": {
    "description": "info (default), warning, or urgent \u2014 affects subject prefix and accent",
    "enum": [
     "info",
     "warning",
     "urgent"
    ],
    "type": "string"
   },
   "title": {
    "description": "Subject line, max 120 characters",
    "type": "string"
   },
   "to": {
    "anyOf": [
     {
      "const": "all",
      "description": "Every current member of the linked org",
      "type": "string"
     },
     {
      "properties": {
       "user_id": {
        "description": "One org member user_id from agent_organization",
        "type": "string"
       }
      },
      "required": [
       "user_id"
      ],
      "type": "object"
     },
     {
      "properties": {
       "user_ids": {
        "description": "Org member user_ids from agent_organization",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "user_ids"
      ],
      "type": "object"
     },
     {
      "properties": {
       "role": {
        "description": "Org role: OWNER, OPS, FINANCE, DEVELOPER, or VIEWER",
        "type": "string"
       }
      },
      "required": [
       "role"
      ],
      "type": "object"
     },
     {
      "properties": {
       "roles": {
        "description": "One or more org roles",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "roles"
      ],
      "type": "object"
     },
     {
      "properties": {
       "email": {
        "description": "Exact member email from agent_organization \u2014 not an arbitrary address",
        "type": "string"
       }
      },
      "required": [
       "email"
      ],
      "type": "object"
     }
    ],
    "description": "Who to notify: \"all\", { user_id }, { user_ids }, { role }, { roles }, or { email } matching an org member. Never an address outside the org."
   }
  },
  "required": [
   "agent_id",
   "to",
   "title",
   "body"
  ],
  "type": "object"
 },
 "name": "agent_notify",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "channel": {
    "type": "string"
   },
   "delivered": {
    "type": "number"
   },
   "detail": {
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "failed": {
    "type": "number"
   },
   "from": {
    "type": "string"
   },
   "hint": {
    "type": "string"
   },
   "idempotent_replay": {
    "type": "boolean"
   },
   "next": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool"
    ],
    "type": "object"
   },
   "notify_id": {
    "type": "string"
   },
   "recipients": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Notify org members"
}
