{
 "description": "Requires a ChainHelix API key as bearer token, or 5 cents per call paid over Binance b402 in USDT, USDC, USD1 or U on BNB Smart Chain, or over x402 in USDC on the Base network. Resolve one argument name against the ChainHelix Agentic Lexicon: the entry (id, meaning, representation, unit, example) or, when the name is unknown or ambiguous, the candidates to choose from. Optional namespace (common, agent, identity, payment, wallet, onchain, defi, market, data) and venue (an exchange name, e.g. binance: a venue field name resolves through ccxt's mapping)",
 "inputSchema": {
  "properties": {
   "name": {
    "description": "the argument name to resolve, e.g. origQty, stop_price, budgetUsd",
    "type": "string"
   },
   "namespace": {
    "enum": [
     "common",
     "agent",
     "identity",
     "payment",
     "wallet",
     "onchain",
     "defi",
     "market",
     "data"
    ],
    "type": "string"
   },
   "venue": {
    "description": "exchange name, lower case, e.g. binance",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object",
  "x-aliases": {
   "name": [
    "Name",
    ":name",
    "_name",
    "NAME"
   ],
   "namespace": [
    "Namespace",
    "_namespace",
    "namespaces"
   ]
  },
  "x-lexicon": {
   "bundleSha256": "e5b4290024a229f2bdf97f8fc6a0079c3fe13b77267f41fdcffeb8b26aa1c41e",
   "name": "ChainHelix Agentic Lexicon",
   "resolve": "lexicon_resolve",
   "spec": "lexicon_spec",
   "version": "0.1.0"
  },
  "x-vocab": {
   "name": "agent.name",
   "namespace": "data.namespace",
   "venue": "data.venue"
  }
 },
 "name": "lexicon_resolve",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "by": {
    "type": "string"
   },
   "candidates": {
    "items": {},
    "type": "array"
   },
   "charged": {
    "type": "boolean"
   },
   "entry": {},
   "id": {
    "type": "string"
   },
   "lexiconVersion": {
    "type": [
     "string",
     "null"
    ]
   },
   "ok": {
    "type": "boolean"
   },
   "reason": {
    "type": "string"
   },
   "receipt": {
    "additionalProperties": false,
    "properties": {
     "bytes": {
      "type": "number"
     },
     "covers": {
      "type": "string"
     },
     "issuedAt": {
      "type": "number"
     },
     "lookup": {
      "type": "string"
     },
     "network": {
      "type": [
       "string",
       "null"
      ]
     },
     "nonce": {
      "type": "string"
     },
     "seq": {
      "type": "number"
     },
     "settleTx": {
      "type": [
       "string",
       "null"
      ]
     },
     "sha256": {
      "type": "string"
     },
     "tool": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "spelling": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
