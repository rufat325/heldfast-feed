{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a Planner task: title, bucket (move), due date, priority, progress (not started / in progress / completed), assignees, or labels. Fetches the current etag automatically.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "add_assignee_ids": {
    "description": "User IDs to assign",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "add_labels": {
    "description": "Labels to apply \u2014 the plan's label name, a default color name (e.g. \"Red\"), or a category key (category1\u2013category25)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "bucket_id": {
    "description": "Move to this bucket ID",
    "type": "string"
   },
   "due_date": {
    "description": "New due date (ISO, e.g. 2026-07-31) or empty string to clear",
    "type": "string"
   },
   "priority": {
    "description": "New priority",
    "enum": [
     "urgent",
     "important",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "progress": {
    "description": "New progress state",
    "enum": [
     "not_started",
     "in_progress",
     "completed"
    ],
    "type": "string"
   },
   "remove_assignee_ids": {
    "description": "User IDs to unassign",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "remove_labels": {
    "description": "Labels to remove (same formats as add_labels)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "task_id": {
    "description": "Task ID",
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "New title",
    "type": "string"
   }
  },
  "required": [
   "task_id"
  ],
  "type": "object"
 },
 "name": "planner_update_task",
 "title": "Update a Task"
}
