{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Fine-Tune ROI Calculator"
 },
 "description": "Use when a user is considering fine-tuning vs prompt engineering. Returns training cost, monthly inference savings, months-to-ROI, and breakeven volume.",
 "inputSchema": {
  "examples": [
   {
    "monthly_inference_tokens": 300000000,
    "train_tokens": 50000000
   }
  ],
  "properties": {
   "base_inference_cost_1m": {
    "description": "Baseline API output cost per 1M",
    "minimum": 0,
    "type": "number"
   },
   "finetuned_inference_cost_1m": {
    "description": "Fine-tuned inference cost per 1M",
    "minimum": 0,
    "type": "number"
   },
   "monthly_inference_tokens": {
    "description": "Expected monthly inference volume (output tokens)",
    "minimum": 0,
    "type": "number"
   },
   "prompt_reduction_pct": {
    "description": "Prompt size reduction % from eliminating few-shot (default 0)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "train_cost_per_1m": {
    "description": "Training cost per 1M tokens",
    "minimum": 0,
    "type": "number"
   },
   "train_tokens": {
    "description": "Training tokens (dataset \u00d7 epochs)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "train_tokens",
   "monthly_inference_tokens"
  ],
  "type": "object"
 },
 "name": "fine-tune-roi-calculator",
 "title": "Fine-Tune ROI Calculator"
}
