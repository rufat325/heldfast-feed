{
 "description": "Run JavaScript in the page context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "script": {
    "minLength": 1,
    "type": "string"
   },
   "selector": {
    "description": "Matched element passed as first arg to script.",
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "sessionId",
   "script"
  ],
  "type": "object"
 },
 "name": "browser_evaluate",
 "title": "Browser Evaluate"
}
