{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Restated periods"
 },
 "description": "List periods whose value changed in a later filing, with first and latest values, % change and cause (stock splits left out by default). Omit concept to scan everything.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Ticker (AAPL), CIK or company name.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "concept": {
    "description": "Default: every concept.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "include_splits": {
    "description": "Also list stock-split changes; default false.",
    "type": "boolean"
   },
   "limit": {
    "description": "Default 25, newest first.",
    "maximum": 400,
    "minimum": 1,
    "type": "integer"
   },
   "min_change_pct": {
    "description": "Minimum absolute change, % of first value.",
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "offset": {
    "description": "next_offset from the last page.",
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "periods": {
    "description": "annual (default), quarterly, or all (adds year-to-date).",
    "enum": [
     "annual",
     "quarterly",
     "all"
    ],
    "type": "string"
   },
   "since": {
    "description": "Only periods ending on or after.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "company"
  ],
  "type": "object"
 },
 "name": "restatements",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "rows: one per restated period, newest first, with first and latest values, change_pct and cause.",
  "properties": {
   "changed": {
    "type": "number"
   },
   "columns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "company": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "next_offset": {
    "type": "number"
   },
   "rows": {
    "items": {},
    "type": "array"
   },
   "scanned": {
    "type": "number"
   },
   "snapshot": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "Restated periods"
}
