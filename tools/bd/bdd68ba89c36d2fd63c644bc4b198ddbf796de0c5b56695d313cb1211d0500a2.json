{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a third-party link. Use this tool to update the status or type of a link between a YouTube channel and a third-party service.",
 "inputSchema": {
  "properties": {
   "external_channel_id": {
    "description": "Channel ID to which changes should be applied, for delegation",
    "type": "string"
   },
   "link_status": {
    "description": "Status of the link: unknown|failed|pending|linked",
    "enum": [
     "unknown",
     "failed",
     "pending",
     "linked"
    ],
    "type": "string"
   },
   "linking_token": {
    "description": "Linking token that identifies the YouTube account and channel",
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|silent",
    "enum": [
     "json",
     "yaml",
     "silent"
    ],
    "type": "string"
   },
   "parts": {
    "default": [
     "snippet",
     "status"
    ],
    "description": "Comma separated parts",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Type of the link: linkUnspecified|channelToStoreLink",
    "enum": [
     "linkUnspecified",
     "channelToStoreLink"
    ],
    "type": "string"
   }
  },
  "required": [
   "linking_token"
  ],
  "type": "object"
 },
 "name": "thirdPartyLink-update",
 "title": "Update a third-party link"
}
