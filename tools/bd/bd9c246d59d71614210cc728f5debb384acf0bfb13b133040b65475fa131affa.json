{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a free indicative swap quote (output amount includes Tollbooth's fee). Use before build_swap to decide whether to trade.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Sell amount as an integer string in the input token's base units",
    "type": "string"
   },
   "chain": {
    "description": "Chain to swap on",
    "enum": [
     "solana",
     "base",
     "ethereum",
     "arbitrum",
     "polygon",
     "optimism",
     "bsc",
     "avalanche"
    ],
    "type": "string"
   },
   "inputToken": {
    "description": "Token being sold: mint address (solana) or ERC-20 address (EVM chains)",
    "type": "string"
   },
   "outputToken": {
    "description": "Token being bought: mint address (solana) or ERC-20 address (EVM chains)",
    "type": "string"
   },
   "slippageBps": {
    "description": "Max slippage in bps (default 100)",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "chain",
   "inputToken",
   "outputToken",
   "amount"
  ],
  "type": "object"
 },
 "name": "get_quote",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "type": "string"
   },
   "feeBps": {
    "description": "Tollbooth fee in basis points",
    "type": "number"
   },
   "inputAmount": {
    "description": "Sell amount in base units",
    "type": "string"
   },
   "inputToken": {
    "type": "string"
   },
   "next": {
    "additionalProperties": {},
    "description": "How to build the swap transaction",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "outputAmount": {
    "description": "Estimated buy amount in base units, after fees",
    "type": "string"
   },
   "outputToken": {
    "type": "string"
   },
   "slippageBps": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Get swap quote"
}
