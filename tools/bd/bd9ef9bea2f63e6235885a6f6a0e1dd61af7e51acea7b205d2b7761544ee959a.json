{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Loa's hospital directory by name or location and return hospital IDs plus address details. Use the returned hospital_ids with get_hospital_pricing to fetch source-labeled Published MRF and reviewed overlay prices.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "city": {
    "description": "City name",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "name": {
    "description": "Hospital name to search for",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code or full state name, e.g. \"CA\" or \"New York\".",
    "type": "string"
   },
   "zip_code": {
    "description": "ZIP code",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_hospitals",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hospitals": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "city": {
       "type": "string"
      },
      "hospital_id": {
       "type": "string"
      },
      "loa_link": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "Tracked Loa link. Share it when the user wants to book, contact, or learn more about this provider or hospital.",
         "properties": {
          "action": {
           "enum": [
            "book",
            "website",
            "profile"
           ],
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "url",
          "action",
          "label"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "website": {
       "type": "string"
      },
      "zip_code": {
       "type": "string"
      }
     },
     "required": [
      "hospital_id",
      "name",
      "address",
      "city",
      "state",
      "zip_code",
      "phone",
      "website",
      "loa_link"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "authoritative",
       "advisory",
       "estimate"
      ],
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "methodology_url": {
      "format": "uri",
      "type": "string"
     },
     "source_scope": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "authority",
     "basis",
     "methodology_url"
    ],
    "type": "object"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "city": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "zip_code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "state",
     "city",
     "zip_code",
     "name"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "hospitals",
   "total",
   "provenance"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Hospital Search"
}
