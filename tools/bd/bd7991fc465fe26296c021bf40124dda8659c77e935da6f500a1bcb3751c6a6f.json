 "annotations": {
  "readOnlyHint": true,
  "title": "Get a meter's quantities"
 },
 "description": "Fetch the aggregated quantities a meter has recorded over a window \u2014 what usage-based billing will charge for. Polar: GET /v1/meters/{id}/quantities.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_id": {
    "description": "Only this customer's usage.",
    "type": "string"
   },
   "end_timestamp": {
    "description": "ISO-8601 end of the window.",
    "type": "string"
   },
   "interval": {
    "description": "Bucket size for the series.",
    "enum": [
     "hour",
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "meter_id": {
    "description": "The meter's id.",
    "type": "string"
   },
   "start_timestamp": {
    "description": "ISO-8601 start of the window.",
    "type": "string"
   }
  },
  "required": [
   "meter_id",
   "start_timestamp",
   "end_timestamp",
   "interval"
  ],
  "type": "object"
 },
 "name": "polar_get_meter_quantities",
 "title": "Get a meter's quantities"
}
