{
 "description": "Reopen a closed evidence case with previously unconsidered evidence, preserving prior rounds.",
 "inputSchema": {
  "properties": {
   "evidence": {
    "properties": {
     "allegation": {
      "type": "string"
     },
     "evidenceIds": {
      "items": {
       "format": "uuid",
       "type": "string"
      },
      "type": "array"
     },
     "expectedVersion": {
      "type": "integer"
     }
    },
    "required": [
     "expectedVersion",
     "allegation",
     "evidenceIds"
    ],
    "type": "object"
   },
   "id": {
    "format": "uuid",
    "type": "string"
   },
   "idempotencyKey": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "evidence",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "reopen_case"
}
