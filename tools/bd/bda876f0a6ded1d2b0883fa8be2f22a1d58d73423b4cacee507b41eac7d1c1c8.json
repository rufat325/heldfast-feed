{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read:sales"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read one website order"
 },
 "description": "Read one website order and its items, including buyer details, with the separate read:sales permission. Pass the exact orderId from soclo_sales_orders. Read-only and free.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "orderId": {
    "description": "The exact owned website order id, from soclo_sales_orders.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "orderId"
  ],
  "type": "object"
 },
 "name": "soclo_sales_order",
 "title": "Read one website order"
}
