{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a new email message. \"to\", \"cc\", and \"bcc\" accept a string or an array of strings. Prefer arrays for multiple recipients (e.g. [\"alice@example.com\"]).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "bcc": {
    "$ref": "#/properties/to",
    "description": "BCC recipient(s)"
   },
   "body": {
    "description": "Email body (HTML supported)",
    "type": "string"
   },
   "cc": {
    "$ref": "#/properties/to",
    "description": "CC recipient(s)"
   },
   "importance": {
    "description": "Email importance",
    "enum": [
     "low",
     "normal",
     "high"
    ],
    "type": "string"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "to": {
    "anyOf": [
     {
      "items": {
       "format": "email",
       "maxLength": 254,
       "type": "string"
      },
      "maxItems": 500,
      "type": "array"
     },
     {
      "$ref": "#/properties/to/anyOf/0/items"
     }
    ],
    "description": "Recipient email address(es). Use an array: [\"alice@example.com\"]"
   }
  },
  "type": "object"
 },
 "name": "send_email"
}
