{"_meta":{"xdata.kr/credential":{"providers":["wetax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=wetax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: wetax__session__login (\uac19\uc740 account_link_id). \uae30\uad00\uc5d0 \uc800\uc7a5\ud569\ub2c8\ub2e4. \uc18c\ub4dd\uc790\ubcc4 \uba85\uc138 \uc904\uc744 \uac80\uc0ac\ud55c \ub4a4 \uc800\uc7a5\ud569\ub2c8\ub2e4. \uba85\uc138\ub294 \uc120\ud0dd\uc774\ub77c \uc904 \uc5c6\uc774 \ubcf4\ub0b4\uba74 \uba85\uc138 \uc5c6\uc774 \ub2e4\uc74c \ub2e8\uacc4\ub85c \ub118\uc5b4\uac11\ub2c8\ub2e4. \uc18c\ub4dd \uc885\ub958, \uc131\uba85, \uc2dd\ubcc4\ubc88\ud638\uac00 \uac19\uc740 \uc904\uc774 \ub458\uc774\uba74 \uac70\uc808\ud569\ub2c8\ub2e4. \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"dclr_id":{"description":"\uc2e0\uace0 \uc2dd\ubcc4\uc790\uc785\ub2c8\ub2e4. \uc2e0\uace0\uc778 \uc800\uc7a5\uc774 \ub3cc\ub824\uc900 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc2b5\ub2c8\ub2e4.","type":"string"},"statement_rows":{"description":"\uc18c\ub4dd\uc790\ubcc4\ub85c \ud55c \uc904\uc529 \ub123\ub294 \ubaa9\ub85d\uc785\ub2c8\ub2e4. \uba85\uc138\ub294 \uc120\ud0dd\uc774\ub77c \uc904\uc744 \ud558\ub098\ub3c4 \ubcf4\ub0b4\uc9c0 \uc54a\uc73c\uba74 \uba85\uc138 \uc5c6\uc774 \ub2e4\uc74c \ub2e8\uacc4\ub85c \ub118\uc5b4\uac11\ub2c8\ub2e4. \uc904\uc744 \ubcf4\ub0bc \ub54c\ub294 \uc18c\ub4dd \uc885\ub958 \ucf54\ub4dc(income_type_code), \uc9c0\uae09\uc77c(payment_date), \uc18c\ub4dd\uc790 \uc131\uba85(payee_name), \uc18c\ub4dd\uc790 \uc2dd\ubcc4\ubc88\ud638(payee_identifier), \uacfc\uc138\ud45c\uc900(tax_base_amount), \uc0b0\ucd9c\uc138\uc561(calculated_tax_amount), \uc870\uc815 \ud658\uae09\uc561(adjustment_amount), \ub0a9\ubd80\uc561(payment_amount)\uc744 \ubcf4\ub0b4\uace0, \ubaa8\ub4e0 \uc904\uc758 \uacfc\uc138\ud45c\uc900 \ud569\uacc4\uc640 \uc0b0\ucd9c\uc138\uc561 \ud569\uacc4\uac00 \uc800\uc7a5\ub41c \uc2e0\uace0\uc758 \ud569\uacc4\uc640 \uac19\uc544\uc57c \ud569\ub2c8\ub2e4. \uc18c\ub4dd \uc885\ub958\uc640 \uc131\uba85, \uc2dd\ubcc4\ubc88\ud638\uac00 \ubaa8\ub450 \uac19\uc740 \uc904\uc744 \ub450 \ubc88 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","items":{"type":"object"},"type":"array"}},"required":["dclr_id"],"type":"object"},"name":"wetax__tax__local_income__special_withholding__statement_save","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\uc9c0\ubc29\uc18c\ub4dd\uc138 \ud2b9\ubcc4\uc9d5\uc218 \uc2e0\uace0 \uba85\uc138 \uc800\uc7a5"}
