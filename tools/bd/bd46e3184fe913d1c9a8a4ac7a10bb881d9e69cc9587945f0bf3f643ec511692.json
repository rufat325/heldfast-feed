{
 "description": "Update spend progress or status on a welcome offer. Supports absolute spend or delta. Set status to 'earned' only after confirming the bonus actually posted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "card_id": {
    "description": "Card ID with the active offer",
    "type": "string"
   },
   "current_spend": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Set absolute spend amount"
   },
   "notes": {
    "description": "Additional context",
    "type": "string"
   },
   "spend_delta": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Relative change (e.g., +450)"
   },
   "status": {
    "description": "Update status",
    "enum": [
     "earned",
     "missed",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
 "name": "update_welcome_offer"
}
