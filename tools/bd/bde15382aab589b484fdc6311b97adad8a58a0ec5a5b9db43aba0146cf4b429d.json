{
 "description": "Read Android vitals from the Play Developer Reporting API: crash rate, ANR rate, error counts and startup metrics, daily or hourly, with optional breakdowns. Reports how fresh the data actually is. Carries no acquisition or conversion data; use play_store_stats for that. Read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregationPeriod": {
    "default": "DAILY",
    "description": "DAILY is reported in America/Los_Angeles, HOURLY in UTC",
    "enum": [
     "DAILY",
     "HOURLY"
    ],
    "type": "string"
   },
   "days": {
    "default": 28,
    "description": "How many days back to query",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "dimensions": {
    "default": [],
    "description": "Breakdown dimensions such as versionCode or countryCode",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "includeRows": {
    "default": false,
    "description": "Include every raw row as well as the counts; off by default so a summary call stays small",
    "type": "boolean"
   },
   "metricSets": {
    "default": [
     "crashRate",
     "anrRate"
    ],
    "description": "Which Android vitals metric sets to query",
    "items": {
     "enum": [
      "crashRate",
      "anrRate",
      "errorCount",
      "slowStartRate",
      "excessiveWakeupRate"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "packageName": {
    "description": "Android package name",
    "maxLength": 200,
    "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
    "type": "string"
   },
   "pageSize": {
    "default": 1000,
    "description": "Rows per metric set",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "packageName"
  ],
  "type": "object"
 },
 "name": "play_vitals",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregationPeriod": {
    "type": "string"
   },
   "days": {
    "type": "number"
   },
   "metricSets": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "available": {
       "type": "boolean"
      },
      "error": {
       "type": "string"
      },
      "latestDataAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "rowCount": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "rows": {
       "items": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "available",
      "rowCount",
      "latestDataAt",
      "rows"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "packageName": {
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "aggregationPeriod",
   "days",
   "metricSets",
   "notes"
  ],
  "type": "object"
 }
}
