{
 "description": "Update a show's metadata",
 "inputSchema": {
  "properties": {
   "author": {
    "description": "Show author name",
    "type": "string"
   },
   "category": {
    "description": "Primary podcast category",
    "type": "string"
   },
   "copyright": {
    "description": "Copyright notice",
    "type": "string"
   },
   "description": {
    "description": "Show description",
    "type": "string"
   },
   "explicit": {
    "description": "Whether the show contains explicit content",
    "type": "boolean"
   },
   "image_url": {
    "description": "URL to show artwork",
    "type": "string"
   },
   "keywords": {
    "description": "Comma-separated keywords",
    "type": "string"
   },
   "language": {
    "description": "Show language (e.g. 'en')",
    "type": "string"
   },
   "owner_email": {
    "description": "Owner email address",
    "type": "string"
   },
   "secondary_category": {
    "description": "Secondary podcast category",
    "type": "string"
   },
   "show_id": {
    "description": "ID of the show to update",
    "type": "string"
   },
   "show_type": {
    "description": "Show type",
    "enum": [
     "episodic",
     "serial"
    ],
    "type": "string"
   },
   "time_zone": {
    "description": "Time zone for the show",
    "type": "string"
   },
   "title": {
    "description": "Show title",
    "type": "string"
   },
   "website": {
    "description": "Show website URL",
    "type": "string"
   }
  },
  "required": [
   "show_id"
  ],
  "type": "object"
 },
 "name": "update_show"
}
