{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Shop Overview"
 },
 "description": "Return an overview of the supported shops, including their shipping cost tiers, free-shipping thresholds, and supported countries (DE and AT).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "description": "Filter output to a specific country (optional \u2014 omit for both DE and AT)",
    "enum": [
     "DE",
     "AT"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_shop_info",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "shops": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "country": {
       "type": "string"
      },
      "free_shipping_threshold_at": {
       "type": "number"
      },
      "free_shipping_threshold_de": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "shipping_at": {
       "type": "string"
      },
      "shipping_de": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "country"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "shops"
  ],
  "type": "object"
 },
 "title": "Get Shop Overview"
}
