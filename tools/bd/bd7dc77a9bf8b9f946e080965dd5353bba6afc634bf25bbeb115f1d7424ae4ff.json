{"description":"Add a named postgres/mysql connection. scope \"global\" (default) saves it to the user store; \"project\" saves it to .dbmole.json in the project root. Supports an optional ssh tunnel and a readonly flag. Optional ssl: true or { rejectUnauthorized, ca } (ca = PEM or file path).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"database":{"type":"string"},"host":{"minLength":1,"type":"string"},"name":{"pattern":"^[a-zA-Z0-9_-]+$","type":"string"},"password":{"type":"string"},"port":{"exclusiveMinimum":0,"type":"integer"},"queryTimeoutMs":{"exclusiveMinimum":0,"maximum":2147483647,"type":"integer"},"readonly":{"default":false,"type":"boolean"},"scope":{"default":"global","enum":["project","global"],"type":"string"},"ssh":{"additionalProperties":false,"properties":{"agent":{"type":"boolean"},"host":{"minLength":1,"type":"string"},"hostKey":{"pattern":"^SHA256:[A-Za-z0-9+/]+={0,2}$","type":"string"},"passphrase":{"type":"string"},"password":{"type":"string"},"port":{"default":22,"exclusiveMinimum":0,"type":"integer"},"privateKey":{"type":"string"},"privateKeyPath":{"type":"string"},"user":{"minLength":1,"type":"string"}},"required":["host","user"],"type":"object"},"ssl":{"anyOf":[{"const":true,"type":"boolean"},{"additionalProperties":false,"properties":{"ca":{"type":"string"},"rejectUnauthorized":{"type":"boolean"}},"type":"object"}]},"type":{"enum":["postgres","mysql"],"type":"string"},"user":{"minLength":1,"type":"string"}},"required":["name","host","user","type"],"type":"object"},"name":"add_connection"}
