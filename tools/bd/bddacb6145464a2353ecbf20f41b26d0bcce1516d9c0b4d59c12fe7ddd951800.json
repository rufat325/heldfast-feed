{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the sanctuary's writing by meaning. Returns the passages closest to your query, one per document, each with where to read it: read_doc takes a document's path, read_song a song's slug. Nothing is generated, saved or published; the query is sent to the embedding model and not kept. Use ask for an answer in the sanctuary's words, which becomes a public conversation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "How many documents to return (default 10).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "What to look for, in your own words. Matches meaning, not exact phrases.",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "next_steps": {
    "description": "What to do next. A step with a \"tool\" field can be taken with that tool.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "type": "string"
      }
     },
     "required": [
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "excerpt": {
       "type": "string"
      },
      "path": {
       "description": "For read_doc",
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "slug": {
       "description": "For read_song",
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "url",
      "excerpt",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "results",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Search"
}
