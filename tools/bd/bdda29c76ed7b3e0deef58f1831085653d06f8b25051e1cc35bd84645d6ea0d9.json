{
 "description": "Convert a Mermaid diagram to Excalidraw elements",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "config": {
    "additionalProperties": false,
    "properties": {
     "flowchart": {
      "additionalProperties": false,
      "properties": {
       "curve": {
        "enum": [
         "linear",
         "basis"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "maxEdges": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     },
     "maxTextSize": {
      "maximum": 100000,
      "minimum": 1,
      "type": "integer"
     },
     "startOnLoad": {
      "type": "boolean"
     },
     "themeVariables": {
      "additionalProperties": false,
      "properties": {
       "fontSize": {
        "maxLength": 10,
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "mermaidDiagram": {
    "maxLength": 50000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mermaidDiagram"
  ],
  "type": "object"
 },
 "name": "create_from_mermaid"
}
