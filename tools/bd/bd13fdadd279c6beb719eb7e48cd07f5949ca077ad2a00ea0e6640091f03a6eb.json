{
 "_meta": {
  "ui": {
   "resourceUri": "list://display",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "description": "Display an interactive, customizable list with optional checkboxes, drag-and-drop reordering, image thumbnails, and copy/export functionality. Perfect for displaying any type of list: tasks, items, options, files, or any sequential data. Features include compact/comfortable views, individual item copy, and bulk export (CSV, JSON, text).",
 "inputSchema": {
  "properties": {
   "allowCheckboxes": {
    "default": true,
    "description": "Show checkboxes for items",
    "type": "boolean"
   },
   "allowReorder": {
    "default": true,
    "description": "Allow drag-and-drop reordering",
    "type": "boolean"
   },
   "compact": {
    "default": false,
    "description": "Use compact layout mode",
    "type": "boolean"
   },
   "items": {
    "description": "Array of list items to display",
    "items": {
     "properties": {
      "checked": {
       "default": false,
       "description": "Whether the item is checked",
       "type": "boolean"
      },
      "content": {
       "description": "Text content of the list item",
       "type": "string"
      },
      "id": {
       "description": "Unique identifier for the list item",
       "type": "string"
      },
      "image": {
       "description": "Optional image URL or data URI for the item",
       "type": "string"
      },
      "metadata": {
       "description": "Optional metadata for the item",
       "type": "object"
      },
      "subtext": {
       "description": "Optional secondary text/description",
       "type": "string"
      }
     },
     "required": [
      "id",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "showImages": {
    "default": true,
    "description": "Display item images if available",
    "type": "boolean"
   },
   "title": {
    "description": "Optional title for the list",
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "display_list",
 "title": "Display List"
}
