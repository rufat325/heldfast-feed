{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a GeoJSON feature scaffold with feature rows, property maps, style rules, adapter source, and projection/privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "webclient_json",
    "enum": [
     "file_watch",
     "webclient_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9072/features.geojson",
    "type": "string"
   },
   "feature_count": {
    "default": 64,
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "geometry_mode": {
    "default": "mixed",
    "enum": [
     "points",
     "lines",
     "polygons",
     "mixed"
    ],
    "type": "string"
   },
   "name": {
    "default": "geojson_feature_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the GeoJSON scaffold.",
    "type": "string"
   },
   "property_count": {
    "default": 8,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "source_label": {
    "default": "geojson_source",
    "type": "string"
   },
   "style_rule_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_geojson_feature_bus",
 "title": "Connect GeoJSON feature bus"
}
