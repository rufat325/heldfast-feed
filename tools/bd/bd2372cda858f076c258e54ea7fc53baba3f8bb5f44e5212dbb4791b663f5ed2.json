{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Run a privacy-minimized preflight using coarse vehicle, document, access, and location facts. It identifies what needs case review but never accepts or rejects a vehicle. Use submit_car_donation or the human form for an actual Cars Helping Kids review.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "access": {
    "enum": [
     "standard_tow_access",
     "limited_or_special_access",
     "unknown"
    ],
    "type": "string"
   },
   "condition": {
    "enum": [
     "runs_and_drives",
     "starts_not_drivable",
     "does_not_run",
     "wrecked_or_incomplete",
     "unknown"
    ],
    "type": "string"
   },
   "keys": {
    "enum": [
     "yes",
     "no",
     "unknown"
    ],
    "type": "string"
   },
   "lien_status": {
    "enum": [
     "no_lien",
     "lien_exists",
     "unknown"
    ],
    "type": "string"
   },
   "location_scope": {
    "enum": [
     "continental_us",
     "alaska",
     "hawaii",
     "island_or_remote",
     "unknown"
    ],
    "type": "string"
   },
   "model_year": {
    "maximum": 2028,
    "minimum": 1886,
    "type": "integer"
   },
   "title_status": {
    "enum": [
     "title_in_hand",
     "title_missing",
     "title_issue",
     "unknown"
    ],
    "type": "string"
   },
   "vehicle_type": {
    "enum": [
     "Car",
     "Truck",
     "SUV",
     "Motorcycle",
     "RV",
     "Boat",
     "Trailer",
     "Other"
    ],
    "type": "string"
   }
  },
  "required": [
   "vehicle_type",
   "condition",
   "title_status",
   "lien_status",
   "keys",
   "access",
   "location_scope"
  ],
  "type": "object"
 },
 "name": "check_vehicle_donation_readiness",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "important_limit": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "preparation": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "review_reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "case_review_needed",
     "ready_to_submit_for_review"
    ],
    "type": "string"
   },
   "submission_url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "status",
   "review_reasons",
   "preparation",
   "next_step",
   "submission_url",
   "important_limit"
  ],
  "type": "object"
 },
 "title": "Check vehicle donation readiness"
}
