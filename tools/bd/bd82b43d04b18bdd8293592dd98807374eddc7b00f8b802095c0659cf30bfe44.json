{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List tags for a specific metric (useful for understanding available groupings and filters)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "metricName": {
    "description": "Full metric name. Example: system.cpu.user",
    "type": "string"
   },
   "windowSeconds": {
    "description": "Look-back window in seconds (default/min 14400 = 4h)",
    "type": "number"
   }
  },
  "required": [
   "metricName"
  ],
  "type": "object"
 },
 "name": "list-metric-tags"
}
