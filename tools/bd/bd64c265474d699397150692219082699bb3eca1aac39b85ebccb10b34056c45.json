{
 "description": "Map supplied keywords to supplied pages and flag missing pages or cannibalization risks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keywords": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 250,
    "minItems": 1,
    "type": "array"
   },
   "max_mappings": {
    "default": 250,
    "maximum": 250,
    "minimum": 1,
    "type": "integer"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "current_keywords": {
       "default": [],
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 30,
       "type": "array"
      },
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "headings": {
       "default": [],
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 30,
       "type": "array"
      },
      "page_type": {
       "default": "unknown",
       "enum": [
        "unknown",
        "homepage",
        "blog_post",
        "landing_page",
        "product",
        "software",
        "local_business",
        "comparison_page",
        "guide",
        "docs"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand, domain, or product",
    "type": "string"
   }
  },
  "required": [
   "keywords",
   "pages"
  ],
  "type": "object"
 },
 "name": "agentseo_content_keyword_map",
 "title": "AgentSEO Content Keyword Map"
}
