{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this to write or delete the app's Swift and resource files under <AppName>/ in the project. Adding or removing files regenerates the Xcode project. Paths are relative to the project folder; nothing outside it can be written.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "delete": {
       "default": false,
       "type": "boolean"
      },
      "encoding": {
       "default": "utf8",
       "enum": [
        "utf8",
        "base64"
       ],
       "type": "string"
      },
      "path": {
       "description": "e.g. HabitTracker/Views/HabitListView.swift",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "projectDir": {
    "description": "Absolute path of the app's project folder. Every file the agent writes stays inside it.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectDir",
   "files"
  ],
  "type": "object"
 },
 "name": "ios_write_files",
 "title": "Write app source files"
}
