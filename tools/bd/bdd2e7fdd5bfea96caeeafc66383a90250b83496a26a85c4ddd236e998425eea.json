{
 "description": "Edit a roadmap item \u2014 update its title, status (suggested|in_progress|completed|ignored), or priority.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "itemId": {
    "description": "Roadmap item ID from seo_list_roadmap",
    "type": "string"
   },
   "priority": {
    "description": "Priority integer (lower = higher priority)",
    "type": "integer"
   },
   "status": {
    "description": "New status",
    "enum": [
     "suggested",
     "in_progress",
     "completed",
     "ignored"
    ],
    "type": "string"
   },
   "title": {
    "description": "New title for the roadmap item",
    "type": "string"
   }
  },
  "required": [
   "itemId"
  ],
  "type": "object"
 },
 "name": "seo_roadmap_edit"
}
