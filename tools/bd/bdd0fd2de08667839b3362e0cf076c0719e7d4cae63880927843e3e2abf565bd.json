{
 "_meta": {
  "openai/toolInvocation/invoked": "Addresses ready.",
  "openai/toolInvocation/invoking": "Searching addresses\u2026",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this to search for a mailing address and return Loqate suggestions with IDs. Pass country_code to filter by country; it defaults to US. If a suggestion has type \"Container\" (building/complex), call this tool again with container=<id> and a refined query to drill down to type \"Address\". Only type \"Address\" is valid for order creation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "container": {
    "description": "Loqate container id for drilling into suggestions, if provided",
    "type": "string"
   },
   "country_code": {
    "description": "Two-letter country code to filter suggestions. Defaults to US.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "query": {
    "description": "Partial address text, e.g. \"123 Main St\"",
    "minLength": 3,
    "type": "string"
   },
   "target": {
    "description": "Which address field is being searched (used for UI context).",
    "enum": [
     "sender",
     "recipient"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "postalform.search_addresses",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "type": "string"
   },
   "suggestions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "countryCode": {
       "type": "string"
      },
      "countryName": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text",
      "type",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "target": {
    "enum": [
     "sender",
     "recipient"
    ],
    "type": "string"
   },
   "view": {
    "const": "address_suggestions",
    "type": "string"
   }
  },
  "required": [
   "view",
   "query",
   "suggestions"
  ],
  "type": "object"
 },
 "title": "Search mailing addresses"
}
