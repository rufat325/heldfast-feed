 "description": "Compare two sets of environment variables without revealing either side. Reports what was added, removed and changed, and describes each change by length and character classes rather than by value, so it is safe to run between staging and production. Flags a value that became empty, a value whose character classes changed, and a new variable shaped like a credential. Pay 90000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "The same, for the other environment.",
    "example": {
     "DATABASE_URL": "postgres://app:a-different-not-real-password@prod-db.internal:5432/orders",
     "FEATURE_FLAGS": "",
     "LOG_LEVEL": "info",
     "STRIPE_WEBHOOK_SECRET": "whsec_0000000000000000000000000000000000"
    },
    "type": "object"
   },
   "after_name": {
    "description": "A label for the second side.",
    "example": "production",
    "maxLength": 64,
    "type": "string"
   },
   "before": {
    "description": "Variable names to values, at most 1000. No value is returned in the response.",
    "example": {
     "DATABASE_URL": "postgres://app:not-a-real-password@staging-db.internal:5432/orders",
     "FEATURE_FLAGS": "new-checkout",
     "LEGACY_QUEUE_URL": "https://queue.internal/legacy",
     "LOG_LEVEL": "debug"
    },
    "type": "object"
   },
   "before_name": {
    "description": "A label for the first side, such as staging.",
    "example": "staging",
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "before",
   "after"
  ],
  "type": "object"
 },
