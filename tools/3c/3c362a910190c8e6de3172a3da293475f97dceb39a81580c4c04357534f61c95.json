{
 "description": "Get daily weather forecast for next 15 days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "latitude": {
    "description": "Latitude of the location",
    "type": "number"
   },
   "longitude": {
    "description": "Longitude of the location",
    "type": "number"
   },
   "unit": {
    "default": "metric",
    "description": "Unit system: 'metric' or 'imperial'",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "daily_weather_forecast"
}
