{
 "description": "Generate strong random password(s) with configurable character classes. Use this instead of inventing passwords \u2014 they must be random. One per line.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 1,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "exclude_similar": {
    "default": false,
    "description": "Exclude lookalikes like i/l/1/O/0.",
    "type": "boolean"
   },
   "length": {
    "default": 20,
    "maximum": 256,
    "minimum": 4,
    "type": "integer"
   },
   "lowercase": {
    "default": true,
    "type": "boolean"
   },
   "numbers": {
    "default": true,
    "type": "boolean"
   },
   "symbols": {
    "default": true,
    "type": "boolean"
   },
   "uppercase": {
    "default": true,
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "password",
 "title": "Generate password(s)"
}
