{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "NO-WRITE preview for assigning one immutable published quiz as a Project To-do. audience is mandatory. SELECTED requires exact same-job active selectedContractIds; broad audiences resolve the complete current roster and return a short-lived signed receipt. Returns masked names/counts, future-hire semantics, due/blocking behavior, duplicate warnings, and the exact form version. Requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "blockingMode": {
    "enum": [
     "NONE",
     "IMMEDIATE",
     "DEADLINE"
    ],
    "type": "string"
   },
   "categoryId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "completionPolicy": {
    "enum": [
     "ON_SUBMIT",
     "ON_PASS",
     "ON_REVIEW"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 5000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dueOffsetMinutes": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 525600,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "formVersionId": {
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "priority": {
    "enum": [
     "LOW",
     "NORMAL",
     "HIGH",
     "URGENT"
    ],
    "type": "string"
   },
   "required": {
    "type": "boolean"
   },
   "selectedContractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "title": {
    "maxLength": 180,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "formVersionId",
   "completionPolicy",
   "audience"
  ],
  "type": "object"
 },
 "name": "opentrain_preflight_project_todo_quiz_assignment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
