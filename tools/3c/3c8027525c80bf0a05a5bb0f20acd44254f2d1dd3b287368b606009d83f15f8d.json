{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List a hosted space's versions, newest first: number, status (uploading, preview, checking, live, refused, unjudged, replaced), size, and whether rollback can pick it. Refused versions carry the reason. Needs sign-in.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "space": {
    "description": "The space's slug, as my_spaces or publish named it, e.g. pixel-racer.",
    "pattern": "^[a-z0-9-]{1,100}$",
    "type": "string"
   }
  },
  "required": [
   "space"
  ],
  "type": "object"
 },
 "name": "versions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "space": {
    "type": "string"
   },
   "versions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "string"
      },
      "files": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "leftBehind": {
       "description": "Made before the space moved off hosting: it can only be looked at.",
       "type": "boolean"
      },
      "live": {
       "type": "boolean"
      },
      "liveAt": {
       "type": "string"
      },
      "number": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "reason": {
       "description": "Why the check refused it.",
       "type": "string"
      },
      "rollback": {
       "description": "It was live before, so rollback can pick it.",
       "type": "boolean"
      },
      "size": {
       "description": "Bytes.",
       "type": "number"
      },
      "status": {
       "description": "uploading, preview, checking, live, refused, unjudged or replaced.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "number",
      "status",
      "createdAt",
      "live",
      "files",
      "size",
      "rollback",
      "leftBehind"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "space",
   "versions"
  ],
  "type": "object"
 },
 "title": "Versions of a space"
}
