{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a client"
 },
 "description": "Change a client's name, email, mobile phone, date of birth, pronoun or external id. Only the fields you pass change. GraphQL: updateClient.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "client_id": {
    "description": "The Client id, e.g. urn:blvd:Client:<uuid>.",
    "minLength": 1,
    "type": "string"
   },
   "dob": {
    "description": "Date of birth, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "external_id": {
    "description": "Your own id for this client.",
    "type": "string"
   },
   "first_name": {
    "description": "First name.",
    "type": "string"
   },
   "last_name": {
    "description": "Last name.",
    "type": "string"
   },
   "mobile_phone": {
    "description": "Mobile phone in E.164 form, e.g. +15551234567.",
    "type": "string"
   },
   "pronoun": {
    "description": "Pronoun, e.g. she/her.",
    "type": "string"
   }
  },
  "required": [
   "client_id"
  ],
  "type": "object"
 },
 "name": "boulevard_update_client",
 "title": "Update a client"
}
