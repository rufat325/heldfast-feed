{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Remove explicitly named node and/or edge IDs. Removing a node also removes every incident edge deterministically.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "edgeIds": {
    "description": "Edge IDs to remove.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "nodeIds": {
    "description": "Node IDs to remove.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "description": "Vault-relative path ending in .canvas.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "canvas_remove",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Remove Canvas items"
}
