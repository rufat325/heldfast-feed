{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "sensitive-write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decide the exact review"
 },
 "description": "Records the person's decision on an exact pending review. Approve applies remaining selected edits or acknowledges the work CHECK showed; apply and drop decide selected changes while keeping the review open.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "approve",
     "decline",
     "apply",
     "drop"
    ],
    "type": "string"
   },
   "changeIds": {
    "description": "Pending change ids: apply and drop act on them; approve keeps them and drops the rest; decline takes none.",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 128,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "decisionId": {
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "editorKey": {
    "description": "The editor key from private tool-result _meta.rapier, held by the host and editor alone.",
    "maxLength": 512,
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "expectedVersion": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document",
   "editorKey",
   "expectedRevision",
   "expectedVersion",
   "reviewId",
   "action",
   "decisionId"
  ],
  "type": "object"
 },
 "name": "document.review_decide",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "ok",
     "applied",
     "rebased",
     "unchanged",
     "target_gone",
     "conflict",
     "pending",
     "invalid",
     "refused",
     "uncertain",
     "replayed"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Decide the exact review"
}
