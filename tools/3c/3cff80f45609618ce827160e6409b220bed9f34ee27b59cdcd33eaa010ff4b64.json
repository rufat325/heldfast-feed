{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "veterical:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List bookable vets and staff"
 },
 "description": "Use this when someone asks which vets, nurses or assistants can be booked at their clinic. Returns up to 100 staff display names for one clinic (no contact details, roles or pet data). Not for staff days off or vacations.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Clinic id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "list_clinic_providers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "providerCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "providerCountIsLowerBound": {
    "type": "boolean"
   },
   "providers": {
    "description": "Display names of staff with a doctor, nurse or assistant role. Staff identifiers, contact details, roles, colors, avatars and all animal or clinical data are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "displayName": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "displayName"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "providerCount",
   "providerCountIsLowerBound",
   "providers"
  ],
  "type": "object"
 },
 "title": "List bookable vets and staff"
}
