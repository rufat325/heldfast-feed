{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Look up a claim or a message by its receipt ID. Shows the answer once a person has released it.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "receipt_id": {
    "description": "The EOUS-... receipt ID from submit_claim or contact_us.",
    "pattern": "^EOUS-[0-9A-HJKMNP-TV-Z]{10}$",
    "type": "string"
   }
  },
  "required": [
   "receipt_id"
  ],
  "type": "object"
 },
 "name": "check_status",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "receipt_id": {
    "type": "string"
   },
   "reply": {
    "type": "string"
   },
   "status": {
    "enum": [
     "received",
     "in_review",
     "released",
     "declined"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "claim",
     "message"
    ],
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   }
  },
  "required": [
   "receipt_id",
   "type",
   "status",
   "updated_at"
  ],
  "type": "object"
 },
 "title": "Check a claim or a message"
}
