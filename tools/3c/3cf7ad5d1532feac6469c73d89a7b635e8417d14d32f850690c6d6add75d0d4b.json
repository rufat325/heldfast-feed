    "description": "A slug: lower-case letters, digits and hyphens, for example `acme-foods`.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   },
   "relationship": {
    "default": "wholesale",
    "description": "The relationship slug. The default is `wholesale`.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "brand"
  ],
  "type": "object"
 },
