{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Open New Tab"
 },
 "description": "Open a new browser tab. Returns a tab_id to use with browser_switch_tab.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   },
   "url": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "URL to open in the new tab (opens blank tab if omitted)"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "browser_new_tab"
}
