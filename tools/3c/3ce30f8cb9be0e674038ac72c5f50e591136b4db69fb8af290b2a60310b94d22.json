{"annotations":{"readOnlyHint":true},"description":"Quote a video job. Pass API fields such as model, mode, duration_seconds, resolution, fps,\ncamera_motion, auto_duration, or audio_duration_seconds (for mode=\"a2v\" on ltx-2.5-fast / ltx-2.5-pro).\n\nFor minimax-relight use estimate_video_relight; for minimax-camera-controls use estimate_video_camera;\nfor lightx-recamera / lightx-relight use estimate_lightx_recamera / estimate_lightx_relight.\nNot for higgsfield-* models: use estimate_higgsfield_cinema / estimate_higgsfield_genjutsu /\nestimate_higgsfield_restyle / estimate_higgsfield_wan_prime.","inputSchema":{"$defs":{"VideoEstimate":{"additionalProperties":false,"properties":{"aspect_ratio":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Aspect Ratio"},"audio_duration_seconds":{"anyOf":[{"exclusiveMinimum":0.0,"maximum":300.0,"type":"number"},{"type":"null"}],"title":"Audio Duration Seconds"},"auto_duration":{"title":"Auto Duration","type":"boolean"},"camera_motion":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Camera Motion"},"duration_seconds":{"maximum":30.0,"minimum":1.0,"title":"Duration Seconds","type":"integer"},"fps":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Fps"},"has_reference_videos":{"title":"Has Reference Videos","type":"boolean"},"mode":{"anyOf":[{"enum":["t2v","i2v","r2v","edit","a2v","auto"],"type":"string"},{"type":"null"}],"title":"Mode"},"model":{"title":"Model","type":"string"},"reference_images":{"maximum":30.0,"minimum":0.0,"title":"Reference Images","type":"integer"},"resolution":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Resolution"},"with_audio":{"title":"With Audio","type":"boolean"}},"required":["model"],"title":"VideoEstimate","type":"object"}},"properties":{"request":{"$ref":"#/$defs/VideoEstimate"}},"required":["request"],"title":"estimate_videoArguments","type":"object"},"name":"estimate_video","outputSchema":{"additionalProperties":true,"title":"estimate_videoDictOutput","type":"object"}}
