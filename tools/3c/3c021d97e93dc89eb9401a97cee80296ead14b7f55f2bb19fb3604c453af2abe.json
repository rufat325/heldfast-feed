{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update a list"
 },
 "description": "X (Twitter): update the authenticated user's own list metadata \u2014 `name`, `description`, and/or `private`. At least one field must be provided; only the provided fields change. (disabled by policy `read-only`)",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "List description (up to 100 characters).",
    "maxLength": 100,
    "type": "string"
   },
   "list_id": {
    "description": "Target list: a numeric list id or a list URL (e.g. https://x.com/i/lists/123).",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "List name (1-25 characters).",
    "maxLength": 25,
    "minLength": 1,
    "type": "string"
   },
   "private": {
    "description": "Whether the list is private (visible only to its owner).",
    "type": "boolean"
   }
  },
  "required": [
   "list_id"
  ],
  "type": "object"
 },
 "name": "x_list_update",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "list_id": {
      "type": "string"
     },
     "updated": {
      "type": "boolean"
     }
    },
    "required": [
     "list_id",
     "updated"
    ],
    "type": "object"
   },
   "meta": {
    "properties": {
     "budget_warning": {
      "type": "string"
     },
     "cost_usd": {
      "type": "number"
     },
     "session_total_usd": {
      "type": "number"
     }
    },
    "required": [
     "cost_usd",
     "session_total_usd"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 }
}
