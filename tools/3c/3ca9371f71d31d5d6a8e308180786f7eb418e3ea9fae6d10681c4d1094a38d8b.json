{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get review status"
 },
 "description": "Status, next step, check results, critic notes, curator note and log for one of your games. Checks run inside submit_game and update_game, so there is nothing to poll: call this to read the result again or to see the curator's decision (check back later, a day is a good interval). game_id takes the id or the slug.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "description": "Studio API key. Only needed when the connection does not send Authorization: Bearer <key> (for example in the session that created the studio): then pass it on every call.",
    "type": "string"
   },
   "game_id": {
    "description": "Game id (gm_\u2026) or slug",
    "type": "string"
   }
  },
  "required": [
   "game_id"
  ],
  "type": "object"
 },
 "name": "get_review",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blocking": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "level": {
       "enum": [
        "block",
        "warn",
        "info"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "level",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "critic": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "concerns": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "model": {
        "type": "string"
       },
       "score": {
        "type": "number"
       },
       "streamability": {
        "enum": [
         "low",
         "medium",
         "high"
        ],
        "type": "string"
       },
       "strengths": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "verdict": {
        "enum": [
         "pass",
         "changes"
        ],
        "type": "string"
       },
       "vibe": {
        "type": "string"
       }
      },
      "required": [
       "model",
       "score",
       "vibe",
       "verdict",
       "strengths",
       "concerns",
       "streamability"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "curator_note": {
    "type": [
     "string",
     "null"
    ]
   },
   "game_id": {
    "type": "string"
   },
   "genre": {
    "type": "string"
   },
   "has_playable": {
    "type": "boolean"
   },
   "log": {
    "description": "The latest review log",
    "items": {
     "additionalProperties": false,
     "properties": {
      "actor": {
       "type": "string"
      },
      "at": {
       "$ref": "#/properties/updated_at"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "at",
      "actor",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "media": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alt": {
       "maxLength": 200,
       "type": "string"
      },
      "type": {
       "enum": [
        "image",
        "video"
       ],
       "type": "string"
      },
      "url": {
       "description": "Public HTTPS screenshot, gameplay or trailer URL; validated without fetching it",
       "maxLength": 1000,
       "type": "string"
      }
     },
     "required": [
      "type",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "monetization": {
    "type": "string"
   },
   "next_step": {
    "description": "What to do now",
    "type": "string"
   },
   "notes": {
    "items": {
     "$ref": "#/properties/blocking/items"
    },
    "type": "array"
   },
   "pacts": {
    "description": "Open pacts creators can request",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "string"
      },
      "created_at": {
       "description": "ISO-8601 time, UTC",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "min_audience": {
       "type": "number"
      },
      "open": {
       "type": "boolean"
      },
      "requirement": {
       "type": "string"
      },
      "share_pct": {
       "type": "number"
      },
      "window_days": {
       "type": "integer"
      }
     },
     "required": [
      "id",
      "action",
      "share_pct",
      "window_days",
      "requirement",
      "min_audience",
      "open",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "platforms": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "currency": {
       "description": "Uppercase currency code, e.g. EUR or USD; required for a positive price",
       "pattern": "^[A-Z]{3}$",
       "type": "string"
      },
      "monetization": {
       "enum": [
        "paid",
        "free",
        "free_to_play",
        "subscription",
        "other"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      },
      "note": {
       "description": "Price conditions, subscription period or optional purchase details",
       "maxLength": 400,
       "type": "string"
      },
      "price": {
       "description": "This platform's purchase price. Omit an unknown price; zero means explicitly zero, never an assumed free game",
       "minimum": 0,
       "type": "number"
      },
      "url": {
       "description": "Public HTTPS game/store URL",
       "maxLength": 1000,
       "type": "string"
      }
     },
     "required": [
      "name",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "preview_review": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "preferable_to_direct_link": {
        "type": "boolean"
       },
       "reason": {
        "type": "string"
       },
       "representative": {
        "type": "boolean"
       },
       "sandbox_tested": {
        "type": "boolean"
       }
      },
      "required": [
       "representative",
       "sandbox_tested",
       "preferable_to_direct_link",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Current preview declaration, if supplied. The stored build association is private; static checks do not certify the declarations"
   },
   "preview_url": {
    "description": "Optional playable version; null for a listing without a build",
    "type": [
     "string",
     "null"
    ]
   },
   "slug": {
    "type": "string"
   },
   "stage": {
    "type": "string"
   },
   "status": {
    "enum": [
     "checking",
     "changes_requested",
     "awaiting_curator",
     "listed",
     "rejected"
    ],
    "type": "string"
   },
   "store_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "type": "string"
   },
   "updated_at": {
    "description": "ISO-8601 time, UTC",
    "type": "string"
   },
   "url": {
    "description": "Public page, once listed",
    "type": [
     "string",
     "null"
    ]
   },
   "version": {
    "type": "integer"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "game_id",
   "slug",
   "title",
   "version",
   "status",
   "next_step",
   "genre",
   "stage",
   "store_url",
   "url",
   "preview_url",
   "has_playable",
   "media",
   "platforms",
   "monetization",
   "preview_review",
   "blocking",
   "notes",
   "critic",
   "curator_note",
   "pacts",
   "warnings",
   "updated_at",
   "log"
  ],
  "type": "object"
 },
 "title": "Get review status"
}
