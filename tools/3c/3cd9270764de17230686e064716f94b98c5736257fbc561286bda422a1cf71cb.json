{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true
 },
 "description": "Update an existing course. Only provided fields are changed; omitted fields are left as-is.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_code": {
    "description": "New course code",
    "type": "string"
   },
   "course_id": {
    "description": "The Canvas course ID to update",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "default_view": {
    "description": "Default course home page view",
    "enum": [
     "feed",
     "wiki",
     "modules",
     "assignments",
     "syllabus"
    ],
    "type": "string"
   },
   "end_at": {
    "description": "New end date in ISO 8601 format (e.g. 2026-05-15T00:00:00Z)",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "name": {
    "description": "New course name",
    "type": "string"
   },
   "start_at": {
    "description": "New start date in ISO 8601 format (e.g. 2026-01-15T00:00:00Z)",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "syllabus_body": {
    "description": "HTML body for the course syllabus",
    "type": "string"
   }
  },
  "required": [
   "course_id"
  ],
  "type": "object"
 },
 "name": "update_course",
 "title": "Update Course"
}
