{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store evidence that backs one approved claim: a title, where it comes from, and what it shows. Proof does not approve a new claim, guarantee, discount, or offer. Link claimId when the evidence supports a saved claim. Pass proofId to revise an existing proof record.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "format": "uuid",
    "type": "string"
   },
   "claimId": {
    "$ref": "#/properties/brandId"
   },
   "proofId": {
    "$ref": "#/properties/brandId"
   },
   "source": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "maxLength": 12000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "brandId",
   "title",
   "source",
   "summary"
  ],
  "type": "object"
 },
 "name": "save_proof",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save proof"
}
