{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "supovia:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search help-center articles"
 },
 "description": "Use this when someone asks which help article covers a topic or question on one of their websites. Returns up to 5 matching published articles with id, title, slug and language, matched by meaning in one language (English by default). Not for reading an article's text.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "description": "Language code to search in, e.g. en, it or fr; defaults to en",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "What the article should cover, in natural language, up to 500 characters",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "websiteId": {
    "description": "Website whose help center to search",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "query",
   "websiteId"
  ],
  "type": "object"
 },
 "name": "search_documents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documents": {
    "description": "Closest matches first. Content chunks, embeddings, scores, prompts and arbitrary metadata are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 20,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "title",
      "slug",
      "locale"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   }
  },
  "required": [
   "documents"
  ],
  "type": "object"
 },
 "title": "Search help-center articles"
}
