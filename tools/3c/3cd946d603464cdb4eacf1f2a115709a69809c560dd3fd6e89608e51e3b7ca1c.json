{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reads the complete bounded document returned by search_reference, with its source location, revisions, and attribution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "The stable result id returned by search_reference.",
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_reference",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attribution": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "faction": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "datasheet",
     "deployment",
     "detachment",
     "mission",
     "rule",
     "terrain"
    ],
    "type": "string"
   },
   "revisions": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "sections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "text",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "kind",
   "title",
   "faction",
   "url",
   "sections",
   "revisions",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Read one Praetorium reference result"
}
