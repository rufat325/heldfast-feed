{
 "_meta": {
  "openai/outputTemplate": "ui://linkbreakers-docs/search-results.html",
  "ui": {
   "resourceUri": "ui://linkbreakers-docs/search-results.html"
  },
  "ui/resourceUri": "ui://linkbreakers-docs/search-results.html"
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Linkbreakers docs"
 },
 "description": "Search the Linkbreakers help center, guides, integrations and product news, or the public QR code design templates. Returns ranked results with their URL, Markdown URL and a snippet; read a help article in full with get_article.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Restrict help results to one help center category",
    "enum": [
     "overview",
     "use-cases",
     "dashboard",
     "developer",
     "legal",
     "workflow",
     "guides",
     "alternatives",
     "research",
     "partnerships",
     "integrations",
     "news"
    ],
    "type": "string"
   },
   "limit": {
    "default": 8,
    "description": "Maximum number of results",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Natural language question or keywords",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "default": "help",
    "description": "help searches help center articles; qr_templates searches public QR code design templates",
    "enum": [
     "help",
     "qr_templates"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_docs",
 "title": "Search Linkbreakers docs"
}
