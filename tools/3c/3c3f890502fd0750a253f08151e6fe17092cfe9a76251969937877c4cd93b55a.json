{
 "annotations": {
  "destructiveHint": true,
  "title": "Create activity"
 },
 "description": "Create a new activity (task/event). `subject` is required; link it to a deal/person/org and set type/date/time as needed. Pipedrive REST: POST /api/v2/activities.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deal_id": {
    "description": "Link to this deal id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "done": {
    "description": "Whether the activity is already marked done.",
    "type": "boolean"
   },
   "due_date": {
    "description": "Due date, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "due_time": {
    "description": "Due time, HH:MM (24h).",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "duration": {
    "description": "Duration, HH:MM.",
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "note": {
    "description": "Free-text note attached to the activity.",
    "type": "string"
   },
   "org_id": {
    "description": "Link to this organization id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "owner_id": {
    "description": "Assign to this owner (user) id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "person_id": {
    "description": "Link to this person id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "subject": {
    "description": "Activity subject/title (required).",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Activity type key, e.g. 'call', 'meeting', 'task', 'email'.",
    "type": "string"
   }
  },
  "required": [
   "subject"
  ],
  "type": "object"
 },
 "name": "pipedrive_create_activity",
 "title": "Create activity"
}
