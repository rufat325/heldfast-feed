{"_meta":{"openai/toolInvocation/invoked":"Public site audit complete.","openai/toolInvocation/invoking":"Discovering and auditing public sitemap pages\u2026","securitySchemes":[{"type":"noauth"}],"ui":{"resourceUri":"ui://web-validator/results-v5.html"},"ui/resourceUri":"ui://web-validator/results-v5.html"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Use this for a bounded, sitemap-first audit of a public website the user owns or is authorized to inspect. It fetches at most 8 same-origin HTML pages per call, respects robots.txt, and returns compact page summaries plus deduplicated findings and a sampled cross-page canonical/noindex/hreflang evidence graph. It does not recursively follow HTML links, authenticate, execute JavaScript, fetch assets, or run site-wide link checks. To continue a batch, pass both the returned page offset and discovery fingerprint; changed sitemaps require restarting at offset 0.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"expected_discovery_fingerprint":{"description":"Fingerprint from the first batch. Required when page_offset > 0 to reject sitemap drift.","pattern":"^[a-f0-9]{64}$","type":"string"},"max_pages":{"default":5,"description":"Maximum same-origin pages to audit in this call, from 1 to 8.","maximum":8,"minimum":1,"type":"integer"},"page_offset":{"default":0,"description":"Zero-based sitemap-page offset for continuing a capped audit batch.","maximum":250,"minimum":0,"type":"integer"},"site_url":{"description":"Authorized public website URL. The final public origin becomes the crawl boundary.","format":"uri","maxLength":2048,"type":"string"}},"required":["site_url"],"type":"object"},"name":"audit_public_site","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"audit_health_score":{"maximum":100,"minimum":0,"type":"integer"},"discovery":{"enum":["site