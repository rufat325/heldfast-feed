{
 "description": "Render a video from an inline template descriptor (`template`). Supply user clips via userVideoPaths (absolute paths under the configured media dir) for each project_video section, optional form `fields`, and an optional `locale`. Renders in a forked worker and returns the output mp4 path plus duration/codec metadata.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fields": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "locale": {
    "type": "string"
   },
   "outputBaseName": {
    "pattern": "^[\\w-]+$",
    "type": "string"
   },
   "template": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "userVideoPaths": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "template"
  ],
  "type": "object"
 },
 "name": "compose_video",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audioCodec": {
    "type": [
     "string",
     "null"
    ]
   },
   "durationSeconds": {
    "type": [
     "number",
     "null"
    ]
   },
   "outputPath": {
    "type": "string"
   },
   "renderId": {
    "type": "string"
   },
   "sizeBytes": {
    "type": "number"
   },
   "videoCodec": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "outputPath",
   "durationSeconds",
   "sizeBytes",
   "videoCodec",
   "audioCodec",
   "renderId"
  ],
  "type": "object"
 },
 "title": "Compose Video"
}
