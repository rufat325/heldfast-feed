{
 "description": "Bill-of-materials cost roll-up for furniture: buy quantity = net qty x (1 + waste%, verified presets: S4S lumber 18%, rough 28%, nested panels 10%, hardware 3%), line and total costs, cost per product and a selling price from a target margin (price = cost / (1 - margin)).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "labor_per_product": {
    "description": "Direct labour per product",
    "minimum": 0,
    "type": "number"
   },
   "lines": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "qty": {
       "description": "Net quantity per product",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "unit": {
       "description": "Unit label (m3, m2, pcs...)",
       "type": "string"
      },
      "unit_cost": {
       "description": "Cost per unit",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "waste_pct": {
       "default": 0,
       "description": "Waste allowance %",
       "maximum": 200,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "qty",
      "unit_cost"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "margin_pct": {
    "description": "Target margin on selling price, %",
    "maximum": 90,
    "minimum": 0,
    "type": "number"
   },
   "products": {
    "default": 1,
    "description": "Products this BOM covers",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "lines"
  ],
  "type": "object"
 },
 "name": "bom_costing"
}
