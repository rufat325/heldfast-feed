{
 "description": "Get detailed information about a specific Pusher channel, including whether it is occupied and optional subscription/user counts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "channel": {
    "description": "The channel name to query",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "info": {
    "description": "Additional attributes to request",
    "items": {
     "enum": [
      "user_count",
      "subscription_count"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "channel"
  ],
  "type": "object"
 },
 "name": "get_channel_info"
}
