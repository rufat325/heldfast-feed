{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One window or billboard by id (\"F47-S3\" is floor 47, south face, column 3; \"B-1234\" is a city billboard): its monthly price and whether it can be leased now. When it can't, reason says why: taken (lit by a brand), reserved (paid, in review), paused, prize (a game prize, only its winner can lease it) or crown (never sold).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Window or billboard id, e.g. \"F47-S3\" or \"B-1234\"",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_window",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "available": {
    "type": "boolean"
   },
   "item": {
    "additionalProperties": false,
    "properties": {
     "billing": {
      "const": "monthly",
      "type": "string"
     },
     "column": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "1 to 6 across the face; 1 and 6 are corners"
     },
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "face": {
      "anyOf": [
       {
        "enum": [
         "south",
         "east",
         "north",
         "west"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "floor": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "1 to 80; null for billboards and casino games"
     },
     "id": {
      "description": "Slot id: \"F47-S3\" (floor 47, south face, column 3), \"B-1234\" (a city billboard) or \"C-slots\" (the sponsor of a casino game)",
      "type": "string"
     },
     "image": {
      "description": "The slot's share card (PNG)",
      "type": "string"
     },
     "kind": {
      "enum": [
       "window",
       "billboard",
       "casino"
      ],
      "type": "string"
     },
     "leaseUrl": {
      "description": "Where a person leases this slot",
      "type": "string"
     },
     "pageUrl": {
      "description": "The slot's page",
      "type": "string"
     },
     "price": {
      "description": "Monthly price for people, e.g. \"$68\"",
      "type": "string"
     },
     "priceCents": {
      "description": "Monthly price in US cents, exactly what Stripe charges",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "spot": {
      "anyOf": [
       {
        "enum": [
         "corner",
         "middle"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "kind",
     "floor",
     "face",
     "column",
     "spot",
     "priceCents",
     "price",
     "currency",
     "billing",
     "pageUrl",
     "leaseUrl",
     "image"
    ],
    "type": "object"
   },
   "reason": {
    "anyOf": [
     {
      "enum": [
       "taken",
       "reserved",
       "paused",
       "prize",
       "crown"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Why it can't be leased: taken (lit), reserved (paid, in review), paused, prize (only its winner), crown (never sold)"
   }
  },
  "required": [
   "item",
   "available",
   "reason"
  ],
  "type": "object"
 },
 "title": "Get one window"
}
