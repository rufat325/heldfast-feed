ice in the list given, starting at 1.","type":"number"},"severity":{"enum":["error","warning"],"type":"string"}},"required":["row","invoice_number","severity","message"],"type":"object"},"type":"array"},"invoice_count":{"type":"number"},"line_item_count":{"type":"number"},"totals":{"items":{"additionalProperties":false,"properties":{"currency":{"type":"string"},"invoices":{"type":"number"},"net":{"type":"string"},"total":{"type":"string"},"vat":{"type":"string"}},"required":["currency","invoices","net","vat","total"],"type":"object"},"type":"array"}},"required":["invoice_count","line_item_count","totals","check_count","checks"],"type":"object"},"title":"Check invoices"}
