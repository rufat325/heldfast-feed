{"_meta":{"openai/toolInvocation/invoked":"Invoices checked","openai/toolInvocation/invoking":"Checking the invoices"},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Use this when the user wants invoices verified without making a file: whether net plus VAT equals the total, whether line items add up, which fields are missing, and which invoices look like duplicates. Returns the findings and totals per currency. Nothing is stored.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"invoices":{"description":"Every invoice, one entry each, with values exactly as printed on the document. Use null for anything not printed or not legible; never estimate.","items":{"properties":{"category":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}]},"currency":{"anyOf":[{"pattern":"^[A-Za-z]{3}$","type":"string"},{"type":"null"}],"description":"ISO 4217 code, e.g. GBP, USD, EUR."},"customer":{"anyOf":[{"maxLength":300,"type":"string"},{"type":"null"}],"description":"Who the invoice is billed to, if printed."},"date":{"anyOf":[{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}],"description":"Invoice date as YYYY-MM-DD."},"description":{"anyOf":[{"maxLength":4000,"type":"string"},{"type":"null"}],"description":"One line on what the invoice is for."},"invoice_number":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}]},"line_items":{"items":{"properties":{"category":{"anyOf":[{"maxLength":120,"type":"string"},{"type":"null"}]},"description":{"description":"The line as printed.","maxLength":2000,"type":"string"},"net":{"anyOf":[{"maximum":999999999999,"minimum":-999999999999,"type":"number"},{"type":"null"}],"description":"Line amount before VAT."},"quantity":{"anyOf":[{"maximum":999999999999,"minimum":-999999999999,"type":"number"},{"type":"null"}]},"unit_price":{"anyOf":[{"maximum":999999999999,"minimum":-999999999999,"type":"n