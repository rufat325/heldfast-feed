{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"Dry-runs the UNSIGNED transaction returned by build_swap_tx on the MultiversX gateway (checkSignature=false). The transaction is re-verified first and refused unless it is exactly what build_swap_tx produces (receiver, function, token, amount, minOut, chainID, gas caps). Returns status, estimated gas, a failure reason, and the expected received amount. Simulation does not guarantee execution.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"amountIn":{"description":"Optional check: amountIn.decimal from build_swap_tx","maxLength":80,"type":"string"},"minOut":{"description":"Required: minOut.raw from build_swap_tx (the minimum you accepted)","pattern":"^\\d{1,78}$","type":"string"},"network":{"default":"mainnet","description":"MultiversX network (default mainnet; devnet only if configured)","enum":["mainnet","devnet"],"type":"string"},"tokenIn":{"description":"Optional check: data.tokenIn.id from build_swap_tx","maxLength":20,"type":"string"},"tokenOut":{"description":"Optional check: data.tokenOut.id from build_swap_tx","maxLength":20,"type":"string"},"transaction":{"additionalProperties":false,"description":"The `transaction` object from build_swap_tx, unchanged","properties":{"chainID":{"maxLength":4,"type":"string"},"data":{"maxLength":16384,"type":"string"},"gasLimit":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"gasPrice":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"nonce":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"options":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"receiver":{"maxLength":62,"type":"string"},"sender":{"maxLength":62,"type":"string"},"value":{"maxLength":40,"type":"string"},"version":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"}},"required":["nonce","value","receiver","sender","gasPrice","gasLimit","data","chainID","version"],"type":"object"}},"required":["transaction","minOut"],"type":"object"},"name":"simulate_swap_tx","title":"Simulate an unsigned swap transaction"}
