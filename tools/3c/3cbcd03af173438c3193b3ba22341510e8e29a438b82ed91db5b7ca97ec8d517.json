{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List views with definitions"
 },
 "description": "List views and materialized views in a schema with their SQL definitions. Use this over `pg_list_tables` with `includeViews: true` when you want the view body, not just names.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "includeMaterialized": {
    "default": true,
    "description": "If true, include materialized views.",
    "type": "boolean"
   },
   "schema": {
    "default": "public",
    "description": "Schema name (defaults to 'public').",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pg_list_views",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "definition": {
       "description": "Reconstructed view body from pg_get_viewdef.",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "type": {
       "enum": [
        "view",
        "materialized_view"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "definition"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "title": "List views with definitions"
}
