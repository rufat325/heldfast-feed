{
 "description": "Create a Gemini TTS task on RunAPI (text to speech). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callback_url": {
    "description": "Webhook URL for async notifications.",
    "type": "string"
   },
   "dialogue_turns": {
    "description": "Non-empty ordered dialogue turns whose speaker ids reference configured speakers.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "speaker_id": {
       "description": "Identifier matching a configured speakers[].speaker_id.",
       "type": "string"
      },
      "text": {
       "description": "Spoken text, up to 10,000 characters.",
       "maxLength": 10000,
       "type": "string"
      }
     },
     "required": [
      "text",
      "speaker_id"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "gemini-2.5-pro-tts",
     "gemini-3.1-flash-tts"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "sample_context": {
    "description": "Overall delivery context and tone.",
    "type": "string"
   },
   "scene": {
    "description": "Scene and recording environment.",
    "type": "string"
   },
   "speakers": {
    "description": "Non-empty speaker configurations with unique Speaker N identifiers.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accent": {
       "description": "Speaker accent.",
       "enum": [
        "Neutral",
        "American (Gen)",
        "American (Valley)",
        "American (South)",
        "British (RP)",
        "British (Brixton)",
        "Transatlantic",
        "Australian"
       ],
       "type": "string"
      },
      "audio_profile": {
       "description": "Optional voice character guidance.",
       "type": "string"
      },
      "pace": {
       "description": "Speaker pace.",
       "enum": [
        "Natural",
        "Rapid Fire",
        "The Drift",
        "Staccato"
       ],
       "type": "string"
      },
      "speaker_id": {
       "description": "Unique identifier in Speaker N format.",
       "pattern": "^Speaker [1-9][0-9]*$",
       "type": "string"
      },
      "style": {
       "description": "Speaker delivery style.",
       "enum": [
        "Vocal Smile",
        "Newscaster",
        "Whisper",
        "Empathetic",
        "Promo/Hype",
        "Deadpan"
       ],
       "type": "string"
      },
      "voice_name": {
       "description": "Preset voice name.",
       "enum": [
        "Achernar",
        "Achird",
        "Algenib",
        "Algieba",
        "Alnilam",
        "Aoede",
        "Autonoe",
        "Callirrhoe",
        "Charon",
        "Despina",
        "Enceladus",
        "Erinome",
        "Fenrir",
        "Gacrux",
        "Iapetus",
        "Kore",
        "Laomedeia",
        "Leda",
        "Orus",
        "Puck",
        "Pulcherrima",
        "Rasalgethi",
        "Sadachbia",
        "Sadaltager",
        "Schedar",
        "Sulafat",
        "Umbriel",
        "Vindemiatrix",
        "Zephyr",
        "Zubenelgenubi"
       ],
       "type": "string"
      }
     },
     "required": [
      "pace",
      "style",
      "accent",
      "speaker_id",
      "voice_name"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "temperature": {
    "description": "Sampling temperature.",
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "speakers",
   "dialogue_turns"
  ],
  "type": "object"
 },
 "name": "text_to_speech"
}
