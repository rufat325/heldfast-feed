{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search availability"
 },
 "description": "Search availability across every apartment category for a given date range and party size. Returns one match per available category with total EUR price (public rate, no discount code), photos and a booking_url that opens beachvalencia.com with dates and guests pre-filled. Use it whenever the traveller asks \"what do you have from X to Y for N people\". Example: {\"check_in\":\"2027-05-22\",\"check_out\":\"2027-05-27\",\"adults\":4}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "description": "Number of adults.",
    "maximum": 32,
    "minimum": 1,
    "type": "integer"
   },
   "check_in": {
    "description": "Arrival date (YYYY-MM-DD, Europe/Madrid).",
    "type": "string"
   },
   "check_out": {
    "description": "Departure date (YYYY-MM-DD, Europe/Madrid); must be strictly after check_in.",
    "type": "string"
   },
   "children": {
    "description": "Optional list of children ages. Only the count is used to size the property.",
    "items": {
     "maximum": 17,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 10,
    "type": "array"
   },
   "language": {
    "description": "Response language. Defaults to en if omitted or unsupported.",
    "enum": [
     "es",
     "en"
    ],
    "type": "string"
   }
  },
  "required": [
   "check_in",
   "check_out",
   "adults"
  ],
  "type": "object"
 },
 "name": "search_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "check_in": {
    "type": "string"
   },
   "check_out": {
    "type": "string"
   },
   "currency": {
    "const": "EUR",
    "type": "string"
   },
   "guests": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bedrooms": {
       "type": "string"
      },
      "booking_url": {
       "type": "string"
      },
      "discount_note": {
       "type": "string"
      },
      "highlights": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "max_guests": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "min_stay_nights": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "nightly_avg_eur": {
       "type": "number"
      },
      "nights": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "photos": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "public_price_eur": {
       "type": "number"
      },
      "total_price_eur": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "max_guests",
      "bedrooms",
      "location",
      "highlights",
      "total_price_eur",
      "nightly_avg_eur",
      "nights",
      "photos",
      "booking_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "minimum_stay_only": {
    "description": "Properties that would be available if the stay met the minimum-nights rule.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "min_stay_nights": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "min_stay_nights"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nights": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "priority_note": {
    "type": "string"
   },
   "priority_url": {
    "type": "string"
   }
  },
  "required": [
   "currency",
   "check_in",
   "check_out",
   "nights",
   "guests",
   "matches",
   "minimum_stay_only",
   "priority_note",
   "priority_url"
  ],
  "type": "object"
 },
 "title": "Search availability"
}
