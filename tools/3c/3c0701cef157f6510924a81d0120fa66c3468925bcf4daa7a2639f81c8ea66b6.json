{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "artifact.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lists previous versions of a Carryo website, including version details and changes, for reviewing edit history or planning a restoration. Returns version metadata without changing the website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "linkId": {
    "description": "Carryo page link identifier to inspect",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "linkId"
  ],
  "type": "object"
 },
 "name": "website.list_versions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currentVersionNumber": {
    "description": "Current page version number",
    "type": "number"
   },
   "linkId": {
    "description": "Carryo page link identifier",
    "type": "string"
   },
   "versions": {
    "description": "Page version history",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessMode": {
       "description": "Whether the version was public or restricted",
       "enum": [
        "public",
        "restricted"
       ],
       "type": "string"
      },
      "assetBytes": {
       "description": "Total bundled asset size in bytes",
       "type": "number"
      },
      "assetChanges": {
       "description": "Asset changes in this version",
       "items": {
        "additionalProperties": false,
        "properties": {
         "action": {
          "description": "Asset change type",
          "enum": [
           "added",
           "updated",
           "removed",
           "retained"
          ],
          "type": "string"
         },
         "contentType": {
          "description": "Optional MIME type for the asset",
          "type": [
           "string",
           "null"
          ]
         },
         "path": {
          "description": "Relative asset path that changed",
          "type": "string"
         },
         "previousSizeBytes": {
          "description": "Previous asset size in bytes",
          "type": [
           "number",
           "null"
          ]
         },
         "sizeBytes": {
          "description": "Current asset size in bytes",
          "type": [
           "number",
           "null"
          ]
         }
        },
        "required": [
         "path",
         "action"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "assetCount": {
       "description": "Number of bundled assets in this version",
       "type": "number"
      },
      "changeSummary": {
       "$ref": "#/properties/versions/items/properties/assetChanges/items/properties/contentType",
       "description": "Optional human-readable version change summary"
      },
      "createdAt": {
       "description": "ISO-8601 timestamp when this version was created",
       "type": "string"
      },
      "eventType": {
       "description": "Version event type",
       "enum": [
        "created",
        "updated",
        "legacy_current"
       ],
       "type": "string"
      },
      "fileName": {
       "description": "Page file name for this version",
       "type": "string"
      },
      "isCurrent": {
       "description": "Whether this is the page current version",
       "type": "boolean"
      },
      "linkId": {
       "description": "Carryo page link identifier",
       "type": "string"
      },
      "sizeBytes": {
       "description": "HTML content size in bytes",
       "type": "number"
      },
      "versionNumber": {
       "description": "Page version number",
       "type": "number"
      }
     },
     "required": [
      "linkId",
      "versionNumber",
      "eventType",
      "createdAt",
      "fileName",
      "accessMode",
      "sizeBytes",
      "assetCount",
      "assetBytes",
      "assetChanges",
      "isCurrent"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "linkId",
   "currentVersionNumber",
   "versions"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "artifact.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List Website Versions"
}
