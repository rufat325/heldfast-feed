{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "projects:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a memoir, family legacy, celebration, tribute, or life-series project.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvedCreation": {
    "const": true,
    "description": "True only after the user approved creating this project.",
    "type": "boolean"
   },
   "category": {
    "enum": [
     "memoir",
     "family-legacy",
     "celebration",
     "tribute",
     "life-series"
    ],
    "type": "string"
   },
   "subjectBirthDecade": {
    "maxLength": 20,
    "type": "string"
   },
   "subjectName": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "subjectNote": {
    "maxLength": 500,
    "type": "string"
   },
   "subjectPronouns": {
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "subjectRelationship": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "tributeMode": {
    "enum": [
     "celebration",
     "memorial"
    ],
    "type": "string"
   }
  },
  "required": [
   "category",
   "subjectName",
   "subjectRelationship",
   "subjectPronouns",
   "approvedCreation"
  ],
  "type": "object"
 },
 "name": "create_life_project",
 "title": "Create a Life Story Project"
}
