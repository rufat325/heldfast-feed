{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "What BRYDGE has already found about an action, without reading the records again. Free. BRYDGE checks each action by itself once the destination's reporting window has passed; until then this says PENDING.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "authorization": {
    "description": "The authorization id brydge_supervise returned for the action.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "authorization"
  ],
  "type": "object"
 },
 "name": "brydge_get_finding",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agentAgreed": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "authorization": {
    "type": "string"
   },
   "because": {
    "type": "string"
   },
   "checkedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "claimed": {
    "type": [
     "string",
     "null"
    ]
   },
   "externalRef": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "replayed": {
    "type": "boolean"
   },
   "state": {
    "enum": [
     "PENDING",
     "VERIFIED",
     "FAILED",
     "MISMATCH",
     "UNKNOWN"
    ],
    "type": "string"
   }
  },
  "required": [
   "authorization",
   "state",
   "reason",
   "because",
   "externalRef",
   "claimed",
   "agentAgreed",
   "checkedAt",
   "replayed"
  ],
  "type": "object"
 },
 "title": "What BRYDGE has found so far"
}
