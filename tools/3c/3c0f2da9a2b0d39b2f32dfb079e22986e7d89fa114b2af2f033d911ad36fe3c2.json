{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Rule Guidance"
 },
 "description": "Returns complete guidance for one known rule slug: requirements, rationale, verification and remediation prompts, code examples, sources, and related rules. Use it when the user requests detailed guidance for a specific frontend rule. Unknown slugs return similar suggestions.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://frontendchecklist.io/favicon.svg"
  }
 ],
 "inputSchema": {
  "properties": {
   "includeUrl": {
    "description": "Include the rule's web URL in response (default: false)",
    "type": "boolean"
   },
   "slug": {
    "description": "Rule slug: the kebab-case rule ID, e.g. 'alt-text' or 'doctype'. The ID must identify a rule in the published catalogue.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_rule",
 "outputSchema": {
  "properties": {
   "aiContext": {
    "type": "string"
   },
   "categories": {
    "items": {
     "enum": [
      "html",
      "css",
      "javascript",
      "performance",
      "accessibility",
      "seo",
      "security",
      "images",
      "testing",
      "privacy",
      "pwa",
      "i18n"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "content": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "difficulty": {
    "type": "string"
   },
   "estimatedTime": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "primaryCategory": {
    "type": "string"
   },
   "priority": {
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "prompts": {
    "properties": {
     "aiContext": {
      "type": "string"
     },
     "check": {
      "type": "string"
     },
     "codeReview": {
      "type": "string"
     },
     "explain": {
      "type": "string"
     },
     "fix": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "relatedRules": {
    "items": {
     "properties": {
      "reason": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "sourceSummary": {
    "properties": {
     "primarySourceCount": {
      "type": "number"
     },
     "sourceCount": {
      "type": "number"
     },
     "sourceRoleCount": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "sources": {
    "items": {
     "properties": {
      "authority": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "subcategory": {
    "type": "string"
   },
   "suggestions": {
    "items": {
     "properties": {
      "similarity": {
       "type": "number"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get Rule Guidance"
}
