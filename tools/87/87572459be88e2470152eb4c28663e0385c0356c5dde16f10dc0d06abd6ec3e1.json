{
 "description": "Gets daily and monthly send quota usage for a mailbox.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "mailboxId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mailboxId"
  ],
  "type": "object"
 },
 "name": "assistantmail_get_usage"
}
