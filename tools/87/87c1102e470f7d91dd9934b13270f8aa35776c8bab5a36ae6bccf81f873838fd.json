{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Score inventory health"},"description":"Use this when someone shares a list or CSV of products with stock and sales rates and asks which need reordering, which are overstocked, or how healthy the inventory is. Up to 500 rows. Applies Forthcast's urgency bands (Order now, Plan ahead, On track, Excess, No demand), reorder points, suggested quantities and inventory value. Works without a connected store.","inputSchema":{"$defs":{"InventoryRowInput":{"additionalProperties":false,"properties":{"demand_per_day":{"anyOf":[{"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Average units sold per day.","title":"Demand Per Day"},"demand_per_month":{"anyOf":[{"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Average units sold per month (if no daily figure).","title":"Demand Per Month"},"demand_std_daily":{"anyOf":[{"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Standard deviation of daily demand, if known.","title":"Demand Std Daily"},"lead_time_days":{"anyOf":[{"maximum":730,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"description":"Supplier lead time in days.","title":"Lead Time Days"},"on_hand":{"description":"Units available now.","title":"On Hand","type":"number"},"on_order":{"anyOf":[{"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Units on open purchase orders.","title":"On Order"},"sku":{"description":"SKU or product name.","maxLength":64,"minLength":1,"title":"Sku","type":"string"},"unit_cost":{"anyOf":[{"minimum":0,"type":"number"},{"type":"null"}],"default":null,"description":"Cost per unit, for valuation.","title":"Unit Cost"}},"required":["sku","on_hand"],"title":"InventoryRowInput","type":"object"}},"properties":{"default_lead_time_days":{"default":14,"description":"Lead time for rows that give none.","maximum":730,"minimum":1