{
 "description": "Generate encounters based on the world seed. Returns a prompt for LLM execution.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 12,
    "description": "Number of encounters to generate",
    "maximum": 30,
    "minimum": 1,
    "type": "number"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "types": {
    "default": [
     "combat",
     "event",
     "social"
    ],
    "description": "Encounter types to include (at least one required)",
    "items": {
     "enum": [
      "combat",
      "event",
      "social"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "generate_encounters"
}
