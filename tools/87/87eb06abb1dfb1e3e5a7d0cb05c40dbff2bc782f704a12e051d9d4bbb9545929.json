{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read the papers closest to a question and return, for each, whether its\n    own abstract sentences answer yes, no or not addressed, with the deciding\n    sentence quoted. Call when a user asks whether something holds across the\n    literature. Candidates are chosen by meaning, so a paper that answers in\n    different words can be missed. Needs a personal key; counts against a daily\n    allowance.",
 "inputSchema": {
  "properties": {
   "field": {
    "default": "",
    "description": "Optional arXiv category such as gr-qc or math.CO; empty for all fields.",
    "title": "Field",
    "type": "string"
   },
   "question": {
    "description": "A yes-or-no question the literature could answer.",
    "maxLength": 600,
    "minLength": 15,
    "title": "Question",
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "title": "ask_fieldArguments",
  "type": "object"
 },
 "name": "ask_field",
 "outputSchema": {
  "properties": {
   "bank": {
    "title": "Bank",
    "type": "string"
   },
   "candidates_read": {
    "title": "Candidates Read",
    "type": "integer"
   },
   "counts": {
    "additionalProperties": {
     "type": "integer"
    },
    "title": "Counts",
    "type": "object"
   },
   "field": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "title": "Field"
   },
   "found": {
    "title": "Found",
    "type": "boolean"
   },
   "limit": {
    "title": "Limit",
    "type": "integer"
   },
   "method": {
    "title": "Method",
    "type": "string"
   },
   "model": {
    "title": "Model",
    "type": "string"
   },
   "note": {
    "title": "Note",
    "type": "string"
   },
   "papers": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "Papers",
    "type": "array"
   },
   "question": {
    "title": "Question",
    "type": "string"
   },
   "references": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "References",
    "type": "array"
   },
   "references_checked": {
    "title": "References Checked",
    "type": "integer"
   }
  },
  "title": "PersonalResult",
  "type": "object"
 },
 "title": "Ask a yes-or-no question across a field"
}
