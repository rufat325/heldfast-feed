{
 "annotations": {
  "readOnlyHint": true,
  "title": "List invoices"
 },
 "description": "Query invoices by client, issue date range, status, practitioner or last-updated range. Each invoice includes items, payments and amounts due/paid. Max 100 per page. IntakeQ: GET /invoices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "client_id": {
    "description": "Only this client's invoices (numeric client id).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "end_date": {
    "description": "Invoices on or before (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "last_updated_end_date": {
    "description": "Changed on or before (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "last_updated_start_date": {
    "description": "Changed on or after (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "page": {
    "description": "Page number (1, 2, ...). Each page holds at most 100 records.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "practitioner_email": {
    "description": "Only this practitioner's invoices.",
    "type": "string"
   },
   "start_date": {
    "description": "Invoices on or after (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "description": "Only invoices in this status.",
    "enum": [
     "Draft",
     "Scheduled",
     "Unpaid",
     "Paid",
     "PastDue",
     "Refunded",
     "Forgiven",
     "Canceled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "intakeq_list_invoices",
 "title": "List invoices"
}
