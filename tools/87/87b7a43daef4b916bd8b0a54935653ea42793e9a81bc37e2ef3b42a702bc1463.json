{
 "description": "Register a new webhook subscription. Returns the webhook and the HMAC signing secret (shown once \u2014 store it immediately).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "feedId": {
    "description": "Feed ID from list_feeds. Use 'events.race' for structured race events.",
    "minLength": 1,
    "type": "string"
   },
   "filters": {
    "properties": {
     "constructors": {
      "description": "Team keywords, e.g. [\"ferrari\",\"mclaren\"]",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "drivers": {
      "description": "TLA codes, e.g. [\"VER\",\"NOR\"]",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "positions": {
      "properties": {
       "max": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       },
       "min": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "webhookMethod": {
    "default": "post",
    "enum": [
     "post",
     "put"
    ],
    "type": "string"
   },
   "webhookUrl": {
    "description": "Public HTTPS URL to deliver payloads to.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "feedId",
   "webhookUrl"
  ],
  "type": "object"
 },
 "name": "create_webhook"
}
