{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommend something to watch on Romanian TV"
 },
 "description": "Returns up to N ranked program recommendations for a given timeframe. Uses a deterministic scorer that rewards films / documentaries / generalist channels, penalises news, and boosts programs starting within the next hour. Use for queries like \"recommend me something for tonight\", \"ce e bun la TV disear\u0103\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exclude_news": {
    "default": true,
    "description": "Drop news channels and news programs",
    "type": "boolean"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "prefer": {
    "default": [
     "filme",
     "documentare"
    ],
    "description": "Preferred categories for ranking boost",
    "items": {
     "enum": [
      "filme",
      "seriale",
      "documentare",
      "sport",
      "copii",
      "muzica"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "timeframe": {
    "default": "tonight",
    "description": "now | tonight | primetime | tomorrow | weekend | today | YYYY-MM-DD | ISO range \"A/B\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tv_recommend_today",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asked_at_utc": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "exclude_news": {
    "type": "boolean"
   },
   "generated_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "channel_category": {
       "type": [
        "string",
        "null"
       ]
      },
      "channel_id": {
       "type": "string"
      },
      "channel_name": {
       "type": "string"
      },
      "program": {
       "additionalProperties": true,
       "properties": {
        "category": {
         "type": [
          "string",
          "null"
         ]
        },
        "description": {
         "type": "string"
        },
        "duration_min": {
         "type": "number"
        },
        "start_local": {
         "type": "string"
        },
        "start_utc": {
         "type": "string"
        },
        "stop_local": {
         "type": "string"
        },
        "stop_utc": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "title",
        "start_local",
        "start_utc",
        "stop_local",
        "stop_utc",
        "duration_min"
       ],
       "type": "object"
      },
      "score": {
       "type": "number"
      },
      "why_recommended": {
       "type": "string"
      }
     },
     "required": [
      "channel_id",
      "channel_name",
      "program",
      "score",
      "why_recommended"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prefer": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeframe_label": {
    "type": "string"
   },
   "window": {
    "additionalProperties": true,
    "properties": {
     "from_utc": {
      "type": "string"
     },
     "to_utc": {
      "type": "string"
     }
    },
    "required": [
     "from_utc",
     "to_utc"
    ],
    "type": "object"
   }
  },
  "required": [
   "asked_at_utc",
   "timeframe_label",
   "window",
   "prefer",
   "exclude_news",
   "count",
   "items"
  ],
  "type": "object"
 },
 "title": "Recommend something to watch on Romanian TV"
}
