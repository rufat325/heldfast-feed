   "query": {
    "description": "\u0422\u0435\u043a\u0441\u0442 \u043f\u043e\u0438\u0441\u043a\u0430 \u043f\u043e \u043f\u043e\u0437\u0438\u0446\u0438\u0438, \u043d\u043e\u043c\u0435\u0440\u0443 \u043a\u043e\u043d\u0442\u0440\u0430\u043a\u0442\u0430 \u0438\u043b\u0438 \u0438\u0437\u0432\u0435\u0449\u0435\u043d\u0438\u044f, \u0437\u0430\u043a\u0430\u0437\u0447\u0438\u043a\u0443 \u0438 \u043f\u043e\u0441\u0442\u0430\u0432\u0449\u0438\u043a\u0443",
