{
 "description": "Charge a tokenized card (POST /payment/v1/charge/create). Amounts in COP unless currency says otherwise. Test mode is controlled by EPAYCO_TEST.",
 "inputSchema": {
  "properties": {
   "bill": {
    "description": "Merchant invoice/order reference",
    "type": "string"
   },
   "currency": {
    "description": "Currency code (default COP)",
    "type": "string"
   },
   "customer_id": {
    "description": "Customer id from create_customer",
    "type": "string"
   },
   "description": {
    "description": "Charge description",
    "type": "string"
   },
   "doc_number": {
    "description": "Payer document number",
    "type": "string"
   },
   "doc_type": {
    "description": "Payer document type: CC, CE, NIT, ...",
    "type": "string"
   },
   "dues": {
    "description": "Installments (default \"1\")",
    "type": "string"
   },
   "email": {
    "description": "Payer email",
    "type": "string"
   },
   "last_name": {
    "description": "Payer last name",
    "type": "string"
   },
   "name": {
    "description": "Payer first name",
    "type": "string"
   },
   "tax": {
    "description": "Tax portion (default \"0\")",
    "type": "string"
   },
   "tax_base": {
    "description": "Taxable base (default value)",
    "type": "string"
   },
   "token_card": {
    "description": "Card token",
    "type": "string"
   },
   "value": {
    "description": "Amount (string, e.g. \"116000\")",
    "type": "string"
   }
  },
  "required": [
   "token_card",
   "customer_id",
   "doc_type",
   "doc_number",
   "name",
   "email",
   "bill",
   "value"
  ],
  "type": "object"
 },
 "name": "charge_card"
}
