{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a booking or appointment request for a published business facade. Creates a PENDING reservation; the merchant confirms in Dashboard. Not a guaranteed instant booking. HTTP equivalent: POST /api/v1/b/{handle}/reservations.",
 "inputSchema": {
  "properties": {
   "date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "email": {
    "description": "Optional guest email",
    "type": "string"
   },
   "handle": {
    "description": "Public facade handle (AgentID)",
    "type": "string"
   },
   "mode": {
    "description": "table for dine-in; appointment for generic services",
    "enum": [
     "table",
     "appointment"
    ],
    "type": "string"
   },
   "name": {
    "description": "Guest name",
    "type": "string"
   },
   "note": {
    "description": "Optional note for the merchant",
    "type": "string"
   },
   "partySize": {
    "description": "Party size (1\u201340)",
    "type": "integer"
   },
   "phone": {
    "description": "Guest phone (E.164 or local)",
    "type": "string"
   },
   "service": {
    "description": "Optional service label",
    "type": "string"
   },
   "table": {
    "description": "Optional table code from facade.tables",
    "type": "string"
   },
   "time": {
    "description": "HH:mm",
    "type": "string"
   }
  },
  "required": [
   "handle",
   "name",
   "phone",
   "partySize",
   "date",
   "time"
  ],
  "type": "object"
 },
 "name": "create_reservation"
}
