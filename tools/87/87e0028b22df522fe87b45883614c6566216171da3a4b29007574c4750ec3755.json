{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "private",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Submit a signed payment mandate for autonomous execution. Runs the four-check pipeline and the per-agent autonomy fence; payments outside the agent's envelope are gated to human approval.",
 "inputSchema": {
  "properties": {
   "jcsHash": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[a-f0-9]+$",
    "type": "string"
   },
   "mandateBodyJson": {
    "maxLength": 16384,
    "minLength": 1,
    "type": "string"
   },
   "serviceLevel": {
    "enum": [
     "PAYMENT_SERVICE_LEVEL_UNSPECIFIED",
     "PAYMENT_SERVICE_LEVEL_STANDARD",
     "PAYMENT_SERVICE_LEVEL_SAME_DAY"
    ],
    "type": "string"
   },
   "signatureB64url": {
    "maxLength": 256,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "autonomous_pay",
 "outputSchema": {
  "properties": {
   "audit": {
    "anyOf": [
     {
      "properties": {
       "checks": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "correlationId": {
        "type": "string"
       },
       "mandateJcsHash": {
        "type": "string"
       },
       "policyVersion": {
        "type": "string"
       },
       "rejectedAt": {
        "type": "string"
       },
       "signerFingerprint": {
        "type": "string"
       },
       "wysiwysHash": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "feeCents": {
    "type": "string"
   },
   "paymentId": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "PAYMENT_STATUS_UNSPECIFIED",
     "PAYMENT_STATUS_SUBMITTED",
     "PAYMENT_STATUS_DENIED",
     "PAYMENT_STATUS_NEEDS_HUMAN_APPROVAL",
     "PAYMENT_STATUS_REJECTED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Submit Payment"
}
