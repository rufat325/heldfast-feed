 "description": "Score product-market fit signals (the \"very disappointed\" test, retention, organic pull, NPS) into a weighted 0-100 PMF score and scale-readiness verdict. See the full version at https://rahuldsarker.co/calculators/product-market-fit-scoring-grader",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "disappointed": {
    "description": "\"Very disappointed if it went away\" test (>40%): strong, ok (mixed), or weak/no. Weight 30",
    "enum": [
     "strong",
     "ok",
     "weak"
    ],
    "type": "string"
   },
   "nps": {
    "description": "Strong NPS & referrals: strong, ok, or weak/no. Weight 20",
    "enum": [
     "strong",
     "ok",
     "weak"
    ],
    "type": "string"
   },
   "organic": {
    "description": "Organic / word-of-mouth pull: strong, ok, or weak/no. Weight 20",
    "enum": [
     "strong",
     "ok",
     "weak"
    ],
    "type": "string"
   },
   "retention": {
    "description": "Retention curve flattens (users stick): strong, ok, or weak/no. Weight 30",
    "enum": [
     "strong",
     "ok",
     "weak"
    ],
    "type": "string"
   }
  },
  "required": [
   "disappointed",
   "retention",
   "organic",
   "nps"
  ],
  "type": "object"
 },
 "name": "product_market_fit_scoring_grader",
