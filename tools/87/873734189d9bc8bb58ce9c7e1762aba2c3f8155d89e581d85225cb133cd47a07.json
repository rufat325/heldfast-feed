{"annotations":{"destructiveHint":false,"openWorldHint":false},"description":"Godot animation: create/remove/rename animations and add tracks and keys on an AnimationPlayer. ops run in order as one undo step; track paths are \"Node:property\" relative to the player's root_node.","inputSchema":{"properties":{"allow_missing":{"description":"Skip existence checks.","type":"boolean"},"animation":{"description":"Default animation for ops that omit it.","type":"string"},"ops":{"items":{"properties":{"animation":{"description":"\"walk\" or \"library/walk\".","type":"string"},"interpolation":{"enum":["nearest","linear","cubic","linear_angle","cubic_angle"],"type":"string"},"key":{"type":"number"},"length":{"type":"number"},"loop":{"enum":["none","linear","pingpong"],"type":"string"},"op":{"enum":["create","remove","rename","set","add_track","remove_track","insert_key","remove_key"],"type":"string"},"path":{"description":"add_track: e.g. \"Sprite2D:modulate\".","type":"string"},"step":{"type":"number"},"time":{"type":"number"},"to":{"type":"string"},"track":{"description":"Track index or path.","type":["number","string"]},"transition":{"description":"Easing (1 = linear).","type":"number"},"type":{"description":"Track type (default value).","enum":["value","position_3d","rotation_3d","scale_3d","blend_shape","method","bezier","audio","animation"],"type":"string"},"update_mode":{"enum":["continuous","discrete","capture"],"type":"string"},"value":{"description":"Typed like the property; method: {method,args}; rotation_3d: [x,y,z] deg."}},"required":["op"],"type":"object"},"type":"array"},"player":{"description":"AnimationPlayer path; optional if the scene has one.","type":"string"},"scene":{"description":"Scene; required headless.","type":"string"}},"required":["ops"],"type":"object"},"name":"godot_anim_edit","title":"Edit animations"}
