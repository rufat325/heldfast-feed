{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Reinstall OS on an existing server (simplified path via eq/order_instance with id). DESTRUCTIVE: all disk data will be erased. Requires HOSTKEY_ALLOW_DESTRUCTIVE=1 in the server environment, confirm=true, and re-entering the server's current hostname. Async: status via check_task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Required (=true) to start reinstall",
    "type": "boolean"
   },
   "deploy_notify": {
    "type": "boolean"
   },
   "hostname": {
    "description": "Current server hostname \u2014 confirms the correct server is selected",
    "type": "string"
   },
   "id": {
    "description": "Server ID",
    "type": "integer"
   },
   "os_id": {
    "description": "New OS ID from list_os (0 + own_os=1 \u2014 no OS install)",
    "type": "integer"
   },
   "own_os": {
    "description": "1 \u2014 do not install OS",
    "type": "integer"
   },
   "post_install_script": {
    "type": "string"
   },
   "root_pass": {
    "description": "New root password",
    "minLength": 8,
    "type": "string"
   },
   "soft_id": {
    "description": "Software ID from list_software",
    "type": "integer"
   },
   "ssh_key": {
    "description": "Public SSH key for root",
    "type": "string"
   }
  },
  "required": [
   "id",
   "hostname",
   "os_id",
   "root_pass",
   "confirm"
  ],
  "type": "object"
 },
 "name": "reinstall_server"
}
