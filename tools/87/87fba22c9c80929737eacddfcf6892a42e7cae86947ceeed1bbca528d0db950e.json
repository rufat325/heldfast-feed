{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The reading list an emotion or theme page shows: books with one-line claims and a short attributed passage (\u2264300 chars). Exactly one of emotion or theme. FREE and read-only. Every url carries ?ref=mcp for citation arrival measurement.\n\n[capability: library-extraction-cards \u00b7 mirrors: GET /api/corpus/reading-list]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "emotion": {
    "description": "Emotion primary slug (e.g. grief). Mutually exclusive with theme.",
    "type": "string"
   },
   "limit": {
    "default": 24,
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "theme": {
    "description": "Controlled theme slug (e.g. desire). Mutually exclusive with emotion.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vela.library.reading_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "enum": [
     "emotion",
     "theme"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "ok": {
    "const": true,
    "type": "boolean"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "claim": {
       "type": "string"
      },
      "passage": {
       "additionalProperties": false,
       "properties": {
        "quote": {
         "type": "string"
        },
        "theme": {
         "type": "string"
        }
       },
       "required": [
        "quote",
        "theme"
       ],
       "type": "object"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "title",
      "author",
      "year",
      "claim",
      "passage",
      "url",
      "slug"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "kind",
   "slug",
   "limit",
   "rows"
  ],
  "type": "object"
 },
 "title": "vela.library.reading_list"
}
