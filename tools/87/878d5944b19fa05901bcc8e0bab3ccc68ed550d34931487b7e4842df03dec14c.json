{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Atomically edit an operator's name, parent, exact Network Editor position, color, comment, or writable flags. The bridge prevalidates requested fields, reads values back, and rolls back partial failures; parent moves copy and validate the destination before destroying the source. Returns the final path and per-field results. Does not use raw Python fallback.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowCooking": {
    "type": "boolean"
   },
   "bypass": {
    "type": "boolean"
   },
   "cloneImmune": {
    "type": "boolean"
   },
   "color": {
    "additionalItems": false,
    "description": "Operator RGB color, each channel in 0..1.",
    "items": [
     {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    ],
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "comment": {
    "description": "Bounded operator comment, including empty.",
    "maxLength": 2048,
    "type": "string"
   },
   "display": {
    "type": "boolean"
   },
   "lock": {
    "type": "boolean"
   },
   "name": {
    "description": "New operator name.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
    "type": "string"
   },
   "node_x": {
    "description": "Exact Network Editor X coordinate.",
    "maximum": 1000000,
    "minimum": -1000000,
    "type": "integer"
   },
   "node_y": {
    "description": "Exact Network Editor Y coordinate.",
    "maximum": 1000000,
    "minimum": -1000000,
    "type": "integer"
   },
   "parent_path": {
    "description": "Destination parent COMP for a safe move.",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "path": {
    "description": "Full path of the operator to edit.",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "render": {
    "type": "boolean"
   },
   "viewer": {
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "edit_td_node_metadata",
 "title": "Edit TouchDesigner node metadata"
}
