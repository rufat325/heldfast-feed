{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The University Senate meeting schedule for an academic year (default: the current one) with the agenda, materials, slides and minutes posted for each meeting, and the years the archive covers. Meetings run 3:15-5:00 PM unless a document says otherwise. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "year": {
    "description": "Academic year, e.g. \"2024-2025\" (default: current)",
    "pattern": "^\\d{4}-\\d{4}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "senate_get_meetings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "academic_year": {
    "description": "Academic year as \"YYYY-YYYY\", e.g. \"2025-2026\"",
    "pattern": "^\\d{4}-\\d{4}$",
    "type": "string"
   },
   "meetings": {
    "description": "Meetings in date order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Date as YYYY-MM-DD",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "documents": {
       "description": "Agenda, materials, slides and minutes posted for the meeting",
       "items": {
        "additionalProperties": false,
        "properties": {
         "text": {
          "description": "Link text",
          "type": "string"
         },
         "url": {
          "description": "Absolute URL",
          "type": "string"
         }
        },
        "required": [
         "text",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "label": {
       "description": "What makes the meeting special, e.g. \"President's State of the Campus Address\"; null for a regular meeting",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "date",
      "label",
      "documents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "other_documents": {
    "description": "Documents filed under the year but not a meeting, e.g. committee reports",
    "items": {
     "additionalProperties": false,
     "properties": {
      "text": {
       "description": "Link text",
       "type": "string"
      },
      "url": {
       "description": "Absolute URL",
       "type": "string"
      }
     },
     "required": [
      "text",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "years": {
    "description": "Every academic year with a schedule, newest first",
    "items": {
     "description": "Academic year as \"YYYY-YYYY\", e.g. \"2025-2026\"",
     "pattern": "^\\d{4}-\\d{4}$",
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "academic_year",
   "years",
   "meetings",
   "other_documents"
  ],
  "type": "object"
 },
 "title": "Get Senate meetings"
}
