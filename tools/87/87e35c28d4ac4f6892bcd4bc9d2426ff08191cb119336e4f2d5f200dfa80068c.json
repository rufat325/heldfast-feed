{
 "description": "Create a product in Bling",
 "inputSchema": {
  "properties": {
   "codigo": {
    "description": "Product code/SKU",
    "type": "string"
   },
   "formato": {
    "description": "S=Simple, E=With variations, V=Variation",
    "enum": [
     "S",
     "E",
     "V"
    ],
    "type": "string"
   },
   "nome": {
    "description": "Product name",
    "type": "string"
   },
   "pesoBruto": {
    "description": "Gross weight in kg",
    "type": "number"
   },
   "pesoLiquido": {
    "description": "Net weight in kg",
    "type": "number"
   },
   "preco": {
    "description": "Sale price",
    "type": "number"
   },
   "precoCusto": {
    "description": "Cost price",
    "type": "number"
   },
   "situacao": {
    "description": "A=Active, I=Inactive",
    "enum": [
     "A",
     "I"
    ],
    "type": "string"
   },
   "tipo": {
    "description": "P=Product, S=Service, K=Kit",
    "enum": [
     "P",
     "S",
     "K"
    ],
    "type": "string"
   },
   "unidade": {
    "description": "Unit of measure (UN, KG, etc.)",
    "type": "string"
   }
  },
  "required": [
   "nome",
   "preco",
   "tipo",
   "formato"
  ],
  "type": "object"
 },
 "name": "create_product"
}
