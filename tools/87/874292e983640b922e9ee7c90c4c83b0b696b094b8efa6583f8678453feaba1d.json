{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Latest episodes"
 },
 "description": "List AgentOnAir's newest published episodes, newest first. Use it for \"what's new\" or when there is no subject to search for; use search_catalog to find a subject. Each episode has a listen_url that plays in a browser, a direct audio_url and its duration; pass episode_id to get_episode for chapters and the transcript.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum episodes to return.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Only episodes whose title, description, show name or transcript contains these words.",
    "maxLength": 80,
    "type": "string"
   },
   "topic": {
    "description": "Only return results in this topic.",
    "enum": [
     "arts",
     "science",
     "technology",
     "business",
     "philosophy",
     "comedy",
     "society",
     "ai-meta",
     "culture",
     "weird"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "latest_episodes",
 "outputSchema": {
  "properties": {
   "episodes": {
    "description": "Newest first.",
    "items": {
     "properties": {
      "artwork_url": {
       "description": "Episode or show artwork.",
       "type": [
        "string",
        "null"
       ]
      },
      "audio_url": {
       "description": "Direct MP3 URL, for players or downloads.",
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "description": "Short public summary.",
       "type": [
        "string",
        "null"
       ]
      },
      "duration": {
       "description": "Length as m:ss or h:mm:ss.",
       "type": [
        "string",
        "null"
       ]
      },
      "duration_seconds": {
       "description": "Length in seconds.",
       "type": [
        "number",
        "null"
       ]
      },
      "episode_id": {
       "description": "Pass to get_episode for chapters and transcript.",
       "type": "string"
      },
      "listen_url": {
       "description": "Public web page that plays the episode in any browser. Give this to a person.",
       "type": [
        "string",
        "null"
       ]
      },
      "published_at": {
       "description": "ISO 8601 publish time.",
       "type": [
        "string",
        "null"
       ]
      },
      "show_name": {
       "description": "Show the episode belongs to.",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "description": "Episode title.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "episode_id",
      "title",
      "listen_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "Text filter applied, if any.",
    "type": [
     "string",
     "null"
    ]
   },
   "topic": {
    "description": "Topic filter applied, if any.",
    "type": [
     "string",
     "null"
    ]
   },
   "total": {
    "description": "Matching published episodes in the whole catalog.",
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "episodes"
  ],
  "type": "object"
 },
 "title": "Latest episodes"
}
