{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieves today prayer timetable (Fajr, Sunrise, Dhuhr, Asr, Maghrib, Isha) in UTC and formatted local time. MANDATORY: The LLM must always explicitly disclose to the user which calculation authority method was used and why it was selected (see authorityNotice in response).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calculationMethod": {
    "description": "Optional calculation authority override (auto-resolved from location by default)",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "date": {
    "description": "Date in YYYY-MM-DD format (defaults to today)",
    "type": "string"
   },
   "latitude": {
    "description": "Optional explicit latitude override",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Optional explicit longitude override",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "madhab": {
    "description": "Optional Asr shadow jurisprudence override (Shafi or Hanafi)",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "Optional IANA timezone override",
    "type": "string"
   },
   "userId": {
    "description": "Optional unique user identifier to load stored preferences. If omitted, pure geographic auto-resolution is applied.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_today_prayer_times",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authorityDescription": {
    "type": "string"
   },
   "authorityNotice": {
    "additionalProperties": false,
    "properties": {
     "authorityDescription": {
      "description": "Full descriptive name of the calculation authority",
      "type": "string"
     },
     "madhab": {
      "description": "The Asr jurisprudence school",
      "enum": [
       "Shafi",
       "Hanafi"
      ],
      "type": "string"
     },
     "method": {
      "description": "The calculation authority method",
      "enum": [
       "UmmAlQura",
       "MuslimWorldLeague",
       "Egyptian",
       "Karachi",
       "NorthAmerica",
       "Dubai",
       "Qatar",
       "Kuwait",
       "MoonsightingCommittee",
       "Singapore",
       "Turkey",
       "Tehran"
      ],
      "type": "string"
     },
     "requiredDisplayInstruction": {
      "description": "Mandatory theological notice for AI presentation",
      "type": "string"
     },
     "selectionReason": {
      "description": "Rationale for selecting this authority",
      "type": "string"
     }
    },
    "required": [
     "method",
     "madhab",
     "authorityDescription",
     "selectionReason",
     "requiredDisplayInstruction"
    ],
    "type": "object"
   },
   "calculationMethod": {
    "description": "Active calculation authority",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "localDate": {
    "description": "Local schedule date YYYY-MM-DD",
    "type": "string"
   },
   "madhab": {
    "description": "Active Asr jurisprudence",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
