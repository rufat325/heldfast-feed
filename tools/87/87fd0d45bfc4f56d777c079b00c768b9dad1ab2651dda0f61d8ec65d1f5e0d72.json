     "dhuhr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "fajr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "isha": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "maghrib": {
