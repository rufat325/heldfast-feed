     }
    },
    "required": [
     "fajr",
     "sunrise",
     "dhuhr",
     "asr",
     "maghrib",
     "isha"
    ],
    "type": "object"
   },
   "timezone": {
    "description": "Resolved IANA timezone",
    "type": "string"
   }
  },
  "required": [
   "localDate",
   "timezone",
   "calculationMethod",
