{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search guild messages"
 },
 "description": "Search for messages across all channels in a guild using Discord's native search API. Returns messages matching the query with channel context. Requires READ_MESSAGE_HISTORY permission. Use discord_search_messages for channel-specific search.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "author_id": {
    "description": "Optional. Only show messages from this user ID.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "channel_id": {
    "description": "Optional. Restrict search to this channel ID.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Max messages to return (1\u201325). Default 25.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query (case-insensitive).",
    "type": "string"
   }
  },
  "required": [
   "guild_id",
   "query"
  ],
  "type": "object"
 },
 "name": "discord_search_guild_messages",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": "string"
      },
      "channel_id": {
       "type": "string"
      },
      "channel_name": {
       "type": "string"
      },
      "content": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "author",
      "content",
      "timestamp",
      "channel_id",
      "channel_name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "matches"
  ],
  "type": "object"
 }
}
