{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List drafts"
 },
 "description": "List an inbox's drafts, most recently created first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Continue with next_cursor from the previous result, keeping the same filters. Stop when next_cursor is null.",
    "maxLength": 1024,
    "type": "string"
   },
   "inbox_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "draft (default): editable drafts. submitted: drafts already sent or attempted. all: both.",
    "enum": [
     "draft",
     "submitted",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "inbox_id"
  ],
  "type": "object"
 },
 "name": "list_drafts",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "drafts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "description": "Absolute ISO 8601 service timestamp in UTC (Z), with millisecond precision.",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "inbox_id": {
       "type": "string"
      },
      "sent_message_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "state": {
       "enum": [
        "draft",
        "submitted"
       ],
       "type": "string"
      },
      "subject": {
       "type": "string"
      },
      "updated_at": {
       "description": "Absolute ISO 8601 service timestamp in UTC (Z), with millisecond precision.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "inbox_id",
      "state",
      "subject",
      "created_at",
      "updated_at",
      "sent_message_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "drafts",
   "next_cursor"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List drafts"
}
