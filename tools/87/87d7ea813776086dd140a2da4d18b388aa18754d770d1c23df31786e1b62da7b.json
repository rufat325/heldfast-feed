{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Open a local executable, application bundle, archive, JavaScript, source map, plist, or analysis database after validation. provider_id selects one deep provider or deterministic auto selection; the binding remains stable until close or an explicit switch, with no failure fallback. An optional snapshot v2 is imported atomically and must match the binary identity, concrete provider, and canonical analysis profile exactly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "path": "/tmp/fixture"
   }
  ],
  "properties": {
   "path": {
    "description": "Local filesystem path used by this operation.",
    "minLength": 1,
    "type": "string"
   },
   "provider_id": {
    "anyOf": [
     {
      "const": "auto",
      "type": "string"
     },
     {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]*$",
      "type": "string"
     }
    ],
    "description": "Exact deep-analysis provider ID, or automatic selection when omitted."
   },
   "snapshot_path": {
    "description": "Local filesystem path for snapshot.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "open_binary",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": false,
    "properties": {
     "architecture": {
      "anyOf": [
       {
        "enum": [
         "x86",
         "x86_64",
         "arm",
         "arm64"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "format": {
      "enum": [
       "hopper",
       "analysis-database",
       "mach-o",
       "elf",
       "pe",
       "zip",
       "ipa",
       "apk",
       "msix",
       "appx",
       "asar",
       "dmg",
       "pkg",
       "plist",
       "javascript",
       "source-map"
      ],
      "type": "string"
     },
     "kind": {
      "enum": [
       "executable",
       "database",
       "archive",
       "artifact"
      ],
      "type": "string"
     },
     "loaderArgs": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "path": {
      "type": "string"
     },
     "sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     }
    },
    "required": [
     "path",
     "format",
     "kind",
     "loaderArgs",
     "sha256",
     "architecture"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Open Binary"
}
