 "description": "Returns one domain purchase's live status \u2014 use it to answer 'did my domain go through?' after checkout.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "domain": {
    "maxLength": 253,
    "minLength": 1,
    "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+\\.?)$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "formation_get_domain_order",
 "outputSchema": {
  "properties": {
   "autoRenew": {
    "type": "boolean"
   },
   "expiresAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "DOMAIN_ORDER_STATUS_UNSPECIFIED",
     "DOMAIN_ORDER_STATUS_CHECKOUT_PENDING",
     "DOMAIN_ORDER_STATUS_REGISTERED",
     "DOMAIN_ORDER_STATUS_FAILED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get Domain Order"
}
