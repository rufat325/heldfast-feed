{
 "description": "List all monitoring targets for your team. Returns name, URL, type, status, and uptime info for each target.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "description": "Max number of targets to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "description": "Filter by target status",
    "enum": [
     "HEALTHY",
     "WARNING",
     "CRITICAL",
     "UNKNOWN"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by target type",
    "enum": [
     "WEBSITE",
     "API",
     "WEBSHOP"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_targets",
 "title": "List Targets"
}
