{"_meta":{"com.invoiceparserpro/capability":{"category":"Invoice review and corrections","description":"Correct selected fields on one saved invoice. Financial corrections can reset approval; invalid or unsupported values are refused. Review and confirm the exact change first. The preview expires after five minutes. Preview only; nothing is applied until you confirm.","examples":["For our fictional practice invoice, preview correcting only the invoice number to DEMO-104. Show the current value and wait for my confirmation.","Preview clearing the selected invoice's due date. Show the change and whether it affects approval, then wait for my confirmation."],"mode":"preview","scope":"workspace.write"},"securitySchemes":[{"scopes":["workspace.write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Preview: Correct invoice fields"},"description":"Prepare a bounded change to saved invoice header fields. Requires confirmation; financial edits may reset approval. Unknown fields and invalid currencies are refused. This returns an exact preview and a five-minute confirmation token; it does not apply the change.","inputSchema":{"$defs":{"EditFields":{"additionalProperties":false,"properties":{"fields":{"$ref":"#/$defs/InvoiceFields"},"invoice_id":{"format":"uuid","title":"Invoice Id","type":"string"}},"required":["invoice_id","fields"],"title":"EditFields","type":"object"},"InvoiceFields":{"additionalProperties":false,"properties":{"currency":{"anyOf":[{"maxLength":3,"minLength":3,"type":"string"},{"type":"null"}],"default":null,"title":"Currency"},"customer_name":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"default":null,"title":"Customer Name"},"discount":{"anyOf":[{"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)","type":"string"},{"type":"null"}],"default":null,"title":"Discount"},"document_type":{"anyOf":[{"enum":["invoice","credit_note","debit_memo"],"type":"string"},{"type":"null"}],"default":null,"title":"Document Type"},"due_date":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null,"title":"Due Date"},"fees":{"anyOf":[{"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)","type":"string"},{"type":"null"}],"default":null,"title":"Fees"},"invoice_date":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null,"title":"Invoice Date"},"invoice_number":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Invoice Number"},"original_invoice_reference":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Original Invoice Reference"},"payment_terms":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"default":null,"title":"Payment Terms"},"po_number":{"anyOf":[{"maxLength":200,"type":"string"},{"type":"null"}],"default":null,"title":"Po Number"},"shipping":{"anyOf":[{"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)","type":"string"},{"type":"null"}],"default":null,"title":"Shipping"},"subtotal":{"anyOf":[{"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)","type":"string"},{"type":"null"}],"default":null,"title":"Subtotal"},"tax":{"anyOf":[{"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)","type":"string"},{"type":"null"}],"default":null,"title":"Tax"},"total_amount":{"anyOf":[{"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*(?:\\d{0,14}|(?=[\\d.]{1,21}0*$)\\d{0,14}\\.\\d{0,6}0*$)","type":"string"},{"type":"null"}],"default":null,"title":"Total Amount"},"vendor_address":{"anyOf":[{"maxLength":2000,"type":"string"},{"type":"null"}],"default":null,"title":"Vendor Address"},"vendor_name":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"defaul