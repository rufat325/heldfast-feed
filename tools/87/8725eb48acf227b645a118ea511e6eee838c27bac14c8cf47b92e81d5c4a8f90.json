{
 "description": "List Swiss public institutions (Confederation, cantons, municipalities) that publish tenders",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "lang": {
    "default": "en",
    "description": "Language for names",
    "enum": [
     "de",
     "fr",
     "it",
     "en"
    ],
    "type": "string"
   },
   "search": {
    "description": "Filter by name (min 3 characters)",
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_institutions"
}
