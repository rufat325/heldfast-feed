{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud Hadoop cluster. HA is always enabled (2 master nodes). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bootstrapScript": {
    "description": "Bootstrap script path (required when useBootstrapScript=true)",
    "type": "string"
   },
   "bucketName": {
    "description": "Object Storage bucket name",
    "type": "string"
   },
   "cloudHadoopAddOnCodeList": {
    "description": "Add-on codes (e.g. PRESTO, HBASE)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cloudHadoopAdminUserName": {
    "description": "Admin user name for Ambari (3-15 chars)",
    "type": "string"
   },
   "cloudHadoopAdminUserPassword": {
    "description": "Admin password (8-20 chars)",
    "type": "string"
   },
   "cloudHadoopClusterName": {
    "description": "Cluster name (3-15 chars, lowercase+numbers+'-')",
    "type": "string"
   },
   "cloudHadoopClusterTypeCode": {
    "description": "Cluster type code (use ncloud_hadoop_list_cluster_types)",
    "type": "string"
   },
   "cloudHadoopImageProductCode": {
    "description": "Image product code. Default: latest",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview without creating",
    "type": "boolean"
   },
   "edgeNodeProductCode": {
    "description": "Edge node server type code",
    "type": "string"
   },
   "edgeNodeSubnetNo": {
    "description": "Edge node subnet number",
    "type": "string"
   },
   "engineVersionCode": {
    "description": "Engine version code (for Rocky cluster)",
    "type": "string"
   },
   "kdcPassword": {
    "description": "KDC admin password (required when useKdc=true)",
    "type": "string"
   },
   "kdcRealm": {
    "description": "KDC Realm (required when useKdc=true)",
    "type": "string"
   },
   "loginKeyName": {
    "description": "Login key name for SSH access",
    "type": "string"
   },
   "masterNodeDataStorageSize": {
    "description": "Master storage GB (100-2000/10GB, or 4000, 6000)",
    "type": "number"
   },
   "masterNodeDataStorageTypeCode": {
    "description": "Master storage type (SSD|HDD|CB2)",
    "type": "string"
   },
   "masterNodeProductCode": {
    "description": "Master node server type code",
    "type": "string"
   },
   "masterNodeSubnetNo": {
    "description": "Master node subnet number",
    "type": "string"
   },
   "regionCode": {
    "description": "Region code (e.g. KR)",
    "type": "string"
   },
   "useBootstrapScript": {
    "description": "Use bootstrap script (default: false)",
    "type": "boolean"
   },
   "useDataCatalog": {
    "description": "Use Data Catalog for Hive metastore (default: false)",
    "type": "boolean"
   },
   "useKdc": {
    "description": "Use Kerberos KDC (default: false)",
    "type": "boolean"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "string"
   },
   "workerNodeCount": {
    "description": "Worker node count (2-8, default: 2)",
    "type": "number"
   },
   "workerNodeDataStorageSize": {
    "description": "Worker storage GB (100-2000/10GB, or 4000, 6000)",
    "type": "number"
   },
   "workerNodeDataStorageTypeCode": {
    "description": "Worker storage type (SSD|HDD|CB2)",
    "type": "string"
   },
   "workerNodeProductCode": {
    "description": "Worker node server type code",
    "type": "string"
   },
   "workerNodeSubnetNo": {
    "description": "Worker node subnet (private subnet only)",
    "type": "string"
   }
  },
  "required": [
   "cloudHadoopClusterName",
   "cloudHadoopClusterTypeCode",
   "vpcNo",
   "cloudHadoopAdminUserName",
   "cloudHadoopAdminUserPassword",
   "bucketName",
   "edgeNodeSubnetNo",
   "masterNodeSubnetNo",
   "masterNodeDataStorageTypeCode",
   "masterNodeDataStorageSize",
   "workerNodeSubnetNo",
   "workerNodeDataStorageTypeCode",
   "workerNodeDataStorageSize",
   "loginKeyName"
  ],
  "type": "object"
 },
 "name": "ncloud_hadoop_create_cluster"
}
