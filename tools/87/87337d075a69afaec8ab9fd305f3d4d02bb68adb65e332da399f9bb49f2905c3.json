{
 "description": "Get the actual input/output data for a run action. Fetches content from inputsLink/outputsLink URLs. For Standard SKU, workflowName is required. Essential for debugging data transformation issues.",
 "inputSchema": {
  "properties": {
   "actionName": {
    "description": "Action name",
    "type": "string"
   },
   "logicAppName": {
    "description": "Logic App resource name",
    "type": "string"
   },
   "resourceGroupName": {
    "description": "Resource group name",
    "type": "string"
   },
   "runId": {
    "description": "Run ID",
    "type": "string"
   },
   "subscriptionId": {
    "description": "Azure subscription ID",
    "type": "string"
   },
   "type": {
    "description": "Which content to fetch (default: both)",
    "enum": [
     "inputs",
     "outputs",
     "both"
    ],
    "type": "string"
   },
   "workflowName": {
    "description": "Workflow name (required for Standard SKU)",
    "type": "string"
   }
  },
  "required": [
   "subscriptionId",
   "resourceGroupName",
   "logicAppName",
   "runId",
   "actionName"
  ],
  "type": "object"
 },
 "name": "get_action_io"
}
