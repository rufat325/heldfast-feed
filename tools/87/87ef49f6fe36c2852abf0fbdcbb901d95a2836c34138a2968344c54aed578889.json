{
 "description": "Record what happened when you acted on a spark \u2014 an outcome note, a new status (tried / worked / failed), and ideally the cost (effort spent) and value (graded payoff). LOG FAILURES TOO: 'most bets fail' is the premise of problem #2, so failed and zero-value outcomes are exactly the signal a spend-policy is learned from \u2014 recording only wins makes the history unusable. This outcome history is what lets the system learn when surfacing a dormant problem is worth the attention.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claimType": {
    "description": "Backfill the claim's logical type IF never stated (write-once: ignored when already set). 'universal' = a null kills the claim; 'existential-bounded' = a null kills only the tested frame.",
    "enum": [
     "universal",
     "existential-bounded"
    ],
    "type": "string"
   },
   "cost": {
    "description": "ACTUAL effort spent chasing it to a verdict (same scale as capture's estimate).",
    "type": "number"
   },
   "costToOpen": {
    "description": "Revise the FORWARD cost-to-open estimate (uncommon \u2014 normally set once at capture). Resolution never changes it automatically.",
    "type": "number"
   },
   "exhaustion": {
    "description": "State the retirement predicate (when to ABANDON rather than re-park \u2014 the dual of wakeCondition) IF never stated. Write-once. A parked spark with a wake but no exhaustion is unkillable-in-practice; ledger_invariants.py flags these as ORPHANED-EXISTENTIAL.",
    "type": "string"
   },
   "forbids": {
    "description": "Backfill the content statement (one observation this spark rules out) IF never stated. Write-once: an existing forbids is immutable \u2014 revising it after results is the post-hoc rescue it exists to block.",
    "type": "string"
   },
   "id": {
    "description": "Spark id",
    "type": "integer"
   },
   "outcome": {
    "description": "What happened when you tried it",
    "type": "string"
   },
   "status": {
    "description": "New status for the spark",
    "enum": [
     "pending",
     "tried",
     "worked",
     "failed"
    ],
    "type": "string"
   },
   "value": {
    "description": "Graded payoff of the outcome: 0 if it failed or yielded nothing, higher for bigger wins (heavy-tailed). The reward signal the budget policy is fit on \u2014 log it for failures too.",
    "type": "number"
   },
   "wakeCondition": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "all": {
        "description": "Ripe when EVERY atom is ripe. A `manual` atom here means: once the numeric atoms are ripe, surface as 'manual check due' instead of auto-firing.",
        "items": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "description": "Threshold \u2014 the atom is ripe when current >= gte",
             "exclusiveMinimum": 0,
             "type": "number"
            },
            "signal": {
             "const": "sparkCount",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "signal": {
             "const": "resolvedSparkCount",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "signal": {
             "const": "openProblemCount",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "onOrAfter": {
             "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
             "type": "string"
            },
            "signal": {
             "const": "date",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "onOrAfter"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "path": {
             "type": "string"
            },
            "signal": {
             "const": "fileLines",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "path",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "path": {
             "type": "string"
            },
            "pattern": {
             "type": "string"
            },
            "signal": {
             "const": "fileMatches",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "path",
            "pattern",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "dir": {
             "type": "string"
            },
            "gte": {
             "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items/anyOf/0/properties/gte"
            },
            "signal": {
             "const": "fileCount",
             "type": "string"
            },
            "suffix": {
             "type": "string"
            }
           },
           "required": [
            "signal",
            "dir",
            "gte"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "note": {
             "type": "string"
            },
            "signal": {
             "const": "manual",
             "type": "string"
            }
           },
           "required": [
            "signal",
            "note"
           ],
           "type": "object"
          }
         ]
        },
        "minItems": 1,
        "type": "array"
       },
       "any": {
        "description": "Ripe when AT LEAST ONE atom is ripe",
        "items": {
         "$ref": "#/properties/wakeCondition/anyOf/0/properties/all/items"
        },
        "minItems": 1,
        "type": "array"
       },
       "summary": {
        "description": "One-line human statement of the trigger",
        "type": "string"
       }
      },
      "required": [
       "summary"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Park a HOLD/STOPped spark with its computable re-run trigger \u2014 the digest owns the wait (see wake_status). Pass null to clear; resolving worked/failed auto-clears."
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_spark",
 "title": "Record a spark's outcome"
}
