{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Save a move comparison to the signed-in member's Scenario Planner, so it appears under their saved scenarios in Heed: the origin (their declared tax residency unless given), the destination, the planned move date and a label. Use it after run_scenario when the member says 'save that'. Pro. Saves nothing else; it writes one row to their record, so confirm first. Returns the saved scenario with its id.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"from_country":{"description":"Origin. Defaults to the member's declared tax residency.","type":"string"},"label":{"description":"A short name for the scenario.","maxLength":80,"type":"string"},"move_date":{"description":"Planned move date, YYYY-MM-DD.","type":"string"},"target_country":{"description":"Destination, name or two-letter code.","type":"string"}},"required":["target_country"],"type":"object"},"name":"save_scenario","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"app_url":{"type":"string"},"scenario":{"additionalProperties":false,"properties":{"asset_classes":{"items":{"type":"string"},"type":"array"},"created_at":{"$ref":"#/properties/scenario/properties/label"},"from":{"additionalProperties":false,"properties":{"code":{"type":"string"},"name":{"type":"string"}},"required":["code","name"],"type":"object"},"id":{"type":"string"},"income_types":{"items":{"type":"string"},"type":"array"},"label":{"type":["string","null"]},"move_date":{"$ref":"#/properties/scenario/properties/label"},"to":{"$ref":"#/properties/scenario/properties/from"}},"required":["id","label","from","to","move_date","income_types","asset_classes","created_at"],"type":"object"},"summary":{"type":"string"}},"required":["summary","scenario","app_url"],"type":"object"},"title":"Save a scenario"}
