{
 "description": "Register an action outcome (agent perspective). Part of three-way reporting.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action_id": {
    "type": "string"
   },
   "declared_intent": {
    "type": "string"
   },
   "divergence_score": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "observed_outcome": {
    "type": "string"
   },
   "outcome_class": {
    "enum": [
     "success",
     "partial_success",
     "failure",
     "unintended_effect",
     "unknown"
    ],
    "type": "string"
   },
   "semantic_uncertainty": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "type": "string"
   }
  },
  "required": [
   "action_id",
   "declared_intent",
   "semantic_uncertainty",
   "observed_outcome",
   "outcome_class",
   "divergence_score",
   "valid_until"
  ],
  "type": "object"
 },
 "name": "create_outcome_record"
}
