      }
     },
     "required": [
      "site_id",
      "label",
      "timezone",
      "is_demo"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "my_sites": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "domain": {
       "type": "string"
      },
      "is_demo": {
       "type": "boolean"
      },
      "is_primary": {
       "type": "boolean"
      },
      "name": {
