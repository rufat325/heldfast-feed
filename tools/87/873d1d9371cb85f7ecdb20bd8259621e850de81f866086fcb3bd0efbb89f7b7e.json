{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List available sites"
 },
 "description": "List the sites this signed-in account can analyze, in two groups. Requires a RevenueScope account (OAuth); no site registration is needed. my_sites = the sites connected to the account (display name, domain, timezone, is_demo). demo_sites = operator-curated sample sites, with timezone and the site's is_demo flag. Only call a site a sample when is_demo=true. Prefer my_sites; if site_id is omitted, analytics tools use the is_primary=true site. When my_sites is empty, analytics tools default to the first demo site and say so; tell the user the numbers come from a sample site, not their own. A demo site can always be viewed by passing its site_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "list_sites",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "demo_sites": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "is_demo": {
       "type": "boolean"
      },
      "label": {
       "type": "string"
      },
      "site_id": {
       "type": "string"
      },
      "timezone": {
