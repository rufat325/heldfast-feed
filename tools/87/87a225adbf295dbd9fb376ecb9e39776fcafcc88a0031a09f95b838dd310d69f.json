{
 "description": "Submit a response to a project. Markdown body (\u226550 chars). Requires a builder account with an active access pass. A sandbox key validates without persisting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget_cents": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "budget_currency": {
    "enum": [
     "EUR",
     "USD",
     "UAH"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project (storm) UUID from list_projects",
    "type": "string"
   },
   "source_language": {
    "default": "en",
    "enum": [
     "en",
     "ru",
     "uk"
    ],
    "type": "string"
   },
   "source_message": {
    "description": "Markdown response body",
    "minLength": 50,
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "source_message"
  ],
  "type": "object"
 },
 "name": "create_response",
 "title": "Create a response"
}
