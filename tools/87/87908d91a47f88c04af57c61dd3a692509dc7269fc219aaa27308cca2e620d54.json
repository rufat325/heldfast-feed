{
 "description": "Filterable audit of feed events (subscribe/fetch/action/unsubscribe), newest first, agent-attributed. Requires a workspace API key (for a feed your workspace owns) or the admin token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "feed": {
    "description": "Feed id",
    "type": "string"
   },
   "limit": {
    "description": "Max rows (default 50)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Filter by event type",
    "enum": [
     "subscribe",
     "fetch",
     "action",
     "unsubscribe"
    ],
    "type": "string"
   }
  },
  "required": [
   "feed"
  ],
  "type": "object"
 },
 "name": "hello_aigent_event_log"
}
