{
 "description": "Import a video's comments into the local comment knowledge base for semantic search. Fetches comments via the existing comment pipeline and indexes them for searchComments. Imports persist across sessions \u2014 call recallWorkspace or listCommentCollections first to avoid re-importing. [~3-10s]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activateCollection": {
    "description": "Set as active comment collection (default: true)",
    "type": "boolean"
   },
   "collectionId": {
    "description": "Custom collection ID (default: comments-{videoId})",
    "type": "string"
   },
   "dryRun": {
    "type": "boolean"
   },
   "includeReplies": {
    "description": "Include reply threads (default: true)",
    "type": "boolean"
   },
   "label": {
    "description": "Human-readable collection label",
    "type": "string"
   },
   "maxRepliesPerThread": {
    "maximum": 20,
    "minimum": 0,
    "type": "number"
   },
   "maxTopLevel": {
    "description": "Max top-level comments to fetch",
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "order": {
    "enum": [
     "relevance",
     "time"
    ],
    "type": "string"
   },
   "videoIdOrUrl": {
    "description": "YouTube video URL or ID",
    "type": "string"
   }
  },
  "required": [
   "videoIdOrUrl"
  ],
  "type": "object"
 },
 "name": "importComments"
}
