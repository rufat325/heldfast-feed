{"annotations":{"readOnlyHint":true},"description":"What a user should have got for every flag in one environment, by email or user key, with the reason (off, tester or rollout and their bucket), what their SDK reported that UTC day (seen), and any changes that day that flipped their result. Use it when a bug report says a feature stopped working, or works for some users and not others. times is a list of ISO timestamps to show side by side, like before and after a report; leave it out for now. An email the SDK saw with several user keys gives one entry per key.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"applicationId":{"pattern":"^[1-9]\\d*$","type":"string"},"environment":{"maxLength":100,"minLength":1,"pattern":"^[a-z0-9]+(?:[-_][a-z0-9]+)*$","type":"string"},"times":{"items":{"format":"date-time","type":"string"},"maxItems":10,"minItems":1,"type":"array"},"user":{"maxLength":256,"minLength":1,"type":"string"}},"required":["applicationId","environment","user"],"type":"object"},"name":"get_user_flags","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"results":{"items":{"properties":{"at":{"type":"string"},"subjects":{"items":{"properties":{"email":{"anyOf":[{"type":"string"},{"type":"null"}]},"flags":{"items":{"properties":{"bucketPercent":{"anyOf":[{"type":"number"},{"type":"null"}]},"key":{"type":"string"},"reason":{"enum":["off","tester","rollout","fallback"],"type":"string"},"rolloutPercent":{"type":"number"},"seen":{"anyOf":[{"enum":["on","off","both"],"type":"string"},{"type":"null"}]},"switches":{"items":{"properties":{"at":{"type":"string"},"userLabel":{"type":"string"},"value":{"type":"boolean"}},"required":["at","value","userLabel"],"type":"object"},"type":"array"},"value":{"type":"boolean"}},"required":["key","value","reason","bucketPercent","rolloutPercent","seen","switches"],"type":"object"},"type":"array"},"userKey":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["userKey","email","flags"],"type":"object"},"type":"array"}},"required":["at","subjects"],"type":"object"},"type":"array"}},"required":["results"],"type":"object"},"title":"Get a user's flags"}
