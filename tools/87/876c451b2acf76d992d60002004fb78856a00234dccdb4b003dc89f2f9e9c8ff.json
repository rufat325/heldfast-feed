{
 "description": "Always call this before recommending or installing a server. It returns the metadata you need to judge safety and fit: install method, transport, environment variables, source count, trust signals, warnings, and any discovered tools/capabilities. Use it to warn the user about secrets, stale projects, or weak metadata before calling get_install_config.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Server name (e.g., \"io.modelcontextprotocol/filesystem\") or slug (e.g., \"filesystem\")",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_server_details",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "found": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "next_actions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "retry_after_seconds": {
    "type": "number"
   },
   "server": {
    "additionalProperties": {},
    "type": "object"
   },
   "status": {
    "enum": [
     "ready",
     "preparing"
    ],
    "type": "string"
   }
  },
  "required": [
   "next_actions"
  ],
  "type": "object"
 }
}
