{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one stored source record by UUID, or an editor-reviewed event when kind='event'. Returns up to 6000 characters of stored source text, original URLs, publication status and provenance. It never retrieves arbitrary external URLs.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "kind": {
    "default": "record",
    "enum": [
     "record",
     "event"
    ],
    "type": "string"
   },
   "language": {
    "description": "Optional presentation language. Omit for legacy copy. Source text remains in its original language.",
    "enum": [
     "zh-CN",
     "zh-Hant",
     "en"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_resource",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "coverage_note": {
    "type": "string"
   },
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "interpretation_note": {
    "type": "string"
   },
   "language": {
    "additionalProperties": false,
    "properties": {
     "note": {
      "type": "string"
     },
     "original_records": {
      "const": "preserved",
      "type": "string"
     },
     "presentation_language": {
      "enum": [
       "zh-CN",
       "zh-Hant",
       "en",
       "legacy"
      ],
      "type": "string"
     },
     "requested_language": {
      "anyOf": [
       {
        "enum": [
         "zh-CN",
         "zh-Hant",
         "en"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "requested_language",
     "presentation_language",
     "original_records",
     "note"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "coverage_note",
   "language"
  ],
  "type": "object"
 },
 "title": "Read a BioAI resource"
}
