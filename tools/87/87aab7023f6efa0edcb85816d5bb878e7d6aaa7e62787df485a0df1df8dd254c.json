{
 "description": "Type text into an input. Prefer a 'ref' from aethyn_snapshot; or a 'selector'. Set submit:true to press Enter after.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ref": {
    "type": "string"
   },
   "selector": {
    "type": "string"
   },
   "session_id": {
    "type": "string"
   },
   "submit": {
    "description": "Press Enter after typing.",
    "type": "boolean"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "text"
  ],
  "type": "object"
 },
 "name": "aethyn_type",
 "title": "Type text"
}
