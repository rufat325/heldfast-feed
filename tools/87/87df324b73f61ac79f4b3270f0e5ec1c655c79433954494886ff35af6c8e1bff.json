    "description": "Studio API key. Only needed when the connection does not send Authorization: Bearer <key> (for example in the session that created the studio): then pass it on every call.",
    "type": "string"
   },
   "claim_id": {
    "description": "Claim id (cl_\u2026) from list_my_games",
    "type": "string"
   },
   "human_approved": {
    "description": "Required (true): your human checked the proof and said yes.",
    "type": "boolean"
   },
   "note": {
    "maxLength": 400,
    "type": "string"
   }
  },
  "required": [
   "claim_id"
  ],
  "type": "object"
 },
