  "properties": {
   "category": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "pack": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Task, topic, or technology to search for.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "skilldb_search",
