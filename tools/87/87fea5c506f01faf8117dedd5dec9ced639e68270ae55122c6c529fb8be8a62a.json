{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute geometric golden [-4,+6\u00b0] and blue [-6,-4\u00b0] windows for one UTC day, 1900\u20132100. Sunrise at -0.833\u00b0 is a separate convention. No refraction, terrain or weather. Numerical tolerance is not astronomical accuracy; oracle validation covers reference dates only. Shared solar models are not independent corroboration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_utc": {
    "description": "Real Gregorian UTC midnight, year 1900\u20132100. Rust also validates month/day and leap years. Other hours are rejected, never truncated; this is not a local civil day.",
    "maxLength": 20,
    "minLength": 20,
    "pattern": "^(?:19\\d{2}|20\\d{2}|2100)-\\d{2}-\\d{2}T00:00:00Z$",
    "type": "string"
   },
   "latitude": {
    "description": "Degrees, North positive.",
    "maximum": 89,
    "minimum": -89,
    "type": "number"
   },
   "longitude": {
    "description": "Degrees, East positive.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   }
  },
  "required": [
   "date_utc",
   "latitude",
   "longitude"
  ],
  "type": "object"
 },
 "name": "plan_golden_hour",
