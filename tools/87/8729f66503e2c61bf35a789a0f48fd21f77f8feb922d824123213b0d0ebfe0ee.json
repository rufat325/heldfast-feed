{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "$0.01 per call. Pay with x402 (USDC on Base) in _meta[\"x402/payment\"]; MPP (tempo) on the HTTP URL /v1/drive. Driving time/distance between two named places.",
 "inputSchema": {
  "properties": {
   "destination": {
    "examples": [
     "Hilton Downtown Orlando"
    ],
    "maxLength": 200,
    "minLength": 1,
    "title": "Destination",
    "type": "string"
   },
   "near": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Disambiguation hint, e.g. 'Orlando, FL'",
    "title": "Near"
   },
   "origin": {
    "examples": [
     "MCO"
    ],
    "maxLength": 200,
    "minLength": 1,
    "title": "Origin",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "title": "DriveRequest",
  "type": "object"
 },
 "name": "drive_time",
 "outputSchema": {
  "$defs": {
   "PlaceOut": {
    "properties": {
     "confidence": {
      "title": "Confidence",
      "type": "number"
     },
     "kind": {
      "title": "Kind",
      "type": "string"
     },
     "lat": {
      "title": "Lat",
      "type": "number"
     },
     "lon": {
      "title": "Lon",
      "type": "number"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "source": {
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "name",
     "lat",
     "lon",
     "kind",
     "source",
     "confidence"
    ],
    "title": "PlaceOut",
    "type": "object"
   }
  },
  "properties": {
   "attribution": {
    "title": "Attribution",
    "type": "string"
   },
   "destination": {
    "$ref": "#/$defs/PlaceOut"
   },
   "distance_m": {
    "title": "Distance M",
    "type": "integer"
   },
   "duration_s": {
    "title": "Duration S",
    "type": "integer"
   },
   "estimated": {
    "description": "true = straight-line fallback, not a road route",
    "title": "Estimated",
    "type": "boolean"
   },
   "miles": {
    "title": "Miles",
    "type": "number"
   },
   "minutes": {
    "title": "Minutes",
    "type": "number"
   },
   "origin": {
    "$ref": "#/$defs/PlaceOut"
   }
  },
  "required": [
   "origin",
   "destination",
   "distance_m",
   "duration_s",
   "miles",
   "minutes",
   "estimated",
   "attribution"
  ],
  "title": "DriveResponse",
  "type": "object"
 }
}
