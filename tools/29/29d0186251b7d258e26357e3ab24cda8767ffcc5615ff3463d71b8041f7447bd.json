{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Calculate structured natal aspects between chart bodies using GetBirthChart's calculation methodology. Returns factual aspect data without interpretation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "additional_points": {
    "items": {
     "enum": [
      "mean_lilith",
      "true_lilith",
      "osculating_lilith",
      "part_of_fortune",
      "vertex"
     ],
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "altitude_m": {
    "type": "number"
   },
   "aspect_preset": {
    "enum": [
     "standard",
     "extended",
     "custom",
     "modern-major-v1"
    ],
    "type": "string"
   },
   "ayanamsa": {
    "enum": [
     "lahiri",
     "true_citra",
     "fagan_bradley",
     "krishnamurti",
     "raman"
    ],
    "type": "string"
   },
   "custom_aspect_rules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "exact_angle": {
       "maximum": 180,
       "minimum": 0,
       "type": "number"
      },
      "orb": {
       "maximum": 15,
       "minimum": 0,
       "type": "number"
      },
      "type": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "type",
      "exact_angle",
      "orb"
     ],
     "type": "object"
    },
    "maxItems": 64,
    "type": "array"
   },
   "date": {
    "description": "Local civil birth date in YYYY-MM-DD format.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "fold": {
    "enum": [
     0,
     1
    ],
    "type": "number"
   },
   "house_system": {
    "enum": [
     "placidus",
     "koch",
     "porphyry",
     "campanus",
     "regiomontanus",
     "alcabitius",
     "topocentric",
     "morinus",
     "meridian",
     "whole_sign",
     "equal"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "node_type": {
    "enum": [
     "true",
     "mean"
    ],
    "type": "string"
   },
   "place": {
    "description": "Optional caller-side place label; it is not geocoded.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "time": {
    "description": "Local clock time in HH:mm or HH:mm:ss format.",
    "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone identifier, such as America/New_York.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "unknown_time": {
    "description": "Set true when no reliable birth time is available.",
    "type": "boolean"
   },
   "zodiac": {
    "enum": [
     "tropical",
     "sidereal"
    ],
    "type": "string"
   }
  },
  "required": [
   "date",
   "latitude",
   "longitude",
   "timezone"
  ],
  "type": "object"
 },
 "name": "calculate_aspects",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {},
  "type": "object"
 }
}
