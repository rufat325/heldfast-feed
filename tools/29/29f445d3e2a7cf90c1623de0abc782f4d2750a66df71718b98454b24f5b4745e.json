{
 "description": "Create a same-chain token swap transaction via deBridge",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "affiliateFeePercent": {
    "description": "Affiliate fee percentage",
    "type": "number"
   },
   "affiliateFeeRecipient": {
    "description": "Wallet address to receive affiliate fees",
    "type": "string"
   },
   "chainId": {
    "description": "Chain ID (native or deBridge internal)",
    "type": "string"
   },
   "senderAddress": {
    "description": "Transaction submitter address",
    "type": "string"
   },
   "slippage": {
    "description": "Slippage tolerance or 'auto'",
    "type": "string"
   },
   "srcChainPriorityLevel": {
    "description": "Priority level: 'normal' or 'aggressive' (default: 'normal')",
    "type": "string"
   },
   "tokenIn": {
    "description": "Input token address",
    "type": "string"
   },
   "tokenInAmount": {
    "description": "Amount in smallest units",
    "type": "string"
   },
   "tokenOut": {
    "description": "Output token address",
    "type": "string"
   },
   "tokenOutAmount": {
    "description": "Expected output amount or 'auto'",
    "type": "string"
   },
   "tokenOutRecipient": {
    "description": "Address on the source chain to receive target tokens",
    "type": "string"
   }
  },
  "required": [
   "chainId",
   "tokenIn",
   "tokenInAmount",
   "tokenOut",
   "tokenOutRecipient"
  ],
  "type": "object"
 },
 "name": "transaction_same_chain_swap"
}
