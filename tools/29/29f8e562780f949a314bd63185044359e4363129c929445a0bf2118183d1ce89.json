{"description":"Set or clear DNSSEC for a domain. Provide either a DS record (key_tag, digest_type, digest, algorithm) or a DNSKEY (flags, public_key, algorithm). To disable, set clear to true without key fields.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"algorithm":{"description":"DNSSEC algorithm number (e.g., '13' for ECDSAP256SHA256)","enum":["1","2","3","4","5","6","7","8","10","12","13","14","15","16","252","253","254"],"type":"string"},"clear":{"description":"Set to true to remove DNSSEC from the domain","type":"boolean"},"digest":{"description":"DS digest in hexadecimal","pattern":"^[0-9a-fA-F]+$","type":"string"},"digest_type":{"description":"DS digest type: 1=SHA-1, 2=SHA-256, 3=GOST, 4=SHA-384","enum":["1","2","3","4"],"type":"string"},"domain":{"description":"Domain name to configure DNSSEC for","type":"string"},"flags":{"description":"DNSSEC flags (e.g., '257' for KSK)","enum":["256","257"],"type":"string"},"key_tag":{"description":"DS key tag (0-65535)","pattern":"^\\d+$","type":"string"},"public_key":{"description":"DNSSEC public key","minLength":1,"pattern":"^[A-Za-z0-9+/]+={0,2}$","type":"string"}},"required":["domain"],"type":"object"},"name":"set_dnssec"}
