  "readOnlyHint": false,
  "title": "Set up a powder alert"
 },
 "description": "Set a standing powder alert up for the person you are talking to, using\n    an email address THEY gave you: we email them when that mountain is\n    forecast a real dump.\n\n    Ask them for the address in their own words first, and only pass it here if\n    they say yes to being emailed. We then confirm it ourselves \u2014 nothing at\n    all is created until they open the link in that mail. If the address was\n    wrong, or they did not really want it, they ignore one email and no watch,\n    no account and no record of them exists.\n\n    `cm` is the bar worth waking up for (5-100; the house bar is 20 cm in three\n    days at the summit). Use `watch_resort` instead when you would rather hand\n    them a link than ask for an address \u2014 both end in the same place.",
 "inputSchema": {
  "properties": {
   "cm": {
    "default": 0,
    "title": "Cm",
    "type": "integer"
   },
   "email": {
    "title": "Email",
    "type": "string"
   },
   "lang": {
    "default": "en",
    "title": "Lang",
    "type": "string"
   },
   "resort": {
    "title": "Resort",
    "type": "string"
   }
  },
  "required": [
   "resort",
   "email"
  ],
