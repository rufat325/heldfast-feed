          "in": "path",
          "name": "id",
          "schema": {
           "type": "string"
          }
         }
        ],
        "responses": {
         "200": {
          "content": {
           "application/json": {
            "schema": {
             "$ref": "#/components/schemas/Order"
            }
           }
          },
          "description": "The order"
         },
         "404": {
          "description": "Not found"
         }
        },
        "summary": "Fetch one order"
       }
      }
