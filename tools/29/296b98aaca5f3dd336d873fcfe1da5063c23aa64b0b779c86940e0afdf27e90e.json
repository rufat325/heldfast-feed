             },
             "type": "array"
            }
           }
          },
          "description": "A page of orders"
         },
         "429": {
          "description": "Rate limited"
         }
        },
        "summary": "List orders"
       },
       "parameters": [
        {
         "in": "query",
         "name": "page",
         "schema": {
          "minimum": 1,
          "type": "integer"
         }
        }
