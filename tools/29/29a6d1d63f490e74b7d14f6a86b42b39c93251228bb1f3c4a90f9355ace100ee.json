{
 "description": "Submit feedback on a memory's relevance. Helps improve future recall quality.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "feedback": {
    "description": "Whether the memory was relevant/helpful",
    "enum": [
     "positive",
     "negative"
    ],
    "type": "string"
   },
   "memory_id": {
    "description": "The UUID of the memory to rate",
    "type": "string"
   },
   "reason": {
    "description": "Optional reason for the feedback",
    "type": "string"
   },
   "volume_id": {
    "description": "Volume ID. Uses default if not set.",
    "type": "string"
   }
  },
  "required": [
   "memory_id",
   "feedback"
  ],
  "type": "object"
 },
 "name": "feedback"
}
