{
 "description": "Get candlestick/OHLCV data for a trading pair",
 "inputSchema": {
  "properties": {
   "from": {
    "description": "Start timestamp (ISO 8601)",
    "type": "string"
   },
   "limit": {
    "description": "Number of candles",
    "type": "number"
   },
   "resolution": {
    "description": "Candle resolution",
    "enum": [
     "1m",
     "5m",
     "15m",
     "30m",
     "1h",
     "4h",
     "1d",
     "1w"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Trading pair symbol (e.g. BTC-BRL)",
    "type": "string"
   },
   "to": {
    "description": "End timestamp (ISO 8601)",
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "resolution"
  ],
  "type": "object"
 },
 "name": "get_candles"
}
