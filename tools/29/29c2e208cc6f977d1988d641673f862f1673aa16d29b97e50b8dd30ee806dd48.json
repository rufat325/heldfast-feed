    "description": "Numeric record id to delete.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "zone": {
    "description": "Zone name, e.g. example.com.",
    "type": "string"
   }
  },
  "required": [
   "zone",
   "record"
  ],
  "type": "object"
 },
 "name": "dnsimple_delete_zone_record",
 "title": "Delete a zone record"
}
