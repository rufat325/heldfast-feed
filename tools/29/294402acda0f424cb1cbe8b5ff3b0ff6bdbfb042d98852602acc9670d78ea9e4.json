{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "doctor.use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Persist an app consult quote for text in the owned threadId at its current sequence, with optional responseStyle learning/technical/roast for this reply. Omit for the account default. Returns the allowance quote without starting a reply. Show the quote before requesting a start. Keep the caller-generated commandKey (16-120 characters) stable for this action and all retries. Action and version are fixed by this tool; do not supply them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "commandKey": {
    "maxLength": 120,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "responseStyle": {
    "enum": [
     "learning",
     "technical",
     "roast"
    ],
    "type": "string"
   },
   "sequence": {
    "maximum": 1998,
    "minimum": 0,
    "type": "integer"
   },
   "text": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "threadId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "commandKey",
   "threadId",
   "sequence",
   "text"
  ],
  "type": "object"
 },
 "name": "quote_doctor_reply",
 "securitySchemes": [
  {
   "scopes": [
    "doctor.use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Quote Doctor reply"
}
