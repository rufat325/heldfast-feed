{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Inspect .bpc"
 },
 "description": "Parse a .bpc source and return a structured summary: chartType, scenes, data (rowCount, entryCount, labels, seriesNames, multiSeries), annotation/colorize/highlight/area-fill presence flags, series count.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "source": {
    "description": "The .bpc chart source to parse and summarize.",
    "type": "string"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "name": "inspect_dsl",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "chartType": {
    "description": "Declared chart type.",
    "type": "string"
   },
   "data": {
    "additionalProperties": false,
    "description": "Summary of the data block.",
    "properties": {
     "entryCount": {
      "description": "Total data-block entries (rows plus directives like series).",
      "type": "integer"
     },
     "labels": {
      "description": "Row labels in source order.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "multiSeries": {
      "description": "True when the data declares multiple series.",
      "type": "boolean"
     },
     "rowCount": {
      "description": "Number of data rows.",
      "type": "integer"
     },
     "seriesNames": {
      "description": "Series names for multi-series charts.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "rowCount",
     "entryCount",
     "labels",
     "seriesNames",
     "multiSeries"
    ],
    "type": "object"
   },
   "hasAnnotations": {
    "description": "Whether any annotation/range/note is present.",
    "type": "boolean"
   },
   "hasAreaFills": {
    "description": "Whether any area-fill is present.",
    "type": "boolean"
   },
   "hasColorizes": {
    "description": "Whether any non-highlight colorize is present.",
    "type": "boolean"
   },
   "hasHighlights": {
    "description": "Whether any highlight is present.",
    "type": "boolean"
   },
   "scenes": {
    "description": "Per-scene summaries, base chart first (always at least one).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "hasTransition": {
       "description": "Whether the scene defines transforms.",
       "type": "boolean"
      },
      "index": {
       "description": "Scene number, matching the editor player: scene 1 is the base chart.",
       "type": "integer"
      },
      "name": {
       "description": "Scene name, if named.",
       "type": "string"
      }
     },
     "required": [
      "index",
      "hasTransition"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "seriesCount": {
    "description": "Number of series.",
    "type": "integer"
   }
  },
  "required": [
   "chartType",
   "scenes",
   "data",
   "hasAnnotations",
   "hasColorizes",
   "hasHighlights",
   "hasAreaFills",
   "seriesCount"
  ],
  "type": "object"
 }
}
