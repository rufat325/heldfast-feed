        "null"
       ]
      },
      "emails": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "googleProfileClaimed": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "phone": {
       "type": [
        "string",
        "null"
       ]
      },
      "phones": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "rating": {
       "type": [
        "number",
