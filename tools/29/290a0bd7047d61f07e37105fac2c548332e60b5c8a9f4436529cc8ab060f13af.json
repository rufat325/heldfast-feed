        "chatgpt": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "googleAds": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "googleAnalytics": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "meta": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "tiktok": {
         "type": [
          "boolean",
          "null"
         ]
        }
       },
       "required": [
        "meta",
        "googleAds",
        "googleAnalytics",
        "tiktok",
        "chatgpt"
       ],
       "type": "object"
      },
      "address": {
       "type": [
        "string",
        "null"
       ]
      },
      "businessId": {
       "type": "string"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "city": {
