{
 "description": "Retrieve the recent check-in activity feed for a specific Untappd user",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Number of results (max 25, default 25)",
    "maximum": 25,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "max_id": {
    "description": "Return results older than this checkin ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "min_id": {
    "description": "Return only checkins newer than this ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "username": {
    "description": "Untappd username",
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "get_user_activity"
}
