{
 "description": "List files and directories on the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "details": {
    "default": false,
    "description": "Show detailed listing (ls -la)",
    "type": "boolean"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "path": {
    "default": "/sdcard",
    "description": "Directory path on device",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "adb_ls"
}
