{
 "description": "Create a persistent Glamour project from a reference screenshot and target URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "browserSettings": {
    "properties": {
     "colorScheme": {
      "default": "light",
      "enum": [
       "light",
       "dark",
       "no-preference"
      ],
      "type": "string"
     },
     "disableAnimations": {
      "default": true,
      "type": "boolean"
     },
     "fixedTime": {
      "default": "2024-01-01T00:00:00.000Z",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     "locale": {
      "default": "en-US",
      "type": "string"
     },
     "maskSelectors": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "randomSeed": {
      "default": 1,
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "readinessPredicate": {
      "type": "string"
     },
     "readySelector": {
      "type": "string"
     },
     "timeoutMs": {
      "default": 30000,
      "exclusiveMinimum": 0,
      "maximum": 120000,
      "type": "integer"
     },
     "timezoneId": {
      "default": "UTC",
      "type": "string"
     },
     "waitUntil": {
      "default": "networkidle",
      "enum": [
       "load",
       "domcontentloaded",
       "networkidle"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "name": {
    "default": "glamour-project",
    "minLength": 1,
    "type": "string"
   },
   "referenceBundlePath": {
    "type": "string"
   },
   "referencePath": {
    "type": "string"
   },
   "targetConfig": {
    "properties": {
     "buildCommand": {
      "type": "string"
     },
     "designTokens": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "devCommand": {
      "type": "string"
     },
     "framework": {
      "type": "string"
     },
     "repositoryRoot": {
      "type": "string"
     },
     "route": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "targetUrl": {
    "format": "uri",
    "type": "string"
   },
   "viewport": {
    "properties": {
     "deviceScaleFactor": {
      "default": 1,
      "exclusiveMinimum": 0,
      "maximum": 4,
      "type": "number"
     },
     "height": {
      "exclusiveMinimum": 0,
      "maximum": 16384,
      "type": "integer"
     },
     "width": {
      "exclusiveMinimum": 0,
      "maximum": 16384,
      "type": "integer"
     }
    },
    "required": [
     "width",
     "height"
    ],
    "type": "object"
   }
  },
  "required": [
   "targetUrl"
  ],
  "type": "object"
 },
 "name": "visual.create_project"
}
