{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Calendar Availability"
 },
 "description": "Compute open meeting slots for one mailbox from its own calendar. Single-mailbox only; not a cross-user free/busy lookup.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buffer": {
    "maximum": 240,
    "minimum": 0,
    "type": "integer"
   },
   "days": {
    "description": "Weekdays offered, 0=Sunday..6=Saturday (default Mon-Fri).",
    "items": {
     "maximum": 6,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 7,
    "type": "array"
   },
   "duration": {
    "default": 30,
    "description": "Meeting length in minutes.",
    "maximum": 480,
    "minimum": 5,
    "type": "integer"
   },
   "from": {
    "description": "Start of the range (UTC instant).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "interval": {
    "description": "Step between slot starts.",
    "maximum": 480,
    "minimum": 5,
    "type": "integer"
   },
   "mailbox": {
    "description": "The mailbox (calendar owner) address.",
    "maxLength": 508,
    "type": "string"
   },
   "minimum_notice": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "timezone": {
    "description": "Zone the window is defined in (default UTC).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "End of the range (UTC instant).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "window_end": {
    "description": "Minutes from midnight.",
    "maximum": 1440,
    "minimum": 0,
    "type": "integer"
   },
   "window_start": {
    "description": "Minutes from midnight.",
    "maximum": 1440,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "mailbox",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "shipmail_get_calendar_availability",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "availability": {
    "properties": {
     "duration_minutes": {
      "type": "number"
     },
     "from": {
      "type": "string"
     },
     "mailbox": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "slots": {
      "items": {
       "properties": {
        "end": {
         "type": "string"
        },
        "start": {
         "type": "string"
        }
       },
       "required": [
        "start",
        "end"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "timezone": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "object",
     "mailbox",
     "from",
     "to",
     "duration_minutes",
     "timezone",
     "slots"
    ],
    "type": "object"
   }
  },
  "required": [
   "availability"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Get Calendar Availability"
}
