{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns a ready-to-open link to a free MusoKit tool, preset where possible: a tuner for a specific instrument or tuning, a metronome at a tempo, a tone at a frequency, etc. Use when the user needs to actually tune, keep time or hear something.",
 "inputSchema": {
  "properties": {
   "beats": {
    "description": "Beats per bar (metronome only).",
    "type": "integer"
   },
   "bpm": {
    "description": "Tempo (metronome only).",
    "type": "number"
   },
   "frequency": {
    "description": "Frequency in Hz (tone-generator only).",
    "type": "number"
   },
   "instrument": {
    "description": "Tuner preset (tuner only).",
    "enum": [
     "guitar-std",
     "guitar-dropd",
     "guitar-halfdown",
     "open-g",
     "open-d",
     "dadgad",
     "bass-std",
     "bass-5",
     "ukulele",
     "violin",
     "mandolin",
     "cello",
     "chromatic"
    ],
    "type": "string"
   },
   "tool": {
    "enum": [
     "tuner",
     "metronome",
     "drum-machine",
     "tone-generator",
     "chord-finder",
     "scale-explorer",
     "circle-of-fifths",
     "capo-calculator",
     "transpose",
     "chord-progression-generator",
     "chord-player",
     "ear-trainer",
     "rhythm-trainer",
     "speed-trainer",
     "bpm-to-ms"
    ],
    "type": "string"
   }
  },
  "required": [
   "tool"
  ],
  "type": "object"
 },
 "name": "open_music_tool",
 "title": "Link to a music tool"
}
