 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a value rule set"
 },
 "description": "Create a value rule set. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_create_value_rule_set.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "type": "object"
   },
   "payload": {
    "properties": {
     "name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "rules": {
      "description": "Evaluated in order; the first matching rule wins.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "adjustSign": {
         "description": "Direction of the adjustment. There is no signed value field.",
         "enum": [
          "INCREASE",
          "DECREASE"
         ],
         "type": "string"
        },
        "adjustValue": {
         "maximum": 1000,
         "minimum": 1,
         "type": "integer"
        },
        "criteria": {
         "description": "All criteria on a rule must match for the rule to fire.",
         "items": {
          "additionalProperties": false,
          "properties": {
           "criteriaType": {
            "enum": [
             "AGE",
             "GENDER",
             "OS_TYPE",
             "DEVICE_PLATFORM",
             "LOCATION",
             "PLACEMENT",
             "OMNI_CHANNEL",
             "AUDIENCE_LABEL"
            ],
            "type": "string"
           },
           "criteriaValueTypes": {
            "items": {
             "type": "string"
            },
            "minItems": 1,
            "type": "array"
           },
           "criteriaValues": {
            "items": {
             "type": "string"
            },
            "minItems": 1,
            "type": "array"
           },
           "id": {
            "type": "string"
           },
           "operator": {
            "const": "CONTAINS",
            "type": "string"
           }
          },
          "required": [
           "criteriaType",
           "operator",
           "criteriaValues",
           "criteriaValueTypes"
          ],
          "type": "object"
         },
         "maxItems": 4,
         "minItems": 1,
         "type": "array"
        },
        "id": {
         "type": "string"
        },
        "name": {
         "maxLength": 255,
         "minLength": 1,
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "adjustSign",
        "adjustValue",
        "criteria"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "name",
     "rules"
    ],
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_create_value_rule_set",
 "title": "Create a value rule set"
}
