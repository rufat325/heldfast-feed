{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List cached queries domain was cited for"
 },
 "description": "List queries that the given domain has been cited for, served from the local cache. Build up a corpus by calling check_citations or am_i_cited first; cited_for queries it without spending API budget.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain to look up, e.g. 'automatelab.tech'.",
    "minLength": 1,
    "type": "string"
   },
   "engine": {
    "description": "Filter by engine. Omit to include all.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum results.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "ISO date floor, e.g. '2026-01-01'. Only return entries fetched on or after this date.",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "domain_cited_for",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain that was looked up.",
    "type": "string"
   },
   "engine_filter": {
    "description": "Engine filter applied, if any.",
    "type": "string"
   },
   "results": {
    "description": "Cache entries where this domain was cited.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "engine": {
       "type": "string"
      },
      "fetched_at": {
       "type": "string"
      },
      "query": {
       "type": "string"
      },
      "rank": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "query",
      "engine",
      "rank",
      "url",
      "fetched_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "since": {
    "description": "ISO date floor applied, if any.",
    "type": "string"
   },
   "source": {
    "const": "local_cache",
    "description": "Always 'local_cache' \u2014 no external calls made.",
    "type": "string"
   },
   "total": {
    "description": "Total entries returned.",
    "type": "number"
   }
  },
  "required": [
   "domain",
   "results",
   "total",
   "source"
  ],
  "type": "object"
 }
}
