{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hairdora:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Look up service prices"
 },
 "description": "Use this when someone asks what their salon charges for a cut, colour, blow-dry or other service, or what services it offers. Returns services with id, name, price and salon for all their salons unless one is given, 50 by default and up to 100. Not for what a particular client had done.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum number of services to return (default 50, maximum 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "salonId": {
    "description": "Only services of this salon, by an id from the user's salon list; every salon when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_services",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "hasMore": {
    "type": "boolean"
   },
   "services": {
    "description": "Services the salon offers, with prices. Internal metadata and organization data are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "price": {
       "description": "Price in the salon's currency",
       "type": [
        "number",
        "null"
       ]
      },
      "salonId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "price",
      "salonId"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "services",
   "count",
   "hasMore"
  ],
  "type": "object"
 },
 "title": "Look up service prices"
}
