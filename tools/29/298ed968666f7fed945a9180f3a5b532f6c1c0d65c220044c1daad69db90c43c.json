{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List infrastructure asset costs"
 },
 "description": "List cost rows for infrastructure features. Filter by feature, work order, category, or cost date range. Amounts are bare numbers with no currency: call get_organization_settings for currency_code before stating one.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Filter by cost category",
    "enum": [
     "Repair",
     "PM",
     "Operation",
     "Replacement",
     "Decommission"
    ],
    "type": "string"
   },
   "cost_date_from": {
    "description": "Costs on/after this date (YYYY-MM-DD)",
    "type": "string"
   },
   "cost_date_to": {
    "description": "Costs on/before this date (YYYY-MM-DD)",
    "type": "string"
   },
   "feature_id": {
    "description": "Filter by infrastructure feature ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "page": {
    "description": "Page number (default: all pages fetched automatically)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default: 1000, max: 1000). All pages are fetched automatically.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "work_order_id": {
    "description": "Filter by work order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_infrastructure_asset_costs",
 "title": "List infrastructure asset costs"
}
