{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Show revision history for a single ticket. Provide title or id. For project-wide history, use project_history instead.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Ticket numeric ID (provide title or id)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Maximum number of revisions to return (oldest first)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Number of revisions to skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "title": {
    "description": "Ticket title (provide title or id)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ticket_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefit": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "estimate": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "penalty": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "revised_at": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "risk": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "tags": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "prefix": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "prefix",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "ticket_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "ticket_id",
      "title",
      "description",
      "benefit",
      "penalty",
      "estimate",
      "risk",
      "tags",
      "revised_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
