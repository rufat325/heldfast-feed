{
 "description": "Create a new test suite for CI grouping. Suites can contain test cases and test scenarios.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "default": "",
    "description": "Suite description",
    "type": "string"
   },
   "environmentId": {
    "description": "Default environment ID for running tests",
    "type": "number"
   },
   "folderId": {
    "default": 0,
    "description": "Folder ID (0 for root)",
    "type": "number"
   },
   "name": {
    "description": "Suite name",
    "type": "string"
   },
   "ordering": {
    "default": 0,
    "description": "Sort order",
    "type": "number"
   },
   "priority": {
    "default": 2,
    "description": "Priority (1=high, 2=medium, 3=low)",
    "type": "number"
   },
   "runnerId": {
    "default": 0,
    "description": "Default runner ID",
    "type": "number"
   },
   "tags": {
    "default": [],
    "description": "Tag names",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_test_suite"
}
