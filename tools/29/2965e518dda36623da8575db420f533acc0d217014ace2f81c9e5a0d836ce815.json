{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check for unread recruiter mail"
 },
 "description": "Returns unread recruiter-message and thread counts, oldest unread time and recent message previews with thread, company, role and kind. Reading does not mark messages read. Previews contain third-party email content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_unread_reminders",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "messages": {
    "description": "The newest unread messages, at most ten.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "type": "string"
      },
      "jobTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "anyOf": [
        {
         "enum": [
          "rejection",
          "interview",
          "recruiter_reply",
          "ats_confirmation",
          "other"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "messageId": {
       "type": "string"
      },
      "preview": {
       "type": "string"
      },
      "receivedAt": {
       "type": "string"
      },
      "threadId": {
       "type": "string"
      }
     },
     "required": [
      "threadId",
      "messageId",
      "company",
      "jobTitle",
      "kind",
      "receivedAt",
      "preview"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "oldestUnreadAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "unreadMessages": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "unreadThreads": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "unreadMessages",
   "unreadThreads",
   "oldestUnreadAt",
   "messages"
  ],
  "type": "object"
 },
 "title": "Check for unread recruiter mail"
}
