{
 "description": "Govern an x402 (HTTP-402) machine payment BEFORE paying. Pass the agentId + the 402 challenge's `accepts` array; Countersign picks the cheapest option, evaluates it against policy, and returns allow / deny / needs_approval. Only pay if it returns allow \u2014 a rogue or over-budget agent never pays.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accepts": {
    "description": "the `accepts` array from the 402 Payment Required body",
    "items": {
     "additionalProperties": {},
     "properties": {
      "asset": {
       "type": "string"
      },
      "extra": {
       "additionalProperties": {},
       "properties": {
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxAmountRequired": {
       "description": "atomic units",
       "type": "string"
      },
      "network": {
       "description": "CAIP-2 (eip155:84532) or venue name",
       "type": "string"
      },
      "payTo": {
       "type": "string"
      }
     },
     "required": [
      "network",
      "maxAmountRequired",
      "payTo"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "agentId": {
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "accepts"
  ],
  "type": "object"
 },
 "name": "countersign_guard_x402"
}
