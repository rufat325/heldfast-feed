{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Paid (1 credit). Relight a finished interior visualization as day, evening or night, with lamps on or off, keeping the wall colour. Needs project_id and the color_key returned by visualize_room.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "color_key": {
    "description": "color_key of the painted result, e.g. \"c1\"",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "lamps": {
    "default": false,
    "description": "Lamps on",
    "type": "boolean"
   },
   "project_id": {
    "description": "project_id from visualize_room",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "time": {
    "description": "Time of day",
    "enum": [
     "day",
     "evening",
     "night"
    ],
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "color_key",
   "time"
  ],
  "type": "object"
 },
 "name": "relight_room",
 "title": "Change the time of day"
}
