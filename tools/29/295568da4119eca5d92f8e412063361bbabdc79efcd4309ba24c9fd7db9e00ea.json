{
 "description": "Suggest trading strategies matching your risk profile. Filters by risk tolerance, max drawdown, preferred assets, and minimum Sharpe ratio.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxDrawdown": {
    "description": "Maximum acceptable drawdown % (e.g. 15)",
    "type": "number"
   },
   "minSharpe": {
    "description": "Minimum Sharpe ratio",
    "type": "number"
   },
   "preferredAssets": {
    "description": "Preferred assets like ['BTC', 'ETH']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "riskTolerance": {
    "default": "moderate",
    "description": "Risk tolerance level",
    "enum": [
     "conservative",
     "moderate",
     "aggressive"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "suggest_strategies"
}
