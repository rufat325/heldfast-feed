  "additionalProperties": false,
  "properties": {
   "clientName": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "currency": {
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "projectTitle": {
    "$ref": "#/properties/clientName"
   },
   "reference": {
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "clientName",
   "projectTitle",
   "reference",
   "currency"
  ],
  "type": "object"
 },
 "name": "start_schedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "start schedule"
}
