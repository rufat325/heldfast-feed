{
 "description": "Flag (star) or unflag an email.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Which configured account the email belongs to.",
    "type": "string"
   },
   "flagged": {
    "description": "true to flag/star, false to remove the flag.",
    "type": "boolean"
   },
   "id": {
    "description": "The email id.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "flagged"
  ],
  "type": "object"
 },
 "name": "flag_email"
}
