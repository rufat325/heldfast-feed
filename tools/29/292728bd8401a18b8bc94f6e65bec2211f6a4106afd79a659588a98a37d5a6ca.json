{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks about one model's size, architecture, context window or licence. Needs a model id from search_catalog. Returns total and active parameters, weight size per quantisation, context length, licence, release date and sources. It does not say whether the model fits any machine; use check_hardware_fit for that.",
 "inputSchema": {
  "properties": {
   "model_id": {
    "description": "Model id from search_catalog.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-z0-9][a-z0-9._-]*$",
    "type": "string"
   }
  },
  "required": [
   "model_id"
  ],
  "type": "object"
 },
 "name": "get_model_specs",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data_as_of": {
    "description": "Date the bundled catalogue was last updated. Not the time of this call.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "active_params_b": {
      "description": "Parameters read per token in billions. Equals total for dense models. Sets speed, never memory.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "context_length": {
      "anyOf": [
       {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "The model's default context window in tokens."
     },
     "family": {
      "maxLength": 120,
      "type": "string"
     },
     "id": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "type": "string"
     },
     "is_moe": {
      "type": "boolean"
     },
     "license": {
      "anyOf": [
       {
        "maxLength": 80,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "release_date": {
      "anyOf": [
       {
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "status": {
      "enum": [
       "current",
       "legacy",
       "deprecated"
      ],
      "type": "string"
     },
     "total_params_b": {
      "description": "Total parameters in billions. Sets memory residency.",
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "id",
     "name",
     "total_params_b",
     "active_params_b",
     "is_moe",
     "family",
     "context_length",
     "license",
     "release_date",
     "status"
    ],
    "type": "object"
   },
   "quantisations": {
    "description": "Weight size per quantisation. Excludes KV cache and overhead, which depend on context length.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bits_per_weight": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "confidence": {
       "enum": [
        "measured",
        "estimated",
        "community"
       ],
       "type": "string"
      },
      "quantisation": {
       "enum": [
        "Q2_K",
        "Q3_K_M",
        "Q4_K_M",
        "Q5_K_M",
        "Q6_K",
        "Q8_0",
        "F16"
       ],
       "type": "string"
      },
      "weights_gb": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "quantisation",
      "bits_per_weight",
      "weights_gb",
      "confidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "pattern": "^https:\\/\\/",
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "summary": {
    "description": "One or two plain-language sentences stating the answer.",
    "maxLength": 600,
    "type": "string"
   },
   "url": {
    "pattern": "^https:\\/\\/llmconfigurator\\.com\\/en\\/",
    "type": "string"
   }
  },
  "required": [
   "data_as_of",
   "summary",
   "model",
   "quantisations",
   "sources",
   "url"
  ],
  "type": "object"
 },
 "title": "Get a model's specifications"
}
