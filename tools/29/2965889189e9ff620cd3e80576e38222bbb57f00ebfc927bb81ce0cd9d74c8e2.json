{
 "description": "Generate or edit an image. With reference_images routes to Nano Banana 2 (RunPod); without, to GPT Image 2 (PiAPI).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "default": "9:16",
    "enum": [
     "1:1",
     "16:9",
     "9:16",
     "4:3",
     "3:4",
     "3:2",
     "2:3",
     "21:9"
    ],
    "type": "string"
   },
   "count": {
    "default": 1,
    "maximum": 4,
    "minimum": 1,
    "type": "number"
   },
   "enhance_prompt": {
    "default": false,
    "type": "boolean"
   },
   "influencer": {
    "description": "Slug of a saved influencer \u2014 the server attaches its portrait + character sheet as references and prepends its appearance description to the prompt.",
    "type": "string"
   },
   "model": {
    "default": "auto",
    "enum": [
     "auto",
     "nano-banana-2",
     "gpt-image-2"
    ],
    "type": "string"
   },
   "owns_references": {
    "description": "Required true when reference_images are attached (likeness consent).",
    "type": "boolean"
   },
   "prompt": {
    "type": "string"
   },
   "reference_images": {
    "items": {
     "type": "string"
    },
    "maxItems": 14,
    "type": "array"
   },
   "resolution": {
    "default": "1k",
    "enum": [
     "1k",
     "2k",
     "4k"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "make_image",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "credits_charged": {
    "type": "number"
   },
   "run_id": {
    "description": "Poll this id with get_run for status + output URLs.",
    "type": "string"
   }
  },
  "required": [
   "run_id",
   "credits_charged"
  ],
  "type": "object"
 }
}
