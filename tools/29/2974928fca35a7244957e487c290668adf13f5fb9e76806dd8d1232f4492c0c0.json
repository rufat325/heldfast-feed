{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Propose a document"
 },
 "description": "Stages a complete document alternative against an inspected base and creates an offline page for reviewing it. Workspace source changes only after approval.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "by": {
    "description": "The proposal author's display name.",
    "maxLength": 96,
    "minLength": 1,
    "type": "string"
   },
   "context_handle": {
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sha256": {
    "maxLength": 64,
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "text": {
    "maxLength": 26214400,
    "type": "string"
   }
  },
  "required": [
   "document",
   "text",
   "by"
  ],
  "type": "object"
 },
 "name": "document.propose",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "baseRevision": {
    "maxLength": 256,
    "type": "string"
   },
   "bytes": {
    "minimum": 0,
    "type": "integer"
   },
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "exportExpiresAt": {
    "maxLength": 64,
    "type": "string"
   },
   "exportId": {
    "maxLength": 128,
    "type": "string"
   },
   "filename": {
    "maxLength": 256,
    "type": "string"
   },
   "limitBytes": {
    "minimum": 0,
    "type": "integer"
   },
   "mimeType": {
    "maxLength": 64,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "ok",
     "target_gone",
     "conflict",
     "pending",
     "invalid",
     "refused",
     "uncertain",
     "replayed"
    ],
    "type": "string"
   },
   "page": {
    "maxLength": 8192,
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   },
   "sha256": {
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Propose a document"
}
