{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a QR code image (PNG or SVG) for any text or link. Free, no account. The answer carries the image and a permanent image URL you can embed or print.",
 "inputSchema": {
  "properties": {
   "bgcolor": {
    "description": "Background hex, e.g. ffffff",
    "type": "string"
   },
   "color": {
    "description": "Foreground hex, e.g. 1a237e (default 000000)",
    "type": "string"
   },
   "data": {
    "description": "Text or URL to encode (max 2000 chars)",
    "type": "string"
   },
   "ecc": {
    "description": "Error correction (default M)",
    "enum": [
     "L",
     "M",
     "Q",
     "H"
    ],
    "type": "string"
   },
   "format": {
    "description": "Image format (default png)",
    "enum": [
     "png",
     "svg"
    ],
    "type": "string"
   },
   "margin": {
    "description": "Quiet zone in modules (default 4)",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "size": {
    "description": "Pixels (default 300)",
    "maximum": 2000,
    "minimum": 32,
    "type": "integer"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "qr_code",
 "title": "QR code image (free)"
}
