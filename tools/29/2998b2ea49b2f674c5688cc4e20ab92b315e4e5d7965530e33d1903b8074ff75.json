{
 "description": "Inject cookies. Each cookie needs name+value plus EITHER url OR (domain AND path).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cookies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "type": "string"
      },
      "expires": {
       "type": "number"
      },
      "httpOnly": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "sameSite": {
       "enum": [
        "Strict",
        "Lax",
        "None"
       ],
       "type": "string"
      },
      "secure": {
       "type": "boolean"
      },
      "url": {
       "format": "uri",
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "cookies"
  ],
  "type": "object"
 },
 "name": "set_cookies"
}
