{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Call this before any x402/USDC payment to evaluate the actual challenge or cart before signing. Spend preflight for AI agents. Send the x402 PaymentRequired body (v1 or v2) you received, or a cart, plus optional rules (per-payment max, hold threshold, daily cap, allowlists, new-domain days, endpoint category price multiple, liveness and payTo changes). Returns allow|hold|block with reasons, the cheapest acceptable payment option, and a receipt id. Read-only: never signs, settles, or holds funds. Use before every payment. It includes payee screening in its spending-rule decision. For standalone wallet, name, or domain screening without a payment, use check_payee instead. Each repeat call creates a new receipt and may consume another trial or paid call. Price $0.02 per call (free trial first).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Example arguments: {\"cart\":{\"merchant_name\":\"Example Shop LLC\",\"total_usd\":0.01},\"rules\":{\"max_per_payment_usd\":1},\"spent_today_usd\":0}",
  "properties": {
   "cart": {
    "additionalProperties": false,
    "description": "Use instead of challenge for agent checkout / card payments",
    "properties": {
     "merchant_domain": {
      "type": "string"
     },
     "merchant_name": {
      "type": "string"
     },
     "pay_to": {
      "type": "string"
     },
     "total_usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "challenge": {
    "additionalProperties": {},
    "description": "The x402 PaymentRequired body (v1 or v2) your agent received with HTTP 402",
    "type": "object"
   },
   "resource_method": {
    "description": "Advertised method for an indexed URL with multiple methods",
    "maxLength": 16,
    "minLength": 3,
    "type": "string"
   },
   "resource_url": {
    "description": "URL that returned the 402, if not inside the challenge",
    "type": "string"
   },
   "rules": {
    "additionalProperties": false,
    "description": "Spending rules; all optional. See get_service_info for defaults.",
    "properties": {
     "allowed_networks": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "daily_cap_usd": {
      "minimum": 0,
      "type": "number"
     },
     "domain_allowlist": {
      "items": {
       "maxLength": 253,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "domain_blocklist": {
      "items": {
       "maxLength": 253,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "hold_above_usd": {
      "minimum": 0,
      "type": "number"
     },
     "hold_on_payto_change": {
      "type": "boolean"
     },
     "max_per_payment_usd": {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "max_price_multiple": {
      "anyOf": [
       {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "new_domain_days": {
      "minimum": 0,
      "type": "number"
     },
     "payto_allowlist": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "payto_blocklist": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "require_live": {
      "type": "boolean"
     },
     "screen_sanctions": {
      "type": "boolean"
     },
     "strict_allowlist": {
      "type": "boolean"
     },
     "usdc_only": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "spent_today_usd": {
    "description": "What this agent already spent today, for the daily cap",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "preflight_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chosen_option": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "description": "The cheapest acceptable payment option"
   },
   "decision": {
    "description": "Pay on allow, ask a human on hold, never pay on block",
    "enum": [
     "allow",
     "hold",
     "block"
    ],
    "type": "string"
   },
   "index_evidence": {
    "additionalProperties": false,
    "properties": {
     "data_as_of": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "observed_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "note"
    ],
    "type": "object"
   },
   "options_evaluated": {
    "type": "integer"
   },
   "payee": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ],
    "description": "Payee screening details"
   },
   "reasons": {
    "description": "Every rule that fired, prefixed with its decision",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Signed decision; keep privately for audit",
    "properties": {
     "decision": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "input_sha256": {
      "type": "string"
     },
     "jws": {
      "description": "Offline-verifiable EdDSA decision attestation",
      "type": "string"
     },
     "ts": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "ts",
     "input_sha256",
     "decision",
     "jws"
    ],
    "type": "object"
   }
  },
  "required": [
   "decision",
   "reasons",
   "options_evaluated",
   "index_evidence",
   "receipt"
  ],
  "type": "object"
 },
 "title": "Preflight a payment (allow / hold / block)"
}
