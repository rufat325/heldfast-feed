{
 "description": "Manage npm access tokens (list or revoke)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "revoke"
    ],
    "type": "string"
   },
   "otp": {
    "description": "One-time password for 2FA",
    "type": "string"
   },
   "token": {
    "description": "Token ID to revoke (required for revoke)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "token"
}
