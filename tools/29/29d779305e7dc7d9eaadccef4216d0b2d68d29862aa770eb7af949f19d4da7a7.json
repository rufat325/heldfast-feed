{
 "description": "Get dependencies for an AI agent. Returns a list of all registered dependencies or a dependency tree structure showing relationships.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Unique identifier for the agent",
    "type": "string"
   },
   "dependency_type": {
    "description": "Filter by dependency type (optional)",
    "enum": [
     "model",
     "package",
     "tool",
     "service",
     "api",
     "mcp_server"
    ],
    "type": "string"
   },
   "format": {
    "default": "list",
    "description": "Output format: 'list' for flat list, 'tree' for hierarchical view (default: list)",
    "enum": [
     "list",
     "tree"
    ],
    "type": "string"
   },
   "include_unverified": {
    "default": true,
    "description": "Include unverified dependencies (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "tork_supply_chain_deps"
}
