{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Get venue details"},"description":"Everything Festiv knows about one venue: type, neighbourhood (or `nearest_area` when it sits just outside one), address and coordinates, phone, website, weekly opening hours and whether it is open now (`hours_by_programme: true` = no fixed hours: they depend on what's on, and the venue is not closed), price level (price_level_source: type_estimate = estimated from the venue type, not a known price), cuisines, `halal` (present only when a verified halal certificate is on record: authority and valid-to date), `dietary` (menu observations such as 'No pork on this menu' with a provenance note \u2014 not a halal status), `alcohol_served` only when known, amenities, a short description, awards (MICHELIN and others) and press quotes with their sources, reservation and delivery links, the next few events at the venue, and the Festiv page link. Pass the venue name (add the area if the name is common) or a Festiv slug from an earlier result; if the name is not in Festiv the error lists the closest names instead of guessing.","inputSchema":{"properties":{"area":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Neighbourhood or district name, e.g. 'Bangsar', 'KLCC', 'George Town'. A name Festiv does not know is refused, not guessed; a city or region word such as 'Penang' or 'Klang Valley' is read as a city.","title":"Area"},"language":{"default":"en","description":"Reply language for summaries: en, ms (Malay) or zh (Chinese). Venue names stay in their original script.","pattern":"^(en|ms|zh)$","title":"Language","type":"string"},"name":{"description":"Venue name, or a slug / id from an earlier result.","maxLength":200,"title":"Name","type":"string"}},"required":["name"],"title":"get_venueArguments","type":"object"},"name":"get_venue","outputSchema":{"properties":{"about":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"About"},"address":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Address"},"alcohol_served":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Alcohol Served"},"amenities":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Amenities"},"area":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Area"},"awards":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Awards"},"city":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"City"},"cuisines":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Cuisines"},"delivery_urls":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Delivery Urls"},"dietary":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Dietary"},"halal":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Halal"},"hours":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Hours"},"hours_by_programme":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Hours By Programme"},"latitude":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Latitude"},"longitude":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Longitude"},"name":{"title":"Name","type":"string"},"nearest_area":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Nearest Area"},"phone":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Phone"},"photo_count":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Photo Count"},"press":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Press"},"price_level":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Price Level"},"price_level_source":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Price Level Source"},"price_range":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"default":null,"title":"Price Range"},"rating":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Rating"},"rating_count":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Rating Count"},"reservation_partner":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Reservation Partner"},"reservation_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Reservation Url"},"type":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Type"},"upcoming":{"anyOf":[{"items":{"additionalProperties":true,"type":"object"},"type":"array"},{"type":"null"}],"default":null,"title":"Upcoming"},"url":{"title":"Url","type":"string"},"verified_by_owner":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Verified By Owner"},"website":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Website"}},"required":["name","url"],"title":"Venue","type":"object"},"title":"Get venue details"}
