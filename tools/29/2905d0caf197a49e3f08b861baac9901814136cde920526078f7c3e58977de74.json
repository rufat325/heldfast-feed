{
 "description": "Create a receipt (recibo de venta) \u2014 the customer can later self-invoice it from the receipt's folio",
 "inputSchema": {
  "properties": {
   "folio_number": {
    "description": "Optional folio number",
    "type": "number"
   },
   "items": {
    "description": "Receipt line items (same shape as invoice items)",
    "items": {
     "properties": {
      "product": {
       "description": "Product ID or inline product object",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment_form": {
    "description": "SAT payment form code",
    "type": "string"
   },
   "series": {
    "description": "Optional series",
    "type": "string"
   }
  },
  "required": [
   "items",
   "payment_form"
  ],
  "type": "object"
 },
 "name": "create_receipt"
}
