{"description":"Builds a text logo as SVG: a shape with initials (circle, rounded, square, hexagon, diamond, shield) beside or above the name and tagline, or the text alone. Colour presets: forest, ocean, sunset, mono, royal; any colour can be overridden. The text uses common system fonts, so it may look slightly different on other machines.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"background":{"description":"Default transparent","pattern":"^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$","type":"string"},"bold":{"description":"Default true","type":"boolean"},"font":{"description":"Default sans","enum":["sans","rounded","serif","mono","impact"],"type":"string"},"gradient":{"description":"Default true","type":"boolean"},"layout":{"description":"Default stacked","enum":["stacked","inline","text"],"type":"string"},"letterSpacing":{"description":"Percent of the font size (default 0)","maximum":50,"minimum":-10,"type":"number"},"letters":{"description":"Mark inside the shape (default the initials of the name)","maxLength":3,"type":"string"},"markColor":{"pattern":"^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$","type":"string"},"name":{"minLength":1,"type":"string"},"output":{"description":".svg file","type":"string"},"overwrite":{"type":"boolean"},"preset":{"description":"Default forest","enum":["forest","ocean","sunset","mono","royal"],"type":"string"},"shape":{"description":"Default circle","enum":["circle","rounded","square","hexagon","diamond","shield","none"],"type":"string"},"shapeColor":{"pattern":"^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$","type":"string"},"shapeColor2":{"description":"End of the gradient","pattern":"^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$","type":"string"},"tagline":{"type":"string"},"taglineColor":{"pattern":"^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$","type":"string"},"textColor":{"pattern":"^#([0-9a-f]{3,4}|[0-9a-f]{6}|[0-9a-f]{8})$","type":"string"}},"required":["name","output"],"type":"object"},"name":"logo_create","title":"Simple logo as SVG"}
