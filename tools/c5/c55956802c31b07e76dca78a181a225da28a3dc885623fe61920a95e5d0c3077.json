{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a poll configuration. Only provided fields are changed. Set expire to 0 for no expiration, or a unix timestamp to auto-close on that date.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access": {
    "enum": [
     "open",
     "private"
    ],
    "type": "string"
   },
   "allowComment": {
    "type": "boolean"
   },
   "allowMaybe": {
    "type": "boolean"
   },
   "allowProposals": {
    "type": "boolean"
   },
   "anonymous": {
    "type": "boolean"
   },
   "autoReminder": {
    "type": "boolean"
   },
   "description": {
    "type": "string"
   },
   "expire": {
    "description": "Unix timestamp; 0 = no expiration; negative = close immediately",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "hideBookedUp": {
    "type": "boolean"
   },
   "maxVotesPerOption": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "maxVotesPerUser": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pollId": {
    "description": "Poll ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "showResults": {
    "enum": [
     "never",
     "always",
     "closed"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "useNo": {
    "type": "boolean"
   }
  },
  "required": [
   "pollId"
  ],
  "type": "object"
 },
 "name": "update_poll",
 "title": "Update Poll"
}
