{"_meta":{"openai/outputTemplate":"ui://skybuyfly/results.html","openai/toolInvocation/invoked":"Loaded the product's offers","openai/toolInvocation/invoking":"Loading the product's offers\u2026","openai/widgetAccessible":true,"securitySchemes":[{"type":"noauth"}],"ui":{"resourceUri":"ui://skybuyfly/results.html","visibility":["model","app"]}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get a product's airport prices"},"description":"Get one SkyBuyFly product by its product_id: its description and size, every stored offer per airport shop (the shop's own price, the price in the requested currency, when it was observed, a link to the SkyBuyFly deal page) and similar products. Relevant when a traveller wants every airport and shop for one product. The prices are stored observations; this tool does not check them live.","inputSchema":{"properties":{"currency":{"default":"USD","description":"A 3-letter ISO 4217 currency code, e.g. EUR (any case; default USD), that every price is shown in; list_currencies has every one.","pattern":"^[A-Za-z]{3}$","title":"Currency","type":"string"},"product_id":{"description":"A SkyBuyFly product_id exactly as search_products, lookup_barcode or get_featured_products answered it: 32 lowercase hex characters or a dashed UUID.","pattern":"^(?:[0-9a-f]{32}|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$","title":"Product Id","type":"string"}},"required":["product_id"],"title":"get_productArguments","type":"object"},"name":"get_product","outputSchema":{"$defs":{"AirportPrice":{"additionalProperties":false,"description":"A product's price at one airport, in the requested currency.","properties":{"code":{"title":"Code","type":"string"},"name":{"title":"Name","type":"string"},"price":{"$ref":"#/$defs/Money"}},"required":["code","name","price"],"title":"AirportPrice","type":"object"},"Money":{"additionalProperties":false,"description":"An amount in an ISO 4217 currency, rounded to cents.","properties":{"amount":{"title":"Amount","type":"number"},"currency":{"title":"Currency","type":"string"}},"required":["amount","currency"],"title":"Money","type":"object"},"Offer":{"additionalProperties":false,"description":"One shop's offer: at one airport, or a retailer-wide online shop (``scope``), whose airport fields are null.\n\nAn ``online_shop`` offer is a real shop price, never one of a card's ``airports``.","properties":{"airport_code":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Airport Code"},"airport_name":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Airport Name"},"availability":{"anyOf":[{"enum":["in_stock","sold_out_online"],"type":"string"},{"type":"null"}],"title":"Availability"},"city":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"City"},"country":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Country"},"display_price":{"anyOf":[{"$ref":"#/$defs/Money"},{"type":"null"}]},"observed_at":{"description":"ISO 8601 timestamp (UTC)","format":"date-time","title":"Observed At","type":"string"},"price":{"anyOf":[{"$ref":"#/$defs/Money"},{"type":"null"}]},"retailer":{"title":"Retailer","type":"string"},"retailer_domain":{"title":"Retailer Domain","type":"string"},"scope":{"enum":["airport","online_shop"],"title":"Scope","type":"string"},"skybuyfly_url":{"title":"Skybuyfly Url","type":"string"},"source":{"enum":["live","stored"],"title":"Source","type":"string"},"status":{"enum":["live_confirmed","stored","live_check_failed","live_timeout","live_blocked"],"title":"Status","type":"string"}},"required":["airport_code","airport_name","city","country","scope","retailer","retailer_domain","price","display_price","availability","observed_at","source","status","skybuyfly_url"],"title":"Offer","type":"object"},"ProductCard":{"additionalProperties":false,"description":"One product with its price at every airport that sells it (cheapest first).\n\n``lowest_price``/``highest_price`` span every comparable shop price, online shops included\n(``lowest_price_scope`` says where the lowest is); ``airports`` lists airport prices only. ``offer_count`` is the\nnumber of shop offers the API knows for the product (null where the answer does not say). ``size`` is the API's\nown measure (\"100 ml\"; null where the answer carries none).","properties":{"airports":{"items":{"$ref":"#/$defs/AirportPrice"},"title":"Airports","type":"array"},"brand":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Brand"},"category":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Category"},"highest_price":{"anyOf":[{"$ref":"#/$defs/Money"},{"type":"null"}]},"image_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Image Url"},"lowest_price":{"anyOf":[{"$ref":"#/$defs/Money"},{"type":"null"}]},"lowest_price_scope":{"anyOf":[{"enum":["airport","online_shop"],"type":"string"},{"type":"null"}],"title":"Lowest Price Scope"},"offer_count":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Offer Count"},"price_observed_at":{"anyOf":[{"description":"ISO 8601 timestamp (UTC)","format":"date-time","type":"string"},{"type":"null"}],"title":"Price Observed At"},"product_id":{"title":"Product Id","type":"string"},"size":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Size"},"skybuyfly_url":{"title":"Skybuyfly Url","type":"string"},"title":{"title":"Title","type":"string"}},"required":["product_id","title","brand","category","image_url","size","lowest_price","lowest_price_scope","highest_price","offer_count","airports","price_observed_at","skybuyfly_url"],"title":"ProductCard","type":"object"},"ProductDetail":{"additionalProperties":false,"description":"A product card with its description.","properties":{"airports":{"items":{"$ref":"#/$defs/AirportPrice"},"title":"Airports","type":"array"},"brand":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Brand"},"category":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Category"},"description":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Description"},"highest_price":{"anyOf":[{"$ref":"#/$defs/Money"},{"type":"null"}]},"image_url":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Image Url"},"lowest_price":{"anyOf":[{"$ref":"#/$defs/Money"},{"type":"null"}]},"lowest_price_scope":{"anyOf":[{"enum":["airport","online_shop"],"type":"string"},{"type":"null"}],"title":"Lowest Price Scope"},"offer_count":{"anyOf":[{"type":"integer"},{"type":"null"}],"title":"Offer Count"},"price_observed_at":{"anyOf":[{"description":"ISO 8601 timestamp (UTC)","format":"date-time","type":"string"},{"type":"null"}],"title":"Price Observed At"},"product_id":{"title":"Product Id","type":"string"},"size":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Size"},"skybuyfly_url":{"title":"Skybuyfly Url","type":"string"},"title":{"title":"Title","type":"string"}},"required":["product_id","title","brand","category","image_url","size","lowest_price","lowest_price_scope","highest_price","offer_count","airports","price_observed_at","skybuyfly_url","description"],"title":"ProductDetail","type":"object"}},"additionalProperties":false,"description":"``get_product``.","properties":{"currency":{"title":"Currency","type":"string"},"offers":{"items":{"$ref":"#/$defs/Offer"},"title":"Offers","type":"array"},"product":{"$ref":"#/$defs/ProductDetail"},"similar":{"items":{"$ref":"#/$defs/ProductCard"},"title":"Similar","type":"array"},"view":{"const":"product","default":"product","title":"View","type":"string"}},"required":["currency","product","offers","similar"],"title":"ProductResult","type":"object"},"title":"Get a product's airport prices"}
