    "type": "string"
   },
   "headline": {
    "maxLength": 1000,
    "type": "string"
   },
   "name": {
    "maxLength": 400,
    "type": "string"
   },
   "skills": {
    "maxLength": 4000,
    "type": "string"
   },
   "summary": {
    "maxLength": 8000,
    "type": "string"
   }
  },
  "required": [
   "name",
   "headline",
   "contact",
   "summary",
   "experience",
   "skills",
