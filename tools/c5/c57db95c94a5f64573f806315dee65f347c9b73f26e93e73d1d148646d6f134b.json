{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add, update, remove, enable, or disable a RouterOS scheduler entry. Idempotent by name. add throws CONFLICT if name exists; update throws NOT_FOUND if it does not. Supports dry-run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "update",
     "remove",
     "enable",
     "disable"
    ],
    "type": "string"
   },
   "comment": {
    "description": "Optional comment",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview changes without applying.",
    "type": "boolean"
   },
   "interval": {
    "description": "Run interval (e.g. 00:05:00 for every 5 minutes)",
    "type": "string"
   },
   "name": {
    "description": "Job name \u2014 idempotency key",
    "type": "string"
   },
   "onEvent": {
    "description": "Script name or inline command to run (required on add)",
    "type": "string"
   },
   "routerId": {
    "description": "Router ID; omit to use the default router.",
    "type": "string"
   },
   "startDate": {
    "description": "Start date (e.g. jan/01/2000)",
    "type": "string"
   },
   "startTime": {
    "description": "Start time (e.g. 00:00:00)",
    "type": "string"
   }
  },
  "required": [
   "action",
   "name"
  ],
  "type": "object"
 },
 "name": "manage_scheduled_job",
 "title": "Manage Scheduled Job"
}
