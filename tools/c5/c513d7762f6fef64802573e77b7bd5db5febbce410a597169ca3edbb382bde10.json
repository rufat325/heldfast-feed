{
 "description": "Compact navigation search over entries by title, summary, kind, and tags. Returns snippet, matchedIn, slices, and moduleName per hit\u2014use get-entry for full payload. Prefer get-slice when you know the category (api, domain). Filters (moduleName, kind, tags) narrow agent context. Default limit 10.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "Exact filter on entry kind",
    "type": "string"
   },
   "limit": {
    "description": "Max results per page (default 10, max 50)",
    "type": "number"
   },
   "moduleName": {
    "description": "Exact filter on refs.moduleName",
    "type": "string"
   },
   "offset": {
    "description": "Skip first N matches (default 0)",
    "type": "number"
   },
   "projectId": {
    "description": "Required. Call list-projects first (query by workspace folder name) and pass the matching projectId. Never omit. default-project is forbidden.",
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Search text",
    "type": "string"
   },
   "tags": {
    "description": "Filter entries having any of these tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "query"
  ],
  "type": "object"
 },
 "name": "search-entries",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "offset": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "matchedIn": {
       "items": {
        "enum": [
         "title",
         "summary",
         "kind",
         "tags"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "moduleName": {
       "type": "string"
      },
      "refs": {
       "additionalProperties": false,
       "properties": {
        "entryIds": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "files": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "moduleName": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "slices": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "snippet": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "title",
      "summary",
      "snippet",
      "matchedIn",
      "slices",
      "moduleName"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "returned": {
    "type": "number"
   },
   "summary": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "summary",
   "total",
   "returned",
   "offset",
   "hasMore",
   "results"
  ],
  "type": "object"
 },
 "title": "Search Entries"
}
