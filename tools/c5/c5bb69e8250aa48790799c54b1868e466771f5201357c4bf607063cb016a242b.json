{
 "description": "Halt (pause) an ongoing staged rollout. The release stays in halted state until resumed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "track": {
    "default": "production",
    "description": "Release track (internal, alpha, beta, production)",
    "enum": [
     "internal",
     "alpha",
     "beta",
     "production"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gpc_halt_rollout"
}
