 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   },
   "days": {
    "default": 14,
    "description": "Number of days of APY history",
    "type": "number"
   },
   "pool_address": {
    "description": "Pool address",
    "type": "string"
   }
  },
