{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List designs"
 },
 "description": "List the designs this server has open, the built-in reference architectures you can start from, and the .tensorcad.json files it can see on disk. Start here when you do not already hold a design_id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_files": {
    "description": "Also scan the working directory for .tensorcad.json files.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "tensorcad_list_designs",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "designs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "design_id": {
       "type": "string"
      },
      "dirty": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "revision": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "source": {
       "enum": [
        "preset",
        "file",
        "empty",
        "derived"
       ],
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      }
     },
     "required": [
      "design_id",
      "name",
      "revision",
      "source",
      "dirty",
      "created_at",
      "updated_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "presets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "family": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "published_params": {
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "designs",
   "presets",
   "files"
  ],
  "type": "object"
 },
 "title": "List designs"
}
