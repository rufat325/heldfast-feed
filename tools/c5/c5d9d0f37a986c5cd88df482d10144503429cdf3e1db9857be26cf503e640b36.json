{
 "description": "Hand off work to another agent with a summary of the state at handoff.",
 "inputSchema": {
  "properties": {
   "agent": {
    "description": "acting agent identity (defaults to OCTOBOARD_AGENT)",
    "type": "string"
   },
   "context": {
    "type": "string"
   },
   "openQuestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "relatedFiles": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "type": "string"
   },
   "task": {
    "type": "string"
   },
   "to": {
    "type": "string"
   }
  },
  "required": [
   "to",
   "summary"
  ],
  "type": "object"
 },
 "name": "board_handoff"
}
