{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://matchawards/results-v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this last, after searching, to show the user the opportunities you picked as a card. Pass up to 10 ids from search_contracts or search_grants results, best first. Keep your reply to a short summary; the card shows the rows.\n\nIds from search_jobs or search_awards are not shown. Do not use to search (search_contracts, search_grants) or for one result's details (get_opportunity).",
 "inputSchema": {
  "properties": {
   "ids": {
    "description": "Ids from search results, in the order to show them.",
    "items": {
     "description": "The id field of a search result.",
     "pattern": "^[A-Za-z0-9_-]{1,128}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "title": "Ids",
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "title": "show_resultsArguments",
  "type": "object"
 },
 "name": "show_results",
 "outputSchema": {
  "$defs": {
   "Naics": {
    "properties": {
     "code": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Code"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Title"
     }
    },
    "title": "Naics",
    "type": "object"
   },
   "OpportunityRow": {
    "description": "One search result. Jobs fill title, agency (the employer), state, city, posted_at and url only.",
    "properties": {
     "agency": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Agency"
     },
     "agency_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "The agency's MatchAwards id.",
      "title": "Agency Id"
     },
     "ai_matched_naics": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only when you filtered by naics: requested codes this contract notice matched only because MatchAwards' AI suggested them, not its own codes. Call such a match AI-suggested.",
      "title": "Ai Matched Naics"
     },
     "city": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "City"
     },
     "id": {
      "description": "Pass to get_opportunity for the description and contacts.",
      "title": "Id",
      "type": "string"
     },
     "matched_naics": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Only when you filtered by naics: the requested codes this record carries: its own code (in naics) or, for a grant or job, another code of its program or occupation.",
      "title": "Matched Naics"
     },
     "naics": {
      "anyOf": [
       {
        "$ref": "#/$defs/Naics"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "On state notices (type state) the naics code itself is AI-assigned."
     },
     "no_fixed_deadline": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "true: the deadline is a placeholder date.",
      "title": "No Fixed Deadline"
     },
     "office": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Office"
     },
     "posted_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Date, YYYY-MM-DD.",
      "title": "Posted At"
     },
     "response_deadline": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Date, YYYY-MM-DD; null if none.",
      "title": "Response Deadline"
     },
     "sam_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "The SAM.gov notice (federal only). Show it as a markdown link.",
      "title": "Sam Url"
     },
     "set_aside": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Set Aside"
     },
     "solicitation_number": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Solicitation Number"
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "State"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Title"
     },
     "type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "federal, state, grant or job.",
      "title": "Type"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "The posting on matchawards.com. Show it as a markdown link.",
      "title": "Url"
     }
    },
    "required": [
     "id"
    ],
    "title": "OpportunityRow",
    "type": "object"
   }
  },
  "properties": {
   "as_of": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "When the API generated the first row shown (ISO time).",
    "title": "As Of"
   },
   "failed": {
    "description": "Ids not fetched because MatchAwards was busy or failed. Call show_results again with just these ids to add them.",
    "items": {
     "type": "string"
    },
    "title": "Failed",
    "type": "array"
   },
   "missing": {
    "description": "Ids not shown because they were not found or are not a contract or grant (a job). Retrying will not add them.",
    "items": {
     "type": "string"
    },
    "title": "Missing",
    "type": "array"
   },
   "note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Note"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/OpportunityRow"
    },
    "title": "Results",
    "type": "array"
   },
   "warning": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Set when some ids could not be fetched (see failed).",
    "title": "Warning"
   }
  },
  "required": [
   "results"
  ],
  "title": "ShownResults",
  "type": "object"
 },
 "title": "Show results"
}
