{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect a previously uploaded PDF using its document capability. Upload binary PDFs through POST /v1/documents; persist both the returned capability and recovery key securely.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "document_id",
   "capability"
  ],
  "type": "object"
 },
 "name": "inspect_pdf",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "PDF metadata, page count, extracted capabilities, and parser warnings.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "attachments": {
    "items": {},
    "type": "array"
   },
   "bookmarks": {
    "items": {},
    "type": "array"
   },
   "byteLength": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "contentHash": {
    "type": "string"
   },
   "createdAt": {
    "type": "string"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "expiresAt": {
    "type": "string"
   },
   "extensions": {},
   "fileName": {
    "type": "string"
   },
   "formFields": {
    "items": {},
    "type": "array"
   },
   "metadata": {},
   "operations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "resource": {},
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Inspect PDF"
}
