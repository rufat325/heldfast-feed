{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "title": "Update task"
 },
 "description": "Update an existing task. Only send fields you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contact_ids": {
    "description": "Replace associated contacts",
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "type": "array"
   },
   "date": {
    "description": "Due date (YYYY-MM-DD)",
    "type": "string"
   },
   "date_type": {
    "description": "Date type: specific (has a due date), asap (do as soon as possible), one_day (someday/no rush)",
    "enum": [
     "specific",
     "asap",
     "one_day"
    ],
    "type": "string"
   },
   "description": {
    "description": "Task description",
    "type": "string"
   },
   "duration_minutes": {
    "anyOf": [
     {
      "maximum": 1440,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Estimated duration in minutes. Pass null to clear."
   },
   "id": {
    "description": "Task UUID",
    "format": "uuid",
    "type": "string"
   },
   "priority": {
    "description": "Priority level",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "start_time": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Wall-clock start time HH:MM (24h) \u2014 anchors the task on the Day-view timeline. Pass null to clear it (unschedule)."
   },
   "tag_ids": {
    "description": "Replace associated tags",
    "items": {
     "format": "uuid",
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Task title",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_task"
}
