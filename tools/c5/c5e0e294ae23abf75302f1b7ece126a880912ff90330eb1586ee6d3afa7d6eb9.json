{
 "description": "Optimize 2D guillotine cutting plans for plywood, MDF, glass, sheet metal (2D nesting with kerf, per-part rotation lock for grain direction, optional sheet trim and multiple stock sizes). Returns sheets used, piece positions, utilization, estimated cut length/count and unplaced pieces. Includes a web_url with the plan prefilled for a visual layout diagram.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "kerf": {
    "default": 0,
    "description": "Blade/saw width consumed by each cut",
    "minimum": 0,
    "type": "number"
   },
   "pieces": {
    "description": "Pieces to cut",
    "items": {
     "properties": {
      "height": {
       "description": "Piece height",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "label": {
       "description": "Optional piece name",
       "type": "string"
      },
      "qty": {
       "default": 1,
       "description": "How many of this piece",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "rotatable": {
       "default": true,
       "description": "Allow 90-degree rotation (false = grain lock)",
       "type": "boolean"
      },
      "width": {
       "description": "Piece width",
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "width",
      "height"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "stock_count": {
    "default": 1,
    "description": "How many sheets are available",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "stock_height": {
    "description": "Sheet height",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "stock_width": {
    "description": "Sheet width",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "stocks": {
    "description": "Optional mixed stock sizes; replaces stock_width/stock_height/stock_count when given",
    "items": {
     "properties": {
      "count": {
       "description": "Sheets available of this size",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "height": {
       "description": "Sheet height",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "width": {
       "description": "Sheet width",
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "width",
      "height",
      "count"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "type": "array"
   },
   "trim_x": {
    "default": 0,
    "description": "Symmetric trim removed from left/right sheet edges (damaged edges)",
    "minimum": 0,
    "type": "number"
   },
   "trim_y": {
    "default": 0,
    "description": "Symmetric trim removed from top/bottom sheet edges",
    "minimum": 0,
    "type": "number"
   },
   "unit": {
    "description": "Unit for all dimensions",
    "enum": [
     "mm",
     "cm",
     "m",
     "in",
     "ft"
    ],
    "type": "string"
   }
  },
  "required": [
   "unit",
   "stock_width",
   "stock_height",
   "pieces"
  ],
  "type": "object"
 },
 "name": "sheet_cutting_optimizer"
}
