{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Proposal"
 },
 "description": "Create a scheduling proposal \u2014 send a set of candidate time slots to one or more participant agents so they can accept, decline, or counter-propose. The organizer agent owns the proposal; once every participant responds, the system auto-resolves to the highest-scoring slot (or cancels if all decline). Requires an org-level API key. Pro plan only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calendar_id": {
    "description": "Calendar the resolved event will be created on",
    "type": "string"
   },
   "description": {
    "description": "Longer context/agenda",
    "maxLength": 5000,
    "type": "string"
   },
   "expires_at": {
    "description": "Auto-cancel cutoff if unresolved",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "organizer_agent_id": {
    "description": "Agent ID proposing the meeting",
    "type": "string"
   },
   "participant_agent_ids": {
    "description": "Agent IDs invited to respond",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "slots": {
    "description": "Candidate time slots (up to 20)",
    "items": {
     "properties": {
      "calendar_id": {
       "description": "Calendar to create the event on if this slot is chosen. Defaults to the proposal's top-level calendar_id.",
       "type": "string"
      },
      "end_time": {
       "description": "Slot end time (ISO 8601), after start_time",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "start_time": {
       "description": "Slot start time (ISO 8601)",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "weight": {
       "default": 1,
       "description": "Preference for this slot, 0\u201310 (higher = more preferred). Used to rank candidate slots when the proposal is resolved. Defaults to 1.",
       "maximum": 10,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "start_time",
      "end_time"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "title": {
    "description": "Short description of what the meeting is about",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "organizer_agent_id",
   "participant_agent_ids",
   "calendar_id",
   "slots"
  ],
  "type": "object"
 },
 "name": "create_proposal"
}
