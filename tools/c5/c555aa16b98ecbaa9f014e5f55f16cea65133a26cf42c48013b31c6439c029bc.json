    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "id": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "note": {
    "description": "Note for the transcript",
    "type": "string"
   },
   "nrIsPageId": {
