{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "readOnlyHint": false,
  "title": "Editar alerta"
 },
 "description": "Edita interesse ou pausa/reativa o alerta do dono. Reativa\u00e7\u00e3o al\u00e9m da franquia exige pagamento. Filtros substituem o recorte inteiro.",
 "inputSchema": {
  "properties": {
   "ativo": {
    "description": "`false` pausa sem apagar; `true` reativa.",
    "type": "boolean"
   },
   "canal": {
    "description": "Novo canal: `pull`, `webhook` ou `email` (e-mail verificado da conta; exige sess\u00e3o).",
    "enum": [
     "pull",
     "webhook",
     "email"
    ],
    "type": "string"
   },
   "destino": {
    "description": "Nova URL https na porta 443 (webhook). Ignorado no pull e no e-mail.",
    "type": "string"
   },
   "filtros": {
    "additionalProperties": false,
    "description": "Recorte adicional: modalidades, munic\u00edpios, exclus\u00f5es, valores, propostas abertas e CNAEs. PATCH substitui o recorte inteiro; {} limpa.",
    "properties": {
     "abertas": {
      "type": "boolean"
     },
     "cnaes": {
      "items": {
       "pattern": "^\\d{4}-?\\d/?\\d{2}$",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "excluir": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "modalidades": {
      "items": {
       "maximum": 13,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 10,
      "type": "array"
     },
     "municipios": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "valor_max": {
      "minimum": 0,
      "type": "number"
     },
     "valor_min": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "id": {
    "description": "Identificador do alerta.",
    "type": "string"
   },
   "termos": {
    "description": "Termos do objeto; espa\u00e7o exige todos, | aceita alternativas.",
    "type": "string"
   },
   "uf": {
    "description": "Sigla da UF; vazio libera.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "editar_alerta",
 "title": "Editar alerta"
}
