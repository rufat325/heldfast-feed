{
 "description": "Get algorithm recommendations based on your use case, performance requirements, and target environment",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "priority": {
    "default": "balanced",
    "description": "What to optimize for",
    "enum": [
     "security",
     "performance",
     "size",
     "balanced"
    ],
    "type": "string"
   },
   "target_environment": {
    "default": "server",
    "description": "Where the crypto operations will run",
    "enum": [
     "server",
     "browser",
     "mobile",
     "embedded",
     "smart-contract"
    ],
    "type": "string"
   },
   "use_case": {
    "description": "Primary use case for the cryptographic operation",
    "enum": [
     "blockchain-wallet",
     "api-authentication",
     "document-signing",
     "key-exchange",
     "iot-device",
     "government",
     "financial-custody"
    ],
    "type": "string"
   }
  },
  "required": [
   "use_case"
  ],
  "type": "object"
 },
 "name": "pqc_recommend_algorithm"
}
