{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: extract a conservative operator chain from an embedded TouchDesigner tutorial and draft a RecipeSchema JSON without writing files or touching the TD bridge.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Optional recipe description override.",
    "type": "string"
   },
   "difficulty": {
    "default": "intermediate",
    "enum": [
     "beginner",
     "intermediate",
     "advanced"
    ],
    "type": "string"
   },
   "family": {
    "description": "Optional operator family/category constraint, e.g. TOP, CHOP, SOP, DAT.",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Optional recipe id override.",
    "minLength": 1,
    "type": "string"
   },
   "include_glsl_code": {
    "default": true,
    "description": "Include a complete GLSL pixel-shader code block when a GLSL TOP tutorial provides one.",
    "type": "boolean"
   },
   "max_steps": {
    "default": 5,
    "description": "Maximum operator references to keep from the tutorial.",
    "exclusiveMinimum": 0,
    "maximum": 8,
    "type": "integer"
   },
   "name": {
    "description": "Tutorial id or display name to draft from.",
    "minLength": 1,
    "type": "string"
   },
   "recipe_name": {
    "description": "Optional recipe display name override.",
    "minLength": 1,
    "type": "string"
   },
   "strict": {
    "default": true,
    "description": "Return an isError result when no RecipeSchema-valid draft can be produced.",
    "type": "boolean"
   },
   "tags": {
    "default": [],
    "description": "Extra recipe tags to append.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "td_version_min": {
    "default": "2023",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "draft_recipe_from_tutorial",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chainReport": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "message": {
         "type": "string"
        },
        "severity": {
         "type": "string"
        },
        "type": {
         "type": "string"
        }
       },
       "required": [
        "type",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "valid": {
      "type": "boolean"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "valid"
    ],
    "type": "object"
   },
   "draftable": {
    "type": "boolean"
   },
   "extractedOperators": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "nextToolHints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipe": {},
   "tutorial": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   },
   "unsupportedReasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "valid": {
    "type": "boolean"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "valid": {
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "issues"
    ],
    "type": "object"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "valid",
   "draftable",
   "validation",
   "tutorial",
   "extractedOperators",
   "warnings",
   "unsupportedReasons",
   "nextToolHints"
  ],
  "type": "object"
 },
 "title": "Draft recipe from tutorial"
}
