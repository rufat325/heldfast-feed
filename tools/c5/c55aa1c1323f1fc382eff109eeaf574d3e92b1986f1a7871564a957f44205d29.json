{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Attach explicit relevance labels to one exact Pathmark recall so audit_memory can report measured precision.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "irrelevantIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "note": {
    "maxLength": 1000,
    "type": "string"
   },
   "recallId": {
    "description": "The recallId returned by chat or ask_memory.",
    "minLength": 1,
    "type": "string"
   },
   "relevantIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "required": [
   "recallId"
  ],
  "type": "object"
 },
 "name": "rate_recall",
 "title": "Rate recalled memories"
}
