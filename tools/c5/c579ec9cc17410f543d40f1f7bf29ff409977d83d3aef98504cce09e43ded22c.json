{
 "annotations": {
  "destructiveHint": true,
  "title": "Send in a lead / lead event"
 },
 "description": "Add a new lead or record activity on an existing one \u2014 FUB's documented way to create leads. FUB de-duplicates by email/phone (or use person.id to target a contact), routes the lead per Lead Flow, notifies the agent and runs action plans for Registration / Inquiry types. A 204 means the lead flow for this source is archived and the event was ignored. FUB: POST /v1/events.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Any additional information.",
    "type": "string"
   },
   "message": {
    "description": "A message from the lead.",
    "type": "string"
   },
   "occurredAt": {
    "description": "ISO-8601 time it happened. Events older than a day are historical and do not trigger workflows.",
    "type": "string"
   },
   "pageTitle": {
    "description": "For Viewed Page events.",
    "type": "string"
   },
   "pageUrl": {
    "description": "For Viewed Page events.",
    "type": "string"
   },
   "person": {
    "description": "The lead.",
    "properties": {
     "addresses": {
      "items": {
       "properties": {
        "city": {
         "type": "string"
        },
        "code": {
         "description": "Postal/ZIP code, as a string.",
         "type": "string"
        },
        "country": {
         "type": "string"
        },
        "state": {
         "description": "Abbreviated state code, e.g. \"CA\".",
         "type": "string"
        },
        "street": {
         "type": "string"
        },
        "type": {
         "description": "e.g. \"home\", \"work\", \"mailing\".",
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "assignedLenderId": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "assignedLenderName": {
      "type": "string"
     },
     "assignedTo": {
      "description": "Full name of the agent.",
      "type": "string"
     },
     "assignedUserId": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "contacted": {
      "type": "boolean"
     },
     "customFields": {
      "additionalProperties": {
       "type": [
        "string",
        "number",
        "null"
       ]
      },
      "description": "Account custom fields, keyed by their API name (e.g. {\"customBirthday\": \"1990-02-16\"}). See the `name` column of fub_list_custom_fields. null clears a value.",
      "propertyNames": {
       "pattern": "^custom[A-Za-z0-9_]+$",
       "type": "string"
      },
      "type": "object"
     },
     "emails": {
      "items": {
       "properties": {
        "type": {
         "description": "e.g. \"home\", \"work\".",
         "type": "string"
        },
        "value": {
         "description": "The email address.",
         "type": "string"
        }
       },
       "required": [
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "firstName": {
      "type": "string"
     },
     "id": {
      "description": "Existing person id to attach this event to.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "lastName": {
      "type": "string"
     },
     "phones": {
      "items": {
       "properties": {
        "type": {
         "description": "e.g. \"mobile\", \"home\", \"work\".",
         "type": "string"
        },
        "value": {
         "description": "The phone number, e.g. 888-555-1234.",
         "type": "string"
        }
       },
       "required": [
        "value"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "price": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "source": {
      "type": "string"
     },
     "sourceUrl": {
      "type": "string"
     },
     "stage": {
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "property": {
    "description": "The property the event is about.",
    "properties": {
     "area": {
      "description": "Square feet.",
      "type": "string"
     },
     "bathrooms": {
      "type": "string"
     },
     "bedrooms": {
      "type": "string"
     },
     "city": {
      "type": "string"
     },
     "code": {
      "type": "string"
     },
     "forRent": {
      "type": "boolean"
     },
     "lot": {
      "description": "Acres.",
      "type": "string"
     },
     "mlsNumber": {
      "type": "string"
     },
     "price": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "state": {
      "type": "string"
     },
     "street": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "source": {
    "description": "Lead source name, e.g. \"MyWebsite.com\". Used for Lead Flow routing.",
    "type": "string"
   },
   "system": {
    "description": "Name of the system sending the lead.",
    "type": "string"
   },
   "type": {
    "description": "Event type. \"Inquiry\" becomes Property or General Inquiry automatically.",
    "enum": [
     "Registration",
     "Inquiry",
     "Seller Inquiry",
     "Property Inquiry",
     "General Inquiry",
     "Viewed Property",
     "Saved Property",
     "Visited Website",
     "Incoming Call",
     "Unsubscribed",
     "Property Search",
     "Saved Property Search",
     "Visited Open House",
     "Viewed Page"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "person"
  ],
  "type": "object"
 },
 "name": "fub_send_lead_event",
 "title": "Send in a lead / lead event"
}
