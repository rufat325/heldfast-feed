{
 "description": "Build an UNSIGNED tx that mints a new Uniswap v3 position. Amounts are decimal strings (wei) \u2014 compute them with get_pool_state (live ratio) right before minting, or stale prices revert the mint. Returns the tx plus unsigned rlp. When simulated, simulationResult={tokenId,liquidity,amount0,amount1} decoded from the eth_call return data. Simulation is OFF by default here (minting needs token approvals and balances, so eth_call usually reverts); pass simulate=true to attempt it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount0Desired": {
    "pattern": "^\\d+$",
    "type": "string"
   },
   "amount1Desired": {
    "pattern": "^\\d+$",
    "type": "string"
   },
   "chainId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "fee": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "recipient": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "simulate": {
    "type": "boolean"
   },
   "slippageBps": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "tickLower": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "tickUpper": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "token0": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "token1": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "chainId",
   "token0",
   "token1",
   "fee",
   "tickLower",
   "tickUpper",
   "amount0Desired",
   "amount1Desired",
   "recipient"
  ],
  "type": "object"
 },
 "name": "build_mint",
 "title": "Build a mint-position transaction"
}
