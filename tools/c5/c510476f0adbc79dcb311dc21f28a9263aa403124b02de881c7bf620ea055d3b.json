{
 "description": "Register a risk to objectives, with likelihood, assertions, related COSO principles and a fraud flag.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assertions": {
    "default": [],
    "items": {
     "enum": [
      "completeness",
      "existence-occurrence",
      "accuracy",
      "valuation",
      "obligations-rights",
      "presentation-disclosure"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "cause": {
    "type": "string"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "fraud": {
    "default": false,
    "type": "boolean"
   },
   "impact": {
    "type": "string"
   },
   "likelihood": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "principles": {
    "default": [],
    "items": {
     "maximum": 17,
     "minimum": 1,
     "type": "integer"
    },
    "type": "array"
   },
   "scopeItemId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "description"
  ],
  "type": "object"
 },
 "name": "register_risk",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "risk": {}
  },
  "required": [
   "risk"
  ],
  "type": "object"
 },
 "title": "Register a risk"
}
