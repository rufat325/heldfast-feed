 "description": "Pause or resume many campaigns. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_bulk_update_ad_campaign_status.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "type": "object"
   },
   "payload": {
    "properties": {
     "campaigns": {
      "items": {
       "properties": {
        "platform": {
         "enum": [
          "facebook",
          "instagram",
          "tiktok",
          "linkedin",
          "pinterest",
          "google",
          "twitter",
          "openai",
          "googleads",
          "tiktokads",
          "linkedinads",
          "pinterestads",
          "xads",
          "openaiads"
         ],
         "type": "string"
        },
        "platformCampaignId": {
         "type": "string"
        }
       },
       "required": [
        "platformCampaignId",
        "platform"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "status": {
      "enum": [
       "active",
       "paused"
      ],
      "type": "string"
     }
    },
    "required": [
