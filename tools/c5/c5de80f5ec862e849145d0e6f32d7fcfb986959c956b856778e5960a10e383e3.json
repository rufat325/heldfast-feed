{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Bundle a walkerOS flow configuration into deployable JavaScript. Resolves all destinations, sources, and transformers, then outputs a tree-shaken production bundle. Returns bundle statistics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "configPath": {
    "description": "Path to flow configuration file (JSON or JavaScript), URL, or inline JSON string",
    "minLength": 1,
    "type": "string"
   },
   "flow": {
    "description": "Flow name for multi-flow configs",
    "type": "string"
   },
   "output": {
    "description": "Output file path (defaults to config-defined)",
    "type": "string"
   },
   "stats": {
    "default": true,
    "description": "Return bundle statistics",
    "type": "boolean"
   }
  },
  "required": [
   "configPath"
  ],
  "type": "object"
 },
 "name": "flow_bundle",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buildTime": {
    "description": "Build time in milliseconds",
    "type": "number"
   },
   "message": {
    "description": "Status message",
    "type": "string"
   },
   "packages": {
    "description": "Names of packages included in the bundle",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "description": "Whether bundling succeeded",
    "type": "boolean"
   },
   "totalSize": {
    "description": "Total bundle size in bytes",
    "type": "number"
   },
   "treeshakingEffective": {
    "description": "Whether tree-shaking was effective",
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Bundle Flow"
}
