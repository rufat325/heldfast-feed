{
 "annotations": {
  "readOnlyHint": true,
  "title": "List vendors"
 },
 "description": "List vendors (contractors, suppliers) with contact details, category, insurance and default expense GL account. Filter by name, email, phone, website, status or insurance expiration. Buildium: GET /v1/vendors.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "email": {
    "description": "Email contains this value.",
    "type": "string"
   },
   "insurance_expiration": {
    "description": "Insurance expiration window.",
    "enum": [
     "Expired",
     "ThirtyDaysOrLess",
     "SixtyDaysOrLess",
     "NinetyDaysOrLess",
     "None",
     "Any"
    ],
    "type": "string"
   },
   "last_updated_from": {
    "description": "Updated on or after \u2014 UTC, formatted YYYY-MM-DDTHH:MM:SSZ.",
    "type": "string"
   },
   "last_updated_to": {
    "description": "Updated on or before \u2014 UTC, formatted YYYY-MM-DDTHH:MM:SSZ.",
    "type": "string"
   },
   "limit": {
    "description": "Max results, 1-1000 (Buildium default 50).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Vendor name contains this value.",
    "type": "string"
   },
   "offset": {
    "description": "Zero-based record offset for paging (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "orderby": {
    "description": "Sort, e.g. \"Name\", \"LeaseToDate desc\" or \"Rent desc,City asc\". Any field of the returned object.",
    "type": "string"
   },
   "phone": {
    "description": "Phone number contains this value.",
    "type": "string"
   },
   "status": {
    "description": "Vendor status (both if omitted).",
    "enum": [
     "Active",
     "Inactive"
    ],
    "type": "string"
   },
   "website": {
    "description": "Website contains this value.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "buildium_list_vendors",
 "title": "List vendors"
}
