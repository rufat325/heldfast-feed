{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Build a practical daily summary from Google Health rollups and reconciled streams when available. Read-only, beta, non-medical.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "default": "today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$|^today$",
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "timezone": {
    "default": "UTC",
    "description": "IANA timezone used only for display, e.g. America/New_York.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "google_health_daily_summary",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "generated_at": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "daily_summary",
     "weekly_summary"
    ],
    "type": "string"
   }
  },
  "required": [
   "kind",
   "generated_at"
  ],
  "type": "object"
 },
 "title": "Google Health Daily Summary"
}
