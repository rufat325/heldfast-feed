  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get bandwidth/traffic usage by folder, by video, or DRM by video. Returns array of {name, bandwidth_bytes, video_id?} entries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_date": {
    "$ref": "#/properties/start_date",
    "description": "End date (YYYY-MM-DD)"
   },
   "start_date": {
    "description": "Start date (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "type": {
    "default": "all",
    "description": "Traffic type \u2014 'all' (regular, required by the API) or 'drm'",
    "enum": [
     "all",
     "drm"
    ],
    "type": "string"
   },
   "video_id": {
    "description": "Video ID (omit for folder-level)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "panda_get_bandwidth_analytics",
 "title": "Get Bandwidth Analytics"
}
