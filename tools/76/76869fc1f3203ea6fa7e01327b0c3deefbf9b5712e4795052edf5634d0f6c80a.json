    "enum": [
     "aimode",
     "aioverview",
     "chatgpt",
     "copilot",
     "gemini",
     "google",
     "grok",
     "perplexity"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_countries",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
