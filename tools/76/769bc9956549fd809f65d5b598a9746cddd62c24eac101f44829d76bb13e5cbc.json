{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save a fact or revise canon only after the user approves it. Preserve the existing title/kind. LOCKED requires approval as established fact; brainstorming is not approval. Existing entries require expectedRevision from retrieval; conflicting edits fail without overwriting. Identical retries leave revision history unchanged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "maxLength": 12000,
    "minLength": 1,
    "type": "string"
   },
   "expectedRevision": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "kind": {
    "enum": [
     "CHARACTER",
     "RELATIONSHIP",
     "APPEARANCE",
     "ABILITY",
     "LOCATION",
     "WORLD_RULE",
     "TIMELINE",
     "PLOT_THREAD",
     "ITEM",
     "FACTION",
     "OTHER"
    ],
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   },
   "revisionReason": {
    "maxLength": 1000,
    "type": "string"
   },
   "status": {
    "enum": [
     "LOCKED",
     "DEVELOPING",
     "UNKNOWN",
     "RETIRED"
    ],
    "type": "string"
   },
   "tags": {
    "default": [],
    "items": {
     "maxLength": 80,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "kind",
   "title",
   "status",
   "content"
  ],
  "type": "object"
 },
 "name": "upsert_canon_entry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "upsert canon entry"
}
