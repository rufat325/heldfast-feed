{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Do two mods work together"
 },
 "description": "Whether two Minecraft mods ran together in the Modkeel lab, clashed, or were never tested together. By mod id.",
 "inputSchema": {
  "properties": {
   "mc": {
    "description": "Minecraft version, e.g. 1.21.1 or 26.2. Omit for all versions.",
    "type": "string"
   },
   "mod_a": {
    "description": "Mod id, e.g. iris.",
    "type": "string"
   },
   "mod_b": {
    "description": "Mod id, e.g. sodium.",
    "type": "string"
   }
  },
  "required": [
   "mod_a",
   "mod_b"
  ],
  "type": "object"
 },
 "name": "mod_pair",
 "outputSchema": {
  "properties": {
   "data": {
    "description": "Snapshot date and license of the lab data; attribute when quoting.",
    "properties": {
     "built": {
      "type": "string"
     },
     "license": {
      "type": "object"
     }
    },
    "type": "object"
   },
   "mc": {
    "type": [
     "string",
     "null"
    ]
   },
   "mods": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runs": {
    "items": {
     "properties": {
      "detail": {
       "type": "string"
      },
      "env": {
       "type": "string"
      },
      "mc": {
       "type": "string"
      },
      "source": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "verdict": {
    "description": "untested: no lab run, not a known conflict.",
    "enum": [
     "ran_together",
     "clash",
     "untested"
    ],
    "type": "string"
   }
  },
  "required": [
   "mods",
   "verdict",
   "runs",
   "data"
  ],
  "type": "object"
 },
 "title": "Do two mods work together"
}
