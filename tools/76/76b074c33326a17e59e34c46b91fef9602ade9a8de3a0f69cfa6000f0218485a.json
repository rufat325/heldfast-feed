{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add guests"
 },
 "description": "Adds guests to a draft (a draft_ id from create_event) or a live AUTOPILOT event. On a live autopilot event this mails each new guest their invite immediately and needs the send permission too; on an unsent draft it only needs the write permission and mails nobody. A classic (share-link) poll has no guest list \u2014 people join from the link \u2014 so adding a guest to one is refused.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "event_id": {
    "description": "A draft_ id, or a live event id",
    "type": "string"
   },
   "guests": {
    "items": {
     "properties": {
      "email": {
       "type": "string"
      },
      "name": {
       "maxLength": 80,
       "type": "string"
      },
      "phone": {
       "maxLength": 30,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 75,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "event_id",
   "guests"
  ],
  "type": "object"
 },
 "name": "add_guests",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "added": {
    "type": "number"
   },
   "already_invited": {
    "type": "number"
   },
   "invited": {
    "type": "number"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:write",
    "events:send"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add guests"
}
