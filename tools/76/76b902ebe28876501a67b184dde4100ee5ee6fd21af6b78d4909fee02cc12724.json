{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Waits for one submitted MCP App action to reach an authoritative result. Pass operation.id from the action receipt. If phase remains PROCESSING, call again with the same operation_id. If next_call is present, perform that continuation instead; do not repeat the original write.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "operation_id": {
    "description": "operation.id from an action receipt",
    "type": "string"
   },
   "timeout_s": {
    "description": "Seconds, up to 35; default 30",
    "type": "integer"
   }
  },
  "required": [
   "operation_id"
  ],
  "type": "object"
 },
 "name": "huasheng_wait_for_action",
 "outputSchema": {
  "properties": {
   "action": {
    "properties": {
     "accepted": {
      "type": "boolean"
     },
     "action_id": {
      "type": "string"
     },
     "client_action_id": {
      "description": "App-supplied id; repeats reuse the first result",
      "type": "string"
     },
     "entity": {
      "properties": {
       "id": {
        "type": "string"
       },
       "snapshot": {
        "type": "object"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     "error": {
      "properties": {
       "code": {
        "type": "string"
       },
       "retryable": {
        "type": "boolean"
       },
       "suggested_action": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "retryable"
      ],
      "type": "object"
     },
     "followup": {
      "properties": {
       "prompt": {
        "type": "string"
       },
       "required": {
        "description": "Deprecated; always false",
        "type": "boolean"
       }
      },
      "required": [
       "required"
      ],
      "type": "object"
     },
     "kind": {
      "description": "e.g. footage.replace",
      "type": "string"
     },
     "next_call": {
      "properties": {
       "arguments": {
        "type": "object"
       },
       "tool": {
        "type": "string"
       }
      },
      "required": [
       "tool",
       "arguments"
      ],
      "type": "object"
     },
     "operation": {
      "properties": {
       "id": {
        "description": "Pass to huasheng_wait_for_action",
        "type": "string"
       },
       "poll_after_ms": {
        "type": "integer"
       },
       "progress": {
        "type": "number"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     "phase": {
      "enum": [
       "ACCEPTED",
       "PROCESSING",
       "SUCCEEDED",
       "FAILED",
       "CANCELLED",
       "STALE"
      ],
      "type": "string"
     },
     "pid": {
      "type": "integer"
     },
     "revision": {
      "type": "integer"
     },
     "summary": {
      "type": "string"
     },
     "terminal": {
      "type": "boolean"
     }
    },
    "required": [
     "action_id",
     "pid",
     "kind",
     "phase",
     "accepted",
     "terminal",
     "summary",
     "followup"
    ],
    "type": "object"
   },
   "answered": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "applied": {
    "description": "Whether the change has landed. If false, track action.operation.id and follow action.next_call when present",
    "type": "boolean"
   },
   "can_be": {
    "description": "When only reading: what it accepts",
    "type": "string"
   },
   "clip": {
    "description": "Which clip was changed",
    "type": "integer"
   },
   "current": {
    "description": "When only reading: the current value",
    "type": "string"
   },
   "label": {
    "description": "Human-readable name of the changed setting",
    "type": "string"
   },
   "note": {
    "description": "What to do next, in plain words",
    "type": "string"
   },
   "options": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "outcome": {
    "enum": [
     "started",
     "queued",
     "busy"
    ],
    "type": "string"
   },
   "pid": {
    "description": "The 15-digit video id",
    "type": "integer"
   },
   "run_id": {
    "type": "string"
   },
   "selected": {
    "properties": {
     "id": {
      "type": "string"
     },
     "position": {
      "type": "integer"
     },
     "type": {
      "enum": [
       "clip",
       "motion"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "position",
     "id"
    ],
    "type": "object"
   },
   "setting": {
    "type": "string"
   },
   "url": {
    "description": "Link to the video in Huasheng",
    "type": "string"
   },
   "value": {
    "type": "string"
   }
  },
  "required": [
   "pid",
   "url"
  ],
  "type": "object"
 },
 "title": "Track a change made in a Huasheng card"
}
