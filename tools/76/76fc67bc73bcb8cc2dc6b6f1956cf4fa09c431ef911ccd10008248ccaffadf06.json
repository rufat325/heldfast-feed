{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search SF rentals, with provenance"
 },
 "description": "Search PutRoots' San Francisco rental index. Every row carries its source, the date we last saw it, and whether the landlord stated any requirements at all. Use this when someone asks what's available in SF at a price / bedroom count / neighborhood. Without a signed-in PutRoots account this searches the free sample only (3 listings per bedroom tier) and says so, with the true total.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "beds": {
    "description": "Bedroom tier. \"room\" means a room in a shared place.",
    "enum": [
     "room",
     "studio",
     "1",
     "2",
     "3+"
    ],
    "type": "string"
   },
   "hood": {
    "description": "Neighborhood name, matched loosely (e.g. \"Mission\", \"Sunset\").",
    "type": "string"
   },
   "limit": {
    "description": "How many to return (default 10, max 25). Newest first.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Max monthly rent in USD. Listings with no stated price are excluded when you set this \u2014 we don't let unpriced posts through a price filter.",
    "type": "number"
   },
   "min_price": {
    "description": "Min monthly rent in USD.",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_listings",
 "outputSchema": {
  "properties": {
   "gated": {
    "description": "true = free sample only (anonymous or partner key); total still tells the true index size.",
    "type": "boolean"
   },
   "listings": {
    "items": {
     "properties": {
      "beds": {
       "type": [
        "string",
        "null"
       ]
      },
      "hood": {
       "type": [
        "string",
        "null"
       ]
      },
      "last_seen": {
       "type": [
        "string",
        "null"
       ]
      },
      "not_checked_vs_budget": {
       "type": "boolean"
      },
      "posted": {
       "type": [
        "string",
        "null"
       ]
      },
      "price": {
       "type": [
        "number",
        "null"
       ]
      },
      "requirements_stated": {
       "type": "boolean"
      },
      "source": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "price",
      "source",
      "requirements_stated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "listings_with_no_stated_requirements": {
    "type": "integer"
   },
   "matched": {
    "type": "integer"
   },
   "not_checked_vs_budget": {
    "type": "integer"
   },
   "searched": {
    "type": "integer"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "gated",
   "total",
   "searched",
   "matched",
   "listings"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search SF rentals, with provenance"
}
