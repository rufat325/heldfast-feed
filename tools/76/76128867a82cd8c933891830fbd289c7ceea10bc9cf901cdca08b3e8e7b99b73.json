 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get locality market insights"
 },
 "description": "Get aggregated insights for one locality: \u20b9/sqft, supply count, demand pulse, livability/investment grade, highlights, watchouts, monthly priceTrends, and strengthTags. Use when the user asks \"what is X locality like\". Covers cities AVnester publishes locality guides for; others return supported=false \u2014 surface the scopeMessage. Always surface the disclaimer field when returning livability or investment grade.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {
   "city": {
    "description": "Indian city (required).",
    "maxLength": 60,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "locality": {
    "description": "Locality name within an Indian city.",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   }
  },
  "required": [
   "locality",
   "city"
  ],
  "type": "object"
 },
 "name": "get_locality_insights",
