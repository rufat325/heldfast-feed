{
 "description": "Compare search interest over time for up to 5 keywords",
 "inputSchema": {
  "properties": {
   "geo": {
    "default": "",
    "description": "Country code e.g. US, RU (default: worldwide)",
    "type": "string"
   },
   "keywords": {
    "description": "Up to 5 keywords",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeframe": {
    "default": "today 12-m",
    "description": "e.g. today 12-m, today 5-y",
    "type": "string"
   }
  },
  "required": [
   "keywords"
  ],
  "type": "object"
 },
 "name": "compare_keywords"
}
