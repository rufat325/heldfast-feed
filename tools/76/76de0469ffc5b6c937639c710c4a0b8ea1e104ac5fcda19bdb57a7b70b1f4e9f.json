{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Write metadata tags to a media file using ffmpeg. Can target a file by search term. Infers artist/title from the filename if not provided.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "album": {
    "description": "Album name",
    "type": "string"
   },
   "artist": {
    "description": "Artist name",
    "type": "string"
   },
   "comment": {
    "description": "Comment (e.g. rating, notes, mood)",
    "type": "string"
   },
   "date": {
    "description": "Year or date (e.g. 1978)",
    "type": "string"
   },
   "genre": {
    "description": "Genre (e.g. Rock, Jazz, Metal)",
    "type": "string"
   },
   "query": {
    "description": "File path or search term for the file to tag",
    "type": "string"
   },
   "title": {
    "description": "Track title",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "mpv_tag",
 "title": "Tag File"
}
