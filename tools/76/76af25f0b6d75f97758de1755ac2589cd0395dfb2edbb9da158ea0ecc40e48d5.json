{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get the full delivery event log for a specific email by its messageId. Returns all SES events: Send, Delivery, Bounce, Complaint, Open, Click.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "messageId": {
    "description": "SES message id, as returned by send_email or list_recent_sends.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "messageId"
  ],
  "type": "object"
 },
 "name": "get_email_event_log",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "SES events in recorded order: Send, Delivery, Bounce, Complaint, Open, Click.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "timestamp": {
       "description": "ISO 8601.",
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "timestamp"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "found": {
    "description": "False when no events are recorded yet for this messageId.",
    "type": "boolean"
   },
   "from": {
    "type": "string"
   },
   "messageId": {
    "type": "string"
   },
   "sentAt": {
    "description": "ISO 8601.",
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "subject": {
    "type": "string"
   },
   "to": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "found",
   "messageId"
  ],
  "type": "object"
 }
}
