{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Keyword search over everything published on rafeblandford.com \u2014 the FULL TEXT of every post, plus the About and Career pages.\n\nDeterministic by design: it matches titles, tags, excerpts and body text and ranks by a fixed score. No model, no embeddings \u2014 the same query always returns the same results.\n\nReturns metadata and an excerpt, not the body. Call get_post with a result's `slug` for the full text.\n\nA blank query returns the most recent items. Combine it with `topic` to browse one section of the site.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://rafeblandford.com/content/images/2026/06/favicon-512.png"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "256x256"
   ],
   "src": "https://rafeblandford.com/content/images/size/w256h256/2026/06/favicon-512.png"
  }
 ],
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "Maximum results. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "query": {
    "default": "",
    "description": "Words or a phrase. Blank returns the most recent writing.",
    "title": "Query",
    "type": "string"
   },
   "topic": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional. Restrict to one of the site's topic groups: work, ai-work, product-tech, rafeos, all-about-archive, notes. Every response lists them in `available_topics` with counts.",
    "title": "Topic"
   }
  },
  "title": "search_writingArguments",
  "type": "object"
 },
 "name": "search_writing",
 "outputSchema": {
  "$defs": {
   "CorpusRevision": {
    "properties": {
     "evidence_version": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "Version of the editorial dossier behind this corpus.",
      "title": "Evidence Version"
     },
     "generated": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "When this snapshot was generated. Regeneration is daily and usually changes nothing, so this moves more often than `sha256` does.",
      "title": "Generated"
     },
     "schema_version": {
      "description": "Version of the RESPONSE CONTRACT, not of the content.",
      "title": "Schema Version",
      "type": "string"
     },
     "sha256": {
      "description": "Digest of the public corpus, EXCLUDING `generated`. Same content gives the same digest; any changed published claim changes it. Quote it if you record this answer \u2014 it is what makes the answer reproducible later.",
      "title": "Sha256",
      "type": "string"
     }
    },
    "required": [
     "schema_version",
     "sha256"
    ],
    "title": "CorpusRevision",
    "type": "object"
   },
   "WritingResult": {
    "properties": {
     "excerpt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Excerpt"
     },
     "kind": {
      "title": "Kind",
      "type": "string"
     },
     "markdown_url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Markdown Url"
     },
     "match": {
      "anyOf": [
       {
        "additionalProperties": true,
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Match"
     },
     "provenance": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "written-by-rafe | written-with-ai | ai-authored. The site's own label; see /ai-provenance/.",
      "title": "Provenance"
     },
     "published_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Published At"
     },
     "reading_time": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Reading Time"
     },
     "slug": {
      "title": "Slug",
      "type": "string"
     },
     "tags": {
      "default": [],
      "items": {
       "type": "string"
      },
      "title": "Tags",
      "type": "array"
     },
     "title": {
      "title": "Title",
      "type": "string"
     },
     "topic": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Topic"
     },
     "topic_label": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Topic Label"
     },
     "updated_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Updated At"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "slug",
     "title",
     "url"
    ],
    "title": "WritingResult",
    "type": "object"
   }
  },
  "properties": {
   "available_topics": {
    "additionalProperties": true,
    "default": {},
    "title": "Available Topics",
    "type": "object"
   },
   "corpus": {
    "anyOf": [
     {
      "$ref": "#/$defs/CorpusRevision"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "interpretation": {
    "title": "Interpretation",
    "type": "string"
   },
   "query": {
    "title": "Query",
    "type": "string"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/WritingResult"
    },
    "title": "Results",
    "type": "array"
   },
   "topic": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Topic"
   },
   "total_matched": {
    "title": "Total Matched",
    "type": "integer"
   }
  },
  "required": [
   "query",
   "interpretation",
   "total_matched",
   "results"
  ],
  "title": "SearchWritingOutput",
  "type": "object"
 },
 "title": "Search the writing"
}
