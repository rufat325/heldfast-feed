{
 "description": "WRITE: Create a DYNAMIC (multi-text) creative using `asset_feed_spec`. Meta will auto-combine the bodies/titles/descriptions and optimize the best mix. The parent ad set MUST have is_dynamic_creative=true. Pass arrays of texts plus either video_id(s) or image_hash(es).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_account_id": {
    "description": "'act_123' or '123'",
    "type": "string"
   },
   "bodies": {
    "description": "Primary text variants",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "call_to_action_types": {
    "description": "e.g. ['SHOP_NOW','LEARN_MORE']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "descriptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "image_hashes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "instagram_user_id": {
    "type": "string"
   },
   "link_urls": {
    "description": "Landing page variants",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "page_id": {
    "type": "string"
   },
   "titles": {
    "description": "Headline variants",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url_tags": {
    "type": "string"
   },
   "video_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ad_account_id",
   "name",
   "page_id",
   "bodies",
   "link_urls"
  ],
  "type": "object"
 },
 "name": "create_ad_creative_with_asset_feed"
}
