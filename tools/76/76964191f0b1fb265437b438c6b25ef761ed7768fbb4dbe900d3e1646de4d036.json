{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute the multiplicative gated AXI Score (AXI v2.0, Section 4.5.8) from telemetry metrics. Consent and integrity gates fail closed when data is missing.",
 "inputSchema": {
  "properties": {
   "cf": {
    "description": "Consent Fidelity per event class (0\u20131). Missing values fail the gate closed.",
    "properties": {
     "action": {
      "type": "number"
     },
     "identity": {
      "type": "number"
     },
     "memoryWrite": {
      "type": "number"
     },
     "perception": {
      "type": "number"
     }
    },
    "required": [
     "action",
     "memoryWrite",
     "identity",
     "perception"
    ],
    "type": "object"
   },
   "cli": {
    "description": "Cognitive Load Index (0\u2013100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "ii": {
    "description": "Interaction Integrity (0\u20131). Alternatively pass integrity sub-scores.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "integrity": {
    "description": "Sub-scores used to compute II by weighted harmonic mean when ii is omitted",
    "properties": {
     "accuracy": {
      "type": "number"
     },
     "calibration": {
      "type": "number"
     },
     "scope": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "pc": {
    "description": "Presence Continuity (0\u20131)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "re": {
    "description": "Repair Efficacy (0\u20131)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "tdr": {
    "description": "Trust Decay Rate in trust-index points/day",
    "type": "number"
   },
   "ttc": {
    "description": "Time-to-Comfort in seconds",
    "type": "number"
   }
  },
  "required": [
   "cf"
  ],
  "type": "object"
 },
 "name": "axi_calculate_score",
 "title": "Calculate AXI Score"
}
