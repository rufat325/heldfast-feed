{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Resolve an escalation \u2014 actions: send_reply, retry_application, human_takeover, dismiss",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actionType": {
    "description": "Action to take",
    "enum": [
     "send_reply",
     "retry_application",
     "human_takeover",
     "dismiss"
    ],
    "type": "string"
   },
   "escalationId": {
    "description": "Escalation ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "replyBody": {
    "description": "Reply body if send_reply",
    "type": "string"
   },
   "resolution": {
    "description": "Resolution notes",
    "type": "string"
   }
  },
  "required": [
   "escalationId",
   "resolution",
   "actionType"
  ],
  "type": "object"
 },
 "name": "resolve_escalation",
 "title": "Resolve escalation"
}
