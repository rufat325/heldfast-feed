{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Retrieve metadata of an object without returning the object body (HEAD request)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Name of the bucket",
    "type": "string"
   },
   "objectName": {
    "description": "Object key (path) to get metadata for",
    "type": "string"
   }
  },
  "required": [
   "bucketName",
   "objectName"
  ],
  "type": "object"
 },
 "name": "ncloud_head_object"
}
