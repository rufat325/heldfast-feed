    "type": "string"
   }
  },
  "required": [
   "status",
   "artist",
   "discography_complete",
   "release_count",
   "releases",
   "resolved_as",
   "did_you_mean",
   "resolved_at"
  ],
  "type": "object"
 },
 "title": "Artist discography"
}
