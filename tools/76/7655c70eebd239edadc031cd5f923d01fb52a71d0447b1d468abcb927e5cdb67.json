{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a member"
 },
 "description": "Update fields on an existing member. Only the fields you pass are sent. Emails and phones passed here are ADDED (existing ones are kept). When updating custom_fields, also pass the member's membership_type. Current RMS: PUT /members/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "active": {
    "description": "Set false to make the member inactive (reversible).",
    "type": "boolean"
   },
   "custom_fields": {
    "additionalProperties": {},
    "description": "Custom field values by field name.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Notes about the member.",
    "type": "string"
   },
   "emails": {
    "description": "Email addresses to add.",
    "items": {
     "properties": {
      "address": {
       "description": "Email address.",
       "type": "string"
      },
      "type_id": {
       "description": "Email type list-value id (4001 = Work in a default setup).",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "member_id": {
    "description": "The member id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "membership_type": {
    "description": "The member's EXISTING type \u2014 required by the API when updating custom_fields.",
    "enum": [
     "Organisation",
     "Contact",
     "Venue",
     "User"
    ],
    "type": "string"
   },
   "name": {
    "description": "New name.",
    "minLength": 1,
    "type": "string"
   },
   "phones": {
    "description": "Phone numbers to add.",
    "items": {
     "properties": {
      "number": {
       "description": "Phone number.",
       "type": "string"
      },
      "type_id": {
       "description": "Phone type list-value id (6001 = Work in a default setup).",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "number"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "tag_list": {
    "description": "Replacement tag list.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "member_id"
  ],
  "type": "object"
 },
 "name": "current_rms_update_member",
 "title": "Update a member"
}
