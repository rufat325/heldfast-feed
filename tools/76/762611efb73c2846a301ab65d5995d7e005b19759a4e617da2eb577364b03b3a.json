{
 "annotations": {
  "readOnlyHint": true,
  "title": "Approximate term match"
 },
 "description": "Fuzzy match a term against RxNorm names \u2014 tolerant of abbreviations, misspellings, and extra words. RxNav REST: GET /approximateTerm.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "maxEntries": {
    "description": "Max candidates to return. Default 20.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "option": {
    "description": "0 = current concepts (default), 1 = include obsolete.",
    "enum": [
     "0",
     "1"
    ],
    "type": "string"
   },
   "term": {
    "description": "Search term, e.g. 'zocor 10 mg'.",
    "type": "string"
   }
  },
  "required": [
   "term"
  ],
  "type": "object"
 },
 "name": "rxnorm_get_approximate_match",
 "title": "Approximate term match"
}
