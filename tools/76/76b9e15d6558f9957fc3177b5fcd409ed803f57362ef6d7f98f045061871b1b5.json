{
 "description": "Create a new travel itinerary for a destination. Returns the itinerary ID and polls for completion automatically. The generation takes 30-60 seconds.",
 "inputSchema": {
  "properties": {
   "budget": {
    "description": "Budget level",
    "enum": [
     "budget",
     "moderate",
     "luxury"
    ],
    "type": "string"
   },
   "days": {
    "description": "Number of days (1-30)",
    "maximum": 30,
    "minimum": 1,
    "type": "number"
   },
   "destination": {
    "description": "Travel destination (city, country, or region)",
    "type": "string"
   },
   "preferences": {
    "description": "Travel preferences (e.g., \"food and culture\", \"adventure\", \"budget\")",
    "type": "string"
   },
   "start_date": {
    "description": "Trip start date (YYYY-MM-DD format)",
    "type": "string"
   },
   "travelers": {
    "description": "Number of travelers",
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "destination",
   "days"
  ],
  "type": "object"
 },
 "name": "create_itinerary"
}
