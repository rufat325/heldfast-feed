{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Raw text completion"
 },
 "description": "LLM text generation / chat completion: a raw completion from your prompt with optional system message, max_tokens and temperature; Gemini by default, other configured models by provider and model. Use it for drafting, rewriting, translation, classification or any prompt, paid per call with no API key or account. Input: prompt. Answer grounded in your own text: llm.analyze. $0.25 per call. Returns: text, model, provider, finish_reason, usage{input_tokens,output_tokens}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "Optional answer language, BCP-47 (en, ja, pt-BR). Default: the input's.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "max_tokens": {
    "description": "1-4096, default 1024.",
    "type": "integer"
   },
   "model": {
    "description": "Optional: a specific model from that provider.",
    "type": "string"
   },
   "prompt": {
    "description": "The prompt.",
    "type": "string"
   },
   "provider": {
    "description": "Optional: gemini or anthropic.",
    "type": "string"
   },
   "system": {
    "description": "Optional system message.",
    "type": "string"
   },
   "temperature": {
    "description": "0-2, default 0.7.",
    "type": "number"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "hubvibe_llm_generate",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attribution": {
    "items": {},
    "type": "array"
   },
   "billing_warning": {
    "type": "string"
   },
   "price_usd": {
    "type": "number"
   },
   "provenance": {
    "type": "object"
   },
   "receipt_id": {
    "type": "string"
   },
   "receipt_url": {
    "type": "string"
   },
   "result": {
    "type": "object"
   },
   "status": {
    "const": "ok",
    "type": "string"
   },
   "worker": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "worker",
   "price_usd",
   "result",
   "provenance",
   "receipt_id",
   "receipt_url"
  ],
  "type": "object"
 },
 "title": "Raw text completion"
}
