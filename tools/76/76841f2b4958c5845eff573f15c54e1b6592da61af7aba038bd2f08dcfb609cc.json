  "title": "Contract Testing: Publish Consumer Contracts"
 },
 "description": "Publish one or more consumer Pact contracts to the Pact Broker or PactFlow, with branch and tag metadata.\n\n**Toolset:** Contracts\n\n**Parameters:**\n- pacticipantName (string) *required*: Name of the consumer application\n- pacticipantVersionNumber (string) *required*: Version number of the consumer\n- contracts (array) *required*: Contracts to publish\n- tags (array): Version tags (e.g. 'main', 'staging')\n- branch (string): Branch name of the consumer\n- buildUrl (string): URL of the CI build that produced these contracts",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "branch": {
    "description": "Branch name of the consumer",
    "type": "string"
   },
   "buildUrl": {
    "description": "URL of the CI build that produced these contracts",
    "type": "string"
   },
   "contracts": {
    "description": "Contracts to publish",
    "items": {
     "properties": {
      "consumerName": {
       "description": "Consumer application name",
       "type": "string"
      },
      "content": {
       "description": "Base64-encoded Pact JSON content",
       "type": "string"
      },
      "contentType": {
       "const": "application/json",
       "description": "Content type (must be 'application/json')",
       "type": "string"
      },
      "providerName": {
       "description": "Provider application name",
       "type": "string"
      },
      "specification": {
       "const": "pact",
       "description": "Specification type (must be 'pact')",
       "type": "string"
      }
     },
     "required": [
      "consumerName",
      "providerName",
      "content",
      "contentType",
      "specification"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pacticipantName": {
    "description": "Name of the consumer application",
    "minLength": 1,
    "type": "string"
   },
   "pacticipantVersionNumber": {
    "description": "Version number of the consumer",
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Version tags (e.g. 'main', 'staging')",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "pacticipantName",
   "pacticipantVersionNumber",
   "contracts"
  ],
  "type": "object"
 },
