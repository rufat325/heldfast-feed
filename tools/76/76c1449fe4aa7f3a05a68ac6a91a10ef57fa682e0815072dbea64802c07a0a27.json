{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Record up to 200 results into an existing run \u2014 status, duration, comment, stacktrace, attachments \u2014 in one call, not one per test. Status is a label only: passed, failed, blocked, skipped, invalid. If the run does not exist yet and the job is finished, qase_ci_report creates, records and completes in one call. Cost: one API call for the whole list, about 0.5s.",
 "inputSchema": {
  "properties": {
   "code": {
    "description": "Project code, e.g. DEMO",
    "maxLength": 10,
    "minLength": 2,
    "pattern": "^[A-Z0-9_]+$",
    "type": "string"
   },
   "results": {
    "description": "Results to record, 1 to 200 per call",
    "items": {
     "properties": {
      "attachments": {
       "description": "Hashes from qase_attachment_upload",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "case_id": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "comment": {
       "type": "string"
      },
      "custom_field": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "defect": {
       "type": "boolean"
      },
      "stacktrace": {
       "type": "string"
      },
      "status": {
       "enum": [
        "passed",
        "failed",
        "blocked",
        "skipped",
        "invalid"
       ],
       "type": "string"
      },
      "steps": {
       "items": {
        "properties": {
         "attachments": {
          "description": "Hashes from qase_attachment_upload",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "comment": {
          "type": "string"
         },
         "position": {
          "minimum": 0,
          "type": "integer"
         },
         "status": {
          "enum": [
           "passed",
           "failed",
           "blocked",
           "skipped"
          ],
          "type": "string"
         }
        },
        "required": [
         "position",
         "status"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "time_ms": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "status"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "run_id": {
    "description": "Run ID to record results into",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "code",
   "run_id",
   "results"
  ],
  "type": "object"
 },
 "name": "qase_result_record",
 "title": "Record test results"
}
