{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add interview rounds to an interview plan draft"
 },
 "description": "Add interview rounds to a draft exactly as written \u2014 deterministic, no AI generation. Requires skills; the resulting sequence must stay within 20 rounds. Optional source_stage {stage: interview_sequence, version} returns 409 when stale.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.add_rounds",
    "type": "string"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "maxLength": 5000,
         "type": "string"
        },
        "duration": {
         "maximum": 480,
         "minimum": 0,
         "type": "integer"
        },
        "id": {
         "maxLength": 128,
         "type": "string"
        },
        "interviewerGuidance": {
         "maxLength": 5000,
         "type": "string"
        },
        "name": {
         "maxLength": 300,
         "type": "string"
        },
        "primaryFocus": {
         "maxLength": 500,
         "type": "string"
        },
        "purpose": {
         "maxLength": 5000,
         "type": "string"
        },
        "questionTypes": {
         "items": {
          "maxLength": 300,
          "type": "string"
         },
         "maxItems": 50,
         "type": "array"
        },
        "recommendedQuestionCount": {
         "maximum": 100,
         "minimum": 0,
         "type": "integer"
        },
        "round": {
         "maxLength": 300,
         "type": "string"
        },
        "title": {
         "maxLength": 300,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "source_stage": {
      "additionalProperties": false,
      "properties": {
       "stage": {
        "const": "interview_sequence",
        "type": "string"
       },
       "version": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "stage"
      ],
      "type": "object"
     }
    },
    "required": [
     "items"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "type": {
      "const": "interview_plan_draft",
      "type": "string"
     }
    },
    "required": [
     "type",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "resource",
   "input"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plan_drafts_add_rounds",
 "title": "Add interview rounds to an interview plan draft"
}
