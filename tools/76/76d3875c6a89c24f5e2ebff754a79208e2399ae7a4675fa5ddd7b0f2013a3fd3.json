{
 "description": "Create or replace a project flow with two to eight ordered steps and exact origins. Owner/admin only. Edits start a new report version.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "definition": {
    "additionalProperties": false,
    "properties": {
     "display_name": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "flow_key": {
      "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
      "type": "string"
     },
     "kind": {
      "enum": [
       "acquisition",
       "activation"
      ],
      "type": "string"
     },
     "steps": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "display_name": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "origin": {
         "maxLength": 255,
         "type": "string"
        },
        "step_key": {
         "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
         "type": "string"
        }
       },
       "required": [
        "step_key",
        "display_name",
        "origin"
       ],
       "type": "object"
      },
      "maxItems": 8,
      "minItems": 2,
      "type": "array"
     },
     "timeout_minutes": {
      "default": 60,
      "maximum": 1440,
      "minimum": 10,
      "type": "integer"
     }
    },
    "required": [
     "flow_key",
     "display_name",
     "kind",
     "steps"
    ],
    "type": "object"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "definition"
  ],
  "type": "object"
 },
 "name": "save_analytics_flow"
}
