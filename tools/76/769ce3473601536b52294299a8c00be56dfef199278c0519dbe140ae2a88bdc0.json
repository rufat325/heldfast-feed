{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check whether a custom deployment is connected for Git-push auto-deploy. Returns Git URL, branch, mode (github, manual or none), enabled state and payload URL. Check this before connecting: image and manifest deployments do not have a tracked Git source.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_git_webhook_status",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "branch": {
      "type": "string"
     },
     "enabled": {
      "type": "boolean"
     },
     "git_url": {
      "type": "string"
     },
     "mode": {
      "enum": [
       "github",
       "manual",
       "none"
      ],
      "type": "string"
     },
     "payload_url": {
      "type": "string"
     },
     "webhook_id": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "git_url",
     "branch",
     "mode",
     "webhook_id",
     "enabled",
     "payload_url"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Check git auto-deploy"
}
