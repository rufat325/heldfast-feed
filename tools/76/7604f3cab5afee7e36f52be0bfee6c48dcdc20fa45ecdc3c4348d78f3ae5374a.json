 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Remix staff picks"
 },
 "description": "Use this when the user wants a game to play without naming one, such as \"find me a quick puzzle game\", \"something fun to play on my phone\" or \"racing games for my computer\". Returns free, quick-to-start browser games on remix.gg, Remix staff picks first, optionally in one genre, then that genre's most played.",
 "inputSchema": {
  "properties": {
   "genre": {
    "description": "A Remix genre, such as puzzle, racing, match-3, soccer or roguelite",
    "enum": [
     "action",
     "adventure",
     "basketball",
     "board",
     "card",
     "casual",
     "clicker",
     "cooking",
     "driving",
     "education",
     "fighting",
     "flying",
     "football",
     "golf",
     "kids",
     "match-3",
     "music",
     "platformer",
     "puzzle",
     "racing",
     "roguelite",
     "rpg",
     "shooter",
     "simulation",
     "soccer",
     "sports",
     "strategy",
     "trivia",
     "word"
    ],
    "type": "string"
   },
   "limit": {
    "default": 6,
    "description": "How many games to return",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "madeFor": {
    "default": "any",
    "description": "Only games made for this device. Every game also plays in a computer browser on remix.gg.",
    "enum": [
     "phone",
     "computer",
     "any"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "top_games",
