{
 "description": "Configure optimizer behavior: mode, threshold, strictness, default target, ephemeral mode, session limits. Supports config locking with passphrase protection.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audit_log": {
    "description": "Enable append-only JSONL audit trail (default: false)",
    "type": "boolean"
   },
   "auto_compile": {
    "description": "Auto-compile prompts",
    "type": "boolean"
   },
   "default_target": {
    "description": "Default output target",
    "enum": [
     "claude",
     "openai",
     "generic"
    ],
    "type": "string"
   },
   "ephemeral_mode": {
    "description": "Ephemeral mode: sessions in-memory only",
    "type": "boolean"
   },
   "lock": {
    "description": "Lock config \u2014 prevents changes until unlocked with the same secret",
    "type": "boolean"
   },
   "lock_secret": {
    "description": "Passphrase to lock/unlock config (min 4 chars). Stored as SHA-256 hash only.",
    "maxLength": 128,
    "minLength": 4,
    "type": "string"
   },
   "max_session_dir_mb": {
    "description": "Max session directory size in MB",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "max_session_size_kb": {
    "description": "Max session size in KB",
    "maximum": 1024,
    "minimum": 1,
    "type": "number"
   },
   "max_sessions": {
    "description": "Max session count",
    "maximum": 10000,
    "minimum": 1,
    "type": "number"
   },
   "mode": {
    "description": "Optimization mode",
    "enum": [
     "manual",
     "always_on"
    ],
    "type": "string"
   },
   "policy_mode": {
    "description": "Policy enforcement mode (default: advisory)",
    "enum": [
     "advisory",
     "enforce"
    ],
    "type": "string"
   },
   "session_retention_days": {
    "description": "Auto-purge sessions older than N days (undefined = no auto-purge)",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "strictness": {
    "description": "Strictness level",
    "enum": [
     "relaxed",
     "standard",
     "strict"
    ],
    "type": "string"
   },
   "threshold": {
    "description": "Quality threshold (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "unlock": {
    "description": "Unlock config \u2014 requires the same secret used to lock",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "configure_optimizer"
}
