{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Converts verified natal placements to Lal Kitab fixed houses and returns source locators for all nine planet-house sections. Prediction prose, annual-chart emulation and remedies remain withheld until atomic extraction, scan verification and lineage review.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "birthTimeAccuracyMinutes": {
    "default": 5,
    "maximum": 1440,
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "name",
   "date",
   "time"
  ],
  "type": "object"
 },
 "name": "analyze_lal_kitab",
 "outputSchema": {
  "properties": {
   "blockedOutputs": {
    "type": "array"
   },
   "conjunctions": {
    "type": "array"
   },
   "controlledDisclosurePolicy": {
    "type": "object"
   },
   "conversion": {
    "type": "object"
   },
   "placements": {
    "type": "array"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-lal-kitab-structure-1"
   },
   "sourceCoverage": {
    "type": "object"
   },
   "tradition": {
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "tradition",
   "conversion",
   "placements",
   "conjunctions",
   "sourceCoverage",
   "controlledDisclosurePolicy",
   "blockedOutputs",
   "safety"
  ],
  "type": "object"
 },
 "title": "Inspect Lal Kitab house structure and source sections"
}
