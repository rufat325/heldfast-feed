{
 "description": "Creates a new tag that can be assigned to monitors.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "Tag color as a hex string (e.g. \"#ff0000\") or CSS color name",
    "type": "string"
   },
   "name": {
    "description": "Tag name",
    "type": "string"
   }
  },
  "required": [
   "name",
   "color"
  ],
  "type": "object"
 },
 "name": "addTag",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "msg": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "tag": {
    "additionalProperties": false,
    "properties": {
     "color": {
      "type": "string"
     },
     "id": {
      "type": "number"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "color"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Add Tag"
}
