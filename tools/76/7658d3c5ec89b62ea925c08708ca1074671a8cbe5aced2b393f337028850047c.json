{"description":"\u064a\u0646\u0634\u0626 \u0631\u0627\u0628\u0637\u064b\u0627 \u0645\u0633\u0628\u0642 \u0627\u0644\u062a\u0639\u0628\u0626\u0629 \u064a\u0641\u062a\u062d \u0645\u0648\u0644\u0651\u062f \u0627\u0644\u0631\u064a\u0644\u0632 \u0627\u0644\u0642\u0631\u0622\u0646\u064a \u0639\u0644\u0649 \u0627\u0644\u0633\u0648\u0631\u0629 \u0648\u0627\u0644\u0646\u0637\u0627\u0642 \u0627\u0644\u0645\u0637\u0644\u0648\u0628\u064a\u0646 \u062c\u0627\u0647\u0632\u064b\u0627 \u0644\u0644\u0645\u0639\u0627\u064a\u0646\u0629 \u0648\u0627\u0644\u062a\u0635\u062f\u064a\u0631 (\u062d\u062a\u0649 30 \u0622\u064a\u0629)\u060c \u0645\u0639 \u0625\u0645\u0643\u0627\u0646\u064a\u0629 \u062a\u0639\u064a\u064a\u0646 \u0627\u0644\u0642\u0627\u0631\u0626 \u0645\u0633\u0628\u0642\u064b\u0627. \u0627\u0633\u062a\u062f\u0639\u0650\u0647\u0627 \u062d\u064a\u0646 \u064a\u0637\u0644\u0628 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0635\u0646\u0627\u0639\u0629/\u062a\u062d\u0645\u064a\u0644 \u0641\u064a\u062f\u064a\u0648 \u0644\u0622\u064a\u0627\u062a \u0628\u0639\u064a\u0646\u0647\u0627.","inputSchema":{"additionalProperties":false,"properties":{"from_ayah":{"description":"\u0622\u064a\u0629 \u0627\u0644\u0628\u062f\u0627\u064a\u0629 (\u0627\u0641\u062a\u0631\u0627\u0636\u064a 1)","minimum":1,"type":"integer"},"reciter":{"description":"folder \u0627\u0644\u0642\u0627\u0631\u0626 \u0627\u062e\u062a\u064a\u0627\u0631\u064a\u064b\u0627 (\u0645\u062b\u0644 Alafasy_128kbps) \u0644\u064a\u064f\u0633\u0628\u0642 \u0627\u062e\u062a\u064a\u0627\u0631\u0647 \u0641\u064a \u0627\u0644\u0645\u0648\u0644\u0651\u062f","type":"string"},"surah":{"maximum":114,"minimum":1,"type":"integer"},"to_ayah":{"description":"\u0622\u064a\u0629 \u0627\u0644\u0646\u0647\u0627\u064a\u0629 (\u0627\u0641\u062a\u0631\u0627\u0636\u064a from_ayah\u060c \u0623\u0642\u0635\u0649 30)","minimum":1,"type":"integer"}},"required":["surah"],"type":"object"},"name":"create_reel"}
