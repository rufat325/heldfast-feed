{
 "_meta": {
  "anthropic/maxResultSizeChars": 150000
 },
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save a new page-by-page outline for a deck (pages written for the old one are dropped). The reply carries PAGE 1'S BRIEF; each submit_page reply carries the next page's.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deck_id": {
    "maxLength": 40,
    "minLength": 10,
    "type": "string"
   },
   "guest_token": {
    "description": "Only for a deck created WITHOUT an account: the guest_token create_deck returned.",
    "maxLength": 80,
    "type": "string"
   },
   "pages": {
    "items": {
     "properties": {
      "content": {
       "description": "The approved copy. Every numeral here must come from the user's material \u2014 the deck's truth check enforces it.",
       "properties": {
        "bullets": {
         "description": "Up to 6 short points; no walls.",
         "items": {
          "maxLength": 160,
          "type": "string"
         },
         "maxItems": 6,
         "type": "array"
        },
        "caption": {
         "description": "Small mono caption, e.g. a source line.",
         "maxLength": 200,
         "type": "string"
        },
        "cta": {
         "properties": {
          "primary": {
           "maxLength": 60,
           "type": "string"
          },
          "secondary": {
           "maxLength": 80,
           "type": "string"
          }
         },
         "required": [
          "primary"
         ],
         "type": "object"
        },
        "eyebrow": {
         "description": "Tiny label above the headline, e.g. 'THE PROBLEM'.",
         "maxLength": 60,
         "type": "string"
        },
        "headline": {
         "description": "The one strong display line.",
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "lede": {
         "description": "Supporting sentence or two.",
         "maxLength": 400,
         "type": "string"
        },
        "meta": {
         "description": "Stat tiles as label/value pairs \u2014 ONLY figures the user gave you.",
         "items": {
          "properties": {
           "label": {
            "maxLength": 60,
            "type": "string"
           },
           "value": {
            "maxLength": 60,
            "type": "string"
           }
          },
          "required": [
           "label",
           "value"
          ],
          "type": "object"
         },
         "maxItems": 6,
         "type": "array"
        }
       },
       "required": [
        "headline"
       ],
       "type": "object"
      },
      "description": {
       "description": "What this page must accomplish in the argument, one or two sentences. Not shown on the page.",
       "maxLength": 600,
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "description": "Short page title, 2-6 words (e.g. 'The Tracker Tax').",
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "visual_concept": {
       "description": "The composition and the one graphic device that expresses the page's argument: layout, the diagram/chart/mock, where the headline sits, colours by role. Concrete enough to draw from.",
       "maxLength": 1200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "label",
      "description",
      "visual_concept",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "minItems": 1,
    "type": "array"
   },
   "tone": {
    "description": "The register, e.g. 'confident, technical, CTO-to-CTO'.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "deck_id",
   "pages"
  ],
  "type": "object"
 },
 "name": "write_outline",
 "title": "Write the outline"
}
