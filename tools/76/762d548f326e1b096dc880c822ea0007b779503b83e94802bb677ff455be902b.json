 "description": "Get EIA petroleum time series data for a specific product (gasoline, diesel, crude, stocks, supply, production, imports). Returns prices or volumes by period with regional breakdowns. Requires free EIA API key.supply, production, and imports. Simplified interface to common EIA petroleum series.",
 "inputSchema": {
  "examples": [
   {
    "product": "gasoline"
   },
   {
    "frequency": "weekly",
    "product": "crude",
    "start": "2023-01-01"
   }
  ],
  "properties": {
   "_apiKey": {
    "description": "EIA API key",
    "type": "string"
   },
   "area": {
    "description": "Retail prices only: \"US\" (default, national average), \"all\" (every region EIA reports), or an EIA area code such as \"R10\" (East Coast) or \"SCA\" (California).",
    "type": "string"
   },
   "end": {
    "description": "End date (optional)",
    "type": "string"
   },
   "frequency": {
    "description": "Frequency: \"weekly\", \"monthly\", \"annual\" (optional; retail prices default to weekly)",
    "type": "string"
   },
   "grade": {
    "description": "Gasoline grade, for product \"gasoline\" only: \"regular\" (default \u2014 the national headline price), \"midgrade\", \"premium\", or \"all\" (all grades combined).",
    "enum": [
     "regular",
     "midgrade",
     "premium",
     "all"
    ],
    "type": "string"
   },
   "product": {
    "description": "Product type: \"gasoline\" (retail pump price), \"diesel\" (retail pump price), \"crude\" (WTI spot), \"stocks\", \"supply\", \"production\", \"imports\"",
    "type": "string"
   },
   "start": {
    "description": "Start date (optional)",
    "type": "string"
   }
  },
  "required": [
