{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Schedule a selected existing video asset to explicit active YouTube, Instagram, Facebook, TikTok, LinkedIn or Threads accounts connected in the BlitzReels UI, using reviewed copy, privacy/consent choices, synthetic-media disclosure, time and timezone. Requires confirmPublish=true. Existing workspace permissions and provider access rules apply. A scheduled receipt is not proof of publication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "affiliate_cta_text": {
    "anyOf": [
     {
      "maxLength": 80,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "affiliate_tracking_url": {
    "anyOf": [
     {
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "caption": {
    "anyOf": [
     {
      "maxLength": 5000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "confirmPublish": {
    "const": true,
    "type": "boolean"
   },
   "contains_synthetic_media": {
    "type": "boolean"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "include_affiliate_cta": {
    "type": "boolean"
   },
   "media_asset_id": {
    "type": "string"
   },
   "project_name": {
    "anyOf": [
     {
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduled_for": {
    "type": "string"
   },
   "targets": {
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "connection_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "platform": {
         "const": "linkedin",
         "type": "string"
        }
       },
       "required": [
        "platform"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "connection_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "platform": {
         "const": "threads",
         "type": "string"
        }
       },
       "required": [
        "platform"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "connection_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "description": {
         "anyOf": [
          {
           "maxLength": 5000,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "made_for_kids": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "platform": {
         "const": "youtube",
         "type": "string"
        },
        "privacy_status": {
         "anyOf": [
          {
           "enum": [
            "private",
            "unlisted",
            "public"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "title": {
         "anyOf": [
          {
           "maxLength": 100,
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "platform"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "connection_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "platform": {
         "const": "instagram",
         "type": "string"
        },
        "share_to_feed": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "trial_graduation_strategy": {
         "anyOf": [
          {
           "enum": [
            "MANUAL",
            "SS_PERFORMANCE"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "trial_reel": {
         "type": [
          "boolean",
          "null"
         ]
        }
       },
       "required": [
        "platform"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "connection_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "platform": {
         "const": "facebook",
         "type": "string"
        },
        "title": {
         "anyOf": [
          {
           "maxLength": 255,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "platform"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "allow_comment": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "allow_duet": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "allow_stitch": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "brand_organic": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "branded_content": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "commercial_content_enabled": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "connection_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "consent_accepted": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "cover_timestamp_ms": {
         "anyOf": [
          {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "is_ai_generated": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "platform": {
         "const": "tiktok",
         "type": "string"
        },
        "privacy_level": {
         "anyOf": [
          {
           "enum": [
            "PUBLIC_TO_EVERYONE",
            "FOLLOWER_OF_CREATOR",
            "MUTUAL_FOLLOW_FRIENDS",
            "SELF_ONLY"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "publish_mode": {
         "anyOf": [
          {
           "enum": [
            "direct_post",
            "draft"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "platform"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "timezone": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "media_asset_id",
   "contains_synthetic_media",
   "scheduled_for",
   "targets",
   "workspaceId",
   "idempotencyKey",
   "confirmPublish"
  ],
  "type": "object"
 },
 "name": "publishing_video_schedule",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Schedule Reviewed Video Publication"
}
