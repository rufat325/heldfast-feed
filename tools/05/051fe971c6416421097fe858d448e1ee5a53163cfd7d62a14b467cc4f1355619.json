{
 "description": "[mode: real] Generate GitHub Actions / Jenkins / GitLab CI configuration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "branches": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "buildCommand": {
    "type": "string"
   },
   "platform": {
    "enum": [
     "ios",
     "android",
     "flutter",
     "react-native",
     "web"
    ],
    "type": "string"
   },
   "projectPath": {
    "type": "string"
   },
   "provider": {
    "enum": [
     "github-actions",
     "jenkins",
     "gitlab-ci"
    ],
    "type": "string"
   },
   "testCommand": {
    "type": "string"
   },
   "writeToFile": {
    "type": "boolean"
   }
  },
  "required": [
   "projectPath",
   "provider"
  ],
  "type": "object"
 },
 "name": "generate_cicd_config"
}
