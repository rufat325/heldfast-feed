{
 "description": "List all user searches. Returns a paginated list filtered by status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "description": "Page number (100 results per page)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "show": {
    "description": "Filter by status (default: all)",
    "enum": [
     "all",
     "started",
     "finished",
     "pending",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_user_searches"
}
