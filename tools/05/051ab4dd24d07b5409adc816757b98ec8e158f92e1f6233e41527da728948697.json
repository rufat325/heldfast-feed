{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search everything"
 },
 "description": "One text search across clinics, pharmacies, products, strains and brands. Use it when you do not yet know which kind the question is about, or to turn a name into a slug; then call the specific tool, which returns more detail. Returns names, kinds, slugs and page URLs only \u2014 no prices, stock or medical information.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Most results per kind, 1-20. Default 8.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to look for: a name, brand, strain, town or postcode.",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_findabis",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "clinic",
        "pharmacy",
        "product",
        "strain",
        "brand"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "anyOf": [
        {
         "format": "uri",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Canonical Findabis page, absolute; null when the listing has no page"
      }
     },
     "required": [
      "kind",
      "name",
      "slug",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search everything"
}
