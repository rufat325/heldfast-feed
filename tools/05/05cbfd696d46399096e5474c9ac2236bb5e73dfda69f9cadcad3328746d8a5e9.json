{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Plan the work"
 },
 "description": "Plans for migrations, experiments and the team. Pick with mode: redirects = Redirect map for a migration or URL change. split_test = SEO split test on a page template, with the Worker. Needs urls, field, pattern. sprint = Fixes into a week plan of tickets per role. Needs fixes[{title, url, detail, severity, impact, effort}].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "clicks": {
    "description": "Optional clicks per page for a balanced split.",
    "items": {
     "properties": {
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "url",
      "clicks"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "field": {
    "description": "What to change.",
    "enum": [
     "title",
     "description"
    ],
    "type": "string"
   },
   "fixes": {
    "items": {
     "properties": {
      "detail": {
       "maxLength": 600,
       "type": "string"
      },
      "effort": {
       "enum": [
        "small",
        "medium",
        "large"
       ],
       "type": "string"
      },
      "impact": {
       "description": "Clicks or revenue at stake, any unit, used to rank.",
       "minimum": 0,
       "type": "number"
      },
      "role": {
       "enum": [
        "dev",
        "content",
        "outreach"
       ],
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "type": "string"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "maxItems": 300,
    "minItems": 1,
    "type": "array"
   },
   "format": {
    "description": "Output format, default redirects (Cloudflare Pages and Netlify).",
    "enum": [
     "redirects",
     "nginx",
     "apache",
     "nextjs",
     "csv"
    ],
    "type": "string"
   },
   "hours": {
    "additionalProperties": false,
    "description": "Hours per week per role, default 8 each.",
    "properties": {
     "content": {
      "maximum": 80,
      "minimum": 0,
      "type": "number"
     },
     "dev": {
      "maximum": 80,
      "minimum": 0,
      "type": "number"
     },
     "outreach": {
      "maximum": 80,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "mode": {
    "description": "Default redirects.",
    "enum": [
     "redirects",
     "split_test",
     "sprint"
    ],
    "type": "string"
   },
   "new_site": {
    "description": "New site address, to read its sitemap instead of new_urls.",
    "maxLength": 2048,
    "type": "string"
   },
   "new_urls": {
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "old_site": {
    "description": "Old site address, to read its sitemap instead of old_urls.",
    "maxLength": 2048,
    "type": "string"
   },
   "old_urls": {
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "pattern": {
    "description": "The new value with {title} or {description} as placeholders.",
    "maxLength": 200,
    "type": "string"
   },
   "start_date": {
    "description": "Optional planned start, YYYY-MM-DD.",
    "maxLength": 2000,
    "type": "string"
   },
   "urls": {
    "description": "Pages of one template.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 20,
    "type": "array"
   },
   "weeks": {
    "description": "Weeks to plan, default 4.",
    "maximum": 12,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "plan",
 "outputSchema": {
  "type": "object"
 },
 "title": "Plan the work"
}
