{"_meta":{"securitySchemes":[{"scopes":["research:read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Answer a focused options question"},"description":"Requires a SignalDock account connection. Expected move, near-money skew/activity or IV history for one equity or futures root. At most five provider operations. Skew/activity require expiration. Coverage is bounded, never whole-chain totals. API reference: https://www.signaldock.app/developers/openapi.json.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"expiration":{"format":"date","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$","type":"string"},"history_days":{"maximum":1905,"minimum":1,"type":"integer"},"limit":{"default":25,"maximum":100,"minimum":1,"type":"integer"},"offset":{"default":0,"maximum":1000000,"minimum":0,"type":"integer"},"path":{"default":[],"description":"Object keys or array indices from the returned field directory. Empty selects the root.","items":{"maxLength":100,"minLength":1,"type":"string"},"maxItems":8,"type":"array"},"question":{"enum":["expected_move","skew","activity","iv_history"],"type":"string"},"strike_count":{"maximum":25,"minimum":1,"type":"integer"},"symbol":{"pattern":"^\\/?[A-Z0-9][A-Z0-9./-]{0,19}$","type":"string"}},"required":["symbol","question"],"type":"object"},"name":"options_question","title":"Answer a focused options question"}
