  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "opening": {
    "description": "Opening name or slug, e.g. \"London System\", \"caro-kann\", \"Sicilian Najdorf\".",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "opening"
  ],
  "type": "object"
 },
 "name": "get_opening_guide",
