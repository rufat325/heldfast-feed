 "description": "Use this tool to check whether a protocol pricing off Hyperliquid's raw mid (instead of mark/oracle) is currently exposed to a mid-price swing - the exact failure mode behind the 2026-10-10 Papertrade incident on HyperEVM. elevated is a fixed-threshold flag (abs(mid_oracle_gap_bp) >= alert_threshold_bp), not a manipulation determination. Single snapshot, no trade-flow/volume data (Hyperliquid doesn't expose it). Paid in USDC on Base.",
 "inputSchema": {
  "properties": {
   "coin": {
    "description": "Hyperliquid perpetual ticker, e.g. ETH or BTC.",
    "type": "string"
   }
  },
  "required": [
   "coin"
  ],
  "type": "object"
 },
 "name": "market.oracle_gap",
 "outputSchema": {
  "properties": {
   "alert_threshold_bp": {
    "type": "number"
   },
   "coin": {
    "type": "string"
   },
   "data_source": {
    "type": "string"
   },
   "elevated": {
    "description": "True when abs(mid_oracle_gap_bp) >= alert_threshold_bp. A fixed-threshold boolean, not a manipulation determination - see notice.",
    "type": "boolean"
   },
   "generated_at": {
    "properties": {
     "kst": {
      "type": "string"
     },
     "utc": {
      "type": "string"
     }
    },
    "required": [
     "utc",
     "kst"
    ],
    "type": "object"
   },
   "mark_oracle_gap_bp": {
    "description": "(mark_price - oracle_price) / oracle_price * 10000, in basis points.",
    "type": [
     "number",
     "null"
    ]
   },
   "mark_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "mid_oracle_gap_bp": {
    "description": "(mid_price - oracle_price) / oracle_price * 10000, in basis points.",
    "type": [
     "number",
     "null"
    ]
   },
   "mid_price": {
    "type": [
     "number",
     "null"
    ]
   },
   "notice": {
    "type": [
     "string",
     "null"
    ]
   },
   "oracle_price": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
