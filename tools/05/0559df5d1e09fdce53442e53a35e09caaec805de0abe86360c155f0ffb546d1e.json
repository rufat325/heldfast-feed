{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"The latest observation for up to 20 instruments in ONE call. A separate tool from price.latest rather than an optional argument on it, because the two are priced differently and nothing binds a payment to a request body \u2014 one multiplexed entry point would let a caller quote the single price and send the bundle. Use this instead of looping price.latest: it is one settlement and one round trip. Codes that do not resolve come back with an error field rather than being dropped, and codes past the cap are listed in dropped_codes. Paid; charged only if at least one code resolves.","inputSchema":{"additionalProperties":false,"properties":{"codes":{"description":"Instrument codes, up to 20. Example: [\"CL\", \"BZ\", \"HG\"].","items":{"type":"string"},"minItems":1,"type":"array"}},"required":["codes"],"type":"object"},"name":"price.bundle","outputSchema":{"properties":{"count":{"type":"integer"},"dropped_codes":{"items":{"type":"string"},"type":"array"},"observations":{"items":{"properties":{"as_of":{"description":"As-of date for the observation","type":"string"},"cite":{"description":"One-line citation for agents","type":"string"},"derived":{"description":"True when value is derived","type":"boolean"},"formula":{"description":"Derivation formula when derived","type":"string"},"freshness_class":{"description":"Freshness class for the series","type":"string"},"id":{"description":"Stable observation id","type":"string"},"inputs":{"description":"Input series ids when derived","items":{"type":"string"},"type":"array"},"instrument":{"description":"Instrument code, e.g. CL","type":"string"},"license_tag":{"description":"License / redistribution tag","type":"string"},"name":{"description":"Human-readable instrument name","type":"string"},"observed_at":{"description":"ISO timestamp when observed","type":"string"},"pct_change":{"description":"Percent change vs