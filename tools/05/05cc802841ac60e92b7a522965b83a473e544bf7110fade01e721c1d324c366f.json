{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "What a model call costs per request, per day and per month at a given volume, from AI Gateway's live prices. Model ids look like 'openai/gpt-4.1-mini' or 'anthropic/claude-sonnet-4.5'.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cached_share": {
    "description": "Share of input tokens served from the prompt cache, 0 to 1",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "input_tokens": {
    "description": "Input tokens per request: system prompt, retrieved documents, history and the user's message",
    "maximum": 2000000,
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "A model id like 'openai/gpt-4.1-mini' or 'anthropic/claude-sonnet-4'",
    "maxLength": 100,
    "minLength": 3,
    "type": "string"
   },
   "output_tokens": {
    "description": "Output tokens per request: the length of a typical reply",
    "maximum": 200000,
    "minimum": 0,
    "type": "integer"
   },
   "requests_per_day": {
    "description": "Expected requests per day, for the monthly cost",
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "model",
   "input_tokens",
   "output_tokens",
   "requests_per_day"
  ],
  "type": "object"
 },
 "name": "estimate_cost",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cache_saving_per_month": {
    "type": "number"
   },
   "input_share": {
    "description": "Share of the cost that's input tokens, 0 to 1",
    "type": "number"
   },
   "model": {
    "type": "string"
   },
   "per_day": {
    "type": "number"
   },
   "per_month": {
    "type": "number"
   },
   "per_request": {
    "type": "number"
   },
   "price_source": {
    "enum": [
     "catalog",
     "fallback"
    ],
    "type": "string"
   },
   "prices_per_million": {
    "additionalProperties": false,
    "description": "Dollars per million tokens",
    "properties": {
     "cached_input": {
      "type": "number"
     },
     "input": {
      "type": "number"
     },
     "output": {
      "type": "number"
     }
    },
    "required": [
     "input",
     "cached_input",
     "output"
    ],
    "type": "object"
   }
  },
  "required": [
   "model",
   "per_request",
   "per_day",
   "per_month",
   "input_share",
   "cache_saving_per_month",
   "prices_per_million",
   "price_source"
  ],
  "type": "object"
 },
 "title": "Estimate model cost"
}
