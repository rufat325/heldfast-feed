{
 "description": "Step 2 of the workbench loop: run the physics solver on a blueprint and return a simulation snapshot plus proof metrics (pass/warn/fail). If any metric warns or fails, revise the design and re-forge with anvil.forge \u2014 iterate until all metrics pass. Only then move to anvil.export.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "blueprint": {
    "additionalProperties": true,
    "description": "Anvil blueprint: a schematic graph for one domain.",
    "properties": {
     "description": {
      "type": "string"
     },
     "domain": {
      "enum": [
       "silicon",
       "cellular",
       "quantum",
       "neural",
       "mechanical",
       "chemistry",
       "architecture",
       "metallurgy",
       "robotics",
       "machines",
       "optics",
       "sky"
      ],
      "type": "string"
     },
     "edges": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "from": {
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "params": {
         "additionalProperties": {
          "type": "number"
         },
         "type": "object"
        },
        "to": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "nodes": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "id": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "params": {
         "additionalProperties": {
          "type": "number"
         },
         "type": "object"
        },
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        },
        "z": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "scale": {
      "description": "meters per schematic unit",
      "type": "number"
     },
     "skin": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "type": "object"
   },
   "steps": {
    "default": 200,
    "description": "Solver steps of recommended dt to run before snapshotting.",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "blueprint"
  ],
  "type": "object"
 },
 "name": "anvil.solve"
}
