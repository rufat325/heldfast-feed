{
 "description": "Publishes generated documents to external platforms (Notion, GitHub Wiki, Obsidian, Confluence, Slack, or Discord).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "document": {
    "minLength": 1,
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "filename": {
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "vaultPath": {
      "type": "string"
     },
     "wikiPath": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "platform": {
    "enum": [
     "notion",
     "github-wiki",
     "obsidian",
     "confluence",
     "slack",
     "discord"
    ],
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document",
   "platform",
   "title"
  ],
  "type": "object"
 },
 "name": "muse_publish_document"
}
