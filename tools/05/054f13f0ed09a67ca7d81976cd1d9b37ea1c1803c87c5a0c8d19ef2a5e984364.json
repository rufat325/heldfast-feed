{"description":"Turn customer requests on or off for a shop, and pick the kinds of work and the states (and optional ZIP codes) it serves (owner or office). A shop's agent can do this too, unless the owner turned agent opt-in off with network.setAgentOptIn; every change is in the activity log.","inputSchema":{"properties":{"enabled":{"type":"boolean"},"postal_codes":{"description":"Only these ZIP codes. Leave out for the whole state.","items":{"pattern":"^\\d{5}$","type":"string"},"maxItems":500,"type":"array"},"quote_new_accounts":{"description":"false: replies to accounts made in the last 7 days can't carry a price, only an offer to visit first","type":"boolean"},"shop_id":{"format":"uuid","type":"string"},"states":{"description":"US states served, like ID or US-ID. Defaults to the shop's own state.","items":{"maxLength":5,"type":"string"},"maxItems":60,"type":"array"},"trades":{"items":{"enum":["painting","fencing","gutters","roofing","siding","windows_doors","plumbing","electrical","hvac","landscaping","lawn_care","tree_service","concrete_masonry","decks_patios","flooring","drywall","carpentry","cabinets_countertops","remodeling","handyman","cleaning","pressure_washing","pest_control","junk_removal","moving","appliance_repair","garage_doors","insulation","foundation","septic","pools","solar","locksmith","other"],"type":"string"},"maxItems":40,"type":"array"}},"required":["shop_id","enabled"],"type":"object"},"name":"network_listingSet","outputSchema":{"anyOf":[{"properties":{"agent_optin":{"type":"boolean"},"area":{"type":"string"},"enabled":{"type":"boolean"},"next_actions":{"description":"Up to 3 useful next steps, best first, in plain words. op names the op to call, when there is one. when is now, later, check, or tell_human. due_at is set for later and check when there is a natural time. A send is tell_human: show the owner the draft, then send only when they say so.","items":{"properties":{"args_hint":{"type":"string"},"due_at":{"format":"date-time","type":["string","null"]},"op":{"type":["string","null"]},"say":{"type":"string"},"when":{"enum":["now","later","check","tell_human"],"type":"string"}},"required":["say","op","when"],"type":"object"},"maxItems":3,"type":"array"},"pledge":{"type":"string"},"postal_codes":{"items":{"type":"string"},"type":"array"},"prices":{"type":"string"},"quote_new_accounts":{"type":"boolean"},"shop_id":{"format":"uuid","type":"string"},"states":{"items":{"type":"string"},"type":"array"},"stripe_fee":{"type":"string"},"trades":{"items":{"type":"string"},"type":"array"},"updated_by_agent":{"type":"boolean"},"waiting_requests_delivered":{"type":"integer"}},"required":["shop_id","enabled","area","trades","states","postal_codes","quote_new_accounts","agent_optin","updated_by_agent","pledge","stripe_fee","prices","waiting_requests_delivered","next_actions"],"type":"object"},{"properties":{"approval_id":{"format":"uuid","type":"string"},"approval_required":{"enum":[true],"type":"boolean"},"expires_at":{"format":"date-time","type":"string"},"message":{"type":"string"},"status":{"enum":["pending"],"type":"string"}},"required":["approval_required","approval_id","status","expires_at","message"],"type":"object"}],"type":"object"}}
