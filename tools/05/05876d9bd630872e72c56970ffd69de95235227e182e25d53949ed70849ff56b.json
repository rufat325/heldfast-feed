{
 "description": "Reveal the committed content's digest + salt after handover. Verifies\n    against the commitment (one bit of drift fails); returns a delivery_proof\n    string for escrow release. Late reveals expire the commitment.",
 "inputSchema": {
  "properties": {
   "commitment_id": {
    "title": "Commitment Id",
    "type": "string"
   },
   "content_digest": {
    "title": "Content Digest",
    "type": "string"
   },
   "salt": {
    "title": "Salt",
    "type": "string"
   }
  },
  "required": [
   "commitment_id",
   "salt",
   "content_digest"
  ],
  "title": "revealArguments",
  "type": "object"
 },
 "name": "reveal",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "revealOutput",
  "type": "object"
 }
}
