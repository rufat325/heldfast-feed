{
 "description": "Convert a JSON array of objects to CSV. Configurable delimiter, columns, optional flattening of nested objects with dot-keys (e.g. `meta.city`). Max 50,000 rows per request.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "columns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "delimiter": {
    "default": ",",
    "type": "string"
   },
   "flatten": {
    "default": false,
    "type": "boolean"
   },
   "include_headers": {
    "default": true,
    "type": "boolean"
   },
   "json": {
    "type": "string"
   },
   "newline": {
    "default": "\n",
    "enum": [
     "\n",
     "\r\n",
     "\r"
    ],
    "type": "string"
   }
  },
  "required": [
   "json"
  ],
  "type": "object"
 },
 "name": "json_to_csv"
}
