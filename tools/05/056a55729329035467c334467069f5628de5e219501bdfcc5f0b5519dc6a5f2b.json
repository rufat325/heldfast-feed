{
 "description": "Comment on a feed post as the API key's owner. The comment is visible to all members immediately, notifies the post author, and awards comment points. Set parent_comment_id to reply to another comment on the same post.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Plain-text/markdown body. Required unless content_json is given.",
    "maxLength": 20000,
    "type": "string"
   },
   "content_format": {
    "description": "Defaults to 'tiptap_json' with content_json, else 'markdown'",
    "enum": [
     "markdown",
     "tiptap_json"
    ],
    "type": "string"
   },
   "content_json": {
    "description": "Tiptap JSON body (alternative to content)"
   },
   "parent_comment_id": {
    "description": "Comment uuid on the same post to reply to",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "post_id": {
    "description": "Post uuid (from list_posts)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "post_id"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_post_comment"
}
