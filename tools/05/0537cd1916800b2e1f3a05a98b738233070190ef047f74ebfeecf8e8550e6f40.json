{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List the organization's signing requests (the native:<id> values attach returned), newest first: status, timestamps and a masked \"First L.\" signer, never an email address. Filter by jobId, status or versionId; bounded cursor pagination (limit 1-100; pass result.nextCursor as cursor). Requires agreements:read. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "QUEUED",
     "SENT",
     "VIEWED",
     "CONSENTED",
     "SIGNED",
     "COMPLETED",
     "DECLINED",
     "VOIDED",
     "FAILED"
    ],
    "type": "string"
   },
   "versionId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "opentrain_agreements_requests_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "requests": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "assignmentId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "completedAt": {
         "anyOf": [
          {
           "format": "date-time",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "contractId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "createdAt": {
         "format": "date-time",
         "type": "string"
        },
        "documentId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "jobId": {
         "anyOf": [
          {
           "maxLength": 64,
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "lastRemindedAt": {
         "anyOf": [
          {
           "format": "date-time",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "queuedAt": {
         "anyOf": [
          {
           "format": "date-time",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "requestId": {
         "pattern": "^native:[A-Za-z0-9_-]{1,64}$",
         "type": "string"
        },
        "sentAt": {
         "anyOf": [
          {
           "format": "date-time",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "signer": {
         "additionalProperties": false,
         "properties": {
          "displayName": {
           "maxLength": 120,
           "type": "string"
          }
         },
         "required": [
          "displayName"
         ],
         "type": "object"
        },
        "status": {
         "enum": [
          "QUEUED",
          "SENT",
          "VIEWED",
          "CONSENTED",
          "SIGNED",
          "COMPLETED",
          "DECLINED",
          "VOIDED",
          "FAILED"
         ],
         "type": "string"
        },
        "updatedAt": {
         "format": "date-time",
         "type": "string"
        },
        "versionId": {
         "maxLength": 64,
         "minLength": 1,
         "type": "string"
        },
        "versionNumber": {
         "exclusiveMinimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "requestId",
        "documentId",
        "versionId",
        "versionNumber",
        "jobId",
        "contractId",
        "assignmentId",
        "status",
        "signer",
        "queuedAt",
        "sentAt",
        "lastRemindedAt",
        "completedAt",
        "createdAt",
        "updatedAt"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     }
    },
    "required": [
     "requests",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
