    "type": "integer"
   },
   "ok": {
    "type": "boolean"
   },
   "scopeNotes": {
    "type": "string"
   },
   "sheets": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok",
   "lines",
