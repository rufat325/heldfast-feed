 "description": "Run the initial AI takeoff for a new project with an attached plan PDF. This consumes one estimate from the user's existing Portravo balance; ask for explicit credit-use confirmation before setting confirm_credit_use=true. Reuse the idempotency_key on retry to prevent a duplicate charge. Returns extracted quantities for review in Portravo, not a bid-ready estimate. Failed provider runs refund the reservation; existing review work cannot be overwritten.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "confirm_credit_use": {
    "const": true,
    "type": "boolean"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9_.:-]+$",
    "type": "string"
   },
   "project_id": {
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "confirm_credit_use",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "run_takeoff",
 "outputSchema": {
