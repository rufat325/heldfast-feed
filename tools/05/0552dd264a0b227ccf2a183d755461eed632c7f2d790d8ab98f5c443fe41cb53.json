{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Log call"
 },
 "description": "Record a call you made or took (e.g. a callback), with outcome and a short summary. No real call is placed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "contactId": {
    "type": "string"
   },
   "direction": {
    "description": "Default outbound",
    "enum": [
     "inbound",
     "outbound"
    ],
    "type": "string"
   },
   "durationSec": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "employeeId": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "answered",
     "missed",
     "voicemail"
    ],
    "type": "string"
   },
   "phone": {
    "description": "Defaults to the contact's phone",
    "type": "string"
   },
   "summary": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "name": "phone_log_call",
 "title": "Log call"
}
