{
 "description": "Laminate/vinyl plank takeoff: planks, boxes and cost with offcut reuse between rows (best-fit), expansion gap, layout waste presets and direction.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "direction": {
    "default": "length",
    "description": "Plank direction",
    "enum": [
     "length",
     "width"
    ],
    "type": "string"
   },
   "expansion_mm": {
    "default": 10,
    "minimum": 0,
    "type": "number"
   },
   "layout": {
    "default": "staggered",
    "enum": [
     "straight",
     "staggered",
     "herringbone",
     "diagonal"
    ],
    "type": "string"
   },
   "min_offcut_mm": {
    "default": 300,
    "description": "Offcuts shorter than this are not reused",
    "minimum": 0,
    "type": "number"
   },
   "plank_length_mm": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "plank_width_mm": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "planks_per_box": {
    "default": 8,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "price_per_box": {
    "minimum": 0,
    "type": "number"
   },
   "price_per_m2": {
    "minimum": 0,
    "type": "number"
   },
   "room_length_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "room_width_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "waste_percent": {
    "description": "Overrides the layout default",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "room_width_m",
   "room_length_m",
   "plank_width_mm",
   "plank_length_mm"
  ],
  "type": "object"
 },
 "name": "flooring_calculator"
}
