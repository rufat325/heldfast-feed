{
 "_meta": {
  "openai/outputTemplate": "ui://hotelumo/schedule-summary-v1.html",
  "openai/toolInvocation/invoked": "Hotelumo schedule summary ready.",
  "openai/toolInvocation/invoking": "Counting Hotelumo stays\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://hotelumo/schedule-summary-v1.html"
  },
  "ui/resourceUri": "ui://hotelumo/schedule-summary-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Count arrivals, departures and stays"
 },
 "description": "Use this when someone asks how busy the hotel is, or how many arrivals, departures or in-house stays fall on each day. Returns daily counts of confirmed, checked-in and checked-out stays plus reservation totals by status, for 7 days from today by default and at most 31 days; counting stops at 500. Not for looking up a guest or reservation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateFrom": {
    "description": "First day as YYYY-MM-DD (inclusive); defaults to today in UTC",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dateTo": {
    "description": "Last day as YYYY-MM-DD (inclusive), at most 31 days in total; defaults to six days after dateFrom",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hotelId": {
    "description": "Hotel id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "hotelId"
  ],
  "type": "object"
 },
 "name": "get_hotel_schedule_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "One row per day. arrivals, departures and inHouseReservations count confirmed, checked-in and checked-out stays; a stay is not in-house on its checkout day. Reservation or allocation identifiers, individual stay records, guest data, room assignments, notes, documents, payments, access data, channel references and credentials are never returned.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "arrivals": {
       "maximum": 500,
       "minimum": 0,
       "type": "integer"
      },
      "day": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "departures": {
       "maximum": 500,
       "minimum": 0,
       "type": "integer"
      },
      "inHouseReservations": {
       "maximum": 500,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "day",
      "arrivals",
      "departures",
      "inHouseReservations"
     ],
     "type": "object"
    },
    "maxItems": 31,
    "type": "array"
   },
   "hotel": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "pattern": "^[0-9a-f]{24}$",
      "type": "string"
     },
     "name": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "timezone": {
      "$ref": "#/properties/hotel/properties/name"
     }
    },
    "required": [
     "id",
     "name",
     "timezone"
    ],
    "type": "object"
   },
   "range": {
    "additionalProperties": false,
    "properties": {
     "dateFrom": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "dateTo": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     }
    },
    "required": [
     "dateFrom",
     "dateTo"
    ],
    "type": "object"
   },
   "reservationCount": {
    "maximum": 500,
    "minimum": 0,
    "type": "integer"
   },
   "reservationCountIsLowerBound": {
    "description": "True when more than 500 reservations overlap the range",
    "type": "boolean"
   },
   "statusCounts": {
    "additionalProperties": {
     "maximum": 500,
     "minimum": 0,
     "type": "integer"
    },
    "description": "Reservations overlapping the range by status, inquiries, requests, no-shows and cancellations included",
    "propertyNames": {
     "enum": [
      "INQUIRY",
      "REQUESTED",
      "CONFIRMED",
      "CHECKED_IN",
      "CHECKED_OUT",
      "NO_SHOW",
      "CANCELED",
      "UNSPECIFIED"
     ]
    },
    "type": "object"
   }
  },
  "required": [
   "hotel",
   "range",
   "reservationCount",
   "reservationCountIsLowerBound",
   "statusCounts",
   "days"
  ],
  "type": "object"
 },
 "title": "Count arrivals, departures and stays"
}
