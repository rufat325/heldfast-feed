{
 "description": "Delete a WooCommerce product (to trash unless force)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "force": {
    "default": false,
    "description": "Delete permanently instead of moving to trash (default false)",
    "type": "boolean"
   },
   "id": {
    "description": "Product ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "woo_delete_product"
}
