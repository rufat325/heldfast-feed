{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Service Package"
 },
 "description": "Update an existing service package. Pass only the fields you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicableItems": {
    "description": "Item IDs the package can be redeemed against",
    "items": {
     "properties": {
      "itemId": {
       "type": "string"
      },
      "itemType": {
       "enum": [
        "booking_service",
        "event"
       ],
       "type": "string"
      }
     },
     "required": [
      "itemType",
      "itemId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "applicableType": {
    "description": "What this package applies to: services | products | both",
    "enum": [
     "ALL",
     "ALL_BOOKINGS",
     "ALL_EVENTS",
     "SELECTED"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Description"
   },
   "name": {
    "description": "Name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "packageId": {
    "description": "Service package ID to update",
    "type": "string"
   },
   "price": {
    "description": "Decimal string, e.g. \"80.00\"",
    "minimum": 0,
    "type": "number"
   },
   "sessionCount": {
    "description": "Number of sessions in the package",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Status filter",
    "enum": [
     "ACTIVE",
     "INACTIVE"
    ],
    "type": "string"
   },
   "validDays": {
    "description": "Validity period in days",
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "packageId"
  ],
  "type": "object"
 },
 "name": "update_service_package",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
