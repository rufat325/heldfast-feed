{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Replicate-style prediction handoff scaffold with request templates, polling/webhook maps, output contracts, and credential-safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "endpoint_url": {
    "default": "https://api.replicate.com/v1/predictions",
    "description": "Prediction endpoint or local adapter URL.",
    "type": "string"
   },
   "model_ref": {
    "default": "owner/model:version",
    "description": "Model/version reference hint.",
    "type": "string"
   },
   "name": {
    "default": "replicate_prediction_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "output_mode": {
    "default": "image",
    "enum": [
     "image",
     "video",
     "json"
    ],
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Replicate scaffold.",
    "type": "string"
   },
   "poll_seconds": {
    "default": 2,
    "maximum": 120,
    "minimum": 0.25,
    "type": "number"
   },
   "request_mode": {
    "default": "webclient_json",
    "enum": [
     "webclient_json",
     "webhook_adapter",
     "manual"
    ],
    "type": "string"
   },
   "webhook_url": {
    "default": "",
    "description": "Optional webhook callback URL or adapter route.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_replicate_prediction_bridge",
 "title": "Connect Replicate prediction bridge"
}
