{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get note"
 },
 "description": "Get a single note by ID, with full content, tags, backlinks (notes that link to it via [[wiki links]]), and any reminders on it, in one response. Works for active and archived notes; a trashed note returns not-found (restore it first).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "noteId": {
    "description": "The note ID.",
    "type": "string"
   }
  },
  "required": [
   "noteId"
  ],
  "type": "object"
 },
 "name": "get_note",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backlinks": {
    "description": "Notes that link here via [[wiki links]].",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "updated_at": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "additionalProperties": false,
    "description": "The note, including its full markdown content and tags.",
    "properties": {
     "archivedAt": {
      "description": "Set only while the note is archived.",
      "type": [
       "string",
       "null"
      ]
     },
     "content": {
      "description": "Full markdown body.",
      "type": [
       "string",
       "null"
      ]
     },
     "createdAt": {
      "type": "string"
     },
     "deletedAt": {
      "description": "Set only while the note is in trash.",
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "isPinned": {
      "type": "boolean"
     },
     "tags": {
      "description": "Present on detail, create and update responses. Omitted when empty.",
      "items": {},
      "type": "array"
     },
     "title": {
      "type": [
       "string",
       "null"
      ]
     },
     "updatedAt": {
      "type": "string"
     },
     "wordCount": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "reminders": {
    "description": "Reminders set on this note.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dismissedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "noteId": {
       "type": "string"
      },
      "recurrence": {
       "description": "RRULE string, null for one-shot reminders.",
       "type": [
        "string",
        "null"
       ]
      },
      "snoozedUntil": {
       "type": [
        "string",
        "null"
       ]
      },
      "triggerAt": {
       "description": "ISO 8601, with UTC offset.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
