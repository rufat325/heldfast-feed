{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List forum threads"
 },
 "description": "List posts in a forum channel. Returns { threads: [...], hasMore, nextBefore }. The first call (no `before`) includes all active posts plus the first page of archived posts; archived posts are paginated, so if hasMore is true pass nextBefore back as `before` to fetch older archived posts. Read-only. Use discord_get_forum_post to read one post's messages.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "before": {
    "description": "Pagination cursor: an ISO timestamp. Pass the previous response's nextBefore to fetch older archived posts. When set, active posts are omitted.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "forum_channel_id": {
    "description": "ID (snowflake) of the forum channel to list posts from.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max archived posts per page (1\u2013100). Default 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "forum_channel_id"
  ],
  "type": "object"
 },
 "name": "discord_list_forum_threads",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "nextBefore": {
    "type": [
     "string",
     "null"
    ]
   },
   "threads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "appliedTags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "archived": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "createdAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "locked": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "messageCount": {
       "type": [
        "number",
        "null"
       ]
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "archived",
      "locked",
      "messageCount",
      "appliedTags",
      "createdAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "threads",
   "hasMore",
   "nextBefore"
  ],
  "type": "object"
 }
}
