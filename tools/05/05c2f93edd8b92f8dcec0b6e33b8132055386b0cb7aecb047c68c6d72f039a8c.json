{
 "description": "Manage distribution tags",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "ls",
     "add",
     "rm"
    ],
    "type": "string"
   },
   "package": {
    "description": "Package name (for add: pkg@version)",
    "type": "string"
   },
   "tag": {
    "description": "Tag name (required for add/rm)",
    "type": "string"
   }
  },
  "required": [
   "action",
   "package"
  ],
  "type": "object"
 },
 "name": "dist-tag"
}
