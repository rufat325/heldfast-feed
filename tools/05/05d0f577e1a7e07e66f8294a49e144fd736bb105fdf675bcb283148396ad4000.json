{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "contacts:sync"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Synchronize one complete Pool Founder route-date window into the private Pool Pro Florida CalDAV calendar. Each stop is one stable VEVENT. Completed events are historical records and are never removed. Missing non-completed events inside a validated complete window are retained and marked cancelled instead of deleted.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "events": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Service address. Written to LOCATION so mobile calendars can open Maps.",
       "type": "string"
      },
      "customerName": {
       "type": "string"
      },
      "email": {
       "description": "Optional structured customer email from Pool Founder. Included in event notes for tap-to-email on mobile calendars.",
       "format": "email",
       "type": "string"
      },
      "end": {
       "description": "ISO 8601 end with UTC offset or Z. Planned before service; actual departure after completion.",
       "type": "string"
      },
      "jobId": {
       "description": "Permanent Pool Founder job ID.",
       "type": "string"
      },
      "phone": {
       "description": "Optional structured customer phone number from Pool Founder. Included in event notes for tap-to-call on mobile calendars.",
       "type": "string"
      },
      "routeId": {
       "description": "Permanent Pool Founder route ID.",
       "type": "string"
      },
      "routeName": {
       "type": "string"
      },
      "serviceDate": {
       "description": "Service date in YYYY-MM-DD.",
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "serviceName": {
       "type": "string"
      },
      "start": {
       "description": "ISO 8601 start with UTC offset or Z. Planned before service; actual arrival after completion.",
       "type": "string"
      },
      "status": {
       "enum": [
        "planned",
        "in_progress",
        "completed",
        "skipped",
        "cancelled"
       ],
       "type": "string"
      },
      "stopIndex": {
       "maximum": 500,
       "minimum": 1,
       "type": "integer"
      },
      "timingSource": {
       "enum": [
        "planned",
        "actual"
       ],
       "type": "string"
      }
     },
     "required": [
      "jobId",
      "routeId",
      "serviceDate",
      "stopIndex",
      "customerName",
      "address",
      "serviceName",
      "start",
      "end",
      "status",
      "timingSource"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   },
   "snapshot": {
    "additionalProperties": false,
    "properties": {
     "complete": {
      "const": true,
      "type": "boolean"
     },
     "eventCount": {
      "minimum": 0,
      "type": "integer"
     },
     "generatedAt": {
      "description": "ISO 8601 snapshot generation time.",
      "type": "string"
     },
     "source": {
      "const": "poolfounder",
      "type": "string"
     },
     "windowEnd": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "windowStart": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     }
    },
    "required": [
     "source",
     "complete",
     "generatedAt",
     "windowStart",
     "windowEnd",
     "eventCount"
    ],
    "type": "object"
   }
  },
  "required": [
   "snapshot",
   "events"
  ],
  "type": "object"
 },
 "name": "sync_route_calendar",
 "securitySchemes": [
  {
   "scopes": [
    "contacts:sync"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Sync Pool Founder route calendar"
}
