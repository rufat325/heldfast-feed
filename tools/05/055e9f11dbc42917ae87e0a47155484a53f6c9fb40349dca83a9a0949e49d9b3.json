{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Given a decision_id, show what it cites and what cites it. Uses the reference graph database with 9.65M citation edges. Returns resolved citations with confidence scores and unresolved references.",
 "inputSchema": {
  "properties": {
   "decision_id": {
    "description": "Decision ID (e.g., bger_6B_1_2025)",
    "type": "string"
   },
   "direction": {
    "default": "both",
    "description": "Citation direction: 'both' (default), 'outgoing', or 'incoming'",
    "enum": [
     "both",
     "outgoing",
     "incoming"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max citations per direction per page (default 50, max 200)",
    "type": "integer"
   },
   "min_confidence": {
    "default": 0.3,
    "description": "Minimum confidence score for resolved citations (0-1, default 0.3)",
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset per direction (default 0). The response reports *_total and *_has_more; when has_more is true, re-query with offset=next_offset to retrieve the rest (heavily-cited leading decisions exceed the 200-per-page cap).",
    "type": "integer"
   }
  },
  "required": [
   "decision_id"
  ],
  "type": "object"
 },
 "name": "find_citations",
 "outputSchema": {
  "$defs": {
   "CitationEdge": {
    "additionalProperties": true,
    "properties": {
     "confidence_score": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Confidence Score"
     },
     "court": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Court"
     },
     "decision_date": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Decision Date"
     },
     "docket_number": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Docket Number"
     },
     "ignored_arguments": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "MCP parameters that were ignored; they did not affect the returned result.",
      "title": "Ignored Arguments"
     },
     "mention_count": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Mention Count"
     },
     "source_decision_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Decision Id"
     },
     "target_decision_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target Decision Id"
     },
     "target_ref": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Target Ref"
     }
    },
    "title": "CitationEdge",
    "type": "object"
   },
   "CitationsResponse": {
    "additionalProperties": true,
    "properties": {
     "decision_id": {
      "title": "Decision Id",
      "type": "string"
     },
     "direction": {
      "title": "Direction",
      "type": "string"
     },
     "ignored_arguments": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "MCP parameters that were ignored; they did not affect the returned result.",
      "title": "Ignored Arguments"
     },
     "incoming": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/$defs/CitationEdge"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Incoming"
     },
     "incoming_has_more": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Incoming Has More"
     },
     "incoming_returned": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Incoming Returned"
     },
     "incoming_total": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Incoming Total"
     },
     "limit": {
      "title": "Limit",
      "type": "integer"
     },
     "next_offset": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Next Offset"
     },
     "offset": {
      "title": "Offset",
      "type": "integer"
     },
     "outgoing": {
      "anyOf": [
       {
        "items": {
         "$ref": "#/$defs/CitationEdge"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Outgoing"
     },
     "outgoing_has_more": {
      "anyOf": [
       {
        "type": "boolean"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Outgoing Has More"
     },
     "outgoing_returned": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Outgoing Returned"
     },
     "outgoing_total": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Outgoing Total"
     }
    },
    "required": [
     "decision_id",
     "direction",
     "limit",
     "offset"
    ],
    "title": "CitationsResponse",
    "type": "object"
   },
   "ResearchError": {
    "additionalProperties": true,
    "properties": {
     "available_e_numbers": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Available E Numbers"
     },
     "error": {
      "title": "Error",
      "type": "string"
     },
     "ignored_arguments": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "MCP parameters that were ignored; they did not affect the returned result.",
      "title": "Ignored Arguments"
     },
     "message": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Message"
     }
    },
    "required": [
     "error"
    ],
    "title": "ResearchError",
    "type": "object"
   }
  },
  "anyOf": [
   {
    "$ref": "#/$defs/CitationsResponse"
   },
   {
    "$ref": "#/$defs/ResearchError"
   }
  ],
  "type": "object"
 },
 "title": "Find citations"
}
