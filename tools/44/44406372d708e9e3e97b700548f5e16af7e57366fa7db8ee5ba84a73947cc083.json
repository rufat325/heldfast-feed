{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get posts"
 },
 "description": "Batch-fetch one or more X (Twitter) posts by numeric id or status URL (1-100 per call). Returns compacted posts (author handle, text, metrics, reply/quote refs, media) plus a `missing` list for any ids that could not be fetched (deleted, protected, or not found). Pass `raw: true` for the uncompacted, size-capped API envelope.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ids": {
    "description": "Post references to fetch. Each is a numeric post id or a full status URL (e.g. https://x.com/user/status/123). 1-100 per call.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "raw": {
    "type": "boolean"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "x_post_get",
 "outputSchema": {
  "$defs": {
   "compact_media": {
    "properties": {
     "alt_text": {
      "type": "string"
     },
     "type": {
      "enum": [
       "photo",
       "video",
       "animated_gif"
      ],
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "compact_post": {
    "properties": {
     "author": {
      "type": "string"
     },
     "created_at": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "media": {
      "items": {
       "$ref": "#/$defs/compact_media"
      },
      "type": "array"
     },
     "metrics": {
      "$ref": "#/$defs/post_metrics"
     },
     "note_tweet": {
      "type": "string"
     },
     "quoted": {
      "$ref": "#/$defs/post_ref"
     },
     "reply_to": {
      "$ref": "#/$defs/post_ref"
     },
     "text": {
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "author",
     "text"
    ],
    "type": "object"
   },
   "missing": {
    "properties": {
     "id": {
      "type": "string"
     },
     "reason": {
      "enum": [
       "not-found",
       "deleted",
       "suspended",
       "protected",
       "unauthorized",
       "unavailable"
      ],
      "type": "string"
     },
     "resource_type": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "reason"
    ],
    "type": "object"
   },
   "post_metrics": {
    "properties": {
     "bookmarks": {
      "type": "number"
     },
     "impressions": {
      "type": "number"
     },
     "likes": {
      "type": "number"
     },
     "quotes": {
      "type": "number"
     },
     "replies": {
      "type": "number"
     },
     "reposts": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "post_ref": {
    "properties": {
     "author": {
      "type": "string"
     },
     "id": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   }
  },
  "properties": {
   "data": {
    "anyOf": [
     {
      "properties": {
       "items": {
        "items": {
         "$ref": "#/$defs/compact_post"
        },
        "type": "array"
       },
       "missing": {
        "items": {
         "$ref": "#/$defs/missing"
        },
        "type": "array"
       }
      },
      "required": [
       "items"
      ],
      "type": "object"
     },
     {
      "description": "Uncompacted X API envelope (raw: true).",
      "type": "object"
     }
    ]
   },
   "meta": {
    "properties": {
     "budget_warning": {
      "type": "string"
     },
     "cost_usd": {
      "type": "number"
     },
     "session_total_usd": {
      "type": "number"
     }
    },
    "required": [
     "cost_usd",
     "session_total_usd"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 }
}
