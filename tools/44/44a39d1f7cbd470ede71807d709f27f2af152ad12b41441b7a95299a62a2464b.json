{
 "description": "File a manual geolocated incident report (same as POST /api/reports).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "crime",
     "fire",
     "disaster",
     "weather",
     "unrest",
     "health",
     "infra",
     "alert",
     "report"
    ],
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "severity": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "submit_report",
 "title": "Submit incident report"
}
