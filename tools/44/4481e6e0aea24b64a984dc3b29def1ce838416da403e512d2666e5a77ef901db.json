{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"\uc77c\uc6a9\uadfc\ub85c\uc790\uc5d0\uac8c \uc77c\uae09\uc744 \uc9c0\uae09\ud560 \ub54c \ub5bc\ub294 \uc608\uc0c1 \uc18c\ub4dd\uc138\uc640 \uc9c0\ubc29\uc18c\ub4dd\uc138\ub97c \uacc4\uc0b0\ud55c\ub2e4(\uc0ac\uc774\ud2b8 /tools/daily-worker-tax \uc640 \uac19\uc740 \uc5d4\uc9c4). \ub0a0\ub9c8\ub2e4 1\uc77c \uc138\uc561 = (\uc77c\uae09 \u2212 1\uc77c \uadfc\ub85c\uc18c\ub4dd\uacf5\uc81c 15\ub9cc\uc6d0, \uc77c\uae09\uc774 \uadf8\ubcf4\ub2e4 \uc801\uc73c\uba74 0) \u00d7 6% \u2212 \uadf8 \uc0b0\ucd9c\uc138\uc561\uc758 55%(\uadfc\ub85c\uc18c\ub4dd\uc138\uc561\uacf5\uc81c) = (\uc77c\uae09 \u2212 15\ub9cc\uc6d0) \u00d7 2.7%. \uc77c\uae09\uc774 \ub2e4\ub978 \ub0a0\uc740 \ub0a0\ub9c8\ub2e4 \uacc4\uc0b0\ud574 \ub354\ud558\uace0 \ud3c9\uade0\uc744 \ub0b4\uc9c0 \uc54a\ub294\ub2e4. \ud55c \ubc88\uc5d0 \uc9c0\uae09\ud55c \ub0a0\ub4e4\uc758 \uc138\uc561 \ud569\uacc4\uac00 1,000\uc6d0 \ubbf8\ub9cc\uc774\uba74 \ub5bc\uc9c0 \uc54a\uace0(\uc9c0\uae09 \uac74\ub9c8\ub2e4 \ud310\ub2e8), \uc544\ub2c8\uba74 10\uc6d0 \ubbf8\ub9cc\uc744 \ubc84\ub9b0\ub2e4. \uc9c0\ubc29\uc18c\ub4dd\uc138\ub294 \ub5c0 \uc18c\ub4dd\uc138\uc758 10%\uc5d0\uc11c 10\uc6d0 \ubbf8\ub9cc \ubc84\ub9bc. \ub0a0\ub9c8\ub2e4 1\uc6d0 \ubbf8\ub9cc\uc744 \uba3c\uc800 \ubc84\ub9ac\ub294 \ubc29\uc2dd\uc758 \uac12(dailyFloor)\ub3c4 \ud568\uaed8 \ub0b4\uace0, \ub450 \uac12\uc774 \ub2e4\ub974\uba74 \ub458 \ub2e4 \ub9d0\ud55c\ub2e4. \uc77c\uc6a9\uadfc\ub85c\uc790\uc778\uc9c0 \uac00\ub9ac\ub294 \uac83, \ube44\uacfc\uc138 \uad6c\ubd84, 4\ub300\ubcf4\ud5d8, \ube44\uac70\uc8fc\uc790, \uac19\uc740 \ub0a0 \uc5ec\ub7ec \uacf3 \uc18c\ub4dd \ud569\uc0b0, 2018\ub144 \uc774\uc804 \uc18c\ub4dd, \uc9c0\uae09\uba85\uc138\uc11c\u00b7\uc2e0\uace0\uc11c \uc791\uc131\uc740 \ub2e4\ub8e8\uc9c0 \uc54a\ub294\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"dailyWorker":{"description":"\uc77c\uc6a9\uadfc\ub85c\uc790\uc778\uac00(\uc18c\ub4dd\uc138\ubc95 \uc2dc\ud589\ub839 \uc81c20\uc870 \uc81c1\ud56d \u2014 \uac74\uc124 1\ub144 \ubbf8\ub9cc \uace0\uc6a9 \ub4f1\u00b7\ud558\uc5ed\u00b7\uadfc\ub85c\uacc4\uc57d\uc0c1 3\uac1c\uc6d4 \ubbf8\ub9cc \uace0\uc6a9). false \uba74 \uacc4\uc0b0\ud558\uc9c0 \uc54a\ub294\ub2e4","type":"boolean"},"payments":{"description":"\uc9c0\uae09 \uac74 \ubaa9\ub85d \u2014 \ud55c \ubc88\uc5d0 \uc9c0\uae09\ud55c \ub0a0\ub4e4\uc744 \ud55c \uac74\uc73c\ub85c \ubb36\ub294\ub2e4. \ub9e4\uc77c \uc9c0\uae09\ud588\uc73c\uba74 \ud558\ub8e8\uce58\ub97c \ud55c \uac74\uc73c\ub85c","items":{"additionalProperties":false,"properties":{"lines":{"description":"\uc774 \uc9c0\uae09\uc5d0 \ub4e0 \ub0a0\ub4e4 \u2014 \uc77c\uae09\uc774 \ub2e4\ub978 \ub0a0\uc740 \uc904\uc744 \ub098\ub208\ub2e4","items":{"additionalProperties":false,"properties":{"dailyWage":{"description":"\uacfc\uc138 \uc77c\uae09(\uc6d0, \ube44\uacfc\uc138\ub97c \ube80 \uae08\uc561)","type":"number"},"days":{"description":"\uc774 \uc77c\uae09\uc73c\ub85c \uc77c\ud55c \uc77c\uc218(1~366\uc77c)","type":"number"}},"required":["dailyWage","days"],"type":"object"},"type":"array"}},"required":["lines"],"type":"object"},"type":"array"}},"required":["dailyWorker","payments"],"type":"object"},"name":"calc_daily_worker_tax","title":"\uc77c\uc6a9\uadfc\ub85c\uc18c\ub4dd \uc6d0\ucc9c\uc9d5\uc218 \uacc4\uc0b0"}
