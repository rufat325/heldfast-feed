{
 "description": "Store a value under a namespaced key with optional TTL. Covered by Pro subscription, or $0.005 USD per call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "key": {
    "description": "Key.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "namespace": {
    "description": "Namespace for isolation.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "description": "Optional tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ttlSeconds": {
    "description": "TTL in seconds.",
    "maximum": 31536000,
    "minimum": 1,
    "type": "integer"
   },
   "value": {
    "description": "Value. Max 50,000 chars.",
    "maxLength": 50000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "namespace",
   "key",
   "value"
  ],
  "type": "object"
 },
 "name": "memory.store"
}
