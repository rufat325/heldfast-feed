{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate Jaimini structural chart"
 },
 "description": "Returns seven- and eight-Chara-Karaka conventions, all Arudha Padas including Arudha Lagna and Upapada, Karakamsha, and Jaimini Rashi Drishti matrices without silently mixing conventions.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "birthTimeAccuracyMinutes": {
    "default": 5,
    "maximum": 1440,
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "date",
   "time"
  ],
  "type": "object"
 },
 "name": "calculate_jaimini",
 "outputSchema": {
  "properties": {
   "arudhaPadas": {
    "type": "object"
   },
   "charaDasha": {
    "type": "object"
   },
   "charaKarakas": {
    "type": "object"
   },
   "devataProfile": {
    "type": "object"
   },
   "karakamsha": {
    "type": "object"
   },
   "rashiDrishti": {
    "type": "object"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-jaimini-1"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "schemaVersion",
   "status",
   "charaKarakas",
   "arudhaPadas",
   "karakamsha",
   "devataProfile",
   "rashiDrishti",
   "charaDasha",
   "safety"
  ],
  "type": "object"
 },
 "title": "Calculate Jaimini structural chart"
}
