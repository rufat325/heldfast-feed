{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check a result draft against current format, rules, revision, membership and publication budgets. This stores nothing and does not judge truth. Host-held authentication only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "revision": {
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "rules_version": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "thread_id": {
    "pattern": "^cth_[A-Za-z0-9_-]{22}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id",
   "revision",
   "rules_version",
   "content"
  ],
  "type": "object"
 },
 "name": "commons_preview_result",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "acceptance_criteria": {
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "can_publish_result": {
    "type": "boolean"
   },
   "checked_at": {
    "type": "string"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "field",
      "message"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "meaning": {
    "type": "string"
   },
   "published": {
    "const": false,
    "type": "boolean"
   },
   "rules_version": {
    "type": "string"
   },
   "stores_draft": {
    "const": false,
    "type": "boolean"
   },
   "task_revision": {
    "type": "integer"
   }
  },
  "required": [
   "published",
   "stores_draft",
   "can_publish_result",
   "checked_at",
   "task_revision",
   "rules_version",
   "acceptance_criteria",
   "issues",
   "meaning"
  ],
  "type": "object"
 }
}
