{
 "annotations": {
  "readOnlyHint": true,
  "title": "List reservations"
 },
 "description": "List reservations across all channels (Airbnb, Booking.com, direct, ...), paginated, with guest, dates, channel, price and payment status. Filter by stay range, arrival, departure, creation or modification date, and property. Smoobu: GET /api/reservations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "apartment_id": {
    "description": "Only this property.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "arrival_from": {
    "description": "Only arrivals on or after (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "arrival_to": {
    "description": "Only arrivals on or before (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "created_from": {
    "description": "Only bookings created on or after (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "created_to": {
    "description": "Only bookings created on or before (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departure_from": {
    "description": "Only departures on or after (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departure_to": {
    "description": "Only departures on or before (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "exclude_blocked": {
    "description": "Hide blocked-period bookings.",
    "type": "boolean"
   },
   "from": {
    "description": "Only bookings overlapping a stay range starting on this date (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "include_price_elements": {
    "description": "Include each booking's price breakdown.",
    "type": "boolean"
   },
   "include_related": {
    "description": "With apartment_id: also return bookings from grouped properties.",
    "type": "boolean"
   },
   "modified_from": {
    "description": "Only bookings modified on or after (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "modified_to": {
    "description": "Only bookings modified on or before (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Bookings per page, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "show_cancellations": {
    "description": "Include cancelled bookings.",
    "type": "boolean"
   },
   "to": {
    "description": "End of that stay range (yyyy-mm-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "smoobu_list_reservations",
 "title": "List reservations"
}
