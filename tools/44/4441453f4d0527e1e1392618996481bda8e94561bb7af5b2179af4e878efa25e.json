{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a user asks about monthly internet egress cost from daily request volume, average response size, provider, and CDN offload. Uses the same model as the browser calculator.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "avg_response_kb": {
    "description": "avg response kb used by this deterministic tool.",
    "examples": [
     1
    ],
    "minimum": 0,
    "type": "number"
   },
   "cdn_pct": {
    "description": "cdn expressed as a percentage.",
    "examples": [
     1
    ],
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "daily_requests": {
    "description": "daily requests used by this deterministic tool.",
    "examples": [
     1
    ],
    "minimum": 0,
    "type": "number"
   },
   "provider": {
    "description": "Cloud provider whose published pricing model should be applied.",
    "enum": [
     "AWS",
     "GCP",
     "Azure",
     "Cloudflare",
     "DigitalOcean"
    ],
    "examples": [
     "AWS"
    ],
    "type": "string"
   }
  },
  "required": [
   "daily_requests",
   "avg_response_kb"
  ],
  "type": "object"
 },
