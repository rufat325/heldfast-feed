{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Full coaching cycle history for one assignment (keyset page; drafts included \u2014 employer view; response view:\"cycles\"). Worker names are masked; answer keys, expected answers, and worker personal data NEVER appear. Requires project_todos:read, a claimed account, and the default-off project-todos agent surface. Keyless read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "assignmentId"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_cycles",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "assignmentId": {
      "type": "string"
     },
     "cycles": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "closedAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "closedReason": {
         "anyOf": [
          {
           "enum": [
            "ACCEPTED",
            "GRADED",
            "SUPERSEDED",
            "CANCELLED"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "cycleNumber": {
         "type": "integer"
        },
        "reason": {
         "type": [
          "string",
          "null"
         ]
        },
        "requestedQuestionIds": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "reviewCycleId": {
         "type": "string"
        },
        "sentAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "sourceAttemptId": {
         "type": "string"
        },
        "status": {
         "enum": [
          "DRAFT",
          "OPEN",
          "RESUBMITTED",
          "CLOSED"
         ],
         "type": "string"
        }
       },
       "required": [
        "reviewCycleId",
        "cycleNumber",
        "status",
        "sourceAttemptId",
        "requestedQuestionIds",
        "reason",
        "sentAt",
        "closedAt",
        "closedReason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     },
     "view": {
      "const": "cycles",
      "type": "string"
     }
    },
    "required": [
     "view",
     "assignmentId",
     "cycles",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
