{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute AXI_A for robotaxis, driver-assistance, delivery robots, and humanoids: safety-case, bystander-legibility, consent, and integrity gates times the episode-weighted role BaseScore.",
 "inputSchema": {
  "properties": {
   "bystanderLegibility": {
    "description": "Bystander Legibility (0\u20131); gate requires >= 0.95",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "cf": {
    "description": "Consent Fidelity per event class (0\u20131). Missing values fail the gate closed.",
    "properties": {
     "action": {
      "type": "number"
     },
     "identity": {
      "type": "number"
     },
     "memoryWrite": {
      "type": "number"
     },
     "perception": {
      "type": "number"
     }
    },
    "required": [
     "action",
     "memoryWrite",
     "identity",
     "perception"
    ],
    "type": "object"
   },
   "ii": {
    "description": "Interaction Integrity (0\u20131). Alternatively pass integrity sub-scores.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "integrity": {
    "description": "Sub-scores used to compute II by weighted harmonic mean when ii is omitted",
    "properties": {
     "accuracy": {
      "type": "number"
     },
     "calibration": {
      "type": "number"
     },
     "scope": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "roles": {
    "description": "Role-level metrics (principal, supervisor, occupant). Give baseScore directly or the metrics.",
    "items": {
     "properties": {
      "baseScore": {
       "type": "number"
      },
      "cli": {
       "description": "Cognitive Load Index (0\u2013100)",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "episodes": {
       "type": "number"
      },
      "pc": {
       "description": "Presence Continuity (0\u20131)",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "re": {
       "description": "Repair Efficacy (0\u20131)",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "role": {
       "type": "string"
      },
      "tdr": {
       "description": "Trust Decay Rate in trust-index points/day",
       "type": "number"
      },
      "timeToReadiness": {
       "type": "number"
      },
      "timeToReassurance": {
       "type": "number"
      },
      "ttc": {
       "description": "Time-to-Comfort in seconds",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "safetyCase": {
    "description": "Deployment holds a valid external safety case or type approval for its ODD",
    "type": "boolean"
   }
  },
  "required": [
   "cf",
   "safetyCase",
   "bystanderLegibility"
  ],
  "type": "object"
 },
 "name": "axi_calculate_autonomy_score",
 "title": "Calculate AXI-Autonomy Score"
}
