{
 "_meta": {
  "anthropic/alwaysLoad": true
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "Edit only non-secret metadata on a credential after the user approves\nthe exact before\u2192after change from the Telegram/passkey vouch link. Use\nallowed_hosts or login_hosts with mode add/remove/replace; label renames are\nalso supported. Pass an exact vault reference, a service, or a saved credential\nname (combine service+name to disambiguate). The first call returns\napproval_pending and an approval_id. After the user approves, call\nedit_credential again with ONLY that approval_id. Unknown and immutable fields\nare rejected. This tool can never read or alter the stored secret value; rotate\na secret only by calling store_credential with the new value.",
 "inputSchema": {
  "$defs": {
   "allowedHostEdit": {
    "additionalProperties": false,
    "properties": {
     "hosts": {
      "items": {
       "maxLength": 256,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     "mode": {
      "enum": [
       "add",
       "remove",
       "replace"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode",
     "hosts"
    ],
    "type": "object"
   },
   "loginHostEdit": {
    "additionalProperties": false,
    "properties": {
     "hosts": {
      "items": {
       "maxLength": 253,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "mode": {
      "enum": [
       "add",
       "remove",
       "replace"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode",
     "hosts"
    ],
    "type": "object"
   }
  },
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "changes": {
      "additionalProperties": false,
      "properties": {
       "allowed_hosts": {
        "$ref": "#/$defs/allowedHostEdit"
       },
       "label": {
        "type": "string"
       },
       "login_hosts": {
        "$ref": "#/$defs/loginHostEdit"
       }
      },
      "type": "object"
     },
     "name": {
      "type": "string"
     },
     "reference": {
      "type": "string"
     },
     "service": {
      "type": "string"
     }
    },
    "required": [
     "changes"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "approval_id": {
      "type": "string"
     }
    },
    "required": [
     "approval_id"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "edit_credential"
}
