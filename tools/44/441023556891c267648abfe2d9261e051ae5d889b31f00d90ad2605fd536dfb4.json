{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud DB for MongoDB instance. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "arbiterProductCode": {
    "description": "Arbiter server product code",
    "type": "string"
   },
   "arbiterServerCount": {
    "description": "Number of arbiter servers",
    "type": "number"
   },
   "backupFileRetentionPeriod": {
    "description": "Backup retention period in days (1-30)",
    "type": "number"
   },
   "cloudMongoDbImageProductCode": {
    "description": "MongoDB image product code",
    "type": "string"
   },
   "cloudMongoDbServerNamePrefix": {
    "description": "Server name prefix",
    "type": "string"
   },
   "cloudMongoDbServiceName": {
    "description": "MongoDB service name (3-20 chars, lowercase letters and numbers)",
    "type": "string"
   },
   "cloudMongoDbUserName": {
    "description": "Initial admin user name",
    "type": "string"
   },
   "cloudMongoDbUserPassword": {
    "description": "Initial admin user password",
    "type": "string"
   },
   "clusterTypeCode": {
    "description": "Cluster type code (STAND_ALONE | SINGLE_REPLICA_SET | SHARDED_CLUSTER)",
    "type": "string"
   },
   "compressCode": {
    "description": "Compression algorithm (SNPP | ZLIB | ZSTD | NONE)",
    "type": "string"
   },
   "configPort": {
    "description": "Config port (default 17017)",
    "type": "number"
   },
   "configProductCode": {
    "description": "Config server product code",
    "type": "string"
   },
   "configServerCount": {
    "description": "Number of config servers (for sharded cluster)",
    "type": "number"
   },
   "dataStorageTypeCode": {
    "description": "Data storage type (SSD | HDD | CB2)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating the instance",
    "type": "boolean"
   },
   "engineVersionCode": {
    "description": "MongoDB engine version code",
    "type": "string"
   },
   "memberPort": {
    "description": "Member port (default 17017, range 10000-65535)",
    "type": "number"
   },
   "memberProductCode": {
    "description": "Member server product code",
    "type": "string"
   },
   "memberServerCount": {
    "description": "Number of member servers in the replica set",
    "type": "number"
   },
   "mongosPort": {
    "description": "Mongos port (default 17017)",
    "type": "number"
   },
   "mongosProductCode": {
    "description": "Mongos server product code",
    "type": "string"
   },
   "mongosServerCount": {
    "description": "Number of mongos servers (for sharded cluster)",
    "type": "number"
   },
   "shardCount": {
    "description": "Number of shards (2-3, for SHARDED_CLUSTER)",
    "type": "number"
   },
   "subnetNo": {
    "description": "Subnet number",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "string"
   }
  },
  "required": [
   "cloudMongoDbServiceName",
   "cloudMongoDbServerNamePrefix",
   "clusterTypeCode",
   "vpcNo",
   "subnetNo",
   "cloudMongoDbUserName",
   "cloudMongoDbUserPassword"
  ],
  "type": "object"
 },
 "name": "ncloud_create_mongodb_instance"
}
