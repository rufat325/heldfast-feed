{
 "description": "Create a new shipment",
 "inputSchema": {
  "properties": {
   "contract": {
    "description": "Contract/account number",
    "type": "string"
   },
   "destination": {
    "description": "Destination address",
    "properties": {
     "city": {
      "description": "City",
      "type": "string"
     },
     "contact_name": {
      "description": "Recipient name",
      "type": "string"
     },
     "contact_phone": {
      "description": "Recipient phone",
      "type": "string"
     },
     "number": {
      "description": "Street number",
      "type": "string"
     },
     "postal_code": {
      "description": "Postal code",
      "type": "string"
     },
     "province": {
      "description": "Province",
      "type": "string"
     },
     "street": {
      "description": "Street name",
      "type": "string"
     }
    },
    "required": [
     "postal_code",
     "contact_name"
    ],
    "type": "object"
   },
   "origin": {
    "description": "Origin address",
    "properties": {
     "city": {
      "description": "City",
      "type": "string"
     },
     "number": {
      "description": "Street number",
      "type": "string"
     },
     "postal_code": {
      "description": "Postal code",
      "type": "string"
     },
     "province": {
      "description": "Province",
      "type": "string"
     },
     "street": {
      "description": "Street name",
      "type": "string"
     }
    },
    "required": [
     "postal_code"
    ],
    "type": "object"
   },
   "packages": {
    "description": "Packages to ship",
    "items": {
     "properties": {
      "height": {
       "description": "Height in cm",
       "type": "number"
      },
      "length": {
       "description": "Length in cm",
       "type": "number"
      },
      "weight": {
       "description": "Weight in grams",
       "type": "number"
      },
      "width": {
       "description": "Width in cm",
       "type": "number"
      }
     },
     "required": [
      "weight"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "contract",
   "destination",
   "packages"
  ],
  "type": "object"
 },
 "name": "create_shipment"
}
