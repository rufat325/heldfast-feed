{
 "description": "Crear un nuevo flow (playbook) con nombre, disparador y pasos. El AI lo ejecuta cuando el usuario dice algo que matchea el trigger.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Nombre del flow (ej: pr-ready)",
    "type": "string"
   },
   "steps": {
    "description": "Pasos del flow: [{tool, confirm?, target?, note?}]",
    "items": {
     "additionalProperties": false,
     "properties": {
      "confirm": {
       "type": "boolean"
      },
      "note": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "trigger": {
    "description": "Descripcion del disparador (ej: cuando el usuario dice \"PR listo\")",
    "type": "string"
   }
  },
  "required": [
   "name",
   "trigger",
   "steps"
  ],
  "type": "object"
 },
 "name": "df_flow_create"
}
