{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update an existing Global Traffic Manager policy",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "geoMapId": {
    "description": "Geo/CIDR Map ID",
    "type": "number"
   },
   "lbType": {
    "description": "Load balancing type",
    "enum": [
     "ROUND_ROBIN",
     "WEIGHTED_RR",
     "FAILOVER",
     "GEO",
     "CIDR"
    ],
    "type": "string"
   },
   "monitor": {
    "additionalProperties": false,
    "description": "Health check monitor configuration",
    "properties": {
     "hostHeader": {
      "description": "Host header",
      "type": "string"
     },
     "path": {
      "description": "Health check path",
      "type": "string"
     },
     "period": {
      "description": "Check period in seconds",
      "type": "number"
     },
     "port": {
      "description": "Health check port",
      "type": "number"
     },
     "protocol": {
      "description": "Health check protocol",
      "enum": [
       "HTTP",
       "HTTPS",
       "TCP"
      ],
      "type": "string"
     },
     "thresholdFail": {
      "description": "Failure threshold",
      "type": "number"
     },
     "thresholdNormal": {
      "description": "Normal threshold",
      "type": "number"
     }
    },
    "required": [
     "protocol",
     "port"
    ],
    "type": "object"
   },
   "name": {
    "description": "Policy name",
    "type": "string"
   },
   "policyId": {
    "description": "Policy ID to update",
    "type": "number"
   },
   "resourceGroups": {
    "description": "Resource groups",
    "items": {
     "additionalProperties": false,
     "properties": {
      "active": {
       "description": "Active resources",
       "items": {
        "additionalProperties": false,
        "properties": {
         "content": {
          "description": "Resource address",
          "type": "string"
         },
         "healthCheckRegionId": {
          "description": "Health check region ID",
          "type": "number"
         },
         "type": {
          "description": "Resource type (PUBLIC_IP or CNAME)",
          "type": "string"
         }
        },
        "required": [
         "content",
         "healthCheckRegionId",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "geoMapDetailId": {
       "description": "Geo map detail ID",
       "type": [
        "number",
        "null"
       ]
      },
      "sid": {
       "description": "Resource group ID",
       "type": [
        "number",
        "null"
       ]
      },
      "standby": {
       "description": "Standby resources",
       "items": {
        "additionalProperties": false,
        "properties": {
         "content": {
          "description": "Resource address",
          "type": "string"
         },
         "healthCheckRegionId": {
          "description": "Health check region ID",
          "type": "number"
         },
         "type": {
          "description": "Resource type (PUBLIC_IP or CNAME)",
          "type": "string"
         }
        },
        "required": [
         "content",
         "healthCheckRegionId",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "weighted": {
       "description": "Weight (WEIGHTED_RR only)",
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "active"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "policyId"
  ],
  "type": "object"
 },
 "name": "ncloud_gtm_update_policy"
}
