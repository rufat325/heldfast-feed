{
 "description": "Clear cell values from one or more ranges. Clears values only - preserves formatting, validation, and other cell properties. Use a1-notation prompt for range syntax.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "ranges": {
    "description": "A1 notation ranges to clear (e.g., [\"A1:B5\", \"D3:D10\"]). Clears values only, preserves formatting.",
    "items": {
     "description": "A1 notation for cell range (e.g., A1, A1:B2, A:B, 1:2)",
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "gid",
   "ranges"
  ],
  "type": "object"
 },
 "name": "values-clear",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "clearedRanges": {
        "description": "A1 notation ranges that were cleared",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Title of the sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the sheet",
        "type": "string"
       },
       "spreadsheetTitle": {
        "description": "Title of the spreadsheet",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "spreadsheetTitle",
       "spreadsheetUrl",
       "sheetTitle",
       "sheetUrl",
       "clearedRanges"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
