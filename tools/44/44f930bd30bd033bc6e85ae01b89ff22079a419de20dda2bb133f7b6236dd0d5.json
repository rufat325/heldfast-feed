{"description":"List recent runs for a pipeline","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"branch":{"description":"Branch to filter by (e.g., \"main\" or \"refs/heads/main\")","type":"string"},"continuationToken":{"description":"Continuation token for pagination","type":"string"},"createdFrom":{"description":"Filter runs created at or after this time (ISO 8601)","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","type":"string"},"createdTo":{"description":"Filter runs created at or before this time (ISO 8601)","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$","type":"string"},"orderBy":{"default":"createdDate desc","description":"Sort order for run creation date","enum":["createdDate desc","createdDate asc"],"type":"string"},"pipelineId":{"description":"Pipeline numeric ID","maximum":9007199254740991,"minimum":1,"type":"integer"},"projectId":{"description":"The ID or name of the project (Default: no default project)","type":"string"},"result":{"description":"Filter by final run result","enum":["succeeded","partiallySucceeded","failed","canceled","none"],"type":"string"},"state":{"description":"Filter by current run state","enum":["notStarted","inProgress","completed","cancelling","postponed"],"type":"string"},"top":{"default":50,"description":"Maximum number of runs to return (1-100)","maximum":100,"minimum":1,"type":"integer"}},"required":["pipelineId","top","orderBy"],"type":"object"},"mcp_enabled