{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare models"
 },
 "description": "Side-by-side core overall and per-size accuracy, cost, latency and token results for model or family names.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
