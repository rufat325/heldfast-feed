         "type": "string"
        },
        "chainName": {
         "type": "string"
        },
        "nativeAsset": {
         "additionalProperties": false,
         "properties": {
          "decimals": {
           "type": "number"
          },
          "symbol": {
           "type": "string"
          }
         },
         "required": [
          "symbol",
          "decimals"
         ],
         "type": "object"
        },
        "nonce": {
         "type": "number"
        },
        "status": {
         "const": "ok",
         "type": "string"
        }
       },
       "required": [
        "status",
        "chain",
        "chainName",
        "balance",
        "balanceRaw",
        "nativeAsset",
        "nonce",
        "active"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "chain": {
         "description": "Blockchain queried",
         "type": "string"
        },
        "reason": {
         "type": "string"
        },
        "status": {
         "const": "error",
         "type": "string"
        }
       },
       "required": [
        "status",
        "reason"
       ],
       "type": "object"
      }
     ]
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "chainsQueried": {
    "type": "number"
   },
   "chainsSuccessful": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "summary": {
