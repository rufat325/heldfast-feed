  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Wallet address to analyze across all EVM chains",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "chain.cross",
