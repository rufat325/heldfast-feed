{
 "annotations": {
  "openWorldHint": false,
  "title": "Memory Extract Entities"
 },
 "description": "Store LLM-extracted entities and relationships for a memory. The calling agent should analyze memory content and provide structured entity/relationship data. This enables knowledge graph queries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entities": {
    "description": "Entities extracted from the memory content",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aliases": {
       "description": "Alternative names for this entity",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "description": "Entity name",
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "description": "Entity type",
       "enum": [
        "person",
        "project",
        "tool",
        "concept",
        "organization",
        "file",
        "package",
        "pattern",
        "work_item",
        "pull_request",
        "commit",
        "team",
        "department",
        "sop",
        "agent"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "memory_id": {
    "description": "Memory ID to associate extracted entities with",
    "type": "string"
   },
   "relationships": {
    "description": "Relationships between entities",
    "items": {
     "additionalProperties": false,
     "properties": {
      "source": {
       "description": "Source entity name",
       "type": "string"
      },
      "target": {
       "description": "Target entity name",
       "type": "string"
      },
      "type": {
       "description": "Relationship type",
       "enum": [
        "uses",
        "created_by",
        "depends_on",
        "related_to",
        "part_of",
        "works_with",
        "manages",
        "reports_to",
        "member_of",
        "works_on",
        "owns",
        "follows"
       ],
       "type": "string"
      }
     },
     "required": [
      "source",
      "target",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "memory_id",
   "entities"
  ],
  "type": "object"
 },
 "name": "memory_extract_entities"
}
