{
 "description": "Create a new subscription on Google Play (monetization API). Pass the full subscription body \u2014 including listings and at least one base plan with billing details and per-region pricing. Base plans are created in DRAFT state; call google_activate_subscription_base_plan to make them purchasable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "basePlans": {
    "description": "At least one base plan is required",
    "items": {
     "additionalProperties": false,
     "properties": {
      "autoRenewing": {
       "additionalProperties": false,
       "description": "Auto-renewing billing config. Use this for standard monthly/yearly subs.",
       "properties": {
        "accountHoldDuration": {
         "description": "ISO 8601 account hold duration, e.g. P30D",
         "type": "string"
        },
        "billingPeriodDuration": {
         "description": "ISO 8601 duration, e.g. P1M, P3M, P1Y",
         "type": "string"
        },
        "gracePeriodDuration": {
         "description": "ISO 8601 grace period duration, e.g. P3D",
         "type": "string"
        },
        "legacyCompatible": {
         "type": "boolean"
        },
        "prorationMode": {
         "description": "e.g. SUBSCRIPTION_PRORATION_MODE_CHARGE_ON_NEXT_BILLING_DATE",
         "type": "string"
        },
        "resubscribeState": {
         "description": "e.g. RESUBSCRIBE_STATE_ACTIVE",
         "type": "string"
        }
       },
       "required": [
        "billingPeriodDuration"
       ],
       "type": "object"
      },
      "basePlanId": {
       "description": "Stable base plan id, e.g. pro-monthly",
       "type": "string"
      },
      "offerTags": {
       "description": "Optional offer tag identifiers",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "regionalConfigs": {
       "description": "At least one region price is required",
       "items": {
        "additionalProperties": false,
        "properties": {
         "currency": {
          "description": "ISO 4217 currency code, e.g. USD",
          "type": "string"
         },
         "newSubscriberAvailability": {
          "default": true,
          "type": "boolean"
         },
         "priceMicros": {
          "description": "Price in micros, e.g. 3990000 for $3.99",
          "type": "string"
         },
         "regionCode": {
          "description": "ISO 3166-1 alpha-2 region, e.g. US",
          "type": "string"
         }
        },
        "required": [
         "regionCode",
         "priceMicros",
         "currency"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "basePlanId",
      "autoRenewing",
      "regionalConfigs"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "listings": {
    "description": "At least one localization is required",
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefits": {
       "description": "Up to four short benefit bullets per locale",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "description": "Localized description (max 80 chars)",
       "type": "string"
      },
      "languageCode": {
       "description": "BCP-47 locale code, e.g. en-US",
       "type": "string"
      },
      "title": {
       "description": "Localized subscription title (max 30 chars)",
       "type": "string"
      }
     },
     "required": [
      "languageCode",
      "title",
      "description"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "packageName": {
    "description": "Android package name (e.g. com.example.app)",
    "type": "string"
   },
   "productId": {
    "description": "Subscription product ID, e.g. com.example.app.pro_monthly",
    "type": "string"
   },
   "regionsVersion": {
    "default": "2022/02",
    "description": "Google Play regions version. Default 2022/02 matches Google API expectations.",
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "productId",
   "listings",
   "basePlans"
  ],
  "type": "object"
 },
 "name": "google_create_subscription"
}
