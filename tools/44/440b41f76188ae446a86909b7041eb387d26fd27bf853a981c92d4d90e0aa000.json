{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Build an illustrative fixed-income ladder"
 },
 "description": "Build an educational equal-weight maturity ladder from current eligible public CD, money-market, Treasury, or municipal options for a requested rung count and term range. Every covered rung contains a canonical brinkeradvisor_url and an original source_name and source_url. Returns explicit uncovered rungs. This tool does not access accounts, trade, recommend a product, forecast rates or the economy, or provide suitability or tax advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "hypothetical_amount_usd": {
    "maximum": 10000000,
    "minimum": 1000,
    "type": "number"
   },
   "instrument_types": {
    "items": {
     "enum": [
      "cd",
      "money_market",
      "treasury",
      "municipal"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "maximum_term_months": {
    "maximum": 120,
    "minimum": 0,
    "type": "integer"
   },
   "minimum_term_months": {
    "maximum": 120,
    "minimum": 0,
    "type": "integer"
   },
   "rung_count": {
    "maximum": 10,
    "minimum": 2,
    "type": "integer"
   }
  },
  "required": [
   "instrument_types",
   "rung_count",
   "minimum_term_months",
   "maximum_term_months"
  ],
  "type": "object"
 },
 "name": "build_ladder",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "description": "Feed publication date; each covered rung has its own record date and age.",
    "type": "string"
   },
   "equal_target_percentage": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "hypothetical_amount_usd": {
    "anyOf": [
     {
      "maximum": 10000000,
      "minimum": 1000,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "illustrative_only": {
    "const": true,
    "type": "boolean"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "maturity_spacing_months": {
    "minimum": 0,
    "type": "number"
   },
   "rungs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "option": {
       "additionalProperties": false,
       "properties": {
        "as_of": {
         "description": "Original record value date, which may precede the feed publication date.",
         "type": "string"
        },
        "brinkeradvisor_url": {
         "description": "Absolute canonical BrinkerAdvisor record URL, distinct from the original provider source URL.",
         "format": "uri",
         "type": "string"
        },
        "data_age_hours": {
         "anyOf": [
          {
           "minimum": 0,
           "type": "number"
          },
          {
           "type": "null"
          }
         ],
         "description": "Age of this record, not the feed, when retrieved."
        },
        "id": {
         "type": "string"
        },
        "instrument_type": {
         "enum": [
          "cd",
          "money_market",
          "treasury",
          "municipal"
         ],
         "type": "string"
        },
        "issuer_or_institution": {
         "type": "string"
        },
        "product": {
         "type": "string"
        },
        "published_yield": {
         "type": "string"
        },
        "source_name": {
         "type": "string"
        },
        "source_status": {
         "type": "string"
        },
        "source_url": {
         "description": "Absolute original provider or government source URL documenting the record's provenance.",
         "format": "uri",
         "type": "string"
        },
        "term": {
         "type": "string"
        },
        "term_months": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "id",
        "instrument_type",
        "issuer_or_institution",
        "product",
        "term",
        "term_months",
        "published_yield",
        "as_of",
        "data_age_hours",
        "source_name",
        "source_status",
        "source_url",
        "brinkeradvisor_url"
       ],
       "type": "object"
      },
      "reason": {
       "type": "string"
      },
      "rung": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "status": {
       "enum": [
        "covered",
        "uncovered"
       ],
       "type": "string"
      },
      "target_amount_usd": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "target_percentage": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "target_term_months": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "rung",
      "target_term_months",
      "target_percentage",
      "target_amount_usd",
      "status"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "source_freshness": {
    "description": "Feed age band, not the age of every covered rung.",
    "enum": [
     "under_24h",
     "24_to_48h",
     "48_to_72h"
    ],
    "type": "string"
   }
  },
  "required": [
   "as_of",
   "source_freshness",
   "illustrative_only",
   "maturity_spacing_months",
   "equal_target_percentage",
   "hypothetical_amount_usd",
   "rungs",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Build an illustrative fixed-income ladder"
}
