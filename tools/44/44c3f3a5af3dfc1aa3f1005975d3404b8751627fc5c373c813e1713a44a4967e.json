{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a file or folder share in Nextcloud",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "expireDate": {
    "description": "Expiration date (YYYY-MM-DD)",
    "type": "string"
   },
   "hideDownload": {
    "description": "Hide download button for public link shares",
    "type": "boolean"
   },
   "label": {
    "description": "Label for public link shares",
    "type": "string"
   },
   "note": {
    "description": "Note to the share recipient",
    "type": "string"
   },
   "password": {
    "description": "Password-protect the share",
    "type": "string"
   },
   "path": {
    "description": "File or folder path to share",
    "type": "string"
   },
   "permissions": {
    "description": "Permission bitmask: 1=read, 2=update, 4=create, 8=delete, 16=share",
    "type": "number"
   },
   "shareType": {
    "description": "Share type: 0=user, 1=group, 3=public link, 4=email, 6=federated",
    "type": "number"
   },
   "shareWith": {
    "description": "Recipient (required for user/group/email/federated; omit for public link)",
    "type": "string"
   }
  },
  "required": [
   "path",
   "shareType"
  ],
  "type": "object"
 },
 "name": "create_share",
 "title": "Create Share"
}
