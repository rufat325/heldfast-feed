{
 "description": "Start an asynchronous UGC video generation. Choose exactly one stock or custom creator. Poll get_video for completion after the request returns.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "required": [
     "creatorId"
    ]
   },
   {
    "required": [
     "customCreatorId"
    ]
   }
  ],
  "properties": {
   "aspectRatio": {
    "description": "For example 9:16, 16:9, or 1:1.",
    "type": "string"
   },
   "clipMode": {
    "description": "Parallel is faster; sequential chains clips for visual continuity.",
    "enum": [
     "parallel",
     "sequential"
    ],
    "type": "string"
   },
   "creatorId": {
    "description": "Stock creator id or slug.",
    "type": "string"
   },
   "customCreatorId": {
    "description": "Custom creator id.",
    "type": "string"
   },
   "dialogue": {
    "default": true,
    "description": "Set false for silent b-roll or reaction clips.",
    "type": "boolean"
   },
   "durationSeconds": {
    "description": "Deprecated and ignored; script length determines duration.",
    "minimum": 1,
    "type": "number"
   },
   "presetSlug": {
    "type": "string"
   },
   "productDescription": {
    "type": "string"
   },
   "productImageUrl": {
    "format": "uri",
    "type": "string"
   },
   "productName": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "scenes": {
    "description": "Optional per-scene spoken lines and visual directions.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "shotType": {
       "type": "string"
      },
      "spokenLine": {
       "minLength": 1,
       "type": "string"
      },
      "visualDirection": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "spokenLine",
      "visualDirection"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "script": {
    "description": "Voiceover text when dialogue is true; visual direction when dialogue is false.",
    "maxLength": 2400,
    "minLength": 20,
    "type": "string"
   },
   "useNativeAudio": {
    "default": true,
    "type": "boolean"
   },
   "videoModel": {
    "type": "string"
   },
   "voiceId": {
    "type": "string"
   },
   "voiceModel": {
    "type": "string"
   }
  },
  "required": [
   "script",
   "productName"
  ],
  "type": "object"
 },
 "name": "generate_video"
}
