{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Restaure un backup (ATTENTION: op\u00e9ration destructive!) \u26a0\ufe0f ATTENTION: Op\u00e9ration potentiellement destructive!",
 "inputSchema": {
