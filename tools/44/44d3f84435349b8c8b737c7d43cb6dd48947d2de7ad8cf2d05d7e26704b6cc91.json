     "port": {
      "maximum": 65535,
      "minimum": 1,
      "type": "integer"
     },
     "ssh_options": {
      "items": {
       "pattern": "^[A-Za-z][A-Za-z0-9]*=[^\\r\\n]*$",
       "type": "string"
      },
      "maxItems": 32,
      "type": "array"
     },
     "user": {
      "pattern": "^(?!-)[A-Za-z0-9._@\\\\-]{1,128}$",
      "type": "string"
     }
    },
    "required": [
     "host"
    ],
    "type": "object"
   },
   "session_id": {
    "type": "string"
