{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create one short link. Returns state, URLs when active, qr_tracking_url. Requires registered account. Anonymous MCP is not supported.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "alias": "notes",
    "idempotency_key": "example-create-1",
    "locale": "en",
    "title": "Notes",
    "url": "https://example.com/notes"
   }
  ],
  "properties": {
   "alias": {
    "description": "Optional custom path segment (stored lowercase). Do not send customSlug.",
    "maxLength": 32,
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Client-generated unique key for this create. Required. Replays within 24h.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Accepted values: en, zh-CN, and zh-cn (the only case fold of zh-CN). EN, ZH-CN, and bare zh are rejected. Omitted or blank defaults to en.",
    "type": "string"
   },
   "title": {
    "description": "Optional link title, at most 256 characters.",
    "maxLength": 256,
    "type": "string"
   },
   "url": {
    "description": "Destination HTTPS/HTTP URL to shorten. Required. Do not send longUrl.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "shorten_url",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "destination": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "qr_tracking_url": {
    "type": "string"
   },
   "request_id": {
    "type": "string"
   },
   "retryable": {
    "type": "boolean"
   },
   "short_url": {
    "type": "string"
   },
   "short_url_ascii": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "status_url": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "request_id"
  ],
  "type": "object"
 },
 "title": "Shorten URL"
}
