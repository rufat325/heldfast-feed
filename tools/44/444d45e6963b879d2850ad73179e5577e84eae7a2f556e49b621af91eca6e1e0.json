    "type": "string"
   },
   "response": {
    "description": "The review response value",
    "enum": [
     "approve",
     "request_changes"
    ],
    "type": "string"
   },
   "review_id": {
    "description": "The review identifier",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "review_id",
   "response"
  ],
  "type": "object"
 },
