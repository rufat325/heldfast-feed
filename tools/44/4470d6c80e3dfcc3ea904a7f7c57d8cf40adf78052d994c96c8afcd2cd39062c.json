{
 "description": "Inspect failed jobs in a BullMQ queue \u2014 shows job ID, name, error reason, attempts, and stack trace",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 10,
    "description": "Number of failed jobs to return",
    "type": "number"
   },
   "queue": {
    "description": "BullMQ queue name",
    "type": "string"
   },
   "redis_url": {
    "default": "redis://localhost:6379",
    "description": "Redis connection URL",
    "type": "string"
   }
  },
  "required": [
   "queue"
  ],
  "type": "object"
 },
 "name": "bullmq_failed_jobs"
}
