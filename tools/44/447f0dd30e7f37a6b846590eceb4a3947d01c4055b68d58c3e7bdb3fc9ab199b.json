{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"Generate Bar Chart"},"description":"Generate a horizontal bar chart to show data for numerical comparisons among different categories, such as, comparing categorical data and for horizontal comparisons. Hosted by Darwin using AntV's public free renderer. Returns a PNG image. Accepts at most 50 rows with bounded image sizes. No API key is required; payments are not supported.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"axisXTitle":{"default":"","maxLength":128,"type":"string"},"axisYTitle":{"default":"","maxLength":128,"type":"string"},"data":{"items":{"additionalProperties":false,"properties":{"category":{"maxLength":128,"minLength":1,"type":"string"},"group":{"maxLength":128,"type":"string"},"value":{"maximum":1000000000000,"minimum":-1000000000000,"type":"number"}},"required":["category","value"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"group":{"default":false,"description":"Whether grouping is enabled. When enabled, bar charts require a 'group' field in the data. When `group` is true, `stack` should be false.","type":"boolean"},"height":{"default":400,"maximum":1200,"minimum":256,"type":"integer"},"stack":{"default":true,"description":"Whether stacking is enabled. When enabled, bar charts require a 'group' field in the data. When `stack` is true, `group` should be false.","type":"boolean"},"style":{"additionalProperties":false,"properties":{"backgroundColor":{"pattern":"^#[a-fA-F0-9]{3}(?:[a-fA-F0-9]{3})?$","type":"string"},"palette":{"items":{"pattern":"^#[a-fA-F0-9]{3}(?:[a-fA-F0-9]{3})?$","type":"string"},"maxItems":20,"minItems":1,"type":"array"},"texture":{"enum":["default","rough"],"type":"string"}},"type":"object"},"theme":{"default":"default","description":"Set the theme for the chart, optional, default is 'default'.","enum":["default","academy","dark"]