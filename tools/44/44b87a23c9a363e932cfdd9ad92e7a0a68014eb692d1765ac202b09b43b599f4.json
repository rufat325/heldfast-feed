{
 "description": "Rule-based shortlist (up to 5) for a buyer's project, with the reasons for each match \u2014 the same published matching rules as the questionnaire on erppartnerfinder.com. Read-only: nothing is sent to any partner. To let the buyer contact partners, call prepare_request.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ai_assisted_delivery": {
    "default": "none",
    "enum": [
     "important",
     "nice",
     "none"
    ],
    "type": "string"
   },
   "apps": {
    "default": [],
    "items": {
     "enum": [
      "accounting",
      "invoicing",
      "sales",
      "crm",
      "purchase",
      "inventory",
      "manufacturing",
      "plm",
      "quality",
      "maintenance",
      "project",
      "timesheets",
      "field_service",
      "helpdesk",
      "planning",
      "website",
      "ecommerce",
      "pos",
      "marketing",
      "email_marketing",
      "events",
      "appointments",
      "hr",
      "payroll",
      "recruitment",
      "expenses",
      "documents",
      "sign",
      "rental",
      "subscriptions",
      "fleet",
      "repair",
      "studio",
      "knowledge",
      "spreadsheet_bi"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "country": {
    "enum": [
     "DE",
     "AT",
     "CH",
     "other"
    ],
    "type": "string"
   },
   "employees": {
    "enum": [
     "1-10",
     "11-50",
     "51-200",
     "201-500",
     "500+"
    ],
    "type": "string"
   },
   "industry": {
    "enum": [
     "other",
     "manufacturing",
     "wholesale_distribution",
     "retail_ecommerce",
     "construction_trades",
     "professional_services",
     "it_software",
     "logistics_transport",
     "food_beverage",
     "healthcare_pharma",
     "energy_utilities",
     "real_estate",
     "education",
     "nonprofit",
     "public_sector",
     "finance_insurance",
     "hospitality_tourism",
     "automotive",
     "agriculture",
     "media_marketing"
    ],
    "type": "string"
   },
   "languages": {
    "default": [
     "de"
    ],
    "items": {
     "enum": [
      "de",
      "en",
      "fr",
      "it"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "situation": {
    "enum": [
     "new",
     "switch",
     "rescue",
     "upgrade"
    ],
    "type": "string"
   },
   "users": {
    "description": "Planned Odoo users",
    "enum": [
     "1-5",
     "6-20",
     "21-50",
     "51-200",
     "200+"
    ],
    "type": "string"
   }
  },
  "required": [
   "country",
   "industry",
   "employees",
   "users",
   "situation"
  ],
  "type": "object"
 },
 "name": "match_partners",
 "title": "Match partners to a project"
}
