{
 "description": "Compute the Coast FIRE milestone \u2014 the capital required today such that, with no further contributions, a portfolio compounds to the user's retirement target by their target age.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annual_expenses_in_retirement": {
    "minimum": 1,
    "type": "number"
   },
   "currency": {
    "default": "USD",
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "CHF",
     "JPY",
     "CAD",
     "AUD",
     "DKK"
    ],
    "type": "string"
   },
   "current_age": {
    "maximum": 80,
    "minimum": 18,
    "type": "integer"
   },
   "current_savings": {
    "minimum": 0,
    "type": "number"
   },
   "expected_return_rate": {
    "default": 7,
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "inflation_rate": {
    "default": 3,
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "monthly_savings": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "portfolio_volatility": {
    "default": 0,
    "maximum": 50,
    "minimum": 0,
    "type": "number"
   },
   "safe_withdrawal_rate": {
    "default": 4,
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "target_retirement_age": {
    "maximum": 100,
    "minimum": 30,
    "type": "integer"
   }
  },
  "required": [
   "current_age",
   "target_retirement_age",
   "current_savings",
   "annual_expenses_in_retirement"
  ],
  "type": "object"
 },
 "name": "calculate_coast_fire"
}
