{
 "description": "Request a production readiness analysis pack tailored to your technology stack. Returns framework-specific rules, security advisories, and analysis prompts for local scanning.",
 "inputSchema": {
  "properties": {
   "dependencies": {
    "description": "Map of package name to version for CVE lookup (e.g., {\"next\": \"16.0.0\", \"react\": \"19.0.0\"})",
    "type": "object"
   },
   "focus": {
    "description": "Focus area for the pack. 'full' covers all domains (default).",
    "enum": [
     "full",
     "security",
     "api",
     "deploy",
     "stability"
    ],
    "type": "string"
   },
   "framework": {
    "description": "The web framework (e.g., 'nextjs', 'remix', 'vite', 'nuxt', 'sveltekit', 'astro')",
    "type": "string"
   },
   "framework_version": {
    "description": "The framework version (e.g., '16.0.0')",
    "type": "string"
   },
   "integrations": {
    "description": "Third-party integrations detected (e.g., ['supabase', 'stripe', 'github'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "language": {
    "description": "The primary language",
    "enum": [
     "typescript",
     "javascript"
    ],
    "type": "string"
   },
   "package_manager": {
    "description": "The package manager",
    "enum": [
     "npm",
     "pnpm",
     "yarn",
     "bun"
    ],
    "type": "string"
   }
  },
  "required": [
   "framework",
   "language",
   "package_manager"
  ],
  "type": "object"
 },
 "name": "request_intelligence_pack"
}
