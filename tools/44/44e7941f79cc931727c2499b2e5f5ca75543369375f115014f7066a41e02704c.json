{
 "description": "Return a single COSO component by id, with its principles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "enum": [
     "control-environment",
     "risk-assessment",
     "control-activities",
     "information-communication",
     "monitoring-activities"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_component",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "component": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "enum": [
         "control-environment",
         "risk-assessment",
         "control-activities",
         "information-communication",
         "monitoring-activities"
        ],
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "number": {
        "type": "number"
       },
       "principles": {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "summary": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "number",
       "name",
       "summary",
       "principles"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "found": {
    "type": "boolean"
   }
  },
  "required": [
   "found",
   "component"
  ],
  "type": "object"
 },
 "title": "Get a COSO component"
}
