{
 "description": "Update a link's destination, title, notes, scheduling, click limit, folder or protections. Use the remove_* flags to clear a field.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bio_visible": {
    "description": "Show/hide this link on your public link-in-bio page",
    "type": "boolean"
   },
   "burn_after_reading": {
    "description": "Toggle one-time (burn-after-reading) behaviour",
    "type": "boolean"
   },
   "expires_at": {
    "description": "New ISO-8601 expiry timestamp",
    "type": "string"
   },
   "folder_id": {
    "description": "Move the link to this folder id",
    "type": "integer"
   },
   "id": {
    "description": "The link id",
    "type": "integer"
   },
   "max_clicks": {
    "description": "New maximum click count",
    "minimum": 1,
    "type": "integer"
   },
   "notes": {
    "description": "New private notes",
    "type": "string"
   },
   "password": {
    "description": "New password",
    "type": "string"
   },
   "remove_expiration": {
    "description": "Clear the expiry so the link never expires",
    "type": "boolean"
   },
   "remove_max_clicks": {
    "description": "Clear the click limit",
    "type": "boolean"
   },
   "remove_password": {
    "description": "Remove password protection",
    "type": "boolean"
   },
   "remove_starts_at": {
    "description": "Clear the activation timestamp",
    "type": "boolean"
   },
   "safe_link_interstitial": {
    "description": "Toggle the safety interstitial page",
    "type": "boolean"
   },
   "starts_at": {
    "description": "New ISO-8601 activation timestamp",
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "description": "New destination URL",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_link"
}
