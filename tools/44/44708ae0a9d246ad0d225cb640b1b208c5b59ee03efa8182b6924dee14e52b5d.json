{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a DORA deployment event for tracking deployment frequency and lead time",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "environment": {
    "description": "Environment name. Example: production, staging",
    "type": "string"
   },
   "finishedAt": {
    "description": "Unix timestamp (seconds) when deployment finished",
    "type": "number"
   },
   "service": {
    "description": "Service name for the deployment. Example: my-api-service",
    "type": "string"
   },
   "startedAt": {
    "description": "Unix timestamp (seconds) when deployment started",
    "type": "number"
   },
   "version": {
    "description": "Version or git SHA of the deployment. Example: v1.2.3 or abc123",
    "type": "string"
   }
  },
  "required": [
   "service",
   "startedAt",
   "finishedAt"
  ],
  "type": "object"
 },
 "name": "send-dora-deployment"
}
