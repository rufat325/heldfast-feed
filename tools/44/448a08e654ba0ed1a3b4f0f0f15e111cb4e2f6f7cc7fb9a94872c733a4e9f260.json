     "date-without-year",
     "date-param-no-format",
     "phone-as-numerals",
     "email-written-raw",
     "url-written-raw",
     "hyphen-range",
     "long-digit-string",
     "markdown-output",
     "no-spelling-protocol",
     "bare-letter-spelling",
     "english-anchors-multilingual",
     "claims-to-be-human",
     "no-ai-disclosure",
     "no-recording-notice",
     "scripted-tool-start",
     "stall-phrases",
     "silent-opener",
     "long-opener",
     "tool-no-description",
     "tool-param-untyped",
     "tool-param-undescribed",
     "tool-required-missing",
     "tool-result-unstated",
     "vapi-nested-item-enum",
     "vapi-flat-analysis-keys",
     "vapi-analysis-plan-off",
     "vapi-analysis-no-transcript",
     "turbo-tts-stutter",
