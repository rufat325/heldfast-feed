{
 "description": "Search construct names and definitions across all canons (or one canon) by deterministic token scoring.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "canon": {
    "description": "Restrict to one canon slug.",
    "type": "string"
   },
   "limit": {
    "description": "Maximum matches to return.",
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "Search query.",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_constructs",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "matches": {
    "items": {
     "properties": {
      "canon": {
       "type": "string"
      },
      "definition": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "score": {
       "type": "integer"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "score",
      "canon",
      "name",
      "definition",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query",
   "count",
   "matches"
  ],
  "type": "object"
 }
}
