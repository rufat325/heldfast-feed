{
 "description": "Find queries ranking just off page 1 with high impressions, the highest-ROI keywords to improve",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endDate": {
    "description": "End date in YYYY-MM-DD; defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum opportunities to return; defaults to 50",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "maxPosition": {
    "description": "Highest average position to include; defaults to 20",
    "minimum": 0,
    "type": "number"
   },
   "minImpressions": {
    "description": "Minimum impressions required; defaults to 10",
    "minimum": 0,
    "type": "number"
   },
   "minPosition": {
    "description": "Lowest average position to include; defaults to 5",
    "minimum": 0,
    "type": "number"
   },
   "siteUrl": {
    "description": "Search Console property to analyze",
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "description": "Start date in YYYY-MM-DD; defaults to the latest 28-day window",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "search_opportunities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "opportunities": {
    "description": "Highest-value striking-distance rows",
    "items": {
     "additionalProperties": false,
     "properties": {
      "clicks": {
       "description": "Search clicks",
       "type": "number"
      },
      "ctr": {
       "description": "Click-through rate as a fraction",
       "type": "number"
      },
      "impressions": {
       "description": "Search impressions",
       "type": "number"
      },
      "keys": {
       "description": "Dimension values in request order",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "opportunity": {
       "description": "Opportunity score based on impressions and position",
       "type": "number"
      },
      "position": {
       "description": "Average search position",
       "type": "number"
      }
     },
     "required": [
      "keys",
      "impressions",
      "clicks",
      "ctr",
      "position",
      "opportunity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "siteUrl": {
    "description": "Search Console property analyzed",
    "type": "string"
   },
   "truncated": {
    "description": "Whether Search Console held more than 5000 rows for this window, so the list was computed from the top rows only",
    "type": "boolean"
   },
   "window": {
    "additionalProperties": false,
    "description": "Analysis window",
    "properties": {
     "endDate": {
      "description": "Inclusive window end date",
      "type": "string"
     },
     "startDate": {
      "description": "Inclusive window start date",
      "type": "string"
     }
    },
    "required": [
     "startDate",
     "endDate"
    ],
    "type": "object"
   }
  },
  "required": [
   "siteUrl",
   "window",
   "truncated",
   "opportunities"
  ],
  "type": "object"
 }
}
