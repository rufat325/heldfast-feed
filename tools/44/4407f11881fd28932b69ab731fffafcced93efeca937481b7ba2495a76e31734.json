{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one file an app has stored, as a WINDOW of its bytes: offset/length select it, data_base64 carries exactly that window, next_offset continues (same window grammar as get_app, and for the same reason). Reassemble by concatenating decoded windows; sha256 is the WHOLE file's hash, so reassembly is checkable.",
 "inputSchema": {
  "properties": {
   "app": {
    "type": "string"
   },
   "length": {
    "description": "max bytes for this window (default fits the result budget)",
    "type": "number"
   },
   "offset": {
    "description": "byte offset to read from (default 0)",
    "type": "number"
   },
   "path": {
    "description": "the file's logical name",
    "type": "string"
   }
  },
  "required": [
   "app",
   "path"
  ],
  "type": "object"
 },
 "name": "file_read",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "app": {
    "type": "string"
   },
   "data_base64": {
    "type": "string"
   },
   "eot": {
    "type": "string"
   },
   "mime": {
    "type": "string"
   },
   "next_offset": {
    "type": [
     "number",
     "null"
    ]
   },
   "offset": {
    "type": "number"
   },
   "path": {
    "type": "string"
   },
   "returned": {
    "type": "number"
   },
   "sha256": {
    "type": "string"
   },
   "size": {
    "type": "number"
   },
   "total": {
    "type": "number"
   },
   "version": {
    "type": "number"
   }
  },
  "required": [
   "app",
   "path",
   "mime",
   "size",
   "sha256",
   "version"
  ],
  "type": "object"
 },
 "title": "Read an app file"
}
