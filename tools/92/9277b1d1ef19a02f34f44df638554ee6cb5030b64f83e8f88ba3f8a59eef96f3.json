{"_meta":{"xdata.kr/credential":{"providers":[],"register_url":null,"required":false,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\uace0\uac1d\uc774 \ubcf4\uad00\uc744 \uc694\uccad\ud55c \ub9c8\ucf00\ud305 \uc131\uacfc \ubcf4\uace0\ub97c \uc5d1\uc2a4\ubcf4\uc2a4\uc5d0 \ubcf4\uad00\ud558\uace0 \ubcf4\uad00 \ubc88\ud638(archived_report_id)\ub97c \ub3cc\ub824\uc90d\ub2c8\ub2e4. report_content \uc5d0\ub294 \uc131\uacfc \ubcf4\uace0 \ub3c4\uad6c\uac00 \ub3cc\ub824\uc900 \uacb0\uacfc\ub97c \uadf8\ub300\ub85c \ub123\uace0, \ucc44\ub110 \uc774\ub984\uacfc \ubcf4\uace0 \uae30\uac04, \ubcf4\uace0\ub97c \ub9cc\ub4e0 \uc2dc\uac01(as_of)\uc744 \ud568\uaed8 \ub123\uc2b5\ub2c8\ub2e4. \uace0\uac1d\uc774 \ubcf4\uad00\uc744 \uc694\uccad\ud588\uc744 \ub54c\ub9cc \ubd80\ub974\uc138\uc694. \ubd80\ub97c \ub54c\ub9c8\ub2e4 \ud55c \uac74\uc529 \uc0c8\ub85c \ubcf4\uad00\ub418\ub2c8 \uac19\uc740 \ubcf4\uace0\ub294 \ud55c \ubc88\ub9cc \ubcf4\ub0c5\ub2c8\ub2e4. \uad11\uace0\ub098 \uc678\ubd80 \uae30\uad00\uc5d0 \uc544\ubb34\uac83\ub3c4 \uc4f0\uc9c0 \uc54a\uc73c\uba70 \ub85c\uadf8\uc778\uc774\ub098 \uc5f0\ub3d9\uc774 \ud544\uc694 \uc5c6\uc2b5\ub2c8\ub2e4. \ubcf4\uad00\ud55c \ubcf4\uace0\ub294 \ubcf4\uad00\ud55c \ub9c8\ucf00\ud305 \ubcf4\uace0 \ucc3e\uae30 \ub3c4\uad6c\ub85c \ub2e4\uc2dc \ucc3e\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"as_of":{"description":"\ubcf4\uace0\ub97c \ub9cc\ub4e0 \uc2dc\uac01(\uacb0\uacfc\uc758 as_of \uac12)","minLength":1,"type":"string"},"basis":{"description":"\ubcf4\uace0 \uc8fc\uae30(\uc120\ud0dd, 20\uc790 \uc774\ub0b4). \uc608: \uc77c, \uc8fc, \uc6d4","maxLength":20,"type":"string"},"channels":{"description":"\ubcf4\uace0\uc5d0 \ub2f4\uae34 \ucc44\ub110 \uc774\ub984 \ubaa9\ub85d","items":{"description":"\ucc44\ub110 \uc774\ub984","minLength":1,"type":"string"},"minItems":1,"type":"array"},"grounds":{"description":"\ubcf4\uace0\uc758 \uadfc\uac70 \uba54\ubaa8(\uc120\ud0dd)","type":"object"},"period_end_exclusive":{"description":"\ubcf4\uace0 \uae30\uac04 \ub05d \ub0a0\uc9dc(\uc774 \ub0a0\uc740 \ube60\uc9c4\ub2e4) (YYYY-MM-DD)","minLength":1,"type":"string"},"period_start":{"description":"\ubcf4\uace0 \uae30\uac04 \uc2dc\uc791 \ub0a0\uc9dc (YYYY-MM-DD)","minLength":1,"type":"string"},"report_content":{"description":"\uc131\uacfc \ubcf4\uace0 \ub3c4\uad6c\uac00 \ub3cc\ub824\uc900 \uacb0\uacfc \uadf8\ub300\ub85c","type":"object"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \