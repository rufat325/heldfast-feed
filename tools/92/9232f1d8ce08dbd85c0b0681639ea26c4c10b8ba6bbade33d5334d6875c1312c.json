{
 "description": "Automatically suggests and applies tags to sessions. Actions: suggest (recommend tags), apply (add tags to session), train (learn from examples), config (configure tagging behavior).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "suggest",
     "apply",
     "train",
     "config"
    ],
    "type": "string"
   },
   "categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "codeBlocks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "language": {
       "default": "text",
       "type": "string"
      }
     },
     "required": [
      "code"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "content": {
    "type": "string"
   },
   "customPatterns": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "pattern": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "pattern",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "defaultCategories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "enableAutoTag": {
    "type": "boolean"
   },
   "examples": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "content",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "includeExisting": {
    "default": true,
    "type": "boolean"
   },
   "maxTags": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "minConfidence": {
    "default": 0.7,
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "sessionId": {
    "type": "string"
   },
   "useAI": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_auto_tag"
}
