  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cnpj": {
    "description": "Brazilian CNPJ, 14 characters, with or without punctuation (e.g. 00.000.000/0001-91).",
    "maxLength": 18,
    "minLength": 14,
    "type": "string"
   }
  },
  "required": [
   "cnpj"
  ],
  "type": "object"
 },
 "name": "br_company_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "cached": {
    "type": "boolean"
   },
   "cnpj": {
    "description": "Normalized 14-character CNPJ.",
    "type": "string"
   },
   "data_freshness": {
    "type": "string"
   },
   "generated_at": {
    "type": "string"
   },
   "legal_name": {
    "type": "string"
   },
   "main_activity": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "description": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "description"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "opened_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "registration_status": {
    "description": "ATIVA, SUSPENSA, INAPTA, BAIXADA, NULA or UNKNOWN.",
    "type": "string"
   },
   "sources": {
    "description": "Source URL and fetch time of each fact.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "fetched_at": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "url",
      "fetched_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Short summary in English and Portuguese.",
    "properties": {
     "en": {
      "type": "string"
     },
     "pt": {
      "type": "string"
     }
    },
    "required": [
     "en",
     "pt"
    ],
    "type": "object"
   }
  },
  "required": [
   "cnpj",
   "summary",
   "sources",
   "data_freshness",
   "generated_at",
   "cached",
   "legal_name",
   "registration_status",
   "opened_at",
   "main_activity",
   "address"
  ],
  "type": "object"
 }
}
