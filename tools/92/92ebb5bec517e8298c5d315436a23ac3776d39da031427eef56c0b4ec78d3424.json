  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a hotel price"
 },
 "description": "Say whether a price the person has been quoted for a hotel is high, low or usual for that hotel in that month, using HotelMonitor's own scans. Use it when someone asks \"is this a good price?\". Returns no verdict when there is not enough data. Prices are tax-inclusive nightly figures for two adults from past scans, not a live quote. Results include page_url (price history) and book_url (a booking-site link with the dates filled in) for checking the current price.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "checkin": {
    "description": "YYYY-MM-DD, today or later.",
    "type": "string"
   },
   "checkout": {
    "description": "YYYY-MM-DD. Required when per is \"stay\". At most 30 nights.",
    "type": "string"
   },
   "destination": {
    "description": "Destination slug, e.g. tenerife, new-york, algarve.",
    "type": "string"
   },
   "hotel": {
    "maxLength": 120,
    "type": "string"
   },
   "per": {
    "description": "Is price per night or for the whole stay?",
    "enum": [
     "night",
     "stay"
    ],
    "type": "string"
   },
   "price": {
    "description": "In GBP.",
    "type": "number"
   },
   "via": {
    "description": "Optional short name of your app or assistant (lower-case letters, digits, - or _), used in booking links so we can see where visits come from.",
    "maxLength": 32,
    "type": "string"
   }
  },
  "required": [
   "hotel",
   "destination",
   "checkin",
   "price",
   "per"
  ],
  "type": "object"
 },
 "name": "check_hotel_price",
