{
 "description": "Search for available human operators near a location who can perform real-world tasks like verifications, photo documentation, deliveries, and inspections.",
 "inputSchema": {
  "properties": {
   "lat": {
    "description": "Latitude of the task location",
    "type": "number"
   },
   "lng": {
    "description": "Longitude of the task location",
    "type": "number"
   },
   "min_rating": {
    "description": "Minimum operator rating (0-5)",
    "type": "number"
   },
   "radius_km": {
    "default": 50,
    "description": "Search radius in kilometers (default: 50, max: 500)",
    "type": "number"
   },
   "task_type": {
    "enum": [
     "VERIFICATION",
     "PHOTO",
     "DELIVERY",
     "INSPECTION",
     "CAPTCHA_SOLVING",
     "FORM_FILLING",
     "BROWSER_INTERACTION",
     "CONTENT_REVIEW",
     "DATA_VALIDATION",
     "ACCOUNT_CREATION",
     "API_KEY_PROCUREMENT",
     "PHONE_VERIFICATION",
     "SUBSCRIPTION_SETUP"
    ],
    "type": "string"
   }
  },
  "required": [
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "search_operators"
}
