{"_meta":{"securitySchemes":[{"scopes":["admin"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Delete a draft post"},"description":"Permanently deletes a draft post and its target rows. Use this only when the user explicitly asks to discard a draft. Returns deleted=true, the post id and what the deleted draft was (title, caption, type, media count). Does NOT delete scheduled or published posts (returns an error), and does NOT remove anything already published on a platform.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"post_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"}},"required":["post_id"],"type":"object"},"name":"delete_post","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"deleted":{"const":true,"type":"boolean"},"post":{"additionalProperties":false,"properties":{"content":{"type":["string","null"]},"mediaCount":{"type":"number"},"title":{"type":["string","null"]},"type":{"type":"string"}},"required":["title","content","type","mediaCount"],"type":"object"},"post_id":{"type":"string"}},"required":["deleted","post_id","post"],"type":"object"},"title":"Delete a draft post"}
