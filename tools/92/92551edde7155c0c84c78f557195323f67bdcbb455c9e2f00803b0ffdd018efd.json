{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The ready-made presets and the per-game options create_server accepts for a game (keys, allowed values, defaults, what is available on this account). Call it before create_server when the user wants a particular setup, e.g. offline mode, a difficulty, a map or a player count.",
 "inputSchema": {
  "properties": {
   "game": {
    "description": "Game short name, e.g. \"minecraft-java\" (default), \"terraria\", \"rust\", \"cs2\". Same slugs as create_server.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_creation_options",
 "outputSchema": {
  "properties": {
   "game": {
    "type": "string"
   },
   "options": {
    "items": {
     "properties": {
      "available": {
       "description": "False when this account cannot use it (with the reason in unavailable_reason).",
       "type": "boolean"
      },
      "choices": {
       "description": "For select options.",
       "items": {
        "properties": {
         "label": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "default": {
       "description": "The default value, as text.",
       "type": "string"
      },
      "docs": {
       "description": "A docs page for the options that need one.",
       "type": "string"
      },
      "help": {
       "type": "string"
      },
      "key": {
       "description": "Pass this inside create_server's options.",
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "max": {
       "type": "integer"
      },
      "min": {
       "type": "integer"
      },
      "type": {
       "description": "boolean, select, number or text.",
       "type": "string"
      },
      "unavailable_reason": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "presets": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "key": {
       "description": "Pass this as create_server's preset.",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "options": {
       "description": "The option values the preset fills in.",
       "type": "object"
      },
      "yours": {
       "description": "True for a preset the user saved from one of their servers.",
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "game",
   "presets",
   "options"
  ],
  "type": "object"
 },
 "title": "Get Creation Options"
}
