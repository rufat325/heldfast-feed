{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Liefert eine einzelne Folge des Podcasts \"Biohacking Kompakt\" mit Titel, Erscheinungsdatum, Hoerlinks und - wenn die Folge einem Thema der Seite zugeordnet ist - dessen Kurzfassung samt BK-Score.\n\nArgs:\n  - nr (number): Folgennummer\n  - response_format ('markdown' | 'json')\n\nReturns: { nr, titel, datum, spotify, apple, thema: { id, view, name, kurz, score_label } | null }\n\nFehlerfaelle:\n  - Folge existiert nicht oder ist noch nicht erschienen: die Antwort sagt, welche Nummern es gibt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nr": {
    "description": "Folgennummer, z. B. 63",
    "minimum": 1,
    "type": "integer"
   },
   "response_format": {
    "default": "markdown",
    "description": "Ausgabeformat: 'markdown' zum Lesen, 'json' zum Weiterverarbeiten",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   }
  },
  "required": [
   "nr"
  ],
  "type": "object"
 },
 "name": "bk_get_podcast_episode",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apple": {
    "$ref": "#/properties/datum"
   },
   "datum": {
    "type": [
     "string",
     "null"
    ]
   },
   "nr": {
    "type": [
     "number",
     "null"
    ]
   },
   "spotify": {
    "$ref": "#/properties/datum"
   },
   "thema": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "kurz": {
        "$ref": "#/properties/datum"
       },
       "name": {
        "type": "string"
       },
       "score_label": {
        "$ref": "#/properties/datum"
       },
       "url": {
        "type": "string"
       },
       "view": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "view",
       "name",
       "kurz",
       "score_label",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "titel": {
    "type": "string"
   }
  },
  "required": [
   "nr",
   "titel",
   "datum",
   "spotify",
   "apple",
   "thema"
  ],
  "type": "object"
 },
 "title": "Eine Podcastfolge abrufen"
}
