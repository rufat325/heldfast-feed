{
 "_meta": {
  "openai/outputTemplate": "ui://widget/xenition-slides.html",
  "openai/toolInvocation/invoked": "Deck ready",
  "openai/toolInvocation/invoking": "Designing your deck\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "xenition.read",
     "xenition.write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://xenition-app/xenition-slides.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a slide deck"
 },
 "description": "Create a polished, designed presentation deck in the user's Xenition workspace from a brief or topic. Returns the deck's slides (shown as an inline preview) plus a link to open and edit it in Xenition. Use when the user asks for slides, a deck, a presentation, or a pitch deck.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "brief": {
    "description": "what the deck is about \u2014 a topic, brief, or outline (e.g. 'a 10-slide investor pitch for a solar-panel startup')",
    "type": "string"
   },
   "title": {
    "description": "optional title for the saved deck; defaults to a title the engine chooses",
    "type": "string"
   }
  },
  "required": [
   "brief"
  ],
  "type": "object"
 },
 "name": "create_slides",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifactId": {
    "type": "string"
   },
   "openUrl": {
    "type": "string"
   },
   "slideCount": {
    "type": "integer"
   },
   "slides": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bullets": {
       "items": {
        "type": "string"
       },
       "type": [
        "null",
        "array"
       ]
      },
      "imageUrl": {
       "type": "string"
      },
      "subtitle": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "theme": {
    "additionalProperties": false,
    "properties": {
     "accent": {
      "type": "string"
     },
     "background": {
      "type": "string"
     },
     "primary": {
      "type": "string"
     },
     "text": {
      "type": "string"
     }
    },
    "required": [
     "primary",
     "accent",
     "background",
     "text"
    ],
    "type": "object"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "artifactId",
   "title",
   "slideCount",
   "theme",
   "slides"
  ],
  "type": "object"
 },
 "title": "Create a slide deck"
}
