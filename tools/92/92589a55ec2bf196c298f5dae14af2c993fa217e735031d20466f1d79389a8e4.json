{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List enrichment runs",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entityId": {
    "description": "Exact company id; never matches contact runs.",
    "type": "string"
   },
   "entityType": {
    "enum": [
     "company",
     "contact"
    ],
    "type": "string"
   },
   "fromDate": {
    "description": "Include runs created at or after this instant.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Repeatable. Unknown values are rejected with `422`.",
    "items": {
     "enum": [
      "processing",
      "completed",
      "failed"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "toDate": {
    "description": "Include runs created at or before this instant.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
   "type": {
    "description": "Run type \u2014 `custom` or a prebuilt enrichment type.",
    "enum": [
     "custom",
     "firmographics",
     "funding",
     "mna",
     "open-jobs",
     "tech-stack"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "enrichment_runs-list"
}
