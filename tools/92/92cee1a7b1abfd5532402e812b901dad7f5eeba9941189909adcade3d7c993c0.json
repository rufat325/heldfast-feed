{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Prepare a creator fee claim"
 },
 "description": "Unsigned transactions that collect the creator fee owed to an address across its markets: one claimCreatorFees() call per curve, or one Multicall3 batch per chain when several are owed. The curve always pays its immutable creator, whoever sends the transaction.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "Creator address whose owed fees to collect.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "chainId": {
    "description": "Only this chain. Omit for every chain.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "prepare_claim",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "address": {
    "description": "Creator address.",
    "type": [
     "string",
     "null"
    ]
   },
   "checkedMarkets": {
    "description": "Markets checked."
   },
   "claimable": {
    "description": "Markets that owe this address a creator fee.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "chainId": {
       "description": "Chain id.",
       "type": [
        "number",
        "null"
       ]
      },
      "curve": {
       "description": "Curve that owes the fee.",
       "type": [
        "string",
        "null"
       ]
      },
      "nativeSymbol": {
       "description": "Native asset.",
       "type": [
        "string",
        "null"
       ]
      },
      "owed": {
       "description": "Owed, in the chain's native asset.",
       "type": [
        "number",
        "null"
       ]
      },
      "owedUsd": {
       "description": "Owed, in USD at the current native price.",
       "type": [
        "number",
        "null"
       ]
      },
      "symbol": {
       "description": "Ticker.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "detail": {
    "description": "Why it refused, or extra context on a successful answer."
   },
   "error": {
    "description": "Present only when the tool refused, as a stable code such as unknown_market. Nothing was spent.",
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "description": "Who receives the fee.",
    "type": [
     "string",
     "null"
    ]
   },
   "transactions": {
    "description": "One claim per curve, or one Multicall3 batch per chain.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "chainId": {
       "description": "Chain to send it on.",
       "type": [
        "number",
        "null"
       ]
      },
      "data": {
       "description": "Calldata.",
       "type": [
        "string",
        "null"
       ]
      },
      "from": {
       "description": "Address that must sign and send it.",
       "type": [
        "string",
        "null"
       ]
      },
      "gasEstimate": {
       "description": "Gas estimate, or null when it can only be estimated after the previous transaction is mined.",
       "type": [
        "string",
        "null"
       ]
      },
      "markets": {
       "description": "Markets a claim covers.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "purpose": {
       "description": "What the transaction does.",
       "type": [
        "string",
        "null"
       ]
      },
      "to": {
       "description": "Contract it calls.",
       "type": [
        "string",
        "null"
       ]
      },
      "value": {
       "description": "Native value in wei. Always 0.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "unreadableMarkets": {
    "description": "Markets that could not be read."
   }
  },
  "type": "object"
 },
 "title": "Prepare a creator fee claim"
}
