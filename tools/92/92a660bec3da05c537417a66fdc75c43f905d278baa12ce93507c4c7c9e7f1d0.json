{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List flow events across sessions"
 },
 "description": "List flow events across sessions. Every session event in one feed, oldest first. Ids only increase, so starting_after is a durable high-water mark for a sync loop. Use flow_session, not session_id, to filter by session.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "flow_id": {
    "description": "One flow.",
    "type": "integer"
   },
   "flow_session": {
    "description": "One session.",
    "type": "integer"
   },
   "limit": {
    "default": 100,
    "description": "1 to 100, default 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "node_key": {
    "description": "One step of the flow.",
    "type": "string"
   },
   "since": {
    "description": "ISO-8601 UTC on occurred_at.",
    "format": "date-time",
    "type": "string"
   },
   "starting_after": {
    "description": "The next_cursor from the previous page.",
    "type": "string"
   },
   "type": {
    "description": "Event type.",
    "enum": [
     "session_started",
     "node_entered",
     "node_exited",
     "branch_selected",
     "input_received",
     "link_clicked",
     "outcome_achieved",
     "session_completed",
     "session_expired",
     "session_cancelled",
     "session_reactivated"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_flow_events"
}
