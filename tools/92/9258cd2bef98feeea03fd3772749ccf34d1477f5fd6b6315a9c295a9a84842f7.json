{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read selected course topics"
 },
 "description": "Read CRICOS course topics by code or URL. Defaults to core. Explicit nonempty sections replace the default: core, overview, fees, requirements, intakes, campuses, pathways, packages, similar. Topic options must be nested under their selected section. Full semantic entries are preserved; subsequent pages require unchanged contentVersion. Use fee years/audience, requirement topics, date/campus filters or pageSize to narrow large responses. includeSimilar and unknown arguments are rejected.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "campuses": {
    "additionalProperties": false,
    "properties": {
     "contentVersion": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "page": {
      "default": 1,
      "minimum": 1,
      "type": "integer"
     },
     "pageSize": {
      "default": 10,
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "postcode": {
      "pattern": "^\\d{4}$",
      "type": "string"
     },
     "regionalCategory": {
      "enum": [
       "Category 2",
       "Category 3"
      ],
      "type": "string"
     },
     "state": {
      "enum": [
       "ACT",
       "NSW",
       "NT",
       "QLD",
       "SA",
       "TAS",
       "VIC",
       "WA"
      ],
      "type": "string"
     },
     "status": {
      "default": "open",
      "enum": [
       "open",
       "all"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "course": {
    "minLength": 4,
    "type": "string"
   },
   "fees": {
    "additionalProperties": false,
    "properties": {
     "audience": {
      "enum": [
       "offshore",
       "onshore",
       "domestic",
       "online",
       "voe"
      ],
      "type": "string"
     },
     "offers": {
      "additionalProperties": false,
      "properties": {
       "contentVersion": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "page": {
        "default": 1,
        "minimum": 1,
        "type": "integer"
       },
       "pageSize": {
        "default": 10,
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "years": {
      "items": {
       "maximum": 9999,
       "minimum": 1900,
       "type": "integer"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "intakes": {
    "additionalProperties": false,
    "properties": {
     "contentVersion": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "dateFrom": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "dateTo": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "page": {
      "default": 1,
      "minimum": 1,
      "type": "integer"
     },
     "pageSize": {
      "default": 10,
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "locale": {
    "default": "zh-CN",
    "description": "Language of names/descriptions in the result: zh-CN (default, Simplified Chinese plus English names), en-US, zh-TW. Also selects the language prefix of returned oneuedu.com URLs.",
    "enum": [
     "zh-CN",
     "en-US",
     "zh-TW"
    ],
    "type": "string"
   },
   "packages": {
    "additionalProperties": false,
    "properties": {
     "contentVersion": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "page": {
      "default": 1,
      "minimum": 1,
      "type": "integer"
     },
     "pageSize": {
      "default": 5,
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "pathways": {
    "additionalProperties": false,
    "properties": {
     "contentVersion": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "page": {
      "default": 1,
      "minimum": 1,
      "type": "integer"
     },
     "pageSize": {
      "default": 10,
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "requirements": {
    "additionalProperties": false,
    "properties": {
     "topics": {
      "items": {
       "enum": [
        "english",
        "entry",
        "placement",
        "licensing",
        "accreditation"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "sections": {
    "items": {
     "enum": [
      "core",
      "overview",
      "fees",
      "requirements",
      "intakes",
      "campuses",
      "pathways",
      "packages",
      "similar"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "similar": {
    "additionalProperties": false,
    "properties": {
     "state": {
      "enum": [
       "ACT",
       "NSW",
       "NT",
       "QLD",
       "SA",
       "TAS",
       "VIC",
       "WA"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "course"
  ],
  "type": "object"
 },
 "name": "get_course",
 "title": "Read selected course topics"
}
