{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Ground a claim in the corpus: hybrid semantic + theme retrieval over real passages, returning citations with source, passage code, scores, and a SHORT snippet. Use to check whether the corpus supports, complicates or is silent on an assertion. COSTS a small amount (one embedding per call).\n\n[capability: corpus-ingestion-dual-grade \u00b7 mirrors: internal \u2014 lib/audit/retrieve.ts]",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "claim": {
    "description": "The claim to ground.",
    "minLength": 3,
    "type": "string"
   },
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "claim"
  ],
  "type": "object"
 },
 "name": "vela.corpus.ground_claim",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claim": {
    "type": "string"
   },
   "hits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "passageCode": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "rationale": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      },
      "snippetTruncated": {
       "type": "boolean"
      },
      "sourceTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "themes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "passageCode",
      "sourceTitle",
      "themes",
      "score",
      "rationale",
      "snippet",
      "snippetTruncated"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "claim",
   "hits"
  ],
  "type": "object"
 },
 "title": "vela.corpus.ground_claim"
}
