{
 "description": "Query Datadog Security Monitoring. Actions: rules (list detection rules), signals (search security signals), findings (list security findings). Use for: threat detection, compliance, security posture, incident investigation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "rules",
     "signals",
     "findings"
    ],
    "type": "string"
   },
   "from": {
    "description": "Start time (ISO 8601, relative like \"1h\", \"7d\")",
    "type": "string"
   },
   "id": {
    "description": "Rule or signal ID (for specific lookups)",
    "type": "string"
   },
   "pageCursor": {
    "description": "Cursor for pagination",
    "type": "string"
   },
   "pageSize": {
    "description": "Number of results to return",
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query for signals or findings",
    "type": "string"
   },
   "severity": {
    "description": "Filter by severity",
    "enum": [
     "info",
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter signals by status",
    "enum": [
     "open",
     "under_review",
     "archived"
    ],
    "type": "string"
   },
   "to": {
    "description": "End time (ISO 8601, relative like \"now\")",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "security"
}
