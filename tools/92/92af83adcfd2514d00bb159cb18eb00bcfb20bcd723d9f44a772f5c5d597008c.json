{
 "annotations": {
  "readOnlyHint": true,
  "title": "List Costs"
 },
 "description": "List expense records (for margin/profit analytics) by date and cost group. Returns {costs[], pagination}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter_cost_groups": {
    "description": "Filter by cost group code",
    "type": "string"
   },
   "filter_date_from": {
    "description": "Costs created on/after (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filter_date_to": {
    "description": "Costs created on/before (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_costs"
}
