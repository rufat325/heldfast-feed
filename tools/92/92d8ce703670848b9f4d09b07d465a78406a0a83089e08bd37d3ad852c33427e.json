{
 "_meta": {
  "openai/outputTemplate": "ui://croncool/project-overview-v2.html",
  "openai/toolInvocation/invoked": "Croncool project overview ready.",
  "openai/toolInvocation/invoking": "Loading Croncool project\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://croncool/project-overview-v2.html"
  },
  "ui/resourceUri": "ui://croncool/project-overview-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show Croncool project overview"
 },
 "description": "Use this when someone wants a quick overview or dashboard of one Croncool project. Returns an overview card with the project's name and creation time, whether workflow hosting is set up, and up to 12 jobs with schedule, target origin and last run status. Not for a job's run history.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "projectId": {
    "description": "Project id",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "show_project_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "jobCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "jobCountIsLowerBound": {
    "type": "boolean"
   },
   "jobs": {
    "description": "Up to 12 of the project jobs. Job request payloads, credential-bearing target paths or queries, organization fields and workflow callback secrets are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expression": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "httpMethod": {
       "anyOf": [
        {
         "maxLength": 16,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastExecutionStatus": {
       "anyOf": [
        {
         "enum": [
          "success",
          "failure"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastExecutionTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "targetOrigin": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "type": {
       "anyOf": [
        {
         "maxLength": 60,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "expression",
      "type",
      "targetOrigin",
      "httpMethod",
      "lastExecutionStatus",
      "lastExecutionTime"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 128,
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "workflowHostingConfigured": {
        "type": "boolean"
       }
      },
      "required": [
       "id",
       "name",
       "creationTime",
       "workflowHostingConfigured"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "project",
   "jobCount",
   "jobCountIsLowerBound",
   "jobs"
  ],
  "type": "object"
 },
 "title": "Show Croncool project overview"
}
