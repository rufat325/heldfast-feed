{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Port congestion"
 },
 "description": "Current congestion level at one or more ports: average wait hours, vessels at anchor, and congestion level (low/moderate/high/severe). Provide UN/LOCODE codes like NLRTM, GBFXT, DEHAM, CNSHA.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "port_codes": {
    "description": "UN/LOCODE port codes (e.g. [\"NLRTM\", \"GBFXT\"]). Get them from container details if unsure.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "port_codes"
  ],
  "type": "object"
 },
 "name": "get_port_congestion",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "On an empty result: NOT_FOUND (no record after asking) or NO_EVENTS (record, nothing filed).",
    "type": "string"
   },
   "data": {
    "additionalProperties": true,
    "properties": {
     "ports": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "properties": {
          "avg_wait_hours": {
           "type": [
            "number",
            "null"
           ]
          },
          "congestion_level": {
           "type": [
            "string",
            "null"
           ]
          },
          "name": {
           "type": [
            "string",
            "null"
           ]
          },
          "unlocode": {
           "type": [
            "string",
            "null"
           ]
          },
          "updated_at": {
           "type": [
            "string",
            "null"
           ]
          },
          "vessels_at_anchor": {
           "type": [
            "number",
            "null"
           ]
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "message": {
    "description": "On an empty result: what the emptiness means.",
    "type": "string"
   },
   "ok": {
    "description": "False never appears here \u2014 failures arrive as tool errors.",
    "type": "boolean"
   },
   "result": {
    "description": "\"empty\" means the query succeeded and there is nothing to report.",
    "enum": [
     "data",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "ok",
   "result"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ]
}
