{
 "description": "Remove a submitted sitemap from a Search Console property (write; supports dryRun)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dryRun": {
    "default": false,
    "description": "If true, report what would be removed without writing to Search Console",
    "type": "boolean"
   },
   "feedpath": {
    "description": "Absolute URL of the sitemap to remove",
    "format": "uri",
    "type": "string"
   },
   "siteUrl": {
    "description": "Search Console property",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "feedpath"
  ],
  "type": "object"
 },
 "name": "delete_sitemap",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "type": "boolean"
   },
   "feedpath": {
    "type": "string"
   },
   "siteUrl": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "siteUrl",
   "feedpath"
  ],
  "type": "object"
 }
}
