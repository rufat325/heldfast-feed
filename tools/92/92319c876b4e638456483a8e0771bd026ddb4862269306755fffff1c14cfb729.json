{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Calculate balances and reimbursement suggestions for 2\u201330 participants across 1\u2013100 expenses with different payers and equal or weighted shares. Uses integer cents, deterministic largest-remainder allocation, and offsets debts. Supported single currencies: EUR, USD, GBP, CHF, CAD; no conversion. The tool is stateless and cannot access accounts, fetch data, store results or transfer money. Use aliases when possible.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currency":{"enum":["EUR","USD","GBP","CHF","CAD"],"type":"string"},"expenses":{"items":{"additionalProperties":false,"properties":{"amountCents":{"description":"Positive integer minor units: 18.34 becomes 1834. Never pass floating currency values.","maximum":100000000,"minimum":1,"type":"integer"},"payerId":{"pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,39}$","type":"string"},"shares":{"additionalProperties":{"maximum":10000,"minimum":1,"type":"integer"},"description":"Participant IDs mapped to positive whole-number weights. Omit a participant to exclude them; all 1 means equal shares.","propertyNames":{"pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,39}$","type":"string"},"type":"object"}},"required":["amountCents","payerId","shares"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"participants":{"items":{"additionalProperties":false,"properties":{"id":{"pattern":"^[a-zA-Z][a-zA-Z0-9_-]{0,39}$","type":"string"},"name":{"description":"Display label or alias. Do not include bank, email or other sensitive identifiers.","maxLength":60,"minLength":1,"type":"string"}},"required":["id","name"],"type":"object"},"maxItems":30,"minItems":2,"type":"array"}},"required":["currency","participants","expenses"],"type":"object"},"name":"calculate_shared_expenses","outputSchema":{"$schema":