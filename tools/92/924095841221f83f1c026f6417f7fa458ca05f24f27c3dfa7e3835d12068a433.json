{
 "description": "Assemble A/B preference pairs on a PAIRWISE RL-environment project (same-task pairing by default; repeated assembly over the same pool = k-way ranking). Graded pairs export as DPO JSONL. Requires rlenv:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environmentId": {
    "minLength": 1,
    "type": "string"
   },
   "maxPairs": {
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "strategy": {
    "default": "SAME_TASK",
    "enum": [
     "SAME_TASK",
     "SEQUENTIAL"
    ],
    "type": "string"
   }
  },
  "required": [
   "environmentId",
   "projectId"
  ],
  "type": "object"
 },
 "name": "opentrain_rlenv_assemble_pairs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
