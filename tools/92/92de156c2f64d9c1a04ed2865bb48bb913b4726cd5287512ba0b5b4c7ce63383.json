{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update the description of a container image in a registry (PATCH /repositories/{registry}/{imageName}). Provide description (short, \u2264100 chars) and/or full_description (Markdown).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Short description (max 100 characters)",
    "maxLength": 100,
    "type": "string"
   },
   "full_description": {
    "description": "Detailed description (Markdown supported)",
    "type": "string"
   },
   "imageName": {
    "description": "Name of the image to update (URI-encoded automatically)",
    "type": "string"
   },
   "registryName": {
    "description": "Name of the registry",
    "type": "string"
   }
  },
  "required": [
   "registryName",
   "imageName"
  ],
  "type": "object"
 },
 "name": "ncloud_ncr_update_image"
}
