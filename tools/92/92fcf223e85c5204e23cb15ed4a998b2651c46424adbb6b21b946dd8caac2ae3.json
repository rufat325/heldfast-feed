{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists Docker volumes with structured driver, mountpoint, and scope information.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cluster": {
    "default": false,
    "description": "Display cluster volumes from Docker Swarm (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "filter": {
    "anyOf": [
     {
      "maxLength": 255,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 255,
       "type": "string"
      },
      "maxItems": 1000,
      "type": "array"
     }
    ],
    "description": "Filter by dangling, driver, label, name. String or string[] for multiple filters."
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "volume-ls",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "volumes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "string"
      },
      "driver": {
       "type": "string"
      },
      "labels": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "mountpoint": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "scope": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "driver"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "volumes"
  ],
  "type": "object"
 },
 "title": "Docker Volume LS"
}
