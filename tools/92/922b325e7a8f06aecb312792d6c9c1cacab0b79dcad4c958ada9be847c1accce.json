{
 "description": "Add a text watermark to every page of a PDF.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fontSize": {
    "default": 50,
    "description": "Font size (default 50)",
    "type": "number"
   },
   "input": {
    "description": "Absolute path to the input PDF",
    "type": "string"
   },
   "opacity": {
    "default": 0.3,
    "description": "Watermark opacity (0-1, default 0.3)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "output": {
    "description": "Absolute path for the output PDF",
    "type": "string"
   },
   "text": {
    "description": "Watermark text",
    "type": "string"
   }
  },
  "required": [
   "input",
   "text",
   "output"
  ],
  "type": "object"
 },
 "name": "pdf_watermark"
}
