{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a blog post"
 },
 "description": "Use this when someone wants to read, check or quote one blog post. Returns its title, summary, language, slug, blog, author, published state, dates and up to 8,000 characters of content, looked up by id or by slug plus language. Not for a visual preview card.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idOrSlug": {
    "description": "Article id, or its slug together with locale",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Language of the post, an ISO 639-1 code such as en; needed when looking up by slug",
    "maxLength": 50,
    "type": "string"
   }
  },
  "required": [
   "idOrSlug"
  ],
  "type": "object"
 },
 "name": "get_article",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "article": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "author": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "blogId": {
        "$ref": "#/properties/article/anyOf/0/properties/id"
       },
       "content": {
        "anyOf": [
         {
          "maxLength": 8000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "contentTruncated": {
        "type": "boolean"
       },
       "coverUrl": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "created": {
        "$ref": "#/properties/article/anyOf/0/properties/lastEditTime"
       },
       "description": {
        "anyOf": [
         {
          "maxLength": 1000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "format": {
        "anyOf": [
         {
          "maxLength": 20,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locale": {
        "anyOf": [
         {
          "maxLength": 50,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "published": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "slug": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "title": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "title",
       "locale",
       "slug",
       "published",
       "lastEditTime",
       "blogId",
       "description",
       "content",
       "contentTruncated",
       "format",
       "author",
       "created",
       "coverUrl"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "article"
  ],
  "type": "object"
 },
 "title": "Read a blog post"
}
