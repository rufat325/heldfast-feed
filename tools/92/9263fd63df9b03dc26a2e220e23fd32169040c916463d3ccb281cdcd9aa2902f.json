{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Datadog organization users with filtering and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "description": "Search filter string. Example: john",
    "type": "string"
   },
   "filterStatus": {
    "description": "Filter by user status. Example: Active, Pending, Disabled",
    "type": "string"
   },
   "pageNumber": {
    "default": 0,
    "description": "Page number (0-based)",
    "type": "number"
   },
   "pageSize": {
    "default": 50,
    "description": "Number of results per page (default 50)",
    "type": "number"
   },
   "sort": {
    "description": "Sort field. Example: name, email, created_at",
    "type": "string"
   },
   "sortDir": {
    "description": "Sort direction: asc or desc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-users"
}
