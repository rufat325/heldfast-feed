{
 "description": "Free read-only selector for supported x402 services. Makes no payment. Returns mapped stable-asset price and public usage evidence; it does not certify functional correctness.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "capability": {
    "enum": [
     "WEB_SEARCH",
     "URL_TO_TEXT",
     "GOOGLE_TRENDS_INTEREST",
     "WEATHER_CURRENT",
     "GEOCODE"
    ],
    "type": "string"
   },
   "max_price_usdc": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "mode": {
    "enum": [
     "CHEAPEST",
     "BALANCED",
     "PROVEN",
     "STRICT"
    ],
    "type": "string"
   }
  },
  "required": [
   "capability"
  ],
  "type": "object"
 },
 "name": "route_service"
}
