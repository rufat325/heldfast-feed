{
 "description": "Extract data from the page without a full snapshot. Types: text (visible text), html (markup), title, url, js (evaluate JavaScript). Use target with @eN or CSS selector for element-specific extraction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "js": {
    "description": "JavaScript expression for type='js'.",
    "type": "string"
   },
   "maxChars": {
    "default": 5000,
    "description": "Max output characters.",
    "type": "integer"
   },
   "sessionId": {
    "description": "Session ID.",
    "type": "string"
   },
   "target": {
    "description": "@eN ref or CSS selector. Omit for page-level.",
    "type": "string"
   },
   "type": {
    "default": "text",
    "description": "What to extract.",
    "enum": [
     "text",
     "html",
     "title",
     "url",
     "js"
    ],
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "extract",
 "title": "Extract Data"
}
