{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Route Payment"
 },
 "description": "Multi-stablecoin settlement routing. Given amount, source currency (from), and destination currency (to), returns all three stablecoin options (USDC, EURC, USDT) ranked by settlement efficiency. EURC is recommended for EUR destinations \u2014 eliminates cross-currency conversion. Returns settleBody ready to POST to /settle for the top-ranked option.",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "Settlement amount in source currency",
    "type": "number"
   },
   "from": {
    "description": "Source currency code (USD, EUR, GBP, BRL, etc.)",
    "type": "string"
   },
   "to": {
    "description": "Destination currency code (USD, EUR, GBP, etc.)",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "route",
 "outputSchema": {
  "properties": {
   "generatedAt": {
    "type": "string"
   },
   "options": {
    "items": {
     "properties": {
      "isCrossCurrency": {
       "type": "boolean"
      },
      "rank": {
       "type": "number"
      },
      "rationale": {
       "type": "string"
      },
      "settleBody": {
       "additionalProperties": true,
       "type": "object"
      },
      "token": {
       "type": "string"
      },
      "tokenAddress": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "routingAdvice": {
    "properties": {
     "oracleStabilityScore": {
      "description": "Current oracle stability score 0\u2013100",
      "type": "number"
     },
     "rationale": {
      "type": "string"
     },
     "recommendation": {
      "description": "Top-ranked stablecoin (USDC, EURC, or USDT)",
      "type": "string"
     }
    },
    "type": "object"
   },
   "settleEndpoint": {
    "type": "string"
   },
   "ttlSeconds": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
