 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Start a generation the customer approved"
 },
 "description": "Spends Brix36 credits and starts the quoted work under the customer's financial approval. In chat mode, stage:pictures records one approval for pictures and video using the original operationId, quoteToken, priceVersion, quotedCredits and revisionId. Insufficient balance returns balance, shortfall and creditsInformationUrl without a checkout. Stage:video uses the current picture revision and the same financial approval, subject to the existing readiness gates. Identical stage and argument retries reconcile the same operation. New authorizations retain pause/cap, OAuth studio.spend, account and exact-quote checks. The response waits up to 45 seconds for the started stage and includes current progress, a finished video link when available, or the free status-call arguments for work still rendering. Existing page-approved operations and confirmationToken codes remain supported.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmationToken": {
    "description": "Brix36-issued code for an existing app-approved operation. New chat approvals are bound by the chat-stage quote fields.",
    "maxLength": 80000,
    "minLength": 16,
    "type": "string"
   },
   "modelId": {
    "description": "Optional with an approved quote (the approved model is used). Otherwise the id of the model the customer chose, from that quote's models list.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "operationId": {
    "description": "The same id used for this operation at quote time.",
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "priceVersion": {
    "description": "Exact version of the combined quote the customer approved.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "projectId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "quoteToken": {
    "description": "The exact opaque quoteToken returned by studio_generation_quote.",
    "maxLength": 80000,
    "minLength": 16,
    "type": "string"
   },
   "quotedCredits": {
    "description": "Exact totalCredits approved by the customer; bound to the quoted price.",
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "revisionId": {
    "description": "For pictures, the quoted revisionId; for video, the current picture revision with applicable readiness checks satisfied.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "stage": {
    "description": "Chat mode: pictures records one financial approval and starts pictures; video starts video under that same approval and the current readiness gates. Each retry retains its original stage.",
    "enum": [
     "pictures",
     "video"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "operationId",
   "quoteToken"
  ],
  "type": "object"
 },
