{
 "description": "Generate an Open Graph / social card image. Returns an image using built-in templates or custom HTML.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accentColor": {
    "description": "Accent color as hex, e.g. \"#6366f1\"",
    "type": "string"
   },
   "bgColor": {
    "description": "Background color as hex, e.g. \"#0f172a\"",
    "type": "string"
   },
   "bgImage": {
    "description": "Background image URL",
    "type": "string"
   },
   "format": {
    "description": "Image format (default: png)",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "height": {
    "description": "Image height in pixels (default: 630)",
    "maximum": 1260,
    "minimum": 1,
    "type": "integer"
   },
   "html": {
    "description": "Custom HTML template (overrides template parameter, Growth plan+)",
    "type": "string"
   },
   "logo": {
    "description": "Logo image URL",
    "type": "string"
   },
   "subtitle": {
    "description": "Subtitle text",
    "type": "string"
   },
   "template": {
    "description": "Built-in template name (default: \"default\")",
    "enum": [
     "default",
     "minimal",
     "gradient"
    ],
    "type": "string"
   },
   "textColor": {
    "description": "Text color as hex, e.g. \"#f8fafc\"",
    "type": "string"
   },
   "title": {
    "description": "Main title text (default: \"Your Title Here\")",
    "type": "string"
   },
   "width": {
    "description": "Image width in pixels (default: 1200)",
    "maximum": 2400,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "create_og_image"
}
