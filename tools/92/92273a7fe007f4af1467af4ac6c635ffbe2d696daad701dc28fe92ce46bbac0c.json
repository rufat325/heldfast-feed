{
 "description": "Inspect a URL's Google index status, canonical selection, mobile usability, and rich results",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "inspectionUrl": {
    "description": "Fully qualified URL to inspect",
    "format": "uri",
    "type": "string"
   },
   "siteUrl": {
    "description": "Search Console property containing the inspected URL",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "inspectionUrl"
  ],
  "type": "object"
 },
 "name": "inspect_url",
