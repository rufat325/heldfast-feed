   "inspectionUrl": {
    "type": "string"
   },
   "mobileUsability": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "issues": {
        "items": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "type": "array"
       },
       "verdict": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "verdict",
       "issues"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "richResults": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "detectedItems": {
