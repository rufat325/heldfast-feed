   {
    "type": "noauth"
   },
   {
    "scopes": [
     "human:actions"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://darwin/presentation/readonly-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Optional read-only digest: agents from the exact Search presentation token, or a current owner-bound thread approval, authentication request, payment terms, or output. Never use for clarification, no-match, ordinary chat, progress or acknowledgements. No input form or execution. The assistant handles all decisions and subsequent tools. Never fabricate request IDs or terms.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "const": "agents",
      "type": "string"
     },
     "presentationToken": {
      "maxLength": 120000,
      "minLength": 40,
      "type": "string"
     }
    },
    "required": [
     "kind",
     "presentationToken"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "approval",
       "authentication",
       "payment"
      ],
      "type": "string"
     },
     "request": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "thread": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "kind",
     "thread",
     "request"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "cursor": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "kind": {
      "const": "output",
      "type": "string"
     },
     "message": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "thread": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "kind",
     "thread",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "show_darwin_view",
 "title": "Darwin"
}
