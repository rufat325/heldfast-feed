        "string",
        "null"
       ]
      },
      "license": {
       "description": "SPDX licence id, e.g. \"MIT\".",
       "type": [
        "string",
        "null"
       ]
      },
      "match_reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "notable_for": {
       "type": [
        "string",
        "null"
       ]
      },
      "open_source": {
       "description": "true: OSI-licensed; false: source-available or closed; null when unknown.",
       "type": [
        "boolean",
        "null"
       ]
      },
      "patterns": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pricing": {
