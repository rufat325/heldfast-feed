  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One UI pattern: its definition, its best examples, related patterns and the technologies the examples use. Use it before designing that pattern. Example: {\"slug\": \"empty-state\", \"limit\": 8}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 12,
    "description": "How many examples to return (1 to 60, default 12).",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "slug": {
    "description": "Pattern slug, e.g. \"command-menu\" or \"empty-state\".",
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_pattern",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "definition": {
    "type": [
     "string",
     "null"
    ]
   },
   "examples": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": [
        "string",
        "null"
       ]
