{
 "description": "List CRM users with optional filters for location, company, role, and sorting.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "companyId": {
    "description": "Filter by company ID",
    "type": "string"
   },
   "ids": {
    "description": "Comma-separated list of user IDs to retrieve",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of users to return",
    "type": "number"
   },
   "locationId": {
    "description": "Filter by location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "role": {
    "description": "Filter by user role (admin, user, etc.)",
    "type": "string"
   },
   "sort": {
    "description": "Field to sort results by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: 'asc' or 'desc'",
    "type": "string"
   }
  },
  "required": [
   "access_token"
  ],
  "type": "object"
 },
 "name": "crm_list_users"
}
