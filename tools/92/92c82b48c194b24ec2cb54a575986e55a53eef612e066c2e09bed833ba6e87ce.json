{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get post"
 },
 "description": "Get a single post by its slug. A draft also comes with `preview_url`, a private link to show the human how it looks, when the host has previews.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blog_id": {
    "description": "Your blog's id, as returned by signup. Optional with an API key: it defaults to the key's blog, and any id you pass must be that blog. Required when the server runs without API keys.",
    "type": "string"
   },
   "slug": {
    "description": "Slug of the post, e.g. \"hello-world\", as returned by create_post or list_posts.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_post",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "error": {
    "additionalProperties": {},
    "description": "Present only on failure (isError: true). Success fields are absent then.",
    "properties": {
     "code": {
      "description": "Error code, e.g. \"POST_NOT_FOUND\".",
      "type": "string"
     },
     "details": {
      "additionalProperties": {},
      "description": "Extra context. Keys depend on the code.",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "message": {
      "description": "What went wrong and what to do next.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "details"
    ],
    "type": "object"
   },
   "post": {
    "additionalProperties": {},
    "properties": {
     "author": {
      "type": "string"
     },
     "blogId": {
      "type": "string"
     },
     "body": {
      "description": "Markdown body.",
      "type": "string"
     },
     "coverImage": {
      "type": "string"
     },
     "createdAt": {
      "description": "ISO 8601.",
      "type": "string"
     },
     "excerpt": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "language": {
      "description": "The post's own BCP-47 language tag. Absent: it uses the blog's language.",
      "type": "string"
     },
     "publishedAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "ISO 8601 publish time. null for drafts."
     },
     "seoDescription": {
      "type": "string"
     },
     "seoTitle": {
      "type": "string"
     },
     "slug": {
      "description": "The post's page is {blog_url}{slug}/.",
      "type": "string"
     },
     "status": {
      "enum": [
       "draft",
       "published"
      ],
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "translationGroup": {
      "description": "Shared by every translation of the same post.",
      "type": "string"
     },
     "updatedAt": {
      "description": "ISO 8601.",
      "type": "string"
     }
    },
    "required": [
     "id",
     "blogId",
     "slug",
     "title",
     "body",
     "tags",
     "status",
     "publishedAt",
     "createdAt",
     "updatedAt"
    ],
    "type": "object"
   },
   "preview_url": {
    "description": "Private link to a rendered draft for the human to review: not indexed, not listed anywhere. Present only for drafts, on hosts with previews.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get post"
}
