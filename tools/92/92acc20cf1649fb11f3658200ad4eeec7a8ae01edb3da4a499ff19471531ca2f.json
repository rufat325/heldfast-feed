 "description": "Encontra profissionais reais perto de um lugar para uma necessidade. Ex.: need=\"instalar 3 ventiladores\", where=\"Tijuca, Rio de Janeiro\", min_rating=4.5, max_price_brl=350. Retorna perfis estruturados (nota, avalia\u00e7\u00f5es, dist\u00e2ncia, pre\u00e7o quando informado) e uma tela com cards.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "emergency_24h": {
    "description": "S\u00f3 quem atende 24 horas / emerg\u00eancia",
    "type": "boolean"
   },
   "lat": {
    "description": "Latitude (busca geolocalizada: use com lng quando o usu\u00e1rio compartilhar a localiza\u00e7\u00e3o)",
    "type": "number"
   },
   "limit": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "lng": {
    "type": "number"
   },
   "max_price_brl": {
    "description": "Mant\u00e9m quem n\u00e3o informou pre\u00e7o (cobra por or\u00e7amento)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "min_rating": {
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "min_reviews": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "need": {
    "description": "O que o usu\u00e1rio precisa, com as palavras dele",
    "minLength": 2,
    "type": "string"
   },
   "niche": {
    "description": "Slug exato do tipo de profissional (de list_categories), ex.: \"motorista\", \"pedreiro\". Quando informado, vence a interpreta\u00e7\u00e3o do texto.",
    "type": "string"
   },
   "radius_km": {
    "description": "Raio da busca em km a partir de lat/lng ou do lugar (padr\u00e3o: 5 a 15 km conforme o lugar)",
    "maximum": 80,
    "minimum": 1,
    "type": "number"
   },
   "service": {
    "description": "Subcategoria exata, a service_key de search_services (ex.: \"piscina/limpeza\"). Prioriza quem faz exatamente isso, sem esconder o resto do tipo.",
    "type": "string"
   },
   "sort": {
    "enum": [
     "relevance",
     "distance",
     "rating"
    ],
    "type": "string"
   },
   "where": {
    "description": "Bairro e/ou cidade, ex.: \"Tijuca, Rio de Janeiro\" ou \"Pinheiros SP\"",
    "type": "string"
   }
  },
  "required": [
   "need"
  ],
  "type": "object"
 },
