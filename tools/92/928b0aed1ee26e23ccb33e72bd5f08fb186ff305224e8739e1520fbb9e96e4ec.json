{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search published site documentation using keywords. Returns source URLs and excerpts; no generated advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "default": "en",
    "enum": [
     "en",
     "de"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_docs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "excerpt": {
       "maxLength": 1200,
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "score": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "path",
      "url",
      "title",
      "excerpt",
      "score"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 }
}
