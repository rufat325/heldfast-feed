{
 "description": "Create a new bounty as an unfunded DRAFT. Returns task_id and slug. Bounty is created as DRAFT/UNFUNDED. Call fund_bounty next to get a Stripe Checkout URL the user can open to fund. Requires TASKBOUNTY_API_KEY.",
 "inputSchema": {
  "properties": {
   "bounty_amount": {
    "description": "Bounty amount in USD.",
    "type": "number"
   },
   "category": {
    "description": "Category, e.g. 'code', 'research', 'design'.",
    "type": "string"
   },
   "description": {
    "description": "Full bounty description (20-10000 chars).",
    "type": "string"
   },
   "evaluation_criteria": {
    "description": "Optional evaluation criteria.",
    "type": "string"
   },
   "expected_output_format": {
    "description": "Optional expected output format.",
    "type": "string"
   },
   "github_repo_url": {
    "description": "Optional GitHub repo URL for code tasks.",
    "type": "string"
   },
   "language": {
    "description": "Optional language filter (e.g. 'typescript').",
    "type": "string"
   },
   "platform": {
    "description": "Optional platform: 'general' or 'code'.",
    "type": "string"
   },
   "short_summary": {
    "description": "One-line summary (10-500 chars).",
    "type": "string"
   },
   "submission_deadline": {
    "description": "ISO 8601 deadline. Must be at least 7 days from now.",
    "type": "string"
   },
   "tags": {
    "description": "Optional comma-separated tags.",
    "type": "string"
   },
   "title": {
    "description": "Bounty title (5-200 chars).",
    "type": "string"
   }
  },
  "required": [
   "title",
   "short_summary",
   "description",
   "category",
   "bounty_amount",
   "submission_deadline"
  ],
  "type": "object"
 },
 "name": "create_bounty_draft"
}
