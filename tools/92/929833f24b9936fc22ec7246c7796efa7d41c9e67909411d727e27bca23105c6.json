    "type": "integer"
   },
   "wallet": {
    "description": "EVM wallet address (0x...).",
    "type": "string"
   }
  },
  "required": [
   "wallet"
  ],
  "type": "object"
 },
 "name": "verify_audit_trail",
 "outputSchema": {
  "description": "Audit-chain verification result.",
