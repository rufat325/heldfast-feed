{
 "description": "Generate random loot/treasure for a system and tier",
 "inputSchema": {
  "properties": {
   "count": {
    "description": "Number of items (default 3)",
    "type": "number"
   },
   "system": {
    "description": "System slug (default: dnd-5e)",
    "type": "string"
   },
   "tier": {
    "description": "Loot tier (default: minor)",
    "enum": [
     "minor",
     "major",
     "legendary"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "rpg_loot"
}
