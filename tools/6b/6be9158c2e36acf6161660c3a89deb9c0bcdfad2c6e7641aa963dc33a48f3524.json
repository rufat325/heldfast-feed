{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Open orders on Ripio Trade, optionally for one pair or side, with price and requested, executed and remaining amounts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "next_cursor from a previous call.",
    "type": "string"
   },
   "pair": {
    "description": "Ripio Trade pair, e.g. USDT_ARS.",
    "pattern": "^[A-Za-z0-9]{2,12}_[A-Za-z0-9]{2,12}$",
    "type": "string"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ripio_list_open_orders",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "next_cursor": {
    "type": "string"
   },
   "orders": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "executed_amount": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "pair": {
       "type": "string"
      },
      "price": {
       "type": "string"
      },
      "remaining_amount": {
       "type": "string"
      },
      "requested_amount": {
       "type": "string"
      },
      "side": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "pair",
      "side",
      "type",
      "status",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "orders"
  ],
  "type": "object"
 },
 "title": "Ripio Trade open orders"
}
