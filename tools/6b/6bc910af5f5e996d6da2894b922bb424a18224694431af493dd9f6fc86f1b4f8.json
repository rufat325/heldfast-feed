{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Render invoice PDF"
 },
 "description": "Generate a downloadable PDF artifact without a browser, account or storage. Requires sender/customer names, invoice number, dates and complete line items. Western European text only; unsupported characters or logos return an explicit error, use the web builder for those. Does not send invoices or process payments.",
 "inputSchema": {
  "description": "Direct PDF input. Western European (Windows-1252) text only, no logos, no payment ledger. Unknown text is rejected, never silently replaced.",
  "properties": {
   "billTo": {
    "description": "The customer. name is required; email is prefilled at checkout.",
    "properties": {
     "address": {
      "description": "Multi-line postal address",
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "currency": {
    "default": "usd",
    "enum": [
     "usd",
     "cad",
     "eur",
     "gbp",
     "aud",
     "nzd"
    ],
    "type": "string"
   },
   "discount": {
    "description": "Minor units, taken off the subtotal",
    "minimum": 0,
    "type": "integer"
   },
   "dueDate": {
    "description": "YYYY-MM-DD. The invoice reads overdue the day after.",
    "format": "date",
    "type": "string"
   },
   "from": {
    "description": "The business sending the invoice.",
    "properties": {
     "address": {
      "description": "Multi-line postal address",
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "issueDate": {
    "description": "YYYY-MM-DD",
    "format": "date",
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "quantity": {
       "description": "May be fractional, e.g. 1.5 hours",
       "minimum": 0,
       "type": "number"
      },
      "unitPrice": {
       "description": "Minor units (cents)",
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "description",
      "quantity",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "notes": {
    "maxLength": 2000,
    "type": "string"
   },
   "number": {
    "description": "Your invoice number, e.g. INV-1042",
    "maxLength": 40,
    "type": "string"
   },
   "shipTo": {
    "description": "Optional shipping address",
    "properties": {
     "address": {
      "description": "Multi-line postal address",
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "format": "email",
      "type": "string"
     },
     "name": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "shipping": {
    "description": "Minor units, added after tax",
    "minimum": 0,
    "type": "integer"
   },
   "taxRate": {
    "description": "Percent. Applied after discount, not to shipping.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "terms": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "from",
   "billTo",
   "number",
   "issueDate",
   "dueDate",
   "items"
  ],
  "type": "object"
 },
 "name": "render_invoice_pdf",
 "title": "Generate an invoice PDF"
}
