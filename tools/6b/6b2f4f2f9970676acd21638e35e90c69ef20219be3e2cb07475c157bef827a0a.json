{
 "description": "Update an existing webhook subscription. Use active: false to pause delivery, active: true to resume. Can also update the endpoint URL, HTTP method, or filters without deleting and recreating the webhook.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "description": "false = pause delivery, true = resume.",
    "type": "boolean"
   },
   "filters": {
    "properties": {
     "constructors": {
      "description": "Team keywords, e.g. [\"ferrari\",\"mclaren\"]",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "drivers": {
      "description": "TLA codes, e.g. [\"VER\",\"NOR\"]",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "positions": {
      "properties": {
       "max": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       },
       "min": {
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "webhookId": {
    "minLength": 1,
    "type": "string"
   },
   "webhookMethod": {
    "enum": [
     "post",
     "put"
    ],
    "type": "string"
   },
   "webhookUrl": {
    "description": "New endpoint URL.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "webhookId"
  ],
  "type": "object"
 },
 "name": "update_webhook"
}
