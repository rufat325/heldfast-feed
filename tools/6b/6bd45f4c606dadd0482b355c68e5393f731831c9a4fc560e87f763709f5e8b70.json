{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Quick Reference"
 },
 "description": "Returns a compact checklist for one frontend category, filtered by priority and formatted as JSON, Markdown, or a task list. Use it when the user requests a concise checklist for a deployment, review, or team handoff.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://frontendchecklist.io/favicon.svg"
  }
 ],
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category name, e.g. 'accessibility', 'performance', or 'seo' (see list_categories).",
    "type": "string"
   },
   "format": {
    "description": "Output format (default: 'json'). Use 'markdown' for readable docs, 'checklist' for copy-paste task lists.",
    "enum": [
     "json",
     "markdown",
     "checklist"
    ],
    "type": "string"
   },
   "priorityFilter": {
    "description": "Filter by priority level (default: 'critical+high'). Use 'all' for comprehensive lists, 'critical' for essentials only.",
    "enum": [
     "all",
     "critical",
     "critical+high",
     "critical+high+medium"
    ],
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "get_quick_reference",
 "outputSchema": {
  "properties": {
   "category": {
    "type": "string"
   },
   "displayName": {
    "type": "string"
   },
   "error": {
    "properties": {
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "items": {
    "items": {
     "properties": {
      "checkPrompt": {
       "type": "string"
      },
      "priority": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "markdown": {
    "type": "string"
   },
   "priorityFilter": {
    "type": "string"
   },
   "totalCount": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Get Quick Reference"
}
