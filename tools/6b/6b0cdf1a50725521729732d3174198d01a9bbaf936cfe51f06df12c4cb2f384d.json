{
 "_meta": {
  "openai/toolInvocation/invoked": "Add track complete.",
  "openai/toolInvocation/invoking": "Add track\u2026",
  "ui": {
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add an instrument or audio track linked to a built-in, sampler, WAM, or VST3 instrument slot.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   },
   "instrumentKind": {
    "default": "synth",
    "enum": [
     "synth",
     "drum",
     "sampler",
     "wam",
     "vst3"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "maximum": 127,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "default": "instrument",
    "enum": [
     "instrument",
     "audio"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "add_track",
 "title": "Add track"
}
