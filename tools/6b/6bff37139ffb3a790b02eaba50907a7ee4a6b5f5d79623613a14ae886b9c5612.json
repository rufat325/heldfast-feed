{
 "description": "Retrieve a specific draft by key. Returns JSON with draft_key, sequence, and parsed data (title, reply, categoryId, tags, action).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "draft_key": {
    "description": "Draft key (e.g., \"new_topic\", \"topic_123\", \"new_private_message\")",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "sequence": {
    "description": "Expected sequence number (optional)",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "draft_key"
  ],
  "type": "object"
 },
 "name": "discourse_get_draft",
 "title": "Get Draft"
}
