{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect the provenance behind startup credits and deals. Resolve one to ten exact revisions to supporting events and observations, including freshness and dispute status.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "revision_digests": {
    "description": "Exact offer revision digests returned by Sourcey search or comparison.",
    "items": {
     "pattern": "^sha256:[a-f0-9]{64}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "revision_digests"
  ],
  "type": "object"
 },
 "name": "inspect_evidence",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "coverage_policy_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "event_ids": {
       "items": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "type": "array"
      },
      "first_inclusion_sequence": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "freshness_policy_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "observation_ids": {
       "items": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "type": "array"
      },
      "revision_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "revision_digest",
      "first_inclusion_sequence",
      "event_ids",
      "observation_ids",
      "coverage_policy_digest",
      "freshness_policy_digest"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "release_id": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "release_id",
   "data"
  ],
  "type": "object"
 },
 "title": "Inspect evidence"
}
