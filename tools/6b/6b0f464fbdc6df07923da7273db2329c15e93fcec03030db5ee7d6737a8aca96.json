{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Draft/publish ONE feedback comment on the EXACT reviewed attempt (action coaching_comment). While a DRAFT selection cycle exists the comment joins that private batch (publishedImmediately:false) \u2014 the worker sees NOTHING until send-back. Stale pages fail closed via attemptId. Requires project_todos:write and a caller-supplied stable idempotencyKey (registry op project_todos.quizzes.coaching.manage). The response echoes its action discriminator and receipt fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "attemptId": {
    "minLength": 1,
    "type": "string"
   },
   "bodyDoc": {
    "additionalProperties": {},
    "type": "object"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "questionId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "questionId",
   "attemptId",
   "bodyDoc",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_comment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "coaching_comment",
      "type": "string"
     },
     "commentId": {
      "type": "string"
     },
     "publishedImmediately": {
      "type": "boolean"
     },
     "replayed": {
      "type": "boolean"
     },
     "reviewCycle": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "cycleNumber": {
          "type": "integer"
         },
         "id": {
          "type": "string"
         },
         "requestedQuestionIds": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "status": {
          "enum": [
           "DRAFT",
           "OPEN",
           "RESUBMITTED",
           "CLOSED"
          ],
          "type": "string"
         }
        },
        "required": [
         "id",
         "status",
         "cycleNumber",
         "requestedQuestionIds"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "threadId": {
      "type": "string"
     }
    },
    "required": [
     "action",
     "commentId",
     "threadId",
     "publishedImmediately",
     "replayed",
     "reviewCycle"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
