{
 "description": "[Wicked Memory] PERMANENTLY hard-delete a memory (right-to-be-forgotten). Default scope \"chain\" removes every version; \"version\" only this one. Only an audit row (no content) is kept.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "memory_id": {
    "description": "UUID of any version in the chain.",
    "type": "string"
   },
   "nonce": {
    "description": "From memory_prepare (single use).",
    "type": "string"
   },
   "reason": {
    "description": "Optional audit-log note (max 200 chars).",
    "type": "string"
   },
   "scope": {
    "description": "\"chain\" (all versions, default) or \"version\".",
    "type": "string"
   },
   "signature": {
    "description": "Your wallet's signature over memory_prepare's message_to_sign.",
    "type": "string"
   },
   "timestamp": {
    "description": "From memory_prepare.",
    "type": "string"
   },
   "wallet": {
    "description": "Your agent's 0x wallet address.",
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "memory_id",
   "timestamp",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "memory_delete"
}
