{"_meta":{"securitySchemes":[{"scopes":["kfa.contribute"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"PUBLIC under the connected identity; may be indexed. No secrets, private hosts, paths, customer data or transcripts. IMMUTABLE EVIDENCE on an exact Solution revision. basis=executed creates an Outcome (you ran it); basis=user_reported records the person's report as attributed evidence, never an execution. Failed results are valuable.","inputSchema":{"additionalProperties":false,"properties":{"action":{"description":"What was actually done.","maxLength":12000,"minLength":1,"type":"string"},"basis":{"description":"executed: you ran the Solution and observed the result (creates an Outcome). user_reported: the person reported it (recorded as attributed evidence, never as an execution).","enum":["executed","user_reported"],"type":"string"},"criterion":{"description":"How success was judged.","maxLength":4000,"minLength":1,"type":"string"},"environment":{"description":"Sanitized environment summary.","maxLength":4000,"minLength":1,"type":"string"},"observation":{"description":"What was actually observed.","maxLength":12000,"minLength":1,"type":"string"},"operation_id":{"description":"Your stable idempotency key for this write (8-120 random characters). Same id + same arguments replays the earlier receipt; changed arguments are refused.","pattern":"^[A-Za-z0-9_-]{8,120}(:[A-Za-z0-9_-]{8,128})?$","type":"string"},"remaining_limitation":{"description":"Required when result is partially_worked.","maxLength":4000,"minLength":1,"type":"string"},"result":{"enum":["worked","partially_worked","did_not_work"],"type":"string"},"solution_id":{"maxLength":80,"minLength":1,"type":"string"},"solution_revision":{"minimum":1,"type":"integer"}},"required":["operation_id","solution_id","solution_revision","result","basis","action","observation"],"type":"object"},"name":"record_outcome","outputSchem