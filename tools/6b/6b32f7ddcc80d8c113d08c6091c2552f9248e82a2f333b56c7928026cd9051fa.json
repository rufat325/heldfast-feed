{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create contract document"
 },
 "description": "Create a contract document record. Requires contract_documents:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contract_id": {
    "description": "Contract ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "file_name": {
    "description": "File name (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "file_path": {
    "description": "Storage path from upload URL response (required)",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "uploaded_by": {
    "description": "Uploader user ID",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "contract_id",
   "file_name",
   "file_path"
  ],
  "type": "object"
 },
 "name": "create_contract_document",
 "title": "Create contract document"
}
