{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List tickets with calculated value, cost, and priority. Supports tag filters (intersection), exclude-tags, title search, score thresholds, sort, and limit/offset pagination. Returns {total, offset, items[]}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "excludeTags": {
    "description": "Exclude tickets with these tags. Each as prefix:value",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max number of results to return (default 100; total gives the full count)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "maxCost": {
    "description": "Maximum cost (estimate+risk) threshold",
    "type": "number"
   },
   "minPriority": {
    "description": "Minimum priority, compared with the exact value/cost (21/13 = 1.615 is below 1.62, though returned as 1.62)",
    "type": "number"
   },
   "minValue": {
    "description": "Minimum value (benefit+penalty) threshold",
    "type": "number"
   },
   "offset": {
    "description": "Skip first N results (for pagination)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "search": {
    "description": "Filter by title substring (case-insensitive)",
    "type": "string"
   },
   "sort": {
    "description": "Sort descending by: priority, benefit, penalty, estimate, risk, value, cost",
    "type": "string"
   },
   "tag": {
    "description": "Filter by tag (prefix:value) \u2014 single tag, kept for backward compat",
    "type": "string"
   },
   "tags": {
    "description": "Filter by multiple tags (intersection). Each as prefix:value",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "ticket_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefit": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "cost": {
       "description": "estimate + risk",
       "type": "number"
      },
      "created_at": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "estimate": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "penalty": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "priority": {
       "description": "value / cost, rounded to 2 decimals",
       "type": "number"
      },
      "project_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "risk": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticket_uuid": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updated_at": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "value": {
       "description": "benefit + penalty",
       "type": "number"
      }
     },
     "required": [
      "id",
      "ticket_uuid",
      "project_id",
      "title",
      "description",
      "benefit",
      "penalty",
      "estimate",
      "risk",
      "created_at",
      "updated_at",
      "value",
      "cost",
      "priority"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "total": {
    "description": "Matching tickets, before limit and offset",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "offset",
   "items"
  ],
  "type": "object"
 }
}
