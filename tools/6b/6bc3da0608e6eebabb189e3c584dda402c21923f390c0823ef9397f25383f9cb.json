{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare one Carve document across HTML, Markdown, plain text, ANSI, GitHub, WordPress, and PDF-stage profiles, returning target-specific warnings, losses, and fallbacks.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "source": {
    "description": "Document source (maximum 1000000 UTF-8 bytes)",
    "type": "string"
   },
   "targets": {
    "default": [
     "html",
     "markdown",
     "github",
     "wordpress",
     "pdf"
    ],
    "items": {
     "enum": [
      "html",
      "markdown",
      "plain",
      "ansi",
      "github",
      "wordpress",
      "pdf"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "name": "carve_check_targets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "compatible": {
    "type": "boolean"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "compatible": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "lossy": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "warning": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "compatible",
     "warning",
     "lossy"
    ],
    "type": "object"
   },
   "targetCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "targets": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "compatible",
   "targetCount",
   "summary",
   "targets"
  ],
  "type": "object"
 },
 "title": "Check Carve publishing targets"
}
