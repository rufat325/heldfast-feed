{
 "description": "Compute the coin name (sha256 of parent_coin_info || puzzle_hash || amount). Local computation only \u2014 no RPC.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "integer"
     }
    ],
    "description": "Coin amount in mojos. Strings are accepted for values that exceed JS number precision."
   },
   "parent_coin_info": {
    "description": "32-byte parent coin id (hex)",
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "puzzle_hash": {
    "description": "32-byte puzzle hash (hex)",
    "pattern": "^(0x)?[0-9a-fA-F]{64}$",
    "type": "string"
   }
  },
  "required": [
   "parent_coin_info",
   "puzzle_hash",
   "amount"
  ],
  "type": "object"
 },
 "name": "calculate_coin_name"
}
