558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"business_management_no":{"description":"\uace0\uc6a9\ubcf4\ud5d8 \uc0ac\uc5c5\uc7a5\uad00\ub9ac\ubc88\ud638 11\uc790\ub9ac. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \ub85c\uadf8\uc778\ud560 \ub54c \uc800\uc7a5\ud55c \ubc88\ud638\ub97c \uc501\ub2c8\ub2e4.","type":"string"},"programme_key":{"description":"\uce74\ud0c8\ub85c\uadf8 \uc0ac\uc5c5 \ud0a4 (\uc608: w24_b0010 \uace0\uc6a9\ucd09\uc9c4\uc7a5\ub824\uae08). subsidy_pack \uc9c4\ub2e8 \uacb0\uacfc\uc758 programme_key \ub97c \uadf8\ub300\ub85c \ub123\ub294\ub2e4.","type":"string"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"}},"required":["programme_key"],"type":"object"},"name":"work24__subsidy__application__requirements","securitySchemes":[{"scopes":["mcp:t