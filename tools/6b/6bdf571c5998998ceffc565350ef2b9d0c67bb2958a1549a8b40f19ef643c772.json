tion":"More words; never billed or coded from.","maxLength":1000,"type":"string"},"quantity":{"$ref":"#/$defs/Quantity","description":"Measured amount (120 sq_ft), only as the words give it.","type":"object"},"repeat_of":{"description":"Id of an earlier finding this repeats in its own rooms (\"same as above\"); it bills.","maxLength":40,"pattern":"^[A-Za-z0-9_.:-]+$","type":"string"},"rooms":{"$ref":"#/$defs/Rooms","description":"Which rooms: {\"area\": \"bedroom\", \"count\": 3} is all 3 bedrooms; labels name them.","type":"object"},"signature_like":{"default":false,"description":"Set by our reader; send it back unchanged.","type":"boolean"},"source_text":{"description":"The original words. Scanned for hazards; never billed or coded from.","maxLength":1000,"type":"string"},"status":{"$ref":"#/$defs/FindingStatus","default":"needed","description":"Only needed (the default) bills; on a hazard, done/ok/none without evidence stays Possible.","type":"string"},"year_statement":{"$ref":"#/$defs/YearStatement","description":"A year said in passing (\"built 1972\"); never sets property.year_built.","type":"object"}},"type":"object"},"FindingStatus":{"enum":["needed","done","ok","none"],"type":"string"},"FloorCoverings":{"additionalProperties":false,"description":"What is on the floors. Drives the carpet-cleaning baseline and whole-unit carpet sizes.","properties":{"carpet_present":{"description":"Is there wall-to-wall carpet? Omit if unknown.","type":"boolean"},"carpet_sq_ft":{"description":"Carpeted area; omit to assume 60% of the floor area.","maximum":20000,"minimum":0,"type":"integer"}},"type":"object"},"Location":{"additionalProperties":false,"description":"Where; a plain string works too.","properties":{"area":{"$ref":"#/$defs/Area","default":"whole_unit","type":"string"},"label":{"description":"e.g. 'Bedroom 2'.","maxLength":60,"type":"string"}},"type":"object"},"Occupants":{"additionalProperties":false,"description":"property.occupants: lead-rule facts about the unit; leave out what is unknown.","properties":{"child_under_6":{"description":"A child under 6 lives there or is expected to.","type":"boolean"},"elderly":{"description":"Housing for the elderly (62+) or disabled; not just an older tenant.","type":"boolean"},"hud_assisted":{"type":"boolean"}},"type":"object"},"PriceTier":{"description":"Purchasing channel. Library prices are pm_vendor (a PM buying turns from a local vendor).","enum":["bulk_contract","pm_vendor","retail_one_off"],"type":"string"},"Profile":{"enum":["minimum","standard","premium"],"type":"string"},"PropertyProfile":{"additionalProperties":false,"properties":{"bathrooms":{"anyOf":[{"maximum":12.0,"minimum":0.0,"multipleOf":0.5,"type":"number"},{"pattern":"^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$","type":"string"}],"description":"Half baths count as 0.5."},"bedrooms":{"description":"0 for a studio.","maximum":12,"minimum":0,"type":"integer"},"floor_coverings":{"$ref":"#/$defs/FloorCoverings","type":"object"},"occupants":{"$ref":"#/$defs/Occupants","type":"object"},"pets":{"description":"Did pets live in the unit? true adds an optional flea treatment. Omit if unknown.","type":"boolean"},"sq_ft":{"description":"Interior sq ft.","maximum":20000,"minimum":150,"type":"integer"},"unit_type":{"$ref":"#/$defs/UnitType","default":"apartment","description":"Single-family homes and townhomes get house-sized defaults (floor area, locks).","type":"string"},"walk_date":{"description":"The walk-through date; dated or aged items are judged against it. Omit if unknown.","format":"date","type":"string"},"year_built":{"description":"Drives lead-paint (pre-1978) handling.","maximum":2100,"minimum":1700,"type":"integer"},"zip":{"description":"5-digit US ZIP code (no street address).","pattern":"^\\d{5}$","type":"string"}},"required":["zip","bedrooms","bathrooms"],"type":"object"},"Quantity":{"additionalProperties":false,"properties":{"uom":{"$ref":"#/$defs/Uom","type":"string"},"value":{"anyOf":[{"exclusiveMinimum":0.0,"maximum":100