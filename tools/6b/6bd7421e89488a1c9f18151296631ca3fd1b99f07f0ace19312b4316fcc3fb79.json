    "minimum": 12,
    "type": "integer"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "quality": {
    "enum": [
     "draft",
     "standard",
     "high"
    ],
    "type": "string"
   },
   "slideIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "picorn_video_render_project",
