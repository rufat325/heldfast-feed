{
 "description": "List Gmail labels for label: query syntax. Case-sensitive.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "labels-list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "description": "Gmail label ID",
           "type": "string"
          },
          "name": {
           "description": "Label name for use in queries (case-sensitive)",
           "type": "string"
          },
          "type": {
           "description": "Whether this is a user-created or system label",
           "enum": [
            "user",
            "system"
           ],
           "type": "string"
          },
          "visibility": {
           "description": "Label visibility in Gmail UI",
           "enum": [
            "labelShow",
            "labelHide",
            "labelShowIfUnread"
           ],
           "type": "string"
          }
         },
         "required": [
          "id",
          "name",
          "type",
          "visibility"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "items"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
