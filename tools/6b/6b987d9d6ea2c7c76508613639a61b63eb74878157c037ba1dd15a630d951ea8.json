{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "securitySchemes": [
   {
    "scopes": [
     "read:posts"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "See one Autopilot run\u2019s results"
 },
 "description": "Read one Autopilot run from the verified customer timeline by its original planRunId (from soclo_autopilot_runs): made, scheduled and published posts with results. Free; never starts work. Needs read:posts.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "planRunId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "planRunId"
  ],
  "type": "object"
 },
 "name": "soclo_autopilot_run",
 "title": "See one Autopilot run\u2019s results"
}
