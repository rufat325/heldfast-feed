{
 "description": "Returns all scheduled maintenance windows defined in Uptime Kuma.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "getMaintenanceWindows",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "maintenanceWindows": {
    "description": "Array of maintenance windows",
    "items": {
     "additionalProperties": true,
     "properties": {
      "active": {
       "description": "Whether the maintenance window is active",
       "type": "boolean"
      },
      "dateRange": {
       "description": "Date range [startDate, endDate] in ISO format, null for recurring windows",
       "items": {
        "type": [
         "string",
         "null"
        ]
       },
       "type": "array"
      },
      "daysOfMonth": {
       "description": "Days of month (1-31)",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "description": {
       "description": "Description of the maintenance",
       "type": "string"
      },
      "id": {
       "description": "Maintenance ID (assigned by server)",
       "type": "number"
      },
      "intervalDay": {
       "description": "Interval in days for recurring-interval strategy",
       "type": [
        "number",
        "null"
       ]
      },
      "strategy": {
       "description": "Scheduling strategy",
       "enum": [
        "single",
        "recurring-interval",
        "recurring-weekday",
        "recurring-day-of-month",
        "manual"
       ],
       "type": "string"
      },
      "timeRange": {
       "description": "Time range within the day",
       "items": {
        "additionalProperties": true,
        "properties": {
         "hours": {
          "type": "number"
         },
         "minutes": {
          "type": "number"
         }
        },
        "required": [
         "hours",
         "minutes"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "timezone": {
       "description": "Timezone for the maintenance window",
       "type": "string"
      },
      "title": {
       "description": "Title of the maintenance window",
       "type": "string"
      },
      "weekdays": {
       "description": "Days of week (0=Sunday, 6=Saturday)",
       "items": {
        "type": "number"
       },
       "type": "array"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "maintenanceWindows",
   "count"
  ],
  "type": "object"
 },
 "title": "Get Maintenance Windows"
}
