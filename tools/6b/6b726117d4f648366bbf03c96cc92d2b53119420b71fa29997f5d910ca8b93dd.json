{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Rename a tag's value. All ticket assignments carry over. New value must not conflict with an existing tag under the same prefix.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "newValue": {
    "description": "New tag value",
    "type": "string"
   },
   "oldValue": {
    "description": "Current tag value",
    "type": "string"
   },
   "prefix": {
    "description": "Tag prefix",
    "type": "string"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "required": [
   "prefix",
   "oldValue",
   "newValue"
  ],
  "type": "object"
 },
 "name": "tag_rename",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "created_at": {
    "description": "ISO timestamp",
    "type": "string"
   },
   "id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "prefix": {
    "type": "string"
   },
   "project_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "updated_at": {
    "description": "ISO timestamp",
    "type": "string"
   },
   "value": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "project_id",
   "prefix",
   "value",
   "created_at",
   "updated_at"
  ],
  "type": "object"
 }
}
