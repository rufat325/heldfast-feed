{
 "description": "Add a condition to a character (narrative/exploration). For combat, use `add_combat_condition` instead so combat effects (advantage/disadvantage, modifiers) are picked up.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "characterId": {
    "description": "Character receiving the condition",
    "type": "string"
   },
   "condition": {
    "additionalProperties": false,
    "description": "Condition to apply. duration is rounds (number), 'permanent', or 'until_rest'.",
    "properties": {
     "description": {
      "type": "string"
     },
     "duration": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "const": "permanent",
        "type": "string"
       },
       {
        "const": "until_rest",
        "type": "string"
       }
      ]
     },
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "stackable": {
      "default": false,
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "name",
     "description",
     "duration"
    ],
    "type": "object"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "characterId",
   "condition"
  ],
  "type": "object"
 },
 "name": "apply_condition"
}
