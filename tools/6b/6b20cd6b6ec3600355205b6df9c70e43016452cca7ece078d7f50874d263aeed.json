{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true},"description":"Find Sentry cron monitors, which track scheduled jobs through check-ins. Returns each monitor's status, schedule, owner, project, and recent environment state.\nUptime URL checks: find_uptime_monitors. Metric thresholds: find_metric_monitors.\nWhen more results exist, narrow by project, environment, owner, or name.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"environment":{"anyOf":[{"description":"Environment to report monitor state for.","type":"string"},{"type":"null"}],"default":null},"fresh":{"description":"Bypass cached reads.","type":"boolean"},"limit":{"default":10,"description":"Maximum monitors to return.","exclusiveMinimum":0,"maximum":99,"type":"integer"},"organizationSlug":{"description":"The organization slug, from `find_organizations`. In `org/project` notation, the part before the slash.","type":"string"},"owner":{"anyOf":[{"description":"Owner filter: `user:123`, `team:456`, `myteams`, or `unassigned`.","type":"string"},{"type":"null"}],"default":null},"projectSlug":{"anyOf":[{"description":"The project slug, or lowercase `all` for every project.","type":"string"},{"type":"null"}],"default":null},"query":{"anyOf":[{"description":"Text to match in the monitor name or slug.","type":"string"},{"type":"null"}],"default":null},"regionUrl":{"anyOf":[{"description":"The organization's region URL from `find_organizations`, e.g. `https://us.sentry.io`. Omit for self-hosted Sentry.","type":"string"},{"type":"null"}],"default":null}},"type":"object"},"name":"find_monitors","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"hasMore":{"type":"boolean"},"monitors":{"items":{"additionalProperties":false,"properties":{"environments":{"items":{"additionalProperties":false,"properties":{"lastCheckIn":{"anyOf":[{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048