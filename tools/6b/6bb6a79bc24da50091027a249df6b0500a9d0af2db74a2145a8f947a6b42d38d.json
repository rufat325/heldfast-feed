{
 "description": "Recompress an image at target quality.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Output format",
    "enum": [
     "jpeg",
     "png",
     "webp",
     "avif"
    ],
    "type": "string"
   },
   "image_base64": {
    "description": "Base64-encoded image file",
    "type": "string"
   },
   "quality": {
    "description": "Target quality (1-100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "image_base64",
   "quality"
  ],
  "type": "object"
 },
 "name": "bytario_image_compress"
}
