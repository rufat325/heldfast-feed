{
 "description": "Apply a batch of graph edits (add/update/remove nodes, connect/disconnect edges) atomically to the stored flowSpec. Preferred over individual calls for multi-step edits; validate afterwards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ops": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "aspectRatio": {
       "type": "string"
      },
      "assetRef": {
       "type": "string"
      },
      "compositionRules": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "copySafety": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "edgeId": {
       "type": "string"
      },
      "globalRules": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "mimeType": {
       "type": "string"
      },
      "modelId": {
       "type": "string"
      },
      "negativeConstraints": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "nodeId": {
       "type": "string"
      },
      "op": {
       "description": "Edit kind; remaining fields are the same names as the single-edit tools.",
       "enum": [
        "add_node",
        "update_node",
        "remove_node",
        "connect",
        "disconnect",
        "set_generate_target"
       ],
       "type": "string"
      },
      "palette": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "position": {
       "additionalProperties": false,
       "properties": {
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        }
       },
       "required": [
        "x",
        "y"
       ],
       "type": "object"
      },
      "provider": {
       "type": "string"
      },
      "sizeHint": {
       "type": "string"
      },
      "sourceNodeId": {
       "type": "string"
      },
      "sourcePort": {
       "type": "string"
      },
      "stageIndex": {
       "type": "number"
      },
      "stageLabel": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "storagePath": {
       "type": "string"
      },
      "strategy": {
       "type": "string"
      },
      "surface": {
       "type": "string"
      },
      "targetNodeId": {
       "type": "string"
      },
      "targetPort": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "textPolicy": {
       "type": "string"
      },
      "themeStyle": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "tone": {
       "type": "string"
      },
      "type": {
       "enum": [
        "prompt",
        "reference",
        "style",
        "generate",
        "output",
        "frame",
        "note"
       ],
       "type": "string"
      }
     },
     "required": [
      "op"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "sessionId": {
    "description": "Persisted flow session id (flow_session_\u2026) from create_asset_flow or list_asset_flows.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "ops"
  ],
  "type": "object"
 },
 "name": "apply_flow_edits"
}
