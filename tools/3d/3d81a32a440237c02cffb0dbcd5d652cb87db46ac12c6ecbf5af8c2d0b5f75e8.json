  "properties": {
   "includeArchived": {
    "description": "Include Archived deals.",
    "type": "boolean"
   },
   "includeDeleted": {
    "description": "Include Deleted deals.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size, 1-100 (FUB default 10).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Rows to skip. For deep paging prefer `next`.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "personId": {
    "description": "Only deals for this person.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pipelineId": {
    "description": "Only deals in this pipeline.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "Only deals with this status.",
    "enum": [
     "Active",
     "Archived",
     "Deleted"
    ],
    "type": "string"
   },
   "userId": {
    "description": "Only deals for this user.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "fub_list_deals",
 "title": "List deals"
}
