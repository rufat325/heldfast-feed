{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a routed HiveMind query using a saved identity and return the normalized reply. The hub may cascade the query according to its routing policy; a query can trigger actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configPath": {
    "description": "Path to a Thalovant SDK config file.",
    "minLength": 1,
    "type": "string"
   },
   "context": {
    "additionalProperties": false,
    "properties": {
     "authClaims": {
      "additionalProperties": {},
      "type": "object"
     },
     "authProvider": {
      "minLength": 1,
      "type": "string"
     },
     "channel": {
      "minLength": 1,
      "type": "string"
     },
     "destination": {
      "minLength": 1,
      "type": "string"
     },
     "deviceId": {
      "minLength": 1,
      "type": "string"
     },
     "locale": {
      "minLength": 1,
      "type": "string"
     },
     "metadata": {
      "$ref": "#/properties/context/properties/authClaims"
     },
     "platform": {
      "minLength": 1,
      "type": "string"
     },
     "roles": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     },
     "sessionId": {
      "minLength": 1,
      "type": "string"
     },
     "source": {
      "minLength": 1,
      "type": "string"
     },
     "userId": {
      "minLength": 1,
      "type": "string"
     },
     "userName": {
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   },
   "fromEnv": {
    "default": false,
    "description": "Load the identity from Thalovant SDK environment variables.",
    "type": "boolean"
   },
   "identityFile": {
    "description": "Path to a Thalovant identity JSON file.",
    "minLength": 1,
    "type": "string"
   },
   "includeAudio": {
    "default": false,
    "description": "Include bounded embedded skill clips as MCP audio/resources.",
    "type": "boolean"
   },
   "lang": {
    "minLength": 1,
    "type": "string"
   },
   "profile": {
    "description": "SDK config profile name.",
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "default": "wss",
    "description": "Runtime transport protocol.",
    "enum": [
     "wss",
     "https",
     "mqtt"
    ],
    "type": "string"
   },
   "queryId": {
    "minLength": 1,
    "type": "string"
   },
   "replySettleMs": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "timeoutMs": {
    "default": 30000,
    "maximum": 300000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "thalovant_query",
 "title": "Query Hub"
}
