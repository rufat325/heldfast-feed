{
 "description": "Generate the exact shell command to install a shadcn component.\nSupports npm, pnpm, yarn, and bun. Pass multiple components to install in one call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "components": {
    "description": "Component slug(s) \u2014 e.g., ['button', 'card']",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "packageManager": {
    "default": "npm",
    "enum": [
     "npm",
     "pnpm",
     "yarn",
     "bun"
    ],
    "type": "string"
   }
  },
  "required": [
   "components"
  ],
  "type": "object"
 },
 "name": "shadcn_install_command"
}
