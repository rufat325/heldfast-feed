{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Technical indicator"
 },
 "description": "Technical indicator series for a stock: SMA, EMA, RSI or MACD on adjusted closes (daily by default), latest first. Use for 'is AAPL overbought?' (RSI) or trend questions. Pro.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "indicator": {
    "enum": [
     "sma",
     "ema",
     "rsi",
     "macd"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Points to return (default 50)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "long_window": {
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "short_window": {
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "signal_window": {
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "ticker": {
    "description": "Stock or ETF ticker, e.g. NVDA, SPY, BRK.B",
    "type": "string"
   },
   "timespan": {
    "enum": [
     "minute",
     "hour",
     "day",
     "week",
     "month",
     "quarter",
     "year"
    ],
    "type": "string"
   },
   "window": {
    "description": "Look-back window for sma/ema/rsi (default 14)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "ticker",
   "indicator"
  ],
  "type": "object"
 },
 "name": "technical_indicator",
 "title": "Technical indicator"
}
