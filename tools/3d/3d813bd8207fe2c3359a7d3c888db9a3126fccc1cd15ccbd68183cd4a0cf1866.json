    "minimum": 1,
    "type": "integer"
   },
   "check_in": {
    "description": "Arrival date YYYY-MM-DD.",
    "type": "string"
   },
   "check_out": {
    "description": "Departure date YYYY-MM-DD.",
    "type": "string"
   },
   "children": {
    "items": {
     "maximum": 17,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 10,
    "type": "array"
   },
   "id": {
    "description": "Property/type ID (G1..G6 or G4B).",
    "type": "string"
   },
   "language": {
    "enum": [
     "es",
     "en"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "check_in",
   "check_out",
   "adults"
  ],
  "type": "object"
 },
 "name": "get_quote",
