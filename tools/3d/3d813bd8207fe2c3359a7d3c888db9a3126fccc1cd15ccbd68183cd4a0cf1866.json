  "readOnlyHint": true,
  "title": "Get quote"
 },
 "description": "Return the exact total EUR price for one property category and date range. The price matches what checkout charges a non-member with no discount code \u2014 if the traveller has a code, they enter it themselves on beachvalencia.com. Includes deposit and cancellation summary. If the dates are not available, \"available\" is false and booking_url points to the search page as a fallback. Example: {\"id\":\"G4\",\"check_in\":\"2027-06-08\",\"check_out\":\"2027-06-15\",\"adults\":6}.",
 "execution": {
  "taskSupport": "forbidden"
 },
