{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Report abuse"
 },
 "description": "Report an API for abuse \u2014 CSAM, fraud, malware, copyright, trademark, etc. Returns a reference ID for tracking. Submitting a report does not guarantee removal; trust & safety reviews each report.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiSlug": {
    "pattern": "^[a-z0-9_-]+$",
    "type": "string"
   },
   "category": {
    "enum": [
     "csam",
     "ncii",
     "illegal",
     "malware",
     "fraud",
     "copyright",
     "trademark",
     "impersonation",
     "harassment",
     "sanctions",
     "other"
    ],
    "type": "string"
   },
   "details": {
    "maxLength": 4000,
    "minLength": 10,
    "type": "string"
   },
   "reporterEmail": {
    "format": "email",
    "type": "string"
   }
  },
  "required": [
   "apiSlug",
   "category",
   "details"
  ],
  "type": "object"
 },
 "name": "gatefare.report_abuse"
}
