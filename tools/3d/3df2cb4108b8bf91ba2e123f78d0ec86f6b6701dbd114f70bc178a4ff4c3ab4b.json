{
 "description": "Browse the leaderboard of top-performing traders you can copy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Number of traders to return (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "period": {
    "default": "30d",
    "description": "Leaderboard time period",
    "enum": [
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   },
   "sortBy": {
    "default": "roi",
    "description": "Sort criteria",
    "enum": [
     "roi",
     "pnl",
     "winRate"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_top_traders"
}
