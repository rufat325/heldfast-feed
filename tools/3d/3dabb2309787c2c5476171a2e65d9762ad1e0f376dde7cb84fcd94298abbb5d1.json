{
 "description": "Change a form's settings: context, destinations, thresholds, watch mode, allow/block lists.",
 "inputSchema": {
  "properties": {
   "allow_list": {
    "description": "Emails or domains always delivered without judging",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "api_key": {
    "description": "Doorman API key (dm_live_...). Only needed if the MCP connection has no Authorization header.",
    "type": "string"
   },
   "block_list": {
    "description": "Emails or domains always dropped",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deliver_at": {
    "description": "Deliver when P(real) >= this (default 0.8)",
    "type": "number"
   },
   "drop_below": {
    "description": "Drop when P(real) < this (default 0.2)",
    "type": "number"
   },
   "email_to": {
    "description": "Comma-separated emails",
    "type": "string"
   },
   "form_id": {
    "description": "f_...",
    "type": "string"
   },
   "forward_holds": {
    "description": "Forward held submissions, flagged (default true)",
    "type": "boolean"
   },
   "kind": {
    "enum": [
     "lead",
     "signup",
     "checkout",
     "comment"
    ],
    "type": "string"
   },
   "mode": {
    "description": "watch = deliver would-be drops, tagged (a safe way to start)",
    "enum": [
     "enforce",
     "watch"
    ],
    "type": "string"
   },
   "name": {
    "description": "Form name",
    "type": "string"
   },
   "redirect_url": {
    "description": "Redirect after submit",
    "type": "string"
   },
   "site_context": {
    "description": "What the business sells and to whom",
    "type": "string"
   },
   "slack_url": {
    "description": "Slack incoming webhook URL",
    "type": "string"
   },
   "webhook_url": {
    "description": "HTTPS webhook URL",
    "type": "string"
   }
  },
  "required": [
   "form_id"
  ],
  "type": "object"
 },
 "name": "doorman_update_form"
}
