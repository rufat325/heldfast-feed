    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "One-based result page number.",
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query.",
    "type": "string"
   },
   "sort": {
    "description": "Optional public result sort order.",
    "enum": [
     "newest",
     "oldest",
     "deadline_soon",
     "deadline_later",
     "level_asc",
     "price_asc",
     "price_desc",
     "duration_asc",
     "smallest",
     "largest",
     "founded_newest",
     "founded_oldest",
     "most_jobs"
    ],
    "type": "string"
   }
  },
  "required": [
