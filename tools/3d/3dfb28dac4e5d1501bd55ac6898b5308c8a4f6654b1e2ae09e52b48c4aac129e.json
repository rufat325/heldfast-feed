{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start compact task context with optional capability steps and dependencies. Requires read and requests:write. No conversation or reasoning trace is stored.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "current_stage": {
    "default": "planning",
    "maxLength": 100,
    "type": "string"
   },
   "intent": {
    "maxLength": 1000,
    "minLength": 3,
    "type": "string"
   },
   "request_id": {
    "maxLength": 120,
    "minLength": 8,
    "type": "string"
   },
   "steps": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "capability": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "depends_on": {
       "default": [],
       "items": {
        "maxLength": 50,
        "type": "string"
       },
       "maxItems": 20,
       "type": "array"
      },
      "id": {
       "pattern": "^[a-z0-9_-]{1,50}$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "capability"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "request_id",
   "intent"
  ],
  "type": "object"
 },
 "name": "create_task_session"
}
