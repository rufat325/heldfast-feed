{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"After the seller approves the details and sending a verification email, prepare a private draft. Requires a seller-owned email and a stable idempotency_key. Does not publish. Returns a draft ID; ask the seller for the 8-digit code emailed to them. Never invent a code or use another person\u2019s email.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"email":{"format":"email","maxLength":254,"pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"idempotency_key":{"description":"Generate a unique request ID; reuse it only for retries with identical details.","maxLength":100,"minLength":16,"type":"string"},"sale":{"additionalProperties":false,"properties":{"address":{"maxLength":500,"minLength":5,"type":"string"},"categories":{"default":[],"items":{"maxLength":50,"minLength":1,"type":"string"},"maxItems":12,"type":"array"},"description":{"default":"","maxLength":2000,"type":"string"},"end_date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"end_time":{"anyOf":[{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},{"type":"null"}]},"photos":{"default":[],"items":{"format":"uri","maxLength":2000,"type":"string"},"maxItems":5,"type":"array"},"start_date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"start_time":{"anyOf":[{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},{"type":"null"}]},"title":{"maxLength":200,"minLength":3,"type":"string"}},"required":["title","address","start_date","end_date"],"type":"object"}},"required":["sale","email","idempotency_key"],"type":"object"},"name":"prepare_sale"}
