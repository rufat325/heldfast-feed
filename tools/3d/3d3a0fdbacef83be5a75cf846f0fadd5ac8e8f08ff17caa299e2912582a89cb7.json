{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Biggest resolved prediction-market surprises"
 },
 "description": "Free public surprise index: resolved binary markets whose winner was priced under 50 (of 100) about 24 hours before settlement, lowest T-24h winner probability first. surprise.t24hProbability and surprise.t7dProbability are the WINNING outcome's probability in 0-100 points (t7d is often null). Multi-strike ladders and markets without provider resolution are excluded. window filters by resolution recency. No API key required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fiat": {
    "description": "Fiat currency code for monetary figures (default USD).",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "limit": {
    "description": "Rows, 1-100 (default 10).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset (default 0).",
    "minimum": 0,
    "type": "integer"
   },
   "source": {
    "description": "Venue slug, as in pm_data_events rows.",
    "enum": [
     "polymarket",
     "kalshi",
     "rothera",
     "limitless",
     "smarkets",
     "manifold",
     "metaculus",
     "predictit",
     "futuur",
     "myriad",
     "forecastex",
     "gemini"
    ],
    "type": "string"
   },
   "window": {
    "description": "Resolved within this window (default all).",
    "enum": [
     "7d",
     "30d",
     "90d",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pm_data_surprises",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {},
   "httpStatus": {
    "type": "integer"
   },
   "ledgerEventId": {
    "type": [
     "string",
     "null"
    ]
   },
   "ledgerStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "httpStatus",
   "ok"
  ],
  "type": "object"
 },
 "title": "Biggest resolved prediction-market surprises"
}
