           "null"
          ]
         },
         "fetched_at": {
          "type": "string"
         },
         "futures": {
          "anyOf": [
           {
            "$ref": "#/properties/exchange/anyOf/0/properties/fees/properties/spot/anyOf/0"
           },
           {
            "type": "null"
           }
          ]
         },
         "savings_example": {
          "type": "string"
         },
         "spot": {
          "anyOf": [
           {
            "additionalProperties": true,
            "properties": {
