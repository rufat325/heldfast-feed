{
 "description": "Set the focus motor to position (0-100, near\u2192far), mapped onto the device range.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "camera": {
    "type": "string"
   },
   "position": {
    "allOf": [
     {
      "type": "number"
     },
     {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    ],
    "default": 50
   }
  },
  "type": "object"
 },
 "name": "obsbot_focus_manual"
}
