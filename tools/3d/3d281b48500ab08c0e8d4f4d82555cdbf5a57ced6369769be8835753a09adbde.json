{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "clypmint",
     "clypmint.publish"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Make the approved ideas"
 },
 "description": "Make the videos for a calendar from plan_content: every idea, or the numbers given. Each then posts on its date once it is ready and the accounts are connected, so this needs publishing permission, TikTok/YouTube settings in platform_options when they are named, and the user\u2019s explicit yes. dry_run: true answers the credits and the room left this month, and makes nothing; past the room it answers 402 with how many fit. Cost: About 4 credits per 30-second video.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "description": "true: answer the credit cost and make nothing.",
    "type": "boolean"
   },
   "items": {
    "description": "The idea numbers (n) to make; every idea not removed when left out.",
    "items": {
     "maximum": 31,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 31,
    "minItems": 1,
    "type": "array"
   },
   "operation_id": {
    "description": "A stable ID for this request. Preserve it on retries. Use a new ID only for a deliberate new request.",
    "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
    "type": "string"
   },
   "plan_id": {
    "pattern": "^pln_[0-9a-f]{24}$",
    "type": "string"
   },
   "platform_options": {
    "additionalProperties": false,
    "description": "TikTok and YouTube publishing settings, required when the ideas post there.",
    "properties": {
     "TIKTOK": {
      "additionalProperties": false,
      "properties": {
       "consent": {
        "const": true,
        "type": "boolean"
       },
       "disableComments": {
        "type": "boolean"
       },
       "disableDuet": {
        "type": "boolean"
       },
       "disableStitch": {
        "type": "boolean"
       },
       "isAiGenerated": {
        "type": "boolean"
       },
       "isBrandContent": {
        "type": "boolean"
       },
       "isOrganicBrandContent": {
        "type": "boolean"
       },
       "privacy": {
        "enum": [
         "SELF_ONLY",
         "PUBLIC_TO_EVERYONE",
         "MUTUAL_FOLLOW_FRIENDS",
         "FOLLOWER_OF_CREATOR"
        ],
        "type": "string"
       }
      },
      "required": [
       "privacy",
       "disableComments",
       "disableDuet",
       "disableStitch",
       "isAiGenerated",
       "isBrandContent",
       "isOrganicBrandContent",
       "consent"
      ],
      "type": "object"
     },
     "YOUTUBE": {
      "additionalProperties": false,
      "properties": {
       "containsSyntheticMedia": {
        "type": "boolean"
       },
       "madeForKids": {
        "type": "boolean"
       },
       "privacy": {
        "enum": [
         "PUBLIC",
         "PRIVATE",
         "UNLISTED"
        ],
        "type": "string"
       }
      },
      "required": [
       "privacy",
       "madeForKids"
      ],
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "plan_id"
  ],
  "type": "object"
 },
 "name": "approve_plan",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Clypmint approve_plan result. Error results carry error; successful requests expose the identifiers and state available for the next step. Signed media stays in private metadata.",
  "properties": {
   "available": {
    "type": "boolean"
   },
   "code": {
    "type": [
     "string",
     "null"
    ]
   },
   "cost": {
    "additionalProperties": true,
    "type": "object"
   },
   "dry_run": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "import_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "output_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "plan_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "state": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "type": [
     "string",
     "integer",
     "null"
    ]
   },
   "studio_url": {
    "format": "uri",
    "type": "string"
   },
   "style_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "version_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "video_id": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "clypmint",
    "clypmint.publish"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Make the approved ideas"
}
