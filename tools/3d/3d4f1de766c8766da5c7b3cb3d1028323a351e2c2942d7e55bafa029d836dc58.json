{
 "description": "Run a Polyrama strategy against historical market data and return summary statistics, P&L series, and fills. Requires write:paper scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "fidelity": {
    "default": 60,
    "maximum": 1440,
    "minimum": 1,
    "type": "number"
   },
   "interval": {
    "default": "1w",
    "enum": [
     "1h",
     "6h",
     "1d",
     "1w",
     "1m",
     "max"
    ],
    "type": "string"
   },
   "params": {
    "additionalProperties": true,
    "type": "object"
   },
   "strategy": {
    "minLength": 1,
    "type": "string"
   },
   "tokenId": {
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "strategy",
   "tokenId"
  ],
  "type": "object"
 },
 "name": "polyrama_run_backtest"
}
