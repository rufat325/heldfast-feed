{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List messages received by this address, newest first. Each item carries the id, sender, recipients, topic, time, read state, flags, size, attachment names and types, and a short preview. Reaction messages are hidden unless include_reactions is true, and hidden reactions never count as unread; listed reactions have their own read state (mark_read accepts them) and carry the emoji in reaction. Topics are set only on a thread's first message; get_thread reports a reply's thread_topic. Use get_message for a full body and get_thread for the conversation around a message.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "include_reactions": {
    "default": false,
    "description": "also list reaction messages (normally hidden)",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "page size (host maximum 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "number of newest messages to skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "unread_only": {
    "default": false,
    "description": "keep only unread messages from the fetched page (reactions only with include_reactions)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_messages",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "count": {
    "type": "number"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "added": {
       "description": "recipients added later via add-to",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "attachments": {
       "description": "sorted by filename, the same order in every tool",
       "items": {
        "additionalProperties": {},
        "properties": {
         "filename": {
          "type": "string"
         },
         "size": {
          "type": "number"
         },
         "type": {
          "description": "media type; inferred from the filename when the host records none",
          "type": "string"
         }
        },
        "required": [
         "filename",
         "size"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "compressed": {
       "description": "true when the body was sent deflate-compressed on the wire (see size)",
       "type": "boolean"
      },
      "from": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "important": {
       "type": "boolean"
      },
      "no_reply": {
       "type": "boolean"
      },
      "pid": {
       "type": [
        "string",
        "null"
       ]
      },
      "preview": {
       "description": "start of the body; may be shorter than the full body",
       "type": "string"
      },
      "reaction": {
       "description": "the emoji when this message is itself a reaction (\"\" clears one); null otherwise",
       "type": [
        "string",
        "null"
       ]
      },
      "reactions": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "emoji": {
          "type": "string"
         },
         "from": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "emoji",
         "from"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "read": {
       "description": "null when not applicable (your own sent messages)",
       "type": [
        "boolean",
        "null"
       ]
      },
      "size": {
       "description": "body size in bytes as stored by your host: for a message you received with compressed true, the compressed wire length; your own sent messages store the uncompressed length. body_bytes, where given, is the decoded length",
       "type": "number"
      },
      "terminal": {
       "type": "boolean"
      },
      "time": {
       "description": "ISO-8601; null for drafts",
       "type": [
        "string",
        "null"
       ]
      },
      "time_posix": {
       "type": [
        "number",
        "null"
       ]
      },
      "to": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "topic": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "pid",
      "from",
      "to",
      "added",
      "topic",
      "time",
      "time_posix",
      "read",
      "important",
      "no_reply",
      "terminal",
      "type",
      "size",
      "preview",
      "attachments",
      "reactions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_offset": {
    "description": "offset for the next page, or null when this page was short",
    "type": [
     "number",
     "null"
    ]
   },
   "offset": {
    "type": "number"
   },
   "untrusted_content_notice": {
    "type": "string"
   }
  },
  "required": [
   "messages",
   "count",
   "offset",
   "next_offset"
  ],
  "type": "object"
 },
 "title": "List inbox"
}
