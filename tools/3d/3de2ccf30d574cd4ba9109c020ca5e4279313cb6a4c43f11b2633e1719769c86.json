{
 "description": "Update an existing custom object record by schema key and record ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "associations": {
    "description": "Array of association objects to set on this record",
    "items": {},
    "type": "array"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "owners": {
    "description": "Array of user IDs who own this record",
    "items": {},
    "type": "array"
   },
   "properties": {
    "additionalProperties": {},
    "description": "Key-value map of field values to update",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "recordId": {
    "description": "The record ID to update",
    "type": "string"
   },
   "schemaKey": {
    "description": "Custom object schema key",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "schemaKey",
   "recordId"
  ],
  "type": "object"
 },
 "name": "crm_update_object_record"
}
