{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: check whether TouchDesigner is reachable, whether display/projector topology matches expectations, and whether generated sensor/helper status DATs such as source_status or bridge_status are healthy. This is a room/hardware preflight for physical installations; it returns PASS/WARNING/FAIL/UNVERIFIED checks without mutating the TD project.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "expected_min_monitors": {
    "description": "Optional minimum display/monitor count expected for the room/projector setup.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "include": {
    "description": "Subset of hardware checks to run. Defaults to bridge + display, and also status_surfaces when status_paths is non-empty.",
    "items": {
     "enum": [
      "bridge",
      "display",
      "status_surfaces"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "status_paths": {
    "default": [],
    "description": "Optional DAT paths containing generated status JSON, such as source_status or bridge_status.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "diagnose_hardware_environment",
