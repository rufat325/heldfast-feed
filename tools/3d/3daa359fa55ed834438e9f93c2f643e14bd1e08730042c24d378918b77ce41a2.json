{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Escalate To Human"
 },
 "description": "Hand off an in-flight task to a human operator with a full context bundle: transcript, prior actions, identifiers, and a recommended next step. [$0.2/per_call] [async\u2192get_outcome]",
 "inputSchema": {
  "properties": {
   "context": {
    "properties": {
     "operation_id": {
      "type": "string"
     },
     "original_operation": {
      "type": "string"
     },
     "prior_actions": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "recommended_next_step": {
      "type": "string"
     },
     "transcript": {
      "items": {
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "description": "Retry key: a 24h replay returns the original receipt, not re-run or charged.",
    "maxLength": 128,
    "type": "string"
   },
   "priority": {
    "default": "normal",
    "enum": [
     "normal",
     "urgent"
    ],
    "type": "string"
   },
   "reason": {
    "enum": [
     "automation_failed",
     "customer_requested",
     "compliance_hold",
     "ambiguous_intent",
     "exception_required"
    ],
    "type": "string"
   },
   "smb_id": {
    "type": "string"
   }
  },
  "required": [
   "smb_id",
   "reason",
   "context"
  ],
  "type": "object"
 },
 "name": "escalate_to_human"
}
