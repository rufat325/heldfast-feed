  "additionalProperties": false,
  "properties": {
   "coupons": {
    "description": "Deals with a coupon code",
    "items": {
     "additionalProperties": false,
     "properties": {
      "coupon_code": {
       "type": [
        "string",
        "null"
       ]
      },
      "discount_percent": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "image_url": {
       "description": "Product photo",
       "type": [
        "string",
        "null"
       ]
      },
      "old_price": {
       "description": "BRL, price before the discount",
       "type": [
        "number",
        "null"
       ]
      },
      "price": {
       "description": "BRL",
       "type": [
        "number",
        "null"
       ]
      },
      "published_at": {
       "description": "ISO 8601",
       "type": [
        "string",
        "null"
       ]
      },
      "store": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "Deal page on Pechincha.ai",
       "type": "string"
      },
      "valid_until": {
       "description": "ISO 8601, end date reported by the store",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "title",
      "price",
      "old_price",
      "discount_percent",
      "store",
      "coupon_code",
      "published_at",
      "url",
      "image_url",
      "valid_until"
     ],
     "type": "object"
