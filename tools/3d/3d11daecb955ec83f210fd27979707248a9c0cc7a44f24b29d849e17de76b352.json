{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Retrieve current details for a known Tudetic product ID and optional variant ID.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lang": {
    "default": "es",
    "pattern": "^[a-z]{2}$",
    "type": "string"
   },
   "pricing": {
    "default": "public",
    "description": "customer only works with a valid logged-in PrestaShop session. The server derives the group.",
    "enum": [
     "public",
     "customer"
    ],
    "type": "string"
   },
   "product_id": {
    "minimum": 1,
    "type": "integer"
   },
   "shop": {
    "default": "tudetic",
    "enum": [
     "tudetic",
     "mototic",
     "scubatic",
     "biketic",
     "autotic",
     "trekktic",
     "cubiertas",
     "ociotic",
     "decortic"
    ],
    "type": "string"
   },
   "variant_id": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "product_id"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "product": {
    "type": "object"
   },
   "schema_version": {
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "product"
  ],
  "type": "object"
 },
 "title": "Get a Tudetic product"
}
