{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read text files, like cat: whole, or one slice via head, tail, or startLine/endLine. Images and audio return as media; other binary files are rejected.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "dependentRequired": {
   "endLine": [
    "startLine"
   ]
  },
  "oneOf": [
   {
    "required": [
     "path"
    ]
   },
   {
    "required": [
     "paths"
    ]
   }
  ],
  "properties": {
   "endLine": {
    "description": "End line (1-indexed)",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "head": {
    "description": "Return first N lines",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "includeHash": {
    "default": false,
    "description": "Include SHA-256 hash of the returned content in the response",
    "type": "boolean"
   },
   "path": {
    "description": "Single file path; mutually exclusive with paths",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "paths": {
    "description": "Array of file paths for batch mode (max 1000); mutually exclusive with path",
    "items": {
     "description": "File or directory path inside an allowed workspace root.",
     "maxLength": 4096,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "startLine": {
    "description": "Start line (1-indexed)",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "tail": {
    "description": "Return last N lines",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "read",
 "title": "Read File"
}
