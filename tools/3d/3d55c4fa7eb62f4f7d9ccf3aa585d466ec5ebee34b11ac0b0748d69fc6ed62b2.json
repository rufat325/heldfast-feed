{
 "_meta": {
  "ui": {
   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Re-cut a clip from Samplecut's clip card to a new start/end, reusing the audio already extracted for it. Called by the interactive card; to cut something new, use cut_audio.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "clip_id": {
    "description": "clip_id from a cut_audio result",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "end_sec": {
    "description": "New range end in seconds",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "format": {
    "description": "Download format; default the clip's current format",
    "enum": [
     "wav",
     "mp3"
    ],
    "type": "string"
   },
   "start_sec": {
    "description": "New range start in seconds",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "clip_id",
   "start_sec",
   "end_sec"
  ],
  "type": "object"
 },
 "name": "retrim_clip",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clip_id": {
    "type": "string"
   },
   "download_url": {
    "type": "string"
   },
   "editor_url": {
    "type": "string"
   },
   "end_sec": {
    "type": "number"
   },
   "expires_at": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "format": {
    "enum": [
     "wav",
     "mp3"
    ],
    "type": "string"
   },
   "full": {
    "type": "boolean"
   },
   "peaks": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "start_sec": {
    "type": "number"
   },
   "title": {
    "type": "string"
   },
   "track_duration_sec": {
    "type": "number"
   }
  },
  "required": [
   "title",
   "format",
   "full",
   "download_url",
   "editor_url",
   "expires_at",
   "clip_id",
   "track_duration_sec",
   "filename",
   "peaks"
  ],
  "type": "object"
 },
 "title": "Adjust clip"
}
