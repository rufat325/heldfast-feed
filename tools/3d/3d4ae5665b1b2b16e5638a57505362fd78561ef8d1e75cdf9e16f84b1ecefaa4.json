    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "list_id": {
    "description": "Screen id from list_smart_lists (e.g. day_gainers, golden_cross, ai_beneficiaries).",
    "type": "string"
   },
   "offset": {
    "description": "Zero-based offset into the screen for paging.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
