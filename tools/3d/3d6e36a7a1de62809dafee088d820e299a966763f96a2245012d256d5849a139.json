{
 "description": "Generate an assembled codebase analysis prompt with specified technology stacks and analysis focus areas",
 "inputSchema": {
  "properties": {
   "analysis_focus": {
    "description": "Areas to focus analysis on",
    "items": {
     "enum": [
      "architecture",
      "security",
      "performance",
      "testing",
      "documentation",
      "maintainability",
      "scalability",
      "reliability",
      "code-quality",
      "dependencies"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   },
   "technology_stack": {
    "description": "Technology stacks to analyze",
    "items": {
     "enum": [
      "node.js",
      "javascript",
      "typescript",
      "python",
      "java",
      "c#",
      "go",
      "rust",
      "php",
      "ruby",
      "swift",
      "kotlin",
      "react",
      "angular",
      "vue",
      "express",
      "nestjs",
      "django",
      "flask",
      "spring",
      "laravel",
      "rails",
      "mongodb",
      "postgresql",
      "mysql",
      "redis",
      "docker",
      "kubernetes",
      "aws",
      "azure",
      "gcp"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "technology_stack",
   "analysis_focus"
  ],
  "type": "object"
 },
 "name": "generate_codebase_analysis_prompt"
}
