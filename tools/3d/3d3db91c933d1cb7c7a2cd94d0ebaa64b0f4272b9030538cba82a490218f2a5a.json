{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Find free and busy times for calendars within a time range. Useful for finding meeting availability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarIds": {
    "default": [
     "primary"
    ],
    "description": "Calendar IDs to check (defaults to primary)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeMax": {
    "description": "End of the interval (RFC3339)",
    "type": "string"
   },
   "timeMin": {
    "description": "Start of the interval (RFC3339)",
    "type": "string"
   },
   "timeZone": {
    "description": "Timezone for the response",
    "type": "string"
   }
  },
  "required": [
   "timeMin",
   "timeMax"
  ],
  "type": "object"
 },
 "name": "freebusy_query",
 "title": "Query free/busy"
}
