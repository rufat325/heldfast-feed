{
 "_meta": {
  "ui": {
   "resourceUri": "ui://agent-manager.dev/docs-browser"
  }
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return the newest published release, read live from GitHub, with the install command for every package manager the project supports.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "install_method": {
    "description": "Return the install command for this package manager only.",
    "enum": [
     "homebrew",
     "cask",
     "script",
     "aur",
     "mise",
     "go"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_latest_release",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "install": {
    "items": {
     "properties": {
      "command": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "platforms": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "name",
      "command"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "published_at": {
    "type": "string"
   },
   "url": {
    "type": "string"
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "version",
   "url",
   "install"
  ],
  "type": "object"
 },
 "title": "Get the current agent-manager release"
}
