{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Match a buyer's hard requirements and softer preferences against current public RoamWorthy stock. Use this for conversational requests such as family size, automatic transmission, travel seats, licence/weight limits, fixed/island beds, showers, dimensions, mileage, features, location and an approximate budget. Returns up to 10 ranked vehicles with explicit match reasons, compromises and unknown data rather than pretending every requirement is known. Read-only, privacy-safe and designed for LLM shopping assistants.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budgetFlexPercent": {
    "description": "Default 10% when budgetMode=around.",
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "budgetGbp": {
    "maximum": 10000000,
    "minimum": 1000,
    "type": "integer"
   },
   "budgetMode": {
    "description": "around uses budgetFlexPercent as a soft target; hard_max never returns a vehicle above budgetGbp.",
    "enum": [
     "around",
     "hard_max"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "postcode": {
    "maxLength": 10,
    "minLength": 5,
    "type": "string"
   },
   "preferences": {
    "$ref": "#/properties/requirements"
   },
   "radiusMiles": {
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "requirements": {
    "additionalProperties": false,
    "properties": {
     "bedTypes": {
      "items": {
       "maxLength": 60,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "condition": {
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "features": {
      "items": {
       "maxLength": 60,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "layouts": {
      "items": {
       "maxLength": 60,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "maxLengthMm": {
      "maximum": 20000,
      "minimum": 1000,
      "type": "integer"
     },
     "maxMileage": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "integer"
     },
     "maxWeightKg": {
      "maximum": 10000,
      "minimum": 100,
      "type": "integer"
     },
     "maxYear": {
      "maximum": 2100,
      "minimum": 1980,
      "type": "integer"
     },
     "minBerths": {
      "maximum": 12,
      "minimum": 1,
      "type": "integer"
     },
     "minPayloadKg": {
      "maximum": 5000,
      "minimum": 0,
      "type": "integer"
     },
     "minTravelSeats": {
      "maximum": 12,
      "minimum": 1,
      "type": "integer"
     },
     "minYear": {
      "maximum": 2100,
      "minimum": 1980,
      "type": "integer"
     },
     "standardLicenceOnly": {
      "type": "boolean"
     },
     "transmission": {
      "enum": [
       "automatic",
       "manual"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "vehicleType": {
    "enum": [
     "caravan",
     "motorhome",
     "campervan"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_matching_vehicles",
 "title": "Find best-matching RoamWorthy vehicles"
}
