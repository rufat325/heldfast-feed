{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new target group for a load balancer",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "algorithmTypeCode": {
    "description": "Load balancing algorithm (RR, LC, SIPHS, MH)",
    "type": "string"
   },
   "healthCheckCycle": {
    "description": "Health check cycle in seconds (5-300, default: 30)",
    "type": "number"
   },
   "healthCheckDownThreshold": {
    "description": "Unhealthy threshold count (2-10, default: 2)",
    "type": "number"
   },
   "healthCheckHttpMethodTypeCode": {
    "description": "HTTP method type for health check (HEAD, GET). Required if healthCheckProtocolTypeCode is HTTP or HTTPS",
    "type": "string"
   },
   "healthCheckPort": {
    "description": "Health check port",
    "type": "number"
   },
   "healthCheckProtocolTypeCode": {
    "description": "Health check protocol (HTTP, HTTPS, TCP)",
    "type": "string"
   },
   "healthCheckUpThreshold": {
    "description": "Healthy threshold count (2-10, default: 2)",
    "type": "number"
   },
   "healthCheckUrlPath": {
    "description": "Health check URL path (for HTTP/HTTPS)",
    "type": "string"
   },
   "targetGroupDescription": {
    "description": "Target group description",
    "type": "string"
   },
   "targetGroupName": {
    "description": "Target group name (max 30 characters)",
    "maxLength": 30,
    "type": "string"
   },
   "targetGroupPort": {
    "description": "Target group port number",
    "type": "number"
   },
   "targetGroupProtocolTypeCode": {
    "description": "Target group protocol type (HTTP, HTTPS, TCP, PROXY_TCP)",
    "type": "string"
   },
   "targetNoList": {
    "description": "List of target numbers to bind to the target group at creation",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "targetTypeCode": {
    "description": "Target type code (VSVR)",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "string"
   }
  },
  "required": [
   "vpcNo",
   "targetGroupProtocolTypeCode",
   "targetTypeCode"
  ],
  "type": "object"
 },
 "name": "ncloud_create_target_group"
}
