{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Issue a Datoka Proof Receipt v0.1 from a commitment-only statement. Authenticated non-production pilot only; not sold through x402 in this release. Never send raw prompts or artifacts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Persist this unique key before purchase. Reuse unchanged with the same input and payment authorization after interruption.",
    "pattern": "^[\\x21-\\x7e]{16,200}$",
    "type": "string"
   },
   "statement": {
    "additionalProperties": false,
    "properties": {
     "artifact": {
      "additionalProperties": false,
      "properties": {
       "algorithm": {
        "const": "sha256",
        "type": "string"
       },
       "digest": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "encoding": {
        "enum": [
         "bytes",
         "jcs"
        ],
        "type": "string"
       },
       "mediaType": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "encoding",
       "digest",
       "mediaType"
      ],
      "type": "object"
     },
     "attestation": {
      "const": "signed_declaration",
      "type": "string"
     },
     "createdAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "independentlyVerified": {
      "const": false,
      "type": "boolean"
     },
     "parentReceipts": {
      "items": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     },
     "references": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "kind": {
         "enum": [
          "payment",
          "authorization",
          "anchor"
         ],
         "type": "string"
        },
        "protocol": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        },
        "reference": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "kind",
        "protocol",
        "reference"
       ],
       "type": "object"
      },
      "maxItems": 16,
      "type": "array"
     },
     "sources": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        },
        "retrievedAt": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
         "type": "string"
        },
        "snapshot": {
         "additionalProperties": false,
         "properties": {
          "algorithm": {
           "const": "sha256",
           "type": "string"
          },
          "digest": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "encoding": {
           "enum": [
            "bytes",
            "jcs"
           ],
           "type": "string"
          }
         },
         "required": [
          "algorithm",
          "encoding",
          "digest"
         ],
         "type": "object"
        },
        "uri": {
         "format": "uri",
         "maxLength": 2048,
         "type": "string"
        }
       },
       "required": [
        "uri",
        "retrievedAt"
       ],
       "type": "object"
      },
      "maxItems": 64,
      "type": "array"
     },
     "transformations": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        },
        "version": {
         "maxLength": 512,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id"
       ],
       "type": "object"
      },
      "maxItems": 32,
      "type": "array"
     },
     "validUntil": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "version": {
      "const": "datoka.proof.v0.1",
      "type": "string"
     }
    },
    "required": [
     "version",
     "createdAt",
     "artifact",
     "sources",
     "transformations",
     "parentReceipts",
     "attestation",
     "independentlyVerified",
     "references"
    ],
    "type": "object"
   }
  },
  "required": [
   "statement",
   "chain",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "issue_proof_receipt"
}
