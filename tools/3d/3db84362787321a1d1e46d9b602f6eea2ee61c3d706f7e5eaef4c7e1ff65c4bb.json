{
 "description": "Use this after get_server_details to generate a ready-to-paste JSON config snippet for the target client. Returns structured config, file paths, required env vars, restart guidance, and safety flags like requires_user_secrets and safe_to_autoinstall.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Server name or slug (e.g., \"filesystem\", \"io.modelcontextprotocol/filesystem\")",
    "type": "string"
   },
   "platform": {
    "default": "claude-desktop",
    "description": "Target platform for install config",
    "enum": [
     "claude-desktop",
     "cursor",
     "claude-code",
     "cline",
     "windsurf"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_install_config",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoInstallable": {
    "type": "boolean"
   },
   "config": {
    "additionalProperties": {},
    "type": "object"
   },
   "configFilePath": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "envVarsNeeded": {
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "found": {
    "type": "boolean"
   },
   "installType": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "next_actions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "platform": {
    "type": "string"
   },
   "possible_unlabeled_secrets": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "requires_user_secrets": {
    "type": "boolean"
   },
   "retry_after_seconds": {
    "type": "number"
   },
   "safe_to_autoinstall": {
    "type": "boolean"
   },
   "server": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ready",
     "preparing"
    ],
    "type": "string"
   },
   "warningFlags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "next_actions"
  ],
  "type": "object"
 }
}
