{
 "description": "Build a weekly status, project update, or quarterly report from a connected source. Native PowerPoint objects. Requires API key.",
 "inputSchema": {
  "properties": {
   "kind": {
    "enum": [
     "weekly",
     "quarterly",
     "project"
    ],
    "type": "string"
   },
   "pageId": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "projectKey": {
    "type": "string"
   },
   "repoFullName": {
    "type": "string"
   },
   "source": {
    "description": "jira | github | notion | asana | linear | clickup",
    "type": "string"
   },
   "spaceId": {
    "type": "string"
   },
   "teamId": {
    "type": "string"
   },
   "templateId": {
    "description": "Optional locked .pptx template id",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "source"
  ],
  "type": "object"
 },
 "name": "generate_report"
}
