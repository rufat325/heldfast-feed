{
 "description": "Submit implementation for human review. Only works if tests are approved. Sets state to finished.",
 "inputSchema": {
  "properties": {
   "commitHash": {
    "description": "Latest commit SHA",
    "type": "string"
   },
   "implementationNotes": {
    "description": "What was implemented",
    "type": "string"
   },
   "storyId": {
    "description": "ID of the story",
    "type": "string"
   },
   "testResults": {
    "description": "Test output summary",
    "type": "string"
   },
   "usage": {
    "description": "Optional: your session's token usage \u2014 lands on the story's usage ledger so the team sees what this work cost. Self-reported provenance; repeats are safe when session_id is set (server computes deltas).",
    "properties": {
     "cache_creation_tokens": {
      "description": "Cumulative cache-creation tokens",
      "type": "number"
     },
     "cache_read_tokens": {
      "description": "Cumulative cache-read tokens",
      "type": "number"
     },
     "input_tokens": {
      "description": "Cumulative session input tokens",
      "type": "number"
     },
     "model": {
      "description": "Model id, e.g. claude-fable-5",
      "type": "string"
     },
     "output_tokens": {
      "description": "Cumulative session output tokens",
      "type": "number"
     },
     "session_id": {
      "description": "Stable session id \u2014 enables idempotent cumulative reporting",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "storyId"
  ],
  "type": "object"
 },
 "name": "submit_for_review"
}
