{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a custom metric definition in Metabase for KPI tracking and business intelligence",
 "inputSchema": {
  "properties": {
   "aggregation": {
    "description": "Metric aggregation definition",
    "properties": {
     "field_id": {
      "description": "Field ID to aggregate (required for sum, avg, min, max)",
      "type": "number"
     },
     "type": {
      "description": "Aggregation type",
      "enum": [
       "count",
       "sum",
       "avg",
       "min",
       "max",
       "distinct"
      ],
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "description": {
    "description": "Metric description and business context",
    "type": "string"
   },
   "filters": {
    "description": "Optional filters to apply to metric calculation",
    "items": {
     "properties": {
      "field_id": {
       "description": "Field ID to filter on",
       "type": "number"
      },
      "operator": {
       "description": "Filter operator",
       "enum": [
        "=",
        "!=",
        ">",
        "<",
        ">=",
        "<=",
        "contains",
        "starts-with",
        "ends-with",
        "is-null",
        "not-null"
       ],
       "type": "string"
      },
      "value": {
       "description": "Filter value"
      }
     },
     "required": [
      "field_id",
      "operator"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Metric name",
    "type": "string"
   },
   "table_id": {
    "description": "Base table ID for the metric",
    "type": "number"
   }
  },
  "required": [
   "name",
   "description",
   "table_id",
   "aggregation"
  ],
  "type": "object"
 },
 "name": "mb_metric_create",
 "title": "Create Metric"
}
