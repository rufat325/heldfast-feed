{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare two text files and return a unified diff from a to b, like diff -u.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "a": {
    "description": "First file to compare",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "b": {
    "description": "Second file to compare",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "context": {
    "default": 3,
    "description": "Number of context lines surrounding each change (default: 3)",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   }
  },
  "required": [
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "diff",
 "title": "Diff"
}
