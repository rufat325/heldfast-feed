{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new calendar event.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attendees": {
    "description": "Attendees (JSON array as string, e.g. '[{\"email\":\"a@x.com\"},{\"email\":\"b@x.com\",\"optional\":true}]')",
    "type": "string"
   },
   "calendarId": {
    "description": "Calendar ID",
    "type": "string"
   },
   "description": {
    "description": "Event description",
    "type": "string"
   },
   "end": {
    "description": "End time JSON",
    "type": "string"
   },
   "location": {
    "description": "Event location",
    "type": "string"
   },
   "sendUpdates": {
    "description": "Sends invitation email to attendees when set: \"all\", \"externalOnly\", or \"none\" (default: none \u2014 no email, though the event may still appear on an attendee's calendar depending on their settings)",
    "enum": [
     "all",
     "externalOnly",
     "none"
    ],
    "type": "string"
   },
   "start": {
    "description": "Start time JSON (e.g. '{\"dateTime\":\"2026-03-10T10:00:00-07:00\"}')",
    "type": "string"
   },
   "summary": {
    "description": "Event title",
    "type": "string"
   }
  },
  "required": [
   "calendarId",
   "summary",
   "start",
   "end"
  ],
  "type": "object"
 },
 "name": "calendar_events_insert"
}
