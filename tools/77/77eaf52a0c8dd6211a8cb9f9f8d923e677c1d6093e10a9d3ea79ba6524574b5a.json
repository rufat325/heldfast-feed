{
 "description": "Apply number formatting to cells in a Google Sheet",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "pattern": {
    "description": "Number format pattern (e.g., '#,##0.00', 'yyyy-mm-dd', '$#,##0.00', '0.00%')",
    "type": "string"
   },
   "range": {
    "description": "Range to format (e.g., 'A1:C10')",
    "type": "string"
   },
   "spreadsheetId": {
    "description": "Spreadsheet ID",
    "type": "string"
   },
   "type": {
    "description": "Format type",
    "enum": [
     "NUMBER",
     "CURRENCY",
     "PERCENT",
     "DATE",
     "TIME",
     "DATE_TIME",
     "SCIENTIFIC"
    ],
    "type": "string"
   }
  },
  "required": [
   "spreadsheetId",
   "range",
   "pattern"
  ],
  "type": "object"
 },
 "name": "formatGoogleSheetNumbers"
}
