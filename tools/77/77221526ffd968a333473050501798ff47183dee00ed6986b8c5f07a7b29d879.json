{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update an existing Cloud Insight rule template (metrics group).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupName": {
    "description": "New name for the metrics group",
    "type": "string"
   },
   "metricList": {
    "description": "Updated metric configurations",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregation": {
       "description": "Aggregation type",
       "enum": [
        "AVG",
        "MIN",
        "MAX",
        "SUM",
        "COUNT"
       ],
       "type": "string"
      },
      "condition": {
       "description": "Threshold condition",
       "enum": [
        "GT",
        "GTE",
        "LT",
        "LTE",
        "EQ"
       ],
       "type": "string"
      },
      "duration": {
       "description": "Duration in minutes",
       "type": "number"
      },
      "eventLevel": {
       "description": "Event severity level",
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "metricGroupItemId": {
       "description": "Metric item ID",
       "type": "string"
      },
      "threshold": {
       "description": "Threshold value",
       "type": "number"
      }
     },
     "required": [
      "metricGroupItemId",
      "condition",
      "threshold",
      "duration",
      "eventLevel"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "metricsGroupId": {
    "description": "Metrics group ID to update",
    "type": "string"
   }
  },
  "required": [
   "metricsGroupId"
  ],
  "type": "object"
 },
 "name": "ncloud_update_metrics_group"
}
