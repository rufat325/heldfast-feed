 "description": "Returns the full conditions of one tariff from a compare-tariffs result, identified by its `ref`: price composition, scope of the price guarantee, contract duration, renewal and cancellation terms, deposit, energy-source mix, customer ratings, and for eco tariffs the required eco statement and proof. Texts come in the requested `language`. Keywords: Tarifdetails, Vertragsbedingungen, Preisgarantie, K\u00fcndigungsfrist, Vertragslaufzeit, AGB, tariff conditions, contract details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "language": {
    "description": "Language of the conversation (for the eco statement and proof texts). Default: de.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "ref": {
    "description": "Offer reference from a compare-tariffs result (field `ref`).",
    "pattern": "^[a-z0-9]+\\.\\d+$",
    "type": "string"
   }
  },
  "required": [
   "ref"
  ],
  "type": "object"
 },
 "name": "tariff-details",
