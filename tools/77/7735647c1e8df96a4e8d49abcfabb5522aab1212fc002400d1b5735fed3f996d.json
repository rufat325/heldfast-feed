{
 "description": "PAID $0.50 \u2014 risk scores for up to 25 wallets in one payment ($0.02/wallet effective).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "wallets": {
    "description": "up to 25 wallet addresses",
    "items": {
     "pattern": "^0x[0-9a-fA-F]{40}$",
     "type": "string"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "wallets"
  ],
  "type": "object"
 },
 "name": "score_batch"
}
