{"_meta":{"securitySchemes":[{"scopes":["vocabulary:read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Find your saved words"},"description":"Searches or browses the learner's saved words by text or group to read or edit them, with meanings, examples, notes, images, group membership, IDs and versions for save_word and delete_word. It ignores practice scheduling; get_training_items picks words to practise and get_learning_context gives an account overview. Results are paged; pass nextCursor to continue.","inputSchema":{"additionalProperties":false,"properties":{"cursor":{"pattern":"^[0-9]{1,6}$","type":"string"},"groupIds":{"items":{"maxLength":100,"minLength":1,"pattern":".*\\S.*","type":"string"},"maxItems":50,"minItems":1,"type":"array"},"languageCode":{"description":"Code of the learning language, for example en-GB or es-ES.","enum":["en-US","en-GB","es-ES","es-MX","uk-UA","pl-PL","fr-FR","fr-CA","de-DE","de-AT","de-CH","it-IT","ko-KR","ja-JP","sv-SE","ar-SA","nl-NL","nl-BE","zh-CN"],"type":"string"},"limit":{"maximum":50,"minimum":1,"type":"integer"},"text":{"maxLength":50,"minLength":1,"pattern":".*\\S.*","type":"string"}},"required":["languageCode"],"type":"object"},"name":"find_my_words","outputSchema":{"properties":{"examplesOmitted":{"type":"boolean"},"items":{"items":{"properties":{"comment":{"type":"string"},"definitions":{"items":{"properties":{"comment":{"type":"string"},"definition":{"type":"string"},"examples":{"items":{"type":"string"},"type":"array"},"id":{"type":"string"},"translation":{"type":"string"}},"type":"object"},"type":"array"},"groupIds":{"items":{"type":"string"},"type":"array"},"id":{"type":"string"},"imageUrl":{"type":"string"},"text":{"type":"string"},"version":{"type":"string"}},"type":"object"},"type":"array"},"message":{"type":"string"},"nextCursor":{"type":"string"}},"type":"object"},"securitySchemes":[{"scopes":["vocabulary:read"],"type":"oauth