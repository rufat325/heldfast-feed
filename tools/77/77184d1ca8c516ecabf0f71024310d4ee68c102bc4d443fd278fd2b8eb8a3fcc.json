 "description": "Filter manufacturer center-of-glass performance data for 1 in. insulating glass units: Vitro (Solarban 60/70/72/90/R67/R77/R100, Sungate 400, Solarcool, Vistacool on Clear/Starphire/Acuity/Solexia/Atlantica/Azuria/Solarblue/Pacifica/Solarbronze/Optigray/Solargray/Optiblue/Graylite II; 145 makeups), Guardian SunGuard (SNX 62/27, SNX 51/23, SNE 50/25, SN 68, SN 54, SNR 50/43/35 on UltraClear/Clear/Green/CrystalGray/Gray) and Viracon (VNG-5024, VNG-4022, VNE-53, VRE-4725, VRE-4423 by substrate). Returns VLT, exterior/interior reflectance, U (air/argon), SHGC, LSG, catalog status and tags. Filter by maker, product, substrate, or limits (e.g. max_shgc 0.25 to meet IECC CZ 2). Old names like 'Solarban 70XL' or 'Solarban 67' are mapped to current names. Values are COG, not NFRC whole-product ratings. Responses keep the KB's confidence tags: [V] verified, [V-mfr] manufacturer claim, [UNVERIFIED], [inference], [Expert] field experience.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include_discontinued": {
    "description": "Include discontinued/not-available makeups (default true).",
    "type": "boolean"
   },
   "limit": {
    "description": "Max rows (default 15).",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "maker": {
    "description": "Vitro (formerly PPG), Guardian, or Viracon.",
    "type": "string"
   },
   "max_shgc": {
    "description": "Maximum SHGC (air value when available, else argon).",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "max_u": {
    "description": "Maximum U-value (argon when available, else air), Btu/h\u00b7ft\u00b2\u00b7\u00b0F.",
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "max_vlt": {
    "description": "Maximum VLT %.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "min_lsg": {
    "description": "Minimum light-to-solar-gain ratio.",
    "maximum": 3,
    "minimum": 0,
    "type": "number"
   },
   "min_vlt": {
    "description": "Minimum visible light transmittance %.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "product": {
    "description": "Coating/product, e.g. 'Solarban 70', 'SNX 62/27', 'VNE-53', or a family prefix like 'SNR' or 'Solarban R'.",
    "type": "string"
   },
   "sort_by": {
    "description": "Sort: vlt (high first), shgc (low first), lsg (high first), u (low first).",
    "enum": [
     "vlt",
     "shgc",
     "lsg",
     "u"
    ],
    "type": "string"
   },
   "substrate": {
    "description": "Glass substrate/tint, e.g. 'Clear', 'Starphire', 'low-iron', 'Solexia', 'Optigray', 'Gray', 'Green'.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "lookup_glass_performance",
