{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan an outfit"
 },
 "description": "Prescribe a complete men's outfit for an occasion within a budget. Each piece gets the best-graded maker that fits the money at a ledger starting price (full price or Nordstrom Rack), a second choice, and what to check at the fitting, plus cloth, cut and tag advice. If nothing graded fits the money for a piece, that piece comes back with no maker. If nothing fits at all, the result gives the lowest budget that fills every graded piece. Makers come only from the QuarterMaster ledger. Use after the fitting questions, or straight away when someone gives the occasion and the money for a man's outfit (\"wedding in October, $800, what do I get?\"). Limits: menswear only; prices are US dollars from the QuarterMaster ledger of 53 makers, checked September 2026, not live store prices; no stock, size or delivery checks; no orders.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "already_own": {
    "description": "Pieces they already own for this occasion; the plan builds around them.",
    "items": {
     "enum": [
      "jacket",
      "suit",
      "trouser",
      "layer",
      "shell",
      "shirt",
      "knit",
      "shoes",
      "watch"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "budget": {
    "description": "Total to spend on the outfit, in US dollars.",
    "minimum": 50,
    "type": "number"
   },
   "cloth": {
    "description": "Jacket or suit cloth, if tailoring is involved.",
    "enum": [
     "worsted",
     "flannel",
     "linen"
    ],
    "type": "string"
   },
   "cut": {
    "description": "Jacket or suit cut, if tailoring is involved.",
    "enum": [
     "trim",
     "classic",
     "easy"
    ],
    "type": "string"
   },
   "impression": {
    "description": "How they want to come across: quiet (quiet and correct, the default), sharper (a notch above the room), relaxed (at ease).",
    "enum": [
     "quiet",
     "sharper",
     "relaxed"
    ],
    "type": "string"
   },
   "room": {
    "description": "The occasion.",
    "enum": [
     "work-dinner",
     "first-date",
     "wedding-guest",
     "rainy-weekend",
     "coffee-with-friends"
    ],
    "type": "string"
   },
   "time_of_day": {
    "enum": [
     "day",
     "evening"
    ],
    "type": "string"
   }
  },
  "required": [
   "room",
   "budget"
  ],
  "type": "object"
 },
