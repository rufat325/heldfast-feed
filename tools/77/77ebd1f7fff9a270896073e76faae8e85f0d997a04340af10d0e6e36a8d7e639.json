{
 "description": "Create a new contact in the workspace",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bbc_station": {
    "description": "BBC station name if applicable",
    "type": "string"
   },
   "email": {
    "description": "Email address (must be unique in workspace)",
    "format": "email",
    "type": "string"
   },
   "genres": {
    "description": "Music genres (e.g. [\"pop\", \"indie\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Contact display name",
    "type": "string"
   },
   "notes": {
    "description": "Free-text notes about this contact",
    "type": "string"
   },
   "outlet": {
    "description": "Station, publication, or company name",
    "type": "string"
   },
   "platform_type": {
    "description": "Contact platform type",
    "enum": [
     "radio",
     "press",
     "playlist",
     "tv",
     "online",
     "other"
    ],
    "type": "string"
   },
   "role": {
    "description": "Job title or role",
    "type": "string"
   }
  },
  "required": [
   "name",
   "email"
  ],
  "type": "object"
 },
 "name": "tap_create_contact"
}
