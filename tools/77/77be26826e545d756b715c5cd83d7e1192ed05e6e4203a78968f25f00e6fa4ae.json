{
 "description": "Create a notification alert rule. Defines which events at which severity levels trigger notifications on which channels. Supports quiet hours and per-target scoping.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channelTypes": {
    "description": "Channels to notify",
    "items": {
     "enum": [
      "IN_APP",
      "EMAIL",
      "SLACK",
      "WEBHOOK",
      "SMS",
      "WEB_PUSH"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "enabled": {
    "default": true,
    "description": "Whether the rule is active",
    "type": "boolean"
   },
   "eventTypes": {
    "description": "Events that trigger this rule",
    "items": {
     "enum": [
      "INCIDENT_OPENED",
      "INCIDENT_RESOLVED",
      "INCIDENT_ACKNOWLEDGED",
      "FINDING_CREATED",
      "FINDING_RESOLVED",
      "FINDING_ESCALATED",
      "TARGET_DOWN",
      "TARGET_RECOVERED",
      "TEST_FAILED",
      "TEST_RECOVERED",
      "SCAN_COMPLETED",
      "BILLING_LIMIT_REACHED",
      "ACTION_REQUIRED"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Rule name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "quietHoursEnd": {
    "description": "Quiet hours end (hour UTC)",
    "maximum": 23,
    "minimum": 0,
    "type": "number"
   },
   "quietHoursStart": {
    "description": "Quiet hours start (hour UTC)",
    "maximum": 23,
    "minimum": 0,
    "type": "number"
   },
   "severities": {
    "description": "Only trigger for these severities",
    "items": {
     "enum": [
      "CRITICAL",
      "WARNING",
      "INFO"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "targetId": {
    "description": "Scope to a specific target",
    "type": "string"
   }
  },
  "required": [
   "name",
   "eventTypes",
   "channelTypes"
  ],
  "type": "object"
 },
 "name": "create_notification_rule",
 "title": "Create Notification Rule"
}
