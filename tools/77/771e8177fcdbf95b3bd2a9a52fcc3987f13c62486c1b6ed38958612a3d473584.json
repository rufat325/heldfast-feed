 "description": "Fetch one opportunity with its dates, state (0 Enquiry, 1 Draft, 2 Quotation, 3 Order), status and charge/cost totals. Associations (customer, venue, line items, assets, participants) are only returned when named in include. Current RMS: GET /opportunities/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "include": {
    "description": "Associations to embed, e.g. [\"member\", \"venue\", \"opportunity_items\"].",
    "items": {
     "enum": [
      "owner",
      "member",
      "billing_address",
      "destination",
      "collection",
      "venue",
      "opportunity_surcharges",
      "participants",
      "opportunity_items",
      "item_assets",
      "return_item_assets"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "opportunity_id": {
    "description": "The opportunity id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "opportunity_id"
  ],
  "type": "object"
 },
 "name": "current_rms_get_opportunity",
 "title": "Get one opportunity"
}
