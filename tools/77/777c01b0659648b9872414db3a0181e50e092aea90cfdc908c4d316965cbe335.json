{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List degradation incidents across status pages with optional status/page filtering",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filterPageId": {
    "description": "Filter by status page ID",
    "type": "string"
   },
   "filterStatus": {
    "description": "Filter by degradation status",
    "enum": [
     "investigating",
     "identified",
     "monitoring",
     "resolved"
    ],
    "type": "string"
   },
   "pageLimit": {
    "default": 25,
    "description": "Number of results per page",
    "type": "number"
   },
   "pageOffset": {
    "description": "Offset for pagination",
    "type": "number"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "created_at",
     "-created_at",
     "modified_at",
     "-modified_at"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-status-page-degradations"
}
