    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "id": {
    "description": "Test cycle ID",
    "type": [
     "string",
     "number"
    ]
   },
   "maxResults": {
    "description": "Items per page (max 100, default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Sort e.g. \"id:asc\" or \"updated:desc\"",
    "type": "string"
   },
   "startAt": {
    "description": "Page offset (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
