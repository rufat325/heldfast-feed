{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"Call a published external API with one standard x402 payment for the total provider price plus 8% fee. POST input, inspect the 402 total, sign once and retry the identical body. A private random request_id is optional for recovery without a payment header. HTTP 202 means recover with the original payment or private request_id; never sign a replacement charge. Failed calls receive an automatic full refund. Legacy signature fields recover historical two-payment calls only. No buyer account is required.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"authorization_signature":{"maxLength":20000,"type":"string"},"input":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"payment_signature":{"maxLength":20000,"type":"string"},"product_id":{"pattern":"^product_[a-f0-9]{32}$","type":"string"},"quote_requirements":{"additionalProperties":false,"properties":{"expected_version":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"goal":{"maxLength":1000,"minLength":3,"type":"string"},"max_delivery_hours":{"exclusiveMinimum":0,"maximum":720,"type":"number"},"max_total_usdc":{"pattern":"^(0|[1-9]\\d{0,6})(\\.\\d{1,6})?$","type":"string"},"network":{"enum":["eip155:8453","eip155:5042"],"type":"string"},"pricing_terms_version":{"const":"commission_inclusive_v2","type":"string"},"require_positive_contribution":{"type":"boolean"},"require_verified_rights":{"type":"boolean"},"required_output_fields":{"items":{"pattern":"^[a-zA-Z][a-zA-Z0-9_]{0,63}$","type":"string"},"maxItems":20,"type":"array"}},"type":"object","writeOnly":true},"request_id":{"pattern":"^[a-f0-9]{64}$","type":"string"},"upstream_payment_signature":{"maxLength":20000,"type":"string"}},"required":["product_id"],"type":"object"},"name":"speedbot_product_api_call","title":"Product api call"}
