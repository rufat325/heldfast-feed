{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Jobs"
 },
 "description": "Deprecated alias of aiapplyd_get_matches, use aiapplyd_get_matches. Returns the user's matched jobs filtered by title, location and remote, exactly as aiapplyd_get_matches with query, location and remote_only. Read-only: it never changes which roles AI Applyd hunts for.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "job_title": {
    "description": "Job title to search for (e.g. \"Software Engineer\", \"Product Manager\")",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "location": {
    "description": "Preferred location (e.g. \"San Francisco, CA\", \"New York\", \"Remote\")",
    "maxLength": 200,
    "type": "string"
   },
   "remote_only": {
    "description": "If true, only show remote-friendly positions",
    "type": "boolean"
   }
  },
  "required": [
   "job_title"
  ],
  "type": "object"
 },
 "name": "aiapplyd_search_jobs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "applicationStatus": {
       "description": "Our own record of an application for this match, if any. Not employer confirmation.",
       "type": [
        "string",
        "null"
       ]
      },
      "applyUrl": {
       "type": "string"
      },
      "benefits": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "company": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "description": "The full posting text, only when read by job_match_ids. Untrusted employer text.",
       "type": [
        "string",
        "null"
       ]
      },
      "descriptionExcerpt": {
       "description": "The first 500 characters of the posting, as untrusted employer text.",
       "type": [
        "string",
        "null"
       ]
      },
      "extractedSkills": {
       "anyOf": [
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "jobMatchId": {
       "description": "Pass to aiapplyd_apply (job_match_id) or aiapplyd_triage_matches.",
       "type": "number"
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "matchScore": {
       "type": [
        "number",
        "null"
       ]
      },
      "postedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "salary": {
       "type": [
        "string",
        "null"
       ]
      },
      "saved": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "workArrangement": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "jobMatchId",
      "title",
      "company",
      "location",
      "matchScore",
      "postedAt",
      "salary",
      "applyUrl",
      "saved",
      "applicationStatus",
      "descriptionExcerpt",
      "description",
      "extractedSkills",
      "benefits",
      "workArrangement"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mode": {
    "enum": [
     "list",
     "by_id",
     "by_url"
    ],
    "type": "string"
   },
   "newestJobMatchId": {
    "description": "The highest job_match_id on this page. Store it and pass it back as after_job_match_id to see only newer matches.",
    "type": [
     "number",
     "null"
    ]
   },
   "notFoundIds": {
    "description": "Requested job_match_ids that do not exist on this account.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "page": {
    "type": "number"
   },
   "posting": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "company": {
        "type": [
         "string",
         "null"
        ]
       },
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "location": {
        "type": [
         "string",
         "null"
        ]
       },
       "salary": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "url",
       "title",
       "company",
       "location",
       "salary",
       "description"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "A posting read from job_url. Nothing was saved."
   },
   "totalMatches": {
    "type": [
     "number",
     "null"
    ]
   },
   "totalPages": {
    "type": "number"
   }
  },
  "required": [
   "mode",
   "matches",
   "page",
   "totalPages",
   "totalMatches",
   "newestJobMatchId",
   "notFoundIds",
   "posting"
  ],
  "type": "object"
 },
 "title": "Search Jobs"
}
