{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the categories under a path, or the top-level categories, with counts of published brands. A category has a page when it has 10 published brands. With a page, the result also has that category and up to 200 of its brands. Without a page, `category` is null and the result has the categories under the path. A path that is no category answers `not_found`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "path": {
    "description": "A category path, for example `snacks/protein-bars`.",
    "maxLength": 300,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+(?:\\/[a-z0-9-]+)*$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_categories",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "direct_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "has_page": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "route_known_count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "path",
      "name",
      "brand_count",
      "route_known_count",
      "direct_count",
      "has_page"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "category": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "brand_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "brands": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "availability": {
           "anyOf": [
            {
             "enum": [
              "direct",
              "indirect_only",
              "unavailable",
              "unknown"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "canonical_name": {
           "type": "string"
          },
          "category": {
           "type": [
            "string",
            "null"
           ]
          },
          "last_verified_at": {
           "anyOf": [
            {
             "format": "date-time",
             "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "sells_direct": {
           "type": "boolean"
          },
          "slug": {
           "type": "string"
          }
         },
         "required": [
          "slug",
          "canonical_name",
          "category",
          "availability",
          "last_verified_at",
          "sells_direct"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "children": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "brand_count": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "name": {
           "type": "string"
          },
          "path": {
           "type": "string"
          }
         },
         "required": [
          "path",
          "name",
          "brand_count"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "direct_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "name": {
        "type": "string"
       },
       "parents": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "name": {
           "type": "string"
          },
          "path": {
           "type": "string"
          }
         },
         "required": [
          "path",
          "name"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "path": {
        "type": "string"
       },
       "route_known_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "slug": {
        "type": "string"
       }
      },
      "required": [
       "slug",
       "path",
       "name",
       "description",
       "parents",
       "children",
       "brand_count",
       "route_known_count",
       "direct_count",
       "brands"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "category",
   "categories"
  ],
  "type": "object"
 },
 "title": "List categories"
}
