{
 "description": "Update an issue. Requires `write` scope. Pass issueId plus at least one field. Enum fields (severity/status/issueType) are strictly validated.",
 "inputSchema": {
  "properties": {
   "assignedToUid": {
    "description": "New assignee user id (null unassigns)",
    "type": "string"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "dueDate": {
    "description": "New due date (ISO date string, null clears)",
    "type": "string"
   },
   "estimateMinutes": {
    "description": "New estimate in minutes (null clears)",
    "type": "number"
   },
   "issueId": {
    "description": "The issue id to update (required)",
    "type": "string"
   },
   "issueType": {
    "description": "New type",
    "enum": [
     "bug",
     "enhancement",
     "feature",
     "task"
    ],
    "type": "string"
   },
   "labels": {
    "description": "Replacement label list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "severity": {
    "description": "New severity",
    "enum": [
     "minor",
     "major",
     "critical",
     "blocker"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "New start date (ISO date string, null clears)",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "newBug",
     "triaged",
     "inProgress",
     "blocked",
     "fixed",
     "verified",
     "wontFix",
     "duplicate"
    ],
    "type": "string"
   },
   "title": {
    "description": "New title",
    "type": "string"
   }
  },
  "required": [
   "issueId"
  ],
  "type": "object"
 },
 "name": "update_issue"
}
