{
 "description": "Modificar la configuracion de un proyecto existente.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseBranch": {
    "description": "Rama base (main/master)",
    "type": "string"
   },
   "gitProject": {
    "description": "Path completo del proyecto en GitLab (ej: grupo/subgrupo/repo)",
    "type": "string"
   },
   "gitToken": {
    "description": "Nuevo token de Git provider",
    "type": "string"
   },
   "gitUrl": {
    "description": "URL base del GitLab self-hosted (ej: https://gitlab.empresa.com)",
    "type": "string"
   },
   "jiraEmail": {
    "description": "Nuevo email para Jira Cloud",
    "type": "string"
   },
   "jiraPat": {
    "description": "Nuevo PAT para Jira Server",
    "type": "string"
   },
   "jiraProjectKey": {
    "description": "Nueva clave del proyecto en Jira",
    "type": "string"
   },
   "jiraToken": {
    "description": "Nuevo API Token para Jira Cloud",
    "type": "string"
   },
   "jiraUrl": {
    "description": "Nueva URL de Jira",
    "type": "string"
   },
   "name": {
    "description": "Nombre del proyecto a modificar",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "df_project_update"
}
