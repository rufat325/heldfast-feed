{
 "description": "Wait for page navigation to complete",
 "inputSchema": {
  "properties": {
   "pageId": {
    "description": "Page ID (uses active page if not specified)",
    "type": "string"
   },
   "timeout": {
    "default": 30000,
    "description": "Timeout in milliseconds",
    "type": "number"
   },
   "url": {
    "description": "URL pattern to wait for",
    "type": "string"
   },
   "waitUntil": {
    "default": "load",
    "enum": [
     "load",
     "domcontentloaded",
     "networkidle"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "wait_for_navigation"
}
