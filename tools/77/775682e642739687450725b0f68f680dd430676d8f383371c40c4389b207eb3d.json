{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Unlock premium data"
 },
 "description": "D\u00e9bloque pour 12 mois, en cr\u00e9dits, des donn\u00e9es premium d'une soci\u00e9t\u00e9, partag\u00e9es dans l'organisation : linkedin (director_id de get_directors ; sans director_id, page de la soci\u00e9t\u00e9), presse, conseils. dry_run=true : devis sans d\u00e9bit. Sinon d\u00e9bite le solde dans la limite du budget mensuel de l'agent et de max_credits ; une m\u00eame idempotency_key ne d\u00e9bite qu'une fois.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Requis hors dry_run",
    "maxLength": 200,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "director_id": {
       "type": "string"
      },
      "family": {
       "enum": [
        "linkedin",
        "presse",
        "conseils"
       ],
       "type": "string"
      },
      "siren": {
       "description": "SIREN a 9 chiffres",
       "type": "string"
      }
     },
     "required": [
      "siren",
      "family"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "max_credits": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "unlock_premium_data",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "already_unlocked": {
    "items": {
