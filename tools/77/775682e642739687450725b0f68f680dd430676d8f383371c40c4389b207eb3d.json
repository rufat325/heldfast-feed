      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "balance_after": {
    "type": "number"
   },
   "charged_credits": {
    "type": "number"
   },
   "dry_run": {
    "type": "boolean"
   },
   "expires_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "items": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "replayed": {
    "type": "boolean"
   },
   "total_credits": {
    "type": "number"
   },
   "unavailable": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "unlocked": {
    "items": {
