{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare deterministic object-category totals for two explicit official datasets.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "base_dataset_ref": {
    "maxLength": 64,
    "minLength": 10,
    "pattern": "^official:[1-9][0-9]*$",
    "title": "Base Dataset Ref",
    "type": "string"
   },
   "base_district_identifier": {
    "maxLength": 100,
    "minLength": 2,
    "title": "Base District Identifier",
    "type": "string"
   },
   "client_id": {
    "anyOf": [
     {
      "pattern": "^sacs_client_[0-9a-f]{32}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Client Id"
   },
   "compare_dataset_ref": {
    "maxLength": 64,
    "minLength": 10,
    "pattern": "^official:[1-9][0-9]*$",
    "title": "Compare Dataset Ref",
    "type": "string"
   },
   "compare_district_identifier": {
    "maxLength": 100,
    "minLength": 2,
    "title": "Compare District Identifier",
    "type": "string"
   },
   "fund_codes": {
    "anyOf": [
     {
      "items": {
       "description": "Two-digit SACS fund code",
       "pattern": "^[0-9]{2}$",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Fund Codes"
   },
   "resource_codes": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[0-9]{4}$",
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Resource Codes"
   }
  },
  "required": [
   "base_district_identifier",
   "base_dataset_ref",
   "compare_district_identifier",
   "compare_dataset_ref"
  ],
  "title": "sacs_compare_districtsArguments",
  "type": "object"
 },
 "name": "sacs_compare_districts",
 "outputSchema": {
  "$defs": {
   "PublicError": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "invalid_request",
       "not_found",
       "private_scope_denied",
       "dataset_mismatch",
       "payload_rejected",
       "backend_unavailable"
      ],
      "title": "Code",
      "type": "string"
     },
     "message": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "title": "PublicError",
    "type": "object"
   },
   "SourceProvenance": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "maxLength": 500,
      "minLength": 1,
      "title": "Description",
      "type": "string"
     },
     "record_ref": {
      "maxLength": 160,
      "minLength": 1,
      "title": "Record Ref",
      "type": "string"
     },
     "source": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Source",
      "type": "string"
     }
    },
    "required": [
     "source",
     "record_ref",
     "description"
    ],
    "title": "SourceProvenance",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": "sacs.mcp.v1",
    "default": "sacs.mcp.v1",
    "title": "Contract Version",
    "type": "string"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Data"
   },
   "data_version": {
    "maxLength": 256,
    "minLength": 1,
    "title": "Data Version",
    "type": "string"
   },
   "error": {
    "anyOf": [
     {
      "$ref": "#/$defs/PublicError"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "title": "Limitations",
    "type": "array"
   },
   "ok": {
    "title": "Ok",
    "type": "boolean"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 8,
    "title": "Request Id",
    "type": "string"
   },
   "source_provenance": {
    "items": {
     "$ref": "#/$defs/SourceProvenance"
    },
    "title": "Source Provenance",
    "type": "array"
   }
  },
  "required": [
   "data_version",
   "request_id",
   "ok"
  ],
  "title": "PublicToolResponse",
  "type": "object"
 }
}
