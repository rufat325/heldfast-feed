{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Prepare a 15-minute review to connect a generated image application to a PostgreSQL or MariaDB catalog provider in the same project environment and server. Creates no database or deployment yet. Returns changes and a digest, never credentials. Review the application, provider and possible interruption before applying. Only where wire is listed in this connection's input schema, set wire=true to also bind every other eligible web/worker component of the environment on apply \u2014 each with its OWN credential. Requires unrestricted account credentials and deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   },
   "provider_deployment_id": {
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "provider_deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_prepare_service_binding",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "binding_id": {
      "type": "string"
     },
     "consumer_deployment_id": {
      "type": "string"
     },
     "consumer_name": {
      "type": "string"
     },
     "copies_provider_password": {
      "type": "boolean"
     },
     "credential_delivery": {
      "type": "string"
     },
     "database": {
      "type": "string"
     },
     "environment_id": {
      "type": "string"
     },
     "expires_at": {
      "type": "string"
     },
     "may_interrupt_traffic": {
      "type": "boolean"
     },
     "opens_host_port": {
      "type": "boolean"
     },
     "operation": {
      "const": "create",
      "type": "string"
     },
     "plan_id": {
      "type": "string"
     },
     "provider_deployment_id": {
      "type": "string"
     },
     "provider_engine": {
      "type": "string"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "variable": {
      "const": "DATABASE_URL",
      "type": "string"
     },
     "wire": {
      "type": "boolean"
     },
     "wire_components": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "wire_note": {
      "type": "string"
     }
    },
    "required": [
     "plan_id",
     "review_digest",
     "status",
     "expires_at",
     "receipt",
     "operation",
     "binding_id",
     "consumer_deployment_id",
     "consumer_name",
     "provider_deployment_id",
     "provider_engine",
     "environment_id",
     "variable",
     "may_interrupt_traffic",
     "database",
     "copies_provider_password",
     "opens_host_port",
     "credential_delivery"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Prepare service binding"
}
