{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a checkout session"
 },
 "description": "Start a TestWell order for the user: tests/panels, the US state where they will visit the lab (required for pricing and lab routing), and the buyer's name, email and phone. Returns priced line items in cents, the single $6 lab fee, the total, any blocking messages, and pay_online_url \u2014 a prefilled cart the user can pay in a browser when the platform has no payment token. Use dry_run to preview without creating a session.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyer": {
    "properties": {
     "email": {
      "format": "email",
      "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "first_name": {
      "maxLength": 80,
      "type": "string"
     },
     "last_name": {
      "maxLength": 80,
      "type": "string"
     },
     "phone_number": {
      "maxLength": 20,
      "type": "string"
     }
    },
    "type": "object"
   },
   "dry_run": {
    "description": "Price only; do not create a session",
    "type": "boolean"
   },
   "items": {
    "items": {
     "properties": {
      "id": {
       "description": "Test or panel slug/id",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "maximum": 1,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "state": {
    "description": "US state code or name where the blood will be drawn",
    "maxLength": 40,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "create_checkout",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "currency": {
    "const": "usd",
    "type": "string"
   },
   "dry_run": {
    "type": "boolean"
   },
   "fulfillment_options": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "const": "digital",
       "type": "string"
      }
     },
     "required": [
      "type",
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "base_amount": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "item": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "quantity": {
         "type": "number"
        }
       },
       "required": [
        "id",
        "quantity"
       ],
       "type": "object"
      },
      "lab": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "subtotal": {
       "type": "number"
      },
      "total": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "item",
      "base_amount",
      "subtotal",
      "total"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "messages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "content": {
       "type": "string"
      },
      "param": {
       "type": "string"
      },
      "type": {
       "enum": [
        "info",
        "error"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "order": {
    "additionalProperties": false,
    "properties": {
     "checkout_session_id": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "permalink_url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "checkout_session_id",
     "permalink_url"
    ],
    "type": "object"
   },
   "pay_online_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Prefilled cart for browser payment when the platform has no payment token"
   },
   "status": {
    "enum": [
     "not_ready_for_payment",
     "ready_for_payment",
     "in_progress",
     "completed",
     "canceled"
    ],
    "type": "string"
   },
   "totals": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": "number"
      },
      "display_text": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "display_text",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "status",
   "currency",
   "line_items",
   "totals",
   "messages",
   "fulfillment_options",
   "links"
  ],
  "type": "object"
 },
 "title": "Create a checkout session"
}
