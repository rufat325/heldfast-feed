{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "JSON Schema for one name from list_schemas. Use quote for a line, not the word line. server includes the version. A tool name returns that tool's inputSchema and outputSchema",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "A name from list_schemas: server, quote, source, settings, or a tool name.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_schema",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "inputSchema": {},
   "kind": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "outputSchema": {},
   "schema": {},
   "title": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "name",
   "kind",
   "title",
   "description",
   "next"
  ],
  "type": "object"
 },
 "title": "Get a schema"
}
