{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Answer a question using ONLY the papers you've saved \u2014 a synthesis over your library (or one collection) with inline [arXiv-ID] citations. The inverse of find_gaps (which finds important work you're MISSING): ask_library reasons over what you HAVE. Optionally scope to one collection (collection_name OR collection_id); omit both to use your whole library. Read-only. Requires SF_API_KEY (it reads your saved set). Free accounts get 1 question/month; Pro raises this to 200/day.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collection_id": {
    "description": "Scope the answer to one collection by UUID. Omit to use your whole library.",
    "type": "string"
   },
   "collection_name": {
    "description": "Scope the answer to one collection by name (resolved by the backend). Omit to use your whole library.",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 8,
    "description": "How many of your most-relevant saved papers to ground the answer on (max 20). Default 8.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "question": {
    "description": "The natural-language question to answer from your saved papers.",
    "maxLength": 500,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask_library",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "answer": {
    "description": "The synthesized answer with inline [arXiv-ID] citations.",
    "type": "string"
   },
   "citations": {
    "items": {},
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "papers": {
    "items": {
     "additionalProperties": {},
     "description": "A paper record. Verbose calls add extraction fields (method_name, datasets, baselines, ...).",
     "properties": {
      "arxiv_id": {
       "type": "string"
      },
      "arxiv_url": {
       "type": "string"
      },
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "citation_count": {
       "type": "number"
      },
      "collections": {
       "description": "Collections this saved paper is filed under, e.g. 'AgentOPA/G4' (list_library only).",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "github_stars": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "github_url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "has_code": {
       "type": "boolean"
      },
      "impact_pct": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "institution_tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "is_read": {
       "type": "boolean"
      },
      "is_saved": {
       "type": "boolean"
      },
      "llm_novelty_score": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "llm_significance": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "llm_summary": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "n_authors": {
       "type": "number"
      },
      "note_text": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "The user's own recorded verdict on this paper, when one exists. A hit carrying this was ALREADY judged \u2014 read it instead of re-deriving a verdict from the abstract."
      },
      "pdf_url": {
       "type": "string"
      },
      "primary_category": {
       "type": "string"
      },
      "published_date": {
       "type": "string"
      },
      "rank_score": {
       "type": "number"
      },
      "similarity": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "venue_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "year": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Ask Library"
}
