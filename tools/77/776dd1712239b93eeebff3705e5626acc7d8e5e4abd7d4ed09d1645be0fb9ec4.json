{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Previews deleting one explicitly selected Note Type. Refuses if any Note uses the type, even without Cards, or if it is the last Note Type. Requires the reviewed impact hash and explicit confirmation to apply. Requires AnkiConnect v1.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"confirmDeletion":{"default":false,"type":"boolean"},"dryRun":{"default":true,"description":"Preview without modifying Anki","type":"boolean"},"expectedImpactHash":{"description":"Hash from the reviewed deletion preview","pattern":"^[a-f0-9]{64}$","type":"string"},"noteTypeId":{"description":"Explicit stable ID from list-note-types","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["noteTypeId"],"type":"object"},"name":"delete-unused-note-type","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"applied":{"type":"boolean"},"blockers":{"items":{"type":"string"},"type":"array"},"dryRun":{"type":"boolean"},"hasNotes":{"description":"Whether any Note uses this type; null if the type could not be inspected.","type":["boolean","null"]},"impactHash":{"anyOf":[{"pattern":"^[a-f0-9]{64}$","type":"string"},{"type":"null"}]},"noteType":{"anyOf":[{"additionalProperties":false,"properties":{"id":{"description":"Anki note type/model ID","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"kind":{"enum":["normal","cloze"],"type":"string"},"name":{"description":"Anki note type/model name","type":"string"}},"required":["id","name","kind"],"type":"object"},{"type":"null"}]},"noteTypeId":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"verified":{"type":"boolean"},"warnings":{"items":{"type":"string"},"type":"array"}},"required":["noteTypeId","noteType","hasNotes","dryRun","applied","verified","impactHash","blockers","warnings