{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find Local Businesses"
 },
 "description": "Find local businesses of a kind in a city, as listed on Google Maps: name, address, phone number, website, star rating and number of reviews. Use it to build a lead list, find competitors, or look up a business's contact details. Price: $0.03 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "description": "How many businesses, default 10, max 20.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "City and state, e.g. \"Houston, TX\". Required unless the connection sets a default location.",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "query": {
    "description": "Type of business or name, e.g. \"plumbers\" or \"taco truck\".",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "business_listings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "location": {
    "description": "Location searched.",
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "phone": {
       "type": [
        "string",
        "null"
       ]
      },
      "place_id": {
       "description": "Google place_id; pass it to the reviews tool.",
       "type": [
        "string",
        "null"
       ]
      },
      "rating": {
       "description": "Google star rating, 1 to 5.",
       "type": [
        "number",
        "null"
       ]
      },
      "review_count": {
       "type": [
        "number",
        "null"
       ]
      },
      "website": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "address",
      "phone",
      "website",
      "rating",
      "review_count",
      "place_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "location",
   "results",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Find Local Businesses"
}
