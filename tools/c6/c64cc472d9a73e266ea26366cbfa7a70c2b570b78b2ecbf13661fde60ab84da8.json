{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List invoices in Billy with filters for customer, state, date range and free-text search. Returns invoices plus meta.paging.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contactId": {
    "description": "Filter by customer contact ID",
    "type": "string"
   },
   "invoiceNo": {
    "description": "Filter by exact invoice number",
    "type": "string"
   },
   "isPaid": {
    "description": "Filter by paid status",
    "type": "boolean"
   },
   "maxEntryDate": {
    "description": "Invoice date <= this (YYYY-MM-DD)",
    "type": "string"
   },
   "minEntryDate": {
    "description": "Invoice date >= this (YYYY-MM-DD)",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Records per page (max 1000, default 50)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Free-text search",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "sortProperty": {
    "description": "Sort field, e.g. 'entryDate', 'createdTime'",
    "type": "string"
   },
   "state": {
    "description": "Filter by invoice state",
    "enum": [
     "draft",
     "approved",
     "voided"
    ],
    "type": "string"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_invoices"
}
