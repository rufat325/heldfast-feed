{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Sync catalog changes"
 },
 "description": "State synchronization for a mirror built from network_snapshot: pass the sync_cursor and receive upserts (current rows in the same view) and tombstones since that position, with has_more and next_cursor. Bounded eventual consistency: take a fresh snapshot at least every 24 hours and whenever resync_required is true. Example: {\"cursor\": \"<sync_cursor from network_snapshot>\"}. Pass country=CA for Canadian dealers.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "default": "US",
    "description": "Market to search; rooftops in the other country are excluded. Prices are in that country's currency; the radius stays in miles.",
    "enum": [
     "US",
     "CA"
    ],
    "type": "string"
   },
   "cursor": {
    "maxLength": 2048,
    "minLength": 8,
    "type": "string"
   },
   "rooftop_slug": {
    "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?$",
    "type": "string"
   },
   "view": {
    "enum": [
     "manifest",
     "summary",
     "full"
    ]
   }
  },
  "required": [
   "cursor"
  ],
  "type": "object"
 },
