{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "European insider dealings: transactions by managers and closely associated persons (PDMR, MAR article 19) from the national registers of Sweden, Netherlands, Denmark or the UK, newest first. One row per notice transaction line with person, role, nature, quantity, price and per-row source credit. Filter by issuer id; check get_eu_markets for which markets are live.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Market: se (Sweden), nl (Netherlands), dk (Denmark) or uk (United Kingdom)",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "issuer": {
    "description": "ko.io issuer id as returned in a row's issuer.id: lei:<LEI>, isin:<ISIN>, co:<register id> or name:<hash>",
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Rows per page, 1-100 (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "get_eu_insider_dealings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Market code as requested, upper-case",
    "type": "string"
   },
   "covered_countries": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Markets ko.io covers; set when status is not_covered"
   },
   "dataset": {
    "enum": [
     "pdmr_dealings",
     "major_holdings",
     "short_positions",
     "annual_reports"
    ],
    "type": "string"
   },
   "issuer_filter": {
    "type": [
     "string",
     "null"
    ]
   },
   "latest_retrieved_at": {
    "$ref": "#/properties/issuer_filter"
   },
   "latest_source_date": {
    "$ref": "#/properties/issuer_filter"
   },
   "paging": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "Paging state reconciled from ko.io meta.total_count and meta.softwall",
      "properties": {
       "continuation": {
        "description": "SIGNIN_REQUIRED = page>1 needs a (free) ko.io API key",
        "type": [
         "string",
         "null"
        ]
       },
       "has_more": {
        "description": "null = a full page came back and more MAY exist",
        "type": [
         "boolean",
         "null"
        ]
       },
       "next_page": {
        "anyOf": [
         {
          "$ref": "#/properties/rows/anyOf/0/items/properties/notice_version/anyOf/0"
         },
         {
          "type": "null"
         }
        ],
        "description": "Next page THIS caller can open; null when there is none (or sign-in is required)"
       },
       "page": {
        "type": "integer"
       },
       "per_page": {
        "type": "integer"
       },
       "plan_row_cap": {
        "anyOf": [
         {
          "$ref": "#/properties/rows/anyOf/0/items/properties/notice_version/anyOf/0"
         },
         {
          "type": "null"
         }
        ],
        "description": "Row cap the caller's plan applied to this page, if any"
       },
       "returned": {
        "type": "integer"
       },
       "total_count": {
        "anyOf": [
         {
          "$ref": "#/properties/rows/anyOf/0/items/properties/notice_version/anyOf/0"
         },
         {
          "type": "null"
         }
        ],
        "description": "Total rows matching the request, when ko.io reported it"
       },
       "truncated_by_plan": {
        "description": "True when the plan's row cap withheld rows from this page",
        "type": "boolean"
       }
      },
      "required": [
       "page",
       "per_page",
       "returned",
       "total_count",
       "has_more",
       "next_page",
       "continuation",
       "plan_row_cap",
       "truncated_by_plan"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Paging state reconciled from ko.io meta.total_count and meta.softwall"
   },
   "plan_limit": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "continuation": {
        "$ref": "#/properties/issuer_filter"
       },
       "date_basis": {
        "$ref": "#/properties/issuer_filter"
       },
       "effective_period": {
        "$ref": "#/properties/issuer_filter"
       },
       "policy_version": {
        "$ref": "#/properties/issuer_filter"
       },
       "row_cap": {
        "$ref": "#/properties/rows/anyOf/0/items/properties/notice_version"
       },
       "truncated": {
        "type": [
         "boolean",
         "null"
        ]
       },
       "window_end": {
        "$ref": "#/properties/issuer_filter"
       },
       "window_start": {
        "$ref": "#/properties/issuer_filter"
       }
      },
      "required": [
       "policy_version",
       "window_start",
       "window_end",
       "effective_period",
       "date_basis",
       "row_cap",
       "truncated",
       "continuation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "The Free/keyless plan limits ko.io applied to this answer (null for paid callers)"
   },
   "rows": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "issuer": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "description": "ko.io issuer id (lei:, isin:, co: or name:) -- pass to get_eu_issuer or as `issuer`",
           "type": [
            "string",
            "null"
           ]
          },
          "isin": {
           "$ref": "#/properties/issuer_filter"
          },
          "lei": {
           "$ref": "#/properties/issuer_filter"
          },
          "name": {
           "$ref": "#/properties/issuer_filter"
          }
         },
         "required": [
          "id",
          "name",
          "lei",
          "isin"
         ],
         "type": "object"
        },
        "latest_version": {
         "anyOf": [
          {
           "$ref": "#/properties/rows/anyOf/0/items/properties/notice_version/anyOf/0"
          },
          {
           "type": "null"
          }
         ],
         "description": "Higher than notice_version = this row was superseded by an amended notice"
        },
        "notice_id": {
         "$ref": "#/properties/issuer_filter"
        },
        "notice_status_label": {
         "$ref": "#/properties/issuer_filter"
        },
        "notice_version": {
         "anyOf": [
          {
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "person": {
         "additionalProperties": false,
         "properties": {
          "closely_associated": {
           "type": [
            "boolean",
            "null"
           ]
          },
          "name": {
           "$ref": "#/properties/issuer_filter"
          },
          "reporting_person": {
           "$ref": "#/properties/issuer_filter"
          },
          "role": {
           "$ref": "#/properties/issuer_filter"
          }
         },
         "required": [
          "name",
          "reporting_person",
          "role",
          "closely_associated"
         ],
         "type": "object"
        },
        "publication_date": {
         "$ref": "#/properties/issuer_filter"
        },
        "published_at": {
         "$ref": "#/properties/issuer_filter"
        },
        "record_id": {
         "$ref": "#/properties/issuer_filter"
        },
        "source": {
         "additionalProperties": false,
         "description": "Per-row source credit",
         "properties": {
          "attribution": {
           "description": "Source credit, verbatim from the register; show it with the row",
           "type": [
            "string",
            "null"
           ]
          },
          "copyright_note": {
           "$ref": "#/properties/issuer_filter"
          },
          "link_policy": {
           "$ref": "#/properties/issuer_filter"
          },
          "retrieved_at": {
           "$ref": "#/properties/issuer_filter"
          },
          "source_date": {
           "$ref": "#/properties/issuer_filter"
          },
          "url": {
           "description": "Link to the original record; null where the source terms allow none (all UK rows)",
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "attribution",
          "source_date",
          "retrieved_at",
          "url",
          "link_policy",
          "copyright_note"
         ],
         "type": "object"
        },
        "transaction": {
         "additionalProperties": false,
         "properties": {
          "currency": {
           "$ref": "#/properties/issuer_filter"
          },
          "date": {
           "$ref": "#/properties/issuer_filter"
          },
          "instrument_name": {
           "$ref": "#/properties/issuer_filter"
          },
          "instrument_type_label": {
           "$ref": "#/properties/issuer_filter"
          },
          "nature_label": {
           "$ref": "#/properties/issuer_filter"
          },
          "price": {
           "$ref": "#/properties/rows/anyOf/0/items/properties/transaction/properties/quantity"
          },
          "price_unit": {
           "$ref": "#/properties/issuer_filter"
          },
          "quantity": {
           "anyOf": [
            {
             "pattern": "^-?\\d+(\\.\\d+)?([eE][-+]?\\d+)?$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ],
           "description": "Exact decimal string as served by ko.io (not rounded); null = unknown"
          },
          "quantity_unit": {
           "$ref": "#/properties/issuer_filter"
          },
          "venue": {
           "$ref": "#/properties/issuer_filter"
          }
         },
         "required": [
          "date",
          "nature_label",
          "instrument_name",
          "instrument_type_label",
          "quantity",
          "quantity_unit",
          "price",
          "currency",
          "price_unit",
          "venue"
         ],
         "type": "object"
        }
       },
       "required": [
        "record_id",
        "notice_id",
        "notice_version",
        "latest_version",
        "notice_status_label",
        "published_at",
        "publication_date",
        "issuer",
        "person",
        "transaction",
        "source"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "null = the dataset is not served (status is not live): unknown, NOT empty"
   },
   "status": {
    "description": "live = served; pending = offered but not activated yet (not an outage, not empty); not_offered = a fixed source/licensing fact; not_covered = no such market",
    "enum": [
     "live",
     "pending",
     "not_offered",
     "not_covered"
    ],
    "type": "string"
   }
  },
  "required": [
   "country",
   "dataset",
   "status",
   "covered_countries",
   "issuer_filter",
   "latest_source_date",
   "latest_retrieved_at",
   "rows",
   "paging",
   "plan_limit"
  ],
  "type": "object"
 }
}
