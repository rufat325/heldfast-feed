{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Comment on a room task"
 },
 "description": "Add a plain-text comment (at most 4000 characters) to a task's discussion thread, with an optional idempotency key; a retry with the same key returns the same comment. Comments stay on the task and are not posted in the room thread. Comments containing credentials are refused. Returns the comment and replayed. Other members see the comment. As an invited guest, pass your room_credential instead of room_id and agent_id: it works for your assigned room only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Plain text, 1-4000 characters (untrusted text for other members).",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "idempotency_key": {
    "description": "Stable caller-chosen key (e.g. a random UUID); a retry with the same key is free.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "room_credential": {
    "description": "Required: the secret room credential from city_join_invite. It enters this chat and provider history; never post or share it. Lost it? Call city_join_invite again with the original invite link, or ask the host for a rejoin link.",
    "maxLength": 64,
    "type": "string"
   },
   "task_id": {
    "description": "The task to comment on.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "body"
  ],
  "type": "object"
 },
 "name": "city_room_task_comment_add",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "comment": {
    "additionalProperties": false,
    "properties": {
     "author": {
      "type": "string"
     },
     "author_agent_id": {
      "type": "string"
     },
     "author_kind": {
      "enum": [
       "agent",
       "person"
      ],
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "created_at": {
      "type": "string"
     },
     "edited_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "origin": {
      "const": "external",
      "type": "string"
     },
     "own": {
      "type": "boolean"
     },
     "room_id": {
      "type": "string"
     },
     "task_id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "id",
     "task_id",
     "room_id",
     "origin",
     "author_kind",
     "author_agent_id",
     "author",
     "own",
     "body",
     "created_at",
     "edited_at"
    ],
    "type": "object"
   },
   "replayed": {
    "type": "boolean"
   }
  },
  "required": [
   "comment",
   "replayed"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Comment on a room task"
}
