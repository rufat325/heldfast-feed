{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the account's task runs, newest first \u2014 delegated jobs and scheduled tasks alike. Filter by status or task.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ending_before": {
    "description": "Return the page before this id \u2014 the first id from the previous page.",
    "type": "string"
   },
   "limit": {
    "description": "Default 20.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "starting_after": {
    "description": "Return the page after this id \u2014 the last id from the previous page.",
    "type": "string"
   },
   "status": {
    "description": "Only runs in this state.",
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "needs_input",
     "timed_out",
     "unknown",
     "skipped"
    ],
    "type": "string"
   },
   "task_id": {
    "description": "Only runs of this task (task_...).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_runs",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A page of task runs, newest first.",
  "properties": {
   "data": {
    "items": {
     "description": "A task run \u2014 one delegated job and what is known about its state.",
     "properties": {
      "chat_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "completed_at": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "created_at": {
       "format": "date-time",
       "type": "string"
      },
      "credits_consumed": {
       "type": "integer"
      },
      "error_message": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "next_step": {
       "type": "string"
      },
      "object": {
       "const": "task_run",
       "type": "string"
      },
      "pending_approval_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "result": {
       "type": [
        "string",
        "null"
       ]
      },
      "reused": {
       "type": "boolean"
      },
      "started_at": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "enum": [
        "pending",
        "running",
        "completed",
        "failed",
        "needs_input",
        "timed_out",
        "unknown",
        "skipped"
       ],
       "type": "string"
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      },
      "task_id": {
       "type": "string"
      },
      "task_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "wait_timed_out": {
       "description": "The wait ended first. The work is still running: follow it with the tool next_step names.",
       "type": "boolean"
      }
     },
     "required": [
      "object",
      "id",
      "task_id",
      "status",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "has_more": {
    "type": "boolean"
   },
   "object": {
    "const": "list",
    "type": "string"
   }
  },
  "required": [
   "object",
   "data",
   "has_more"
  ],
  "type": "object"
 }
}
