{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "project_todos:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Confirmed selective send-back (action coaching_send_back_confirm): the canonical RETURN of ONLY the requested questions, publishing the reviewed draft batch with one aggregated worker notification. Requires the planToken minted by opentrain_quiz_coaching_send_back_plan; the send-back transaction recomputes the digests and fails closed as 409 PLAN_STALE on any drift. Requires project_todos:write and a caller-supplied stable idempotencyKey (registry op project_todos.quizzes.coaching.manage). The response echoes its action discriminator and receipt fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "minLength": 1,
    "type": "string"
   },
   "expectedSubmittedAt": {
    "format": "date-time",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "planToken": {
    "maxLength": 8192,
    "minLength": 16,
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "reviewCycleId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "reviewCycleId",
   "reason",
   "expectedSubmittedAt",
   "planToken",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_quiz_coaching_send_back_confirm",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "const": "coaching_send_back_confirm",
      "type": "string"
     },
     "assignmentId": {
      "type": "string"
     },
     "assignmentStatus": {
      "anyOf": [
       {
        "enum": [
         "OPEN",
         "IN_PROGRESS",
         "SUBMITTED",
         "COMPLETED",
         "RETURNED",
         "WAIVED",
         "CLOSED",
         "SUPERSEDED"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "cycle": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "closedAt": {
          "type": [
           "string",
           "null"
          ]
         },
         "closedReason": {
          "anyOf": [
           {
            "enum": [
             "ACCEPTED",
             "GRADED",
             "SUPERSEDED",
             "CANCELLED"
            ],
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "cycleNumber": {
          "type": "integer"
         },
         "reason": {
          "type": [
           "string",
           "null"
          ]
         },
         "requestedQuestionIds": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "reviewCycleId": {
          "type": "string"
         },
         "sentAt": {
          "type": [
           "string",
           "null"
          ]
         },
         "sourceAttemptId": {
          "type": "string"
         },
         "status": {
          "enum": [
           "DRAFT",
           "OPEN",
           "RESUBMITTED",
           "CLOSED"
          ],
          "type": "string"
         }
        },
        "required": [
         "reviewCycleId",
         "cycleNumber",
         "status",
         "sourceAttemptId",
         "requestedQuestionIds",
         "reason",
         "sentAt",
         "closedAt",
         "closedReason"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "replayed": {
      "type": "boolean"
     },
     "waitingOnRole": {
      "anyOf": [
       {
        "enum": [
         "WORKER",
         "EMPLOYER",
         "NONE"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "action",
     "assignmentId",
     "assignmentStatus",
     "waitingOnRole",
