{"description":"Create a feature flag in an application. It starts off in every environment; use set_flag to turn it on. The key is what code checks, like new-checkout.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"applicationId":{"pattern":"^[1-9]\\d*$","type":"string"},"description":{"anyOf":[{"maxLength":2000,"type":"string"},{"type":"null"}]},"key":{"maxLength":100,"minLength":1,"pattern":"^[a-z0-9]+(?:[-_][a-z0-9]+)*$","type":"string"},"name":{"maxLength":100,"minLength":1,"type":"string"}},"required":["applicationId","name","key","description"],"type":"object"},"name":"create_flag","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"flag":{"properties":{"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"environments":{"additionalProperties":{"properties":{"enabled":{"type":"boolean"},"rolloutPercent":{"type":"number"}},"required":["enabled","rolloutPercent"],"type":"object"},"propertyNames":{"type":"string"},"type":"object"},"id":{"type":"string"},"key":{"type":"string"},"name":{"type":"string"}},"required":["id","key","name","description","environments"],"type":"object"}},"required":["flag"],"type":"object"},"title":"Create a flag"}
