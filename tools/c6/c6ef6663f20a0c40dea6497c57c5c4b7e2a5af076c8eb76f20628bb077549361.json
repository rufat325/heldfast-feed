{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "SPF check"
 },
 "description": "Fetches a domain's SPF record and evaluates it: raw record, parsed terms with qualifiers, DNS lookups counted against the RFC 7208 limit of ten, the final `all` qualifier, and warnings for common silent failures. A domain without a record returns found=false. Alignment and reporting belong to dmarc_check, signing keys to dkim_check. Anonymous, rate-limited per IP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Domain name, e.g. deinkunde.com",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "spf_check",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "all": {
    "type": [
     "string",
     "null"
    ]
   },
   "domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "found": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "lookups": {
    "type": [
     "number",
     "null"
    ]
   },
   "ok": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "record": {
    "type": [
     "string",
     "null"
    ]
   },
   "terms": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {
        "qualifier": {
         "type": [
          "string",
          "null"
         ]
        },
        "term": {
         "type": [
          "string",
          "null"
         ]
        },
        "type": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "warnings": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "SPF check"
}
