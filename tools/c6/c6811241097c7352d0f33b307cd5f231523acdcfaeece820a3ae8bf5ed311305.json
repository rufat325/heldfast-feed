{"annotations":{"openWorldHint":false,"readOnlyHint":true},"description":"List free appointment start times for one service of a business, per day in the business timezone, with ISO 8601 start/end (including UTC offset) and the team members who can take each slot. Holidays, vacations, working hours and buffers are already applied. Ranges are capped to 14 days. service.questions lists booking questions to ask the user (pass answers to create_booking). Never invent slots: only book times returned here. Flow: search_businesses -> get_available_slots -> confirm service, date, time, team member, name and e-mail with the user -> create_booking. Bookings are only requests until the customer clicks the confirmation link e-mailed to them.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"dateFrom":{"description":"First day (YYYY-MM-DD, business timezone). Defaults to today.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"dateTo":{"description":"Last day, inclusive. Defaults to dateFrom + 6 days; ranges are capped to 14 days.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"serviceId":{"description":"Service id from search_businesses.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"slug":{"description":"Business slug from search_businesses.","maxLength":120,"minLength":1,"type":"string"},"teamMemberId":{"description":"Only slots of this team member.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["slug","serviceId"],"type":"object"},"name":"get_available_slots","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"business":{"additionalProperties":false,"properties":{"name":{"type":"string"},"profileUrl":{"type":"string"},"slug":{"type":"string"},"timezone":{"type":"string"}},"required":["slug","name","timezone","profileUrl"],"type":"object"},"days":{"items":{"additionalProperties":false,"properties":{"date":{"type":"string"},"slots":{"items":{"additionalProperties":false,"properties":{"end":{"type":"string"},"start":{"type":"string"},"teamMembers":{"items":{"additionalProperties":false,"properties":{"id":{"type":"number"},"name":{"type":"string"}},"required":["id","name"],"type":"object"},"type":"array"},"time":{"type":"string"}},"required":["time","start","end","teamMembers"],"type":"object"},"type":"array"}},"required":["date","slots"],"type":"object"},"type":"array"},"range":{"additionalProperties":false,"properties":{"from":{"type":"string"},"to":{"type":"string"},"truncated":{"type":"boolean"}},"required":["from","to","truncated"],"type":"object"},"service":{"additionalProperties":false,"properties":{"durationMin":{"type":"number"},"id":{"type":"number"},"name":{"type":"string"},"priceCents":{"type":"number"},"questions":{"items":{"additionalProperties":false,"properties":{"id":{"type":"number"},"label":{"type":"string"},"options":{"items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"value":{"type":"string"}},"required":["value","label"],"type":"object"},"type":"array"},"required":{"type":"boolean"},"type":{"type":"string"}},"required":["id","label","type","required","options"],"type":"object"},"type":"array"}},"required":["id","name","durationMin","priceCents","questions"],"type":"object"},"teamMembers":{"items":{"additionalProperties":false,"properties":{"id":{"type":"number"},"name":{"type":"string"},"role":{"type":"string"}},"required":["id","name","role"],"type":"object"},"type":"array"}},"required":["business","service","teamMembers","range","days"],"type":"object"},"title":"Get available appointment slots"}
