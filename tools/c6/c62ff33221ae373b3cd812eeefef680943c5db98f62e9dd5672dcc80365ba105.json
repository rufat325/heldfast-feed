{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for facts by tags, content query, verification status, or source type. Use this on every prompt to validate context before responding - not just at session start.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque cursor for pagination",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "orderBy": {
    "default": "recent",
    "enum": [
     "recent",
     "oldest",
     "usage"
    ],
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "sourceType": {
    "enum": [
     "user",
     "documentation",
     "code",
     "inference"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "verifiedOnly": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_facts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "facts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "id": {
       "type": "number"
      },
      "sourceType": {
       "type": [
        "string",
        "null"
       ]
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "updatedAt": {
       "type": "string"
      },
      "verified": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "content",
      "tags",
      "verified",
      "sourceType",
      "updatedAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "description": "Opaque cursor for next page, absent if no more results",
    "type": "string"
   },
   "suggestedTags": {
    "description": "Popular tags to explore when search returns empty results",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "facts"
  ],
  "type": "object"
 },
 "title": "Search Facts"
}
