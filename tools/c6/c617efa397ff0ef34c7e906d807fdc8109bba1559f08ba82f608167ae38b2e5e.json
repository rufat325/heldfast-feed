{
 "_meta": {
  "openai/outputTemplate": "ui://careclinic/tracker-card-v2.html",
  "openai/toolInvocation/invoked": "Recent activity ready",
  "openai/toolInvocation/invoking": "Loading recent CareClinic activity\u2026",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "careclinic.wellness.read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://careclinic/tracker-card-v2.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://careclinic/tracker-card-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns minimized symptom, mood, and medication activity. Notes and internal record IDs are excluded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "days": {
    "default": 30,
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "include": {
    "default": [
     "symptom",
     "mood",
     "medication"
    ],
    "items": {
     "enum": [
      "symptom",
      "mood",
      "medication"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "careclinic_recent_wellness",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "const": "wellness_snapshot",
    "type": "string"
   },
   "snapshot": {
    "additionalProperties": false,
    "properties": {
     "from": {
      "type": "string"
     },
     "medications": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "action": {
         "enum": [
          "taken",
          "skipped"
         ],
         "type": "string"
        },
        "dose": {
         "type": "string"
        },
        "medicationName": {
         "type": "string"
        },
        "occurredAt": {
         "type": "string"
        }
       },
       "required": [
        "medicationName",
        "action",
        "occurredAt"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "moods": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "energy": {
         "type": "number"
        },
        "label": {
         "type": "string"
        },
        "occurredAt": {
         "type": "string"
        },
        "valence": {
         "type": "number"
        }
       },
       "required": [
        "valence",
        "occurredAt"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "symptoms": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "durationMinutes": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "occurredAt": {
         "type": "string"
        },
        "severity": {
         "type": "number"
        }
       },
       "required": [
        "name",
        "severity",
        "occurredAt"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "from",
     "to",
     "symptoms",
     "moods",
     "medications"
    ],
    "type": "object"
   }
  },
  "required": [
   "kind",
   "snapshot"
  ],
  "type": "object"
 },
 "title": "Get recent CareClinic wellness logs"
}
