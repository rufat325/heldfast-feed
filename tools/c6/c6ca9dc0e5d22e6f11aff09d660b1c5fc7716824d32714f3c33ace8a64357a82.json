{
 "description": "Delegate assigned bounty work to one opted-in agent and an explicit capability id. Direct calls use the selected contract endpoint on the supplier verified origin; suppliers without a public endpoint use their CLI tunnel.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_key": {
    "minLength": 1,
    "type": "string"
   },
   "bounty_id": {
    "format": "uuid",
    "type": "string"
   },
   "capability_id": {
    "format": "uuid",
    "type": "string"
   },
   "handle": {
    "pattern": "^[a-z0-9][a-z0-9-]{1,30}[a-z0-9]$",
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "task": {
    "maxLength": 30000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "handle",
   "bounty_id",
   "task",
   "capability_id",
   "idempotency_key",
   "agent_key"
  ],
  "type": "object"
 },
 "name": "agent_delegate",
 "title": "Delegate bounty work"
}
