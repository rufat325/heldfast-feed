{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Split utilities"
 },
 "description": "Split utility and household bills across housemates, each bill equally, by occupants, or by usage weight, and total what each person owes. Use for recurring shared bills such as electricity, gas or internet. Do NOT use for rent (use split_rent) or to settle who already paid (use settle_up).",
 "inputSchema": {
  "properties": {
   "bills": {
    "description": "Bills to split (names must be unique), e.g. [{\"name\":\"Electricity\",\"amount\":120,\"split\":\"by_usage\"}]",
    "items": {
     "properties": {
      "amount": {
       "description": "Bill total, positive number, e.g. 120",
       "type": "number"
      },
      "name": {
       "description": "Unique bill label, e.g. 'Electricity'",
       "type": "string"
      },
      "split": {
       "description": "'equal' per person, 'by_occupants' weighted by each person's occupants, or 'by_usage' weighted by usage_weight (required on everyone)",
       "enum": [
        "equal",
        "by_occupants",
        "by_usage"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount",
      "split"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "people": {
    "description": "Housemates sharing the bills (names must be unique), e.g. [{\"name\":\"Asha\",\"usage_weight\":2},{\"name\":\"Dev\",\"usage_weight\":1}]",
    "items": {
     "properties": {
      "name": {
       "description": "Unique housemate name",
       "type": "string"
      },
      "occupants": {
       "description": "How many people this housemate pays for (by_occupants bills), positive, default 1",
       "type": "number"
      },
      "usage_weight": {
       "description": "Relative usage for by_usage bills, positive, e.g. 2 for double use, 0.5 for a light user",
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "bills",
   "people"
  ],
  "type": "object"
 },
 "name": "split_utilities",
 "outputSchema": {
  "properties": {
   "bills": {
    "description": "Each bill with its per-person shares (shares sum to the bill amount)",
    "items": {
     "properties": {
      "amount": {
       "description": "Bill total, rounded to cents",
       "type": "number"
      },
      "name": {
       "description": "Bill label",
       "type": "string"
      },
      "shares": {
       "description": "Each person's share of this bill",
       "items": {
        "properties": {
         "amount": {
          "description": "Amount, rounded to cents",
          "type": "number"
         },
         "name": {
          "description": "Person's name",
          "type": "string"
         }
        },
        "required": [
         "name",
         "amount"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "split": {
       "description": "Split rule applied",
       "enum": [
        "equal",
        "by_occupants",
        "by_usage"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount",
      "split",
      "shares"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "grand_total": {
    "description": "Sum of all bill amounts",
    "type": "number"
   },
   "note": {
    "description": "Plain-language explanation of the totals",
    "type": "string"
   },
   "totals": {
    "description": "Total each person owes across all bills",
    "items": {
     "properties": {
      "amount": {
       "description": "Amount, rounded to cents",
       "type": "number"
      },
      "name": {
       "description": "Person's name",
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "bills",
   "totals",
   "grand_total",
   "note"
  ],
  "type": "object"
 },
 "title": "Split utilities"
}
