        "minimum": 0,
        "type": "integer"
       },
       "scripts_observed": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "source_artifacts": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "bytes": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "charset": {
           "const": "utf-8",
           "type": "string"
          },
          "media_type": {
           "maxLength": 256,
           "minLength": 1,
           "type": "string"
          },
          "sha256": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "text_available": {
           "const": true,
           "type": "boolean"
          },
          "uri": {
           "pattern": "^rea:\\/\\/web-content\\/sha256\\/[a-f0-9]{64}$",
           "type": "string"
          }
         },
         "required": [
          "uri",
          "sha256",
          "bytes",
          "media_type",
          "charset",
          "text_available"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "target_url": {
        "type": "string"
       }
      },
      "required": [
