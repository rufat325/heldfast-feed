{
 "description": "Create a purchase intent for bots or human operators buying for bots.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_cents": {
    "minimum": 0,
    "type": "integer"
   },
   "buyer_ref": {
    "default": "",
    "type": "string"
   },
   "buyer_type": {
    "default": "bot",
    "type": "string"
   },
   "currency": {
    "default": "usd",
    "type": "string"
   },
   "idempotency_key": {
    "default": "",
    "type": "string"
   },
   "preferred_rail": {
    "default": "card",
    "type": "string"
   },
   "product_id": {
    "default": "memory-api-hosted",
    "type": "string"
   },
   "quantity": {
    "default": 1,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "tier": {
    "default": "solo",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_purchase_intent"
}
