{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Season plan"
 },
 "description": "Size a season end-to-end: total fixtures from the round-robin, games per match day given the courts available, match days needed, and the calendar dates from a start date to the estimated finish date.",
 "inputSchema": {
  "properties": {
   "courts": {
    "description": "Courts available per match day (1-12)",
    "type": "number"
   },
   "days_between_rounds": {
    "description": "Days between match days, default 7",
    "type": "number"
   },
   "second_leg": {
    "description": "Plan a double round-robin (each pair meets twice)",
    "type": "boolean"
   },
   "slot_minutes": {
    "description": "Minutes per time slot (10-180)",
    "type": "number"
   },
   "start_date": {
    "description": "First match day, YYYY-MM-DD",
    "type": "string"
   },
   "teams": {
    "description": "Team names (2 or more, unique)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "teams",
   "courts",
   "slot_minutes",
   "start_date"
  ],
  "type": "object"
 },
 "name": "season_plan"
}
