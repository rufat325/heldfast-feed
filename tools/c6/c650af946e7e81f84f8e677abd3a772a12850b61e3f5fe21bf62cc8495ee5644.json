{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "One Hyperliquid wallet's stats over a window: volume, realized PnL, fill count, win rate, maker share and markets traded.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   },
   "from": {
    "description": "Unix ms window start (default 24h ago)",
    "type": "number"
   },
   "to": {
    "description": "Unix ms window end (default now)",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_user_summary",
 "outputSchema": {
  "description": "One wallet over a window",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "state": {
    "description": "Open positions right now",
    "properties": {
     "address": {
      "description": "Wallet address (0x\u2026)"
     },
     "as_of_ts": {
      "description": "Snapshot time, Unix milliseconds"
     },
     "asset_positions": {
      "description": "Open positions",
      "items": {
       "description": "Open position",
       "properties": {
        "entry_price": {
         "description": "Average entry price"
        },
        "leverage": {
         "description": "Leverage"
        },
        "leverage_type": {
         "description": "cross or isolated"
        },
        "mark_price": {
         "description": "Current mark price"
        },
        "market": {
         "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
        },
        "market_class": {
         "description": "perp, spot, prediction or option"
        },
        "position_value": {
         "description": "Position value in USD"
        },
        "realized_pnl": {
         "description": "Realized PnL in USD"
        },
        "return_on_equity": {
         "description": "Unrealized PnL divided by margin"
        },
        "size": {
         "description": "Signed size: positive long, negative short"
        },
        "unrealized_pnl": {
         "description": "Unrealized PnL in USD"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "margin_summary": {
      "description": "Account totals",
      "properties": {
       "open_markets_count": {
        "description": "Markets with an open position"
       },
       "total_position_value": {
        "description": "Sum of position values in USD"
       },
       "total_realized_pnl": {
        "description": "Sum of realized PnL in USD"
       },
       "total_unrealized_pnl": {
        "description": "Sum of unrealized PnL in USD"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   },
   "window": {
    "description": "Window totals",
    "properties": {
     "fees": {
      "description": "Fees in USD"
     },
     "fill_count": {
      "description": "Fills"
     },
     "losses": {
      "description": "Losing closing fills"
     },
     "maker_fills": {
      "description": "Fills as maker"
     },
     "maker_notional": {
      "description": "Maker notional in USD"
     },
     "pct_maker": {
      "description": "Share of fills as maker, 0 to 1"
     },
     "realized_pnl": {
      "description": "Realized PnL in USD"
     },
     "taker_fills": {
      "description": "Fills as taker"
     },
     "taker_notional": {
      "description": "Taker notional in USD"
     },
     "volume_usd": {
      "description": "Traded notional in USD"
     },
     "win_rate": {
      "description": "Share of closed trades that were profitable, 0 to 1"
     },
     "wins": {
      "description": "Profitable closing fills"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
