{
 "description": "Create a checklist definition with its COMPLETE draft (title + required + tree) in one atomic, receipt-backed call. Requires job_checklists:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key. Same key + same payload replays the stored receipt; same key + changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "required": {
    "type": "boolean"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "tree": {
    "description": "Adaptive v2 checklist tree (see job_checklists capabilities for limits).",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "maxItems": 300,
    "type": "array"
   }
  },
  "required": [
   "jobId",
   "title",
   "required",
   "tree",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_checklists_create",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
