{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Read recent output from a background session (e.g., tail -f logs).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lines": {
    "default": 50,
    "description": "Number of recent lines to read",
    "type": "number"
   },
   "name": {
    "description": "Background session name",
    "type": "string"
   },
   "profile": {
    "description": "Profile name",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "read-session-output"
}
