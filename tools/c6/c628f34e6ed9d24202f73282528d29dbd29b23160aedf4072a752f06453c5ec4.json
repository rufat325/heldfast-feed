{
 "description": "Telegram call-channel callers (Solana and Robinhood Chain calls) ranked by what happened after their own posts, traded or not: per caller n, hit15 (reached +15% within 60 min), win35 (+35% before -20%), x2, rug rate (-80% within 60 min) and median 1/5/15/60-minute returns and max moves, each shrunk toward the pooled value so a few lucky calls do not top the board. Callers are sha1 hashes; chats are named only when they are public channels/groups. Windows 24h, 7d, 30d. Rebuilt hourly; refused (503, not charged) if older than 3 h. Costs $0.05 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max rows, 1-200 (default 50)",
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "sort": {
    "description": "Ranking field (default win35)",
    "enum": [
     "win35",
     "x2",
     "hit15",
     "rug",
     "n",
     "ret15"
    ],
    "type": "string"
   },
   "window": {
    "description": "Scoring window (default 7d)",
    "enum": [
     "24h",
     "7d",
     "30d"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sol_callers_leaderboard",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "callers": {
    "type": "number"
   },
   "calls": {
    "type": "number"
   },
   "chain": {
    "type": "string"
   },
   "generatedAt": {
    "type": "number"
   },
   "method": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "pooled": {
    "$ref": "#/properties/method"
   },
   "rows": {
    "items": {
     "$ref": "#/properties/method"
    },
    "type": "array"
   },
   "schemaVersion": {
    "type": "number"
   },
   "sort": {
    "type": "string"
   },
   "window": {
    "type": "string"
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "window",
   "sort",
   "calls",
   "callers",
   "pooled",
   "rows"
  ],
  "type": "object"
 }
}
