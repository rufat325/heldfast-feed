{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search Tempo worklogs using a POST body with advanced filters (author ids, issue ids, project ids, date range). For team or Tempo-account filters use tempo_get_worklogs_by_team / tempo_get_worklogs_by_account.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "authorIds": {
    "description": "Atlassian account ids of worklog authors",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "from": {
    "description": "Start date (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "issueIds": {
    "description": "Jira issue ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results (default 50)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "orderBy": {
    "description": "Sort criteria (default START_DATE_TIME ASC, ID ASC)",
    "items": {
     "properties": {
      "field": {
       "enum": [
        "ID",
        "START_DATE_TIME",
        "UPDATED"
       ],
       "type": "string"
      },
      "order": {
       "enum": [
        "ASC",
        "DESC"
       ],
       "type": "string"
      }
     },
     "required": [
      "field",
      "order"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "projectIds": {
    "description": "Jira project ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "to": {
    "description": "End date (YYYY-MM-DD)",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "updatedFrom": {
    "description": "Filter by update date",
    "type": "string"
   },
   "view": {
    "description": "Response shape: \"compact\" (default) drops fields the response already carries elsewhere; \"full\" returns every field this server understands. compact strips image/avatar URLs from the response; \"full\" returns Tempo's payload untouched. No field projection: this server has no verified record of which Tempo fields matter, and inventing one would risk dropping a field a caller needs.",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tempo_search_worklogs"
}
