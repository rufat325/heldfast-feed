{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Delete an environment after typing its current name as `confirm`. Only possible once every service is detached; its variable group goes with it. Does not stop or uninstall any application. Requires unrestricted account credentials and manage scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "The current environment name, verbatim.",
    "type": "string"
   },
   "environment_id": {
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "required": [
   "environment_id",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_delete_environment",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "deleted": {
      "const": true,
      "type": "boolean"
     },
     "environment_id": {
      "type": "string"
     }
    },
    "required": [
     "environment_id",
     "deleted"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Delete environment"
}
