    "type": "string"
   },
   "format": {
    "anyOf": [
     {
      "enum": [
       "7v7",
       "9v9",
       "11v11"
      ],
      "type": "string"
     },
     {
      "const": 7,
      "type": "number"
     },
     {
      "const": 9,
      "type": "number"
     },
     {
      "const": 11,
      "type": "number"
     },
     {
      "enum": [
       "7",
       "9",
       "11"
      ],
      "type": "string"
     }
    ],
    "description": "7v7, 9v9 or 11v11; also accepts numbers 7, 9, 11 and strings \"7\", \"9\", \"11\"."
   },
   "style": {
    "enum": [
     "balanced",
     "attacking",
     "defensive"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recommend_formation",
