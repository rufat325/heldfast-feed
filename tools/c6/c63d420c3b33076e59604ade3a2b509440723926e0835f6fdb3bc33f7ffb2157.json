{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return only the stored passages relevant to a question about one library item. Use after list_library instead of reading a long book, PDF, email, transcript, or document from the beginning.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "UUID that identifies the resource; pass it back exactly as smry returned it.",
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "max_passages": {
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "max_tokens": {
    "maximum": 25000,
    "minimum": 100,
    "type": "integer"
   },
   "query": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "query"
  ],
  "type": "object"
 },
 "name": "search_saved_item",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "content_kind": {
    "anyOf": [
     {
      "const": "article",
      "type": "string"
     },
     {
      "const": "website",
      "type": "string"
     },
     {
      "const": "book",
      "type": "string"
     },
     {
      "const": "email",
      "type": "string"
     },
     {
      "const": "pdf",
      "type": "string"
     },
     {
      "const": "social_post",
      "type": "string"
     },
     {
      "const": "video",
      "type": "string"
     },
     {
      "const": "podcast_episode",
      "type": "string"
     },
     {
      "const": "document",
      "type": "string"
     },
     {
      "const": "unknown",
      "type": "string"
     }
    ]
   },
   "id": {
    "type": "string"
   },
   "matched_blocks": {
    "type": "number"
   },
   "next_cursor": {
    "type": [
     "number",
     "null"
    ]
   },
   "passages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "anchor": {
       "type": "number"
      },
      "rank": {
       "type": "number"
      },
      "score": {
       "type": "number"
      },
      "section": {
       "type": [
        "string",
        "null"
       ]
      },
      "text": {
       "type": "string"
      },
      "tokens": {
       "type": "number"
      }
     },
     "required": [
      "anchor",
      "section",
      "rank",
      "score",
      "tokens",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "tokens_returned": {
    "type": "number"
   },
   "total_blocks": {
    "type": "number"
   },
   "total_tokens": {
    "type": "number"
   }
  },
  "required": [
   "id",
   "title",
   "content_kind",
   "query",
   "total_blocks",
   "total_tokens",
   "matched_blocks",
   "tokens_returned",
   "next_cursor",
   "passages"
  ],
  "type": "object"
 },
 "title": "Search inside a library item"
}
