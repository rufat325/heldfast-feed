{
 "description": "Get upcoming scheduled execution times for a job",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Job UUID",
    "type": "string"
   },
   "max": {
    "description": "Maximum number of forecasted times",
    "minimum": 1,
    "type": "integer"
   },
   "time": {
    "description": "Lookahead period (e.g., '1d', '6h', '30m'). Default '1d'",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "rundeck_get_job_forecast"
}
