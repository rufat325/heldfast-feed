{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get reactions"
 },
 "description": "List the users who reacted to a message with a specific emoji. Returns { reactions: [...] } with id, username, bot flag. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel_id": {
    "description": "ID (snowflake) of the channel or thread containing the message.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "emoji": {
    "description": "Unicode emoji or custom emoji 'name:id' to list reactors for.",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Max users to return (1\u2013100). Default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "message_id": {
    "description": "ID of the message to inspect.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "channel_id",
   "message_id",
   "emoji"
  ],
  "type": "object"
 },
 "name": "discord_get_reactions",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "reactions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bot": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "username": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "username",
      "bot"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "reactions"
  ],
  "type": "object"
 }
}
