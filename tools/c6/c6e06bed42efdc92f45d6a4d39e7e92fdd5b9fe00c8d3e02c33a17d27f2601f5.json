{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Recent events for an entity"},"description":"Recent events stored for one entity, newest first, each with its type, severity, official source and source URL; event types are those of the packs this key can use. Pass the entity id (ent_\u2026) returned by a check or lookup. An empty list means no events were recorded in the window, not that nothing happened. Cost: 1 lookup from the monthly quota (same as GET /v1/entities/{entity_id}/events). Price: 1 lookup at \u00a30.02 per lookup (list unit price).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"entity_id":{"description":"Entity id (ent_\u2026) as returned by check or a lookup","pattern":"^ent_[A-Za-z0-9_-]{1,64}$","type":"string"},"limit":{"default":20,"description":"Most recent events to return (1\u2013100)","maximum":100,"minimum":1,"type":"integer"},"since_days":{"default":90,"description":"Look back this many days (1\u2013365)","maximum":365,"minimum":1,"type":"integer"}},"required":["entity_id"],"type":"object"},"name":"sisoco_recent_events","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"entity":{"additionalProperties":false,"properties":{"country":{"type":["string","null"]},"id":{"type":"string"},"kind":{"type":"string"},"lei":{"type":["string","null"]},"name":{"type":"string"},"registry":{"type":"string"},"registry_id":{"type":"string"},"status":{"type":["string","null"]}},"required":["id","kind","country","registry","registry_id","name","status","lei"],"type":"object"},"events":{"description":"Newest first","items":{"additionalProperties":false,"properties":{"api_version":{"type":"string"},"data":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"effective_at":{"type":["string","null"]},"entity":{"additionalPro