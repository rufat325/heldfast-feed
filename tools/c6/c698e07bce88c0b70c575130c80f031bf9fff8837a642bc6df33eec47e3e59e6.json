{
 "description": "Watch curated regulatory effective dates and deadlines in a bounded window.\n\n    `since_days` controls both recently effective dates behind today and\n    effective/deadline dates ahead of today. This is a source-linked watch\n    over the curated Viridis dataset, not a live external regulatory feed.",
 "inputSchema": {
  "properties": {
   "jurisdiction": {
    "title": "Jurisdiction",
    "type": "string"
   },
   "payment_ref": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Payment Ref"
   },
   "request_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Request Id"
   },
   "since_days": {
    "default": 90,
    "title": "Since Days",
    "type": "integer"
   },
   "topics": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Topics"
   }
  },
  "required": [
   "jurisdiction"
  ],
  "title": "monitor_changesArguments",
  "type": "object"
 },
 "name": "monitor_changes",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "monitor_changesOutput",
  "type": "object"
 }
}
