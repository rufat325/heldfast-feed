{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Build Swap Transaction"
 },
 "description": "Flash-action: swaps assets within an Arcadia account in one atomic transaction. The backend finds the optimal swap route. NOTE: If you are closing a position (swap + repay + withdraw), prefer write.account.close which batches everything atomically. Only use this tool for standalone swaps within an active position. The returned calldata is time-sensitive \u2014 sign and broadcast within 30 seconds. If the transaction reverts due to price movement, rebuild and sign again immediately (retry at least once before giving up). Response includes tenderly_sim_url and tenderly_sim_status for pre-broadcast validation \u2014 if tenderly_sim_status is 'false', do NOT broadcast the transaction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account_address": {
    "description": "Arcadia account address",
    "type": "string"
   },
   "amount_in": {
    "description": "Raw units",
    "type": "string"
   },
   "asset_from": {
    "description": "Token address to swap from",
    "type": "string"
   },
   "asset_to": {
    "description": "Token address to swap to",
    "type": "string"
   },
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   },
   "slippage": {
    "default": 100,
    "description": "Basis points, 100 = 1%",
    "type": "number"
   }
  },
  "required": [
   "account_address",
   "asset_from",
   "asset_to",
   "amount_in"
  ],
  "type": "object"
 },
 "name": "write.account.swap",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "additionalProperties": true,
    "properties": {
     "total_account_value": {
      "type": "string"
     },
     "used_margin": {
      "type": "string"
     }
    },
    "required": [
     "total_account_value",
     "used_margin"
    ],
    "type": "object"
   },
   "before": {
    "additionalProperties": true,
    "properties": {
     "total_account_value": {
      "type": "string"
     },
     "used_margin": {
      "type": "string"
     }
    },
    "required": [
     "total_account_value",
     "used_margin"
    ],
    "type": "object"
   },
   "description": {
    "type": "string"
   },
   "expected_value_change": {
    "type": "string"
   },
   "tenderly_sim_status": {
    "enum": [
     "success",
     "failure",
     "unavailable"
    ],
    "type": "string"
   },
   "tenderly_sim_url": {
    "type": "string"
   },
   "transaction": {
    "additionalProperties": false,
    "properties": {
     "chainId": {
      "type": "number"
     },
     "data": {
      "type": "string"
     },
     "to": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "to",
     "data",
     "value",
     "chainId"
    ],
    "type": "object"
   }
  },
  "required": [
   "transaction"
  ],
  "type": "object"
 }
}
