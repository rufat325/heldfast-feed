    "maxLength": 300,
    "type": "string"
   },
   "name": {
    "description": "Business name as written, e.g. \u682a\u5f0f\u4f1a\u793eSBI\u8a3c\u5238 or Bybit Fintech Limited",
    "maxLength": 200,
    "type": "string"
   },
   "number": {
    "description": "Registration number (e.g. \u95a2\u6771\u8ca1\u52d9\u5c40\u9577(\u91d1\u5546)\u7b2c44\u53f7) or 13-digit corporate number",
    "maxLength": 80,
    "type": "string"
   }
  },
  "type": "object"
 },
