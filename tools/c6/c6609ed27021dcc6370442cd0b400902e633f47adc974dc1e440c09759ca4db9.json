{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get activity summary"
 },
 "description": "Summarises what happened on the connected Nexwin account over a period: the answer to \"what's happened the last two days?\" or \"anything I need to follow up?\". Returns totals for calls and for chats (how many, resolved, needing follow-up, transferred to staff, sentiment, bookings made) and one entry per conversation, newest first, with the receptionist's own summary and action items. Give lastDays (today counts as day 1, in the business's timezone) or startDate and endDate; 30 days at most. Set followUpsOnly for \"who do I need to call back?\". For a full transcript, pass an entry's channel and id to get_call_chat_detail.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "endDate": {
    "description": "YYYY-MM-DD, business-local",
    "type": "string"
   },
   "followUpsOnly": {
    "description": "Only list conversations that have action items",
    "type": "boolean"
   },
   "lastDays": {
    "description": "How many days back, today included. Use instead of startDate/endDate.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "maxItems": {
    "description": "Conversations to list (default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "startDate": {
    "description": "YYYY-MM-DD, business-local",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_activity_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_environment": {
    "description": "The Nexwin country and environment that supplied the result",
    "type": "string"
   },
   "calls": {
    "additionalProperties": true,
    "properties": {
     "needingFollowUp": {
      "type": "number"
     },
     "resolved": {
      "type": "number"
     },
     "total": {
      "type": "number"
     },
     "totalMinutes": {
      "type": "number"
     },
     "transferredToStaff": {
      "type": "number"
     },
     "unresolved": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "resolved",
     "unresolved",
     "needingFollowUp",
     "transferredToStaff",
     "totalMinutes"
    ],
    "type": "object"
   },
   "chats": {
    "$ref": "#/properties/calls"
   },
   "endDate": {
    "type": "string"
   },
   "followUpsOnly": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "actionItems": {
       "type": [
        "string",
        "null"
       ]
      },
      "channel": {
       "type": "string"
      },
      "customerName": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "startedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "channel",
      "id",
      "startedAt",
      "customerName",
      "summary",
      "actionItems"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "itemsOmitted": {
    "type": "number"
   },
   "partial": {
    "description": "True when the period had more conversations than were read; only the two totals then cover the whole period",
    "type": "boolean"
   },
   "startDate": {
    "type": "string"
   },
   "timezone": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "_environment",
   "startDate",
   "endDate",
   "timezone",
   "calls",
   "chats",
   "partial",
   "followUpsOnly",
   "items",
   "itemsOmitted"
  ],
  "type": "object"
 },
 "title": "Get activity summary"
}
