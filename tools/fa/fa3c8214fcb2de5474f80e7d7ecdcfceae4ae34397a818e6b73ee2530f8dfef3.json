{
 "description": "Update an existing CRM user's profile, role, or permissions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "companyId": {
    "description": "Company ID the user belongs to",
    "type": "string"
   },
   "email": {
    "description": "User email address",
    "type": "string"
   },
   "firstName": {
    "description": "User first name",
    "type": "string"
   },
   "lastName": {
    "description": "User last name",
    "type": "string"
   },
   "locationIds": {
    "description": "Array of location IDs the user has access to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "permissions": {
    "additionalProperties": {},
    "description": "Permissions object defining user capabilities",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "phone": {
    "description": "User phone number",
    "type": "string"
   },
   "role": {
    "description": "User role (admin, user, etc.)",
    "type": "string"
   },
   "type": {
    "description": "User type (e.g. 'account')",
    "type": "string"
   },
   "userId": {
    "description": "User ID to update",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "userId"
  ],
  "type": "object"
 },
 "name": "crm_update_user"
}
