{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Everything around one card beyond the price: community nicknames (\u5708\u5185\u53eb\u6cd5), counterfeit-risk flags with self-check steps, holder-turnover tier (locked vs high-churn), and a curated context note \u2014 plus the headline price. Accepts card_id or an exact nickname via query (e.g. \"\u51e1\u9ad8\u76ae\", \"\u91d1\u62f1\u95e8\"). Absence of flags is not a clearance; coverage is curated and growing. Calls record usage and query metadata within POKEKA.",
 "inputSchema": {
  "properties": {
   "card_id": {
    "description": "Card id from search_card / slang_lookup.",
    "type": "string"
   },
   "query": {
    "description": "Alternative to card_id: an exact community nickname or alias.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_card_context",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "card": {
    "additionalProperties": true,
    "properties": {
     "card_id": {
      "type": "string"
     },
     "card_number": {
      "type": "string"
     },
     "card_url": {
      "type": "string"
     },
     "character": {
      "description": "featured Pok\u00e9mon (EN species name)",
      "type": "string"
     },
     "dex_no": {
      "type": "number"
     },
     "finish_tiers": {
      "type": "string"
     },
     "gen_code": {
      "type": "string"
     },
     "image_url": {
      "type": "string"
     },
     "lang": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "rarity": {
      "description": "bilingual rarity bucket label",
      "type": "string"
     },
     "rarity_display": {
      "additionalProperties": true,
      "properties": {
       "cjk": {
        "description": "JP-style code (SR/RR/\u2026)",
        "type": "string"
       },
       "en": {
        "description": "official EN star-system name",
        "type": "string"
       }
      },
      "type": "object"
     },
     "rarity_tier": {
      "description": "machine rarity tier key (double_rare/ultra_rare/\u2026)",
      "type": "string"
     },
     "set_code": {
      "type": "string"
     },
     "set_name": {
      "type": "string"
     },
     "variant": {
      "description": "variant slot (master_ball/poke_ball/\u2026); absent for normal",
      "type": "string"
     },
     "variant_kind": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "context_coverage_note": {
    "type": "string"
   },
   "context_note": {
    "type": "string"
   },
   "has_risk_flags": {
    "type": "boolean"
   },
   "headline": {
    "additionalProperties": true,
    "properties": {
     "company": {
      "type": "string"
     },
     "grade": {
      "type": "string"
     },
     "n_sales": {
      "type": "number"
     },
     "price_cny": {
      "type": "number"
     },
     "price_jpy": {
      "type": "number"
     },
     "price_usd": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "hoarding_tier": {
    "enum": [
     "high_churn",
     "mid",
     "locked"
    ],
    "type": "string"
   },
   "last_sale": {
    "additionalProperties": true,
    "properties": {
     "company": {
      "type": "string"
     },
     "grade": {
      "type": "string"
     },
     "n_sales": {
      "type": "number"
     },
     "note": {
      "description": "Always quote this caveat with the number \u2014 it is one sale, not a valuation.",
      "type": "string"
     },
     "price_cny": {
      "type": "number"
     },
     "price_jpy": {
      "type": "number"
     },
     "price_usd": {
      "type": "number"
     },
     "sale_date": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "nicknames": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "price_note": {
    "type": "string"
   },
   "price_status": {
    "type": "string"
   },
   "reference": {
    "additionalProperties": true,
    "properties": {
     "as_of": {
      "description": "snapshot date of a reference (non-sale) price \u2014 quote it as of this date, not as today",
      "type": "string"
     },
     "company": {
      "type": "string"
     },
     "confidence": {
      "type": "string"
     },
     "estimate_max_date": {
      "description": "Latest sale included in a historical estimate; not the newest source sale.",
      "type": "string"
     },
     "estimate_min_date": {
      "type": "string"
     },
     "finish": {
      "type": "string"
     },
     "grade": {
      "type": "string"
     },
     "last_sold": {
      "type": "string"
     },
     "market": {
      "description": "Which market this sale actually happened in (USD/CNY/JPY). The other two currency fields are convenience conversions at current FX rates, NOT prices observed in those markets. A USD-market sale quoted in CNY does not mean the card trades at that price in China.",
      "type": "string"
     },
     "n_sales": {
      "type": "number"
     },
     "price_cny": {
      "type": "number"
     },
     "price_jpy": {
      "type": "number"
     },
     "price_usd": {
      "type": "number"
     },
     "sale_date": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "release_date": {
    "type": "string"
   },
   "risk_flags": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "note": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Card context"
}
