{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new reservation/booking in Guesty. Use for direct bookings from your website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "checkIn": {
    "description": "Check-in date (YYYY-MM-DD)",
    "type": "string"
   },
   "checkOut": {
    "description": "Check-out date (YYYY-MM-DD)",
    "type": "string"
   },
   "guestEmail": {
    "description": "Guest email address",
    "type": "string"
   },
   "guestName": {
    "description": "Guest full name",
    "type": "string"
   },
   "guestPhone": {
    "description": "Guest phone number",
    "type": "string"
   },
   "listingId": {
    "description": "The listing ID to book",
    "type": "string"
   },
   "numberOfGuests": {
    "default": 1,
    "description": "Number of guests",
    "type": "number"
   },
   "source": {
    "default": "direct",
    "description": "Booking source (direct, website, etc.)",
    "type": "string"
   }
  },
  "required": [
   "listingId",
   "checkIn",
   "checkOut",
   "guestName"
  ],
  "type": "object"
 },
 "name": "create_reservation"
}
