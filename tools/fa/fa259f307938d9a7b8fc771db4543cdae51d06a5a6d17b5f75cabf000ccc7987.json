{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Renews the run's lease (a run created with lease_minutes): it then ends lease_minutes from now unless it is renewed again. A runner calls it while it lives (every third of the lease is enough); when the runner stops, the platform ends the run and deletes everything in it. A run created without a lease has nothing to renew. The run's own key may call it.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"id":{"description":"The run's id, from create_run or list_runs.","format":"uuid","type":"string"}},"required":["id"],"type":"object"},"name":"renew_run","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"account_notices":{"items":{"additionalProperties":false,"properties":{"dismissible":{"type":"boolean"},"id":{"type":"string"},"message":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["id","message","url","dismissible"],"type":"object"},"type":"array"},"available_keypairs":{"items":{"type":"string"},"type":"array"},"details":{},"duplicate":{"type":"boolean"},"error":{"anyOf":[{"anyOf":[{"not":{}},{"type":"boolean"}]},{"anyOf":[{"not":{}},{"type":"boolean"}]}]},"idempotency_key":{"type":"string"},"invalid_keypair_name":{"type":"boolean"},"machine":{},"message":{"type":"string"},"mode":{"type":"string"},"needs_keypair":{"type":"boolean"},"needs_keypair_name":{"type":"boolean"},"needs_plan":{"type":"boolean"},"next":{"type":"string"},"plan_tool":{"type":"string"},"recovery":{"type":"string"},"request":{},"result":{},"source_mismatch":{"type":"boolean"},"status":{},"validation":{"anyOf":[{"anyOf":[{"not":{}},{}]},{"anyOf":[{"not":{}},{}]}]}},"type":"object"},"title":"Renew run"}
