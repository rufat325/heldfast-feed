{
 "description": "Update this agent's status and current task. Call this when starting a new task, getting blocked, or completing work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_name": {
    "description": "Agent name",
    "type": "string"
   },
   "current_task": {
    "description": "Description of current task",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "idle",
     "working",
     "blocked",
     "completed"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_name",
   "status"
  ],
  "type": "object"
 },
 "name": "update_status"
}
