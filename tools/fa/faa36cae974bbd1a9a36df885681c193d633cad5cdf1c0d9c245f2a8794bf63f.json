 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "PreviewClose computes the per-currency revenue/expense totals and the net income a close would roll, without writing anything, and reports what still blocks the close along with what closing carries with it. The blockers come from the function ClosePeriod refuses on, so a clean preview means the close will not be refused for a precondition. Read-only.",
 "inputSchema": {
  "properties": {
   "basis": {
    "enum": [
     "REPORT_BASIS_UNSPECIFIED",
     "REPORT_BASIS_ACCRUAL",
     "REPORT_BASIS_CASH"
    ],
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "endDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "granularity": {
    "enum": [
     "PERIOD_GRANULARITY_UNSPECIFIED",
     "PERIOD_GRANULARITY_MONTH",
     "PERIOD_GRANULARITY_QUARTER",
     "PERIOD_GRANULARITY_YEAR"
    ],
    "type": "string"
   },
   "startDate": {
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "accounting_preview_close",
 "outputSchema": {
  "properties": {
   "blockers": {
    "items": {
     "properties": {
      "message": {
       "type": "string"
      },
      "reason": {
       "enum": [
        "PERIOD_CLOSE_REFUSAL_REASON_UNSPECIFIED",
        "PERIOD_CLOSE_REFUSAL_REASON_INVALID_RANGE",
        "PERIOD_CLOSE_REFUSAL_REASON_PERIOD_OVERLAP"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "notices": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "previews": {
    "items": {
     "properties": {
      "currencyCode": {
       "type": "string"
      },
      "netIncome": {
       "type": "string"
      },
      "totalExpenses": {
       "type": "string"
      },
      "totalRevenue": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Preview Close"
}
