{
 "description": "Deliver task results. Task must be in 'claimed' status and caller must be the claimer. Returns taskId, txId (HCS transaction ID), and timestamp.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "claimerDid": {
    "description": "Claimer DID",
    "minLength": 1,
    "type": "string"
   },
   "resultBody": {
    "description": "Result content (max 4KB)",
    "maxLength": 4096,
    "type": "string"
   },
   "resultIpfs": {
    "description": "IPFS CID for large results",
    "type": "string"
   },
   "taskId": {
    "description": "Task ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId",
   "claimerDid"
  ],
  "type": "object"
 },
 "name": "deliver_result"
}
