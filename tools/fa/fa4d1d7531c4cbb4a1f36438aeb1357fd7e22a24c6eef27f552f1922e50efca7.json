   },
   "idempotencyKey": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "method": {
    "default": "GET",
    "enum": [
     "GET",
     "POST",
     "PUT"
    ],
    "type": "string"
   },
   "path": {
    "description": "Relative path beginning with /v2/ or /v3/.",
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "myfatoorah_api_request",
