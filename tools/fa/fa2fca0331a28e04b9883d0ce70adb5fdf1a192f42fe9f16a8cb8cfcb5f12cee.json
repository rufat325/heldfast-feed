{
 "description": "Submit or restart a simulated mastery run inside Preview. Returns worker-safe pass/fail and redo/locked question ids only. Never creates a Forms attempt, Project To-do event, notification, or worker progress. Requires lms:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "submit",
     "restart",
     "advance_cooldown"
    ],
    "type": "string"
   },
   "expectedStateRevision": {
    "minimum": 1,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Stable idempotency key. Reuse only for the identical operation.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "sessionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "action",
   "expectedStateRevision",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_submit_preview_mastery_run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
