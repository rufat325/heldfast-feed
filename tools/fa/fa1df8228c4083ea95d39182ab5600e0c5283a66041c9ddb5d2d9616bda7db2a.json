     "width_mm",
     "height_mm",
     "colour",
     "mount_type",
     "quantity",
     "unit_price_zar",
     "total_price_zar",
     "currency",
     "vat_included"
    ],
    "type": "object"
   },
   "contact_name": {
    "type": "string"
   },
   "contact_phone": {
    "type": "string"
   },
   "contact_required": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
