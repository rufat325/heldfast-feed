{
 "description": "Lock in a full blind specification: product, dimensions, colour, and mount type (inside recess or outside face-fix). Validates that the colour exists and is in stock, then prices the blind. Returns a configuration summary to pass directly into create_cart. Call check_colour_stock first if availability is uncertain.",
 "inputSchema": {
  "properties": {
   "colour": {
    "description": "Colour name (must match available colours)",
    "type": "string"
   },
   "finish": {
    "description": "Optional finish for aluminium venetians",
    "type": "string"
   },
   "height_mm": {
    "description": "Height/drop in millimetres",
    "type": "number"
   },
   "mount_type": {
    "description": "Use inside (recess) or outside (face-fix); handler requires a nonempty value",
    "minLength": 1,
    "type": "string"
   },
   "product_id": {
    "description": "product_id from search_catalog or lookup_catalog",
    "type": "string"
   },
   "province": {
    "description": "Optional. Customer's South African province or city. Garden Route locations get Duncan's direct contact; other locations get the online shop contact.",
    "type": "string"
   },
   "quantity": {
    "description": "Number of blinds (default 1)",
    "type": "number"
   },
   "width_mm": {
    "description": "Width in millimetres",
    "type": "number"
   }
  },
  "required": [
   "product_id",
   "width_mm",
   "height_mm",
   "colour",
   "mount_type"
  ],
  "type": "object"
 },
 "name": "configure_product",
 "outputSchema": {
  "additionalProperties": true,
  "oneOf": [
   {
    "properties": {
     "success": {
      "const": true
     }
    },
    "required": [
     "configuration"
    ]
   },
   {
    "properties": {
     "success": {
      "const": false
     }
    },
    "required": [
     "message"
    ]
   }
  ],
  "properties": {
   "configuration": {
    "additionalProperties": true,
    "properties": {
     "category": {
      "type": "string"
     },
     "colour": {
      "type": "string"
     },
     "colour_hex": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "contact_name": {
      "type": "string"
     },
     "contact_phone": {
      "type": "string"
     },
     "contact_required": {
      "type": "boolean"
     },
     "currency": {
      "const": "ZAR",
      "type": "string"
     },
     "effective_height_mm": {
      "type": "number"
     },
     "effective_width_mm": {
      "type": "number"
     },
     "finish": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "height_mm": {
      "type": "number"
     },
     "lead_time": {
      "type": "string"
     },
     "material": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "measurement_review_required": {
      "type": "boolean"
     },
     "message": {
      "type": "string"
     },
     "mount_type": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "product_id": {
      "type": "string"
     },
     "product_name": {
      "type": "string"
     },
     "product_url": {
      "type": "string"
     },
     "quantity": {
      "type": "number"
     },
     "success": {
      "type": "boolean"
     },
     "total_price_zar": {
      "type": "number"
     },
     "unit_price_zar": {
      "type": "number"
     },
     "vat_included": {
      "type": "boolean"
     },
