{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hairdora:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get salon details and opening hours"
 },
 "description": "Use this when someone asks for one salon's opening hours, address, phone, website, timezone or default appointment length. Returns that salon's business settings with up to 14 opening-hour rows, Monday first. Not for free booking slots.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "salonId": {
    "description": "Id of one of the user's salons, as the salon list returns it (24 lowercase hex characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "salonId"
  ],
  "type": "object"
 },
 "name": "get_salon",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "salon": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "appointmentDuration": {
        "anyOf": [
         {
          "exclusiveMinimum": 0,
          "maximum": 1440,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ],
        "description": "Default appointment length in minutes"
       },
       "city": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "countryCode": {
        "anyOf": [
         {
          "pattern": "^[A-Z]{2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "currency": {
        "anyOf": [
         {
          "pattern": "^[A-Z]{3}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 16,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "firstDayOfTheWeek": {
        "anyOf": [
         {
          "enum": [
           "Monday",
           "Tuesday",
           "Wednesday",
           "Thursday",
           "Friday",
           "Saturday",
           "Sunday"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "openingHours": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "close": {
           "anyOf": [
            {
             "pattern": "^\\d{1,2}:\\d{2}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "day": {
           "anyOf": [
            {
             "enum": [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
              "Saturday",
              "Sunday"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "open": {
           "anyOf": [
            {
             "pattern": "^\\d{1,2}:\\d{2}$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "day",
          "open",
          "close"
         ],
         "type": "object"
        },
        "maxItems": 14,
        "type": "array"
       },
       "openingHoursTruncated": {
        "description": "True when the salon has more than 14 opening-hour rows",
        "type": "boolean"
       },
       "phone": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "postalCode": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "state": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "street": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "timezone": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "website": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "currency",
       "defaultLocale",
       "timezone",
       "countryCode",
       "firstDayOfTheWeek",
       "appointmentDuration",
       "phone",
       "street",
       "city",
       "state",
       "postalCode",
       "website",
       "openingHours",
       "openingHoursTruncated"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Business settings of the salon; null when not found. Organization ids, payment configuration, credentials, integrations, reminders, staff data and internal metadata are excluded."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "salon"
  ],
  "type": "object"
 },
 "title": "Get salon details and opening hours"
}
