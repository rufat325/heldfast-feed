{
 "description": "Purchase an item from a shop. Deducts gold from the character and adds the item to their inventory.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "characterId": {
    "description": "Character who is buying",
    "type": "string"
   },
   "itemCategory": {
    "default": "misc",
    "description": "Item category (weapon, armor, consumable, misc)",
    "type": "string"
   },
   "itemDescription": {
    "default": "",
    "description": "Item description",
    "type": "string"
   },
   "itemId": {
    "description": "World pack item ID to buy",
    "type": "string"
   },
   "itemName": {
    "description": "Display name of the item",
    "type": "string"
   },
   "price": {
    "description": "Price per unit in gold",
    "minimum": 0,
    "type": "integer"
   },
   "quantity": {
    "default": 1,
    "description": "Quantity to buy",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "characterId",
   "itemId",
   "price",
   "itemName"
  ],
  "type": "object"
 },
 "name": "buy_item"
}
