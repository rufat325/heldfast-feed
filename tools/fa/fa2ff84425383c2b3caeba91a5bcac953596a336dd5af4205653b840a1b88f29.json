{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "[Skillsmith \u2014 Discover stage] Search the Skillsmith registry of agent skills (SKILL.md format) \u2014 curated, security-scanned, trust-scored skills indexed daily from GitHub. Skillsmith is a registry for sharing, scanning, and tracking agent skills across any MCP-capable runtime. Use this tool for ANY user request to find/search/discover/list skills \u2014 e.g. 'search for testing skills', 'find git workflow skills', 'show me devops skills with quality above 80'. Returns ranked installable skills with trust badges, NOT general programming guidance. Results are installable-only by default (pass installable_only:false to also include discovery-only entries that cannot be installed). Filters: query (required), category, trust_tier (verified/curated/community/experimental), min_score, max_risk, safe_only, installable_only, limit, compatibility (IDE/LLM). Matching is keyword-based, not semantic \u2014 use a short single-topic query; on empty results, check the response suggestion field for what to try next.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Filter by skill category",
    "enum": [
     "development",
     "testing",
     "documentation",
     "devops",
     "database",
     "security",
     "productivity",
     "integration",
     "ai-ml",
     "other"
    ],
    "type": "string"
   },
   "compatible_with": {
    "description": "Rank by IDE and/or LLM compatibility (deprioritizes, never excludes)",
    "properties": {
     "ides": {
      "description": "IDE slugs (e.g. [\"cursor\", \"claude-code\"])",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "llms": {
      "description": "LLM slugs (e.g. [\"claude\", \"gpt-4o\"])",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "installable_only": {
    "description": "When true (default), return only installable skills \u2014 excludes discovery-only registry entries that install_skill cannot resolve. Pass false to opt back in to discovery-only entries.",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum results to return (default 10). Out-of-range values are clamped, not rejected.",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "max_risk": {
    "description": "Maximum risk score (0-100, lower is safer)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "min_score": {
    "description": "Minimum quality score (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Search query \u2014 matched literally/lexically (not semantically); use a short single-topic term (e.g. 'testing') rather than a multi-concept phrase for best results",
    "type": "string"
   },
   "safe_only": {
    "description": "Only show skills that passed security scan",
    "type": "boolean"
   },
   "trust_tier": {
    "description": "Filter by trust tier level (verified, curated, community, experimental, unknown)",
    "enum": [
     "verified",
     "curated",
     "community",
     "experimental",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "compatibilityDeprioritized": {
    "type": "number"
   },
   "discoveryOnlyHidden": {
    "type": "number"
   },
   "filters": {
    "properties": {
     "category": {
      "type": "string"
     },
     "compatibleWith": {
      "properties": {
       "ides": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "llms": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "maxRiskScore": {
      "type": "number"
     },
     "minScore": {
      "type": "number"
     },
     "safeOnly": {
      "type": "boolean"
     },
     "trustTier": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "author": {
       "type": "string"
      },
      "category": {
       "type": "string"
      },
      "compatibility": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "installHint": {
       "type": "string"
      },
      "installable": {
       "type": "boolean"
      },
      "license": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "repository": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "security": {
       "properties": {
        "findingsCount": {
         "type": "number"
        },
        "passed": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "riskScore": {
         "type": [
          "number",
          "null"
         ]
        },
        "scanCoverageIncomplete": {
         "type": "boolean"
        },
        "scanCoverageNote": {
         "type": [
          "string",
          "null"
         ]
        },
        "scannedAt": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "source": {
       "enum": [
        "local",
        "registry"
       ],
       "type": "string"
      },
      "trustTier": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "author",
      "category",
      "trustTier",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "suggestion": {
    "type": "string"
   },
   "timing": {
    "properties": {
     "searchMs": {
      "type": "number"
     },
     "totalMs": {
      "type": "number"
     }
    },
    "required": [
     "searchMs",
     "totalMs"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "results",
   "total",
   "query",
   "filters",
   "timing"
  ],
  "type": "object"
 },
 "title": "Search Skills"
}
