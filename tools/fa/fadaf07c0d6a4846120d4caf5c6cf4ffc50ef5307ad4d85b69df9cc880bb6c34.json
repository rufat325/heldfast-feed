{
 "description": "Updates mailbox metadata (currently display name).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "displayName": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "mailboxId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mailboxId",
   "displayName"
  ],
  "type": "object"
 },
 "name": "assistantmail_update_mailbox"
}
