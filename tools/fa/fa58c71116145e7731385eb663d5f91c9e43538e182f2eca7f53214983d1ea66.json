{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get card payment status"},"description":"Read one card payment order made by request_card_payment: whether a person has paid, what was charged and the fax it sent. Use get_fax_status for a wallet fax and get_review_status for a human approval decision. Returns the order with next: checkout, confirm, wait or done. While a person still has to pay or confirm, it returns status_url again, the link to give them. Once the fax was released, it also returns the fax with its delivery state and the carrier's evidence. Evidence is not legal proof of acceptance. It cannot pay, confirm or send. Repeated polls are safe and free. Scope: fax:read.","inputSchema":{"properties":{"order_id":{"description":"Card payment order id from request_card_payment. Format: oto_ followed by 32 lowercase hexadecimal characters. Required, no default. This is an order, not a fax id or an approval request.","examples":["oto_0123456789abcdef0123456789abcdef"],"pattern":"^oto_[0-9a-f]{32}$","title":"Order Id","type":"string"}},"required":["order_id"],"title":"get_card_payment_statusArguments","type":"object"},"name":"get_card_payment_status","outputSchema":{"$defs":{"Attempt":{"additionalProperties":true,"properties":{"attempt_number":{"title":"Attempt Number","type":"integer"},"error":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Error"},"evidence":{"anyOf":[{"additionalProperties":true,"type":"object"},{"type":"null"}],"title":"Evidence"},"failure_code":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Failure Code"},"fax_job_id":{"title":"Fax Job Id","type":"string"},"finished_at":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Finished At"},"id":{"title":"Id","type":"string"},"pages_sent":{"title":"Pages Sent","type":"integer"},"provider":{"title":"Provider","type":"string"},"provider_ref":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Provider Ref"},"started_at"