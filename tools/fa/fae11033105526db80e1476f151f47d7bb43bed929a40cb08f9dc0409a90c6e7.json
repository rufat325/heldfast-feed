{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get project overview: total tickets, breakdown by state tag, and the top-N open (not state:done) tickets by priority. Good starting point for any project.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "topN": {
    "description": "Number of top tickets",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "report_summary",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "byState": {
    "additionalProperties": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "topByPriority": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "priority": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "priority"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalTickets": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "withoutState": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "totalTickets",
   "byState",
   "withoutState",
   "topByPriority"
  ],
  "type": "object"
 }
}
