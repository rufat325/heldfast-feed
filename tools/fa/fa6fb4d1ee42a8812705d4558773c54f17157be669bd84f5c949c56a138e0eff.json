{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create invoice"
 },
 "description": "Issue an invoice to a customer (optionally for a job of that customer). Total is computed from line items; due date defaults to company payment terms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "customerId": {
    "description": "Customer id",
    "minLength": 1,
    "type": "string"
   },
   "dueOn": {
    "description": "Date, YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "issuedOn": {
    "description": "Date, YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "jobId": {
    "type": [
     "string",
     "null"
    ]
   },
   "lineItems": {
    "items": {
     "properties": {
      "description": {
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "sku": {
       "minLength": 1,
       "type": "string"
      },
      "unitPriceCents": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "sku",
      "description",
      "quantity",
      "unitPriceCents"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "customerId",
   "lineItems"
  ],
  "type": "object"
 },
 "name": "invoicing_create_invoice",
 "title": "Create invoice"
}
