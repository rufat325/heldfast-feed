    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Response shape. 'json' returns structured records; 'text' returns the same content rendered as a short narrative paragraph for chat surfaces.",
    "enum": [
     "json",
     "text"
    ],
    "type": "string"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   },
   "topic": {
    "description": "Optional topic keyword. Accepted but not applied: the search is not filtered by this value.",
    "enum": [
     "transport",
     "money",
     "safety",
     "culture",
     "food",
     "weather",
     "language",
     "connectivity"
    ],
    "type": "string"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
