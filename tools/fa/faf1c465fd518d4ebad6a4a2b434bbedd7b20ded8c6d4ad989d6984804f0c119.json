{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/uae-gratuity-calculator"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "UAE end-of-service gratuity estimate"
 },
 "description": "AED estimate for covered private-sector full-time foreign workers using monthly basic salary, at least one year service, 21 days for first five years then 30; capped at 24 months basic salary. Assumes continuous service without unpaid leave; no deductions or alternative schemes assessed. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "basicSalary": {
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "endDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "startDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "basicSalary",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "uae_gratuity",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "const": "AED",
    "type": "string"
   },
   "eligible": {
    "type": "boolean"
   },
   "gratuity": {
    "type": "number"
   },
   "yearsOfService": {
    "type": "number"
   }
  },
  "required": [
   "yearsOfService",
   "eligible",
   "gratuity",
   "currency"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "UAE end-of-service gratuity estimate"
}
