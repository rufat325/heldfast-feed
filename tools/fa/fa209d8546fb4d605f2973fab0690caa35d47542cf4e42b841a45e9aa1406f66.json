{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Show the pairing code"
 },
 "description": "Returns the page's pairing state. A connected workspace first requires approval in its owner's connected browser, then the target page collects the person's allow or cancel decision; polling grants no session.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "decision": {
    "enum": [
     "allow",
     "cancel"
    ],
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "document"
  ],
  "type": "object"
 },
 "name": "document.pair_status",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "codeExpiresAt": {
    "maxLength": 64,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "waiting",
     "owner_confirmation_required",
     "confirmation_required",
     "paired",
     "cancelled",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "owner_approval_url": {
    "maxLength": 2048,
    "type": "string"
   },
   "paired": {
    "type": "boolean"
   },
   "pairingCode": {
    "maxLength": 8,
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Show the pairing code"
}
