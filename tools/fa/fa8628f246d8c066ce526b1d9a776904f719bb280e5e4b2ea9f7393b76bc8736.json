{
 "description": "Get basic metrics for multiple services in one call (up to 20). More efficient than individual lookups.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ids": {
    "description": "Service UUIDs",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "prowl_batch_metrics"
}
