{
 "description": "List account fundings (deposits)",
 "inputSchema": {
  "properties": {
   "fids": {
    "description": "Comma-separated funding IDs to filter",
    "type": "string"
   },
   "limit": {
    "description": "Number of results (default 25, max 100)",
    "type": "number"
   },
   "marker": {
    "description": "Pagination marker",
    "type": "string"
   },
   "method": {
    "description": "Funding method (e.g. spei, bitcoin)",
    "type": "string"
   },
   "sort": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "pending",
     "complete",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_fundings"
}
