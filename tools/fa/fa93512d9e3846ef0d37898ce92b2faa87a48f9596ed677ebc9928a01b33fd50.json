{
 "description": "Update media item metadata (title, alt text, caption, description, attachment, ...); only the given fields change",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alt_text": {
    "description": "Alt text for images",
    "type": "string"
   },
   "author": {
    "description": "Author user ID",
    "type": "integer"
   },
   "caption": {
    "description": "Caption",
    "type": "string"
   },
   "comment_status": {
    "description": "Whether comments are open",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "date": {
    "description": "Date in the site timezone (ISO8601)",
    "type": "string"
   },
   "date_gmt": {
    "description": "Date in GMT (ISO8601)",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "featured_media": {
    "description": "Cover image media ID (audio/video)",
    "type": "integer"
   },
   "id": {
    "description": "Media ID",
    "type": "integer"
   },
   "meta": {
    "additionalProperties": {},
    "description": "Registered meta fields (show_in_rest) as key/value",
    "type": "object"
   },
   "ping_status": {
    "description": "Whether pingbacks/trackbacks are open",
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "post": {
    "description": "ID of the post the item is attached to (0 = unattached)",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "URL slug",
    "type": "string"
   },
   "status": {
    "description": "Status (media normally inherits its parent's; 'private' hides it)",
    "enum": [
     "publish",
     "future",
     "draft",
     "pending",
     "private"
    ],
    "type": "string"
   },
   "template": {
    "description": "Theme template file for the attachment page",
    "type": "string"
   },
   "title": {
    "description": "Title",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "wp_update_media"
}
