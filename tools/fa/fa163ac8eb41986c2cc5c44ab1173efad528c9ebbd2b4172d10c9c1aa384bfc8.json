{
 "_meta": {
  "ui": {
   "resourceUri": "ui://warp/quote-card.mcp",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://warp/quote-card.mcp"
 },
 "annotations": {
  "readOnlyHint": true,
  "title": "Get Cargo Van Quote"
 },
 "description": "Quote a cargo van shipment (1-3 pallets, firm price)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commodity": {
    "description": "Commodity description",
    "type": "string"
   },
   "delivery_services": {
    "description": "Delivery accessorials: delivery-appointment, liftgate-delivery, residential-delivery, limited-access-delivery, inside-delivery, driver-assist-delivery",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "destination_zip": {
    "description": "5-digit US ZIP code",
    "pattern": "^\\d{5}$",
    "type": "string"
   },
   "height_in": {
    "description": "Per-pallet height in inches (defaults to 48)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "length_in": {
    "description": "Per-pallet length in inches (defaults to 48)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "origin_zip": {
    "description": "5-digit US ZIP code",
    "pattern": "^\\d{5}$",
    "type": "string"
   },
   "pallets": {
    "description": "Number of pallets (1-3)",
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "pickup_date": {
    "description": "Pickup date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "pickup_services": {
    "description": "Pickup accessorials: pickup-appointment, liftgate-pickup, residential-pickup, limited-access-pickup, inside-pickup, driver-assist-pickup",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "weight_lbs_per_pallet": {
    "description": "Weight per pallet in lbs",
    "maximum": 3500,
    "minimum": 50,
    "type": "number"
   },
   "width_in": {
    "description": "Per-pallet width in inches (defaults to 40)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "origin_zip",
   "destination_zip",
   "pallets",
   "weight_lbs_per_pallet",
   "pickup_date"
  ],
  "type": "object"
 },
 "name": "van_quote",
 "title": "Get Cargo Van Quote"
}
