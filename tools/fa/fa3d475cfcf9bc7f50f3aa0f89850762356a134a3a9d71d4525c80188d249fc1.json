{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Public-address holdings check before/after a meme buy (GET /api/portfolio). Address is routing input, not proof of ownership.",
 "execution": {
