  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "chains": {
    "maxLength": 200,
    "type": "string"
   },
   "dust": {
    "minimum": 0,
    "type": "number"
   },
   "sol": {
    "maxLength": 44,
    "minLength": 32,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "memeswap_portfolio"
}
