 },
 "description": "Use this when requesting a saved draft screenshot, public browser preview or validation warnings. Find draftId with search_post_drafts. Returns documentJson/richHtml, JPEG and enables a public preview link. Use show_post_card for an in-chat card. Follow display.instruction; check screenshot.truncated and retry unavailable screenshots without recreating the draft. May fetch external image URLs for screenshot rendering. Never publishes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channelId": {
    "description": "Preview this owner-bound channel's auto-signature. Without a channel use the account default or post override.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "draftId": {
    "type": "string"
   }
  },
  "required": [
   "draftId"
  ],
  "type": "object"
 },
 "name": "preview_post",
