{
 "description": "Generate a complete, publish-ready article with matched images. Send a topic, get back a finished article.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "image_tier": {
    "default": "standard",
    "description": "Image tier: basic (stock), standard (stock + product), premium (AI-generated)",
    "enum": [
     "basic",
     "standard",
     "premium"
    ],
    "type": "string"
   },
   "include_images": {
    "default": true,
    "description": "Include matched images",
    "type": "boolean"
   },
   "keywords": {
    "description": "Target SEO keywords",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tone": {
    "default": "informational",
    "description": "Writing tone",
    "enum": [
     "informational",
     "conversational",
     "professional",
     "review"
    ],
    "type": "string"
   },
   "topic": {
    "description": "The article topic",
    "type": "string"
   },
   "word_count": {
    "default": 1500,
    "description": "Target word count",
    "type": "number"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "generate_article"
}
