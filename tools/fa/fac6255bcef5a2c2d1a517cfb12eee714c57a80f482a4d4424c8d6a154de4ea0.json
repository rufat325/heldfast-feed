{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "FINAL LEGACY RESCUE REQUEST STEP. Use only AFTER legacy-rescue-lab-v1 has been matched/reviewed and the human explicitly asks Evercraft to review a $299 Legacy Rescue Scan. Records bounded contact and problem context only. It does not create checkout, charge, payment obligation, private-system access, invasive testing authority, deployment, migration, cutover, production mutation, or external communication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "desired_outcome": {
    "maxLength": 2400,
    "type": "string"
   },
   "email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "human_confirmed": {
    "const": true,
    "type": "boolean"
   },
   "idempotency_key": {
    "maxLength": 240,
    "minLength": 8,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "problem_summary": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "default": "evercraft-machine-commerce-mcp",
    "maxLength": 160,
    "type": "string"
   },
   "system_description": {
    "maxLength": 2400,
    "type": "string"
   },
   "target_url": {
    "maxLength": 1000,
    "type": "string"
   }
  },
  "required": [
   "idempotency_key",
   "name",
   "email",
   "problem_summary",
   "human_confirmed"
  ],
  "type": "object"
 },
 "name": "submit_legacy_rescue_scan_request",
 "title": "Submit a Legacy Rescue Scan request"
}
