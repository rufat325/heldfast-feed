{
 "_meta": {
  "ui": {
   "resourceUri": "table://display",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "description": "Display an interactive table with sorting, filtering, pagination, column visibility, and row selection. Accepts column definitions and row data. Returns a visual table component that users can interact with.",
 "inputSchema": {
  "properties": {
   "allowColumnVisibility": {
    "default": true,
    "type": "boolean"
   },
   "allowRowSelection": {
    "default": true,
    "type": "boolean"
   },
   "columns": {
    "description": "Array of column definitions",
    "items": {
     "properties": {
      "filterable": {
       "default": true,
       "type": "boolean"
      },
      "key": {
       "description": "Unique key for the column (maps to data property)",
       "type": "string"
      },
      "label": {
       "description": "Display label for the column header",
       "type": "string"
      },
      "sortable": {
       "default": true,
       "type": "boolean"
      },
      "type": {
       "default": "string",
       "enum": [
        "string",
        "number",
        "date",
        "boolean"
       ],
       "type": "string"
      },
      "width": {
       "description": "Column width in pixels",
       "type": "number"
      }
     },
     "required": [
      "key",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pageSize": {
    "default": 10,
    "type": "number"
   },
   "rows": {
    "description": "Array of row data objects",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Optional title for the table",
    "type": "string"
   }
  },
  "required": [
   "columns",
   "rows"
  ],
  "type": "object"
 },
 "name": "display_table",
 "title": "Display Table"
}
