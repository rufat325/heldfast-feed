{
 "description": "Generate a signed aps.txt file for site-wide governance. Like robots.txt but cryptographically signed with terms, revocation endpoint, and MCP upgrade path.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "Domain this declaration covers (e.g. theagenttimes.com)",
    "type": "string"
   },
   "inference": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "mcpEndpoint": {
    "type": "string"
   },
   "privateKey": {
    "description": "Publisher's Ed25519 private key (hex)",
    "type": "string"
   },
   "publicKey": {
    "description": "Publisher's Ed25519 public key (hex)",
    "type": "string"
   },
   "publisherName": {
    "description": "Human-readable publisher name",
    "type": "string"
   },
   "redistribution": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "revocationEndpoint": {
    "type": "string"
   },
   "training": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   }
  },
  "required": [
   "domain",
   "publisherName",
   "publicKey",
   "privateKey"
  ],
  "type": "object"
 },
 "name": "generate_aps_txt"
}
