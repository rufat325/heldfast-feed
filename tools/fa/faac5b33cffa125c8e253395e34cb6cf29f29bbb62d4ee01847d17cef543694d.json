{
 "description": "Search for elements by type, locked status, or group ID",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupId": {
    "maxLength": 64,
    "type": "string"
   },
   "locked": {
    "type": "boolean"
   },
   "type": {
    "enum": [
     "rectangle",
     "ellipse",
     "diamond",
     "arrow",
     "text",
     "line",
     "freedraw"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "query_elements"
}
