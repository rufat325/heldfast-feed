{
 "description": "Import job definitions into a project from JSON, YAML, or XML content",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Job definition content (JSON, YAML, or XML)",
    "type": "string"
   },
   "dupeOption": {
    "description": "How to handle duplicate jobs (default skip)",
    "enum": [
     "skip",
     "create",
     "update"
    ],
    "type": "string"
   },
   "format": {
    "description": "Content format (default json)",
    "enum": [
     "json",
     "xml",
     "yaml"
    ],
    "type": "string"
   },
   "project": {
    "description": "Target project name",
    "type": "string"
   },
   "uuidOption": {
    "description": "UUID handling (default preserve)",
    "enum": [
     "preserve",
     "remove"
    ],
    "type": "string"
   }
  },
  "required": [
   "project",
   "content"
  ],
  "type": "object"
 },
 "name": "rundeck_import_jobs"
}
