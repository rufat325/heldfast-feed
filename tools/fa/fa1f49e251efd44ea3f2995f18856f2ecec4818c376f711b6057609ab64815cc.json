{
 "description": "Capture four surfaces in one timestamped document: Search Console totals and top rows per property, App Store listings, Google Play installs and traffic, and WordPress.org stats. Core Web Vitals field data, Android vitals, App Store sales and App Store reviews are not captured. A surface that cannot be read is recorded as an error in place rather than omitted; list_snapshots names the documents already on disk to compare an earlier one against; read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apps": {
    "default": [],
    "description": "App Store apps, each a numeric app id or a bundle id",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "outPath": {
    "description": "File name or path inside the snapshot directory (SEO_MCP_SNAPSHOT_DIR, default ~/.config/seo-mcp/snapshots); must end in .json, or pass auto to name the file after the moment it was taken. An existing file is not overwritten unless overwrite is true",
    "minLength": 1,
    "type": "string"
   },
   "overwrite": {
    "default": false,
    "description": "Replace an existing file at outPath; without it an existing file is left alone and reported",
    "type": "boolean"
   },
   "packages": {
    "default": [],
    "description": "Google Play package names",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "platform": {
    "default": "IOS",
    "description": "App Store platform for the app surfaces",
    "enum": [
     "IOS",
     "MAC_OS",
     "TV_OS",
     "VISION_OS"
    ],
    "type": "string"
   },
   "properties": {
    "description": "Search Console properties to capture",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "slugs": {
    "default": [],
    "description": "WordPress.org plugin slugs",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "storefronts": {
    "default": [
     "us"
    ],
    "description": "Storefront country codes for App Store ratings",
    "items": {
     "pattern": "^[a-z]{2}$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "windowDays": {
    "default": 28,
    "description": "Search Console window in days, ending today",
    "maximum": 480,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "snapshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apps": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "app": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "hasEditableRecord": {
       "type": "boolean"
      },
      "localeCount": {
       "type": "number"
      },
      "ratings": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "averageUserRating": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "source": {
          "type": "string"
         },
         "storefront": {
          "type": "string"
         },
         "userRatingCount": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "storefront",
         "averageUserRating",
         "userRatingCount"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "versionString": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "app"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "packages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "activeDeviceInstalls": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "error": {
       "type": "string"
      },
      "lastDatePresent": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "package": {
       "type": "string"
      }
     },
     "required": [
      "package"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "properties": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": "string"
      },
      "siteUrl": {
       "type": "string"
      },
      "topPages": {
       "additionalProperties": false,
       "properties": {
        "rows": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "clicks": {
            "type": "number"
           },
           "ctr": {
            "type": "number"
           },
           "impressions": {
            "type": "number"
           },
           "keys": {
            "additionalProperties": {
             "type": "string"
            },
            "propertyNames": {
             "type": "string"
            },
            "type": "object"
           },
           "position": {
            "type": "number"
           },
           "rank": {
            "type": "number"
           }
          },
          "required": [
           "rank",
           "keys",
           "clicks",
           "impressions",
           "ctr",
           "position"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "truncated": {
         "type": "boolean"
        }
       },
       "required": [
        "rows",
        "truncated"
       ],
       "type": "object"
      },
      "topQueries": {
       "additionalProperties": false,
       "properties": {
        "rows": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "clicks": {
            "type": "number"
           },
           "ctr": {
            "type": "number"
           },
           "impressions": {
            "type": "number"
           },
           "keys": {
            "additionalProperties": {
             "type": "string"
            },
            "propertyNames": {
             "type": "string"
            },
            "type": "object"
           },
           "position": {
            "type": "number"
           },
           "rank": {
            "type": "number"
           }
          },
          "required": [
           "rank",
           "keys",
           "clicks",
           "impressions",
           "ctr",
           "position"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "truncated": {
         "type": "boolean"
        }
       },
       "required": [
        "rows",
        "truncated"
       ],
       "type": "object"
      },
      "totals": {
       "additionalProperties": false,
       "properties": {
        "clicks": {
         "type": "number"
        },
        "ctr": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "daysWithData": {
         "type": "number"
        },
        "firstIncompleteDate": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "impressions": {
         "type": "number"
        },
        "position": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "clicks",
        "impressions",
        "ctr",
        "position",
        "daysWithData",
        "firstIncompleteDate"
       ],
       "type": "object"
      }
     },
     "required": [
      "siteUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slugs": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "activeInstalls": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "downloaded": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "error": {
       "type": "string"
      },
      "numRatings": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "rating": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "slug"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "surfacesWithErrors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "takenAt": {
    "type": "string"
   },
   "window": {
    "additionalProperties": false,
    "properties": {
     "endDate": {
      "type": "string"
     },
     "startDate": {
      "type": "string"
     }
    },
    "required": [
     "startDate",
     "endDate"
    ],
    "type": "object"
   },
   "windowDays": {
    "type": "number"
   },
   "writtenTo": {
    "type": "string"
   }
  },
  "required": [
   "takenAt",
