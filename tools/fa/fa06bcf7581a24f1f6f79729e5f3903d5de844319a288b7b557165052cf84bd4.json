{
 "description": "Request a Pix devolution (refund) on a received Pix transaction",
 "inputSchema": {
  "properties": {
   "descricao": {
    "description": "Refund description",
    "type": "string"
   },
   "e2eId": {
    "description": "End-to-end Pix ID of the original transaction",
    "type": "string"
   },
   "id": {
    "description": "Devolution ID (client-generated, up to 35 chars)",
    "type": "string"
   },
   "natureza": {
    "description": "Refund nature",
    "enum": [
     "ORIGINAL",
     "RETIRADA"
    ],
    "type": "string"
   },
   "valor": {
    "description": "Refund amount as string (e.g. '10.00')",
    "type": "string"
   }
  },
  "required": [
   "e2eId",
   "id",
   "valor"
  ],
  "type": "object"
 },
 "name": "create_devolucao"
}
