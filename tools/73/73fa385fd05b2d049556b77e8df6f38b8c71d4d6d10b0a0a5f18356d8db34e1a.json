{
 "description": "Run a .riv state machine step by step: set/fire inputs, advance time, observe state transitions, and optionally capture frames. Returns a transition report.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artboard": {
    "type": "string"
   },
   "background": {
    "type": "string"
   },
   "path": {
    "description": "Path to the .riv file",
    "type": "string"
   },
   "stateMachine": {
    "description": "State machine name (default: first)",
    "type": "string"
   },
   "steps": {
    "description": "Sequence of interaction steps",
    "items": {
     "additionalProperties": false,
     "properties": {
      "advance": {
       "description": "Seconds to advance (default 0)",
       "maximum": 30,
       "minimum": 0,
       "type": "number"
      },
      "capture": {
       "description": "Capture a PNG frame after this step",
       "type": "boolean"
      },
      "input": {
       "description": "Input name to set/fire before advancing",
       "type": "string"
      },
      "value": {
       "description": "Value for number/boolean inputs",
       "type": [
        "number",
        "boolean"
       ]
      }
     },
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "width": {
    "exclusiveMinimum": 0,
    "maximum": 2048,
    "type": "integer"
   }
  },
  "required": [
   "path",
   "steps"
  ],
  "type": "object"
 },
 "name": "riv_play_state_machine",
 "title": "Interactively drive a state machine"
}
