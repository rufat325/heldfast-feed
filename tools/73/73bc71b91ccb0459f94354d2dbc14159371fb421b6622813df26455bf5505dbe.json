{
 "description": "Activate a pre-authorized emergency pathway with evidence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "pathway_id": {
    "type": "string"
   },
   "trigger_evidence": {
    "description": "Evidence that trigger conditions are met",
    "type": "string"
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "type": "string"
   }
  },
  "required": [
   "pathway_id",
   "trigger_evidence",
   "valid_until"
  ],
  "type": "object"
 },
 "name": "activate_emergency"
}
