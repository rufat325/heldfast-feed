 "description": "ECB historical daily reference rates for one currency against EUR. Provide year (1999 onward) or an exact date, not both. Default: current year. Returns one year at most, original decimals, missing values and evidence. No weekend carry-forward, interpolation, current quote for discontinued currencies, cross rates or executable prices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "Uppercase non-EUR currency code from list_exchange_rate_history, for example USD. Values are currency units per one EUR.",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "date": {
    "description": "Exact source date YYYY-MM-DD, for example 2008-09-15; cannot be combined with year. No filling of weekends or gaps.",
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "CSV content with null flags, original values, source notes and provenance, alongside JSON. No missing-date filling.",
    "enum": [
     "json",
     "csv"
    ],
    "type": "string"
   },
   "year": {
    "description": "One source calendar year since 1999; defaults to the current year. Cannot be combined with date.",
    "maximum": 2026,
    "minimum": 1999,
    "type": "integer"
   }
  },
  "required": [
   "currency"
  ],
  "type": "object"
 },
