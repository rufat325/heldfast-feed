{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Smart Vertical"
 },
 "description": "Korean/local vertical and structured data router. Use domain to access places, weather, subway, finance, DART, real estate, safety, news, commerce, spellcheck, zipcode, law, public restrooms, and GeekNews without exposing every provider as a separate MCP tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Domain-specific action. Explicit values must match a supported action exactly on action-dispatch domains; omit to use the default. Supported: geeknews list/search/detail; stock search/base-info/trade-info; dart disclosures/company/financials; real_estate region-code/transactions; food_safety recall/unfit/functional-ingredient; coupang search/rocket/budget/goldbox; law search/get-text/search-precedents.",
    "type": "string"
   },
   "article": {
    "description": "Law article, e.g. \uc81c38\uc870.",
    "type": "string"
   },
   "asset_type": {
    "description": "Real-estate asset type.",
    "enum": [
     "apartment",
     "officetel",
     "villa",
     "single-house",
     "commercial"
    ],
    "type": "string"
   },
   "bas_date": {
    "description": "KRX base date YYYYMMDD.",
    "type": "string"
   },
   "base_date": {
    "description": "Weather base date YYYYMMDD.",
    "type": "string"
   },
   "base_time": {
    "description": "Weather base time HHmm.",
    "type": "string"
   },
   "bgn_de": {
    "description": "DART disclosure begin date YYYYMMDD.",
    "type": "string"
   },
   "bsns_year": {
    "description": "DART business year.",
    "type": "string"
   },
   "code": {
    "description": "Stock code.",
    "type": "string"
   },
   "context_mode": {
    "description": "Coarse alias/backcompat fallback when no numeric budget control is supplied.",
    "enum": [
     "compact",
     "balanced",
     "full"
    ],
    "type": "string"
   },
   "corp_code": {
    "description": "DART corp code.",
    "type": "string"
   },
   "currency": {
    "description": "AliExpress currency hint.",
    "enum": [
     "KRW",
     "USD"
    ],
    "type": "string"
   },
   "deal_type": {
    "description": "Real-estate deal type.",
    "enum": [
     "trade",
     "rent"
    ],
    "type": "string"
   },
   "deal_ymd": {
    "description": "Real-estate deal month YYYYMM.",
    "type": "string"
   },
   "display": {
    "description": "News result count.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "domain": {
    "description": "Vertical domain: geeknews, subway, weather, fine_dust, stock, dart, real_estate, drug_safety, food_safety, news, aliexpress, shopping, coupang, spellcheck, zipcode, law, place, or public_restroom.",
    "enum": [
     "geeknews",
     "subway",
     "weather",
     "fine_dust",
     "stock",
     "dart",
     "real_estate",
     "drug_safety",
     "food_safety",
     "news",
     "aliexpress",
     "shopping",
     "coupang",
     "spellcheck",
     "zipcode",
     "law",
     "place",
     "public_restroom"
    ],
    "type": "string"
   },
   "end_de": {
    "description": "DART disclosure end date YYYYMMDD.",
    "type": "string"
   },
   "fs_div": {
    "description": "DART financial statement division.",
    "enum": [
     "OFS",
     "CFS"
    ],
    "type": "string"
   },
   "headroom_tokens": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null means absent. Approximate remaining host context tokens. Uses compact/balanced fallback only; request full explicitly with output_budget or preferred_budget_chars."
   },
   "id": {
    "description": "Domain-specific identifier, e.g. GeekNews item id.",
    "type": "string"
   },
   "intent": {
    "description": "Place search intent.",
    "enum": [
     "auto",
     "food",
     "cafe",
     "walk",
     "dog_walk",
     "errand",
     "date",
     "work"
    ],
    "type": "string"
   },
   "item_names": {
    "description": "Drug names for drug_safety; query can be used for a single item.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "lat": {
    "description": "Latitude for weather/place/public_restroom.",
    "type": "number"
   },
   "law_id": {
    "description": "Law id for law get-text.",
    "type": "string"
   },
   "lawd_cd": {
    "description": "Real-estate law-dong code.",
    "type": "string"
   },
   "limit": {
    "description": "Generic result limit; domain-specific maxes still apply internally.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "AliExpress locale.",
    "enum": [
     "ko",
     "en"
    ],
    "type": "string"
   },
   "location": {
    "description": "Location/anchor hint for place, public_restroom, subway, or other local lookups.",
    "type": "string"
   },
   "lon": {
    "description": "Longitude for weather/place/public_restroom.",
    "type": "number"
   },
   "market": {
    "description": "KRX market for stock base-info/trade-info.",
    "enum": [
     "KOSPI",
     "KOSDAQ",
     "KONEX"
    ],
    "type": "string"
   },
   "max_price": {
    "description": "Coupang budget max price in KRW.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "num_of_rows": {
    "description": "Real-estate rows.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "nx": {
    "description": "KMA weather grid X.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "ny": {
    "description": "KMA weather grid Y.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "output_budget": {
    "description": "Explicit smartvertical output projection. Defaults to compact; use full only when the host really needs large vertical lists or long legal/safety records.",
    "enum": [
     "compact",
     "balanced",
     "full"
    ],
    "type": "string"
   },
   "page_count": {
    "description": "DART page count.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "pblntf_ty": {
    "description": "DART disclosure type.",
    "type": "string"
   },
   "preferred_budget_chars": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null means absent. Preferred host/RPC budget hint. Projects smartvertical structuredContent.result and text to compact/balanced/full."
   },
   "providers": {
    "description": "Place providers.",
    "items": {
     "enum": [
      "kakao",
      "google",
      "naver"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "query": {
    "description": "Primary keyword/search query. Also works as a fallback for domains that need q, product name, law keyword, address keyword, station, or location.",
    "type": "string"
   },
   "radius_km": {
    "description": "Public restroom radius in kilometers.",
    "maximum": 5,
    "minimum": 0.1,
    "type": "number"
   },
   "radius_m": {
    "description": "Place search radius in meters.",
    "maximum": 50000,
    "minimum": 50,
    "type": "integer"
   },
   "region_hint": {
    "description": "Fine-dust region hint, e.g. \uc11c\uc6b8 \uac15\ub0a8\uad6c.",
    "type": "string"
   },
   "reprt_code": {
    "description": "DART report code.",
    "type": "string"
   },
   "ship_to": {
    "description": "AliExpress ship-to ISO-2 country.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "sort": {
    "description": "Domain-specific sort, e.g. date/sim, rel/price_asc, blended/distance/rating.",
    "type": "string"
   },
   "start": {
    "description": "News result offset.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "station": {
    "description": "Alias for station_name when calling subway.",
    "type": "string"
   },
   "station_name": {
    "description": "Subway station name or fine-dust station name.",
    "type": "string"
   },
   "text": {
    "description": "Text input for spellcheck.",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "timeout_ms": {
    "description": "Domain request timeout in milliseconds.",
    "maximum": 60000,
    "minimum": 3000,
    "type": "integer"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "smartvertical",
 "title": "Smart Vertical"
}
