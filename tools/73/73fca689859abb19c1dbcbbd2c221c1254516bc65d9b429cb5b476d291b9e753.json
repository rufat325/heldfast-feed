{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Validate a blueprint against the live server and stage an ordered build plan. Checks Discord limits, name collisions, role references, feature requirements, and the bot's permissions, and reports every problem at once. Changes nothing. Compose the blueprint from the user's request, optionally starting from a reference layout. Existing channels and roles with matching names are reused, never duplicated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "blueprint": {
    "description": "The desired structure: roles, categories, channels.",
    "properties": {
     "categories": {
      "items": {
       "properties": {
        "channels": {
         "items": {
          "properties": {
           "name": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
           },
           "nsfw": {
            "type": "boolean"
           },
           "posting_roles": {
            "description": "With read_only: role names that may still post.",
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "private_to": {
            "description": "Role names that can see this channel. Everyone else is denied view.",
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "read_only": {
            "description": "Deny sending for everyone; for rules and announcements.",
            "type": "boolean"
           },
           "slowmode_seconds": {
            "maximum": 21600,
            "minimum": 0,
            "type": "integer"
           },
           "topic": {
            "maxLength": 1024,
            "type": "string"
           },
           "type": {
            "description": "Default text.",
            "enum": [
             "text",
             "voice",
             "forum",
             "stage",
             "announcement"
            ],
            "type": "string"
           }
          },
          "required": [
           "name"
          ],
          "type": "object"
         },
         "maxItems": 50,
         "type": "array"
        },
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "private_to": {
         "description": "Role names that can see the whole category.",
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "name",
        "channels"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "channels": {
      "description": "Top-level channels outside any category.",
      "items": {
       "properties": {
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "nsfw": {
         "type": "boolean"
        },
        "posting_roles": {
         "description": "With read_only: role names that may still post.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "private_to": {
         "description": "Role names that can see this channel. Everyone else is denied view.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "read_only": {
         "description": "Deny sending for everyone; for rules and announcements.",
         "type": "boolean"
        },
        "slowmode_seconds": {
         "maximum": 21600,
         "minimum": 0,
         "type": "integer"
        },
        "topic": {
         "maxLength": 1024,
         "type": "string"
        },
        "type": {
         "description": "Default text.",
         "enum": [
          "text",
          "voice",
          "forum",
          "stage",
          "announcement"
         ],
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 500,
      "type": "array"
     },
     "name": {
      "description": "Optional label for saving or referencing this blueprint.",
      "maxLength": 100,
      "type": "string"
     },
     "roles": {
      "description": "Highest role first, the way the server settings list them. A build creates them in this order and that order is the hierarchy.",
      "items": {
       "properties": {
        "color": {
         "pattern": "^#?[0-9a-fA-F]{6}$",
         "type": "string"
        },
        "hoist": {
         "description": "Show members with this role separately in the sidebar.",
         "type": "boolean"
        },
        "mentionable": {
         "type": "boolean"
        },
        "name": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "permissions": {
         "description": "Extra permission names beyond the preset.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "preset": {
         "description": "Vetted permission bundle. Administrator is never included.",
         "enum": [
          "none",
          "member",
          "moderator",
          "admin"
         ],
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 250,
      "type": "array"
     },
     "theme": {
      "description": "Freeform note recording the intent and naming style.",
      "maxLength": 500,
      "type": "string"
     }
    },
    "type": "object"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   }
  },
  "required": [
   "blueprint"
  ],
  "type": "object"
 },
 "name": "plan_server_build",
 "title": "Plan server build"
}
