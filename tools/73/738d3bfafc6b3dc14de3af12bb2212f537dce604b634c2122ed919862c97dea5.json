     "properties": {
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "type": "array"
   },
   "project": {
    "description": "Target project slug",
    "type": "string"
   },
   "question": {
    "description": "Decision prompt",
    "type": "string"
   },
   "state_pack": {
    "description": "Optional explicit StatePack",
    "type": "object"
   },
   "utility_profile": {
    "description": "Named utility profile override",
    "type": "string"
   }
  },
  "required": [
   "project",
   "question",
   "options"
  ],
  "type": "object"
 },
 "name": "ask_choice"
}
