{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Mutual exclusion with fencing tokens. acquire(holder) returns owner_token and fence (globally increasing);\npass fence to downstream writes so a stale holder can be rejected. Holds expire after hold_seconds (default 60)\nunless renewed. 409 unavailable means held: retry after Retry-After or wait_seconds up to 30.","inputSchema":{"properties":{"action":{"enum":["create","read","acquire","renew","release","touch","delete"],"title":"Action","type":"string"},"hold_seconds":{"anyOf":[{"maximum":3600,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Hold Seconds"},"holder":{"anyOf":[{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,99}$","type":"string"},{"type":"null"}],"default":null,"title":"Holder"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"owner_token":{"anyOf":[{"maxLength":128,"minLength":16,"type":"string"},{"type":"null"}],"default":null,"title":"Owner Token"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"leaseArguments","type":"object"},"name":"lease"}
