{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Position calculator"
 },
 "description": "Pure math for a hypothetical position: bust price, liquidation distance and settled PnL at a target exit, using the exchange formula (win curve, deadband, 2% win fee). Does not need a wallet.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entryPrice": {
    "description": "Defaults to the live ask (long) or bid (short).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "exitPrice": {
    "description": "Target exit to evaluate.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "leverage": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "marginUsd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "market": {
    "description": "Market symbol: BTC or ETH.",
    "enum": [
     "BTC",
     "ETH"
    ],
    "type": "string"
   },
   "side": {
    "description": "long profits if price rises, short if it falls.",
    "enum": [
     "long",
     "short"
    ],
    "type": "string"
   }
  },
  "required": [
   "market",
   "side",
   "marginUsd",
   "leverage"
  ],
  "type": "object"
 },
 "name": "calculate_position",
 "title": "Position calculator"
}
