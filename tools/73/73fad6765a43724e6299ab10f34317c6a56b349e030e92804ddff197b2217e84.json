      "text"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "book_id",
   "book_name",
   "chapter",
   "start_verse",
   "end_verse",
   "url",
   "licensing",
   "text_modified",
   "verses"
  ],
  "type": "object"
 },
