{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Query Geometry"
 },
 "description": "Use this when you need to resolve or inspect topology against a script's lowered geometry. Selected by `mode` (default 'evaluate'):\n- 'evaluate' \u2014 inspect a Query (@kc[...] ref, @kcq[...] DSL, or { ast }); returns matched entities. Pass expect:'unique' to assert exactly-one.\n- 'resolve' \u2014 resolve a single @kc[...] / @kcq[...] ref to one entity ({ ref }).\n- 'lineage' \u2014 walk the HistoryMap for a named face ref ({ feature_id, ref }).\nAll params except `mode` are forwarded verbatim.",
 "inputSchema": {
  "properties": {
   "code": {
    "description": "Inline kernelCAD script source.",
    "type": "string"
   },
   "expect": {
    "description": "mode:'evaluate' \u2014 'unique' asserts exactly-one.",
    "enum": [
     "any",
     "unique"
    ],
    "type": "string"
   },
   "feature_id": {
    "description": "Optional FeatureId; defaults to the last lowered shape (use \"auto\" for lineage).",
    "type": "string"
   },
   "file": {
    "description": "Path to a .kcad.ts script file. Hosted server: cannot read files from your machine \u2014 pass `code`, or `project:<slug>` for a saved project.",
    "type": "string"
   },
   "mode": {
    "description": "Resolution mode (default 'evaluate').",
    "enum": [
     "evaluate",
     "resolve",
     "lineage"
    ],
    "type": "string"
   },
   "query": {
    "description": "mode:'evaluate' \u2014 Query input: @kc[...] / @kcq[...] string or { ast } object."
   },
   "ref": {
    "description": "mode:'resolve'|'lineage' \u2014 topology ref string.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "query",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "candidates": {
    "description": "mode:'resolve' \u2014 near-miss candidates (failure).",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "chain": {
    "description": "mode:'lineage' \u2014 HistoryMap walk.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "entities": {
    "description": "mode:'evaluate' \u2014 matched entities.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "entity": {
    "additionalProperties": true,
    "description": "mode:'resolve' \u2014 the single matched entity.",
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "errorCode": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "query": {
    "additionalProperties": true,
    "description": "mode:'evaluate' \u2014 the resolved Query ({ ast }).",
    "type": "object"
   },
   "ref": {
    "description": "mode:'resolve' \u2014 the resolved ref string.",
    "type": "string"
   },
   "warnings": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Query Geometry"
}
