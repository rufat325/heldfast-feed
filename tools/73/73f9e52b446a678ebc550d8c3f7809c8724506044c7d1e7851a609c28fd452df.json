{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Read an exact county's published residential sales. Filter by postal ZIP, city, address, property type, or month. Follow the next cursor with the same filters. Dates have month precision.","inputSchema":{"additionalProperties":false,"properties":{"city":{"description":"Exact postal city","maxLength":46,"minLength":1,"type":"string"},"county":{"description":"Florida county slug, for example miami-dade","maxLength":40,"minLength":1,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"},"cursor":{"description":"Next cursor from the preceding page","maxLength":320,"minLength":1,"type":"string"},"from":{"description":"Sale month as YYYY-MM","maxLength":7,"minLength":1,"pattern":"^[0-9]{4}-(0[1-9]|1[0-2])$","type":"string"},"limit":{"default":25,"description":"Maximum records to return","maximum":100,"minimum":1,"type":"integer"},"q":{"description":"Address or city text","maxLength":80,"minLength":1,"type":"string"},"to":{"description":"Sale month as YYYY-MM","maxLength":7,"minLength":1,"pattern":"^[0-9]{4}-(0[1-9]|1[0-2])$","type":"string"},"type":{"description":"Florida DOR property use code","enum":["001","002","003","004","005","006","007","008"],"type":"string"},"zip":{"description":"Five-digit ZIP code, including leading zeroes","maxLength":5,"minLength":1,"pattern":"^[0-9]{5}$","type":"string"}},"required":["county"],"type":"object"},"name":"search_florida_recorded_sales","title":"Search Florida recorded property sales"}
