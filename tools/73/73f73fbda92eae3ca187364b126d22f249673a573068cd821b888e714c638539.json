{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "agent:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the caller\u2019s current nonterminal Darwin actions with bounded pagination.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actingAiId": {
    "description": "Optional authorized Darwin AI whose current actions should be listed. Omit to use the active AI.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "Opaque pagination cursor returned as nextCursor by a previous list_actions call.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "lifecycle": {
    "default": "current",
    "description": "Return active Actions, ended Actions, or both.",
    "enum": [
     "current",
     "ended",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of current actions to return, from 1 through 50. Defaults to 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "targetAiId": {
    "description": "Return only Actions bound to this destination AI.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_actions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actionId": {
       "maxLength": 191,
       "minLength": 1,
       "type": "string"
      },
      "aiId": {
       "anyOf": [
        {
         "maxLength": 191,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "attentionState": {
       "enum": [
        "needs_attention",
        "clear"
       ],
       "type": "string"
      },
      "availableActions": {
       "items": {
        "enum": [
         "status",
         "update",
         "authenticate",
         "pay",
         "approve",
         "stop",
         "end"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "capabilityId": {
       "anyOf": [
        {
         "maxLength": 191,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "capabilityIds": {
       "items": {
        "maxLength": 191,
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      },
      "capabilityRevision": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "maximum": 9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "createdAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "intent": {
       "type": "string"
      },
      "lifecycle": {
       "enum": [
        "active",
        "ending",
        "ended"
       ],
       "type": "string"
      },
      "lifecycleStatus": {
       "type": "string"
      },
      "mode": {
       "enum": [
        "buy",
        "sell",
        "chat",
        "auto"
       ],
       "type": "string"
      },
      "outcome": {
       "anyOf": [
        {
         "enum": [
          "succeeded",
          "failed",
          "canceled",
          "unknown"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "revision": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "targetAiId": {
       "anyOf": [
        {
         "maxLength": 191,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "type": "string"
      },
      "updatedAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      }
     },
     "required": [
      "actionId",
      "aiId",
      "targetAiId",
      "capabilityId",
      "capabilityRevision",
      "revision",
      "lifecycle",
      "outcome",
      "title",
      "intent",
      "mode",
      "lifecycleStatus",
      "attentionState",
      "capabilityIds",
      "createdAt",
      "updatedAt",
      "availableActions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 191,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "completed"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "list"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "status",
   "actions",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List actions"
}
