{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Register NFC Tag"
 },
 "description": "Register a physical NFC tag to a project, task list, or specific task. When someone taps the tag, TaScan routes them to the linked resource. Tags use NTAG215 chips and are programmed with NFC Tools Pro.",
 "inputSchema": {
  "properties": {
   "location_description": {
    "description": "Physical location of the tag",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID",
    "type": "string"
   },
   "tag_hardware_id": {
    "description": "NFC tag hardware serial number (e.g., \"04:CB:6C:51:CE:2A:81\")",
    "type": "string"
   },
   "tag_name": {
    "description": "Friendly name (e.g., \"Ballroom A Door\", \"Breaker Panel 3\")",
    "type": "string"
   },
   "target_type": {
    "description": "What this tag points to",
    "enum": [
     "project",
     "task_list",
     "task"
    ],
    "type": "string"
   },
   "task_id": {
    "description": "Task ID (required for task targets)",
    "type": "string"
   },
   "task_list_id": {
    "description": "Task list ID (required for task_list/task targets)",
    "type": "string"
   }
  },
  "required": [
   "tag_hardware_id",
   "tag_name",
   "target_type"
  ],
  "type": "object"
 },
 "name": "tascan_register_tag"
}
