{
 "description": "Build the unsigned transaction for a policy rule change (submit from the owner or an admin wallet; `value` is the protocol update fee in wei). Operations: addMembers, removeMembers, setActionRule (UNSET|MEMBERS|ANYONE|NOBODY), addIssuer, removeIssuer, addAdmin, removeAdmin, setExpiry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "operation": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "addMembers",
        "type": "string"
       },
       "members": {
        "items": {
         "type": "string"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "kind",
       "members"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "removeMembers",
        "type": "string"
       },
       "members": {
        "items": {
         "$ref": "#/properties/operation/anyOf/0/properties/members/items"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "kind",
       "members"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "description": "Action name (e.g. \"withdraw\") or 0x-prefixed bytes32. Names are keccak256-hashed, matching keccak256(\"withdraw\") in the protected contract.",
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "const": "setActionRule",
        "type": "string"
       },
       "rule": {
        "enum": [
         "UNSET",
         "MEMBERS",
         "ANYONE",
         "NOBODY"
        ],
        "type": "string"
       }
      },
      "required": [
       "kind",
       "action",
       "rule"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "issuer": {
        "$ref": "#/properties/operation/anyOf/0/properties/members/items"
       },
       "kind": {
        "const": "addIssuer",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "issuer"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "issuer": {
        "$ref": "#/properties/operation/anyOf/0/properties/members/items"
       },
       "kind": {
        "const": "removeIssuer",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "issuer"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "admin": {
        "$ref": "#/properties/operation/anyOf/0/properties/members/items"
       },
       "kind": {
        "const": "addAdmin",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "admin"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "admin": {
        "$ref": "#/properties/operation/anyOf/0/properties/members/items"
       },
       "kind": {
        "const": "removeAdmin",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "admin"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "expiresAt": {
        "minimum": 0,
        "type": "integer"
       },
       "kind": {
        "const": "setExpiry",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "expiresAt"
      ],
      "type": "object"
     }
    ]
   },
   "policyId": {
    "anyOf": [
     {
      "pattern": "^\\d+$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "integer"
     }
    ],
    "description": "Policy ID as decimal string or integer"
   }
  },
  "required": [
   "policyId",
   "operation"
  ],
  "type": "object"
 },
 "name": "policy_update"
}
