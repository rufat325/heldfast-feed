{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List available sites"
 },
 "description": "List the sites this caller can analyze, in two groups. my_sites = the sites connected to the signed-in account (display name, domain, timezone, is_demo); empty when not signed in. demo_sites = operator-curated sites for trying RevenueScope, with timezone and the site's is_demo flag. Only call a site a sample when is_demo=true. When signed in (OAuth), prefer my_sites and, if site_id is omitted, default analytics tools to the is_primary=true site. When NOT signed in, my_sites is empty: use a demo_sites site_id and disclose its is_demo status.",
 "execution": {
  "taskSupport": "forbidden"
 },
