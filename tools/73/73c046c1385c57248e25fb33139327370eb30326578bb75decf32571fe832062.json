{
 "description": "Read messages for an agent. Returns messages addressed to this agent or broadcast to all. Marks them as read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_name": {
    "description": "The agent reading messages",
    "type": "string"
   },
   "since": {
    "description": "Only messages after this ISO timestamp",
    "type": "string"
   },
   "type": {
    "description": "Filter by message type",
    "enum": [
     "instruction",
     "status",
     "question",
     "response",
     "alert",
     "note"
    ],
    "type": "string"
   },
   "unread_only": {
    "description": "Only return unread messages (default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "agent_name"
  ],
  "type": "object"
 },
 "name": "read_messages"
}
