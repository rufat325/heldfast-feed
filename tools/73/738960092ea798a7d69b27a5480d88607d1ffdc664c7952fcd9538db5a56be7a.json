{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search market-linked news stories"
 },
 "description": "News stories from the last 48 hours for one country (IN or US) that are linked to a listed company, commodity, index or the rupee. Each story says what it reports about those instruments and names up to three sources. Information only \u2014 never investment advice. Without a query it returns the most relevant stories; with one, the stories that mention the query's words. Results are paged with a cursor.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Market the story affects: 'IN' (India) or 'US'.",
    "enum": [
     "IN",
     "US"
    ],
    "type": "string"
   },
   "cursor": {
    "description": "next_cursor from the previous page of the same search. Omit for the first page.",
    "maxLength": 600,
    "type": "string"
   },
   "hours": {
    "description": "Lookback window in hours, default 24, max 48 \u2014 older stories are purged.",
    "maximum": 48,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "description": "Stories per page, default 5, max 10.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Words to look for, e.g. a company, commodity or topic: 'crude oil', 'Reliance', 'RBI'.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
 "name": "search_stories",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "code": {
    "enum": [
     "OK",
     "NO_DATA"
    ],
    "type": "string"
   },
   "country": {
    "enum": [
     "IN",
     "US"
    ],
    "type": "string"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "stories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "country": {
       "enum": [
        "IN",
        "US"
       ],
       "type": "string"
      },
      "first_seen_at": {
       "type": "string"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "instruments": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "relevance": {
       "type": "number"
      },
      "sources": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      },
      "why_it_matters": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "headline",
      "summary",
      "why_it_matters",
      "instruments",
      "relevance",
      "country",
      "first_seen_at",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   },
   "window_hours": {
    "type": "number"
   }
  },
  "required": [
   "code",
   "stories",
   "next_cursor",
   "total",
   "country",
   "window_hours"
  ],
  "type": "object"
 },
 "title": "Search market-linked news stories"
}
