{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update reviewed test-level baselines and row size or complexity values. RiskRover calculates estimation hours.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baselines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "manHours": {
       "maximum": 99,
       "minimum": 1,
       "type": "integer"
      },
      "testLevelId": {
       "$ref": "#/properties/testLevelId"
      }
     },
     "required": [
      "testLevelId",
      "manHours"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "projectId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "qualityId": {
    "$ref": "#/properties/testLevelId"
   },
   "reviewed": {
    "const": true,
    "description": "Set to true only after explicit user approval of these exact estimation changes.",
    "type": "boolean"
   },
   "testLevelId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "updates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "complexity": {
       "$ref": "#/properties/updates/items/properties/size"
      },
      "pbsQualityItemId": {
       "$ref": "#/properties/testLevelId"
      },
      "size": {
       "maximum": 2,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "pbsQualityItemId"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "reviewed"
  ],
  "type": "object"
 },
 "name": "submit_effort_estimation_updates",
 "title": "Submit reviewed Effort Estimation updates"
}
