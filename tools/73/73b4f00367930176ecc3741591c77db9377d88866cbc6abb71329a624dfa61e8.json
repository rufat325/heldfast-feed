{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Screen a list of up to 100 Korean businesses in a single call by their 10-digit business registration numbers (\uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638). Returns one entry per input number (order preserved) with registration status, tax type, and any public-procurement debarment (\"\ubd80\uc815\ub2f9\uc5c5\uc790 \uc81c\uc7ac\") on record \u2014 a company can be perfectly active and still barred from public contracts. The summary counts how many are currently debarred. Use this for supplier, vendor or customer list screening instead of repeated single checks. Recently checked numbers may be answered from a cache up to 24 hours old (marked \"cache\": true). Sources: Korea National Tax Service, Public Procurement Service.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "business_numbers": {
    "description": "1-100 Korean business registration numbers; hyphens/spaces allowed",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "business_numbers"
  ],
  "type": "object"
 },
 "name": "check_korean_business_batch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "business_number": {
       "type": "string"
      },
      "cache": {
       "type": "boolean"
      },
      "checked_at": {
       "type": "string"
      },
      "closed_date": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sanctions": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "active": {
          "type": "boolean"
         },
         "begins_on": {
          "type": "string"
         },
         "ends_on": {
          "type": "string"
         },
         "institution": {
          "type": "string"
         },
         "law": {
          "type": "string"
         },
         "status": {
          "type": "string"
         }
        },
        "required": [
         "active"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "source": {
       "const": "Korea National Tax Service (NTS)",
       "type": "string"
      },
      "status": {
       "enum": [
        "active",
        "suspended",
        "closed",
        "not_registered"
       ],
       "type": "string"
      },
      "status_code_raw": {
       "type": "string"
      },
      "tax_type": {
       "enum": [
        "general",
        "simplified",
        "exempt",
        "non_profit",
        "unknown"
       ],
       "type": "string"
      }
     },
     "required": [
      "business_number",
      "status",
      "status_code_raw",
      "tax_type",
      "closed_date",
      "checked_at",
      "source",
      "cache"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "active": {
      "type": "number"
     },
     "closed": {
      "type": "number"
     },
     "not_registered": {
      "type": "number"
     },
     "sanctioned": {
      "type": "number"
     },
     "suspended": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "active",
     "suspended",
     "closed",
     "not_registered"
    ],
    "type": "object"
   }
  },
  "required": [
   "results",
   "summary"
  ],
  "type": "object"
 },
 "title": "Batch check Korean business status"
}
