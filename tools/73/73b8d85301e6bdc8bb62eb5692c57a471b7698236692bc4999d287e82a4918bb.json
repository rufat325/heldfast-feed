{
 "description": "Compute a cryptographic hash of a file. Supports MD5, SHA-1, SHA-256, SHA-384, SHA-512.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "algorithm": {
    "description": "Hash algorithm (default: sha256)",
    "enum": [
     "md5",
     "sha1",
     "sha256",
     "sha384",
     "sha512"
    ],
    "type": "string"
   },
   "data_base64": {
    "description": "Base64-encoded file data",
    "type": "string"
   }
  },
  "required": [
   "data_base64"
  ],
  "type": "object"
 },
 "name": "bytario_file_hash"
}
