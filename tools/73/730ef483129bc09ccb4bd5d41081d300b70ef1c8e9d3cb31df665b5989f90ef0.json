{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Re-check the day before booking"
 },
 "description": "Re-checks that the quoted date is still free right before the booking. It does NOT block or reserve the day - RIED.TAXI only blocks a day with a created booking. Returns available=true/false (with alternative dates) and held=false. Call it when the customer wants to proceed, then show the summary and create the booking right after their explicit yes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pickup_date": {
    "description": "YYYY-MM-DD (Europe/Vienna).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "pickup_time": {
    "description": "HH:MM, 24h, Europe/Vienna.",
    "pattern": "^([01]?\\d|2[0-3]):[0-5]\\d$",
    "type": "string"
   },
   "quote_id": {
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "quote_id",
   "pickup_date",
   "pickup_time"
  ],
  "type": "object"
 },
 "name": "ried_taxi_recheck_availability",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "alternative_dates": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "available": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "expires_at": {
    "type": "string"
   },
   "expires_in_minutes": {
    "type": "integer"
   },
   "held": {
    "type": "boolean"
   },
   "hold_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "pickup_date": {
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Re-check the day before booking"
}
