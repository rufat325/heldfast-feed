{
 "description": "Identify yourself to the coordination server. Sets your role and scopes tools accordingly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_id": {
    "description": "Your agent ID",
    "type": "string"
   },
   "private_key": {
    "description": "Your Ed25519 private key (for signing)",
    "type": "string"
   },
   "public_key": {
    "description": "Your Ed25519 public key",
    "type": "string"
   }
  },
  "required": [
   "public_key",
   "private_key"
  ],
  "type": "object"
 },
 "name": "identify"
}
