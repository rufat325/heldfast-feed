{"description":"Act as the tax advisor for a sale: compares FIFO, LIFO, HIFO and minimum-tax lot selection, splits short- and long-term gains, estimates tax, flags wash sales, and notes lots about to turn long-term. With mode=harvest it scans positions for tax-loss harvesting. Price: $0.02.","inputSchema":{"examples":[{"lots":[{"acquired_date":"2024-01-10","cost_basis_per_share":200,"lot_id":"a","quantity":10},{"acquired_date":"2026-09-01","cost_basis_per_share":450,"lot_id":"b","quantity":10}],"sell":{"date":"2026-10-12","price":420,"quantity":10},"symbol":"MSFT"}],"properties":{"as_of":{"description":"mode=harvest: date, default today","type":"string"},"lots":{"items":{"properties":{"acquired_date":{"type":"string"},"cost_basis_per_share":{"type":"number"},"lot_id":{"type":"string"},"quantity":{"type":"number"},"symbol":{"type":"string"}},"type":"object"},"type":"array"},"min_harvest_loss":{"description":"mode=harvest: ignore losses smaller than this (USD), default 100.","type":"number"},"mode":{"default":"sell","enum":["sell","harvest"]},"prices":{"description":"mode=harvest: {SYMBOL: current price}","type":"object"},"recent_transactions":{"items":{"properties":{"date":{"type":"string"},"quantity":{"type":"number"},"side":{"enum":["buy","sell"]},"symbol":{"type":"string"}},"type":"object"},"type":"array"},"sell":{"description":"mode=sell","properties":{"date":{"type":"string"},"price":{"type":"number"},"quantity":{"type":"number"}},"type":"object"},"symbol":{"type":"string"},"tax_rates":{"properties":{"long_term":{"type":"number"},"short_term":{"type":"number"}},"type":"object"}},"required":["lots"],"type":"object"},"name":"tax_lot_plan","title":"Tax lot selection and wash-sale check"}
