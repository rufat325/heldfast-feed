{
 "_meta": {
  "openai/outputTemplate": "ui://widget/aviasurf-route-profile.html",
  "openai/toolInvocation/invoked": "Aviasurf results ready",
  "openai/toolInvocation/invoking": "Searching Aviasurf\u2026",
  "ui": {
   "resourceUri": "ui://widget/aviasurf-route-profile.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Inspect cached route facts"
 },
 "description": "Summarize a cached fare sample in an interactive route profile: price statistics, airlines observed, travel duration, route distance, and city airports. Prices are per adult. Always link the returned search_url from a short label in the answer language, for example \"Check live prices on Aviasurf\"; never paste the raw URL as text. direct_seen means only that a nonstop option appeared in the sample; never infer that direct flights do not exist.",
 "inputSchema": {
  "additionalProperties": false,
  "not": {
   "required": [
    "depart_date",
    "depart_month"
   ]
  },
  "properties": {
   "currency": {
    "description": "Three-letter output currency. Set it only when the user explicitly requests a currency; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "depart_date": {
    "description": "Optional exact departure date. Omit both date fields for the cheapest observations across the cached horizon; do not combine with depart_month.",
    "format": "date",
    "type": "string"
   },
   "depart_month": {
    "description": "Optional departure month. Omit both date fields for the cheapest observations across the cached horizon; do not combine with depart_date.",
    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
    "type": "string"
   },
   "destination": {
    "description": "Destination city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language locale for airport and airline names.",
    "pattern": "^[A-Za-z]{2}(?:-[A-Za-z]{2})?$",
    "type": "string"
   },
   "market": {
    "description": "Two-letter country market. Set it only when the user explicitly requests a country market or local Aviasurf site; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "origin": {
    "description": "Origin city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "return_date": {
    "description": "Optional return date for a round trip.",
    "format": "date",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
 "name": "route_facts",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "type": "string"
   },
   "destination_airports": {
