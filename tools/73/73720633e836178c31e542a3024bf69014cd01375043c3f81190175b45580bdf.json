{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Operator-only: publish a new named Cypher query template.\n\nThe template must reference each declared parameter as $name (binding,\nnot interpolation). param_schema maps param name -> {\"type\": ...,\n\"required\": true|false}; types: string, int, float, bool, list.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "access_mode": {
    "default": "read",
    "description": "'read' (default) or 'write'.",
    "type": "string"
   },
   "cypher_template": {
    "description": "Parameterized Cypher using $param placeholders.",
    "type": "string"
   },
   "description": {
    "default": "",
    "description": "Human-readable description of what the query returns.",
    "type": "string"
   },
   "dpop_token": {
    "default": "",
    "type": "string"
   },
   "key": {
    "description": "Stable, human-meaningful key (e.g. 'holdings_by_sector').",
    "type": "string"
   },
   "npub": {
    "default": "",
    "description": "Required. The operator's npub (npub1...).",
    "type": "string"
   },
   "param_schema": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Declared parameters and their types."
   },
   "row_limit": {
    "default": 1000,
    "description": "Max rows returned (default 1000).",
    "type": "integer"
   },
   "timeout_ms": {
    "default": 5000,
    "description": "Best-effort query timeout (default 5000).",
    "type": "integer"
   }
  },
  "required": [
   "key",
   "cypher_template"
  ],
  "type": "object"
 },
 "name": "cypher_create_query",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 }
}
