{
 "description": "A copy-paste form snippet for a framework (html, react, vue, or fetch) wired to the form's endpoint.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "formId": {
    "description": "Form id, e.g. frm_abc123",
    "type": "string"
   },
   "framework": {
    "default": "html",
    "enum": [
     "html",
     "react",
     "vue",
     "fetch"
    ],
    "type": "string"
   }
  },
  "required": [
   "formId"
  ],
  "type": "object"
 },
 "name": "get_form_snippet",
 "title": "Get form snippet"
}
