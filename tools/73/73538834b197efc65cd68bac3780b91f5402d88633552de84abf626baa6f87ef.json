{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Previews a local .apkg export of one normal deck and its subdecks. Media is included; scheduling is opt-in. On confirmation, writes a new file under the configured export directory without overwriting existing files. Requires local AnkiConnect v1.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"confirmExport":{"default":false,"type":"boolean"},"deckId":{"description":"ID of one normal deck from list-decks; its subdecks are in scope.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"dryRun":{"default":true,"description":"Preview without exporting a file or importing into Anki.","type":"boolean"},"expectedImpactHash":{"description":"Hash from the reviewed preview.","pattern":"^[a-f0-9]{64}$","type":"string"},"fileName":{"description":"File name only. Defaults to deck-<id>.apkg.","pattern":"^[\\p{L}\\p{M}\\p{N}][\\p{L}\\p{M}\\p{N} ._-]{0,114}\\.apkg$","type":"string"},"includeScheduling":{"default":false,"description":"Include learning progress and review history.","type":"boolean"}},"required":["deckId"],"type":"object"},"name":"export-deck-package","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"blockers":{"items":{"type":"string"},"type":"array"},"deck":{"additionalProperties":false,"properties":{"id":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"name":{"type":"string"}},"required":["id","name"],"type":"object"},"dryRun":{"type":"boolean"},"exportDirectory":{"type":"string"},"exported":{"type":"boolean"},"fileName":{"type":"string"},"impactHash":{"anyOf":[{"pattern":"^[a-f0-9]{64}$","type":"string"},{"type":"null"}]},"includeScheduling":{"type":"boolean"},"includedDeckCount":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"includedDecks":{"items":{"addi