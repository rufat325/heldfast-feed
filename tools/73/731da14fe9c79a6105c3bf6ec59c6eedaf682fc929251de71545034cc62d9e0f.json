{
 "description": "Convierte un monto entre UVA y pesos argentinos al valor de la UVA de una fecha (default hoy).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "de": {
    "default": "UVA",
    "enum": [
     "UVA",
     "ARS"
    ],
    "type": "string"
   },
   "fecha": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "monto": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "monto"
  ],
  "type": "object"
 },
 "name": "ar_uva_convertir",
 "title": "Convertir UVA a pesos argentinos"
}
