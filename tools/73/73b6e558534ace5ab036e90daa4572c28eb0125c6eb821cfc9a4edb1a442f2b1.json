    "maximum": 80,
    "minimum": 15,
    "type": "integer"
   },
   "citizenship": {
    "type": "string"
   },
   "current_country": {
    "type": "string"
   },
   "education": {
    "enum": [
     "high_school",
     "associate",
     "bachelor",
     "master",
     "phd",
     "professional"
    ],
    "type": "string"
   },
   "goal": {
    "enum": [
     "work_tech",
     "start_company",
     "study_work",
     "relocate_family",
     "digital_nomad"
    ],
    "type": "string"
   },
   "income_usd": {
    "minimum": 0,
    "type": "integer"
   },
   "target_countries": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeline": {
    "enum": [
     "asap",
     "6months",
     "1year",
     "2plus"
