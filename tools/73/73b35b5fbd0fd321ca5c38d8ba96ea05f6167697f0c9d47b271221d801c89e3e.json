   "amount": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "country": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "direction": {
    "enum": [
     "net-to-gross",
     "gross-to-net"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "country"
  ],
  "type": "object"
 },
 "name": "vat_price"
}
