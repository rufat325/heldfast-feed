{
 "description": "Compute net/gross price with EU VAT for a given country. Free MCP demo; for production volume use POST /vat/price via x402 (https://toolrail.dev/skill.md).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
