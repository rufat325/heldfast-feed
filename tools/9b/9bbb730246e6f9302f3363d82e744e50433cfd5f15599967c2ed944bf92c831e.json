   "limit": {
    "description": "Page size, default 20",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page, default 1",
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Search by name or symbol",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_coins",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "coins": {
