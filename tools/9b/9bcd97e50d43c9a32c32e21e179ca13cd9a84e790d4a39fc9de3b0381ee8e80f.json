{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List infrastructure hosts with filtering, sorting, and metadata",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 100,
    "description": "Number of hosts to return (max 1000)",
    "type": "number"
   },
   "filter": {
    "description": "Filter string for search results. Example: web-server or env:prod",
    "type": "string"
   },
   "from": {
    "description": "Unix epoch seconds \u2014 hosts active since this time. Example: 1740000000",
    "type": "number"
   },
   "includeHostsMetadata": {
    "description": "Include agent_version, machine, platform, processor",
    "type": "boolean"
   },
   "includeMutedHostsData": {
    "description": "Include mute status info",
    "type": "boolean"
   },
   "sortDir": {
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "sortField": {
    "description": "Field to sort by. Example: apps, cpu, iowait, load",
    "type": "string"
   },
   "start": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list-hosts"
}
