{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record a discount the freelancer is putting on the invoice. kind none uses value 0. kind percent takes a whole number from 1 to 100. kind fixed takes a whole number of minor units. After the invoice is sealed, a different discount is refused until accept_invoice_change applies an apply_discount suggestion. Do not invent a discount.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "invoiceId": {
    "format": "uuid",
    "type": "string"
   },
   "kind": {
    "enum": [
     "none",
     "percent",
     "fixed"
    ],
    "type": "string"
   },
   "note": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "maximum": 100000000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "invoiceId",
   "kind",
   "value",
   "note"
  ],
  "type": "object"
 },
 "name": "offer_discount",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "offer discount"
}
