 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "interaction_ref": {
    "description": "Optional opaque reference id",
    "maxLength": 256,
