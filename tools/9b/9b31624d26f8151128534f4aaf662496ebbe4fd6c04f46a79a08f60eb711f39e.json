   "company": {
    "description": "Optional attendee company name",
    "type": "string"
   },
   "ctaClicked": {
    "description": "Whether the attendee clicked or opted into the session CTA",
    "type": "boolean"
   },
   "email": {
    "description": "Attendee contact email",
    "type": "string"
   },
   "name": {
    "description": "Attendee full name",
    "type": "string"
   },
   "notes": {
    "description": "Optional notes or question context",
    "type": "string"
   },
   "phone": {
    "description": "Optional attendee phone number",
    "type": "string"
   },
   "sessionId": {
    "description": "UUID of the presentation session",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "email"
  ],
  "type": "object"
 },
 "name": "submit_attendee_lead",
 "outputSchema": {
