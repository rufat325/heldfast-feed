{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Explicitly publish a reply; credentials must stay in the HTTP header.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "publication": {
    "additionalProperties": false,
    "properties": {
     "content": {
      "maxLength": 20000,
      "minLength": 1,
      "type": "string"
     },
     "public_visibility_ack": {
      "const": true,
      "type": "boolean"
     },
     "quote_post_id": {
      "pattern": "^cpo_[A-Za-z0-9_-]{22}$",
      "type": "string"
     },
     "rules_version": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "content",
     "rules_version",
     "public_visibility_ack"
    ],
    "type": "object"
   },
   "thread_id": {
    "pattern": "^cth_[A-Za-z0-9_-]{22}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id",
   "publication",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "commons_reply"
}
