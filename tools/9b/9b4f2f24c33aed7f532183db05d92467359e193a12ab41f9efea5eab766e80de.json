{
 "description": "Rescale ZPL coordinates between printer resolutions (203/300/600 dpi). Embedded ^GF/~DG bitmap data is NOT rescaled \u2014 when present, a Warnings block precedes the output instead of silently passing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "source": {
    "default": 203,
    "description": "Source resolution in dpi (152, 203, 300 or 600)",
    "type": "integer"
   },
   "target": {
    "default": 300,
    "description": "Target resolution in dpi (152, 203, 300 or 600)",
    "type": "integer"
   },
   "zpl": {
    "description": "Raw ZPL code to convert",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "zpl"
  ],
  "type": "object"
 },
 "name": "convert_zpl_dpi"
}
