{
 "annotations": {
  "destructiveHint": true,
  "title": "Create customer"
 },
 "description": "Creates a new customer in Orb (additive). Requires name and a valid email. Orb API: POST /customers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "ISO-4217 currency code for this customer.",
    "type": "string"
   },
   "email": {
    "description": "Customer billing email (required, must be a valid email).",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "external_customer_id": {
    "description": "Your external id for this customer.",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "User-defined key/value metadata (string\u2192string).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Customer display name (required).",
    "type": "string"
   },
   "payment_provider": {
    "description": "External payment/invoicing provider.",
    "enum": [
     "quickbooks",
     "bill.com",
     "stripe_charge",
     "stripe_invoice",
     "netsuite",
     "adyen"
    ],
    "type": "string"
   },
   "payment_provider_id": {
    "description": "Id of this customer in the external payment provider.",
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone (e.g. America/New_York).",
    "type": "string"
   }
  },
  "required": [
   "name",
   "email"
  ],
  "type": "object"
 },
 "name": "orb_create_customer",
 "title": "Create customer"
}
