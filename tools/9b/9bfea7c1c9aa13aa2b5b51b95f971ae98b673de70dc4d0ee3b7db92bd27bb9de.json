  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountIds": {
    "items": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "action": {
    "enum": [
     "start",
     "pause"
    ],
    "type": "string"
   },
   "id": {
    "description": "Factory id.",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "action"
  ],
  "type": "object"
 },
 "name": "vibevo_set_factory_monitoring",
