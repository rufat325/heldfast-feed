{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get the full docs-registry entry for one component: usage guidance, props, example story source, and theming tokens.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "name": {
    "description": "Component name, e.g. \"Button\"",
    "type": "string"
   },
   "section": {
    "description": "Narrow the payload; default \"all\"",
    "enum": [
     "all",
     "usage",
     "props",
     "examples",
     "theming"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "dense": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "examples": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "story": {
       "type": "string"
      }
     },
     "required": [
      "story",
      "description",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "forbiddenUse": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "group": {
    "type": [
     "string",
     "null"
    ]
   },
   "import": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "props": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "status": {
    "type": "string"
   },
   "tokens": {},
   "usage": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "name",
   "group",
   "status",
   "import",
   "description"
  ],
  "type": "object"
 },
 "title": "Get component docs"
}
