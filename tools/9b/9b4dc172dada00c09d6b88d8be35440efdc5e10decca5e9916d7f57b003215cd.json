{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Draw a picture"
 },
 "description": "Creates or edits a native SVG drawing in the active document: movable, editable figures, a spatial sketch or a brush painting. Separate from Mermaid: a Mermaid flowchart is a fence in the Markdown source, inserted with document.apply_edits and rendered in the document. Read the drawing for recipe_handle. Change a drawing dial with shapes.set; a background kind or effect preset alone takes its starting values. Change an object with an operation. A complete recipe replaces the inspected recipe, including strokes and fonts, and uses the same open-canvas hand-off as a patch. An imported SVG without a Rapier recipe is edited node by node: read it for its node tree, then send svg_handle with node_edits. With contribution, the picture is staged with your words under that name for the person to keep or drop together; a patch to the drawing the person has open takes no contribution (it is refused draw_session_open), so it goes without one and lands at once.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "alt": {
    "description": "The caption, as the person reads it (required on create). With recipe_handle it can be edited alone.",
    "minLength": 1,
    "type": "string"
   },
   "context_handle": {
    "description": "Create: the block preceding the new drawing.",
    "maxLength": 128,
    "type": "string"
   },
   "contribution": {
    "description": "The purpose of these changes. Words and pictures with this name form one contribution, kept or dropped together.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "direction": {
    "description": "The direction of automatic figure layout on create or shapes.add; down by default.",
    "enum": [
     "down",
     "across",
     "up",
     "back"
    ],
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "figures": {
    "description": "Figures use kind, not type. Example: [{\"kind\":\"rect\",\"id\":\"start\",\"label\":\"Start\"},{\"kind\":\"rect\",\"id\":\"end\",\"label\":\"Finish\"},{\"kind\":\"arrow\",\"from\":\"start\",\"to\":\"end\"}]. Omit x, y, w and h for automatic layout. Figures create a new drawing; on an existing or open drawing, send the same figures in shapes.add or shapes.replace. Paint with real brushes: {\"kind\":\"paint\",\"seed\":1,\"strokes\":[{\"brush\":\"rapier/oil\",\"colour\":\"#2255cc\",\"size\":50,\"points\":[[x,y,pressure],...]}]}. Water uses {\"kind\":\"paint\",\"mode\":\"water\",\"seed\":1,\"paper\":\"cold-press\",\"actions\":[{\"kind\":\"stroke\",\"brush\":\"water/round\",\"pigment\":\"ultramarine\",\"paths\":[[[10,10,0.7,0],[20,15,0.5,6]]]}]}; get_context.paint lists every brush; rapier.guide with topic paint lists the complete pigment palette, paper settings, controls and actions. Water path points are [x,y,pressure,tick], with integer ticks at 60 per second. Text uses an action {\"kind\":\"text\",\"text\":\"Hi\",\"at\":[10,10],\"textSize\":16}; Trace uses {\"kind\":\"trace\",\"shapeId\":\"outline\"} from the inspected drawing. Both take brush, pigment and controls. Paint size is 0-100; load and water 0-1; angle 0-179 degrees; follow and erase are booleans. Point samples use x and y in drawing units, with optional pressure 0-1. In shapes.replace, a paint figure names the inspected layer id and edits its existing material and transform.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "maxItems": 128,
    "type": "array"
   },
   "label": {
    "description": "A short name the person sees for this change.",
    "type": "string"
   },
   "node_edits": {
    "description": "Value edits on the imported SVG nodes disclosed by read_context. Definitions, gradients, clips, transforms, references and untouched source bytes are retained. Unsafe content is refused by field. null removes an optional attribute or style property.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "attributes": {
       "additionalProperties": {
        "maxLength": 16384,
        "type": [
         "string",
         "null"
        ]
       },
       "description": "SVG attributes by exact name. Use style for CSS; namespaces, event handlers, scripts and external references are refused.",
       "maxProperties": 64,
       "minProperties": 1,
       "propertyNames": {
        "pattern": "^[A-Za-z_][A-Za-z0-9_.:-]*$"
       },
       "type": "object"
      },
      "geometry": {
       "additionalProperties": {
        "maxLength": 16384,
        "type": [
         "string",
         "number",
         "null"
        ]
       },
       "description": "Geometry supported by the inspected element. Numbers or SVG value strings; paths, point lists and transforms retain SVG syntax.",
       "maxProperties": 64,
       "minProperties": 1,
       "propertyNames": {
        "enum": [
         "x",
         "y",
         "x1",
         "y1",
         "x2",
         "y2",
         "cx",
         "cy",
         "r",
         "rx",
         "ry",
         "fx",
         "fy",
         "fr",
         "width",
         "height",
         "dx",
         "dy",
         "d",
         "points",
         "pathLength",
         "transform",
         "viewBox",
         "preserveAspectRatio",
         "rotate",
         "textLength",
         "lengthAdjust",
         "startOffset",
         "offset",
         "refX",
         "refY",
         "markerWidth",
         "markerHeight",
         "orient",
         "gradientTransform",
         "patternTransform"
        ]
       },
       "type": "object"
      },
      "id": {
       "description": "The inspected structural node id.",
       "maxLength": 1024,
       "pattern": "^svg:0(?:\\.[0-9]+)*$",
       "type": "string"
      },
      "style": {
       "additionalProperties": {
        "maxLength": 16384,
        "type": [
         "string",
         "null"
        ]
       },
       "description": "Inline CSS properties. Fragment URLs refer to definitions in this SVG.",
       "maxProperties": 64,
       "minProperties": 1,
       "propertyNames": {
        "enum": [
         "alignment-baseline",
         "baseline-shift",
         "clip-path",
         "clip-rule",
