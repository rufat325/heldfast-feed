         "font-variant",
         "font-weight",
         "image-rendering",
         "letter-spacing",
         "lighting-color",
         "marker-start",
         "marker-mid",
         "marker-end",
         "mask",
         "opacity",
         "overflow",
         "paint-order",
         "pointer-events",
         "shape-rendering",
         "stop-color",
         "stop-opacity",
         "stroke",
         "stroke-dasharray",
         "stroke-dashoffset",
         "stroke-linecap",
         "stroke-linejoin",
         "stroke-miterlimit",
         "stroke-opacity",
         "stroke-width",
         "text-anchor",
         "text-decoration",
         "text-rendering",
         "transform",
         "transform-box",
         "transform-origin",
         "unicode-bidi",
         "vector-effect",
         "visibility",
         "white-space",
         "word-spacing",
         "writing-mode"
        ]
       },
       "type": "object"
      },
      "text": {
       "description": "Character data of a leaf text, tspan, textPath, title or desc. Markup remains text.",
       "maxLength": 16384,
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 128,
    "minItems": 1,
    "type": "array"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
