{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update iCal Subscription"
 },
 "description": "Update an external iCal feed subscription \u2014 change its label or its feed URL. Changing the URL forces a full re-sync on the next poll.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "label": {
    "description": "New label for this subscription",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "subscription_id": {
    "description": "iCal subscription ID to update",
    "type": "string"
   },
   "url": {
    "description": "New HTTPS URL of the iCal feed (.ics)",
    "format": "starts_with",
    "pattern": "^https:\\/\\/.*",
    "type": "string"
   }
  },
  "required": [
   "subscription_id"
  ],
  "type": "object"
 },
 "name": "update_ical_subscription"
}
