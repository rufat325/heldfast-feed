    "description": "Exact hash returned by a prior authored-entity deletion plan.",
    "pattern": "^[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "ids": {
    "description": "Entity IDs to delete after dependency checks.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "relationships": {
    "description": "Exact relationship triples to retract, including legacy shard records.",
