    "description": "Filter by available days (ISO 1-7, Mon=1, Sun=7)",
    "items": {
     "maximum": 7,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 7,
    "type": [
     "array",
     "null"
    ]
   },
   "descending": {
    "default": true,
    "description": "Sort descending",
    "type": [
     "boolean",
     "null"
    ]
   },
   "duration": {
    "description": "Required duration in minutes",
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "end": {
    "description": "Available until date (YYYY-MM-DD)",
    "format": "date",
    "type": [
     "string",
     "null"
    ]
   },
   "hours_end": {
    "description": "Filter by availability end time (HH:MM)",
    "type": [
     "string",
     "null"
    ]
   },
   "hours_start": {
    "description": "Filter by availability start time (HH:MM)",
    "type": [
     "string",
     "null"
    ]
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "perPage": {
    "default": 20,
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "price_from": {
    "description": "Minimum price per hour",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "price_to": {
    "description": "Maximum price per hour",
    "minimum": 0,
    "type": [
     "integer",
     "null"
