  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "grants": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "hookOn": {
    "type": "string"
   },
   "namespace": {
    "type": "string"
   },
   "wasmBase64": {
    "maxLength": 180000,
    "type": "string"
   },
   "wasmHex": {
    "maxLength": 262144,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "hook_report",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "analysis": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "classification": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "feeEstimate": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "hookOnDecoded": {
    "anyOf": [
     {
      "items": {},
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "structure": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "verdict": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
