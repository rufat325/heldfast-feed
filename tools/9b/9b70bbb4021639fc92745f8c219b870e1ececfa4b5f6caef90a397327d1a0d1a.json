{
 "description": "Candidate Engine step 2 \u2014 narrow a COMMITTED set: verifiers are assigned under the fixed pre-registered routing policy (never your choice \u2014 that is what stops verification shopping), each routed claim runs through the deterministic moat, unroutable claims stay quarantined (held, never judged), and the FULL set \u2014 rejected and quarantined included \u2014 is sealed with its ordered trace. Refuses an uncommitted or altered set. Pass the set exactly as candidate_commit returned it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cset": {
    "additionalProperties": false,
    "description": "the committed set, verbatim from candidate_commit",
    "properties": {
     "candidate_set_id": {
      "maxLength": 4000,
      "type": "string"
     },
     "candidates": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "candidate_id": {
         "maxLength": 4000,
         "type": "string"
        },
        "cluster_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "parent_ids": {
         "items": {
          "maxLength": 4000,
          "type": "string"
         },
         "maxItems": 200,
         "type": "array"
        },
        "proposal_weight": {
         "maximum": 1000000000000.0,
         "minimum": -1000000000000.0,
         "type": "number"
        },
        "raw_text": {
         "maxLength": 4000,
         "type": "string"
        },
        "safety_status": {
         "maxLength": 4000,
         "type": "string"
        },
        "selection_status": {
         "maxLength": 4000,
         "type": "string"
        },
        "verification_status": {
         "maxLength": 4000,
         "type": "string"
        }
       },
       "required": [
        "candidate_id",
        "raw_text"
       ],
       "type": "object"
      },
      "maxItems": 64,
      "type": "array"
     },
     "commitment": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "commitment_seal": {
      "type": [
       "string",
       "null"
      ]
     },
     "generation_method": {
      "maxLength": 4000,
      "type": "string"
     },
     "generator": {
      "maxLength": 4000,
      "type": "string"
     },
     "prompt_hash": {
      "type": [
       "string",
       "null"
      ]
     },
     "query_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "schema_version": {
      "maxLength": 4000,
      "type": "string"
     }
    },
    "required": [
     "candidate_set_id",
     "query_hash",
     "generator",
     "generation_method",
     "commitment",
     "candidates"
    ],
    "type": "object"
   }
  },
  "required": [
   "cset"
  ],
  "type": "object"
 },
 "name": "candidate_narrow"
}
