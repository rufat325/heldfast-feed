{
 "description": "Manages vibe coding session history. Save, retrieve, search, and manage past coding sessions with their code contexts and design decisions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "save",
     "get",
     "update",
     "delete",
     "list",
     "search",
     "stats"
    ],
    "type": "string"
   },
   "codeContexts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "codeBlocks": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "filename": {
          "type": "string"
         },
         "language": {
          "type": "string"
         }
        },
        "required": [
         "language",
         "code"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "conversationSummary": {
       "type": "string"
      },
      "sessionId": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "sessionId",
      "timestamp",
      "codeBlocks",
      "conversationSummary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "designDecisions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "rationale": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "description",
      "rationale",
      "category",
      "timestamp"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "filterTags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "keyword": {
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {},
    "type": "object"
   },
   "offset": {
    "type": "number"
   },
   "searchIn": {
    "items": {
     "enum": [
      "title",
      "summary",
      "tags"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "type": "string"
   },
   "sortBy": {
    "enum": [
     "createdAt",
     "updatedAt",
     "title"
    ],
    "type": "string"
   },
   "sortOrder": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_session_history"
}
