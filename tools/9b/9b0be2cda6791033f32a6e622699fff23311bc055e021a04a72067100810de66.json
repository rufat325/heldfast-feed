{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a site-wide feed of recently-submitted manga recommendation pairs (e.g. 'if you liked X, try Y') with the submitting user's own commentary \u2014 not tied to any one title. Use get_manga_recommendations instead for recommendations similar to a specific mal_id. No official-API fallback exists for this tool \u2014 it always needs Tenrai itself to be reachable.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results per page (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "sfw": {
    "description": "If true, exclude adult/explicit-rated entries (R+ Mild Nudity and up). Defaults to false (no filtering). Note: this alone still allows mainstream, safely-rated shows tagged with the Ecchi genre (fanservice) through \u2014 use `sfw_strict` to also exclude those.",
    "type": "boolean"
   },
   "sfw_strict": {
    "description": "If true, exclude adult/explicit-rated entries AND anything tagged with the Ecchi genre, even otherwise-mainstream/safely-rated shows. Stricter than `sfw` alone. Defaults to false.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_recent_manga_recommendations",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "page": {
    "additionalProperties": false,
    "properties": {
     "current_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "has_next_page": {
      "type": "boolean"
     },
     "last_visible_page": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "date": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "entries": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "image_url": {
          "type": "string"
         },
         "mal_id": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "title": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "mal_id"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "user": {
       "type": "string"
      }
     },
     "required": [
      "entries"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page"
  ],
  "type": "object"
 },
 "title": "Get recent manga recommendations"
}
