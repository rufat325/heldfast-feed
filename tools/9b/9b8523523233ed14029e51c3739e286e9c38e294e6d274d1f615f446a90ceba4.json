{
 "description": "Crear una regla configurable. Las reglas pueden bloquear o advertir sobre acciones.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Accion: block (bloquea) o warn (solo avisa)",
    "enum": [
     "block",
     "warn"
    ],
    "type": "string"
   },
   "description": {
    "description": "Descripcion de lo que hace la regla",
    "type": "string"
   },
   "name": {
    "description": "Nombre de la regla (ej: no-merge-to-main)",
    "type": "string"
   },
   "scope": {
    "description": "Ambito: git, jira, o all",
    "enum": [
     "git",
     "jira",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "description",
   "scope",
   "action"
  ],
  "type": "object"
 },
 "name": "df_rule_create"
}
