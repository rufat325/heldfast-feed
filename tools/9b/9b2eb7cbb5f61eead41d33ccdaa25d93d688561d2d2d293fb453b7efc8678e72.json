{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a cumulative cost or token usage-limit policy with non-empty conditions and grouping. A periodic reset can be weekly, monthly, or omitted for a cumulative lifetime limit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "alert_threshold": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional alert threshold"
   },
   "conditions": {
    "description": "Policy match conditions",
    "items": {
     "properties": {
      "excludes": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "Values to exclude"
      },
      "key": {
       "description": "Match key such as api_key, virtual_key, provider, config, prompt, model, endpoint_type, mcp_server, mcp_tool, workspace_id, or metadata.*",
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "One value or several OR-matched values; use * for wildcard matching"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "credit_limit": {
    "description": "Maximum cumulative usage",
    "minimum": 0,
    "type": "number"
   },
   "group_by": {
    "description": "Usage grouping dimensions",
    "items": {
     "properties": {
      "key": {
       "description": "Counter grouping key such as api_key, workspace_id, virtual_key, provider, config, prompt, model, mcp_server, mcp_tool, or metadata.*",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Optional policy display name",
    "type": "string"
   },
   "organisation_id": {
    "description": "Organisation UUID scope",
    "type": "string"
   },
   "periodic_reset": {
    "anyOf": [
     {
      "enum": [
       "monthly",
       "weekly"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional reset schedule"
   },
   "type": {
    "description": "Budget type",
    "enum": [
     "cost",
     "tokens"
    ],
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace UUID scope",
    "type": "string"
   }
  },
  "required": [
   "conditions",
   "group_by",
   "type",
   "credit_limit"
  ],
  "type": "object"
 },
 "name": "create_usage_limit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
