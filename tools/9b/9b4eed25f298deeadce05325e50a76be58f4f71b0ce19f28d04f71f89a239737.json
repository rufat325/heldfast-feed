{
 "_meta": {
  "fastmcp": {
   "tags": [
    "markets"
   ]
  }
 },
 "description": "Use when the user wants to browse, filter, or sort individual markets (not events). Returns paginated markets with their probability, volume, source, parent event ID, and 24h delta. Filterable by source, country, category, status, and full-text `search`. Sortable by `volume_24hr` or `probability`. Cap `page_size` \u2264 50 for chat-friendly responses.",
 "inputSchema": {
  "properties": {
   "active": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter by `active` flag (true/false).",
    "title": "Active"
   },
   "categories": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Comma-separated category labels to include (OR)",
    "title": "Categories"
   },
   "categories_exclude": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Comma-separated category labels to exclude",
    "title": "Categories Exclude"
   },
   "closed": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter by `closed` flag (true/false). Open markets are `closed=false`.",
    "title": "Closed"
   },
   "countries": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Comma-separated country names to include (OR). Full English names per the AI categorizer's prompt \u2014 e.g. 'United States', 'United Kingdom', 'European Union'. No allow-list \u2014 misspelled values silently yield zero matches.",
    "title": "Countries"
   },
   "countries_exclude": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Comma-separated country names to exclude.",
    "title": "Countries Exclude"
   },
   "country_match": {
    "default": "any",
    "description": "How multiple `countries` combine: 'any' (default, OR \u2014 tagged with any selected country) or 'all' (AND \u2014 tagged with all of them, e.g. both Iran and Israel). Markets carry \u22643 country tags.",
    "pattern": "^(any|all)$",
    "title": "Country Match",
    "type": "string"
   },
   "created_after": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter to rows whose created_at >= this ISO 8601 datetime (first appearance in pdata's database).",
    "title": "Created After"
   },
   "created_before": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter to rows whose created_at <= this ISO 8601 datetime.",
    "title": "Created Before"
   },
   "ends_after": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter to events whose end_date >= this ISO 8601 datetime (e.g. `2026-06-01T00:00:00Z`).",
    "title": "Ends After"
   },
   "ends_before": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Filter to events whose end_date <= this ISO 8601 datetime.",
    "title": "Ends Before"
   },
   "hide_ended": {
    "default": false,
    "description": "If true, hide markets/events whose end_date is in the past (end_date <= now()); rows with no end_date are kept.",
    "title": "Hide Ended",
    "type": "boolean"
   },
   "hide_price_derivatives": {
    "default": false,
    "description": "If true, exclude events with is_price_derivative=TRUE",
    "title": "Hide Price Derivatives",
    "type": "boolean"
   },
   "include_uncategorized": {
    "default": false,
    "description": "If true, the include clause also matches rows whose categories array is empty/NULL or contains only labels outside the canonical set (synthetic 'Other' bucket).",
    "title": "Include Uncategorized",
    "type": "boolean"
   },
   "include_uncountried": {
    "default": false,
    "description": "If true, the include clause also matches rows whose countries array is empty/NULL \u2014 country-agnostic markets (synthetic 'No country' bucket).",
    "title": "Include Uncountried",
    "type": "boolean"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "minimum": 1.0,
    "title": "Page",
    "type": "integer"
   },
   "page_size": {
    "default": 50,
    "description": "Items per page (1-200; default 50). Pass page_size=5 for chat-style summaries.",
    "maximum": 200.0,
    "minimum": 1.0,
    "title": "Page Size",
    "type": "integer"
   },
   "prob_24h_change_max": {
    "anyOf": [
     {
      "maximum": 1.0,
      "minimum": -1.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum 24h probability change (-1 to 1, signed).",
    "title": "Prob 24H Change Max"
   },
   "prob_24h_change_min": {
    "anyOf": [
     {
      "maximum": 1.0,
      "minimum": -1.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum 24h probability change (-1 to 1, signed). Use 0.15 for >=15pp positive moves.",
    "title": "Prob 24H Change Min"
   },
   "probability_max": {
    "anyOf": [
     {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum probability (0-1).",
    "title": "Probability Max"
   },
   "probability_min": {
    "anyOf": [
     {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum probability (0-1). Filters to markets above this implied probability.",
    "title": "Probability Min"
   },
   "rank_max": {
    "anyOf": [
     {
      "maximum": 100.0,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum rank score (numeric).",
    "title": "Rank Max"
   },
   "rank_min": {
    "anyOf": [
     {
      "maximum": 100.0,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum rank score (numeric). Higher = more prominent.",
    "title": "Rank Min"
   },
   "search": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Full-text search across title, description, slug. Case-insensitive substring match.",
    "title": "Search"
   },
   "sort": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Field name; prefix '-' for descending order (e.g. `-volume_24hr`). Common allowed values: `volume_24hr`, `normalized_vol_24hr`, `liquidity`, `end_date`, `closed_time`, `updated_at`. Markets endpoints additionally accept `probability`, `prob_24h_change`, `spread`. Invalid values return 400.",
    "title": "Sort"
   },
   "source": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Source name(s); single value or comma-separated list. Allowed: polymarket, kalshi, manifold, myriad, limitless, predict, opinion, gemini.",
    "title": "Source"
   },
   "spread_max": {
    "anyOf": [
     {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum bid-ask spread (0-1). Lower = more liquid.",
    "title": "Spread Max"
   },
   "spread_min": {
    "anyOf": [
     {
      "maximum": 1.0,
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum bid-ask spread (0-1). Higher = less liquid.",
    "title": "Spread Min"
   },
   "status": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Comma-separated status list; any of {open, closing-soon, resolved}",
    "title": "Status"
   },
   "volume_24h_change_max": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum 24h notional volume change (signed USD).",
    "title": "Volume 24H Change Max"
   },
   "volume_24h_change_min": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum 24h notional volume change (signed USD; e.g. 1000 means +$1k vs prior 24h).",
    "title": "Volume 24H Change Min"
   },
   "volume_24hr_max": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum 24h notional volume (USD).",
    "title": "Volume 24Hr Max"
   },
   "volume_24hr_min": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum 24h notional volume (USD). Excludes low-activity markets.",
    "title": "Volume 24Hr Min"
   },
   "volume_max": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Maximum cumulative volume (USD).",
    "title": "Volume Max"
   },
   "volume_min": {
    "anyOf": [
     {
      "minimum": 0.0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Minimum cumulative volume (USD). Excludes low-activity markets across full history.",
    "title": "Volume Min"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_markets",
 "outputSchema": {
  "properties": {
   "_meta": {
    "description": "Agent metadata for list/aggregate responses (no cite_as).",
    "properties": {
     "as_of": {
      "format": "date-time",
      "title": "As Of",
      "type": "string"
     },
     "attribution": {
      "default": "pdata.world \u2014 aggregated prediction-market data across 8 platforms",
      "title": "Attribution",
      "type": "string"
     },
     "canonical_url": {
      "title": "Canonical Url",
      "type": "string"
     },
     "docs": {
      "default": "https://api.pdata.world/docs",
      "title": "Docs",
      "type": "string"
     }
    },
    "required": [
     "canonical_url"
    ],
    "title": "ResponseMetaList",
    "type": "object"
   },
   "items": {
    "items": {
     "description": "Market as returned in list and detail endpoints.",
     "properties": {
      "active": {
       "title": "Active",
       "type": "boolean"
      },
      "added_at": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
