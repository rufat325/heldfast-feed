       "anyOf": [
        {
         "items": {
          "type": "number"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ],
       "title": "Chart 24H"
      },
      "closed": {
       "title": "Closed",
       "type": "boolean"
      },
      "closed_time": {
       "anyOf": [
        {
         "format": "date-time",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Closed Time"
      },
      "countries": {
       "default": [],
       "items": {
        "type": "string"
       },
       "title": "Countries",
       "type": "array"
      },
      "description": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Description"
      },
      "end_date": {
