      },
      "volume_24hr": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "title": "Volume 24Hr"
      }
     },
     "required": [
      "source",
      "id",
      "active",
      "closed",
      "updated_at",
      "fetched_at"
     ],
     "title": "MarketOut",
     "type": "object"
    },
    "title": "Items",
    "type": "array"
   },
   "meta": {
    "properties": {
     "page": {
      "minimum": 1.0,
      "title": "Page",
      "type": "integer"
     },
     "page_size": {
      "minimum": 1.0,
      "title": "Page Size",
      "type": "integer"
     },
     "total": {
      "minimum": 0.0,
      "title": "Total",
      "type": "integer"
     },
     "total_pages": {
      "minimum": 0.0,
      "title": "Total Pages",
      "type": "integer"
     }
    },
    "required": [
     "page",
     "page_size",
     "total",
     "total_pages"
    ],
    "title": "PageMeta",
    "type": "object"
   }
  },
  "required": [
   "items",
   "meta",
   "_meta"
  ],
  "title": "Page[MarketOut]",
  "type": "object",
  "x-fastmcp-top-level-schema": "Page_MarketOut_"
 }
}
