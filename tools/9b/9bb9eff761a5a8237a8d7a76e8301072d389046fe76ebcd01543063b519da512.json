{
 "description": "Calculate shipping rates from multiple carriers",
 "inputSchema": {
  "properties": {
   "from": {
    "properties": {
     "postal_code": {
      "description": "Origin CEP",
      "type": "string"
     }
    },
    "required": [
     "postal_code"
    ],
    "type": "object"
   },
   "products": {
    "description": "Products to ship",
    "items": {
     "properties": {
      "height": {
       "description": "Height in cm",
       "type": "number"
      },
      "insurance_value": {
       "description": "Declared value for insurance",
       "type": "number"
      },
      "length": {
       "description": "Length in cm",
       "type": "number"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      },
      "weight": {
       "description": "Weight in kg",
       "type": "number"
      },
      "width": {
       "description": "Width in cm",
       "type": "number"
      }
     },
     "required": [
      "width",
      "height",
      "length",
      "weight",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "to": {
    "properties": {
     "postal_code": {
      "description": "Destination CEP",
      "type": "string"
     }
    },
    "required": [
     "postal_code"
    ],
    "type": "object"
   }
  },
  "required": [
   "from",
   "to",
   "products"
  ],
  "type": "object"
 },
 "name": "calculate_shipping"
}
