{
 "annotations": {
  "openWorldHint": false,
  "title": "Memory Condense"
 },
 "description": "Apply agent-generated summaries to condense old memories. Preserves original content for later restoration. Use after consolidation reports flag condensation candidates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "memories": {
    "description": "Batch of memories with agent-generated summaries",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Memory ID to condense",
       "type": "string"
      },
      "one_liner": {
       "description": "Optional one-line description",
       "maxLength": 200,
       "type": "string"
      },
      "summary": {
       "description": "Agent-generated summary of the memory",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "target_level": {
    "default": "summary",
    "description": "Target condensation level",
    "enum": [
     "summary",
     "one_liner"
    ],
    "type": "string"
   }
  },
  "required": [
   "memories"
  ],
  "type": "object"
 },
 "name": "memory_condense"
}
