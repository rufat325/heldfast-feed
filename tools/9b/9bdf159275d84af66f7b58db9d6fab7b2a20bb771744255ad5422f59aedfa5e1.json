{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Resolve building"
 },
 "description": "Identifies the building from an address found with search_address (object address) or from a cadastral reference (14 characters = building or plot; 18 or 20 = a single flat). Give either cadastralReference or address, not both. status resolved returns a resolutionToken (valid 15 minutes) for create_free_report, the building's public cadastral data, whether an IEE/ITE record exists (ieeAvailability; unverified means the registry did not answer, not that there is none) and the report types that can be ordered. status select_unit lists the units: ask the person which flat, or repeat with the 14-character reference and scope=building for the whole building. Only non-protected cadastral data is returned. Do not publish the address or reference.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "description": "Coded address from search_address (provinceCode, municipalityDgcCode, municipalityIneCode, streetTypeCode, streetCode, number; localityId in the Basque Country; optional block, stair, floor, door). Use instead of cadastralReference.",
    "properties": {
     "block": {
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[\\p{L}\\p{N}/ .-]+$",
      "type": "string"
     },
     "door": {
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[\\p{L}\\p{N}/ .-]+$",
      "type": "string"
     },
     "floor": {
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[\\p{L}\\p{N}/ .-]+$",
      "type": "string"
     },
     "localityId": {
      "pattern": "^[0-9]{14}$",
      "type": "string"
     },
     "municipalityDgcCode": {
      "pattern": "^\\d{1,3}$",
      "type": "string"
     },
     "municipalityIneCode": {
      "pattern": "^\\d{3}$",
      "type": "string"
     },
     "number": {
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[\\p{L}\\p{N}/ -]+$",
      "type": "string"
     },
     "provinceCode": {
      "pattern": "^\\d{2}$",
      "type": "string"
     },
     "stair": {
      "maxLength": 16,
      "minLength": 1,
      "pattern": "^[\\p{L}\\p{N}/ .-]+$",
      "type": "string"
     },
     "streetCode": {
      "pattern": "^[A-Z0-9]{1,15}$",
      "type": "string"
     },
     "streetTypeCode": {
      "pattern": "^[A-Z0-9]{1,4}$",
      "type": "string"
     }
    },
    "required": [
     "provinceCode",
     "municipalityDgcCode",
     "municipalityIneCode",
     "streetTypeCode",
     "streetCode",
     "number"
    ],
    "type": "object"
   },
   "cadastralReference": {
    "description": "Cadastral reference: 14 characters (building or plot), 18 or 20 (a flat). Use instead of address.",
    "pattern": "^[A-Z0-9]{14}([A-Z0-9]{4}|[A-Z0-9]{6})?$",
    "type": "string"
   },
   "language": {
    "default": "es",
    "description": "Language of the texts in the answer (and of the report): es, en, de, nl or fr. Default es.",
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "scope": {
    "const": "building",
    "description": "Only with a 14-character cadastralReference: building to report on the whole building.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "resolve_building",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "availableNumbers": {
    "items": {
     "maxLength": 16,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "availableTiers": {
    "items": {
     "enum": [
      "free",
      "simple",
      "complete"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "building": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "address": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "cadastralReference": {
        "pattern": "^[A-Z0-9]{14,20}$",
        "type": "string"
       },
       "constructionYear": {
        "maximum": 2100,
        "minimum": 1000,
        "type": "integer"
       },
       "door": {
        "maxLength": 16,
        "minLength": 1,
        "type": "string"
       },
       "floor": {
        "maxLength": 16,
        "minLength": 1,
        "type": "string"
       },
       "municipality": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "postalCode": {
        "pattern": "^\\d{5}$",
        "type": "string"
       },
       "province": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "rc14": {
        "pattern": "^[A-Z0-9]{14}$",
        "type": "string"
       },
       "stair": {
        "maxLength": 16,
        "minLength": 1,
        "type": "string"
       },
       "surfaceAreaM2": {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "use": {
        "maxLength": 80,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "cadastralReference",
       "rc14"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "cadastralReference": {
       "pattern": "^[A-Z0-9]{14,20}$",
       "type": "string"
      },
      "constructionYear": {
       "maximum": 2100,
       "minimum": 1000,
       "type": "integer"
      },
      "door": {
       "maxLength": 16,
       "minLength": 1,
       "type": "string"
      },
      "floor": {
       "maxLength": 16,
       "minLength": 1,
       "type": "string"
      },
      "municipality": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "postalCode": {
       "pattern": "^\\d{5}$",
       "type": "string"
      },
      "province": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "rc14": {
       "pattern": "^[A-Z0-9]{14}$",
       "type": "string"
      },
      "stair": {
       "maxLength": 16,
       "minLength": 1,
       "type": "string"
      },
      "surfaceAreaM2": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "use": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "cadastralReference",
      "rc14"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   },
   "contract": {
    "const": "agent-api-1.1.0",
    "type": "string"
   },
   "evaluationScope": {
    "anyOf": [
     {
      "enum": [
       "building",
       "dwelling"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "ieeAvailability": {
    "anyOf": [
     {
      "enum": [
       "available",
       "none",
       "not_integrated",
       "unverified"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "language": {
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "notice": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "resolutionExpiresInSeconds": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "resolutionToken": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "resolved",
     "select_unit",
     "not_found",
     "unconfirmed"
    ],
    "type": "string"
   }
  },
  "required": [
   "contract",
   "language",
   "status",
   "evaluationScope",
   "building",
   "candidates",
   "resolutionToken",
   "resolutionExpiresInSeconds",
   "ieeAvailability",
   "availableTiers",
   "notice"
  ],
  "type": "object"
 },
 "title": "Identify the building or flat to report on"
}
