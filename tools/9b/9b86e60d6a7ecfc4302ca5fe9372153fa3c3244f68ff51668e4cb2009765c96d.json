{
 "description": "\ucc44\uc6a9 \uac8c\uc2dc\uae00\uc758 \uad6c\uc870\ud654 \ub370\uc774\ud130\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4 (admin \uc804\uc6a9). post_as_persona \uc9c1\ud6c4 \ud638\ucd9c\ud558\uc138\uc694. \uae09\uc5ec\ub294 \uc6d0(KRW) \ub2e8\uc704 \uc815\uc218, \ube44\uacf5\uac1c\uba74 wage_type=\ud611\uc758 \ub85c \ubcf4\ub0b4\uace0 \uae08\uc561\uc740 \uc0dd\ub7b5\ud569\ub2c8\ub2e4.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "closes_at": {
    "description": "\ub9c8\uac10\uc77c ISO8601 (\uc54c\uba74)",
    "type": "string"
   },
   "contact_phone": {
    "maxLength": 30,
    "type": "string"
   },
   "employer_name": {
    "maxLength": 120,
    "type": "string"
   },
   "employment_type": {
    "description": "\uc815\uaddc\uc9c1/\uacc4\uc57d\uc9c1/\uc54c\ubc14 \ub4f1",
    "maxLength": 20,
    "type": "string"
   },
   "location_raw": {
    "description": "\uadfc\ubb34\uc9c0 \uc6d0\ubb38 (\uc608: '\uc81c\uc8fc\uc2dc \uc6a9\ub2f4\ub85c 97')",
    "type": "string"
   },
   "occupation": {
    "description": "\uc9c1\uc885 (\uc608: '\uc815\uc721\uc810 \ud310\ub9e4\u00b7\ub9e4\uc7a5\uad00\ub9ac')",
    "maxLength": 80,
    "type": "string"
   },
   "post_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "source_name": {
    "maxLength": 60,
    "type": "string"
   },
   "source_ref": {
    "maxLength": 120,
    "type": "string"
   },
   "source_url": {
    "format": "uri",
    "type": "string"
   },
   "wage_max_krw": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wage_min_krw": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wage_type": {
    "enum": [
     "\uc2dc\uae09",
     "\uc77c\uae09",
     "\uc6d4\uae09",
     "\uc5f0\ubd09",
     "\ud611\uc758"
    ],
    "type": "string"
   },
   "work_hours_text": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "post_id",
   "location_raw",
   "occupation",
   "wage_type",
   "source_name"
  ],
  "type": "object"
 },
 "name": "upsert_job_listing"
}
