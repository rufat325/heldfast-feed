{
 "description": "Update an existing Lovelace dashboard's properties (title, icon, etc.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dashboard_id": {
    "description": "The dashboard ID (numeric, from ha_list_dashboards)",
    "type": "string"
   },
   "icon": {
    "description": "New icon (e.g. 'mdi:tablet')",
    "type": "string"
   },
   "require_admin": {
    "description": "Whether to require admin access",
    "type": "boolean"
   },
   "show_in_sidebar": {
    "description": "Whether to show in sidebar",
    "type": "boolean"
   },
   "title": {
    "description": "New display title",
    "type": "string"
   }
  },
  "required": [
   "dashboard_id"
  ],
  "type": "object"
 },
 "name": "ha_update_dashboard"
}
