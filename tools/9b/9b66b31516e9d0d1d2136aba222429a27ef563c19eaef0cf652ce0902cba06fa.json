{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete the SSL certificate of a site (the site will fall back to no HTTPS or Infomaniak's default cert until a new one is requested). Two-phase commit. The plan pulls the current certificate status so the caller can see what is about to be removed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the first (plan) phase. Re-pass to execute. Omit to receive the plan + token. Undo afterwards by calling infomaniak_request_certificate with type='free'.",
    "format": "uuid",
    "type": "string"
   },
   "hosting_id": {
    "description": "Web hosting ID. Discover via infomaniak_find_site(domain) \u2192 hosting_id.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "site_id": {
    "description": "Site ID on that hosting. Same source as hosting_id.",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "site_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_delete_certificate",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "current_status": {
        "type": "string"
       },
       "hosting_id": {
        "type": "number"
       },
       "site_id": {
        "type": "number"
       }
      },
      "required": [
       "hosting_id",
       "site_id"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
