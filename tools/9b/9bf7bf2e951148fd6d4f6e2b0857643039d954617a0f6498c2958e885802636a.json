{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a calendar event"
 },
 "description": "Creates a calendar event (may send invites to participants). Requires calendar_id (sent as a query param). Nylas v3: POST /v3/grants/{grant_id}/events.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "calendar_id": {
    "description": "REQUIRED. The calendar id to create the event in (sent as a query param).",
    "type": "string"
   },
   "description": {
    "description": "Event description.",
    "type": "string"
   },
   "end_time": {
    "description": "Event end, Unix timestamp (seconds).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "grant_id": {
    "description": "Connected-account grant id. Overrides NYLAS_GRANT_ID for this call.",
    "type": "string"
   },
   "location": {
    "description": "Event location.",
    "type": "string"
   },
   "participants": {
    "description": "Participant email addresses (array of strings).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start_time": {
    "description": "Event start, Unix timestamp (seconds).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "Event title.",
    "type": "string"
   }
  },
  "required": [
   "calendar_id",
   "title",
   "start_time",
   "end_time"
  ],
  "type": "object"
 },
 "name": "nylas_create_event",
 "title": "Create a calendar event"
}
