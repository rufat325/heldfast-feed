{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start an in-memory SSE watch on the anonymous URL, or on a permanent slug with a Pro token. Call watch.wait next to receive the request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "slug": {
    "description": "Optional permanent slug such as billing. Omit to use this process's anonymous inspect URL. A named slug requires OPENWEBHOOK_TOKEN.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "watch.start",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "ephemeral": {
    "type": "boolean"
   },
   "hint": {
    "type": [
     "string",
     "null"
    ]
   },
   "ingestUrl": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "started": {
    "type": "boolean"
   },
   "watched": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "watching": {
    "type": "boolean"
   }
  },
  "required": [
   "watching",
   "ephemeral",
   "started",
   "watched"
  ],
  "type": "object"
 },
 "title": "Start watch"
}
