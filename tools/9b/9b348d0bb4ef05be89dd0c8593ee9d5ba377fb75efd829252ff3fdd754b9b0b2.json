{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare up to ten exact listing ids returned by match_listings using catalogue price, location and published marker facts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "listingIds": {
    "description": "Exact listing ids returned by match_listings, in display order.",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "location": {
    "description": "Irish town or Eircode used for the comparison.",
    "maxLength": 200,
    "type": "string"
   },
   "query": {
    "description": "Original catalogue search wording for display context.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "listingIds"
  ],
  "type": "object"
 },
 "name": "render_results",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "catalogueNotice": {
    "additionalProperties": false,
    "properties": {
     "clinicalSuitability": {
      "const": "not-assessed",
      "type": "string"
     },
     "exhaustiveCoverage": {
      "const": false,
      "type": "boolean"
     },
     "pricesLiveVerified": {
      "const": false,
      "type": "boolean"
     },
     "source": {
      "const": "compiled-public-catalogue",
      "type": "string"
     }
    },
    "required": [
     "source",
     "exhaustiveCoverage",
     "pricesLiveVerified",
     "clinicalSuitability"
    ],
    "type": "object"
   },
   "disclaimer": {
    "type": "string"
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "county": {
      "type": "string"
     },
     "eircode": {
      "type": "string"
     },
     "eircodeRoutingKey": {
      "type": "string"
     },
     "raw": {
      "type": "string"
     },
     "source": {
      "enum": [
       "eircode",
       "routing-key",
       "town",
       "address",
       "unknown"
      ],
      "type": "string"
     },
     "town": {
      "type": "string"
     }
    },
    "required": [
     "raw",
     "source"
    ],
    "type": "object"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "catalogueStatus": {
       "const": "published-example",
       "type": "string"
      },
      "category": {
       "type": "string"
      },
      "clinicName": {
       "type": "string"
      },
      "county": {
       "type": "string"
      },
      "eircode": {
       "type": "string"
      },
      "eircodeRoutingKey": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "locationMatch": {
       "enum": [
        "unknown",
        "eircode",
        "routingKey",
        "town",
        "serviceTown",
        "nearbyText",
        "county",
        "adjacentCounty",
        "addressText",
        "national",
        "none"
       ],
       "type": "string"
      },
      "markers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "markersPublished": {
       "type": "boolean"
      },
      "national": {
       "type": "boolean"
      },
      "panelId": {
       "type": "string"
      },
      "panelName": {
       "type": "string"
      },
      "priceEur": {
       "type": [
        "number",
        "null"
       ]
      },
      "priceNote": {
       "type": [
        "string",
        "null"
       ]
      },
      "provider": {
       "type": "string"
      },
      "providerRelationship": {
       "const": "no-partnership",
       "type": "string"
      },
      "score": {
       "additionalProperties": false,
       "properties": {
        "intent": {
         "type": "number"
        },
        "location": {
         "type": "number"
        },
        "total": {
         "type": "number"
        }
       },
       "required": [
        "total",
        "location",
        "intent"
       ],
       "type": "object"
      },
      "serviceMode": {
       "enum": [
        "home-kit",
        "clinic"
       ],
       "type": "string"
      },
      "serviceTowns": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "town": {
       "type": "string"
      },
      "venueNote": {
       "type": [
        "string",
        "null"
       ]
      },
      "why": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "catalogueStatus",
      "providerRelationship",
      "provider",
      "clinicName",
      "town",
      "county",
      "eircode",
      "eircodeRoutingKey",
      "serviceTowns",
      "national",
      "serviceMode",
      "venueNote",
      "panelName",
      "panelId",
      "priceEur",
      "priceNote",
      "category",
      "markersPublished",
      "markers",
      "locationMatch",
      "score",
      "why"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "query": {
    "type": "string"
   },
   "view": {
    "const": "results",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "view",
   "query",
   "matches",
   "catalogueNotice",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Compare blood tests"
}
