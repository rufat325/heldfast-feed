  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amountMinor": {
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "dueOn": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "scheduleId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "scheduleId",
   "amountMinor",
   "dueOn"
  ],
  "type": "object"
 },
 "name": "record_deposit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
