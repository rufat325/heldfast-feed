{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a parking/queue occupancy scaffold with zone occupancy, sensor maps, signage policy, adapter source, and privacy safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9071/parking",
    "type": "string"
   },
   "capacity": {
    "default": 500,
    "maximum": 250000,
    "minimum": 1,
    "type": "integer"
   },
   "lot_label": {
    "default": "main_lot",
    "type": "string"
   },
   "name": {
    "default": "parking_occupancy_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the parking scaffold.",
    "type": "string"
   },
   "provider": {
    "default": "iot_counter",
    "enum": [
     "camera_analytics",
     "iot_counter",
     "api_vendor",
     "manual"
    ],
    "type": "string"
   },
   "sensor_count": {
    "default": 12,
    "maximum": 512,
    "minimum": 0,
    "type": "integer"
   },
   "zone_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_parking_occupancy_bus",
 "title": "Connect parking occupancy bus"
}
