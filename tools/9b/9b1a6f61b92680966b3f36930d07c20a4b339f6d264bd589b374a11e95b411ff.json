{
 "description": "Browse an Open Label project's data catalog with compound filters (mediaKind IMAGE|VIDEO|AUDIO|TEXT|DOCUMENT|OTHER, taskStatus, reviewStatus, tag, search, uniquenessMax, sort incl. UNIQUENESS_ASC/SHARPNESS_ASC/BRIGHTNESS_ASC) plus facet counts. Requires open-label:read scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
