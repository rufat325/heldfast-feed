{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create an instant mood/vibe playlist from a template (focus, wind-down, gym, commute) composed from your existing listening data. Creates a new playlist and fills it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Playlist description override",
    "type": "string"
   },
   "dry_run": {
    "description": "Preview only: validate inputs and describe exactly what would change without performing it",
    "type": "boolean"
   },
   "limit": {
    "default": 30,
    "description": "How many tracks (1-100, default 30)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Playlist name (default: \"<Template> Mix\")",
    "type": "string"
   },
   "public": {
    "default": false,
    "description": "Whether the playlist is public",
    "type": "boolean"
   },
   "response_format": {
    "default": "concise",
    "description": "'concise' = human prose, 'detailed' = more fields in prose, 'json' = raw API object",
    "enum": [
     "concise",
     "detailed",
     "json"
    ],
    "type": "string"
   },
   "template": {
    "description": "Template name",
    "enum": [
     "focus",
     "wind-down",
     "gym",
     "commute"
    ],
    "type": "string"
   }
  },
  "required": [
   "template"
  ],
  "type": "object"
 },
 "name": "playlist_template_apply"
}
