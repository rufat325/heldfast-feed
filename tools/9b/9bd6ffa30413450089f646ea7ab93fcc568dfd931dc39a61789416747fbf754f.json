{
 "_meta": {
  "com.oxinsider/docs-group": "traders",
  "securitySchemes": [
   {
    "scopes": [
     "read",
     "export"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Trader Export Snapshot"
 },
 "description": "Read export source-range, completeness, volume reconciliation, row-count estimate, and large-export policy for one trader. Metadata only; does not start an export job.\n\nArgs:\n  - address (string, required): Trader wallet address, known username-style lookup, or trd_-prefixed trader ID emitted by the API. Bare integer database IDs are not accepted\n\nReturns: Trader export snapshot metadata.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Trader wallet address, known username-style lookup, or trd_-prefixed trader ID emitted by the API. Bare integer database IDs are not accepted",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_trader_export_snapshot",
 "outputSchema": {
  "$defs": {
   "ExportCompleteness": {
    "properties": {
     "reason": {
      "type": "string"
     },
     "status": {
      "enum": [
       "complete",
       "partial",
       "empty"
      ],
      "type": "string"
     },
     "sync_coverage": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "status",
     "reason",
     "sync_coverage"
    ],
    "type": "object"
   },
   "ExportCounts": {
    "properties": {
     "estimated_size_mb": {
      "type": "number"
     },
     "estimated_trade_rows": {
      "type": "integer"
     },
     "exported_markets": {
      "type": "integer"
     },
     "pnl_days": {
      "type": "integer"
     }
    },
    "required": [
     "pnl_days",
     "exported_markets",
     "estimated_trade_rows",
     "estimated_size_mb"
    ],
    "type": "object"
   },
   "ExportSourceRange": {
    "properties": {
     "first_pnl_date": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "last_pnl_date": {
      "anyOf": [
       {
        "format": "date",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "latest_market_activity_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "latest_trade_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "first_pnl_date",
     "last_pnl_date",
     "latest_trade_at",
     "latest_market_activity_at"
    ],
    "type": "object"
   },
   "ExportVolumeReconciliation": {
    "properties": {
     "activity_volume_coverage": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "exported_activity_volume": {
      "type": "number"
     },
     "exported_market_cost_basis": {
      "type": "number"
     },
     "provider_activity_volume_gap": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "provider_lifetime_volume": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "provider_lifetime_volume",
     "exported_activity_volume",
     "exported_market_cost_basis",
     "provider_activity_volume_gap",
     "activity_volume_coverage"
    ],
    "type": "object"
   },
   "LargeExportPolicy": {
    "properties": {
     "async_job": {
      "type": "object"
     },
     "current_internal_route": {
      "type": "string"
     },
     "direct_streaming": {
      "type": "object"
     },
     "mode": {
      "const": "v1_async_export",
      "type": "string"
     },
     "rate_limit": {
      "type": "object"
     },
     "v1_async": {
      "properties": {
       "cancel_route": {
        "type": "string"
       },
       "download_route": {
        "type": "string"
       },
       "formats": {
        "items": {
         "enum": [
          "json",
          "ndjson",
          "csv"
         ],
         "type": "string"
        },
        "type": "array"
       },
       "retention": {
        "type": "string"
       },
       "status_route": {
        "type": "string"
       },
       "status_values": {
        "items": {
         "enum": [
          "queued",
          "running",
          "ready",
          "failed",
          "reconcile_required",
          "expired",
          "cancel_requested",
          "cancelled"
         ],
         "type": "string"
        },
        "type": "array"
       },
       "submit_route": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "mode",
     "current_internal_route",
     "v1_async",
     "direct_streaming",
     "async_job",
     "rate_limit"
    ],
    "type": "object"
   },
   "ResponseMeta": {
    "properties": {
     "cache_age_s": {
      "type": "integer"
     },
     "cached": {
      "type": "boolean"
     },
     "category_skill_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_enriched_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_model_operationally_degraded": {
      "type": "boolean"
     },
     "category_skill_model_version": {
      "type": "string"
     },
     "category_skill_observation_started_at": {
      "format": "date-time",
      "type": "string"
     },
     "category_skill_platform": {
      "const": "polymarket",
      "type": "string"
     },
     "category_skill_scope": {
      "const": "observed_goldsky_primary_taker_fill",
      "type": "string"
     },
     "category_skill_source": {
      "enum": [
       "live",
       "partial",
       "degraded",
       "unavailable"
      ],
      "type": "string"
     },
     "category_skill_source_coverage": {
      "enum": [
       "partial_whale_threshold_fills",
       "graded_wallet_fills"
      ],
      "type": "string"
     },
     "category_skill_status_counts": {
      "properties": {
       "degraded": {
        "minimum": 0,
        "type": "integer"
       },
       "insufficient": {
        "minimum": 0,
        "type": "integer"
       },
       "live": {
        "minimum": 0,
        "type": "integer"
       },
       "stale": {
        "minimum": 0,
        "type": "integer"
       },
       "unknown": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "live",
       "insufficient",
       "stale",
       "unknown",
       "degraded"
      ],
      "type": "object"
     },
     "category_skill_taxonomy_version": {
      "type": "string"
     },
     "cost": {
      "type": "integer"
     },
     "directional_source": {
      "enum": [
       "live",
       "degraded"
      ],
      "type": "string"
     },
     "ranking_as_of": {
      "format": "date-time",
      "type": "string"
     },
     "ranking_generation": {
      "type": "integer"
     },
     "ranking_source": {
      "enum": [
       "live",
       "db_only"
      ],
      "type": "string"
     },
     "request_id": {
      "type": "string"
     }
    },
    "required": [
     "request_id",
     "cached",
     "cost"
    ],
    "type": "object"
   },
   "TraderExportSnapshot": {
    "properties": {
     "address": {
      "type": "string"
     },
     "completeness": {
      "$ref": "#/$defs/ExportCompleteness"
     },
     "counts": {
      "$ref": "#/$defs/ExportCounts"
     },
     "generated_at": {
      "format": "date-time",
      "type": "string"
     },
     "large_export_policy": {
      "$ref": "#/$defs/LargeExportPolicy"
     },
     "reconciliation": {
      "$ref": "#/$defs/ExportVolumeReconciliation"
     },
     "source_range": {
      "$ref": "#/$defs/ExportSourceRange"
     }
    },
    "required": [
     "address",
     "generated_at",
     "source_range",
     "completeness",
     "reconciliation",
     "counts",
     "large_export_policy"
    ],
    "type": "object"
   }
  },
  "anyOf": [
   {
    "allOf": [
     {
      "$ref": "#/$defs/TraderExportSnapshot"
     },
     {
      "properties": {
       "meta": {
        "$ref": "#/$defs/ResponseMeta"
       }
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ]
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "doc_url": {
        "type": "string"
       },
       "param": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "request_id": {
        "type": "string"
       },
       "retry_after_seconds": {
        "minimum": 0,
        "type": "integer"
       },
       "retry_at": {
        "type": "string"
       },
       "status": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "code"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "read",
    "export"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get Trader Export Snapshot"
}
