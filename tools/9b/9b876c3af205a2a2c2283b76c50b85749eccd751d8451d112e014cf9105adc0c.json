{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search messages"
 },
 "description": "Search messages across channels. Scope with a channel filter (filter, e.g. {\"type\":\"messaging\"}) plus EITHER a full-text `query` OR a `message_filter` object (e.g. {\"text\":{\"$q\":\"refund\"}}). GET /api/v2/chat/search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "filter": {
    "additionalProperties": {},
    "description": "Channel filter_conditions, e.g. {\"type\":\"messaging\"} or {\"members\":{\"$in\":[\"u1\"]}}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "limit": {
    "description": "Max results (<=100). Default 20.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "message_filter": {
    "additionalProperties": {},
    "description": "Message filter object, e.g. {\"text\":{\"$q\":\"refund\"}} or {\"attachments\":{\"$exists\":true}}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "next": {
    "description": "Pagination cursor returned by a previous search.",
    "type": "string"
   },
   "query": {
    "description": "Full-text search string. Provide this OR message_filter.",
    "type": "string"
   },
   "sort": {
    "description": "Sort spec for results.",
    "items": {
     "properties": {
      "direction": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "field": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "direction"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "filter"
  ],
  "type": "object"
 },
 "name": "stream_search_messages",
 "title": "Search messages"
}
