{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a standalone fiscal receipt (54-FZ). Supports payment and refund receipts with items, VAT codes, and customer contacts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customer_email": {
    "description": "Customer email for the receipt",
    "format": "email",
    "type": "string"
   },
   "customer_phone": {
    "description": "Customer phone (if no email)",
    "type": "string"
   },
   "items": {
    "description": "Receipt items/services",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "anyOf": [
        {
         "pattern": "^\\d+(\\.\\d{1,2})?$",
         "type": "string"
        },
        {
         "exclusiveMinimum": 0,
         "type": "number"
        }
       ],
       "description": "Unit price in rubles"
      },
      "description": {
       "description": "Item/service name",
       "type": "string"
      },
      "measure": {
       "description": "Measure, tag 2108 (default 'piece'; required for FFD 1.2 and Receipts-from-YooMoney)",
       "type": "string"
      },
      "payment_mode": {
       "description": "Payment mode, tag 1214 (default 'full_payment')",
       "type": "string"
      },
      "payment_subject": {
       "description": "Payment subject, tag 1212 (default 'commodity'; 'service' for services)",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "vat_code": {
       "description": "VAT code: 1=no VAT, 2=0%, 3=10%, 4=20%, 5=computed 10/110, 6=computed 20/120",
       "maximum": 6,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "description",
      "quantity",
      "amount",
      "vat_code"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "payment_id": {
    "description": "Payment ID (required for type=payment)",
    "type": "string"
   },
   "refund_id": {
    "description": "Refund ID (required for type=refund)",
    "type": "string"
   },
   "send": {
    "default": true,
    "description": "Send the receipt to the customer (required for a standalone receipt)",
    "type": "boolean"
   },
   "settlement_id": {
    "description": "Settlement ID (for linking)",
    "type": "string"
   },
   "settlements": {
    "description": "Settlements. If omitted \u2014 auto: one 'cashless' for the sum of items",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "anyOf": [
        {
         "$ref": "#/properties/items/items/properties/amount/anyOf/0"
        },
        {
         "$ref": "#/properties/items/items/properties/amount/anyOf/1"
        }
       ],
       "description": "Settlement amount"
      },
      "type": {
       "description": "Settlement type: cashless, prepayment, postpayment, consideration",
       "type": "string"
      }
     },
     "required": [
      "type",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "tax_system_code": {
    "description": "Tax system code, tag 1055 (1-6). Send only if the shop has multiple tax systems or uses FFD 1.2",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Receipt type",
    "enum": [
     "payment",
     "refund"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "items"
  ],
  "type": "object"
 },
 "name": "create_receipt",
 "title": "Create receipt"
}
