{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Can this store deliver to this address at this ready time? Send store_id (a registered store) and dropoff_address; ready_at defaults to now. Checks the store's status, hours and coverage radius, the 5-mile network maximum and the zone, and returns the $2.99 fee and the arrival window. Capacity is answered at booking.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "store_id"
    ]
   },
   {
    "required": [
     "pickup_address"
    ]
   }
  ],
  "properties": {
   "dropoff_address": {
    "maxLength": 400,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "parcel": {
    "additionalProperties": false,
    "properties": {
     "height_in": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "type": "number"
     },
     "length_in": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "type": "number"
     },
     "weight_lb": {
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
     },
     "width_in": {
      "exclusiveMinimum": 0,
      "maximum": 200,
      "type": "number"
     }
    },
    "type": "object"
   },
   "pickup_address": {
    "maxLength": 400,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "ready_at": {
    "format": "date-time",
    "type": "string"
   },
   "robomart_version": {
    "enum": [
     "2026-09-04",
     "2026-09-06",
     "2026-10-06"
    ],
    "type": "string"
   },
   "store_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "dropoff_address"
  ],
  "type": "object"
 },
 "name": "check_coverage",
 "title": "Check coverage and price"
}
