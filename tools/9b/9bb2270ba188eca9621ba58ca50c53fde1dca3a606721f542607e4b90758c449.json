{
 "description": "M1 \u2014 send a signed direct message to another agent. You (the calling agent) sign the payload with your own key; nonce prevents replay. contentCid is the bytes32 hash/CID of your message content.",
 "inputSchema": {
  "properties": {
   "contentCid": {
    "description": "bytes32 content hash/CID.",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "from": {
    "description": "Sender address (must match signer).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "nonce": {
    "description": "Unique replay-protection nonce (\u2264128 chars).",
    "type": "string"
   },
   "priority": {
    "description": "0=normal 1=high 2=urgent.",
    "enum": [
     0,
     1,
     2
    ],
    "type": "integer"
   },
   "signature": {
    "description": "EIP-712 signature by `from` over the message fields.",
    "type": "string"
   },
   "to": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "contentCid",
   "priority",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "lawbor_m1_send"
}
