{
 "description": "Create an Open RPC video batch. Supports text, image, transition, and reference generation when the selected model supports them. Recommended flow: list_models(type=video) -> get_model_help -> generate_video -> get_task_status using the returned batch_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "description": "Video aspect ratio, for example 16:9.",
    "type": "string"
   },
   "duration": {
    "description": "Video duration in seconds.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "generate_audio": {
    "default": false,
    "description": "Generate video audio when the selected model supports it.",
    "type": "boolean"
   },
   "generation_type": {
    "default": "text",
    "description": "Generation type: text, image, transition, or reference.",
    "type": "string"
   },
   "images": {
    "description": "Image URLs or local image paths for image, transition, or reference generation.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "model": {
    "description": "Video model id or API model key.",
    "minLength": 1,
    "type": "string"
   },
   "multi_clip": {
    "default": false,
    "description": "Generate multiple clips when the selected model supports it.",
    "type": "boolean"
   },
   "prompt": {
    "description": "Video generation prompt.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "resolution": {
    "description": "Video resolution, for example 720p.",
    "type": "string"
   },
   "style": {
    "description": "Video style when supported by the selected model.",
    "type": "string"
   },
   "watermark": {
    "default": false,
    "description": "Include a watermark when needed by the target account or environment.",
    "type": "boolean"
   }
  },
  "required": [
   "model",
   "prompt"
  ],
  "type": "object"
 },
 "name": "generate_video",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepted_count": {
    "description": "Number of accepted items.",
    "type": "number"
   },
   "accepted_credits": {
    "description": "Credits accepted by the batch.",
    "type": "number"
   },
   "batch_id": {
    "description": "Open RPC batch ID for get_task_status.",
    "type": "string"
   },
   "batch_status": {
    "description": "Initial batch status.",
    "type": "string"
   },
   "estimated_failed_credits": {
    "description": "Estimated credits for rejected items.",
    "type": "number"
   },
   "failed_count": {
    "description": "Number of rejected items.",
    "type": "number"
   },
   "items": {
    "description": "Per-item batch acceptance details.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accepted": {
       "type": "boolean"
      },
      "business_type": {
       "type": "number"
      },
      "code": {
       "anyOf": [
        {
         "type": [
          "number",
          "string"
         ]
        },
        {
         "type": "null"
        }
       ]
      },
      "message": {
       "type": [
        "string",
        "null"
       ]
      },
      "need_credits": {
       "type": "number"
      },
      "serial_no": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "business_type",
      "accepted",
      "serial_no",
      "need_credits",
      "status",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "description": "Human-readable next-step guidance.",
    "type": "string"
   },
   "success": {
    "const": true,
    "description": "Whether the batch request was accepted by Freebeat.",
    "type": "boolean"
   },
   "total_count": {
    "description": "Total number of submitted items.",
    "type": "number"
   }
  },
  "required": [
   "success",
   "batch_id",
   "batch_status",
   "total_count",
   "accepted_count",
   "failed_count",
   "accepted_credits",
   "estimated_failed_credits",
   "items",
   "message"
  ],
  "type": "object"
 }
}
