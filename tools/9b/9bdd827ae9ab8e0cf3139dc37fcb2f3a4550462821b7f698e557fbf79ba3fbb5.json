{
 "description": "Update a hosted concert's metadata.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "artist": {
    "description": "Artist name",
    "maxLength": 200,
    "type": "string"
   },
   "description": {
    "description": "Description",
    "maxLength": 2000,
    "type": "string"
   },
   "genre": {
    "description": "Genre",
    "maxLength": 100,
    "type": "string"
   },
   "image_prompt": {
    "description": "Cover image prompt",
    "maxLength": 1000,
    "type": "string"
   },
   "listen_links": {
    "description": "External platform links",
    "items": {
     "properties": {
      "label": {
       "description": "Display label (required if platform is \"other\")",
       "maxLength": 50,
       "type": "string"
      },
      "platform": {
       "description": "Platform key (suno, spotify, apple_music, soundcloud, bandcamp, youtube_music, youtube, tidal, amazon_music, deezer, udio, other)",
       "type": "string"
      },
      "url": {
       "description": "HTTPS URL",
       "format": "uri",
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "platform",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "mode": {
    "description": "Concert mode",
    "enum": [
     "loop",
     "scheduled"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Concert slug",
    "type": "string"
   },
   "title": {
    "description": "Concert title",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_concert"
}
