{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Persists partial W-7 intake answers while collecting them conversationally, so nothing is lost between sessions. Overwrites the previous draft \u2014 send everything gathered so far.",
 "inputSchema": {
  "properties": {
   "applicationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "draft": {
    "properties": {
     "countriesOfCitizenship": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "dateOfBirth": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
     },
     "email": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "type": "string"
     },
     "foreignAddress": {
      "properties": {
       "cityStateProvince": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "maxLength": 100,
        "minLength": 2,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "pattern": "^[A-Za-z0-9 -]*$",
        "type": "string"
       },
       "street": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "fullLegalName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "hadPriorItin": {
      "type": "boolean"
     },
     "hasSsnOrEligible": {
      "type": "boolean"
     },
     "hasValidPassportOrId": {
      "type": "boolean"
     },
     "mailingAddress": {
      "properties": {
       "cityStateProvince": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "maxLength": 100,
        "minLength": 2,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "pattern": "^[A-Za-z0-9 -]*$",
        "type": "string"
       },
       "street": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "message": {
      "maxLength": 2000,
      "type": "string"
     },
     "otherNamesUsed": {
      "maxLength": 255,
      "type": "string"
     },
     "phone": {
      "maxLength": 30,
      "minLength": 5,
      "pattern": "^[0-9+ ()\\-]+$",
      "type": "string"
     },
     "placeOfBirth": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "reasonForApplying": {
      "pattern": "^[a-h]$",
      "type": "string"
     },
     "usVisaExpiration": {
      "maxLength": 10,
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "usVisaNumber": {
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9 -]*$",
      "type": "string"
     },
     "usVisaNumberOnFile": {
      "type": "boolean"
     },
     "usVisaType": {
      "maxLength": 50,
      "type": "string"
     },
     "visitedUsOrHasVisa": {
      "type": "boolean"
     }
    },
    "required": [
     "mailingAddress"
    ],
    "type": "object"
   }
  },
  "required": [
   "applicationId",
   "draft"
  ],
  "type": "object"
 },
 "name": "itin_save_itin_intake_draft",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Save ITIN Intake Draft"
}
