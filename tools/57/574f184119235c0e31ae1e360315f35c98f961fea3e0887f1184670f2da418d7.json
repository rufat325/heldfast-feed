{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\u0423\u044f\u0437\u0432\u0438\u043c\u043e\u0441\u0442\u044c \u0438\u0437 \u0411\u0414\u0423 \u0424\u0421\u0422\u042d\u041a"},"description":"\u041a\u0430\u0440\u0442\u043e\u0447\u043a\u0430 \u0443\u044f\u0437\u0432\u0438\u043c\u043e\u0441\u0442\u0438 \u043d\u0430 cisoclub.ru \u043f\u043e \u0434\u0430\u043d\u043d\u044b\u043c \u0411\u0430\u043d\u043a\u0430 \u0434\u0430\u043d\u043d\u044b\u0445 \u0443\u0433\u0440\u043e\u0437 \u0424\u0421\u0422\u042d\u041a \u0420\u043e\u0441\u0441\u0438\u0438: \u043f\u043e \u043d\u043e\u043c\u0435\u0440\u0443 \u0411\u0414\u0423 (BDU:2026-14624) \u0438\u043b\u0438 CVE (CVE-2026-1234). \u0423\u0440\u043e\u0432\u0435\u043d\u044c \u043e\u043f\u0430\u0441\u043d\u043e\u0441\u0442\u0438, \u043e\u0446\u0435\u043d\u043a\u0430 CVSS, \u043d\u0430\u043b\u0438\u0447\u0438\u0435 \u044d\u043a\u0441\u043f\u043b\u043e\u0439\u0442\u0430, \u043e\u043f\u0438\u0441\u0430\u043d\u0438\u0435 \u0438 \u0430\u0434\u0440\u0435\u0441 \u043a\u0430\u0440\u0442\u043e\u0447\u043a\u0438.","inputSchema":{"properties":{"id":{"description":"\u041d\u043e\u043c\u0435\u0440 \u0411\u0414\u0423 (BDU:\u0413\u0413\u0413\u0413-NNNNN) \u0438\u043b\u0438 CVE (CVE-\u0413\u0413\u0413\u0413-N)","maxLength":40,"type":"string"}},"required":["id"],"type":"object"},"name":"cisoclub_get_vulnerability","outputSchema":{"properties":{"found":{"type":"boolean"},"results":{"items":{"properties":{"bdu_id":{"type":"string"},"cve":{"items":{"type":"string"},"type":"array"},"cvss":{"type":["number","null"]},"date":{"type":"string"},"exploit":{"type":"boolean"},"exploit_public":{"type":"boolean"},"full_text":{"type":"boolean"},"severity":{"type":"string"},"text":{"type":"string"},"title":{"type":"string"},"unfixed":{"type":"boolean"},"url":{"type":"string"}},"required":["bdu_id","title","url"],"type":"object"},"type":"array"}},"required":["found","results"],"type":"object"},"title":"\u0423\