{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Estimer une consommation de data"
 },
 "description": "Estime la consommation mensuelle de donn\u00e9es d\u2019un utilisateur (Go par mois, d\u00e9tail par usage et sources), \u00e0 partir des d\u00e9bits publi\u00e9s par les \u00e9diteurs (Teams, Zoom, Meet, Netflix, Spotify) et du poids m\u00e9dian d\u2019une page web. \u00c0 utiliser pour chiffrer un besoin avant de choisir un forfait. Tous les param\u00e8tres sont facultatifs. GPS, mails, cloud et partage de connexion : valeurs fournies par l\u2019utilisateur, aucun chiffre officiel. Estimation indicative. Source : https://comontel.fr/outils/estimateur-data.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "audio_call_hours_per_week": {
    "maximum": 80,
    "minimum": 0,
    "type": "number"
   },
   "cloud_gb_per_month": {
    "description": "Valeur relev\u00e9e par l\u2019utilisateur",
    "maximum": 500,
    "minimum": 0,
    "type": "number"
   },
   "email_mb_per_day": {
    "description": "Valeur relev\u00e9e par l\u2019utilisateur",
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "gps_hours_per_week": {
    "maximum": 80,
    "minimum": 0,
    "type": "number"
   },
   "gps_mb_per_hour": {
    "description": "Valeur relev\u00e9e par l\u2019utilisateur",
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   },
   "music_hours_per_week": {
    "maximum": 80,
    "minimum": 0,
    "type": "number"
   },
   "music_profile": {
    "description": "Qualit\u00e9 de la musique en streaming",
    "enum": [
     "spotify-normal",
     "spotify-high"
    ],
    "type": "string"
   },
   "streaming_hours_per_week": {
    "maximum": 80,
    "minimum": 0,
    "type": "number"
   },
   "streaming_profile": {
    "description": "Qualit\u00e9 de la vid\u00e9o en streaming",
    "enum": [
     "netflix-mobile",
     "netflix-sd",
     "netflix-hd"
    ],
    "type": "string"
   },
   "tethering_gb_per_month": {
    "description": "Valeur relev\u00e9e par l\u2019utilisateur",
    "maximum": 500,
    "minimum": 0,
    "type": "number"
   },
   "video_hours_per_week": {
    "maximum": 80,
    "minimum": 0,
    "type": "number"
   },
   "video_profile": {
    "description": "Service de visioconf\u00e9rence (Teams par d\u00e9faut)",
    "enum": [
     "teams-audio",
     "teams-video",
     "teams-group",
     "teams-screen",
     "zoom-video",
     "zoom-group",
     "meet-video",
     "meet-audio"
    ],
    "type": "string"
   },
   "web_pages_per_day": {
    "maximum": 2000,
    "minimum": 0,
    "type": "number"
   },
   "workdays_per_month": {
    "maximum": 31,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "estimate_data_usage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "La r\u00e9ponse ; null si l\u2019information demand\u00e9e n\u2019existe pas"
   },
   "provenance": {
    "type": "string"
   },
   "reviewed_at": {
    "description": "Derni\u00e8re v\u00e9rification (AAAA-MM-JJ)",
    "type": "string"
   },
   "source_url": {
    "description": "Page publique o\u00f9 l\u2019information est affich\u00e9e",
    "type": "string"
   },
   "status": {
    "description": "\u00ab inconnu \u00bb : ne jamais deviner ni compl\u00e9ter",
    "enum": [
     "valid\u00e9",
     "\u00e0 valider",
     "inconnu"
    ],
    "type": "string"
   },
   "updated_at": {
    "description": "Derni\u00e8re modification de la donn\u00e9e (AAAA-MM-JJ)",
    "type": "string"
   }
  },
  "required": [
   "data",
   "source_url",
   "updated_at",
   "reviewed_at",
   "provenance",
   "status"
  ],
  "type": "object"
 },
 "title": "Estimer une consommation de data"
}
