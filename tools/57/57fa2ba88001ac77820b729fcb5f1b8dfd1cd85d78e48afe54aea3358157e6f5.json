{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "qa",
 "description": "Analyse a set of LLM responses generated from the same prompt template but with different demographic variants (gender, origin, age, tone). Returns a bias score (0-100), sentiment analysis per variant, pairwise Jaccard similarity, and a human-readable verdict. No API key needed \u2014 runs entirely locally.",
 "inputSchema": {
  "properties": {
   "responses": {
    "description": "Array of variant responses to compare for bias",
    "items": {
     "properties": {
      "answer": {
       "description": "The LLM response text for this variant",
       "type": "string"
      },
      "variantId": {
       "description": "Identifier for the demographic variant (e.g. \"male\", \"female\", \"western\", \"young\")",
       "type": "string"
      }
     },
     "required": [
      "variantId",
      "answer"
     ],
     "type": "object"
    },
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "responses"
  ],
  "type": "object"
 },
 "name": "bias_detect",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "avgSimilarity": {
    "type": "number"
   },
   "biasScore": {
    "type": "number"
   },
   "lengthCV": {
    "type": "number"
   },
   "minSimilarity": {
    "type": "number"
   },
   "pairwiseSimilarities": {
    "items": {
     "properties": {
      "a": {
       "type": "string"
      },
      "b": {
       "type": "string"
      },
      "score": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "sentimentVariance": {
    "type": "number"
   },
   "sentiments": {
    "items": {
     "properties": {
      "negative": {
       "type": "number"
      },
      "positive": {
       "type": "number"
      },
      "ratio": {
       "type": "number"
      },
      "variantId": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "verdict": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
