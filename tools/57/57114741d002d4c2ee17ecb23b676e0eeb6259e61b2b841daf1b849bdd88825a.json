{
 "description": "Plan or confirm the canonical Project To-do RETURN with required feedback. Planning is no-write. A confirmed, eligible exhausted mastery return grants exactly one additional module run; there is no direct run-limit mutation. Confirmation requires confirmReturn=true and an idempotency key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "confirmReturn": {
    "const": true,
    "type": "boolean"
   },
   "expectedStatus": {
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "expectedSubmittedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotencyKey": {
    "description": "Required request idempotency key. Reuse it only for the identical operation.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "plan": {
    "const": true,
    "type": "boolean"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "reason"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_return_assignment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
