{
 "description": "Analyze layover quality for connecting flights. Reports connection time, risk level (tight/comfortable/long), and aircraft details.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cabinClass": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "departureDate": {
    "description": "Departure date (YYYY-MM-DD)",
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "maxResults": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "origin": {
    "description": "Departure airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departureDate"
  ],
  "type": "object"
 },
 "name": "analyze_layovers"
}
