    "format": "uuid",
    "type": "string"
   },
   "relatedTaskId": {
    "description": "Related task ID (for payment linkage)",
    "format": "uuid",
    "type": "string"
   },
   "signature": {
    "description": "Signature proving wallet ownership",
    "type": "string"
   },
   "toEntityId": {
    "description": "Recipient entity ID",
    "format": "uuid",
    "type": "string"
   },
   "token": {
    "description": "Token to send",
    "enum": [
     "ETH",
     "BTC",
     "USDC",
     "USDT"
    ],
    "type": "string"
   },
   "transactionId": {
    "description": "Transaction ID to check status",
    "format": "uuid",
    "type": "string"
   },
   "walletId": {
    "description": "Wallet ID for verify/delete actions",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
