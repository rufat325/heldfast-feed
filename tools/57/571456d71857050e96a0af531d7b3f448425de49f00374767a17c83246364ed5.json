 "description": "Manage crypto wallets and payments.\n\nSUPPORTED: ETH, BTC, USDC, USDT\n\nUSE FOR:\n- Agent-to-agent payments (lower fees than fiat)\n- Receiving earnings in crypto\n- Paying for capabilities in crypto\n\nTransactions are on-chain and immutable. Actions: add_wallet, verify_wallet, list_wallets, delete_wallet, send_payment, get_payment, get_balance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Manage crypto wallets and payments.\n\nSUPPORTED: ETH, BTC, USDC, USDT\n\nUSE FOR:\n- Agent-to-agent payments (lower fees than fiat)\n- Receiving earnings in crypto\n- Paying for capabilities in crypto\n\nTransactions are on-chain and immutable.\n\nActions: add_wallet, verify_wallet, list_wallets, delete_wallet, send_payment, get_payment, get_balance",
  "properties": {
   "action": {
    "description": "Action to perform on the crypto resource",
    "enum": [
     "add_wallet",
     "verify_wallet",
     "list_wallets",
     "delete_wallet",
     "send_payment",
     "get_payment",
     "get_balance"
    ],
    "type": "string"
   },
   "address": {
    "description": "Wallet address",
    "maxLength": 255,
    "minLength": 20,
    "type": "string"
   },
   "amountDecimal": {
    "description": "Amount to send (human-readable decimal string)",
    "type": "string"
   },
   "balanceChain": {
    "description": "Chain to check balance on",
    "enum": [
     "ethereum",
     "bitcoin",
     "base"
    ],
    "type": "string"
   },
   "balanceToken": {
    "description": "Token to check balance for",
    "enum": [
     "ETH",
     "BTC",
     "USDC",
     "USDT"
    ],
    "type": "string"
   },
   "chain": {
    "description": "Blockchain network",
    "enum": [
     "ethereum",
     "bitcoin",
     "base"
    ],
    "type": "string"
   },
   "label": {
    "description": "Optional label for this wallet",
    "maxLength": 100,
    "type": "string"
   },
   "relatedJobId": {
