{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate tax on rental income"
 },
 "description": "Calculate UK income tax on rental profit for a landlord in a tax year, given rent, allowable expenses, mortgage interest (relieved as a 20% tax credit) and other income.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allowableExpenses": {
    "description": "Allowable expenses, not mortgage interest",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "grossRent": {
    "description": "Rent received in the year",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "mortgageInterestPaid": {
    "description": "Mortgage interest paid",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "otherIncome": {
    "description": "Other taxable income",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "taxYear": {
    "description": "UK tax year, e.g. \"2026-27\". Defaults to the current one.",
    "enum": [
     "2026-27",
     "2025-26",
     "2024-25"
    ],
    "type": "string"
   }
  },
  "required": [
   "grossRent"
  ],
  "type": "object"
 },
 "name": "calculate_rental_income_tax",
 "title": "Calculate tax on rental income"
}
