{
 "annotations": {
  "readOnlyHint": true,
  "title": "Places search"
 },
 "description": "Search for places (POIs) by category within an area, optionally filtered by name/conditions. Returns a GeoJSON FeatureCollection. Geoapify REST: GET /v2/places.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bias": {
    "description": "Bias results toward a location, e.g. 'proximity:13.4,52.5'.",
    "type": "string"
   },
   "categories": {
    "description": "Comma-separated Geoapify place categories, e.g. 'catering.restaurant,commercial' (required).",
    "minLength": 1,
    "type": "string"
   },
   "conditions": {
    "description": "Comma-separated conditions, e.g. 'named,internet_access'.",
    "type": "string"
   },
   "filter": {
    "description": "Spatial filter, e.g. 'circle:13.4,52.5,1000' or 'rect:...' or 'place:<placeId>'.",
    "type": "string"
   },
   "lang": {
    "description": "Result language as an ISO 639-1 code, e.g. 'en', 'de', 'fr'.",
    "type": "string"
   },
   "limit": {
    "description": "Max number of results to return.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Filter places by (partial) name.",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset (skip N results).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "categories"
  ],
  "type": "object"
 },
 "name": "geoapify_places",
 "title": "Places search"
}
