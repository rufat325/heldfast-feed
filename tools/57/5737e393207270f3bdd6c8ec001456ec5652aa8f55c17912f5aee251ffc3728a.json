{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Add or subtract days, weeks, months or years from any date to get the exact date and weekday \u2013 like 90 days from today. Leap years and month ends handled. Web page: https://calcbright.com/date-calculator",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "days": {
    "default": 90,
    "description": "Days",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "months": {
    "default": 0,
    "description": "Months",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "op": {
    "default": "add",
    "description": "Operation",
    "enum": [
     "add",
     "subtract"
    ],
    "type": "string"
   },
   "start": {
    "description": "Start date Leave empty to start from today. (YYYY-MM-DD)",
    "format": "date",
    "type": "string"
   },
   "weeks": {
    "default": 0,
    "description": "Weeks",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "years": {
    "default": 0,
    "description": "Years",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "date_calculator",
 "title": "Date Calculator"
}
