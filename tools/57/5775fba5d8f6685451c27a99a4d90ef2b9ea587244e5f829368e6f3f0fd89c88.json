 "description": "Shows the Bus Details sheet for one trip from search_buses: amenities (iconified), pickup and dropping points with times, cancellation-policy slabs, rating, and a Book on Paytm Checkin CTA. This is the source for amenities, boarding/dropping points, cancellation policy, or details for a specific bus, including a tap on a bus card in the widget. The tripRef from the card is enough, without a new search_buses call. Required: trip_ref, the opaque tripRef from the prior search_buses card, matched exactly. Optional: summary (the card's AI summary line) and booking_url (the card's Paytm hand-off link). No seat map or payment in chat \u2014 booking continues on Paytm Checkin.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "booking_deeplink": {
    "default": "",
    "description": "Optional H5/mweb/app deeplink (`paytmtr://bus-seat`).",
    "type": "string"
   },
   "booking_url": {
    "default": "",
    "description": "Optional Paytm Checkin seat URL from the search card (dweb).",
    "type": "string"
   },
   "summary": {
    "default": "",
    "description": "Optional AI summary line already shown on the card, so the\ndetails sheet shows the same line.",
    "type": "string"
   },
   "trip_ref": {
    "description": "Opaque trip token from search_buses (`tripRef` on each card).",
    "type": "string"
   }
  },
  "required": [
   "trip_ref"
  ],
  "type": "object"
 },
