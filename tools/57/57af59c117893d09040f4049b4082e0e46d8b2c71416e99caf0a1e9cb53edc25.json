      "sourceRegister",
      "sourceCheckedAt",
      "profileUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "requestedLocation": {
    "type": [
     "string",
     "null"
    ]
   },
   "resolvedArea": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "path": {
      "format": "uri",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
