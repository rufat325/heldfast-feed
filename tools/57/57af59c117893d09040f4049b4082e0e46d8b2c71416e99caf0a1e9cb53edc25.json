     "additionalProperties": false,
     "properties": {
      "location": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "region": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "region",
      "location"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "coverageNote": {
    "type": "string"
   },
   "listings": {
