     "properties": {
      "accreditations": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "claimed": {
       "type": "boolean"
      },
      "location": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "profileUrl": {
       "format": "uri",
       "type": "string"
      },
      "publicReference": {
       "description": "Public directory listing slug for get_trader.",
       "type": "string"
      },
      "sourceCheckedAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "sourceRegister": {
       "type": [
        "string",
        "null"
       ]
      },
      "trade": {
       "type": "string"
      }
     },
     "required": [
