{
 "description": "Create a promotion coupon code",
 "inputSchema": {
  "properties": {
   "expirationIntervalPerUse": {
    "description": "Time between uses (ISO 8601 duration)",
    "type": "string"
   },
   "isArchived": {
    "description": "Archived state (default false)",
    "type": "boolean"
   },
   "maxItemsPerClient": {
    "description": "Max usage per customer (0 = unlimited)",
    "type": "number"
   },
   "promotionId": {
    "description": "Promotion ID this coupon is tied to",
    "type": "string"
   },
   "utmSource": {
    "description": "Coupon code / UTM source (what the customer types)",
    "type": "string"
   }
  },
  "required": [
   "utmSource",
   "promotionId"
  ],
  "type": "object"
 },
 "name": "create_coupon"
}
