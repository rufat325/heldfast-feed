{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Retired: QFactory skill package"
 },
 "description": "Retired. Returns the current QFactory skill package and verified catalog facts for clients without the QFactory plugin. Input fields other than revision, expectedSha256, section and id are ignored.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent": {
    "enum": [
     "codex",
     "claude",
     "cursor",
     "other"
    ],
    "type": "string"
   },
   "expectedSha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "id": {
    "pattern": "^[a-z0-9][a-z0-9-]{0,99}$",
    "type": "string"
   },
   "installedCore": {
    "anyOf": [
     {
      "maxLength": 80,
      "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[a-z0-9.-]+)?$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "mode": {
    "enum": [
     "start",
     "setup",
     "use",
     "adapt",
     "create"
    ],
    "type": "string"
   },
   "os": {
    "enum": [
     "darwin",
     "linux",
     "win32"
    ],
    "type": "string"
   },
   "provider": {
    "default": "caller",
    "enum": [
     "caller",
     "openrouter"
    ],
    "type": "string"
   },
   "registryPin": {
    "additionalProperties": false,
    "properties": {
     "catalog": {
      "maxLength": 200,
      "type": "string"
     },
     "catalogSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "release": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
     }
    },
    "required": [
     "release",
     "catalog",
     "catalogSha256"
    ],
    "type": "object"
   },
   "revision": {
    "pattern": "^[a-z0-9][a-z0-9.-]{0,79}$",
    "type": "string"
   },
   "section": {
    "enum": [
     "workflows",
     "components",
     "demos"
    ],
    "type": "string"
   },
   "step": {
    "default": "prepare",
    "enum": [
     "prepare",
     "execute",
     "verify",
     "resume"
    ],
    "type": "string"
   }
  },
  "required": [
   "mode",
   "installedCore",
   "agent",
   "os"
  ],
  "type": "object"
 },
 "name": "instructions",
 "title": "Retired: QFactory skill package"
}
