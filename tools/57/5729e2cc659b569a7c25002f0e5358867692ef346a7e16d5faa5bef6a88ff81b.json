{
 "description": "Verify a PDF's embedded Omitly audit report and trailing Ed25519 tamper-evidence seal \u2014 on-device, nothing uploaded. Distinct from `verify_redaction`: that tool re-checks whether redacted regions are still empty; this tool cryptographically checks whether the delivered bytes have changed since they were sealed. The seal proves INTEGRITY, NOT IDENTITY: the signing key is per-install and travels with the file, so a valid seal means 'unchanged since sealed by the holder of this key', never 'produced by Omitly'. Compare `sealFingerprint` out-of-band against the fingerprint the sender published if origin matters. Requires a configured native engine \u2014 there is no wasm seal-verification path, so this always needs OMITLY_ENGINE_DIR/OMITLY_REDACT_BIN. A `seal_unsupported_version` verdict means this verifier is too old to check the seal at all \u2014 that is neither a pass nor a fail; update the verifier rather than trusting or rejecting the file on that basis.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pdfPath": {
    "description": "absolute path to the PDF to check for an Omitly audit report and seal",
    "type": "string"
   }
  },
  "required": [
   "pdfPath"
  ],
  "type": "object"
 },
 "name": "verify_seal",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allPassed": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "carriesAuditReport": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "decisionChannel": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputSha256": {
    "type": [
     "string",
     "null"
    ]
   },
   "licenseProvenance": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "licenseId": {
        "type": "string"
       },
       "licensedTo": {
        "type": "string"
       },
       "product": {
        "type": "string"
       },
       "reason": {
        "type": [
         "string",
         "null"
        ]
       },
       "valid": {
        "type": "boolean"
       }
      },
      "required": [
       "valid",
       "licenseId",
       "licensedTo",
       "product",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "metadataScrubbed": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "outputFilename": {
    "type": [
     "string",
     "null"
    ]
   },
   "outputSha256": {
    "type": [
     "string",
     "null"
    ]
   },
   "pageCount": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "regionCount": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "sealFingerprint": {
    "type": [
     "string",
     "null"
    ]
   },
   "sealValid": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "sealVersion": {
    "type": [
     "string",
     "null"
    ]
   },
   "sourceFilename": {
    "type": [
     "string",
     "null"
    ]
   },
   "verdict": {
