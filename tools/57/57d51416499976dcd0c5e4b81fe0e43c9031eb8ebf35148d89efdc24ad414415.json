{
 "description": "System tool namespace for console commands and asset validation actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to execute inside tool namespace manage_system",
    "enum": [
     "console_command",
     "get_console_variable",
     "validate_assets"
    ],
    "type": "string"
   },
   "params": {
    "anyOf": [
     {
      "additionalProperties": false,
      "description": "Parameters for manage_system.console_command",
      "properties": {
       "command": {
        "type": "string"
       }
      },
      "required": [
       "command"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "description": "Parameters for manage_system.get_console_variable",
      "properties": {
       "console_variable": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "variable_name": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "additionalProperties": false,
      "description": "Parameters for manage_system.validate_assets",
      "properties": {
       "asset_paths": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        ]
       },
       "paths": {
        "$ref": "#/properties/params/anyOf/2/properties/asset_paths"
       }
      },
      "type": "object"
     }
    ],
    "description": "Parameters for the selected manage_system action. Supported actions: manage_system.console_command, manage_system.get_console_variable, manage_system.validate_assets."
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_system"
}
