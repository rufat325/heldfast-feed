{"_meta":{"anthropic/maxResultSizeChars":150000},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Find spoken instances of words or a phrase across official videos and White House transcripts.\n\n        Returns one small page: counts for the whole result, then up to 5 videos (newest first, or most instances\n        first with sort=\"most_instances\"), each with up to 3 passages (quotes; overlapping instances merged), each\n        passage listing its instances with citation id and share_url. `notes` and `more_passages` say what else\n        there is: use `next_cursor` for more videos, govtube_list_video_instances for the rest of one video, and\n        detail=\"full\" for larger pages. White House transcripts have no timing (`timing_granularity` \"document\",\n        null times, a `position` and a `document_url`).\n        ","inputSchema":{"properties":{"cursor":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"next_cursor from the previous page of the same search (same query and filters).","title":"Cursor"},"date_from":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null,"description":"Earliest event date, YYYY-MM-DD.","title":"Date From"},"date_to":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null,"description":"Latest event date, YYYY-MM-DD.","title":"Date To"},"detail":{"default":"compact","description":"compact (default): small pages, passages only. full: the larger pages of the REST API (default 10 videos x 5), with every instance listed one by one as well as in passages.","enum":["compact","full"],"title":"Detail","type":"string"},"include_unreviewed":{"default":false,"description":"With speaker: also return moments where that person was named from the on-screen caption and nobody has reviewed the name yet. They are labelled 'matched from on-screen name, not reviewed'; say so when you quote them.","title":"Include Unreviewed","type":"boolean"},"max_instances_per_video":{"anyOf":[{"maximum":20,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"description":"Passages per video, 1 to 20 (with detail=\"full\", also instances). Default 3, or 5 with detail=\"full\".","title":"Max Instances Per Video"},"max_videos":{"anyOf":[{"maximum":25,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"description":"Videos per page, 1 to 25. Default 5, or 10 with detail=\"full\".","title":"Max Videos"},"playable_only":{"default":false,"description":"true: only results with playable video; transcript-only results (no video) are left out and counted in counts.transcript_only.","title":"Playable Only","type":"boolean"},"query":{"description":"Words to find. Put an exact phrase in double quotes: \"no tax on tips\". Unquoted words must occur within 8 words of each other.","title":"Query","type":"string"},"sort":{"default":"newest","description":"newest (default): event date, newest first; on the same day, video sessions before official transcripts. most_instances: most instances first; check order_exact in the response.","enum":["newest","most_instances"],"title":"Sort","type":"string"},"source":{"anyOf":[{"enum":["house_floor_clerk","senate_floor_and_committees","govinfo_dcpd","govinfo_crec","us_gov_youtube"],"type":"string"},{"type":"null"}],"default":null,"description":"Only one source: house_floor_clerk (U.S. House floor), senate_floor_and_committees (U.S. Senate floor and committee hearings), govinfo_dcpd (White House transcripts, no video timing), govinfo_crec (Congressional Record, House and Senate speeches as printed, no video timing) or us_gov_youtube (official U.S. government YouTube channels; see source_caveats). A source can hold nothing yet: govtube_get_coverage lists what each one holds.","title":"Source"},"speaker":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"description":"Bioguide ID of a member of Congress, e.g. 'C001053' (Rep. Tom Cole). Matches speakers a person has confirmed. Names matched only from the on-screen caption are left out (the result counts them in unreviewed_excluded) unless include_unreviewed is true. Omit to search everyone.","examples":["C001053"],"title":"Speaker"}},"required":["query"],"title":"search_instancesArguments","type":"object"},"name":"govtube_search_instances","outputSchema":{"$defs":{"CountPart":{"properties":{"exact":{"type":"boolean"},"instances":{"type":"integer"},"videos":{"type":"integer"}},"required":["instances","videos","exact"],"type":"object"},"Counts":{"properties":{"by_timing":{"additionalProperties":{"type":"integer"},"type":"object"},"exact":{"type":"boolean"},"instances":{"type":"integer"},"playable":{"$ref":"#/$defs/CountPart"},"transcript_only":{"$ref":"#/$defs/CountPart"},"videos":{"type":"integer"}},"required":["instances","videos","exact","playable","transcript_only"],"type":"object"},"DocumentPosition":{"properties":{"paragraph":{"minimum":1,"type":"integer"},"word":{"minimum":1,"type":"integer"}},"required":["paragraph","word"],"type":"object"},"Excerpt":{"properties":{"boundary":{"enum":["sentence","clause","window"],"type":"string"},"end_ms":{"anyOf":[{"type":"integer"},{"type":"null"}]},"highlight":{"items":{"$ref":"#/$defs/MatchSpan"},"type":"array"},"match":{"items":{"$ref":"#/$defs/MatchSpan"},"type":"array"},"start_ms":{"anyOf":[{"type":"integer"},{"type":"null"}]},"text":{"type":"string"},"truncated_after":{"default":false,"type":"boolean"},"truncated_before":{"default":false,"type":"boolean"}},"required":["text","match","start_ms","end_ms","boundary"],"type":"object"},"MatchSpan":{"properties":{"end":{"type":"integer"},"start":{"type":"integer"}},"required":["start","end"],"type":"object"},"McpInstance":{"properties":{"caption_check":{"default":"not_checked","enum":["agrees","differs","not_checked"],"type":"string"},"document_highlight_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"document_url":{"anyOf":[{"type":"string"}