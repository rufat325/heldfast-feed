{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "dododentist:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find free appointment times"
 },
 "description": "Use this when someone asks when their dental practice has free appointment times or the next available slot. Returns each open online-booking slot's start and end, grouped by day, for the next days with openings: up to 7 days and 100 slots (no patient or dentist details). Not for booking or holding a slot.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Practice id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "get_clinic_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "One row per day with open online-booking slots, in date order, holding at most 100 slots in total. Slot times only; patients, dentists, treatments and clinical data are never included.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "day": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "slots": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "endTime": {
          "maxLength": 32,
          "type": "string"
         },
         "startTime": {
          "maxLength": 32,
          "type": "string"
         }
        },
        "required": [
         "startTime",
         "endTime"
        ],
        "type": "object"
       },
       "maxItems": 100,
       "type": "array"
      }
     },
     "required": [
      "day",
      "slots"
     ],
     "type": "object"
    },
    "maxItems": 7,
    "type": "array"
   }
  },
  "required": [
   "days"
  ],
  "type": "object"
 },
 "title": "Find free appointment times"
}
