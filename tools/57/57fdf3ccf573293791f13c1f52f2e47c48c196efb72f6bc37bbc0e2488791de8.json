{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lista medicamentos filtrados pelo tipo de tarja. LIVRE: venda sem receita. VERMELHA: requer receita m\u00e9dica simples (reten\u00e7\u00e3o). PRETA: controle especial (psicotr\u00f3picos, entorpecentes). Nota: a API da ANVISA n\u00e3o exp\u00f5e filtro direto por tarja na listagem; use consultar_bula para confirmar a tarja de um medicamento espec\u00edfico.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "pagina": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "tarja": {
    "description": "Tipo de tarja: LIVRE (venda livre), VERMELHA (reten\u00e7\u00e3o de receita), PRETA (controle especial)",
    "enum": [
     "LIVRE",
     "VERMELHA",
     "PRETA"
    ],
    "type": "string"
   }
  },
  "required": [
   "tarja"
  ],
  "type": "object"
 },
 "name": "filtrar_por_tarja",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": false,
    "properties": {
     "data_da_base": {
      "description": "ISO 8601 da \u00faltima atualiza\u00e7\u00e3o da base consultada",
      "type": "string"
     },
     "defasagem_dias": {
      "description": "Dias desde data_da_base",
      "type": "number"
     },
     "fonte": {
      "description": "Identifica\u00e7\u00e3o da fonte que respondeu (ex: anvisa_api, cache_local)",
      "type": "string"
     },
     "modo": {
      "enum": [
       "cache_local",
       "online"
      ],
      "type": "string"
     },
     "status": {
      "description": "'stale' quando defasagem > 30 dias",
      "enum": [
       "ok",
       "stale"
      ],
      "type": "string"
     }
    },
    "required": [
     "data_da_base",
     "fonte",
     "defasagem_dias",
     "modo"
    ],
    "type": "object"
   },
   "data": {
    "additionalProperties": false,
    "properties": {
     "medicamentos": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "dataAtualizacao": {
         "type": "string"
        },
        "empresa": {
         "type": "string"
        },
        "idBulaPacienteProtegido": {
         "type": "string"
        },
        "idBulaProfissionalProtegido": {
         "type": "string"
        },
        "nomeProduto": {
         "type": "string"
        },
        "numProcesso": {
         "type": "string"
        }
       },
       "required": [
        "numProcesso",
        "nomeProduto",
        "empresa"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "pagina": {
      "type": "number"
     },
     "total": {
      "description": "N\u00famero de resultados retornados nesta p\u00e1gina",
      "type": "number"
     }
    },
    "required": [
     "total",
     "pagina",
     "medicamentos"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "_meta"
  ],
  "type": "object"
 },
 "title": "Filtrar Medicamentos por Tarja"
}
