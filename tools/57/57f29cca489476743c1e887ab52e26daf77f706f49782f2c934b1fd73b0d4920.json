{
 "description": "Diagnose an x402 Base USDC payment challenge against an explicitly authorized payee allowlist and spending cap. Never signs or buys. Costs $0.001 USDC on Base via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowed_payees": {
    "items": {
     "pattern": "^0x[a-fA-F0-9]{40}$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "challenge": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "max_atomic_usdc": {
    "type": "string"
   },
   "supported_schemes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "challenge",
   "max_atomic_usdc",
   "allowed_payees"
  ],
  "type": "object"
 },
 "name": "x402-payment-diagnostic"
}
