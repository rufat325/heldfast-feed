{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Random Sequence"
 },
 "description": "Generate a random DNA, RNA or protein sequence, optionally with a target GC content.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "gcContent": {
    "description": "Target GC percentage 0..100 (dna/rna only); omit for uniform.",
    "type": "number"
   },
   "kind": {
    "default": "dna",
    "enum": [
     "dna",
     "rna",
     "protein"
    ],
    "type": "string"
   },
   "length": {
    "default": 100,
    "description": "Number of residues to generate.",
    "type": "integer"
   }
  },
  "required": [
   "length"
  ],
  "type": "object"
 },
 "name": "random_sequence",
 "title": "Random Sequence"
}
