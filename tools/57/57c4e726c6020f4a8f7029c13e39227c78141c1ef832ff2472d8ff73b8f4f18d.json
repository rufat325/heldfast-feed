{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "campaign.create"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create campaign"
 },
 "description": "Create a new Argo campaign. The current user becomes GM and the calling token gains read+write access to the new campaign immediately (no re-consent needed). Requires the campaign.create OAuth scope, granted at consent time.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignName": {
    "description": "Display name of the campaign.",
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Short description of the campaign's setting, tone, and premise.",
    "minLength": 1,
    "type": "string"
   },
   "gameSystemSlug": {
    "description": "Optional explicit slug for the public URL (e.g. 'dnd5e'). If omitted, the server derives one from ruleSystem.",
    "type": "string"
   },
   "ruleSystem": {
    "description": "Rule system the campaign uses. E.g. 'Dungeons & Dragons 5e', 'Pathfinder 2e', 'Forbidden Lands'. Free-form; the WebAPI derives the slug from this.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaignName",
   "description",
   "ruleSystem"
  ],
  "type": "object"
 },
 "name": "create_campaign",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessLevel": {
    "type": [
     "string",
     "null"
    ]
   },
   "campaignDescription": {
    "type": [
     "string",
     "null"
    ]
   },
   "campaignName": {
    "type": "string"
   },
   "coGameMasterIds": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "gameMasterId": {
    "type": "string"
   },
   "gameSystemSlug": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "ruleSystem": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "gameMasterId",
   "campaignName"
  ],
  "type": "object"
 },
 "title": "Create campaign"
}
