  "readOnlyHint": true,
  "title": "Get Hotel Detail (by propertyId / OpenTravel-direct)"
 },
 "description": "Prices and availability for one OpenTravel direct-listed hotel over a date range, with its photos, amenities and room types, each room with its rate plan and total price. Takes the propertyId from search results (source 'OPENTRAVEL_DIRECT'), or a hotel name plus city for a known direct listing. get_hotel_info returns the same hotel's static facts without dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 2,
    "description": "Number of adults (default 2)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "checkIn": {
    "description": "Check-in date YYYY-MM-DD. Must be today or later.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkOut": {
    "description": "Check-out date YYYY-MM-DD. Must be after checkIn.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Number of children (default 0)",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "city": {
    "description": "City of the hotel \u2014 required when resolving by hotelName.",
    "maxLength": 100,
    "type": "string"
   },
   "hotelName": {
    "description": "Fallback name for a confirmed OpenTravel direct listing when propertyId is unavailable",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "description": "Preferred UI language (en/vi/de/ja/ko/zh/fr/es/ru/th/id).",
    "enum": [
     "en",
     "vi",
     "de",
     "ja",
     "ko",
     "zh",
     "fr",
     "es",
     "ru",
     "th",
     "id"
    ],
    "type": "string"
   },
   "propertyId": {
    "description": "OpenTravel propertyId UUID from search results (opentravelResults[].propertyId).",
    "maxLength": 200,
    "type": "string"
   },
   "queryText": {
    "description": "Optional short excerpt of the current request, used only to detect the UI language; it is not stored or forwarded.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "checkIn",
   "checkOut"
  ],
  "type": "object"
 },
 "name": "get_hotel_detail",
