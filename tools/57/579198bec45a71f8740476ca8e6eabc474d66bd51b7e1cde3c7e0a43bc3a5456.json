{
 "description": "Search the Agent Switchboard directory of vetted AI agents, MCP servers, and agentic tools. Returns relevance-ranked matches. Filter by category slug, access methods, and/or official (first-party listings from major vendors).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access": {
    "description": "Require ALL of these access methods (api, mcp, cli, browser-extension)",
    "items": {
     "enum": [
      "api",
      "mcp",
      "cli",
      "browser-extension"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "category": {
    "description": "Category slug, e.g. \"code-devtools\", \"voice-messaging\"",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results per page (1\u201350)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "official": {
    "description": "Only first-party listings from major vendors (e.g. Notion's own Notion MCP)",
    "type": "boolean"
   },
   "offset": {
    "default": 0,
    "description": "Number of results to skip, for pagination",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search (name, description, skills, tags)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_agents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agents": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessMethods": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "authType": {
       "type": "string"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "official": {
       "description": "First-party listing from a major vendor",
       "type": "boolean"
      },
      "officialVendor": {
       "type": [
        "string",
        "null"
       ]
      },
      "provider": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "verified": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "slug",
      "description",
      "provider",
      "categories",
      "accessMethods",
      "authType",
      "verified",
      "official",
      "officialVendor",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "type": "integer"
   },
   "offset": {
    "type": "integer"
   },
   "total": {
    "description": "Total matches before paging",
    "type": "integer"
   }
  },
  "required": [
   "total",
   "offset",
   "limit",
   "agents"
  ],
  "type": "object"
 },
 "title": "Search Agents"
}
