{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Service Schedule"
 },
 "description": "Create a bookable schedule window for a service, including recurring weekly/daily availability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "byWeekday": {
    "description": "Weekdays for weekly recurrence: 0=Mon, 1=Tue, ... 6=Sun",
    "items": {
     "maximum": 6,
     "minimum": 0,
     "type": "integer"
    },
    "type": "array"
   },
   "date": {
    "description": "Start date or one-off date (YYYY-MM-DD)",
    "type": "string"
   },
   "endTime": {
    "description": "HH:MM (24h)",
    "type": "string"
   },
   "maxCapacity": {
    "description": "Max bookings per generated slot",
    "type": "number"
   },
   "notes": {
    "description": "Free-form notes",
    "type": "string"
   },
   "recurrence": {
    "description": "Default none",
    "enum": [
     "none",
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   },
   "recurrenceEndDate": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "recurrenceInterval": {
    "description": "Default 1",
    "type": "number"
   },
   "resourceId": {
    "description": "Optional resource ID to bind this schedule to a room/resource",
    "type": "string"
   },
   "serviceId": {
    "description": "Service ID",
    "type": "string"
   },
   "staffId": {
    "description": "Optional companyMembers.id to bind this schedule to staff",
    "type": "string"
   },
   "startTime": {
    "description": "HH:MM (24h)",
    "type": "string"
   }
  },
  "required": [
   "serviceId",
   "date",
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "create_service_schedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
