{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update an existing Billy contact. Only provided fields are changed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cityText": {
    "description": "City name",
    "type": "string"
   },
   "contactNo": {
    "description": "Your own reference number",
    "type": "string"
   },
   "countryId": {
    "description": "Country code, e.g. 'DK'",
    "type": "string"
   },
   "id": {
    "description": "Contact ID to update",
    "type": "string"
   },
   "isArchived": {
    "description": "Archive/unarchive the contact",
    "type": "boolean"
   },
   "isCustomer": {
    "description": "Contact can receive invoices",
    "type": "boolean"
   },
   "isSupplier": {
    "description": "Contact can have bills",
    "type": "boolean"
   },
   "name": {
    "description": "Company or person name",
    "type": "string"
   },
   "phone": {
    "description": "Phone number",
    "type": "string"
   },
   "registrationNo": {
    "description": "VAT/CVR/tax registration number",
    "type": "string"
   },
   "street": {
    "description": "Street address",
    "type": "string"
   },
   "type": {
    "description": "Contact type",
    "enum": [
     "company",
     "person"
    ],
    "type": "string"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   },
   "zipcodeText": {
    "description": "Zip/postal code",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_contact"
}
