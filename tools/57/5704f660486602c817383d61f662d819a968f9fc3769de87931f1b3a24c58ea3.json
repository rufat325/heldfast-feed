{
 "_meta": {
  "ai.getemboss/agentic-access": {
   "action-class": "acting",
   "audience": "https://api.getemboss.ai",
   "audit": "required",
   "consequence": "write",
   "scope": [
    "forms:write"
   ],
   "subject": "required",
   "token": {
    "max-ttl": 3600,
    "x-api-key-lifetime": "until-revoked"
   },
   "x-billed": [
    "verify"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Check a filled form"
 },
 "description": "Check a filled form: required fields, allowed options, consistent choices, text that fits, empty signature boxes; returns complete, review required or incomplete. Give a form_id and the filled PDF (pdf_url: public https link, or pdf_base64). Billed as one verify; the first 5 each month are free.",
 "inputSchema": {
  "examples": [
   {
    "form_id": "11111111-2222-3333-4444-555555555555",
    "pdf_url": "https://example.com/filled/building-permit.pdf"
   }
  ],
  "properties": {
   "form_id": {
    "title": "Form Id",
    "type": "string"
   },
   "pdf_base64": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Pdf Base64"
   },
   "pdf_url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Pdf Url"
   }
  },
  "required": [
   "form_id"
  ],
  "title": "verify_formArguments",
  "type": "object"
 },
 "name": "verify_form",
 "outputSchema": {
  "additionalProperties": true,
  "title": "verify_formDictOutput",
  "type": "object"
 },
 "title": "Check a filled form"
}
