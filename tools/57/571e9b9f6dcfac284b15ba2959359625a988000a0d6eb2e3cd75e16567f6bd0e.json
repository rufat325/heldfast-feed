{"_meta":{"xdata.kr/credential":{"providers":["nhis_edi","nps_edi","comwel"],"register_url":"https://console.xdata.kr/credentials?link=1&priority=nhis_edi%2Cnps_edi%2Ccomwel","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"\uac74\uac15\ubcf4\ud5d8, \uad6d\ubbfc\uc5f0\uae08, \uace0\uc6a9\ubcf4\ud5d8 \uace0\uc9c0 \ub2e8\uacc4\ub97c \ubb36\uc5b4 \ubcf4\ud5d8\ub8cc \ud569\uacc4\ub97c \uacc4\uc0b0\ud574 \uc90d\ub2c8\ub2e4. \uae08\uc561\uc740 \uae30\uad00\uc774 \uc0ac\uc5c5\uc7a5\uc5d0 \uace0\uc9c0\ud55c \ud569\uacc4\uc774\uace0 \uadfc\ub85c\uc790 \ubaab\uacfc \uc0ac\uc5c5\uc8fc \ubaab\uc744 \ubaa8\ub450 \ub2f4\uc2b5\ub2c8\ub2e4(\uace0\uc6a9\ubcf4\ud5d8\uc740 \uc2e4\uc5c5\uae09\uc5ec \ubaab\ub9cc). \uadfc\ub85c\uc790 \uae09\uc5ec\uc5d0\uc11c \ub5bc\ub294 \uae08\uc561\uc774 \uc544\ub2c8\ubbc0\ub85c \uadfc\ub85c\uc790 \ubaab\uc740 \ub530\ub85c \uacc4\uc0b0\ud558\uc138\uc694. \uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8, \uad6d\ubbfc\uc5f0\uae08\uacf5\ub2e8, \uadfc\ub85c\ubcf5\uc9c0\uacf5\ub2e8 \uc138\uc158 \ub85c\uadf8\uc778\uc744 \uba3c\uc800 \ud574\uc57c \ud569\ub2c8\ub2e4. \uac04\uc774\uc138\uc561\ud45c\ub85c income_tax_won \uacfc local_income_tax_won \ub3c4 \ubc1b\uc73c\ub824\uba74 employees[](\ud589\ub9c8\ub2e4 monthly_pay_won \uacfc dependent_count)\ub97c \ub123\uac70\ub098, \uc9c1\uc6d0 \ud55c \uba85\uc774\uba74 monthly_pay_won \uacfc dependent_count \ub97c \ub123\uc2b5\ub2c8\ub2e4. \ub123\uc9c0 \uc54a\uc73c\uba74 \ub450 \uc138\uae08 \uce78\uc740 missing_fields \uc5d0 \ub0a8\uc2b5\ub2c8\ub2e4. \uad6d\ubbfc\uac74\uac15\ubcf4\ud5d8\uacf5\ub2e8\uc774 \uac19\uc740 \uace0\uc9c0(\uace0\uc9c0\ub144\uc6d4\uacfc \uace0\uc9c0\ucc28\uc218)\ub97c \uc791\uc131\ud68c\ucc28(WRT_CHASU)\ub97c \ub2ec\ub9ac\ud574 \uc5ec\ub7ec \ubc88 \ub0c8\uc73c\uba74 \uac00\uc7a5 \ucd5c\uadfc \ud68c\ucc28\ub97c \uc501\ub2c8\ub2e4. \ud589 \ud0a4\ub098 \uac70\ub974\ub294 \uc870\uac74\uc73c\ub85c \uace0\uc9c0\uac00 \ud558\ub098\ub85c \uc881\ud600\uc9c0\uc9c0 \uc54a\uc73c\uba74 \uc694\uc57d\ub9c8\ub2e4 \uadf8 \uae30\uad00\uc758 \uac00\uc7a5 \ucd5c\uadfc \uace0\uc9c0(\uac00\uc7a5 \ub2a6\uc740 \uace0\uc9c0\ub144\uc6d4, \uadf8 \uc548\uc5d0\uc11c \uac00\uc7a5 \ub2a6\uc740 \ucc28\uc218)\ub97c \uc501\ub2c8\ub2e4. \uc21c\uc704\uac00 \uac19\uc740 \uace0\uc9c0\uac00 \ub458\uc774\uac70\ub098 \uc2dc\uc810\uc744 \uc77d\uc744 \uc218 \uc5c6\ub294 \ud589\uc740 \uae30\uad00\ubcc4 \ud589 \ud0a4\ub85c \uac00\ub824 \uc8fc\uc9c0 \uc54a\uc73c\uba74 \uac74\ub108\ub701\ub2c8\ub2e4. account_link_id \ub294 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub2e8\uacc4\ub9c8\ub2e4 \uadf8 \uae30\uad00\uc758 \uc5f0\ub3d9\uc744 \uc2a4\uc2a4\ub85c \ucc3e\uc2b5\ub2c8\ub2e4. \uc5ec\ub7ec \uae30\uad00\uc758 \uc9c1\uc6d0 \ud589\uc744 \ud569\uce60 \ub54c\ub294 \uc774\ub984\uacfc \uc0ac\uc5c5\uc7a5\uc774 \ubaa8\ub450 \uac19\uc744 \ub54c\ub9cc \uac19\uc740 \uc9c1\uc6d0\uc73c\ub85c \ubd05\ub2c8\ub2e4. \uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638\ub294 \uc77c\ubd80\ub098 \uac00\ub9b0 \uac12\uc774\ub77c\ub3c4 \ub9de\ucd94\ub294 \uae30\uc900\uc73c\ub85c \uc4f0\uc9c0 \ub9c8\uc138\uc694. \uc774\ub984\uc774 \uac19\uc740 \uc0ac\ub78c\uc774 \ub458\uc774\uba74 \uc790\ub3d9\uc73c\ub85c \ud569\uce58\uc9c0 \ub9d0\uace0 \uc785\uc0ac\uc77c\uc774\ub098 \uae30\uad00\uc758 \uc9c1\uc6d0 \ubc88\ud638\ucc98\ub7fc \uad6c\ubcc4\ub418\ub294 \uac12\uc744 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ubb3c\uc5b4\ubcf4\uc138\uc694. \ud55c \uae30\uad00\uc5d0\ub9cc \uc788\ub294 \uc9c1\uc6d0\ub3c4 \ube7c\uc9c0 \ub9d0\uace0 \uadf8 \uae30\uad00\uc758 \uae08\uc561\ub9cc \ub530\ub85c \ubcf4\uc5ec \uc8fc\uc138\uc694. computed \uac00 null \uc774\uba74 \uacb0\uacfc\ub97c \ub9cc\ub4e4\uc9c0 \ubabb\ud55c \uac83\uc785\ub2c8\ub2e4. computed_error \uc5d0\uc11c \uae4c\ub2ed\uc744 \uc77d\uace0, \uacb0\uacfc\ub97c \ub2e4 \ub41c \uac83\ucc98\ub7fc \ubcf4\uc5ec \uc8fc\uc9c0 \ub9c8\uc138\uc694. \uc774 \uacbd\uc6b0\ub294 \ub450 \uaf34\ub85c \uc635\ub2c8\ub2e4. \ud558\ub098\ub294 partial \uc774 true \uc778 \uc774 \ubd09\ud22c\uc774\uace0(\uac00\uc838\uc62c \uac83\uc740 \ub2e4 \uac00\uc838\uc640 \uac01 \ub2e8\uacc4\uc5d0 \ub2f4\uc558\uc9c0\ub9cc \uacc4\uc0b0\ud558\uc9c0 \ubabb\ud568), \ub2e4\ub978 \ud558\ub098\ub294 data \uc5d0 \uac19\uc740 \ubd09\ud22c\ub97c \uc2e4\uc740 \uc624\ub958\uc785\ub2c8\ub2e4. \uacb0\uacfc\uac00 \ub35c \ub410\uc73c\uba74 \ub2e8\uacc4\uac00 \uc2e4\ud328\ud588\ub4e0 \uacc4\uc0b0\uc774 \uc2e4\ud328\ud588\ub4e0 partial \uc740 true \uc785\ub2c8\ub2e4. \ud30c\uc77c: \uc5d1\uc140(xlsx) \u00b7 \uc774 \uc791\uc5c5\uc758 \uacb0\uacfc\ub85c \ub9cc\ub4e0 \ubb38\uc11c - output_formats \ub85c \uccad\ud560 \ub54c\ub9cc \ub9cc\ub4ed\ub2c8\ub2e4. \uacb0\uacfc\uc758 artifacts[] \uc5d0 \uc2e4\ub9ac\uace0, \ub0b4\ub824\ubc1b\uae30 \ub9c1\ud06c(download_url)\ub294 15\ubd84 \ub3d9\uc548 \uc5f4\ub9ac\uba70 \ud30c\uc77c\uc740 7\uc77c \ub3d9\uc548 \ubcf4\uad00\ub429\ub2c8\ub2e4. \ub9c1\ud06c\uac00 \ub9cc\ub8cc\ub418\uba74 \uacb0\uacfc\uc758 pack_run_id \ub85c xdata__job__result \ub97c \ub2e4\uc2dc \ubd88\ub7ec \uc0c8 \ub9c1\ud06c\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778 \uc5c6\uc774 \ubc1b\uc740 \uacb0\uacfc\ub294 \ud568\uaed8 \uc628 recovery_receipt \ub97c \ub530\ub85c \ubcf4\uad00\ud588\ub2e4\uac00, \ucc98\uc74c\uc758 job_id \ub098 pack_run_id \uc640 \ud568\uaed8 xdata__job__result \uc5d0 \ubcf4\ub0b4\uc138\uc694. \uc99d\ud45c\ub85c\ub294 \uadf8 \uacb0\uacfc \ud558\ub098\ub9cc, \uc6d0\ub798 \ud30c\uc77c \ubcf4\uad00 \uae30\uac04\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc99d\ud45c\ub294 \uacf5\uac1c\ud558\uc9c0 \ub9c8\uc138\uc694. \uc783\uc5b4\ubc84\ub9ac\uba74 \uac00\uc785\ud574\ub3c4 \ub418\ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub85c\uadf8\uc778\ud574\ub3c4 \uc99d\ud45c\ub294 \uadf8\ub300\ub85c \uc4f0\uc774\uace0, \ub2e4\ub978 \uacb0\uacfc\ub294 \uc5f4\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \uc99d\ud45c\uac00 \uc5c6\uc73c\uba74 \ucc98\uc74c \uacc4\uc815\uacfc \uac19\uc740 \ud65