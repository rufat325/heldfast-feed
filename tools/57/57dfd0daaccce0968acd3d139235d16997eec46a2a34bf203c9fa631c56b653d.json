 "description": "Busca subastas judiciales de inmuebles del BOE por provincia, municipio, tipo, precio, superficie, texto libre, zona (bbox o radio) y estado. P\u00fablica, sin cuenta: devuelve datos oficiales del BOE y la URL de cada ficha. El scoring, veredicto, cargas, ROI, valoraci\u00f3n e intervinientes requieren cuenta y plan Pro o superior; si algo est\u00e1 cerrado se devuelve `locked` con `upgradeUrl`. Sin plan con scoring, `orden: score` pasa a `recent` y `solo_viables` se ignora (campo `degradado`). M\u00e1ximo 20 por p\u00e1gina (`por_pagina`, o su alias `limite`); no acepta par\u00e1metros que no est\u00e9n declarados.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "area_max": {
    "description": "Superficie construida m\u00e1xima (m\u00b2)",
    "minimum": 0,
    "type": "number"
   },
   "area_min": {
    "description": "Superficie construida m\u00ednima (m\u00b2)",
    "minimum": 0,
    "type": "number"
   },
   "bbox": {
    "additionalProperties": false,
    "description": "Zona rectangular en grados (lon/lat)",
    "properties": {
     "este": {
      "type": "number"
     },
     "norte": {
      "type": "number"
     },
     "oeste": {
      "type": "number"
     },
     "sur": {
      "type": "number"
     }
    },
    "required": [
     "oeste",
     "sur",
     "este",
     "norte"
    ],
    "type": "object"
   },
   "cerca": {
    "additionalProperties": false,
    "description": "Radio alrededor de un punto (m\u00e1ximo 50 km)",
    "properties": {
     "km": {
      "exclusiveMinimum": 0,
      "maximum": 50,
      "type": "number"
     },
     "lat": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lon": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lon",
     "km"
    ],
    "type": "object"
   },
   "estado": {
    "description": "`activas` (por defecto), `todas`, `adjudicadas` o `desiertas`",
    "enum": [
     "activas",
     "todas",
     "adjudicadas",
     "desiertas"
    ],
    "type": "string"
   },
   "limite": {
    "description": "Alias de `por_pagina` (n\u00famero de resultados por p\u00e1gina). Si indicas los dos, manda `por_pagina`.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "municipio": {
    "description": "Claves `provincia:municipio` (de `estadisticas_publicas` con `municipio_q`)",
    "items": {
     "description": "Clave `provincia:municipio` (de `estadisticas_publicas`)",
     "pattern": "^[a-z0-9-]+:[a-z0-9-]+$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "orden": {
    "description": "`recent` (por defecto), `ending`, `discount`, `price`; `score` solo con plan Pro (si no, pasa a `recent`)",
    "enum": [
     "recent",
     "ending",
     "discount",
     "price",
     "score"
    ],
    "type": "string"
   },
   "pagina": {
    "description": "P\u00e1gina (\u22651; m\u00e1ximo 25 sin cuenta, 50 con cuenta)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "por_pagina": {
    "description": "Resultados por p\u00e1gina (1..20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "precio_max": {
    "description": "Valor de subasta m\u00e1ximo (euros)",
    "minimum": 0,
    "type": "number"
   },
   "precio_min": {
    "description": "Valor de subasta m\u00ednimo (euros)",
    "minimum": 0,
    "type": "number"
   },
   "provincia": {
    "description": "Slugs de provincia (p. ej. [`madrid`, `barcelona`]); ver `estadisticas_publicas`",
    "items": {
     "description": "Slug en min\u00fasculas (p. ej. `madrid`)",
     "pattern": "^[a-z0-9-]{1,80}$",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "solo_viables": {
    "description": "Ocultar las no recomendables: solo con plan Pro (si no, se ignora)",
    "type": "boolean"
   },
   "texto": {
    "description": "Texto libre (calle, barrio, juzgado\u2026), m\u00e1ximo 120 caracteres",
    "maxLength": 120,
    "type": "string"
   },
   "tipo": {
    "description": "Tipos de inmueble, valores EXACTOS de `estadisticas_publicas.tipos` (p. ej. `Vivienda`, `Garaje`)",
    "items": {
     "maxLength": 60,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   }
  },
  "type": "object"
 },
