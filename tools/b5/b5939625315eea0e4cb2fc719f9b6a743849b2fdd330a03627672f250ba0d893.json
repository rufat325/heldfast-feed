{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "read"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Inspect a passage"
 },
 "description": "Reads exact source, a native drawing recipe, an imported SVG's node tree or a comparison difference before editing. Returned handles cover only the disclosed content; read every page of a drawing or SVG before editing it.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "context_handle": {
    "description": "A handle from find or an earlier read, or a change handle while a comparison is open.",
    "maxLength": 128,
    "type": "string"
   },
   "cursor": {
    "description": "Continues a long passage or both sides of a comparison difference.",
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "end": {
    "description": "One past the last UTF-16 unit.",
    "maximum": 26214400,
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "description": "Units per page. Clamped to 4096.",
    "maximum": 9007199254740991,
    "minimum": 256,
    "type": "integer"
   },
   "objectId": {
    "description": "The handle can change this object alone; the whole drawing is still read.",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "paintSample": {
    "additionalProperties": false,
    "description": "Sample a paint layer in this inspected native drawing at [x,y] drawing units. Returns its material sample without changing it; use the same passage or drawing handle as the read.",
    "properties": {
     "objectId": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-]+$",
      "type": "string"
     },
     "point": {
      "items": {
       "maximum": 1000000,
       "minimum": -1000000,
       "type": "number"
      },
      "maxItems": 2,
      "minItems": 2,
      "type": "array"
     }
    },
    "required": [
     "objectId",
     "point"
    ],
    "type": "object"
   },
   "ref": {
    "description": "An outline ref to read.",
    "maxLength": 128,
    "type": "string"
   },
   "return_id": {
    "description": "A received page from get_context or wait_for_user; read by start and limit, without an edit handle.",
    "maxLength": 128,
    "type": "string"
   },
   "start": {
    "description": "The first UTF-16 unit.",
    "maximum": 26214400,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "document"
  ],
  "type": "object"
 },
 "name": "document.read_context",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "change_id": {
    "maxLength": 128,
    "type": "string"
   },
   "comment_handle": {
    "maxLength": 128,
    "type": "string"
   },
   "compareId": {
    "maxLength": 128,
    "type": "string"
   },
   "complete": {
    "type": "boolean"
   },
   "complete_handle": {
    "maxLength": 128,
    "type": "string"
   },
   "coverage": {
    "additionalProperties": true,
    "type": "object"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "drawing": {
    "additionalProperties": true,
    "type": "object"
   },
   "end": {
    "minimum": 0,
    "type": "integer"
   },
   "expires_in_ms": {
    "minimum": 0,
    "type": "integer"
   },
   "handle": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "images": {
    "additionalProperties": true,
    "type": "object"
   },
   "inserted": {
    "maxLength": 4096,
    "type": "string"
   },
   "inserted_chars": {
    "minimum": 0,
    "type": "integer"
   },
   "inserted_end": {
    "minimum": 0,
    "type": "integer"
   },
   "inserted_start": {
    "minimum": 0,
    "type": "integer"
   },
   "layout": {
    "additionalProperties": true,
    "type": "object"
   },
   "name": {
    "maxLength": 256,
    "type": "string"
   },
   "next_cursor": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "objectId": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "omissions": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "omitted": {
    "minimum": 0,
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "ok",
     "pending",
     "target_gone",
     "conflict",
     "yielded",
     "invalid",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "paintSample": {
    "additionalProperties": true,
    "type": "object"
   },
   "pending": {
    "additionalProperties": true,
    "properties": {
     "kind": {
      "enum": [
       "surface-fact",
       "human-review"
      ]
     },
     "proposalId": {
      "maxLength": 128,
      "type": "string"
     },
     "requestId": {
      "maxLength": 128,
      "type": "string"
     },
     "requirements": {
      "additionalProperties": true,
      "type": "object"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "reason": {
    "type": "string"
   },
   "receivedAt": {
    "maxLength": 64,
    "type": "string"
   },
   "recipe_handle": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "remaining": {
    "minimum": 0,
    "type": "integer"
   },
   "removed": {
    "maxLength": 4096,
    "type": "string"
   },
   "removed_chars": {
    "minimum": 0,
    "type": "integer"
   },
   "removed_end": {
    "minimum": 0,
    "type": "integer"
   },
   "removed_start": {
    "minimum": 0,
    "type": "integer"
   },
   "representation": {
    "const": "source"
   },
   "return_id": {
    "maxLength": 128,
    "type": "string"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   },
   "sha256": {
    "maxLength": 64,
    "type": "string"
   },
   "start": {
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "maxLength": 32,
    "type": "string"
   },
   "text": {
    "maxLength": 12288,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Inspect a passage"
}
