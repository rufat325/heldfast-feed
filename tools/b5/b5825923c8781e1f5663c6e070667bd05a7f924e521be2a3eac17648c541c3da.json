  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Predict near-future gas prices using moving average and trend analysis of recent block base fees. Returns prediction, trend, and recommendation. Scope: short-horizon fee forecast from recent samples. Use this for 'what may fees be soon?'. It is not a live quote (gas.tracker), historical data (gas.history), or a timing recommendation (gas.optimize), and it never executes a transaction.",
 "execution": {
  "taskSupport": "forbidden"
 },
