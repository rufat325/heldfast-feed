{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:brand"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Learn your brand from your content"
 },
 "description": "Scan the owner\u2019s supplied website, photos or own captions through the app\u2019s free brand_scan admission. Needs manage:brand and confirm: true; without confirm it previews only. Scan results are evidence, never an automatic brand save: ask about inferred money-facing facts before saving with soclo_brand_save. Website evidence is read through Soclo\u2019s existing guarded site scanner; images are downscaled JPEG base64. A stable UUID clientRequestId survives lost replies: read soclo_brand_status with kind brand_scan after interruption, never repeat model work automatically. Scans admitted by the native-rest free boundary cost zero customer credits; that boundary refuses unavailable free admission.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "captionsOrigin": {
      "enum": [
       "pasted",
       "social"
      ],
      "type": "string"
     },
     "currentBrand": {
      "additionalProperties": false,
      "properties": {
       "account_type": {
        "anyOf": [
         {
          "maxLength": 20000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "asset_urls": {
        "anyOf": [
         {
          "items": {
           "maxLength": 1000,
           "type": "string"
          },
          "maxItems": 300,
          "type": "array"
         },
         {
          "type": "null"
         }
        ]
       },
       "bio": {
        "anyOf": [
