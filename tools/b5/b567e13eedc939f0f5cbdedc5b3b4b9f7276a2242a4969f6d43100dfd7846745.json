          "maxLength": 20000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "booking_url": {
        "anyOf": [
         {
          "maxLength": 20000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "brand_description": {
        "anyOf": [
         {
          "maxLength": 20000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "brand_hashtags": {
        "anyOf": [
         {
          "items": {
           "maxLength": 1000,
           "type": "string"
          },
          "maxItems": 300,
          "type": "array"
         },
         {
          "type": "null"
         }
        ]
       },
       "business_name": {
        "anyOf": [
         {
          "maxLength": 20000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "colors": {
        "anyOf": [
         {
          "items": {
           "maxLength": 1000,
           "type": "string"
          },
          "maxItems": 300,
          "type": "array"
         },
         {
          "type": "null"
         }
        ]
       },
       "compliance_notes": {
