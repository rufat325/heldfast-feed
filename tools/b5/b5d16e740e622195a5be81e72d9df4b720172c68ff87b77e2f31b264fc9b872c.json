{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Update a board: name, backlog/sprints toggles, columns (with status mapping). Board owner cannot be changed via API.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "backlogAvailable": {
    "description": "Must equal sprintsAvailable",
    "type": "boolean"
   },
   "backlogColumns": {
    "items": {
     "properties": {
      "limit": {
       "type": "number"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "boardId": {
    "type": "number"
   },
   "columns": {
    "items": {
     "properties": {
      "limit": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "statuses": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "statuses"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "nonParametrizedColumns": {
    "items": {
     "properties": {
      "limit": {
       "type": "number"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sprintsAvailable": {
    "description": "Must equal backlogAvailable",
    "type": "boolean"
   }
  },
  "required": [
   "boardId"
  ],
  "type": "object"
 },
 "name": "update_board"
}
