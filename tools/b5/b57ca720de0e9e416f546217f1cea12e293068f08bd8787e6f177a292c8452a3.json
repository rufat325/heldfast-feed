{
 "description": "Read existing note days on one side of an anchor, newest first.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "anchor": {
    "description": "Inclusive YYYY-MM-DD anchor.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dir": {
    "enum": [
     "older",
     "newer"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 400,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "anchor",
   "dir",
   "limit"
  ],
  "type": "object"
 },
 "name": "recent_days"
}
