{
 "description": "Compare two domains to find shared keyword deficits, advantages, and target1-exclusive keyword opportunities.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "intersections": {
    "default": true,
    "type": "boolean"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 250,
    "minimum": 5,
    "type": "integer"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "min_search_volume": {
    "default": 0,
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "sort_by": {
    "default": "opportunity",
    "enum": [
     "opportunity",
     "search_volume",
     "traffic_gap",
     "rank_gap",
     "cpc"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target1": {
    "minLength": 1,
    "type": "string"
   },
   "target2": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target1",
   "target2"
  ],
  "type": "object"
 },
 "name": "agentseo_domain_intersection",
 "title": "AgentSEO Domain Intersection"
}
