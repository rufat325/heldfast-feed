{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Create one Project To-do and its initial assignments atomically. audience is mandatory: use SELECTED plus exact selectedContractIds for personalized feedback. ACTIVE/FUTURE/ACTIVE_AND_FUTURE require the signed receipt from opentrain_preflight_project_todo. A stable idempotencyKey makes retries converge; exact duplicates are refused unless allowDuplicate=true. Requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowDuplicate": {
    "type": "boolean"
   },
   "audience": {
    "description": "REQUIRED. SELECTED is the safe choice for personalized feedback; broad audiences require a fresh preflightReceipt.",
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "autoAssignNewHires": {
    "type": "boolean"
   },
   "categoryId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "preflightReceipt": {
    "minLength": 1,
    "type": "string"
   },
   "selectedContractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   },
   "version": {
    "additionalProperties": false,
    "properties": {
     "blockingMode": {
      "enum": [
       "NONE",
       "IMMEDIATE",
       "AFTER_DUE"
      ],
      "type": "string"
     },
     "blockingScope": {
      "enum": [
       "NONE",
       "PROJECT_WORK",
       "PROVIDER_ACCESS"
      ],
      "type": "string"
     },
     "completionConfig": {
      "anyOf": [
       {
        "additionalProperties": {},
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "content": {},
     "description": {
      "anyOf": [
       {
        "maxLength": 20000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "dueOffsetMinutes": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "ownerRole": {
      "enum": [
       "WORKER",
       "EMPLOYER"
      ],
      "type": "string"
     },
     "priority": {
      "enum": [
       "NORMAL",
       "HIGH",
       "URGENT"
      ],
      "type": "string"
     },
     "reminderPolicy": {},
     "required": {
      "type": "boolean"
     },
     "sourceInstructionPageId": {
      "anyOf": [
       {
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "type": {
      "enum": [
       "MANUAL_ACTION",
       "READ_ACKNOWLEDGE",
       "EXTERNAL_ACTION",
       "EMPLOYER_REVIEW",
       "QUIZ",
       "TRAINING",
       "PLATFORM_REQUIREMENT",
       "INTEGRATION_ACTION",
       "WORK_AVAILABILITY"
      ],
      "type": "string"
     }
    },
    "required": [
     "title",
     "type"
    ],
    "type": "object"
   }
  },
  "required": [
   "idempotencyKey",
   "jobId",
   "audience",
   "version"
  ],
  "type": "object"
 },
 "name": "opentrain_create_project_todo",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
