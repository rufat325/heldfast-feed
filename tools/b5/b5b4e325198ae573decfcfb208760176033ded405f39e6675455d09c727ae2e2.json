{
 "description": "Get a price quote for a token swap without executing. Use this to check rates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount to swap (e.g. \"1.5\")",
    "type": "string"
   },
   "from_token": {
    "description": "Source token symbol (SOL, USDC, etc.)",
    "type": "string"
   },
   "to_token": {
    "description": "Destination token symbol",
    "type": "string"
   }
  },
  "required": [
   "from_token",
   "to_token",
   "amount"
  ],
  "type": "object"
 },
 "name": "get_swap_quote"
}
