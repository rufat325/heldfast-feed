{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "quotes:read",
     "quotes:answer"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save additional quote answers"
 },
 "description": "Saves answers to the connected quote\u2019s outstanding follow-up questions and returns the updated status. A save can overwrite earlier answers and resume affected carrier processing. Coverage limits, deductibles, consent, attestations and protected information are not accepted; they are completed on Menlo\u2019s website. Takes the current baseRevision and an eventId; the same eventId with the same answers returns the original result.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "answers": {
    "description": "Only customer-confirmed facts from current additional questions whose answerOnWebsite is false; coverage choices the customer made are fine; never protected information, consent, signatures, owner answers or uploads",
    "items": {
     "additionalProperties": false,
     "properties": {
      "questionId": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "enum": [
        "confirmed",
        "unknown",
        "declined"
       ],
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "maxLength": 4000,
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "items": {
          "maxLength": 500,
          "type": "string"
         },
         "maxItems": 100,
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "questionId",
      "status",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "baseRevision": {
    "description": "The revision returned by get_missing_questions; conflicts require rereading questions",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "eventId": {
    "description": "Stable unique ID for this answer submission; retries reuse the same ID and identical answers",
    "pattern": "^[A-Za-z0-9_-]{8,128}$",
    "type": "string"
   },
   "locale": {
    "default": "en",
    "description": "Language for the resulting quote status",
    "enum": [
     "en",
     "es"
    ],
    "type": "string"
   }
  },
  "required": [
   "eventId",
   "baseRevision",
   "answers"
  ],
  "type": "object"
 },
 "name": "answer_additional_questions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "additionalQuestionCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "aggregate": {
    "additionalProperties": false,
    "properties": {
     "blocked": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "declined": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "quoted": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "referred": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "status": {
      "type": "string"
     },
     "terminal": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "status",
     "total",
     "terminal",
     "quoted",
     "referred",
     "declined",
     "blocked"
    ],
    "type": "object"
   },
   "carriers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "carrierId": {
       "type": "string"
      },
      "declineReason": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "informationSubmitted": {
       "type": "boolean"
      },
      "quote": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "carrier": {
           "maxLength": 120,
           "minLength": 1,
           "type": "string"
          },
          "coverages": {
           "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 20,
           "minItems": 1,
           "type": "array"
          },
          "dueToday": {
           "maxLength": 40,
           "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$",
           "type": "string"
          },
          "intro": {
           "maxLength": 500,
           "minLength": 1,
           "type": "string"
          },
          "limits": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "label": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
             },
             "value": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
             }
            },
            "required": [
             "label",
             "value"
            ],
            "type": "object"
           },
           "maxItems": 20,
           "minItems": 1,
           "type": "array"
          },
          "monthly": {
           "maxLength": 40,
           "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$",
           "type": "string"
          },
          "monthlyCount": {
           "exclusiveMinimum": 0,
           "maximum": 60,
           "type": "integer"
          },
          "startDate": {
           "format": "date",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
           "type": "string"
          },
          "subjectTo": {
           "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 20,
           "minItems": 1,
           "type": "array"
          },
          "underwritingApproval": {
           "const": "pending",
           "type": "string"
          },
          "yearly": {
           "maxLength": 40,
           "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$",
           "type": "string"
          }
         },
         "required": [
          "carrier"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "carrierId",
      "status",
      "quote",
      "declineReason",
      "informationSubmitted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "demo": {
    "type": "boolean"
   },
   "formId": {
    "type": "string"
   },
   "formRevisionId": {
    "type": "string"
   },
   "nextAction": {
    "enum": [
     "answer_page",
     "finish_on_website",
     "answer_questions",
     "broker_review",
     "wait",
     "review",
     "review_application",
     "cancelled"
    ],
    "type": "string"
   },
   "notificationExpiresAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "notificationStatus": {
    "enum": [
     "subscribed",
     "not_subscribed"
    ],
    "type": "string"
   },
   "ownerQuote": {
    "type": "boolean"
   },
   "pricingNotice": {
    "type": "string"
   },
   "progressMessage": {
    "type": "string"
   },
   "quoteNumber": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "stage": {
    "type": "string"
   },
   "websiteUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "demo",
   "quoteNumber",
   "formId",
   "formRevisionId",
   "revision",
   "stage",
   "ownerQuote",
   "aggregate",
   "carriers",
   "additionalQuestionCount",
   "nextAction",
   "websiteUrl",
   "pricingNotice",
   "notificationStatus",
   "notificationExpiresAt",
   "progressMessage"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "quotes:read",
    "quotes:answer"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Save additional quote answers"
}
