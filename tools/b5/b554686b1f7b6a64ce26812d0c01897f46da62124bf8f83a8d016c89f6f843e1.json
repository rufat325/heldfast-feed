{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/text.chunk",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Split text into at most 200 overlapping chunks with offsets and intact UTF-16 surrogate pairs. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "maxChars": {
      "maximum": 10000,
      "minimum": 32,
      "type": "integer"
     },
     "overlap": {
      "maximum": 500,
      "minimum": 0,
      "type": "integer"
     },
     "text": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "text_chunk",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "chunks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "end": {
       "type": "number"
      },
      "start": {
       "type": "number"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "start",
      "end",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "type": "number"
   },
   "offsetUnit": {
    "type": "string"
   }
  },
  "required": [
   "chunks",
   "offsetUnit",
   "count"
  ],
  "type": "object"
 }
}
