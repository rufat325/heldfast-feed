{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate a configuration"
 },
 "description": "Resolves defaults, exclusions and dependencies; returns valid=false with errors (unknown_option, dependency_unmet) and warnings (exclusive_conflict) that can be fixed, plus the resolved list of selections and total EUR price.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "configuration": {
    "additionalProperties": false,
    "properties": {
     "engraving": {
      "description": "Optional engraving text (not priced, not rendered).",
      "maxLength": 24,
      "type": "string"
     },
     "model": {
      "description": "model_id from list_models, e.g. 'v6-44-sa'.",
      "type": "string"
     },
     "options": {
      "description": "option_id values from describe_model. Unset components keep their default.",
      "items": {
       "type": "string"
      },
      "maxItems": 40,
      "type": "array"
     }
    },
    "required": [
     "model"
    ],
    "type": "object"
   },
   "lang": {
    "default": "en",
    "enum": [
     "fr",
     "en",
     "de",
     "es",
     "it",
     "nl",
     "pt",
     "ja",
     "ko",
     "zh",
     "ar",
     "hi"
    ],
    "type": "string"
   }
  },
  "required": [
   "configuration"
  ],
  "type": "object"
 },
 "name": "validate_configuration",
 "outputSchema": {
  "properties": {
   "errors": {
    "items": {
     "properties": {
      "code": {
       "enum": [
        "unknown_option",
        "dependency_unmet"
       ],
       "type": "string"
      },
      "hint": {
       "type": "string"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "is_order": {
    "const": false
   },
   "resolved": {
    "properties": {
     "base_price_eur": {
      "type": "number"
     },
     "engraving": {
      "type": [
       "string",
       "null"
      ]
     },
     "model_id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "selections": {
      "items": {
       "properties": {
        "component": {
         "type": "string"
        },
        "option": {
         "type": "string"
        },
        "option_id": {
         "type": "string"
        },
        "surcharge_eur": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "total_price_eur": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "valid": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "properties": {
      "code": {
       "enum": [
        "exclusive_conflict"
       ],
       "type": "string"
      },
      "hint": {
       "type": "string"
      },
      "options": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Validate a configuration"
}
