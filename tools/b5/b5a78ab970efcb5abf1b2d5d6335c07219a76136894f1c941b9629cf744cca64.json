{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare precomputed thematic indicators by period. Editorial and lexical assignments are default; filters.includeSemantic explicitly includes embedding associations. firstYears requires exactly one author and starts at their earliest catalogued work. Percentages use evaluable works, not semantic top-k results.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "authorIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "baselReferencePrefix": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "baselReferences": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "downloadFormats": {
      "items": {
       "enum": [
        "epub",
        "pdf",
        "mobi"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "full": {
      "type": "boolean"
     },
     "hasDownload": {
      "type": "boolean"
     },
     "hasExtractedText": {
      "type": "boolean"
     },
     "inOriginalLanguage": {
      "type": "boolean"
     },
     "includeSemantic": {
      "type": "boolean"
     },
     "isIndexed": {
      "type": "boolean"
     },
     "journalIds": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "journalScope": {
      "enum": [
       "original",
       "edition",
       "any"
      ],
      "type": "string"
     },
     "labelIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "originalLanguages": {
      "items": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "originalYearFrom": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "originalYearTo": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publicationIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "publicationLanguages": {
      "items": {
       "maxLength": 16,
       "minLength": 2,
       "type": "string"
      },
      "maxItems": 40,
      "minItems": 1,
      "type": "array"
     },
     "publicationTypes": {
      "items": {
       "enum": [
        "Mainwork",
        "Translation",
        "Anthology",
        "Article",
        "Contribution",
        "Preface",
        "Epilogue",
        "Letter",
        "EditedWork",
        "Excerpt"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "publicationYearFrom": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publicationYearTo": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "publisherIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "reference": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "title": {
      "maxLength": 250,
      "minLength": 1,
      "type": "string"
     },
     "topicIds": {
      "items": {
       "maxLength": 250,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "translatorIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "workIds": {
      "items": {
       "pattern": "^[a-f\\d]{24}$",
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "workTypes": {
      "items": {
       "enum": [
        "Mainwork",
        "Translation",
        "Anthology",
        "Article",
        "Contribution",
        "Preface",
        "Epilogue",
        "Letter",
        "EditedWork"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "firstYears": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "interval": {
    "default": "fiveYears",
    "enum": [
     "year",
     "fiveYears",
     "decade"
    ],
    "type": "string"
   },
   "offset": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "periods": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "to": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "from",
      "to"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "get_topics_by_period",
 "title": "Compare topics across periods"
}
