{
 "description": "Generate multi-touch email sequences by persona, stage, and objective. Creates prospecting, nurture, follow-up, and re-engagement sequences.",
 "inputSchema": {
  "properties": {
   "call_to_action": {
    "description": "Desired action (meeting, demo, reply)",
    "type": "string"
   },
   "key_value_prop": {
    "description": "Primary value proposition",
    "type": "string"
   },
   "num_emails": {
    "description": "Number of emails in sequence (3-7)",
    "type": "number"
   },
   "sender_context": {
    "description": "Context about sender (role, shared connections, etc.)",
    "type": "string"
   },
   "sequence_type": {
    "description": "Type of email sequence",
    "enum": [
     "cold_outreach",
     "warm_follow_up",
     "post_demo",
     "proposal_follow_up",
     "re_engagement",
     "nurture",
     "event_follow_up",
     "referral_request"
    ],
    "type": "string"
   },
   "social_proof": {
    "description": "Customer names, stats, or proof points",
    "type": "string"
   },
   "specific_pain_point": {
    "description": "Specific pain point to address",
    "type": "string"
   },
   "target_industry": {
    "description": "Target industry for context",
    "type": "string"
   },
   "target_persona": {
    "description": "Target persona (e.g., VP Sales, CTO, CFO)",
    "type": "string"
   },
   "tone": {
    "description": "Email tone",
    "enum": [
     "professional",
     "casual",
     "urgent",
     "consultative",
     "provocative"
    ],
    "type": "string"
   },
   "your_solution": {
    "description": "Your product/solution",
    "type": "string"
   }
  },
  "required": [
   "sequence_type",
   "target_persona",
   "your_solution"
  ],
  "type": "object"
 },
 "name": "email_sequence_generator"
}
