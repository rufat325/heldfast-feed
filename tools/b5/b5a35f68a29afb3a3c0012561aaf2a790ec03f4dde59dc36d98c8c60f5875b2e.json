{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find literal accent-insensitive keyword passages in selected publication/video/podcast IDs. Original UTF-16 offsets, bounded context, and citations. Requires full text exposure; no semantic ranking.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ids": {
    "description": "publication:, video: or podcast: ids",
    "items": {
     "maxLength": 64,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "keyword": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Default 10, max 20",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "radius": {
    "maximum": 500,
    "minimum": 20,
    "type": "integer"
   }
  },
  "required": [
   "ids",
   "keyword"
  ],
  "type": "object"
 },
 "name": "get_text_passages",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "effective_limit": {
    "type": "number"
   },
   "has_more": {
    "type": "boolean"
   },
   "next_offset": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "requested_limit": {
    "type": "number"
   },
   "response_limited": {
    "type": "boolean"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amira_url": {
       "type": "string"
      },
      "end": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "match_end": {
       "type": "number"
      },
      "match_start": {
       "type": "number"
      },
      "start": {
       "type": "number"
      },
      "text": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "amira_url",
      "start",
      "end",
      "match_start",
      "match_end",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scanned_matches_capped": {
    "type": "boolean"
   },
   "snapshot_id": {
    "type": "string"
   },
   "total_matches": {
    "type": "number"
   },
   "unavailable_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "total_matches",
   "offset",
   "has_more",
   "results",
   "snapshot_id",
   "scanned_matches_capped",
   "unavailable_ids"
  ],
  "type": "object"
 },
 "title": "Find cited text passages"
}
