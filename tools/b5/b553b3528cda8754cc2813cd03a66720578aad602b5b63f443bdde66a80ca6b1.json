{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "[INSPECT] Read-only.\nRecord FPS and frame times for N seconds: avg/min/max, percentiles, spikes, jank.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "duration": {
    "description": "Seconds (default: 3, max: 30)",
    "type": "number"
   },
   "includeFrameTimes": {
    "description": "Include raw frame times (default: false)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "perf_monitor"
}
