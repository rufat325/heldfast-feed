{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send the learner a Telegram message that a set is waiting. Use sparingly \u2014 one ping per set, right after you create it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "setId": {
    "description": "Set id returned by create_study_set or list_study_sets",
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "Custom message. Omit for the default 'your set is ready' ping",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "setId"
  ],
  "type": "object"
 },
 "name": "notify_learner",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "notified": {
    "type": "boolean"
   },
   "setId": {
    "type": "string"
   },
   "telegramId": {
    "type": "number"
   }
  },
  "required": [
   "setId",
   "notified"
  ],
  "type": "object"
 },
 "title": "Ping the learner"
}
