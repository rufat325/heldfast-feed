{
 "description": "Start a new Turtle Soup session. Detect user language and pass language (zh-CN/en-US/ja-JP). Optional: region, difficulty, keyword.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "difficulty": {
    "description": "Optional difficulty preference",
    "enum": [
     "\u7b80\u5355",
     "\u4e2d\u7b49",
     "\u56f0\u96be"
    ],
    "type": "string"
   },
   "keyword": {
    "description": "Optional fuzzy keyword on title/surface/tags",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "description": "User language for localized response, e.g. zh-CN/en-US/ja-JP",
    "maxLength": 16,
    "minLength": 2,
    "type": "string"
   },
   "region": {
    "description": "Optional region code, e.g. US/CN/JP",
    "maxLength": 8,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "start_session"
}
