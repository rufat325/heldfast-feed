{
 "description": "Start an async eval run. Requires evals:run for API keys. Set mode: \"advanced\" with baselineVersionId and candidateVersionId to run a statistically-backed A/B (repeats defaults to 3, max 5).",
 "inputSchema": {
  "properties": {
   "artifactBundleId": {
    "format": "uuid",
    "type": "string"
   },
   "auditRunId": {
    "format": "uuid",
    "type": "string"
   },
   "baselineVersionId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateFileId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateFileVersionId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateVersionId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateVersionNumber": {
    "minimum": 1,
    "type": "integer"
   },
   "maxCases": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "standard",
     "advanced"
    ],
    "type": "string"
   },
   "repeats": {
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "rubricVersion": {
    "type": "string"
   },
   "sourceFileId": {
    "format": "uuid",
    "type": "string"
   },
   "sourceFileVersionId": {
    "format": "uuid",
    "type": "string"
   },
   "sourceVersionNumber": {
    "minimum": 1,
    "type": "integer"
   },
   "testCases": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "artifactBundleId"
  ],
  "type": "object"
 },
 "name": "rubrkit_run_evals",
 "title": "Run evals"
}
