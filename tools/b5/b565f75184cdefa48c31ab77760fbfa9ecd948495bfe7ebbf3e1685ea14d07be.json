{
 "description": "Encrypt a PDF with a password and optional permission restrictions. Produces a new document; the original is unchanged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "algorithm": {
    "description": "Encryption algorithm (default: AES256)",
    "enum": [
     "AES256",
     "AES128"
    ],
    "type": "string"
   },
   "disableCopy": {
    "description": "Prevent copying text",
    "type": "boolean"
   },
   "disableEditing": {
    "description": "Prevent editing",
    "type": "boolean"
   },
   "disablePrint": {
    "description": "Prevent printing",
    "type": "boolean"
   },
   "documentId": {
    "description": "The source document ID to protect",
    "type": "string"
   },
   "encryptMetadata": {
    "description": "Encrypt PDF metadata (default: false)",
    "type": "boolean"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Custom metadata to attach",
    "type": "object"
   },
   "ownerPassword": {
    "description": "Full-control owner password; required when using AES256 with a userPassword",
    "type": "string"
   },
   "preSignedUrlExpiresIn": {
    "description": "Pre-signed download URL expiry in seconds (60\u201386400)",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "userPassword": {
    "description": "Password required to open the PDF",
    "type": "string"
   }
  },
  "required": [
   "documentId"
  ],
  "type": "object"
 },
 "name": "protect_pdf"
}
