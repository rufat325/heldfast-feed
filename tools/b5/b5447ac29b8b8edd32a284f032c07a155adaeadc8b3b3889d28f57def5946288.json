{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete a mail redirection. Two-phase commit.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token returned by the first (plan) phase of the two-phase commit. Re-pass it on the second call to actually delete. Omit on first call to receive the plan + token.",
    "format": "uuid",
    "type": "string"
   },
   "mail_hosting_id": {
    "description": "Mail hosting ID. Discover via infomaniak_list_mail_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Local part of the redirection source to remove (e.g. 'support' to delete 'support@coden.lu'). NOT the full email. List existing rules with infomaniak_list_redirections.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mail_hosting_id",
   "name"
  ],
  "type": "object"
 },
 "name": "infomaniak_delete_redirection",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "mail_hosting_id": {
        "type": "number"
       },
       "name": {
        "type": "string"
       }
      },
      "required": [
       "mail_hosting_id",
       "name"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "name",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
