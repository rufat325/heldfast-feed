{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List recent Official Journal documents"
 },
 "description": "List documents published to the Official Journal recently. Default window is 7 days. Filterable by document type, author, and language. Use this when the user asks \"what was published this week\" or wants a delta over a date window.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "author": {
    "enum": [
     "commission",
     "council",
     "parliament",
     "court-of-justice",
     "general-court",
     "ecb",
     "eca",
     "eesc",
     "cor",
     "ema",
     "efsa"
    ],
    "type": "string"
   },
   "days": {
    "default": 7,
    "description": "Look-back window in days.",
    "minimum": 1,
    "type": "integer"
   },
   "documentType": {
    "enum": [
     "judgment",
     "opinion",
     "order",
     "regulation",
     "directive",
     "decision",
     "recommendation",
     "opinion-act",
     "communication",
     "proposal",
     "report",
     "resolution",
     "declaration",
     "treaty",
     "protocol",
     "agreement",
     "written-question",
     "oral-question",
     "consolidated-text",
     "guideline",
     "implementing"
    ],
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "fr",
     "de",
     "es",
     "it",
     "pl",
     "nl",
     "pt",
     "ro",
     "bg",
     "cs",
     "da",
     "el",
     "et",
     "fi",
     "ga",
     "hr",
     "hu",
     "lt",
     "lv",
     "mt",
     "sk",
     "sl",
     "sv"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "lex_recent_documents"
}
