{
 "description": "Create a dependency edge between two catalog entities (for impact analysis). Requires `write` scope. Both endpoints must already exist; self-edges and duplicates are rejected.",
 "inputSchema": {
  "properties": {
   "description": {
    "description": "Why the dependency exists",
    "type": "string"
   },
   "fromId": {
    "description": "Id of the source entity (required)",
    "type": "string"
   },
   "fromKind": {
    "description": "Kind of the source entity",
    "enum": [
     "component",
     "api",
     "resource",
     "system",
     "domain"
    ],
    "type": "string"
   },
   "toId": {
    "description": "Id of the target entity (required)",
    "type": "string"
   },
   "toKind": {
    "description": "Kind of the target entity",
    "enum": [
     "component",
     "api",
     "resource",
     "system",
     "domain"
    ],
    "type": "string"
   },
   "type": {
    "description": "Edge type (default 'depends_on')",
    "type": "string"
   }
  },
  "required": [
   "fromKind",
   "fromId",
   "toKind",
   "toId"
  ],
  "type": "object"
 },
 "name": "create_dependency"
}
