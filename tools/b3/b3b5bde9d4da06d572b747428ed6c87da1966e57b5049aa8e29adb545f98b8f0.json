 "description": "Look up one product by GTIN (EAN/UPC barcode) or Ponito product id. Use this when you already know exactly which product you mean \u2014 e.g. from a barcode, a previous search result, or a product page. Returns the product with its best offer in the given country.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "The shopper's country (offers and prices are country-specific).",
    "enum": [
     "CH",
     "DE",
     "FR",
     "GB",
     "AT",
     "ES",
     "NL"
    ],
    "type": "string"
   },
   "id": {
    "description": "A GTIN (8-14 digit EAN/UPC barcode) or a Ponito product id.",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "de",
     "fr",
     "en",
     "it",
     "es",
     "pt",
     "nl"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "country"
  ],
  "type": "object"
 },
 "name": "get_product",
 "outputSchema": {
  "properties": {
   "best_offer": {
    "properties": {
     "currency": {
      "type": "string"
     },
     "price": {
      "description": "Lowest current price in minor units (cents/rappen).",
      "type": "integer"
     },
     "shops_count": {
      "description": "Number of shops currently offering the product.",
      "type": "integer"
     }
    },
    "required": [
     "price",
     "currency",
     "shops_count"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "brand": {
    "type": [
     "string",
     "null"
    ]
   },
   "gtins": {
    "description": "GTIN (EAN/UPC) barcodes.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Ponito product id.",
    "type": "string"
   },
   "image": {
    "description": "Product photo, served from Ponito.",
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "rating": {
