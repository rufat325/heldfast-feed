{
 "description": "Live amendment status for the network: every ENABLED amendment (resolved to its human name where known, raw hash otherwise) plus any in the VOTING set (already at >80% support, counting toward enablement). Reads the on-ledger Amendments singleton \u2014 no admin node needed. 1 RPC read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_amendment_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "caveat": {
    "type": "string"
   },
   "enabled": {
    "items": {},
    "type": "array"
   },
   "enabledCount": {
    "type": "number"
   },
   "error": {
    "type": "string"
   },
   "knownNameTableSize": {
    "type": "number"
   },
   "namedCount": {
    "type": "number"
   },
   "network": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "unnamedCount": {
    "type": "number"
   },
   "voting": {
    "items": {},
    "type": "array"
   },
   "votingCount": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
