{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"\u0418\u0437\u043c\u0435\u043d\u044f\u0435\u0442 \u0446\u0435\u043d\u0443 \u043e\u0434\u043d\u043e\u0433\u043e \u0442\u043e\u0432\u0430\u0440\u043d\u043e\u0433\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f (POST /offer-prices/updates c \u043e\u0434\u043d\u0438\u043c \u044d\u043b\u0435\u043c\u0435\u043d\u0442\u043e\u043c). \u0412\u0430\u043b\u044e\u0442\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 RUR \u2014 \u043f\u043e\u0434\u0441\u0442\u0430\u0432\u043b\u044f\u0435\u0442\u0441\u044f \u0430\u0432\u0442\u043e\u043c\u0430\u0442\u0438\u0447\u0435\u0441\u043a\u0438. \u041e\u043f\u0446\u0438\u043e\u043d\u0430\u043b\u044c\u043d\u043e: discount_base \u2014 \u0446\u0435\u043d\u0430 \u0434\u043e \u0441\u043a\u0438\u0434\u043a\u0438 (\u043f\u043e\u043a\u0430\u0436\u0435\u0442\u0441\u044f \u0437\u0430\u0447\u0451\u0440\u043a\u043d\u0443\u0442\u043e\u0439; \u0441\u043a\u0438\u0434\u043a\u0430 \u0434\u043e\u043b\u0436\u043d\u0430 \u043f\u043e\u043f\u0430\u0434\u0430\u0442\u044c \u0432 5\u201395%, \u0438\u043d\u0430\u0447\u0435 API \u0432\u0435\u0440\u043d\u0451\u0442 400), pay_by_price + pay_by_condition (\u0442\u043e\u043b\u044c\u043a\u043e \u043f\u0430\u0440\u043e\u0439, \u0432\u043c\u0435\u0441\u0442\u0435) \u2014 \u0441\u043f\u0435\u0446\u0446\u0435\u043d\u0430 \u043f\u0440\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u0438 \u043e\u043f\u043b\u0430\u0442\u044b. \u041e\u0442\u0432\u0435\u0442 API: { status: \"OK\" } \u043b\u0438\u0431\u043e { status: \"ERROR\", errors: [{ code, message }] } \u2014 \u043f\u0440\u043e\u0432\u0435\u0440\u044f\u0439\u0442\u0435 status. \u0415\u0441\u043b\u0438 \u0432 \u0444\u0438\u0434\u0435 \u043d\u0435\u0441\u043a\u043e\u043b\u044c\u043a\u043e \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u0439 \u0441 \u043e\u0434\u0438\u043d\u0430\u043a\u043e\u0432\u044b\u043c id, \u0446\u0435\u043d\u0430 \u043e\u0431\u043d\u043e\u0432\u0438\u0442\u0441\u044f \u0442\u043e\u043b\u044c\u043a\u043e \u0443 \u043f\u0435\u0440\u0432\u043e\u0433\u043e. \u041b\u0438\u043c\u0438\u0442: 50 000 \u0438\u0437\u043c\u0435\u043d\u0435\u043d\u0438\u0439 \u0446\u0435\u043d \u0432 \u043c\u0438\u043d\u0443\u0442\u0443.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"discount_base":{"description":"\u0426\u0435\u043d\u0430 \u0434\u043e \u0441\u043a\u0438\u0434\u043a\u0438 (\u0437\u0430\u0447\u0451\u0440\u043a\u043d\u0443\u0442\u0430\u044f), \u0431\u043e\u043b\u044c\u0448\u0435 price; \u0441\u043a\u0438\u0434\u043a\u0430 5\u201395%.","exclusiveMinimum":0,"type":"number"},"feed_id":{"description":"\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u0444\u0438\u0434\u0430 (feedId \u0438\u0437 list_feeds).","type":"integer"},"offer_id":{"description":"\u0418\u0434\u0435\u043d\u0442\u0438\u0444\u0438\u043a\u0430\u0442\u043e\u0440 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f \u0438\u0437 \u0444\u0438\u0434\u0430 (id \u0432 YML, \u0434\u043e 50 \u0441\u0438\u043c\u0432\u043e\u043b\u043e\u0432).","maxLength":50,"minLength":1,"type":"string"},"pay_by_condition":{"description":"\u0423\u0441\u043b\u043e\u0432\u0438\u0435 \u043e\u043f\u043b\u0430\u0442\u044b \u0434\u043b\u044f \u0441\u043f\u0435\u0446\u0446\u0435\u043d\u044b: yandex_pay, fast_payment_system \u0438\u043b\u0438 ozon_card; \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 pay_by_price.","enum":["yandex_pay","fast_payment_system","ozon_card"],"type":"string"},"pay_by_price":{"description":"\u0421\u043f\u0435\u0446\u0446\u0435\u043d\u0430 \u043f\u0440\u0438 \u0432\u044b\u043f\u043e\u043b\u043d\u0435\u043d\u0438\u0438 \u0443\u0441\u043b\u043e\u0432\u0438\u044f \u043e\u043f\u043b\u0430\u0442\u044b (\u0446\u0435\u043b\u043e\u0435, \u0432 \u0440\u0443\u0431\u043b\u044f\u0445); \u0442\u043e\u043b\u044c\u043a\u043e \u0432\u043c\u0435\u0441\u0442\u0435 \u0441 pay_by_condition.","exclusiveMinimum":0,"type":"integer"},"price":{"description":"\u0426\u0435\u043d\u0430 \u0432 \u0440\u0443\u0431\u043b\u044f\u0445 (\u0432\u0430\u043b\u044e\u0442\u0430 \u0432\u0441\u0435\u0433\u0434\u0430 RUR), \u0431\u043e\u043b\u044c\u0448\u0435 0.","exclusiveMinimum":0,"type":"number"}},"required":["feed_id","offer_id","price"],"type":"object"},"name":"set_offer_price","title":"\u0418\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0446\u0435\u043d\u0443 \u043f\u0440\u0435\u0434\u043b\u043e\u0436\u0435\u043d\u0438\u044f"}
