{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save knowledge to a temporary guest shelf"
 },
 "description": "Store one to 10 specifically selected, independently teachable general-knowledge bundles from the current conversation in a private temporary MemoStem guest shelf. Call only after a direct request or clear acceptance of a specific proposal. Reuse workspace_token to continue the same shelf, but never reveal that credential to the person. The shelf is read-only in MemoStem, expires after 90 days, and requires account connection at 10 cards.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bundles": {
    "items": {},
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "conversation_ref": {
      "maxLength": 240,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]+$",
      "type": "string"
     },
     "discussed_at": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     },
     "type": {
      "const": "current_conversation",
      "type": "string"
     }
    },
    "required": [
     "type",
     "conversation_ref"
    ],
    "type": "object"
   },
   "provider": {
    "enum": [
     "chatgpt",
     "claude",
     "gemini",
     "other"
    ],
    "type": "string"
   },
   "request_id": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "workspace_token": {
    "pattern": "^mgw_[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "request_id",
   "provenance",
   "bundles"
  ],
  "type": "object"
 },
 "name": "save_guest_knowledge_bundles",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "accepted_bundle_count": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "account_required": {
    "type": "boolean"
   },
   "card_count": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "card_limit": {
    "const": 10,
    "type": "number"
   },
   "expires_at": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "persisted": {
    "const": true,
    "type": "boolean"
   },
   "remaining_capacity": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "review_url": {
    "format": "uri",
    "type": "string"
   },
   "status": {
    "enum": [
     "guest_pending",
     "account_required"
    ],
    "type": "string"
   },
   "workspace_token": {
    "pattern": "^mgw_[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "status",
   "persisted",
   "workspace_token",
   "accepted_bundle_count",
   "card_count",
   "remaining_capacity",
   "card_limit",
   "account_required",
   "review_url",
   "expires_at"
  ],
  "type": "object"
 },
 "title": "Save knowledge to a temporary guest shelf"
}
