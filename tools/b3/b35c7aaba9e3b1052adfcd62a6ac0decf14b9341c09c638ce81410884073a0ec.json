{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create or update a Cloud Functions action (Basic or Sequence type)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionName": {
    "description": "Name of the action to create or update",
    "type": "string"
   },
   "custom_options": {
    "description": "Enable custom options",
    "type": "boolean"
   },
   "description": {
    "description": "Description of the action",
    "type": "string"
   },
   "exec_binary": {
    "description": "Whether code is base64 encoded",
    "type": "boolean"
   },
   "exec_code": {
    "description": "Source code string (required for basic actions)",
    "type": "string"
   },
   "exec_components": {
    "description": "Array of '{packageName}/{actionName}' for sequence actions",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "exec_kind": {
    "description": "Runtime string (e.g. 'nodejs:16', 'python:3.9', 'java:11', 'dotnet:6.0', or 'sequence')",
    "type": "string"
   },
   "exec_main": {
    "description": "Entry function name (required for basic actions)",
    "type": "string"
   },
   "limits_memory": {
    "description": "Memory in MB (128, 256, 512, or 1024)",
    "type": "number"
   },
   "limits_timeout": {
    "description": "Timeout in milliseconds (500~300000)",
    "type": "number"
   },
   "packageName": {
    "default": "-",
    "description": "Package name (use '-' for unpackaged actions)",
    "type": "string"
   },
   "parameters": {
    "additionalProperties": {},
    "description": "Default parameters as a JSON object",
    "type": "object"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   },
   "raw_http": {
    "description": "Enable raw HTTP handling",
    "type": "boolean"
   },
   "subnet_no": {
    "description": "Subnet number",
    "type": "number"
   },
   "vpc_no": {
    "description": "VPC number",
    "type": "number"
   },
   "web": {
    "description": "Enable web action",
    "type": "boolean"
   }
  },
  "required": [
   "actionName",
   "exec_kind"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_create_action"
}
