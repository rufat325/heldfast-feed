{
 "description": "Generate a Software Bill of Materials (SBOM) for a project",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "SBOM format (default: cyclonedx)",
    "enum": [
     "cyclonedx",
     "spdx"
    ],
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "production": {
    "description": "Only include production dependencies",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "sbom"
}
