{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new case in Datadog Case Management",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Detailed description of the case",
    "type": "string"
   },
   "priority": {
    "default": "NOT_DEFINED",
    "description": "Case priority",
    "enum": [
     "NOT_DEFINED",
     "P1",
     "P2",
     "P3",
     "P4",
     "P5"
    ],
    "type": "string"
   },
   "title": {
    "description": "Case title",
    "type": "string"
   },
   "typeId": {
    "description": "Case type ID. Use list-cases to find valid type IDs",
    "type": "string"
   }
  },
  "required": [
   "title",
   "typeId"
  ],
  "type": "object"
 },
 "name": "create-case"
}
