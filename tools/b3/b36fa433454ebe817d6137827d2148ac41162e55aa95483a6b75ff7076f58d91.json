 "description": "\u5ba2\u6237\u7aef\u65e0\u6cd5\u542f\u52a8 OAuth \u65f6\u7684\u540e\u5907\u5165\u53e3\u3002\u8fd4\u56de\u6d4f\u89c8\u5668\u6ce8\u518c\u94fe\u63a5\u3002\u672c\u5de5\u5177\u4e0d\u521b\u5efa\u8d26\u6237\uff0c\u4e0d\u63a5\u6536\u5bc6\u7801\uff0c\u4e5f\u4e0d\u4ee3\u7528\u6237\u540c\u610f\u6761\u6b3e\u3002 Fallback when the client cannot start OAuth. Returns a browser registration link. This tool does not create an account, accept a password, or accept terms for the user.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "locale": "en"
   },
   {
    "locale": "zh-CN"
   }
  ],
  "properties": {
   "locale": {
    "description": "Browser signup page language. Does not accept email, password, or acceptance. API language preference. Canonical values: en and zh-CN. Documented aliases normalized to the canonical value: zh-cn, zh-Hans, zh-hans, zh_Hans, zh_hans. Traditional Chinese is not supported. EN, ZH-CN, and bare zh are rejected. Omitted or blank defaults to en. This preference does not rewrite URL bytes, translate parameter names, or use the caller's location. Website routes stay /zh-cn.",
    "enum": [
     "en",
     "zh-CN",
     "zh-cn",
     "zh-Hans",
     "zh-hans",
     "zh_Hans",
     "zh_hans"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "begin_registration",
