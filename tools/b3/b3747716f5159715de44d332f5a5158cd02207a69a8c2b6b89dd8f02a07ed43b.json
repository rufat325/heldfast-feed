{
 "_meta": {
  "ui": {
   "resourceUri": "ui://calibre/book-card.html"
  },
  "ui/resourceUri": "ui://calibre/book-card.html"
 },
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get full metadata (authors, ISBN, formats, comments, cover) for one book by its id or uuid (id and bookId are interchangeable \u2014 pass the bookId from a search result). Set include_cover=true only when the cover image itself must be inspected.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookId": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "include_cover": {
    "type": "boolean"
   },
   "library": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calibre_get_book",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "book": {
    "additionalProperties": false,
    "properties": {
     "authorSort": {
      "type": "string"
     },
     "authors": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "comments": {
      "type": "string"
     },
     "coverUrl": {
      "type": "string"
     },
     "formats": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "type": "number"
     },
     "identifiers": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "languages": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "lastModified": {
      "type": "string"
     },
     "pages": {
      "type": "number"
     },
     "pubdate": {
      "type": "string"
     },
     "publisher": {
      "type": "string"
     },
     "rating": {
      "type": "number"
     },
     "series": {
      "type": "string"
     },
     "seriesIndex": {
      "type": "number"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     },
     "uuid": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "libraryId": {
    "type": "string"
   },
   "serverUrl": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get book metadata"
}
