{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List Epsilon orders by maker wallet (defaults to the configured trading wallet), status, and/or type. Newest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "e.g. active, filled, cancelled",
    "type": "string"
   },
   "type": {
    "description": "e.g. limit, dca, trailing",
    "type": "string"
   },
   "wallet": {
    "description": "maker wallet; defaults to the configured trading wallet",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_orders"
}
