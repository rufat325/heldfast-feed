{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Identify canonical competitor domains for a query"
 },
 "description": "Fan a query across engines and aggregate citations by registered domain (not URL). Returns top competitor domains ranked by cross-engine consensus, with per-engine breakdown and top URLs per domain. Use to identify the canonical competitor set for a query - the domains every engine treats as authoritative.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "engines": {
    "description": "Engines to query. If omitted, uses all LLM engines with a configured API key (google_ai_mode, perplexity, claude, openai, gemini). Include bing_serp/brave_serp only for web_rank comparison.",
    "items": {
     "enum": [
      "perplexity",
      "claude",
      "openai",
      "gemini",
      "google_ai_mode",
      "bing_serp",
      "brave_serp"
     ],
     "type": "string"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array"
   },
   "exclude_domains": {
    "description": "Domains to filter out (e.g. your own brand, Wikipedia, Reddit). Suffix-match.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "max_results": {
    "default": 10,
    "description": "Max citations per engine.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query to fan out across engines.",
    "minLength": 1,
    "type": "string"
   },
   "top_n": {
    "default": 10,
    "description": "Max competitor domains to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "competitors_canonical_set",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domains": {
    "description": "Competitor domains ranked by cross-engine consensus.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "best_rank": {
       "description": "Best (lowest) rank across all citations.",
       "type": "number"
      },
      "by_engine": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "best_rank": {
          "type": "number"
         },
         "citations": {
          "type": "number"
         },
         "engine": {
          "type": "string"
         },
         "sample_urls": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "engine",
         "citations",
         "best_rank",
         "sample_urls"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "domain": {
       "description": "Registered domain (eTLD+1).",
       "type": "string"
      },
      "engine_count": {
       "description": "Number of engines that cited this domain.",
       "type": "number"
      },
      "top_urls": {
       "description": "Most-cited URLs for this domain.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "type": "number"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "url",
         "count"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "total_citations": {
       "type": "number"
      }
     },
     "required": [
      "domain",
      "total_citations",
      "engine_count",
      "best_rank",
      "by_engine",
      "top_urls"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "engines": {
    "description": "Per-engine run summary.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "citations": {
       "type": "number"
      },
      "engine": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "ok": {
       "type": "boolean"
      }
     },
     "required": [
      "engine",
      "ok",
      "citations"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "engines_queried": {
    "type": "number"
   },
   "engines_succeeded": {
    "type": "number"
   },
   "excluded_domains": {
    "description": "Registered domains that were filtered out.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "query": {
    "description": "The query that was fanned across engines.",
    "type": "string"
   },
   "top_n": {
    "description": "Maximum domains returned.",
    "type": "number"
   },
   "total_unique_domains": {
    "description": "Total unique competitor domains found before top_n truncation.",
    "type": "number"
   }
  },
  "required": [
   "query",
   "fetched_at",
   "engines",
   "engines_queried",
   "engines_succeeded",
   "excluded_domains",
   "total_unique_domains",
   "top_n",
   "domains"
  ],
  "type": "object"
 }
}
