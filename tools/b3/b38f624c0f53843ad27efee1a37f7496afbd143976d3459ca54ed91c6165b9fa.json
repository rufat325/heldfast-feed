{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Save or update prospects in a local named list. Accepts full person objects (deduped by email, LinkedIn URL, Apollo id, or name + domain) or { prospect_id, patch } edits. Use this to persist drafted copy (patch custom_fields.first_line) and to set status/notes/signals. Local write, no credits, no network. Suppressed people are still saved but flagged. Next: sdr_list_prospects or sdr_export_csv.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"list":{"description":"List slug ([a-z0-9-_]).","maxLength":64,"minLength":1,"type":"string"},"merge":{"description":"Merge strategy.","enum":["fill_missing","overwrite"],"type":"string"},"people":{"description":"People or { prospect_id, patch } edits.","items":{"anyOf":[{"properties":{"patch":{"properties":{"custom_fields":{"additionalProperties":{"maxLength":2000,"type":"string"},"propertyNames":{"type":"string"},"type":"object"},"notes":{"anyOf":[{"maxLength":4000,"type":"string"},{"type":"null"}]},"signals":{"items":{"properties":{"confidence":{"enum":["high","medium","low"],"type":"string"},"excerpt":{"maxLength":1500,"type":"string"},"matched_rule":{"type":"string"},"published_at":{"type":["string","null"]},"source":{"type":"string"},"title":{"type":"string"},"type":{"enum":["funding","hiring","leadership_change","product_launch","acquisition","tech_change","other"],"type":"string"},"url":{"type":"string"}},"required":["type","title","url","confidence"],"type":"object"},"maxItems":50,"type":"array"},"status":{"enum":["new","enriched","queued","contacted","replied","disqualified"],"type":"string"}},"type":"object"},"prospect_id":{"maxLength":80,"type":"string"}},"required":["prospect_id","patch"],"type":"object"},{"properties":{"company":{"anyOf":[{"properties":{"domain":{"type":"string"},"id":{"type":"string"},"name":{"type":"strin