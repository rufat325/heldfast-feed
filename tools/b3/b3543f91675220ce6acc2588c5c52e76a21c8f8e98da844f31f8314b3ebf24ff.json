 "description": "What X (Twitter) is saying about a topic, as numbers only, live: post volume per hour or day over the last 1-7 days, and over a sample of recent posts the engagement totals, averages and rate (likes, reposts, replies, quotes, impressions), language mix, top hashtags and link/media share. Aggregates only: no post text, ids, authors or profiles are returned. Input: query (X operators allowed); optional days, granularity, sample (0-100 posts read), lang, include_retweets. $0.50 per call. Returns: query, effective_query, window{}, granularity, volume{total, buckets[]}, sample{requested, read, pages, x_cost_usd}, engagement{likes_total, ..., languages{}, top_hashtags[]}, source, as_of, checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "Window ending now, default 7 (X's recent limit).",
    "maximum": 7,
    "minimum": 1,
    "type": "integer"
   },
   "granularity": {
    "description": "Volume buckets, default day.",
    "enum": [
     "hour",
     "day"
    ],
    "type": "string"
   },
   "include_retweets": {
    "description": "Default false: reposts are excluded from volume and sample.",
    "type": "boolean"
   },
   "lang": {
    "description": "Restrict to a language (en, ja...).",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "query": {
    "description": "Words or X search operators (\"machine learning\" from:nasa has:links).",
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   },
   "sample": {
    "description": "Recent posts read for the engagement aggregates, default 40; 0 = volume only.",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
