{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "grading:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Change grading prompt"
 },
 "description": "Changes a session's Fiveable question or teacher-provided prompt and AP question type before any essay is scored. Regenerates the rubric using that type's AP rubric and point total. Returns the previous prompt for restoration.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "fiveableQuestionId": {
    "maxLength": 120,
    "type": "string"
   },
   "prompt": {
    "additionalProperties": false,
    "properties": {
     "frqType": {
      "description": "Question type as Fiveable names it, e.g. \"Long Essay Question (LEQ)\". Omit to get the list.",
      "maxLength": 120,
      "type": "string"
     },
     "images": {
      "description": "Visuals the question depends on.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "data": {
         "description": "Base64 image, no data: prefix.",
         "maxLength": 6000000,
         "minLength": 1,
         "type": "string"
        },
        "mediaType": {
         "enum": [
          "image/jpeg",
          "image/png",
          "image/webp"
         ],
         "type": "string"
        }
       },
       "required": [
        "data",
        "mediaType"
       ],
       "type": "object"
      },
      "maxItems": 4,
      "type": "array"
     },
     "text": {
      "description": "The question exactly as the teacher assigned it.",
      "maxLength": 20000,
      "minLength": 20,
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "sessionId": {
    "description": "Grading session id from list_grading_sessions or create_grading_session.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "update_grading_rubric",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "grading:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Change grading prompt"
}
