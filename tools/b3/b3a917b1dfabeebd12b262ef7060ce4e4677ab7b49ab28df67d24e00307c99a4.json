{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Load Memory Pack"
 },
 "description": "Load a Governed Memory Pack into agent context. Validates TTL, trust level, role access, context class, and hash integrity before loading.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "Agent requesting the load",
    "maxLength": 100,
    "type": "string"
   },
   "context_class": {
    "description": "Execution context class",
    "enum": [
     "PROD",
     "STAGING",
     "DEMO",
     "EVAL_ONLY",
     "TRAINING"
    ],
    "type": "string"
   },
   "operator_role": {
    "description": "Role of the operator",
    "maxLength": 100,
    "type": "string"
   },
   "pack_id": {
    "description": "Memory pack ID to load",
    "maxLength": 100,
    "type": "string"
   },
   "run_id": {
    "description": "Current run/pipeline ID",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "pack_id",
   "agent_id",
   "run_id",
   "operator_role"
  ],
  "type": "object"
 },
 "name": "load_memory_pack"
}
