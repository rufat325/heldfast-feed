{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Check the current status of a recently created or modified resource by type and ID",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "resourceId": {
    "description": "Resource instance number/ID to check",
    "type": "string"
   },
   "resourceType": {
    "description": "Type of the resource to check status",
    "enum": [
     "server",
     "vpc",
     "subnet",
     "loadbalancer",
     "targetGroup",
     "natGateway",
     "mysqlInstance",
     "blockStorage",
     "publicIp",
     "acg",
     "networkAcl",
     "autoScalingGroup"
    ],
    "type": "string"
   }
  },
  "required": [
   "resourceType",
   "resourceId"
  ],
  "type": "object"
 },
 "name": "ncloud_get_operation_status"
}
