{
 "_meta": {
  "ui": {
   "resourceUri": "ui://seminara.online/sessions/create"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Seminara interactive presentation session with optional CTA, live publishing, slides, and knowledge base context.",
 "inputSchema": {
  "properties": {
   "ctaText": {
    "description": "Call to action button text (e.g. \"Book a Demo\")",
    "type": "string"
   },
   "ctaUrl": {
    "description": "Call to action destination link (e.g. \"https://cal.com/meeting\")",
    "type": "string"
   },
   "description": {
    "description": "Optional session description",
    "type": "string"
   },
   "isLive": {
    "description": "Whether to publish session live immediately (default false, stays draft)",
    "type": "boolean"
   },
   "knowledgeBase": {
    "description": "Optional background knowledge context or FAQs for Aura",
    "items": {
     "properties": {
      "content": {
       "description": "Contextual content text",
       "type": "string"
      },
      "title": {
       "description": "Document or topic title",
       "type": "string"
      }
     },
     "required": [
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pdfUrl": {
    "description": "Optional presentation PDF URL",
    "type": "string"
   },
   "slides": {
    "description": "Optional slide cards to seed for this session",
    "items": {
     "properties": {
      "agentNotes": {
       "description": "Private presenter instructions for Aura",
       "type": "string"
      },
      "imageUrl": {
       "description": "Slide image URL",
       "type": "string"
      },
      "textContent": {
       "description": "Slide key text and bullet points",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Session title",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_session",
 "outputSchema": {
  "properties": {
   "createdAt": {
    "description": "ISO timestamp of creation",
    "type": "string"
   },
   "id": {
    "description": "UUID of the created session",
    "type": "string"
   },
   "isLive": {
    "description": "Whether session is published live",
    "type": "boolean"
   },
   "rehearsalUrl": {
    "description": "Zero-cost rehearsal sandbox link",
    "type": "string"
   },
   "roomUrl": {
    "description": "Audience join link",
    "type": "string"
   },
   "status": {
    "description": "Session status (draft or published)",
    "type": "string"
   },
   "title": {
    "description": "Session title",
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "status",
   "roomUrl"
  ],
  "type": "object"
 }
}
