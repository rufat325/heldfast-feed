{
 "description": "Transform an image with a new prompt while preserving characteristics. Control influence with image_weight (0-100).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "description": "Output aspect ratio",
    "enum": [
     "1x1",
     "16x9",
     "9x16",
     "4x3",
     "3x4",
     "3x2",
     "2x3",
     "4x5",
     "5x4",
     "1x2",
     "2x1",
     "1x3",
     "3x1",
     "10x16",
     "16x10"
    ],
    "type": "string"
   },
   "image": {
    "description": "Local file path of the source image to remix",
    "minLength": 1,
    "type": "string"
   },
   "image_weight": {
    "description": "Original image influence (0-100, default: 50)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "magic_prompt": {
    "description": "Auto-enhance prompts (default: AUTO)",
    "enum": [
     "AUTO",
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "negative_prompt": {
    "description": "What to exclude",
    "type": "string"
   },
   "num_images": {
    "description": "Number of variations (1-8, default: 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "description": "New creative direction",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "rendering_speed": {
    "description": "Speed/quality tradeoff (default: DEFAULT)",
    "enum": [
     "FLASH",
     "TURBO",
     "DEFAULT",
     "QUALITY"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Reproducibility seed",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "style_type": {
    "description": "Visual style (default: AUTO)",
    "enum": [
     "AUTO",
     "GENERAL",
     "REALISTIC",
     "DESIGN",
     "FICTION"
    ],
    "type": "string"
   }
  },
  "required": [
   "image",
   "prompt"
  ],
  "type": "object"
 },
 "name": "ideogram_remix"
}
