{
 "description": "Create a pipeline task. Tasks start in \"backlog\" and move through stages: backlog \u2192 spec \u2192 plan \u2192 implement \u2192 test \u2192 review \u2192 done. Use parent_id to create subtasks under an existing task.",
 "inputSchema": {
  "properties": {
   "assign_to": {
    "description": "Agent name to assign to",
    "type": "string"
   },
   "description": {
    "description": "Detailed instructions (max 50K chars)",
    "type": "string"
   },
   "parent_id": {
    "description": "Parent task ID \u2014 creates a subtask that inherits project and priority",
    "type": "number"
   },
   "priority": {
    "description": "Priority \u2014 higher number = more important (default: 0)",
    "type": "number"
   },
   "project": {
    "description": "Project name for grouping",
    "type": "string"
   },
   "stage": {
    "description": "Initial pipeline stage (default: backlog)",
    "type": "string"
   },
   "tags": {
    "description": "Tags for categorization",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "description": "Task title (max 500 chars)",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "task_create"
}
