{
 "annotations": {},
 "description": "Send Alim Talk (KakaoTalk notification) messages through SENS (POST /alimtalk/v2/services/{serviceId}/messages \u2192 202). Every field must match the approved template (content, buttons, item list). Optional SMS failover per message. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "default": false,
    "description": "If true, returns the request preview without sending",
    "type": "boolean"
   },
   "messages": {
    "description": "Recipients (1-100)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "buttons": {
       "description": "Buttons (must match the template)",
       "items": {
        "additionalProperties": false,
        "properties": {
         "linkMobile": {
          "description": "Mobile URL (required for WL)",
          "type": "string"
         },
         "linkPc": {
          "description": "PC URL (required for WL)",
          "type": "string"
         },
         "name": {
          "description": "Button label (\u226420 chars; '\ucc44\ub110 \ucd94\uac00' for AC)",
          "maxLength": 20,
          "type": "string"
         },
         "schemeAndroid": {
          "description": "Android scheme (required for AL)",
          "type": "string"
         },
         "schemeIos": {
          "description": "iOS scheme (required for AL)",
          "type": "string"
         },
         "type": {
          "description": "DS delivery | WL web link | AL app link | BK bot keyword | MD message | AC add channel",
          "enum": [
           "DS",
           "WL",
           "AL",
           "BK",
           "MD",
           "AC"
          ],
          "type": "string"
         }
        },
        "required": [
         "type",
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "content": {
       "description": "Message content (must match the template)",
       "type": "string"
      },
      "countryCode": {
       "description": "Country code (default 82)",
       "type": "string"
      },
      "failoverConfig": {
       "additionalProperties": false,
       "description": "SMS failover settings (used with useSmsFailover=true)",
       "properties": {
        "content": {
         "description": "Failover content (default = the message content without buttons)",
         "type": "string"
        },
        "from": {
         "description": "Failover sender number (registered in the console)",
         "type": "string"
        },
        "subject": {
         "description": "Failover subject (LMS only; default = channel name)",
         "type": "string"
        },
        "type": {
         "description": "Failover type; omitted = SMS when \u226490 bytes, else LMS",
         "enum": [
          "SMS",
          "LMS"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "headerContent": {
       "description": "Header (item-list templates only, \u226416 bytes)",
       "type": "string"
      },
      "item": {
       "additionalProperties": false,
       "description": "Item list (item-list templates)",
       "properties": {
        "list": {
         "description": "Items (2-10)",
         "items": {
          "additionalProperties": false,
          "properties": {
           "description": {
            "description": "Item value (1-23 chars)",
            "maxLength": 23,
            "minLength": 1,
            "type": "string"
           },
           "title": {
            "description": "Item name (1-6 chars)",
            "maxLength": 6,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "title",
           "description"
          ],
          "type": "object"
         },
         "maxItems": 10,
         "minItems": 2,
         "type": "array"
        },
        "summary": {
         "additionalProperties": false,
         "description": "Item summary",
         "properties": {
          "description": {
           "description": "Summary value (currency symbol/code, digits, comma, space, 2-decimal point)",
           "maxLength": 23,
           "minLength": 1,
           "type": "string"
          },
          "title": {
           "description": "Summary label (1-6 chars)",
           "maxLength": 6,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "title",
          "description"
         ],
         "type": "object"
        }
       },
       "required": [
        "list"
       ],
       "type": "object"
      },
      "itemHighlight": {
       "additionalProperties": false,
       "description": "Item highlight (item-list templates)",
       "properties": {
        "description": {
         "description": "Highlight description",
         "type": "string"
        },
        "title": {
         "description": "Highlight title (\u226430 chars / 15 per line; with image \u226421 / 10 per line)",
         "type": "string"
        }
       },
       "required": [
        "title",
        "description"
       ],
       "type": "object"
      },
      "title": {
       "description": "Emphasis title (emphasis-type templates only)",
       "type": "string"
      },
      "to": {
       "description": "Recipient number (digits only)",
       "pattern": "^\\d+$",
       "type": "string"
      },
      "useSmsFailover": {
       "description": "Send SMS/LMS when the Alim Talk is not delivered (not for 'B'-prefixed result codes)",
       "type": "boolean"
      }
     },
     "required": [
      "to",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "plusFriendId": {
    "description": "KakaoTalk channel ID (e.g. @channelname)",
    "type": "string"
   },
   "reserveTime": {
    "description": "Scheduled send time 'YYYY-MM-DD HH:mm' (no seconds; must be at least 10 minutes from now)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}$",
    "type": "string"
   },
   "reserveTimeZone": {
    "description": "tz database name for reserveTime (default Asia/Seoul)",
    "type": "string"
   },
   "serviceId": {
    "description": "ALIMTALK service ID in NRN form (e.g. ncp:kkobizmsg:kr:1********2:myproject). Defaults to NCLOUD_SENS_ALIMTALK_SERVICE_ID / NCLOUD_SENS_SERVICE_ID. Find it with ncloud_sens_list_projects (kkoBizMsgService.serviceId). A 'Forbidden' reply means the project does not have this channel enabled.",
    "type": "string"
   },
   "templateCode": {
    "description": "Approved template code",
    "type": "string"
   }
  },
  "required": [
   "plusFriendId",
   "templateCode",
   "messages"
  ],
  "type": "object"
 },
 "name": "ncloud_sens_send_alimtalk"
}
