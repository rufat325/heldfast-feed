{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "One-call AgentEnvelope decision for a proposed agent action. It normalizes hosted verification into allowed/denied and checks optional operation/resource labels against the verified record envelope when present.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actionIndex": {
    "description": "The action index",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "agentId": {
    "description": "The registered agent id",
    "pattern": "^[a-zA-Z0-9_:-]{1,128}$",
    "type": "string"
   },
   "expectedActionEnvelopeHash": {
    "description": "Optional expected action-envelope hash",
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "operation": {
    "description": "The proposed operation, for decision context and audit readability",
    "pattern": "^[a-zA-Z0-9_:.*/-]{1,256}$",
    "type": "string"
   },
   "payload": {
    "description": "The exact signed action payload"
   },
   "resource": {
    "description": "The proposed resource, for decision context and audit readability",
    "pattern": "^[a-zA-Z0-9_:.*/-]{1,256}$",
    "type": "string"
   },
   "signature": {
    "description": "0x-prefixed 65-byte signature",
    "pattern": "^0x[a-fA-F0-9]{130}$",
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "actionIndex",
   "payload",
   "signature"
  ],
  "type": "object"
 },
 "name": "ae_authorize_action",
 "title": "Authorize action (hosted decision)"
}
