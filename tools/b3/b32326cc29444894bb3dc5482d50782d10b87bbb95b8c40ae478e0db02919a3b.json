{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search cruises"
 },
 "description": "Search cruises sold to the UK market by destination, departure port, cruise line, ship, months or dates, length, budget, no-fly (UK departures) and ocean or river. Names or slugs both work, and anything we can't match comes back in not_understood. query takes free text (\"a week in the fjords from Southampton next June\"); structured fields win where both are given. Returns up to 20 cruises a page, with prices in pounds (each with its basis and the date it was checked), month counts and Cruisify links. The cursor holds only the page number, so for the next page call again with the same fields (applied_filters, without query) and next_cursor as cursor, up to 10 pages.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cruise_lines": {
    "description": "Cruise line names, slugs or short names: \"P&O\", \"fred-olsen\"",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "cursor": {
    "description": "next_cursor from the previous page. It holds only the page number, so send it with that page's applied_filters",
    "maxLength": 64,
    "type": "string"
   },
   "date_from": {
    "description": "Earliest departure date, YYYY-MM-DD",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "date_to": {
    "description": "Latest departure date, YYYY-MM-DD",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "departure_ports": {
    "description": "Departure port names or slugs: \"Southampton\" (list_departure_ports has them all)",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "destinations": {
    "description": "Destination names or slugs: \"Caribbean\", \"norwegian-fjords\" (list_destinations has them all)",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "kind": {
    "description": "ocean or river cruises only",
    "enum": [
     "ocean",
     "river"
    ],
    "type": "string"
   },
   "max_price_gbp": {
    "description": "Highest price per person, in pounds",
    "maximum": 1000000,
    "minimum": 1,
    "type": "integer"
   },
   "months": {
    "description": "Departure months, YYYY-MM",
    "items": {
     "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])$",
     "type": "string"
    },
    "maxItems": 24,
    "type": "array"
   },
   "nights_max": {
    "description": "Longest length, in nights",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "nights_min": {
    "description": "Shortest length, in nights",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "no_fly": {
    "description": "true: only cruises leaving from a UK port",
    "type": "boolean"
   },
   "query": {
    "description": "Free text, read into the fields above: \"a week in the fjords from Southampton next June\". Structured fields win where both are given. Leave it out when paging.",
    "maxLength": 200,
    "type": "string"
   },
   "round_trip": {
    "description": "true: round trips only; false: one-way only",
    "type": "boolean"
   },
   "ships": {
    "description": "Ship names or slugs",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "sort": {
    "description": "departure (default), price, price_per_night, nights (shortest first) or newest",
    "enum": [
     "departure",
     "price",
     "price_per_night",
     "nights",
     "newest"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_cruises",
