      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "nights_max": {
      "description": "Longest length, in nights",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "nights_min": {
      "description": "Shortest length, in nights",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "no_fly": {
      "description": "Only cruises leaving from a UK port",
      "type": "boolean"
     },
     "round_trip": {
      "description": "true: round trips only; false: one-way only",
      "type": "boolean"
     },
     "ships": {
      "description": "Ship slugs",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sort": {
      "description": "The order of the results",
      "enum": [
       "departure",
       "price",
       "price_per_night",
       "nights",
       "newest"
      ],
      "type": "string"
     }
    },
    "required": [
     "destinations",
     "departure_ports",
     "cruise_lines",
     "ships",
     "months",
     "no_fly",
     "sort"
    ],
    "type": "object"
   },
   "by_month": {
    "additionalProperties": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "description": "Matching cruises per departure month (YYYY-MM), counted without any months or dates asked for",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "freshness": {
    "description": "fresh: up to date; stale: some dates or prices may be out of date; cache_only: from the cruises we already held",
    "enum": [
     "fresh",
     "stale",
     "cache_only"
    ],
    "type": "string"
   },
   "landing_url": {
    "description": "The Cruisify page for this search, when there is one",
    "format": "uri",
    "type": "string"
   },
   "next_cursor": {
    "description": "The cursor for the next page, with applied_filters; absent on the last page we give (page 10 at most)",
    "type": "string"
   },
   "not_understood": {
    "description": "What was asked for but left out of the search, and why",
    "items": {
     "additionalProperties": false,
     "properties": {
      "reason": {
       "description": "Why it was left out of the search",
       "type": "string"
      },
      "text": {
       "description": "What was asked for",
       "type": "string"
      }
     },
     "required": [
      "text",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "page": {
    "description": "This page's number, 20 cruises to a page",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "results": {
    "description": "This page's cruises",
    "items": {
     "additionalProperties": false,
     "properties": {
      "book_url": {
       "description": "Where to book: the priced sailing, or the cruise line when there is no price",
       "format": "uri",
       "type": "string"
      },
      "cruise_line": {
       "description": "The cruise line's name",
       "type": "string"
      },
      "dates_available": {
       "description": "How many matching departure dates it has",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "kind": {
       "description": "ocean, river or expedition",
       "enum": [
        "ocean",
        "river",
        "expedition"
       ],
       "type": "string"
      },
      "next_departure": {
       "description": "The first matching departure date",
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "nights": {
       "description": "Length in nights",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "price": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "basis": {
           "description": "What the price covers, in the cruise line's own words",
           "type": "string"
          },
          "checked_at": {
           "description": "The UK date the price was checked, YYYY-MM-DD",
           "format": "date",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
           "type": "string"
          },
          "converted_from": {
           "description": "The currency we converted the price from, so it is our estimate; null for a price set in pounds",
           "type": [
            "string",
            "null"
           ]
          },
          "for_departure": {
           "description": "The departure date this price is for",
           "format": "date",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
           "type": "string"
          },
          "from_gbp": {
           "description": "The lowest price per person, in pounds",
