{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Ingest Transcript"
 },
 "description": "Store a transcript source and return an extraction prompt for the calling agent's model. Raven makes no model or network call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "source_meta": {
    "additionalProperties": false,
    "description": "Metadata identifying the transcript source.",
    "properties": {
     "kind": {
      "description": "Source kind. Defaults to meeting.",
      "type": "string"
     },
     "ref": {
      "description": "Source reference, such as a meeting title, URL, or date.",
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "ref"
    ],
    "type": "object"
   },
   "text": {
    "description": "Transcript text to extract design decisions from.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text",
   "source_meta"
  ],
  "type": "object"
 },
 "name": "ingest_transcript"
}
