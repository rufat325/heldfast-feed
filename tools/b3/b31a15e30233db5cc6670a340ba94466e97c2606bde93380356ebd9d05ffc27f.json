{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Chercher des sorties sourc\u00e9es"
 },
 "description": "Alias stable de rechercher_evenements : commune, dates, cat\u00e9gorie, gratuit\u00e9 explicitement connue et langue. Les r\u00e9sultats comprennent les r\u00e9f\u00e9rences des fiches publiques et leurs sources.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "categorie": {
    "maxLength": 120,
    "type": "string"
   },
   "commune": {
    "maxLength": 120,
    "type": "string"
   },
   "date_debut": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_fin": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "gratuit": {
    "type": "boolean"
   },
   "langue": {
    "default": "fr",
    "enum": [
     "fr",
     "en",
     "de",
     "nl",
     "it",
     "es"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "periode": {
    "default": "a_venir",
    "enum": [
     "a_venir",
     "archives",
     "tous"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 160,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "chercher_sorties",
 "title": "Chercher des sorties sourc\u00e9es"
}
