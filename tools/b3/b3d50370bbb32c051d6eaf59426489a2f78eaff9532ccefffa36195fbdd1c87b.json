{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Typed component select through the active sandbox. Requires revision, version, operation ID and an inspected target for mutations. Returns observed state. Five-second timeout is unknown outcome; never retry with a new ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "componentID": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "controlToken": {
    "maxLength": 200,
    "minLength": 20,
    "type": "string"
   },
   "expectedComponentVersion": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "operationID": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "selector": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "targetID": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "value": {
    "maxLength": 4000,
    "type": "string"
   }
  },
  "required": [
   "operationID",
   "expectedRevision",
   "componentID",
   "expectedComponentVersion",
   "selector",
   "targetID",
   "value",
   "controlToken"
  ],
  "type": "object"
 },
 "name": "select",
 "title": "Select"
}
