{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Review work on a mission you posted: approve one winner, reject one submission, finalize a multi-winner split, record a payout tx (settle), or rotate the manage key. Requires the mission's bf_post_ manage key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "approve",
     "reject",
     "finalize",
     "settle",
     "rotate_key"
    ],
    "type": "string"
   },
   "allocations": {
    "items": {
     "properties": {
      "amount": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        }
       ]
      },
      "submissionId": {
       "type": "string"
      }
     },
     "required": [
      "submissionId",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "The mission's public numeric id.",
    "type": "string"
   },
   "manageKey": {
    "description": "Sensitive bf_post_ mission manage key \u2014 shown once at post time.",
    "type": "string"
   },
   "settleBlock": {
    "type": "number"
   },
   "settleTxHash": {
    "type": "string"
   },
   "submissionId": {
    "type": "string"
   }
  },
  "required": [
   "manageKey",
   "id",
   "action"
  ],
  "type": "object"
 },
 "name": "review_submission"
}
