{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Build a harmonious color palette from a base color using color-theory rules (complementary, analogous, triadic, tetradic, or monochromatic). Returns each color as hex and HSL. Use to derive a theme or design tokens from one brand color.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "Base color: \"#3b82f6\", \"rgb(...)\" or \"hsl(...)\".",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "harmony": {
    "default": "analogous",
    "description": "Color-harmony rule.",
    "enum": [
     "complementary",
     "analogous",
     "triadic",
     "tetradic",
     "monochromatic"
    ],
    "type": "string"
   }
  },
  "required": [
   "color"
  ],
  "type": "object"
 },
 "name": "color_palette",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base": {
    "description": "The base color as hex.",
    "type": "string"
   },
   "colors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "hex": {
       "type": "string"
      },
      "hsl": {
       "type": "string"
      }
     },
     "required": [
      "hex",
      "hsl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "harmony": {
    "type": "string"
   }
  },
  "required": [
   "harmony",
   "base",
   "colors"
  ],
  "type": "object"
 },
 "title": "Generate a color palette"
}
