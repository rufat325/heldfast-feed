{
 "description": "Act on a project: join it, log progress, or ship it (founder only). action = join | log | ship.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "join",
     "log",
     "ship"
    ],
    "type": "string"
   },
   "entry": {
    "description": "for action=log: what got done",
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "url": {
    "description": "for action=ship: where it lives",
    "type": "string"
   }
  },
  "required": [
   "name",
   "action"
  ],
  "type": "object"
 },
 "name": "aiim_project_action"
}
