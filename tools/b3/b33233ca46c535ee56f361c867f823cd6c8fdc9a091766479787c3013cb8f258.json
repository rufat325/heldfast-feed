{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "research:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find supported markets"
 },
 "description": "Search the same crypto, stock and ETF directory as Premiss. Does not return prices or candles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asset_class": {
    "enum": [
     "crypto",
     "stock",
     "etf"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": "",
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "query",
   "limit"
  ],
  "type": "object"
 },
 "name": "search_markets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "markets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "active": {
       "type": "boolean"
      },
      "assetClass": {
       "enum": [
        "crypto",
        "stock",
        "etf"
       ],
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "exchange": {
       "type": "string"
      },
      "market": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "symbol": {
       "type": "string"
      }
     },
     "required": [
      "market",
      "symbol",
      "name",
      "assetClass",
      "exchange",
      "currency",
      "active"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "markets"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "research:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Find supported markets"
}
