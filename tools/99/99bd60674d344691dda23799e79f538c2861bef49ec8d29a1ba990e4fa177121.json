{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Send a poll message via WhatsApp. Polls support 2-12 options and optional multi-select. Only supported on Baileys channels.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channelId": {
    "description": "WhatsApp channel identifier (UUID)",
    "type": "string"
   },
   "name": {
    "description": "Poll question/title",
    "minLength": 1,
    "type": "string"
   },
   "options": {
    "description": "Poll answer options (2-12 items)",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "minItems": 2,
    "type": "array"
   },
   "selectableCount": {
    "description": "Max selections allowed. 0 = unlimited (default). 1 = single-choice.",
    "minimum": 0,
    "type": "integer"
   },
   "to": {
    "description": "Recipient JID or phone number (individual or group)",
    "type": "string"
   }
  },
  "required": [
   "channelId",
   "to",
   "name",
   "options"
  ],
  "type": "object"
 },
 "name": "neuron_send_poll",
 "title": "Send Poll"
}
