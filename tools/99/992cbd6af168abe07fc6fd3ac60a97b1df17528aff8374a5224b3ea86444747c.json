{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free pilot: convert dated decimal-string amounts to EUR using exact-date ECB historical references. Up to 500 rows, eight currency/year snapshots, 48,000 UTF-8 argument bytes; start with small batches. Unique id per row. Half-even rounding by default, two decimals per line; total sums rounded lines. EUR uses identity, without a source quote. Preserve original amounts, rates and source evidence. Missing, stale or mismatched rates block complete export and total; never substitute another date. JSON by default; output_format=both includes CSV in the same result. ECB originals are free; indicative references are not executable prices or accounting/tax certification. Source checks are not independent verification. No transfer, customer-content retention or content logging.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "output_format": {
    "default": "json",
    "description": "json keeps the response smaller. both includes the CSV in the same free result; no separate export purchase.",
    "enum": [
     "json",
     "both"
    ],
    "type": "string"
   },
   "rounding": {
    "default": "half_even",
    "enum": [
     "half_even",
     "half_away_from_zero"
    ],
    "type": "string"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "pattern": "^-?\\d{1,36}(?:\\.\\d{1,18})?$",
       "type": "string"
      },
      "currency": {
       "pattern": "^[A-Z]{3}$",
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "id": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "date",
      "currency",
      "amount"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "name": "convert_currency_batch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "billing": {
    "additionalProperties": false,
    "properties": {
     "charged": {
      "const": false,
      "type": "boolean"
     },
     "enabled": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "enabled",
     "charged"
    ],
    "type": "object"
   },
   "blocked_rows": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "complete_artifact_available": {
    "type": "boolean"
   },
   "rows": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "row": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "status": {
       "enum": [
        "converted",
        "blocked"
       ],
       "type": "string"
      }
     },
     "required": [
      "row",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "evidence_sha256": {
       "type": "string"
      },
      "independently_verified": {
       "const": false,
       "type": "boolean"
      },
      "record_id": {
       "type": "string"
      },
      "source_url": {
       "type": "string"
      }
     },
     "required": [
      "record_id",
      "source_url",
      "evidence_sha256",
      "independently_verified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "complete",
     "incomplete"
    ],
    "type": "string"
   },
   "target_currency": {
    "const": "EUR",
    "type": "string"
   },
   "total_eur": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "target_currency",
   "rows",
   "sources",
   "blocked_rows",
   "total_eur",
   "complete_artifact_available",
   "billing"
  ],
  "type": "object"
 }
}
