{
 "_meta": {
  "openai/profile": true,
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "profile",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the stable Lots of Sounds profile connected to this request. Use it only to identify the active plugin account.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "email": {
    "description": "Email address for display.",
    "format": "email",
    "type": "string"
   },
   "id": {
    "description": "Opaque profile ID that stays unchanged for this account.",
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   },
   "name": {
    "description": "Display name for the connected profile.",
    "type": "string"
   },
   "nickname": {
    "description": "Label for the connected profile.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Get connected profile"
}
