{
 "description": "D\u00edas h\u00e1biles entre dos fechas (inclusive) en Uruguay o Argentina, descontando fines de semana y feriados. O, con `sumar`, la fecha que resulta de sumar N d\u00edas h\u00e1biles a `desde` (negativo para restar).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "desde": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hasta": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "pais": {
    "enum": [
     "uy",
     "ar"
    ],
    "type": "string"
   },
   "sumar": {
    "maximum": 1000,
    "minimum": -1000,
    "type": "integer"
   }
  },
  "required": [
   "pais",
   "desde"
  ],
  "type": "object"
 },
 "name": "dias_habiles",
 "title": "D\u00edas h\u00e1biles"
}
