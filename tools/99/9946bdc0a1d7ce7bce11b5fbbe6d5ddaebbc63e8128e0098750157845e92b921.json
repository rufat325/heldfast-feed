{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Active Hyperliquid markets with display symbol, class (perp, spot, prediction), HIP-3 issuer and base asset. Use search to find how a market is named (e.g. search 'nvda' finds xyz:NVDA-PERP).",
 "inputSchema": {
  "properties": {
   "issuer": {
    "description": "HIP-3 issuer code (e.g. 'flx'). Pass empty string '' to return only native non-builder markets. Omit to include every issuer.",
    "type": "string"
   },
   "limit": {
    "description": "Rows to return (default 100)",
    "type": "number"
   },
   "market_class": {
    "description": "Market class. Omit to return perp + spot + prediction. 'prediction' filters to HIP-4 outcome contracts.",
    "enum": [
     "perp",
     "spot",
     "prediction",
     "option"
    ],
    "type": "string"
   },
   "search": {
    "description": "Case-insensitive match on symbol, base asset or Hyperliquid coin",
    "type": "string"
   },
   "source": {
    "description": "Venue. Defaults to 'hyperliquid'.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_markets",
 "outputSchema": {
  "description": "Active markets",
  "properties": {
   "data": {
    "description": "Markets",
    "items": {
     "description": "One market",
     "properties": {
      "active_from_ms": {
       "description": "Listing time, Unix milliseconds"
      },
      "base_asset": {
       "description": "Base asset"
      },
      "base_market": {
       "description": "Display symbol without the HIP-3 issuer prefix"
      },
      "display_symbol": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "hl_coin": {
       "description": "Hyperliquid coin string"
      },
      "issuer": {
       "description": "HIP-3 builder code (\"\" for native markets)"
      },
      "market_class": {
       "description": "perp, spot, prediction or option"
      },
      "market_id": {
       "description": "Stable market id"
      },
      "max_leverage": {
       "description": "Maximum leverage"
      },
      "quote_asset": {
       "description": "Quote asset, e.g. USDC"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "matched": {
    "description": "Markets matching the search"
   },
   "returned": {
    "description": "Rows in data"
   },
   "total_markets": {
    "description": "Active markets before search"
   }
  },
  "type": "object"
 }
}
