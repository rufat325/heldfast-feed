{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Mapbox Token Tool"
 },
 "description": "Create a new Mapbox public access token with specified scopes and optional URL restrictions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowedUrls": {
    "description": "Optional array of URLs where the token can be used (max 100)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expires": {
    "description": "Optional expiration time in ISO 8601 format (maximum 1 hour in the future)",
    "type": "string"
   },
   "note": {
    "description": "Description of the token",
    "type": "string"
   },
   "scopes": {
    "description": "Array of scopes/permissions for the public token. Valid scopes: styles:tiles, styles:read, fonts:read, datasets:read, vision:read.",
    "items": {
     "enum": [
      "styles:tiles",
      "styles:read",
      "fonts:read",
      "datasets:read",
      "vision:read"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "note",
   "scopes"
  ],
  "type": "object"
 },
 "name": "create_token_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowedUrls": {
    "description": "URLs that the token is restricted to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "client": {
    "description": "The client for the token",
    "type": "string"
   },
   "created": {
    "description": "ISO 8601 creation timestamp",
    "type": "string"
   },
   "default": {
    "description": "Whether this is the default token",
    "type": "boolean"
   },
   "expires": {
    "description": "Expiration time in ISO 8601 format (temporary tokens only)",
    "type": "string"
   },
   "id": {
    "description": "The token's unique identifier",
    "type": "string"
   },
   "modified": {
    "description": "ISO 8601 last modified timestamp",
    "type": "string"
   },
   "note": {
    "description": "Human-readable description of the token",
    "type": [
     "string",
     "null"
    ]
   },
   "scopes": {
    "description": "Array of scopes granted to the token",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "token": {
    "description": "The actual access token string",
    "type": "string"
   },
   "usage": {
    "description": "Token usage type: pk (public), sk (secret), or tk (temporary)",
    "enum": [
     "pk",
     "sk",
     "tk"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "usage",
   "client",
   "default",
   "scopes",
   "note",
   "created",
   "modified",
   "token"
  ],
  "type": "object"
 },
 "title": "Create Mapbox Token Tool"
}
