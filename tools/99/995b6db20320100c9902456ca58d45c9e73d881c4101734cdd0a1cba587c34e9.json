{
 "description": "Confirm stablecoin payment for a discount code. After calling insumer_verify, confirm that the USDC/USDT payment was made on-chain. The server verifies the transaction receipt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "Stablecoin amount sent",
    "type": [
     "string",
     "number"
    ]
   },
   "chainId": {
    "anyOf": [
     {
      "enum": [
       "1",
       "8453",
       "137",
       "42161",
       "10",
       "56",
       "43114"
      ],
      "type": "string"
     },
     {
      "type": "integer"
     },
     {
      "const": "solana",
      "type": "string"
     },
     {
      "const": "tron",
      "type": "string"
     }
    ],
    "description": "Payment chain: EVM chain ID (1, 8453, 137, 42161, 10, 56, 43114), 'solana', or 'tron'"
   },
   "code": {
    "description": "Verification code from insumer_verify (e.g. INSR-A7K3M)",
    "type": "string"
   },
   "txHash": {
    "description": "On-chain transaction hash or Solana signature",
    "type": "string"
   }
  },
  "required": [
   "code",
   "txHash",
   "chainId",
   "amount"
  ],
  "type": "object"
 },
 "name": "insumer_confirm_payment"
}
