  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Resolve up to 100 symbols in a single request. Requires a plan with bulk endpoints enabled. Your current plan does not include bulk endpoints \u2014 calls will return 403.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "context": {
    "description": "Source exchange or quote currency applied to every input symbol",
    "type": "string"
   },
   "symbols": {
    "description": "Up to 100 symbols to resolve in a single request",
    "items": {
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "resolve_symbols_batch",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "resolved": {
