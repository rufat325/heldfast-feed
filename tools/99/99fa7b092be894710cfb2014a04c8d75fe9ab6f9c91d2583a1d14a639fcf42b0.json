{
 "description": "Deploy a new token on PumpClaw (Base, Uniswap V4). Requires BASE_PRIVATE_KEY env var. Free \u2014 no ETH cost.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "creator": {
    "description": "Creator address for fee attribution (default: deployer wallet)",
    "type": "string"
   },
   "imageUrl": {
    "description": "Token logo URL (optional)",
    "type": "string"
   },
   "initialFdv": {
    "description": "Initial FDV in ETH (default: 2)",
    "type": "string"
   },
   "name": {
    "description": "Token name (e.g. 'My Cool Token')",
    "type": "string"
   },
   "symbol": {
    "description": "Token ticker symbol (e.g. 'MCT')",
    "type": "string"
   },
   "totalSupply": {
    "description": "Total supply in tokens (default: 1000000000)",
    "type": "string"
   },
   "websiteUrl": {
    "description": "Project website URL (optional)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "symbol"
  ],
  "type": "object"
 },
 "name": "deploy_token"
}
