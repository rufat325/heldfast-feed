  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Put a scene on a stream"
 },
 "description": "Makes a stream play a scene (its published version) instead of a video playlist, or with scene null stops doing so. Refused (STREAM_LIVE) while the stream runs: stop it, set the scene, start it again. The scene must be published first (publish_scene).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "scene": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The scene (scn_\u2026); null: none"
   },
   "streamId": {
    "description": "A stream's id, from list_streams.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "streamId",
   "scene"
  ],
  "type": "object"
 },
 "name": "set_stream_scene",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "setStreamScene": {
      "additionalProperties": {},
      "properties": {
       "id": {
        "type": "string"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     }
    },
    "required": [
     "setStreamScene"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "code": {
      "description": "Stable \u2014 branch on it: INVALID_INPUT, REVISION_REQUIRED, STALE_PUBLISH, CONFIRM_REQUIRED, UNAVAILABLE, \u2026",
      "type": "string"
     },
     "currentRevision": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
