{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Load one Martin attempt summary with artifact directory references for a canonical run.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "attemptIndex": {
    "description": "Attempt index to inspect. Defaults to the latest attempt.",
    "minimum": 1,
    "type": "integer"
   },
   "file": {
    "description": "Path to a canonical loop-record.json file or run directory.",
    "type": "string"
   },
   "loopId": {
    "description": "Loop ID under the run store.",
    "type": "string"
   },
   "runsDir": {
    "description": "Optional runs-root override.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "martin_get_attempt",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "attempt": {
    "additionalProperties": true,
    "properties": {
     "adapterId": {
      "type": "string"
     },
     "artifactFiles": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "artifacts": {
      "additionalProperties": false,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "directory": {
        "type": "string"
       },
       "files": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "directory",
       "available",
       "files"
      ],
      "type": "object"
     },
     "attemptId": {
      "type": "string"
     },
     "completedAt": {
      "type": "string"
     },
     "failureClass": {
      "type": "string"
     },
     "index": {
      "type": "integer"
     },
     "intervention": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "startedAt": {
      "type": "string"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "index"
    ],
    "type": "object"
   },
   "loop": {
    "additionalProperties": true,
    "properties": {
     "activeAttemptId": {
      "description": "ID of the currently active attempt, when a run is in progress.",
      "type": "string"
     },
     "attempts": {
      "type": "integer"
     },
     "avoidedUsd": {
      "type": "number"
     },
     "costUsd": {
      "type": "number"
     },
     "createdAt": {
      "type": "string"
     },
     "lastAttempt": {
      "additionalProperties": true,
      "type": "object"
     },
     "lifecycleState": {
      "type": "string"
     },
     "loopId": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "pressure": {
      "type": "string"
     },
     "remainingBudgetUsd": {
      "type": "number"
     },
     "remainingIterations": {
      "type": "integer"
     },
     "remainingTokens": {
      "type": "integer"
     },
     "shouldStop": {
      "type": "boolean"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "loopId",
     "title",
     "objective",
     "status",
     "lifecycleState",
     "attempts",
     "costUsd",
     "avoidedUsd",
     "pressure",
     "shouldStop",
     "remainingBudgetUsd",
     "remainingIterations"
    ],
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "sourceKind": {
    "enum": [
     "file",
     "loop_id",
     "latest",
     "runs_root"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "source",
   "sourceKind",
   "loop",
   "attempt",
   "warnings"
  ],
  "type": "object"
 }
}
