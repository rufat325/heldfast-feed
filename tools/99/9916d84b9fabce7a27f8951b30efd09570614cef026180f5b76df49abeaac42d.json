{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update contract document"
 },
 "description": "Update a contract document by ID. Requires contract_documents:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contract_id": {
    "description": "Contract ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "file_name": {
    "description": "File name",
    "maxLength": 500,
    "type": "string"
   },
   "file_path": {
    "description": "Storage path",
    "maxLength": 2000,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "id": {
    "description": "Contract document ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "uploaded_by": {
    "description": "Uploader user ID",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_contract_document",
 "title": "Update contract document"
}
