{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read exact employer URLs, sidebar order, checksums and visual assertions. A real authenticated browser and separate worker accounts must execute them. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "folderId"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_visual_review",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "assertions": {
      "items": {
       "$ref": "#/properties/result/properties/employerUrl"
      },
      "type": "array"
     },
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "employerUrl": {
      "type": "string"
     },
     "folderId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "generatedAt": {
      "$ref": "#/properties/result/properties/employerUrl"
     },
     "pages": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "checksum": {
         "$ref": "#/properties/result/properties/employerUrl"
        },
        "depth": {
         "enum": [
          0,
          1
         ],
         "type": "number"
        },
        "imageUrls": {
         "items": {
          "$ref": "#/properties/result/properties/employerUrl"
         },
         "type": "array"
        },
        "pageId": {
         "$ref": "#/properties/result/properties/folderId"
        },
        "parentPageId": {
         "anyOf": [
          {
           "$ref": "#/properties/result/properties/folderId"
          },
          {
           "type": "null"
          }
         ]
        },
        "position": {
         "minimum": 0,
         "type": "integer"
        },
        "shareUrl": {
         "$ref": "#/properties/result/properties/employerUrl"
        },
        "title": {
         "$ref": "#/properties/result/properties/employerUrl"
        }
       },
       "required": [
        "pageId",
        "title",
        "parentPageId",
        "depth",
        "position",
        "checksum",
        "shareUrl",
        "imageUrls"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "requiresAuthenticatedEmployerSession": {
      "const": true,
      "type": "boolean"
     },
     "reviewSurface": {
      "const": "EMPLOYER_FOLDER_INSTRUCTIONS_TAB",
      "type": "string"
     },
     "treeChecksum": {
      "$ref": "#/properties/result/properties/employerUrl"
     },
     "viewports": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "height": {
         "$ref": "#/properties/result/properties/pages/items/properties/position"
        },
        "name": {
         "$ref": "#/properties/result/properties/employerUrl"
        },
        "width": {
         "$ref": "#/properties/result/properties/pages/items/properties/position"
        }
       },
       "required": [
        "name",
        "width",
        "height"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "workerCoverage": {
      "additionalProperties": false,
      "properties": {
       "included": {
        "const": false,
        "type": "boolean"
       },
       "reason": {
        "$ref": "#/properties/result/properties/employerUrl"
       },
       "requirement": {
        "$ref": "#/properties/result/properties/employerUrl"
       }
      },
      "required": [
       "included",
       "reason",
       "requirement"
      ],
      "type": "object"
     }
    },
    "required": [
     "canonicalSource",
     "folderId",
     "employerUrl",
     "reviewSurface",
     "requiresAuthenticatedEmployerSession",
     "workerCoverage",
     "generatedAt",
     "treeChecksum",
     "pages",
     "viewports",
     "assertions"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
