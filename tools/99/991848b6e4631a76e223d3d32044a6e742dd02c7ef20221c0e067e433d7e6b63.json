{
 "_meta": {
  "ui": {
   "resourceUri": "ui://outreach-desk/intake"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this to evaluate an inbound recruiter pitch or outreach message across relevance, specificity, cadence, and spam signals.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cadence_days": {
    "description": "Days elapsed since the previous message from this sender (defaults to 7).",
    "minimum": 0,
    "type": "integer"
   },
   "desk_key": {
    "description": "The secret desk_key returned when the desk was created. It is the only credential for this desk and cannot be recovered.",
    "pattern": "^od_[0-9a-f]{32}$",
    "type": "string"
   },
   "is_follow_up": {
    "description": "Whether this message is a follow-up to earlier outreach.",
    "type": "boolean"
   },
   "message": {
    "description": "The inbound outreach or recruiter pitch text to evaluate.",
    "type": "string"
   },
   "previous_declined": {
    "description": "Whether the candidate previously declined outreach from this sender.",
    "type": "boolean"
   },
   "sender": {
    "description": "Optional recruiter sender info (email address, URL or domain) to associate with scoreboard.",
    "type": "string"
   },
   "sender_domain": {
    "description": "Optional explicit sender domain (e.g. 'stripe.com').",
    "type": "string"
   }
  },
  "required": [
   "desk_key",
   "message"
  ],
  "type": "object"
 },
 "name": "score_message",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "breakdown": {
    "properties": {
     "cadence": {
      "type": "integer"
     },
     "relevance": {
      "type": "integer"
     },
     "spam": {
      "type": "integer"
     },
     "specificity": {
      "type": "integer"
     }
    },
    "required": [
     "relevance",
     "specificity",
     "cadence",
     "spam"
    ],
    "type": "object"
   },
   "composite_score": {
    "type": "integer"
   },
   "evaluation_id": {
    "type": "string"
   },
   "flags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "key_reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recommended_action": {
    "enum": [
     "interested",
     "request_info",
     "decline"
    ],
    "type": "string"
   },
   "sender_domain": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "evaluation_id",
   "sender_domain",
   "composite_score",
   "breakdown",
   "flags",
   "summary",
   "recommended_action",
   "key_reasons",
   "source",
   "as_of"
  ],
  "type": "object"
 },
 "title": "Score Inbound Pitch"
}
