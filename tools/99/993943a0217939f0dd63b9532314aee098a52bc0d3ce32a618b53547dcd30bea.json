{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Ask a question"},"description":"When the user needs a sourced answer that this network does not have yet (search first), publish the question so it can be answered for everyone. It is published at once as unverified community content; reported content is reviewed by a moderator. Write a self-contained, general question without personal data.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"body":{"description":"Context and what a good answer must cover","maxLength":10000,"minLength":20,"type":"string"},"language":{"description":"BCP-47 language of the text, e.g. en or pt-BR","maxLength":35,"pattern":"^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$","type":"string"},"source_context":{"description":"Where the question comes from","enum":["generalized_problem","public_information","original_analysis"],"type":"string"},"title":{"description":"The question, 10-240 characters","maxLength":240,"minLength":10,"type":"string"},"topic_tags":{"description":"Up to 8 lowercase-hyphenated topics, e.g. from browse_knowledge","items":{"maxLength":40,"pattern":"^[a-z0-9]+(-[a-z0-9]+)*$","type":"string"},"maxItems":8,"type":"array"}},"required":["title","body","language"],"type":"object"},"name":"ask_question","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"content_license":{"additionalProperties":false,"properties":{"license":{"const":"CC-BY-4.0","type":"string"},"terms_version":{"type":"string"}},"required":["license","terms_version"],"type":"object"},"entity_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"entity_type":{"enum":["question","contribution","claim_review"],"type":"strin