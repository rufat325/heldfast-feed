{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Collect the sealed result of an impreza_export_onion_key command by its command_id, exactly once. A successful read removes the platform copy; a second read returns 404, so save the sealed bundle securely before leaving. A 409 means the agent has not finished yet: wait and retry. Decrypt locally with the recipient private key; never send that key to the platform. Requires manage scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "command_id": {
    "type": "string"
   },
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "command_id"
  ],
  "type": "object"
 },
 "name": "impreza_fetch_onion_key_export",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "command_id": {
      "pattern": "^cmd_[A-Za-z0-9_-]{1,28}$",
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "onion": {
      "pattern": "^[a-z2-7]{56}.onion$",
      "type": "string"
     }
    },
    "required": [
     "command_id",
     "onion",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Collect encrypted onion identity"
}
