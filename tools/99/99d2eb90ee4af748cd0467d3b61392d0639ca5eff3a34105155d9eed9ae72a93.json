  "readOnlyHint": true,
  "title": "Where an approved generation has got to"
 },
 "description": "Waits up to 45 seconds for an active rendering stage to finish, then returns its current state and continuation data. Reads a saved whole-job or picture-only operation by its original projectId and operationId. Returns approval and generation state, next-step data, balance or shortfall where applicable, and any fresh unapproved quote. Whole-job states include making_pictures, pictures_ready, video_waiting_for_payment, starting_video, making_video and failed. Picture-only approval covers only its quoted pictures. Video retains the original financial approval and applicable readiness gates; likeness not_required needs no likeness verdict. This free read does not advance stages or charge credits.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "operationId": {
    "description": "The original operationId from studio_generation_quote or studio_storyboard_stills_quote.",
    "maxLength": 128,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "projectId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "operationId"
  ],
  "type": "object"
 },
