{
 "description": "Get console logs from the browser (errors, warnings, etc.)",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "log_types": {
    "description": "Filter by log types (e.g., ['error', 'warning'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "session_id": {
    "description": "Browser session ID",
    "type": "string"
   },
   "since_timestamp": {
    "description": "Only return logs after this timestamp",
    "type": "number"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "get_browser_console_logs"
}
