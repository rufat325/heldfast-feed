{
 "annotations": {
  "idempotentHint": false
 },
 "description": "Create a new skill document. Skills are markdown files that capture procedural knowledge and can reference other skills, resources, and facts.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "default": "[auto-migrated] Needs description",
    "description": "Description explaining what this skill does. Agents should always provide meaningful descriptions to enable search and avoid duplicates.",
    "minLength": 1,
    "type": "string"
   },
   "executionLogId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   },
   "references": {
    "additionalProperties": false,
    "properties": {
     "facts": {
      "items": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "type": "array"
     },
     "resources": {
      "items": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "type": "array"
     },
     "skills": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "tags": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "title",
   "content",
   "tags"
  ],
  "type": "object"
 },
 "name": "create_skill",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filePath": {
    "type": "string"
   },
   "id": {
    "type": "number"
   },
   "name": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "filePath"
  ],
  "type": "object"
 },
 "title": "Create Skill"
}
