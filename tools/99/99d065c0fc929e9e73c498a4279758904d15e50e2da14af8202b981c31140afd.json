{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search and compare robots by name, description, specifications, type, use case, maker, and linked task. Supports hardware filters and sorting.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "query"
    ]
   },
   {
    "required": [
     "robot_type"
    ]
   },
   {
    "required": [
     "autonomy_level"
    ]
   },
   {
    "required": [
     "status"
    ]
   },
   {
    "required": [
     "use_case"
    ]
   },
   {
    "required": [
     "min_price"
    ]
   },
   {
    "required": [
     "max_price"
    ]
   },
   {
    "required": [
     "manufacturing_country"
    ]
   },
   {
    "required": [
     "release_date_from"
    ]
   },
   {
    "required": [
     "release_date_to"
    ]
   },
   {
    "required": [
     "task"
    ]
   }
  ],
  "properties": {
   "autonomy_level": {
    "description": "Exact autonomy level, such as Teleoperated or Fully autonomous.",
    "enum": [
     "Teleoperated",
     "Assisted",
     "Semi-autonomous",
     "Fully autonomous"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "manufacturing_country": {
    "description": "Manufacturing country name or two-letter country code.",
    "type": "string"
   },
   "max_price": {
    "description": "Maximum listed price, inclusive.",
    "minimum": 0,
    "type": "number"
   },
   "min_price": {
    "description": "Minimum listed price, inclusive.",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Optional free-text robot capability, product, use case, specification, or maker query.",
    "type": "string"
   },
   "release_date_from": {
    "description": "Earliest release date, inclusive, in YYYY-MM-DD format.",
    "format": "date",
    "type": "string"
   },
   "release_date_to": {
    "description": "Latest release date, inclusive, in YYYY-MM-DD format.",
    "format": "date",
    "type": "string"
   },
   "robot_type": {
    "description": "Exact robot type, such as Warehouse, Home, or Humanoid.",
    "enum": [
     "Humanoid",
     "Mobile",
     "Manipulator",
     "Drone",
     "Industrial",
     "Warehouse",
     "Healthcare",
     "Home",
     "Agricultural",
     "Defense",
     "Service",
     "Companion",
     "Other"
    ],
    "type": "string"
   },
   "sort": {
    "default": "relevance",
    "enum": [
     "relevance",
     "price",
     "latest",
     "popular"
    ],
    "type": "string"
   },
   "status": {
    "description": "Exact availability status, such as Pilot or Commercially available.",
    "enum": [
     "Announced",
     "In development",
     "Prototype",
     "Pilot",
     "Pre-order",
     "In production",
     "Commercially available",
     "Paused",
     "Discontinued",
     "Cancelled",
     "Waitlist"
    ],
    "type": "string"
   },
   "task": {
    "description": "Exact TAAFT task name or slug. Matches primary and secondary task links.",
    "type": "string"
   },
   "use_case": {
    "description": "Exact primary use case, such as Warehousing & Logistics or Productivity.",
    "enum": [
     "Manufacturing",
     "Warehousing & Logistics",
     "Healthcare",
     "Elder Care",
     "Surgery",
     "Agriculture",
     "Construction",
     "Inspection",
     "Security",
     "Defense",
     "Retail",
     "Hospitality",
     "Home Assistance",
     "Education",
     "Research",
     "Disaster Response",
     "Other"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_robots",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "robots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "availability": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "entity_type": {
       "type": "string"
      },
      "id": {
       "type": "integer"
      },
      "maker": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "price": {
       "type": [
        "number",
        "null"
       ]
      },
      "price_currency": {
       "type": [
        "string",
        "null"
       ]
      },
      "primary_use_cases": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "slug": {
       "type": "string"
      },
      "tasks": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "integer"
         },
         "name": {
          "type": "string"
         },
         "role": {
          "enum": [
           "primary",
           "secondary"
          ],
          "type": "string"
         },
         "slug": {
          "type": "string"
         },
         "url": {
          "type": "string"
         }
        },
        "required": [
         "id",
         "name",
         "slug",
         "role",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "types": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "entity_type",
      "name",
      "slug",
      "url",
      "description",
      "price",
      "price_currency",
      "types",
      "primary_use_cases",
      "maker",
      "availability",
      "tasks"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "robots"
  ],
  "type": "object"
 },
 "title": "Search robots"
}
