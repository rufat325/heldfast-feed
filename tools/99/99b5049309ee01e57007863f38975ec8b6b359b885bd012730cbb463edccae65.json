{
 "description": "Manage leave requests: list, get, create, update, cancel, approve, reject, view types and allowances",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action",
    "enum": [
     "list_leaves",
     "get_leave",
     "list_types",
     "get_type",
     "list_allowances",
     "create",
     "update",
     "cancel",
     "approve",
     "reject"
    ],
    "type": "string"
   },
   "confirm": {
    "description": "Confirm cancel/reject",
    "type": "boolean"
   },
   "description": {
    "description": "Leave description",
    "type": "string"
   },
   "employee_id": {
    "description": "Employee ID",
    "type": "number"
   },
   "finish_on": {
    "description": "End date (YYYY-MM-DD). For list_leaves: leaves overlapping a window to this date",
    "type": "string"
   },
   "half_day": {
    "description": "Half day option",
    "enum": [
     "all_day",
     "start",
     "finish"
    ],
    "type": "string"
   },
   "id": {
    "description": "Leave/type ID",
    "type": "number"
   },
   "leave_type_id": {
    "description": "Leave type ID",
    "type": "number"
   },
   "limit": {
    "default": 100,
    "description": "Items per page",
    "type": "number"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "start_on": {
    "description": "Start date (YYYY-MM-DD). For list_leaves: leaves overlapping a window from this date",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "factorial_time_off",
 "title": "FactorialHR Time Off"
}
