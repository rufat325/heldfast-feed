{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Generate a compact handoff packet so another AI agent can continue SDLC work.\n\nUse when wrapping up a session, before handing off to a specialised agent, or when context is nearing its limit.\n\nArgs:\n  - owner, repo: Repository coordinates.\n  - issueNumber (number?): Issue being worked on.\n  - pullNumber (number?): PR being worked on.\n  - releaseRef (string?): Release ref being worked on.\n  - currentStatus (string?): Optional caller-authored status; system evidence is used when omitted.\n  - goal / nonGoals / completedActions / decisions: Optional caller-authored handoff context.\n  - nextSteps (string[]?): Ordered tasks for the next agent.\n\nReturns: Compact handoff prompt, repo context snapshot, and remaining tasks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "completedActions": {
    "description": "Optional caller-authored completed actions. Kept unverified.",
    "items": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "currentStatus": {
    "description": "Optional caller-authored work status. Kept unverified.",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "decisions": {
    "description": "Optional caller-authored decisions. Kept unverified.",
    "items": {
     "properties": {
      "rationale": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      },
      "summary": {
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "goal": {
    "description": "Optional caller-authored goal. Kept unverified.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "issueNumber": {
    "description": "Issue being worked on (if applicable).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "nextSteps": {
    "description": "Ordered list of next steps for the incoming agent.",
    "items": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "nonGoals": {
    "description": "Optional caller-authored non-goals. Kept unverified.",
    "items": {
     "maxLength": 1000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "owner": {
    "description": "GitHub owner. Falls back to GITHUB_OWNER.",
    "type": "string"
   },
   "pullNumber": {
    "description": "PR being worked on (if applicable).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "releaseRef": {
    "description": "Release ref being worked on (if applicable).",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "repo": {
    "description": "GitHub repo. Falls back to GITHUB_REPO.",
    "type": "string"
   }
  },
  "type": "object"
 },
