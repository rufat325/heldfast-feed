{
 "description": "Full-text search across blog posts and tools. Returns title, URL, excerpt, and a markdown_url for the full document.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 5,
    "description": "Max results (1-20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "post_type": {
    "description": "Optional: post, tool",
    "enum": [
     "post",
     "tool",
     "any"
    ],
    "type": "string"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_content",
 "title": "Search content"
}
