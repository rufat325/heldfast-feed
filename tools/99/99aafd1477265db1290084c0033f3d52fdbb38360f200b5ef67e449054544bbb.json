{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Resolve the configured issue providers for the current Git repository.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cwd": {
    "description": "Git working directory; defaults to the server process cwd",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "resolve_project_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "additionalProperties": false,
      "properties": {
       "configured_providers": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "default_provider": {
        "type": "string"
       },
       "selected": {
        "additionalProperties": false,
        "properties": {
         "alias": {
          "type": "string"
         },
         "credential_alias": {
          "type": "string"
         },
         "credential_available": {
          "type": "boolean"
         },
         "profile": {
          "type": "string"
         },
         "target": {
          "additionalProperties": {},
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         "type": {
          "enum": [
           "linear",
           "github",
           "jira-cloud"
          ],
          "type": "string"
         }
        },
        "required": [
         "alias",
         "type",
         "profile",
         "target",
         "credential_alias",
         "credential_available"
        ],
        "type": "object"
       }
      },
      "required": [
       "default_provider",
       "configured_providers",
       "selected"
      ],
      "type": "object"
     },
     "repository": {
      "additionalProperties": false,
      "properties": {
       "git_root": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "match_source": {
        "enum": [
         "origin",
         "remote-alias",
         "path-alias"
        ],
        "type": "string"
       },
       "origin": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "git_root",
       "origin",
       "match_source"
      ],
      "type": "object"
     }
    },
    "required": [
     "repository",
     "issues"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Resolve project issue context"
}
