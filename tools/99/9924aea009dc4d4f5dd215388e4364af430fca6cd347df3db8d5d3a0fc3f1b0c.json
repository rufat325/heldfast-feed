{
 "description": "Create a durable agent session with scoped permissions (persisted to DATA_DIR). Non-custodial.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowlistSymbols": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxDailyNotionalUsd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "maxNotionalUsd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "owner": {
    "type": "string"
   },
   "permissions": {
    "items": {
     "enum": [
      "read",
      "quote",
      "swap",
      "set_policy",
      "admin"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sessionKey": {
    "type": "string"
   },
   "ttlHours": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "owner"
  ],
  "type": "object"
 },
 "name": "stocktoken_session_create"
}
