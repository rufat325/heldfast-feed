{
 "description": "Create a new App Store version for submission",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "copyright": {
    "type": "string"
   },
   "earliestReleaseDate": {
    "description": "ISO 8601 date for scheduled release",
    "type": "string"
   },
   "platform": {
    "default": "IOS",
    "enum": [
     "IOS",
     "MAC_OS",
     "TV_OS",
     "VISION_OS"
    ],
    "type": "string"
   },
   "releaseType": {
    "enum": [
     "MANUAL",
     "AFTER_APPROVAL",
     "SCHEDULED"
    ],
    "type": "string"
   },
   "versionString": {
    "description": "Version (e.g. 1.0.0)",
    "type": "string"
   }
  },
  "required": [
   "appId",
   "versionString"
  ],
  "type": "object"
 },
 "name": "apple_create_version"
}
