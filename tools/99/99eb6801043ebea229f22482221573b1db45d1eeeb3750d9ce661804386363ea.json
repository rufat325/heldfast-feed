    "type": "string"
   },
   "fiscal_year": {
    "description": "Fiscal year (YYYY). Omit to return most recent periods.",
    "maximum": 2030,
    "minimum": 1993,
    "type": "integer"
   },
   "limit": {
    "default": 5,
    "description": "Maximum number of periods to return (1\u201340). Defaults to 5.",
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "default": "annual",
    "description": "Filing period granularity. Annual uses 10-K; quarterly uses 10-Q.",
    "enum": [
     "annual",
     "quarterly"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker symbol, e.g. AAPL, MSFT \u2014 or a CIK (SEC identifier), e.g. '0000320193'.",
    "maxLength": 10,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9.\\-]+$",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
