{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the file formats Convert To It supports by extension, name, MIME type or category, and see whether each can be read (converted from) or written (converted to).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "can_read": {
    "description": "true: only formats that can be converted from.",
    "type": "boolean"
   },
   "can_write": {
    "description": "true: only formats that can be converted to.",
    "type": "boolean"
   },
   "category": {
    "description": "Comma-separated categories, e.g. \"image\" or \"audio,video\".",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Extension, name or MIME type, e.g. \"webp\" or \"photoshop\". Omit to list everything.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_formats",
 "outputSchema": {
  "properties": {
   "formats": {
    "items": {
     "properties": {
      "can_read": {
       "type": "boolean"
      },
      "can_write": {
       "type": "boolean"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "converters": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "extension": {
       "type": "string"
      },
      "mime": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "extension",
      "name",
      "mime",
      "categories",
      "can_read",
      "can_write",
      "converters"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Matches before the limit.",
    "type": "integer"
   }
  },
  "required": [
   "total",
   "formats"
  ],
  "type": "object"
 },
 "title": "Search formats"
}
