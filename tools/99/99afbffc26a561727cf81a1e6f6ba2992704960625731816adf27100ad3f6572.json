{
 "description": "Search definitions (functions, classes, methods, \u2026) by name across the whole workspace. Matches name prefixes and doc comments; falls back to substring match. Returns one line per symbol with its id (#N) for use with get_symbol_info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "continuation token from a truncated response; repeat the same arguments with it",
    "type": "string"
   },
   "exported_only": {
    "description": "only public/exported symbols",
    "type": "boolean"
   },
   "kind": {
    "description": "filter by symbol kind",
    "enum": [
     "function",
     "method",
     "constructor",
     "class",
     "interface",
     "trait",
     "struct",
     "enum",
     "enum_member",
     "type_alias",
     "variable",
     "constant",
     "property",
     "field",
     "namespace",
     "module",
     "signal",
     "macro",
     "impl",
     "blueprint_function",
     "event_dispatcher"
    ],
    "type": "string"
   },
   "lang": {
    "enum": [
     "uasset",
     "typescript",
     "tsx",
     "javascript",
     "python",
     "c",
     "cpp",
     "rust",
     "go",
     "java",
     "kotlin",
     "c_sharp",
     "gdscript",
     "php",
     "ruby",
     "lua",
     "solidity",
     "zig",
     "nix",
     "swift",
     "scala",
     "dart",
     "terraform",
     "pascal",
     "vue",
     "svelte"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "max_tokens": {
    "default": 2500,
    "description": "soft cap on response size in estimated tokens; truncated output says how to get the rest",
    "maximum": 20000,
    "minimum": 200,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "path_prefix": {
    "description": "restrict to files under this root-relative path",
    "type": "string"
   },
   "query": {
    "description": "symbol name or name fragment, e.g. \"parseConfig\" or \"http client\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_symbols",
 "title": "Search symbols"
}
