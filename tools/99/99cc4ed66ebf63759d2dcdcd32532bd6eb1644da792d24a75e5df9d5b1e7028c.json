{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "data",
 "description": "Transform a JSON array using common operations: pluck (extract specific fields), filter (by field value), sort_by (field), group_by (field), count_by (field), uniq_by (field). Useful for processing MCP tool results and LLM structured outputs.",
 "inputSchema": {
  "properties": {
   "field": {
    "description": "Field to operate on (for sort_by, group_by, count_by, uniq_by, filter)",
    "type": "string"
   },
   "fields": {
    "description": "Comma-separated field list for \"pluck\" (e.g. \"id,name,email\")",
    "type": "string"
   },
   "filter_op": {
    "description": "For \"filter\": \"==\" | \"!=\" | \">\" | \">=\" | \"<\" | \"<=\" | \"contains\" | \"exists\" | \"!exists\"",
    "type": "string"
   },
   "filter_value": {
    "description": "For \"filter\": value to compare against",
    "type": "string"
   },
   "input": {
    "description": "The JSON containing an array (or an object with an array at `path`) \u2014 a JSON string, or the value itself.",
    "type": [
     "string",
     "object",
     "array"
    ]
   },
   "n": {
    "description": "For first_n / last_n: number of items",
    "type": "number"
   },
   "operation": {
    "description": "Operation: \"pluck\", \"filter\", \"sort_by\", \"group_by\", \"count_by\", \"uniq_by\", \"reverse\", \"first_n\", \"last_n\", \"flatten\"",
    "type": "string"
   },
   "path": {
    "description": "Optional dot-notation path to the array within the JSON object (e.g. \"data.items\")",
    "type": "string"
   },
   "sort_order": {
    "description": "For sort_by: \"asc\" (default) or \"desc\"",
    "type": "string"
   }
  },
  "required": [
   "input",
   "operation"
  ],
  "type": "object"
 },
 "name": "transform_json_array",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "count": {
    "type": "number"
   },
   "field": {},
   "fields": {},
   "group_count": {
    "type": "number"
   },
   "operation": {
    "type": "string"
   },
   "order": {},
   "removed": {
    "type": "number"
   },
   "removed_duplicates": {
    "type": "number"
   },
   "result": {},
   "total": {
    "type": "number"
   },
   "unique_values": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
