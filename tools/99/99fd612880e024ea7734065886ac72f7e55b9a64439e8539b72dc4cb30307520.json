       }
      },
      "title": "VNSpriteBackground",
      "type": "object"
     },
     "cell_height": {
      "minimum": 32.0,
      "title": "Cell Height",
      "type": "integer"
     },
     "cell_width": {
      "minimum": 32.0,
      "title": "Cell Width",
      "type": "integer"
     },
     "full_body": {
      "default": true,
      "title": "Full Body",
      "type": "boolean"
     },
     "layout": {
      "default": "3x2",
      "enum": [
       "2x2",
       "3x2",
       "4x2"
      ],
      "title": "Layout",
      "type": "string"
     },
     "padding": {
      "default": "generous",
      "title": "Padding",
      "type": "string"
     }
    },
    "required": [
     "cell_width",
     "cell_height"
    ],
    "title": "VNSpriteSheetConfig",
    "type": "object"
   },
   "style": {
    "properties": {
     "consistency_reference_asset_id": {
      "anyOf": [
