    "title": "Cells",
    "type": "array"
   },
   "character": {
    "properties": {
     "age_range": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Age Range"
     },
     "description": {
      "additionalProperties": {
       "type": "string"
      },
      "title": "Description",
      "type": "object"
     },
     "id": {
      "minLength": 1,
      "title": "Id",
      "type": "string"
     },
     "name": {
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "role": {
