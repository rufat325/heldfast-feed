       "type": "string"
      },
      "id": {
       "minLength": 1,
       "title": "Id",
       "type": "string"
      },
      "notes": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "title": "Notes"
      },
