     "preset": {
      "minLength": 1,
      "title": "Preset",
      "type": "string"
     },
     "rendering": {
      "minLength": 1,
      "title": "Rendering",
      "type": "string"
     }
    },
    "required": [
     "preset",
     "rendering"
    ],
    "title": "VNSpriteStyle",
    "type": "object"
   }
  },
  "required": [
   "character",
   "style",
   "sheet",
   "cells"
  ],
  "type": "object"
 },
 "name": "vn_generate_sprite_sheet",
