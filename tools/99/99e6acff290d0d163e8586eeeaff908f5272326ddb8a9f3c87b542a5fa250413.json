{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for documents matching a keyword.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Limit search to a specific collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filter": {
    "description": "Filter string",
    "type": "string"
   },
   "fuzzy": {
    "description": "Fuzzy matching level",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "probH": {
    "description": "Upper probability threshold",
    "type": "number"
   },
   "probL": {
    "description": "Lower probability threshold",
    "type": "number"
   },
   "query": {
    "description": "Keyword search query",
    "type": "string"
   },
   "rows": {
    "description": "Number of results",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sorting": {
    "description": "Sorting mode",
    "type": "string"
   },
   "start": {
    "description": "Start offset",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "transkribus_search_keyword",
 "title": "Keyword Search"
}
