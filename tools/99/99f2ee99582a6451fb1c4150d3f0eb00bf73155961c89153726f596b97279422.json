{
 "description": "Mark a review note resolved on a workpaper.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "noteId": {
    "minLength": 1,
    "type": "string"
   },
   "resolvedBy": {
    "minLength": 1,
    "type": "string"
   },
   "workpaperId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "workpaperId",
   "noteId"
  ],
  "type": "object"
 },
 "name": "resolve_review_note",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "note": {},
   "workpaper": {}
  },
  "required": [
   "workpaper",
   "note"
  ],
  "type": "object"
 },
 "title": "Resolve a review note"
}
