{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the one-click agent install state of one managed VPS: whether it can take the install now (agent_installable and, when false, the reason), what the agent is, the install job (status, attempts, last error without addresses) and the agent once it registers. state is one of not_started, installing, registering, registered, online or failed. Use it to follow an install started with impreza_install_agent. Read only; it never installs anything.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "service_id": {
    "description": "The VPS service id.",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "service_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_agent_install",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "about": {
      "type": "string"
     },
     "agent": {
      "additionalProperties": false,
      "properties": {
       "status": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "version"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "agent_installable": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "detail": {
      "type": "string"
     },
     "hostname": {
      "type": "string"
     },
     "job": {
      "additionalProperties": false,
      "properties": {
       "attempts": {
        "type": "integer"
       },
       "created_at": {
        "type": "string"
       },
       "last_error": {
        "type": "string"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "attempts",
       "created_at",
       "last_error"
      ],
      "type": [
       "object",
       "null"
      ]
     },
     "product": {
      "type": "string"
     },
     "reason": {
      "enum": [
       "server_stopped",
       "guest_agent_unavailable",
       "os_rhel_family",
       "os_unsupported",
       "os_unknown",
       "service_not_active",
       "not_provisioned",
       "control_panel_server",
       "install_in_progress",
       "agent_present",
       "platform_unavailable",
       "not_checked",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "script_sha256": {
      "type": "string"
     },
     "service_id": {
      "type": "integer"
     },
     "state": {
      "enum": [
       "not_started",
       "installing",
       "registering",
       "registered",
       "online",
       "failed"
      ],
      "type": "string"
     }
    },
    "required": [
     "service_id",
     "hostname",
     "product",
     "agent_installable",
     "reason",
     "detail",
     "about",
     "script_sha256",
     "state",
     "job",
     "agent"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Get agent install state"
}
