{
 "description": "Create a blog author profile.",
 "inputSchema": {
  "properties": {
   "agent_type": {
    "description": "Human or AI author",
    "enum": [
     "human",
     "ai"
    ],
    "type": "string"
   },
   "avatar_url": {
    "description": "Avatar image URL",
    "type": "string"
   },
   "bio": {
    "description": "Author biography",
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "email": {
    "description": "Author email",
    "type": "string"
   },
   "full_name": {
    "description": "Author full name",
    "type": "string"
   },
   "project": {
    "description": "Optional project \u2014 a website inside the workspace (proj_xxx) \u2014 to scope this call to. Sent as the X-Project-Id header. If omitted, the spideriq.json / SPIDERIQ_PROJECT_ID binding (or the workspace default project) is used.",
    "type": "string"
   },
   "role": {
    "description": "Author role",
    "enum": [
     "author",
     "editor",
     "contributor",
     "administrator"
    ],
    "type": "string"
   },
   "slug": {
    "description": "URL slug",
    "type": "string"
   },
   "workspace": {
    "description": "Tenant to target (cli_\u2026). Omit to use the active/bound workspace. list_workspaces shows the options.",
    "type": "string"
   }
  },
  "required": [
   "full_name"
  ],
  "type": "object"
 },
 "name": "content_create_author"
}
