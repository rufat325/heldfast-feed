{
 "description": "Check one file for type errors without running tsc on the whole project. Call it on each file you edit; the edit is done when none reports an error.",
 "inputSchema": {
  "properties": {
   "backend": {
    "description": "Default typescript7; retry with typescript6 if it fails or looks wrong",
    "enum": [
     "typescript6",
     "typescript7"
    ]
   },
   "file": {
    "description": "TS/JS file: absolute, or relative to the server's cwd",
    "type": "string"
   },
   "include_suggestions": {
    "description": "Also report suggestions such as unused variables",
    "type": "boolean"
   },
   "project": {
    "description": "tsconfig.json; default: the nearest one above file",
    "type": "string"
   }
  },
  "required": [
   "file"
  ],
  "type": "object"
 },
 "name": "diagnostics",
 "outputSchema": {
  "properties": {
   "error": {
    "properties": {
     "candidates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "FILE_NOT_FOUND",
       "SYMBOL_NOT_FOUND",
       "TYPESCRIPT_ERROR",
       "INTERNAL_ERROR"
      ]
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "result": {
    "properties": {
     "diagnostics": {
      "items": {
       "properties": {
        "category": {
         "enum": [
          "error",
          "warning",
          "suggestion",
          "message"
         ]
        },
        "code": {
         "type": "number"
        },
        "column": {
         "type": "number"
        },
        "endColumn": {
         "type": "number"
        },
        "endLine": {
         "type": "number"
        },
        "line": {
         "type": "number"
        },
        "message": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "line",
        "column",
        "endLine",
        "endColumn",
        "code",
        "category",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "errorCount": {
      "type": "number"
     },
     "file": {
      "type": "string"
     },
     "warningCount": {
      "type": "number"
     }
    },
    "required": [
     "file",
     "diagnostics",
     "errorCount",
     "warningCount"
    ],
    "type": "object"
   },
   "version": {
    "const": 1
   }
  },
  "required": [
   "version",
   "ok"
  ],
  "type": "object"
 }
}
