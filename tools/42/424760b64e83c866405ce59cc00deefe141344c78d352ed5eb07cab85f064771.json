{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Save the seller's listing as a DRAFT \u2014 never live: the seller opens its activate_url, adds the photos and the map pin, accepts the terms and posts it. Checked by the posting form's rules; if something is missing or wrong, nothing is saved and the message says what to ask. At most 3 drafts; give draft_id to update one. Prices are whole amounts: a sale in millions with at most one decimal (42900000), a rent a month in whole thousands. Needs the seller's sign-in.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"address":{"maxLength":300,"type":"string"},"building":{"description":"Required for a home.","enum":["house","semi-detached","small-condo","large-condo","housing-estate"],"type":"string"},"currency":{"maxLength":3,"type":"string"},"deadline":{"description":"Last day for offers, YYYY-MM-DD.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"description":{"maxLength":20000,"type":"string"},"draft_id":{"description":"Update this draft instead of making a new one.","maxLength":64,"type":"string"},"facts":{"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"items":{"type":"string"},"type":"array"},{"items":{"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"}]},"propertyNames":{"type":"string"},"type":"object"},"type":"array"}]},"description":"By key, as ingatlan_draft_fields lists them.","propertyNames":{"type":"string"},"type":"object"},"kind":{"enum":["home","shop"],"type":"string"},"lat":{"maximum":90,"minimum":-90,"type":"number"},"lng":{"maximum":180,"minimum":-180,"type":"number"},"rent":{"properties":{"min_months":{"maximum":120,"minimum":1,"type":"integer"},"monthly_rent":{"description":"Asking rent a month, e.g. 250000.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"reserve":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["monthly_rent","min_months"],"type":"object"},"sale":{"properties":{"price":{"description":"Asking price, e.g. 65000000.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"reserve":{"description":"Hidden minimum, at most the price; the price when omitted.","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["price"],"type":"object"},"title":{"maxLength":120,"type":"string"}},"required":["kind","title"],"type":"object"},"name":"ingatlan_save_draft"}
