{
 "description": "Create a release on a track with optional version codes and release notes",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "editId": {
    "description": "Edit ID",
    "type": "string"
   },
   "packageName": {
    "description": "Android package name",
    "type": "string"
   },
   "releaseName": {
    "description": "Release name/label",
    "type": "string"
   },
   "releaseNotes": {
    "description": "Release notes per language",
    "items": {
     "additionalProperties": false,
     "properties": {
      "language": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "language",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "default": "completed",
    "enum": [
     "draft",
     "halted",
     "completed",
     "inProgress"
    ],
    "type": "string"
   },
   "track": {
    "description": "Target track",
    "enum": [
     "internal",
     "alpha",
     "beta",
     "production"
    ],
    "type": "string"
   },
   "userFraction": {
    "description": "Staged rollout fraction (0.0-1.0, only for production)",
    "type": "number"
   },
   "versionCodes": {
    "description": "Version codes to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "packageName",
   "editId",
   "track"
  ],
  "type": "object"
 },
 "name": "google_create_release"
}
