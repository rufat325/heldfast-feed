{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Datadog notebooks with search and filtering",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "authorHandle": {
    "description": "Filter by author handle (email). Example: user@example.com",
    "type": "string"
   },
   "count": {
    "default": 50,
    "description": "Number of results to return (default 50)",
    "type": "number"
   },
   "includeCells": {
    "default": false,
    "description": "Include notebook cell contents in response",
    "type": "boolean"
   },
   "query": {
    "description": "Search query to filter notebooks by name. Example: incident postmortem",
    "type": "string"
   },
   "sortDir": {
    "default": "desc",
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "sortField": {
    "default": "modified",
    "description": "Sort field: modified, name, created",
    "type": "string"
   },
   "start": {
    "default": 0,
    "description": "Pagination offset",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list-notebooks"
}
