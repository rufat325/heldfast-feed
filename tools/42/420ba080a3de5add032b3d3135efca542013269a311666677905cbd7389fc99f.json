{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create attachment"
 },
 "description": "Create an attachment record linked to a work order, work request, PM schedule, or PM template. Exactly one parent ID must be provided. Requires attachments:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "file_name": {
    "description": "File name (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "file_size": {
    "description": "File size in bytes",
    "minimum": 0,
    "type": "number"
   },
   "file_type": {
    "description": "MIME type",
    "maxLength": 200,
    "type": "string"
   },
   "file_url": {
    "description": "File URL / storage path (required)",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "pm_schedule_id": {
    "description": "PM schedule ID (exactly one parent required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "pm_template_id": {
    "description": "PM template ID (exactly one parent required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "uploaded_by": {
    "description": "Uploader user ID",
    "maxLength": 200,
    "type": "string"
   },
   "work_order_id": {
    "description": "Work order ID (exactly one parent required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "work_request_id": {
    "description": "Work request ID (exactly one parent required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "file_url",
   "file_name"
  ],
  "type": "object"
 },
 "name": "create_attachment",
 "title": "Create attachment"
}
