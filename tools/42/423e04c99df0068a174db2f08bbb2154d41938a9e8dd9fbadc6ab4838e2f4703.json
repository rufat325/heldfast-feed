{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the caller's own product listings in EVERY state -- active, inactive, pending moderation, rejected, and closed -- not just the publicly visible ones (soft-deleted listings are excluded). Use this to find a draft created earlier with products.create (those sit in state 'inactive' until the seller activates them) when you no longer have its product_id, or to review what the seller currently has listed. Each entry includes the listing's state, price, quantity, and an edit_url (the seller's product page where an inactive draft is reviewed and activated). Optionally filter to a single state. Read-only, no side effects. Requires an 'Authorization: Bearer <agent api key>' header.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 50,
    "description": "Maximum number of most-recent listings to return (1-100, default 50).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "Optional filter to a single listing state. 'inactive' is where products.create drafts sit until the seller activates them. When omitted, listings in every state are returned.",
    "enum": [
     "active",
     "inactive",
     "pending_moderation",
     "rejected",
     "closed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sellers.listings",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "listings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "edit_url": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "listing_type": {
       "enum": [
        "fixed_price",
        "auction"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "offers_enabled": {
       "type": "boolean"
      },
      "price": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "quantity": {
       "type": "number"
      },
      "state": {
       "enum": [
        "active",
        "inactive",
        "pending_moderation",
        "rejected",
        "closed",
        "unknown"
       ],
       "type": "string"
      },
      "state_flags": {
       "additionalProperties": false,
       "properties": {
        "missing_methods": {
         "type": "boolean"
        },
        "subscription_paused": {
         "type": "boolean"
        }
       },
       "required": [
        "subscription_paused",
        "missing_methods"
       ],
       "type": "object"
      },
      "updated_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "state",
      "state_flags",
      "listing_type",
      "price",
      "quantity",
      "offers_enabled",
      "edit_url",
      "created_at",
      "updated_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "listings",
   "count"
  ],
  "type": "object"
 },
 "title": "List the authenticated seller's own listings (any state)"
}
