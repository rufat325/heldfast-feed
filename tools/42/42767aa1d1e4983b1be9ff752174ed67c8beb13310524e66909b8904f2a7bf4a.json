    "type": "string"
   },
   "pair": {
    "description": "Kraken pair as the venue spells it: XBTUSD, ETHUSD, SOLUSD [required]",
    "type": "string"
   }
  },
  "required": [
   "pair"
  ],
  "type": "object"
 },
 "name": "market_kraken_depth",
