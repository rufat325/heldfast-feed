{
 "description": "Search/filter elements within a global source. No component param needed.\nExamples:\n- Find all buttons: type=\"button\"\n- Find by class: custom_class=\"hero\"\n- Find text: text=\"subscribe\"\n- Data-bound only: has_bind=true\n- With events: has_events=true\n- With custom class: has_custom_class=true",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "component": {
    "description": "Component hint for faster lookup (e.g. \"popup\", \"cart-droppable\")",
    "type": "string"
   },
   "custom_class": {
    "description": "Filter by custom class substring",
    "type": "string"
   },
   "global_source_id": {
    "description": "Global source ID",
    "type": "string"
   },
   "has_bind": {
    "description": "Only elements with data bindings",
    "type": "boolean"
   },
   "has_custom_class": {
    "description": "Only elements with custom class",
    "type": "boolean"
   },
   "has_events": {
    "description": "Only elements with events",
    "type": "boolean"
   },
   "id": {
    "description": "Filter by element ID substring (e.g. 'TEXT', 'BUTTON-3')",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max results (default 50)",
    "type": "number"
   },
   "text": {
    "description": "Filter by text content substring",
    "type": "string"
   },
   "type": {
    "description": "Filter by element type (e.g. 'text', 'button', 'image', 'container', 'section')",
    "type": "string"
   }
  },
  "required": [
   "global_source_id"
  ],
  "type": "object"
 },
 "name": "search_global_source_elements"
}
