{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Share a string with other projects"
 },
 "description": "Use this when someone asks to reuse a key's translations in other projects, such as a common button label. Returns the target projects and how many language rows were attached, up to 25 targets; later edits to that string apply in every attached project. Not for a copy that can differ per project.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Exact key to share, with all of its languages",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "description": "Project id or name that already has the key",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "targetProjects": {
    "description": "1 to 25 project ids or names to attach the key to",
    "items": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "project",
   "key",
   "targetProjects"
  ],
  "type": "object"
 },
 "name": "share_phrase",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "maxLength": 256,
    "type": "string"
   },
   "project": {
    "anyOf": [
     {
      "maxLength": 128,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "updated",
     "not-found",
     "no-targets",
     "already-shared"
    ],
    "type": "string"
   },
   "targetProjects": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 25,
    "type": "array"
   },
   "translationCount": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "status",
   "project",
   "key",
   "targetProjects",
   "translationCount"
  ],
  "type": "object"
 },
 "title": "Share a string with other projects"
}
