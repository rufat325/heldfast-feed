{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List publications"
 },
 "description": "Posts of an organization, newest first, as a short projection: id, network, state, date and the first words of the text. States are draft, ready (scheduled), publishing, sended (published) and withErrors. Use get_publication for the full record of one, including why it failed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "from_date": {
    "description": "ISO 8601 date, inclusive.",
    "type": "string"
   },
   "id_organization": {
    "description": "The PlanVortex organization id. Optional.",
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "search": {
    "description": "Free text search over the post text.",
    "type": "string"
   },
   "social_network": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "state": {
    "description": "Filter by state. 'ready' is what a user calls 'scheduled'.",
    "items": {
     "enum": [
      "draft",
      "ready",
      "publishing",
      "sended",
      "withErrors"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "to_date": {
    "description": "ISO 8601 date, inclusive.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_publications",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "publications": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "errors": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "id_account": {
       "type": "string"
      },
      "publication_type": {
       "type": "string"
      },
      "publish_date": {
       "type": "string"
      },
      "social_network": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "social_network",
      "state",
      "publication_type",
      "text",
      "id_account",
      "errors"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "publications",
   "total"
  ],
  "type": "object"
 },
 "title": "List publications"
}
