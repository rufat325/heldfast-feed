{
 "_meta": {
  "openai/toolInvocation/invoked": "Program preview ready",
  "openai/toolInvocation/invoking": "Checking the program",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Preview program in Phorme"
 },
 "description": "Use this when the user wants to turn a multiweek training program from this conversation into trackable Phorme training. It checks every week and workout, matches exercises to the Phorme movement library, and stores a private preview for 24 hours. It does not save training to any account. Do not use it for a single workout, nutrition plans or medical questions.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "program": {
    "additionalProperties": false,
    "description": "The multiweek program to preview, taken from this conversation. At most 500 workouts in total.",
    "properties": {
     "description": {
      "description": "Short summary of the program.",
      "maxLength": 2000,
      "type": "string"
     },
     "difficulty": {
      "description": "Intended training level. Defaults to intermediate.",
      "enum": [
       "beginner",
       "intermediate",
       "advanced"
      ],
      "type": "string"
     },
     "title": {
      "description": "Program name, for example \"Four week strength base\".",
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "weeks": {
      "description": "Weeks in order.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "focus": {
         "description": "Short focus for the week, for example \"Volume\".",
         "maxLength": 300,
         "type": "string"
        },
        "week_number": {
         "description": "Week position in the program, starting at 1. Each week_number appears once.",
         "maximum": 52,
         "minimum": 1,
         "type": "integer"
        },
        "workouts": {
         "description": "Workouts in this week.",
         "items": {
          "additionalProperties": false,
          "properties": {
           "day_number": {
            "description": "Day position within the week, starting at 1. Each day_number appears once in a week.",
            "maximum": 14,
            "minimum": 1,
            "type": "integer"
           },
           "estimated_duration_minutes": {
            "description": "Expected length of the workout in minutes.",
            "maximum": 360,
            "minimum": 1,
            "type": "integer"
           },
           "exercises": {
            "description": "Exercises in the order they are performed. At most 300 sets in total.",
            "items": {
             "additionalProperties": false,
             "properties": {
              "duration": {
               "description": "Work time in seconds for a timed exercise.",
               "exclusiveMinimum": 0,
               "maximum": 7200,
               "type": "number"
              },
              "load": {
               "description": "Target load, for example \"80%\", \"135 lb\", \"60 kg\", \"bodyweight\" or \"RPE 8\".",
               "maxLength": 80,
               "type": "string"
              },
              "name": {
               "description": "Exercise name as written in the conversation, for example \"Back squat\".",
               "maxLength": 120,
               "minLength": 1,
               "type": "string"
              },
              "notes": {
               "description": "Short coaching note for this exercise.",
               "maxLength": 500,
               "type": "string"
              },
              "reps": {
               "description": "Reps per set as short text, for example \"8\", \"8-10\", \"AMRAP\" or \"40 sec\".",
               "maxLength": 40,
               "minLength": 1,
               "type": "string"
              },
              "rest": {
               "description": "Rest between sets, for example \"90 sec\" or \"2 min\".",
               "maxLength": 40,
               "type": "string"
              },
              "sets": {
               "description": "Number of sets.",
               "maximum": 20,
               "minimum": 1,
               "type": "integer"
              }
             },
             "required": [
              "name",
              "sets",
              "reps"
             ],
             "type": "object"
            },
            "maxItems": 100,
            "minItems": 1,
            "type": "array"
           },
           "notes": {
            "description": "Short note for the whole workout.",
            "maxLength": 2000,
            "type": "string"
           },
           "title": {
            "description": "Workout name, for example \"Lower body strength\".",
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "day_number",
           "exercises"
          ],
          "type": "object"
         },
         "maxItems": 14,
         "minItems": 1,
         "type": "array"
        }
       },
       "required": [
        "week_number",
        "workouts"
       ],
       "type": "object"
      },
      "maxItems": 52,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "title",
     "weeks"
    ],
    "type": "object"
   }
  },
  "required": [
   "program"
  ],
  "type": "object"
 },
 "name": "preview_program_import",
 "outputSchema": {
  "properties": {
   "estimated_duration_minutes": {
    "type": [
     "integer",
     "null"
    ]
   },
   "exercise_count": {
    "type": "integer"
   },
   "exercises": {
    "description": "Each exercise with its Phorme library match and demo link.",
    "items": {
     "properties": {
      "demo_url": {
       "description": "Page with the movement demo.",
       "type": [
        "string",
        "null"
       ]
      },
      "equipment": {
       "description": "Equipment the matched movement uses.",
       "type": [
        "string",
        "null"
       ]
      },
      "equipment_ok": {
       "description": "Whether that fits the equipment the user listed. Null when no equipment was given or the library does not say.",
       "type": [
        "boolean",
        "null"
       ]
      },
      "library_name": {
       "description": "The Phorme movement it matched, or null when nothing matched.",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "library_name",
      "equipment",
      "equipment_ok",
      "demo_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "expires_at": {
    "description": "When the preview can no longer be saved, as an ISO 8601 time.",
    "type": "string"
   },
   "preview_id": {
    "description": "Identifies this preview when it is saved.",
    "format": "uuid",
    "type": "string"
   },
   "requires_confirmation": {
    "description": "Always true: saving needs the user's confirmation.",
    "type": "boolean"
   },
   "title": {
    "type": "string"
   },
   "training_kind": {
    "enum": [
     "workout",
     "program"
    ],
    "type": "string"
   },
   "warning_count": {
    "type": "integer"
   },
   "warnings": {
    "description": "Items the user should review before saving.",
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "path",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "preview_id",
   "expires_at",
   "training_kind",
   "title",
   "exercise_count",
   "estimated_duration_minutes",
   "warning_count",
   "warnings",
   "requires_confirmation"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Preview program in Phorme"
}
