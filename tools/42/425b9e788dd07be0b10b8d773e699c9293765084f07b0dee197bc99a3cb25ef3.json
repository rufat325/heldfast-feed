    "enum": [
     "standard_eoa",
     "delegated_eip7702",
     "smart_contract",
     "unknown"
    ]
   },
   "funds_available": {
    "type": "boolean"
   },
   "intent": {
    "enum": [
     "discovery_only",
     "evaluate_purchase"
    ]
   },
   "service": {
    "type": "string"
   },
   "spend_authorized": {
    "type": "boolean"
   },
   "supported_assets": {
    "items": {
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "supported_networks": {
    "items": {
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "supports_x402_v2": {
    "type": "boolean"
   },
   "wallet_available": {
    "type": "boolean"
   }
  },
  "required": [
   "service",
   "intent"
  ],
  "type": "object"
 },
 "name": "payment_capability_preflight",
 "title": "Declare Payment Capability"
}
