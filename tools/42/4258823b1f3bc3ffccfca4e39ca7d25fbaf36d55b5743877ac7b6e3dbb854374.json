{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/html.forms",
  "agent-utilities/priceMicroUsd": 500
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Describe up to 30 forms and their controls without returning field values or submitting anything. PAID: 500 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "baseUrl": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     "html": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "html_forms",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "forms": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": [
        "string",
        "null"
       ]
      },
      "fields": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "disabled": {
          "type": "boolean"
         },
         "label": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "required": {
          "type": "boolean"
         },
         "type": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "type",
         "label",
         "required",
         "disabled"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "fieldsTruncated": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "method": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "action",
      "method",
      "fields",
      "fieldsTruncated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "forms",
   "truncated",
   "scope"
  ],
  "type": "object"
 }
}
