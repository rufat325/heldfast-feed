{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Records a need voidjet cannot serve, for when the user wants voidjet to know about it: e.g. no offer on the route, a return flight, pets, instant booking. Takes 1-5 categories and optional route, dates, passengers and budget; no personal data. Helps voidjet decide what to add.",
 "inputSchema": {
  "properties": {
   "aircraft_class": {
    "anyOf": [
     {
      "enum": [
       "vlj",
       "light",
       "midsize",
       "super_midsize",
       "heavy",
       "ultra",
       "turboprop",
       "airliner_vip"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Aircraft Class"
   },
   "categories": {
    "items": {
     "enum": [
      "route_not_covered",
      "date_not_covered",
      "too_few_seats",
      "price_above_budget",
      "return_flight",
      "multi_leg",
      "one_way_charter_wanted",
      "flexible_search_wanted",
      "aircraft_type_or_class",
      "cabin_amenities",
      "helicopter_or_other_aircraft",
      "pets",
      "special_luggage",
      "medical_or_accessibility",
      "cargo",
      "instant_booking_or_payment",
      "binding_price_or_availability",
      "notification_on_new_offers",
      "contact_by_phone",
      "provider_details",
      "other_information",
      "language_or_currency",
      "other"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "title": "Categories",
    "type": "array"
   },
   "date_from": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Date From"
   },
   "date_to": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Date To"
   },
   "destination": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Destination"
   },
   "max_budget_eur": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 10000000,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Max Budget Eur"
   },
   "origin": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Origin"
   },
   "passengers": {
    "anyOf": [
     {
      "maximum": 500,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Passengers"
   }
  },
  "required": [
   "categories"
  ],
  "title": "report_unmet_needArguments",
  "type": "object"
 },
 "name": "report_unmet_need",
 "outputSchema": {
  "properties": {
   "message": {
    "title": "Message",
    "type": "string"
   },
   "recorded": {
    "title": "Recorded",
    "type": "boolean"
   }
  },
  "required": [
   "recorded",
   "message"
  ],
  "title": "FeedbackResult",
  "type": "object"
 },
 "title": "Report an unmet need"
}
