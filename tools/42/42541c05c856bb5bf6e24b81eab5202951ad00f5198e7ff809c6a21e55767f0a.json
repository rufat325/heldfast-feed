{
 "description": "Start a shell command in the background and capture stdout/stderr to log files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cmd": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Command as a string or string array."
   },
   "command": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ],
    "description": "Command as a string or string array."
   },
   "cwd": {
    "description": "Working directory override.",
    "type": "string"
   },
   "env": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Environment variable overrides for the command.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "run_background"
}
