{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve payment requirements for a marketplace asset before purchasing. Returns whether the asset is free or paid. For paid assets, includes the x402 payment requirements object that must be signed by the buyer's wallet and passed to the purchase_asset tool.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "uploadId": {
    "description": "Upload ID of the marketplace asset to check payment requirements for.",
    "type": "string"
   }
  },
  "required": [
   "uploadId"
  ],
  "type": "object"
 },
 "name": "get_payment_requirements",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "additionalProperties": false,
    "description": "Asset metadata.",
    "properties": {
     "fileName": {
      "type": "string"
     },
     "mimeType": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "pricePerDownload": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "sellerAddress": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "sizeBytes": {
      "type": "number"
     },
     "title": {
      "type": "string"
     },
     "uploadId": {
      "type": "string"
     }
    },
    "required": [
     "uploadId",
     "title",
     "fileName",
     "mimeType",
     "sizeBytes",
     "sellerAddress",
     "pricePerDownload"
    ],
    "type": "object"
   },
   "isFree": {
    "description": "Whether the asset can be downloaded for free.",
    "type": "boolean"
   },
   "paymentRequirements": {
    "additionalProperties": false,
    "description": "x402 payment requirements \u2014 present only for paid assets. Sign this with your wallet and pass to purchase_asset.",
    "properties": {
     "asset": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "extra": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "maxAmountRequired": {
      "type": "string"
     },
     "maxTimeoutSeconds": {
      "type": "number"
     },
     "mimeType": {
      "type": "string"
     },
     "network": {
      "type": "string"
     },
     "payTo": {
      "type": "string"
     },
     "resource": {
      "type": "string"
     },
     "scheme": {
      "type": "string"
     }
    },
    "required": [
     "scheme",
     "network",
     "maxAmountRequired",
     "resource",
     "description",
     "mimeType",
     "payTo",
     "maxTimeoutSeconds",
     "asset",
     "extra"
    ],
    "type": "object"
   }
  },
  "required": [
   "isFree",
   "asset"
  ],
  "type": "object"
 },
 "title": "Get Payment Requirements"
}
