{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List verified metrics"
 },
 "description": "What Muffed can answer on. By default a summary of metric families with their counts and season coverage; with search or detail:true, individual metric keys. Returns keys and coverage only, never figures.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "detail": {
    "type": "boolean"
   },
   "entity_kind": {
    "enum": [
     "player",
     "team",
     "route",
     "personnel_group",
     "box_count",
     "rusher_count",
     "coverage_type",
     "regression_rule",
     "metric",
     "league"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "maxLength": 64,
    "type": "string"
   },
   "season": {
    "maximum": 2026,
    "minimum": 2016,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_metrics",
 "title": "List verified metrics"
}
