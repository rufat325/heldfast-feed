{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Search issued invoices"},"description":"Search issued (sales) invoices \u2014 vydan\u00e9 faktury \u2014 newest first. Each row includes payment status from UOL receivables. Use tax_date_* (DUZP) for accounting-period questions, issue_date_* for \"issued in\". Drafts and cancelled invoices are listed too; check status. For \"who owes me money\" prefer list_receivables.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"buyer_id":{"description":"Contact id from search_contacts","type":"string"},"due_date_from":{"description":"Date as YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"due_date_to":{"description":"Date as YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"issue_date_from":{"description":"Date as YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"issue_date_to":{"description":"Date as YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"limit":{"default":25,"description":"Rows per page (max 100)","maximum":100,"minimum":1,"type":"integer"},"number":{"description":"Partial match of the invoice number","type":"string"},"page":{"default":1,"description":"Page number, starting at 1","maximum":9007199254740991,"minimum":1,"type":"integer"},"query":{"description":"Full-text: invoice number, buyer name or text","type":"string"},"tax_date_from":{"description":"Date as YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"tax_date_to":{"description":"Date as YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"total_max":{"type":"number"},"total_min":{"description":"Total including VAT","type":"number"},"type":{"enum":["standard","corrective","proforma","penalty"],"type":"string"},"variable_symbol":{"type":"string"}},"type":"object"},"name":"search_sales_invoices","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","add