{
 "description": "Convierte un monto entre Unidades Indexadas y pesos uruguayos al valor de la UI de una fecha (default hoy).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "de": {
    "default": "UI",
    "enum": [
     "UI",
     "UYU"
    ],
    "type": "string"
   },
   "fecha": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "monto": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "monto"
  ],
  "type": "object"
 },
 "name": "uy_ui_convertir",
 "title": "Convertir UI a pesos uruguayos"
}
