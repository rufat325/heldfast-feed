  "properties": {
   "allowedRouters": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "allowedSources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "buyToken": {
    "type": "string"
   },
   "deadlineMs": {
    "type": "number"
   },
   "decimalsIn": {
    "type": "number"
   },
   "decimalsOut": {
    "type": "number"
   },
   "fromChainId": {
    "type": "number"
   },
   "minBuyAmount": {
    "type": "string"
   },
   "receiver": {
    "type": "string"
   },
   "sellAmount": {
    "type": "string"
   },
   "sellToken": {
    "type": "string"
   },
   "slippageBps": {
    "type": "number"
   },
   "sources": {
    "description": "alias for allowedSources",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "toChainId": {
    "type": "number"
   }
  },
  "required": [
   "fromChainId",
   "toChainId",
   "sellToken",
   "buyToken",
   "sellAmount",
   "receiver",
   "deadlineMs"
  ],
  "type": "object"
 },
 "name": "rfq_quote"
}
