     "ultraBullet",
     "bullet",
     "blitz",
     "rapid",
     "classical",
     "chess960",
     "crazyhouse",
     "antichess",
     "atomic",
     "horde",
     "kingOfTheHill",
     "racingKings",
     "threeCheck"
    ],
    "type": "string"
   }
  },
  "required": [
   "perf"
  ],
  "type": "object"
 },
 "name": "lichess_get_top_players",
 "title": "lichess: Get top players"
}
