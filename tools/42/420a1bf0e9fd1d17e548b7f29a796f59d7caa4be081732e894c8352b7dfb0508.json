{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Set (metafieldsSet) and/or delete (metafieldsDelete) up to 25 metafields each, for any owner GID. Read them with shopify_get resource metafields. Defaults to dryRun:true.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "delete": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "minLength": 1,
       "type": "string"
      },
      "namespace": {
       "minLength": 1,
       "type": "string"
      },
      "ownerId": {
       "pattern": "^gid:\\/\\/shopify\\/[A-Za-z]+\\/[0-9]+$",
       "type": "string"
      }
     },
     "required": [
      "ownerId",
      "namespace",
      "key"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "dryRun": {
    "default": true,
    "description": "True (the default) returns a before/after preview without changing anything in Shopify. Pass false to apply the change; the tool then reads the result back.",
    "type": "boolean"
   },
   "set": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "minLength": 1,
       "type": "string"
      },
      "namespace": {
       "default": "custom",
       "minLength": 1,
       "type": "string"
      },
      "ownerId": {
       "pattern": "^gid:\\/\\/shopify\\/[A-Za-z]+\\/[0-9]+$",
       "type": "string"
      },
      "type": {
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "ownerId",
      "key",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "store": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "store"
  ],
  "type": "object"
 },
 "name": "shopify_metafields"
}
