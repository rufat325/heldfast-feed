{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"\ubcf5\ub300\ub9ac \uc0c1\ub2f4 \uc694\uccad \uc900\ube44"},"description":"Prepare or revise a consultation preview from the user facts without submitting it.\n\n\uc774\uc6a9\uc790\uac00 \ubcc0\ud638\uc0ac \uc0c1\ub2f4 \uc2e0\uccad\uc744 \uc694\uccad\ud588\uc744 \ub54c, \uc81c\uacf5\ud55c \uc0ac\uc2e4\uc744 \ubc14\ud0d5\uc73c\ub85c \uc0ac\uac74 \uc720\ud615\u00b7\uc9c4\ud589 \ub2e8\uacc4\uc640 10~200\uc790 \uc694\uc57d\uc744 \ub2f4\uc740 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc900\ube44\ud569\ub2c8\ub2e4. \uae30\uc874 \ucd08\uc548\uc740 \uc9c4\ud589 ID\uc640 \ubc84\uc804\uc73c\ub85c \uc218\uc815\ud558\uac70\ub098 \uc7ac\uac1c\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc774 \ub2e8\uacc4\uc5d0\uc11c\ub294 \uc778\uc99d\uc774\ub098 \uc811\uc218\uac00 \uc2dc\uc791\ub418\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"category":{"enum":["civil","criminal","advisory"],"type":"string"},"expected_journey_revision":{"minimum":1,"type":"integer"},"journey_id":{"pattern":"^[a-f0-9]{32}$","type":"string"},"resume":{"type":"boolean"},"stage":{"enum":["before_action","in_progress","urgent","general_advice"],"type":"string"},"summary":{"description":"\uc0ac\uc6a9\uc790\uac00 \uc2e4\uc81c\ub85c \ub9d0\ud55c \uc0c1\ub2f4 \uc8fc\uc81c\u00b7\ubb38\uc81c\u00b7\uc9c8\ubb38\uc744 \uc694\uc57d\ud569\ub2c8\ub2e4. \uc2e0\uccad\ud558\uace0 \uc2f6\ub2e4\ub294 \ubb38\uc7a5\ub9cc \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ub0b4\uc6a9\uc774 \uc5c6\uc73c\uba74 \ub3c4\uad6c\ub97c \ud638\ucd9c\ud558\uae30 \uc804\uc5d0 \uc0ac\uc6a9\uc790\uc5d0\uac8c \ubb3b\uc2b5\ub2c8\ub2e4.","maxLength":200,"minLength":10,"type":"string"}},"required":["category","summary","stage"],"type":"object"},"name":"prepare_consultation_request","securitySchemes":[{"scopes":["consultations:prepare"],"type":"oauth2"}],"title":"\ubcf5\ub300\ub9ac \uc0c1\ub2f4 \uc694\uccad \uc900\ube4