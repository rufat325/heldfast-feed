{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find exact normalized text matches in native PDF text (no OCR). Results and excerpts are bounded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of matches to return.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Optional 1-based page filter.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Exact or normalized text to find.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document_id",
   "capability",
   "query"
  ],
  "type": "object"
 },
 "name": "search_document",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Bounded native-text search hits with page evidence.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "extensions": {},
   "hits": {
    "items": {},
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "resource": {},
   "totalMatches": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Search PDF text"
}
