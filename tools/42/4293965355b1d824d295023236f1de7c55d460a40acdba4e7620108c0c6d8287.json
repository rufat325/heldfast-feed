{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save the user-reviewed business name, audience, offer, conversion goal, tone, protected vocabulary and editorial preferences for the selected workspace. Requires workspace settings permission and confirmReviewed=true; changes future assistant guidance, preserving existing projects. Pronunciation notes guide script drafting; they do not retime or replace source speech.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "brandName": {
    "anyOf": [
     {
      "maxLength": 160,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "confirmReviewed": {
    "const": true,
    "type": "boolean"
   },
   "conversionGoal": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "editorialPreferences": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "avoidTerms": {
        "items": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 40,
        "type": "array"
       },
       "preferredLanguage": {
        "anyOf": [
         {
          "maxLength": 40,
          "minLength": 2,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "pronunciationNotes": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "pronunciation": {
           "maxLength": 160,
           "minLength": 1,
           "type": "string"
          },
          "term": {
           "maxLength": 100,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "term",
          "pronunciation"
         ],
         "type": "object"
        },
        "maxItems": 40,
        "type": "array"
       },
       "purpose": {
        "anyOf": [
         {
          "enum": [
           "authority",
           "education",
           "product_demo",
           "lead_generation"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "purpose",
       "preferredLanguage",
       "avoidTerms",
       "pronunciationNotes"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "offer": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "protectedWords": {
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 40,
    "type": "array"
   },
   "tone": {
    "anyOf": [
     {
      "maxLength": 240,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "workspaceId",
   "idempotencyKey",
   "brandName",
   "audience",
   "offer",
   "conversionGoal",
   "tone",
   "editorialPreferences",
   "protectedWords",
   "confirmReviewed"
  ],
  "type": "object"
 },
 "name": "workspace_context_save",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Save Reviewed Business Context"
}
