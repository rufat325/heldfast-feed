{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update fields on a contact by id. Provide a patch with at least one field. Use search_contacts first to find the contact id. The result echoes the operating workspace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The contact id returned by search_contacts.",
    "minLength": 1,
    "type": "string"
   },
   "patch": {
    "additionalProperties": false,
    "description": "The contact fields to update; include at least one changed field.",
    "properties": {
     "companyId": {
      "anyOf": [
       {
        "description": "Company id to link this contact to (from search_companies).",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Company id to link this contact to (from search_companies). Optional."
     },
     "email": {
      "anyOf": [
       {
        "description": "The contact's email address.",
        "format": "email",
        "maxLength": 255,
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The contact's email address. Optional."
     },
     "firstName": {
      "description": "The contact's first name.",
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "jobTitle": {
      "anyOf": [
       {
        "description": "The contact's job title.",
        "maxLength": 160,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The contact's job title. Optional."
     },
     "lastName": {
      "anyOf": [
       {
        "description": "The contact's last name.",
        "maxLength": 120,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The contact's last name. Optional."
     },
     "ownerId": {
      "anyOf": [
       {
        "description": "User id of the workspace member who owns this contact.",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "User id of the workspace member who owns this contact. Optional."
     },
     "phone": {
      "anyOf": [
       {
        "description": "The contact's phone number.",
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The contact's phone number. Optional."
     },
     "tags": {
      "description": "Tags for segmentation. Optional.",
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "id",
   "patch"
  ],
  "type": "object"
 },
 "name": "update_contact",
 "title": "Update contact"
}
