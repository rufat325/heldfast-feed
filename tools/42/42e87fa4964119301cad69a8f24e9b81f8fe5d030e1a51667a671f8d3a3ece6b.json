{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Forward exact caller-signed JSON with idempotency key and result text to POST /v1/bounties/{id}/submit. Owner acceptance is separate and unpaid; this tool does not sign or pay.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bounty_id": {
    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
    "type": "string"
   },
   "did": {
    "pattern": "^did:voidly:[1-9A-HJ-NP-Za-km-z]{1,32}$",
    "type": "string"
   },
   "nonce": {
    "pattern": "^[0-9a-f]{32}$",
    "type": "string"
   },
   "raw_body": {
    "maxLength": 8192,
    "minLength": 2,
    "type": "string"
   },
   "signature": {
    "pattern": "^[A-Za-z0-9+/]{86}==$",
    "type": "string"
   },
   "timestamp": {
    "pattern": "^[0-9]{10}$",
    "type": "string"
   }
  },
  "required": [
   "bounty_id",
   "raw_body",
   "did",
   "timestamp",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "voidly_bounty_submit",
 "title": "Submit Voidly bounty work"
}
