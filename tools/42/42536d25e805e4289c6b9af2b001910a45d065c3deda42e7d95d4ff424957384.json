{
 "description": "Solana pump.fun graduations from the last 1-48 hours with aggregates: median time on the curve, how many followed a buyer burst, and median post-graduation returns at 1, 5 and 15 minutes (with the share still up at 15). Data rewritten every 20 s; refused (503, not charged) if older than 120 s. Costs $0.02 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hours": {
    "description": "Look-back window in hours, 1-48 (default 24)",
    "maximum": 48,
    "minimum": 1,
    "type": "number"
   },
   "limit": {
    "description": "Max rows, 1-2000 (default 500)",
    "maximum": 2000,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "sol_grads_history",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "chain": {
    "type": "string"
   },
   "generatedAt": {
    "type": "number"
   },
   "grads": {
    "items": {
     "$ref": "#/properties/method"
    },
    "type": "array"
   },
   "hours": {
    "type": "number"
   },
   "method": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "schemaVersion": {
    "type": "number"
   },
   "stats": {
    "$ref": "#/properties/method"
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "hours",
   "stats",
   "grads"
  ],
  "type": "object"
 }
}
