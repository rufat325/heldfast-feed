{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "CI/CD Pipeline Cost Calculator"
 },
 "description": "Use this when a user asks how much their GitHub Actions CI/CD pipeline costs per month. Takes average job duration in minutes, jobs per run, runs per month and the runner label (ubuntu-latest, windows-latest, macos-latest or self-hosted; matched case-insensitively). Uses GitHub list prices for standard hosted runners effective 1 Jan 2026 and GitHub Free's 2,000 included minutes for private repositories, drawn at list price. Self-hosted minutes carry no GitHub charge.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "avg_job_min": {
    "description": "Average job duration in minutes.",
    "examples": [
     8
    ],
    "minimum": 0,
    "type": "number"
   },
   "jobs_per_run": {
    "description": "Jobs per workflow run.",
    "examples": [
     4
    ],
    "minimum": 0,
    "type": "number"
   },
   "runner": {
    "description": "Runner label, for example ubuntu-latest, windows-latest, macos-latest or self-hosted. Matched case-insensitively; defaults to Linux.",
    "examples": [
     "ubuntu-latest"
    ],
    "maxLength": 128,
    "type": "string"
   },
   "runs_per_month": {
    "description": "Workflow runs per month.",
    "examples": [
     500
    ],
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "avg_job_min",
   "jobs_per_run",
   "runs_per_month"
  ],
  "type": "object"
 },
 "name": "pipeline-cost-calculator",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affiliate_context": {
    "additionalProperties": false,
    "properties": {
     "affiliate": {
      "type": "string"
     },
     "cta_label": {
      "type": "string"
     },
     "disclosure": {
      "type": "string"
     },
     "framing": {
      "type": "string"
     },
     "posture": {
      "enum": [
       "secondary"
      ],
      "type": "string"
     },
     "slot_id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "variant": {
      "type": "string"
     }
    },
    "required": [
     "affiliate",
     "cta_label",
     "disclosure",
     "framing",
     "posture",
     "slot_id",
     "url",
     "variant"
    ],
    "type": "object"
   },
   "billable_minutes": {
    "type": "number"
   },
   "computation_basis": {
    "type": "string"
   },
   "included_minutes": {
    "type": "number"
   },
   "included_minutes_used": {
    "type": "number"
   },
   "interpretation": {
    "type": "string"
   },
   "monthly_cost_usd": {
    "type": "number"
   },
   "next_step": {
    "type": "string"
   },
   "next_step_url": {
    "type": "string"
   },
   "rate_per_minute_usd": {
    "type": "number"
   },
   "rates_as_of": {
    "type": "string"
   },
   "runner_multiplier": {
    "type": "number"
   },
   "runner_type": {
    "type": "string"
   },
   "severity": {
    "type": "string"
   },
   "total_minutes_per_month": {
    "type": "number"
   },
   "why_follow_up": {
    "type": "string"
   }
  },
  "required": [
   "billable_minutes",
   "computation_basis",
   "included_minutes",
   "included_minutes_used",
