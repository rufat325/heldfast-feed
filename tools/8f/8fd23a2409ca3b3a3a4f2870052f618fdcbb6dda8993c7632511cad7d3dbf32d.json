{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Verify a ManifestBundle"
 },
 "description": "Structural and content-address verification: schema, recomputed manifestDigest, every inline blob hashes to its key, attestation subject matches. When a root with .axiom/trust/keys.json is available, detached DSSE signatures are verified and the trusted keyids are reported under `signatures`. Never writes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bundle": {
    "additionalProperties": {},
    "description": "ManifestBundle",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "root": {
    "description": "Absolute repository root; must equal or lie inside an allowlisted --root",
    "type": "string"
   }
  },
  "required": [
   "bundle"
  ],
  "type": "object"
 },
 "name": "axiom_manifest_verify",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "canonical": {
    "type": "boolean"
   },
   "errors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "enum": [
        "ERR_PATH_NOT_RELATIVE_POSIX",
        "ERR_PATH_SEGMENT",
        "ERR_PATH_NOT_NFC",
        "ERR_PATH_RESERVED_NAME",
        "ERR_PATH_INVALID_CHAR",
        "ERR_PATH_CASE_COLLISION",
        "ERR_SYMLINK_IN_PATH",
        "ERR_CONTAINMENT",
        "ERR_TARGET_TYPE",
        "ERR_EXISTS",
        "ERR_NOT_FOUND",
        "ERR_BLOB_MISSING",
        "ERR_DIGEST_FORMAT",
        "ERR_DIGEST_MISMATCH",
        "ERR_SIZE_MISMATCH",
        "ERR_BLOB_TOO_LARGE",
        "ERR_BUNDLE_TOO_LARGE",
        "ERR_LOCKED",
        "ERR_ROOT_NOT_ALLOWED",
        "ERR_ROOT_REQUIRED",
        "ERR_ROOT_NOT_DIR",
        "ERR_CONFIRM_DIGEST_MISMATCH",
        "ERR_CHECKS_FAILED",
        "ERR_PREIMAGE_CHANGED",
        "ERR_JOURNAL_CORRUPT",
        "ERR_JOURNAL_CHAIN",
        "ERR_EBUSY",
        "ERR_CONFLICT",
        "ERR_INVALID_PLAN",
        "ERR_INVALID_MANIFEST",
        "ERR_INVALID_PROFILE",
        "ERR_PREDICATE_UNKNOWN",
        "ERR_PREDICATE_PARAMS",
        "ERR_PROVIDER_FAILED",
        "ERR_GUARD_TIMEOUT",
        "ERR_GUARD_OUTPUT",
        "ERR_FACT_DISABLED",
        "ERR_SIGNATURE_MISSING",
        "ERR_SIGNATURE_INVALID",
        "ERR_KEYLESS_UNAVAILABLE",
        "ERR_TRUST_STATE_CORRUPT",
        "ERR_ROLLBACK",
        "ERR_EMITTER_UNKNOWN",
        "ERR_TEMPLATE_UNKNOWN",
        "ERR_TEMPLATE_PARAMS",
        "ERR_PATCH_FORMAT",
        "ERR_PATCH_PREIMAGE",
        "ERR_PATCH_NO_MATCH",
        "ERR_GIT_NOT_FOUND",
        "ERR_GIT_NOT_REPO",
        "ERR_GIT_DIRTY",
        "ERR_GIT_BRANCH_EXISTS",
        "ERR_GIT_BRANCH_INVALID",
        "ERR_GIT_FAILED",
        "ERR_TASK_NOT_FOUND",
        "ERR_TASK_CANCELLED",
        "ERR_PLAN_SESSION_STATE",
        "ERR_REF_OFFLINE",
        "ERR_NET_DISABLED",
        "ERR_NET_DENIED",
        "ERR_NET_FAILED",
        "ERR_NOT_CANONICAL",
        "ERR_UNSUPPORTED_OP",
        "ERR_INTERNAL"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "manifestDigest": {
    "description": "sha256:<64 lowercase hex>",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "signatures": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "ERR_SIGNATURE_MISSING",
       "ERR_SIGNATURE_INVALID"
      ],
      "type": "string"
     },
     "findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "message": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "keyids": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "ok": {
      "type": "boolean"
     },
     "trustFile": {
      "type": "string"
     }
    },
    "required": [
     "trustFile",
     "keyids",
     "findings",
     "ok"
    ],
    "type": "object"
   },
   "signed": {
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "canonical",
   "signed",
   "missing",
   "errors"
  ],
  "type": "object"
 },
 "title": "Verify a ManifestBundle"
}
