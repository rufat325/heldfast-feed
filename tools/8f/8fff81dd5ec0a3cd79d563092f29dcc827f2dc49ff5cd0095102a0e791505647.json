{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record CI status checks (up to 1000 per call), each attached to whichever card its commit/branch/PR or description names.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "branch": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "minLength": 1,
       "type": "string"
      },
      "pr": {
       "type": "string"
      },
      "sha": {
       "type": "string"
      },
      "status": {
       "enum": [
        "passing",
        "failing",
        "pending",
        "superseded"
       ],
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "status"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "repo": {
    "additionalProperties": false,
    "properties": {
     "provider": {
      "type": "string"
     },
     "remoteUrl": {
      "description": "The repo's remote URL, in whatever form (HTTPS or SSH) \u2014 resolved to the same RepoLink either way.",
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "remoteUrl"
    ],
    "type": "object"
   }
  },
  "required": [
   "repo",
   "checks"
  ],
  "type": "object"
 },
 "name": "zuuna_report_ci_checks",
 "title": "zuuna_report_ci_checks"
}
