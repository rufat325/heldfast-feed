{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send a message"
 },
 "description": "Compose a new message in a connected mailbox and send it in one call. Call this only when the person asked for this message to go; when they asked to prepare one, draft it instead. A request id already spent sends nothing again: the answer says whether that send went or may have gone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attachments": {
    "description": "Files to carry: one held by a connected mailbox of the message's own provider, or content you write out.",
    "items": {
     "anyOf": [
      {
       "properties": {
        "attachmentId": {
         "description": "An attachment id, as a message read named it.",
         "maxLength": 2048,
         "pattern": "^(?:\\d+(?:\\.\\d+)*|[A-Za-z0-9_=-]+)$",
         "type": "string"
        },
        "mailbox": {
         "description": "The mailbox holding the message the file is in, of the same provider as the one written from.",
         "minLength": 1,
         "type": "string"
        },
        "messageId": {
         "description": "The provider's own identifier.",
         "pattern": "^[A-Za-z0-9_=-]{1,512}$",
         "type": "string"
        }
       },
       "required": [
        "mailbox",
        "messageId",
        "attachmentId"
       ],
       "type": "object"
      },
      {
       "properties": {
        "content": {
         "contentEncoding": "base64",
         "description": "The file's own bytes, base64.",
         "format": "base64",
         "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
         "type": "string"
        },
        "filename": {
         "description": "What the file is called.",
         "minLength": 1,
         "type": "string"
        },
        "mimeType": {
         "description": "The file's media type.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "filename",
        "mimeType",
        "content"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "bcc": {
    "description": "Who to blind-copy. The other recipients are not told.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "body": {
    "description": "The message text.",
    "minLength": 1,
    "type": "string"
   },
   "cc": {
    "description": "Who to copy.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "html": {
    "description": "The message as HTML, for formatting; body stays its plain-text version. An Outlook mailbox keeps only the HTML and writes the plain version from it.",
    "minLength": 1,
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "requestId": {
    "description": "Your own id for this send, new for every message. One whose send went or may have gone sends nothing again.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "subject": {
    "description": "The subject line.",
    "type": "string"
   },
   "to": {
    "description": "Who the message is addressed to.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "mailbox",
   "to",
   "subject",
   "body",
   "requestId"
  ],
  "type": "object"
 },
 "name": "messages_send",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accepted": {
    "const": true,
    "type": "boolean"
   },
   "id": {
    "type": [
     "string",
     "null"
    ]
   },
   "messageId": {
    "type": "string"
   },
   "refusedRecipients": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "threadId": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "threadId"
  ],
  "type": "object"
 },
 "title": "Send a message"
}
