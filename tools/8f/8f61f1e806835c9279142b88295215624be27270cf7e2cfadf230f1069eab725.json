{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check availability"
 },
 "description": "Check live start times and remaining seats for a TripWays tour on one date or a range of up to 31 days. Pass party_size (seats needed) or a travelers object; slots that cannot fit the group are left out, and party_size wins if both are given. The status field is ok, no_schedule, no_fit, or calendar_gone. Use get_price_quote with the same date, start time, and travelers for the total.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_id": {
    "pattern": "^[0-9]+$",
    "type": "string"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_end": {
    "description": "Inclusive end; default = date. Max 31 days.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "party_size": {
    "description": "Occupied seats to keep (not ticket count). Slots with availabilityCount < party_size are omitted unless unlimited. Wins over travelers when both are set.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "travelers": {
    "additionalProperties": false,
    "description": "Simple ages; mapped to occupied seats (infants excluded unless the tour has an infant category). Used only when party_size is omitted.",
    "properties": {
     "adults": {
      "default": 1,
      "minimum": 0,
      "type": "integer"
     },
     "children": {
      "minimum": 0,
      "type": "integer"
     },
     "infants": {
      "minimum": 0,
      "type": "integer"
     },
     "seniors": {
      "minimum": 0,
      "type": "integer"
     },
     "youth": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "bokun_id",
   "date"
  ],
  "type": "object"
 },
 "name": "check_availability",
 "outputSchema": {
  "properties": {
   "bokun_id": {
    "type": "string"
   },
   "bookable_natively": {
    "type": "boolean"
   },
   "checkout_url": {
    "type": "string"
   },
   "error": {
    "description": "Present when ok is false. code: tour_not_found, destination_not_found, destination_ambiguous, or unpriced. message is written for the traveler.",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "slots": {
    "description": "Open start times that fit the party.",
    "items": {
     "properties": {
      "date": {
       "description": "YYYY-MM-DD.",
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "min_participants": {
       "type": "integer"
      },
      "rate_ids": {
       "type": "array"
      },
      "sold_out": {
       "type": "boolean"
      },
      "spots_left": {
       "description": "Null when unlimited.",
       "type": [
        "integer",
        "null"
       ]
      },
      "start_time": {
       "description": "HH:MM.",
       "type": "string"
      },
      "start_time_id": {
       "description": "Pass to get_price_quote / get_booking_link.",
       "type": "integer"
      },
      "unlimited": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "description": "ok, no_schedule, no_fit, or calendar_gone.",
    "type": "string"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Check availability"
}
