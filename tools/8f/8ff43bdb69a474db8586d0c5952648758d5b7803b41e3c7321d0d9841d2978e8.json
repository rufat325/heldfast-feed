{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Return an idempotent, short-lived download URL for one verified artifact this service holds, including a result artifact named by a succeeded invocation's output_artifact. HTTP sends no request body, not even an empty JSON object; artifact_ref is the URL path parameter and Idempotency-Key is a header. The MCP tool instead takes artifact_ref and idempotency_key as tool arguments. The URL expires after at most 60 seconds. The immutable artifact reference is the only authority; verify downloaded bytes against the returned content digest.",
 "inputSchema": {
  "$defs": {
   "ArtifactRef": {
    "description": "Opaque artifact reference minted by artifact commitment. Relay it unchanged; its form is not part of the contract.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "IdempotencyKey": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[^\\s\\x00-\\x1F\\x7F](?:[^\\x00-\\x1F\\x7F]*[^\\s\\x00-\\x1F\\x7F])?$",
    "type": "string"
   }
  },
  "$id": "urn:ausca:mcp:CreateArtifactAccess:input:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "artifact_ref": {
    "$ref": "#/$defs/ArtifactRef"
   },
   "idempotency_key": {
    "$ref": "#/$defs/IdempotencyKey"
   }
  },
  "required": [
   "artifact_ref",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "ausca_artifact_access",
 "outputSchema": {
  "$defs": {
   "ArtifactAccess": {
    "additionalProperties": false,
    "properties": {
     "artifact_ref": {
      "$ref": "#/$defs/ArtifactRef"
     },
     "content_digest": {
      "$ref": "#/$defs/Digest"
     },
     "created_at": {
      "format": "date-time",
      "type": "string"
     },
     "download_url": {
      "format": "uri",
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "media_type": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "size_bytes": {
      "maximum": 26214400,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "artifact_ref",
     "content_digest",
     "media_type",
     "size_bytes",
     "created_at",
     "download_url",
     "expires_at"
    ],
    "type": "object"
   },
   "ArtifactRef": {
    "description": "Opaque artifact reference minted by artifact commitment. Relay it unchanged; its form is not part of the contract.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "Digest": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "$id": "urn:ausca:mcp:CreateArtifactAccess:output:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "artifact": {
    "$ref": "#/$defs/ArtifactAccess"
   },
   "status": {
    "const": "ready"
   }
  },
  "required": [
   "status",
   "artifact"
  ],
  "type": "object"
 },
 "title": "Mint artifact download access"
}
