{
 "description": "Add a new line item (deliverable) to a storyline's strategy. Specify the channel, type, title, description, and a config map (pass {} if no extra config).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "automatable": {
    "description": "Whether PostKing can auto-generate this item (defaults to server-side logic)",
    "type": "boolean"
   },
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "channel": {
    "description": "Publishing channel \u2014 e.g. 'linkedin', 'twitter', 'blog', 'email'",
    "minLength": 1,
    "type": "string"
   },
   "config": {
    "additionalProperties": {},
    "description": "Channel/type-specific configuration \u2014 pass {} if none",
    "type": "object"
   },
   "description": {
    "description": "What this piece of content should achieve or cover",
    "minLength": 1,
    "type": "string"
   },
   "storylineId": {
    "description": "Storyline ID",
    "type": "string"
   },
   "targetDate": {
    "description": "Target publish date (ISO 8601)",
    "type": "string"
   },
   "title": {
    "description": "Line-item headline / title",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Content type \u2014 e.g. 'post', 'article', 'newsletter', 'video'",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "storylineId",
   "channel",
   "type",
   "title",
   "description",
   "config"
  ],
  "type": "object"
 },
 "name": "storyline_add_line_item"
}
