  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "New workflow description",
    "type": "string"
   },
   "edges": {
    "description": "Updated list of edges",
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "description": "Source node ID",
       "type": "string"
      },
      "to": {
       "description": "Target node ID",
       "type": "string"
      }
     },
     "required": [
      "from",
      "to"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "New workflow name",
    "type": "string"
   },
   "nodes": {
    "description": "Updated list of nodes",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
