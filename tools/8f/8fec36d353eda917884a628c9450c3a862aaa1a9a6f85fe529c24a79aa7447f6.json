       "type": "string"
      },
      "name": {
       "description": "Node name",
       "type": "string"
      },
      "properties": {
       "additionalProperties": {},
       "description": "Node-specific properties",
       "type": "object"
      },
      "type": {
       "description": "Node type",
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "workflowId": {
    "description": "Workflow ID to update",
    "type": "string"
   }
