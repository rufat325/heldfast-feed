{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing Datadog dashboard",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dashboardId": {
    "description": "Dashboard ID to update. Example: abc-def-ghi",
    "type": "string"
   },
   "description": {
    "description": "Dashboard description",
    "type": "string"
   },
   "layoutType": {
    "description": "Layout type",
    "enum": [
     "ordered",
     "free"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "templateVariables": {
    "description": "Template variables",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Dashboard title",
    "type": "string"
   },
   "widgets": {
    "description": "Array of widget definitions",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "dashboardId",
   "title",
   "layoutType",
   "widgets"
  ],
  "type": "object"
 },
 "name": "update-dashboard"
}
