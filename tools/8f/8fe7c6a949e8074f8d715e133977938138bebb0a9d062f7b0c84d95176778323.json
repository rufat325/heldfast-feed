    "default": 1000,
    "description": "Model requests per day; count every call in agent loops.",
    "maximum": 10000000,
    "minimum": 1,
    "title": "Requests Per Day",
    "type": "integer"
   },
   "servers": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "github",
        "filesystem",
        "memory",
        "playwright"
       ],
       "type": "string"
      },
      "maxItems": 4,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Distinct server ids; omit for all.",
    "title": "Servers"
   }
  },
