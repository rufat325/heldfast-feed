{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a custom path. Note: Illustrator will be activated (brought to foreground) during execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "anchors": {
    "description": "Array of anchor points",
    "items": {
     "properties": {
      "left_handle": {
       "description": "Left direction handle coordinates",
       "properties": {
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        }
       },
       "required": [
        "x",
        "y"
       ],
       "type": "object"
      },
      "point_type": {
       "default": "corner",
       "description": "Point type",
       "enum": [
        "corner",
        "smooth"
       ],
       "type": "string"
      },
      "right_handle": {
       "description": "Right direction handle coordinates",
       "properties": {
        "x": {
         "type": "number"
        },
        "y": {
         "type": "number"
        }
       },
       "required": [
        "x",
        "y"
       ],
       "type": "object"
      },
      "x": {
       "description": "Anchor point X coordinate",
       "type": "number"
      },
      "y": {
       "description": "Anchor point Y coordinate",
       "type": "number"
      }
     },
     "required": [
      "x",
      "y"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "closed": {
    "description": "Whether to close the path",
    "type": "boolean"
   },
   "coordinate_system": {
    "description": "Coordinate system. Auto-detected from document by default (CMYK/print \u2192 document, RGB/web \u2192 artboard-web). artboard-web: origin at active artboard top-left, Y-down. document: Illustrator native coords, origin at bottom-left, Y-up. Call get_document_info to check which system is active.",
    "enum": [
     "artboard-web",
     "document"
    ],
    "type": "string"
   },
   "fill": {
    "description": "Fill color",
    "oneOf": [
     {
      "properties": {
       "c": {
        "description": "Cyan (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "k": {
        "description": "Black (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "m": {
        "description": "Magenta (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "type": {
        "const": "cmyk",
        "description": "Color type",
        "type": "string"
       },
       "y": {
        "description": "Yellow (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "type",
       "c",
       "m",
       "y",
       "k"
      ],
      "type": "object"
     },
     {
      "properties": {
       "b": {
        "description": "Blue (0-255)",
        "maximum": 255,
        "minimum": 0,
        "type": "number"
       },
       "g": {
        "description": "Green (0-255)",
        "maximum": 255,
        "minimum": 0,
        "type": "number"
       },
       "r": {
        "description": "Red (0-255)",
        "maximum": 255,
        "minimum": 0,
        "type": "number"
       },
       "type": {
        "const": "rgb",
        "description": "Color type",
        "type": "string"
       }
      },
      "required": [
       "type",
       "r",
       "g",
       "b"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "gray",
        "description": "Color type",
        "type": "string"
       },
       "value": {
        "description": "Gray value (0-100)",
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "type": "object"
     },
     {
      "properties": {
       "type": {
        "const": "none",
        "description": "Color type",
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     }
    ]
   },
   "layer_name": {
    "description": "Target layer name",
    "type": "string"
   },
   "name": {
    "description": "Object name",
    "type": "string"
   },
   "stroke": {
    "description": "Stroke settings",
    "properties": {
     "color": {
      "description": "Stroke color",
      "oneOf": [
       {
        "properties": {
         "c": {
          "description": "Cyan (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "k": {
          "description": "Black (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "m": {
          "description": "Magenta (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         },
         "type": {
          "const": "cmyk",
          "description": "Color type",
          "type": "string"
         },
         "y": {
          "description": "Yellow (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "type",
         "c",
         "m",
         "y",
         "k"
        ],
        "type": "object"
       },
       {
        "properties": {
         "b": {
          "description": "Blue (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "g": {
          "description": "Green (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "r": {
          "description": "Red (0-255)",
          "maximum": 255,
          "minimum": 0,
          "type": "number"
         },
         "type": {
          "const": "rgb",
          "description": "Color type",
          "type": "string"
         }
        },
        "required": [
         "type",
         "r",
         "g",
         "b"
        ],
        "type": "object"
       },
       {
        "properties": {
         "type": {
          "const": "gray",
          "description": "Color type",
          "type": "string"
         },
         "value": {
          "description": "Gray value (0-100)",
          "maximum": 100,
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "type",
         "value"
        ],
        "type": "object"
       },
       {
        "properties": {
         "type": {
          "const": "none",
          "description": "Color type",
          "type": "string"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       }
      ]
     },
     "width": {
      "description": "Stroke width",
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "anchors"
  ],
  "type": "object"
 },
 "name": "create_path",
 "title": "Create Path"
}
