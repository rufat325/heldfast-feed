{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check whether an email address has bought from this merchant (optionally a specific product or offer). Use to gate access to content, communities, or support.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "offer_id": {
    "type": "string"
   },
   "product_id": {
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
 "name": "verify_purchase",
 "title": "Verify a purchase"
}
