{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Rename a custom emoji.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "emoji": {
    "description": "Current emoji name or ID.",
    "type": "string"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "name": {
    "maxLength": 32,
    "minLength": 2,
    "pattern": "^[A-Za-z0-9_]+$",
    "type": "string"
   }
  },
  "required": [
   "emoji",
   "name"
  ],
  "type": "object"
 },
 "name": "update_emoji",
 "title": "Update emoji"
}
