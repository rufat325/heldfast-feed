 "description": "Use this when the user names or describes a Pok\u00e9mon card and wants to identify it or see its price. Finds Pok\u00e9mon cards the way the pokefocus.com search box does, best match first. Each card has its id, TCGplayer market price, 30-day raw and PSA 10 eBay sold medians and sale counts, image, card page, and a link to its active listings. Not for sealed products.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Results to return.",
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Card name, number (\"173/165\", \"GG35\"), set name or code, rarity, or a mix, as in the pokefocus.com search box.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_cards",
