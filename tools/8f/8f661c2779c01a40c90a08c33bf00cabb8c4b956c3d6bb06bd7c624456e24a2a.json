"type":"object"},"name":"get_occasion_sky","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","anyOf":[{"additionalProperties":false,"properties":{"data":{"additionalProperties":false,"properties":{"bestDays":{"anyOf":[{"additionalProperties":false,"properties":{"best":{"items":{"additionalProperties":false,"properties":{"date":{"type":"string"},"reasons":{"items":{"type":"string"},"type":"array"},"score":{"maximum":100,"minimum":0,"type":"integer"},"verdict":{"type":"string"}},"required":["date","score","verdict","reasons"],"type":"object"},"maxItems":3,"type":"array"},"days":{"maximum":92,"minimum":1,"type":"integer"},"from":{"type":"string"},"to":{"type":"string"}},"required":["from","to","days","best"],"type":"object"},{"type":"null"}]},"card":{"additionalProperties":false,"properties":{"closing":{"type":"string"},"interpretation":{"type":"string"},"title":{"type":"string"}},"required":["title","interpretation","closing"],"type":"object"},"cardUrl":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}]},"date":{"type":"string"},"evening":{"anyOf":[{"additionalProperties":false,"properties":{"civilDusk":{"anyOf":[{"additionalProperties":false,"properties":{"local":{"type":"string"},"utc":{"type":"string"}},"required":["utc","local"],"type":"object"},{"type":"null"}]},"flags":{"items":{"type":"string"},"type":"array"},"goldenHour":{"anyOf":[{"additionalProperties":false,"properties":{"end":{"additionalProperties":false,"properties":{"local":{"type":"string"},"utc":{"type":"string"}},"required":["utc","local"],"type":"object"},"start":{"additionalProperties":false,"properties":{"local":{"type":"string"},"utc":{"type":"string"}},"required":["utc","local"],"type":"object"}},"required":["start","end"],"type":"object"},{"type":"null"}]},"moonHighest":{"anyOf":[{"additionalProperties":false,"properties":{"altitude":{"type":"number"},"at":{"additionalProperties":false,"properties":{"local":{"type":"string"},"utc":{"type":"string"}},"required":[