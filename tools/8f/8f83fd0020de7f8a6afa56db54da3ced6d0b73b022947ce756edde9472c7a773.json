{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a UWB RTLS scaffold with sanitized tag positions, anchor maps, spatial policy, adapter source, and tag-privacy notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "websocket_json",
    "enum": [
     "websocket_json",
     "http_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "ws://127.0.0.1:9086/uwb",
    "type": "string"
   },
   "anchor_count": {
    "default": 8,
    "maximum": 256,
    "minimum": 3,
    "type": "integer"
   },
   "name": {
    "default": "uwb_anchor_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the UWB scaffold.",
    "type": "string"
   },
   "position_units": {
    "default": "meters",
    "enum": [
     "meters",
     "centimeters",
     "normalized"
    ],
    "type": "string"
   },
   "space_label": {
    "default": "tracked_space",
    "type": "string"
   },
   "tag_count": {
    "default": 12,
    "maximum": 2048,
    "minimum": 1,
    "type": "integer"
   },
   "zone_count": {
    "default": 4,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_uwb_anchor_bus",
 "title": "Connect UWB anchor bus"
}
