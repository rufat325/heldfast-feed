{
 "description": "Get photos for a specific business.",
 "inputSchema": {
  "properties": {
   "businessId": {
    "description": "Yelp business ID",
    "type": "string"
   },
   "category": {
    "description": "Photo category",
    "enum": [
     "all",
     "food",
     "inside",
     "outside",
     "drink",
     "menu"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Number of photos to retrieve",
    "type": "number"
   }
  },
  "required": [
   "businessId"
  ],
  "type": "object"
 },
 "name": "yelp_get_photos"
}
