{
 "annotations": {},
 "description": "Link an action to a trigger for event-based execution",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionName": {
    "description": "Action name in \"{packageName}/{actionName}\" format",
    "type": "string"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   },
   "triggerName": {
    "description": "Name of the trigger",
    "type": "string"
   }
  },
  "required": [
   "triggerName",
   "actionName"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_link_trigger_action"
}
