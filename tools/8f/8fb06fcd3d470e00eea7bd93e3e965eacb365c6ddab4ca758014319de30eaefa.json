{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update project"
 },
 "description": "Update an existing project by ID. Requires projects:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "budget_status": {
    "description": "Budget status",
    "enum": [
     "off_track",
     "on_track",
     "not_set",
     "monitor"
    ],
    "type": "string"
   },
   "current_phase": {
    "description": "Current phase",
    "maxLength": 100,
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "end_date": {
    "description": "End date (ISO 8601)",
    "type": "string"
   },
   "health_status": {
    "description": "Health status",
    "enum": [
     "on_track",
     "at_risk",
     "delayed",
     "critical"
    ],
    "type": "string"
   },
   "id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "image_url": {
    "description": "Image URL",
    "maxLength": 2000,
    "type": "string"
   },
   "name": {
    "description": "Project name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "progress_percentage": {
    "description": "Progress percentage (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "progress_status": {
    "description": "Progress status",
    "enum": [
     "off_track",
     "on_track",
     "monitor"
    ],
    "type": "string"
   },
   "project_code": {
    "description": "Project code",
    "maxLength": 100,
    "type": "string"
   },
   "project_manager": {
    "description": "Project manager name",
    "maxLength": 200,
    "type": "string"
   },
   "project_type": {
    "description": "Project type",
    "enum": [
     "capital",
     "maintenance",
     "repair",
     "upgrade",
     "new_construction",
     "renovation",
     "deferred_maintenance",
     "other"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Start date (ISO 8601)",
    "type": "string"
   },
   "status": {
    "description": "Status label shown in the app's Status column and filter: planning, in-progress, on-hold, completed, cancelled, or your organization's own value. Defaults to planning. Whether the project is active or archived follows current_phase; status counts only when the phase has no Means setting.",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_project",
 "title": "Update project"
}
