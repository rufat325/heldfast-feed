{
 "description": "Set a budget threshold for daily, weekly, or monthly spend. Alerts when exceeded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "period": {
    "description": "Budget period: daily, weekly, or monthly",
    "enum": [
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   },
   "threshold": {
    "description": "Budget threshold in USD (e.g. 10.00 for $10)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "threshold",
   "period"
  ],
  "type": "object"
 },
 "name": "volt_set_budget_alert"
}
