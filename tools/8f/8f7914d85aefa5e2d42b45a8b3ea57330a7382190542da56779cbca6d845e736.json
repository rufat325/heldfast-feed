{
 "description": "Get compliance findings from a completed GuardBee scan, optionally filtered by severity",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "framework": {
    "description": "Framework label for the report header",
    "enum": [
     "KVKK",
     "GDPR",
     "CCPA"
    ],
    "type": "string"
   },
   "scanId": {
    "description": "Scan ID returned by check_compliance",
    "type": "string"
   },
   "severity": {
    "description": "Filter by severity",
    "enum": [
     "CRITICAL",
     "HIGH",
     "MEDIUM",
     "LOW",
     "INFO"
    ],
    "type": "string"
   }
  },
  "required": [
   "scanId"
  ],
  "type": "object"
 },
 "name": "get_compliance_findings"
}
