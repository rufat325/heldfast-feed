{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new standalone draft email (saved but not sent). For replying to an existing thread, use create_reply_draft instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bcc": {
    "$ref": "#/properties/to",
    "description": "BCC recipient(s)"
   },
   "body": {
    "description": "Email body (HTML supported)",
    "type": "string"
   },
   "cc": {
    "$ref": "#/properties/to",
    "description": "CC recipient(s)"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "to": {
    "anyOf": [
     {
      "items": {
       "format": "email",
       "maxLength": 254,
       "type": "string"
      },
      "maxItems": 500,
      "type": "array"
     },
     {
      "$ref": "#/properties/to/anyOf/0/items"
     }
    ],
    "description": "Recipient email address(es)"
   }
  },
  "type": "object"
 },
 "name": "create_draft"
}
