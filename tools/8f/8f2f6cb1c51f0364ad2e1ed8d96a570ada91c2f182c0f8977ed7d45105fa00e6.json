       "type": "string"
      },
      "kind": {
       "enum": [
        "read",
        "write",
        "delete"
       ],
       "type": "string"
      },
      "method": {
       "type": "string"
      },
      "operationId": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
