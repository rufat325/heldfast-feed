{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return full details for a single CVE id (CVSS, EPSS, KEV status, affected products). Use when you need context on a specific CVE before recommending a patch or explaining risk to a developer.",
 "inputSchema": {
  "properties": {
   "cve_id": {
    "description": "CVE identifier, e.g. \"CVE-2021-44228\"",
    "type": "string"
   }
  },
  "required": [
   "cve_id"
  ],
  "type": "object"
 },
 "name": "get_cve_details",
 "outputSchema": {
  "properties": {
   "activelyExploited": {
    "type": "boolean"
   },
   "affectedProducts": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "authenticationRequired": {
    "type": "boolean"
   },
   "cveId": {
    "type": "string"
   },
   "cvssScore": {
    "type": "number"
   },
   "cvssVector": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "epssPercentile": {
    "type": "number"
   },
   "epssScore": {
    "type": "number"
   },
   "error": {
    "type": "string"
   },
   "found": {
    "description": "False when the CVE id is not in Attestd's database.",
    "type": "boolean"
   },
   "lastCheckedAt": {
    "type": "string"
   },
   "remoteExploitable": {
    "type": "boolean"
   },
   "sourcePublishedAt": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
