{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Prepare a 15-minute review to move the hostname of a running custom application to another running custom application on the same server. The target must not already serve a hostname. Applying moves the route after the target proves healthy and re-probes the hostname before reporting; the source keeps running and can receive the hostname back through another reviewed switch. Preparation queues nothing. Requires unrestricted account credentials and deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "Source application currently serving the hostname.",
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   },
   "target_deployment_id": {
    "pattern": "^dpl_(?:[a-f0-9]{16}|[a-f0-9]{24})$",
    "type": "string"
   }
  },
  "required": [
   "deployment_id",
   "target_deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_prepare_traffic_switch",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "expires_at": {
      "type": "string"
     },
     "health_requirement": {
      "type": "string"
     },
     "may_interrupt_traffic": {
      "type": "boolean"
     },
     "operation": {
      "type": "string"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "rollback": {
      "type": "string"
     },
     "source_deployment_id": {
      "type": "string"
     },
     "source_hostname": {
      "type": "string"
     },
     "source_hostname_removed": {
      "type": "boolean"
     },
     "source_name": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "switch_id": {
      "type": "string"
     },
     "target_deployment_id": {
      "type": "string"
     },
     "target_name": {
      "type": "string"
     },
     "target_state": {
      "type": "string"
     },
     "target_upstream": {
      "type": "string"
     }
    },
    "required": [
     "switch_id",
     "review_digest",
     "expires_at",
     "status",
     "receipt",
     "operation",
     "source_deployment_id",
     "source_name",
     "source_hostname",
     "target_deployment_id",
     "target_name",
     "target_state",
     "target_upstream",
     "may_interrupt_traffic",
     "health_requirement",
     "rollback",
     "source_hostname_removed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Prepare traffic switch"
}
