{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Search workspace files with ripgrep and return matching lines with line numbers. Skips the same files as globFiles. If truncated is true, narrow the search.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"caseSensitive":{"default":true,"type":"boolean"},"fileGlob":{"default":"**/*","maxLength":1000,"type":"string"},"limit":{"default":50,"maximum":100,"minimum":1,"type":"integer"},"literal":{"default":false,"type":"boolean"},"pattern":{"maxLength":1000,"minLength":1,"type":"string"},"workspaceId":{"maxLength":100,"minLength":1,"pattern":"^[a-zA-Z0-9][a-zA-Z0-9._-]*$","type":"string"}},"required":["workspaceId","pattern"],"type":"object"},"name":"grepFiles"}
