{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Evaluation Cost Calculator"
 },
 "description": "Use when a user needs to budget an LLM evaluation run. Given samples/models/trials, returns total cost, per-run cost, and parallel time estimate.",
 "inputSchema": {
  "examples": [
   {
    "samples": 2000
   }
  ],
  "properties": {
   "avg_tokens_in": {
    "description": "Avg input tokens per sample (default 2000)",
    "minimum": 0,
    "type": "number"
   },
   "avg_tokens_out": {
    "description": "Avg output tokens per sample (default 500)",
    "minimum": 0,
    "type": "number"
   },
   "judge_enabled": {
    "description": "Enable LLM-as-judge second pass (default false)",
    "type": "boolean"
   },
   "judge_tokens_in": {
    "description": "Judge input tokens (default 1500)",
    "minimum": 0,
    "type": "number"
   },
   "judge_tokens_out": {
    "description": "Judge output tokens (default 200)",
    "minimum": 0,
    "type": "number"
   },
   "model": {
    "description": "Eval model (default claude-sonnet-4-6)",
    "type": "string"
   },
   "models": {
    "description": "Candidate models (default 1)",
    "minimum": 1,
    "type": "number"
   },
   "provider": {
    "description": "Eval provider (default anthropic)",
    "type": "string"
   },
   "samples": {
    "description": "Number of eval samples",
    "minimum": 1,
    "type": "number"
   },
   "trials_per_sample": {
    "description": "Repeats per sample (default 1)",
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "samples"
  ],
  "type": "object"
 },
 "name": "eval-cost-calculator",
 "title": "Evaluation Cost Calculator"
}
