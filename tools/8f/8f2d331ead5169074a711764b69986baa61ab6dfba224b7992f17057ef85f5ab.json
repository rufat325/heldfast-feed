     "actualLtvPercent": {
      "type": "number"
     },
     "defaultLtvPercent": {
      "type": "number"
     },
     "downPaymentAmount": {
      "type": "integer"
     },
     "interestType": {
      "enum": [
       "reducing-balance"
      ]
     },
     "lenderMaxLoan": {
      "type": "integer"
     },
     "notALoanApproval": {
      "enum": [
       true
      ]
     },
     "unfundedAmount": {
      "type": "integer"
     }
    },
    "required": [
     "defaultLtvPercent",
     "actualLtvPercent",
     "downPaymentAmount",
     "lenderMaxLoan",
     "unfundedAmount",
     "interestType",
     "notALoanApproval"
