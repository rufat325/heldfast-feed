    "description": "string \u2014 the note, up to 4096 bytes.",
    "type": "string"
   },
   "salt": {
    "description": "optional string \u2014 a number that makes this note distinct from an identical one; omitted, we pick.",
    "type": "string"
   }
  },
  "required": [
   "body"
  ],
  "type": "object"
 },
