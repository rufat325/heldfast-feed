{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "\u4e3a\u5df2\u6709\u77ed\u94fe\u8fd4\u56de\u53ef\u626b\u63cf\u7684\u4e8c\u7ef4\u7801\u56fe\u7247\uff0c\u9ed8\u8ba4 PNG 512\u00d7512\uff1b\u9700\u8981\u65f6\u4e5f\u53ef\u8fd4\u56de SVG\u3002\u77e9\u9635\u7f16\u7801\u5e26 ?s=qr \u7684\u8ffd\u8e2a\u77ed\u94fe\uff08ASCII \u4e3b\u673a\u540d\uff09\uff0c\u4e0e GET /v1/links/{id}/qr \u76f8\u540c\u3002\u9700\u8981\u5df2\u6ce8\u518c\u8d26\u6237\uff0c\u4e14\u5fc5\u987b\u662f\u8be5\u94fe\u63a5\u7684\u6240\u6709\u8005\u3002\u4e0d\u65b0\u5efa\u77ed\u94fe\uff0c\u4e5f\u4e0d\u6293\u53d6\u76ee\u6807\u5730\u5740\u3002format \u53ef\u4e3a png \u6216 svg\uff1bPNG \u8fb9\u957f\u4ec5 256\u3001512\u30011024\uff0cSVG \u5ffd\u7565\u8fb9\u957f\u3002\u4e00\u5e76\u8fd4\u56de qr_tracking_url\u3001MIME \u7c7b\u578b\u4e0e\u50cf\u7d20\u8fb9\u957f\u3002 Return a scannable QR image for an existing short link. Default is PNG 512\u00d7512; SVG when format is svg. The matrix encodes the tracking URL with ?s=qr (ASCII host), the same payload as GET /v1/links/{id}/qr. A registered account that owns the link is required. Does not create a link and does not fetch the destination. format is png or svg. PNG size is 256, 512, or 1024. SVG ignores size. Also returns qr_tracking_url, MIME type, and pixel size.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "id": "example"
   },
   {
    "short_url": "https://xn--s7y.xn--3ds443g/example"
   },
   {
    "format": "png",
    "id": "example",
    "size": 512
   }
  ],
  "properties": {
   "format": {
    "description": "Image format. Default png. svg only when requested. SVG ignores size.",
    "enum": [
     "png",
     "svg"
    ],
    "type": "string"
   },
   "id": {
    "description": "Existing short code. Mutually exclusive with short_url.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "short_url": {
    "description": "Existing short URL to tag for QR. Mutually exclusive with id.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "size": {
    "anyOf": [
     {
      "const": 256,
      "type": "number"
     },
     {
      "const": 512,
      "type": "number"
     },
     {
      "const": 1024,
      "type": "number"
     }
    ],
    "description": "PNG square pixels. Default 512. Allowed: 256, 512, or 1024. Ignored when format is svg."
   }
  },
  "type": "object"
 },
 "name": "create_qr",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "image_available": {
      "const": true,
      "type": "boolean"
     },
     "mime_type": {
      "description": "image/png or image/svg+xml.",
      "enum": [
       "image/png",
       "image/svg+xml"
      ],
      "type": "string"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     },
     "pixel_size": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "PNG square pixels. Null for SVG."
     },
     "qr_tracking_url": {
      "description": "ASCII tracking URL encoded in the image, including ?s=qr.",
      "type": "string"
     },
     "request_id": {
      "type": "string"
     },
     "short_url": {
      "type": "string"
     },
     "short_url_ascii": {
      "type": "string"
     },
     "state": {
      "const": "active",
      "type": "string"
     },
     "status_url": {
      "type": "string"
     }
    },
    "required": [
     "ok",
     "request_id",
     "id",
     "state",
     "short_url",
     "short_url_ascii",
     "qr_tracking_url",
     "status_url",
     "mime_type",
     "pixel_size",
     "image_available"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "error": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "image_available": {
      "const": false,
      "type": "boolean"
     },
     "message": {
      "type": "string"
     },
     "ok": {
      "const": false,
      "type": "boolean"
     },
     "request_id": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     },
     "state": {
      "enum": [
       "quarantined",
       "disabled",
       "blocked",
       "expired"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "ok",
     "request_id",
     "message",
     "type",
     "title",
     "code",
     "retryable"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "QR image \u00b7 \u4e8c\u7ef4\u7801\u56fe\u7247\uff08\u77ed.\u5728\u7ebf\uff09"
}
