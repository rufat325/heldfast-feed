{
 "_meta": {
  "openai/outputTemplate": "ui://widget/recapwren-v1.html",
  "openai/toolInvocation/invoked": "Report ready",
  "openai/toolInvocation/invoking": "Crunching the numbers\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://widget/recapwren-v1.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants to write, build or format a weekly, monthly or campaign report for a client or boss (\"weekly client report\", \"status report\", \"monthly marketing report\", \"KPI update\", \"Friday report\"). Pass each metric with its current and previous value (and target, if any); the tool computes changes, % change, target status and an overall status, and returns a formatted report, email-ready text and a printable link (Save as PDF). Do not invent numbers: ask the user for any metric values you do not have.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client": {
    "description": "Client or project name",
    "examples": [
     "Acme Co"
    ],
    "type": "string"
   },
   "issues": {
    "description": "Blockers or risks",
    "items": {
     "type": "string"
    },
    "maxItems": 15,
    "type": "array"
   },
   "metrics": {
    "examples": [
     [
      {
       "current": 86,
       "name": "Leads",
       "previous": 71,
       "target": 90
      }
     ]
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "current": {
       "type": "number"
      },
      "higherIsBetter": {
       "default": true,
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "previous": {
       "type": "number"
      },
      "target": {
       "type": "number"
      },
      "unit": {
       "description": "e.g. \"$\", \"%\", \"visits\", \"leads\"",
       "type": "string"
      }
     },
     "required": [
      "name",
      "current"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "minItems": 1,
    "type": "array"
   },
   "nextSteps": {
    "items": {
     "type": "string"
    },
    "maxItems": 15,
    "type": "array"
   },
   "period": {
    "description": "e.g. \"Week of 6 Oct 2026\" or \"September 2026\"",
    "type": "string"
   },
   "preparedBy": {
    "type": "string"
   },
   "summary": {
    "description": "One or two sentences in the user's words (optional)",
    "type": "string"
   },
   "wins": {
    "items": {
     "type": "string"
    },
    "maxItems": 15,
    "type": "array"
   }
  },
  "required": [
   "client",
   "metrics"
  ],
  "type": "object"
 },
 "name": "build_client_report",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Build a weekly client report"
}
