{
 "description": "Run a trigger definition against an isolated event sequence without mutating live state.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "definition": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "events": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "order": {
    "default": "provided",
    "enum": [
     "provided",
     "event_time"
    ],
    "type": "string"
   },
   "until": {
    "type": "string"
   }
  },
  "required": [
   "definition",
   "events"
  ],
  "type": "object"
 },
 "name": "trigger_simulate"
}
