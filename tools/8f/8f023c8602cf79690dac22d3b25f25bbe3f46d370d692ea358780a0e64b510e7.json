{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One episode's title, show, summary, and full transcript. Scoped to episodes referenced by a published digest. Pass ``digest`` when an episode spans more than one week. Pass ``lang`` (es / zh) for the episode's translated title, summary, and transcript when the translations exist \u2014 ``lang`` in the payload echoes what was actually served ('' = English original).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "digest": {
    "description": "Optional YYYY-MM-DD edition date to disambiguate an episode that spans weeks",
    "type": "string"
   },
   "eid": {
    "description": "Episode id (from list_digest_episodes)",
    "type": "string"
   },
   "lang": {
    "description": "Localized title + summary + transcript (es / zh); omit for English",
    "enum": [
     "es",
     "zh",
     "hi",
     "fr"
    ],
    "type": "string"
   }
  },
  "required": [
   "eid"
  ],
  "type": "object"
 },
 "name": "get_episode",
 "outputSchema": {
  "properties": {
   "chapters": {
    "description": "Chapter list (often empty): [{\"start\": seconds, \"title\": str}]",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "RSS episode description",
    "type": [
     "string",
     "null"
    ]
   },
   "digest_slug": {
    "type": "string"
   },
   "duration_sec": {
    "type": [
     "integer",
     "null"
    ]
   },
   "eid": {
    "type": "string"
   },
   "lang": {
    "description": "The language actually served ('' = English original)",
    "type": "string"
   },
   "published": {
    "type": "string"
   },
   "show": {
    "type": "string"
   },
   "speakers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "summary": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "transcript": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "eid",
   "title",
   "show",
   "published",
   "duration_sec",
   "description",
   "summary",
   "transcript",
   "speakers",
   "digest_slug",
   "url"
  ],
  "type": "object"
 },
 "title": "Read one episode"
}
