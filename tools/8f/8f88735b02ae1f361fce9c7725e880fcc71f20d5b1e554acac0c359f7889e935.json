{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:inbox"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save automatic-reply settings"
 },
 "description": "Preview, then with confirm: true save, an exact patch of the automatic-reply settings. Needs manage:inbox. Read soclo_inbox_settings first and retain expectedVersion (null only when absent), plus a stable UUID clientRequestId. exact_answers replaces the entire approved answer list; preserve every answer outside the intended edit. It never sends an immediate reply. Enabling automatic replies can cause future replies on enabled accounts, requires explicit owner approval and existing AI consent, and does not enroll any other account. After an uncertain save, read soclo_inbox_settings and reconcile before writing again.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "description": "true only after the owner approved the exact text or change. Omit or pass false to get a preview instead: nothing is sent, nothing is saved.",
    "type": "boolean"
   },
   "expectedVersion": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "settings": {
    "additionalProperties": false,
    "properties": {
     "daily_message_cap": {
      "maximum": 50,
      "minimum": 0,
      "type": "integer"
     },
     "enabled": {
      "type": "boolean"
     },
     "exact_answers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "answer": {
         "maxLength": 4000,
         "minLength": 1,
         "type": "string"
        },
        "question": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "question",
        "answer"
       ],
       "type": "object"
      },
      "maxItems": 200,
      "type": "array"
     },
     "handover_complaint": {
      "type": "boolean"
     },
     "handover_human_request": {
      "type": "boolean"
     },
     "handover_money_or_binding": {
      "type": "boolean"
     },
     "handover_unsure": {
      "type": "boolean"
     },
     "instructions": {
      "maxLength": 4000,
      "type": "string"
     },
     "kill_switch": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "settings",
   "expectedVersion",
   "clientRequestId"
  ],
  "type": "object"
 },
 "name": "soclo_inbox_settings_save",
 "title": "Save automatic-reply settings"
}
