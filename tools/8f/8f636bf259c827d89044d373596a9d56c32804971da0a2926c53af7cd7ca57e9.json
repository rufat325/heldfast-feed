{
 "description": "Execute multiple browser actions sequentially in a single MCP call. Eliminates round-trip overhead for humanization sequences (e.g. Bezier mouse paths, typed text with delays). Each action can have an optional delayAfter (ms) to pause between steps. Returns a single result with the outcome of each action.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "description": "Array of actions to execute sequentially.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "description": "Interaction to perform.",
       "enum": [
        "click",
        "dblclick",
        "fill",
        "type",
        "check",
        "uncheck",
        "select",
        "press",
        "scroll",
        "hover",
        "mousemove",
        "back",
        "forward"
       ],
       "type": "string"
      },
      "delayAfter": {
       "description": "Delay in ms to wait after this action completes.",
       "type": "number"
      },
      "key": {
       "description": "Key name for press.",
       "type": "string"
      },
      "scrollAmount": {
       "description": "Pixels to scroll.",
       "type": "integer"
      },
      "scrollDirection": {
       "description": "Scroll direction.",
       "enum": [
        "up",
        "down",
        "left",
        "right"
       ],
       "type": "string"
      },
      "target": {
       "description": "@eN ref or CSS selector.",
       "type": "string"
      },
      "typeDelay": {
       "description": "Delay in ms between keystrokes for type.",
       "type": "number"
      },
      "value": {
       "description": "Text for fill/type, option value for select.",
       "type": "string"
      },
      "x": {
       "description": "X coordinate for mousemove.",
       "type": "number"
      },
      "y": {
       "description": "Y coordinate for mousemove.",
       "type": "number"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID.",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "actions"
  ],
  "type": "object"
 },
 "name": "batch_actions",
 "title": "Batch Actions"
}
