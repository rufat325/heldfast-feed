{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Company Financials"
 },
 "description": "Key financial numbers for a US public company by stock ticker or CIK: revenue, net income, diluted EPS, assets, liabilities, equity and cash (or any XBRL concept you name), latest annual and latest quarterly value with period, form and filing date. Data source: SEC EDGAR XBRL financial data (free public data; not affiliated with or endorsed by the SEC). Price: $0.03 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "metrics": {
    "description": "XBRL concept names (us-gaap). Default: Revenues, NetIncomeLoss, EarningsPerShareDiluted, Assets, Liabilities, StockholdersEquity, CashAndCashEquivalentsAtCarryingValue. Revenues also checks RevenueFromContractWithCustomerExcludingAssessedTax and SalesRevenueNet.",
    "items": {
     "pattern": "^[A-Za-z][A-Za-z0-9]{1,150}$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "ticker_or_cik": {
    "description": "Stock ticker (e.g. \"AAPL\", \"BRK.B\") or the company's numeric SEC CIK (e.g. \"320193\").",
    "maxLength": 12,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9.\\-]+$",
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "company_financials",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "cik": {
    "type": "string"
   },
   "company": {
    "type": [
     "string",
     "null"
    ]
   },
   "metrics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "latest_annual": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "end": {
           "description": "Period end (YYYY-MM-DD).",
           "type": "string"
          },
          "filed": {
           "type": "string"
          },
          "fiscal_period": {
           "description": "\"FY\", \"Q1\", \"Q2\", \"Q3\".",
           "type": [
            "string",
            "null"
           ]
          },
          "fiscal_year": {
           "type": [
            "number",
            "null"
           ]
          },
          "form": {
           "type": "string"
          },
          "start": {
           "description": "Period start (null for point-in-time values like Assets).",
           "type": [
            "string",
            "null"
           ]
          },
          "value": {
           "type": "number"
          }
         },
         "required": [
          "value",
          "start",
          "end",
          "fiscal_year",
          "fiscal_period",
          "form",
          "filed"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Most recent full-year value (10-K/20-F/40-F)."
      },
      "latest_quarter": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "end": {
           "description": "Period end (YYYY-MM-DD).",
           "type": "string"
          },
          "filed": {
           "type": "string"
          },
          "fiscal_period": {
           "description": "\"FY\", \"Q1\", \"Q2\", \"Q3\".",
           "type": [
            "string",
            "null"
           ]
          },
          "fiscal_year": {
           "type": [
            "number",
            "null"
           ]
          },
          "form": {
           "type": "string"
          },
          "start": {
           "description": "Period start (null for point-in-time values like Assets).",
           "type": [
            "string",
            "null"
           ]
          },
          "value": {
           "type": "number"
          }
         },
         "required": [
          "value",
          "start",
          "end",
          "fiscal_year",
          "fiscal_period",
          "form",
          "filed"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Most recent single-quarter value from a 10-Q (balance-sheet items: as of quarter end)."
      },
      "metric": {
       "description": "Metric requested.",
       "type": "string"
      },
      "tag": {
       "description": "XBRL tag the values came from (null if the company never reported it).",
       "type": [
        "string",
        "null"
       ]
      },
      "unit": {
       "description": "e.g. \"USD\" or \"USD/shares\".",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "metric",
      "tag",
      "unit",
      "latest_annual",
      "latest_quarter"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "const": "SEC EDGAR",
    "type": "string"
   }
  },
  "required": [
   "source",
   "company",
   "cik",
   "metrics",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Company Financials"
}
