{
 "description": "As the agent, acknowledge what you were paid for a completed task.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "minimum": 0,
    "type": "number"
   },
   "currency": {
    "maxLength": 16,
    "type": "string"
   },
   "task": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "ronin_received"
}
