{
 "description": "Update one of your listings; set status:'PUBLISHED' to publish.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "longDescriptionMd": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "shortDesc": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "status": {
    "enum": [
     "DRAFT",
     "PUBLISHED",
     "SUSPENDED"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_listing"
}
