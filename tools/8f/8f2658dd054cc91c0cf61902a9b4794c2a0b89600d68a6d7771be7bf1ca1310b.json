     "solar",
     "lunar",
     "pillar"
    ],
    "type": "string"
   },
   "isLeapMonth": {
    "description": "\u519c\u5386\u95f0\u6708\uff0cinputMode=lunar \u65f6\u7528",
    "type": "boolean"
   },
   "isMale": {
    "description": "\u7537=true\uff0c\u5f71\u54cd\u5927\u8fd0\u987a\u9006",
    "type": "boolean"
   },
   "longitude": {
    "description": "\u51fa\u751f\u5730\u7ecf\u5ea6\u3002\u7ed9\u4e86\u5c31\u6309\u771f\u592a\u9633\u65f6\u6821\u6b63",
    "type": "number"
   },
   "minute": {
