    "minimum": 0,
    "type": "integer"
   },
   "month": {
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "pillars": {
    "description": "inputMode=pillar \u65f6\u7528\uff0c\u5e72\u652f\u5404\u4e24\u5b57",
