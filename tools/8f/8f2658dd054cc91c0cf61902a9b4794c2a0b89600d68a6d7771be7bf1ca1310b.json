      "type": "string"
     },
     "hour": {
      "type": "string"
     },
     "month": {
      "type": "string"
     },
     "year": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "timeZone": {
    "description": "IANA \u65f6\u533a\uff0c\u9ed8\u8ba4 Asia/Shanghai",
    "type": "string"
   },
   "year": {
    "type": "integer"
   },
   "zishiRule": {
    "description": "\u665a\u5b50\u65f6\u65e5\u67f1\u5f52\u5c5e\uff0c\u9ed8\u8ba4 sameDay",
    "enum": [
     "sameDay",
     "nextDay",
     "legacyCompat"
    ],
    "type": "string"
   }
