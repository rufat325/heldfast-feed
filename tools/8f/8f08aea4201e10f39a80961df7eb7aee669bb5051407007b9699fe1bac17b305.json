 "description": "Earthquakes worldwide from the last hour to 30 days, filtered by minimum magnitude and optionally within a radius of a place \u2014 with depth, tsunami flag and USGS alert level. USGS real-time earthquake feeds (updated every minute). Price: free. Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "How many quakes to return, largest first. Range 1-100. Default 20.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_magnitude": {
    "default": 4.5,
    "description": "Only quakes at or above this magnitude. Range 0-9. Default 4.5.",
    "maximum": 9,
    "minimum": 0,
    "type": "number"
   },
   "near": {
    "description": "place or lat,lon (optional)",
    "type": "string"
   },
   "period": {
    "default": "day",
    "description": "Look-back window. One of \"hour\", \"day\", \"week\", \"month\". Default \"day\".",
    "enum": [
     "hour",
     "day",
     "week",
     "month"
    ],
    "type": "string"
   },
   "radius_km": {
    "default": 1000,
    "description": "Search radius around the given place (only when a place is given). Range 10-5000. Default 1000.",
    "maximum": 5000,
    "minimum": 10,
    "type": "number"
   }
  },
  "type": "object"
 },
