{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get project settings"
 },
 "description": "Use this when someone asks about one project's languages, default voice, narration speed or pronunciation rules. Returns its name, domain, default and configured locales, voice settings and up to 50 pronunciation rules, looked up by project id or vanity id. Not for finding languages or devices that lack videos.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectId": {
    "description": "Project id or its stable public vanity id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "get_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultVoice": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "domain": {
        "anyOf": [
         {
          "maxLength": 253,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locales": {
        "items": {
         "maxLength": 32,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "pronunciationRuleCount": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "pronunciationRuleCountIsLowerBound": {
        "type": "boolean"
       },
       "pronunciationRules": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "alphabet": {
           "enum": [
            "ipa",
            "cmu"
           ],
           "type": "string"
          },
          "phonemes": {
           "anyOf": [
            {
             "maxLength": 500,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "word": {
           "anyOf": [
            {
             "maxLength": 120,
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "word",
          "phonemes",
          "alphabet"
         ],
         "type": "object"
        },
        "maxItems": 50,
        "type": "array"
       },
       "pronunciationRulesTruncated": {
        "type": "boolean"
       },
       "similarityBoost": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "speed": {
        "anyOf": [
         {
          "maximum": 10,
          "minimum": 0.1,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "stability": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "style": {
        "anyOf": [
         {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "vanityId": {
        "anyOf": [
         {
          "maxLength": 63,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "vanityId",
       "domain",
       "defaultLocale",
       "locales",
       "defaultVoice",
       "stability",
       "similarityBoost",
       "style",
       "speed",
       "creationTime",
       "lastEditTime",
       "pronunciationRules",
       "pronunciationRuleCount",
       "pronunciationRuleCountIsLowerBound",
       "pronunciationRulesTruncated"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Project settings; null when not found. Organization ids and pronunciation-dictionary ids are never returned."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Get project settings"
}
