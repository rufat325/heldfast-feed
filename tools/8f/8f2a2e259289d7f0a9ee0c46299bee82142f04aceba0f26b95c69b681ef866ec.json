{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create project cost snapshot"
 },
 "description": "Record a cost snapshot for a project at a point in time. Requires project_cost_snapshots:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actual_cost": {
    "description": "Actual cost to date (required)",
    "minimum": 0,
    "type": "number"
   },
   "forecasted_cost": {
    "description": "Forecasted total cost",
    "minimum": 0,
    "type": "number"
   },
   "percent_complete": {
    "description": "Completion percentage (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "snapshot_date": {
    "description": "Snapshot date (ISO 8601, required)",
    "type": "string"
   },
   "total_budget": {
    "description": "Total budget amount (required)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "project_id",
   "snapshot_date",
   "total_budget",
   "actual_cost"
  ],
  "type": "object"
 },
 "name": "create_project_cost_snapshot",
 "title": "Create project cost snapshot"
}
