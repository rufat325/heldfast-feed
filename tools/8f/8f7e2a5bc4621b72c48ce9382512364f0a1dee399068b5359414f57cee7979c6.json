{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Active Hyperliquid markets ranked in one call: mark price, 24h change, 24h volume, open interest and current hourly funding. Sort by abs_funding for the most extreme funding, abs_change_24h for the biggest movers, or volume (default). Use min_volume_usd to skip illiquid markets. Returns the top 25 unless limit is set.",
 "inputSchema": {
  "properties": {
   "issuer": {
    "description": "HIP-3 builder code (e.g. 'xyz'). Omit to include every issuer.",
    "type": "string"
   },
   "limit": {
    "description": "Rows to return (1-200, default 25)",
    "type": "number"
   },
   "market_class": {
    "description": "Filter to one class",
    "enum": [
     "perp",
     "spot",
     "prediction",
     "option"
    ],
    "type": "string"
   },
   "min_volume_usd": {
    "description": "Skip markets with less 24h volume than this (USD)",
    "type": "number"
   },
   "order": {
    "description": "desc (default) or asc",
    "enum": [
     "desc",
     "asc"
    ],
    "type": "string"
   },
   "sort_by": {
    "description": "Ranking key (default volume). funding_rate is hourly; positive means longs pay shorts.",
    "enum": [
     "volume",
     "open_interest",
     "funding",
     "abs_funding",
     "change_24h",
     "abs_change_24h"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_markets_snapshot",
 "outputSchema": {
  "description": "Markets ranked by the requested key",
  "properties": {
   "data": {
    "description": "Ranked markets",
    "items": {
     "description": "One market",
     "properties": {
      "change_24h_pct": {
       "description": "24h change as a fraction, e.g. -0.031 for -3.1%"
      },
      "display_symbol": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "funding_rate": {
       "description": "Current hourly funding rate"
      },
      "issuer": {
       "description": "HIP-3 builder code (\"\" for native markets)"
      },
      "mark_24h_ago": {
       "description": "Mark price 24h ago"
      },
      "mark_price": {
       "description": "Current mark price"
      },
      "mark_ts_ms": {
       "description": "Mark sample time, Unix milliseconds"
      },
      "market_class": {
       "description": "perp, spot, prediction or option"
      },
      "market_id": {
       "description": "Stable market id"
      },
      "open_interest_base": {
       "description": "Open interest in base units"
      },
      "open_interest_usd": {
       "description": "Open interest in USD"
      },
      "volume_24h_usd": {
       "description": "24h volume in USD"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "matched": {
    "description": "Markets past the volume floor"
   },
   "order": {
    "description": "desc or asc"
   },
   "returned": {
    "description": "Rows in data"
   },
   "sort_by": {
    "description": "Ranking key used"
   },
   "total_markets": {
    "description": "Active markets before filtering"
   }
  },
  "type": "object"
 }
}
