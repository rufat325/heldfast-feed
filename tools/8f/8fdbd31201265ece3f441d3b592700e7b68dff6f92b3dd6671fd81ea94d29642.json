           "type": "string"
          }
         },
         "required": [
          "type",
          "ticker"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "forms": {
           "items": {
            "maxLength": 20,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 25,
           "type": "array"
          },
          "ticker": {
           "$ref": "#/properties/rules/items/properties/trigger_params/anyOf/3/properties/ticker"
          },
          "type": {
           "const": "filing_event",
           "type": "string"
          }
         },
         "required": [
          "type"
         ],
         "type": "object"
