      },
      "trigger_type": {
       "enum": [
        "alert_fired",
        "schedule_tick",
        "inbox_item",
        "price_threshold",
        "filing_event",
        "manual",
        "scheduled_task_wake"
       ],
       "type": "string"
      },
      "trigger_wiring_status": {
       "description": "'live' means a real event source calls evaluateRulesForEvent() for this trigger_type today \u2014 this rule CAN fire. 'not_yet_wired' means the trigger_type is accepted and persisted for forward-compatibility but no code path dispatches it yet \u2014 this rule will never fire until Valuein wires that trigger source. Check this before relying on a rule; use alert_fired/inbox_item/scheduled_task_wake/schedule_tick for a rule that fires today.",
       "enum": [
        "live",
        "not_yet_wired"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "trigger_type",
      "trigger_params",
      "condition_expr",
