               "format": "uri",
               "maxLength": 512,
               "type": "string"
              },
              "type": {
               "const": "slack",
               "type": "string"
              }
             },
             "required": [
              "type",
              "target"
             ],
             "type": "object"
            },
            {
             "additionalProperties": false,
             "properties": {
              "target": {
               "description": "A standing_agent.id identifying which standing agent team to run when this signal fires. NOT a URL \u2014 no outbound-URL validation applies to this field.",
               "maxLength": 64,
               "minLength": 1,
               "type": "string"
              },
              "type": {
               "const": "agent_run",
               "type": "string"
              }
             },
             "required": [
              "type",
              "target"
             ],
             "type": "object"
            }
           ],
           "description": "Delivery channel \u2014 same discriminated union create_signal accepts (email/webhook/dashboard/slack/agent_run)."
