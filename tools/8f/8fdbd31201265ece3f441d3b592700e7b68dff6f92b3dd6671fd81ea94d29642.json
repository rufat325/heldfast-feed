        {
         "additionalProperties": false,
         "properties": {
          "task_id": {
           "description": "Scope to one specific scheduled_task id. Omit to react to ANY of the owner's tasks waking.",
           "maxLength": 64,
           "minLength": 1,
           "type": "string"
          },
          "type": {
           "const": "scheduled_task_wake",
           "type": "string"
          }
         },
         "required": [
          "type"
