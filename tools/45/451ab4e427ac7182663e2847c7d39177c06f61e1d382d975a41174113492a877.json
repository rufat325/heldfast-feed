{
 "_meta": {
  "openai/outputTemplate": "ui://doctofam/schedule-summary-v1.html",
  "openai/toolInvocation/invoked": "DoctoFam schedule summary ready.",
  "openai/toolInvocation/invoking": "Counting DoctoFam schedule\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "doctofam:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://doctofam/schedule-summary-v1.html"
  },
  "ui/resourceUri": "ui://doctofam/schedule-summary-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Count patient visits per day"
 },
 "description": "Use this when someone asks how busy their medical practice is or how many patient visits are booked each day. Returns appointment counts per UTC day for one practice, whatever their status, for the next 7 days by default and at most 31 days; counting stops at 100. Not for counting cancellations or seeing which patients are booked.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Practice id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "endTime": {
    "$ref": "#/properties/startTime",
    "description": "End of the range as an ISO 8601 date-time, after startTime and at most 31 days later; defaults to 7 days after the start"
   },
   "startTime": {
    "description": "Start of the range as an ISO 8601 date-time; defaults to now",
    "maxLength": 32,
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "get_clinic_schedule_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appointmentCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "appointmentCountIsLowerBound": {
    "description": "True when more than 100 appointments fall in the range",
    "type": "boolean"
   },
   "days": {
    "description": "One row per UTC day that has appointments, canceled ones included. Aggregate counts only: appointment identifiers and times, patient information, services, diagnoses and notes are never returned.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "appointmentCount": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "day": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      }
     },
     "required": [
      "day",
      "appointmentCount"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "range": {
    "additionalProperties": false,
    "properties": {
     "endTime": {
      "$ref": "#/properties/range/properties/startTime"
     },
     "startTime": {
      "maxLength": 32,
      "type": "string"
     }
    },
    "required": [
     "startTime",
     "endTime"
    ],
    "type": "object"
   }
  },
  "required": [
   "range",
   "appointmentCount",
   "appointmentCountIsLowerBound",
   "days"
  ],
  "type": "object"
 },
 "title": "Count patient visits per day"
}
