{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Count how many tickets use each Fibonacci score (1-21), per dimension (benefit, penalty, estimate, risk).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "report_distribution",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "counts": {
       "additionalProperties": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "description": "Tickets per score",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "dimension": {
       "type": "string"
      }
     },
     "required": [
      "dimension",
      "counts"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
