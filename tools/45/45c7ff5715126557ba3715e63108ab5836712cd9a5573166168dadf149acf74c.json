{
 "description": "Read aggregate reached steps, drop-off, elapsed time, sources and unlinked coverage for full UTC days. Observations do not prove backend business outcomes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2019-09/schema#",
  "additionalProperties": false,
  "properties": {
   "bearerToken": {
    "type": "string"
   },
   "flowKey": {
    "pattern": "^[a-z][a-z0-9_.-]{0,63}$",
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   },
   "window": {
    "enum": [
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   }
  },
  "required": [
   "bearerToken",
   "projectId",
   "flowKey"
  ],
  "type": "object"
 },
 "name": "get_analytics_flow_report"
}
