{
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseUrl": {
    "description": "Base URL (e.g., http://localhost:3000)",
    "type": "string"
   },
   "dataSets": {
    "description": "Data sets for parameterized testing. The scenario runs once per data set with {{variable}} substitution.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "description": "Label for this data set (e.g. \"admin user\")",
       "type": "string"
      },
      "variables": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Variable substitutions for {{variable}} placeholders in steps",
       "type": "object"
      }
     },
     "required": [
      "label",
      "variables"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Scenario name",
    "type": "string"
   },
   "steps": {
    "description": "Array of test steps to execute. Steps can use {{variable}} placeholders when dataSets is provided.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "navigate",
        "click",
        "type",
        "select",
        "hover",
        "scroll",
        "press",
        "waitForSelector",
        "waitForText",
        "waitForNavigation",
        "waitForNetworkIdle",
        "assert",
        "screenshot",
        "evaluate",
        "sleep",
        "login",
        "fill_form",
        "wait_stable"
       ],
       "type": "string"
      },
      "attribute": {
       "type": "string"
      },
      "expected": {
       "type": [
        "string",
        "number"
       ]
      },
      "fields": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Form fields map for fill_form action: selector-or-label to value",
       "type": "object"
      },
      "key": {
       "type": "string"
      },
      "ms": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "password": {
       "description": "Password for login action",
       "type": "string"
      },
      "pixels": {
       "type": "number"
      },
      "query": {
       "description": "Natural language element description for smart resolution (e.g. \"the login button\"). Falls back to this when selector fails.",
       "type": "string"
      },
      "screenshotName": {
       "type": "string"
      },
      "script": {
       "type": "string"
      },
      "selector": {
       "type": "string"
      },
      "timeout": {
       "type": "number"
      },
      "type": {
       "enum": [
        "exists",
        "notExists",
        "textContains",
        "textEquals",
        "hasAttribute",
        "hasClass",
        "isVisible",
        "isEnabled",
        "urlContains",
        "urlEquals",
        "countEquals",
        "consoleNoErrors"
       ],
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "value": {
       "type": "string"
      },
      "waitForSelector": {
       "description": "Element to wait for after login action completes",
       "type": "string"
      }
     },
     "required": [
      "name",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "steps"
  ],
  "type": "object"
 },
 "name": "test_scenario_run"
}
