{
 "_meta": {
  "threadlinqs/catalog_note": "Served from the public catalog, not your authenticated tool list. Check THREADLINQS_API_KEY.",
  "threadlinqs/catalog_source": "public_catalog"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "CVE Intelligence"
 },
 "description": "Composite CVE dossier in one call: the enriched CVE detail, the threats that reference it (authoritative join \u2014 cve.threat_ids is reconciled to it), the attributed actors and MITRE techniques behind those threats, weaponization velocity for THIS CVE with its rank against the corpus, CWE-sibling related CVEs, and detections that name it.",
 "inputSchema": {
  "properties": {
   "cve_id": {
    "description": "CVE identifier (e.g. CVE-2024-3400)",
    "type": "string"
   }
  },
  "required": [
   "cve_id"
  ],
  "type": "object"
 },
 "name": "get_cve_intelligence",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "actors": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "actor": {
       "type": "string"
      },
      "threat_count": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "cve": {
    "additionalProperties": true,
    "properties": {
     "cve_id": {
      "type": "string"
     },
     "threat_ids": {
      "items": {
       "description": "Reconciled from threats.cve_list \u2014 the authoritative join. Pass to get_threat.",
       "type": "string"
      },
      "type": "array"
     },
     "threat_ids_note": {
      "description": "Present only when the derived cve_details reverse index disagreed.",
      "type": "string"
     },
     "threat_ids_source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "mitre": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "tactic": {
       "type": "string"
      },
      "technique": {
       "type": "string"
      },
      "technique_id": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "related_cves": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "cve_id": {
       "type": "string"
      },
      "is_kev": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "related_detections": {
    "type": [
     "object",
     "null"
    ]
   },
   "threats": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "actor": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "velocity_data": {
    "additionalProperties": true,
    "properties": {
     "cohort_fastest": {
      "items": {},
      "type": "array"
     },
     "corpus": {
      "additionalProperties": true,
      "properties": {
       "avg_velocity": {
        "type": "number"
       },
       "total": {
        "type": "integer"
       }
      },
      "type": "object"
     },
     "cve": {
      "description": "The velocity row for THIS CVE (velocity_days = publication \u2192 first tracked threat), or null when it has no tracked linkage.",
      "type": [
       "object",
       "null"
      ]
     },
     "note": {
      "type": "string"
     },
     "rank": {
      "description": "{faster_than_pct, position, of} \u2014 where this CVE sits in the corpus velocity distribution.",
      "type": [
       "object",
       "null"
      ]
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "CVE Intelligence"
}
