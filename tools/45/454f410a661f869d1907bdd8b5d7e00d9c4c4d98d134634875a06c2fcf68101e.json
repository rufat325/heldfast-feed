{
 "_meta": {
  "lovie/risk": "destructive",
  "openai/toolInvocation/invoked": "Removed",
  "openai/toolInvocation/invoking": "Removing\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false
 },
 "description": "Begins the paid transfer at the registrar using the EPP/auth code the user obtained from their current provider. The code is used once and never stored. Transfers take days; track with the transfer-status tool.",
 "inputSchema": {
  "properties": {
   "authCode": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "domain": {
    "maxLength": 253,
    "minLength": 1,
    "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+\\.?)$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "formation_start_domain_transfer",
 "outputSchema": {
  "properties": {
   "status": {
    "enum": [
     "DOMAIN_TRANSFER_STATUS_UNSPECIFIED",
     "DOMAIN_TRANSFER_STATUS_AWAITING_PAYMENT",
     "DOMAIN_TRANSFER_STATUS_AWAITING_AUTH_CODE",
     "DOMAIN_TRANSFER_STATUS_IN_PROGRESS",
     "DOMAIN_TRANSFER_STATUS_COMPLETED",
     "DOMAIN_TRANSFER_STATUS_FAILED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Start Domain Transfer"
}
