{
 "description": "Generate a standalone barcode (SVG text or PNG image). Supported types include code128, code39, ean13, upca, upce, itf14, msi, qrcode, datamatrix, pdf417.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Data to encode",
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "default": "svg",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "type": {
    "description": "Barcode type, e.g. code128",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "type",
   "data"
  ],
  "type": "object"
 },
 "name": "barcode_generate"
}
