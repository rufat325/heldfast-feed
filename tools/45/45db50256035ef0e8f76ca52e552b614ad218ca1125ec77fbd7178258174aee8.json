{
 "description": "How published posts performed: each post's channels with their latest impressions, likes, comments, shares and saves, plus totals. Defaults to the last 30 days, newest first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channel_id": {
    "description": "Only this channel.",
    "type": "string"
   },
   "from": {
    "description": "First day, YYYY-MM-DD.",
    "type": "string"
   },
   "limit": {
    "description": "1 to 100 (default 20).",
    "type": "number"
   },
   "order": {
    "enum": [
     "desc",
     "asc"
    ],
    "type": "string"
   },
   "platform": {
    "description": "Only this network, e.g. x or linkedin.",
    "type": "string"
   },
   "post_id": {
    "description": "Just this post.",
    "type": "string"
   },
   "sort": {
    "enum": [
     "date",
     "impressions",
     "likes",
     "comments",
     "shares",
     "saves",
     "engagement"
    ],
    "type": "string"
   },
   "to": {
    "description": "Last day, YYYY-MM-DD (default today).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_analytics"
}
