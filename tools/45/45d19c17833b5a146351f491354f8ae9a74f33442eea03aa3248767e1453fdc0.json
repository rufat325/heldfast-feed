{
 "description": "Get historical price data for a forex pair",
 "inputSchema": {
  "properties": {
   "frame": {
    "description": "Time frame (e.g., '1d', '1wk', '1mo')",
    "type": "string"
   },
   "from": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "ticker": {
    "description": "Forex ticker",
    "type": "string"
   },
   "to": {
    "description": "End date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "forex_prices"
}
