     },
     "challenge": {
      "type": "string"
     },
     "challenge_label": {
      "type": "string"
     },
     "challenge_preview": {
      "type": "string"
     },
     "challenger_name": {
      "type": "string"
     },
     "completed_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "created_at": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "opponent_name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "participant_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "participants": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "raw_status": {
      "type": "string"
     },
     "slots_remaining": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "spend_cap": {
      "minimum": 0,
      "type": "number"
     },
     "spend_cap_usd": {
      "minimum": 0,
