{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Move Inbox Message"
 },
 "description": "Move one inbox message to a system folder role or custom folder ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from_folder_id": {
    "description": "Current folder ID, if already known.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Mailbox ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "message_id": {
    "description": "JMAP inbox message ID.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "target_folder_id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "target_role": {
    "enum": [
     "inbox",
     "archive",
     "junk",
     "trash"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "message_id"
  ],
  "type": "object"
 },
 "name": "shipmail_move_inbox_message",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "inbox_message_action": {
    "properties": {
     "address": {
      "type": "string"
     },
     "mailbox_id": {
      "type": "string"
     },
     "message_id": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "object",
     "mailbox_id",
     "address",
     "message_id",
     "ok"
    ],
    "type": "object"
   }
  },
  "required": [
   "inbox_message_action"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Move Inbox Message"
}
