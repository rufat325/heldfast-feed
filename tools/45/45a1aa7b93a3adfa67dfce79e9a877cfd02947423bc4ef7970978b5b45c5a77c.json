{
 "description": "Recall prior Vigile security memory context for an entity, pattern, or incident. Returns compact context, evidence chunks, and source references with provenance status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max_chunks": {
    "description": "Maximum evidence chunks (default: 8)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Recall query, e.g. 'previous incident for inc_123'",
    "maxLength": 400,
    "minLength": 2,
    "type": "string"
   },
   "retrieval_mode": {
    "description": "Experimental retrieval mode",
    "enum": [
     "default",
     "ontology_v1"
    ],
    "type": "string"
   },
   "risk_level": {
    "description": "Set to high for high-risk actions",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "scope": {
    "description": "Optional retrieval scope filters",
    "items": {
     "maxLength": 30,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "vigile_recall"
}
