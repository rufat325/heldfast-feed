{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Generate code"
 },
 "description": "Emit a runnable PyTorch module plus the design document. Without out_dir the file contents come back in the result; with out_dir they are written to disk and only a manifest comes back.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "class_name": {
    "description": "Class name for the top-level module.",
    "type": "string"
   },
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   },
   "include_smoke_test": {
    "description": "Emit a __main__ block that checks the size.",
    "type": "boolean"
   },
   "out_dir": {
    "description": "Directory to write into. Omit to get the contents inline.",
    "type": "string"
   }
  },
  "required": [
   "design_id"
  ],
  "type": "object"
 },
 "name": "tensorcad_generate_code",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "design_id": {
    "type": "string"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bytes": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "contents": {
       "description": "Present only when out_dir was not given.",
       "type": "string"
      },
      "lines": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "path": {
       "type": "string"
      },
      "written_to": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "bytes",
      "lines"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "out_dir": {
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "wrote": {
    "type": "boolean"
   }
  },
  "required": [
   "design_id",
   "revision",
   "wrote",
   "files",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Generate code"
}
