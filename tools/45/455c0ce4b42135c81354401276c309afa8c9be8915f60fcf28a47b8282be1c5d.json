{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Headcount plan"
 },
 "description": "Estimate how many invited guests will attend (adults vs children) and the food, drink, cake, favor and plate quantities to buy, with standard buffers. Use when sizing the shopping list from an invite count. Do NOT use for spending (use party_budget) or a dated to-do plan (use party_timeline).",
 "inputSchema": {
  "properties": {
   "children_pct": {
    "description": "Percent of attendees who are children, 0-100, default 0",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "expected_decline_pct": {
    "description": "Percent of invitees expected to decline, 0-100, default 15",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "invited": {
    "description": "People invited, whole number 1-1000, e.g. 40",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "invited"
  ],
  "type": "object"
 },
 "name": "headcount_plan",
 "outputSchema": {
  "properties": {
   "adults": {
    "description": "Expected adult attendees",
    "type": "integer"
   },
   "children": {
    "description": "Expected child attendees",
    "type": "integer"
   },
   "expected_attendees": {
    "description": "Expected attendance after declines (rounded up)",
    "type": "integer"
   },
   "invited": {
    "description": "Number of people invited",
    "type": "integer"
   },
   "note": {
    "description": "Plain-language explanation of the estimate and buffers",
    "type": "string"
   },
   "quantities": {
    "description": "Shopping quantities including buffers",
    "properties": {
     "cake_slices": {
      "description": "Cake slices (20% extra)",
      "type": "integer"
     },
     "drinks": {
      "description": "Drinks (2.5 per adult, 1.5 per child)",
      "type": "integer"
     },
     "favors": {
      "description": "Party favors (10% extra)",
      "type": "integer"
     },
     "mains_portions": {
      "description": "Main-course portions (15% extra per adult, 0.75 per child)",
      "type": "integer"
     },
     "plates": {
      "description": "Plates (25% extra)",
      "type": "integer"
     }
    },
    "required": [
     "mains_portions",
     "drinks",
     "cake_slices",
     "favors",
     "plates"
    ],
    "type": "object"
   }
  },
  "required": [
   "invited",
   "expected_attendees",
   "adults",
   "children",
   "quantities",
   "note"
  ],
  "type": "object"
 },
 "title": "Headcount plan"
}
