    "type": "string"
   },
   "servers": {
    "items": {
     "properties": {
      "avg_latency_ms": {
       "type": "number"
      },
      "category": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "success_rate": {
       "type": "number"
      },
      "total_interactions": {
       "type": "integer"
      },
      "tracked_since": {
       "type": "string"
      },
      "trust_score": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "total_results": {
    "type": "integer"
   }
  },
  "type": "object"
 }
}
