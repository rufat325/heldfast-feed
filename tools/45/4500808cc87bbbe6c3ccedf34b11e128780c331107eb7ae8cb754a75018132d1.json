{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"Search the literature"},"description":"A live keyword search of OpenAlex (CC0 metadata), not of the citation graph snapshot. It matches titles, abstracts and full text where OpenAlex has it, ranked by relevance. Use it to find seed papers when you have a topic but no DOIs yet. Keyword matches miss related work that uses different words, which the citation graph finds. It is not a systematic search. Returns OpenAlex ID, DOI, title, year, venue, global cited_by_count, type, is_retracted and has_abstract; page with next_cursor. limit is at most 50. Rows carry no abstracts or authors.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"cursor":{"description":"next_cursor from the previous page.","minLength":1,"type":"string"},"limit":{"default":10,"maximum":50,"minimum":1,"type":"integer"},"open_access":{"description":"true keeps open-access papers.","type":"boolean"},"query":{"description":"Keywords, a title or a phrase.","maxLength":1000,"minLength":1,"type":"string"},"year_from":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"year_to":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"}},"required":["query"],"type":"object"},"name":"search_literature","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"diagnostics":{"additionalProperties":false,"properties":{"advisories":{"items":{"type":"string"},"type":"array"},"unresolved_seeds":{"items":{"additionalProperties":false,"properties":{"input":{"type":"string"},"reason":{"type":"string"}},"required":["input","reason"],"type":"object"},"type":"array"}},"required":["advisories"],"type":"object"},"next_cursor":{"type":["string","null"]},"next_step":{"type":"string"},"rows":{"items":{"additionalProperties":false,"properties":{"cited_by_count":{"type":["number","null"]},"doi":{"type":["string","null"]},"has_abstract":{"type":"boolean"},"inciteful_url":{"type":"string"},"is_retracted":{"type":["boolean","null"]},"openalex_id":{"type":"string"},"title":{"type":["string","null"]},"type":{"type":["string","null"]},"venue":{"type":["string","null"]},"year":{"type":["number","null"]}},"required":["openalex_id","doi","title","year","venue","cited_by_count","type","is_retracted","has_abstract","inciteful_url"],"type":"object"},"type":"array"},"truncated":{"type":"boolean"}},"required":["rows","next_cursor","next_step","truncated"],"type":"object"},"title":"Search the literature"}
