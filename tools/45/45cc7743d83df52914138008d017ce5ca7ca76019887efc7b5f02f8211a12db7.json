{
 "description": "Create a Midjourney task on RunAPI (image to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callback_url": {
    "type": "string"
   },
   "enable_loop": {
    "type": "boolean"
   },
   "last_frame_image_url": {
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "midjourney-image-to-video"
    ],
    "type": "string"
   },
   "output_resolution": {
    "enum": [
     "480p"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "source_image_url": {
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "source_image_url"
  ],
  "type": "object"
 },
 "name": "image_to_video"
}
