 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Import essays from files"
 },
 "description": "Splits teacher-supplied PDFs or Word stacks into one essay per student, including AP Classroom 'FRQ Response PDFs, By Student Page Break' exports. Photos support one essay per image and are read by Fiveable. Accepts up to three ChatGPT attached uploads of 25 MB each, or up to three base64 files totaling about 3 MB. Returns counts and warnings only. Long PDFs can take up to a minute.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "files": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "dataBase64": {
       "maxLength": 4200000,
       "minLength": 1,
       "type": "string"
      },
      "fileName": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "mediaType": {
       "description": "e.g. application/pdf, image/jpeg.",
       "maxLength": 120,
       "type": "string"
      }
     },
     "required": [
      "fileName",
      "mediaType",
      "dataBase64"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "type": "array"
   },
   "sessionId": {
    "description": "Grading session id from list_grading_sessions or create_grading_session.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "uploads": {
    "default": [],
    "description": "Files the teacher attached in ChatGPT, passed by reference.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "download_url": {
       "maxLength": 4000,
       "minLength": 1,
       "type": "string"
      },
      "file_id": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "file_name": {
       "maxLength": 200,
       "type": "string"
      },
      "mime_type": {
       "maxLength": 120,
       "type": "string"
      }
     },
     "required": [
      "download_url",
      "file_id"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "type": "array"
   }
  },
  "required": [
   "sessionId",
   "files",
   "uploads"
  ],
  "type": "object"
 },
 "name": "import_essays_from_files",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "grading:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Import essays from files"
}
