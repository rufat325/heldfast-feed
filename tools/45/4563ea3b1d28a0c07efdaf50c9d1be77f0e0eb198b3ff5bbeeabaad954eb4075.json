{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"List my tracked applications"},"description":"Requires techjobs.vn sign-in. Lists the jobs in the signed-in user's Apply Tracker on techjobs.vn (saved, applied, interviewing, offer\u2026), most recently updated first, optionally only one status. Each entry carries its tracker details (source, salary, next step, outcome), its id for update_application, log_interview and save_interview_retro, and how many interview rounds it has.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"status":{"description":"Only entries in this Apply Tracker status, one of: wishlist, clicked, applied, screening, interviewing, offer, rejected, withdrawn, accepted.","enum":["wishlist","clicked","applied","screening","interviewing","offer","rejected","withdrawn","accepted"],"type":"string"}},"type":"object"},"name":"list_applications","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"applications":{"items":{"additionalProperties":false,"properties":{"applied_at":{"type":["string","null"]},"closed_at":{"description":"When the process ended (rejected, withdrawn or accepted); null while open.","type":["string","null"]},"company":{"type":"string"},"company_slug":{"type":"string"},"cover_letter":{"type":["boolean","null"]},"cv_variant_id":{"type":["string","null"]},"excitement":{"type":["number","null"]},"id":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"interview_count":{"description":"Interview rounds logged for this application.","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"job_title":{"type":"string"},"job_url":{"description":"techjobs.vn job page, or the apply link for a job added by hand.","type":["string","null"]},"location":{"type":["string","null"]},"needs_retro_count":{"description":"Rounds marked done that have no lessons-learned entry yet (see save_interview_retro).","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"next_action":{"type":["string","null"]},"next_action_at":{"type":["string","null"]},"next_interview_at":{"description":"Time of the next scheduled round, if any.","type":["string","null"]},"note":{"description":"The user's own note.","type":["string","null"]},"outcome_note":{"type":["string","null"]},"outcome_reason":{"anyOf":[{"enum":["skills_gap","no_response","comp_mismatch","culture_fit","position_closed","failed_assessment","better_offer","my_decision","other"],"type":"string"},{"type":"null"}]},"recruiter_name":{"type":["string","null"]},"salary_currency":{"anyOf":[{"enum":["VND","USD"],"type":"string"},{"type":"null"}]},"salary_max":{"type":["number","null"]},"salary_min":{"type":["number","null"]},"salary_period":{"anyOf":[{"enum":["month","year"],"type":"string"},{"type":"null"}]},"source_channel":{"anyOf":[{"enum":["techjobs","linkedin","itviec","topcv","vietnamworks","company_site","referral","recruiter_outreach","other"],"type":"string"},{"type":"null"}]},"status":{"enum":["wishlist","clicked","applied","screening","interviewing","offer","rejected","withdrawn","accepted"],"type":"string"},"status_label":{"description":"The status as techjobs.vn shows it (Vietnamese).","type":"string"},"status_updated_at":{"type":"string"},"work_mode":{"anyOf":[{"enum":["onsite","hybrid","remote"],"type":"string"},{"type":"null"}]}},"required":["id","job_title","company","company_slug","status","status_label","applied_at","status_updated_at","note","job_url","source_channel","cv_variant_id","cover_letter","recruiter_name","location","work_mode","salary_min","salary_max","salary_currency","salary_period","excitement","next_action","next_action_at","outcome_reason","outcome_note","closed_at","interview_count","next_interview_at","needs_retro_count"],"type":"object"},"type":"array"},"total":{"maximum":9007199254740991,"minimum":-9007199254740991,"ty