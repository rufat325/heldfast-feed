{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Edit a launch"},"description":"Use this when the user asks to change how a launch shows on the board. Changes what the board shows of a launch: its name, tagline, category, and whether dollar amounts are hidden (rank and growth still show). Fields left out stay as they are. The address (slug) never changes.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"category":{"enum":["AI","Business","Developer tools","Design","Education","Entertainment","Finance","Food and drink","Health and fitness","Lifestyle","Marketing","Productivity","Sales","Social","Travel","Utilities","Other"],"type":"string"},"hide_amounts":{"type":"boolean"},"launch_id":{"description":"From list_launches.","format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"name":{"maxLength":80,"minLength":1,"type":"string"},"tagline":{"maxLength":80,"minLength":1,"type":"string"}},"required":["launch_id"],"type":"object"},"name":"edit_launch","title":"Edit a launch"}
