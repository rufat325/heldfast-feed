{
 "description": "Get sales report (completed + processing orders)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_max": {
    "description": "End date (YYYY-MM-DD); only used together with date_min",
    "type": "string"
   },
   "date_min": {
    "description": "Start date (YYYY-MM-DD); only used together with date_max",
    "type": "string"
   },
   "period": {
    "description": "Preset range (default month); ignored when both date_min and date_max are given",
    "enum": [
     "week",
     "month",
     "last_month",
     "year"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_sales_report"
}
