{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Creates a new site on an Infomaniak web hosting. Two-phase commit: first call returns a plan with a confirmation_token, second call (same params + token) actually creates the site.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "format": "uuid",
    "type": "string"
   },
   "directory": {
    "pattern": "^\\/sites\\/[\\w.-]+$",
    "type": "string"
   },
   "environment": {
    "default": "apache_php",
    "enum": [
     "apache_php",
     "nodejs"
    ],
    "type": "string"
   },
   "fqdn": {
    "minLength": 3,
    "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$",
    "type": "string"
   },
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "fqdn"
  ],
  "type": "object"
 },
 "name": "infomaniak_create_site",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "directory": {
        "type": "string"
       },
       "environment": {
        "type": "string"
       },
       "fqdn": {
        "type": "string"
       },
       "hosting_id": {
        "type": "number"
       },
       "payload_preview": {
        "additionalProperties": {},
        "type": "object"
       }
      },
      "required": [
       "hosting_id",
       "fqdn",
       "directory",
       "environment",
       "payload_preview"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "fqdn": {
      "type": "string"
     },
     "hosting_id": {
      "type": "number"
     },
     "message": {
      "type": "string"
     },
     "progress_id": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "progress_id",
     "fqdn",
     "hosting_id",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
