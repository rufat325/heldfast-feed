{"description":"Build a Conditional Branch block (111 condition + then-branch + optional 411 Else + 412 closer, each branch terminated like the editor) for insertion via insert_event_commands. Condition types: switch, self_switch, variable, actor_in_party, gold, item. Provide thenBranch/elseBranch as EventCommand[] (e.g. from other builders). Read-only: returns { commands }.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"condition":{"description":"Conditional branch condition","properties":{"actorId":{"description":"actor_in_party: the actor id","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"compare":{"description":"gold: comparison operator","enum":[">=","<=","<"],"type":"string"},"comparison":{"description":"variable: comparison operator","enum":["==",">=","<=",">","<","!="],"type":"string"},"constant":{"description":"variable: compare against this constant (default 0)","type":"number"},"gold":{"description":"gold: the amount to compare against","type":"number"},"itemId":{"description":"item: the item id (tests \"party has item\")","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"name":{"description":"self_switch: which self switch","enum":["A","B","C","D"],"type":"string"},"switchId":{"description":"switch: the switch id to test","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"type":{"description":"Condition type","enum":["switch","self_switch","variable","actor_in_party","gold","item"],"type":"string"},"value":{"description":"switch/self_switch: test for on (default) or off","enum":["on","off"],"type":"string"},"variableId":{"description":"variable: the variable id (left side)","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"variableOperand":{"description":"variable: compare against this variable id (overrides constant)","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"}},"required":["type"],"type":"object"},"elseBranch":{"description":"Commands for the Else branch; presence (even empty) adds the 411 Else block","items":{"properties":{"code":{"description":"Event command code","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"indent":{"description":"Indentation level (default 0)","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"parameters":{"description":"Command parameters (default [])","items":{},"type":"array"}},"required":["code"],"type":"object"},"type":"array"},"indent":{"description":"Indentation level of the block (default 0)","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"thenBranch":{"description":"Commands to run when the condition is true (default empty)","items":{"properties":{"code":{"description":"Event command code","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"indent":{"description":"Indentation level (default 0)","maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"parameters":{"description":"Command parameters (default [])","items":{},"type":"array"}},"required":["code"],"type":"object"},"type":"array"}},"required":["condition"],"type":"object"},"name":"build_conditional_branch"}
