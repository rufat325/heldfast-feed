{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "After the human explicitly agrees to pay for a bounded FAIE Signal Brief or Proof Sprint, prepare the secure checkout. Verified payment queues research for human-controlled execution and review; it does not authorize consequential action.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "email": {
    "format": "email",
    "maxLength": 254,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "geography": {
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "type": "string"
   },
   "offer_key": {
    "enum": [
     "signal_brief_250",
     "proof_sprint_2500"
    ],
    "type": "string"
   },
   "organization": {
    "maxLength": 220,
    "type": "string"
   },
   "question": {
    "maxLength": 4000,
    "minLength": 20,
    "type": "string"
   },
   "request_id": {
    "maxLength": 240,
    "type": "string"
   },
   "role": {
    "maxLength": 160,
    "type": "string"
   },
   "use_case": {
    "maxLength": 1200,
    "type": "string"
   },
   "user_confirmed_payment": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "user_confirmed_payment",
   "offer_key",
   "email",
   "geography",
   "question"
  ],
  "type": "object"
 },
 "name": "prepare_faie_checkout",
 "title": "Prepare a human-confirmed FAIE checkout"
}
