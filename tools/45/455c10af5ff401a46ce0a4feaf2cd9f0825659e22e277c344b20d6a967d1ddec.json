{"_meta":{"openai/toolInvocation/invoked":"Cost estimate ready.","openai/toolInvocation/invoking":"Calculating cost\u2026","securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Calculate 3D print cost"},"description":"Estimate what an FDM print costs (material, electricity, machine wear, labor, failure allowance) and a suggested selling price. Needs the print weight in grams and time in hours from the slicer; all other inputs have sensible defaults (1 kg spool at $20, 120 W printer, $0.12/kWh, 5% failures).","inputSchema":{"additionalProperties":false,"properties":{"electricity_cost_per_kwh":{"default":0.12,"maximum":10,"minimum":0,"type":"number"},"failure_rate_percent":{"default":5,"description":"Allowance for failed prints, 0\u2013100. Use 0 for none.","maximum":100,"minimum":0,"type":"number"},"labor_minutes":{"default":0,"description":"Hands-on time: slicing, removal, post-processing.","minimum":0,"type":"number"},"labor_rate_per_hour":{"default":0,"minimum":0,"type":"number"},"markup_percent":{"default":0,"description":"Profit markup to compute a selling price.","minimum":0,"type":"number"},"print_time_hours":{"description":"Print time in hours (e.g. 3.5).","maximum":10000,"minimum":0,"type":"number"},"print_weight_grams":{"description":"Filament used, from the slicer.","maximum":1000000,"minimum":0,"type":"number"},"printer_cost_usd":{"default":0,"description":"Printer purchase price, for depreciation. 0 to skip.","minimum":0,"type":"number"},"printer_lifespan_hours":{"default":5000,"exclusiveMinimum":0,"type":"number"},"printer_power_watts":{"default":120,"maximum":10000,"minimum":0,"type":"number"},"quantity":{"default":1,"maximum":10000,"minimum":1,"type":"integer"},"spool_price_usd":{"default":20,"minimum":0,"type":"number"},"spool_weight_kg":{"default":1,"exclusiveMinimum":0,"maximum":50,"type":"number"}},"required":["print_weight_grams","print_time_hours"],"type":"object"},"name":"calculate_print_cost","securitySchemes":[{"type":"noauth"}],"title":"Calculate 3D print cost"}
