{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn a launch date and up to eight chosen channels into a bounded preparation timetable. Returns an evidence-bounded result and the canonical web tool URL.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "channels": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "launchDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "launchDate",
   "channels"
  ],
  "type": "object"
 },
 "name": "toolfound_distribution_plan",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "canonical_result_url": {
    "format": "uri",
    "type": "string"
   },
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "errors": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "sections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "heading": {
       "type": "string"
      },
      "items": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "heading",
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "summary",
   "sections",
   "links",
   "canonical_result_url"
  ],
  "type": "object"
 },
 "title": "Launch distribution timetable"
}
