{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the destructive actions taken in the current session, most recent first. Each entry includes whether it can be reversed via infomaniak_undo.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "infomaniak_history",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "is_reversible": {
       "type": "boolean"
      },
      "kind": {
       "type": "string"
      },
      "recorded_at": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      },
      "undone": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "recorded_at",
      "tool",
      "kind",
      "summary",
      "undone",
      "is_reversible"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "entries"
  ],
  "type": "object"
 }
}
