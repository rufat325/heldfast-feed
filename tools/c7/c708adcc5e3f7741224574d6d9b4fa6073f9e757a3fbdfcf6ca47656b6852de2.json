{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a breaking-news story snapshot (chapters umbrella)"
 },
 "description": "Fetches the current snapshot of a story by id, including its title, status (active, developing, concluded or dormant) and ordered chapters. Returns the whole multi-chapter arc; a single chapter comes from get_live_moment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_live_story",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "story": {
    "additionalProperties": false,
    "properties": {
     "categoryBucket": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "chapterCount": {
      "type": "number"
     },
     "chapters": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "body": {
         "type": "string"
        },
        "chapterIndex": {
         "type": "number"
        },
        "decisionAt": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "endedAt": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "eventOnsetAt": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "freshnessBand": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "importance": {
         "type": "number"
        },
        "kind": {
         "type": "string"
        },
        "lastStateAt": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "momentId": {
         "type": "string"
        },
        "startedAt": {
         "type": "string"
        },
        "status": {
         "enum": [
          "live",
          "ended"
         ],
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "momentId",
        "chapterIndex",
        "title",
        "kind",
        "status"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "concludedAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "firstEventOnsetAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "importance": {
      "type": "number"
     },
     "lastActiveAt": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "primaryKind": {
      "type": "string"
     },
     "status": {
      "enum": [
       "active",
       "developing",
       "concluded",
       "dormant"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "status",
     "primaryKind",
     "chapterCount",
     "chapters"
    ],
    "type": "object"
   }
  },
  "required": [
   "story"
  ],
  "type": "object"
 },
 "title": "Get a breaking-news story snapshot (chapters umbrella)"
}
