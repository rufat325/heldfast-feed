  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "ISO 3166-1 alpha-2 country code for compliance filtering",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "exchange": {
    "description": "Exchange name (binance, okx, bybit, bitget, gate, hyperliquid)",
    "type": "string"
   },
   "type": {
    "description": "Trade type: spot or futures",
    "enum": [
     "spot",
     "futures"
    ],
    "type": "string"
   },
   "volume": {
    "description": "Trade volume in USD",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "exchange",
   "volume",
   "type"
  ],
  "type": "object"
 },
 "name": "calculate_trading_cost",
