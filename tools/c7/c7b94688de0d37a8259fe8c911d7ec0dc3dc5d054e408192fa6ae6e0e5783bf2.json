{
 "description": "List NFS-e with pagination + optional flowStatus filter.",
 "inputSchema": {
  "properties": {
   "company_id": {
    "description": "Company id (falls back to env)",
    "type": "string"
   },
   "flowStatus": {
    "description": "Filter by invoice status",
    "enum": [
     "Issued",
     "Cancelled",
     "WaitingSend",
     "WaitingReturn",
     "IssuedError",
     "CancelError"
    ],
    "type": "string"
   },
   "pageCount": {
    "description": "Results per page (default 50)",
    "type": "number"
   },
   "pageIndex": {
    "description": "Page index (0-based)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list_nfse"
}
