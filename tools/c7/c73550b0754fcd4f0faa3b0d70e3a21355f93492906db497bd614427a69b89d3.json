{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Aggregate RUM data with statistical computations (count, avg, percentiles) and grouping by fields",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregation": {
    "description": "Aggregation function. Example: count or avg",
    "enum": [
     "count",
     "cardinality",
     "avg",
     "sum",
     "min",
     "max",
     "pc75",
     "pc90",
     "pc95",
     "pc98",
     "pc99"
    ],
    "type": "string"
   },
   "from": {
    "description": "Start time (ISO 8601). Example: 2026-02-26T00:00:00Z",
    "type": "string"
   },
   "groupBy": {
    "description": "Field to group by (e.g. @application.id, @view.url_path)",
    "type": "string"
   },
   "metric": {
    "description": "Metric field for non-count aggregations (e.g. @view.loading_time)",
    "type": "string"
   },
   "query": {
    "description": "RUM filter query. Example: service:my-app @type:view",
    "type": "string"
   },
   "to": {
    "description": "End time (ISO 8601). Example: 2026-02-26T23:59:59Z",
    "type": "string"
   }
  },
  "required": [
   "query",
   "from",
   "to",
   "aggregation"
  ],
  "type": "object"
 },
 "name": "aggregate-rum"
}
