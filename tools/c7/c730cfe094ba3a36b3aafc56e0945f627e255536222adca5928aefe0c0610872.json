{
 "description": "Submit a typed contribution to the Acta public record. Questions have no evidence burden. Factual claims require a source or reasoning. Opinion/hypothesis claims require uncertainty. Predictions require resolution criteria, date, source, and rule.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Full text of the contribution",
    "maxLength": 10000,
    "type": "string"
   },
   "category": {
    "description": "Required for claims",
    "enum": [
     "factual",
     "opinion",
     "hypothesis"
    ],
    "type": "string"
   },
   "provenance": {
    "additionalProperties": false,
    "description": "Optional AI authorship metadata",
    "properties": {
     "authored_with_model": {
      "type": "string"
     },
     "disclosure_level": {
      "enum": [
       "private",
       "reproducible",
       "full"
      ],
      "type": "string"
     },
     "prompt_hash": {
      "type": "string"
     },
     "system_prompt_hash": {
      "type": "string"
     },
     "tool_version": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "reasoning": {
    "description": "Reasoning (alternative to source for factual claims)",
    "type": "string"
   },
   "resolution_criteria": {
    "description": "How to determine if confirmed/refuted (required for predictions)",
    "type": "string"
   },
   "resolution_date": {
    "description": "ISO-8601 future date (required for predictions)",
    "type": "string"
   },
   "resolution_rule": {
    "description": "Who/what triggers resolution (required for predictions)",
    "type": "string"
   },
   "resolution_source": {
    "description": "Authoritative source for resolution (required for predictions)",
    "type": "string"
   },
   "source": {
    "description": "URL to supporting evidence (required for factual claims)",
    "type": "string"
   },
   "topic": {
    "description": "Topic slug (e.g. \"ai-regulation-2026\")",
    "type": "string"
   },
   "type": {
    "description": "Contribution type",
    "enum": [
     "question",
     "claim",
     "prediction"
    ],
    "type": "string"
   },
   "uncertainty": {
    "description": "Uncertainty statement (required for opinion/hypothesis claims)",
    "type": "string"
   }
  },
  "required": [
   "topic",
   "type",
   "body"
  ],
  "type": "object"
 },
 "name": "acta_contribute"
}
