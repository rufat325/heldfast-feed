{
 "description": "Submit a new x402 endpoint/service to ClearedIndex for trust verification. Returns the listing URL and initial checks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "enum": [
     "identity",
     "enrichment",
     "compliance",
     "regime",
     "judgment",
     "workflow",
     "other"
    ],
    "type": "string"
   },
   "contactEmail": {
    "description": "Contact email for verification",
    "type": "string"
   },
   "description": {
    "description": "Full description of what the service does",
    "type": "string"
   },
   "endpoints": {
    "description": "API endpoints the service exposes",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "method": {
       "enum": [
        "GET",
        "POST"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "price": {
       "description": "Price per call (e.g. '$0.01')",
       "type": "string"
      }
     },
     "required": [
      "name",
      "path",
      "method",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Service name",
    "type": "string"
   },
   "operator": {
    "description": "Company/person operating the service",
    "type": "string"
   },
   "origin": {
    "description": "Base URL of the service (e.g. https://api.example.com)",
    "type": "string"
   },
   "tagline": {
    "description": "One-line description",
    "type": "string"
   }
  },
  "required": [
   "name",
   "operator",
   "origin",
   "tagline",
   "description",
   "category",
   "contactEmail",
   "endpoints"
  ],
  "type": "object"
 },
 "name": "submit_for_review"
}
