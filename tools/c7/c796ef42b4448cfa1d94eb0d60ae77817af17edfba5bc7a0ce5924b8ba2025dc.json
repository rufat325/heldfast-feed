{
 "description": "Register a custom ERC-20 token in the global token registry so it can be used by send_token, get_balances, and swap_tokens.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Token contract address (0x-prefixed)",
    "type": "string"
   },
   "chainId": {
    "description": "Chain ID",
    "type": "number"
   },
   "decimals": {
    "description": "Token decimal precision (0\u201318)",
    "type": "number"
   },
   "name": {
    "description": "Human-readable name (optional)",
    "type": "string"
   },
   "symbol": {
    "description": "Token symbol",
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "address",
   "decimals",
   "chainId"
  ],
  "type": "object"
 },
 "name": "add_custom_token"
}
