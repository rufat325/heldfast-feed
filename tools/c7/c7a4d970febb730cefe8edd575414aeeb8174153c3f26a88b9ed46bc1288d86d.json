{
 "_meta": {
  "threadlinqs/catalog_note": "Served from the public catalog, not your authenticated tool list. Check THREADLINQS_API_KEY.",
  "threadlinqs/catalog_source": "public_catalog"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Tool Intelligence"
 },
 "description": "Pivot on an offensive tool / utility / RMM / LOLBin by name (e.g. \"Cobalt Strike\", \"Mimikatz\", \"AnyDesk\", \"PsExec\"). Returns the canonical tool + class, prevalence, the threats and actors using it, and its most-common ATT&CK techniques. prevalence.actor_count is the TRUE distinct-actor total; the actors[] array is clipped to the top 20 (see prevalence.actors_returned) \u2014 do not read its length as the population.",
 "inputSchema": {
  "properties": {
   "name": {
    "description": "Tool name (e.g. \"Cobalt Strike\", \"Mimikatz\")",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_tool_intelligence",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "actors": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "count": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "canonical": {
    "type": "string"
   },
   "entity_type": {
    "type": "string"
   },
   "matched": {
    "type": "boolean"
   },
   "membership": {
    "additionalProperties": true,
    "properties": {
     "grounded": {
      "type": "integer"
     },
     "note": {
      "type": "string"
     },
     "title_match": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "prevalence": {
    "additionalProperties": true,
    "properties": {
     "actor_count": {
      "description": "TRUE distinct-actor prevalence, uncapped. The actors[] array is clipped to 20 \u2014 compare with actors_returned.",
      "type": "integer"
     },
     "actors_returned": {
      "type": "integer"
     },
     "threat_count": {
      "type": "integer"
     },
     "threat_count_is_floor": {
      "description": "True when the membership fetch saturated, so threat_count under-counts.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "threats": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "matched_via": {
       "description": "campaigns only: grounded | title | grounded+title",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_techniques": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "count": {
       "type": "integer"
      },
      "technique_id": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "matched"
  ],
  "type": "object"
 },
 "title": "Tool Intelligence"
}
