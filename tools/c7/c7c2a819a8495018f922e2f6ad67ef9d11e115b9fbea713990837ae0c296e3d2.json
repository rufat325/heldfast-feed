{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "artifact.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Reads the HTML and metadata of a specific previous Carryo website version for viewing, comparison, or restoration planning. Requires linkId and versionNumber. Reading a version does not restore it or change the current website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "linkId": {
    "description": "Carryo page link identifier to read",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "versionNumber": {
    "description": "Specific page version number to read",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "linkId",
   "versionNumber"
  ],
  "type": "object"
 },
 "name": "website.read_version",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "description": "Bundled asset descriptors",
    "items": {
     "additionalProperties": false,
     "properties": {
      "contentType": {
       "description": "Asset MIME type",
       "type": "string"
      },
      "path": {
       "description": "Relative asset path in the page asset bundle",
       "type": "string"
      },
      "sizeBytes": {
       "description": "Asset size in bytes",
       "type": "number"
      }
     },
     "required": [
      "path",
      "contentType",
      "sizeBytes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "forms": {
    "description": "Form definitions belonging to this historical version, for comparison or restoration; not its current collection state",
    "items": {
     "additionalProperties": false,
     "properties": {
      "acknowledgementEmailField": {
       "type": "string"
      },
      "closed": {
       "type": "boolean"
      },
      "fields": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "label": {
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         "maxLength": {
          "maximum": 3000,
          "minimum": 1,
          "type": "integer"
         },
         "name": {
          "pattern": "^[a-z][a-z0-9_-]{0,63}$",
          "type": "string"
         },
         "options": {
          "items": {
           "maxLength": 200,
           "minLength": 1,
           "type": "string"
          },
          "maxItems": 100,
          "minItems": 1,
          "type": "array"
         },
         "required": {
          "type": "boolean"
         },
         "type": {
          "enum": [
           "text",
           "email",
           "tel",
           "number",
           "date",
           "textarea",
           "select",
           "checkbox",
           "radio"
          ],
          "type": "string"
         }
        },
        "required": [
         "name",
         "label",
         "type"
        ],
        "type": "object"
       },
       "maxItems": 30,
       "minItems": 1,
       "type": "array"
      },
      "key": {
       "pattern": "^[a-z][a-z0-9_-]{0,63}$",
       "type": "string"
      },
      "notifyOwner": {
       "type": "boolean"
      },
      "title": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key",
      "title",
      "fields"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "htmlContent": {
    "description": "HTML content for the requested historical version",
    "type": "string"
   },
   "linkId": {
    "description": "Carryo page link identifier",
    "type": "string"
   },
   "versionNumber": {
    "description": "Page version number",
    "type": "number"
   }
  },
  "required": [
   "linkId",
   "versionNumber",
   "htmlContent"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "artifact.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read a Website Version"
}
