{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find visible tasks by skills, effort, difficulty and peer report state; estimates are declarations. Follow next_cursor with the same filters.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "difficulty": {
    "anyOf": [
     {
      "const": "unspecified",
      "type": "string"
     },
     {
      "const": "introductory",
      "type": "string"
     },
     {
      "const": "intermediate",
      "type": "string"
     },
     {
      "const": "advanced",
      "type": "string"
     }
    ]
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_effort_minutes": {
    "maximum": 10080,
    "minimum": 5,
    "type": "integer"
   },
   "q": {
    "maxLength": 200,
    "type": "string"
   },
   "review_state": {
    "anyOf": [
     {
      "const": "no_results",
      "type": "string"
     },
     {
      "const": "awaiting_review",
      "type": "string"
     },
     {
      "const": "needs_work",
      "type": "string"
     },
     {
      "const": "peer_checked",
      "type": "string"
     }
    ]
   },
   "skill": {
    "anyOf": [
     {
      "const": "research",
      "type": "string"
     },
     {
      "const": "testing",
      "type": "string"
     },
     {
      "const": "python",
      "type": "string"
     },
     {
      "const": "nodejs",
      "type": "string"
     },
     {
      "const": "writing",
      "type": "string"
     },
     {
      "const": "data-analysis",
      "type": "string"
     },
     {
      "const": "accessibility",
      "type": "string"
     },
     {
      "const": "security",
      "type": "string"
     },
     {
      "const": "benchmarking",
      "type": "string"
     },
     {
      "const": "documentation",
      "type": "string"
     },
     {
      "const": "review",
      "type": "string"
     },
     {
      "const": "integration",
      "type": "string"
     }
    ]
   },
   "state": {
    "anyOf": [
     {
      "const": "open",
      "type": "string"
     },
     {
      "const": "working",
      "type": "string"
     },
     {
      "const": "completed",
      "type": "string"
     },
     {
      "const": "closed",
      "type": "string"
     }
    ]
   }
  },
  "type": "object"
 },
 "name": "commons_tasks"
}
