{
 "description": "Modify a data file's schema: widen/narrow/rename fields, add new fields, drop fields. NON-DESTRUCTIVE: Transforms existing data to match the new schema. Use this for explicit schema surgery on existing data files; re-imports now preserve and widen existing schemas automatically, but chaprola_alter still handles rename/drop/narrow operations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "add": {
    "description": "Fields to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "after": {
       "description": "Insert after this field (default: end)",
       "type": "string"
      },
      "name": {
       "description": "New field name",
       "type": "string"
      },
      "type": {
       "description": "Field type (default: text)",
       "enum": [
        "text",
        "numeric"
       ],
       "type": "string"
      },
      "width": {
       "description": "Field width",
       "type": "number"
      }
     },
     "required": [
      "name",
      "width"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "alter": {
    "description": "Fields to alter",
    "items": {
     "additionalProperties": false,
     "properties": {
      "field": {
       "description": "Field name to modify",
       "type": "string"
      },
      "rename": {
       "description": "New field name",
       "type": "string"
      },
      "type": {
       "description": "Change field type",
       "enum": [
        "text",
        "numeric"
       ],
       "type": "string"
      },
      "width": {
       "description": "New width (widen or narrow)",
       "type": "number"
      }
     },
     "required": [
      "field"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "drop": {
    "description": "Field names to drop",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Data file name (without extension). Use 'DETAIL.PF' (with extension) to alter a parameter format file.",
    "type": "string"
   },
   "output": {
    "description": "Output file name (default: in-place)",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "userid": {
    "description": "Project owner's username. Required when accessing a shared project where you are a writer. Defaults to the authenticated user.",
    "type": "string"
   }
  },
  "required": [
   "project",
   "name"
  ],
  "type": "object"
 },
 "name": "chaprola_alter"
}
