 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "the note body (markdown)",
    "type": "string"
   },
   "notebook": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "title": {
    "description": "the note title (optional)",
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "add_note",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact": {
