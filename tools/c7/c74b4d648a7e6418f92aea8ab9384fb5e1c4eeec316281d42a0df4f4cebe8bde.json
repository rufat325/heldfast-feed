{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Runs mypy and returns structured type-check diagnostics (file, line, severity, message, code).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "configFile": {
    "description": "Path to mypy config file (--config-file)",
    "maxLength": 4096,
    "type": "string"
   },
   "disallowAnyGenerics": {
    "default": false,
    "description": "Disallow usage of generic types without explicit parameters (--disallow-any-generics)",
    "type": "boolean"
   },
   "disallowIncompleteDefs": {
    "default": false,
    "description": "Disallow partially typed function definitions (--disallow-incomplete-defs)",
    "type": "boolean"
   },
   "disallowUntypedCalls": {
    "default": false,
    "description": "Disallow calling untyped functions from typed contexts (--disallow-untyped-calls)",
    "type": "boolean"
   },
   "disallowUntypedDefs": {
    "default": false,
    "description": "Disallow defining functions without type annotations (--disallow-untyped-defs)",
    "type": "boolean"
   },
   "exclude": {
    "description": "Regular expression to exclude files/directories",
    "maxLength": 65536,
    "type": "string"
   },
   "followImports": {
    "description": "How to handle imports (normal/silent/skip/error)",
    "enum": [
     "normal",
     "silent",
     "skip",
     "error"
    ],
    "type": "string"
   },
   "ignoreMissingImports": {
    "default": false,
    "description": "Suppress errors about missing imports for projects with incomplete stubs (--ignore-missing-imports)",
    "type": "boolean"
   },
   "installTypes": {
    "description": "Auto-install missing type stubs (--install-types --non-interactive)",
    "type": "boolean"
   },
   "module": {
    "description": "Specific module to type-check (-m MODULE)",
    "maxLength": 255,
    "type": "string"
   },
   "noIncremental": {
    "default": false,
    "description": "Disable incremental mode (--no-incremental)",
    "type": "boolean"
   },
   "package": {
    "description": "Specific package to type-check (-p PACKAGE)",
    "maxLength": 255,
    "type": "string"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "pythonPath": {
    "description": "Python interpreter path to use (overrides executable/PATH fallback)",
    "maxLength": 4096,
    "type": "string"
   },
   "pythonVersion": {
    "description": "Python version to target (e.g. '3.11')",
    "maxLength": 255,
    "type": "string"
   },
   "strict": {
    "default": false,
    "description": "Enable strict mode for thorough type checking (--strict)",
    "type": "boolean"
   },
   "targets": {
    "default": [
     "."
    ],
    "description": "Files or directories to check (default: ['.'])",
    "items": {
     "maxLength": 4096,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "warnRedundantCasts": {
    "default": false,
    "description": "Warn about redundant type casts (--warn-redundant-casts)",
    "type": "boolean"
   },
   "warnReturnAny": {
    "default": false,
    "description": "Warn about returning values of type Any (--warn-return-any)",
    "type": "boolean"
   },
   "warnUnreachable": {
    "default": false,
    "description": "Warn about statically unreachable code (--warn-unreachable)",
    "type": "boolean"
   },
   "warnUnusedIgnores": {
    "default": false,
    "description": "Warn about unnecessary # type: ignore comments (--warn-unused-ignores)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "mypy",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "column": {
       "type": "number"
      },
      "file": {
       "type": "string"
      },
      "line": {
       "type": "number"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "note"
       ],
       "type": "string"
      }
     },
     "required": [
      "file",
      "line",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "errorCount": {
    "description": "Count of error diagnostics (set in compact output)",
    "type": "number"
   },
   "exitCode": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "truncated": {
    "description": "Whether the compact diagnostics list was capped (only set when true)",
    "type": "boolean"
   },
   "warningCount": {
    "description": "Count of warning diagnostics (set in compact output)",
    "type": "number"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "mypy Type Check"
}
