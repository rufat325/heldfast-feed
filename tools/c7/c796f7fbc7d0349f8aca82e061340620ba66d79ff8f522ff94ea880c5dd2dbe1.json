{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Use this when the user asks how well their resume matches a specific job post, without rewriting it. Pass the resume text (cvText), the job post text (offerText) and the guestToken. Returns an operationId and a coverage score from 0 to 100 with the requirements demonstrated, partly demonstrated, missing or unclear, each with its job post and resume evidence. The score is neither an ATS guarantee nor a hiring probability. Do not use to tailor the resume or produce a PDF; use create_tailored_resume. Identical retries reuse the operation.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"cvText":{"maxLength":80000,"minLength":20,"type":"string"},"guestToken":{"maxLength":100,"minLength":40,"pattern":"^[A-Za-z0-9_-]+$","type":"string"},"offerText":{"maxLength":20000,"minLength":20,"type":"string"}},"required":["guestToken","cvText","offerText"],"type":"object"},"name":"analyze_resume_job","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"downloadUrl":{"format":"uri","type":"string"},"error":{"additionalProperties":false,"properties":{"code":{"type":"string"},"message":{"type":"string"}},"required":["code","message"],"type":"object"},"expiresInSeconds":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"operationId":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"recovery":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"result":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"retryAfterSeconds":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integ