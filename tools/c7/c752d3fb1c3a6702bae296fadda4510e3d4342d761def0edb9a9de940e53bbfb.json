{
 "annotations": {
  "destructiveHint": true,
  "title": "Reply to a case or add an internal note"
 },
 "description": "WRITE: add a post to a case. channel NOTE adds an INTERNAL note visible only to agents (no channel_id needed). channel MAIL/TWITTER/FACEBOOK sends a PUBLIC reply to the customer \u2014 get channel_id from kayako_list_channels with case_id. Can also set status/priority/assignee in the same call. Kayako: POST /api/v1/cases/{id}/reply.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigned_agent_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "assigned_team_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "case_id": {
    "description": "The case id (integer).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "cc": {
    "description": "MAIL only: CC addresses.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "channel": {
    "description": "NOTE for an internal note; MAIL/TWITTER/FACEBOOK for a public reply.",
    "enum": [
     "MAIL",
     "TWITTER",
     "FACEBOOK",
     "NOTE"
    ],
    "type": "string"
   },
   "channel_id": {
    "description": "Channel account id. Required unless channel is NOTE.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "contents": {
    "description": "Reply or note text.",
    "minLength": 1,
    "type": "string"
   },
   "html": {
    "description": "NOTE only: treat contents as HTML (sanitized by Kayako).",
    "type": "boolean"
   },
   "priority_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "status_id": {
    "description": "Also set the case status.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tags": {
    "description": "Comma-separated tags.",
    "maxLength": 500,
    "type": "string"
   },
   "type_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "case_id",
   "contents",
   "channel"
  ],
  "type": "object"
 },
 "name": "kayako_reply_to_case",
 "title": "Reply to a case or add an internal note"
}
