  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "ack: mark read; delete: delete.",
    "enum": [
     "ack",
     "delete"
    ],
    "type": "string"
   },
   "ids": {
    "description": "ack only: these message ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "instance_id": {
    "description": "The inbox (inb_...).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "passport_token": {
    "description": "Your amp_ token, only if your client cannot send it as an Authorization header; leave it out when your MCP app signed in.",
    "pattern": "^amp_(?:s_)?[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "through": {
    "description": "A message id.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "instance_id",
   "action"
  ],
  "type": "object"
 },
 "name": "inbox_bulk",
 "title": "Acknowledge or delete many inbox messages"
