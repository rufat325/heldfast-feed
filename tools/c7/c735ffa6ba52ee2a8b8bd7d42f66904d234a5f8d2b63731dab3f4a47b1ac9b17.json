{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "FREE, no key. Extract declared Product/Offer JSON-LD from supplied HTML only. No page fetch, JavaScript execution, live-price verification or orders. At most 3 offers; inspect truncated and warnings. No paid fallback. Entire JSON input is limited to 16384 UTF-8 bytes; maxOffers defaults to 3. Larger HTML uses commerce_offer_extract after separate spending approval.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "baseUrl": "https://example.com/shop",
    "html": "<script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@type\":\"Product\",\"name\":\"Coffee beans, 500 g\",\"sku\":\"BEANS-500\",\"offers\":{\"@type\":\"Offer\",\"price\":\"8.99\",\"priceCurrency\":\"USD\",\"availability\":\"https://schema.org/InStock\",\"url\":\"/beans\"}}</script>",
    "maxOffers": 3
   }
  ],
  "properties": {
   "baseUrl": {
    "maxLength": 2048,
    "type": "string"
   },
   "html": {
    "maxLength": 16384,
    "type": "string"
   },
   "maxOffers": {
    "default": 3,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "html"
  ],
  "type": "object"
 },
 "name": "agent_utilities_offer_preview",
