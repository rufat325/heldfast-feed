{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview Newsletter"
 },
 "description": "Render a newsletter draft into sanitized email HTML, archive HTML, text, warnings, and counted URL breakdown.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Newsletter ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "shipmail_preview_newsletter",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "preview": {
    "properties": {
     "archive_html": {
      "type": "string"
     },
     "html": {
      "type": "string"
     },
     "newsletter_id": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "url_breakdown": {
      "properties": {
       "href_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "image_src_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "max_unique_urls": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "offending_urls": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "text_url_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "unique_url_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "urls": {
        "items": {
         "properties": {
          "source": {
           "type": "string"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "url",
          "source"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "video_href_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "href_count",
       "image_src_count",
       "video_href_count",
       "text_url_count",
       "unique_url_count",
       "max_unique_urls",
       "urls",
       "offending_urls"
      ],
      "type": "object"
     },
     "warnings": {
      "items": {
       "properties": {
        "kind": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "type": "string"
        }
       },
       "required": [
        "kind",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "object",
     "newsletter_id",
     "html",
     "archive_html",
     "text",
     "warnings",
     "url_breakdown"
    ],
    "type": "object"
   }
  },
  "required": [
   "preview"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Preview Newsletter"
}
