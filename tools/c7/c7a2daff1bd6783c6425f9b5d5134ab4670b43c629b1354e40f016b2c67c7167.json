{
 "description": "Get EU legal basis for a Swedish statute. For provision-level, use get_provision_eu_basis. For reverse lookup (EU \u2192 Swedish), use get_swedish_implementations.",
 "inputSchema": {
  "properties": {
   "include_articles": {
    "default": false,
    "description": "Include specific EU article references",
    "type": "boolean"
   },
   "reference_types": {
    "description": "Filter by reference type",
    "items": {
     "enum": [
      "implements",
      "supplements",
      "applies",
      "references",
      "transposes"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sfs_number": {
    "description": "SFS number (e.g., \"2018:218\")",
    "pattern": "^\\d{4}:\\d+$",
    "type": "string"
   }
  },
  "required": [
   "sfs_number"
  ],
  "type": "object"
 },
 "name": "get_eu_basis"
}
