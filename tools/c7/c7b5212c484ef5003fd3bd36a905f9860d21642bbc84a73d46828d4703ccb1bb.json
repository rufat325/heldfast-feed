{
 "annotations": {
  "destructiveHint": true,
  "title": "Create an opportunity"
 },
 "description": "Create an opportunity (a rental job) as an Enquiry, Draft or Quotation. store_id is required (see current_rms_list_stores); set member_id for the customer and starts_at/ends_at for the job dates. Line items are added in Current RMS. Current RMS: POST /opportunities.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "billing_address_id": {
    "description": "The member's address id used for billing.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "charge_ends_at": {
    "description": "Charging period end (UTC).",
    "type": "string"
   },
   "charge_starts_at": {
    "description": "Charging period start (UTC).",
    "type": "string"
   },
   "collection_instructions": {
    "description": "Collection instructions.",
    "type": "string"
   },
   "custom_fields": {
    "additionalProperties": {},
    "description": "Custom field values by field name.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "customer_collecting": {
    "description": "The customer collects the goods themselves.",
    "type": "boolean"
   },
   "customer_returning": {
    "description": "The customer returns the goods themselves.",
    "type": "boolean"
   },
   "delivery_instructions": {
    "description": "Delivery instructions.",
    "type": "string"
   },
   "description": {
    "description": "Internal description.",
    "type": "string"
   },
   "ends_at": {
    "description": "Overall end / collection date-time (UTC).",
    "type": "string"
   },
   "external_description": {
    "description": "Description shown on customer documents.",
    "type": "string"
   },
   "member_id": {
    "description": "The customer (Organisation/Contact member) id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "owned_by": {
    "description": "User member id of the owner.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "project_id": {
    "description": "The project this opportunity belongs to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "rating": {
    "description": "Rating, 0-5.",
    "maximum": 5,
    "minimum": 0,
    "type": "integer"
   },
   "reference": {
    "description": "Customer reference, e.g. their PO number.",
    "type": "string"
   },
   "starts_at": {
    "description": "Overall start / delivery date-time (UTC).",
    "type": "string"
   },
   "state": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     }
    ],
    "description": "0 = Enquiry, 1 = Draft, 2 = Quotation. Converting to an Order is left to Current RMS."
   },
   "store_id": {
    "description": "The store the job is served from.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "subject": {
    "description": "The opportunity's subject (title).",
    "type": "string"
   },
   "tag_list": {
    "description": "Tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "venue_id": {
    "description": "The Venue member id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "store_id"
  ],
  "type": "object"
 },
 "name": "current_rms_create_opportunity",
 "title": "Create an opportunity"
}
