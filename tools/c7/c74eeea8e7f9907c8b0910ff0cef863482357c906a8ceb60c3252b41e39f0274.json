{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "UCP: catalogus doorzoeken"
 },
 "description": "Zoek supplementen in UCP-vorm (Universal Commerce Protocol): producten met prijs in centen, verkoper, en per variant kortingscode (discounts.codes), attribution, partner_url en permalink. Dezelfde bron als zoek_producten.",
 "inputSchema": {
  "properties": {
   "catalog": {
    "properties": {
     "attribution": {
      "additionalProperties": {
       "type": "string"
      },
      "description": "vrije string-map (utm_source, gclid, \u2026), wordt gelogd",
      "type": "object"
     },
     "context": {
      "description": "address_country (NL/BE/DE/FR/ES) of language kiest de markt; anders de markt van de site.",
      "properties": {
       "address_country": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "language": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "filters": {
      "properties": {
       "categories": {
        "description": "bijv. creatine, eiwitten, pre-workout",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "price": {
        "properties": {
         "max": {
          "description": "in centen",
          "type": "integer"
         },
         "min": {
          "type": "integer"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     "pagination": {
      "properties": {
       "cursor": {
        "type": "string"
       },
       "limit": {
        "default": 10,
        "maximum": 20,
        "minimum": 1,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "query": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "markt": {
    "default": "nl",
    "description": "Markt/land voor prijzen, links en codes (standaard nl).",
    "enum": [
     "nl",
     "be",
     "de",
     "fr",
     "es"
    ],
    "type": "string"
   },
   "meta": {
    "description": "meta[\"ucp-agent\"].profile = URL van het UCP-profiel van het platform (spec: verplicht; wij loggen het en weigeren niet).",
    "properties": {
     "ucp-agent": {
      "properties": {
       "profile": {
        "format": "uri",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "search_catalog",
 "outputSchema": {
  "description": "UCP search-antwoord, zie https://ucp.dev/2026-08-25/schemas/shopping/catalog_search.json#/$defs/search_response",
  "properties": {
   "messages": {
    "type": "array"
   },
   "pagination": {
    "type": "object"
   },
   "policies": {
    "type": "array"
   },
   "products": {
    "type": "array"
   },
   "ucp": {
    "type": "object"
   }
  },
  "required": [
   "ucp",
   "products"
  ],
  "type": "object"
 },
 "title": "UCP: catalogus doorzoeken"
}
