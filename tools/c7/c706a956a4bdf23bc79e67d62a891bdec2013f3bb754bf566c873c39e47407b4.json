{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Blender-to-TouchDesigner scene handoff scaffold for file-watch, OSC, or WebSocket metadata workflows.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "asset_format": {
    "default": "gltf",
    "enum": [
     "gltf",
     "alembic",
     "fbx",
     "obj"
    ],
    "type": "string"
   },
   "handoff_mode": {
    "default": "file_watch",
    "enum": [
     "file_watch",
     "websocket_json",
     "osc"
    ],
    "type": "string"
   },
   "name": {
    "default": "blender_scene_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Blender bridge.",
    "type": "string"
   },
   "receive_port": {
    "default": 8765,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "server_url": {
    "default": "ws://127.0.0.1:8765",
    "type": "string"
   },
   "sync_camera": {
    "default": true,
    "type": "boolean"
   },
   "sync_lights": {
    "default": false,
    "type": "boolean"
   },
   "watch_folder": {
    "default": "./blender_exports",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "create_blender_scene_bridge",
 "title": "Create Blender scene bridge"
}
