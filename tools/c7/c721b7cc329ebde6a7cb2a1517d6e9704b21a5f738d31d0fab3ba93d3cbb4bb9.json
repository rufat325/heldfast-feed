{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the files an app (app) has stored \u2014 a PAGE of {path, size, mime, version} plus usage totals; limit/cursor page through, prefix narrows. These are opaque user files (attachments, exports) the app keeps \u2014 separate from its structured data collection. Renders no UI.",
 "inputSchema": {
  "properties": {
   "app": {
    "description": "the app whose files to list",
    "type": "string"
   },
   "cursor": {
    "description": "opaque cursor from the previous page's next_cursor",
    "type": "string"
   },
   "limit": {
    "description": "page size (default 200)",
    "type": "number"
   },
   "prefix": {
    "description": "only paths starting with this prefix",
    "type": "string"
   }
  },
  "required": [
   "app"
  ],
  "type": "object"
 },
 "name": "file_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "app": {
    "type": "string"
   },
   "eot": {
    "type": "string"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "app": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "mime": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "size": {
       "type": "number"
      },
      "updated_at": {
       "type": "string"
      },
      "version": {
       "type": "number"
      }
     },
     "required": [
      "app",
      "path",
      "sha256",
      "size",
      "mime",
      "version",
      "created_at",
      "updated_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "files_version": {
    "type": "number"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "type": "string"
   },
   "returned": {
    "type": "number"
   },
   "total": {
    "type": "number"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "bytes": {
      "type": "number"
     },
     "count": {
      "type": "number"
     }
    },
    "required": [
     "bytes",
     "count"
    ],
    "type": "object"
   }
  },
  "required": [
   "app",
   "files",
   "usage",
   "files_version"
  ],
  "type": "object"
 },
 "title": "List app files"
}
