    "description": "Start date for effective_date range (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "End date for effective_date range (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Max results to return (1-500)",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "list_type": {
