{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get all domains running a specific platform or technology (e.g. WordPress, Shopify, Wix, Squarespace, Framer). Returns domains with DA scores. Billed at 1 credit per result returned.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results to return (default 100, max 1000)",
    "type": "number"
   },
   "max_da": {
    "description": "Maximum domain authority score (0\u2013100)",
    "type": "number"
   },
   "min_da": {
    "description": "Minimum domain authority score (0\u2013100)",
    "type": "number"
   },
   "platform": {
    "description": "Platform name or slug (e.g. \"wordpress\", \"shopify\", \"wix\", \"squarespace\", \"framer\")",
    "type": "string"
   },
   "sort": {
    "description": "Sort order: da_desc (default), da_asc, domain_asc",
    "enum": [
     "da_desc",
     "da_asc",
     "domain_asc"
    ],
    "type": "string"
   },
   "tld": {
    "description": "Filter by top-level domain (e.g. \"com\", \"io\", \"co.uk\")",
    "type": "string"
   }
  },
  "required": [
   "platform"
  ],
  "type": "object"
 },
 "name": "get_platform_domains"
}
