{
 "description": "Compare ranking pages to find shared page keywords or competitor-page keywords excluded from your pages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exclude_pages": {
    "default": [],
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "ignore_synonyms": {
    "default": true,
    "type": "boolean"
   },
   "include_clickstream_data": {
    "default": false,
    "type": "boolean"
   },
   "include_serp_info": {
    "default": false,
    "type": "boolean"
   },
   "include_subdomains": {
    "default": true,
    "type": "boolean"
   },
   "intersection_mode": {
    "default": "union",
    "enum": [
     "union",
     "intersect"
    ],
    "type": "string"
   },
   "item_types": {
    "default": [
     "organic",
     "featured_snippet"
    ],
    "items": {
     "enum": [
      "organic",
      "paid",
      "featured_snippet",
      "local_pack"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 5,
    "type": "integer"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "max_rank": {
    "default": 30,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_search_volume": {
    "default": 0,
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 20000,
    "minimum": 0,
    "type": "integer"
   },
   "pages": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "sort_by": {
    "default": "opportunity",
    "enum": [
     "opportunity",
     "search_volume",
     "traffic_gap",
     "rank",
     "cpc"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "pages"
  ],
  "type": "object"
 },
 "name": "agentseo_page_intersection",
 "title": "AgentSEO Page Intersection"
}
