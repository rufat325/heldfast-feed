{
 "description": "Create a buy or sell order",
 "inputSchema": {
  "properties": {
   "book": {
    "description": "Order book symbol (e.g. btc_mxn)",
    "type": "string"
   },
   "major": {
    "description": "Amount of major currency (e.g. BTC quantity)",
    "type": "string"
   },
   "minor": {
    "description": "Amount of minor currency (e.g. MXN amount)",
    "type": "string"
   },
   "price": {
    "description": "Limit price (required for limit orders)",
    "type": "string"
   },
   "side": {
    "description": "Order side",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "type": {
    "description": "Order type",
    "enum": [
     "limit",
     "market"
    ],
    "type": "string"
   }
  },
  "required": [
   "book",
   "side",
   "type"
  ],
  "type": "object"
 },
 "name": "create_order"
}
