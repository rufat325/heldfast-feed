{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Theatre for occasion"
 },
 "description": "Use this when the user has an occasion: family outing, date night, group celebration, solo culture trip, business entertainment. Returns ranked theatre shows with fit scores and reasons, honouring party ages and an optional date.",
 "inputSchema": {
  "properties": {
   "city": {
    "description": "City name, resolved to a slug.",
    "type": "string"
   },
   "city_slug": {
    "description": "City slug, e.g. london.",
    "type": "string"
   },
   "date": {
    "description": "ISO date or natural language like this Saturday.",
    "type": "string"
   },
   "format": {
    "default": "json",
    "description": "Response shape. 'json' returns structured records; 'text' returns the same content rendered as a short narrative paragraph for chat surfaces.",
    "enum": [
     "json",
     "text"
    ],
    "type": "string"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   },
   "limit": {
    "description": "Max shows. Defaults to 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "occasion": {
    "enum": [
     "family_outing",
     "date_night",
     "group_celebration",
     "solo_culture",
     "business_entertainment"
    ],
    "type": "string"
   },
   "party": {
    "properties": {
     "adults": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "children_ages": {
      "items": {
       "maximum": 17,
       "minimum": 0,
       "type": "integer"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "find_theatre_for_occasion",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "city_slug": {
    "type": "string"
   },
   "date": {
    "type": [
     "string",
     "null"
    ]
   },
   "detail": {
    "additionalProperties": true,
    "type": "object"
   },
   "error_type": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "occasion": {
    "type": "string"
   },
   "party": {
    "additionalProperties": true,
    "type": "object"
   },
   "schema_version": {
    "type": "string"
   },
   "shows": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "total_matches": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "schemaVersion": "https://mcp.tickadoo.com/schemas/theatre_occasion/1.0"
}
