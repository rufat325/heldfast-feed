{
 "description": "Search D&D 5e SRD equipment, weapons, armor, and magic items. Filter by category, cost, weight, weapon properties, armor type, or rarity.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "armor_category": {
    "description": "Armor category (e.g. \"Light\", \"Medium\", \"Heavy\", \"Shield\")",
    "type": "string"
   },
   "category": {
    "description": "Equipment category (e.g. \"Weapon\", \"Armor\", \"Adventuring Gear\", \"Tools\")",
    "type": "string"
   },
   "cost_max": {
    "description": "Maximum cost in gold pieces",
    "type": "number"
   },
   "cost_min": {
    "description": "Minimum cost in gold pieces",
    "type": "number"
   },
   "limit": {
    "default": 10,
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "default": 0,
    "description": "Offset for pagination",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Search term for item name or description",
    "type": "string"
   },
   "rarity": {
    "description": "Magic item rarity (e.g. \"common\", \"uncommon\", \"rare\", \"very rare\", \"legendary\")",
    "type": "string"
   },
   "weapon_property": {
    "description": "Weapon property (e.g. \"finesse\", \"heavy\", \"two-handed\", \"versatile\")",
    "type": "string"
   },
   "weight_max": {
    "description": "Maximum weight in pounds",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_equipment"
}
