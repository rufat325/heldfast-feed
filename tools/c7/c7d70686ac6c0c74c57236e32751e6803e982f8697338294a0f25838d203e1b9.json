 "description": "Find out which keys every system holds and which only some do. Takes several datasets at once and returns a coverage histogram plus the keys present in only one and the keys partially covered, naming which datasets each is missing from. A pairwise comparison cannot express \"present in three of five\", which is the question when several systems are meant to hold the same population. Pay 120000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "datasets": {
    "description": "Named datasets. Each name must be distinct, or a finding cannot be attributed to one of them.",
    "example": [
     {
      "csv": "customer_id\nC-001\nC-002\nC-003\n",
      "name": "crm"
     },
     {
      "csv": "customer_id\nC-001\nC-002\n",
      "name": "billing"
     },
     {
      "csv": "customer_id\nC-001\nC-004\n",
      "name": "warehouse"
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "csv": {
       "description": "One dataset. Delimited text with a header row, at most 262144 bytes and 5000 data rows. RFC 4180 quoting is honoured. Nothing is fetched.",
       "maxLength": 262144,
       "type": "string"
      },
      "name": {
       "maxLength": 64,
       "type": "string"
      }
     },
     "required": [
      "name",
      "csv"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "delimiter": {
    "description": "Single field separator. Defaults to a comma.",
    "maxLength": 1,
    "minLength": 1,
    "type": "string"
   },
   "key": {
    "description": "The columns forming the key in every dataset. A composite key is supported. Values are canonicalised exactly, so 42 and 42.0 are the same key and a large identifier is compared as text rather than collapsed.",
    "example": [
     "customer_id"
    ],
    "items": {
     "maxLength": 256,
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "require_in_all": {
    "description": "Report keys not present in every dataset. Defaults to true.",
    "type": "boolean"
   }
  },
  "required": [
   "datasets",
   "key"
  ],
  "type": "object"
 },
 "name": "key_coverage_audit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "assumptions": {
