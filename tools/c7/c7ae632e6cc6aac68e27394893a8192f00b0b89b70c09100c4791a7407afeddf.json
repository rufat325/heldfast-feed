     "pattern": "^ev_[a-f0-9]{64}$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of results to return in this page.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based index of the first result to return.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "right_evidence_ids": {
