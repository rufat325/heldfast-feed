     "pattern": "^ev_[a-f0-9]{64}$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record incomplete or differing evidence",
    "type": "boolean"
   }
  },
  "required": [
   "left_evidence_ids",
   "right_evidence_ids"
  ],
  "type": "object"
 },
