{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Bounded static scan with coverage, per-file engine and gaps, file hashes and explicit ignored inputs. Not a rendered audit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cwd": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target",
   "cwd"
  ],
  "type": "object"
 },
 "name": "detect_antipatterns",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "coverage": {
    "additionalProperties": false,
    "properties": {
     "bytesScanned": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "candidateFiles": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "enumeration": {
      "enum": [
       "git",
       "filesystem"
      ],
      "type": "string"
     },
     "excludedDirectories": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "gitListingError": {
      "type": "string"
     },
     "ignoredFiles": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "scannedFiles": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "skippedPaths": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "path": {
         "type": "string"
        },
        "reason": {
         "enum": [
          "symlink",
          "special-file",
          "unreadable"
         ],
         "type": "string"
        }
       },
       "required": [
        "path",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "skippedSpecialFiles": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "skippedSymlinks": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "unreadableEntries": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "unsupportedFiles": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "enumeration",
     "candidateFiles",
     "scannedFiles",
     "ignoredFiles",
     "unsupportedFiles",
     "excludedDirectories",
     "skippedSymlinks",
     "skippedSpecialFiles",
     "unreadableEntries",
     "skippedPaths",
     "bytesScanned"
    ],
    "type": "object"
   },
   "designSystem": {
    "additionalProperties": false,
    "properties": {
     "reason": {
      "type": "string"
     },
     "status": {
      "enum": [
       "absent",
       "no-tokens",
       "loaded",
       "invalid",
       "disabled"
      ],
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "role": {
       "enum": [
        "selected",
        "linked-stylesheet",
        "design-system"
       ],
       "type": "string"
      },
      "sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "path",
      "sha256",
      "role"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "antipattern": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "file": {
       "type": "string"
      },
      "importedBy": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "line": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      },
      "snippet": {
       "type": "string"
      }
     },
     "required": [
      "file",
      "antipattern",
      "name",
      "severity",
      "snippet",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ignoredRules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ignoredValues": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "scannedFiles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "engine": {
       "enum": [
        "static-html",
        "regex"
       ],
       "type": "string"
      },
      "fullPage": {
       "type": "boolean"
      },
      "gaps": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "detail": {
          "type": "string"
         },
         "kind": {
          "type": "string"
         },
         "line": {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         "rule": {
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "engine",
      "fullPage",
      "gaps"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "target": {
    "type": "string"
   },
   "waivedRules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "target",
   "coverage",
   "findings",
   "files",
   "scannedFiles",
   "designSystem",
   "ignoredRules",
   "waivedRules",
   "ignoredValues"
  ],
  "type": "object"
 }
}
