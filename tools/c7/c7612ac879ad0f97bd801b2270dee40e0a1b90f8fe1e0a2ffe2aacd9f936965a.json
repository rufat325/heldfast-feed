{"description":"Read and verify the public Hyperliquid status and bounded fill history for one user-signed reviewed BTC, ETH, or HYPE perp order. Compares the returned order and fills to the expected client-order-id intent. This is an observed Info-API record, not an Insight signature, a wallet authorization, or a trade submission.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"expectedOrder":{"additionalProperties":false,"properties":{"builderFee":{"additionalProperties":false,"properties":{"builder":{"pattern":"^0x[0-9a-fA-F]{40}$","type":"string"},"feeTenthsOfBasisPoint":{"maximum":100,"minimum":1,"type":"integer"},"maximumFeeTenthsOfBasisPoint":{"maximum":100,"minimum":1,"type":"integer"}},"required":["builder","feeTenthsOfBasisPoint"],"type":"object"},"clientOrderId":{"pattern":"^0x[0-9a-fA-F]{32}$","type":"string"},"limitPrice":{"maxLength":80,"pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","type":"string"},"market":{"enum":["BTC","ETH","HYPE"],"type":"string"},"reduceOnly":{"type":"boolean"},"side":{"enum":["buy","sell"],"type":"string"},"size":{"maxLength":80,"pattern":"^(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$","type":"string"}},"required":["market","side","size","limitPrice","reduceOnly","clientOrderId"],"type":"object"},"orderId":{"pattern":"^(?:[1-9][0-9]{0,19}|0x[0-9a-fA-F]{32})$","type":"string"},"submittedAt":{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$","type":"string"},"user":{"pattern":"^0x[0-9a-fA-F]{40}$","type":"string"}},"required":["user","orderId","submittedAt","expectedOrder"],"type":"object"},"name":"verify_hyperliquid_perp_execution"}
