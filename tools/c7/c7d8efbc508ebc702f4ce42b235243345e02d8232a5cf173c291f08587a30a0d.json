{
 "description": "Create a Pix payment (outbound) via Stone",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "Source account ID",
    "type": "string"
   },
   "amount": {
    "description": "Amount in cents",
    "type": "number"
   },
   "description": {
    "description": "Payment description",
    "type": "string"
   },
   "pix_key": {
    "description": "Recipient Pix key",
    "type": "string"
   },
   "pix_key_type": {
    "description": "Pix key type",
    "enum": [
     "cpf",
     "cnpj",
     "email",
     "phone",
     "evp"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "amount",
   "pix_key",
   "pix_key_type"
  ],
  "type": "object"
 },
 "name": "create_pix_payment"
}
