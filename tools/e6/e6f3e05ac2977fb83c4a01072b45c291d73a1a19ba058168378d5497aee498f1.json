{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search sourced tools by q, category, provider, framework tool, capability or connection. Same response as GET /api/v1/tools. Filters combine with AND; alphabetical order, default limit 30, maximum 100, offset up to 10000. Documentation evidence is distinct from live testing. No external tool is executed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "maxLength": 100,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "category": {
    "enum": [
     "integration",
     "scraping-api",
     "serp-api",
     "browser",
     "ip-intelligence",
     "sdk",
     "cli",
     "skill",
     "diagnostic"
    ],
    "type": "string"
   },
   "connection": {
    "enum": [
     "proxy",
     "http-api",
     "cdp",
     "package",
     "template",
     "database-download"
    ],
    "type": "string"
   },
   "limit": {
    "default": 30,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "provider": {
    "maxLength": 100,
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "q": {
    "maxLength": 80,
    "type": "string"
   },
   "tool": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_tools",
 "title": "Find proxy tools and integrations"
}
