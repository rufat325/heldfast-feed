{
 "description": "Validate a set of assertion definitions (route-access, finding-absence) against a completed scan. Returns pass/fail status for each assertion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assertions": {
    "description": "Array of assertion definitions to validate",
    "items": {
     "properties": {
      "allowProfiles": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "denyProfiles": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "match": {
       "properties": {
        "agents": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "ids": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "minimumSeverity": {
         "enum": [
          "critical",
          "high",
          "medium",
          "low",
          "info"
         ],
         "type": "string"
        },
        "tags": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "titleIncludes": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "verificationStatuses": {
         "items": {
          "enum": [
           "confirmed",
           "strong-signal",
           "inconclusive"
          ],
          "type": "string"
         },
         "type": "array"
        }
       },
       "type": "object"
      },
      "path": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "enum": [
        "route-access",
        "finding-absence"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "jobId": {
    "description": "The completed job ID",
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "assertions"
  ],
  "type": "object"
 },
 "name": "validate_assertion_pack"
}
