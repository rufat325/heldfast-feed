{
 "annotations": {
  "readOnlyHint": true,
  "title": "Generate color palette"
 },
 "description": "Generate a 5-color brand palette from a base hex color and a harmony rule. Returns CSS custom properties, a Tailwind config snippet, or a plain hex list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseColor": {
    "description": "Base color as a 6-digit hex, e.g. \"#3B82F6\".",
    "type": "string"
   },
   "format": {
    "default": "css",
    "description": "Output format for the palette.",
    "enum": [
     "css",
     "tailwind",
     "hex"
    ],
    "type": "string"
   },
   "harmony": {
    "default": "complementary",
    "description": "Color harmony rule used to derive the palette.",
    "enum": [
     "complementary",
     "analogous",
     "triadic",
     "split-complementary",
     "tetradic",
     "monochromatic"
    ],
    "type": "string"
   }
  },
  "required": [
   "baseColor"
  ],
  "type": "object"
 },
 "name": "generate_color_palette",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Format of `output`.",
    "enum": [
     "css",
     "tailwind",
     "hex"
    ],
    "type": "string"
   },
   "output": {
    "description": "The palette rendered as CSS custom properties, a Tailwind snippet, or a hex list.",
    "type": "string"
   }
  },
  "required": [
   "format",
   "output"
  ],
  "type": "object"
 },
 "title": "Generate color palette"
}
