{
 "description": "Batch indicative prices for catalog uids (POST /v1/rates). Prices are decimal strings. Uids are class-ranged (uid = class*1e8+seq; 1=fiat e.g. usd 100000001, 2=crypto e.g. btc 200000001). Use search_assets to find uids. Per-rate status: ok = fresh price; stale = last known price, upstream is late (see as_of); pending = in the catalog but not priced yet, wait retry_after seconds for that asset and ask again; unsupported = the uid is not in the catalog (a dynamic coin may have expired; look it up again). Size: about 0.4 KB per asset and quote without include (the result is sent twice, as text and as structuredContent; sizes here count both); sparkline adds a long price array per asset, so request it only when needed. Limits (max assets, max quote currencies) are in get_meta. Optional source (a code such as s1) returns that source's own price instead of the server's choice: source_code equals it, and an asset the source has no reading for is unsupported, never another source's price; exchange codes only answer when the deployment runs multi-source aggregation. A dynamic coin expires after 7 days without use and may get a new uid when registered again (also after a server reset): match it by symbol or a new search, not by a stored uid. Edge cases: read resource ratehub://docs/behavior (behaviour notes).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assets": {
    "description": "Catalog uids to price (class*1e8+seq; use search_assets to find uids)",
    "items": {
     "maximum": 4294967295,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "include": {
    "description": "Optional extras: change, market, sparkline. sparkline is large (a long price array per asset); ask for it only when needed",
    "items": {
     "enum": [
      "change",
      "market",
      "sparkline"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": [
     "null",
     "array"
    ]
   },
   "source": {
    "description": "Optional source code such as s1: every rate is then that source's own reading, or unsupported when it has none (never another source's price)",
    "pattern": "^s[0-9]+$",
    "type": [
     "null",
     "string"
    ]
   },
   "vs": {
    "description": "Quote currency codes (usd, eur, btc, ...)",
    "items": {
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "assets",
   "vs"
  ],
  "type": "object"
 },
 "name": "get_rates",
