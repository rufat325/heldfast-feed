{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"List the next run times of a 5- or 6-field cron expression (Croner dialect) in an explicit IANA timezone, including skipped and repeated wall-clock times at DST transitions.\nWhen to use: Use before deploying or explaining a cron schedule, especially across daylight-saving changes.\nNotes: No account or token needed.\nExample arguments: {\"expr\":\"30 2 * * *\",\"tz\":\"Europe/Rome\",\"from\":\"2026-10-24T00:00:00Z\",\"count\":5}","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"count":{"description":"Runs to return, 1\u201350.","maximum":50,"minimum":1,"type":"integer"},"dialect":{"const":"croner","description":"Only 'croner' (default).","type":"string"},"domAndDow":{"description":"Require both day-of-month and day-of-week to match (default: either).","type":"boolean"},"expr":{"description":"5 or 6 cron fields (seconds optional first); no aliases, ? or year field.","maxLength":256,"minLength":1,"type":"string"},"from":{"description":"Start instant (ISO 8601); runs are strictly after it.","maxLength":40,"minLength":1,"type":"string"},"tz":{"description":"IANA timezone, e.g. Europe/Rome or UTC.","maxLength":100,"minLength":1,"type":"string"}},"required":["expr","tz","from"],"type":"object"},"name":"preview_cron","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"complete":{"type":"boolean"},"dialect":{"const":"croner","type":"string"},"domAndDow":{"type":"boolean"},"error":{"additionalProperties":false,"properties":{"code":{"type":"string"},"message":{"type":"string"}},"required":["code","message"],"type":"object"},"policy":{"type":"string"},"runs":{"items":{"additionalProperties":false,"properties":{"abbreviation":{"type":"string"},"local":{"type":"string"},"offsetMinutes":{"type":"number