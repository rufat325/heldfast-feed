{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List infrastructure asset inspections"
 },
 "description": "List inspections recorded against infrastructure assets. Filter by feature, inspector, method, condition score range, or inspection date range.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "condition_max": {
    "description": "Maximum condition score (0-100)",
    "type": "number"
   },
   "condition_min": {
    "description": "Minimum condition score (0-100)",
    "type": "number"
   },
   "feature_id": {
    "description": "Filter by infrastructure asset (feature) ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "inspection_date_from": {
    "description": "Filter inspections on/after this date (YYYY-MM-DD)",
    "type": "string"
   },
   "inspection_date_to": {
    "description": "Filter inspections on/before this date (YYYY-MM-DD)",
    "type": "string"
   },
   "inspector_id": {
    "description": "Filter by inspector user ID",
    "type": "string"
   },
   "method": {
    "description": "Filter by inspection method (e.g. CCTV, visual)",
    "type": "string"
   },
   "page": {
    "description": "Page number (default: all pages fetched automatically)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default: 1000, max: 1000). All pages are fetched automatically.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_infrastructure_asset_inspections",
 "title": "List infrastructure asset inspections"
}
