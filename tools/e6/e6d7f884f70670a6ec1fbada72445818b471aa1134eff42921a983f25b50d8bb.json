{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update criticality modifier"
 },
 "description": "Update a criticality modifier override by ID. Below 1 tightens the targets of facilities in that tier, above 1 relaxes them. Requires los_targets:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "criticality": {
    "description": "Criticality tier",
    "enum": [
     "critical",
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "id": {
    "description": "Criticality modifier ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "modifier": {
    "description": "Multiplier from 0.1 to 1.9; below 1 tightens, above 1 relaxes",
    "maximum": 1.9,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_criticality_modifier",
 "title": "Update criticality modifier"
}
