{
 "description": "Send an email from a Lettio mailbox. Use deliberately \u2014 this really sends.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account": {
    "description": "Which configured account to send from.",
    "type": "string"
   },
   "body": {
    "description": "Plain-text body.",
    "type": "string"
   },
   "cc": {
    "description": "Optional Cc recipients.",
    "items": {
     "format": "email",
     "type": "string"
    },
    "type": "array"
   },
   "subject": {
    "description": "Subject line.",
    "type": "string"
   },
   "to": {
    "description": "Recipient email addresses.",
    "items": {
     "format": "email",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "to",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "send_email"
}
