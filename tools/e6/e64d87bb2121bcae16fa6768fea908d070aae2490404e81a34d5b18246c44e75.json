{"annotations":{"openWorldHint":true,"readOnlyHint":true},"description":"List workouts/activities (runs, rides, swims, strength...) as dense summaries: id, date, type, name, duration, distance, pace or speed, HR, training load. Use for \"what did I do last week\", finding an activity id, or comparing sessions. For one activity in depth use get_activity; for weekly/monthly totals use get_period_summary. Example: {\"from\":\"2026-10-01\",\"type\":\"running\",\"limit\":10}.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"cursor":{"description":"next_cursor from the previous page","type":"string"},"from":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"limit":{"default":20,"maximum":100,"minimum":1,"type":"integer"},"sort":{"default":"desc","enum":["desc","asc"],"type":"string"},"to":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"type":{"description":"Garmin type key, e.g. running, trail_running, cycling, lap_swimming, strength_training; partial match. All keys: resource garmin://activity-types","type":"string"}},"type":"object"},"name":"get_activities","outputSchema":{"$defs":{"ResponseMeta":{"additionalProperties":{},"properties":{"coverage":{},"fetched_at":{"type":"string"},"note":{"type":"string"},"source":{"enum":["cache","live","partial","local"],"type":"string"},"sync_hint":{}},"required":["source"],"type":"object"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"data":{"additionalProperties":{},"properties":{"activities":{"items":{"additionalProperties":{},"properties":{"avg_hr_bpm":{"type":"number"},"avg_pace":{"type":"string"},"avg_power_w":{"type":"number"},"avg_speed_kmh":{"type":"number"},"calories_kcal":{"type":"number"},"date":{"type":"string"},"distance_km":{"type":"number"},"duration":{"type":"string"},"elevation_gain_m":{"type":"number"},"id":{"type":"number"},"max_hr_bpm":{"type":"number"},"name":{"type":"string"},"start_local":{"type":"string"},"training_effect":{},"training_load":{"type":"number"},"type":{"type":"string"}},"required":["id"],"type":"object"},"type":"array"},"next_cursor":{"type":"string"}},"type":"object"},"meta":{"$ref":"#/$defs/ResponseMeta"}},"required":["data","meta"],"type":"object"},"title":"List activities"}
