{
 "description": "Navigate the shared tab to a URL, or go back, forward, or reload.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "back",
     "forward",
     "reload"
    ],
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browser_navigate"
}
