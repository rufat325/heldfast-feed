{
 "description": "Get pairwise price spreads across chains for a given provider and symbol. Useful for cross-chain arbitrage and risk tracking.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "baseChain": {
    "description": "Base chain for spread calculation",
    "enum": [
     "ethereum",
     "arbitrum",
     "optimism",
     "polygon",
     "solana",
     "avalanche",
     "fantom",
     "cronos",
     "juno",
     "cosmos",
     "osmosis",
     "bnb-chain",
     "base",
     "scroll",
     "zksync",
     "aptos",
     "sui",
     "gnosis",
     "mantle",
     "linea",
     "celestia",
     "injective",
     "sei",
     "tron",
     "ton",
     "near",
     "aurora",
     "celo",
     "starknet",
     "blast",
     "cardano",
     "polkadot",
     "kava",
     "moonbeam",
     "moonriver",
     "metis",
     "starkex",
     "stellar",
     "flare",
     "supra-chain",
     "bandchain"
    ],
    "type": "string"
   },
   "provider": {
    "description": "Oracle provider name",
    "enum": [
     "chainlink",
     "api3",
     "redstone",
     "dia",
     "winklink",
     "supra",
     "twap",
     "reflector",
     "flare",
     "band"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Asset symbol",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_cross_chain_spreads"
}
