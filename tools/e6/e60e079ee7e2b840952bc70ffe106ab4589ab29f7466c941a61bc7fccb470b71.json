{
 "description": "Measure file-level Recall@K, MRR, nDCG, p95 latency and output tokens for labeled retrieval cases. Bypasses search cache. Semantic/hybrid cases use configured services and may incur API cost.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cases": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "expected_files": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      },
      "mode": {
       "enum": [
        "keyword",
        "semantic",
        "hybrid",
        "symbol",
        "regex"
       ],
       "type": "string"
      },
      "query": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "query",
      "expected_files"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "k": {
    "default": 5,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "project_name": {
    "type": "string"
   },
   "rerank": {
    "type": "boolean"
   }
  },
  "required": [
   "project_name",
   "cases"
  ],
  "type": "object"
 },
 "name": "evaluate_retrieval"
}
