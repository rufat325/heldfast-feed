 "description": "Evaluate safe standardized allow, deny, and error observations from an agent wallet or delegated signer. Use this after running a bounded provider policy test matrix to distinguish explicit provider-policy enforcement from validation or generic provider failures and to test exact execution shape separately from operation allowlisting. Accepts no credentials, wallet IDs, signatures, transactions, or raw provider responses; it evaluates caller-supplied observations and does not run the provider tests itself.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "network": {
    "description": "Network identifier used by the tested profile.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "observations": {
    "description": "Unique standardized observations. Raw provider responses, signatures, transactions, credentials, and wallet IDs are rejected.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "actual": {
       "description": "Observed high-level outcome.",
       "enum": [
        "allowed",
        "denied",
        "error"
       ],
       "type": "string"
      },
      "case": {
       "description": "Standardized mutation or control case.",
       "enum": [
        "intended",
        "missing_authorization",
        "wrong_operation",
        "duplicate_approved_action",
        "wrong_chain",
        "wrong_token_contract_or_program",
        "wrong_recipient",
        "wrong_amount",
        "wrong_function_or_instruction",
        "wrong_route_or_offer",
        "changed_protocol_challenge",
        "replay_or_reuse",
        "reordered_approved_actions",
        "mixed_unapproved_action",
        "wrong_fee_asset",
        "missing_validity"
       ],
       "type": "string"
      },
      "code": {
       "description": "Optional safe provider code only, never a raw message or payload.",
       "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,63}$",
       "type": "string"
      },
      "denialClass": {
       "description": "Where the denial or error occurred; only policy earns provider-native coverage.",
       "enum": [
        "none",
        "policy",
        "validation",
        "provider"
       ],
       "type": "string"
      }
     },
     "required": [
      "case",
      "actual",
      "denialClass"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "minItems": 1,
    "type": "array"
   },
   "profileId": {
    "description": "Caller-defined policy profile identifier with no credential or wallet secret.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "description": "Payment or execution protocol bound by the tested profile.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "description": "Wallet or delegated-signer provider name.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "profileId",
   "provider",
   "network",
   "protocol",
   "observations"
  ],
  "type": "object"
 },
