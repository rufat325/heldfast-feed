{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search for files in Nextcloud by name pattern and/or mime type",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "mime": {
    "description": "Filter by mime type prefix (e.g., 'image/', 'text/plain')",
    "type": "string"
   },
   "path": {
    "default": "/",
    "description": "Base directory to search in",
    "type": "string"
   },
   "query": {
    "description": "Search query (file name pattern)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_files",
 "title": "Search Files"
}
