{
 "description": "Create a new invoice. Supports multiple providers: FattureInCloud (IT), Stripe, Xero, QuickBooks, Holded, or local fallback.",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "Currency code (EUR, USD, GBP). Default: EUR",
    "type": "string"
   },
   "customer_email": {
    "description": "Customer email",
    "type": "string"
   },
   "customer_name": {
    "description": "Customer name",
    "type": "string"
   },
   "due_days": {
    "description": "Days until due (default 30)",
    "type": "number"
   },
   "items": {
    "description": "Line items",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "unit_price": {
       "description": "Price in cents",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "description": "Invoice notes",
    "type": "string"
   }
  },
  "required": [
   "customer_email",
   "items"
  ],
  "type": "object"
 },
 "name": "invoice_create"
}
