{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Never paste repository PAT/token values into chat or tool arguments; use the owner-authenticated Git-access form. These legacy schema fields document the underlying operation, not permission to send secrets through MCP. Inspect a retained upload or capture an HTTPS Git repository at a complete commit SHA. Git credentials are used only for fetching, never saved in the plan; captured bytes consume the account upload quota. Reads bounded tar paths and selected configuration files without executing project code. No submodules, redirects or private network origins. Saves account-owned options for up to 24 hours. Review findings before preparing or deploying. Does not guarantee build success or reserve capacity. Do not put credentials in start_command.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "required": [
      "git_url"
     ]
    },
    "required": [
     "context_id"
    ]
   },
   {
    "not": {
     "required": [
      "context_id"
     ]
    },
    "required": [
     "git_url",
     "git_commit"
    ]
   }
  ],
  "properties": {
   "context_id": {
    "pattern": "^ctx_[a-f0-9]{1,36}$",
    "type": "string"
   },
   "dockerfile_path": {
    "maxLength": 255,
    "type": "string"
   },
   "git_commit": {
    "description": "Complete commit SHA required with git_url.",
    "pattern": "^[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "git_token": {
    "description": "Optional access token used only for this fetch.",
    "maxLength": 4096,
    "type": "string"
   },
   "git_url": {
    "description": "HTTPS repository URL, mutually exclusive with context_id.",
    "maxLength": 1024,
    "type": "string"
   },
   "git_username": {
    "maxLength": 100,
    "type": "string"
   },
   "npm_workspace": {
    "description": "Optional declared npm workspace relative to project_dir (the npm root). Keeps the root lockfile and sibling workspaces; builds workspaces in declaration order and starts the selected app. Static output is relative to that workspace.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "php_document_root": {
    "maxLength": 120,
    "type": "string"
   },
   "project_dir": {
    "maxLength": 120,
    "type": "string"
   },
   "start_command": {
    "maxLength": 1000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "impreza_plan_project",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "analysis": {
      "type": "object"
     },
     "created_at": {
      "type": "string"
     },
     "executes_code": {
      "type": "boolean"
     },
     "expires_at": {
      "type": "string"
     },
     "inspection_revision": {
      "type": "string"
     },
     "inventory": {
      "type": "object"
     },
     "npm_workspace": {
      "type": [
       "string",
       "null"
      ]
     },
     "plan_id": {
      "type": "string"
     },
     "project_dir": {
      "type": "string"
     },
     "reserves_capacity": {
      "type": "boolean"
     },
     "reusable": {
      "type": "boolean"
     },
     "source": {
      "type": "object"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "plan_id",
     "status",
     "expires_at",
     "created_at",
     "reusable",
     "reserves_capacity",
     "project_dir",
     "npm_workspace",
     "analysis",
     "inventory",
     "executes_code",
     "source",
     "inspection_revision"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Inspect upload and save plan"
}
