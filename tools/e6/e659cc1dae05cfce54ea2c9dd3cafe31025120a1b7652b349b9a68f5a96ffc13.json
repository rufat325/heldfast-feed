{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Is a question about a given count stage answerable at a given time? Returns verdict ok / too-early / inside-window / too-late, settle_after, and the resolvable sources. Built to stop questions that read the provisional count when they mean the final one.",
 "inputSchema": {
  "properties": {
   "ask_at": {
    "description": "ISO date-time; default now",
    "type": "string"
   },
   "election": {
    "description": "Election id, e.g. \"brazil-general-2026\"; list ids with upcoming_elections",
    "type": "string"
   },
   "race": {
    "description": "Race id, e.g. \"president\"; optional when the election has one race",
    "type": "string"
   },
   "stage": {
    "description": "Default final-result",
    "enum": [
     "exit-poll",
     "election-night",
     "media-call",
     "intermediate-count",
     "final-result",
     "court-validation",
     "government"
    ],
    "type": "string"
   }
  },
  "required": [
   "election"
  ],
  "type": "object"
 },
 "name": "check_question",
 "outputSchema": {
  "properties": {
   "meta": {
    "description": "What this answer was built from; cite dataset_version",
    "properties": {
     "built_at": {
      "description": "When the dataset was built",
      "type": "string"
     },
     "dataset_version": {
      "description": "Dataset version",
      "type": "string"
     },
     "docs": {
      "description": "Documentation URL",
      "type": "string"
     },
     "generated_at": {
      "description": "When this answer was generated",
      "type": "string"
     },
     "licence": {
      "description": "Licence and required credit",
      "type": "string"
     }
    },
    "required": [
     "dataset_version",
     "licence"
    ],
    "type": "object"
   },
   "result": {
    "properties": {
     "ask_at": {
      "description": "Time the question would be asked (ISO)",
      "type": "string"
     },
     "detail": {
      "description": "Explanation",
      "type": "string"
     },
     "election": {
      "description": "Election id",
      "type": "string"
     },
     "race": {
      "description": "Race id",
      "type": "string"
     },
     "replaced_at": {
      "description": "When a later stage replaces this one",
      "type": [
       "string",
       "null"
      ]
     },
     "resolution_sources": {
      "items": {
       "properties": {
        "check": {
         "description": "Latest link check",
         "type": [
          "object",
          "null"
         ]
        },
        "kind": {
         "description": "race_results, feed, results_index, emb_home, directory or media",
         "type": "string"
        },
        "kindReason": {
         "description": "Why it was classified that way",
         "type": "string"
        },
        "origin": {
         "description": "race, stage or authority",
         "type": "string"
        },
        "resolvable": {
         "description": "Can this page answer a results question?",
         "type": "boolean"
        },
        "role": {
         "description": "What the page is for",
         "type": "string"
        },
        "url": {
         "description": "Source URL",
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "settle_after": {
      "description": "Earliest time the question can be settled",
      "type": [
       "string",
       "null"
      ]
     },
     "stage": {
      "description": "Count stage asked about",
      "type": "string"
     },
     "verdict": {
      "description": "ok, too-early, inside-window, too-late or no-window",
      "type": "string"
     },
     "window": {
      "description": "Expected window for one count stage",
      "properties": {
       "by": {
        "description": "Latest expected time (ISO)",
        "type": [
         "string",
         "null"
        ]
       },
       "citation": {
        "description": "Basis for the window",
        "type": "string"
       },
       "confidence": {
        "description": "announced (law or authority), precedent (last election) or estimate",
        "type": "string"
       },
       "from": {
        "description": "Earliest expected time (ISO)",
        "type": [
         "string",
         "null"
        ]
       },
       "observedAt": {
        "description": "When the authority actually published it; null until observed",
        "type": [
         "string",
         "null"
        ]
       },
       "observedSource": {
        "description": "URL that proves the observation",
        "type": [
         "string",
         "null"
        ]
       },
       "replacedAt": {
        "description": "When a later stage replaces it on the authority page",
        "type": [
         "string",
         "null"
        ]
       },
       "source": {
        "description": "Source of a stage published outside the authority page",
        "type": [
         "string",
         "null"
        ]
       },
       "stage": {
        "description": "Count stage id",
        "type": "string"
       }
      },
      "type": [
       "object",
       "null"
      ]
     }
    },
    "required": [
     "election",
     "race",
     "verdict"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "meta"
  ],
  "type": "object"
 },
 "title": "Check a question"
}
