{
 "description": "Save a delivery address for reuse. Persists across sessions in ~/.probo-connect/. Give it a name like \"office\" or \"warehouse\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "description": "The address to save",
    "properties": {
     "address_addition": {
      "description": "House number addition",
      "type": "string"
     },
     "address_city": {
      "description": "City",
      "type": "string"
     },
     "address_company_name": {
      "description": "Company name (required by Probo API)",
      "type": "string"
     },
     "address_country": {
      "description": "Country code (ISO 3166-1 alpha-2)",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "address_email": {
      "description": "Email address",
      "format": "email",
      "type": "string"
     },
     "address_first_name": {
      "description": "First name",
      "type": "string"
     },
     "address_house_number": {
      "description": "House number",
      "type": [
       "string",
       "number"
      ]
     },
     "address_last_name": {
      "description": "Last name",
      "type": "string"
     },
     "address_postal_code": {
      "description": "Postal code",
      "type": "string"
     },
     "address_street": {
      "description": "Street name",
      "type": "string"
     },
     "address_telephone_number": {
      "description": "Phone number",
      "type": "string"
     }
    },
    "required": [
     "address_company_name",
     "address_first_name",
     "address_street",
     "address_postal_code",
     "address_city",
     "address_country"
    ],
    "type": "object"
   },
   "name": {
    "description": "Name for this address, e.g. \"office\", \"warehouse\", \"client-amsterdam\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "address"
  ],
  "type": "object"
 },
 "name": "saveAddress"
}
