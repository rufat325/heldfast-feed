{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List orders, newest first. Filter by status and/or ISO date range; paginate with limit/lastKey.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "ISO date, e.g. 2026-07-01",
    "type": "string"
   },
   "lastKey": {
    "description": "Cursor from a previous page",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "pending",
     "confirmed",
     "processing",
     "shipped",
     "delivered",
     "cancelled",
     "refunded",
     "paid"
    ],
    "type": "string"
   },
   "to": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_orders"
}
