 "description": "Use this when the user asks whether to bid on one opportunity, or wants a qualification brief on it: days left, set-aside, AI fit notes, similar past awards, the firms that typically win such work and the usual award value.\n\nPass the id from a search result, and optionally my_naics (up to 10 codes) and my_set_aside to check the fit. Similar awards come from MatchAwards' award records for the same NAICS at the same agency, or at all agencies when that agency has none (basis says which); sample gives the dates covered and whether every matching record was read, so state that span rather than a longer one. Award records may be incomplete, so say so; ai text is AI-generated, so label it. Never call a firm the incumbent: these are firms that won similar work. Example: id=\"117412688283576625\".\n\nPrint url, sam_url and each award's url and source_url as markdown links.\n\nDo not use for searching (search_contracts, search_grants), for finding partners (find_teaming_partners) or for job postings.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "The id field of a search result.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "title": "Id",
    "type": "string"
   },
   "my_naics": {
    "anyOf": [
     {
      "pattern": "^\\s*\\d{6}(\\s*,\\s*\\d{6}){0,9}\\s*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Up to 10 six-digit NAICS codes, comma-separated, e.g. '236220' or '541511,541512'. A record matches on its own codes (matched_naics says which). Unknown codes are ignored.",
    "title": "My Naics"
   },
   "my_set_aside": {
    "anyOf": [
     {
      "maxLength": 40,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The user's set-aside code, e.g. 'SBA' or 'SDVOSBC', to compare with the opportunity's.",
    "title": "My Set Aside"
   }
  },
  "required": [
   "id"
  ],
  "title": "assess_opportunityArguments",
  "type": "object"
 },
