{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate AMP manifest JSON Schema"
 },
 "description": "Validate a manifest JSON string or object against the official AMP JSON Schema for its spec_version (agentmanifest-0.2 or agentmanifest-0.3). Returns errors or a success_token.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "manifest": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {},
      "description": "Parsed AMP manifest object (agentmanifest-0.2 or agentmanifest-0.3).",
      "type": "object"
     }
    ],
    "description": "Either a JSON string of the manifest, or a parsed manifest object with spec_version, name, endpoints, etc."
   }
  },
  "required": [
   "manifest"
  ],
  "type": "object"
 },
 "name": "validate_manifest_syntax",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "errors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "schema_checked": {
    "type": [
     "string",
     "null"
    ]
   },
   "spec_version": {
    "type": [
     "string",
     "null"
    ]
   },
   "success_token": {
    "type": [
     "string",
     "null"
    ]
   },
   "valid": {
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "spec_version",
   "schema_checked",
   "errors",
   "success_token"
  ],
  "type": "object"
 },
 "title": "Validate AMP manifest JSON Schema"
}
