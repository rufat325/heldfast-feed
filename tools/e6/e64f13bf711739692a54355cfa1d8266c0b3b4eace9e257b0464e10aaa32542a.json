 "description": "Use this when the user budgets an employee for next year or a future date and asks how the statutory employer cost will move (e.g. \"what will this hire in Brazil cost the employer in January 2027?\"). Returns the cost today and at that date (by default 1 January of next year), at the same gross salary and exchange rate, applying only the enacted dated changes recorded for the country; changes announced in a budget come in a separate, flagged variant, and dates deduced from a source are flagged. A country whose changes are not tracked yet gets today's cost and \"not yet tracked\", never a projection. Amounts given in the local currency come back in it, with the USD in brackets. Data snapshot 2026-10-13. Cost comparison, not legal or tax advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Override an adjustable assumption the country declares, e.g. {\"basic_share_of_gross\": 0.6}. See `assumptions` in an employer_cost answer.",
    "type": "object"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code (\"DE\") or country name (\"Germany\")",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "on_date": {
    "description": "Date of the projection, YYYY-MM-DD. Omit for 1 January of the year after the data snapshot.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "payments_per_year": {
    "description": "With salary_period \"month\" only: the total number of monthly salaries the contract pays in a year, statutory ones included (e.g. 14). Omit to use the statutory number of the country.",
    "maximum": 16,
    "minimum": 12,
    "type": "number"
   },
   "salary": {
    "description": "Gross salary, a year unless salary_period is \"month\". Omit to use the country's example salary.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "salary_currency": {
    "default": "USD",
    "description": "Currency of `salary`: USD, or the local currency of the country",
    "enum": [
     "USD",
     "local"
    ],
    "type": "string"
   },
   "salary_period": {
    "default": "year",
    "description": "Whether the salary is a year (default) or a month. Pass a monthly salary as the user gives it, with \"month\": the statutory number of monthly payments of the country (13th, 14th month) is applied, see salary_basis in the answer.",
    "enum": [
     "year",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
