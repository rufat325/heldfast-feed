{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "profile",
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add Wedding Event"
 },
 "description": "Creates an event in the selected wedding, with its name, type, date, time and optional venue, dress code and description. Requires sign-in and an Aisle membership.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "Event date/time (ISO format)",
    "type": "string"
   },
   "description": {
    "description": "Event description",
    "type": "string"
   },
   "dress_code": {
    "description": "Dress code (e.g. Black Tie, Smart Casual)",
    "type": "string"
   },
   "end_time": {
    "description": "Event end time (ISO format)",
    "type": "string"
   },
   "name": {
    "description": "Event name",
    "type": "string"
   },
   "type": {
    "description": "Event type",
    "enum": [
     "welcome_dinner",
     "ceremony",
     "reception",
     "brunch",
     "rehearsal",
     "cocktail_hour",
     "after_party",
     "activity",
     "other"
    ],
    "type": "string"
   },
   "venue_address": {
    "description": "Venue address",
    "type": "string"
   },
   "venue_name": {
    "description": "Venue name for this event",
    "type": "string"
   },
   "wedding_id": {
    "description": "Identifier of a wedding the signed-in account can manage. Required when the account has multiple weddings.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "date"
  ],
  "type": "object"
 },
 "name": "add_my_event",
 "title": "Add Wedding Event"
}
