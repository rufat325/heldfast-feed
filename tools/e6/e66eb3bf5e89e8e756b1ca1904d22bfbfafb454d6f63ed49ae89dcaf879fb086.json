{
 "description": "Edit any entry of your app's community \u2014 yours or a user's \u2014 as the developer: title, summary, category, tags, lang, i18n (replaces the whole map; null clears it) and/or payload (replaced whole). Only the fields you pass change. Editing a user's entry records that you did and tells them. Use it to keep a community fed from elsewhere in sync.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "The app public ID",
    "type": "string"
   },
   "category": {
    "maxLength": 40,
    "type": "string"
   },
   "entryId": {
    "description": "The entry id",
    "type": "string"
   },
   "i18n": {
    "anyOf": [
     {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "summary": {
         "maxLength": 500,
         "type": "string"
        },
        "title": {
         "maxLength": 120,
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Title/summary in other languages; replaces the whole map, null clears it"
   },
   "lang": {
    "maxLength": 8,
    "type": "string"
   },
   "payload": {
    "description": "Replaces the stored payload whole"
   },
   "summary": {
    "maxLength": 500,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 32,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "maxLength": 120,
    "type": "string"
   }
  },
  "required": [
   "appId",
   "entryId"
  ],
  "type": "object"
 },
 "name": "neblla_update_community_entry"
}
