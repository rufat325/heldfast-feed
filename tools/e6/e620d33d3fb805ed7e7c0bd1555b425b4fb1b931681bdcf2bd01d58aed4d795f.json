{
 "description": "Add a new IMAP or iCloud email account (Gmail and Outlook require the setup wizard for OAuth)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "email": {
    "description": "Email address",
    "type": "string"
   },
   "host": {
    "description": "IMAP server hostname",
    "type": "string"
   },
   "name": {
    "description": "Display name for the account",
    "type": "string"
   },
   "password": {
    "description": "Password or app-specific password",
    "type": "string"
   },
   "port": {
    "description": "IMAP server port (default: 993)",
    "type": "number"
   },
   "provider": {
    "description": "Provider type: \"imap\" or \"icloud\" (Gmail/Outlook require OAuth setup wizard)",
    "type": "string"
   },
   "smtpHost": {
    "description": "SMTP server hostname",
    "type": "string"
   },
   "smtpPort": {
    "description": "SMTP server port",
    "type": "number"
   },
   "tls": {
    "description": "Use TLS (default: true)",
    "type": "boolean"
   }
  },
  "required": [
   "provider",
   "name",
   "email"
  ],
  "type": "object"
 },
 "name": "email_add_account"
}
