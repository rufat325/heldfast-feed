{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get one flight offer"
 },
 "description": "Returns one fare from a recent flight search, by its offer_id: the per-person price, the flights, a booking link and the time until which the offer_id is valid. Works for 30 minutes after the search.",
 "inputSchema": {
  "properties": {
   "offer_id": {
    "description": "offer_id of a fare, exactly as the flight search returned it.",
    "type": "string"
   }
  },
  "required": [
   "offer_id"
  ],
  "type": "object"
 },
 "name": "egf_get_offer",
 "outputSchema": {
  "properties": {
   "booking_url": {
    "description": "Absolute https link where the traveller books this fare.",
    "type": "string"
   },
   "carriers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "currency": {
    "description": "ISO 4217 code.",
    "type": "string"
   },
   "departure": {
    "description": "Local departure, ISO 8601 (YYYY-MM-DDTHH:MM).",
    "type": "string"
   },
   "flight_numbers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "offer_id": {
    "type": "string"
   },
   "price": {
    "description": "Per person, in currency.",
    "type": "number"
   },
   "return": {
    "description": "Local return departure, ISO 8601 (YYYY-MM-DDTHH:MM).",
    "type": "string"
   },
   "stops_back": {
    "type": "integer"
   },
   "stops_out": {
    "type": "integer"
   },
   "valid_until": {
    "description": "ISO 8601 date-time. After it, search again: the price is live.",
    "type": "string"
   }
  },
  "required": [
   "offer_id",
   "currency",
   "carriers",
   "flight_numbers",
   "booking_url",
   "valid_until"
  ],
  "type": "object"
 },
 "title": "Get one flight offer"
}
