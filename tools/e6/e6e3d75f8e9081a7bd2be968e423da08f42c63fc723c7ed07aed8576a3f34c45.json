{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Hybrid (keyword + semantic) search over servers and their tools. Filter by connection class to keep only what you can reach autonomously (R0, R1).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "developer-tools",
     "databases",
     "web-search",
     "files-storage",
     "communication",
     "productivity",
     "ai-ml",
     "cloud-devops",
     "finance",
     "commerce",
     "maps-travel",
     "media",
     "science-health",
     "security",
     "iot-automation",
     "legal-government"
    ],
    "type": "string"
   },
   "class": {
    "description": "Connection classes to keep, e.g. ['R0','R1']",
    "items": {
     "enum": [
      "R0",
      "R1",
      "R2",
      "L0",
      "unknown"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "exclude_flags": {
    "description": "Trust flags, any of which excludes a server, e.g. ['multi-version-spam','duplicate-repo']",
    "items": {
     "enum": [
      "multi-version-spam",
      "duplicate-repo",
      "no-repository",
      "no-connection",
      "deprecated",
      "unreachable",
      "blocked",
      "deleted"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "flags": {
    "description": "Trust flags that must all be present",
    "items": {
     "enum": [
      "multi-version-spam",
      "duplicate-repo",
      "no-repository",
      "no-connection",
      "deprecated",
      "unreachable",
      "blocked",
      "deleted"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Results to return (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_trust": {
    "description": "Minimum trust score 0-100",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "What you want to do, in plain words, e.g. 'send an email' or 'query postgres'",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "transport": {
    "enum": [
     "streamable-http",
     "sse"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "hybrid",
     "keyword"
    ],
    "type": "string"
   },
   "next_actions": {
    "description": "Follow-up calls: action is the tool, arguments are ready to pass ({placeholders} are yours to fill)",
    "items": {
     "additionalProperties": {},
     "properties": {
      "action": {
       "type": "string"
      },
      "arguments": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "autonomous": {
       "description": "True when an agent can connect with no human step",
       "type": "boolean"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "connection_class": {
       "description": "R0 remote no auth, R1 static secret, R2 OAuth, L0 local package",
       "enum": [
        "R0",
        "R1",
        "R2",
        "L0",
        "unknown"
       ],
       "type": "string"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "human_steps": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "matched_tools": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "description": {
          "type": [
           "string",
           "null"
          ]
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "description"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Official reverse-DNS name, the argument of every other tool",
       "type": "string"
      },
      "quality_label": {
       "description": "strong, good, needs work, poor, new, not scored or blocked",
       "type": "string"
      },
      "quality_score": {
       "type": [
        "number",
        "null"
       ]
      },
      "score": {
       "description": "Relevance of this result to the query",
       "type": "number"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "tool_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "trust_flags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "trust_score": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "title",
      "description",
      "connection_class",
      "autonomous",
      "human_steps",
      "categories",
      "trust_score",
      "trust_flags",
      "quality_score",
      "quality_label",
      "tool_count",
      "score",
      "matched_tools"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "mode",
   "count",
   "results",
   "next_actions"
  ],
  "type": "object"
 },
 "title": "Search MCP servers by intent"
}
