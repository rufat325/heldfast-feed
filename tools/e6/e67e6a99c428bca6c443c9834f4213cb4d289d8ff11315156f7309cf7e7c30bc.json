{
 "description": "Rotate specified pages of a PDF by 90, 180, or 270 degrees.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "degrees": {
    "description": "Rotation angle",
    "enum": [
     "90",
     "180",
     "270"
    ],
    "type": "string"
   },
   "pages": {
    "description": "Pages to rotate (e.g. \"1,3,5\" or \"all\")",
    "type": "string"
   },
   "pdf_base64": {
    "description": "Base64-encoded PDF file",
    "type": "string"
   }
  },
  "required": [
   "pdf_base64",
   "degrees"
  ],
  "type": "object"
 },
 "name": "bytario_pdf_rotate"
}
