   "family": "dataset",
   "help": {
    "arguments": {
     "tool_name": "get_event"
    },
    "tool": "get_tool_help"
   },
   "limits": {
    "account": 500,
    "free": 500,
    "paid": 500
   },
   "pricing": "by_pack",
   "pricing_authority": {
    "field": "packs[].material_policy",
    "tool": "get_catalog"
   }
  },
  "com.daedalmap/data-contract": {
   "canonical_help_tool": "get_tool_help",
   "contract_version": "1.0.0",
   "input_family": "exact_event",
   "result_family": "relationships"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve one exact disaster event and explicitly requested relationships, affected places, native observations, or geometry. Use get_data to obtain the stable event_id first.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "event_id": {
    "description": "Exact stable event_id returned by a disaster-pack get_data row.",
    "minLength": 1,
    "type": "string"
   },
   "geometry_mode": {
    "default": "current",
    "description": "current returns the representative/current shape; timeline returns bounded progression frames where supported.",
    "enum": [
     "current",
     "timeline"
    ],
    "type": "string"
   },
   "include": {
    "description": "Optional companion layers. Omit for the lightweight event summary. Geometry is never returned implicitly.",
    "items": {
     "enum": [
      "relationships",
      "affected_places",
      "observations",
      "geometry"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   },
   "limit": {
    "default": 100,
    "description": "Per-section ceiling for relationships, affected places, observations, or geometry frames.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "pack_id": {
    "description": "Optional disaster pack hint. Recommended when known to avoid probing unrelated event sources.",
    "type": "string"
   },
   "relationship_depth": {
    "default": 1,
    "description": "Bounded cross-hazard traversal depth when relationships is included.",
    "maximum": 2,
    "minimum": 1,
    "type": "integer"
   },
   "request_id": {
    "description": "Optional caller-supplied request id for tracing.",
    "type": "string"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "get_event",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "anyOf": [
   {
    "required": [
     "event_id",
     "pack_id",
     "event"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "affected_places": {
    "type": "object"
   },
   "available": {
    "type": "object"
   },
   "clarification": {
    "type": "object"
   },
   "error": {
    "additionalProperties": true,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {
      "type": "object"
     },
     "message": {
      "type": "string"
     },
     "retry_hint": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "event": {
    "type": "object"
   },
   "event_id": {
    "type": "string"
   },
   "event_type": {
    "type": "string"
   },
   "geometry": {
    "type": "object"
   },
   "guidance": {
    "type": "object"
   },
   "included": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_step": {
    "additionalProperties": true,
    "anyOf": [
     {
      "required": [
       "action"
      ]
     },
     {
      "required": [
       "tool"
      ]
     }
    ],
    "properties": {
     "action": {
      "type": "string"
     },
     "arguments": {
      "type": "object"
     },
     "tool": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "next_steps": {
    "type": "object"
   },
   "observations": {
    "type": "object"
   },
   "pack_id": {
    "type": "string"
   },
   "provenance": {
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "relationships": {
    "type": "object"
   },
   "request_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "schema_class": {
    "type": "string"
   },
   "source_id": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Get Event"
}
