{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a Cloud Hadoop notebook instance attached to an existing cluster",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Object Storage bucket name",
    "type": "string"
   },
   "cloudHadoopInstanceNo": {
    "description": "Cluster instance number to attach",
    "type": "string"
   },
   "cloudHadoopNotebookComponent": {
    "description": "Notebook component code (use ncloud_hadoop_list_notebook_components)",
    "type": "string"
   },
   "cloudHadoopNotebookImageProductCode": {
    "description": "Notebook image code. Default: latest",
    "type": "string"
   },
   "cloudHadoopNotebookName": {
    "description": "Notebook name (3-15 chars, lowercase+numbers+'-')",
    "type": "string"
   },
   "engineVersionCode": {
    "description": "Engine version code (for Rocky)",
    "type": "string"
   },
   "loginKeyName": {
    "description": "Login key name for SSH access",
    "type": "string"
   },
   "notebookNodeDataStorageSize": {
    "description": "Storage GB (when useNotebookBlockStorage=true)",
    "type": "number"
   },
   "notebookNodeDataStorageTypeCode": {
    "description": "Storage type SSD|HDD|CB2 (when useNotebookBlockStorage=true)",
    "type": "string"
   },
   "notebookNodeProductCode": {
    "description": "Notebook node server type code",
    "type": "string"
   },
   "notebookNodeSubnetNo": {
    "description": "Notebook node subnet number",
    "type": "string"
   },
   "regionCode": {
    "description": "Region code",
    "type": "string"
   },
   "useNotebookBlockStorage": {
    "description": "Add block storage (default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "cloudHadoopNotebookName",
   "cloudHadoopNotebookComponent",
   "cloudHadoopInstanceNo",
   "bucketName",
   "notebookNodeSubnetNo",
   "loginKeyName"
  ],
  "type": "object"
 },
 "name": "ncloud_hadoop_create_notebook"
}
