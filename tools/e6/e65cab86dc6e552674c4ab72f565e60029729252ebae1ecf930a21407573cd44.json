{
 "description": "Apply text formatting to elements in Google Slides",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "bold": {
    "description": "Make text bold",
    "type": "boolean"
   },
   "endIndex": {
    "description": "End index (0-based)",
    "type": "number"
   },
   "fontFamily": {
    "description": "Font family name",
    "type": "string"
   },
   "fontSize": {
    "description": "Font size in points",
    "type": "number"
   },
   "foregroundColor": {
    "description": "Text color (RGB values 0-1)",
    "properties": {
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "italic": {
    "description": "Make text italic",
    "type": "boolean"
   },
   "objectId": {
    "description": "Object ID of the text element",
    "type": "string"
   },
   "presentationId": {
    "description": "Presentation ID",
    "type": "string"
   },
   "startIndex": {
    "description": "Start index (0-based)",
    "type": "number"
   },
   "strikethrough": {
    "description": "Strikethrough text",
    "type": "boolean"
   },
   "underline": {
    "description": "Underline text",
    "type": "boolean"
   }
  },
  "required": [
   "presentationId",
   "objectId"
  ],
  "type": "object"
 },
 "name": "formatGoogleSlidesText"
}
