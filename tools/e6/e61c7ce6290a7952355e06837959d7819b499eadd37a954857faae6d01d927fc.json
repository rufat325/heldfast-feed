{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mimiq:use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Test a UI component"
 },
 "description": "Show a UI component (a button, card, form, modal, navigation or pricing table) to simulated people and hear whether they understand it, trust it and would use it. Provide component_html, component_text, or both. With a key, the result ends with a link to the full report in the Mimiq app.",
 "inputSchema": {
  "properties": {
   "audience": {
    "description": "Who the simulated people should be, in plain words, e.g. \"startup founders in SF\" or \"parents shopping for kids toys\". If omitted, Mimiq picks the likely audience from the content.",
    "maxLength": 500,
    "type": "string"
   },
   "component_html": {
    "description": "The HTML of the component.",
    "maxLength": 50000,
    "type": "string"
   },
   "component_text": {
    "description": "A description of the component (instead of, or with, the HTML).",
    "maxLength": 20000,
    "type": "string"
   },
   "count": {
    "default": 10,
    "description": "How many simulated people (default 10, max 50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "goal": {
    "description": "What the component should achieve, e.g. \"get people to click upgrade\".",
    "maxLength": 500,
    "type": "string"
   },
   "timeout_seconds": {
    "default": 180,
    "maximum": 900,
    "minimum": 30,
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "mimiq.test_component",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "call": {
    "additionalProperties": true,
    "properties": {
     "headline": {
      "type": "string"
     },
     "pick": {
      "type": [
       "string",
       "null"
      ]
     },
     "reason": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "report_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "run": {
    "additionalProperties": true,
    "type": "object"
   },
   "status": {
    "type": "string"
   },
   "summary_card": {
    "type": "string"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "tool"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mimiq:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Test a UI component"
}
