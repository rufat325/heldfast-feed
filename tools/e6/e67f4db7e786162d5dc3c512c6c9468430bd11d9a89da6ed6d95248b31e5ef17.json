{
 "description": "Simulate shipping rates for items to a postal code",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "Country code (default BRA)",
    "type": "string"
   },
   "items": {
    "description": "Items to simulate",
    "items": {
     "properties": {
      "id": {
       "description": "SKU ID",
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "seller": {
       "description": "Seller ID (default 1)",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "postalCode": {
    "description": "Destination postal code (CEP)",
    "type": "string"
   }
  },
  "required": [
   "postalCode",
   "items"
  ],
  "type": "object"
 },
 "name": "get_shipping_rates"
}
