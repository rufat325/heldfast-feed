{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Post a custom event to Datadog (supports markdown, @mentions)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregationKey": {
    "description": "Aggregation key for grouping events",
    "type": "string"
   },
   "alertType": {
    "description": "Alert type",
    "enum": [
     "error",
     "warning",
     "info",
     "success"
    ],
    "type": "string"
   },
   "host": {
    "description": "Associated host name",
    "type": "string"
   },
   "priority": {
    "description": "Event priority",
    "enum": [
     "low",
     "normal"
    ],
    "type": "string"
   },
   "sourceTypeName": {
    "description": "Source type name. Example: my_app",
    "type": "string"
   },
   "tags": {
    "description": "Tags for the event. Example: [\"env:prod\", \"deploy\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "text": {
    "description": "Event body (supports markdown, max 4000 chars). Example: Deployed v1.2.3 to production",
    "type": "string"
   },
   "title": {
    "description": "Event title. Example: Deployment completed",
    "type": "string"
   }
  },
  "required": [
   "title",
   "text"
  ],
  "type": "object"
 },
 "name": "post-event"
}
