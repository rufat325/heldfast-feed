{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "taptax:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create an invoice"
 },
 "description": "Create and save a draft invoice in the signed-in person's TapTax account from a client name and one or more line items. No saved client, earlier invoice or client email is needed to create it; an email is only needed later, to send it. It is numbered in their sequence, uses their saved business details, and is not sent. Free plans include 3 invoices; paid plans are unlimited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "clientAddress": {
    "maxLength": 500,
    "type": "string"
   },
   "clientEmail": {
    "description": "The client email; required to send the invoice",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "clientName": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "dueDate": {
    "description": "Exact due date; otherwise dueInDays applies",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dueInDays": {
    "default": 30,
    "description": "Payment terms in days when no dueDate is given (0 = due on receipt)",
    "maximum": 120,
    "minimum": 0,
    "type": "integer"
   },
   "issueDate": {
    "description": "Defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "description": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "default": 1,
       "exclusiveMinimum": 0,
       "maximum": 99999,
       "type": "number"
      },
      "unitPrice": {
       "description": "In pounds, before VAT",
       "maximum": 10000000,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "notes": {
    "maxLength": 2000,
    "type": "string"
   },
   "vatRatePercent": {
    "description": "VAT rate for a VAT-registered business, e.g. 20",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "clientName",
   "items"
  ],
  "type": "object"
 },
 "name": "create_invoice",
 "title": "Create an invoice"
}
