{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List events from a calendar.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "calendarId": {
    "description": "Calendar ID (use 'primary' for main calendar)",
    "type": "string"
   },
   "maxResults": {
    "description": "Max events to return",
    "type": "number"
   },
   "orderBy": {
    "description": "Sort order: startTime or updated",
    "type": "string"
   },
   "q": {
    "description": "Free-text search",
    "type": "string"
   },
   "singleEvents": {
    "description": "Expand recurring events (usually true)",
    "type": "boolean"
   },
   "timeMax": {
    "description": "Upper bound (RFC3339)",
    "type": "string"
   },
   "timeMin": {
    "description": "Lower bound (RFC3339, e.g. \"2026-03-07T00:00:00Z\")",
    "type": "string"
   }
  },
  "required": [
   "calendarId"
  ],
  "type": "object"
 },
 "name": "calendar_events_list"
}
