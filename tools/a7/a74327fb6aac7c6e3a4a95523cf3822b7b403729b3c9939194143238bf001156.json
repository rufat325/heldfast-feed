{
 "description": "Check if a specific usage type is permitted under a governance block's terms.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "block": {
    "description": "Governance block JSON string",
    "type": "string"
   },
   "usage": {
    "enum": [
     "inference",
     "training",
     "redistribution",
     "derivative",
     "caching"
    ],
    "type": "string"
   }
  },
  "required": [
   "block",
   "usage"
  ],
  "type": "object"
 },
 "name": "check_usage_permitted"
}
