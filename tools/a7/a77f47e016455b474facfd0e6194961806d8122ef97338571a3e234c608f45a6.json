  "title": "Get a token"
 },
 "description": "Get a token by ticker on one chain\n\nThe leading token with this ticker on one chain: market data (price, market cap, liquidity, holders), links, and its registration if it has one (`hasCrown`, `registration.owner`). When several tokens share a ticker on a chain, this returns the registered one if there is one, else the largest; `tokenAddress` names the exact contract. Other tokens with the same ticker are not in this answer.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "Chain key identifier",
    "enum": [
     "eth",
     "arbitrum",
     "arbitrum-sepolia",
     "base",
     "polygon",
     "bnb",
     "avax",
     "robinhood",
     "solana",
     "solana-devnet"
    ],
    "examples": [
     "arbitrum"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Token ticker, e.g. PEPE (case-insensitive).",
    "examples": [
     "PEPE"
    ],
    "type": "string"
   },
   "tokenAddress": {
    "description": "The token's contract address (or Solana mint), when the chain has several tokens with this ticker.",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_token",
