{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Delete skills by name. Optionally delete the skill files from disk.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deleteFiles": {
    "default": false,
    "type": "boolean"
   },
   "names": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "soft": {
    "default": false,
    "description": "If true, soft delete (set deletedAt) instead of hard delete",
    "type": "boolean"
   }
  },
  "required": [
   "names"
  ],
  "type": "object"
 },
 "name": "delete_skills",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deleted": {
    "description": "Number of skills deleted",
    "type": "number"
   },
   "filesDeleted": {
    "type": "number"
   }
  },
  "required": [
   "deleted"
  ],
  "type": "object"
 },
 "title": "Delete Skills"
}
