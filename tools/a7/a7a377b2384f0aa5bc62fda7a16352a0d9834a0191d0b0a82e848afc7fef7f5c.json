{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Look up a submitted trade by transaction hash \u2014 the by-tx path for crash recovery. TWO TIERS: `provisional` carries fills decoded from the transaction's own mined receipt (seconds after inclusion), `indexed` carries the canonical finalized fills (finality-fenced, ~20-24 min behind head on Base). Every fill and the envelope itself carry `finality`. `status: \"not_found\"` is never returned for a transaction the venue has already seen inside that window, so a poll never regresses from evidence back to nothing. Act on provisional; settle on finalized.",
 "inputSchema": {
  "properties": {
   "chainId": {
    "description": "Active chain the transaction was broadcast on. Discover IDs via GET /discover/chains.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "txHash": {
    "description": "Transaction hash to look up (0x + 64 hex).",
    "type": "string"
   }
  },
  "required": [
   "txHash",
   "chainId"
  ],
  "type": "object"
 },
 "name": "problee_get_trade_status",
 "outputSchema": {
  "$defs": {
   "AgentTradeFill": {
    "additionalProperties": false,
    "properties": {
     "batchNonce": {
      "anyOf": [
       {
        "pattern": "^\\d+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "batchTxHash": {
      "type": [
       "string",
       "null"
      ]
     },
     "chainId": {
      "$ref": "#/$defs/ChainId"
     },
     "clOrdId": {
      "$ref": "#/$defs/OrderbookClOrdId"
     },
     "collateralDelta": {
      "type": "string"
     },
     "direction": {
      "enum": [
       "buy",
       "sell",
       "redeem"
      ],
      "type": "string"
     },
     "executionStatus": {
      "const": "executed",
      "type": "string"
     },
     "explorerUrl": {
      "format": "uri",
      "type": "string"
     },
     "feePaid": {
      "type": [
       "string",
       "null"
      ]
     },
     "finality": {
      "$ref": "#/$defs/TradeFinality"
     },
     "id": {
      "type": "string"
     },
     "liquidityRole": {
      "enum": [
       "maker",
       "taker"
      ],
      "type": "string"
     },
     "logicalTradeKey": {
      "type": "string"
     },
     "marketAddress": {
      "$ref": "#/$defs/EvmAddress"
     },
     "outcomeIndex": {
      "anyOf": [
       {
        "const": 0,
        "type": "number"
       },
       {
        "const": 1,
        "type": "number"
       },
       {
        "const": 2,
        "type": "number"
       }
      ]
     },
     "priceDecimal": {
      "type": "string"
     },
     "priceE18": {
      "type": "string"
     },
     "priceRaw": {
      "type": "string"
     },
     "priceRawScale": {
      "enum": [
       "fixed_1e18",
       "decimal_0_1"
      ],
      "type": "string"
     },
     "principalReceipt": {
      "additionalProperties": false,
      "properties": {
       "authority": {
        "const": "committed_ledger",
        "type": "string"
       },
       "collateralDelta": {
        "maxLength": 80,
        "pattern": "^-?\\d+$",
        "type": "string"
       },
       "collateralEntryKey": {
        "anyOf": [
         {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "feeEntryKey": {
        "anyOf": [
         {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "feePaid": {
        "maxLength": 78,
        "pattern": "^\\d+$",
        "type": "string"
       },
       "movementKey": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "shareEntryKey": {
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "authority",
       "movementKey",
       "collateralDelta",
       "feePaid",
       "shareEntryKey",
       "collateralEntryKey",
       "feeEntryKey"
      ],
      "type": "object"
     },
     "publicationState": {
      "enum": [
       "pending",
       "published",
       "finalized"
      ],
      "type": "string"
     },
     "recordedOn": {
      "$ref": "#/$defs/RecordedOn"
     },
     "settlementMode": {
      "enum": [
       "committed",
       "onchain"
      ],
      "type": "string"
     },
     "settlementState": {
      "$ref": "#/$defs/FillSettlementState"
     },
     "sharesDelta": {
      "type": "string"
     },
     "side": {
      "type": "string"
     },
     "timestamp": {
      "anyOf": [
       {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       {
        "format": "date-time",
        "type": "string"
       }
      ]
     },
     "trader": {
      "$ref": "#/$defs/EvmAddress"
     },
     "txHash": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "chainId",
     "txHash",
     "id",
     "marketAddress",
     "trader",
     "side",
     "outcomeIndex",
     "direction",
     "sharesDelta",
     "collateralDelta",
     "priceRaw",
     "priceRawScale",
     "priceDecimal",
     "priceE18",
     "timestamp"
    ],
    "type": "object"
   },
   "ChainId": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "FillSettlementState": {
    "enum": [
     "pending",
     "committed",
     "finalized"
    ],
    "type": "string"
   },
   "OrderbookClOrdId": {
    "maxLength": 200,
    "type": "string"
   },
   "RecordedOn": {
    "additionalProperties": false,
    "properties": {
     "addressTransfersUrl": {
      "format": "uri",
      "type": "string"
     },
     "explorer": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     "txUrl": {
      "format": "uri",
      "type": "string"
     },
     "verifyUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "explorer"
    ],
    "type": "object"
   },
   "TradeFinality": {
    "enum": [
     "provisional",
     "finalized"
    ],
    "type": "string"
   },
   "TradeStatusResponse": {
    "additionalProperties": false,
    "properties": {
     "chainId": {
      "$ref": "#/$defs/ChainId"
     },
     "explorerUrl": {
      "format": "uri",
      "type": "string"
     },
     "finality": {
      "$ref": "#/$defs/TradeFinality"
     },
     "indexed": {
      "items": {
       "$ref": "#/$defs/AgentTradeFill"
      },
      "type": "array"
     },
     "pending": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "createdAt": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "marketAddress": {
          "$ref": "#/$defs/EvmAddress"
         },
         "side": {
          "enum": [
           "outcome1",
           "outcome2",
           "outcome3"
          ],
          "type": "string"
         },
         "status": {
          "enum": [
           "broadcasted",
           "mined"
          ],
          "type": "string"
         },
         "userAddress": {
          "$ref": "#/$defs/EvmAddress"
         }
        },
        "required": [
         "marketAddress",
         "userAddress",
         "status",
         "createdAt"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "provisional": {
      "items": {
       "$ref": "#/$defs/AgentTradeFill"
      },
      "type": "array"
     },
     "status": {
      "enum": [
       "indexed",
       "pending",
       "not_found"
      ],
      "type": "string"
     },
     "txHash": {
      "type": "string"
     }
    },
    "required": [
     "txHash",
     "chainId",
     "status",
     "indexed",
     "pending"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/TradeStatusResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Lookup a submitted trade by transaction hash and chain"
}
