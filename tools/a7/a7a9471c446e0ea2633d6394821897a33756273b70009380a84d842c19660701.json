{
 "_meta": {
  "ui": {
   "visibility": [
    "app",
    "model"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Poll Search Results"
 },
 "description": "Returns the current results of a hotel search session started by search_hotels_live: hotels with their price from each source, and OpenTravel direct listings with the propertyId that get_hotel_detail and get_hotel_info take. Results can be partial while the search runs; status reads 'completed' once every source has answered.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "description": "Optional override for the area filter captured at search time",
    "maxLength": 120,
    "type": "string"
   },
   "hotelName": {
    "description": "Optional override for the hotel-name filter captured at search time",
    "maxLength": 200,
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max hotels to return; 0 = all (default 50)",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "nights": {
    "description": "Number of nights",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Skip first N hotels for pagination (default 0)",
    "minimum": 0,
    "type": "integer"
   },
   "priceCurrency": {
    "description": "ISO 4217 code of priceMin/priceMax; defaults to the UI language's currency",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "priceMax": {
    "description": "Optional override for the maximum-price filter",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "priceMin": {
    "description": "Optional override for the minimum-price filter",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "sessionId": {
    "description": "Session ID from search_hotels_live",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "nights"
  ],
  "type": "object"
 },
 "name": "poll_search_results",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "agodaStatus": {
    "type": "string"
   },
   "bookingStatus": {
    "type": "string"
   },
   "cached": {
    "type": "boolean"
   },
   "checkIn": {
    "type": "string"
   },
   "checkOut": {
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "fxRates": {
    "additionalProperties": {
     "type": "number"
    },
    "type": "object"
   },
   "hasMore": {
    "type": "boolean"
   },
   "hotels": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "imageUrl": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "prices": {
       "additionalProperties": true,
       "properties": {
        "agoda": {
         "additionalProperties": true,
         "properties": {
          "currency": {
           "type": "string"
          },
          "price": {
           "type": "number"
          },
          "url": {
           "type": "string"
          }
         },
         "required": [
          "price",
          "currency",
          "url"
         ],
         "type": "object"
        },
        "booking": {
         "$ref": "#/properties/hotels/items/properties/prices/properties/agoda"
        },
        "traveloka": {
         "$ref": "#/properties/hotels/items/properties/prices/properties/agoda"
        }
       },
       "type": "object"
      },
      "rating": {
       "type": "number"
      },
      "reviewCount": {
       "type": "number"
      },
      "stars": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "stars",
      "rating",
      "reviewCount",
      "imageUrl",
      "location",
      "prices"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "language": {
    "enum": [
     "en",
     "vi",
     "de",
     "ja",
     "ko",
     "zh",
     "fr",
     "es",
     "ru",
     "th",
     "id"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "longStayNotice": {
    "type": [
     "string",
     "null"
    ]
   },
   "nights": {
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "opentravelIndicativeResults": {
    "items": {
     "$ref": "#/properties/opentravelResults/items"
    },
    "type": "array"
   },
   "opentravelResults": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "address": {
       "type": [
        "string",
        "null"
       ]
      },
      "availableRoomTypes": {
       "type": "number"
      },
      "cheapestPrice": {
       "type": "number"
      },
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "country": {
       "type": [
        "string",
        "null"
       ]
      },
      "countryCode": {
       "type": [
        "string",
        "null"
       ]
      },
      "currency": {
       "type": "string"
      },
      "indicativeNote": {
       "type": "string"
      },
      "mainImageUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "nights": {
       "type": "number"
      },
      "priceType": {
       "enum": [
        "available",
        "indicative"
       ],
       "type": "string"
      },
      "propertyId": {
       "type": "string"
      },
      "source": {
       "const": "OPENTRAVEL_DIRECT",
       "type": "string"
      },
      "totalForStay": {
       "type": "number"
      }
     },
     "required": [
      "propertyId",
      "name",
      "address",
      "city",
      "mainImageUrl",
      "cheapestPrice",
      "totalForStay",
      "currency",
      "nights",
      "source",
      "priceType"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "opentravelStatus": {
    "type": "string"
   },
   "progress": {
    "type": "number"
   },
   "sessionId": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "tier": {
    "type": "string"
   },
   "tier2AgodaStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "tier2BookingStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "tier2TravelokaStatus": {
    "type": [
     "string",
     "null"
    ]
   },
   "totalHotels": {
    "type": "number"
   },
   "travelokaStatus": {
    "type": "string"
   }
  },
  "required": [
   "city",
   "checkIn",
   "checkOut",
   "nights",
   "status",
   "progress",
   "bookingStatus",
   "agodaStatus",
   "travelokaStatus",
   "totalHotels",
   "hotels",
   "offset",
   "limit",
   "hasMore",
   "tier",
   "tier2AgodaStatus",
   "tier2BookingStatus",
   "tier2TravelokaStatus",
   "opentravelStatus",
   "opentravelResults",
   "opentravelIndicativeResults",
   "fxRates"
  ],
  "type": "object"
 },
 "title": "Poll Search Results"
}
