{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Model releases dated at or after an ISO 8601 time, newest first: model, lab, kind (new, version, preview, ga, open_weights), status (confirmed: a primary source from the lab's own channel; reported: none yet), the lab's announcement time, the release date the lab's model page states, when and where the release was first seen, the first primary source, the story and every source. A value the sources give only as a date has precision \"day\" and is written YYYY-MM-DD.",
 "inputSchema": {
  "properties": {
   "kind": {
    "enum": [
     "new",
     "version",
     "preview",
     "ga",
     "open_weights"
    ],
    "type": "string"
   },
   "lab": {
    "description": "lab name or key, e.g. OpenAI or mistral-ai",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "ISO 8601 date or time",
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
 "name": "list_releases",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "items": {
     "properties": {
      "announcedAt": {
       "description": "publish time of the lab's own post",
       "type": [
        "string",
        "null"
       ]
      },
      "availableAt": {
       "description": "release date the lab's model page states",
       "type": [
        "string",
        "null"
       ]
      },
      "firstPrimaryUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "firstSeenAt": {
       "type": "string"
      },
      "firstSeenSource": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "new",
        "version",
        "preview",
        "ga",
        "open_weights"
       ],
       "type": "string"
      },
      "lab": {
       "type": "string"
      },
      "labKey": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "releasedAt": {
       "description": "announcedAt, else availableAt, else firstSeenAt; YYYY-MM-DD when releasedPrecision is day",
       "type": "string"
      },
      "releasedPrecision": {
       "enum": [
        "time",
        "day"
       ],
       "type": "string"
      },
      "sources": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "status": {
       "description": "confirmed: a primary source from the lab's own channel",
       "enum": [
        "confirmed",
        "reported"
       ],
       "type": "string"
      },
      "story": {
       "type": [
        "object",
        "null"
       ]
      },
      "trackerSlug": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "model",
      "lab",
      "kind",
      "status",
      "releasedAt",
      "releasedPrecision",
      "firstSeenAt",
      "firstSeenSource",
      "sources",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Model release ledger"
}
