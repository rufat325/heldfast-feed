{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Calculate Varshaphal annual chart"
 },
 "description": "Solves the exact tropical solar-return instant for a target year and returns the sidereal annual chart, Muntha, Tajika aspect candidates, and transparent boundaries for pending Varshesha, Saham, and Mudda-Dasha rules.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "birthTimeAccuracyMinutes": {
    "default": 5,
    "maximum": 1440,
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "targetYear": {
    "maximum": 2050,
    "minimum": 1800,
    "type": "integer"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "date",
   "time",
   "targetYear"
  ],
  "type": "object"
 },
 "name": "calculate_varshaphal",
 "outputSchema": {
  "properties": {
   "annualChart": {
    "type": "object"
   },
   "muntha": {
    "type": "object"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-varshaphal-1"
   },
   "solarReturn": {
    "type": "object"
   },
   "status": {
    "type": "string"
   },
   "subject": {
    "type": "object"
   },
   "tajika": {
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "status",
   "subject",
   "solarReturn",
   "annualChart",
   "muntha",
   "tajika",
   "safety"
  ],
  "type": "object"
 },
 "title": "Calculate Varshaphal annual chart"
}
