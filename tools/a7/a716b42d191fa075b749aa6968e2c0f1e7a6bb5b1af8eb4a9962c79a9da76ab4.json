{
 "description": "Search sponsors by name, description, industry tags, or filters. Returns compact results (id, name, website, niches, industryTags, country, operations, medianSubscribers). Use sponsor_get for full detail on a specific sponsor.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Filter by industry tag category",
    "type": "string"
   },
   "language": {
    "description": "Filter by language (e.g., EN, FR)",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Results per page (max 20)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maxMedianSubscribers": {
    "description": "Maximum median subscribers",
    "type": "integer"
   },
   "minMedianSubscribers": {
    "description": "Minimum median subscribers of YouTubers they sponsor",
    "type": "integer"
   },
   "niches": {
    "description": "Filter by niche IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "order": {
    "default": "desc",
    "description": "Sort order",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination",
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Search query (name or description)",
    "type": "string"
   },
   "sort": {
    "default": "updatedAt",
    "description": "Sort field",
    "enum": [
     "updatedAt",
     "name",
     "operations"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by sponsor status",
    "enum": [
     "VALIDATED",
     "NEED_CONFIRMATION",
     "NEED_INVESTIGATION",
     "NOT_A_SPONSOR"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sponsor_search"
}
