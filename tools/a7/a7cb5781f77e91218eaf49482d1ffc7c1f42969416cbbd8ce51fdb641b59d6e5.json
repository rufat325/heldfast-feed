{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Edit a FreeAgent invoice \u2014 change its dates, reference, project, VAT status, discount or comments, and add, edit or remove line items.\n\nOnly the fields you pass are changed. Line items are addressed by their own URL: a line with no itemUrl is ADDED, a line with itemUrl is edited, and destroy=true removes it. Omit items entirely to leave the existing lines alone \u2014 read them from freeagent_get_invoice first.\n\nFreeAgent only allows edits to a draft invoice: pull an issued one back with freeagent_update_invoice_status mark_as_draft before editing it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comments": {
    "description": "Notes shown on the invoice",
    "maxLength": 2000,
    "type": "string"
   },
   "contact": {
    "description": "Move the invoice to a different client",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/contacts\\/\\d+$",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 currency",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "datedOn": {
    "description": "Invoice date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "discountPercent": {
    "description": "Discount across the whole invoice",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "ecStatus": {
    "description": "VAT treatment for the sale",
    "enum": [
     "UK/Non-EC",
     "EC Goods",
     "EC Services",
     "Reverse Charge",
     "EC VAT MOSS"
    ],
    "type": "string"
   },
   "invoiceId": {
    "description": "FreeAgent invoice ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "items": {
    "description": "Line items to add, edit or remove \u2014 see the description for the rules",
    "items": {
     "additionalProperties": false,
     "properties": {
      "categoryUrl": {
       "description": "Income category for the line",
       "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/categories\\/\\d+$",
       "type": "string"
      },
      "description": {
       "description": "Line description",
       "maxLength": 2000,
       "type": "string"
      },
      "destroy": {
       "description": "Set true with itemUrl to delete that line",
       "type": "boolean"
      },
      "itemType": {
       "description": "Unit the line is measured in",
       "enum": [
        "Hours",
        "Days",
        "Weeks",
        "Months",
        "Years",
        "Products",
        "Services",
        "Training",
        "Expenses",
        "Comment",
        "Bills",
        "Discount",
        "Credit",
        "VAT",
        "Stock"
       ],
       "type": "string"
      },
      "itemUrl": {
       "description": "URL of an existing line to edit or remove. Omit to add a new line.",
       "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/invoice_items\\/\\d+$",
       "type": "string"
      },
      "price": {
       "description": "Unit price",
       "pattern": "^-?\\d+(\\.\\d{1,2})?$",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "pattern": "^\\d+(\\.\\d+)?$",
       "type": "string"
      },
      "salesTaxRate": {
       "description": "VAT rate (e.g. '20.0')",
       "pattern": "^\\d+(\\.\\d+)?$",
       "type": "string"
      },
      "salesTaxStatus": {
       "description": "Whether this line is taxable or exempt",
       "enum": [
        "TAXABLE",
        "EXEMPT"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 40,
    "type": "array"
   },
   "paymentTermsInDays": {
    "description": "Payment terms in days (0 = due on receipt)",
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "placeOfSupply": {
    "description": "Country whose VAT rate applies \u2014 required when ecStatus is 'EC VAT MOSS'",
    "maxLength": 100,
    "type": "string"
   },
   "poReference": {
    "description": "Client purchase order reference",
    "maxLength": 100,
    "type": "string"
   },
   "project": {
    "description": "Project this invoice belongs to",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "reference": {
    "description": "Invoice reference",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "invoiceId"
  ],
  "type": "object"
 },
 "name": "freeagent_update_invoice"
}
