      "type": "string"
     },
     "may_interrupt_traffic": {
      "type": "boolean"
     },
     "operation": {
      "enum": [
       "rotate",
       "abandon_rotation"
      ],
      "type": "string"
     },
     "plan_id": {
      "type": "string"
     },
     "provider_deployment_id": {
      "type": "string"
     },
     "provider_engine": {
      "type": "string"
     },
     "receipt": {
      "type": [
