{
 "description": "Draft a new responsive search ad in an ad group, created PAUSED by default. Returns a draftId \u2014 call confirm_write to actually create it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adGroupId": {
    "description": "Numeric ad group ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "descriptions": {
    "description": "2-4 descriptions, each max 90 characters",
    "items": {
     "maxLength": 90,
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "finalUrls": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "headlines": {
    "description": "3-15 headlines, each max 30 characters",
    "items": {
     "maxLength": 30,
     "type": "string"
    },
    "maxItems": 15,
    "minItems": 3,
    "type": "array"
   },
   "startEnabled": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "adGroupId",
   "headlines",
   "descriptions",
   "finalUrls"
  ],
  "type": "object"
 },
 "name": "create_responsive_search_ad",
 "title": "Draft: create a responsive search ad"
}
