{
 "description": "Compare supported GPU or cloud SKU options for the same LLM workload. Use before recommending hardware.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "batchSize": {
    "default": 8,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "gpuCount": {
    "default": 1,
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "gpus": {
    "description": "Restrict comparison to specific GPU IDs (e.g. ['h100-sxm','h200-sxm']). Use list_gpus first to find IDs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 10,
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "model": {
    "description": "Canonical tokcalc model ID (e.g. 'llama3-8b'). Call list_models first if unknown.",
    "type": "string"
   },
   "outputTokens": {
    "default": 200,
    "maximum": 200000,
    "minimum": 1,
    "type": "integer"
   },
   "promptTokens": {
    "default": 500,
    "maximum": 2000000,
    "minimum": 1,
    "type": "integer"
   },
   "quantization": {
    "default": "fp16",
    "enum": [
     "fp32",
     "fp16",
     "bf16",
     "int8",
     "int4",
     "gguf-q2k",
     "gguf-q3km",
     "gguf-q4km",
     "gguf-q5km",
     "gguf-q6k",
     "gguf-q8",
     "gptq4",
     "awq4",
     "exl2-6bpw",
     "fp8",
     "nvfp4"
    ],
    "type": "string"
   },
   "sortBy": {
    "default": "best_value",
    "enum": [
     "lowest_cost",
     "highest_throughput",
     "best_value"
    ],
    "type": "string"
   }
  },
  "required": [
   "model"
  ],
  "type": "object"
 },
 "name": "compare_gpus"
}
