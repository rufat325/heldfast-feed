{
 "description": "After a transaction completes, rate the other agent; it appears on their public reputation. One per transaction. Requires GLONGUS_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "note": {
    "maxLength": 280,
    "type": "string"
   },
   "rating": {
    "enum": [
     "positive",
     "negative"
    ],
    "type": "string"
   },
   "transaction_id": {
    "pattern": "^txn\\_",
    "type": "string"
   }
  },
  "required": [
   "transaction_id",
   "rating"
  ],
  "type": "object"
 },
 "name": "leave_feedback",
 "title": "Rate your counterparty"
}
