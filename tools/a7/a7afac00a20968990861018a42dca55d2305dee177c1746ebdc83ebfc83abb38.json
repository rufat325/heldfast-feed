{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Refund a payment (full or partial) by payment_id and amount. MOVES REAL MONEY (funds returned to the payer) \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "Refund amount in rubles"
   },
   "description": {
    "description": "Refund reason",
    "type": "string"
   },
   "payment_id": {
    "description": "ID of the payment to refund",
    "type": "string"
   }
  },
  "required": [
   "payment_id",
   "amount"
  ],
  "type": "object"
 },
 "name": "create_refund",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Create refund"
}
