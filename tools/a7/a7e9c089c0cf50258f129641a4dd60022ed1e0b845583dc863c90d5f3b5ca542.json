{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create LoS measurement"
 },
 "description": "Record a new LoS measurement value. Requires los_measurements:write scope. Resolve los_measure_id first via list_los_measures.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actual_value": {
    "description": "Measured value (required)",
    "type": "number"
   },
   "is_auto": {
    "description": "Whether this is an auto-calculated value (default: false)",
    "type": "boolean"
   },
   "los_measure_id": {
    "description": "LoS measure ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "notes": {
    "description": "Notes or context for this measurement",
    "maxLength": 2000,
    "type": "string"
   },
   "period_end": {
    "description": "Period end date (ISO 8601, required, e.g., \"2026-03-31\")",
    "type": "string"
   },
   "period_start": {
    "description": "Period start date (ISO 8601, required, e.g., \"2026-01-01\")",
    "type": "string"
   },
   "period_type": {
    "description": "Period type (required)",
    "enum": [
     "monthly",
     "quarterly",
     "semi_annual",
     "annual"
    ],
    "type": "string"
   }
  },
  "required": [
   "los_measure_id",
   "period_type",
   "period_start",
   "period_end",
   "actual_value"
  ],
  "type": "object"
 },
 "name": "create_los_measurement",
 "title": "Create LoS measurement"
}
