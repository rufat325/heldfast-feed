{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get draft"
 },
 "description": "Full detail for one of this organizer's own unsent drafts (a draft_ id from create_event or list_events): title, description, every date with its time or daypart, and the guest list. The review_url is the organizer's dashboard, where they can review and send it themselves after signing in. Read-only; needs the read permission.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "draft_id": {
    "description": "A draft_ id from create_event or list_events",
    "type": "string"
   }
  },
  "required": [
   "draft_id"
  ],
  "type": "object"
 },
 "name": "get_draft",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created_at": {
    "type": "string"
   },
   "dates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "daypart": {
       "anyOf": [
        {
         "enum": [
          "morning",
          "afternoon",
          "evening"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "endTime": {
       "anyOf": [
        {
         "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "label": {
       "type": "string"
      },
      "startTime": {
       "anyOf": [
        {
         "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "date",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "draft_id": {
    "type": "string"
   },
   "guest_count": {
    "type": "number"
   },
   "guests": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "review_url": {
    "type": "string"
   },
   "spends_credit": {
    "type": "boolean"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "draft_id",
   "title",
   "description",
   "dates",
   "guests",
   "guest_count",
   "spends_credit",
   "created_at"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get draft"
}
