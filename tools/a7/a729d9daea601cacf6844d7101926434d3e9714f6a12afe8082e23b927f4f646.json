{
 "description": "Gestiona leads/prospectos. Acciones: list (page, limit, search, status_id, source_id), get (id), create, update (id), delete (id), convert (id \u2192 transforma lead a cliente).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "convert"
    ],
    "type": "string"
   },
   "address": {
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "client_id": {
    "type": "number"
   },
   "company_name": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "custom_fields": {
    "items": {
     "properties": {
      "custom_field_id": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "custom_field_id",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "email": {
    "type": "string"
   },
   "first_name": {
    "type": "string"
   },
   "gender": {
    "type": "string"
   },
   "id": {
    "description": "ID del lead (requerido para get, update, delete, convert)",
    "type": "number"
   },
   "job_title": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "last_name": {
    "type": "string"
   },
   "lead_status_id": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "owner_id": {
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "phone": {
    "type": "string"
   },
   "search": {
    "type": "string"
   },
   "skype": {
    "type": "string"
   },
   "source_id": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "status_id": {
    "type": "string"
   },
   "website": {
    "type": "string"
   },
   "zip": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "leads"
}
