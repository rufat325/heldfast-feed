{
 "description": "Search RPG entities (spells, monsters, classes, items) across all systems",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Entity category (spell, monster, class, item)",
    "type": "string"
   },
   "game": {
    "description": "Alias for system",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 10)",
    "type": "number"
   },
   "query": {
    "description": "Search term",
    "type": "string"
   },
   "system": {
    "description": "Limit to system (dnd-5e, pathfinder-1e, etc)",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "rpg_search_entities"
}
