       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "shared_delivery": {
    "additionalProperties": false,
    "description": "Delivery address applied to every row that doesn't supply its own. Uncommon (usually each row goes somewhere different).",
    "properties": {
     "city": {
      "type": "string"
     },
     "contactName": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "phone": {
