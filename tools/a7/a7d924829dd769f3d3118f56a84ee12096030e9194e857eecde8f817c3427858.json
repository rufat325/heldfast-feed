     },
     "state": {
      "type": "string"
     },
     "street": {
      "type": "string"
     },
     "zipCode": {
      "pattern": "^\\d{5}$",
      "type": "string"
     }
    },
    "required": [
     "zipCode",
     "city",
     "state",
     "street",
     "contactName",
     "phone",
     "email"
    ],
    "type": "object"
   },
   "shared_pickup_window": {
    "additionalProperties": false,
    "properties": {
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
