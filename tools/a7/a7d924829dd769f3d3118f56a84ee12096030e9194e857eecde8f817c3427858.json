 "annotations": {
  "destructiveHint": true,
  "title": "Batch Book Shipments"
 },
 "description": "Book MANY already-quoted lanes in ONE call (sequential, one card charge per row). Use this after batch_quote when the user says \"book all of them\" or \"book rows 1, 3, 5\" \u2014 do NOT call book in a loop. Each row needs a quote_id (the same one batch_quote returned for that row). Pickup/delivery default to the shared addresses at the top level so a single warehouse \u2192 many destinations only needs one address pair. Returns a progress card showing per-row Booked/Failed status with tracking numbers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bookings": {
    "description": "Array of bookings to confirm (1-25). Each is one freight shipment, one card charge.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessorials": {
       "additionalProperties": false,
       "description": "Per-row accessorials. Falls back to shared_accessorials.",
       "properties": {
        "delivery": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "pickup": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "type": "object"
      },
      "delivery": {
       "additionalProperties": false,
       "description": "Per-row delivery. Omit to inherit from shared_delivery.",
       "properties": {
        "city": {
         "type": "string"
        },
        "contactName": {
         "type": "string"
        },
        "email": {
         "type": "string"
        },
        "phone": {
         "type": "string"
        },
        "specialInstruction": {
         "type": "string"
        },
        "state": {
         "type": "string"
        },
        "street": {
         "type": "string"
        },
        "zipCode": {
         "pattern": "^\\d{5}$",
         "type": "string"
        }
       },
       "required": [
        "zipCode",
        "city",
        "state",
        "street",
        "contactName",
        "phone"
       ],
       "type": "object"
      },
      "delivery_window": {
       "additionalProperties": false,
       "properties": {
        "from": {
         "type": "string"
        },
        "to": {
         "type": "string"
        }
       },
       "required": [
        "from",
        "to"
       ],
       "type": "object"
      },
      "notes": {
       "description": "Per-row special instructions. Falls back to shared_notes.",
       "type": "string"
      },
      "pickup": {
       "additionalProperties": false,
       "description": "Per-row pickup. Omit to inherit from shared_pickup.",
       "properties": {
        "city": {
         "type": "string"
        },
        "contactName": {
         "type": "string"
        },
        "email": {
         "type": "string"
        },
        "phone": {
         "type": "string"
        },
        "specialInstruction": {
         "type": "string"
        },
        "state": {
         "type": "string"
        },
        "street": {
         "type": "string"
        },
        "zipCode": {
         "pattern": "^\\d{5}$",
         "type": "string"
        }
       },
       "required": [
        "zipCode",
        "city",
        "state",
        "street",
        "contactName",
        "phone",
        "email"
       ],
       "type": "object"
      },
      "pickup_window": {
       "additionalProperties": false,
       "properties": {
        "from": {
         "type": "string"
        },
        "to": {
         "type": "string"
        }
       },
       "required": [
        "from",
        "to"
       ],
       "type": "object"
      },
      "quote_id": {
       "description": "Quote ID from a previous quote tool. Must be from THIS session \u2014 quote ids expire and rotate, so quote \u2192 book back-to-back.",
       "type": "string"
      },
      "reference": {
       "description": "Per-row reference (PO #, order #). Falls back to shared_reference.",
       "type": "string"
      }
     },
     "required": [
      "quote_id"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   },
   "shared_accessorials": {
    "additionalProperties": false,
    "properties": {
     "delivery": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "pickup": {
