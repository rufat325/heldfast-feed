{
 "description": "Render raw HTML/CSS to an image. Perfect for generating OG images, social cards, email previews, and dynamic content from templates. No URL needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "css": {
    "description": "Additional CSS to inject",
    "type": "string"
   },
   "dark_mode": {
    "description": "Enable dark mode emulation",
    "type": "boolean"
   },
   "device_scale": {
    "description": "Device scale factor (default: 1)",
    "maximum": 3,
    "minimum": 0.5,
    "type": "number"
   },
   "disable_javascript": {
    "description": "Disable JavaScript execution on the page",
    "type": "boolean"
   },
   "evaluate": {
    "description": "JavaScript code to execute on the page before capture (max 10KB). Runs in the browser context.",
    "type": "string"
   },
   "format": {
    "description": "Image format (default: png)",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "full_page": {
    "description": "Capture full page scroll height",
    "type": "boolean"
   },
   "height": {
    "description": "Viewport height (default: 720)",
    "maximum": 2160,
    "minimum": 200,
    "type": "number"
   },
   "html": {
    "description": "Raw HTML content to render (max 2MB)",
    "type": "string"
   },
   "ignore_https_errors": {
    "description": "Ignore HTTPS/TLS certificate errors",
    "type": "boolean"
   },
   "locale": {
    "description": "BCP 47 locale tag for the browser context (e.g., \"en-US\")",
    "type": "string"
   },
   "quality": {
    "description": "Image quality 1-100 (default: 80)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "selector": {
    "description": "CSS selector to capture specific element",
    "type": "string"
   },
   "timezone": {
    "description": "IANA timezone for the browser context (e.g., \"America/New_York\")",
    "type": "string"
   },
   "wait_until": {
    "description": "Content load strategy (default: domcontentloaded). Use \"networkidle\" for content with external resources.",
    "enum": [
     "commit",
     "domcontentloaded",
     "load",
     "networkidle"
    ],
    "type": "string"
   },
   "width": {
    "description": "Viewport width (default: 1280)",
    "maximum": 3840,
    "minimum": 320,
    "type": "number"
   }
  },
  "required": [
   "html"
  ],
  "type": "object"
 },
 "name": "render_html"
}
