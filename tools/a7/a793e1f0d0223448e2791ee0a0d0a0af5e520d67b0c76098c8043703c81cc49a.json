  "title": "Create Annexure B JSON"
 },
 "description": "Creates the Annexure B JSON (statement of inward-supply invoices) for a GST refund of accumulated ITC (RFD-01), the file the GST portal otherwise requires from its Excel offline utility, from records that pass validate_annexure_b. Returns openUrl, a link the user opens in a browser to sign in by email, pay once per GSTIN and refund period, and download; the checked records are stored behind the link for 24 hours. With a connected account that has paid, it returns the file. The tool takes no GST portal password or OTP. ITC eligibility, reversal amounts and GSTR-2B periods come from the taxpayer's reviewed records; the tool does not infer them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": true,
    "description": "The document's fields, as its requirements tool lists them, or a JSON file from the official utility unchanged.",
    "type": "object"
   },
   "direct": {
    "description": "true to have the file returned to this client. It needs the user's Fast GST Refund account to be connected; if it is not, the client is asked to sign in. Leave out unless the user asked for the file here.",
    "type": "boolean"
   },
   "link": {
    "description": "The openUrl from the other generate tool's result, so that one link holds both files.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
