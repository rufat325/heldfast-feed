{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Stories"
 },
 "description": "Followed stories (\"Pri\u010de\"): news stories Adios tracks over days or weeks as timelines of stages (e.g. a missing person \u2192 search \u2192 found). Newest development first; filter by text, category or period (day/week/month). Then call get_story_timeline with a slug.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category: crime, politics, sport\u2026 (see /v1/categories).",
    "enum": [
     "general",
     "politics",
     "economy",
     "sport",
     "crime",
     "weather",
     "technology",
     "health",
     "entertainment",
     "show",
     "culture",
     "world",
     "lifestyle",
     "travel",
     "science",
     "education",
     "automotive"
    ],
    "type": "string"
   },
   "include_filler": {
    "description": "Filler (horoscopes, quizzes, reality shows, celebrity gossip, promos) is left out of every list; true brings it back.",
    "type": "boolean"
   },
   "order": {
    "description": "latest (default), longest or most_reports.",
    "enum": [
     "latest",
     "longest",
     "most_reports"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page (20 per page).",
    "type": "integer"
   },
   "period": {
    "description": "A new stage within: day, week or month.",
    "enum": [
     "day",
     "week",
     "month"
    ],
    "type": "string"
   },
   "q": {
    "description": "Search the stories' and stages' names.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_stories",
 "outputSchema": {
  "properties": {
   "data": {
    "items": {
     "properties": {
      "articles": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "first_published_at": {
       "format": "date-time",
       "type": "string"
      },
      "last_published_at": {
       "format": "date-time",
       "type": "string"
      },
      "latest_stage": {
       "properties": {
        "label": {
         "type": "string"
        },
        "number": {
         "pattern": "^-?(?:0|[1-9]\\d*)$",
         "type": [
          "string",
          "integer"
         ]
        },
        "started_at": {
         "format": "date-time",
         "type": "string"
        }
       },
       "required": [
        "number",
        "label",
        "started_at"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "portals": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "slug": {
       "type": "string"
      },
      "stages": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "url",
      "first_published_at",
      "last_published_at",
      "stages",
      "articles",
      "portals"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "description": "count, plan, include_filler, the limits applied (e.g. radius_limited_to), and for a nearby search its center.",
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Stories"
}
