{
 "description": "Return the filterable aicoolies catalog index. Equivalent to GET /api/agents/context. Optional category slug, include list, and compact slug-only mode.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category slug, for example ai-native-ides",
    "type": "string"
   },
   "compact": {
    "description": "If true, return slugs only",
    "type": "boolean"
   },
   "include": {
    "description": "Comma-separated collections: tools,comparisons,reviews,stacks (deprecated, always empty),use_cases,categories,tags",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_catalog_context"
}
