{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Profile a table for ETL work: row count, deleted rows, size, and last change from QSYS2.SYSTABLESTAT, plus per-column distinct count, null count, and low and high values. By default column numbers come from stored statistics in QSYS2.SYSCOLUMNSTAT (low and high are the second-lowest and second-highest values), and columns without collected statistics report source \"none\". Set compute to true to scan the table for exact numbers on up to 20 columns. Masked columns keep their counts and return no values.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "columns": {
    "description": "Columns to profile. Defaults to every column (the first 20 when compute is true).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "compute": {
    "description": "Scan the table for exact counts, MIN, and MAX. Slower on large tables. Default false.",
    "type": "boolean"
   },
   "schema": {
    "description": "Schema (library) that contains the table. Uses the system's default schema if not provided.",
    "type": "string"
   },
   "table": {
    "description": "Table name",
    "type": "string"
   }
  },
  "required": [
   "table"
  ],
  "type": "object"
 },
 "name": "profile_table",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cause": {
    "description": "Why the statement failed. &1-style placeholders stand for values in error.",
    "type": "string"
   },
   "computed_rows": {
    "type": [
     "number",
     "null"
    ]
   },
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "column_name": {
       "type": "string"
      },
      "data_type": {
       "type": "string"
      },
      "distinct_values": {
       "type": [
        "number",
        "null"
       ]
      },
      "high": {
       "type": [
        "string",
        "null"
       ]
      },
      "low": {
       "type": [
        "string",
        "null"
       ]
      },
      "masked": {
       "enum": [
        "redact",
        "last4"
       ],
       "type": "string"
      },
      "null_count": {
       "type": [
        "number",
        "null"
       ]
      },
      "source": {
       "enum": [
        "stored",
        "computed",
        "none"
       ],
       "type": "string"
      },
      "statistics_updated": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "column_name",
      "data_type",
      "source",
      "distinct_values",
      "null_count",
      "low",
      "high"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "mode": {
    "enum": [
     "stored",
     "computed"
    ],
    "type": "string"
   },
   "recovery": {
    "description": "What to change before trying again",
    "type": "string"
   },
   "schema": {
    "type": "string"
   },
   "sql": {
    "type": "string"
   },
   "sqlcode": {
    "description": "SQLCODE of the failed statement, such as -204",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "sqlstate": {
    "description": "SQLSTATE of the failed statement",
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "table": {
    "type": "string"
   },
   "table_stats": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "data_size": {
        "type": [
         "number",
         "null"
        ]
       },
       "last_change": {
        "type": [
         "string",
         "null"
        ]
       },
       "last_used": {
        "type": [
         "string",
         "null"
        ]
       },
       "number_deleted_rows": {
        "type": [
         "number",
         "null"
        ]
       },
       "number_rows": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "number_rows",
       "number_deleted_rows",
       "data_size",
       "last_change",
       "last_used"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Profile Table"
}
