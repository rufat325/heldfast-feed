{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Update a HITL config. Can change name, channels, or timeout.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), then call this tool again. start_login does NOT open this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channels": {
    "description": "Updated channels",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "config": {
         "additionalProperties": false,
         "properties": {
          "chat_id": {
           "maxLength": 50,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "chat_id"
         ],
         "type": "object"
        },
        "type": {
         "const": "telegram",
         "type": "string"
        }
       },
       "required": [
        "type",
        "config"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "config": {
         "additionalProperties": false,
         "properties": {
          "bsuid": {
           "description": "WhatsApp Business-Scoped User ID (e.g. US.abc123...)",
           "pattern": "^[A-Z]{2}\\.[a-zA-Z0-9]{10,140}$",
           "type": "string"
          },
          "phone_number": {
           "description": "Phone number in E.164 format",
           "pattern": "^\\+?[1-9]\\d{6,14}$",
           "type": "string"
          }
         },
         "type": "object"
        },
        "type": {
         "const": "whatsapp",
         "type": "string"
        }
       },
       "required": [
        "type",
        "config"
       ],
       "type": "object"
      }
     ]
    },
    "minItems": 1,
    "type": "array"
   },
   "id": {
    "description": "HITL config ID",
    "type": "string"
   },
   "name": {
    "anyOf": [
     {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "New name (null to clear)"
   },
   "timeout_seconds": {
    "description": "Updated timeout in seconds (60\u201386400)",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_hitl"
}
