 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a product listing"
 },
 "description": "Use this when the user is looking at a specific product listing on an online store and wants to know whether it looks trustworthy or like a good buy. Pass what you already read from the listing as arguments: title (required) and, when shown, brand, price, listPrice (the seller's \"was\" price), currency, url, seller, category, rating, reviewCount and key details; each extra field sharpens the read. Returns findings such as generic white-label product, quality, price, questionable discount, review credibility and seller legitimacy, each with a confidence, plus a report on the brand unless includeBrand is false. Signals only, never a buy or avoid verdict. Does not browse: only the domain of url is used. Not for banking, health, government or email pages.",
 "inputSchema": {
  "properties": {
   "brand": {
    "description": "Brand or maker, if the listing names one.",
    "maxLength": 200,
    "type": "string"
   },
   "category": {
    "description": "Product category, e.g. \"Headphones\".",
    "maxLength": 300,
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for price and listPrice. Default USD.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "detail": {
    "description": "Include each finding's full probability distribution. Default false.",
    "type": "boolean"
   },
   "details": {
    "description": "Key specs or bullet points as plain text. Longer text is trimmed.",
    "maxLength": 20000,
    "type": "string"
   },
   "id": {
    "description": "Your own id for this product (e.g. an ASIN or list index); echoed back.",
    "maxLength": 100,
    "type": "string"
   },
   "includeBrand": {
    "description": "Also report on the brand the listing names (its brand field), with findings on the brand itself. Default true.",
    "type": "boolean"
   },
   "listPrice": {
    "description": "The seller's \"was\" / \"list\" / \"typical\" price, if shown.",
    "maximum": 10000000,
    "minimum": 0,
    "type": "number"
   },
   "price": {
    "description": "What the buyer would pay now, as a number.",
    "maximum": 10000000,
    "minimum": 0,
    "type": "number"
   },
   "rating": {
    "description": "Average star rating out of 5.",
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "reviewCount": {
    "description": "Number of ratings or reviews.",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "integer"
   },
   "seller": {
    "description": "Seller or store name, if different from the site.",
    "maxLength": 300,
    "type": "string"
   },
   "title": {
    "description": "Product title exactly as the listing shows it.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Listing URL. Only its domain is used.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
