       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "markdown": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Read an explainer article"
}
