{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Build a knowledge context from tags. Returns formatted markdown with relevant facts, resources, skills, and staleness warnings. Use this to gather context before working on a task.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeStalenessWarnings": {
    "default": true,
    "description": "Include staleness warnings section (default: true)",
    "type": "boolean"
   },
   "maxFacts": {
    "default": 50,
    "description": "Maximum number of facts to include (default: 50)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxResources": {
    "default": 20,
    "description": "Maximum number of resources to include (default: 20)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxSkills": {
    "default": 10,
    "description": "Maximum number of skills to include (default: 10)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "tags": {
    "description": "Tags to build context from",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "tags"
  ],
  "type": "object"
 },
 "name": "get_knowledge_context",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "factsCount": {
    "type": "number"
   },
   "hasStalenessWarnings": {
    "type": "boolean"
   },
   "markdown": {
    "type": "string"
   },
   "resourcesCount": {
    "type": "number"
   },
   "skillsCount": {
    "type": "number"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "markdown",
   "tags",
   "factsCount",
   "resourcesCount",
   "skillsCount",
   "hasStalenessWarnings"
  ],
  "type": "object"
 },
 "title": "Get Knowledge Context"
}
