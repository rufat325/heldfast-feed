{
 "description": "Create a new CRM user with role, permissions, and location assignments.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "companyId": {
    "description": "Company ID the user belongs to",
    "type": "string"
   },
   "email": {
    "description": "User email address",
    "type": "string"
   },
   "firstName": {
    "description": "User first name",
    "type": "string"
   },
   "lastName": {
    "description": "User last name",
    "type": "string"
   },
   "locationIds": {
    "description": "Array of location IDs the user has access to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "password": {
    "description": "User password",
    "type": "string"
   },
   "permissions": {
    "additionalProperties": {},
    "description": "Permissions object defining user capabilities",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "phone": {
    "description": "User phone number",
    "type": "string"
   },
   "role": {
    "description": "User role (admin, user, etc.)",
    "type": "string"
   },
   "scopeCompanyIds": {
    "description": "Array of company IDs the scopes apply to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scopes": {
    "description": "Array of OAuth scopes granted to the user",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "User type (e.g. 'account')",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "companyId",
   "firstName",
   "lastName",
   "email",
   "password",
   "type",
   "role"
  ],
  "type": "object"
 },
 "name": "crm_create_user"
}
