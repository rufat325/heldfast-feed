{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Bind one or more additional FQDNs (including wildcards like `*.example.com`) to a web hosting site. Lets the site's Apache vhost / DocumentRoot serve those new domains too \u2014 no new site provisioning required. Two-phase commit. Asynchronous: returns a `progress_id`; the alias appears in `infomaniak_list_site_aliases` after a few seconds of provisioning. Manager-private.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "aliases": {
    "description": "One or more FQDNs to bind to the site. WILDCARDS ARE ACCEPTED (e.g. `*.evo.broz.be`) \u2014 use this pattern to serve any subdomain from a single WordPress install. The DNS for each alias must already point to the hosting's IP, otherwise Apache will respond but the browser will never reach it.",
    "items": {
     "minLength": 3,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "confirmation_token": {
    "description": "Token from the prior plan response. Required on the apply phase only.",
    "format": "uuid",
    "type": "string"
   },
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "site_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hosting_id",
   "site_id",
   "aliases"
  ],
  "type": "object"
 },
 "name": "infomaniak_add_site_aliases",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "aliases_to_add": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "already_present": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "hosting_id": {
        "type": "number"
       },
       "includes_wildcard": {
        "type": "boolean"
       },
       "site_id": {
        "type": "number"
       },
       "site_main_fqdn": {
        "type": "string"
       }
      },
      "required": [
       "hosting_id",
       "site_id",
       "aliases_to_add",
       "includes_wildcard",
       "already_present"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "progress_id": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "progress_id",
     "message",
     "note"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
