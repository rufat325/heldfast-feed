{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update compliance record"
 },
 "description": "Update an existing compliance record by ID. Requires compliance_records:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "completed_at": {
    "description": "Completion date-time (ISO 8601)",
    "type": "string"
   },
   "completed_by": {
    "description": "User ID who completed",
    "maxLength": 200,
    "type": "string"
   },
   "days_since_last_completion": {
    "description": "Days since last completion",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "Compliance record ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "required_frequency_days": {
    "description": "Required frequency in days",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_compliance_record",
 "title": "Update compliance record"
}
