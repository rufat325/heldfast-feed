{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Filter robots by published figures, e.g. payload at least 20 kg and reach at least 1300 mm, optionally within a category or maker, sorted by a figure. Only robots that publish every filtered figure can match; the answer says, per figure, how many robots in scope publish it, so a short list is never mistaken for everything that can do the job. Values are compared in the attribute's canonical unit; give `unit` to convert (e.g. 40 lb).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "e.g. \"cobot\", \"quadruped\", \"humanoid\", \"amr\", \"end-effector\"",
    "maxLength": 64,
    "type": "string"
   },
   "filters": {
    "default": [],
    "items": {
     "properties": {
      "attribute": {
       "description": "Attribute key from list_attributes, e.g. payload_kg",
       "maxLength": 64,
       "type": "string"
      },
      "equals": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "boolean"
        }
       ],
       "description": "For text, enum or yes/no figures"
      },
      "max": {
       "type": "number"
      },
      "min": {
       "type": "number"
      },
      "unit": {
       "description": "Unit of min/max if not the canonical one, e.g. lb",
       "maxLength": 16,
       "type": "string"
      }
     },
     "required": [
      "attribute"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "maker": {
    "description": "Maker slug, e.g. \"universal-robots\"",
    "maxLength": 100,
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "order": {
    "default": "desc",
    "enum": [
     "desc",
     "asc"
    ],
    "type": "string"
   },
   "sort_by": {
    "description": "Attribute key to sort by",
    "maxLength": 64,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_robots",
 "title": "Find robots by figures"
}
