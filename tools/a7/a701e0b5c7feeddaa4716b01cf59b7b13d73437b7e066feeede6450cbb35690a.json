{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Alternative direct-upload flow, only when you have file access and can reach the upload host: register files and get one signed PUT upload URL per file. Keep request_id and request_key private and never show them to the customer. Upload each file with HTTP PUT to its URL, then call submit_to_offer. If an upload fails with 403 or a network error, stop and call create_upload_link with the request_id and request_key you already hold so the customer can upload in their browser; do not retry registration with the same idempotency_key. If the linked flow is unavailable, the customer can use https://www.formheim.no/print.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"files":{"items":{"additionalProperties":false,"properties":{"file_id":{"pattern":"^[A-Za-z0-9_-]{1,64}$","type":"string"},"file_name":{"maxLength":255,"minLength":1,"type":"string"},"format":{"enum":["stl","obj","3mf"],"type":"string"},"sha256":{"pattern":"^[a-f0-9]{64}$","type":"string"},"size_bytes":{"maximum":52428800,"minimum":1,"type":"integer"}},"required":["file_id","format","size_bytes","sha256","file_name"],"type":"object"},"maxItems":10,"minItems":1,"type":"array"},"idempotency_key":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"request_id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"request_key":{"pattern":"^[A-Za-z0-9_-]{43}$","type":"string"}},"required":["idempotency_key","files"],"type":"object"},"name":"prepare_print_upload","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema",