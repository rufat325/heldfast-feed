{
 "description": "Plan JSON-LD schema for a URL or markdown page without a provider call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_jsonld": {
    "default": true,
    "type": "boolean"
   },
   "keyword": {
    "type": "string"
   },
   "page_markdown": {
    "description": "Page markdown when no URL exists",
    "maxLength": 50000,
    "minLength": 80,
    "type": "string"
   },
   "page_type": {
    "default": "auto",
    "enum": [
     "auto",
     "article",
     "blog_post",
     "landing_page",
     "product",
     "software",
     "local_business",
     "faq",
     "how_to"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "description": "Optional target brand, domain, or product",
    "type": "string"
   },
   "url": {
    "description": "Page URL to scrape",
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "agentseo_content_schema_plan",
 "title": "AgentSEO Content Schema Plan"
}
