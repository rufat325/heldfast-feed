{"_meta":{"openai/toolInvocation/invoked":"Priced the selection","openai/toolInvocation/invoking":"Pricing the selection\u2026"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Price a selection before spending; reserves nothing. Exactly one of shows (feed URLs from search_shows or chart_shows), chart (a category), or uploads (ids from upload_audio). Returns priced entries, exclusions with reasons, total_ceiling_credits and confirm_with (what confirm takes). Also balance_credits and reserved_credits: what the account has left.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"chart":{"properties":{"category":{"maxLength":100,"minLength":1,"type":"string"},"language":{"description":"A BCP-47 tag such as en or pt-BR.","maxLength":35,"pattern":"^[A-Za-z]{2,3}(-[A-Za-z0-9]{1,8})*$","type":"string"},"size":{"description":"Clamped to the tier; default 10.","maximum":100,"minimum":1,"type":"integer"}},"required":["category"],"type":"object"},"episodes_per_show":{"description":"Newest N per show; default 1.","maximum":100,"minimum":1,"type":"integer"},"include_music_led":{"description":"Chart only; default false.","type":"boolean"},"shows":{"items":{"properties":{"episode_ids":{"description":"From list_episodes; replaces newest-N for this show.","items":{"maxLength":40,"pattern":"^ep_[a-z2-7]{16}$","type":"string"},"maxItems":100,"minItems":1,"type":"array"},"feed_url":{"description":"From search_shows or chart_shows.","format":"uri","maxLength":2048,"type":"string"},"itunes_id":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}],"description":"As the search result carried it."},"title":{"description":"Quote label; defaults to feed_url.","maxLength":300,"type":"string"}},"required":["feed_url"],"type":"object"},"maxItems":100,"minItems":1,"type":"array"},"uploads":{"description":"Upload ids.","items":{"properties":{"u