 "description": "Use this when the user wants to read or open one specific item \u2014 a document, deck, spreadsheet, note or other artifact \u2014 and you have its id (from search_artifacts or an earlier result). Returns its content. Very long items come back cut to the first part; use query_document or summarize_artifact to work with the whole thing. Do not use to find items; use search_artifacts.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "the artifact id, e.g. art_abc123",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_artifact",
