{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return safe source metadata for up to five active knowledge revisions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "revision_refs": {
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "revision_refs"
  ],
  "type": "object"
 },
 "name": "get_knowledge_provenance",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "revisions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "revision_ref": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "sources": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "document_date": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "document_version": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "source_kind": {
          "enum": [
           "official_web",
           "admin_web",
           "admin_document",
           "pasted_text",
           "field_log"
          ],
          "type": "string"
         },
         "source_ref": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "title": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "pattern": "^https:\\/\\/.*",
          "type": "string"
         },
         "verified_at": {
          "type": "string"
         }
        },
        "required": [
         "source_ref",
         "source_kind",
         "title",
         "url",
         "document_version",
         "document_date",
         "verified_at"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "revision_ref",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "revisions"
  ],
  "type": "object"
 },
 "title": "Get Knowledge Provenance"
}
