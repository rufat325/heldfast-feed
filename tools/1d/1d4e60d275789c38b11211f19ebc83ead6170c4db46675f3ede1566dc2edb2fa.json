{
 "description": "Execute a command inside a capsule and return stdout, stderr, and the exit code. Provide the command as an argv array, e.g. ['ls','-la','/workspace'].",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "command": {
    "description": "Command as an argv array",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cwd": {
    "type": "string"
   },
   "sessionId": {
    "type": "string"
   },
   "timeoutSec": {
    "type": "number"
   }
  },
  "required": [
   "sessionId",
   "command"
  ],
  "type": "object"
 },
 "name": "capsulate_exec",
 "title": "Run a command"
}
