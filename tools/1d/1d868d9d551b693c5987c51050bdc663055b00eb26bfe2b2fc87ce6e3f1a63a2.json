{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud DB for MSSQL instance. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backupFileRetentionPeriod": {
    "description": "Backup retention period in days (1-30)",
    "type": "number"
   },
   "backupTime": {
    "description": "Backup time (HH:mm format)",
    "type": "string"
   },
   "characterSetName": {
    "description": "DB character set (Korean_Wansung_CI_AS | SQL_Latin1_General_CP1_CI_AS)",
    "type": "string"
   },
   "cloudMssqlImageProductCode": {
    "description": "MSSQL image product code",
    "type": "string"
   },
   "cloudMssqlPort": {
    "description": "MSSQL port number (default: 1433, range: 10000-20000)",
    "type": "number"
   },
   "cloudMssqlProductCode": {
    "description": "MSSQL server product (spec) code",
    "type": "string"
   },
   "cloudMssqlServiceName": {
    "description": "MSSQL service name (3-20 chars, lowercase letters and numbers)",
    "type": "string"
   },
   "cloudMssqlUserName": {
    "description": "Initial admin user name",
    "type": "string"
   },
   "cloudMssqlUserPassword": {
    "description": "Initial admin user password",
    "type": "string"
   },
   "configGroupNo": {
    "description": "Config Group number",
    "type": "string"
   },
   "dataStorageTypeCode": {
    "description": "Data storage type: SSD | HDD | CB2",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating the instance",
    "type": "boolean"
   },
   "engineVersionCode": {
    "description": "DB engine version code",
    "type": "string"
   },
   "isAutomaticBackup": {
    "description": "Whether to enable automatic backup scheduling",
    "type": "boolean"
   },
   "isBackup": {
    "description": "Whether to enable automatic backup",
    "type": "boolean"
   },
   "isHa": {
    "description": "High availability mode (true creates Mirror server, 2 servers total)",
    "type": "boolean"
   },
   "isMultiZone": {
    "description": "Multi Zone mode (only when isHa=true)",
    "type": "boolean"
   },
   "mirrorSubnetNo": {
    "description": "Mirror server subnet number. Required when isMultiZone=true.",
    "type": "string"
   },
   "subnetNo": {
    "description": "Subnet number",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "string"
   }
  },
  "required": [
   "cloudMssqlServiceName",
   "vpcNo",
   "subnetNo",
   "cloudMssqlUserName",
   "cloudMssqlUserPassword",
   "isHa"
  ],
  "type": "object"
 },
 "name": "ncloud_create_mssql_instance"
}
