{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "veterical:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get vet clinic details"
 },
 "description": "Use this when someone asks about one vet clinic's basic settings, such as its currency, language or timezone. Returns the clinic's name, currency, default language, timezone and last edit time; an id outside the organization returns not-found. Not for free appointment slots.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Clinic id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "get_clinic",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinic": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "anyOf": [
         {
          "pattern": "^[A-Za-z]{3}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 35,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "timezone": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "currency",
       "defaultLocale",
       "timezone",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Administrative clinic metadata only; opening hours, staff, animal, owner and appointment data are not included. Null when not found."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "clinic"
  ],
  "type": "object"
 },
 "title": "Get vet clinic details"
}
