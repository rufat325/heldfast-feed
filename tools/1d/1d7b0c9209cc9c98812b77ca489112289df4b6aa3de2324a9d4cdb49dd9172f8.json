{
 "description": "Update an existing memory's content, importance, or scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "New category (e.g., \"backend\", \"frontend\", or any custom category)",
    "maxLength": 50,
    "type": "string"
   },
   "content": {
    "description": "New content",
    "maxLength": 10000,
    "minLength": 5,
    "type": "string"
   },
   "importance": {
    "description": "New importance (1-10)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "memory_id": {
    "description": "Memory ID to update",
    "type": "integer"
   },
   "memory_type": {
    "description": "New memory type",
    "enum": [
     "identity",
     "preference",
     "architecture",
     "decision",
     "bug",
     "dependency",
     "pattern",
     "context",
     "session_summary",
     "task",
     "correction",
     "reminder",
     "skill",
     "rule",
     "principle",
     "intent"
    ],
    "type": "string"
   },
   "scope": {
    "description": "New scope",
    "enum": [
     "global",
     "project"
    ],
    "type": "string"
   },
   "subject": {
    "description": "New subject (e.g., \"auth_system\", \"react_version\")",
    "maxLength": 100,
    "type": "string"
   },
   "tags": {
    "description": "New tags (replaces existing tags)",
    "items": {
     "maxLength": 30,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   }
  },
  "required": [
   "memory_id"
  ],
  "type": "object"
 },
 "name": "update_memory"
}
