{
 "description": "Add one typed live-enforcement pointer on an onboarding-goal approval requirement.\n\nThis updates the requirement binding only. It does not change the referenced workflow, agent, channel, or routine; run providers; spend credits; make approval decisions; or execute external writes. Removing a path from a send, write, or delete safeguard requires confirm=true. The server reuses the UI validator and writes an actor-attributed audit row.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "binding": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "workflow-step",
        "type": "string"
       },
       "stepId": {
        "description": "Referenced workflow step ID",
        "minLength": 1,
        "type": "string"
       },
       "workflowId": {
        "description": "Referenced workflow ID",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "workflowId",
       "stepId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "description": "App action ID",
        "minLength": 1,
        "type": "string"
       },
       "agentId": {
        "description": "Linked agent ID",
        "minLength": 1,
        "type": "string"
       },
       "appId": {
        "description": "App ID",
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "const": "agent-action",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "agentId",
       "appId",
       "actionId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "channel": {
        "description": "Workspace channel authority",
        "enum": [
         "email",
         "linkedin",
         "whatsapp"
        ],
        "type": "string"
       },
       "kind": {
        "const": "workspace-channel",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "channel"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "actionId": {
        "description": "App action ID",
        "minLength": 1,
        "type": "string"
       },
       "appId": {
        "description": "App ID",
        "minLength": 1,
        "type": "string"
       },
       "kind": {
        "const": "routine-action",
        "type": "string"
       },
       "routineId": {
        "description": "Routine ID",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "routineId",
       "appId",
       "actionId"
      ],
      "type": "object"
     }
    ],
    "description": "Exact typed enforcement pointer to add or remove"
   },
   "confirm": {
    "description": "For unbind only: must be true when removing a send, write, or delete safeguard path",
    "type": "boolean"
   },
   "id": {
    "description": "WorkspaceUseCase id, key, or workflowGraphId",
    "minLength": 1,
    "type": "string"
   },
   "requirementId": {
    "description": "Existing onboarding-goal approval requirement ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "requirementId",
   "binding"
  ],
  "type": "object"
 },
 "name": "bind_use_case_goal_requirement"
}
