     "maxLength": 20,
     "minLength": 8,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "field": {
    "description": "What to rank by, per 100 g: sugars (default), salt or kcal",
