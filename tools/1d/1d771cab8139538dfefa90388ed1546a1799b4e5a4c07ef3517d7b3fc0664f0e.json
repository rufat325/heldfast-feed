{
 "description": "Adds a recipient and sends a consent invitation when required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "email"
  ],
  "type": "object"
 },
 "name": "assistantmail_add_recipient"
}
