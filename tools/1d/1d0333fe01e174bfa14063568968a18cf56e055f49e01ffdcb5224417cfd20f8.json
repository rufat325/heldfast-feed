{
 "description": "Execute a parameterized SQL query against a configured database connection. Read-only by default.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "connection": {
    "default": "default",
    "type": "string"
   },
   "maxRows": {
    "exclusiveMinimum": 0,
    "maximum": 10000,
    "type": "integer"
   },
   "params": {
    "default": [],
    "items": {},
    "type": "array"
   },
   "sql": {
    "minLength": 1,
    "type": "string"
   },
   "timeoutMs": {
    "exclusiveMinimum": 0,
    "maximum": 300000,
    "type": "integer"
   }
  },
  "required": [
   "sql"
  ],
  "type": "object"
 },
 "name": "query_db",
 "title": "Query database"
}
