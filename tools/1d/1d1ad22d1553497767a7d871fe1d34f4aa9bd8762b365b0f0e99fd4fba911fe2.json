{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List channel invites"
 },
 "description": "List the active invites that point to one specific channel. Unlike discord_list_invites (server-wide), this scopes results to a single channel. Requires the Manage Channels permission. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel_id": {
    "description": "ID (snowflake) of the channel to list invites for.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "channel_id"
  ],
  "type": "object"
 },
 "name": "discord_list_channel_invites",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "invites": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "channel_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "channel_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "code": {
       "type": "string"
      },
      "created_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "expires_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "guild_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "guild_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "inviter": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "username": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "username"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "max_age": {
       "type": "number"
      },
      "max_uses": {
       "type": "number"
      },
      "temporary": {
       "type": "boolean"
      },
      "url": {
       "type": "string"
      },
      "uses": {
       "type": "number"
      }
     },
     "required": [
      "code",
      "url",
      "guild_id",
      "guild_name",
      "channel_id",
      "channel_name",
      "inviter",
      "uses",
      "max_uses",
      "max_age",
      "temporary",
      "created_at",
      "expires_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "invites"
  ],
  "type": "object"
 }
}
