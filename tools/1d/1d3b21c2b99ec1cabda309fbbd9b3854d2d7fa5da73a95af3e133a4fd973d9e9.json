{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update any editable field on an existing static page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Blog ID. Use list_blogs to discover available blog IDs.",
    "minLength": 1,
    "type": "string"
   },
   "body": {
    "description": "Updated HTML body.",
    "maxLength": 1000000,
    "minLength": 1,
    "type": "string"
   },
   "image": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Updated featured image path or URL. Use upload_image for local files."
   },
   "metadata": {
    "description": "Custom metadata entries as key/value objects. Maximum 20 entries; description should be 200 characters or fewer.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "maxLength": 50,
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "pageId": {
    "description": "Page ID.",
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Updated page slug.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "description": "Updated publishing status.",
    "enum": [
     "draft",
     "published"
    ],
    "type": "string"
   },
   "title": {
    "description": "Updated page title.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "blogId",
   "pageId"
  ],
  "type": "object"
 },
 "name": "update_page",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {}
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Update page"
}
