{
 "description": "Add product lines to the active checkout. Set replace=true to replace all existing lines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lines": {
    "description": "Lines to add",
    "items": {
     "properties": {
      "quantity": {
       "description": "Quantity (default: 1)",
       "maximum": 500,
       "minimum": 0,
       "type": "integer"
      },
      "sku": {
       "description": "Product SKU",
       "maxLength": 40,
       "type": "string"
      },
      "substitution": {
       "description": "Allow substitution if unavailable",
       "type": "boolean"
      }
     },
     "required": [
      "sku"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "replace": {
    "description": "Replace all existing lines (default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "lines"
  ],
  "type": "object"
 },
 "name": "add_checkout_lines"
}
