{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. Everything an address owns in the tokenized stock basket: each vault, its shares and current USD value.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Wallet address to look up.",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "stocks_portfolio",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "agent": {
    "description": "Address",
    "type": "string"
   },
   "vaultCount": {
    "description": "Vaults held",
    "type": "number"
   },
   "vaults": {
    "description": "Each vault: address, shares, value in USDC",
    "items": {},
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Stock portfolio of an address"
}
