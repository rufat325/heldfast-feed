{
 "description": "Fetch observations for up to 5 Bank of Canada series (find names with search_series). Defaults to the 10 most recent observations when no range is given.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_date": {
    "$ref": "#/properties/start_date",
    "description": "End of range, YYYY-MM-DD"
   },
   "recent": {
    "description": "Alternatively: just the N most recent observations",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "series": {
    "description": "Series names, e.g. ['FXUSDCAD', 'V39079']",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "start_date": {
    "description": "Start of range, YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "series"
  ],
  "type": "object"
 },
 "name": "get_observations",
 "title": "Get time-series observations"
}
