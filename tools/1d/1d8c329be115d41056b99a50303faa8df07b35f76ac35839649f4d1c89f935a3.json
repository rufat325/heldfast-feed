{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Score candidate venues by travel time fairness for multiple participants. Computes travel times from each participant to each venue and ranks by fairness strategy. The AI should suggest venues (from its own knowledge or via search-venues) and pass them here for scoring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fairness": {
    "description": "Scoring strategy: min_max (default, minimise longest journey), min_total (minimise total travel), min_variance (equalise travel times)",
    "enum": [
     "min_max",
     "min_total",
     "min_variance"
    ],
    "type": "string"
   },
   "participants": {
    "description": "Participant locations (2\u201310 people)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "description": "Name or label (e.g. \"Alice\")",
       "type": "string"
      },
      "lat": {
       "description": "Latitude",
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      "lon": {
       "description": "Longitude",
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      }
     },
     "required": [
      "lat",
      "lon"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "transport_mode": {
    "description": "How participants will travel",
    "enum": [
     "drive",
     "cycle",
     "walk"
    ],
    "type": "string"
   },
   "venues": {
    "description": "Candidate venues to score (1\u201350)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "lat": {
       "description": "Latitude",
       "maximum": 90,
       "minimum": -90,
       "type": "number"
      },
      "lon": {
       "description": "Longitude",
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      },
      "name": {
       "description": "Venue name",
       "type": "string"
      },
      "type": {
       "description": "Venue type (pub, cafe, restaurant, park, etc.)",
       "type": "string"
      }
     },
     "required": [
      "lat",
      "lon",
      "name"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "participants",
   "venues",
   "transport_mode"
  ],
  "type": "object"
 },
 "name": "score-venues"
}
