{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "llm",
 "description": "Given an array of message objects [{role, content}], estimate total token usage and check if it fits in the target model's context window. Warns about truncation risk.",
 "inputSchema": {
  "properties": {
   "max_output_tokens": {
    "description": "Reserved tokens for output (default: 4096)",
    "type": "number"
   },
   "messages": {
    "description": "Array of messages (system/user/assistant)",
    "items": {
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "description": "Target model name (e.g. gpt-4o, claude-3.5-sonnet)",
    "type": "string"
   }
  },
  "required": [
   "messages",
   "model"
  ],
  "type": "object"
 },
 "name": "context_window_check",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "breakdown": {
    "type": "object"
   },
   "chars": {
    "type": "number"
   },
   "context_window": {},
   "fits": {},
   "index": {},
   "message_count": {
    "type": "number"
   },
   "model": {},
   "per_message": {},
   "reserved_output_tokens": {},
   "role": {},
   "tokens": {},
   "total_input_tokens": {},
   "total_tokens": {},
   "utilization_percent": {
    "type": "string"
   },
   "warnings": {}
  },
  "type": "object"
 }
}
