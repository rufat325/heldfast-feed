{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Label a thread"
 },
 "description": "Apply and remove labels on one thread, or one message of it - an Outlook mailbox's categories are its labels. The ids come from labels_list. Adding SPAM junks it, and taking SPAM off brings it back to the inbox. In a Gmail mailbox adding TRASH bins it too; an Outlook mailbox takes no other id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addLabelIds": {
    "items": {
     "description": "A label id from labels_list.",
     "pattern": "^[A-Za-z0-9_-]{1,128}$",
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "The threadId a search or a read answered, or with scope message the message's id.",
    "pattern": "^[A-Za-z0-9_=-]{1,512}$",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "removeLabelIds": {
    "items": {
     "description": "A label id from labels_list.",
     "pattern": "^[A-Za-z0-9_-]{1,128}$",
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "description": "thread, the default, acts on the whole thread; message acts on that one message alone.",
    "enum": [
     "thread",
     "message"
    ],
    "type": "string"
   }
  },
  "required": [
   "mailbox",
   "id"
  ],
  "type": "object"
 },
 "name": "threads_modify",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "labelIds": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "done": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "done"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id",
   "labelIds"
  ],
  "type": "object"
 },
 "title": "Label a thread"
}
