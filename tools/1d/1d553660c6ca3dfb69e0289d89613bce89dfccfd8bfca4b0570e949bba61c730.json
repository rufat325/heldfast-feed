{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Flight and airport status right now"
 },
 "description": "What is happening at an airport, or to a flight, now. By airport code (IATA or ICAO): FAA ground stops, ground delay programs with average and max delay, closures and runway configuration (US); the live departure and arrival board with gates and status (Norway, Avinor); current METAR and TAF (any ICAO airport); aircraft in the air around it. By callsign: that aircraft's live position, altitude and speed. Input: airport or callsign; optional flight, direction, hours_ahead. $0.25 per call. Returns: query{}, airport{iata, icao, name, city, country, lat, lon}, delays{status, ground_stop, ground_delay, closure, arrival_delay, departure_delay, runways, notices}, board{departures[], arrivals[], attribution}, weather{metar, taf, flight_category...}, aircraft[], aircraft_scope, coverage{}, attribution[], sections_failed[], notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "airport"
    ]
   },
   {
    "required": [
     "callsign"
    ]
   }
  ],
  "properties": {
   "airport": {
    "description": "IATA (OSL, JFK) or ICAO (ENGM, KJFK) code.",
    "maxLength": 4,
    "minLength": 3,
    "type": "string"
   },
   "callsign": {
    "description": "Callsign as broadcast (SAS1411, UAL123): the aircraft's live position.",
    "maxLength": 8,
    "minLength": 2,
    "type": "string"
   },
   "direction": {
    "description": "Board direction. Default both.",
    "enum": [
     "both",
     "departures",
     "arrivals"
    ],
    "type": "string"
   },
   "flight": {
    "description": "Flight number to pick from the board (SK344).",
    "maxLength": 8,
    "minLength": 2,
    "type": "string"
   },
   "hours_ahead": {
    "description": "Board window ahead, hours. Default 3.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
