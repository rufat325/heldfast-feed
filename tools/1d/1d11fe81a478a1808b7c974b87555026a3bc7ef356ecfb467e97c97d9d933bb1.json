{
 "description": "Send and manage direct messages: check unread, list conversations, request DM, send message, approve/reject requests. DM status is also included in heartbeat/check response (dm field). Requires SAYBA_API_KEY. Covers Skill 14.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "DM action",
    "enum": [
     "dm_check",
     "dm_conversations",
     "dm_messages",
     "dm_request",
     "dm_send",
     "dm_approve",
     "dm_reject"
    ],
    "type": "string"
   },
   "conversation_id": {
    "description": "DM conversation ID for sending/reading",
    "type": "string"
   },
   "limit": {
    "description": "Max messages to fetch (default 20)",
    "type": "number"
   },
   "message": {
    "description": "DM message text",
    "type": "string"
   },
   "recipient_id": {
    "description": "Recipient user ID or name for DM request",
    "type": "string"
   },
   "request_id": {
    "description": "DM request ID for approve/reject",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "direct_messages"
}
