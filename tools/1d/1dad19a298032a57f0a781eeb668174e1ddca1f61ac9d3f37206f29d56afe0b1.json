  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Look up turnover issue codes"
 },
 "description": "Searches the standard taxonomy of rental-unit turnover issues (component.issue codes such as carpet.pet_urine). Inputs, all optional: query (keywords), area (e.g. flooring), limit (default 8). With no arguments it lists the taxonomy areas and the first codes. Returns matching codes with names and areas, and the total match count. Codes are optional: the turnover estimate tools also accept plain descriptions. Not for: cost estimates, legal or security-deposit questions, work other than rental turnover.\nDeterministic and source-cited: the same input gives the same result.",
 "inputSchema": {
  "properties": {
   "area": {
    "description": "Optional taxonomy area filter, e.g. 'flooring' or 'walls' (not a room). Call with no arguments to list every area in `areas`.",
    "type": "string"
   },
   "audit": {
    "default": false,
    "description": "Also return the run record and input/result hashes (an audit trail). Default false.",
    "type": "boolean"
   },
   "client_refs": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Your own reference ids (e.g. unit_id, job_id). Echoed back, never used.",
    "type": "object"
   },
   "expect_ruleset": {
    "description": "Optional. The ruleset version you built against, as results carry it in provenance.ruleset_version (e.g. 'sd-2026.11.14'), or its sha256: hash. If the rules have changed since, the call fails (nothing computed, nothing charged) and says what is in force now, so you upgrade on your own schedule. Leave it out to answer under the current rules.",
    "type": "string"
   },
   "include_aliases": {
    "default": false,
    "description": "Also return each code's aliases (larger result).",
    "type": "boolean"
   },
   "limit": {
    "default": 8,
    "description": "Most codes to return.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Keywords to match against codes, names and aliases, e.g. 'pet stain carpet'.",
    "maxLength": 200,
    "type": "string"
   },
   "serve_pinned": {
    "default": false,
    "description": "Optional, with expect_ruleset. True asks us to answer under the ruleset version you named even when the rules have changed since, from that version's signed bundle; the result says so in served_from_bundle. We refuse a version older than 12 months, one a later correction or law change replaced for your state, or one we have no bundle for. Default false: the call fails whenever the rules have changed.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
