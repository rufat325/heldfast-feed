{
 "description": "Extract specific pages from a PDF into a new file. Pages are 1-indexed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "Absolute path to the input PDF",
    "type": "string"
   },
   "output": {
    "description": "Absolute path for the output PDF",
    "type": "string"
   },
   "pages": {
    "description": "Page numbers to extract (1-indexed)",
    "items": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "input",
   "pages",
   "output"
  ],
  "type": "object"
 },
 "name": "split_pdf"
}
