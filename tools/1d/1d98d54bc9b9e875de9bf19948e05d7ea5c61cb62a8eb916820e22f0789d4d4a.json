{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Confirm a two-step payment (capture held funds). Optionally capture a partial amount. MOVES REAL MONEY \u2014 irreversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "pattern": "^\\d+(\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    ],
    "description": "Amount for a partial capture (optional; must be <= the authorized amount, same currency). Over-capture is rejected by YooKassa"
   },
   "payment_id": {
    "description": "ID of the payment to capture",
    "type": "string"
   }
  },
  "required": [
   "payment_id"
  ],
  "type": "object"
 },
 "name": "capture_payment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "confirmation_url": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Capture payment"
}
