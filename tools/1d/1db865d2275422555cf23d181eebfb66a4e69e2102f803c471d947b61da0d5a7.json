{
 "description": "Edit specific areas of an image using mask-based inpainting. Requires source image, mask (black=edit, white=keep), and prompt; takes the style and character references, style codes, preset and palette (no exact resolution: inpaint keeps the source size).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "character_reference_image": {
    "description": "Local image file of a character to keep consistent (one image; Ideogram bills character references at its own rate)",
    "minLength": 1,
    "type": "string"
   },
   "character_reference_mask": {
    "description": "Grayscale mask of the character reference (same dimensions); needs character_reference_image",
    "minLength": 1,
    "type": "string"
   },
   "color_palette": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "name": {
        "description": "A preset palette",
        "enum": [
         "EMBER",
         "FRESH",
         "JUNGLE",
         "MAGIC",
         "MELON",
         "MOSAIC",
         "PASTEL",
         "ULTRAMARINE"
        ],
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "members": {
        "description": "Explicit colours, most dominant first",
        "items": {
         "additionalProperties": false,
         "properties": {
          "color_hex": {
           "description": "The colour, #RRGGBB",
           "pattern": "^#[0-9A-Fa-f]{6}$",
           "type": "string"
          },
          "color_weight": {
           "description": "Its share of the palette (0.05-1)",
           "maximum": 1,
           "minimum": 0.05,
           "type": "number"
          }
         },
         "required": [
          "color_hex"
         ],
         "type": "object"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "members"
      ],
      "type": "object"
     }
    ],
    "description": "A preset palette by name, or explicit colours with weights (not both)"
   },
   "image": {
    "description": "Local file path of the source image to edit",
    "minLength": 1,
    "type": "string"
   },
   "magic_prompt": {
    "description": "Auto-enhance prompts (default: AUTO)",
    "enum": [
     "AUTO",
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "mask": {
    "description": "Local file path of the mask image (black = regions to edit, white = keep)",
    "minLength": 1,
    "type": "string"
   },
   "num_images": {
    "description": "Number of variations (1-8, default: 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "prompt": {
    "description": "Description of desired changes",
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "rendering_speed": {
    "description": "Speed/quality tradeoff (default: DEFAULT)",
    "enum": [
     "FLASH",
     "TURBO",
     "DEFAULT",
     "QUALITY"
    ],
    "type": "string"
   },
   "seed": {
    "description": "Reproducibility seed",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "style_codes": {
    "description": "8-character hexadecimal style codes from Ideogram",
    "items": {
     "pattern": "^[0-9A-Fa-f]{8}$",
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "style_preset": {
    "description": "A named style preset as Ideogram lists them",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "style_reference_images": {
    "description": "Local image files whose style the result follows (up to 3, 25 MB each)",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "style_type": {
    "description": "Visual style (the API default is GENERAL when omitted)",
    "enum": [
     "AUTO",
     "GENERAL",
     "REALISTIC",
     "DESIGN",
     "FICTION"
    ],
    "type": "string"
   }
  },
  "required": [
   "image",
   "mask",
   "prompt"
  ],
  "type": "object"
 },
 "name": "ideogram_edit"
}
