{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Change a counter screen"},"description":"Change a counter screen\n\nChanges only the fields you send: name, place, voice agent, face, interface languages (comma separated, e.g. `de,en`), idle text, opening line, on or off, the conversation limits and the opening hours in a time zone.","inputSchema":{"additionalProperties":false,"properties":{"body":{"description":"The request fields as one JSON object.","properties":{"avatarProfileId":{"description":"`id` of one of your faces from `GET /presence/avatars`, `null` for voice only.","exclusiveMinimum":0,"type":["number","null"]},"dailyCapMinutes":{"description":"0 switches the daily cap off.","maximum":1440,"minimum":0,"type":"number"},"greeting":{"maxLength":4000,"type":["string","null"]},"idleText":{"maxLength":255,"type":["string","null"]},"isActive":{"type":"boolean"},"location":{"maxLength":255,"type":["string","null"]},"maxConversationSeconds":{"maximum":1800,"minimum":30,"type":"number"},"name":{"maxLength":255,"minLength":1,"type":"string"},"openFrom":{"type":"string"},"openUntil":{"type":"string"},"silenceSeconds":{"maximum":120,"minimum":5,"type":"number"},"timeZone":{"description":"IANA time zone, e.g. Europe/Berlin.","maxLength":64,"minLength":1,"type":"string"},"uiLanguages":{"maxLength":64,"type":["string","null"]},"voiceAgentId":{"exclusiveMinimum":0,"type":"number"}},"type":"object"},"deviceId":{"description":"deviceId","exclusiveMinimum":0,"type":"integer"}},"required":["deviceId","body"],"type":"object"},"name":"update_presence_device","title":"Change a counter screen"}
