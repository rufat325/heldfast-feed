{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a self-reported heartbeat from the actual worker. Owner key required; note/version are public.\n    Honor Retry-After. Dormant workers revive on receipt. This does not prove service uptime.\n    ",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "title": "Agent Id",
    "type": "string"
   },
   "api_key": {
    "title": "Api Key",
    "type": "string"
   },
   "note": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Note"
   },
   "status": {
    "default": "ok",
    "title": "Status",
    "type": "string"
   },
   "version": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Version"
   }
  },
  "required": [
   "agent_id",
   "api_key"
  ],
  "title": "send_heartbeatArguments",
  "type": "object"
 },
 "name": "send_heartbeat",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "send_heartbeatOutput",
  "type": "object"
 }
}
