{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List processed image batches"
 },
 "description": "Use this when someone asks which images a project has processed, or which resized and converted batches exist. Returns each batch's id, slug, output format and template id, 25 per page by default. Not for one batch's variant files and links.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 1024,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Results per page, from 1 to 100; defaults to 25",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Only batches in this project; every project when absent",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_batches",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "format": {
       "anyOf": [
        {
         "maxLength": 20,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "$ref": "#/properties/items/items/properties/id"
      },
      "templateId": {
       "$ref": "#/properties/items/items/properties/id"
      }
     },
     "required": [
      "id",
      "slug",
      "format",
      "templateId"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 1024,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "total": {
    "description": "Matching records across all pages",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List processed image batches"
}
