{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Free Open Loops"
 },
 "description": "Find released original synthesis kits and individually auditioned source samples by keyword, pack, BPM, key and licence. Automated checks are not listening review. Free; no account or tokens required. Source tags are creator hints. Preserve attribution when required and follow each sample\u2019s licence.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bpm_max": {
    "maximum": 400,
    "minimum": 1,
    "type": "number"
   },
   "bpm_min": {
    "maximum": 400,
    "minimum": 1,
    "type": "number"
   },
   "key": {
    "maxLength": 64,
    "type": "string"
   },
   "license": {
    "enum": [
     "CC0-1.0",
     "CC-BY-3.0"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "pack": {
    "maxLength": 200,
    "type": "string"
   },
   "q": {
    "description": "Search sample titles, pack names and source tags.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_open_loops",
 "outputSchema": {
  "additionalProperties": true,
  "anyOf": [
   {
    "required": [
     "total",
     "offset",
     "limit",
     "items"
    ]
   },
   {
    "required": [
     "error",
     "message"
    ]
   }
  ],
  "properties": {
   "details": {
    "additionalProperties": true,
    "description": "Additional structured context from Pulse.",
    "type": "object"
   },
   "error": {
    "description": "Machine-readable error code.",
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "limit": {
    "type": "integer"
   },
   "message": {
    "description": "Human-readable recovery guidance.",
    "type": "string"
   },
   "offset": {
    "type": "integer"
   },
   "retryable": {
    "description": "Whether the caller may retry after changing state or waiting.",
    "type": "boolean"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [],
  "type": "object"
 }
}
