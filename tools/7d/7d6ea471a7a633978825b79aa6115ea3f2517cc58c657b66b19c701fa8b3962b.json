{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search live recruiter and talent-acquisition job listings on Recruiter Roles. Supports full-text search and filtering by sector, location, employment type, work arrangement, salary, and recency. Returns a paginated list with salary, company, location, and a tracked apply URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City slug, comma-separated (e.g. 'dallas-tx').",
    "type": "string"
   },
   "employment_type": {
    "description": "Employment type filter.",
    "enum": [
     "full_time",
     "part_time",
     "contract",
     "freelance"
    ],
    "type": "string"
   },
   "is_remote": {
    "description": "Shorthand for work_arrangement=remote.",
    "type": "boolean"
   },
   "page": {
    "description": "Page number. Default: 1.",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Results per page. Default: 20, max: 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "posted_since": {
    "description": "ISO date \u2014 jobs posted on or after this date.",
    "type": "string"
   },
   "q": {
    "description": "Full-text search across job title and company name.",
    "type": "string"
   },
   "salary_disclosed": {
    "description": "true = only jobs with a disclosed salary; false = only undisclosed.",
    "type": "boolean"
   },
   "salary_min": {
    "description": "Minimum salary in USD. Only returns jobs with a disclosed salary at or above this.",
    "type": "integer"
   },
   "sector": {
    "description": "Sector slug, comma-separated for multiple (e.g. 'technology,financial-services'). Use list_sectors for valid slugs.",
    "type": "string"
   },
   "sort": {
    "description": "Sort order. Default: recent.",
    "enum": [
     "recent",
     "salary_desc"
    ],
    "type": "string"
   },
   "source_type": {
    "description": "'direct' = employer-posted, 'scraped' = aggregated.",
    "enum": [
     "direct",
     "scraped"
    ],
    "type": "string"
   },
   "state": {
    "description": "State/region code, comma-separated (e.g. 'TX,NY,BC'). Use list_locations for codes.",
    "type": "string"
   },
   "updated_since": {
    "description": "ISO datetime \u2014 for incremental sync; jobs updated on or after this.",
    "type": "string"
   },
   "work_arrangement": {
    "description": "Work arrangement filter.",
    "enum": [
     "on_site",
     "hybrid",
     "remote"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_jobs",
