{
 "annotations": {
  "readOnlyHint": true,
  "title": "File Documentation"
 },
 "description": "Get AI-generated documentation for a specific file in an indexed repository. Returns detailed documentation including summaries, functions, dependencies, and code analysis.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Field preset (default: full).",
    "enum": [
     "basic",
     "summary",
     "full"
    ],
    "type": "string"
   },
   "file_id": {
    "description": "File UUID (from code-fundi-list-files results)",
    "type": "string"
   },
   "repo_key": {
    "description": "Repository UUID or clone URL",
    "type": "string"
   }
  },
  "required": [
   "repo_key",
   "file_id"
  ],
  "type": "object"
 },
 "name": "code-fundi-file-docs"
}
