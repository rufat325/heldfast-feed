{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Quote Stamping"
 },
 "description": "Matched lower and upper stamping dies using the approved print process. Simulation is not exposed. Quote the exact customer-reviewed configuration and revision as one complete set. Consumes one quote allowance. Reuse idempotencyKey for retries. Returns a browser link for customer checkout; individual-part update and checkout are blocked.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accessToken": {
    "description": "Guest token returned by printing.sessions.start. Optional when Authorization already carries a permanent key or guest token.",
    "maxLength": 138,
    "minLength": 34,
    "type": "string"
   },
   "configuration": {
    "additionalProperties": false,
    "description": "Workbench configuration including geometry, materials, quantity and order options.",
    "properties": {
     "fulfillmentMethod": {
      "enum": [
       "shipping",
       "pickup",
       "courier"
      ],
      "type": "string"
     },
     "materialId": {
      "enum": [
       "black_pla"
      ],
      "type": "string"
     },
     "parameters": {
      "additionalProperties": false,
      "properties": {
       "artwork": {
        "anyOf": [
         {
          "type": "null"
         },
         {
          "additionalProperties": false,
          "properties": {
           "height": {
            "maximum": 192,
            "minimum": 8,
            "type": "integer"
           },
           "mask": {
            "description": "Row-major binary artwork mask. Its length must equal width \u00d7 height. Use the browser to convert text or SVG artwork.",
            "maxLength": 36864,
            "minLength": 64,
            "pattern": "^[01]+$",
            "type": "string"
           },
           "name": {
            "maxLength": 80,
            "type": "string"
           },
           "text": {
            "maxLength": 32,
            "type": "string"
           },
           "width": {
            "maximum": 192,
            "minimum": 8,
            "type": "integer"
           }
          },
          "required": [
           "width",
           "height",
           "mask"
          ],
          "type": "object"
         }
        ]
       },
       "backing": {
        "const": 5,
        "description": "Approved stamping-process backing thickness in millimeters.",
        "type": "number"
       },
       "blend": {
        "maximum": 4.5,
        "minimum": 1,
        "type": "number"
       },
       "clearance": {
        "maximum": 0.4,
        "minimum": 0.05,
        "type": "number"
       },
       "depth": {
        "maximum": 2.4,
        "minimum": 0.2,
        "type": "number"
       },
       "guided": {
        "type": "boolean"
       },
       "height": {
        "maximum": 80,
        "minimum": 25,
        "type": "number"
       },
       "operation": {
        "enum": [
         "emboss",
         "deboss"
        ],
        "type": "string"
       },
       "pattern": {
        "enum": [
         "ring",
         "letter",
         "rib",
         "artwork"
        ],
        "type": "string"
       },
       "thickness": {
        "maximum": 0.8,
        "minimum": 0.1,
        "type": "number"
       },
       "width": {
        "maximum": 100,
        "minimum": 30,
        "type": "number"
       }
      },
      "required": [
       "pattern",
       "width",
       "height",
       "operation",
       "artwork",
       "guided",
       "depth",
       "thickness",
       "blend",
       "clearance",
       "backing"
      ],
      "type": "object"
     },
     "productionSpeed": {
      "enum": [
       "standard",
       "rush"
      ],
      "type": "string"
     },
     "quantity": {
      "description": "Number of matched lower/upper die pairs.",
      "maximum": 150,
      "minimum": 1,
      "type": "integer"
     },
     "sheet": {
      "additionalProperties": false,
      "properties": {
       "E": {
        "maximum": 250000,
        "minimum": 10000,
        "type": "number"
       },
       "cycle": {
        "enum": [
         "press",
         "full"
        ],
        "type": "string"
       },
       "friction": {
        "maximum": 0.5,
        "minimum": 0,
        "type": "number"
       },
       "material": {
        "enum": [
         "steel",
         "aluminum",
         "copper"
        ],
        "type": "string"
       },
       "nu": {
        "maximum": 0.45,
        "minimum": 0.2,
        "type": "number"
       },
       "quality": {
        "enum": [
         "quick",
         "fine"
        ],
        "type": "string"
       },
       "tangent": {
        "maximum": 10000,
        "minimum": 0,
        "type": "number"
       },
       "yield": {
        "maximum": 1500,
        "minimum": 10,
        "type": "number"
       }
      },
      "required": [
       "material",
       "E",
       "nu",
       "yield",
       "tangent",
       "friction",
       "quality",
       "cycle"
      ],
      "type": "object"
     }
    },
    "required": [
     "parameters",
     "sheet",
     "quantity",
     "materialId",
     "fulfillmentMethod",
     "productionSpeed"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "description": "Stable unique key for retrying this complete-set quote.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "reviewConfirmed": {
    "const": true,
    "description": "The customer reviewed this exact die pair, sheet assumptions, quantity and prototype limitations. This does not authorize checkout or certify a pressing process.",
    "type": "boolean"
   },
   "reviewedRevision": {
    "description": "Exact revision returned by preparation and reviewed by the customer.",
    "maxLength": 64,
    "minLength": 64,
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "configuration",
   "reviewedRevision",
   "reviewConfirmed",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "quote_stamping",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": true,
    "properties": {
     "build": {
      "additionalProperties": true,
      "description": "Complete-set quote and authoritative server totals, returned after quoting.",
      "type": "object"
     },
     "reviewUrl": {
      "description": "Private design review link for the customer.",
      "format": "uri",
      "type": "string"
     },
     "revision": {
      "description": "Hash of the exact normalized design and quantity.",
      "type": "string"
     },
     "success": {
      "const": true,
      "description": "Confirms the operation succeeded.",
      "type": "boolean"
     },
     "warnings": {
      "description": "Design and manufacturing limitations to review.",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "success",
     "revision",
     "reviewUrl"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "A structured AIURION tool error.",
    "properties": {
     "error": {
      "additionalProperties": true,
      "description": "Machine-readable error details.",
      "properties": {
       "code": {
        "description": "Stable error code.",
        "type": "string"
       },
       "message": {
        "description": "Human-readable error message.",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "success": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "success",
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Quote Stamping"
}
