{
 "annotations": {
  "readOnlyHint": true,
  "title": "List orders"
 },
 "description": "List orders in a shop (paginated), optionally filtered by status or SKU. Printify REST: GET /v1/shops/{shop_id}/orders.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Items per page (default 10, max 10).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "shop_id": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "number"
     }
    ],
    "description": "Shop id \u2014 required."
   },
   "sku": {
    "description": "Filter to orders containing this SKU.",
    "type": "string"
   },
   "status": {
    "description": "Filter by fulfillment status, e.g. 'fulfilled'.",
    "type": "string"
   }
  },
  "required": [
   "shop_id"
  ],
  "type": "object"
 },
 "name": "printify_list_orders",
 "title": "List orders"
}
