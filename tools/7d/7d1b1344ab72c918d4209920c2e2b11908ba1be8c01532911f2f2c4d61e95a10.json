{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Escape hatch: call ANY Infomaniak public API endpoint (api.infomaniak.com) when no dedicated tool exists. GET runs immediately. POST/PUT/PATCH/DELETE follow the two-phase commit pattern. Manager-private (/proxy/...) endpoints are NOT reachable through this tool \u2014 use a typed tool instead.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {},
   "confirmation_token": {
    "format": "uuid",
    "type": "string"
   },
   "method": {
    "enum": [
     "GET",
     "POST",
     "PUT",
     "PATCH",
     "DELETE"
    ],
    "type": "string"
   },
   "path": {
    "allOf": [
     {
      "pattern": "^\\/"
     },
     {
      "pattern": "^\\/\\d+\\/[A-Za-z0-9_/.{}-]+$"
     }
    ],
    "minLength": 2,
    "type": "string"
   },
   "query": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "type": "object"
   }
  },
  "required": [
   "method",
   "path"
  ],
  "type": "object"
 },
 "name": "infomaniak_api_call",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "body": {},
       "method": {
        "enum": [
         "GET",
         "POST",
         "PUT",
         "PATCH",
         "DELETE"
        ],
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "query": {
        "additionalProperties": {},
        "type": "object"
       }
      },
      "required": [
       "method",
       "path"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "method": {
      "$ref": "#/anyOf/0/properties/plan/properties/method"
     },
     "path": {
      "type": "string"
     },
     "response": {},
     "status": {
      "const": "executed",
      "type": "string"
     }
    },
    "required": [
     "status",
     "method",
     "path"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
