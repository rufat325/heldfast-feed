{
 "description": "Find USB-connected Agent-Q Firmware devices by writing a status handshake to candidate USB serial ports, and report sanitized candidate failure reasons.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "scan_devices",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeDeviceId": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z0-9_.-]{1,128}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "devices": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "connected": {
       "const": true,
       "type": "boolean"
      },
      "portPath": {
       "maxLength": 128,
       "pattern": "^[\\x20-\\x7E]*$",
       "type": "string"
      },
      "source": {
       "const": "live",
       "type": "string"
      },
      "status": {
       "additionalProperties": false,
       "properties": {
        "device": {
         "additionalProperties": false,
         "properties": {
          "deviceId": {
           "pattern": "^[A-Za-z0-9_.-]{1,128}$",
           "type": "string"
          },
          "firmwareName": {
           "maxLength": 64,
           "pattern": "^[\\x20-\\x7E]*$",
           "type": "string"
          },
          "firmwareVersion": {
           "maxLength": 32,
           "pattern": "^[\\x20-\\x7E]*$",
           "type": "string"
          },
          "hardware": {
           "maxLength": 64,
           "pattern": "^[\\x20-\\x7E]*$",
           "type": "string"
          },
          "state": {
           "enum": [
            "idle",
            "busy",
            "awaiting_approval",
            "locked",
            "error"
           ],
           "type": "string"
          }
         },
         "required": [
          "deviceId",
          "state",
          "firmwareName",
          "hardware",
          "firmwareVersion"
         ],
         "type": "object"
        },
        "provisioning": {
         "additionalProperties": false,
         "properties": {
          "state": {
           "enum": [
            "unprovisioned",
            "provisioning",
            "provisioned",
            "locked",
            "error"
           ],
           "type": "string"
          }
         },
         "required": [
          "state"
         ],
         "type": "object"
        }
       },
       "required": [
        "device",
        "provisioning"
       ],
       "type": "object"
      }
     },
     "required": [
      "source",
      "connected",
      "portPath",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "failures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "connected": {
       "const": false,
       "type": "boolean"
      },
      "firmwareErrorCode": {
       "type": "string"
      },
      "portPath": {
       "maxLength": 128,
       "pattern": "^[\\x20-\\x7E]*$",
       "type": "string"
      },
      "source": {
       "const": "error",
       "type": "string"
      },
      "unavailableReason": {
       "enum": [
        "timeout",
        "port_not_found",
        "port_in_use",
        "port_permission_denied",
        "handshake_failed",
        "unsupported_version",
        "transport_closed"
       ],
       "type": "string"
      }
     },
     "required": [
      "source",
      "connected",
      "portPath",
      "unavailableReason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "const": "live",
    "type": "string"
   }
  },
  "required": [
   "source",
   "devices",
   "failures",
   "activeDeviceId"
  ],
  "type": "object"
 },
 "title": "Scan devices"
}
