{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get API details"
 },
 "description": "Get full details for a specific API by slug, or by handle + urlName pair. Returns pricing, stats, uptime, and publisher info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "handle": {
    "$ref": "#/properties/slug",
    "description": "Publisher handle"
   },
   "slug": {
    "description": "API slug, e.g. 'demo-weather'",
    "pattern": "^[a-z0-9_-]+$",
    "type": "string"
   },
   "urlName": {
    "$ref": "#/properties/slug",
    "description": "API URL name"
   }
  },
  "type": "object"
 },
 "name": "gatefare.get_api"
}
