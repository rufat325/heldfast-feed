 "description": "Decide whether two Avro schemas are compatible, in both directions, under the resolution rules rather than by structural comparison. Backward is a reader on the new schema reading data already written with the old one; forward is a reader still on the old schema reading data written with the new one. Fields match by name with reader aliases consulted, int promotes to long, float and double one way only, and an enum symbol the reader lacks needs an enum default. Pay 220000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "The later schema. An Avro schema, as a JSON object or as JSON text, at most 262144 bytes. Nothing is fetched and no registry is consulted, so the documents supplied are the whole input.",
    "example": {
     "fields": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "total_cents",
       "type": "int"
      },
      {
       "name": "status",
       "type": {
        "name": "Status",
        "symbols": [
         "OPEN"
        ],
        "type": "enum"
       }
      },
      {
       "default": null,
       "name": "note",
       "type": [
        "null",
        "string"
       ]
      },
      {
       "name": "channel",
       "type": "string"
      }
     ],
     "name": "Order",
     "namespace": "shop.v1",
     "type": "record"
    },
    "type": [
     "object",
     "string"
    ]
   },
   "before": {
    "description": "The earlier schema. An Avro schema, as a JSON object or as JSON text, at most 262144 bytes. Nothing is fetched and no registry is consulted, so the documents supplied are the whole input.",
    "example": {
     "fields": [
      {
       "name": "order_id",
       "type": "string"
      },
      {
       "name": "total_cents",
       "type": "long"
      },
      {
       "name": "status",
       "type": {
        "name": "Status",
        "symbols": [
         "OPEN",
         "CLOSED"
        ],
        "type": "enum"
       }
      },
      {
       "default": null,
       "name": "note",
       "type": [
        "null",
        "string"
       ]
      }
     ],
     "name": "Order",
     "namespace": "shop.v1",
     "type": "record"
    },
    "type": [
     "object",
     "string"
    ]
   }
  },
  "required": [
   "before",
   "after"
  ],
  "type": "object"
 },
