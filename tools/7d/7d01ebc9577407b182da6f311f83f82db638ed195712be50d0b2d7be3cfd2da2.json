{
 "_meta": {
  "opentrain.ai/authoring-retry": {
   "allowedRetryAction": "Repeat only the identical key and payload to recover the durable receipt; then inspect canonical readback. Never allocate a new key for an uncertain outcome.",
   "automaticRetry": false,
   "identityFields": [
    "folderId",
    "idempotencyKey",
    "exactRequestPayload"
   ],
   "inspect": [
    {
     "method": "GET",
     "path": "/api/public/v1/instructions/folders/{folderId}/videos/{assetId}"
    }
   ],
   "keyRequirement": "SAME_KEY_AND_PAYLOAD",
   "missingResourceBehavior": "UNKNOWN_NOT_SUCCESS",
   "policy": "DURABLE_RECEIPT",
   "schemaVersion": "folder-instruction-authoring-retry/1",
   "staleStateBehavior": "A key/payload conflict requires inspection, not a new identity or blind retry.",
   "stateActions": {
    "REPLAYED": "INSPECT_CANONICAL_READBACK",
    "UNCERTAIN": "SAME_KEY_AND_PAYLOAD",
    "UPLOAD_GRANT_NOT_REPLAYABLE": "INSPECT_SAME_ASSET_NEVER_REISSUE_GRANT"
   }
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Reserve a page-bound direct TUS upload, not a document edit. The one-time grant is secret and never replayed; retry returns status/cancel recovery, not a fresh grant. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "contentType": {
      "enum": [
       "video/mp4",
       "video/webm",
       "video/ogg",
       "video/quicktime"
      ],
      "type": "string"
     },
     "durationSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 7200,
      "type": "number"
     },
     "fileName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "idempotencyKey": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "pageId": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "sizeBytes": {
      "maximum": 2000000000,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "pageId",
     "fileName",
     "contentType",
     "sizeBytes",
     "durationSeconds",
     "idempotencyKey"
    ],
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "request"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_video_prepare",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "assetId": {
      "$ref": "#/properties/result/properties/folderId"
     },
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "chunkBytes": {
      "minimum": 0,
      "type": "integer"
     },
     "contentType": {
      "type": "string"
     },
     "fileName": {
      "$ref": "#/properties/result/properties/contentType"
     },
     "folderId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "node": {
      "additionalProperties": false,
      "properties": {
       "alt": {
        "const": "opentrain-instruction-video:upload",
        "type": "string"
       },
       "src": {
        "$ref": "#/properties/result/properties/contentType"
       },
       "type": {
        "const": "image",
        "type": "string"
       }
      },
      "required": [
       "type",
       "src",
       "alt"
      ],
      "type": "object"
     },
     "pageId": {
      "$ref": "#/properties/result/properties/folderId"
     },
     "protocol": {
      "const": "tus",
      "type": "string"
     },
     "recovery": {
      "additionalProperties": false,
      "properties": {
       "cancelPath": {
        "$ref": "#/properties/result/properties/contentType"
       },
       "message": {
        "$ref": "#/properties/result/properties/contentType"
       },
       "reason": {
        "const": "UPLOAD_URL_NOT_REPLAYABLE",
        "type": "string"
       },
       "statusPath": {
        "$ref": "#/properties/result/properties/contentType"
       }
      },
      "required": [
       "reason",
       "message",
       "statusPath",
       "cancelPath"
      ],
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     },
     "sizeBytes": {
      "$ref": "#/properties/result/properties/chunkBytes"
     },
     "status": {
      "const": "PENDING",
      "type": "string"
     },
     "uploadExpiresAt": {
      "$ref": "#/properties/result/properties/contentType"
     },
     "uploadMaxDurationSeconds": {
      "$ref": "#/properties/result/properties/chunkBytes"
     },
     "uploadUrl": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "canonicalSource",
     "folderId",
     "pageId",
     "assetId",
     "status",
     "protocol",
     "chunkBytes",
     "contentType",
     "sizeBytes",
     "fileName",
     "uploadMaxDurationSeconds",
     "uploadExpiresAt",
     "node",
     "replayed",
     "uploadUrl"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
