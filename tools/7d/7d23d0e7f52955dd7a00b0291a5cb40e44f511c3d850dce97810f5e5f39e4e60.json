{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search up to 20 exact normalized-text queries in one bounded call. Useful when an agent needs several clauses or fields from one PDF.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum matches per query.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Optional 1-based page filter.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "queries": {
    "description": "One to twenty exact or normalized text queries.",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "document_id",
   "capability",
   "queries"
  ],
  "type": "object"
 },
 "name": "batch_search_document",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Results for each bounded native-text search query.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "extensions": {},
   "resource": {},
   "results": {
    "items": {},
    "type": "array"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Batch search PDF text"
}
