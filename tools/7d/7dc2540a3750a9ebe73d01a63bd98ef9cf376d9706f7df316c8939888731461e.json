{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a virtual key's name, secret, note, or limits. Rotating the key takes effect immediately, and limit changes apply to downstream prompts and configs using this slug. Returns success when Portkey accepts the update.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "alert_threshold": {
    "description": "New alert threshold percentage (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "credit_limit": {
    "description": "New credit limit for usage",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "deployment_configurations": {
    "description": "Replacement Azure deployment configurations",
    "items": {
     "properties": {
      "alias": {
       "description": "Optional model alias for the deployment",
       "type": "string"
      },
      "api_version": {
       "description": "Azure OpenAI API version",
       "minLength": 1,
       "type": "string"
      },
      "deployment_name": {
       "description": "Azure deployment name",
       "minLength": 1,
       "type": "string"
      },
      "is_default": {
       "description": "Whether this is the default Azure deployment",
       "type": "boolean"
      }
     },
     "required": [
      "api_version",
      "deployment_name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "key": {
    "description": "New provider API key value",
    "type": "string"
   },
   "name": {
    "description": "New display name for the key",
    "type": "string"
   },
   "note": {
    "description": "New note or description",
    "type": "string"
   },
   "rate_limit_rpm": {
    "description": "New rate limit in requests per minute",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "secret_mappings": {
    "description": "Replacement Secret Reference mappings",
    "items": {
     "properties": {
      "secret_key": {
       "description": "Optional key selected from a structured external secret",
       "type": [
        "string",
        "null"
       ]
      },
      "secret_reference_id": {
       "description": "Secret Reference ID that owns the external secret",
       "type": "string"
      },
      "target_field": {
       "description": "Virtual Key field populated from the Secret Reference",
       "type": "string"
      },
      "value_format": {
       "anyOf": [
        {
         "enum": [
          "json",
          "string"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Whether Portkey reads the mapped value as JSON or a string"
      }
     },
     "required": [
      "target_field",
      "secret_reference_id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "description": "The slug of the virtual key to update",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_virtual_key",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
