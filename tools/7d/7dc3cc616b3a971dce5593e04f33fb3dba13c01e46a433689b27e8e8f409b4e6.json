{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Adjusts a melody so it can be played on a music box and lists every change. Strategies: \"transpose\" (shift the whole melody to the key that fits best), \"nearest_note\" (move each unplayable note to the closest playable one), \"transpose_then_nearest\" (default: both). Optionally snaps notes to a grid. Returns the new melody and its validation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "box": {
    "description": "Music box type: \"15\", \"20\", \"30\" (notes) or \"freestyle\" (digital only). See list_music_boxes.",
    "enum": [
     "15",
     "20",
     "30",
     "freestyle"
    ],
    "type": "string"
   },
   "bpm": {
    "description": "Tempo in beats per minute (30-300).",
    "maximum": 300,
    "minimum": 30,
    "type": "number"
   },
   "illegal_threshold_ticks": {
    "description": "Minimum gap between two identical notes, in ticks (default 384 = 2 beats).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "notes": {
    "description": "Notes in any order, at most 2000. Only onsets matter: music boxes have no note durations.",
    "items": {
     "properties": {
      "beat": {
       "description": "When the note sounds, in quarter notes from 0 (e.g. 0, 1, 1.5).",
       "minimum": 0,
       "type": "number"
      },
      "pitch": {
       "anyOf": [
        {
         "maxLength": 8,
         "type": "string"
        },
        {
         "maximum": 127,
         "minimum": 0,
         "type": "integer"
        }
       ],
       "description": "Note name like \"C5\", \"F#4\", \"Bb3\", or a MIDI number (60 = C4)."
      },
      "ticks": {
       "description": "Alternative to beat: 192 ticks per quarter note.",
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "pitch"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "quantize_beats": {
    "description": "Snap every note to this grid in beats (e.g. 0.5 = eighth notes).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "strategy": {
    "enum": [
     "transpose",
     "nearest_note",
     "transpose_then_nearest"
    ],
    "type": "string"
   },
   "target_box": {
    "description": "Box to fit into. Defaults to the melody's box.",
    "enum": [
     "15",
     "20",
     "30",
     "freestyle"
    ],
    "type": "string"
   }
  },
  "required": [
   "box",
   "bpm",
   "notes"
  ],
  "type": "object"
 },
 "name": "fit_melody_to_box",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "changes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "type": "string"
      },
      "index": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "kind": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "index",
      "kind",
      "from",
      "to"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "composer_link": {
    "description": "Opens the composer with the fitted melody loaded, without saving.",
    "type": "string"
   },
   "melody": {
    "additionalProperties": false,
    "properties": {
     "box": {
      "type": "string"
     },
     "bpm": {
      "type": "number"
     },
     "notes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "beat": {
         "type": "number"
        },
        "pitch": {
         "type": [
          "string",
          "number"
         ]
        },
        "ticks": {
         "type": "number"
        }
       },
       "required": [
        "pitch"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "box",
     "bpm",
     "notes"
    ],
    "type": "object"
   },
   "semitones": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "summary": {
    "type": "string"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "index": {
         "description": "Index of the note in the input, when the issue is about one note.",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning"
         ],
         "type": "string"
        },
        "suggestions": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ok": {
      "type": "boolean"
     },
     "stats": {
      "additionalProperties": false,
      "properties": {
       "duration_seconds": {
        "type": "number"
       },
       "illegal_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "note_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "strip_length_cm": {
        "type": "number"
       }
      },
      "required": [
       "note_count",
       "illegal_count",
       "duration_seconds"
      ],
      "type": "object"
     }
    },
    "required": [
     "ok",
     "issues",
     "stats"
    ],
    "type": "object"
   }
  },
  "required": [
   "summary",
   "semitones",
   "changes",
   "melody",
   "validation"
  ],
  "type": "object"
 },
 "title": "Fit a melody to a music box"
}
