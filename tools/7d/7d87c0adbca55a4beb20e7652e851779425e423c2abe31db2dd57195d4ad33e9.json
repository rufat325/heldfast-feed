{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read bounded camera and screen recording sets in the selected workspace with status, duration and alignment warnings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "collecting_assets",
       "analyzing",
       "finalizing",
       "ready",
       "failed"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "workspaceId",
   "status",
   "limit",
   "offset"
  ],
  "type": "object"
 },
 "name": "recording_sets_list",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "List Synchronized Recordings"
}
