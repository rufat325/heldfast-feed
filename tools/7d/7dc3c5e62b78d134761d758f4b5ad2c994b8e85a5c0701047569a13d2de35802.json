{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "connections:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List a cursor page of saved connection metadata for one of your AIs. Continue with nextCursor as afterCursor until null. Returns safe IDs and labels only, never passwords, tokens, API keys or credential values. Selecting a saved credential does not grant new permission.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "actingAiId": {
    "description": "Authorized Darwin AI whose saved credential metadata to list.",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "afterCursor": {
    "description": "Continue after the previous response nextCursor.",
    "maxLength": 512,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum saved credentials to return, up to 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "actingAiId"
  ],
  "type": "object"
 },
 "name": "list_auth_credentials",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "credentials": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
       "type": "string"
      },
      "credentialId": {
       "maxLength": 200,
       "minLength": 1,
       "pattern": "^[A-Za-z0-9_-]+$",
       "type": "string"
      },
      "expiresAt": {
       "anyOf": [
        {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "label": {
       "anyOf": [
        {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "provider": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "credentialId",
      "provider",
      "label",
      "status",
      "expiresAt",
      "createdAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 512,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "credentials",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List auth credentials"
}
