{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: compact bridge-side node search by name/path glob, exact or partial operator type, family and bounded depth. Returns {count, truncated, matches/paths, search_metadata} without transferring topology; older bridges fall back only to structured list/topology reads. Prefer this over get_td_nodes when looking through a sub-tree; use get_td_topology only when you need wiring.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "family": {
    "description": "Optional exact TouchDesigner operator family.",
    "enum": [
     "TOP",
     "CHOP",
     "SOP",
     "DAT",
     "COMP",
     "MAT",
     "POP"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Max matches to return.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "max_depth": {
    "description": "Maximum descendant depth; 1 means direct children. Overrides recursive=true.",
    "maximum": 32,
    "minimum": 1,
    "type": "integer"
   },
   "name_glob": {
    "description": "Additional name-only '*' glob.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "node_scan_limit": {
    "default": 5000,
    "description": "Hard cap on nodes inspected inside TouchDesigner.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Where to search from.",
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "path_glob": {
    "description": "Additional absolute-path '*' glob.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "path_only": {
    "default": false,
    "description": "Return only matching paths.",
    "type": "boolean"
   },
   "pattern": {
    "description": "Case-insensitive name/path filter with '*' wildcards (e.g. 'text*', '*noise*').",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "recursive": {
    "default": true,
    "description": "Search the whole sub-network (true) or only direct children (false).",
    "type": "boolean"
   },
   "time_limit_ms": {
    "default": 500,
    "description": "Hard bridge-side search budget in milliseconds.",
    "maximum": 2000,
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Case-insensitive operator-type substring (e.g. 'TOP', 'noise').",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "type_match": {
    "default": "partial",
    "description": "Whether `type` is a substring or an exact operator type.",
    "enum": [
     "partial",
     "exact"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_td_nodes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Total nodes matched before `limit` truncation.",
    "type": "number"
   },
   "matches": {
    "description": "Default mode: each matched node as {path, name, type, family}.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "family": {
       "enum": [
        "TOP",
        "CHOP",
        "SOP",
        "DAT",
        "COMP",
        "MAT",
        "POP"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "parent_path": {
    "description": "The network root the search ran under.",
    "type": "string"
   },
   "paths": {
    "description": "path_only mode: the matched node paths and nothing else.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recursive": {
    "description": "Whether descendants were searched, echoing the request.",
    "type": "boolean"
   },
   "search_metadata": {
    "additionalProperties": false,
    "description": "Current-bridge scan completeness and budget evidence; absent on an older-bridge fallback.",
    "properties": {
     "count_complete": {
      "type": "boolean"
     },
     "matched": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "returned": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "scan_truncated": {
      "type": "boolean"
     },
     "scanned": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "stop_reason": {
      "enum": [
       "completed",
       "node_scan_limit",
       "parameter_scan_limit",
       "time_limit"
      ],
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "scanned",
     "matched",
     "returned",
     "truncated",
     "scan_truncated",
     "count_complete",
     "stop_reason"
    ],
    "type": "object"
   },
   "source": {
    "enum": [
     "bridge_search",
     "legacy_structured_fallback"
    ],
    "type": "string"
   },
   "truncated": {
    "description": "True if more nodes matched than `limit` returned.",
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "maxItems": 4,
    "type": "array"
   }
  },
  "required": [
   "parent_path",
   "recursive",
   "count",
   "truncated",
   "source"
  ],
  "type": "object"
 },
 "title": "Find TouchDesigner nodes"
}
