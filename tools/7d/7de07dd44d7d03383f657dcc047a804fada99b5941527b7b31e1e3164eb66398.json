    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "purpose": {
    "description": "Trading purpose filter",
    "enum": [
     "spot",
     "futures",
     "p2p"
    ],
    "type": "string"
   }
  },
  "required": [
   "country"
  ],
  "type": "object"
 },
