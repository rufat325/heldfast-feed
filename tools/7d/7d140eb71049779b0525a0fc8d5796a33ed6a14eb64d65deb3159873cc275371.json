{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update Order"
 },
 "description": "Update an order (status, customer, delivery, comments). Only the fields you pass are sent. Returns {success}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "by": {
    "default": "id",
    "description": "Lookup field",
    "enum": [
     "id",
     "externalId"
    ],
    "type": "string"
   },
   "customer_comment": {
    "description": "Customer-visible comment",
    "type": "string"
   },
   "customer_external_id": {
    "description": "Re-link the order to an existing customer by externalId",
    "type": "string"
   },
   "customer_id": {
    "description": "Re-link the order to an existing customer by RetailCRM ID",
    "type": "integer"
   },
   "delivery_address": {
    "description": "Updated delivery address",
    "type": "string"
   },
   "delivery_code": {
    "description": "Updated delivery type code",
    "type": "string"
   },
   "delivery_cost": {
    "description": "Updated delivery cost",
    "type": "number"
   },
   "email": {
    "description": "Updated customer email",
    "type": "string"
   },
   "first_name": {
    "description": "Updated customer first name",
    "type": "string"
   },
   "id": {
    "description": "Order ID to update",
    "type": "string"
   },
   "last_name": {
    "description": "Updated customer last name",
    "type": "string"
   },
   "manager_comment": {
    "description": "Internal manager comment",
    "type": "string"
   },
   "phone": {
    "description": "Updated customer phone",
    "type": "string"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   },
   "status": {
    "description": "New status code",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_order"
}
