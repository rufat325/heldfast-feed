{
 "description": "Extract main text, metadata, headings, links and JSON-LD from a public URL without executing JavaScript. HTML, JSON and text; CSS scoping. $0.01 USDC.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ignore_json_paths": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "pattern": "^\\/",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "ignore_selectors": {
    "items": {
     "maxLength": 256,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "include_links": {
    "default": true,
    "type": "boolean"
   },
   "include_structured_data": {
    "default": true,
    "type": "boolean"
   },
   "max_chars": {
    "default": 20000,
    "maximum": 50000,
    "minimum": 100,
    "type": "integer"
   },
   "selector": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "fresh402_extract"
}
