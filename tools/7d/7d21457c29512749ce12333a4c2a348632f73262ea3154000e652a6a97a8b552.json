{
 "description": "List all tracked videos. Free. Supports pagination and filtering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "end_date": {
    "description": "Filter: posted before (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (1-100, default 20)",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "type": "number"
   },
   "platform": {
    "description": "Filter by platform",
    "enum": [
     "tiktok",
     "youtube",
     "insta"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Filter: posted after (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_videos"
}
