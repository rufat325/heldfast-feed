{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search and get monitoring events from Cloud Insight with filtering options.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "endTime": {
    "description": "End time in Unix epoch milliseconds",
    "type": "number"
   },
   "eventLevel": {
    "description": "Event severity level filter",
    "enum": [
     "CRITICAL",
     "WARNING",
     "INFO"
    ],
    "type": "string"
   },
   "pageNum": {
    "description": "Page number (default: 1)",
    "type": "number"
   },
   "pageSize": {
    "description": "Number of results per page (default: 20)",
    "type": "number"
   },
   "prodKey": {
    "description": "Product key to filter events",
    "type": "string"
   },
   "ruleGroupId": {
    "description": "Rule group ID to filter events",
    "type": "string"
   },
   "startTime": {
    "description": "Start time in Unix epoch milliseconds",
    "type": "number"
   }
  },
  "required": [
   "startTime",
   "endTime"
  ],
  "type": "object"
 },
 "name": "ncloud_search_events"
}
