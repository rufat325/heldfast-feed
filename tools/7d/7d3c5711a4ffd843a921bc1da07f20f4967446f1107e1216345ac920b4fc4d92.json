   "models": {
    "description": "2-4 model names to compare, e.g. ['GPT-4o', 'Claude Opus 5', 'Gemini 3.1 Pro']",
    "items": {
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "volumePreset": {
    "description": "Monthly request volume: 10k, 100k, or 1m. Default: 100k",
    "enum": [
     "10k",
     "100k",
     "1m"
    ],
    "type": "string"
   }
  },
  "required": [
   "models"
  ],
  "type": "object"
 },
