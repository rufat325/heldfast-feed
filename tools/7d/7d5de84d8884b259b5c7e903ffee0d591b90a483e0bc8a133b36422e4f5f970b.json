{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Compute source-separated period comparisons, CPA and reported ROAS from supplied Google Ads, Meta Ads and GA4 rows. Return row-level provenance and quality warnings. No ad account access, scheduling, causal attribution or campaign changes.","inputSchema":{"$defs":{"dateRange":{"additionalProperties":false,"properties":{"end":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"start":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"}},"required":["start","end"],"type":"object"},"row":{"additionalProperties":false,"properties":{"campaign":{"minLength":1,"type":"string"},"conversions":{"minimum":0,"type":"number"},"currency":{"pattern":"^[A-Z]{3}$","type":"string"},"id":{"minLength":1,"type":"string"},"leads":{"minimum":0,"type":"number"},"period":{"enum":["current","previous"]},"revenue":{"minimum":0,"type":"number"},"sessions":{"minimum":0,"type":"number"},"source":{"enum":["google_ads","meta_ads","ga4"]},"spend":{"minimum":0,"type":"number"},"timezone":{"minLength":1,"type":"string"}},"required":["id","source","campaign","period"],"type":"object"}},"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currency":{"description":"ISO-like three-letter currency code, normally USD.","pattern":"^[A-Z]{3}$","type":"string"},"currentPeriod":{"$ref":"#/$defs/dateRange"},"isSynthetic":{"description":"Use true only for a clearly labelled synthetic sample.","type":"boolean"},"previousPeriod":{"$ref":"#/$defs/dateRange"},"rows":{"items":{"$ref":"#/$defs/row"},"maxItems":1000,"type":"array"},"timezone":{"minLength":1,"type":"string"}},"required":["currency","timezone","currentPeriod","previousPeriod","rows"],"title":"Marketing report snapshot input","type":"object"},"name":"analyze_marketing_report","title":"Analyze a traceable marketing snapshot"}
