{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Evaluate a structured situation against the published ACI corpus.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "schema_version": {
    "const": "1.0.0"
   },
   "situation": {
    "$id": "https://agentcompanyindex.com/schemas/match-request.schema.json",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "description": "The one shape for a matching situation, used both as the POST /api/v1/match request body and, once extracted from free text or guided answers, as the 'interpreted_situation' echoed back in match-response.schema.json. SEARCH_AND_MATCHING.md \u00a72: all fields are optional, but an incomplete situation must be surfaced, not silently assumed.",
    "properties": {
     "budget_preference": {
      "maxLength": 200,
      "type": [
       "string",
       "null"
      ]
     },
     "category": {
      "maxLength": 100,
      "minLength": 1,
      "type": [
       "string",
       "null"
      ]
     },
     "compliance_requirements": {
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "type": "array"
     },
     "desired_next_action": {
      "enum": [
       "website",
       "demo",
       "signup",
       "contact",
       "partner_intro",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "excluded_conditions": {
      "items": {
       "maxLength": 200,
       "type": "string"
      },
      "type": "array"
     },
     "free_text": {
      "description": "Original query, retained for debugging per SEARCH_AND_MATCHING.md \u00a77. Never used as profile evidence.",
      "maxLength": 2000,
      "type": [
       "string",
       "null"
      ]
     },
     "industry": {
      "maxLength": 100,
      "type": [
       "string",
       "null"
      ]
     },
     "locale": {
      "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
      "type": "string"
     },
     "markets": {
      "items": {
       "maxLength": 20,
       "minLength": 2,
       "type": "string"
      },
      "type": "array"
     },
     "organization_size": {
      "additionalProperties": false,
      "properties": {
       "employees": {
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "size_band": {
        "enum": [
         "micro",
         "small",
         "medium",
         "large",
         "enterprise",
         null
        ],
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "required_capabilities": {
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "type": "array"
     },
     "required_deployment_model": {
      "enum": [
       "cloud",
       "on_premises",
       "both",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "required_integrations": {
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "type": "array"
     },
     "required_languages": {
      "items": {
       "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
       "type": "string"
      },
      "type": "array"
     },
     "unknown_policy": {
      "default": "surface",
      "enum": [
       "surface",
       "hide"
      ],
      "type": "string"
     },
     "workforce_context": {
      "items": {
       "maxLength": 100,
       "type": "string"
      },
      "type": "array"
     }
    },
    "title": "Agent Company Index match request / interpreted situation",
    "type": "object"
   }
  },
  "required": [
   "schema_version",
   "situation"
  ],
  "type": "object"
 },
 "name": "evaluate_situation"
}
