{
 "description": "List retraining cases with job/worker/status filters. Cursor-paged with explicit hasMore \u2014 a non-null nextCursor means more pages exist, so nothing truncates silently. Masked names only; no answer keys. Requires lms:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractId": {
    "$ref": "#/properties/jobId"
   },
   "cursor": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "DRAFT",
     "ASSIGNED",
     "CLOSED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "opentrain_lms_retraining_list_cases",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
