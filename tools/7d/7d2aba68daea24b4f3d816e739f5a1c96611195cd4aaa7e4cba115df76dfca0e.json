{
 "description": "Run a local SEO audit for a domain and location.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Domain or business name",
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "description": "Target location",
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "domain",
   "location"
  ],
  "type": "object"
 },
 "name": "agentseo_local_audit",
 "title": "AgentSEO Local Audit"
}
