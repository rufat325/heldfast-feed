{
 "description": "Add conditional formatting to a Google Sheet",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Alias of the Google account to target. Optional \u2014 defaults to the session/global default account, or the sole authenticated account. Run manage_accounts list to see available aliases.",
    "type": "string"
   },
   "condition": {
    "description": "Condition configuration",
    "properties": {
     "type": {
      "description": "Condition type",
      "enum": [
       "NUMBER_GREATER",
       "NUMBER_LESS",
       "TEXT_CONTAINS",
       "TEXT_STARTS_WITH",
       "TEXT_ENDS_WITH",
       "CUSTOM_FORMULA"
      ],
      "type": "string"
     },
     "value": {
      "description": "Value to compare or formula",
      "type": "string"
     }
    },
    "type": "object"
   },
   "format": {
    "description": "Format to apply when condition is true",
    "properties": {
     "backgroundColor": {
      "properties": {
       "blue": {
        "type": "number"
       },
       "green": {
        "type": "number"
       },
       "red": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "textFormat": {
      "properties": {
       "bold": {
        "type": "boolean"
       },
       "foregroundColor": {
        "properties": {
         "blue": {
          "type": "number"
         },
         "green": {
          "type": "number"
         },
         "red": {
          "type": "number"
         }
        },
        "type": "object"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "range": {
    "description": "Range to apply formatting (e.g., 'A1:C10')",
    "type": "string"
   },
   "spreadsheetId": {
    "description": "Spreadsheet ID",
    "type": "string"
   }
  },
  "required": [
   "spreadsheetId",
   "range",
   "condition",
   "format"
  ],
  "type": "object"
 },
 "name": "addGoogleSheetConditionalFormat"
}
