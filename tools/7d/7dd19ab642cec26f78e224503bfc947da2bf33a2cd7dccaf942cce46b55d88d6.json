{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Collection"
 },
 "description": "Update a collection's name, icon, description, budget, or sharing status. Only provide the fields you want to change \u2014 omitted fields stay unchanged. Set is_public=true to share (returns public URL), is_public=false to unshare.",
 "inputSchema": {
  "properties": {
   "budget": {
    "description": "New budget amount",
    "type": "number"
   },
   "budget_currency": {
    "description": "New budget currency",
    "type": "string"
   },
   "color": {
    "description": "Hex color (e.g. \"#3B82F6\", \"#22C55E\", \"#EF4444\")",
    "type": "string"
   },
   "description": {
    "description": "New description",
    "maxLength": 500,
    "type": "string"
   },
   "icon": {
    "description": "Material Symbols icon name (e.g. \"devices\", \"home\", \"shopping_bag\")",
    "type": "string"
   },
   "id": {
    "description": "The collection ID to update",
    "type": "string"
   },
   "is_public": {
    "description": "Set true to share (generates public URL), false to unshare",
    "type": "boolean"
   },
   "name": {
    "description": "New collection name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "description": "Why this change was made (shown to user in change history)",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_collection"
}
