{
 "description": "Register the population for a control \u2014 either an explicit item list or a declared size. Bounded to 10000 items.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "controlId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "declaredSize": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "date": {
       "type": "string"
      },
      "reference": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "reference"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "type": "array"
   },
   "period": {
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "description"
  ],
  "type": "object"
 },
 "name": "create_population",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "population": {}
  },
  "required": [
   "population"
  ],
  "type": "object"
 },
 "title": "Create a population"
}
