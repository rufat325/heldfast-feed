{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "supovia:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Resolve or reopen a conversation"
 },
 "description": "Use this when someone wants to mark a customer conversation resolved or done, or reopen it. Returns the conversation id, resolved state and last edit time, and the operator dashboard updates live. Repeating the same state has no further effect. Not for replying to the customer.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conversationId": {
    "description": "Conversation to update",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "resolved": {
    "description": "true to mark it resolved (the default), false to reopen it",
    "type": "boolean"
   }
  },
  "required": [
   "conversationId"
  ],
  "type": "object"
 },
 "name": "resolve_conversation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conversation": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "maxLength": 200,
        "type": "string"
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "resolved": {
        "type": "boolean"
       }
      },
      "required": [
       "id",
       "resolved",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Only the id, resolved state and last edit time; null when not found. Customer identifiers, staff ids and organization ids are never returned."
   },
   "status": {
    "enum": [
     "updated",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "conversation"
  ],
  "type": "object"
 },
 "title": "Resolve or reopen a conversation"
}
