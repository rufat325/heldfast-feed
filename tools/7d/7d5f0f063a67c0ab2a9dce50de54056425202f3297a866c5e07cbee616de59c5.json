{
 "description": "WRITE: Update any mutable field on a campaign (name, status, daily_budget, lifetime_budget, bid_strategy). Pass only the fields you want to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bid_strategy": {
    "enum": [
     "LOWEST_COST_WITHOUT_CAP",
     "LOWEST_COST_WITH_BID_CAP",
     "COST_CAP",
     "LOWEST_COST_WITH_MIN_ROAS"
    ],
    "type": "string"
   },
   "campaign_id": {
    "type": "string"
   },
   "daily_budget": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "lifetime_budget": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "type": "string"
   },
   "special_ad_categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ACTIVE",
     "PAUSED",
     "DELETED",
     "ARCHIVED"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "update_campaign"
}
