{
 "description": "List motions in a workspace, filterable by status. Returns short ids so you can follow up with get_motion on a specific one. Default status is 'open'.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of motions per page (1-50). Default: 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (1-based). Default: 1.",
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status. Default: open.",
    "enum": [
     "draft",
     "open",
     "closed"
    ],
    "type": "string"
   },
   "workspace_slug": {
    "description": "The workspace slug (e.g. 'monnet-team-410b').",
    "type": "string"
   }
  },
  "required": [
   "workspace_slug"
  ],
  "type": "object"
 },
 "name": "list_motions"
}
