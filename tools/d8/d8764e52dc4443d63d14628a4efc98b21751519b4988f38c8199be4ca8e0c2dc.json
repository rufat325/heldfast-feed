 },
 "description": "Encode text to Base64 or decode Base64 back to text (UTF-8 safe). Supports URL-safe alphabet. Use whenever you need to encode/decode data URIs, tokens, or config values instead of guessing the bytes.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "Text to encode, or Base64 to decode.",
    "maxLength": 100000,
    "minLength": 1,
    "type": "string"
   },
   "mode": {
    "default": "encode",
    "description": "Direction.",
    "enum": [
     "encode",
     "decode"
    ],
    "type": "string"
   },
   "url_safe": {
    "default": false,
    "description": "Use URL-safe alphabet (-_ instead of +/, no padding).",
    "type": "boolean"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "base64",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mode": {
    "description": "encode or decode.",
    "type": "string"
   },
   "result": {
    "description": "The encoded or decoded text.",
    "type": "string"
   }
  },
  "required": [
   "mode",
   "result"
  ],
  "type": "object"
 },
 "title": "Base64 encode / decode"
}
