{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "plans:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update study plan tasks"
 },
 "description": "Marks specified owned plan tasks complete or incomplete at the student's request. This is self-reported planning, never a quiz score or practice submission. Supply the latest revision and a unique requestId; retry identical input safely.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "planId": {
    "pattern": "^[a-f0-9]{24}$",
    "type": "string"
   },
   "requestId": {
    "description": "Unique id for this intended action. Reuse it with identical input on retries.",
    "pattern": "^[\\w-]{8,128}$",
    "type": "string"
   },
   "tasks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "completed": {
       "type": "boolean"
      },
      "taskId": {
       "pattern": "^session-\\d+-task-\\d+$",
       "type": "string"
      }
     },
     "required": [
      "taskId",
      "completed"
     ],
     "type": "object"
    },
    "maxItems": 240,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "planId",
   "expectedRevision",
   "requestId",
   "tasks"
  ],
  "type": "object"
 },
 "name": "update_study_plan_tasks",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "plans:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update study plan tasks"
}
