{
 "description": "Select a reproducible sample from a population. Seeded (deterministic) for random/systematic/haphazard; targeted takes explicit references. Records the method, seed and references.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "controlId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "method": {
    "enum": [
     "random",
     "systematic",
     "targeted",
     "haphazard"
    ],
    "type": "string"
   },
   "populationId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "rationale": {
    "type": "string"
   },
   "sampleSize": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "seed": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "targetedReferences": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "engagementId",
   "populationId",
   "method"
  ],
  "type": "object"
 },
 "name": "select_sample",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "sample": {}
  },
  "required": [
   "sample"
  ],
  "type": "object"
 },
 "title": "Select a sample"
}
