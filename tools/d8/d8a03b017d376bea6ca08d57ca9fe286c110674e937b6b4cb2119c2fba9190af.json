{
 "description": "Generates a TypeScript SDK client from endpoint definitions. Produces typed interfaces for all request/response models, a client class with methods for each endpoint, error handling helpers (ApiError class with retry support), and authentication wrappers (Bearer, API Key, Basic).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base_url": {
    "description": "Base URL for API calls (default: https://api.example.com)",
    "type": "string"
   },
   "endpoints": {
    "description": "Array of endpoint definitions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "auth_type": {
       "description": "Authentication type",
       "enum": [
        "bearer",
        "api_key",
        "basic",
        "none"
       ],
       "type": "string"
      },
      "description": {
       "description": "Endpoint description",
       "type": "string"
      },
      "method": {
       "description": "HTTP method (GET, POST, PUT, PATCH, DELETE)",
       "type": "string"
      },
      "name": {
       "description": "Operation/function name",
       "type": "string"
      },
      "parameters": {
       "description": "Path, query, or header parameters",
       "items": {
        "additionalProperties": false,
        "properties": {
         "description": {
          "description": "Parameter description",
          "type": "string"
         },
         "in": {
          "description": "Parameter location",
          "enum": [
           "query",
           "path",
           "header",
           "cookie"
          ],
          "type": "string"
         },
         "name": {
          "description": "Parameter name",
          "type": "string"
         },
         "required": {
          "description": "Whether the parameter is required",
          "type": "boolean"
         },
         "type": {
          "description": "Data type",
          "type": "string"
         }
        },
        "required": [
         "name",
         "in",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "path": {
       "description": "URL path (e.g. /users/{id})",
       "type": "string"
      },
      "request_body": {
       "additionalProperties": false,
       "description": "Request body schema",
       "properties": {
        "properties": {
         "additionalProperties": {
          "additionalProperties": false,
          "properties": {
           "description": {
            "description": "Human-readable description of this property",
            "type": "string"
           },
           "enum": {
            "description": "Allowed values",
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "format": {
            "description": "Format hint (e.g. email, date-time, uuid)",
            "type": "string"
           },
           "type": {
            "description": "Data type (string, integer, number, boolean, array, object)",
            "type": "string"
           }
          },
          "required": [
           "type"
          ],
          "type": "object"
         },
         "description": "Properties of the request body",
         "type": "object"
        },
        "required": {
         "description": "List of required field names",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "type": {
         "description": "Body content type (typically 'object')",
         "type": "string"
        }
       },
       "required": [
        "type",
        "properties"
       ],
       "type": "object"
      },
      "response": {
       "additionalProperties": false,
       "description": "Success response schema",
       "properties": {
        "description": {
         "description": "Response description",
         "type": "string"
        },
        "properties": {
         "additionalProperties": {
          "$ref": "#/properties/endpoints/items/properties/request_body/properties/properties/additionalProperties"
         },
         "description": "Properties of the response",
         "type": "object"
        },
        "status": {
         "default": 200,
         "description": "HTTP status code (default: 200)",
         "type": "number"
        },
        "type": {
         "description": "Response content type (typically 'object')",
         "type": "string"
        }
       },
       "required": [
        "type",
        "properties"
       ],
       "type": "object"
      },
      "tags": {
       "description": "Tags for grouping",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "method",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "endpoints"
  ],
  "type": "object"
 },
 "name": "generate_sdk"
}
