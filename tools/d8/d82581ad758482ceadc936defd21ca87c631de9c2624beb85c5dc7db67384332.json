{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search City Experiences"
 },
 "description": "Find activities, tours, attractions, food experiences, and nightlife in a city (sourced from Hotelbeds). If no date range provided, defaults to next 7 days. Returns activity name, price, duration, image, and whether free cancellation is offered.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "tours",
     "attractions",
     "food",
     "sports",
     "transfers",
     "nightlife"
    ],
    "type": "string"
   },
   "city": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "country": {
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "currency": {
    "enum": [
     "AUD",
     "USD",
     "NZD",
     "GBP",
     "EUR",
     "SGD",
     "CAD",
     "MYR"
    ],
    "type": "string"
   },
   "date_from": {
    "format": "date",
    "type": "string"
   },
   "date_to": {
    "format": "date",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 15,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
 "name": "search_experiences"
}
