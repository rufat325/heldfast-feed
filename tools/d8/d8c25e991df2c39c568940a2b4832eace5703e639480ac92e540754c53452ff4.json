{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Check a car dealer's quote. Returns a grade from A to F, the flagged fees and add-ons, and lines to send the dealer. Pass paste (the quote text), or selling_price and msrp. 3 free checks per UTC month. Same as POST /api/quote-check.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"invoice":{"description":"Dealer invoice in dollars.","exclusiveMinimum":0,"maximum":10000000,"type":"number"},"lines":{"description":"Fees and add-ons in dollars. Set kind when known. Otherwise the label decides.","items":{"properties":{"amount":{"maximum":10000000,"minimum":0,"type":"number"},"kind":{"enum":["doc_fee","dealer_addon","gap","service_contract","market_adjustment"],"type":"string"},"label":{"maxLength":80,"minLength":1,"type":"string"}},"required":["label","amount"],"type":"object"},"maxItems":40,"type":"array"},"make":{"maxLength":60,"minLength":1,"type":"string"},"model":{"maxLength":60,"minLength":1,"type":"string"},"msrp":{"description":"MSRP in dollars.","exclusiveMinimum":0,"maximum":10000000,"type":"number"},"paste":{"description":"The dealer quote as text. Used for this check only and never stored.","maxLength":20000,"type":"string"},"selling_price":{"description":"Selling price in dollars.","exclusiveMinimum":0,"maximum":10000000,"type":"number"},"trim":{"maxLength":60,"minLength":1,"type":"string"},"vin":{"pattern":"^[A-HJ-NPR-Z0-9]{17}$","type":"string"},"year":{"maximum":2027,"minimum":1980,"type":"integer"}},"type":"object"},"name":"check_quote","title":"Check Quote"}
