{
 "description": "Upload an HTML+JSON report bundle to IPFS via Pinata. Returns { cid, uri } where uri = ipfs://{cid}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentDid": {
    "description": "Agent DID",
    "minLength": 1,
    "type": "string"
   },
   "agentTier": {
    "description": "Agent passport tier (bronze/silver/gold/platinum)",
    "type": "string"
   },
   "analysisType": {
    "description": "Analysis type",
    "type": "string"
   },
   "datasetUrn": {
    "description": "DataHub dataset URN",
    "type": "string"
   },
   "html": {
    "description": "HTML report content",
    "minLength": 1,
    "type": "string"
   },
   "ipfsApiKey": {
    "description": "Pinata API key (or use env IPFS_API_KEY)",
    "type": "string"
   },
   "ipfsApiSecret": {
    "description": "Pinata API secret (or use env IPFS_API_SECRET)",
    "type": "string"
   },
   "json": {
    "description": "JSON report content",
    "minLength": 1,
    "type": "string"
   },
   "taskId": {
    "description": "Task ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "html",
   "json",
   "taskId",
   "agentDid"
  ],
  "type": "object"
 },
 "name": "upload_result"
}
