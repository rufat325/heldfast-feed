{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get project details"
 },
 "description": "Use this when someone asks about one localization project, such as which languages it has or its default locale. Returns the project's id, name, default locale, configured locales and creation and edit times. Not for how complete its translations are.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projectIdOrName": {
    "description": "Project id or name",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "projectIdOrName"
  ],
  "type": "object"
 },
 "name": "get_project",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 35,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "$ref": "#/properties/project/anyOf/0/properties/creationTime"
       },
       "locales": {
        "items": {
         "$ref": "#/properties/project/anyOf/0/properties/defaultLocale/anyOf/0"
        },
        "maxItems": 200,
        "type": "array"
       },
       "name": {
        "maxLength": 128,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "defaultLocale",
       "locales",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "project"
  ],
  "type": "object"
 },
 "title": "Get project details"
}
