{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "llm",
 "description": "Plan token allocation across system prompt, user input, context/RAG chunks, and expected output. Warns if budget exceeds model context window. Supports 25+ models.",
 "inputSchema": {
  "properties": {
   "context": {
    "description": "Actual context text (will estimate tokens)",
    "type": "string"
   },
   "context_tokens": {
    "description": "Token count for RAG context / documents",
    "type": "number"
   },
   "expected_output_tokens": {
    "description": "Expected max output tokens",
    "type": "number"
   },
   "model": {
    "description": "Model name (e.g. gpt-4o, claude-3.5-sonnet, gemini-2.0-flash)",
    "type": "string"
   },
   "system_prompt": {
    "description": "Actual system prompt text (will estimate tokens)",
    "type": "string"
   },
   "system_prompt_tokens": {
    "description": "Token count for system prompt",
    "type": "number"
   },
   "user_input": {
    "description": "Actual user input text (will estimate tokens)",
    "type": "string"
   },
   "user_input_tokens": {
    "description": "Token count for user message",
    "type": "number"
   }
  },
  "required": [
   "model"
  ],
  "type": "object"
 },
 "name": "token_budget_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "breakdown": {
    "type": "object"
   },
   "context_window": {},
   "fits_in_window": {},
   "model": {},
   "remaining_tokens": {},
   "utilization_percent": {},
   "warnings": {}
  },
  "type": "object"
 }
}
