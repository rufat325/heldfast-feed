{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit an existing issue (PATCH): only provided fields are changed. For array fields you may pass \"add\"/\"remove\"/\"set\"/\"replace\" commands via extraFields, e.g. extraFields={\"tags\": {\"add\": [\"new-tag\"]}}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "affectedVersions": {
    "description": "Affected version names or ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "assignee": {
    "description": "Assignee login or user id",
    "type": "string"
   },
   "attachmentIds": {
    "description": "Temporary attachment ids to attach",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "author": {
    "description": "Author login or user id",
    "type": "string"
   },
   "components": {
    "description": "Queue component names or ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deadline": {
    "description": "Deadline date, format YYYY-MM-DD",
    "type": "string"
   },
   "description": {
    "description": "Issue description (YFM markup supported)",
    "type": "string"
   },
   "dueDate": {
    "description": "Due date, format YYYY-MM-DD",
    "type": "string"
   },
   "estimation": {
    "description": "Estimate in ISO 8601 duration format, e.g. \"P5DT1H\" or \"P2W\"",
    "type": "string"
   },
   "extraFields": {
    "additionalProperties": {},
    "description": "Arbitrary additional issue fields as a JSON object (global custom fields, queue local fields, or add/set/remove update commands like {\"tags\": {\"add\": [\"x\"]}}). Merged into the request body as-is.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "fixVersions": {
    "description": "Fix version names or ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "followers": {
    "description": "Followers: logins or user ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "issueId": {
    "description": "Issue key or id",
    "type": "string"
   },
   "parent": {
    "description": "Parent issue key or id",
    "type": "string"
   },
   "priority": {
    "description": "Priority key, id or name, e.g. \"blocker\", \"normal\"",
    "type": "string"
   },
   "project": {
    "description": "Primary project shortId",
    "type": "number"
   },
   "sprint": {
    "description": "Sprint ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "startDate": {
    "description": "Start date, format YYYY-MM-DD",
    "type": "string"
   },
   "summary": {
    "description": "Issue title/summary",
    "type": "string"
   },
   "tags": {
    "description": "Issue tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Issue type key, id or name, e.g. \"bug\", \"task\"",
    "type": "string"
   },
   "unique": {
    "description": "Value that must be unique across the organization (dedup guard)",
    "type": "string"
   }
  },
  "required": [
   "issueId"
  ],
  "type": "object"
 },
 "name": "edit_issue"
}
