{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Continue a chat with follow-up instructions or answers \u2014 the agent keeps its context. Resumes a run waiting in needs_input, or queues a new run when the last one finished. Returns run_busy while a run is still in progress. Optionally waits for the reply.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chat_id": {
    "description": "A chat id (aichat_...). A run id works too \u2014 it resolves to that run's chat.",
    "type": "string"
   },
   "message": {
    "description": "The follow-up to send into the conversation.",
    "maxLength": 10000,
    "type": "string"
   },
   "timeout_seconds": {
    "description": "Seconds to wait for the reply before returning (default 0: return the new run immediately). Capped like ask_crevio's wait.",
    "maximum": 300,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "chat_id",
   "message"
  ],
  "type": "object"
 },
 "name": "send_message",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A task run \u2014 one delegated job and what is known about its state.",
  "properties": {
   "chat_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "completed_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "created_at": {
    "format": "date-time",
    "type": "string"
   },
   "credits_consumed": {
    "type": "integer"
   },
   "error_message": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "object": {
    "const": "task_run",
    "type": "string"
   },
   "pending_approval_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {
    "type": [
     "string",
     "null"
    ]
   },
   "reused": {
    "type": "boolean"
   },
   "started_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "needs_input",
     "timed_out",
     "unknown",
     "skipped"
    ],
    "type": "string"
   },
   "summary": {
    "type": [
     "string",
     "null"
    ]
   },
   "task_id": {
    "type": "string"
   },
   "task_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "wait_timed_out": {
    "description": "The wait ended first. The work is still running: follow it with the tool next_step names.",
    "type": "boolean"
   }
  },
  "required": [
   "object",
   "id",
   "task_id",
   "status",
   "created_at"
  ],
  "type": "object"
 }
}
