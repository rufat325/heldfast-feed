{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one species: every common name, scientific name, habitats, country observation counts, the full photo credit and the Wikipedia summary.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Species slug from search_animals, for example `red-fox`.",
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Display language.",
    "enum": [
     "en",
     "de",
     "es",
     "fr",
     "it",
     "nl",
     "pt",
     "pl"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_animal",
 "outputSchema": {
  "description": "One animal taxon with every name, photo credit, summary and country counts.",
  "properties": {
   "categoryId": {
    "enum": [
     "mammals",
     "birds",
     "reptiles",
     "amphibians",
     "fish",
     "insects",
     "other"
    ],
    "type": "string"
   },
   "countries": {
    "description": "Up to twelve countries with the most observations.",
    "items": {
     "properties": {
      "code": {
       "description": "ISO 3166-1 alpha-2.",
       "pattern": "^[A-Z]{2}$",
       "type": "string"
      },
      "obs": {
       "type": "integer"
      }
     },
     "required": [
      "code",
      "obs"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "habitats": {
    "items": {
     "enum": [
      "forest",
      "grassland",
      "freshwater",
      "sea",
      "mountains",
      "urban",
      "farm",
      "zoo",
      "savanna",
      "jungle",
      "arctic",
      "desert"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Slug of the animal taxon, for example `red-fox`.",
    "examples": [
     "red-fox"
    ],
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   },
   "image": {
    "anyOf": [
     {
      "description": "Photo credit. Check the licence and source before reuse.",
      "properties": {
       "author": {
        "description": "Credited author. Empty when the source gives no name.",
        "type": "string"
       },
       "license": {
        "enum": [
         "CC0",
         "Public domain",
         "Pexels License",
         "Pixabay Content License"
        ],
        "type": "string"
       },
       "licenseUrl": {
        "description": "Licence terms or public-domain status guidance.",
        "format": "uri",
        "type": "string"
       },
       "source": {
        "description": "Photo source.",
        "enum": [
         "inaturalist",
         "commons",
         "gbif",
         "pexels",
         "pixabay"
        ],
        "examples": [
         "inaturalist"
        ],
        "type": "string"
       },
       "sourceUrl": {
        "description": "Page to link when you show it.",
        "format": "uri",
        "type": "string"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "url",
       "sourceUrl",
       "license",
       "author",
       "source"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "inatId": {
    "description": "iNaturalist taxon id.",
    "type": [
     "integer",
     "null"
    ]
   },
   "name": {
    "description": "Name in the requested language, English when none exists.",
    "type": "string"
   },
   "nameEn": {
    "description": "English common name.",
    "type": "string"
   },
   "nameSci": {
    "description": "Scientific name.",
    "examples": [
     "Vulpes vulpes"
    ],
    "type": "string"
   },
   "names": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Common name per language. A language is absent when no name is known.",
    "propertyNames": {
     "enum": [
      "en",
      "de",
      "es",
      "fr",
      "it",
      "nl",
      "pt",
      "pl"
     ]
    },
    "type": "object"
   },
   "obs": {
    "description": "iNaturalist observation count when available.",
    "type": [
     "integer",
     "null"
    ]
   },
   "parentNameSci": {
    "description": "Parent species scientific name for a subspecies. Null for species.",
    "type": [
     "string",
     "null"
    ]
   },
   "sourceUrl": {
    "format": "uri",
    "type": "string"
   },
   "taxonRank": {
    "default": "species",
    "description": "Taxonomic rank. Legacy records default to species.",
    "type": "string"
   },
   "text": {
    "description": "Wikipedia excerpt. Keep attribution, licence and source links, changes and supplied notices. Check source article exceptions.",
    "properties": {
     "attribution": {
      "type": "string"
     },
     "changes": {
      "type": "string"
     },
     "lang": {
      "enum": [
       "en",
       "de",
       "es",
       "fr",
       "it",
       "nl",
       "pt",
       "pl"
      ],
      "type": "string"
     },
     "license": {
      "type": "string"
     },
     "licenseUrl": {
      "format": "uri",
      "type": "string"
     },
     "notice": {
      "type": "string"
     },
     "sourceUrl": {
      "format": "uri",
      "type": "string"
     },
     "summary": {
      "type": "string"
     }
    },
    "required": [
     "lang",
     "summary",
     "sourceUrl"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "tickable": {
    "description": "Whether a new checklist sighting is allowed.",
    "type": "boolean"
   },
   "wikidataId": {
    "examples": [
     "Q8332"
    ],
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "name",
   "nameEn",
   "nameSci",
   "categoryId",
   "habitats",
   "image",
   "names",
   "wikidataId",
   "inatId",
   "obs",
   "text",
   "countries"
  ],
  "title": "Animal",
  "type": "object"
 },
 "title": "Get animal"
}
