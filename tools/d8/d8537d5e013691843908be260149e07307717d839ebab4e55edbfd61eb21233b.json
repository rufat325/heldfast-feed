{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get matches for a specific DEX order",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pagination cursor from previous response",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Number of results to return",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Number of results to skip",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "order_hash": {
    "description": "Order transaction hash",
    "type": "string"
   },
   "status": {
    "description": "Match status filter",
    "enum": [
     "pending",
     "completed",
     "expired"
    ],
    "type": "string"
   }
  },
  "required": [
   "order_hash"
  ],
  "type": "object"
 },
 "name": "get_order_matches"
}
