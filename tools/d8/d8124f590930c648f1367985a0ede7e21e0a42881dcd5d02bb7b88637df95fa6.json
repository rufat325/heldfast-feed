{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Export Resume PDF"
 },
 "description": "Export a resume as a downloadable PDF file with optional template and styling settings. Costs 1 API credit.",
 "inputSchema": {
  "properties": {
   "colorId": {
    "description": "Color scheme identifier",
    "type": "string"
   },
   "font": {
    "description": "Font family name",
    "type": "string"
   },
   "fontSize": {
    "description": "Base font size in points",
    "type": "number"
   },
   "locale": {
    "description": "Language/locale code (e.g. en, de, fr)",
    "type": "string"
   },
   "margin": {
    "description": "Page margin in millimeters",
    "type": "number"
   },
   "pageNumbering": {
    "description": "Page numbering style",
    "enum": [
     "none",
     "simple",
     "fraction",
     "page"
    ],
    "type": "string"
   },
   "resumeId": {
    "description": "Resume UUID to export",
    "type": "string"
   },
   "spacing": {
    "description": "Line spacing multiplier",
    "type": "number"
   },
   "templateId": {
    "description": "Template identifier (e.g. GRAPHITE)",
    "type": "string"
   }
  },
  "required": [
   "resumeId"
  ],
  "type": "object"
 },
 "name": "laddro.resumes.export",
 "outputSchema": {
  "properties": {
   "content": {
    "description": "Base64-encoded PDF data",
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
