{
 "annotations": {
  "destructiveHint": false
 },
 "description": "[Ncloud Storage] Start a multipart upload (POST /{key}?uploads) and get the uploadId used by ncloud_ncs_upload_part / upload_part_copy / complete_multipart_upload / abort_multipart_upload. Optional storage class, SSE and Object Lock headers apply to the final object.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Name of the Ncloud Storage bucket",
    "type": "string"
   },
   "contentType": {
    "description": "Content-Type of the final object",
    "type": "string"
   },
   "key": {
    "description": "Object key (path) the assembled object will have",
    "type": "string"
   },
   "objectLockLegalHold": {
    "description": "x-amz-object-lock-legal-hold \u2014 ON | OFF",
    "enum": [
     "ON",
     "OFF"
    ],
    "type": "string"
   },
   "objectLockMode": {
    "description": "x-amz-object-lock-mode (bucket must have Object Lock enabled)",
    "enum": [
     "GOVERNANCE",
     "COMPLIANCE"
    ],
    "type": "string"
   },
   "objectLockRetainUntilDate": {
    "description": "x-amz-object-lock-retain-until-date, ISO 8601 (e.g. 2027-01-01T00:00:00Z)",
    "type": "string"
   },
   "serverSideEncryption": {
    "description": "x-amz-server-side-encryption \u2014 AES256 (SSE-S3) | aws:kms (Ncloud-managed KMS key)",
    "enum": [
     "AES256",
     "aws:kms"
    ],
    "type": "string"
   },
   "storageClass": {
    "description": "x-amz-storage-class \u2014 STANDARD (default) | ONEZONE_IA | DEEP_ARCHIVE",
    "enum": [
     "STANDARD",
     "ONEZONE_IA",
     "DEEP_ARCHIVE"
    ],
    "type": "string"
   }
  },
  "required": [
   "bucketName",
   "key"
  ],
  "type": "object"
 },
 "name": "ncloud_ncs_create_multipart_upload"
}
