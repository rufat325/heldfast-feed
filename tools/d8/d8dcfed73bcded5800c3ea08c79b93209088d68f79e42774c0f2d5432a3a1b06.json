{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compile reviewed taxpayer inputs and a deterministic TaxBrain relief evaluation into source-linked Form BE fields. This tool never stores data or submits to MyTax, and output remains review-gated.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assessmentIssuedInTaxpayerName": {
    "description": "Required for A6 code 1 or 2; true only when the joint assessment is issued in this taxpayer\u2019s name",
    "type": "boolean"
   },
   "assessmentType": {
    "anyOf": [
     {
      "const": 1,
      "type": "number"
     },
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 3,
      "type": "number"
     },
     {
      "const": 4,
      "type": "number"
     },
     {
      "const": 5,
      "type": "number"
     }
    ],
    "description": "Form BE A6 assessment-type code selected by the taxpayer"
   },
   "audit": {
    "properties": {
     "previousEventId": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
     },
     "runId": {
      "maxLength": 128,
      "minLength": 8,
      "type": "string"
     },
     "sequence": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "runId",
     "sequence"
    ],
    "type": "object"
   },
   "credits": {
    "properties": {
     "section110Other": {
      "minimum": 0,
      "type": "number"
     },
     "section132ForeignTaxRelief": {
      "minimum": 0,
      "type": "number"
     },
     "section133ForeignTaxRelief": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "donations": {
    "properties": {
     "approvedInstitution": {
      "minimum": 0,
      "type": "number"
     },
     "approvedMedicalEquipment": {
      "minimum": 0,
      "type": "number"
     },
     "approvedSportsActivity": {
      "minimum": 0,
      "type": "number"
     },
     "artifactsOrManuscripts": {
      "minimum": 0,
      "type": "number"
     },
     "government": {
      "minimum": 0,
      "type": "number"
     },
     "libraryFacilities": {
      "minimum": 0,
      "type": "number"
     },
     "nationalOrStateGalleryPaintings": {
      "minimum": 0,
      "type": "number"
     },
     "projectOfNationalInterest": {
      "minimum": 0,
      "type": "number"
     },
     "publicAccessibilityFacilities": {
      "minimum": 0,
      "type": "number"
     },
     "wakafOrEndowment": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "income": {
    "properties": {
     "catalystInvestmentDeduction": {
      "minimum": 0,
      "type": "number"
     },
     "employmentCount": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "employmentIncome": {
      "minimum": 0,
      "type": "number"
     },
     "foreignIncomeReceivedInMalaysia": {
      "minimum": 0,
      "type": "number"
     },
     "malaysiaDividendStatutoryIncome": {
      "minimum": 0,
      "type": "number"
     },
     "otherMalaysiaIncome": {
      "minimum": 0,
      "type": "number"
     },
     "rentalIncome": {
      "minimum": 0,
      "type": "number"
     },
     "spouseAggregateIncome": {
      "minimum": 0,
      "type": "number"
     },
     "spouseDividendStatutoryIncome": {
      "minimum": 0,
      "type": "number"
     },
     "spouseTransferredIncome": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "employmentIncome"
    ],
    "type": "object"
   },
   "inputBlockers": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "payments": {
    "properties": {
     "cp500": {
      "minimum": 0,
      "type": "number"
     },
     "mtdPcb": {
      "minimum": 0,
      "type": "number"
     },
     "section107d": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "rebates": {
    "properties": {
     "qualifyingDepartureLevy": {
      "minimum": 0,
      "type": "number"
     },
     "spouseRebateEligible": {
      "type": "boolean"
     },
     "zakatAndFitrah": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "reliefEvaluation": {
    "properties": {
     "reliefResults": {
      "items": {
       "properties": {
        "categoryId": {
         "minLength": 1,
         "type": "string"
        },
        "claimableAmount": {
         "minimum": 0,
         "type": "number"
        },
        "eligibilityStatus": {
         "enum": [
          "eligible",
          "not_eligible",
          "needs_info"
         ],
         "type": "string"
        },
        "lhdnCode": {
         "minLength": 1,
         "type": "string"
        },
        "rawSpend": {
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "categoryId",
        "lhdnCode",
        "claimableAmount"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "taxYear": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "totalClaimableRelief": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "taxYear",
     "totalClaimableRelief",
     "reliefResults"
    ],
    "type": "object"
   },
   "taxYear": {
    "default": 2025,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "assessmentType",
   "income",
   "reliefEvaluation"
  ],
  "type": "object"
 },
 "name": "prepare_be_2025_draft",
 "title": "Prepare Form BE 2025 draft"
}
