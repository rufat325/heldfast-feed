{
 "description": "Paid Arbitrage Intelligence ($0.03 USDC). Compares Binance and Coinbase public spot order books at a requested trade size and applies caller- or server-configured taker fee assumptions. Rejects stale books. Excludes transfers, inventory rebalancing, and guaranteed execution; does not place orders.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "pattern": "^[A-Z0-9]{2,15}$",
    "type": "string"
   },
   "fee_bps_by_venue": {
    "additionalProperties": {
     "maximum": 1000,
     "minimum": 0,
     "type": "number"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "min_net_spread_bps": {
    "default": 0,
    "maximum": 5000,
    "minimum": 0,
    "type": "number"
   },
   "quote_asset": {
    "default": "USDT",
    "enum": [
     "USDT",
     "USDC",
     "USD"
    ],
    "type": "string"
   },
   "trade_size_usd": {
    "maximum": 10000000,
    "minimum": 10,
    "type": "number"
   },
   "venues": {
    "default": [
     "binance",
     "coinbase"
    ],
    "items": {
     "enum": [
      "binance",
      "coinbase"
     ],
     "type": "string"
    },
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "asset",
   "trade_size_usd"
  ],
  "type": "object"
 },
 "name": "scan_arbitrage",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "cache": {
      "additionalProperties": false,
      "properties": {
       "age_ms": {
        "minimum": 0,
        "type": "number"
       },
       "hit": {
        "type": "boolean"
       }
      },
      "required": [
       "hit",
       "age_ms"
      ],
      "type": "object"
     },
     "failed_sources": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "reason": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "latency_ms": {
      "minimum": 0,
      "type": "number"
     },
     "partial": {
      "type": "boolean"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "latency_ms",
     "partial",
     "failed_sources",
     "cache"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "timestamp": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "tool",
   "timestamp",
   "data",
   "meta"
  ],
  "type": "object"
 }
}
