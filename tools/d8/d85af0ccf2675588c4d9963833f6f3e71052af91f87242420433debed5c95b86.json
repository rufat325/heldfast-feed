{
 "_meta": {
  "com.oxinsider/docs-group": "webhooks",
  "securitySchemes": [
   {
    "scopes": [
     "read",
     "webhooks"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Webhook Endpoints"
 },
 "description": "Read-only list of webhook endpoints owned by the authenticated API key user. This does not create, update, verify, rotate, or delete webhook endpoints.\n\nArgs: none\n\nReturns: List of webhook endpoint configuration records.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "list_webhooks",
 "outputSchema": {
  "$defs": {
   "LargeTradeSubscriptionFilters": {
    "additionalProperties": false,
    "properties": {
     "condition_id": {
      "type": "string"
     },
     "min_grade": {
      "enum": [
       "S",
       "A",
       "B",
       "C",
       "D",
       "F"
      ],
      "type": "string"
     },
     "min_size_usd": {
      "pattern": "^[0-9]+(\\.[0-9]{1,6})?$",
      "type": "string"
     },
     "wallet": {
      "pattern": "^0x[a-fA-F0-9]{40}$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "ResponseMeta": {
    "properties": {
     "cache_age_s": {
      "type": "integer"
     },
     "cached": {
      "type": "boolean"
     },
     "category_skill_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_enriched_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_model_operationally_degraded": {
      "type": "boolean"
     },
     "category_skill_model_version": {
      "type": "string"
     },
     "category_skill_observation_started_at": {
      "format": "date-time",
      "type": "string"
     },
     "category_skill_platform": {
      "const": "polymarket",
      "type": "string"
     },
     "category_skill_scope": {
      "const": "observed_goldsky_primary_taker_fill",
      "type": "string"
     },
     "category_skill_source": {
      "enum": [
       "live",
       "partial",
       "degraded",
       "unavailable"
      ],
      "type": "string"
     },
     "category_skill_source_coverage": {
      "enum": [
       "partial_whale_threshold_fills",
       "graded_wallet_fills"
      ],
      "type": "string"
     },
     "category_skill_status_counts": {
      "properties": {
       "degraded": {
        "minimum": 0,
        "type": "integer"
       },
       "insufficient": {
        "minimum": 0,
        "type": "integer"
       },
       "live": {
        "minimum": 0,
        "type": "integer"
       },
       "stale": {
        "minimum": 0,
        "type": "integer"
       },
       "unknown": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "live",
       "insufficient",
       "stale",
       "unknown",
       "degraded"
      ],
      "type": "object"
     },
     "category_skill_taxonomy_version": {
      "type": "string"
     },
     "cost": {
      "type": "integer"
     },
     "directional_source": {
      "enum": [
       "live",
       "degraded"
      ],
      "type": "string"
     },
     "ranking_as_of": {
      "format": "date-time",
      "type": "string"
     },
     "ranking_generation": {
      "type": "integer"
     },
     "ranking_source": {
      "enum": [
       "live",
       "db_only"
      ],
      "type": "string"
     },
     "request_id": {
      "type": "string"
     }
    },
    "required": [
     "request_id",
     "cached",
     "cost"
    ],
    "type": "object"
   },
   "WebhookEndpoint": {
    "properties": {
     "created_at": {
      "format": "date-time",
      "type": "string"
     },
     "event_types": {
      "items": {
       "$ref": "#/$defs/WebhookEventType"
      },
      "type": "array"
     },
     "failure_count": {
      "type": "integer"
     },
     "id": {
      "format": "int64",
      "type": "integer"
     },
     "name": {
      "type": "string"
     },
     "object": {
      "const": "webhook",
      "type": "string"
     },
     "retry_policy": {
      "$ref": "#/$defs/WebhookRetryPolicy"
     },
     "secret_rotation": {
      "$ref": "#/$defs/WebhookSecretRotation"
     },
     "signing_secret": {
      "type": "string"
     },
     "status": {
      "$ref": "#/$defs/WebhookStatus"
     },
     "trade_filters": {
      "$ref": "#/$defs/LargeTradeSubscriptionFilters"
     },
     "updated_at": {
      "format": "date-time",
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     },
     "verification": {
      "$ref": "#/$defs/WebhookVerification"
     },
     "verification_token_expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "verified_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "object",
     "name",
     "url",
     "event_types",
     "trade_filters",
     "status",
     "verified_at",
     "verification_token_expires_at",
     "failure_count",
     "created_at",
     "updated_at",
     "retry_policy",
     "secret_rotation"
    ],
    "type": "object"
   },
   "WebhookEventType": {
    "enum": [
     "large_trade_inserted_v2",
     "large_trades_inserted",
     "whale_trades_inserted",
     "live_sports_updated",
     "trader_synced",
     "whale_trader_synced",
     "large_positions_updated",
     "wallet_grade_changed",
     "suspicious_trade_flagged",
     "insider_radar_flag_raised",
     "sharp_money_flow_detected",
     "smart_money_flow_detected",
     "export_job_ready",
     "export_job_failed",
     "export_job_expired",
     "export_job_cancelled"
    ],
    "type": "string"
   },
   "WebhookRetryPolicy": {
    "properties": {
     "disable_after_consecutive_failures": {
      "const": 8,
      "type": "integer"
     },
     "max_attempts": {
      "const": 8,
      "type": "integer"
     },
     "retry_horizon_seconds": {
      "const": 7380,
      "type": "integer"
     },
     "terminal_status": {
      "const": "dead_letter",
      "type": "string"
     }
    },
    "required": [
     "max_attempts",
     "terminal_status",
     "retry_horizon_seconds",
     "disable_after_consecutive_failures"
    ],
    "type": "object"
   },
   "WebhookSecretRotation": {
    "properties": {
     "overlap_expires_at": {
      "anyOf": [
       {
        "format": "date-time",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "status": {
      "enum": [
       "idle",
       "pending",
       "overlap"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "overlap_expires_at"
    ],
    "type": "object"
   },
   "WebhookStatus": {
    "enum": [
     "pending_verification",
     "active",
     "disabled"
    ],
    "type": "string"
   },
   "WebhookVerification": {
    "properties": {
     "expires_at": {
      "format": "date-time",
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "token",
     "expires_at"
    ],
    "type": "object"
   }
  },
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/WebhookEndpoint"
      },
      "type": "array"
     },
     "has_more": {
      "type": "boolean"
     },
     "meta": {
      "$ref": "#/$defs/ResponseMeta"
     },
     "next_cursor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "data",
     "has_more",
     "next_cursor",
     "meta"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "doc_url": {
        "type": "string"
       },
       "param": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "request_id": {
        "type": "string"
       },
       "retry_after_seconds": {
        "minimum": 0,
        "type": "integer"
       },
       "retry_at": {
        "type": "string"
       },
       "status": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "code"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "read",
    "webhooks"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List Webhook Endpoints"
}
