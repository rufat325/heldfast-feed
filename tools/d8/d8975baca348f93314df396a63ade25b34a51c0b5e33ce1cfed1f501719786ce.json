{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check missing languages and devices"
 },
 "description": "Use this when someone asks which languages or devices a project still lacks tutorial videos or voiceovers for, or how complete its translations are. Returns video and voiceover counts per language and video counts per device, plus the missing ones, from the latest 100 of each. Not for one tutorial's videos.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expectedDevices": {
    "description": "Devices each language should have videos for, 1 to 10 names such as computer, tablet or smartphone; defaults to those three",
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "projectId": {
    "description": "Project id or its stable public vanity id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "get_project_localization_summary",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   },
   "summary": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "coverageDerivedFromTruncatedData": {
        "type": "boolean"
       },
       "deviceCoverage": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "device": {
           "maxLength": 40,
           "minLength": 1,
           "type": "string"
          },
          "videos": {
           "maximum": 100,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "device",
          "videos"
         ],
         "type": "object"
        },
        "maxItems": 10,
        "type": "array"
       },
       "localeCoverage": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "configured": {
           "type": "boolean"
          },
          "locale": {
           "maxLength": 32,
           "minLength": 1,
           "type": "string"
          },
          "speeches": {
           "maximum": 100,
           "minimum": 0,
           "type": "integer"
          },
          "videos": {
           "maximum": 100,
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "locale",
          "configured",
          "videos",
          "speeches"
         ],
         "type": "object"
        },
        "maxItems": 50,
        "type": "array"
       },
       "localeCoverageTotal": {
        "maximum": 300,
        "minimum": 0,
        "type": "integer"
       },
       "localeCoverageTruncated": {
        "type": "boolean"
       },
       "missingDevices": {
        "items": {
         "maxLength": 40,
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       },
       "missingSpeechLocales": {
        "items": {
         "maxLength": 32,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "missingVideoLocales": {
        "items": {
         "maxLength": 32,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "project": {
        "additionalProperties": false,
        "properties": {
         "configuredLocales": {
          "items": {
           "maxLength": 32,
           "type": "string"
          },
          "maxItems": 100,
          "type": "array"
         },
         "configuredLocalesTruncated": {
          "type": "boolean"
         },
         "defaultLocale": {
          "anyOf": [
           {
            "maxLength": 32,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "id": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         },
         "name": {
          "anyOf": [
           {
            "maxLength": 200,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "id",
         "name",
         "defaultLocale",
         "configuredLocales",
         "configuredLocalesTruncated"
        ],
        "type": "object"
       },
       "totals": {
        "additionalProperties": false,
        "properties": {
         "speeches": {
          "$ref": "#/properties/summary/anyOf/0/properties/totals/properties/tutorials"
         },
         "tutorials": {
          "additionalProperties": false,
          "properties": {
           "count": {
            "maximum": 100,
            "minimum": 0,
            "type": "integer"
           },
           "isLowerBound": {
            "type": "boolean"
           }
          },
          "required": [
           "count",
           "isLowerBound"
          ],
          "type": "object"
         },
         "videos": {
          "$ref": "#/properties/summary/anyOf/0/properties/totals/properties/tutorials"
         }
        },
        "required": [
         "tutorials",
         "videos",
         "speeches"
        ],
        "type": "object"
       }
      },
      "required": [
       "project",
       "totals",
       "localeCoverage",
       "localeCoverageTotal",
       "localeCoverageTruncated",
       "deviceCoverage",
       "missingVideoLocales",
       "missingSpeechLocales",
       "missingDevices",
       "coverageDerivedFromTruncatedData"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Coverage from at most the 100 most recently edited tutorials, videos and voiceover lines; coverageDerivedFromTruncatedData is true when more exist. Null when the project is not found."
   }
  },
  "required": [
   "status",
   "summary"
  ],
  "type": "object"
 },
 "title": "Check missing languages and devices"
}
