{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Grade your exam answers. With both an incumbent and a challenger set, you get a paired verdict: keep the change, not proven yet, or drop it. The outcomes are revealed afterwards, worst misses first.",
 "inputSchema": {
  "properties": {
   "api_key": {
    "description": "Your alk_ key. Only needed if your client can't send it as an Authorization: Bearer header.",
    "type": "string"
   },
   "challenger": {
    "description": "Optional. Answers from the rule change you're testing.",
    "items": {
     "properties": {
      "id": {
       "description": "Exam item id, like q1",
       "type": "string"
      },
      "p": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id",
      "p"
     ],
     "type": "object"
    },
    "maxItems": 60,
    "type": "array"
   },
   "exam_id": {
    "type": "string"
   },
   "incumbent": {
    "description": "Answers from your current rules.",
    "items": {
     "properties": {
      "id": {
       "description": "Exam item id, like q1",
       "type": "string"
      },
      "p": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id",
      "p"
     ],
     "type": "object"
    },
    "maxItems": 60,
    "type": "array"
   }
  },
  "required": [
   "exam_id",
   "incumbent"
  ],
  "type": "object"
 },
 "name": "submit_exam",
 "title": "Submit a blind exam"
}
