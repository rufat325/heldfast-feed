{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use first when you know a model name or provider but need exact pricing-offer IDs for pricing or calculations. Search recorded labels and API IDs; case, spacing and punctuation variants are accepted. Multiple tariffs are returned as separate choices. Defaults to current reviewed offers; check costing_supported before calculating. This discovers pricing offers, not model capability recommendations.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque next_cursor returned by list_models. Omit on the first page; on later pages repeat the original filters and limit unchanged. Restart without a cursor if it expires or the dataset changes.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum offers per page to return: 1\u201350; default 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "pricing_tier": {
    "description": "Optional exact tariff name from offer identity, such as standard or peak. Use to restrict results to a tariff; omit to include all tariffs.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "provider_id": {
    "description": "Optional exact provider_id returned by list_providers or offer identity. Use to restrict results to one provider; omit for all providers.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Optional model name, recorded label or API ID to search. Use when the exact offer ID is unknown; omit to browse. Matching tolerates case, spacing and punctuation differences.",
    "maxLength": 100,
    "type": "string"
   },
   "status": {
    "default": "current",
    "description": "Use current (default) for reviewed offers. Choose expired, unreviewed or all only to inspect catalogue records; those records may not support calculations.",
    "enum": [
     "current",
     "expired",
     "unreviewed",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_models",
 "outputSchema": {
  "$defs": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "MODEL_NOT_FOUND",
       "PRICE_UNREVIEWED",
       "PRICE_EXPIRED",
       "SCOPE_REQUIRED",
       "SCOPE_EXCEEDED",
       "UNSUPPORTED_TARIFF",
       "UNSUPPORTED_CACHE",
       "CATALOGUE_INCONSISTENT",
       "INVALID_CURSOR",
       "CURSOR_EXPIRED",
       "DATASET_CHANGED",
       "NO_COMPARABLE_MODELS",
       "DATASET_UNAVAILABLE",
       "INTERNAL_ERROR"
      ],
      "type": "string"
     },
     "field": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "message": {
      "type": "string"
     },
     "model_id": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resolution": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "field",
     "model_id",
     "resolution"
    ],
    "type": "object"
   },
   "identity": {
    "additionalProperties": false,
    "properties": {
     "api_model_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "billing_channel": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "label": {
      "type": "string"
     },
     "model_id": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "pricing_tier": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "provider_id": {
      "type": "string"
     },
     "provider_label": {
      "type": "string"
     }
    },
    "required": [
     "model_id",
     "label",
     "api_model_id",
     "provider_id",
     "provider_label",
     "billing_channel",
     "pricing_tier"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "contract_version": {
      "const": "1.0"
     },
     "dataset_revision": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "dataset_updated_at": {
      "type": "string"
     },
     "evaluated_at": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "contract_version",
     "dataset_revision",
     "dataset_updated_at",
     "evaluated_at"
    ],
    "type": "object"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "costing_supported": {
      "type": "boolean"
     },
     "identity": {
      "$ref": "#/$defs/identity"
     },
     "max_input_tokens_per_request": {
      "anyOf": [
       {
        "maximum": 1000000000000,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "price_status": {
      "enum": [
       "current",
       "expired",
       "unreviewed"
      ],
      "type": "string"
     },
     "unsupported_reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "identity",
     "price_status",
     "costing_supported",
     "unsupported_reason",
     "max_input_tokens_per_request"
    ],
    "type": "object"
   },
   "warning": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   }
  },
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "additionalProperties": false,
      "properties": {
       "models": {
        "items": {
         "$ref": "#/$defs/summary"
        },
        "maxItems": 50,
        "type": "array"
       },
       "next_cursor": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "warnings": {
        "items": {
         "$ref": "#/$defs/warning"
        },
        "type": "array"
       }
      },
      "required": [
       "models",
       "next_cursor",
       "warnings"
      ],
      "type": "object"
     },
     "meta": {
      "$ref": "#/$defs/meta"
     },
     "ok": {
      "const": true
     }
    },
    "required": [
     "ok",
     "meta",
     "data"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "$ref": "#/$defs/error"
     },
     "errors": {
      "items": {
       "$ref": "#/$defs/error"
      },
      "maxItems": 20,
      "type": "array"
     },
     "meta": {
      "anyOf": [
       {
        "$ref": "#/$defs/meta"
       },
       {
        "type": "null"
       }
      ]
     },
     "ok": {
      "const": false
     }
    },
    "required": [
     "ok",
     "meta",
     "error",
     "errors"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
