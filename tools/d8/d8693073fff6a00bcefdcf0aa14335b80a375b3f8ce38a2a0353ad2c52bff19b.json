{"description":"Connect nodes by key with arrows or lines, in a single step. Connectors follow the nodes when they move. Example: edges=[{from:\"api\",to:\"db\",label:\"SQL\"}].","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"edges":{"description":"Connections to add","items":{"properties":{"arrow":{"description":"Which ends get a head (default end)","enum":["none","start","end","both"],"type":"string"},"color":{"description":"Color name","enum":["default","blue","green","red","purple","yellow","gray"],"type":"string"},"dashed":{"description":"Dashed line","type":"boolean"},"endHead":{"description":"triangle/diamond for UML (inheritance, aggregation)","enum":["open","triangle","triangleFilled","diamond","diamondFilled","circle"],"type":"string"},"fontSize":{"description":"Label text size in px (default 12)","maximum":400,"minimum":6,"type":"number"},"from":{"description":"Key of the start node","type":"string"},"label":{"description":"Text on the connection","maxLength":200,"type":"string"},"routing":{"description":"elbow = orthogonal route (good for flowcharts)","enum":["straight","elbow"],"type":"string"},"startHead":{"description":"Head style at the start","enum":["open","triangle","triangleFilled","diamond","diamondFilled","circle"],"type":"string"},"to":{"description":"Key of the end node","type":"string"}},"required":["from","to"],"type":"object"},"maxItems":200,"minItems":1,"type":"array"}},"required":["edges"],"type":"object"},"name":"diagram_connect","title":"Connect nodes"}
