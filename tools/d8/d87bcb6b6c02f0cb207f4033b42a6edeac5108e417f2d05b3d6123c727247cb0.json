{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the books in the ShelfClub catalog whose mood, vibe, pace and genre tags overlap most with those of a given book. The tags are machine-generated, or voted for by at least three readers of the book, and a book that has none has no similar books. Returns up to 10 books, each with its ShelfClub id, authors, description, reader rating, series, tags and shelfclub.app link.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "The ShelfClub id of the book, as the other tools return it.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "How many books to return.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_similar_books",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "books": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "averageRating": {
       "description": "Reader rating out of 5.",
       "type": [
        "number",
        "null"
       ]
      },
      "description": {
       "description": "From the catalog, cut to 600 characters.",
       "type": [
        "string",
        "null"
       ]
      },
      "genres": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "The ShelfClub id of the book.",
       "type": "string"
      },
      "moods": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pace": {
       "type": [
        "string",
        "null"
       ]
      },
      "series": {
       "type": [
        "string",
        "null"
       ]
      },
      "seriesPosition": {
       "type": [
        "number",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "The book's page on shelfclub.app.",
       "type": "string"
      },
      "vibes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "title",
      "authors",
      "url",
      "description",
      "averageRating",
      "moods",
      "vibes",
      "pace",
      "genres",
      "series",
      "seriesPosition"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "retryAfterSeconds": {
    "description": "With \"try_again_later\", when known: how long to wait.",
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "\"try_again_later\": the service was busy and looked nothing up, so the other fields are absent.",
    "enum": [
     "ok",
     "try_again_later"
    ],
    "type": "string"
   },
   "tagProvenance": {
    "description": "Where the moods, vibes, pace and genres come from.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Get similar books"
}
