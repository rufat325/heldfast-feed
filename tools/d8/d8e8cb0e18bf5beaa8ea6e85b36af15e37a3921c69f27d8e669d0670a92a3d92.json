{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add databases to a Cloud DB for PostgreSQL instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudPostgresqlDatabaseList": {
    "description": "List of databases to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Database name to add",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "cloudPostgresqlInstanceNo": {
    "description": "Cloud PostgreSQL instance number",
    "type": "string"
   }
  },
  "required": [
   "cloudPostgresqlInstanceNo",
   "cloudPostgresqlDatabaseList"
  ],
  "type": "object"
 },
 "name": "ncloud_add_postgresql_databases"
}
