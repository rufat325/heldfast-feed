{
 "description": "Low-level diagnostic \u2014 prefer percher_doctor unless recovery explicitly points here. Returns a finite snapshot of recent application logs (default 200 lines); use percher_deploys_inspect for a deploy's build log. Use when recovery points at logs or the user asks to see them. MCP cannot stream: follow:true is rejected; use the CLI to follow logs continuously.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "app": {
    "type": "string"
   },
   "deployId": {
    "type": "string"
   },
   "follow": {
    "const": false,
    "description": "MCP returns a snapshot; only false is supported.",
    "type": "boolean"
   },
   "level": {
    "enum": [
     "debug",
     "info",
     "warn",
     "error",
     "fatal"
    ],
    "type": "string"
   },
   "search": {
    "maxLength": 256,
    "type": "string"
   },
   "since": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "source": {
    "enum": [
     "build",
     "runtime",
     "crash",
     "system"
    ],
    "type": "string"
   },
   "tail": {
    "exclusiveMinimum": 0,
    "maximum": 10000,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "percher_logs"
}
