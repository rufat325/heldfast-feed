{
 "description": "Update an existing project on AiList. You must own the project (submitted with the same API key). Use this to keep listings current when new features ship or versions change. Requires AILIST_API_KEY env var.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "built_with": {
    "description": "Updated technologies used",
    "maxLength": 500,
    "type": "string"
   },
   "category": {
    "description": "Updated category",
    "enum": [
     "mcp-server",
     "cli-tool",
     "library",
     "web-app",
     "api",
     "plugin",
     "model",
     "dataset",
     "agent",
     "other"
    ],
    "type": "string"
   },
   "description": {
    "description": "Updated description (supports markdown)",
    "maxLength": 5000,
    "type": "string"
   },
   "github_url": {
    "description": "Updated GitHub repository URL",
    "format": "uri",
    "type": "string"
   },
   "npm_package": {
    "description": "Updated npm package name",
    "maxLength": 200,
    "type": "string"
   },
   "pypi_package": {
    "description": "Updated PyPI package name",
    "maxLength": 200,
    "type": "string"
   },
   "slug": {
    "description": "Project slug to update (e.g. \"cogmemai\")",
    "minLength": 1,
    "type": "string"
   },
   "tagline": {
    "description": "Updated tagline",
    "maxLength": 300,
    "type": "string"
   },
   "tags": {
    "description": "Updated comma-separated tags",
    "maxLength": 500,
    "type": "string"
   },
   "url": {
    "description": "Updated homepage URL",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_project"
}
