{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Coluna Sapiens/Repert\u00f3rio"
 },
 "description": "Publica curado da Coluna Sapiens (publish_quote), Coluna Repert\u00f3rio (publish_pop) ou Educativo (publish_educativo) via session token. publish_quote: cria entry com column='sapiens', exige objeto quote completo (text/author/sourceWork/license/referenceImage/flowImage). publish_pop: cria entry com column='repertorio' format='pop-article', exige popReference{featuredItemId,relatedItemIds?,lensTheme?}. publish_educativo: cria artigo derivado de aula (Trilhas \u2192 Blog), exige educativeReference{sourceLessonId,angle?,partNumber?,totalParts?}. Default status='draft' (admin revisa em /dashboard/admin/...); publishNow=true publica direto.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "publish_quote",
     "publish_pop",
     "publish_educativo"
    ],
    "type": "string"
   },
   "category": {
    "description": "Default 'filosofia-tech' pra quote, 'repertorio' pra pop",
    "type": "string"
   },
   "connectedSlugs": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "content": {
    "description": "Markdown completo do artigo/coment\u00e1rio.",
    "type": "string"
   },
   "educativeReference": {
    "additionalProperties": false,
    "description": "Obrigat\u00f3rio pra publish_educativo. sourceLessonId vem da query lms:listLessonsForBlogPicker.",
    "properties": {
     "angle": {
      "description": "fundamento, case, objecao, exemplo\u2026",
      "type": "string"
     },
     "partNumber": {
      "type": "number"
     },
     "sourceCourseSlug": {
      "type": "string"
     },
     "sourceLessonId": {
      "description": "lessons:_id da aula fonte",
      "type": "string"
     },
     "sourceModuleId": {
      "type": "string"
     },
     "totalParts": {
      "type": "number"
     }
    },
    "required": [
     "sourceLessonId"
    ],
    "type": "object"
   },
   "excerpt": {
    "type": "string"
   },
   "format": {
    "description": "Pra publish_quote: 'short' (200-600 palavras) ou 'essay' (>600). Default 'short'.",
    "type": "string"
   },
   "generatedBy": {
    "description": "Marker do gerador (ex: 'claude-opus-4.7-max:sapiens-quote-skill'). Default gen\u00e9rico se omitido.",
    "type": "string"
   },
   "overwrite": {
    "description": "Pra publish_quote: se draft com mesmo slug existe (status='draft', column='sapiens'), apaga e recria. N\u00e3o sobrescreve published.",
    "type": "boolean"
   },
   "popReference": {
    "additionalProperties": false,
    "description": "Obrigat\u00f3rio pra publish_pop. featuredItemId vem de sapiens_repertorio.",
    "properties": {
     "featuredItemId": {
      "type": "string"
     },
     "lensTheme": {
      "type": "string"
     },
     "relatedItemIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "featuredItemId"
    ],
    "type": "object"
   },
   "publishNow": {
    "description": "Default false (cria como draft). True publica direto sem passar por curation.",
    "type": "boolean"
   },
   "quote": {
    "additionalProperties": false,
    "description": "Obrigat\u00f3rio pra publish_quote.",
    "properties": {
     "author": {
      "type": "string"
     },
     "authorWikidataId": {
      "type": "string"
     },
     "flowImage": {
      "additionalProperties": false,
      "properties": {
       "alt": {
        "type": "string"
       },
       "caption": {
        "type": "string"
       },
       "model": {
        "type": "string"
       },
       "prompt": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "url",
       "alt"
      ],
      "type": "object"
     },
     "license": {
      "type": "string"
     },
     "originalLang": {
      "type": "string"
     },
     "page": {
      "type": "string"
     },
     "referenceImage": {
      "additionalProperties": false,
      "properties": {
       "alt": {
        "type": "string"
       },
       "caption": {
        "type": "string"
       },
       "credit": {
        "type": "string"
       },
       "license": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "url",
       "alt"
      ],
      "type": "object"
     },
     "sourceUrl": {
      "type": "string"
     },
     "sourceWork": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "translation": {
      "type": "string"
     },
     "translator": {
      "type": "string"
     },
     "year": {
      "type": "number"
     }
    },
    "required": [
     "text",
     "author"
    ],
    "type": "object"
   },
   "readingTimeMinutes": {
    "type": "number"
   },
   "slug": {
    "description": "kebab-case \u00fanico",
    "type": "string"
   },
   "tags": {
    "description": "Tags. Pra publish_quote, 'sapiens-column' \u00e9 adicionada automaticamente se faltar.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "thumbnailUrl": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "tldr": {
    "type": "string"
   }
  },
  "required": [
   "action",
   "slug",
   "title",
   "content"
  ],
  "type": "object"
 },
 "name": "sapiens_quote_pop"
}
