{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start asynchronous AI research for a contact using LinkedIn and other sources, then poll the research ID for results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": false,
    "description": "Request body",
    "properties": {
     "companyDomain": {
      "description": "Company domain (e.g., \"acme.com\")",
      "example": "acme.com",
      "maxLength": 253,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?(\\.[a-zA-Z0-9]([a-zA-Z0-9\\-]{0,61}[a-zA-Z0-9])?)*$",
      "type": "string"
     },
     "companyName": {
      "description": "Name of the contact's company",
      "example": "Acme Corp",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "contactProfileUrl": {
      "description": "Contact profile URL of the contact (e.g., LinkedIn or other professional profile, optional)",
      "example": "https://linkedin.com/in/johndoe",
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     "firstName": {
      "description": "First name of the contact",
      "example": "John",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "jobTitle": {
      "description": "Job title of the contact (optional)",
      "example": "VP of Sales",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "lastName": {
      "description": "Last name of the contact",
      "example": "Doe",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "linkedInSalesNavigatorUrl": {
      "description": "LinkedIn Sales Navigator profile URL of the contact (optional)",
      "example": "https://www.linkedin.com/sales/lead/ACwAAABcD...",
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     "webhookUrl": {
      "description": "Optional webhook URL to receive notifications when processing completes",
      "example": "https://myapp.com/webhooks/contact-research",
      "format": "uri",
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "firstName",
     "lastName",
     "companyName",
     "companyDomain"
    ],
    "type": "object"
   }
  },
  "required": [
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "contacts-create_research"
}
