{
 "description": "Update an existing report configuration",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "columns": {
    "description": "Columns to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "date": {
    "additionalProperties": false,
    "description": "Date configuration",
    "properties": {
     "end": {
      "type": "string"
     },
     "preset": {
      "type": "string"
     },
     "start": {
      "type": "string"
     },
     "timezone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "exclude_campaign_ad_items": {
    "description": "Exclude ad items in campaigns",
    "type": "boolean"
   },
   "exclude_channel_stats": {
    "description": "Exclude stats from channel-served ads",
    "type": "boolean"
   },
   "exclude_publisher_ad_items": {
    "description": "Exclude ad items directly in zones",
    "type": "boolean"
   },
   "filters": {
    "additionalProperties": {},
    "description": "Filter criteria",
    "type": "object"
   },
   "id": {
    "description": "Report configuration ID",
    "type": "number"
   },
   "name": {
    "description": "Report name",
    "type": "string"
   },
   "period": {
    "description": "Data grouping period",
    "enum": [
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "require_channel_stats": {
    "description": "Only include stats from channel-served ads",
    "type": "boolean"
   },
   "type": {
    "description": "Report type",
    "enum": [
     "overview",
     "advertiser",
     "publisher",
     "zone",
     "campaign",
     "channel",
     "geo-target",
     "ad-item"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_custom_report"
}
