{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search published adrenaline activities on Adrenaline List by text, destination slug, category slug, adrenaline rating (1-10), months and maximum duration. Use list_search_options for valid slugs. Prices are indicative.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "pattern": "^[a-z0-9-]{1,80}$",
    "type": "string"
   },
   "destination": {
    "pattern": "^[a-z0-9-]{1,80}$",
    "type": "string"
   },
   "max_adrenaline": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "max_duration_minutes": {
    "maximum": 20160,
    "minimum": 1,
    "type": "integer"
   },
   "min_adrenaline": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "months": {
    "items": {
     "maximum": 12,
     "minimum": 1,
     "type": "integer"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "page": {
    "default": 1,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_adventures",
 "title": "Search adventures"
}
