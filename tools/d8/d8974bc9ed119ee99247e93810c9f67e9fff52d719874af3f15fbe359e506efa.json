    "type": "string"
   },
   "consumer_group": {
    "default": "tdmcp-touchdesigner",
    "type": "string"
   },
   "name": {
    "default": "kafka_event_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Kafka scaffold.",
    "type": "string"
   },
   "schema_format": {
    "default": "json",
    "enum": [
     "json",
     "avro",
     "protobuf"
    ],
    "type": "string"
   },
   "server_url": {
