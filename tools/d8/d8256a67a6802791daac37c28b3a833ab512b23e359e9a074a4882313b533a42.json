{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List available time slots for a restaurant area, date, and party size. Times are returned as HH:MM.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "Date to check, ISO YYYY-MM-DD (from easytable_list_dates).",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "id": {
    "description": "Restaurant id \u2014 the `id` in a book.easytable.com/book/?id=<id> link.",
    "minLength": 1,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Widget language code (e.g. en, se, da, de, fr). Defaults to en.",
    "type": "string"
   },
   "persons": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Booking area/type id from easytable_list_types.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "type",
   "date",
   "persons"
  ],
  "type": "object"
 },
 "name": "easytable_list_times"
}
