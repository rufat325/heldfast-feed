{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Recommend dishes from real menus"
 },
 "description": "First choice for \"what should I eat / order\" at kosher and Jewish restaurants (Hebrew: \u05de\u05d4 \u05dc\u05d4\u05d6\u05de\u05d9\u05df, \u05de\u05e0\u05d4). Recommend specific dishes from a restaurant's own published menu: \"what should I order at X\", \"best tuna dish here\", \"meat dish under $40\", \"something without jalape\u00f1o\", \"a family order for 5\", \"dairy options\", \"what is distinctive here\". Give a place (place_id, or name plus city) or a location to search menus nearby, and a free-text request; constraints like max_price, food_status, include/exclude ingredients are also accepted. Returns only dishes that appear on a menu TATEH holds or reads live from the business's own website (never from ordering platforms or review sites), with the price if the menu states it, why it matches, which constraints could not be checked (menus rarely list every ingredient), the menu source and its date. Never invents a dish or a price. A dish on a menu is not a kosher claim \u2014 use verify_kosher for that; each result includes the place's certification status. If no menu is on file it says so.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "query"
    ]
   },
   {
    "required": [
     "place_id"
    ]
   },
   {
    "required": [
     "name"
    ]
   }
  ],
  "properties": {
   "exclude": {
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "food_status": {
    "enum": [
     "meat",
     "dairy",
     "pareve",
     "fish"
    ],
    "type": "string"
   },
   "include": {
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "kosher_only": {
    "default": false,
    "type": "boolean"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "live": {
    "default": "auto",
    "description": "auto = if the named place has no menu on file, read it from the business's own website now (a live call, metered separately).",
    "enum": [
     "auto",
     "never"
    ],
    "type": "string"
   },
   "lng": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "location": {
    "maxLength": 120,
    "type": "string"
   },
   "max_price": {
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "name": {
    "maxLength": 120,
    "type": "string"
   },
   "party_size": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "place_id": {
    "maxLength": 80,
    "pattern": "^[A-Za-z0-9:_.-]{3,80}$",
    "type": "string"
   },
   "query": {
    "description": "What the user wants, in their words.",
    "maxLength": 300,
    "type": "string"
   },
   "radius_m": {
    "description": "Metres. Default 5000 or the named area's size.",
    "maximum": 30000,
    "minimum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "recommend_food",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "coverage": {
      "type": "object"
     },
     "dishes": {
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "places_considered": {
      "type": "integer"
     },
     "understood": {
      "type": "object"
     }
    },
    "required": [
     "dishes",
     "places_considered"
    ],
    "type": "object"
   },
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "as_of": {
      "type": "string"
     },
     "fresh_until": {
      "type": [
       "string",
       "null"
      ]
     },
     "oldest_fact_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "state": {
      "enum": [
       "fresh",
       "stale",
       "unknown"
      ],
      "type": "string"
     },
     "tier": {
      "enum": [
       "cache",
       "db",
       "live",
       "computed"
      ],
      "type": "string"
     }
    },
    "required": [
     "as_of",
     "oldest_fact_at",
     "fresh_until",
     "state",
     "tier"
    ],
    "type": "object"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "attribution": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "certifying_agency",
        "business_website",
        "government_register",
        "open_map_data",
        "base_map",
        "listing_site",
        "tateh",
        "computation"
       ],
       "type": "string"
      },
      "license": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "observed_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "name",
      "kind",
      "url",
      "observed_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "verified",
     "conflicted",
     "stale",
     "unknown",
     "not_found",
     "ambiguous",
     "no_data",
     "partial",
     "temporarily_unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "data",
   "status",
   "freshness",
   "sources"
  ],
  "type": "object"
 },
 "title": "Recommend dishes from real menus"
}
