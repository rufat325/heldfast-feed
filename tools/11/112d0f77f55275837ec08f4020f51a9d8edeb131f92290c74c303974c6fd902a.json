{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check whether a GEO intent, exact target, measurement surface, language, market and deliverables are supported. Free and deterministic; never starts a project or paid task. Consumer App/browser measurements cannot be substituted with model API results.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "desired_deliverables": {
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "minItems": 1,
    "type": "array"
   },
   "desired_surface": {
    "enum": [
     "consumer_web",
     "consumer_app",
     "model_api",
     "public_sources"
    ],
    "type": "string"
   },
   "intent": {
    "enum": [
     "brand_visibility.observe",
     "answer_citations.inspect",
     "brand_facts.audit",
     "content_changes.prepare",
     "content_changes.execute",
     "visibility_changes.compare"
    ],
    "type": "string"
   },
   "language": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "market": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "request_ref": {
    "maxLength": 160,
    "minLength": 3,
    "pattern": "^[A-Za-z0-9._:/#-]+$",
    "type": "string"
   },
   "target_id": {
    "maxLength": 160,
    "minLength": 3,
    "pattern": "^[A-Za-z0-9._:/#-]+$",
    "type": "string"
   }
  },
  "required": [
   "request_ref",
   "intent",
   "desired_surface",
   "target_id",
   "language",
   "market",
   "desired_deliverables"
  ],
  "type": "object"
 },
 "name": "geo_match_request",
 "title": "\u5339\u914d GEO \u9700\u6c42"
}
