{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Submit an incident or signal encountered by an agent. Creates a pending submitted item via REST API. Other products: call list_products.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Incident details.",
    "type": "string"
   },
   "title": {
    "description": "Short incident title.",
    "type": "string"
   },
   "url": {
    "description": "Optional reference URL.",
    "type": "string"
   }
  },
  "required": [
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "report_incident",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "description": "The created submission.",
    "properties": {
     "id": {
      "description": "Created item id.",
      "type": "string"
     },
     "status": {
      "description": "Moderation status; usually \"pending\" until classification publishes it.",
      "type": "string"
     },
     "url": {
      "description": "Reference URL stored for the submission.",
      "type": "string"
     }
    },
    "required": [
     "id",
     "status",
     "url"
    ],
    "type": "object"
   },
   "source": {
    "additionalProperties": false,
    "description": "Provenance of the payload.",
    "properties": {
     "name": {
      "description": "Feed name.",
      "type": "string"
     },
     "url": {
      "description": "Feed homepage URL.",
      "type": "string"
     }
    },
    "required": [
     "name",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "source"
  ],
  "type": "object"
 }
}
