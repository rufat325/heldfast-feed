    "maxLength": 7,
    "type": "string"
   },
   "ecc": {
    "default": "M",
    "description": "Error correction: L (7%), M (15%), Q (25%), H (30%).",
    "enum": [
     "L",
     "M",
     "Q",
     "H"
    ],
    "type": "string"
   },
   "light": {
    "default": "#ffffff",
    "description": "Background colour, #hex.",
    "maxLength": 7,
    "type": "string"
   },
   "margin": {
    "default": 4,
    "description": "Quiet zone around the code, in squares.",
    "maximum": 16,
    "minimum": 0,
    "type": "integer"
   },
   "size": {
    "default": 512,
    "description": "Image width/height in pixels.",
    "maximum": 2048,
    "minimum": 64,
    "type": "integer"
   },
   "text": {
    "description": "Text or URL to encode.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
