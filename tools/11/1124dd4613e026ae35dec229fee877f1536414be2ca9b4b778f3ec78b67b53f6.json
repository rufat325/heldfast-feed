 "description": "Seconds per block and blocks per hour, taken from the timestamps of two real headers at the edges of a window \u2014 one stalled block shows as a wider span instead of being smoothed away. Costs $0.001 USDC per call. Chains: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche. Byte-identical to GET /chain/block-stats?chain=base&blocks=20.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blocks": {
    "description": "window size in blocks (bounded) (default 20)",
    "type": "string"
   },
   "chain": {
    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
 "name": "chain_block_stats",
 "outputSchema": {
