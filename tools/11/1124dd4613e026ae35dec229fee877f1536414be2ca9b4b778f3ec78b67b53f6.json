    "type": [
     "string",
     "null"
    ]
   },
   "chain": {
    "type": [
     "string",
     "null"
    ]
   },
   "chainId": {
    "type": "integer"
   },
   "chainLabel": {
    "type": [
     "string",
     "null"
    ]
   },
   "edges": {
