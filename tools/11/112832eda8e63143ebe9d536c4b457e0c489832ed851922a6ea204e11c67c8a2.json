{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The signed-in student's class schedule for a term from the Testudo student portal: each registered section with its instructors, credits, delivery method and weekly meetings (days, times, building and room). Use testudo_list_terms with kind \"schedule\" for the terms available. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "term_id": {
    "description": "Four-digit year followed by \"01\" (Spring), \"05\" (Summer), \"08\" (Fall) or \"12\" (Winter), e.g. \"202608\" for Fall 2026",
    "pattern": "^\\d{4}(01|05|08|12)$",
    "type": "string"
   }
  },
  "required": [
   "term_id"
  ],
  "type": "object"
 },
 "name": "testudo_get_schedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "courses": {
    "description": "Registered sections in the order the portal lists them; empty when not registered",
    "items": {
     "additionalProperties": false,
     "properties": {
      "course": {
       "description": "Course id, e.g. \"CMSC131\" or \"ENGL101X\"",
       "pattern": "^[A-Za-z]{4}\\d{3}[A-Za-z]?$",
       "type": "string"
      },
      "credits": {
       "description": "Credits the section is worth",
       "type": [
        "number",
        "null"
       ]
      },
      "dates": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "end": {
           "type": "string"
          },
          "start": {
           "type": "string"
          }
         },
         "required": [
          "start",
          "end"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Sub-term dates when the section does not run the full term; null otherwise"
      },
      "delivery": {
       "anyOf": [
        {
         "enum": [
          "face_to_face",
          "online",
          "blended"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "How the section is taught; null when the portal omits it"
      },
      "drop_add_status": {
       "description": "Drop/add status the portal shows for the section",
       "type": [
        "string",
        "null"
       ]
      },
      "instructors": {
       "description": "Instructor names",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "meetings": {
       "description": "Weekly meetings of the section",
       "items": {
        "additionalProperties": false,
        "properties": {
         "building": {
          "anyOf": [
           {
            "additionalProperties": false,
            "properties": {
             "code": {
              "description": "Building code, e.g. \"IRB\" (see testudo_soc_get_building)",
              "type": [
               "string",
               "null"
              ]
             },
             "name": {
              "description": "Building name, e.g. \"Brendan Iribe Center\"",
              "type": [
               "string",
               "null"
              ]
             },
             "room": {
              "description": "Room number, e.g. \"0324\"",
              "type": [
               "string",
               "null"
              ]
             }
            },
            "required": [
             "name",
             "code",
             "room"
            ],
            "type": "object"
           },
           {
            "type": "null"
           }
          ],
          "description": "Where the meeting is held; null when online or unassigned"
         },
         "days": {
          "description": "Days the meeting is held",
          "items": {
           "enum": [
            "M",
            "Tu",
            "W",
            "Th",
            "F",
            "Sa",
            "Su"
           ],
           "type": "string"
          },
          "type": "array"
         },
         "end_time": {
          "description": "24-hour time as HH:MM; null when the meeting has no fixed time",
          "type": [
           "string",
           "null"
          ]
         },
         "online": {
          "description": "true for a web-only meeting",
          "type": "boolean"
         },
         "start_time": {
          "description": "24-hour time as HH:MM; null when the meeting has no fixed time",
          "type": [
           "string",
           "null"
          ]
         },
         "tba": {
          "description": "true when the time or place is still to be announced",
          "type": "boolean"
         },
         "type": {
          "enum": [
           "lecture",
           "discussion",
           "lab"
          ],
          "type": "string"
         }
        },
        "required": [
         "type",
         "days",
         "start_time",
         "end_time",
         "building",
         "online",
         "tba"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "section": {
       "description": "Section id, e.g. \"0101\"",
       "pattern": "^[A-Za-z0-9]{4}$",
       "type": "string"
      },
      "title": {
       "description": "Course title",
       "type": [
        "string",
        "null"
       ]
      },
      "waitlist_status": {
       "description": "Waitlist status the portal shows; null when enrolled",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "course",
      "section",
      "title",
      "credits",
      "delivery",
      "instructors",
      "dates",
      "drop_add_status",
      "waitlist_status",
      "meetings"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "student": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "uid": {
      "description": "University id",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "uid",
     "name"
    ],
    "type": "object"
   },
   "term": {
    "description": "Four-digit year followed by \"01\" (Spring), \"05\" (Summer), \"08\" (Fall) or \"12\" (Winter), e.g. \"202608\" for Fall 2026",
    "pattern": "^\\d{4}(01|05|08|12)$",
    "type": "string"
   }
  },
  "required": [
   "student",
   "term",
   "courses"
  ],
  "type": "object"
 },
 "title": "Get schedule"
}
