{
 "description": "Execute test automation code on the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "code": {
    "maxLength": 100000,
    "type": "string"
   },
   "device_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   }
  },
  "required": [
   "device_id",
   "code"
  ],
  "type": "object"
 },
 "name": "run_code"
}
