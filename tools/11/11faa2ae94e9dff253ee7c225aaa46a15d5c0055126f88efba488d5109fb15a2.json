{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get user reviews for one anime (by mal_id): review text (truncated to 1200 characters), score, spoiler/preliminary flags, episodes watched at review time (`episodes_watched`, not `chapters_read` \u2014 that field is manga-only), and community reaction counts. `limit` (default 5) caps how many of the fetched page's reviews come back \u2014 it does not itself fetch further pages, use `page` for Tenrai's own ~20-per-page listing. `sort`/`preliminary`/`spoilers`/`sentiment` filter/order the underlying set before that cap is applied. Get the mal_id from search_anime.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "MyAnimeList numeric ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "default": 5,
    "description": "Max results per page (1-50).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "1-based page number for pagination (1-1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "preliminary": {
    "description": "Filter by preliminary. 'true' includes them alongside other reviews (default), 'false' excludes them, 'only' returns exclusively preliminary reviews.",
    "enum": [
     "true",
     "false",
     "only"
    ],
    "type": "string"
   },
   "sentiment": {
    "description": "Restrict to reviews with this overall sentiment tag. Omit for all sentiments.",
    "enum": [
     "recommended",
     "mixed_feelings",
     "not_recommended"
    ],
    "type": "string"
   },
   "sort": {
    "description": "Sort order. Defaults to most_helpful (Tenrai's own default) when omitted.",
    "enum": [
     "newest",
     "oldest",
     "most_helpful"
    ],
    "type": "string"
   },
   "spoilers": {
    "description": "Filter by spoiler. 'true' includes them alongside other reviews (default), 'false' excludes them, 'only' returns exclusively spoiler reviews.",
    "enum": [
     "true",
     "false",
     "only"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_anime_reviews",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "reviews": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "chapters_read": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "date": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "episodes_watched": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "is_preliminary": {
       "type": "boolean"
      },
      "is_spoiler": {
       "type": "boolean"
      },
      "reactions": {
       "additionalProperties": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "review": {
       "type": "string"
      },
      "score": {
       "maximum": 10,
       "minimum": 1,
       "type": "integer"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "url": {
       "type": "string"
      },
      "user": {
       "type": "string"
      }
     },
     "required": [
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "reviews"
  ],
  "type": "object"
 },
 "title": "Get anime reviews"
}
