{
 "description": "Draft adding one or more negative keyword criteria to an ad group, to stop ads showing for those terms. Returns a draftId \u2014 call confirm_write to actually apply it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adGroupId": {
    "description": "Numeric ad group ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "keywords": {
    "items": {
     "properties": {
      "matchType": {
       "default": "BROAD",
       "enum": [
        "EXACT",
        "PHRASE",
        "BROAD"
       ],
       "type": "string"
      },
      "text": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "text"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "adGroupId",
   "keywords"
  ],
  "type": "object"
 },
 "name": "add_negative_keywords",
 "title": "Draft: add negative keywords to an ad group"
}
