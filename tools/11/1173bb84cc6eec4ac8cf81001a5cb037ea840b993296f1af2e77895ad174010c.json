{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud DB for PostgreSQL instance. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backupFileRetentionPeriod": {
    "description": "Backup retention period in days (1-30)",
    "type": "number"
   },
   "backupFileStorageCount": {
    "description": "Number of backup files to retain (1-30)",
    "type": "number"
   },
   "backupTime": {
    "description": "Backup time (HH:mm format)",
    "type": "string"
   },
   "clientCidr": {
    "description": "Client CIDR for access control",
    "type": "string"
   },
   "cloudPostgresqlDatabaseName": {
    "description": "Initial database name",
    "type": "string"
   },
   "cloudPostgresqlImageProductCode": {
    "description": "PostgreSQL image product code",
    "type": "string"
   },
   "cloudPostgresqlPort": {
    "description": "PostgreSQL port number (default: 5432)",
    "type": "number"
   },
   "cloudPostgresqlProductCode": {
    "description": "PostgreSQL server product (spec) code",
    "type": "string"
   },
   "cloudPostgresqlServerNamePrefix": {
    "description": "Server name prefix",
    "type": "string"
   },
   "cloudPostgresqlServiceName": {
    "description": "PostgreSQL service name (3-20 chars, lowercase letters and numbers)",
    "type": "string"
   },
   "cloudPostgresqlUserName": {
    "description": "Initial user name",
    "type": "string"
   },
   "cloudPostgresqlUserPassword": {
    "description": "Initial user password",
    "type": "string"
   },
   "dataStorageTypeCode": {
    "description": "Data storage type code (SSD | HDD | CB2)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating the instance",
    "type": "boolean"
   },
   "engineVersionCode": {
    "description": "PostgreSQL engine version code (required for Gen3/KVM)",
    "type": "string"
   },
   "isAutomaticBackup": {
    "description": "Whether to enable automatic backup scheduling",
    "type": "boolean"
   },
   "isBackup": {
    "description": "Whether to enable automatic backup",
    "type": "boolean"
   },
   "isBackupFileCompression": {
    "description": "Whether to compress backup files",
    "type": "boolean"
   },
   "isHa": {
    "description": "High availability setting (default: true)",
    "type": "boolean"
   },
   "isMultiZone": {
    "description": "Whether to enable multi-zone high availability",
    "type": "boolean"
   },
   "isStorageEncryption": {
    "description": "Storage encryption (cannot be changed after creation)",
    "type": "boolean"
   },
   "secondarySubnetNo": {
    "description": "Secondary subnet number (required when isMultiZone is true)",
    "type": "string"
   },
   "subnetNo": {
    "description": "Subnet number",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "string"
   }
  },
  "required": [
   "cloudPostgresqlServiceName",
   "vpcNo",
   "subnetNo",
   "cloudPostgresqlDatabaseName",
   "cloudPostgresqlUserName",
   "cloudPostgresqlUserPassword",
   "cloudPostgresqlServerNamePrefix",
   "clientCidr"
  ],
  "type": "object"
 },
 "name": "ncloud_create_postgresql_instance"
}
