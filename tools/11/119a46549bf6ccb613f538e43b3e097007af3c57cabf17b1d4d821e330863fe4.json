{
 "description": "Audit the on-page SEO of up to N pages from a sitemap and roll up the most common issues across the site. Takes a sitemap URL rather than a Search Console property, and needs no Google credentials",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "concurrency": {
    "default": 5,
    "description": "Maximum page fetches in flight",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "maxPages": {
    "default": 20,
    "description": "Maximum pages to audit",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "sitemapUrl": {
    "description": "Public sitemap URL to audit",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "sitemapUrl"
  ],
  "type": "object"
 },
 "name": "audit_site",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audited": {
    "type": "number"
   },
   "childSitemapsFailed": {
    "type": "number"
   },
   "childSitemapsSkipped": {
    "type": "number"
   },
   "failed": {
    "type": "number"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "error": {
       "type": "string"
      },
      "h1": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "issues": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "metaDescription": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rollup": {
    "additionalProperties": {
     "type": "number"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "sitemapUrl": {
    "type": "string"
   },
   "skipped": {
    "type": "number"
   },
   "totalDiscovered": {
    "type": "number"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "sitemapUrl",
   "totalDiscovered",
   "audited",
   "failed",
   "truncated",
   "skipped",
   "childSitemapsSkipped",
   "childSitemapsFailed",
   "pages",
   "rollup"
  ],
  "type": "object"
 }
}
