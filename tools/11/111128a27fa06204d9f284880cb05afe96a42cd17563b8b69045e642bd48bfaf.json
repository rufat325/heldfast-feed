{
 "_meta": {},
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create collection"
 },
 "description": "Create a collection: plain JSON, vector (dimension + metric), or vectorize (server-side embeddings from a provider \u2014 see list_vectorize_providers), optionally with lexical (BM25) and rerank for hybrid search, indexing allow/deny, and a default id type. Idempotent when the settings match an existing collection.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "database": {
    "description": "Database to use: name, id, or Data API endpoint URL. Omit for the configured default.",
    "minLength": 1,
    "type": "string"
   },
   "defaultId": {
    "description": "Auto-generated _id type.",
    "enum": [
     "objectId",
     "uuid",
     "uuidv6",
     "uuidv7"
    ],
    "type": "string"
   },
   "indexing": {
    "description": "Index only (allow) or all but (deny) these fields. Deny large text fields you never filter on.",
    "properties": {
     "allow": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "deny": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "keyspace": {
    "description": "Keyspace. Omit for the configured/default keyspace.",
    "minLength": 1,
    "type": "string"
   },
   "lexical": {
    "description": "Enable BM25 lexical search (needed for hybrid).",
    "type": "boolean"
   },
   "name": {
    "description": "New collection name (letters, digits, underscore).",
    "pattern": "^[A-Za-z][A-Za-z0-9_]{0,47}$",
    "type": "string"
   },
   "rerank": {
    "description": "Reranking service (needed for hybrid).",
    "properties": {
     "modelName": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     }
    },
    "required": [
     "provider",
     "modelName"
    ],
    "type": "object"
   },
   "vector": {
    "description": "Omit for a non-vector collection.",
    "properties": {
     "dimension": {
      "description": "Required unless a vectorize service sets it.",
      "maximum": 8192,
      "minimum": 2,
      "type": "integer"
     },
     "metric": {
      "default": "cosine",
      "enum": [
       "cosine",
       "dot_product",
       "euclidean"
      ],
      "type": "string"
     },
     "service": {
      "properties": {
       "authentication": {
        "additionalProperties": {
         "type": "string"
        },
        "description": "e.g. {\"providerKey\": \"<key name in Astra>\"}",
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "modelName": {
        "type": "string"
       },
       "parameters": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "provider": {
        "description": "Vectorize provider, e.g. \"nvidia\", \"openai\" (see list_vectorize_providers).",
        "type": "string"
       }
      },
      "required": [
       "provider",
       "modelName"
      ],
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_collection",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "deletedCount": {
    "type": "number"
   },
   "failures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "index": {
       "type": "number"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "insertedCount": {
    "type": "number"
   },
   "insertedIds": {
    "items": {},
    "type": "array"
   },
   "keyspace": {
    "type": "string"
   },
   "kind": {
    "type": "string"
   },
   "matchedCount": {
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "modifiedCount": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "operation": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "cancelled"
    ],
    "type": "string"
   },
   "upsertedId": {},
   "view": {
    "const": "mutation",
    "type": "string"
   }
  },
  "required": [
   "view",
   "operation",
   "status",
   "keyspace",
   "name",
   "kind",
   "message"
  ],
  "type": "object"
 },
 "title": "Create collection"
}
