{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update collection filters"
 },
 "description": "Revise a collection's filters. Only what you pass changes: add or remove keywords, entities, exclusion terms and (stock portfolios) tickers; replace the query or the regions. Confirm the change with the user first. Get collection ids from list_collections. Costs 0 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "add_entities": {
    "description": "Entities to add, e.g. {type: 'company', name: 'Nvidia'}",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "minLength": 1,
       "type": "string"
      },
      "type": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "type",
      "name"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "add_exclude_terms": {
    "description": "Terms to exclude",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "add_keywords": {
    "description": "Keywords to add",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "add_tickers": {
    "description": "stock_portfolio: tickers to add",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "collection_id": {
    "description": "Collection id (from list_collections)",
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Replace the search query",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "regions": {
    "anyOf": [
     {
      "items": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replace the region list; null clears it"
   },
   "remove_entities": {
    "description": "Entity names to remove",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "remove_exclude_terms": {
    "description": "Exclusions to drop",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "remove_keywords": {
    "description": "Keywords to remove",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "remove_tickers": {
    "description": "stock_portfolio: tickers to remove",
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "collection_id"
  ],
  "type": "object"
 },
 "name": "update_collection_filters",
 "title": "Update collection filters"
}
