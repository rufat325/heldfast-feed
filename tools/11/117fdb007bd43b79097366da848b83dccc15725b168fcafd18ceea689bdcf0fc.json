{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run a generation and save the asset into the workspace. `params` is the payload you composed from describe_media_model. For editing, `params` may reference workspace file paths (e.g. image, mask) which the server reads and encodes. The asset is saved under output_dir (default ./assets/chutes/<kind>/) and the saved path is returned. Long video/music jobs block with progress updates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cord": {
    "description": "Operation/cord (e.g. img2img); defaults to the primary one.",
    "maxLength": 200,
    "type": "string"
   },
   "filename": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "enum": [
     "image",
     "video",
     "music",
     "speech"
    ],
    "type": "string"
   },
   "model": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "output_dir": {
    "description": "Output directory relative to CWD.",
    "maxLength": 1024,
    "type": "string"
   },
   "overwrite": {
    "description": "Explicitly replace an existing asset and sidecar.",
    "type": "boolean"
   },
   "params": {
    "additionalProperties": {},
    "description": "Payload matching the cord's input schema.",
    "type": "object"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   }
  },
  "required": [
   "model",
   "kind",
   "params"
  ],
  "type": "object"
 },
 "name": "generate_media",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "minimum": 0,
    "type": "integer"
   },
   "contentType": {
    "type": "string"
   },
   "cord": {
    "type": "string"
   },
   "cost": {
    "type": "number"
   },
   "durationMs": {
    "minimum": 0,
    "type": "number"
   },
   "kind": {
    "enum": [
     "image",
     "video",
     "music",
     "speech"
    ],
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "provenancePath": {
    "type": "string"
   },
   "schemaHash": {
    "maxLength": 64,
    "minLength": 64,
    "type": "string"
   }
  },
  "required": [
   "path",
   "kind",
   "model",
   "cord",
   "bytes",
   "contentType",
   "durationMs"
  ],
  "type": "object"
 },
 "title": "Generate media with Chutes"
}
