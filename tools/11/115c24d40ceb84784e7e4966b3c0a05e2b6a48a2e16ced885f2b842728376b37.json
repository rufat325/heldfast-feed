{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Bulk-edit ALL checklist items of a project/portfolio (item count cannot change; omitted optional fields are reset).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entityId": {
    "type": "string"
   },
   "entityType": {
    "description": "Checklists are available for projects and portfolios only",
    "enum": [
     "project",
     "portfolio"
    ],
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "assignee": {
       "type": [
        "string",
        "number"
       ]
      },
      "checked": {
       "type": "boolean"
      },
      "deadline": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "text"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "notify": {
    "type": "boolean"
   }
  },
  "required": [
   "entityType",
   "entityId",
   "items"
  ],
  "type": "object"
 },
 "name": "update_entity_checklist"
}
