{
 "description": "Start automatic schema creation for one local document. Returns a normalized run_id and the SDK result. Use get_quick_schema_creation or wait_for_quick_schema_creation to follow the run. Supply upload_batch_id and source_upload_id only when an external batched-upload workflow provides them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "description": "Optional API base URL. Defaults to SUPARSE_API_URL or Suparse production API.",
    "format": "uri",
    "type": "string"
   },
   "file_path": {
    "description": "Local path to a supported document file.",
    "minLength": 1,
    "type": "string"
   },
   "folder_id": {
    "description": "Optional remote Suparse folder ID to assign to the source document.",
    "minLength": 1,
    "type": "string"
   },
   "pdf_password": {
    "description": "Optional encrypted-PDF password. Treat this as a secret.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "source_upload_id": {
    "description": "Optional source upload ID from an external batch workflow.",
    "minLength": 1,
    "type": "string"
   },
   "upload_batch_id": {
    "description": "Optional existing upload batch ID from an external batch workflow.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "start_quick_schema_creation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "result": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "document_id": {
        "type": "string"
       },
       "path": {
        "type": "string"
       },
       "replay_state": {
        "type": [
         "string",
         "null"
        ]
       },
       "replayed": {
        "type": "boolean"
       },
       "run_id": {
        "type": "string"
       },
       "source_upload_id": {
        "type": [
         "string",
         "null"
        ]
       },
       "stage": {
        "type": "string"
       },
       "status": {
        "const": "queued",
        "type": "string"
       },
       "upload_batch_id": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "run_id",
       "document_id",
       "status"
      ],
      "type": "object"
     },
     {
      "additionalProperties": true,
      "properties": {
       "document_id": {
        "type": "string"
       },
       "quick_schema_run_id": {
        "type": "string"
       },
       "replay_state": {
        "type": [
         "string",
         "null"
        ]
       },
       "replayed": {
        "type": "boolean"
       },
       "source_upload_id": {
        "type": "string"
       },
       "upload_batch_id": {
        "type": "string"
       }
      },
      "required": [
       "document_id",
       "source_upload_id",
       "upload_batch_id",
       "quick_schema_run_id",
       "replayed"
      ],
      "type": "object"
     }
    ]
   },
   "run_id": {
    "type": "string"
   }
  },
  "required": [
   "run_id",
   "result"
  ],
  "type": "object"
 },
 "title": "Start Quick Schema Creation"
}
