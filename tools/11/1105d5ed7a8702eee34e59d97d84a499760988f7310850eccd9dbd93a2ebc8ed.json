{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Creates a company owned by the signed-in user, for example before importing a cap table. Give its name (and code, a lowercase slug). The user becomes its owner; there is no way to create a company for someone else. Returns the new company id.",
 "inputSchema": {
  "properties": {
   "company": {
    "properties": {
     "address": {
      "properties": {
       "city": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       "county": {
        "maxLength": 100,
        "type": "string"
       },
       "state": {
        "maxLength": 100,
        "type": "string"
       },
       "street1": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "street2": {
        "maxLength": 200,
        "type": "string"
       },
       "zipCode": {
        "maxLength": 20,
        "type": "string"
       }
      },
      "type": "object"
     },
     "aliases": {
      "items": {
       "description": "Human-readable name (1-255 Unicode chars).",
       "properties": {
        "value": {
         "maxLength": 255,
         "minLength": 1,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "code": {
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "type": "string"
     },
     "createdAt": {
      "format": "date-time",
      "type": "string"
     },
     "ein": {
      "maxLength": 10,
      "pattern": "^([0-9]{2}-[0-9]{7})?$",
      "type": "string"
     },
     "formedOn": {
      "maxLength": 10,
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "id": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "logoUrl": {
      "maxLength": 1000,
      "type": "string"
     },
     "name": {
      "description": "Human-readable name (1-255 Unicode chars).",
      "properties": {
       "value": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "siblingCompanyIds": {
      "items": {
       "description": "UUID value wrapper.",
       "properties": {
        "value": {
         "format": "uuid",
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 20,
      "type": "array"
     },
     "source": {
      "enum": [
       "COMPANY_SOURCE_UNSPECIFIED",
       "COMPANY_SOURCE_LOVIE_FORMATION",
       "COMPANY_SOURCE_USER_CREATED",
       "COMPANY_SOURCE_IMPORTED"
      ],
      "type": "string"
     },
     "stateOfFormation": {
      "maxLength": 2,
      "pattern": "^([A-Z]{2})?$",
      "type": "string"
     },
     "status": {
      "enum": [
       "COMPANY_STATUS_UNSPECIFIED",
       "COMPANY_STATUS_ACTIVE",
       "COMPANY_STATUS_INACTIVE",
       "COMPANY_STATUS_SUSPENDED"
      ],
      "type": "string"
     },
     "type": {
      "enum": [
       "COMPANY_TYPE_UNSPECIFIED",
       "COMPANY_TYPE_LLC",
       "COMPANY_TYPE_C_CORP",
       "COMPANY_TYPE_S_CORP",
       "COMPANY_TYPE_NONPROFIT",
       "COMPANY_TYPE_SOLE_PROP",
       "COMPANY_TYPE_PARTNERSHIP"
      ],
      "type": "string"
     },
     "updatedAt": {
      "format": "date-time",
      "type": "string"
     },
     "userId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "name",
     "userId"
    ],
    "type": "object"
   }
  },
  "required": [
   "company"
  ],
  "type": "object"
 },
 "name": "company_create_company",
 "outputSchema": {
  "properties": {
   "companyId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "title": "Create Company"
}
