     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "language_detected": {
    "type": [
     "string",
     "null"
    ]
   },
   "latest_extraction_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "dashboard": {
      "type": "string"
     },
