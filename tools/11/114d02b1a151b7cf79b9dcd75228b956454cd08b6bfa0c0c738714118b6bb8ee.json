 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Talonic Document"
 },
 "description": "Fetch a single document's metadata and processing status from the workspace.\n\nUSE WHEN: 'tell me about document X', or to poll status after talonic_request_upload until the file is ready.\nNOT FOR: full text (use talonic_to_markdown) \u00b7 extracted fields (use talonic_extract).\nBY NAME: if the user names a file, call talonic_search first to get its document_id, then call this.\nARGS: document_id.\nRETURNS: filename, pages, type_detected, language, and `status`. Status lifecycle: pending_upload -> uploading -> queued -> extracting -> completed. Wait for `completed` before calling talonic_extract on a freshly uploaded doc. Terminal failure statuses: ocr_failed, extraction_failed, error \u2014 stop polling and report the failure to the user if any of these appear. To read the document's text, call talonic_to_markdown with this id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document_id": {
    "description": "The Talonic document ID. Get this from a previous talonic_extract or talonic_search response.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "document_id"
  ],
  "type": "object"
 },
 "name": "talonic_get_document",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created_at": {
    "type": "string"
   },
