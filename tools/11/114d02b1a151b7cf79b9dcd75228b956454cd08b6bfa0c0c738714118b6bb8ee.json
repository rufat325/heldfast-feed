      },
      "duration_ms": {
       "type": "number"
      },
      "started_at": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "step": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "size_bytes": {
    "type": [
     "number",
     "null"
    ]
   },
   "source": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "type": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "type": "string"
   },
   "triage": {
