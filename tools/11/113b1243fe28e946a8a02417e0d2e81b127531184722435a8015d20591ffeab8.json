{
 "description": "Create a new issue/ticket",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actualHours": {
    "type": "number"
   },
   "assigneeId": {
    "type": "number"
   },
   "attachmentId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "categoryId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "dueDate": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "estimatedHours": {
    "type": "number"
   },
   "issueTypeId": {
    "type": "number"
   },
   "milestoneId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "notifiedUserId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "parentIssueId": {
    "type": "number"
   },
   "priorityId": {
    "type": "number"
   },
   "projectId": {
    "type": "number"
   },
   "startDate": {
    "pattern": "^d{4}-d{2}-d{2}$",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "versionId": {
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "summary",
   "issueTypeId",
   "priorityId"
  ],
  "type": "object"
 },
 "name": "create_issue"
}
