{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List CASL consent records for your account, optionally filtered by phone number or status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "email_address": {
    "description": "Filter consents for one email address.",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (default: 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default: 1).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "phone_number": {
    "description": "Filter consents for a specific phone number (E.164).",
    "type": "string"
   },
   "status": {
    "description": "Filter by consent status.",
    "enum": [
     "ACTIVE",
     "EXPIRED",
     "REVOKED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_consents",
 "title": "List consents"
}
