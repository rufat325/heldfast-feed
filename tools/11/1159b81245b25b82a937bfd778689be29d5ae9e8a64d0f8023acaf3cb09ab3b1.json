{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Compare current prices for one fuel type across 2-10 countries. Returns sorted table cheapest-first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country_codes": {
    "description": "Array of 2-10 ISO 3166-1 alpha-2 country codes to compare.",
    "items": {
     "maxLength": 2,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "fuel_type": {
    "default": "diesel",
    "description": "Fuel type to compare. Uses the same keys as /api/fuel/prices prices.",
    "enum": [
     "gasoline_regular",
     "gasoline",
     "gasoline_premium",
     "gasoline_super",
     "diesel_regular",
     "diesel",
     "diesel_premium",
     "lpg",
     "cng",
     "e85",
     "kerosene",
     "premium"
    ],
    "type": "string"
   }
  },
  "required": [
   "country_codes"
  ],
  "type": "object"
 },
 "name": "compare_fuel_prices",
 "title": "Compare Fuel Prices"
}
