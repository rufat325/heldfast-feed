{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a placeholder image URL (served by usesignal.dev) plus HTML, Markdown and CSS snippets, for mockups, prototypes, seed data and layouts. Width and height up to 4000 px.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "background": {
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   },
   "color": {
    "$ref": "#/properties/background"
   },
   "height": {
    "maximum": 4000,
    "minimum": 1,
    "type": "integer"
   },
   "pattern": {
    "enum": [
     "plain",
     "grid",
     "diagonal",
     "dots",
     "minimal"
    ],
    "type": "string"
   },
   "radius": {
    "maximum": 999,
    "minimum": 0,
    "type": "integer"
   },
   "style": {
    "default": "minimal",
    "enum": [
     "minimal",
     "grid",
     "gradient",
     "dark",
     "glass"
    ],
    "type": "string"
   },
   "text": {
    "maxLength": 120,
    "type": "string"
   },
   "width": {
    "maximum": 4000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "usesignal_placeholder_image"
}
