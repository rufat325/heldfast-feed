{
 "_meta": {
  "threadlinqs/catalog_note": "Served from the public catalog, not your authenticated tool list. Check THREADLINQS_API_KEY.",
  "threadlinqs/catalog_source": "public_catalog"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Malware Intelligence"
 },
 "description": "Pivot on a malware FAMILY by name (e.g. \"LockBit\", \"Vidar\", \"Emotet\"). Returns the canonical family + type, prevalence (threat/actor counts, first/last seen), the threats deploying it, the actors using it, and its most-common ATT&CK techniques. For an offensive TOOL (Cobalt Strike, Mimikatz) use get_tool_intelligence instead. Call resolve_entity first if unsure of the canonical name.",
 "inputSchema": {
  "properties": {
   "name": {
    "description": "Malware family name (e.g. \"LockBit\", \"Vidar\")",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "get_malware_intelligence",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "actors": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "count": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "canonical": {
    "type": "string"
   },
   "entity_type": {
    "type": "string"
   },
   "matched": {
    "type": "boolean"
   },
   "membership": {
    "additionalProperties": true,
    "properties": {
     "grounded": {
      "type": "integer"
     },
     "note": {
      "type": "string"
     },
     "title_match": {
      "type": "integer"
     },
     "total": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "prevalence": {
    "additionalProperties": true,
    "properties": {
     "actor_count": {
      "description": "TRUE distinct-actor prevalence, uncapped. The actors[] array is clipped to 20 \u2014 compare with actors_returned.",
      "type": "integer"
     },
     "actors_returned": {
      "type": "integer"
     },
     "threat_count": {
      "type": "integer"
     },
     "threat_count_is_floor": {
      "description": "True when the membership fetch saturated, so threat_count under-counts.",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "query": {
    "type": "string"
   },
   "threats": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "matched_via": {
       "description": "campaigns only: grounded | title | grounded+title",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "top_techniques": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "count": {
       "type": "integer"
      },
      "technique_id": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "matched"
  ],
  "type": "object"
 },
 "title": "Malware Intelligence"
}
