{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Get price history + latest for a market. Window defaults to ALL; supports 1H, 1D, 1W.\n\nExamples: Read the 1D price history for a market",
 "inputSchema": {
  "properties": {
   "address": {
    "type": "string"
   },
   "chainId": {
    "type": "number"
   },
   "window": {
    "enum": [
     "1H",
     "1D",
     "1W",
     "ALL"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "problee_get_market_chart",
 "outputSchema": {
  "$defs": {
   "AgentMarketChartResponse": {
    "additionalProperties": false,
    "properties": {
     "latest": {
      "anyOf": [
       {
        "$ref": "#/$defs/McpMarketPricePoint"
       },
       {
        "type": "null"
       }
      ]
     },
     "meta": {
      "additionalProperties": false,
      "properties": {
       "pointCount": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "pricingTimestampMs": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "snapshotUpdatedAtMs": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "pointCount",
       "snapshotUpdatedAtMs",
       "pricingTimestampMs"
      ],
      "type": "object"
     },
     "series": {
      "items": {
       "$ref": "#/$defs/McpMarketPricePoint"
      },
      "type": "array"
     },
     "window": {
      "enum": [
       "1H",
       "1D",
       "1W",
       "ALL"
      ],
      "type": "string"
     }
    },
    "required": [
     "series",
     "latest",
     "window",
     "meta"
    ],
    "type": "object"
   },
   "McpMarketPricePoint": {
    "additionalProperties": false,
    "properties": {
     "outcome1": {
      "type": "number"
     },
     "outcome2": {
      "type": "number"
     },
     "outcome3": {
      "type": "number"
     },
     "pricingTimestampMs": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "timestamp": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "outcome1",
     "outcome2",
     "timestamp"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/AgentMarketChartResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Price history + latest frame for a market across a time window"
}
