{
 "description": "List the user's posts. Filter by status (draft, scheduled, publishing, published, failed) and/or platform. Paginated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "description": "Pagination cursor from a previous response",
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "platform": {
    "description": "e.g. instagram, twitter, tiktok",
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "scheduled",
     "publishing",
     "published",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_posts",
 "title": "List posts"
}
