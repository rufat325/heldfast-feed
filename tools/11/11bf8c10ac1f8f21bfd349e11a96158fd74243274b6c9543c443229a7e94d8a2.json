{
 "description": "Validate a local VRM file and return a finding list: missing required humanoid bones, broken node references, missing meta/license fields, unrecognized required extensions, and configurable size/triangle/texture/material budget checks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limits": {
    "additionalProperties": false,
    "description": "Optional budget overrides",
    "properties": {
     "max_materials": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "max_texture_size": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "max_total_bytes": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "max_triangles": {
      "exclusiveMinimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "path": {
    "description": "Local path to a .vrm file",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "vrm_validate"
}
