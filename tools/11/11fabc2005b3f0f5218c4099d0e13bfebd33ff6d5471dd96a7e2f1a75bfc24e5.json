{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "News articles student organizations and departments post on TerpLink, newest first, optionally filtered by keyword or organization. Call terplink_get_article for the body. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return, 1-50 (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of records to skip, for pagination (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "organization_id": {
    "description": "Only articles from this organization",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "query": {
    "description": "Words to match in the title or body",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "terplink_get_news",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "articles": {
    "description": "Newest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "description": "Author name",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Article id, for terplink_get_article",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "image_url": {
       "description": "Cover image",
       "type": [
        "string",
        "null"
       ]
      },
      "organization": {
       "additionalProperties": false,
       "description": "The organization that posted the article",
       "properties": {
        "id": {
         "description": "Organization id",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "description": "Organization name",
         "type": "string"
        },
        "website_key": {
         "description": "Pass to terplink_get_organization",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "name",
        "website_key"
       ],
       "type": "object"
      },
      "published": {
       "description": "When the article was posted",
       "type": "string"
      },
      "summary": {
       "description": "Teaser text",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "description": "Headline",
       "type": "string"
      },
      "updated": {
       "description": "When the article was last edited",
       "type": "string"
      },
      "url": {
       "description": "Public TerpLink page",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "summary",
      "published",
      "updated",
      "organization",
      "author",
      "image_url",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Articles matching the query",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "articles"
  ],
  "type": "object"
 },
 "title": "Get news"
}
