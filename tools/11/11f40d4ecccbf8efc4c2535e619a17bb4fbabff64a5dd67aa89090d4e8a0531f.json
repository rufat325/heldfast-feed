{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record one production interaction with your agent (the prompt or messages, the final answer, the tools it called, optionally the model) as a trace on a target. Call it from your agent or from a proxy in front of it after each task; promote a good trace with agentcheck_promote_trace to replay it nightly and catch regressions. Requires an API key.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "input": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "properties": {
        "content": {
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       },
       "required": [
        "role",
        "content"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "the prompt, the messages array, or an object with prompt/messages"
   },
   "model": {
    "description": "the model that produced this answer, so drift re-runs can compare across models",
    "type": "string"
   },
   "name": {
    "description": "short label, e.g. 'refund for order A-1029'",
    "maxLength": 120,
    "type": "string"
   },
   "output": {
    "description": "the agent's final answer",
    "minLength": 1,
    "type": "string"
   },
   "targetId": {
    "description": "id from agentcheck_create_target or GET /api/v1/targets",
    "minLength": 1,
    "type": "string"
   },
   "toolCalls": {
    "description": "tool calls in order",
    "items": {
     "properties": {
      "args": {},
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "targetId",
   "input",
   "output"
  ],
  "type": "object"
 },
 "name": "agentcheck_record"
}
