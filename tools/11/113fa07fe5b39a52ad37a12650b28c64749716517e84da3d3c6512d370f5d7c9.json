    "items": {
     "additionalProperties": false,
     "description": "A straight fold across the whole part, on the line through start_in\nand end_in ([x, y] in the item's frame; any two points on the line).\nangle_deg is how far it folds: 90 is a square bend. direction is up (a\nmountain fold seen from above) or down (a valley fold); it does not\nchange the price.",
     "properties": {
      "angle_deg": {
       "default": 90.0,
       "exclusiveMinimum": 0,
       "maximum": 180,
       "type": "number"
      },
      "direction": {
       "default": "up",
       "enum": [
        "up",
        "down"
       ],
       "type": "string"
      },
      "end_in": {
       "maxItems": 2,
       "minItems": 2,
       "prefixItems": [
        {
         "maximum": 120,
         "minimum": 0,
         "type": "number"
        },
        {
         "maximum": 120,
         "minimum": 0,
         "type": "number"
        }
       ],
       "type": "array"
      },
