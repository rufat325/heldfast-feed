         "maximum": 120,
         "minimum": 0,
         "type": "number"
        },
        {
         "maximum": 120,
         "minimum": 0,
         "type": "number"
        }
       ],
       "type": "array"
      }
     },
     "required": [
      "start_in",
      "end_in"
     ],
     "type": "object"
    },
    "maxItems": 10,
