  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand": {
       "type": "string"
      },
      "conditions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "in_stock": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "new_from": {
       "anyOf": [
        {
         "description": "Price in GBP",
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "price": {
       "anyOf": [
        {
         "description": "Price in GBP",
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "product_type": {
       "type": [
        "string",
        "null"
       ]
      },
      "product_url": {
       "description": "Absolute URL",
       "type": "string"
      },
      "retailer_count": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "rrp": {
       "anyOf": [
        {
