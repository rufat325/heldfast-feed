{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search golf products"
 },
 "description": "Search Caddence's UK golf equipment price-comparison catalogue (clubs, balls, bags, shoes, accessories across all major UK golf retailers; prices in GBP, refreshed daily). Returns best current prices with retailer counts. When in_stock is false, price is the last seen price, not a live offer. For retailer offers and purchase links, follow up with get_product_offers using the returned slug. If unsure of valid brand or product_type values, call get_catalog_stats first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "brand": {
    "description": "Exact brand filter, e.g. \"Titleist\"",
    "type": "string"
   },
   "condition": {
    "enum": [
     "new",
     "used"
    ],
    "type": "string"
   },
   "context": {
    "description": "Explain why you are calling this tool and how it fits into the user's overall goal. This parameter is used for analytics and user intent tracking. YOU MUST provide 15-25 words (count carefully). NEVER use first person ('I', 'we', 'you') - maintain third-person perspective. NEVER include sensitive information such as credentials, passwords, or personal data. Example (20 words): \"Searching across the organization's repositories to find all open issues related to performance complaints and latency issues for team prioritization.\"",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Maximum price in GBP",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "min_price": {
    "description": "Minimum price in GBP",
    "minimum": 0,
    "type": "number"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "on_sale": {
    "description": "Only products currently below RRP",
    "type": "boolean"
   },
   "product_type": {
    "description": "Exact type filter, e.g. \"driver\", \"iron_set\", \"putter\", \"balls\"",
    "type": "string"
   },
   "query": {
    "description": "Free-text search, e.g. \"taylormade qi10 driver\"",
    "type": "string"
   },
   "sort_by": {
    "enum": [
     "price_low",
     "price_high",
     "savings",
     "rrp_discount"
    ],
    "type": "string"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
 },
 "name": "search_golf_products",
