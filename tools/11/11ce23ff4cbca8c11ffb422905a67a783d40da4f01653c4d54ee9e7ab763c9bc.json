       ]
      },
      "rrp_discount_pct": {
       "type": [
        "number",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "used_from": {
       "anyOf": [
        {
         "description": "Price in GBP",
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "brand",
      "slug",
      "product_type",
      "price",
      "rrp",
      "rrp_discount_pct",
      "new_from",
      "used_from",
      "conditions",
      "retailer_count",
      "in_stock",
      "product_url"
