{
 "description": "Read top-level comments with optional replies and structured provenance. [~1-3s]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "type": "boolean"
   },
   "includeReplies": {
    "type": "boolean"
   },
   "languageHint": {
    "type": "string"
   },
   "maxRepliesPerThread": {
    "maximum": 20,
    "minimum": 0,
    "type": "number"
   },
   "maxTopLevel": {
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "order": {
    "enum": [
     "relevance",
     "time"
    ],
    "type": "string"
   },
   "videoIdOrUrl": {
    "type": "string"
   }
  },
  "required": [
   "videoIdOrUrl"
  ],
  "type": "object"
 },
 "name": "readComments"
}
