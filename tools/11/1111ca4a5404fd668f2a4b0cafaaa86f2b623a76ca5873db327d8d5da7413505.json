{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Emits a PassportDraft as AAS JSON (IDTA 02035 submodels), an AASX package, the draft JSON and/or the HTML sheet, and re-validates the emitted output. Fail-honest: files are returned even when the verdict is invalid, and the verdict is never better than validate_passport\u2019s. Bytes come back base64 inline unless outDir is given.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "asOf": {
    "description": "ISO date-time treated as \"now\" by the re-validation",
    "type": "string"
   },
   "draft": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "draftId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "draftId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": {},
      "properties": {
       "meta": {}
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ],
    "description": "A PassportDraft object, or { draftId } as returned by an earlier call"
   },
   "htmlLang": {
    "description": "Language the html sheet opens in (both are in the file; default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Language of the text summary (default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "outDir": {
    "description": "Directory to write into (needs a file system). Omit to receive base64 bytes inline",
    "type": "string"
   },
   "targets": {
    "description": "aas-json: AAS v3 JSON environment (IDTA 02035); aasx: AASX package; draft-json: the neutral PassportDraft; html: self-contained HTML passport sheet (DE and EN inside)",
    "items": {
     "enum": [
      "aas-json",
      "aasx",
      "draft-json",
      "html"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "draft",
   "targets"
  ],
  "type": "object"
 },
 "name": "emit_passport",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "draftId": {
    "type": "string"
   },
   "error": {
    "description": "Set when the call failed",
    "type": "string"
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bytes": {
       "description": "base64",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "size": {
       "type": "number"
      },
      "target": {
       "enum": [
        "aas-json",
        "aasx",
        "draft-json",
        "html"
       ],
       "type": "string"
      }
     },
     "required": [
      "target",
      "name",
      "size"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "findings": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "layer": {
       "enum": [
        "L1",
        "L2",
        "L3",
        "L4"
       ],
       "type": "string"
      },
      "message": {
       "additionalProperties": false,
       "properties": {
        "de": {
         "type": "string"
        },
        "en": {
         "type": "string"
        }
       },
       "required": [
        "de",
        "en"
       ],
       "type": "object"
      },
      "path": {
       "type": "string"
      },
      "ruleId": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning"
       ],
       "type": "string"
      }
     },
     "required": [
      "layer",
      "ruleId",
      "severity",
      "path",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "verdict": {
    "enum": [
     "valid",
     "valid_with_warnings",
     "invalid"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Emit the passport files"
}
