{
 "_meta": {
  "ui": {
   "resourceUri": "ui://rds/widget.html"
  },
  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a cleaned, encoded UTM-tagged URL from source, medium, campaign, term, and content, and flag common tagging errors. See the full version at https://rahuldsarker.co/calculators/utm-generator-and-validation-helper",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "baseUrl": {
    "description": "Base URL to tag, e.g. https://example.com/pricing",
    "type": "string"
   },
   "campaign": {
    "description": "utm_campaign, e.g. q3-demo-push",
    "type": "string"
   },
   "content": {
    "description": "utm_content (creative / A-B variant), optional",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "medium": {
    "description": "utm_medium, e.g. cpc, paid-social",
    "type": "string"
   },
   "source": {
    "description": "utm_source, e.g. google, linkedin",
    "type": "string"
   },
   "term": {
    "description": "utm_term (paid keyword), optional",
    "type": "string"
   }
  },
  "required": [
   "baseUrl",
   "source",
   "medium",
   "campaign"
  ],
  "type": "object"
 },
 "name": "utm_generator_and_validation_helper",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
         "enum": [
          "currency",
          "x",
          "%",
          "months"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "label",
      "value",
      "unit",
      "display"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "tool": {
    "description": "The calculator tool that produced this result",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "tool",
   "title",
   "calculator",
   "url",
   "bookingUrl",
   "currency",
   "compact",
   "inputs",
   "metrics",
   "notes",
   "benchmarks"
  ],
  "type": "object"
 },
 "title": "UTM Generator & Validation Helper"
}
