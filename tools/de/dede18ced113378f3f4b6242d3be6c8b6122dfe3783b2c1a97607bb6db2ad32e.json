{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Ingest content into a knowledge base. Supports deduplication via externalId and optional LLM processing (summarize, extract_facts, or custom instruction).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Content to ingest",
    "type": "string"
   },
   "externalId": {
    "description": "Unique external ID for deduplication (e.g. file path, URL)",
    "type": "string"
   },
   "folder": {
    "description": "Folder: 'general', 'skills', 'contexts', 'documents', or 'faqs' (default: general)",
    "type": "string"
   },
   "knowledgeBaseId": {
    "description": "Knowledge base ID to ingest into",
    "type": "string"
   },
   "processing": {
    "additionalProperties": false,
    "description": "Optional LLM processing before storage",
    "properties": {
     "instruction": {
      "description": "Custom instruction (only used with 'custom' mode)",
      "type": "string"
     },
     "mode": {
      "default": "raw",
      "description": "Processing mode",
      "enum": [
       "raw",
       "summarize",
       "extract_facts",
       "custom"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "source": {
    "default": "mcp",
    "description": "Source type (default: mcp)",
    "enum": [
     "api",
     "mcp"
    ],
    "type": "string"
   },
   "sourceUrl": {
    "description": "Source URL for reference",
    "type": "string"
   },
   "title": {
    "description": "Title for the knowledge entry",
    "type": "string"
   }
  },
  "required": [
   "knowledgeBaseId",
   "title",
   "content"
  ],
  "type": "object"
 },
 "name": "neuron_ingest_knowledge",
 "title": "Ingest Knowledge"
}
