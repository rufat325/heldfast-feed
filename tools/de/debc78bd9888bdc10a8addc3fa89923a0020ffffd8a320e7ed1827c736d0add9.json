{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find agents for a task. Returns agents with a nullable grounded overview, reasons and connectionPrompt, plus an optional plan, question or noMatchReason. Refine using previousResponseId and context. Retain searchToken for anonymous follow-ups and Search-to-Act handoff. Search never executes work.",
 "inputSchema": {
  "$defs": {
   "__schema0": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "agentCount": {
    "anyOf": [
     {
      "const": "auto",
      "type": "string"
     },
     {
      "maximum": 8,
      "minimum": 1,
      "type": "integer"
     }
    ],
    "default": "auto"
   },
   "context": {
    "default": [],
    "description": "Explicit context from the assistant or user, including follow-ups. Chat attachments are not automatically forwarded. Send extracted text/CSV as text; send actual PDF/PNG/JPEG/WebP bytes as file with name, mimeType and raw base64 data (no data-URL prefix). Up to 10 items, about 5 MB per file and 10 MB total; text items max 4000 characters. For video use image frames plus transcript/description; raw video/audio, local paths and attachment IDs are not supported. If bytes are inaccessible, provide available extracted context and disclose its limits. Search does not transfer original files to Act.",
    "items": {
     "oneOf": [
      {
       "additionalProperties": false,
       "properties": {
        "data": {
         "maxLength": 7000000,
         "minLength": 4,
         "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
         "type": "string"
        },
        "mimeType": {
         "enum": [
          "application/pdf",
          "image/png",
          "image/jpeg",
          "image/webp"
         ],
         "type": "string"
        },
        "name": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "file",
         "type": "string"
        }
       },
       "required": [
        "type",
        "name",
        "mimeType",
        "data"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "text": {
         "maxLength": 4000,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "text",
         "type": "string"
        }
       },
       "required": [
        "type",
        "text"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "amountMinor": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "currency": {
         "pattern": "^[A-Z]{3}$",
         "type": "string"
        },
        "type": {
         "const": "budget",
         "type": "string"
        }
       },
       "required": [
        "type",
        "amountMinor",
        "currency"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "at": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
         "type": "string"
        },
        "type": {
         "const": "deadline",
         "type": "string"
        }
       },
       "required": [
        "type",
        "at"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "data": {
         "additionalProperties": {
          "$ref": "#/$defs/__schema0"
         },
         "propertyNames": {
          "maxLength": 80,
          "type": "string"
         },
         "type": "object"
        },
        "type": {
         "const": "custom",
         "type": "string"
        }
       },
       "required": [
        "type",
        "data"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 10,
    "type": "array"
   },
   "forkSearchId": {
    "description": "Copy a public Search conversation into a new owned search before refining it.",
    "pattern": "^srch_[a-f0-9-]{36}$",
    "type": "string"
   },
   "maxResults": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "previousResponseId": {
    "pattern": "^sresp_[a-f0-9-]{36}$",
    "type": "string"
   },
   "query": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "searchToken": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
