{
 "description": "Update a TestChimp issue status by ordinal id (same flexible issueId formats as get-issue-details). status must be one of: ACTIVE, IGNORED, FIXED, DUPLICATE, IN_PROGRESS_BUG, ARCHIVED_BUG, BLOCKED. For /testchimp fix issue: set IN_PROGRESS_BUG after applying a code fix; set FIXED only after user confirmation / commits pushed. Optional ignoreReason when status is IGNORED: INTENDED_BEHAVIOUR | INACCURATE_ASSESSMENT | NOT_IMPORTANT. Optional agentTraceability records UPDATED Activity inline (requires both workflowId and workflowExecutionId for Activity attachment).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actorType": {
    "enum": [
     "LOCAL_AGENT",
     "CLOUD_AGENT",
     "local-agent",
     "cloud-agent"
    ],
    "type": "string"
   },
   "agentModel": {
    "type": "string"
   },
   "agentTraceability": {
    "additionalProperties": false,
    "properties": {
     "actorType": {
      "enum": [
       "LOCAL_AGENT",
       "CLOUD_AGENT",
       "local-agent",
       "cloud-agent"
      ],
      "type": "string"
     },
     "agentModel": {
      "type": "string"
     },
     "branchName": {
      "type": "string"
     },
     "cliVersion": {
      "type": "string"
     },
     "gitSha": {
      "type": "string"
     },
     "policyFile": {
      "type": "string"
     },
     "policyVersion": {
      "type": "string"
     },
     "skillVersion": {
      "type": "string"
     },
     "userId": {
      "type": "string"
     },
     "workflowExecutionId": {
      "type": "string"
     },
     "workflowId": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "branchName": {
    "type": "string"
   },
   "cliVersion": {
    "type": "string"
   },
   "gitSha": {
    "type": "string"
   },
   "ignoreReason": {
    "enum": [
     "INTENDED_BEHAVIOUR",
     "INACCURATE_ASSESSMENT",
     "NOT_IMPORTANT"
    ],
    "type": "string"
   },
   "issueId": {
    "minLength": 1,
    "type": "string"
   },
   "policyFile": {
    "type": "string"
   },
   "policyVersion": {
    "type": "string"
   },
   "skillVersion": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ACTIVE",
     "IGNORED",
     "FIXED",
     "DUPLICATE",
     "IN_PROGRESS_BUG",
     "ARCHIVED_BUG",
     "BLOCKED"
    ],
    "type": "string"
   },
   "userId": {
    "type": "string"
   },
   "workflowExecutionId": {
    "type": "string"
   },
   "workflowId": {
    "type": "string"
   }
  },
  "required": [
   "issueId",
   "status"
  ],
  "type": "object"
 },
 "name": "update-issue-status"
}
