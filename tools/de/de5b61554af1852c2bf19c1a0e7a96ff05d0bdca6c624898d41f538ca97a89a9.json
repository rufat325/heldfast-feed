{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Disease outbreak events indexed from the WHO Disease Outbreak News (facts and links; WHO's assessments live at the linked pages), each with Geotone's measured news attention: articles carrying the disease in GDELT's thematic tagging across all languages, trailing 14 days vs the prior 14. status 'active' means a WHO update within 90 days; outbreaks are never marked ended by feed disappearance. DON covers internationally significant events and is not exhaustive \u2014 absence here is not absence of disease.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max outbreaks (default 30)",
    "maximum": 120,
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "description": "Filter by status (default active)",
    "enum": [
     "active",
     "quiet",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_outbreaks",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "meta": {
    "properties": {
     "asOf": {
      "description": "Date of the latest datapoint (UTC)",
      "type": "string"
     },
     "attribution": {
      "type": "string"
     },
     "citation": {
      "type": "string"
     },
     "license": {
      "type": "string"
     },
     "page": {
      "description": "Canonical geotone.news page for this result \u2014 link it when citing",
      "type": "string"
     },
     "retrievedAt": {
      "type": "string"
     },
     "source": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "outbreaks": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "attention": {
       "properties": {
        "changePct": {
