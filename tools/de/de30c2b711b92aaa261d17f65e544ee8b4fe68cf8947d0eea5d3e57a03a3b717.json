{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Resolve partial emirate, area, developer or property-type text, such as \"marina\" or \"sobha\", into exact filter slugs for `search`. Does not search project names. Skip when the exact slug is known; use `list_project_facets` to enumerate all values.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum suggestions. Defaults to 5.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Partial developer, area, emirate, or property-type text.",
    "maxLength": 160,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "suggest_project_terms",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "query": {
    "type": "string"
   },
   "suggestions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "emirate": {
       "type": "string"
      },
      "filter": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "type": {
       "enum": [
        "emirate",
        "area",
        "developer",
        "propertyType"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "slug",
      "name",
      "filter"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "suggestions"
  ],
  "type": "object"
 },
 "title": "Suggest Projectory Search Terms"
}
