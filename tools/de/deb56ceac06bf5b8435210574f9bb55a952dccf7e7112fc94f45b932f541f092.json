{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp:use"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Attach up to 10 Studocu documents from search-documents to a project. Returns the sources that were successfully added; compare with document_ids if some were omitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document_ids": {
    "description": "One to ten unique Studocu document IDs returned by search-documents.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "project_id": {
    "description": "UUID of the Studocu project that will receive the document sources.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "document_ids"
  ],
  "type": "object"
 },
 "name": "add-document-sources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "document_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "source_id": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "status": {
       "const": "completed",
       "type": "string"
      },
      "title": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "source_id",
      "document_id",
      "title",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "project_id",
   "sources"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp:use"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add Studocu Document Sources"
}
