      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "filteredToQuery": {
    "type": "boolean"
   },
   "found": {
    "type": "boolean"
   },
   "highSuggests": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "howToTest": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "kind": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
