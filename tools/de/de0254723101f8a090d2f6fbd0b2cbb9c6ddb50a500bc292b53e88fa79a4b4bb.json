{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a host-created event. Use scope='future' to update all future instances of a recurring series.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attendees": {
    "description": "Updated attendee list",
    "items": {
     "additionalProperties": false,
     "properties": {
      "contactId": {
       "type": "string"
      },
      "email": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "endTime": {
    "description": "New end time (ISO 8601)",
    "type": "string"
   },
   "id": {
    "description": "Event (booking) UUID",
    "type": "string"
   },
   "locationType": {
    "description": "New location type",
    "enum": [
     "video",
     "phone",
     "in_person",
     "whatsapp",
     "custom"
    ],
    "type": "string"
   },
   "locationValue": {
    "description": "New location value",
    "type": "string"
   },
   "scope": {
    "description": "'single' (default) or 'future' to update all future instances",
    "enum": [
     "single",
     "future"
    ],
    "type": "string"
   },
   "startTime": {
    "description": "New start time (ISO 8601)",
    "type": "string"
   },
   "title": {
    "description": "New title",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "neuron_update_event",
 "title": "Update Calendar Event"
}
