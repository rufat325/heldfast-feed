{
 "description": "Register (or relabel/unarchive) one published course module as a reusable skill-gap module. The module must exist in the course\u2019s current PUBLISHED version; registration upserts idempotently and never edits course content. Requires lms:write and an idempotency key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "courseId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotencyKey": {
    "description": "Stable idempotency key. Reuse only for the identical operation.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "label": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "moduleKey": {
    "$ref": "#/properties/courseId"
   }
  },
  "required": [
   "courseId",
   "moduleKey",
   "label",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_retraining_register_module",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
