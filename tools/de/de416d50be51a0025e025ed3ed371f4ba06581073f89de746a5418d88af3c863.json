{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Resize a Datafence NAS volume (500-10000 GB, 100 GB steps).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fenceId": {
    "description": "Datafence number (see ncloud_datafence_get_datafence)",
    "type": "integer"
   },
   "instanceNo": {
    "description": "NAS instance number (see ncloud_datafence_list_fence_infra)",
    "type": "integer"
   },
   "volumeSize": {
    "description": "New NAS volume size in GB",
    "maximum": 10000,
    "minimum": 500,
    "type": "integer"
   }
  },
  "required": [
   "fenceId",
   "instanceNo",
   "volumeSize"
  ],
  "type": "object"
 },
 "name": "ncloud_datafence_change_fence_nas_volume"
}
