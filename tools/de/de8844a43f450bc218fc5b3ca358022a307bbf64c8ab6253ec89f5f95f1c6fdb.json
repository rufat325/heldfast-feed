{
 "description": "Get hot, new, or top posts from a subreddit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (1-100, default 25)",
    "type": "number"
   },
   "sort": {
    "description": "Sort order (default: hot)",
    "enum": [
     "hot",
     "new",
     "top",
     "rising"
    ],
    "type": "string"
   },
   "subreddit": {
    "description": "Subreddit name without r/ prefix",
    "type": "string"
   },
   "time": {
    "description": "Time filter for top posts",
    "enum": [
     "hour",
     "day",
     "week",
     "month",
     "year",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "subreddit"
  ],
  "type": "object"
 },
 "name": "reddit_get_posts"
}
