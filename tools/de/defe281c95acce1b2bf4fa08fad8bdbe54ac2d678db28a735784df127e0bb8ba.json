{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Replace complete test suite"
 },
 "description": "Replace the complete reviewed test suite for an existing project after field discovery. Requires 1 to 100 legacy cases, or up to 500 with contract_version: 1, and replaces prior tests without creating a project or changing its sources, fields, or guidance. This is destructive. The target API must advertise replacement support before any write. If the response is interrupted, inspect the project before approving another replacement.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": 1,
    "description": "Required when acceptance expectations or expected_review_bindings are supplied.",
    "type": "number"
   },
   "expected_review_bindings": {
    "additionalProperties": {
     "additionalProperties": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "type": "object"
    },
    "description": "Optional review-binding catalogue; omit for no assertion or use {} to assert zero bindings.",
    "type": "object"
   },
   "project_id": {
    "description": "Existing project ID whose complete test suite will be replaced",
    "type": "string"
   },
   "test_cases": {
    "description": "The complete authoritative reviewed suite (1-500 cases); this replaces existing tests",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expectations": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "pending_reviews": {
           "additionalProperties": false,
           "properties": {
            "resolution_fields": {
             "items": {
              "type": "string"
             },
             "maxItems": 500,
             "type": "array"
            },
            "unmapped_count": {
             "maximum": 500,
             "minimum": 0,
             "type": "integer"
            }
           },
           "required": [
            "unmapped_count"
           ],
           "type": "object"
          },
          "useful_unknown_fields": {
           "items": {
            "$ref": "#/properties/test_cases/items/properties/expectations/anyOf/0/properties/pending_reviews/properties/resolution_fields/items"
           },
           "maxItems": 500,
           "type": "array"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "expected_outcome": {
       "enum": [
        "eligible",
        "not_eligible",
        "undetermined"
       ],
       "type": "string"
      },
      "field_values": {
       "additionalProperties": {},
       "type": "object"
      },
      "name": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name",
      "field_values",
      "expected_outcome"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "project_id",
   "test_cases"
  ],
  "type": "object"
 },
 "name": "aethis_set_tests"
}
