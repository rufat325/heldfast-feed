{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Convert Lead"
 },
 "description": "Convert an account: qualify its open lead (creating one if needed) and link exactly one pipeline deal. Also promotes lifeStage lead -> active. Safe to repeat \u2014 a second call lands on the same lead and deal. Works on accounts that are already active.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "Lead account ID",
    "type": "string"
   },
   "createDeal": {
    "description": "Deprecated and ignored \u2014 a convert always links a deal",
    "type": "boolean"
   },
   "dealAmount": {
    "description": "Optional deal amount",
    "type": "number"
   },
   "dealClosingDate": {
    "description": "Optional deal close date",
    "type": "string"
   },
   "dealName": {
    "description": "Optional deal name",
    "type": "string"
   },
   "dealStage": {
    "description": "Optional initial deal stage (\"lead\" is an alias of \"discovery\")",
    "enum": [
     "discovery",
     "qualified",
     "proposal",
     "negotiation",
     "won",
     "lost",
     "lead",
     "new",
     "open"
    ],
    "type": "string"
   },
   "lifeStage": {
    "description": "Lifecycle after convert (default active)",
    "enum": [
     "active",
     "vip"
    ],
    "type": "string"
   }
  },
  "required": [
   "accountId"
  ],
  "type": "object"
 },
 "name": "convert_lead",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
