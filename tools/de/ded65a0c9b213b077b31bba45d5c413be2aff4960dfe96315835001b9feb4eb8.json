{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get job details"
 },
 "description": "Get one AI trainer job by its id (from search_jobs): pay, location, languages, level, hours, what the work is, the requirements, and the company's own description.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The job id from search_jobs, 8 hex characters.",
    "pattern": "^[0-9a-f]{8}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_job",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "apply_url": {
    "description": "Opens the company's application page.",
    "type": [
     "string",
     "null"
    ]
   },
   "category": {
    "enum": [
     "coding",
     "stem",
     "medical",
     "legal",
     "finance",
     "languages",
     "voice-video",
     "creative",
     "generalist",
     "robotics"
    ],
    "type": "string"
   },
   "commitment": {
    "type": [
     "string",
     "null"
    ]
   },
   "company": {
    "type": "string"
   },
   "description": {
    "description": "The company's own job description, as plain text. Long descriptions are shortened.",
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "level": {
    "anyOf": [
     {
      "enum": [
       "entry",
       "experienced",
       "expert"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "location": {
    "additionalProperties": false,
    "properties": {
     "countries": {
      "description": "ISO 3166-1 alpha-2 codes. Empty: open worldwide.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "label": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "label",
     "countries"
    ],
    "type": "object"
   },
   "pay": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "type": [
       "string",
       "null"
      ]
     },
     "label": {
      "description": "Human-readable pay, for example $35\u201345/hr.",
      "type": [
       "string",
       "null"
      ]
     },
     "max": {
      "type": [
       "number",
       "null"
      ]
     },
     "min": {
      "type": [
       "number",
       "null"
      ]
     },
     "period": {
      "anyOf": [
       {
        "enum": [
         "hour",
         "task",
         "once"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "hour: hourly rate. task: paid per task. once: one payment."
     }
    },
    "required": [
     "min",
     "max",
     "currency",
     "period",
     "label"
    ],
    "type": "object"
   },
   "posted_at": {
    "type": "string"
   },
   "requirements": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "responsibilities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "skills": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "open",
     "closed"
    ],
    "type": "string"
   },
   "summary": {
    "type": [
     "string",
     "null"
    ]
   },
   "title": {
    "type": "string"
   },
   "url": {
    "description": "The job page on aitrainerjobs.co.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "company",
   "category",
   "pay",
   "location",
   "languages",
   "level",
   "commitment",
   "skills",
   "summary",
   "posted_at",
   "url",
   "apply_url",
   "status",
   "responsibilities",
   "requirements",
   "description"
  ],
  "type": "object"
 },
 "title": "Get job details"
}
