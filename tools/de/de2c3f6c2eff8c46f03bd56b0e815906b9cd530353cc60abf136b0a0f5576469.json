  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks about mpg, electric range or fuel cost for a car, such as \"what mpg does a 2022 Toyota RAV4 hybrid get?\". Pass the year, make and model, and optionally words such as AWD or hybrid to narrow it. Returns the EPA's city, highway and combined mpg (mpge for electric vehicles) for each configuration, with electric range, tailpipe CO2 and estimated annual fuel cost, and lists the configurations not shown. EPA estimates, not a promise of real-world mileage.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "make": {
    "description": "Manufacturer, such as \"Honda\"",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "description": "Model name without trim, such as \"CR-V\"",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "option": {
    "description": "Optional words to narrow the configuration, such as \"AWD\", \"hybrid\" or \"2.0 L\"",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Model year, such as 2018",
    "maximum": 2100,
    "minimum": 1950,
    "type": "integer"
   }
  },
  "required": [
   "year",
   "make",
   "model"
  ],
  "type": "object"
 },
 "name": "get_fuel_economy",
