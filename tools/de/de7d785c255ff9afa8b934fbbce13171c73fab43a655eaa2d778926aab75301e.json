{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Latest whale moves"
 },
 "description": "The most recent large moves by tracked Ethereum whale wallets (up to 15), at or above a minimum size (default $100K), optionally filtered to one token. Each move is labelled as an exchange withdrawal, exchange deposit or DEX swap.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "maximum": 15,
    "minimum": 1,
    "type": "integer"
   },
   "min_usd": {
    "default": 100000,
    "description": "Smallest move to include, in USD (default 100000)",
    "minimum": 0,
    "type": "number"
   },
   "symbol": {
    "description": "Optional token symbol filter",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_recent_whale_moves",
 "outputSchema": {
  "properties": {
   "disclaimer": {
    "type": "string"
   },
   "feed_url": {
    "type": "string"
   },
   "min_usd": {
    "type": [
     "number",
     "null"
    ]
   },
   "moves": {
    "items": {
     "properties": {
      "move_type": {
       "enum": [
        "exchange_withdrawal",
        "exchange_deposit",
        "dex_swap_in",
        "dex_swap_out",
        "other"
       ],
       "type": "string"
      },
      "symbol": {
       "type": [
        "string",
        "null"
       ]
      },
      "time_utc": {
       "type": "string"
      },
      "usd_value": {
       "type": [
        "number",
        "null"
       ]
      },
      "wallet": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "time_utc",
      "symbol",
      "usd_value",
      "move_type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   },
   "symbol": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "moves",
   "source",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Latest whale moves"
}
