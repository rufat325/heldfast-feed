{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a deadline monitor for a job, device or agent that should keep checking in. Call ping_heartbeat before the expected interval plus grace period ends. One missed deadline calls a public HTTP or HTTPS webhook or wakes an active Agent Wake webhook task. The monitor lasts at most 24 hours from creation, and pings cannot extend that limit. The returned heartbeat ID and URLs are bearer secrets. No authentication is required.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "expect_every_seconds": {
    "description": "Expected time between check-ins, from 60 seconds to 24 hours.",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "grace_seconds": {
    "description": "Extra time after the expected check-in before the miss action fires. The expected interval plus grace must not exceed 86400 seconds.",
    "maximum": 86400,
    "minimum": 0,
    "type": "integer"
   },
   "on_miss": {
    "description": "Exactly one miss target. Use url for a public HTTP or HTTPS webhook on port 80 or 443, or wake_task_id for an active Agent Wake webhook task.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "payload": {
        "description": "Optional JSON body, at most 32768 encoded bytes."
       },
       "url": {
        "format": "uri",
        "maxLength": 2048,
        "type": "string"
       }
      },
      "required": [
       "url"
      ]
     },
     {
      "additionalProperties": false,
      "properties": {
       "wake_task_id": {
        "format": "uuid",
        "type": "string"
       }
      },
      "required": [
       "wake_task_id"
      ]
     }
    ],
    "type": "object"
   }
  },
  "required": [
   "expect_every_seconds",
   "grace_seconds",
   "on_miss"
  ],
  "type": "object"
 },
 "name": "create_heartbeat",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "created_at_datetime": {
    "type": "string"
   },
   "created_at_timestamp": {
    "type": "integer"
   },
   "delivery": {
    "type": "object"
   },
   "expect_every_seconds": {
    "type": "integer"
   },
   "expires_at_datetime": {
    "type": "string"
   },
   "expires_at_timestamp": {
    "type": "integer"
   },
   "grace_seconds": {
    "type": "integer"
   },
   "heartbeat_id": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "last_ping_at_datetime": {
    "type": "string"
   },
   "last_ping_at_timestamp": {
    "type": "integer"
   },
   "late": {
    "type": "boolean"
   },
   "miss_due_at_datetime": {
    "type": "string"
   },
   "miss_due_at_timestamp": {
    "type": "integer"
   },
   "missed_at_datetime": {
    "type": "string"
   },
   "missed_at_timestamp": {
    "type": "integer"
   },
   "misses": {
    "type": "integer"
   },
   "next_expected_at_datetime": {
    "type": "string"
   },
   "next_expected_at_timestamp": {
    "type": "integer"
   },
   "ok": {
    "type": "boolean"
   },
   "on_miss": {
    "additionalProperties": false,
    "properties": {
     "type": {
      "enum": [
       "webhook",
       "agent_wake"
      ],
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "ping_count": {
    "type": "integer"
   },
   "ping_url": {
    "format": "uri",
    "type": "string"
   },
   "status": {
    "enum": [
     "armed",
     "missed",
     "fired",
     "expired"
    ],
    "type": "string"
   },
   "status_url": {
    "format": "uri",
    "type": "string"
   },
   "terminal_at_datetime": {
    "type": "string"
   },
   "terminal_at_timestamp": {
    "type": "integer"
   }
  },
  "required": [
   "ok",
   "heartbeat_id",
   "status",
   "expect_every_seconds",
   "grace_seconds",
   "created_at_timestamp",
   "created_at_datetime",
   "expires_at_timestamp",
   "expires_at_datetime",
   "last_ping_at_timestamp",
   "last_ping_at_datetime",
   "next_expected_at_timestamp",
   "next_expected_at_datetime",
   "miss_due_at_timestamp",
   "miss_due_at_datetime",
   "ping_count",
   "misses",
   "late",
   "on_miss",
   "ping_url",
   "status_url"
  ],
  "type": "object"
 },
 "title": "Create heartbeat"
}
