    "minimum": 0,
    "type": "number"
   },
   "df2": {
    "default": 20,
    "description": "Denominator df (df\u2082)",
    "maximum": 10000000,
    "minimum": 0,
    "type": "number"
   },
   "dist": {
    "default": "z",
