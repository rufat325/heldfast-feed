{
 "description": "Import an ERC-8004 Identity Registry record (chain_id + ERC-721\n    token_id + agentURI + owner). Idempotent: re-import updates in place.\n    Returns the canonical record with its deterministic bridge DID\n    (did:viridis:erc8004:<chain>:<token>).",
 "inputSchema": {
  "properties": {
   "agent_uri": {
    "title": "Agent Uri",
    "type": "string"
   },
   "chain_id": {
    "title": "Chain Id",
    "type": "integer"
   },
   "metadata": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Metadata"
   },
   "owner": {
    "title": "Owner",
    "type": "string"
   },
   "token_id": {
    "title": "Token Id",
    "type": "integer"
   }
  },
  "required": [
   "chain_id",
   "token_id",
   "agent_uri",
   "owner"
  ],
  "title": "import_registrationArguments",
  "type": "object"
 },
 "name": "import_registration",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "import_registrationOutput",
  "type": "object"
 }
}
