{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Data Flow trigger for scheduled or event-based job execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Trigger description",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview without creating",
    "type": "boolean"
   },
   "enabled": {
    "description": "Whether the trigger is enabled (default: true)",
    "type": "boolean"
   },
   "jobId": {
    "description": "Job ID to associate with this trigger",
    "type": "string"
   },
   "name": {
    "description": "Trigger name",
    "type": "string"
   },
   "schedule": {
    "description": "Cron expression for scheduled triggers (e.g. '0 0 * * *')",
    "type": "string"
   },
   "type": {
    "description": "Trigger type (e.g. CRON, EVENT)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "jobId"
  ],
  "type": "object"
 },
 "name": "ncloud_dataflow_create_trigger"
}
