{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Domain Trust report (both scores)"
 },
 "description": "Both scores, the open fixes ranked by severity, and a saved report link (report_url) that opens the same findings without a rescan; share it as-is. Use this first for \"is my domain set up right?\" questions.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://astraverify.com/logo512-v2.png"
  },
  {
   "mimeType": "image/png",
   "sizes": [
    "64x64"
   ],
   "src": "https://astraverify.com/favicon-64.png"
  }
 ],
 "inputSchema": {
  "properties": {
   "domain": {
    "description": "The domain to check, as the person gave it (no scheme, no path). Reserved names such as example.com are refused.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "refresh": {
    "default": false,
    "description": "Force a fresh scan instead of the cached result (rate limited)",
    "type": "boolean"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "get_report",
 "outputSchema": {
  "properties": {
   "discoverability": {
    "properties": {
     "cache_age_seconds": {
      "description": "Age of the result; 0 means it was scanned just now",
      "type": "integer"
     },
     "canonical_host": {
      "type": [
       "string",
       "null"
      ]
     },
     "capped": {
      "type": "boolean"
     },
     "cdn": {
      "type": [
       "string",
       "null"
      ]
     },
     "components": {
      "items": {
       "description": "One scored area of the domain",
       "properties": {
        "enabled": {
         "type": "boolean"
        },
        "key": {
         "type": "string"
        },
        "max": {
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "points": {
         "type": "integer"
        },
        "summary": {
         "type": "string"
        }
       },
       "required": [
        "key",
        "name",
        "points",
        "max"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "domain": {
      "type": "string"
     },
     "grade": {
      "description": "A+ to F, or null alongside a null score",
      "type": [
       "string",
       "null"
      ]
     },
     "held_back": {
      "description": "Points the cap holds back while a fix is open (89 cap) or a critical one is (69). Not taken from any component: sum(components.points) - held_back = score",
      "type": "integer"
     },
     "inconclusive": {
      "description": "The site could not be fetched, so the scan could not be completed. A failure to measure, not a finding about the site.",
      "type": "boolean"
     },
     "not_applicable": {
      "description": "The domain publishes no web address, so there is no website to assess. Not a low score: score and grade are null and there are no recommendations. verdict names the domain to scan instead.",
      "type": "boolean"
     },
     "not_checked": {
      "description": "Parts skipped in this scan",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "open_fixes": {
      "description": "Findings above info level",
      "type": "integer"
     },
     "raw": {
      "description": "What the components add up to, before the cap",
      "type": "integer"
     },
     "reason": {
      "description": "Why score is null, when it is",
      "type": [
       "string",
       "null"
      ]
     },
     "recommendations": {
      "items": {
       "properties": {
        "component": {
         "type": "string"
        },
        "fix": {
         "description": "The exact change to publish: a DNS record (name, type, value) or a file or tag (kind, label, value, where). Null when there is nothing to publish, for example \"turn on DKIM in your provider\".",
         "properties": {
          "kind": {
           "type": [
            "string",
            "null"
           ]
          },
          "label": {
           "type": [
            "string",
            "null"
           ]
          },
          "name": {
           "type": [
            "string",
            "null"
           ]
          },
          "note": {
           "type": [
            "string",
            "null"
           ]
          },
          "type": {
           "type": [
            "string",
            "null"
           ]
          },
          "value": {
           "type": [
            "string",
            "null"
           ]
          },
          "where": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "type": [
          "object",
          "null"
         ]
        },
        "id": {
         "type": "string"
        },
        "scan": {
         "enum": [
          "email",
          "discoverability"
         ],
         "type": "string"
        },
        "severity": {
         "enum": [
          "critical",
          "important",
          "info"
         ],
         "type": "string"
        },
        "tags": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "title": {
         "type": "string"
        },
        "why": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "severity",
        "title"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "report_url": {
      "description": "The report page for this domain on astraverify.com",
      "type": "string"
     },
     "request_id": {
      "description": "req_... for this call. Quote it when reporting a problem with the result.",
      "type": "string"
     },
     "score": {
      "description": "Out of 100, exactly as astraverify.com shows it. Null when not_applicable or inconclusive is set.",
      "type": [
       "integer",
       "null"
      ]
     },
     "verdict": {
      "description": "One sentence on what engines can do with the site",
      "type": "string"
     },
     "verified_component": {
      "description": "Set by verify_fix: the component re-checked",
      "type": "string"
     }
