{
 "description": "Full pre-trade gate. Runs token risk, slippage, price validation, and position limits in parallel and returns a composite PASS/FLAG/BLOCK with the check that blocked it. One call replaces the individual finance checks.",
 "inputSchema": {
  "properties": {
   "assetType": {
    "description": "Asset type.",
    "enum": [
     "crypto",
     "stock"
    ],
    "type": "string"
   },
   "chain": {
    "description": "Chain for crypto (default: solana).",
    "type": "string"
   },
   "leverage": {
    "description": "Leverage multiplier (default: 1).",
    "type": "number"
   },
   "portfolioValueUsd": {
    "description": "Portfolio value (enables position-limit check).",
    "type": "number"
   },
   "side": {
    "description": "Trade side.",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Asset symbol (stocks or crypto).",
    "type": "string"
   },
   "tokenAddress": {
    "description": "Token address (enables rug + slippage checks).",
    "type": "string"
   },
   "tradeUsd": {
    "description": "Trade size in USD.",
    "type": "number"
   }
  },
  "required": [
   "assetType",
   "side",
   "tradeUsd"
  ],
  "type": "object"
 },
 "name": "finance_order_risk"
}
