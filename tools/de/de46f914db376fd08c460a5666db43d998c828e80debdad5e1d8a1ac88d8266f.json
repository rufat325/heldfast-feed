{
 "description": "Add multiple nodes in a single call. Each node accepts the same fields as map_add_node plus all type-specific fields (ports, dockerServices, domains, parentServer, etc.). Returns array of created ids.",
 "inputSchema": {
  "properties": {
   "nodes": {
    "description": "Array of node objects",
    "items": {
     "properties": {
      "cicdUrl": {
       "type": "string"
      },
      "dashboardUrl": {
       "type": "string"
      },
      "deployPath": {
       "type": "string"
      },
      "dockerServices": {
       "type": "array"
      },
      "domains": {
       "type": "array"
      },
      "ip": {
       "type": "string"
      },
      "ips": {
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "notes": {
       "type": "string"
      },
      "parentServer": {
       "type": "string"
      },
      "ports": {
       "type": "array"
      },
      "provider": {
       "type": "string"
      },
      "registrarUrl": {
       "type": "string"
      },
      "repoUrl": {
       "type": "string"
      },
      "serviceConns": {
       "type": "array"
      },
      "type": {
       "enum": [
        "server",
        "router",
        "switch",
        "firewall",
        "domain",
        "project",
        "service",
        "pc",
        "nas",
        "ap",
        "camera",
        "printer",
        "other"
       ],
       "type": "string"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "type",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "nodes"
  ],
  "type": "object"
 },
 "name": "map_bulk_add_nodes"
}
