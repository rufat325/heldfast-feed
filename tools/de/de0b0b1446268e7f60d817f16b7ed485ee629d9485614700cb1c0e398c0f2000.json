{
 "description": "FREE preflight for a film breakdown payload (film_manifest + shots + scenes + relations). Checks the contract WITHOUT watching anything: schema shape, closed vocabularies (exact\u2192alias\u2192reject), cross-references (shot ids, scene membership, relation endpoints), window topology (a long take's windows must be complete), provenance shape, and observability metadata only \u2014 it never judges whether an observation is TRUE (the server cannot see your video). Lossless representation fixes (alias/trim/wrap) are returned as normalized_patch; semantic problems are errors for YOU to fix, with retry_feedback to feed back to your model. This is advisory: compile_film_breakdown re-validates authoritatively. \u514d\u8d39\u9884\u68c0\uff1a\u5951\u7ea6/\u8bcd\u8868/\u4ea4\u53c9\u5f15\u7528/\u7a97\u53e3\u62d3\u6251\u6821\u9a8c\uff0c\u53ea\u4fee\u8868\u793a\u5c42\u3001\u7edd\u4e0d\u4ee3\u6539\u8bed\u4e49\uff1b\u7f16\u8bd1\u524d\u5148\u8dd1\u5b83\u53ef\u7701\u4e00\u6b21\u5931\u8d25\u5f80\u8fd4\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "film_manifest": {
    "additionalProperties": false,
    "properties": {
     "cut_timestamps": {
      "items": {
       "type": "number"
      },
      "maxItems": 4000,
      "type": "array"
     },
     "duration_sec": {
      "exclusiveMinimum": 0,
      "maximum": 28800,
      "type": "number"
     },
     "media_id": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     }
    },
    "required": [
     "media_id",
     "duration_sec",
     "cut_timestamps"
    ],
    "type": "object"
   },
   "relations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "details": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "from_shot_id": {
       "maxLength": 32,
       "minLength": 1,
       "type": "string"
      },
      "relation_type": {
       "maxLength": 32,
       "type": "string"
      },
      "to_shot_id": {
       "maxLength": 32,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "from_shot_id",
      "to_shot_id"
     ],
     "type": "object"
    },
    "maxItems": 2400,
    "type": "array"
   },
   "scenes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "camera_performance_arc": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "director_intent": {
       "maxLength": 2000,
       "type": "string"
      },
      "editing_arc": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "entity_provenance": {
       "additionalProperties": false,
       "properties": {
        "confidence": {
         "enum": [
          "low",
          "medium",
          "high"
         ],
         "type": "string"
        },
        "model": {
         "maxLength": 64,
         "type": "string"
        },
        "run_id": {
         "maxLength": 64,
         "type": "string"
        },
        "source_stage": {
         "maxLength": 64,
         "type": "string"
        }
       },
       "type": "object"
      },
      "performance_arc": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "scene_key": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "summary": {
       "maxLength": 2000,
       "type": "string"
      },
      "title": {
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "scene_key"
     ],
     "type": "object"
    },
    "maxItems": 400,
    "type": "array"
   },
   "shots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "audio_observation": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "dramatic_layer": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "end_sec": {
       "type": "number"
      },
      "entity_provenance": {
       "additionalProperties": false,
       "properties": {
        "confidence": {
         "enum": [
          "low",
          "medium",
          "high"
         ],
         "type": "string"
        },
        "model": {
         "maxLength": 64,
         "type": "string"
        },
        "run_id": {
         "maxLength": 64,
         "type": "string"
        },
        "source_stage": {
         "maxLength": 64,
         "type": "string"
        }
       },
       "type": "object"
      },
      "objective_layer": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "performance_layer": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "prompt_reverse_fields": {},
      "scene_boundary_before": {
       "type": "boolean"
      },
      "scene_grammar": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "scene_key": {
       "maxLength": 64,
       "type": "string"
      },
      "shot_id": {
       "maxLength": 32,
       "minLength": 1,
       "type": "string"
      },
      "spatial_layer": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "start_sec": {
       "type": "number"
      },
      "tags": {},
      "temporal_layer": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "transfer_profile": {}
     },
     "required": [
      "shot_id",
      "start_sec",
      "end_sec"
     ],
     "type": "object"
    },
    "maxItems": 2400,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "film_manifest",
   "shots",
   "scenes",
   "relations"
  ],
  "type": "object"
 },
 "name": "validate_film_breakdown"
}
