{
 "description": "Run a candidate profile against a URL and grade the result with the oracle. ok=true only when a stream was captured AND the oracle confirms it is real media. Iterate on the profile until this passes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "profile": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "description": "Stable id; defaults to the URL hostname.",
      "type": "string"
     },
     "match": {
      "description": "URL regex patterns; defaults to the hostname.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "pick": {
      "additionalProperties": {},
      "description": "variant/order/audioLanguage/languageMap/audioLanguageFallbacks.",
      "type": "object"
     },
     "sniff": {
      "additionalProperties": {},
      "description": "kinds/urlPattern/urlExclude/replayHeaders.",
      "type": "object"
     },
     "steps": {
      "description": "Ordered page actions (goto/dismissOverlays/play/click/waitFor/scroll/eval).",
      "type": "array"
     }
    },
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "profile"
  ],
  "type": "object"
 },
 "name": "zahori_test_profile",
 "title": "Test a candidate profile"
}
