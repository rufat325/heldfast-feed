{
 "description": "Cancel one LMS assignment by closing its canonical Project To-do envelope. This revokes worker course access while preserving immutable course, progress, and audit history. Requires a reason, confirmCancel=true, and a unique operationKey.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "confirmCancel": {
    "const": true,
    "type": "boolean"
   },
   "jobId": {
    "$ref": "#/properties/assignmentId"
   },
   "operationKey": {
    "description": "Required request idempotency key. Reuse it only for the identical operation.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "jobId",
   "reason",
   "confirmCancel",
   "operationKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_cancel_assignment",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
