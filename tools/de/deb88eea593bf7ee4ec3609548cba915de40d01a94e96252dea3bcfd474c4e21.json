{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare page count and normalized native text between two separately authorized uploaded PDFs. Image-only and visual differences are not compared.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "left_capability": {
    "description": "Capability for the earlier PDF.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "left_document_id": {
    "description": "UUID of the earlier PDF.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "right_capability": {
    "description": "Capability for the later PDF.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "right_document_id": {
    "description": "UUID of the later PDF.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "left_document_id",
   "left_capability",
   "right_document_id",
   "right_capability"
  ],
  "type": "object"
 },
 "name": "compare_pdfs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Page-by-page normalized native-text comparison result.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "changedPageCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "changedPages": {
    "items": {},
    "type": "array"
   },
   "error": {},
   "extensions": {},
   "identicalBytes": {
    "type": "boolean"
   },
   "identicalExtractedPageText": {
    "type": "boolean"
   },
   "left": {},
   "method": {
    "type": "string"
   },
   "resource": {},
   "right": {},
   "truncated": {
    "type": "boolean"
   },
   "warning": {
    "type": "string"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Compare PDFs"
}
