{
 "description": "Attribute a Git commit's files to the current session (who actually produced the code). Reads Git; never rewrites history. Optionally writes an additive git note.",
 "inputSchema": {
  "properties": {
   "actorType": {
    "default": "ai",
    "enum": [
     "human",
     "ai"
    ],
    "type": "string"
   },
   "agent": {
    "description": "acting agent identity (defaults to OCTOBOARD_AGENT)",
    "type": "string"
   },
   "name": {
    "description": "explicit actor name",
    "type": "string"
   },
   "rev": {
    "description": "commit/revision, defaults to HEAD",
    "type": "string"
   },
   "writeNote": {
    "default": false,
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "board_link"
}
