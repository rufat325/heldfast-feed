{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a RUM retention filter's name, event type, sample rate, or query",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "RUM application ID",
    "type": "string"
   },
   "enabled": {
    "description": "Whether the filter is enabled",
    "type": "boolean"
   },
   "eventType": {
    "description": "Updated RUM event type",
    "enum": [
     "session",
     "view",
     "action",
     "error",
     "resource",
     "long_task",
     "vital"
    ],
    "type": "string"
   },
   "filterId": {
    "description": "Retention filter ID (UUID) to update",
    "type": "string"
   },
   "name": {
    "description": "New name for the retention filter",
    "type": "string"
   },
   "query": {
    "description": "Updated RUM search query",
    "type": "string"
   },
   "sampleRate": {
    "description": "Updated sample rate between 0 and 100",
    "type": "number"
   }
  },
  "required": [
   "appId",
   "filterId"
  ],
  "type": "object"
 },
 "name": "update-rum-retention-filter"
}
