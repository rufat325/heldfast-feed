             "const": "sha256",
             "type": "string"
            },
            "checker": {
             "const": "hash_matches",
             "type": "string"
            },
            "expected": {
             "pattern": "^[a-fA-F0-9]{64}$",
             "type": "string"
            }
           },
           "required": [
            "checker",
            "algorithm",
            "expected"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "deadline_met",
             "type": "string"
            },
            "due_at": {
             "format": "date-time",
             "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
             "type": "string"
            }
           },
           "required": [
            "checker",
            "due_at"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "claim_cited",
             "type": "string"
            },
            "claim": {
             "maxLength": 2000,
             "minLength": 1,
             "type": "string"
            },
            "evidence_ref": {
             "format": "starts_with",
             "pattern": "^evd_.*",
             "type": "string"
            }
           },
           "required": [
            "checker",
            "claim"
           ],
           "type": "object"
          }
         ]
        }
       },
       "required": [
        "description",
        "deterministic_check"
