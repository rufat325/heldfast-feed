        "description": {
         "maxLength": 2000,
         "minLength": 1,
         "type": "string"
        },
        "deterministic_check": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "row_count",
             "type": "string"
            },
            "expected": {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            }
           },
           "required": [
            "checker",
            "expected"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "completeness",
             "type": "string"
            },
            "required_fields": {
             "items": {
              "minLength": 1,
              "type": "string"
             },
             "minItems": 1,
             "type": "array"
            }
           },
           "required": [
            "checker",
            "required_fields"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "duplicate_rate",
             "type": "string"
            },
            "key": {
             "minLength": 1,
             "type": "string"
            },
            "maximum": {
             "maximum": 1,
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "checker",
            "key",
            "maximum"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "url_format",
             "type": "string"
            },
            "field": {
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "checker",
            "field"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "json_path",
             "type": "string"
            },
            "expected": {
             "type": [
              "string",
              "number",
              "boolean"
             ]
            },
            "operator": {
             "enum": [
              "eq",
              "gte",
              "lte",
              "contains"
             ],
             "type": "string"
            },
            "path": {
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "checker",
            "path",
            "expected",
            "operator"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "checker": {
             "const": "http_status",
             "type": "string"
            },
            "expected_status": {
             "maximum": 599,
             "minimum": 100,
             "type": "integer"
            },
            "timeout_ms": {
             "exclusiveMinimum": 0,
             "maximum": 5000,
             "type": "integer"
            },
            "url": {
             "format": "uri",
             "type": "string"
            }
           },
           "required": [
            "checker",
            "url",
            "expected_status"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "case_sensitive": {
             "type": "boolean"
            },
            "checker": {
             "const": "text_contains",
             "type": "string"
            },
            "field": {
             "minLength": 1,
             "type": "string"
            },
            "needle": {
