{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "files:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List metadata keys"
 },
 "description": "List metadata keys in the workspace (with counts). Pass `key` to list that key's values instead. Use before `find_files`. Same as `uploads meta keys`.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "When set, return distinct values for this metadata key (with counts) instead of the key list.",
    "type": "string"
   },
   "workspace": {
    "description": "Override the workspace for this call (like the CLI's --workspace flag).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_metadata_keys",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "key": {
    "type": "string"
   },
   "keys": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "distinctValues": {
       "type": "number"
      },
      "key": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "count",
      "distinctValues"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   },
   "values": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "value",
      "count"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "List metadata keys"
}
