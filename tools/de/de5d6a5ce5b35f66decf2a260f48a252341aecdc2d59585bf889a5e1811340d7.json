    "type": "string"
   },
   "remove_unavailable": {
    "description": "true to remove every item that is no longer available (the stale items suppco_get_my_cart lists).",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "suppco_remove_from_cart",
