 "description": "Latest validated ledger index, hash and close time. When to use: To anchor other readings to a ledger or to check how current the network view is. Prefer another tool: Not for transaction data or account state; use the account endpoint for those. Example: xrpl_latest_ledger {}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {},
  "type": "object"
 },
 "name": "xrpl_latest_ledger",
 "outputSchema": {
  "$defs": {
   "Meta": {
    "additionalProperties": false,
    "properties": {
     "age_seconds": {
      "description": "Age of the data at response time",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "as_of": {
      "description": "When the data was read from the ledger",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     "cache": {
      "enum": [
       "hit",
       "miss",
       "stale"
      ],
      "type": "string"
     },
     "ledger_index": {
      "description": "Validated ledger the data comes from",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "stale": {
      "description": "True when served past its fresh TTL (stale-on-error)",
      "type": "boolean"
     }
    },
    "required": [
     "ledger_index",
     "as_of",
     "age_seconds",
     "cache",
     "stale"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "close_time": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "ledger_hash": {
    "type": [
     "string",
     "null"
    ]
   },
   "ledger_index": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "meta": {
    "$ref": "#/$defs/Meta"
   }
  },
  "required": [
   "ledger_index",
   "close_time",
   "ledger_hash",
   "meta"
  ],
  "type": "object"
 },
 "title": "Latest ledger"
}
