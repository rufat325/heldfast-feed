{
 "description": "Upload a local file into the GripForge Library locker (character, weapon, prop, texture, HUD, or bind).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "kind": {
    "description": "Locker kind",
    "enum": [
     "character",
     "fps-arms",
     "enemy",
     "weapon",
     "prop",
     "texture",
     "skybox",
     "loading",
     "hud",
     "button",
     "bind",
     "vfx",
     "animation",
     "audio"
    ],
    "type": "string"
   },
   "name": {
    "description": "Display name (defaults to the filename stem)",
    "type": "string"
   },
   "path": {
    "description": "Absolute path of the file to upload",
    "type": "string"
   }
  },
  "required": [
   "path",
   "kind"
  ],
  "type": "object"
 },
 "name": "gripforge_library_push"
}
