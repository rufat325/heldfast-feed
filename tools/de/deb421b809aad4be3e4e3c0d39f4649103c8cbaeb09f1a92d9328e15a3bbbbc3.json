 "description": "What was added to, removed from or modified in the Japan MOF asset-freeze list since a date? From this service's own record of list versions (MOF publishes only the current list). Each change has the entry id, names, program, before/after fields and the versions compared. History starts at tracking_since; nothing earlier was observed. Free window: last 30 days (an earlier since is clamped; see history_window). Reference relay only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "change_type": {
    "description": "Optional filter: added, removed or modified",
    "enum": [
     "added",
     "removed",
     "modified"
    ],
    "type": "string"
   },
   "entry_id": {
    "description": "Optional filter: MOF list number, e.g. 029-000001",
    "maxLength": 20,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of changes, 1-200 (default 100)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "ISO 8601 date or date-time with time zone, e.g. 2026-10-01 or 2026-10-01T00:00:00Z",
    "maxLength": 40,
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
 "name": "sanctions_list_changes",
