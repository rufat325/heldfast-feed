{
 "description": "Request disclosure of a claim. Auto-substitutes if denied.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "claim_id": {
    "type": "string"
   },
   "mode": {
    "default": "REVEAL_MIN",
    "enum": [
     "PROOF_ONLY",
     "REVEAL_MIN",
     "REVEAL_FULL"
    ],
    "type": "string"
   },
   "requester_id": {
    "default": "anonymous",
    "type": "string"
   }
  },
  "required": [
   "claim_id"
  ],
  "type": "object"
 },
 "name": "request_claim"
}
