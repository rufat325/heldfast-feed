  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Game facts"
 },
 "description": "Public facts about one Steam game: year, developers, genres, top tags, price, Steam Deck status, review numbers, a review-mined summary and links. For a few single-player games, `coop_via_mod` names a reviewed fan mod for co-op, with caveats. Use it to answer questions about a game the user names; for similar games use games_like or recommend. Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "game": {
    "description": "Game name (typos and Russian names are fine), Steam appid or Steam store URL.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Language of the `why` lines.",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   }
  },
  "required": [
   "game"
  ],
  "type": "object"
 },
