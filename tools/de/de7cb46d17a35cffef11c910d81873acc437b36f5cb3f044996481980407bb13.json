{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a catalog product. Defaults to draft status \u2014 publish it by sending status 'active' once it is complete. Use list_categories, list_brands and list_warehouses for the ids; SKU is generated when omitted and must be unique in the workspace. Set trackInventory with an opening stock to start counting units, which is recorded as the first movement in the product stock history. A bundle (type bundle with bundleItems) holds no stock of its own: its stock, tracking and cost are derived from its components, so a stock sent for it is refused and trackInventory/costPrice are ignored. If the target warehouse is set to list new products on the marketplaces, this product joins those channels. When productGroupId names an existing product model, the product joins that model as a new article and takes the model's shared content (name, description, category, brand, characteristics, translations) instead of the values sent. Enforces the workspace plan limit; the result echoes the operating workspace.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "ageGroup": {
    "anyOf": [
     {
      "enum": [
       "newborn",
       "infant",
       "toddler",
       "kids",
       "adult"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "brandId": {
    "anyOf": [
     {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "bundleItems": {
    "default": [],
    "description": "Components of a bundle (type bundle only): simple, non-archived products of the bundle's warehouse, each listed once. Selling the bundle deducts these components; the bundle's stock is how many whole bundles they make. On update, sending it replaces the whole composition.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "productId": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "productId",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "categoryId": {
    "anyOf": [
     {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "color": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "compareAtPrice": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "condition": {
    "anyOf": [
     {
      "enum": [
       "new",
       "used",
       "refurbished"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "costCurrency": {
    "anyOf": [
     {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "costPrice": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ],
    "description": "Purchase price per unit, in costCurrency. Ignored for a bundle: its cost is the sum of its components' costs when all are known and in one currency."
   },
   "depth": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "dimensionUnit": {
    "anyOf": [
     {
      "enum": [
       "cm",
       "mm",
       "in"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "ean": {
    "anyOf": [
     {
      "pattern": "^[0-9]{8,14}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "GTIN/EAN-8/12/13/14 barcode. Presence-and-shape validation only, no checksum.",
    "example": "4006381333931"
   },
   "gender": {
    "anyOf": [
     {
      "enum": [
       "male",
       "female",
       "unisex"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "height": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "images": {
    "description": "The product's photos as { url, alt }, at most 10; the first is the main photo. On an update the list you send replaces the whole set. An entry whose url equals a photo the product already has keeps that stored file and takes only the caption (alt) you send, so sending back what you read never downgrades a stored photo.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "alt": {
       "description": "Alternative text of the photo, up to 200 characters. Optional: when empty a storefront should use the product name.",
       "example": "White leather sneakers, side view",
       "maxLength": 200,
       "type": "string"
      },
      "contentType": {
       "enum": [
        "image/jpeg",
        "image/png",
        "image/webp"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 255,
       "minLength": 1,
       "type": "string"
      },
      "pathname": {
       "minLength": 1,
       "type": "string"
      },
      "size": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "uploadedAt": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "material": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "mpn": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Manufacturer part number \u2014 the maker's own code for the item, not the shop SKU. eBay requires it beside the brand in many categories.",
    "example": "TR-1"
   },
   "name": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "pattern": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "price": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "productGroupId": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "size": {
    "anyOf": [
     {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "sizeSystem": {
    "anyOf": [
     {
      "enum": [
       "AU",
       "BR",
       "CN",
       "DE",
       "EU",
       "FR",
       "IT",
       "JP",
       "MEX",
       "UK",
       "US"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "sizeType": {
    "anyOf": [
     {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "sku": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "default": "draft",
    "enum": [
     "draft",
     "active",
     "archived"
    ],
    "type": "string"
   },
   "stock": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Units on hand, for a product that tracks inventory; a change on update is recorded as a relative movement in the stock history. Refused for a bundle \u2014 its stock is derived from its components."
   },
   "supplierId": {
    "anyOf": [
     {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "tags": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "trackInventory": {
    "default": false,
    "description": "Whether the product counts units. Ignored for a bundle: it tracks stock exactly when one of its components does.",
    "type": "boolean"
   },
   "type": {
    "default": "simple",
    "description": "simple, or bundle \u2014 one sellable item made of bundleItems, holding no stock of its own. Fixed at creation: an update that changes it is refused.",
    "enum": [
     "simple",
     "bundle"
    ],
    "type": "string"
   },
   "unit": {
    "anyOf": [
     {
      "maxLength": 40,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "videos": {
    "default": [],
    "description": "Video links for the product page (YouTube, Vimeo or a direct file), https only, at most 5. Links, not uploads. On update, sending the field replaces the whole list.",
    "example": [
     {
      "url": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
     }
    ],
    "items": {
     "properties": {
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "warehouseId": {
    "anyOf": [
     {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "weight": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   },
   "weightUnit": {
    "anyOf": [
     {
      "enum": [
       "kg",
       "g",
       "lb",
       "oz"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "width": {
    "anyOf": [
     {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "minLength": 1,
        "type": "string"
       }
      ]
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_product",
 "title": "Create product"
}
