  "readOnlyHint": true,
  "title": "Generate an event Lineup"
 },
 "description": "Generate an event pack: a Luma-style event card with .ics + RSVP QR, and an identity badge per attendee with a deterministic avatar and vCard-encoded QR. Use when the user describes an event and the people attending (meetup, conference, wedding, hackathon, dinner) and wants shareable cards. Do NOT use to render a single downloadable PNG of one badge \u2014 use render-badge-png for that. Output is deterministic: the same attendee name + style always yields the same avatar.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accentHex": {
    "description": "Hex color for accent (e.g. '#ef4444'). Defaults to indigo.",
    "type": "string"
   },
   "attendees": {
    "description": "Attendees to generate identity badges for",
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "description": "Postal/contact address as freeform text",
       "type": "string"
      },
      "company": {
       "description": "Company / organization name",
       "type": "string"
      },
      "email": {
       "description": "Email address, e.g. 'lena@acme.io'",
       "type": "string"
      },
      "gender": {
       "description": "Optional gender hint to make the avatar read more clearly: 'm' (no earrings, may have a beard), 'f' (no beard, may have earrings), or 'x'/omit for neutral. Only affects the lorelei & notionists styles. Infer from the name when the user clearly implies it, otherwise omit.",
       "enum": [
        "m",
        "f",
        "x"
       ],
       "type": "string"
      },
      "linkedin": {
       "description": "LinkedIn profile, e.g. 'linkedin.com/in/lenabauer'",
       "type": "string"
      },
      "name": {
       "description": "Attendee full name",
       "type": "string"
      },
      "phone": {
       "description": "Phone number, e.g. '+49 30 1234567'",
       "type": "string"
      },
      "role": {
       "description": "Short role label (e.g. 'Host', 'Judge', 'Hacker')",
       "type": "string"
      },
      "website": {
       "description": "Personal or company website, e.g. 'acme.io'",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "avatarStyle": {
    "description": "Avatar style for the whole crew. 'notionists' = Notion-style sketch (default, friendly meetups), 'lorelei' = monochrome line art (calm/professional), 'bottts' = colorful robots (hackathons / playful trading-card vibe), 'shapes' = abstract geometric (anonymous voting / ballots).",
    "enum": [
     "notionists",
     "lorelei",
     "bottts",
     "shapes"
    ],
    "type": "string"
   },
   "dateISO": {
    "description": "Event start time as ISO 8601 string (UTC or with offset)",
    "type": "string"
   },
   "durationHours": {
    "description": "Event duration in hours (default 3)",
    "type": "number"
   },
   "rsvpUrl": {
    "description": "URL to encode in the event RSVP QR code",
    "type": "string"
   },
   "title": {
    "description": "Event title",
    "type": "string"
   },
   "venue": {
    "description": "Venue / location text",
    "type": "string"
   }
  },
  "required": [
   "title",
   "dateISO",
   "attendees"
  ],
  "type": "object"
 },
