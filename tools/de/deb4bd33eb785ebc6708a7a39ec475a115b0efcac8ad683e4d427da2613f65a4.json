{
 "description": "Find curated owner-authorized firmware, local-protocol and cloud-replacement playbooks. Results prefer the least-invasive path and are not compatibility approval; call check_firmware_compatibility before preparation.",
 "inputSchema": {
  "properties": {
   "device_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "intervention": {
    "enum": [
     "official_local_api",
     "protocol_replacement",
     "cloud_replacement",
     "stock_firmware_overlay",
     "custom_userspace",
     "full_replacement",
     "research_only"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "risk_tolerance": {
    "default": "moderate",
    "enum": [
     "low",
     "moderate",
     "high"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_firmware_playbooks",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Find firmware playbooks"
}
