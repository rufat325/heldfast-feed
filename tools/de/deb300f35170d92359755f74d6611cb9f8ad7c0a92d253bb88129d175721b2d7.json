{
 "description": "Queue up dozens of cached CV identifiers (mirroring Bullhorn/JobAdder/Vincere search-result batches) for parallel formatting against a single branded template\u2014with optional ATS-safe typography and multilingual coverage.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cv_ids": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "ats_safe": {
      "type": "boolean"
     },
     "language": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "template_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "cv_ids",
   "template_id"
  ],
  "type": "object"
 },
 "name": "bulk_format"
}
