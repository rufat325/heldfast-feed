{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update infrastructure asset"
 },
 "description": "Update an existing infrastructure asset (feature) by ID. To change geometry, provide a new GeoJSON Point/LineString matching the existing feature_type. Computed columns (length_m, slope_pct, risk_score) cannot be set. Requires infrastructure_assets:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_type_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "building_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "condition_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "consequence_of_failure_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "data_source": {
    "maxLength": 200,
    "type": "string"
   },
   "depth_m": {
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "type": "string"
   },
   "diameter_mm": {
    "minimum": 0,
    "type": "number"
   },
   "environmental_impact": {
    "type": "string"
   },
   "expected_lifetime_years": {
    "minimum": 0,
    "type": "number"
   },
   "external_ids": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "feature_code": {
    "maxLength": 100,
    "type": "string"
   },
   "financial_impact": {
    "type": "string"
   },
   "flow_direction": {
    "enum": [
     "with_geometry",
     "against_geometry"
    ],
    "type": "string"
   },
   "from_feature_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "from_invert_m": {
    "type": "number"
   },
   "from_street": {
    "maxLength": 200,
    "type": "string"
   },
   "geometry": {
    "anyOf": [
     {
      "properties": {
       "coordinates": {
        "items": false,
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
         {
          "type": "number"
         },
         {
          "type": "number"
         }
        ],
        "type": "array"
       },
       "type": {
        "const": "Point",
        "type": "string"
       }
      },
      "required": [
       "type",
       "coordinates"
      ],
      "type": "object"
     },
     {
      "properties": {
       "coordinates": {
        "items": {
         "items": false,
         "maxItems": 2,
         "minItems": 2,
         "prefixItems": [
          {
           "type": "number"
          },
          {
           "type": "number"
          }
         ],
         "type": "array"
        },
        "minItems": 2,
        "type": "array"
       },
       "type": {
        "const": "LineString",
        "type": "string"
       }
      },
      "required": [
       "type",
       "coordinates"
      ],
      "type": "object"
     }
    ],
    "description": "Replacement GeoJSON geometry"
   },
   "id": {
    "description": "Infrastructure asset ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "image_url": {
    "type": "string"
   },
   "install_date": {
    "type": "string"
   },
   "lanes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "last_maintenance_date": {
    "type": "string"
   },
   "likelihood_of_failure_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "location_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "manufacturer_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "material": {
    "maxLength": 200,
    "type": "string"
   },
   "model": {
    "maxLength": 200,
    "type": "string"
   },
   "name": {
    "maxLength": 500,
    "type": "string"
   },
   "positional_accuracy_class": {
    "enum": [
     "survey_grade",
     "mapping_grade",
     "sketch",
     "unknown"
    ],
    "type": "string"
   },
   "purchase_cost": {
    "minimum": 0,
    "type": "number"
   },
   "purchase_cost_calculation_method": {
    "enum": [
     "manual",
     "calculated_sqft",
     "calculated_unit"
    ],
    "type": "string"
   },
   "purchase_date": {
    "type": "string"
   },
   "qr_code": {
    "maxLength": 200,
    "type": "string"
   },
   "quantity": {
    "minimum": 0,
    "type": "number"
   },
   "regulatory_impact": {
    "type": "string"
   },
   "reputation_impact": {
    "type": "string"
   },
   "risk_factor": {
    "type": "string"
   },
   "road_class": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "O. Reg. 239/02 road class 1-6 (1-2 arterial, 3-4 collector, 5-6 local)"
   },
   "safety_impact": {
    "type": "string"
   },
   "salvage_value": {
    "minimum": 0,
    "type": "number"
   },
   "salvage_value_percentage": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "serial_number": {
    "maxLength": 200,
    "type": "string"
   },
   "service_impact": {
    "type": "string"
   },
   "site_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status_id": {
    "type": "string"
   },
   "system_class_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "system_group_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "system_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "to_feature_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "to_invert_m": {
    "type": "number"
   },
   "to_street": {
    "maxLength": 200,
    "type": "string"
   },
   "unit_of_measure": {
    "maxLength": 50,
    "type": "string"
   },
   "unit_replacement_value": {
    "minimum": 0,
    "type": "number"
   },
   "width_m": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_infrastructure_asset",
 "title": "Update infrastructure asset"
}
