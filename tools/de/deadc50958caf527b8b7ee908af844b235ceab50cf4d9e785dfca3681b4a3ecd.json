     "type": "string"
    },
    "type": "object"
   },
   "timeZone": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "language",
   "total",
   "page",
   "pageSize",
   "hasMore",
   "items",
   "_trust"
  ],
  "type": "object"
 }
