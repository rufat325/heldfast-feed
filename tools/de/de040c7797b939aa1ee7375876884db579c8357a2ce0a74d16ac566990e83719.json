{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check a cosmetic ingredient (banned, restricted, max concentration, INCI)"
 },
 "description": "Checks whether a cosmetic ingredient is banned, restricted or permitted, and gives its INCI name, maximum concentration, product-type conditions and label warnings. It covers the EU Cosmetics Regulation (EC) No 1223/2009 Annexes II to VI with entry numbers, the EU common ingredient names glossary (Decision 2019/701, the last published edition), the UK cosmetics rules and UK ingredient opinions, the SCCS Notes of Guidance, ICCR reports on fragrance allergens and nanomaterials, US prohibited and restricted cosmetic ingredients, 21 CFR Parts 700 to 740, the Health Canada Cosmetic Ingredient Hotlist, the ASEAN Cosmetic Directive annexes and the Japanese cosmetic ingredient labelling names list. Not intended for food, medicines or general chemical restrictions (the food, pharma and chemical tools cover those).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "application": {
    "default": "any",
    "enum": [
     "leave_on",
     "rinse_off",
     "any"
    ],
    "type": "string"
   },
   "for_children_under_3": {
    "default": false,
    "type": "boolean"
   },
   "function": {
    "description": "Optional, narrows to the matching annex.",
    "enum": [
     "preservative",
     "uv_filter",
     "colourant",
     "fragrance_allergen",
     "other"
    ],
    "type": "string"
   },
   "ingredient": {
    "description": "INCI name, common name, CAS or EC.",
    "type": "string"
   },
   "jurisdictions": {
    "default": [
     "EU",
     "GB"
    ],
    "items": {
     "enum": [
      "EU",
      "GB",
      "US",
      "CA",
      "ASEAN",
      "JP"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "product_type": {
    "description": "Optional, e.g. 'face cream', 'hair dye', 'oral care', 'sunscreen', 'spray', 'eye area'.",
    "type": "string"
   }
  },
  "required": [
   "ingredient"
  ],
  "type": "object"
 },
