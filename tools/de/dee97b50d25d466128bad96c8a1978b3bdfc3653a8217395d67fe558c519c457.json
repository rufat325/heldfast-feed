{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List all tags defined in a project, sorted by prefix then value.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tag_list",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "prefix": {
       "type": "string"
      },
      "project_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "updated_at": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "project_id",
      "prefix",
      "value",
      "created_at",
      "updated_at"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
