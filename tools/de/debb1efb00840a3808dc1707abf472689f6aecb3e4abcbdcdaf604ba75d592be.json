{
 "description": "Get cost breakdown across multiple sessions, grouped by model, provider, tool, or session. Supports time range filtering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "group_by": {
    "description": "How to group the cost breakdown",
    "enum": [
     "model",
     "provider",
     "tool",
     "session"
    ],
    "type": "string"
   },
   "session_ids": {
    "description": "Specific session IDs to include (defaults to all)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "time_range": {
    "additionalProperties": false,
    "description": "Filter by time range",
    "properties": {
     "end": {
      "description": "End of time range (ISO 8601)",
      "type": "string"
     },
     "start": {
      "description": "Start of time range (ISO 8601)",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "group_by"
  ],
  "type": "object"
 },
 "name": "get_cost_report"
}
