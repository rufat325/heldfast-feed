   },
   "query": {
    "description": "Search keyword",
    "type": "string"
   },
   "sort": {
    "description": "Sort order (newest, popular, highest_rated)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_skills"
}
