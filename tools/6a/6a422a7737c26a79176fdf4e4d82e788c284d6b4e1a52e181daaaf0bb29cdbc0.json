{
 "description": "Update a player's status, name, controlType, or AI persona",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "aiPersona": {
    "additionalProperties": false,
    "description": "Update AI persona (for AI players)",
    "properties": {
     "personalityNotes": {
      "description": "Additional personality notes",
      "type": "string"
     },
     "playstyle": {
      "description": "AI playstyle",
      "enum": [
       "tactical",
       "roleplay",
       "cautious",
       "reckless"
      ],
      "type": "string"
     },
     "talkativeness": {
      "description": "How much the AI talks in-character (0-10)",
      "maximum": 10,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "characterId": {
    "description": "New character ID (or null to unlink)",
    "type": [
     "string",
     "null"
    ]
   },
   "controlType": {
    "description": "Switch between human and AI control",
    "enum": [
     "human",
     "ai"
    ],
    "type": "string"
   },
   "name": {
    "description": "New display name",
    "type": "string"
   },
   "playerId": {
    "description": "Player ID",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "status": {
    "description": "New status",
    "enum": [
     "active",
     "inactive",
     "waiting_for_input"
    ],
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "playerId"
  ],
  "type": "object"
 },
 "name": "update_player"
}
