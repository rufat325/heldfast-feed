{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Create a new module in a course.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "name": {
    "description": "Name of the module",
    "type": "string"
   },
   "position": {
    "description": "Position of the module in the list",
    "type": "number"
   },
   "prerequisite_module_ids": {
    "description": "IDs of modules that must be completed before this one",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "unlock_at": {
    "description": "Date/time the module unlocks (ISO 8601)",
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_module",
 "title": "Create Module"
}
