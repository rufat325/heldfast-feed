{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Propose real metadata for a book with a missing/raw-filename title via online provider lookup (ISBN from its identifiers or text, else title/author) on Open Library and Google Books. Preview only \u2014 returns a changes object for calibre_update_book; never writes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookId": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "library": {
    "type": "string"
   },
   "sources": {
    "items": {
     "enum": [
      "openlibrary",
      "googlebooks"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "calibre_recover_metadata",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bookId": {
    "type": "number"
   },
   "changes": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "confidence": {
    "type": "number"
   },
   "fieldCount": {
    "type": "number"
   },
   "lookupKey": {
    "type": "string"
   },
   "source": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Recover book metadata"
}
