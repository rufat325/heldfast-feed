  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "inputs": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "data_base64": {
       "maxLength": 6990508,
       "minLength": 1,
       "type": "string"
      },
      "format": {
       "enum": [
        "csv",
        "json",
        "xlsx",
        "png",
        "jpeg",
        "webp",
        "pdf",
        "docx",
        "doc",
        "rtf",
        "odt"
       ],
       "type": "string"
      }
     },
     "required": [
