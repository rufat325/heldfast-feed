       "properties": {
        "bbox_pixels": {
         "items": false,
         "maxItems": 4,
         "minItems": 4,
         "prefixItems": [
          {
           "type": "number"
          },
          {
           "type": "number"
          },
          {
           "type": "number"
          },
          {
           "type": "number"
          }
         ],
         "type": "array"
        },
        "name": {
         "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$",
         "type": "string"
        },
        "page_number": {
         "maximum": 40,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "name",
        "page_number",
        "bbox_pixels"
       ],
       "type": "object"
      },
      "maxItems": 16,
      "minItems": 1,
