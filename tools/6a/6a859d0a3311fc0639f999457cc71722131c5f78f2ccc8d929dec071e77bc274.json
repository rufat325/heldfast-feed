      "data_base64"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "accept_table_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "background": {
