      "minimum": 1,
      "type": "integer"
     },
     "null_token": {
      "maxLength": 32,
      "minLength": 1,
      "type": "string"
     },
     "ocr": {
      "const": true,
      "type": "boolean"
     },
     "ocr_language": {
      "enum": [
       "eng",
       "fra",
       "eng+fra"
      ],
      "type": "string"
     },
     "pages": {
