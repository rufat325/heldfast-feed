{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List saved topic ideas"
 },
 "description": "Use this when someone asks what they could write about next from topic ideas already saved. Returns each idea's id, score out of 10, title, status and source, filtered by status or minimum score, 25 per page by default. Not for fetching new ideas.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Blog whose ideas to list",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Ideas per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "minScore": {
    "description": "Only ideas with at least this AI score, 0 to 10",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Only ideas with this status: new, used or dismissed; omit for all",
    "enum": [
     "new",
     "used",
     "dismissed"
    ],
    "type": "string"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "list_topic_ideas",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "score": {
       "anyOf": [
        {
         "maximum": 10,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "source": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "enum": [
        "new",
        "used",
        "dismissed",
        "unknown"
       ],
       "type": "string"
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "title",
      "score",
      "status",
      "source"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   }
  },
  "required": [
   "items",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List saved topic ideas"
}
