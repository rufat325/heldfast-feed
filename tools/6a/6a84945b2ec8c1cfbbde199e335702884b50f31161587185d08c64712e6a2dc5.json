{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Build a Homechecker buyer checklist"
 },
 "description": "Build a deterministic, sourced checklist from the Homechecker guide corpus for a buyer context. This assembles general questions and checks; it does not analyse a listing, document or actual building.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyingStage": {
    "description": "For example research, contract review, physical inspection, ownership, or selling.",
    "type": "string"
   },
   "concerns": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "era": {
    "description": "For example pre-1920s, 1950s-1970s, or 2000s-on.",
    "type": "string"
   },
   "jurisdiction": {
    "description": "Australia or a state/territory code or name, such as VIC, vic or Victoria.",
    "type": "string"
   },
   "limit": {
    "default": 12,
    "maximum": 20,
    "minimum": 4,
    "type": "integer"
   },
   "propertyType": {
    "description": "For example house, apartment, or townhouse or unit.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "build_buyer_checklist",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "checklist": {
    "additionalProperties": false,
    "properties": {
     "guidanceBoundary": {
      "type": "string"
     },
     "items": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "canonicalUrl": {
         "type": "string"
        },
        "check": {
         "type": "string"
        },
        "guideSlug": {
         "type": "string"
        },
        "guideTitle": {
         "type": "string"
        },
        "section": {
         "type": "string"
        }
       },
       "required": [
        "check",
        "section",
        "guideSlug",
        "guideTitle",
        "canonicalUrl"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "matchedGuides": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "answer": {
         "type": "string"
        },
        "canonicalUrl": {
         "type": "string"
        },
        "slug": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "slug",
        "title",
        "canonicalUrl",
        "answer"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "profile": {
      "additionalProperties": false,
      "properties": {
       "buyingStage": {
        "type": "string"
       },
       "concerns": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "era": {
        "type": "string"
       },
       "jurisdiction": {
        "type": "string"
       },
       "propertyType": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "profile",
     "guidanceBoundary",
     "matchedGuides",
     "items"
    ],
    "type": "object"
   }
  },
  "required": [
   "checklist"
  ],
  "type": "object"
 },
 "title": "Build a Homechecker buyer checklist"
}
