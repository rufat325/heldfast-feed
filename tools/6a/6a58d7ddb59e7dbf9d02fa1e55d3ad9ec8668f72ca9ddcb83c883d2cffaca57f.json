 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "courseId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "$ref": "#/properties/courseId"
   },
   "toCourseVersionId": {
    "$ref": "#/properties/courseId"
   }
  },
  "required": [
   "courseId"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_rollout_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
