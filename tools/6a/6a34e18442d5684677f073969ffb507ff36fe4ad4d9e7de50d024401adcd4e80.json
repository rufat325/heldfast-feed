{
 "description": "Search and filter financial transactions. Returns transactions sorted by date (newest first) by default. Use the `fields` parameter to reduce payload size by requesting only the fields you need. For spending analysis, aggregations, or category breakdowns, use the `query_transactions` tool instead \u2014 it lets you write SQL for efficient server-side computation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "Filter by account ID",
    "type": "integer"
   },
   "amountFilters": {
    "description": "Filter by amount using comparison operators (e.g. [{ operator: '>', amount: 100 }])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "type": "number"
      },
      "operator": {
       "enum": [
        ">",
        "<",
        ">=",
        "<=",
        "="
       ],
       "type": "string"
      }
     },
     "required": [
      "operator",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cursor": {
    "description": "Cursor for pagination",
    "type": "string"
   },
   "endDate": {
    "description": "End date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "fields": {
    "description": "Return only these fields per transaction (e.g. ['name', 'amount', 'date', 'merchantName']). Omit to return all fields.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results (default 100, max 500)",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "merchants": {
    "description": "Filter by exact merchant names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pending": {
    "description": "Filter pending transactions",
    "type": "boolean"
   },
   "search": {
    "description": "Search by transaction name or merchant",
    "type": "string"
   },
   "startDate": {
    "description": "Start date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "items": {
     "enum": [
      "active",
      "hidden",
      "deleted"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "get_transactions"
}
