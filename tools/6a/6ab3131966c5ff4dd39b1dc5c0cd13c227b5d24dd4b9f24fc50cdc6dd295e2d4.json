{
 "annotations": {},
 "description": "Issue a private SSL/TLS certificate from a Private CA (Certificate Manager, gov). Requires a caTag from the Private CA list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "caTag": {
    "description": "CA identifier (caTag) from the Private CA list",
    "type": "string"
   },
   "certificateName": {
    "description": "Certificate name (3-30 chars: letters, numbers, '-', must be unique)",
    "type": "string"
   },
   "certificateType": {
    "description": "Certificate type: NCP_PRIVATE or NCP_PRIVATE_SSL",
    "enum": [
     "NCP_PRIVATE",
     "NCP_PRIVATE_SSL"
    ],
    "type": "string"
   },
   "commonName": {
    "description": "Common Name (CN) \u2014 1-64 character identifier",
    "type": "string"
   },
   "country": {
    "description": "Country code (C) \u2014 ISO 3166-1 alpha-2",
    "type": "string"
   },
   "dnsSans": {
    "description": "DNS Subject Alternative Names (domain names)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "emailSans": {
    "description": "Email Subject Alternative Names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ipSans": {
    "description": "IP Subject Alternative Names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "keyType": {
    "description": "Key type: RSA2048 | RSA4096 | EC256 | EC521",
    "enum": [
     "RSA2048",
     "RSA4096",
     "EC256",
     "EC521"
    ],
    "type": "string"
   },
   "locality": {
    "description": "Locality/city (L) \u2014 0-128 chars",
    "type": "string"
   },
   "organization": {
    "description": "Organization (O) \u2014 0-64 chars",
    "type": "string"
   },
   "organizationUnit": {
    "description": "Organizational Unit (OU) \u2014 0-128 chars",
    "type": "string"
   },
   "period": {
    "description": "Validity period: '1'~'3650' days, or 'MAX' for maximum allowed",
    "type": "string"
   },
   "registPrivateKey": {
    "description": "Whether to store the private key in Certificate Manager",
    "type": "boolean"
   },
   "stateProvince": {
    "description": "State/Province (ST) \u2014 0-128 chars",
    "type": "string"
   },
   "streetAddress": {
    "description": "Street address \u2014 0-128 chars",
    "type": "string"
   }
  },
  "required": [
   "caTag",
   "certificateName",
   "certificateType",
   "keyType",
   "period",
   "registPrivateKey",
   "commonName"
  ],
  "type": "object"
 },
 "name": "ncloud_issue_private_certificate"
}
