{
 "description": "Forge an original themed health-bar frame+fill PNG pair (genre/materials, not a specific game). Writes the PNGs (npm). 2 credits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "colors": {
    "description": "Fill gradient [light, mid, dark] hex",
    "items": {
     "pattern": "^#[0-9a-fA-F]{6}$",
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "name": {
    "description": "Slug for Library items",
    "maxLength": 60,
    "type": "string"
   },
   "out_dir": {
    "description": "Write frame + fill PNGs (default ./gripforge-hud)",
    "type": "string"
   },
   "theme": {
    "description": "e.g. gothic demon-hunter, baroque metal",
    "maxLength": 300,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "theme"
  ],
  "type": "object"
 },
 "name": "gripforge_hud_bar"
}
