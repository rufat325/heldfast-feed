      "default": [],
      "items": {
       "properties": {
        "source_output": {
         "type": "number"
        },
        "source_path": {
         "type": "string"
        },
        "target_input": {
         "type": "number"
        },
        "target_path": {
         "type": "string"
        }
       },
       "required": [
        "source_path",
        "target_path"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nodes": {
      "default": [],
      "items": {
       "properties": {
        "parameters": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "path": {
         "type": "string"
        },
        "type": {
         "type": "string"
        }
       },
       "required": [
        "path"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "before": {
