{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Task"
 },
 "description": "Create a new farm management task. Supports confirm and idempotency validation.",
 "inputSchema": {
  "properties": {
   "assignedToName": {
    "description": "Optional name of the assigned worker",
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "description": {
    "description": "Optional description",
    "type": "string"
   },
   "dueDate": {
    "description": "Optional due date (YYYY-MM-DD)",
    "type": "string"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "priority": {
    "description": "Low, Medium, or High priority",
    "enum": [
     "Low",
     "Medium",
     "High"
    ],
    "type": "string"
   },
   "title": {
    "description": "The title of the task (e.g. Clean brooder box B)",
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "title"
  ],
  "type": "object"
 },
 "name": "create_task"
}
