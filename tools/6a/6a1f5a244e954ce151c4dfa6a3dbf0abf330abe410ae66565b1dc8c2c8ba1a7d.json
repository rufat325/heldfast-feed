{
 "annotations": {
  "destructiveHint": true,
  "title": "Update incident"
 },
 "description": "UPDATES an existing incident on the LIVE public status page (title/type/services/timing). StatusPal: PUT /status_pages/{subdomain}/incidents/{incident_id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ends_at": {
    "description": "New ISO8601 end time.",
    "type": "string"
   },
   "incident_id": {
    "description": "The incident id to update.",
    "type": "number"
   },
   "notify": {
    "description": "Whether to notify/email subscribers about the change.",
    "type": "boolean"
   },
   "service_ids": {
    "description": "New set of affected service ids.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "starts_at": {
    "description": "New ISO8601 start time.",
    "type": "string"
   },
   "subdomain": {
    "description": "Status page subdomain (overrides STATUSPAL_SUBDOMAIN).",
    "type": "string"
   },
   "title": {
    "description": "New incident title.",
    "type": "string"
   },
   "type": {
    "description": "New incident type (\"major\"/\"minor\"/\"scheduled\").",
    "enum": [
     "major",
     "minor",
     "scheduled"
    ],
    "type": "string"
   }
  },
  "required": [
   "incident_id"
  ],
  "type": "object"
 },
 "name": "statuspal_update_incident",
 "title": "Update incident"
}
