  "readOnlyHint": true,
  "title": "Find price reductions"
 },
 "description": "Live listings whose asking price has been reduced recently, biggest\nreduction first. Each listing carries the price before the cut, the\nprice now, the reduction in euros and percent, and when it was cut.\nUse for \"what has dropped in price in Estepona this month?\" or to\nspot motivated sellers.\n\nFilters work as in search_properties (location, type, bedrooms,\nprice). A location we do not hold returns zero results with\nerror: location_not_found. Listings shown as price on application\nare never included.\n",
 "inputSchema": {
  "properties": {
   "bedrooms_min": {
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "days": {
    "default": 30,
    "description": "How far back to look for reductions.",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "es",
     "de",
     "fr",
     "it",
     "nl",
     "pt",
     "bg",
     "el",
     "da",
     "sv",
     "no",
     "fi",
     "pl",
     "ru"
    ],
    "type": "string"
   },
   "limit": {
    "default": 12,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Place name, e.g. 'Marbella'. Omit for every area.",
    "type": "string"
   },
   "min_percent": {
    "default": 0,
    "description": "Only reductions of at least this percentage.",
    "maximum": 90,
    "minimum": 0,
    "type": "number"
   },
   "price_max": {
    "description": "Maximum CURRENT price in euros (sale) or monthly euros (rent).",
    "minimum": 0,
    "type": "integer"
   },
   "property_types": {
    "description": "Comma-separated slugs: apartments, villas, penthouses, plots, townhouses, commercial.",
    "type": "string"
   },
   "search_type": {
    "description": "Defaults to 'for-sale'.",
    "enum": [
     "for-sale",
     "for-rent"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
