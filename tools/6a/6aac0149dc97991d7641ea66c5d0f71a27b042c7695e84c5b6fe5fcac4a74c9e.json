         "account"
        ],
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "version": {
        "description": "Catalog deployment identity.",
        "examples": [
         "deployment-id"
        ],
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "version",
       "query",
       "offset"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "tools": {
