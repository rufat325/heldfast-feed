       ],
       "type": "object"
      },
      "inputSchema": {
       "additionalProperties": {
        "$ref": "#/$defs/__schema0"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "outputSchema": {
       "additionalProperties": {
        "$ref": "#/$defs/__schema0"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "title",
      "description",
      "inputSchema",
      "annotations",
      "execution"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "type": "array"
   },
   "total": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
