        "destructiveHint",
        "idempotentHint",
        "openWorldHint"
       ],
       "type": "object"
      },
      "description": {
       "type": "string"
      },
      "execution": {
       "additionalProperties": false,
       "properties": {
        "taskSupport": {
         "const": "forbidden",
         "type": "string"
        }
       },
       "required": [
