{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "7-day weather forecast and extreme-weather risk"
 },
 "description": "This week's weather and extreme-weather risk at a place: heat waves and cold (graded on the UTCI felt temperature), storms and wind gusts, heavy rain, snow and freezing rain, by local day, with each day's risk class from Very low to Critical and the hazard behind it.\n\nUse it for the weather or the weather risk in the next seven days. For disasters already happening use get_hazards_near; for what a place is exposed to over years, get_climate_profile.\n\nReturns for each day the minimum and maximum temperature, peak precipitation rate, peak wind gust and the risk with its physical reading; hourly=true adds every forecast step. Steps are hourly on the first day, then 3-hourly, then 6-hourly from the fourth day, so a day's true peak can fall between two steps; a day marked partial is cut by the forecast window. Source: Environment and Climate Change Canada GDPS model, read at its 15 km cell. Give latitude and longitude, or a place name.",
 "inputSchema": {
  "properties": {
   "hourly": {
    "default": false,
    "description": "Add every forecast step, hour by hour where the model has them, to the daily summary",
    "title": "Hourly",
    "type": "boolean"
   },
   "latitude": {
    "anyOf": [
     {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Latitude of the place asked about, in degrees, WGS84. Give it with longitude, or give place instead",
    "title": "Latitude"
   },
   "longitude": {
    "anyOf": [
     {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Longitude of the place asked about, in degrees, WGS84. Give it with latitude, or give place instead",
    "title": "Longitude"
   },
   "place": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "A place name or address, used only when latitude and longitude are not given. It is resolved to its best match by a geocoder shared by every user and limited to one lookup a second, so pass coordinates when you have them",
    "title": "Place"
   }
  },
  "title": "get_forecastArguments",
  "type": "object"
 },
 "name": "get_forecast",
 "outputSchema": {
  "$defs": {
