     "wind_speed_max": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Wind Speed Max"
     }
    },
    "required": [
     "date",
     "temperature_min",
     "temperature_max",
     "precipitation_rate_max",
     "wind_speed_max",
     "risk",
     "risk_by_hazard",
     "steps",
     "step_hours",
