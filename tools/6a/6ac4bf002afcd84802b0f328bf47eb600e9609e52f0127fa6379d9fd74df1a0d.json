        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Precipitation Rate Max"
     },
     "risk": {
      "$ref": "#/$defs/Risk",
      "description": "The day's highest risk"
     },
     "risk_by_hazard": {
      "additionalProperties": {
       "type": "string"
      },
      "title": "Risk By Hazard",
      "type": "object"
     },
     "step_hours": {
      "description": "Hours between the day's steps: 1, 3 or 6",
      "title": "Step Hours",
      "type": "integer"
     },
     "steps": {
      "title": "Steps",
      "type": "integer"
     },
     "temperature_max": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "title": "Temperature Max"
     },
     "temperature_min": {
