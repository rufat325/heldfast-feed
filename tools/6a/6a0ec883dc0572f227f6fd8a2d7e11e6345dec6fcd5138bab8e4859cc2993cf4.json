{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Cloud Insight rule template (\uac10\uc2dc \ud56d\ubaa9 \uadf8\ub8f9 / metrics group).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupDesc": {
    "description": "Description (<= 300 chars)",
    "type": "string"
   },
   "groupName": {
    "description": "Name of the metrics group (1-100 chars)",
    "type": "string"
   },
   "metricsGroupItems": {
    "description": "Metric items (at least one)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "calculation": {
       "description": "Aggregation of the metric",
       "enum": [
        "COUNT",
        "SUM",
        "MAX",
        "MIN",
        "AVG"
       ],
       "type": "string"
      },
      "condition": {
       "description": "Threshold operator (LT, LE, EQ, GE, GT)",
       "enum": [
        "LT",
        "LE",
        "EQ",
        "GE",
        "GT"
       ],
       "type": "string"
      },
      "desc": {
       "description": "Metric description",
       "type": "string"
      },
      "dimensions": {
       "description": "Dimension filters, e.g. [{dim:\"type\", val:\"svr\"}]",
       "items": {
        "additionalProperties": false,
        "properties": {
         "dim": {
          "description": "Dimension name defined in the schema (e.g. \"type\")",
          "type": "string"
         },
         "val": {
          "description": "Dimension value (e.g. \"svr\")",
          "type": "string"
         }
        },
        "required": [
         "dim",
         "val"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "duration": {
       "description": "Duration (>= 1)",
       "type": "number"
      },
      "eventLevel": {
       "description": "Event level",
       "enum": [
        "INFO",
        "WARNING",
        "CRITICAL"
       ],
       "type": "string"
      },
      "metric": {
       "description": "Metric name (e.g. avg_cpu_used_rto)",
       "type": "string"
      },
      "metricGroupItemId": {
       "description": "Metric group item ID (when updating an existing item)",
       "type": "string"
      },
      "threshold": {
       "description": "Threshold value",
       "type": "number"
      }
     },
     "required": [
      "metric",
      "eventLevel",
      "condition",
      "calculation",
      "duration",
      "threshold"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key) for the target service",
    "type": "string"
   },
   "prodType": {
    "description": "Product type: system (Ncloud product) or custom (Custom Schema)",
    "enum": [
     "system",
     "custom"
    ],
    "type": "string"
   },
   "temporaryGroup": {
    "default": false,
    "description": "true: create the Event Rule without creating a metrics group (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "prodKey",
   "groupName",
   "metricsGroupItems"
  ],
  "type": "object"
 },
 "name": "ncloud_create_metrics_group"
}
