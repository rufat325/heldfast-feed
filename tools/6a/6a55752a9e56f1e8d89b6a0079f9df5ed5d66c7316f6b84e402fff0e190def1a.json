{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a scoring profile",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "example": "Companies with 1000+ headcount"
     },
     "name": {
      "example": "Enterprise ICP",
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "profileId": {
    "description": "Scoring profile UUID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "profileId",
   "__requestBody"
  ],
  "type": "object"
 },
 "name": "scoring-profile-update"
}
