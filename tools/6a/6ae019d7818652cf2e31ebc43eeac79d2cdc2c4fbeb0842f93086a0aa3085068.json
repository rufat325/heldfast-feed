{
 "_meta": {
  "openai/outputTemplate": "ui://sendit/widget/content-preview.html",
  "openai/toolInvocation/invoked": "Preview ready",
  "openai/toolInvocation/invoking": "Generating preview...",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate a visual preview of how content will appear on each platform.\n\nUSE THIS WHEN:\n\u2022 Before publishing to see how posts will look\n\u2022 To validate content against platform requirements\n\u2022 To check character counts, hashtag limits, and media requirements\n\nReturns an HTML preview mockup for each platform with validation results:\n\u2022 Character count vs limit\n\u2022 Hashtag count (Instagram has 30 max)\n\u2022 Media requirement check\n\u2022 Platform-specific warnings and errors",
 "inputSchema": {
  "properties": {
   "content": {
    "properties": {
     "mediaType": {
      "description": "Media type hint",
      "enum": [
       "image",
       "video",
       "auto"
      ],
      "type": "string"
     },
     "mediaUrl": {
      "description": "Single media URL (optional)",
      "type": "string"
     },
     "mediaUrls": {
      "description": "Multiple media URLs for carousel (optional)",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "text": {
      "description": "Post text/caption",
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "platforms": {
    "description": "Platforms to generate previews for",
    "items": {
     "enum": [
      "x",
      "linkedin",
      "linkedin-page",
      "facebook",
      "instagram",
      "threads",
      "bluesky",
      "mastodon",
      "nostr",
      "youtube",
      "tiktok",
      "lemmy",
      "discord",
      "slack",
      "telegram",
      "pinterest",
      "dribbble",
      "devto",
      "hashnode",
      "gmb",
      "whop",
      "producthunt"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "platforms",
   "content"
  ],
  "type": "object"
 },
 "name": "preview_content",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "errorMessage": {
    "type": "string"
   },
   "followUpSuggestions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "isError": {
    "type": "boolean"
   },
   "previews": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "hasIssues": {
       "type": "boolean"
      },
      "html": {
       "type": "string"
      },
      "platform": {
       "enum": [
        "x",
        "linkedin",
        "linkedin-page",
        "facebook",
        "instagram",
        "threads",
        "bluesky",
        "mastodon",
        "nostr",
        "youtube",
        "tiktok",
        "lemmy",
        "discord",
        "slack",
        "telegram",
        "pinterest",
        "dribbble",
        "devto",
        "hashnode",
        "gmb",
        "whop",
        "producthunt"
       ],
       "type": "string"
      },
      "validation": {
       "additionalProperties": true,
       "properties": {
        "charCount": {
         "type": "number"
        },
        "charLimit": {
         "type": "number"
        },
        "errors": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "warnings": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "charCount",
        "charLimit",
        "errors",
        "warnings"
       ],
       "type": "object"
      }
     },
     "required": [
      "platform",
      "html",
      "hasIssues",
      "validation"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "properties": {
     "errorCount": {
      "type": "number"
     },
     "hasIssues": {
      "type": "boolean"
     },
     "totalPlatforms": {
      "type": "number"
     },
     "warningCount": {
      "type": "number"
     }
    },
    "required": [
     "totalPlatforms",
     "hasIssues",
     "errorCount",
     "warningCount"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Preview Content"
}
