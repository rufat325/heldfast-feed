{
 "description": "Estimate the Swiss cantonal real-estate capital gains tax (Grundst\u00fcckgewinnsteuer) for a property sale. Covers all 26 cantons with holding-period adjustments and Ersatzbeschaffung (replacement-residence) deferral. Educational estimate; commune surcharges and value-enhancing-improvement deductions are not modeled.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "canton": {
    "description": "Canton code (ZH, BE, ..., JU).",
    "enum": [
     "ZH",
     "BE",
     "LU",
     "UR",
     "SZ",
     "OW",
     "NW",
     "GL",
     "ZG",
     "FR",
     "SO",
     "BS",
     "BL",
     "SH",
     "AR",
     "AI",
     "SG",
     "GR",
     "AG",
     "TG",
     "TI",
     "VD",
     "VS",
     "NE",
     "GE",
     "JU"
    ],
    "type": "string"
   },
   "ersatzbeschaffung": {
    "default": false,
    "description": "Reinvest proceeds into a replacement primary residence.",
    "type": "boolean"
   },
   "ersatzbeschaffung_amount": {
    "default": 0,
    "description": "Amount reinvested (caps the tax deferral).",
    "minimum": 0,
    "type": "number"
   },
   "purchase_price": {
    "minimum": 0,
    "type": "number"
   },
   "sale_price": {
    "minimum": 0,
    "type": "number"
   },
   "years_held": {
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "canton",
   "sale_price",
   "purchase_price",
   "years_held"
  ],
  "type": "object"
 },
 "name": "compute_swiss_property_tax"
}
