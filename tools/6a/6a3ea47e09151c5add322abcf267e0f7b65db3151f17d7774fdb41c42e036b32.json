{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Template Slot"
 },
 "description": "Persist an array of page-scoped template slots in one batched DESIGN.md update. fixed/flexible roles and allowedTokens are cooperative advisory metadata: display labels only, not enforced.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "description": "Page pathname, matching location.pathname",
    "minLength": 1,
    "type": "string"
   },
   "slots": {
    "description": "All template slots to persist in this batched call",
    "items": {
     "additionalProperties": false,
     "properties": {
      "role": {
       "enum": [
        "fixed",
        "flexible"
       ],
       "type": "string"
      },
      "selector": {
       "minLength": 1,
       "type": "string"
      },
      "slotId": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "slotId",
      "selector",
      "role"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "template_id": {
    "default": "default",
    "description": "Template identifier; defaults to default",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "page",
   "slots"
  ],
  "type": "object"
 },
 "name": "set_template_slot"
}
