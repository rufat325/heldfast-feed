{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get Link Preview"
 },
 "description": "Check how a URL will appear when shared on Facebook, Twitter/X, LinkedIn, and Google. Returns platform-specific preview cards showing the title, description, and image each platform will render, plus a quality score (0\u2013100) and a list of issues to fix.\n\nUse this tool when the user asks:\n  - 'check the link preview for example.com'\n  - 'how does this page look when shared on social media?'\n  - 'check my og tags'\n  - 'what will this look like on Twitter / Facebook / LinkedIn?'\n\nThis is synchronous \u2014 results are returned immediately. Does not count against your monthly audit quota. Requires OAuth authentication.\n\nFor a full multi-page audit with per-page scoring and an AI report, use **startSiteAudit** instead.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "The full URL to preview (e.g. https://example.com/pricing).",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "getLinkPreview",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "issues": {
    "description": "Issues found \u2014 fix these to improve scores and previews",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "severity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "platforms": {
    "additionalProperties": false,
    "description": "What each platform will display when this URL is shared",
    "properties": {
     "facebook": {
      "additionalProperties": false,
      "properties": {
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "domain": {
        "type": [
         "string",
         "null"
        ]
       },
       "imageStatus": {
        "type": [
         "string",
         "null"
        ]
       },
       "imageUrl": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "google": {
      "additionalProperties": false,
      "properties": {
       "hasStructuredData": {
        "type": "boolean"
       },
       "metaDescription": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       },
       "url": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "linkedin": {
      "additionalProperties": false,
      "properties": {
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "domain": {
        "type": [
         "string",
         "null"
        ]
       },
       "imageStatus": {
        "type": [
         "string",
         "null"
        ]
       },
       "imageUrl": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     "twitter": {
      "additionalProperties": false,
      "properties": {
       "cardType": {
        "type": [
         "string",
         "null"
        ]
       },
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "domain": {
        "type": [
         "string",
         "null"
        ]
       },
       "imageStatus": {
        "type": [
         "string",
         "null"
        ]
       },
       "imageUrl": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "score": {
    "description": "Quality score 0\u2013100",
    "type": "number"
   },
   "scoreLabel": {
    "description": "Score tier: Well Optimized / Good / Room for Improvement / Needs Attention / Poor",
    "type": "string"
   },
   "url": {
    "type": "string"
