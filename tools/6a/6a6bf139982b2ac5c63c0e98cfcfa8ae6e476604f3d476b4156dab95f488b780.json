{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "rag",
 "description": "Fill a prompt template with variables. Supports {{variable}} syntax and {{#if key}}...{{/if}} conditional blocks. Returns the filled prompt and lists unfilled variables.",
 "inputSchema": {
  "properties": {
   "strict": {
    "description": "Throw error if any variable is not provided (default: false)",
    "type": "boolean"
   },
   "template": {
    "description": "Prompt template with {{variable}} placeholders",
    "type": "string"
   },
   "variables": {
    "additionalProperties": true,
    "description": "Key-value pairs to fill (e.g. {\"name\":\"Alice\",\"role\":\"engineer\"})",
    "type": "object"
   }
  },
  "required": [
   "template"
  ],
  "type": "object"
 },
 "name": "prompt_template_fill",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "filled_variables": {},
   "result": {},
   "total_vars": {},
   "unfilled_variables": {}
  },
  "type": "object"
 }
}
