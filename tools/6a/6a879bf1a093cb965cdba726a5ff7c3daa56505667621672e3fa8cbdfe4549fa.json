     "type": "string"
    },
    "type": "object"
   },
   "slug": {
    "description": "Exec-shelf book slug, e.g. the-culture-code.",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "ratings"
  ],
  "type": "object"
 },
