{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Get BGI policy requirements for a Dutch municipality.\n\n    Extracted from Officiele Bekendmakingen (official government publications).\n    Shows what's required, recommended, or subsidized per gemeente.\n\n    Args:\n        gemeente_code_or_name: CBS code (e.g. \"GM0599\") or municipality name\n                              (e.g. \"Rotterdam\"). Use lookup_municipality to find codes.\n        measure_slug: Optional \u2014 filter to one measure's requirements\n\n    Returns requirements grouped by type (subsidy, regulation, obligation)\n    with document titles, dates, amounts, and source URLs.\n    ","inputSchema":{"properties":{"gemeente_code_or_name":{"title":"Gemeente Code Or Name","type":"string"},"measure_slug":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Measure Slug"}},"required":["gemeente_code_or_name"],"title":"get_policy_requirementsArguments","type":"object"},"name":"get_policy_requirements","outputSchema":{"$defs":{"PolicyRequirement":{"properties":{"document_date":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Document Date"},"document_title":{"title":"Document Title","type":"string"},"gemeente_name":{"title":"Gemeente Name","type":"string"},"measure_name":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Measure Name"},"quantitative_unit":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Quantitative Unit"},"quantitative_value":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Quantitative Value"},"requirement_text":{"title":"Requirement Text","type":"string"},"requirement_type":{"title":"Requirement Type","type":"string"},"source_url":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Source Url"},"subsidy_amount":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Subsidy Amount"},"subsidy_uni