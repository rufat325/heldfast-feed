{
 "description": "Convert a web page into clean, LLM-ready Markdown. Ideal for research, content analysis, RAG ingestion, and reading articles behind complex layouts. Costs 1 credit per call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiKey": {
    "description": "Thunderbit API key (tb_xxx). Optional if THUNDERBIT_API_KEY env var is set.",
    "type": "string"
   },
   "countryCode": {
    "description": "ISO 2-letter country code (default US)",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "excludeTags": {
    "description": "HTML tags to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includeTags": {
    "description": "HTML tags to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "renderMode": {
    "description": "Page render mode",
    "enum": [
     "none",
     "basic",
     "full"
    ],
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in ms (5000-60000)",
    "maximum": 60000,
    "minimum": 5000,
    "type": "integer"
   },
   "url": {
    "description": "Web page URL to convert",
    "format": "uri",
    "type": "string"
   },
   "waitFor": {
    "description": "Wait time after load for dynamic content (ms)",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "thunderbit_distill",
 "title": "Distill Web Page to Markdown"
}
