{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Auto Scaling Group. Use dryRun=true to preview without creating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessControlGroupNoList": {
    "description": "List of ACG numbers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "autoScalingGroupName": {
    "description": "Auto Scaling Group name",
    "maxLength": 255,
    "type": "string"
   },
   "defaultCooldown": {
    "description": "Default cooldown period in seconds",
    "type": "number"
   },
   "desiredCapacity": {
    "description": "Desired number of instances",
    "type": "number"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns a preview without actually creating",
    "type": "boolean"
   },
   "healthCheckGracePeriod": {
    "description": "Health check grace period in seconds",
    "type": "number"
   },
   "healthCheckTypeCode": {
    "description": "Health check type (SVR or LOADB)",
    "type": "string"
   },
   "launchConfigurationNo": {
    "description": "Launch configuration number to use",
    "type": "string"
   },
   "maxSize": {
    "description": "Maximum number of instances",
    "minimum": 0,
    "type": "number"
   },
   "minSize": {
    "description": "Minimum number of instances",
    "minimum": 0,
    "type": "number"
   },
   "serverNamePrefix": {
    "description": "Prefix for server instance names",
    "type": "string"
   },
   "subnetNoList": {
    "description": "List of subnet numbers for the ASG",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "targetGroupNoList": {
    "description": "List of target group numbers to attach",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "launchConfigurationNo",
   "subnetNoList",
   "minSize",
   "maxSize"
  ],
  "type": "object"
 },
 "name": "ncloud_create_asg"
}
