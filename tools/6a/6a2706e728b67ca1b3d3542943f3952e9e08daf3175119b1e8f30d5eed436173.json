{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Post Type"
 },
 "description": "Update a custom post type. Built-in types (blog_post, page) cannot be modified.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "icon": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Icon name or URL"
   },
   "label": {
    "description": "Display label",
    "type": "string"
   },
   "labelPlural": {
    "description": "Plural display label",
    "type": "string"
   },
   "postTypeId": {
    "description": "Post type ID",
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort order (lower = earlier)",
    "type": "number"
   },
   "supportsBlocks": {
    "description": "Allow content blocks (rich body)",
    "type": "boolean"
   },
   "supportsCategories": {
    "description": "Allow categories on this post type",
    "type": "boolean"
   },
   "supportsExcerpt": {
    "description": "Allow an excerpt field",
    "type": "boolean"
   },
   "supportsFeaturedImage": {
    "description": "Allow a featured image",
    "type": "boolean"
   },
   "supportsNesting": {
    "description": "Allow parent/child nesting",
    "type": "boolean"
   }
  },
  "required": [
   "postTypeId"
  ],
  "type": "object"
 },
 "name": "update_post_type",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
