{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update an ad set"
 },
 "description": "Update an ad set. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_update_ad_set.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "properties": {
     "adSetId": {
      "type": "string"
     }
    },
    "required": [
     "adSetId"
    ],
    "type": "object"
   },
   "payload": {
    "properties": {
     "bidAmount": {
      "type": "number"
     },
     "bidStrategy": {
      "enum": [
       "LOWEST_COST_WITHOUT_CAP",
       "LOWEST_COST_WITH_BID_CAP",
       "COST_CAP",
       "LOWEST_COST_WITH_MIN_ROAS"
      ],
      "type": "string"
     },
     "budget": {
      "description": "Omit if not updating budget",
      "properties": {
       "amount": {
        "type": "number"
       },
       "type": {
        "enum": [
         "daily",
         "lifetime"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "name": {
      "maxLength": 255,
      "type": "string"
     },
     "platformSpecificData": {
      "properties": {
       "billingEvent": {
        "type": "string"
       },
       "customerLifecycle": {
        "additionalProperties": false,
        "properties": {
         "engagedAudienceIds": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "existingCustomerAudienceIds": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "strategy": {
          "enum": [
           "all_customers",
           "new_customers",
           "new_customers_excluding_engaged"
          ],
          "type": "string"
         }
        },
        "required": [
         "strategy"
        ],
        "type": "object"
       },
       "dailyMinSpendTarget": {
        "type": "number"
       },
       "endDate": {
        "type": "string"
       },
       "lifetimeMinSpendTarget": {
        "type": "number"
       },
       "optimizationGoal": {
        "type": "string"
       },
       "promotedObject": {
        "additionalProperties": false,
        "properties": {
         "applicationId": {
          "type": "string"
         },
         "customConversionId": {
          "type": "string"
         },
         "customEventStr": {
          "type": "string"
         },
         "customEventType": {
          "type": "string"
         },
         "objectStoreUrl": {
          "type": "string"
         },
         "offlineConversionDataSetId": {
          "type": "string"
         },
         "pageId": {
          "type": "string"
         },
         "pixelId": {
          "type": "string"
         },
         "productCatalogId": {
          "type": "string"
         },
         "productSetId": {
          "type": "string"
         },
         "whatsappPhoneNumber": {
          "type": "string"
         }
        },
        "type": "object"
       },
       "startDate": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "roasAverageFloor": {
      "type": "number"
     },
     "smartTargeting": {
      "properties": {
       "audience": {
        "description": "TikTok smart_audience_enabled.",
        "type": "boolean"
       },
       "interestsBehaviors": {
        "description": "TikTok smart_interest_behavior_enabled.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "status": {
      "enum": [
       "active",
       "paused"
      ],
      "type": "string"
     },
     "valueRuleSetId": {
      "pattern": "^\\d+$",
      "type": "string"
     },
     "valueRulesApplied": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "parameters",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_update_ad_set",
 "title": "Update an ad set"
}
