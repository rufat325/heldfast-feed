         }
        ]
       },
       "amenities": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "availability": {
        "description": "Only when dates were passed: available / unavailable / unknown for them; not_checked when the check failed.",
        "enum": [
         "available",
         "unavailable",
         "unknown",
         "not_checked"
        ],
        "type": "string"
       },
       "capacity": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "label": {
           "type": "string"
          },
          "value": {
           "type": "number"
          }
         },
         "required": [
          "label",
          "value"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "city": {
        "type": "string"
       },
       "description": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "image_url": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "location": {
        "additionalProperties": false,
        "properties": {
         "city": {
          "type": "string"
         },
         "lat": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "lng": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "city",
         "lat",
         "lng"
        ],
        "type": "object"
       },
       "name": {
        "type": "string"
       },
       "offer_id": {
        "type": "number"
       },
       "photos": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "price_from_pln": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "price_to_pln": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "rating": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "reviews_count": {
        "type": "number"
       },
       "stay_price": {
        "anyOf": [
         {
          "additionalProperties": false,
          "description": "Date-specific quote from the availability check, for the requested dates and party.",
          "properties": {
           "adults": {
            "type": "number"
           },
           "children": {
            "type": "number"
           },
           "currency": {
            "const": "PLN",
            "type": "string"
           },
           "date_from": {
            "type": "string"
           },
           "date_to": {
            "type": "string"
           },
           "indicative": {
            "description": "True when the total is plausible but not backed by the host's calendar, so it is an indicative price to be confirmed with the host.",
            "type": "boolean"
           },
           "nights": {
            "type": "number"
           },
           "per_night": {
            "description": "total / nights, rounded \u2014 whole party.",
            "type": "number"
           },
           "total": {
            "description": "Total for the whole stay and the whole party, PLN.",
            "type": "number"
           }
          },
          "required": [
           "total",
           "currency",
           "nights",
           "per_night",
           "adults",
           "children",
           "date_from",
           "date_to"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "stay_price_withheld": {
        "description": "See the search result: the price for the dates is to be confirmed with the host.",
        "type": "string"
       },
       "total_price_pln": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "description": "Same as stay_price.total; only with dates."
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "offer_id",
       "name",
       "city",
       "accommodation_type",
       "description",
       "rating",
       "reviews_count",
       "price_from_pln",
       "price_to_pln",
       "location",
       "image_url",
       "photos",
       "amenities",
       "capacity",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "ok",
     "not_found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "language",
   "offer"
  ],
  "type": "object"
 },
 "title": "Get offer details"
}
