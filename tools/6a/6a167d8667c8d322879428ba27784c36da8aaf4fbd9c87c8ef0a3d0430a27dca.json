{
 "_meta": {
  "openai/outputTemplate": "ui://dododentist/clinic-overview-v2.html",
  "openai/toolInvocation/invoked": "DodoDentist clinic overview ready.",
  "openai/toolInvocation/invoking": "Loading DodoDentist clinic\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "dododentist:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://dododentist/clinic-overview-v2.html"
  },
  "ui/resourceUri": "ui://dododentist/clinic-overview-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show dental practice overview"
 },
 "description": "Use this when someone wants a quick overview or dashboard of one dental practice. Returns an overview card with the practice's details, appointment counts for the next 7 days, how many staff take bookings, open online-booking slots and up to 12 treatment prices (no patient or clinical data). Not for a single patient or appointment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "clinicId": {
    "description": "Practice id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "show_clinic_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appointmentCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "appointmentCountIsLowerBound": {
    "type": "boolean"
   },
   "availabilityDays": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "day": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      }
     },
     "required": [
      "day",
      "count"
     ],
     "type": "object"
    },
    "maxItems": 7,
    "type": "array"
   },
   "availableDayCount": {
    "maximum": 7,
    "minimum": 0,
    "type": "integer"
   },
   "availableSlotCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "clinic": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "anyOf": [
         {
          "pattern": "^[A-Za-z]{3}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultLocale": {
        "anyOf": [
         {
          "pattern": "^[a-zA-Z]{2,3}([_-][a-zA-Z0-9]{2,8}){0,2}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "timezone": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "currency",
       "defaultLocale",
       "timezone"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Administrative practice metadata; null when the practice was not found. The overview never includes individual appointment records, patient information, diagnoses, treatment details, notes or other clinical data."
   },
   "procedureCount": {
    "maximum": 12,
    "minimum": 0,
    "type": "integer"
   },
   "procedureCountIsLowerBound": {
    "type": "boolean"
   },
   "procedures": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "price": {
       "anyOf": [
        {
         "maximum": 1000000000000000,
         "minimum": -1000000000000000,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "name",
      "price",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "providerCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "providerCountIsLowerBound": {
    "type": "boolean"
   },
   "scheduleDays": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 100,
       "minimum": 0,
       "type": "integer"
      },
      "day": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      }
     },
     "required": [
      "day",
      "count"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "scheduleRange": {
    "additionalProperties": false,
    "properties": {
     "endTime": {
      "maxLength": 32,
      "type": "string"
     },
     "startTime": {
      "maxLength": 32,
      "type": "string"
     }
    },
    "required": [
     "startTime",
     "endTime"
    ],
    "type": "object"
   }
  },
  "required": [
   "clinic",
   "scheduleRange",
   "appointmentCount",
   "appointmentCountIsLowerBound",
   "scheduleDays",
   "procedureCount",
   "procedureCountIsLowerBound",
   "procedures",
   "providerCount",
   "providerCountIsLowerBound",
   "availableDayCount",
   "availableSlotCount",
   "availabilityDays"
  ],
  "type": "object"
 },
 "title": "Show dental practice overview"
}
