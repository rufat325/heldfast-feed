{
 "description": "Create a failure alert. Fires when a job dead-letters. Channel is email, webhook, or slack.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channel": {
    "enum": [
     "email",
     "webhook",
     "slack"
    ],
    "type": "string"
   },
   "consecutiveFailuresThreshold": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "cooldownMinutes": {
    "maximum": 10080,
    "minimum": 0,
    "type": "integer"
   },
   "enabled": {
    "type": "boolean"
   },
   "jobId": {
    "description": "Scope to one job; omit for all jobs",
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "description": "Email address, webhook URL, or Slack webhook URL",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "channel",
   "target"
  ],
  "type": "object"
 },
 "name": "create_alert"
}
