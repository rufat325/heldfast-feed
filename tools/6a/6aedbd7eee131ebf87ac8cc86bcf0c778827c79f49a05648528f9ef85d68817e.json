{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get a bounded research workflow for an explicitly exploratory user request. Execute the research using this host's search tools, then create and validate separate LaunchChair candidates. This tool itself does not research or create projects.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "audience": {
    "type": "string"
   },
   "maxCandidates": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "validationGate": {
    "anyOf": [
     {
      "enum": [
       "very_high"
      ],
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "maxSaturation": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "minOpportunity": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       },
       "minPain": {
        "maximum": 100,
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "audience"
  ],
  "type": "object"
 },
 "name": "launchchair_research_opportunities"
}
