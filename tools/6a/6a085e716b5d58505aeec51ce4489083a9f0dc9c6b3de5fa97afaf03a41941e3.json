{
 "description": "Update a domain",
 "inputSchema": {
  "properties": {
   "bounce_webhook": {
    "description": "Webhook URL for bounce notifications",
    "type": "string"
   },
   "domain_id": {
    "description": "Domain ID or fully qualified domain name (e.g. \"example.com\")",
    "type": "string"
   },
   "has_adult_content_protection": {
    "description": "Enable Spam Scanner adult content protection",
    "type": "boolean"
   },
   "has_executable_protection": {
    "description": "Enable Spam Scanner executable protection",
    "type": "boolean"
   },
   "has_phishing_protection": {
    "description": "Enable Spam Scanner phishing protection",
    "type": "boolean"
   },
   "has_recipient_verification": {
    "description": "Require alias recipients to click email verification link",
    "type": "boolean"
   },
   "has_virus_protection": {
    "description": "Enable Spam Scanner virus protection",
    "type": "boolean"
   },
   "ignore_mx_check": {
    "description": "Ignore MX record check on the domain",
    "type": "boolean"
   },
   "max_quota_per_alias": {
    "description": "Maximum storage quota per alias (e.g. \"1GB\")",
    "type": "string"
   },
   "retention_days": {
    "description": "Number of days to retain emails (integer between 0 and 30)",
    "type": "number"
   },
   "smtp_port": {
    "description": "Custom SMTP forwarding port number",
    "type": "string"
   }
  },
  "required": [
   "domain_id"
  ],
  "type": "object"
 },
 "name": "updateDomain"
}
