{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Undo an act"
 },
 "description": "Reverse a specific act or turn through retained history while preserving later work.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "act_id": {
        "maxLength": 256,
        "type": "string"
       },
       "kind": {
        "const": "act",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "act_id"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "turn",
        "type": "string"
       },
       "turn_id": {
        "maxLength": 160,
        "minLength": 1,
        "pattern": "\\S",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "turn_id"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "document",
   "target"
  ],
  "type": "object"
 },
 "name": "document.undo",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Undo an act"
}
