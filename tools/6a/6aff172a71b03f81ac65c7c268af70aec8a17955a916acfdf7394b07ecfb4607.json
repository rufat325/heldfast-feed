      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      {
       "type": "string"
      }
     ]
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "max_sources": {
    "default": 60,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
