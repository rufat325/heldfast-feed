{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Estima el alquiler justo de una vivienda concreta (barrio, tipo, dormitorios, ba\u00f1os, m\u00b2) con avisos comparables de anunciantes distintos y, si se da askingPrice, ubica ese precio (percentil y % sobre/bajo la mediana). Sirve para '\u00bfme est\u00e1n cobrando caro?' o para negociar. Casas: superficie construida.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "areaBasis": {
    "description": "built = construida (default), total = con balcones/terrazas.",
    "enum": [
     "built",
     "total"
    ],
    "type": "string"
   },
   "areaM2": {
    "description": "Superficie en m\u00b2.",
    "maximum": 450,
    "minimum": 20,
    "type": "number"
   },
   "askingPrice": {
    "description": "Precio pedido a evaluar, en la moneda indicada.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "bathrooms": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "bedrooms": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "currency": {
    "enum": [
     "UYU",
     "USD"
    ],
    "type": "string"
   },
   "department": {
    "description": "Departamento de Uruguay con tildes, p. ej. \"Montevideo\", \"Canelones\", \"Maldonado\", \"Colonia\".",
    "maxLength": 40,
    "type": "string"
   },
   "neighborhood": {
    "maxLength": 60,
    "type": "string"
   },
   "parkingSpaces": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "type": {
    "enum": [
     "apartamento",
     "casa"
    ],
    "type": "string"
   }
  },
  "required": [
   "department",
   "neighborhood",
   "type",
   "bedrooms",
   "bathrooms",
   "areaM2"
  ],
  "type": "object"
 },
 "name": "estimate_fair_rent",
 "title": "Tasar un alquiler"
}
