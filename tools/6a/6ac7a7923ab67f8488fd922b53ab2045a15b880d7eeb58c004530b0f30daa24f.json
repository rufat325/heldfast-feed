{
 "description": "Send feedback to the service operator: a missing feature, a bug, an abuse report about an item, or anything else. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "item_id": {
    "type": "string"
   },
   "message": {
    "maxLength": 2000,
    "type": "string"
   },
   "request_id": {
    "description": "The request_id from an error, if reporting one.",
    "type": "string"
   },
   "type": {
    "enum": [
     "missing",
     "bug",
     "abuse",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "message"
  ],
  "type": "object"
 },
 "name": "feedback"
}
