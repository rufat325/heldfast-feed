{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Audit Etsy Listing"
 },
 "description": "Use this when the user wants to assess an existing Etsy listing. Returns a versioned Listing Readiness score with official Etsy sources, limitations, weak points, missing keywords, and tag utilization. It does not predict search rank or sales. Free \u2014 does not use quota.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Current Etsy listing description",
    "maxLength": 20000,
    "type": "string"
   },
   "product_name": {
    "description": "Short product description, e.g. \"handmade ceramic coffee mug, speckled glaze, 12oz\"",
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "tags": {
    "description": "Current Etsy tags",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "description": "Current Etsy listing title",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "seerxo_analyze_listing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "description": "All evaluated SEO checks.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "field": {
       "description": "Listing field checked.",
       "type": "string"
      },
      "id": {
       "description": "Stable check identifier.",
       "type": "string"
      },
      "label": {
       "description": "Human-readable check label.",
       "type": "string"
      },
      "pass": {
       "description": "Whether the check passed.",
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "field",
      "label",
      "pass"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "coverage": {
    "description": "Percentage of product keywords covered by the listing.",
    "type": "number"
   },
   "evaluatedAt": {
    "description": "ISO-8601 evaluation timestamp.",
    "type": "string"
   },
   "evidence": {
    "description": "Official Etsy sources used by this scoring version.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source",
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fixes": {
    "description": "Legacy actionable fix list.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "check": {
       "description": "Failed SEO check.",
       "type": "string"
      },
      "fix": {
       "description": "Recommended fix.",
       "type": "string"
      }
     },
     "required": [
      "check",
      "fix"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "grade": {
    "description": "Legacy letter grade derived from the readiness score.",
    "enum": [
     "A",
     "B",
     "C",
     "D",
     "F"
    ],
    "type": "string"
   },
   "limitations": {
    "description": "Important fields and outcomes this audit does not evaluate.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "missingKeywords": {
    "description": "Product keywords missing from the listing.",
    "items": {
     "$ref": "#/properties/limitations/items"
    },
    "type": "array"
   },
   "overallScore": {
    "description": "Deterministic Listing Readiness score from 0 to 100; not a ranking prediction.",
    "type": "number"
   },
   "passed": {
    "description": "Number of SEO checks that passed.",
    "type": "number"
   },
   "percent": {
    "description": "Legacy alias for the overall readiness score.",
    "type": "number"
   },
   "scoreType": {
    "const": "listing_readiness",
    "type": "string"
   },
   "scoringVersion": {
    "const": "etsy-guidance-2026-04-27",
    "type": "string"
   },
   "seoScore": {
    "description": "Deprecated compatibility alias for overallScore.",
    "type": "number"
   },
   "subScores": {
    "additionalProperties": false,
    "properties": {
     "completeness": {
      "description": "Listing completeness score from 0 to 100.",
      "type": "number"
     },
     "description": {
      "description": "Description readiness from 0 to 100.",
      "type": "number"
     },
     "tags": {
      "description": "Tag readiness from 0 to 100.",
      "type": "number"
     },
     "title": {
      "description": "Title readiness from 0 to 100.",
      "type": "number"
     }
    },
    "required": [
     "title",
     "tags",
     "description",
     "completeness"
    ],
    "type": "object"
   },
   "tagUtilization": {
    "additionalProperties": false,
    "properties": {
     "duplicates": {
      "description": "Duplicate tags.",
      "items": {
       "$ref": "#/properties/limitations/items"
      },
      "type": "array"
     },
     "max": {
      "description": "Maximum Etsy tag slots available.",
      "type": "number"
     },
     "overLong": {
      "description": "Tags longer than Etsy allows.",
      "items": {
       "$ref": "#/properties/limitations/items"
      },
      "type": "array"
     },
     "tooBroad": {
      "description": "Single-word tags that are too broad.",
      "items": {
       "$ref": "#/properties/limitations/items"
      },
      "type": "array"
     },
     "used": {
      "description": "Number of tag slots currently used.",
      "type": "number"
     }
    },
    "required": [
     "used",
     "max",
     "duplicates",
     "tooBroad",
     "overLong"
    ],
    "type": "object"
   },
   "total": {
    "description": "Total number of SEO checks.",
    "type": "number"
   },
   "weakPoints": {
    "description": "Ranked, sourced readiness findings and fixes.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "explanation": {
       "description": "Why the deterministic rule produced this finding.",
       "type": "string"
      },
      "field": {
       "description": "Listing field that needs improvement.",
       "type": "string"
      },
      "fix": {
       "description": "Concrete action that resolves the finding.",
       "type": "string"
      },
      "id": {
       "description": "Stable identifier for the failed SEO check.",
       "type": "string"
      },
      "reason": {
       "description": "Human-readable explanation of the finding.",
       "type": "string"
      },
      "ruleId": {
       "description": "Version-stable rule identifier.",
       "type": "string"
      },
      "severity": {
       "description": "Priority of the finding.",
       "enum": [
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "source": {
       "additionalProperties": false,
       "description": "Official Etsy source connected to this finding.",
       "properties": {
        "id": {
         "$ref": "#/properties/evidence/items/properties/id"
        },
        "source": {
         "$ref": "#/properties/evidence/items/properties/source"
        },
        "title": {
         "$ref": "#/properties/evidence/items/properties/title"
        },
        "url": {
         "$ref": "#/properties/evidence/items/properties/url"
        }
       },
       "required": [
        "id",
        "source",
        "title",
        "url"
       ],
       "type": "object"
      }
     },
     "required": [
      "id",
      "ruleId",
      "field",
      "severity",
      "reason",
      "explanation",
      "fix",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "scoringVersion",
   "scoreType",
   "overallScore",
   "evaluatedAt",
   "evidence",
   "limitations",
   "seoScore",
   "subScores",
   "weakPoints",
   "missingKeywords",
   "tagUtilization",
   "percent",
   "grade",
   "coverage",
   "passed",
   "total",
   "fixes",
   "checks"
  ],
  "type": "object"
 },
 "title": "Audit Etsy listing"
}
