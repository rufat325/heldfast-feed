{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a gradient in the document and optionally apply it to objects. Note: Illustrator will be activated (brought to foreground) during execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "angle": {
    "default": 0,
    "description": "Gradient angle (for linear). Note: may not take effect due to a long-standing Illustrator bug (since 2008).",
    "type": "number"
   },
   "apply_to_uuids": {
    "description": "UUIDs of objects to apply this gradient as fill. For groups/compound paths it is applied to every path and text inside (clipping paths and guides are skipped) and checked by reading back; verified then reports descendantFills. UUIDs that cannot be found are listed in notFound, objects that could not be painted in errors; either makes success false (the gradient itself is still created).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "coordinate_system": {
    "description": "Coordinate system. Auto-detected from document by default (CMYK/print \u2192 document, RGB/web \u2192 artboard-web). artboard-web: origin at active artboard top-left, Y-down. document: Illustrator native coords, origin at bottom-left, Y-up. Call get_document_info to check which system is active.",
    "enum": [
     "artboard-web",
     "document"
    ],
    "type": "string"
   },
   "name": {
    "description": "Gradient name",
    "type": "string"
   },
   "stops": {
    "description": "Gradient stops (minimum 2)",
    "items": {
     "properties": {
      "color": {
       "description": "Stop color",
       "oneOf": [
        {
         "properties": {
          "c": {
           "description": "Cyan (0-100)",
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          },
          "k": {
           "description": "Black (0-100)",
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          },
          "m": {
           "description": "Magenta (0-100)",
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          },
          "type": {
           "const": "cmyk",
           "description": "Color type",
           "type": "string"
          },
          "y": {
           "description": "Yellow (0-100)",
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          }
         },
         "required": [
          "type",
          "c",
          "m",
          "y",
          "k"
         ],
         "type": "object"
        },
        {
         "properties": {
          "b": {
           "description": "Blue (0-255)",
           "maximum": 255,
           "minimum": 0,
           "type": "number"
          },
          "g": {
           "description": "Green (0-255)",
           "maximum": 255,
           "minimum": 0,
           "type": "number"
          },
          "r": {
           "description": "Red (0-255)",
           "maximum": 255,
           "minimum": 0,
           "type": "number"
          },
          "type": {
           "const": "rgb",
           "description": "Color type",
           "type": "string"
          }
         },
         "required": [
          "type",
          "r",
          "g",
          "b"
         ],
         "type": "object"
        },
        {
         "properties": {
          "type": {
           "const": "gray",
           "description": "Color type",
           "type": "string"
          },
          "value": {
           "description": "Gray value (0-100)",
           "maximum": 100,
           "minimum": 0,
           "type": "number"
          }
         },
         "required": [
          "type",
          "value"
         ],
         "type": "object"
        }
       ]
      },
      "mid_point": {
       "default": 50,
       "description": "Midpoint between this stop and next (13-87)",
       "maximum": 87,
       "minimum": 13,
       "type": "number"
      },
      "opacity": {
       "default": 100,
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "position": {
       "description": "Position on ramp (0-100)",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "color",
      "position"
     ],
     "type": "object"
    },
    "minItems": 2,
    "type": "array"
   },
   "type": {
    "default": "linear",
    "enum": [
     "linear",
     "radial"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "stops"
  ],
  "type": "object"
 },
 "name": "create_gradient",
 "title": "Create Gradient"
}
