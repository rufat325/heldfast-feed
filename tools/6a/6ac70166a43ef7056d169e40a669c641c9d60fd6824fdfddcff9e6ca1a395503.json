{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a ticket"
 },
 "description": "Open a new helpdesk ticket. Give either end_user_id (an existing contact's EndUserID) or all of end_user_first_name, end_user_last_name and end_user_email to create a new contact with it. Atera: POST /api/v3/tickets.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Ticket description (first comment).",
    "minLength": 1,
    "type": "string"
   },
   "end_user_email": {
    "description": "New contact's email.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "end_user_first_name": {
    "description": "New contact's first name.",
    "type": "string"
   },
   "end_user_id": {
    "description": "Existing contact's EndUserID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "end_user_last_name": {
    "description": "New contact's last name.",
    "type": "string"
   },
   "end_user_phone": {
    "description": "New contact's phone.",
    "type": "string"
   },
   "impact": {
    "enum": [
     "NoImpact",
     "SiteDown",
     "ServerIssue",
     "Minor",
     "Major",
     "Crisis"
    ],
    "type": "string"
   },
   "priority": {
    "enum": [
     "Low",
     "Medium",
     "High",
     "Critical"
    ],
    "type": "string"
   },
   "status": {
    "description": "Ticket status name, e.g. Open, Pending, Resolved or Closed (or a custom status).",
    "minLength": 1,
    "type": "string"
   },
   "technician_contact_id": {
    "description": "Assign to this technician (TechnicianContactID).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "technician_email": {
    "description": "Assign to the technician with this email.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "title": {
    "description": "Ticket title.",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "enum": [
     "Incident",
     "Problem",
     "Request",
     "Change"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "atera_create_ticket",
 "title": "Create a ticket"
}
