{
 "description": "Add a resource to the community library. Supply either resource_url (external link) or file_url (already-uploaded file) \u2014 at least one is required. price must be > 0 if set (omit for free). access_level defaults to public.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_level": {
    "description": "Defaults to public",
    "enum": [
     "public",
     "members",
     "premium"
    ],
    "type": "string"
   },
   "cover_image_url": {
    "format": "uri",
    "type": "string"
   },
   "description": {
    "maxLength": 20000,
    "type": "string"
   },
   "file_url": {
    "description": "For already-uploaded file resources",
    "format": "uri",
    "type": "string"
   },
   "folder_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "is_premium": {
    "type": "boolean"
   },
   "is_published": {
    "description": "Defaults to true",
    "type": "boolean"
   },
   "price": {
    "description": "One-time price (> 0); omit for free",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "resource_type": {
    "description": "Defaults to \"guide\"",
    "enum": [
     "guide",
     "toolkit",
     "course",
     "checklist",
     "template",
     "other"
    ],
    "type": "string"
   },
   "resource_url": {
    "description": "For external-link resources",
    "format": "uri",
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 50,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_resource"
}
