{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Pulls a Docker image from a registry and returns structured result with digest info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allTags": {
    "default": false,
    "description": "Pull all tagged images in the repository (default: false)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "image": {
    "description": "Image to pull (e.g., nginx:latest, ubuntu:22.04)",
    "maxLength": 255,
    "type": "string"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "platform": {
    "description": "Target platform (e.g., \"linux/amd64\", \"linux/arm64\")",
    "maxLength": 255,
    "type": "string"
   },
   "quiet": {
    "default": false,
    "description": "Suppress verbose output (default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "image"
  ],
  "type": "object"
 },
 "name": "pull",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "digest": {
    "type": "string"
   },
   "errorMessage": {
    "type": "string"
   },
   "errorType": {
    "enum": [
     "auth",
     "not-found",
     "network-timeout",
     "rate-limit",
     "unknown"
    ],
    "type": "string"
   },
   "size": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pulled",
     "up-to-date",
     "error"
    ],
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "success"
  ],
  "type": "object"
 },
 "title": "Docker Pull"
}
