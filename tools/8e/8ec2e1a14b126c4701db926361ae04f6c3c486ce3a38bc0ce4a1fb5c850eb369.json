{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch a web page and convert it to clean Markdown for reading or analysis. Removes scripts, styles, ads and (by default) navigation chrome, resolves relative links to absolute URLs, and keeps tables, code blocks and lists intact. Long pages are paginated: when `truncated` is true, call again with `startIndex: nextStartIndex`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeImages": {
    "default": false,
    "description": "Keep images as Markdown image syntax.",
    "type": "boolean"
   },
   "includeLinks": {
    "default": true,
    "description": "Keep Markdown links. When false, link text is inlined as plain text.",
    "type": "boolean"
   },
   "includeMetadata": {
    "default": true,
    "description": "Include a short metadata summary (title, description, canonical, language).",
    "type": "boolean"
   },
   "mainContentOnly": {
    "default": true,
    "description": "Strip navigation, headers, footers and sidebars, keeping the densest content block.",
    "type": "boolean"
   },
   "maxLength": {
    "default": 25000,
    "description": "Maximum number of Markdown characters to return in one call.",
    "maximum": 1000000,
    "minimum": 500,
    "type": "integer"
   },
   "startIndex": {
    "default": 0,
    "description": "Character offset to start from. Use `nextStartIndex` to page through long pages.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "timeoutMs": {
    "description": "Request timeout in milliseconds (1000-120000).",
    "maximum": 120000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "description": "Absolute http(s) URL of the page to fetch.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "fetch_page_markdown",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytesDownloaded": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "contentType": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "elapsedMs": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "endIndex": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "fromCache": {
    "type": "boolean"
   },
   "markdown": {
    "type": "string"
   },
   "markdownLength": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "metadata": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "author": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "canonical": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "description": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "language": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "publishedTime": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "title": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "title",
       "description",
       "canonical",
       "language",
       "author",
       "publishedTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "nextStartIndex": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass as `startIndex` to fetch the next chunk, or null when complete."
   },
   "redirects": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "requestedUrl": {
    "type": "string"
   },
   "startIndex": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "title": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "totalLength": {
    "description": "Length of the full Markdown document.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   },
   "url": {
    "description": "Final URL after redirects.",
    "type": "string"
   },
   "wordCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "url",
   "requestedUrl",
   "status",
   "contentType",
   "title",
   "markdown",
   "markdownLength",
   "totalLength",
   "startIndex",
   "endIndex",
   "nextStartIndex",
   "truncated",
   "wordCount",
   "bytesDownloaded",
   "elapsedMs",
   "fromCache",
   "redirects",
   "metadata"
  ],
  "type": "object"
 },
 "title": "Fetch page as Markdown"
}
