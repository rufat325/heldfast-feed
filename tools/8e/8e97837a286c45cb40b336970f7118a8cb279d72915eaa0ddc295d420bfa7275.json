{
 "description": "Manage URL redirect rules on an application (Traefik regex/replacement). create: regex+replacement+permanent+applicationId. update: redirectId+regex+replacement+permanent. remove: redirectId. get: redirectId. A redeploy of the application is required for changes to take effect.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "create",
     "update",
     "remove",
     "get"
    ],
    "type": "string"
   },
   "applicationId": {
    "type": "string"
   },
   "permanent": {
    "description": "true = 301, false = 302",
    "type": "boolean"
   },
   "redirectId": {
    "type": "string"
   },
   "regex": {
    "description": "Traefik-compatible source regex (e.g. ^https?://old.example.com/(.*))",
    "type": "string"
   },
   "replacement": {
    "description": "Target URL template (e.g. https://new.example.com/$${1})",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "dokploy_redirects"
}
