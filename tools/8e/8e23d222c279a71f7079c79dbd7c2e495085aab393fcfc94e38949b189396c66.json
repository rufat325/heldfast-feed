{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Calculate annual healthcare costs"},"description":"Calculates the expected total annual costs for a household scenario: basic and supplementary premiums, collective discount (collectiviteitskorting, supplementary only), expected deductible (eigen risico), statutory co-payments (eigen bijdragen) and care costs that are not reimbursed, per person and in total, with all assumptions (aannames) and warnings such as provisional premiums. Input is a Scenario: insurance year, 1 to 8 persons with year of birth, chosen policy ids, voluntary deductible and, only if the user volunteers it, planned care per taxonomy category with counts (verwachtGebruik, optional). Do not ask about health; never put diagnoses, medicines or free text in the scenario; get_intake_schema lists the questions and allowed categories. Children under 18 pay no basic premium and no deductible. Provides information, not advice: the user makes the decision and signs up with the insurer themselves.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"collectiefId":{"description":"Collective contract (collectiviteit) id, if any; discounts apply to supplementary only.","maxLength":100,"minLength":1,"type":"string"},"jaar":{"description":"Insurance year (verzekeringsjaar), e.g. 2027.","maximum":2100,"minimum":2020,"type":"integer"},"personen":{"description":"1 to 8 persons in the household, each with a unique id.","items":{"properties":{"geboortejaar":{"description":"Year of birth (geboortejaar).","maximum":2027,"minimum":1900,"type":"integer"},"geboortemaand":{"description":"Month of birth (1-12), optional. Only used in the year the person turns 18 (premium and deductible start the month after the birthday); if omitted, June is assumed.","maximum":12,"minimum":1,"type":"integer"},"id":{"description":"Short person id, e.g. 'p1'. Unique within the scenario.","pattern":"^[A-Za-z0-9_-]{1,32}$","type":"string"},"polisAanvullendIds":{"default":[],"description":"Chosen supplementary and dental package (aanvullend/tand) ids.","items":{"maxLength":100,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","type":"string"},"maxItems":6,"type":"array"},"polisBasisId":{"anyOf":[{"maxLength":100,"minLength":1,"pattern":"^[A-Za-z0-9][A-Za-z0-9._-]*$","type":"string"},{"type":"null"}],"description":"Chosen or current basic policy (basisverzekering) id; null = not chosen yet."},"vasteZorgaanbieders":{"default":[],"description":"Care providers this person wants to keep using.","items":{"properties":{"agbCode":{"description":"AGB code (8 digits) of the care provider, from zoek_zorgaanbieder.","pattern":"^\\d{8}$","type":"string"},"zorgsoort":{"description":"Type of care, e.g. 'ziekenhuis', 'fysio', 'ggz'.","maxLength":40,"minLength":2,"pattern":"^[a-z][a-z0-9_]*$","type":"string"}},"required":["agbCode","zorgsoort"],"type":"object"},"maxItems":10,"type":"array"},"verwachtErPlichtigCent":{"description":"Expected deductible-liable (eigen-risicoplichtige) costs in euro cents; overrides the estimate from verwachtGebruik.","maximum":10000000,"minimum":0,"type":"integer"},"verwachtGebruik":{"default":[],"description":"Expected care use per category and count. No diagnoses, no free text.","items":{"properties":{"aantal":{"description":"Expected number of treatments, sessions, hours or items in the year.","maximum":999,"minimum":0,"type":"integer"},"categorie":{"description":"Care category code from the coverage taxonomy (e.g. fysio, tand_controle, huisarts). Never a diagnosis or medicine.","enum":["fysio","oefentherapie","ergotherapie","logopedie","dietetiek","podotherapie","huidtherapie","tand_controle","tand_behandeling","tand_kronen_bruggen","orthodontie_kind","orthodontie_volwassen","tand_ongeval","bril_lenzen","ooglaser","hoortoestel","buitenland_spoed","buitenland_gepland","repatriering","vaccinaties_reis","alternatieve_geneeswijzen","acupunctuur","chiropractie_osteopathie","homeopathische_middelen","kraamzorg_eigen_bijdrage","bevalling_ziekenhuis_zonder_indicatie","anticonceptie","kinderopvang_ziek","ivf_extra","preventie_cursus","sportmedisch","stoppen_met_roken","dieetadvies","psychologische_zorg_extra","mindfulness","hulpmiddelen","medicijnen_eigen_bijdrage","plastische_chirurgie","sterilisatie","overgangsconsulent","herstel_zorghotel","mantelzorg_vervanging","overlijden_vervoer","eigen_risico_compensatie","medische_pedicure","stottertherapie","ontharing","camouflagetherapie","kunstgebit","orthoptie","buitenland_tand_spoed","buitenland_hulpverlening","kraampakket","kraamzorg_extra","lactatiekunde","zwangerschapscursus","therapeutisch_kamp","griepvaccinatie","beweegprogramma","gezondheidscheck","lidmaatschap_patientenvereniging","steunzolen","borstkolf","plaswekker","pruik","borstprothese","hospice","verblijf_bezoek","vervoer_verblijf_behandeling","ziekenvervoer_extra","mantelzorgmakelaar","mantelzorg_cursus","second_opinion","juridische_bijstand","huisarts","medisch_specialist","medicijnen","ggz_basis","fysio_basis","hulpmiddelen_basis","ziekenvervoer","wijkverpleging","verloskunde","kraamzorg","lab_diagnostiek","mondzorg_basis","fysio_chronisch","fysio_artrose","fysio_etalagebenen","bekkenfysio","lab_huisartspraktijk","ziekenvervoer_zittend","medicijnen_gvs_bijdrage"],"type":"string"},"tariefCentOverride":{"description":"Price per treatment in euro cents; omit to use the reference tariff (zorgtarief_referentie).","maximum":2500000,"minimum":0,"type":"integer"}},"required":["categorie","aantal"],"type":"object"},"maxItems":60,"type":"array"},"vrijwilligEigenRisico":{"default":"0","description":"Voluntary deductible (vrijwillig eigen risico) in whole euros, on top of the mandatory deductible.","enum":["0","100","200","300","400","500"],"type":"string"}},"required":["id","geboortejaar","polisBasisId"],"type":"object"},"maxItems":8,"minItems":1,"type":"array"},"taal":{"default":"nl","description":"Response language: nl (default) or en.","enum":["nl","en"],"type":"string"},"termijn":{"default":"maand","description":"Premium payment term (betaaltermijn).","enum":["maand","kwartaal","halfjaar","jaar"],"type":"string"}},"required":["jaar","personen"],"type":"object"},"name":"bereken_jaarkosten","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"aannames":{"items":{"type":"string"},"type":"array"},"acties":{"items":{"additionalProperties":false,"properties":{"label":{"type":"string"},"type":{"enum":["bewaar","afsluiten","bekijk"],"type":"string"},"url":{"type":"string"}},"required":["type","label","url"],"type":"object"},"type":"array"},"bronnen":{"items":{"additionalProperties":false,"properties":{"anchor":{"type":["string","null"]},"datum":{"type":["string","null"]},"id":{"type":"string"},"titel":{"type":"string"},"url":{"type":"string"},"versie":{"type":["string","null"]}},"required":["id","titel","url","versie","datum","anchor"],"type":"object"},"type":"array"},"data":{"additionalProperties":false,"properties":{"aannames":{"items":{"type":"string"},"type":"array"},"datasetVersie":{"type":"string"},"engineVersie":{"type":"string"},"jaar":{"type":"number"},"perPersoon":{"items":{"additionalProperties":false,"properties":{"persoonId":{"type":"string"},"regels":{"items":{"additionalProperties":false,"properties":{"aannames":{"default":[],"items":{"type":"string"},"type":"array"},"bedragCent":{"type":"number"},"bronId":{"type":"string"},"omschrijving":{"type":"string"},"soort":{"enum":["premie_basis","premie_aanvullend","korting_collectief","eigen_risico","eigen_bijdrage","niet_vergoed"],"type":"string"}},"required":["soort","omschrijving","bedragCent","aannames"],"type":"object"},"type":"array"},"subtotaalCent":{"type":"number"}},"required":["persoonId","regels","subtotaalCent"],"type":"object"},"type":"array"},"totaalCent":{"type":"number"},"waarschuwingen":{"items":{"type":"string"},"type":"array"}},"required":["engineVersie","datasetVersie","jaar","totaalCent","perPersoon","aannames","waarschuwingen"],"type":"object"},"meta":{"additionalProperties":false,"properties":{"affiliateMelding":{"type":"string"},"cursor":{"type":["string","null"]},"datasetVersie":{"type":"string"},"engineVersie":{"type":"string"},"gegenereerdOp":{"type":"string"},"sorteersleutel":{"type":"string"},"taal":{"enum":["nl","en"],"type":"string"}},"required":["engineVersie","datasetVersie","taal"],"type":"object"},"samenvatting":{"type":"string"}},"required":["data","samenvatting","bronnen","aannames","meta","acties"],"type":"object"},"title":"Calculate annual healthcare costs"}
