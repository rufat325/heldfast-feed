{
 "description": "Invoice aging buckets with the right chase action per invoice (friendly nudge \u2192 firm ask \u2192 escalation plan) based on how late each one is.",
 "inputSchema": {
  "properties": {
   "invoices": {
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "client": {
       "type": "string"
      },
      "due": {
       "description": "YYYY-MM-DD",
       "type": "string"
      },
      "paid": {
       "type": "boolean"
      }
     },
     "required": [
      "amount",
      "due"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "today": {
    "description": "YYYY-MM-DD, defaults to server date",
    "type": "string"
   }
  },
  "required": [
   "invoices"
  ],
  "type": "object"
 },
 "name": "invoice_aging"
}
