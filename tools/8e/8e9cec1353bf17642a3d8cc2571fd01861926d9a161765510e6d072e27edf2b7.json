{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Move Grab Layer"
 },
 "description": "Queue a same-page layer reorder or reparent intent (previewed when measuredRects are supplied, otherwise proposed) without mutating the live page. Reparent moves a node to a different parent (toParentSelector); reorder keeps a single parentSelector. Permissions and fixed/flexible roles are cooperative advisory metadata: display labels only, not enforced; caller-supplied roles are rejected. Shadow-root and iframe boundaries are out of scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approximate": {
    "type": "boolean"
   },
   "baselineOrder": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "domSnapshotHash": {
    "minLength": 1,
    "type": "string"
   },
   "fromIndex": {
    "minimum": 0,
    "type": "integer"
   },
   "fromParentSelector": {
    "description": "Required for reparent \u2014 source parent",
    "minLength": 1,
    "type": "string"
   },
   "fromSelector": {
    "minLength": 1,
    "type": "string"
   },
   "measuredRects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "type": "number"
      },
      "selector": {
       "minLength": 1,
       "type": "string"
      },
      "width": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "selector",
      "x",
      "y",
      "width",
      "height"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "operation": {
    "enum": [
     "reorder",
     "reparent"
    ],
    "type": "string"
   },
   "orderedSelectors": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "page": {
    "minLength": 1,
    "type": "string"
   },
   "parentSelector": {
    "description": "Required for reorder \u2014 single parent",
    "minLength": 1,
    "type": "string"
   },
   "role": {
    "description": "Rejected: roles are never accepted from callers",
    "not": {}
   },
   "selectionOrder": {
    "items": {
     "minimum": 1,
     "type": "integer"
    },
    "type": "array"
