     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "toDomSnapshotHash": {
    "minLength": 1,
    "type": "string"
   },
   "toIndex": {
    "minimum": 0,
    "type": "integer"
   },
   "toParentSelector": {
    "description": "Required for reparent \u2014 destination parent",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "operation",
   "page",
   "fromIndex",
   "toIndex",
   "orderedSelectors",
   "measuredRects",
   "approximate",
   "domSnapshotHash"
  ],
  "type": "object"
 },
 "name": "move_grab_layer"
}
