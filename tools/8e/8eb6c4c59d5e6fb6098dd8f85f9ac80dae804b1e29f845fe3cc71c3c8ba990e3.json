{
 "description": "List all installed themes",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Limit to these statuses",
    "items": {
     "enum": [
      "active",
      "inactive"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_themes"
}
