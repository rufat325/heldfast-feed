{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List saved field mappings"
 },
 "description": "Lists field mappings saved for a company. Each mapping is reusable across imports of the same entity type.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companyId": {
    "description": "Company id from list_companies.",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "list_mappings",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "mappings": {
    "description": "Saved field mappings.",
    "items": {
     "additionalProperties": true,
     "properties": {
      "createdAt": {
       "description": "ISO timestamp.",
       "type": "string"
      },
      "entityName": {
       "description": "Entity this mapping targets.",
       "type": "string"
      },
      "fields": {
       "description": "Persisted field entries.",
       "items": {
        "additionalProperties": true,
        "properties": {
         "fixedValue": {
          "description": "Constant applied to every row, if not mapped from a column."
         },
         "sourceFieldTitle": {
          "description": "CSV column the field reads from.",
          "type": "string"
         },
         "targetFieldId": {
          "description": "Importer field id.",
          "type": "string"
         }
        },
        "required": [
         "targetFieldId"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "id": {
       "description": "Mapping id.",
       "type": "string"
      },
      "title": {
       "description": "Mapping name.",
       "type": "string"
      },
      "updatedAt": {
       "description": "ISO timestamp.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "entityName",
      "fields"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
