{
 "description": "Schedule a draft or approved post for a specific time. Equivalent to approve_post but named to match 'pking posts schedule'. Pass a future ISO 8601 UTC datetime. After scheduling the post status becomes 'scheduled'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "postId": {
    "description": "Post ID to schedule",
    "type": "string"
   },
   "scheduledAt": {
    "description": "Future ISO 8601 UTC datetime, e.g. 2026-06-01T09:00:00Z",
    "format": "date-time",
    "type": "string"
   },
   "timezone": {
    "description": "User timezone, e.g. 'America/New_York'",
    "type": "string"
   }
  },
  "required": [
   "postId",
   "scheduledAt"
  ],
  "type": "object"
 },
 "name": "schedule_post"
}
