{
 "description": "Render a VRMA animation applied to a VRM through a local headless Chrome/Edge. mode=image writes a PNG at time_sec; mode=video records a short WebM clip (max 10 seconds).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "duration_sec": {
    "description": "Video mode: recording length",
    "maximum": 10,
    "minimum": 0.5,
    "type": "number"
   },
   "fps": {
    "description": "Video mode: capture rate (default 30)",
    "maximum": 60,
    "minimum": 5,
    "type": "integer"
   },
   "height": {
    "maximum": 4096,
    "minimum": 64,
    "type": "integer"
   },
   "mode": {
    "description": "Default image",
    "enum": [
     "image",
     "video"
    ],
    "type": "string"
   },
   "output_path": {
    "description": "Where to write the PNG/WebM output",
    "type": "string"
   },
   "time_sec": {
    "description": "Image mode: clip time to render (default mid-clip)",
    "minimum": 0,
    "type": "number"
   },
   "view": {
    "enum": [
     "front",
     "three_quarter",
     "side",
     "face"
    ],
    "type": "string"
   },
   "vrm_path": {
    "description": "Local path to the .vrm avatar",
    "type": "string"
   },
   "vrma_path": {
    "description": "Local path to the .vrma animation",
    "type": "string"
   },
   "width": {
    "maximum": 4096,
    "minimum": 64,
    "type": "integer"
   }
  },
  "required": [
   "vrm_path",
   "vrma_path",
   "output_path"
  ],
  "type": "object"
 },
 "name": "vrma_preview"
}
