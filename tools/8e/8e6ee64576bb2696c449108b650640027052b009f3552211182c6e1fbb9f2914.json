{
 "description": "Send RILL from a mnemonic-derived wallet to a recipient address",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount_rill": {
    "description": "Amount of RILL to send",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "mnemonic": {
    "description": "BIP-39 mnemonic phrase for the sending wallet",
    "type": "string"
   },
   "to": {
    "description": "Recipient address (trill1...)",
    "type": "string"
   }
  },
  "required": [
   "mnemonic",
   "to",
   "amount_rill"
  ],
  "type": "object"
 },
 "name": "send_rill"
}
