  "properties": {
   "filter": {
    "additionalProperties": {},
    "description": "Stream filter_conditions object, e.g. {\"type\":\"messaging\"} or {\"members\":{\"$in\":[\"u1\"]}}. Default {} (all channels the app can see).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "limit": {
