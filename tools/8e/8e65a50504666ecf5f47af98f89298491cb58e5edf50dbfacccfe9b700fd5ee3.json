{
 "description": "Returns AI-classified tech/investor news with verdicts, topics, entities, and theses.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max articles (1-100, default 20).",
    "type": "number"
   },
   "mode": {
    "description": "'top' (default) or 'latest'.",
    "type": "string"
   },
   "section": {
    "description": "Filter: news, research, newsletters, podcasts.",
    "type": "string"
   },
   "since": {
    "description": "ISO 8601 date. Only articles after this.",
    "type": "string"
   },
   "topics": {
    "description": "Comma-separated topics (e.g. 'AI,Semiconductors').",
    "type": "string"
   },
   "verdict": {
    "description": "Filter: must_read, worth_reading, skim, skip.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_feed"
}
