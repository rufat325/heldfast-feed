 "inputSchema": {
  "properties": {
   "reference": {
    "title": "Reference",
    "type": "string"
   },
   "version": {
    "default": "BSB",
    "title": "Version",
    "type": "string"
   }
  },
  "required": [
   "reference"
  ],
  "title": "get_passageArguments",
  "type": "object"
 },
 "name": "get_passage",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "get_passageOutput",
  "type": "object"
 }
}
