{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a postcard"
 },
 "description": "Create a postcard order (4x6, 6x9 or 6x11) and get a payment link. The front is an image URL or a big headline; the back carries the message and addresses. Mails only after the user pays.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Front (an image URL or a headline) and the message on the back",
    "properties": {
     "front_headline": {
      "description": "Big text for the front if there is no image, e.g. 'Happy birthday, Sam!'",
      "maxLength": 60,
      "type": "string"
     },
     "front_image_url": {
      "description": "https URL of a photo or design for the front (JPG or PNG)",
      "maxLength": 2000,
      "type": "string"
     },
     "front_theme": {
      "default": "ink",
      "description": "Color theme for a text-only front",
      "enum": [
       "ink",
       "sky",
       "sunset",
       "forest"
      ],
      "type": "string"
     },
     "message": {
      "description": "Handwritten-style message on the back",
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "customer_email": {
    "description": "Where to send the receipt and status updates",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "from": {
    "description": "Return address; printed on the mail piece",
    "properties": {
     "city": {
      "description": "City",
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "company": {
      "description": "Company name, printed under the person's name",
      "maxLength": 60,
      "type": "string"
     },
     "line1": {
      "description": "Street address",
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
     },
     "line2": {
      "description": "Apartment, suite, unit",
      "maxLength": 64,
      "type": "string"
     },
     "name": {
      "description": "Recipient or sender full name",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "description": "Two-letter US state code, e.g. NY",
      "type": "string"
     },
     "zip": {
      "description": "5-digit US ZIP code, or ZIP+4",
      "pattern": "^\\d{5}(-\\d{4})?$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "city",
     "state",
     "zip"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "description": "Any unique string; retrying with the same key returns the original order instead of creating a duplicate",
    "maxLength": 120,
    "type": "string"
   },
   "size": {
    "default": "4x6",
    "description": "Postcard size: 4x6, 6x9 or 6x11 (see get_pricing for prices)",
    "enum": [
     "4x6",
     "6x9",
     "6x11"
    ],
    "type": "string"
   },
   "to": {
    "description": "Recipient's US mailing address",
    "properties": {
     "city": {
      "description": "City",
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "company": {
      "description": "Company name, printed under the person's name",
      "maxLength": 60,
      "type": "string"
     },
     "line1": {
      "description": "Street address",
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
     },
     "line2": {
      "description": "Apartment, suite, unit",
      "maxLength": 64,
      "type": "string"
     },
     "name": {
      "description": "Recipient or sender full name",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "description": "Two-letter US state code, e.g. NY",
      "type": "string"
     },
     "zip": {
      "description": "5-digit US ZIP code, or ZIP+4",
      "pattern": "^\\d{5}(-\\d{4})?$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "city",
     "state",
     "zip"
    ],
    "type": "object"
   }
  },
  "required": [
   "to",
   "from",
   "content"
  ],
  "type": "object"
 },
 "name": "create_postcard",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "certified": {
    "description": "none, certified or certified_return_receipt",
    "type": "string"
   },
   "checkout_url": {
    "description": "Where the user pays; null once paid or cancelled",
    "type": [
     "string",
     "null"
    ]
   },
   "discount": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "display": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "display",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "First-order discount, already taken off price; null when none applies"
   },
   "id": {
    "description": "Order id, ord_\u2026",
    "type": "string"
   },
   "object": {
    "enum": [
     "postcard",
     "letter"
    ],
    "type": "string"
   },
   "order_url": {
    "description": "Order status page",
    "type": "string"
   },
   "preview_url": {
    "description": "Exact print preview",
    "type": "string"
   },
   "price": {
    "additionalProperties": false,
    "properties": {
     "amount_cents": {
      "type": "number"
     },
     "currency": {
      "type": "string"
     },
     "display": {
      "type": "string"
     }
    },
    "required": [
     "amount_cents",
     "currency",
     "display"
    ],
    "type": "object"
   },
   "product": {
    "description": "Product id, e.g. postcard_4x6 or letter_certified",
    "type": "string"
   },
   "product_name": {
    "type": "string"
   },
   "status": {
    "description": "awaiting_payment, paid, printing, mailed, cancelled or refunded",
    "type": "string"
   },
   "status_detail": {
    "description": "Plain-English status to show the user",
    "type": "string"
   },
   "tracking": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "number": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "number",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "USPS tracking, for Certified Mail once printed"
   }
  },
  "required": [
   "id",
   "object",
   "product",
   "product_name",
   "certified",
   "status",
   "status_detail",
   "price",
   "checkout_url",
   "order_url",
   "preview_url",
   "tracking",
   "discount"
  ],
  "type": "object"
 },
 "title": "Create a postcard"
}
