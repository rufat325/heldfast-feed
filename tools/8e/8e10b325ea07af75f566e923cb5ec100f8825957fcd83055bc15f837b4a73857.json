{
 "_meta": {
  "openai/outputTemplate": "ui://sendit/widget/publish-result.html",
  "openai/toolInvocation/invoked": "Published successfully",
  "openai/toolInvocation/invoking": "Publishing from library...",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish content directly from your library to one or more platforms.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "The content library item ID to publish",
    "type": "string"
   },
   "platforms": {
    "description": "Platforms to publish to",
    "items": {
     "enum": [
      "x",
      "linkedin",
      "linkedin-page",
      "facebook",
      "instagram",
      "threads",
      "bluesky",
      "mastodon",
      "nostr",
      "youtube",
      "tiktok",
      "lemmy",
      "discord",
      "slack",
      "telegram",
      "pinterest",
      "dribbble",
      "devto",
      "hashnode",
      "gmb",
      "whop",
      "producthunt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "team_id": {
    "description": "Team ID to operate in team scope. Get available teams with list_teams. If omitted, uses personal scope.",
    "type": "string"
   }
  },
  "required": [
   "id",
   "platforms"
  ],
  "type": "object"
 },
 "name": "publish_from_library",
 "title": "Publish from Library"
}
