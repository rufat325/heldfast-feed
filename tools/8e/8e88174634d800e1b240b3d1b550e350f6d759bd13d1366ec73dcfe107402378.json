{
 "description": "Read Google Ads campaigns: status, daily budget, impressions, clicks, cost and conversions over a window. Needs GOOGLE_ADS_DEVELOPER_TOKEN, an OAuth client and a refresh token; read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 30,
    "description": "How many days back to report, ending today",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "ads_campaigns",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaigns": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clicks": {
       "type": "number"
      },
      "conversions": {
       "type": "number"
      },
      "cost": {
       "type": "number"
      },
      "dailyBudget": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Null when Google returned no amount, which is not a budget of zero"
      },
      "impressions": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "status",
      "dailyBudget",
      "impressions",
      "clicks",
      "cost",
      "conversions"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "days": {
    "type": "number"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rowCount": {
    "type": "number"
   }
  },
  "required": [
   "days",
   "rowCount",
   "campaigns",
   "notes"
  ],
  "type": "object"
 }
}
