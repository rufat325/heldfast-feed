  "properties": {
   "input": {
    "description": "the task/prompt for the agent",
    "type": "string"
   },
   "slug": {
    "description": "the agent's slug (from list_agents)",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "run_agent",
