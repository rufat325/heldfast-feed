 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false
 },
 "description": "Submits the confirmed W-7 intake and pushes the application to the processing partner. Only call after showing the user a full summary and getting explicit confirmation. Requires a trusted-device approval: open one with identity's create-approval-session tool (action_type itin_submit_intake, payload {applicationId}), have the user approve on their phone, then pass the session id as approval_session_id.",
 "inputSchema": {
  "properties": {
   "applicationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "approvalSessionId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "intake": {
    "properties": {
     "countriesOfCitizenship": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "dateOfBirth": {
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
     },
     "email": {
      "maxLength": 255,
      "minLength": 3,
      "pattern": "^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$",
      "type": "string"
     },
     "foreignAddress": {
      "properties": {
       "cityStateProvince": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "maxLength": 100,
        "minLength": 2,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "pattern": "^[A-Za-z0-9 -]*$",
        "type": "string"
       },
       "street": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "fullLegalName": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "hadPriorItin": {
      "type": "boolean"
     },
     "hasSsnOrEligible": {
      "type": "boolean"
     },
     "hasValidPassportOrId": {
      "type": "boolean"
     },
     "mailingAddress": {
      "properties": {
       "cityStateProvince": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       },
       "country": {
        "maxLength": 100,
        "minLength": 2,
        "type": "string"
       },
       "postalCode": {
        "maxLength": 20,
        "pattern": "^[A-Za-z0-9 -]*$",
        "type": "string"
       },
       "street": {
        "maxLength": 255,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     },
     "message": {
      "maxLength": 2000,
      "type": "string"
     },
     "otherNamesUsed": {
      "maxLength": 255,
      "type": "string"
     },
     "phone": {
      "maxLength": 30,
      "minLength": 5,
      "pattern": "^[0-9+ ()\\-]+$",
      "type": "string"
     },
     "placeOfBirth": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "reasonForApplying": {
      "pattern": "^[a-h]$",
      "type": "string"
     },
     "usVisaExpiration": {
      "maxLength": 10,
      "pattern": "^([0-9]{4}-[0-9]{2}-[0-9]{2})?$",
      "type": "string"
     },
     "usVisaNumber": {
      "maxLength": 50,
      "pattern": "^[A-Za-z0-9 -]*$",
      "type": "string"
     },
     "usVisaNumberOnFile": {
      "type": "boolean"
     },
     "usVisaType": {
      "maxLength": 50,
      "type": "string"
     },
     "visitedUsOrHasVisa": {
      "type": "boolean"
     }
    },
    "required": [
     "mailingAddress"
    ],
    "type": "object"
   }
  },
  "required": [
   "applicationId",
   "intake"
  ],
  "type": "object"
 },
 "name": "itin_submit_itin_intake",
 "outputSchema": {
  "properties": {
   "pushError": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ITIN_STATUS_UNSPECIFIED",
     "ITIN_STATUS_CHECKOUT_PENDING",
     "ITIN_STATUS_PAID",
     "ITIN_STATUS_PUSH_FAILED",
     "ITIN_STATUS_SUBMITTED",
     "ITIN_STATUS_COMPLETED",
     "ITIN_STATUS_REJECTED"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Submit ITIN Intake"
}
