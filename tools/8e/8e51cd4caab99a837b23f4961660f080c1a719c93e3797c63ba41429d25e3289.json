{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Compose a transaction to broadcast a text message or numeric value to the Counterparty network",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Source Bitcoin address",
    "type": "string"
   },
   "fee_fraction": {
    "default": 0,
    "description": "Fee fraction for bet matching",
    "type": "number"
   },
   "inputs_set": {
    "description": "Comma-separated UTXOs to use as inputs (txid:vout)",
    "type": "string"
   },
   "inscription": {
    "description": "Base64-encoded inscription data (requires P2TR address)",
    "type": "string"
   },
   "mime_type": {
    "description": "MIME type for inscription (e.g. image/png, text/plain)",
    "type": "string"
   },
   "sat_per_vbyte": {
    "description": "Fee rate in satoshis per virtual byte (e.g. 1, 5.5, 0.15). Check get_fee_estimate for current market rates.",
    "minimum": 0.1,
    "type": "number"
   },
   "text": {
    "description": "Text to broadcast",
    "type": "string"
   },
   "timestamp": {
    "description": "Unix timestamp",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "value": {
    "default": 0,
    "description": "Numeric value",
    "type": "number"
   }
  },
  "required": [
   "address",
   "text"
  ],
  "type": "object"
 },
 "name": "compose_broadcast"
}
