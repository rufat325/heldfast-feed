{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List tasks in a task list. Excludes hidden and assigned tasks by default; set showHidden/showAssigned to include them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "completedMax": {
    "description": "Upper bound on completion date (RFC 3339)",
    "type": "string"
   },
   "completedMin": {
    "description": "Lower bound on completion date (RFC 3339)",
    "type": "string"
   },
   "dueMax": {
    "description": "Upper bound on due date (RFC 3339)",
    "type": "string"
   },
   "dueMin": {
    "description": "Lower bound on due date (RFC 3339)",
    "type": "string"
   },
   "maxResults": {
    "description": "Max tasks per page (1-100, default 20)",
    "type": "number"
   },
   "pageToken": {
    "description": "Token for the next page of results",
    "type": "string"
   },
   "showAssigned": {
    "description": "Include tasks assigned from Docs/Chat Spaces",
    "type": "boolean"
   },
   "showCompleted": {
    "description": "Include completed tasks (default true; ignored unless showHidden is also true)",
    "type": "boolean"
   },
   "showDeleted": {
    "description": "Include deleted tasks",
    "type": "boolean"
   },
   "showHidden": {
    "description": "Include hidden (cleared) tasks",
    "type": "boolean"
   },
   "tasklist": {
    "description": "Task list ID (use \"@default\" for the default list)",
    "type": "string"
   },
   "updatedMin": {
    "description": "Lower bound on last-modified time (RFC 3339)",
    "type": "string"
   }
  },
  "required": [
   "tasklist"
  ],
  "type": "object"
 },
 "name": "tasks_tasks_list"
}
