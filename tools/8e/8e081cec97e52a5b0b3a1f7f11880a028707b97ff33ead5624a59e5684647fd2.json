{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search academic journals. Every parameter is optional \u2014 combine any of keyword, CCF rank, research field and ISSN. Returns a paginated list.",
 "inputSchema": {
  "properties": {
   "ccf_rank": {
    "description": "CCF rank",
    "enum": [
     "A",
     "B",
     "C"
    ],
    "type": "string"
   },
   "field": {
    "description": "Research field (e.g. ai, security, systems, ee, energy) - see the field enum for the full list",
    "enum": [
     "ai",
     "vision",
     "nlp",
     "data",
     "network",
     "security",
     "se",
     "systems",
     "theory",
     "hci",
     "graphics",
     "bio",
     "robotics",
     "web",
     "ee",
     "energy",
     "materials",
     "civil",
     "education",
     "management",
     "math"
    ],
    "type": "string"
   },
   "issn": {
    "description": "ISSN (fuzzy match)",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number, 1-based",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 10,
    "description": "Items per page, max 100",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Keyword, matched against short/full name",
    "type": "string"
   },
   "updated_since": {
    "description": "Incremental sync: only venues changed on/after this date (YYYY-MM-DD). Day granularity. Use the updated_at field of the results as your next checkpoint.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_journals"
}
