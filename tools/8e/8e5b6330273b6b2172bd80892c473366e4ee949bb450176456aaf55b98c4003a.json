{
 "_meta": {
  "smarterweather.dev/input_examples": [
   {
    "lat": 39.74,
    "limit": 3,
    "lon": -104.99,
    "query": "how much rain fell in the last day"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search catalog"
 },
 "description": "Find which dataset answers a weather question when no dedicated tool fits: ranks the data catalog (model grids, radar, satellite, outlooks, observations) by the question's words and returns the best datasets with variable, units, cadence, a one-line why and the exact `call` (tool and arguments) to run next. Pass lat/lon, or `domain`, to keep only datasets covering the place; without one, Alaska/Hawaii twins fold into the CONUS dataset. Calls are ready for \"now\"; for a past time set `time_start`/`time_end` (or `at` where the tool supports it). Free; no network call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Coverage filter when there is no point; not with lat/lon.",
    "enum": [
     "conus",
     "alaska",
     "hawaii",
     "carib",
     "global"
    ],
    "type": "string"
   },
   "family": {
    "description": "Only this source family (e.g. \"nbm\", \"mrms\").",
    "maxLength": 40,
    "type": "string"
   },
   "kind": {
    "description": "Only this dataset kind.",
    "enum": [
     "grid",
     "snapshot",
     "feature",
     "text"
    ],
    "type": "string"
   },
   "lat": {
    "description": "Latitude of the place (with lon).",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "default": 5,
    "description": "Hits to return (1-10, default 5).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "lon": {
    "description": "Longitude of the place (with lat).",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "query": {
    "description": "The question or keywords, in the user's words.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_catalog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "The coverage filter applied: the point's domain, or `domain`.",
    "type": "string"
   },
   "hits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cadence": {
       "description": "ISO 8601 update interval.",
       "type": "string"
      },
      "call": {
       "additionalProperties": false,
       "description": "The exact call that answers from this dataset.",
       "properties": {
        "arguments": {
         "additionalProperties": {},
         "type": "object"
        },
        "tool": {
         "type": "string"
        }
       },
       "required": [
        "tool",
        "arguments"
       ],
       "type": "object"
      },
      "dataset_id": {
       "type": "string"
      },
      "entitlement": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "grid",
        "snapshot",
        "feature",
        "text"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "units": {
       "description": "Served units of `variable`.",
       "type": "string"
      },
      "variable": {
       "description": "Best-matching standard variable name.",
       "type": "string"
      },
      "why": {
       "type": "string"
      }
     },
     "required": [
      "dataset_id",
      "title",
      "kind",
      "why",
      "call"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "query": {
    "type": "string"
   }
  },
  "required": [
   "query",
   "hits"
  ],
  "type": "object"
 },
 "title": "Search catalog"
}
