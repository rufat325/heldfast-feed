{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Track Releases"},"description":"Track releases mapped to ADR decisions. Generates changelogs, manages milestones, compares releases, and assesses release readiness. Supports greenfield and brownfield projects. Writes CHANGELOG.md, creates GitHub Releases and Milestones.","inputSchema":{"properties":{"compareFrom":{"description":"Starting version for comparison","type":"string"},"compareTo":{"description":"Ending version for comparison","type":"string"},"createGithubRelease":{"default":false,"description":"Create a GitHub Release (requires gh CLI)","type":"boolean"},"format":{"default":"keep-a-changelog","description":"Changelog output format","enum":["markdown","keep-a-changelog","conventional"],"type":"string"},"groupByAdr":{"default":false,"description":"Group changelog entries by ADR","type":"boolean"},"includeAdrLinks":{"default":true,"description":"Include ADR references in changelog","type":"boolean"},"includeCommitHashes":{"default":false,"description":"Include commit hashes in output","type":"boolean"},"includeReadiness":{"default":true,"description":"Include release readiness score","type":"boolean"},"includeTimeline":{"default":true,"description":"Include mermaid timeline diagram","type":"boolean"},"localOnly":{"default":false,"description":"For create_milestone: persist locally instead of calling gh CLI. Useful when gh auth is unavailable.","type":"boolean"},"milestoneDescription":{"description":"GitHub milestone description","type":"string"},"milestoneDueDate":{"description":"Milestone due date (YYYY-MM-DD)","type":"string"},"milestoneTitle":{"description":"GitHub milestone title (for create_milestone)","type":"string"},"operation":{"description":"Operation to perform","enum":["detect_releases","track_release","generate_changelog","compare_releases","release_summary","next_release_preview","create_milestone","sync_milestones","push_local_miles