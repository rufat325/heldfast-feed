{
 "_meta": {
  "openai/outputTemplate": "ui://search-hotels/mcp-app-v13.html",
  "ui": {
   "resourceUri": "ui://search-hotels/mcp-app-v13.html"
  },
  "ui/resourceUri": "ui://search-hotels/mcp-app-v13.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Search Hotels Live"
 },
 "description": "Starts a live hotel search for a city and date range. Prices come from Agoda, Booking.com and Traveloka, plus direct rates from OpenTravel partner hotels. Returns a session ID; poll_search_results returns the results as they arrive. Optional filters narrow the results by hotel name, area or total price for the stay. Prices depend on the party: it defaults to 2 adults in 1 room, and the result states the party searched and flags when it was defaulted. When the city or dates are missing, the result is a question for the user instead of a search; the stay dates searched are echoed back for confirmation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 2,
    "description": "Number of adults (default 2). Prices depend on it.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "area": {
    "description": "Optional district, ward, or neighborhood filter within the city",
    "maxLength": 120,
    "type": "string"
   },
   "checkIn": {
    "description": "Check-in date (YYYY-MM-DD), today or later. When omitted, the result asks the user for it.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkOut": {
    "description": "Check-out date (YYYY-MM-DD), after checkIn. When omitted, the result asks the user for it.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Number of children sharing the room (default 0). OTA prices cannot include children; the result says so when children are given.",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "city": {
    "description": "City or broad destination, e.g. 'Da Nang'. When omitted, the result asks the user for it.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "hotelName": {
    "description": "Optional hotel-name filter when the user names a specific property",
    "maxLength": 200,
    "type": "string"
   },
   "language": {
    "description": "Preferred UI language (en/vi/de/ja/ko/zh/fr/es/ru/th/id).",
    "enum": [
     "en",
     "vi",
     "de",
     "ja",
     "ko",
     "zh",
     "fr",
     "es",
     "ru",
     "th",
     "id"
    ],
    "type": "string"
   },
   "priceCurrency": {
    "description": "ISO 4217 code of priceMin/priceMax (USD, EUR, VND, \u2026); defaults to the currency of the UI language.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "priceMax": {
    "description": "Maximum total price for the whole stay (not per night), in priceCurrency.",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "priceMin": {
    "description": "Minimum total price for the whole stay (not per night), in priceCurrency.",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "queryText": {
    "description": "Optional short excerpt of the current request, used only to detect the UI language; it is not stored or forwarded.",
    "maxLength": 500,
    "type": "string"
   },
   "rooms": {
    "default": 1,
    "description": "Number of rooms (default 1).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "search_hotels_live",
