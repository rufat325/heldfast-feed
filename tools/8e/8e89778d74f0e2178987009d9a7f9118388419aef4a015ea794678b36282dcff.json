{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Get one ICD-10 PL, ICD-9 PL or ICD-11 PL code as its page shows it: title, hierarchy, children, notes, attributes, ICD-9 rank, WHO map rows and, for ICD-10 and ICD-9, the JGP groups whose attachment 9 lists name it on service_date. Find the code with search_codes first; open a listed group with get_jgp_group.","inputSchema":{"$defs":{"Code":{"pattern":"^[A-Za-z0-9][A-Za-z0-9.\\-]{0,15}$","type":"string"},"System":{"enum":["icd10-pl","icd9-pl","icd11-pl"],"type":"string"}},"properties":{"code":{"$ref":"#/$defs/Code","description":"The code as printed, e.g. J18.9, 53.03 or BA00."},"service_date":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null,"description":"Day of care, YYYY-MM-DD; picks the release in force. Default today in Poland."},"system":{"$ref":"#/$defs/System","description":"Classification of the code."}},"required":["system","code"],"type":"object"},"name":"get_code","outputSchema":{"$defs":{"Json":{"additionalProperties":true,"type":"object"}},"additionalProperties":true,"properties":{"attributes":{"additionalProperties":{"type":"string"},"type":"object"},"children":{"items":{"$ref":"#/$defs/Json"},"type":"array"},"children_truncated":{"type":"boolean"},"code":{"type":"string"},"jgp_lists":{"anyOf":[{"$ref":"#/$defs/Json"},{"type":"null"}],"default":null},"notes":{"$ref":"#/$defs/Json"},"notice":{"type":"string"},"path":{"items":{"$ref":"#/$defs/Json"},"type":"array"},"procedure_rank":{"anyOf":[{"$ref":"#/$defs/Json"},{"type":"null"}],"default":null},"release":{"$ref":"#/$defs/Json"},"system":{"type":"string"},"title":{"type":"string"},"who_map_rows":{"default":[],"items":{"$ref":"#/$defs/Json"},"type":"array"}},"required":["notice","system","code","release","title","path","children","children_truncated","notes","attributes"],"type":"object"},"title":"Code details"}
