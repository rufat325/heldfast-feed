{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "orders.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a hosted Cashfree or PhonePe checkout after signed-in browser approval, reserving stock/rewards and clearing the active cart. Synchronizes any active payment first and may finalize an already-paid order. No payment is captured by this tool.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "billing_address": {
    "maxLength": 500,
    "minLength": 10,
    "type": "string"
   },
   "confirmation_id": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "coupon_code": {
    "maxLength": 50,
    "type": "string"
   },
   "idempotency_key": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "payment_method": {
    "enum": [
     "cashfree",
     "phonepe",
     "online"
    ],
    "type": "string"
   },
   "payment_mode": {
    "enum": [
     "upi",
     "card",
     "netbanking",
     "wallet",
     "international_card"
    ],
    "type": "string"
   },
   "points_to_redeem": {
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "shipping_address": {
    "maxLength": 500,
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "payment_method",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "start_checkout",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "propertyNames": {
   "type": "string"
  },
  "type": "object"
 },
 "title": "Start Checkout"
}
