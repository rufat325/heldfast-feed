{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read reported financial facts"
 },
 "description": "Read XBRL facts tagged to one filing's accession, covering the API's ten supported concepts. Returns up to 200 reported values with units and periods. It does not return all company periods or calculate investment advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filing_id": {
    "pattern": "^\\d{1,10}-\\d{18}$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "filing_id"
  ],
  "type": "object"
 },
 "name": "filing_facts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "type": "string"
   },
   "company": {
    "additionalProperties": false,
    "properties": {
     "cik": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "fiscalYearEnd": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "sic": {
      "type": "string"
     },
     "sicDescription": {
      "type": "string"
     },
     "ticker": {
      "type": "string"
     }
    },
    "required": [
     "cik",
     "ticker",
     "name"
    ],
    "type": "object"
   },
   "docs_url": {
    "type": "string"
   },
   "error": {
    "maxLength": 80,
    "type": "string"
   },
   "facts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession": {
       "type": "string"
      },
      "concept": {
       "type": "string"
      },
      "end": {
       "type": "string"
      },
      "filed": {
       "type": "string"
      },
      "form": {
       "type": "string"
      },
      "fp": {
       "type": "string"
      },
      "friendly": {
       "type": "string"
      },
      "fy": {
       "type": "number"
      },
      "start": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "concept",
      "value",
      "unit",
      "end",
      "form",
      "filed",
      "accession"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   },
   "filing": {
    "additionalProperties": false,
    "properties": {
     "accession": {
      "type": "string"
     },
     "filingDate": {
      "type": "string"
     },
     "form": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "reportDate": {
      "type": "string"
     },
     "sourceUrl": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "form",
     "accession",
     "filingDate",
     "reportDate",
     "sourceUrl"
    ],
    "type": "object"
   },
   "http_status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "message": {
    "type": "string"
   },
   "retry_after": {
    "maxLength": 80,
    "type": "string"
   },
   "status": {
    "enum": [
     "success",
     "tool_error",
     "internal_error"
    ],
    "type": "string"
   },
   "total_facts": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   },
   "usage": {
    "additionalProperties": {
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "status",
   "docs_url"
  ],
  "type": "object"
 },
 "title": "Read reported financial facts"
}
