{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One story with its full body (what changed, who it affects, key dates with precision, what happened, not yet known, why it matters, first reported by), sources, label history and corrections.",
 "inputSchema": {
  "properties": {
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_story",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "properties": {
     "affects": {
      "description": "sectors and functions the event affects",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "aiDisclosure": {
      "type": [
       "string",
       "null"
      ]
     },
     "aiGenerated": {
      "description": "true: the text is AI-generated from the listed sources (EU AI Act Art. 50(4) label); false only for wire_link items",
      "type": "boolean"
     },
     "attribution": {
      "type": "string"
     },
     "disclosure": {
      "enum": [
       "ai",
       "reviewed",
       "link"
      ],
      "type": "string"
     },
     "format": {
      "description": "one of breaking, model_drop, the_number, money, explainer, rumor, for_the_minutes, standard, wire_link; wire_link = an outlet's headline and a link to its report, no text by Minutes of AI",
      "type": "string"
     },
     "headline": {
      "type": "string"
     },
     "label": {
      "properties": {
       "code": {
        "type": "string"
       },
       "text": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "text"
      ],
      "type": "object"
     },
     "lane": {
      "description": "builders: SDK and library releases, checkpoints, repository signals",
      "enum": [
       "business",
       "builders",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "lede": {
      "type": [
       "string",
       "null"
      ]
     },
     "outletCount": {
      "description": "distinct outlets in sources",
      "type": "integer"
     },
     "publishedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "slug": {
      "type": "string"
     },
     "sourceCount": {
      "description": "entries in sources (one per page)",
      "type": "integer"
     },
     "sources": {
      "items": {
       "properties": {
        "isPrimary": {
         "type": "boolean"
        },
        "outlet": {
         "type": "string"
        },
        "publishedAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "quote": {
         "type": [
          "string",
          "null"
         ]
        },
        "title": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "outlet",
        "url",
        "isPrimary"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "state": {
      "type": "string"
     },
     "updatedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string"
     },
     "wireLink": {
      "description": "wire_link only: {outlet, url, originalHeadline, publishedAt, supersededBy}",
      "type": "object"
     }
    },
    "required": [
     "slug",
     "url",
     "headline",
     "format",
     "label",
     "publishedAt",
     "updatedAt",
     "sources",
     "aiGenerated",
     "attribution"
    ],
    "type": "object"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Story by slug"
}
