{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "llm",
 "description": "Compress an LLM prompt by removing filler words, verbose phrases, duplicate sentences, and unnecessary whitespace. Returns optimized text with token savings breakdown. 100% deterministic, no API key needed.",
 "inputSchema": {
  "properties": {
   "options": {
    "description": "Toggle optimization steps (all true by default)",
    "properties": {
     "duplicates": {
      "default": true,
      "type": "boolean"
     },
     "fillers": {
      "default": true,
      "type": "boolean"
     },
     "instructions": {
      "default": true,
      "type": "boolean"
     },
     "whitespace": {
      "default": true,
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "text": {
    "description": "The prompt text to optimize",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "optimize_prompt_tokens",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "optimized": {},
   "percent_saved": {
    "type": "string"
   },
   "steps": {},
   "tokens_after": {},
   "tokens_before": {},
   "tokens_saved": {}
  },
  "type": "object"
 }
}
