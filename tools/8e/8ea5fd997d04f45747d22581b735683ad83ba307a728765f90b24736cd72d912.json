{
 "description": "Create interactive HTML prototypes with screen flows, navigation, and transitions. Output is a standalone HTML file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
   "__schema0": {
    "properties": {
     "action": {
      "type": "string"
     },
     "children": {
      "items": {
       "$ref": "#/definitions/__schema0"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "placeholder": {
      "type": "string"
     },
     "styles": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "type": {
      "enum": [
       "heading",
       "text",
       "button",
       "input",
       "image",
       "card",
       "nav",
       "list",
       "container",
       "icon",
       "divider"
      ],
      "type": "string"
     }
    },
    "required": [
     "id",
     "type"
    ],
    "type": "object"
   }
  },
  "properties": {
   "brand_identity": {
    "description": "JSON string from branding-mcp generate_brand_identity. Overrides design context with brand tokens.",
    "type": "string"
   },
   "design_context": {
    "description": "Optional design context override",
    "properties": {
     "borderRadius": {},
     "colorPalette": {},
     "shadows": {},
     "spacing": {},
     "typography": {}
    },
    "type": "object"
   },
   "navigation_flow": {
    "description": "Navigation flow between screens",
    "items": {
     "properties": {
      "animation": {
       "enum": [
        "fade",
        "slide-left",
        "slide-right",
        "slide-up",
        "none"
       ],
       "type": "string"
      },
      "from": {
       "type": "string"
      },
      "targetElement": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "trigger": {
       "enum": [
        "click",
        "tap",
        "hover",
        "auto"
       ],
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "trigger"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "output_format": {
    "default": "html",
    "description": "Output format",
    "enum": [
     "html",
     "html_bundle"
    ],
    "type": "string"
   },
   "screens": {
    "description": "Array of screens with their elements",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "elements": {
       "items": {
        "$ref": "#/definitions/__schema0"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "elements"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "screens",
   "navigation_flow"
  ],
  "type": "object"
 },
 "name": "generate_prototype"
}
