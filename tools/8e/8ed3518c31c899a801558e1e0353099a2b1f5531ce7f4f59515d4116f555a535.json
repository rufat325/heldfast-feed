{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Resolve a subaccount by name or ID and transfer credits to it (POST /user/limit/transfer_credits). Checks the parent balance first. dry_run=true (default) previews the transfer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "credits": {
    "description": "Number of credits to transfer",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = transfer",
    "type": "boolean"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "subaccount_ref": {
    "description": "Subaccount name or ID",
    "type": "string"
   }
  },
  "required": [
   "subaccount_ref",
   "credits"
  ],
  "type": "object"
 },
 "name": "panda_action_transfer_credits_to_subaccount",
 "title": "Transfer Credits to Subaccount"
}
