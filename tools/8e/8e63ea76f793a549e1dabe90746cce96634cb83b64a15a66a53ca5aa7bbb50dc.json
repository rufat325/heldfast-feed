{
 "_meta": {
  "openai/outputTemplate": "ui://astra-db/app.html",
  "ui": {
   "resourceUri": "ui://astra-db/app.html"
  },
  "ui/resourceUri": "ui://astra-db/app.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Vector search"
 },
 "description": "Similarity search by natural-language `query` (server-side vectorize), an explicit `vector`, or `documentId` (more like this). `hybrid` combines vector and lexical (BM25) results with reranking on collections that have both. A filter narrows candidates. Returns ranked hits with similarity scores; renders an interactive results view.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "database": {
    "description": "Database to use: name, id, or Data API endpoint URL. Omit for the configured default.",
    "minLength": 1,
    "type": "string"
   },
   "documentId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Find items similar to this existing document (collections)."
   },
   "emit": {
    "default": "structured",
    "description": "html_file also writes a self-contained HTML page and returns a link to it \u2014 only for terminal-only hosts, when the user asks for a visual.",
    "enum": [
     "structured",
     "html_file"
    ],
    "type": "string"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Data API filter, e.g. {\"status\": \"active\", \"year\": {\"$gte\": 2020}}. Typed ids as {\"$uuid\": \"\u2026\"} / {\"$objectId\": \"\u2026\"}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "hybrid": {
    "default": false,
    "description": "Collections with lexical + rerank: combined vector + BM25 search, reranked.",
    "type": "boolean"
   },
   "idType": {
    "default": "auto",
    "description": "How to interpret documentId (auto follows the collection's defaultId).",
    "enum": [
     "auto",
     "string",
     "uuid",
     "objectId"
    ],
    "type": "string"
   },
   "keyspace": {
    "description": "Keyspace. Omit for the configured/default keyspace.",
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "description": "Only needed when a collection and a table share the name; otherwise detected.",
    "enum": [
     "collection",
     "table"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "How many hits.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Collection or table name.",
    "minLength": 1,
    "type": "string"
   },
   "projection": {
    "additionalProperties": {
     "anyOf": [
      {
       "const": 0,
       "type": "number"
      },
      {
       "const": 1,
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "description": "Fields to include (1) or exclude (0), e.g. {\"title\": 1, \"author\": 1}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "query": {
    "description": "Natural-language text; embedded server-side (vectorize).",
    "minLength": 1,
    "type": "string"
   },
   "vector": {
    "description": "A query embedding (must match the dimension).",
    "items": {
     "type": "number"
    },
    "minItems": 2,
    "type": "array"
   },
   "vectorColumn": {
    "description": "Tables only: which vector column to search (default: the only one).",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "vector_search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "type": [
     "string",
     "null"
    ]
   },
   "endpoint": {
    "description": "Data API endpoint of the database this came from; pass it as `database` in follow-up calls.",
    "type": "string"
   },
   "hits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "document": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "fields": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "idValue": {},
      "rank": {
       "type": "number"
      },
      "scores": {
       "additionalProperties": {
        "type": "number"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "similarity": {
       "type": [
        "number",
        "null"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "rank",
      "id",
      "idValue",
      "similarity",
      "title",
      "fields",
      "document"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "keyspace": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "collection",
     "table"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "mode": {
    "enum": [
     "vectorize",
     "vector",
     "document",
     "hybrid"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "query": {
    "type": [
     "string",
     "null"
    ]
   },
   "stats": {
    "additionalProperties": false,
    "properties": {
     "max": {
      "type": [
       "number",
       "null"
      ]
     },
     "mean": {
      "type": [
       "number",
       "null"
      ]
     },
     "min": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "max",
     "min",
     "mean"
    ],
    "type": "object"
   },
   "view": {
    "const": "similarity",
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "view",
   "keyspace",
   "name",
   "kind",
   "mode",
   "query",
   "documentId",
   "limit",
   "hits",
   "stats",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Vector search"
}
