{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List rated services"
 },
 "description": "List services that have been rated, sorted by trust score, with their per-dimension breakdown. Use it to pick a service that others have already measured rather than gambling on an unknown one, or to find an alternative when the service you were going to use scores badly. Filter on min_score and min_ratings together: a high score backed by one rating is an opinion, the same score backed by many is evidence.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of results (default 20, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "min_ratings": {
    "description": "Minimum number of ratings filter",
    "minimum": 0,
    "type": "number"
   },
   "min_score": {
    "description": "Minimum trust score filter (0.0-1.0)",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "sort_by": {
    "description": "Sort field (default: score)",
    "enum": [
     "score",
     "ratings_count",
     "last_rated"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_services",
 "outputSchema": {
  "properties": {
   "count": {
    "minimum": 0,
    "type": "integer"
   },
   "services": {
    "items": {
     "properties": {
      "confidence": {
       "type": [
        "number",
        "null"
       ]
      },
      "dimensions": {
       "properties": {
        "availability": {
         "type": "number"
        },
        "conformity": {
         "type": "number"
        },
        "latency": {
         "type": "number"
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "ratings_count": {
       "type": "integer"
      },
      "score": {
       "type": "number"
      },
      "service": {
       "type": "string"
      },
      "service_supports_receipts": {
       "type": "boolean"
      },
      "trust_level": {
       "enum": [
        "HIGH",
        "MODERATE",
        "LOW",
        "UNKNOWN"
       ],
       "type": "string"
      }
     },
     "required": [
      "service",
      "score",
      "trust_level",
      "ratings_count"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "services"
  ],
  "type": "object"
 }
}
