{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete a DNS record from an Infomaniak-managed zone. Two-phase commit: first call returns a plan with a preview of the record to delete + token, second call (same params + token) actually deletes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the first (plan) phase. The plan response includes a full preview of the record so you can verify before confirming. Re-pass to execute.",
    "format": "uuid",
    "type": "string"
   },
   "record_id": {
    "description": "Numeric id of the record to delete. Get it from infomaniak_dns_list_records \u2192 records[].id. NOT the record name or source.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "zone": {
    "description": "DNS zone (root domain) the record belongs to, e.g. 'broz.be'. Must be a domain whose DNS is managed by Infomaniak.",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "zone",
   "record_id"
  ],
  "type": "object"
 },
 "name": "infomaniak_dns_delete_record",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "record_id": {
        "type": "number"
       },
       "record_preview": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "type": "number"
         },
         "source": {
          "type": "string"
         },
         "target": {
          "type": "string"
         },
         "ttl": {
          "minimum": 0,
          "type": "integer"
         },
         "type": {
          "enum": [
           "A",
           "AAAA",
           "CNAME",
           "MX",
           "TXT",
           "SRV",
           "NS",
           "CAA",
           "PTR",
           "SPF"
          ],
          "type": "string"
         },
         "updated_at": {
          "type": "number"
         }
        },
        "required": [
         "source",
         "type",
         "ttl",
         "target"
        ],
        "type": "object"
       },
       "zone": {
        "type": "string"
       }
      },
      "required": [
       "zone",
       "record_id",
       "record_preview"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "deleted_record_id": {
      "type": "number"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "deleted_record_id",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
