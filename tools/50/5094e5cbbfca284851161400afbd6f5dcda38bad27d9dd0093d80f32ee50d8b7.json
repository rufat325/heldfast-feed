{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recent changes"
 },
 "description": "Companies newly listed as customers by tool vendors in the last N days, optionally for one tool. Departures are not published.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "description": "Window in days (default 30, max 365).",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "description": "Rows to list (default 25, max 100). The usedby page has the full list.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "tool": {
    "description": "Only this tool (slug or name).",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "recent_changes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "counts": {
    "additionalProperties": {},
    "properties": {
     "companies": {
      "type": "number"
     },
     "lines": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "error": {
    "description": "Set only when the input matched nothing or was invalid.",
    "enum": [
     "not_found",
     "bad_request",
     "rate_limited",
     "internal_error"
    ],
    "type": "string"
   },
   "listed": {
    "description": "Companies newly listed as customers, newest first.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "company": {
       "type": "string"
      },
      "companySlug": {
       "type": "string"
      },
      "listedAfter": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "listedBy": {
       "type": "string"
      },
      "proof": {
       "description": "Proof level, strongest first: CONFIRMED, DECLARED (the company states it), OBSERVED, SIGNAL (a job post, the weakest).",
       "enum": [
        "CONFIRMED",
        "DECLARED",
        "OBSERVED",
        "SIGNAL"
       ],
       "type": "string"
      },
      "tool": {
       "type": "string"
      },
      "toolSlug": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "description": "What went wrong, with the next step, when error is set.",
    "type": "string"
   },
   "notes": {
    "description": "How to read this answer.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "additionalProperties": {},
    "description": "The usedby page to cite: quote with a link to source.url.",
    "properties": {
     "citation": {
      "type": "string"
     },
     "markdown": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "terms": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "suggestions": {
    "description": "Close matches to ask again with, when error is not_found.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "tool": {
    "anyOf": [
     {
      "additionalProperties": {},
      "description": "The tool, with its usedby page.",
      "properties": {
       "name": {
        "type": "string"
       },
       "slug": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "tracking": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "activeTools": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "trackedTools": {
        "type": "number"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "How many tools are watched for changes."
   },
   "truncated": {
    "type": "boolean"
   },
   "window": {
    "additionalProperties": {},
    "description": "The period covered.",
    "properties": {
     "days": {
      "type": "number"
     },
     "since": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "source"
  ],
  "type": "object"
 },
 "title": "Recent changes"
}
