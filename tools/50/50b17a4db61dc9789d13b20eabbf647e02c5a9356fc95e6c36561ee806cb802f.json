{
 "description": "Register a key control with its type, frequency, linked risks, assertions and COSO principles.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assertions": {
    "default": [],
    "items": {
     "enum": [
      "completeness",
      "existence-occurrence",
      "accuracy",
      "valuation",
      "obligations-rights",
      "presentation-disclosure"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "frequency": {
    "enum": [
     "annual",
     "quarterly",
     "monthly",
     "weekly",
     "daily",
     "per-transaction"
    ],
    "type": "string"
   },
   "key": {
    "default": true,
    "type": "boolean"
   },
   "owner": {
    "type": "string"
   },
   "principles": {
    "default": [],
    "items": {
     "maximum": 17,
     "minimum": 1,
     "type": "integer"
    },
    "type": "array"
   },
   "riskIds": {
    "default": [],
    "items": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
     "type": "string"
    },
    "type": "array"
   },
   "scopeItemId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "type": {
    "enum": [
     "manual",
     "automated",
     "it-dependent-manual"
    ],
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "description",
   "type",
   "frequency"
  ],
  "type": "object"
 },
 "name": "register_control",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "control": {}
  },
  "required": [
   "control"
  ],
  "type": "object"
 },
 "title": "Register a control"
}
