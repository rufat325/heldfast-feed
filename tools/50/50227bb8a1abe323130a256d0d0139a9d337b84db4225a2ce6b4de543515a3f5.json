{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Build a cited research brief with retained notice requirements, exact award-number candidates and same-industry comparisons. Does not infer an incumbent or eligibility.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "generation": {
    "description": "Retained generation UUID from search_opportunities.",
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "description": "Stable opportunity ID returned by search_opportunities.",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "research_opportunity",
 "outputSchema": {
  "$defs": {
   "AwardSummary": {
    "properties": {
     "data": {
      "$ref": "#/$defs/JsonObject"
     },
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "vendor_url": {
      "description": "Vendor path when an exact recipient UEI is available.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "title",
     "data",
     "url"
    ],
    "type": "object"
   },
   "BriefRequirements": {
    "properties": {
     "scope": {
      "type": "string"
     },
     "source": {
      "anyOf": [
       {
        "$ref": "#/$defs/JsonObject"
       },
       {
        "type": "null"
       }
      ],
      "description": "Notice provenance for the retained text."
     },
     "text": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "scope"
    ],
    "type": "object"
   },
   "JsonObject": {
    "description": "Source-specific JSON map. The envelope is stable; map keys vary by official source.",
    "type": "object"
   },
   "RecordDetail": {
    "properties": {
     "collection": {
      "description": "Absent for curated reference records.",
      "type": [
       "string",
       "null"
      ]
     },
     "data": {
      "$ref": "#/$defs/JsonObject"
     },
     "generation": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "text_has_more": {
      "description": "Whether another text chunk is available.",
      "type": [
       "boolean",
       "null"
      ]
     },
     "text_length": {
      "description": "Total text characters; absent from internal brief notices.",
      "format": "uint",
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "generation",
     "id",
     "title",
     "text",
     "data"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "comparison_awards": {
    "items": {
     "$ref": "#/$defs/AwardSummary"
    },
    "type": "array"
   },
   "generation": {
    "type": "string"
   },
   "linked_awards": {
    "items": {
     "$ref": "#/$defs/AwardSummary"
    },
    "type": "array"
   },
   "next_steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "$ref": "#/$defs/RecordDetail"
   },
   "relationship_basis": {
    "type": "string"
   },
   "requirements": {
    "$ref": "#/$defs/BriefRequirements"
   }
  },
  "required": [
   "generation",
   "notice",
   "linked_awards",
   "comparison_awards",
   "relationship_basis",
   "requirements",
   "next_steps"
  ],
  "type": "object"
 },
 "title": "Research an opportunity"
}
