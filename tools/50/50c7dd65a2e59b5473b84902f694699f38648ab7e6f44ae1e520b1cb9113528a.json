  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "period": {
    "description": "point spacing (default \"1h\")",
    "type": "string"
   },
   "ref": {
    "description": "asset reference as network:identifier [required]",
    "type": "string"
   },
   "span": {
    "description": "how many points (max 720) (default 48)",
    "type": "string"
   }
  },
  "required": [
   "ref"
  ],
  "type": "object"
 },
 "name": "market_llama_asset_price_history",
