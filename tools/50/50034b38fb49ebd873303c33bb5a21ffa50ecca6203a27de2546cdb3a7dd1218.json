{
 "description": "Render a .riv animation (or state machine idle playback) to an animated GIF file for preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "animation": {
    "description": "Animation name (default: first state machine or animation)",
    "type": "string"
   },
   "artboard": {
    "type": "string"
   },
   "background": {
    "description": "CSS background color (default white \u2014 GIF has no alpha)",
    "type": "string"
   },
   "duration": {
    "description": "Seconds to render (default 2)",
    "exclusiveMinimum": 0,
    "maximum": 30,
    "type": "number"
   },
   "fps": {
    "description": "Frames per second (default 20)",
    "exclusiveMinimum": 0,
    "maximum": 60,
    "type": "integer"
   },
   "outPath": {
    "description": "Output GIF path (default: alongside the .riv)",
    "type": "string"
   },
   "path": {
    "description": "Path to the .riv file",
    "type": "string"
   },
   "stateMachine": {
    "type": "string"
   },
   "width": {
    "description": "Output width (default: artboard width, capped 800)",
    "exclusiveMinimum": 0,
    "maximum": 2048,
    "type": "integer"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "riv_render_gif",
 "title": "Render an animation to GIF"
}
