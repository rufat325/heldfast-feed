{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Score freshness of AI-cited pages"
 },
 "description": "Score how recent the pages cited for a query are. Calls check_citations, then collects dateModified for each cited URL, returns a 0-100 recency_score (halflife=365d) plus per-URL freshness bucket (fresh/current/stale/ancient/unknown). Surfaces queries where AI cites old content - opportunity to ship fresher.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "engine": {
    "default": "auto",
    "description": "AI engine to query for the citation set.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode",
     "auto"
    ],
    "type": "string"
   },
   "max_results": {
    "default": 10,
    "description": "How many cited URLs to inspect.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query whose cited URLs to score for freshness.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "citations_freshness",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "average_days_old": {
    "description": "Mean age in days across URLs with a detectable dateModified.",
    "type": [
     "number",
     "null"
    ]
   },
   "buckets": {
    "additionalProperties": false,
    "description": "Freshness bucket distribution.",
    "properties": {
     "ancient": {
      "description": "URLs older than 730 days.",
      "type": "number"
     },
     "current": {
      "description": "URLs modified within 181-365 days.",
      "type": "number"
     },
     "fresh": {
      "description": "URLs modified within 180 days.",
      "type": "number"
     },
     "stale": {
      "description": "URLs modified within 366-730 days.",
      "type": "number"
     },
     "unknown": {
      "description": "URLs with no detectable modification date.",
      "type": "number"
     }
    },
    "required": [
     "fresh",
     "current",
     "stale",
     "ancient",
     "unknown"
    ],
    "type": "object"
   },
   "engine": {
    "description": "Engine used.",
    "type": "string"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "per_url": {
    "description": "Per-URL freshness details.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "The query whose citations were scored.",
    "type": "string"
   },
   "recency_score": {
    "description": "0-100 average recency weight across cited URLs (halflife=365d).",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "query",
   "engine",
   "fetched_at",
   "recency_score",
   "average_days_old",
   "buckets",
   "per_url"
  ],
  "type": "object"
 }
}
