{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Start a timer. Pass seconds for a countdown (1 to 3600), or leave seconds out for a stopwatch that counts up until stop_timer. Returns the timer id (TMR-1). There is no get_timer: read state, elapsed_ms and remaining_ms with run_query schema=timers and filter {\"id\":\"TMR-1\"}. Do not poll in a loop; query again after the countdown ends.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "label": {
    "description": "Optional name for the timer, e.g. demo or break.",
    "maxLength": 60,
    "type": "string"
   },
   "seconds": {
    "description": "Countdown length in seconds, 1 to 3600. Leave out for a stopwatch that counts up.",
    "maximum": 3600,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "start_timer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "timer": {
    "additionalProperties": false,
    "properties": {
     "elapsed_ms": {
      "type": "number"
     },
     "ends_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "remaining_ms": {
      "type": [
       "number",
       "null"
      ]
     },
     "seconds": {
      "type": [
       "number",
       "null"
      ]
     },
     "started_at": {
      "type": "string"
     },
     "state": {
      "enum": [
       "running",
       "finished",
       "stopped"
      ],
      "type": "string"
     },
     "stopped_at": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "label",
     "seconds",
     "state",
     "started_at",
     "ends_at",
     "stopped_at",
     "elapsed_ms",
     "remaining_ms"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "timer"
  ],
  "type": "object"
 }
}
