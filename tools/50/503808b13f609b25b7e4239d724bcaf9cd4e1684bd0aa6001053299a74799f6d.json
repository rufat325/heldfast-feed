{
 "description": "Push a batch of episodes (max 500) to an RL-environment feedback project. Accepts verifiers rollouts ({prompt, completion, trajectory, reward, metrics}), OpenEnv episodes ({steps: [{observation, action, reward, done}]}), or generic chat transcripts. Requires rlenv:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environmentId": {
    "minLength": 1,
    "type": "string"
   },
   "episodes": {
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "environmentId",
   "projectId",
   "episodes"
  ],
  "type": "object"
 },
 "name": "opentrain_rlenv_push_episodes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
