{
 "description": "Create a new internal-control review engagement. Returns the engagement id used by all later tools.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entity": {
    "description": "Entity or business unit under review.",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Optional explicit engagement id.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "materiality": {
    "properties": {
     "amount": {
      "type": "number"
     },
     "basis": {
      "type": "string"
     },
     "currency": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "period": {
    "description": "Review period, e.g. 2025 or 2025-H2.",
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "description": "Engagement title.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "entity"
  ],
  "type": "object"
 },
 "name": "create_engagement",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "engagement": {
    "additionalProperties": false,
    "properties": {
     "createdAt": {
      "type": "string"
     },
     "entity": {
      "type": "string"
     },
     "framework": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "period": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "updatedAt": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "entity",
     "framework",
     "status",
     "createdAt",
     "updatedAt"
    ],
    "type": "object"
   }
  },
  "required": [
   "engagement"
  ],
  "type": "object"
 },
 "title": "Create an engagement"
}
