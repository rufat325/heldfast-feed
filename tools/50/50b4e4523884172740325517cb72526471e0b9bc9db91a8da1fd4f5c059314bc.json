{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add an item to the wishlist with price range, priority, and optional URL.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category",
    "type": "string"
   },
   "currency": {
    "description": "3-letter currency code, e.g. GBP. Defaults to the user's currency",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "name": {
    "description": "Item name",
    "type": "string"
   },
   "notes": {
    "description": "Notes",
    "type": "string"
   },
   "price_max": {
    "description": "Maximum price",
    "type": "number"
   },
   "price_min": {
    "description": "Minimum price",
    "type": "number"
   },
   "priority": {
    "description": "Priority",
    "enum": [
     "high",
     "medium",
     "low",
     "waiting"
    ],
    "type": "string"
   },
   "url": {
    "description": "Product URL",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "add_wishlist_item",
 "title": "Add wishlist item"
}
