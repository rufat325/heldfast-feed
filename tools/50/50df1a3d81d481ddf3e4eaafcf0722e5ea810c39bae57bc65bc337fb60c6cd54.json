  "readOnlyHint": true,
  "title": "Apdex Score Calculator"
 },
 "description": "Use this when a user asks about their Apdex score or wants to measure user satisfaction with response times. Takes satisfied, tolerating, and total request counts; satisfied plus tolerating may not exceed total. Returns the Apdex score (0\u20131) and its rating on the published five-band scale: excellent, good, fair, poor or unacceptable.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "satisfied": {
    "description": "Requests answered within the target threshold T.",
    "examples": [
     850
    ],
    "minimum": 0,
    "type": "number"
   },
   "tolerating": {
    "description": "Requests answered between T and 4T.",
    "examples": [
     100
    ],
    "minimum": 0,
    "type": "number"
   },
   "total": {
    "description": "All requests in the sample, including frustrated ones (slower than 4T or failed).",
    "examples": [
     1000
    ],
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "satisfied",
   "tolerating",
   "total"
  ],
  "type": "object"
 },
 "name": "apdex-score-calculator",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affiliate_context": {
