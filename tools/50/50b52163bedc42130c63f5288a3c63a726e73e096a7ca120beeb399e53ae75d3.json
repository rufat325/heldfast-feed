{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Ticker event history"
 },
 "description": "Recent tape events for one ticker with each event's measured reaction. Use to answer 'what has been driving <ticker> lately'.",
 "inputSchema": {
  "properties": {
   "days": {
    "description": "Look-back window in days (1-60, default 7).",
    "type": "integer"
   },
   "limit": {
    "description": "Max results (1-50, default 20).",
    "type": "integer"
   },
   "ticker": {
    "description": "Ticker symbol, e.g. WDAY.",
    "type": "string"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "ticker_history",
 "outputSchema": {
  "properties": {
   "error": {
    "type": "string"
   },
   "events": {
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "context": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "headline": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "impact": {
       "type": "string"
      },
      "market_reaction": {
       "properties": {
        "instruments": {
         "items": {
          "properties": {
           "label": {
            "description": "Display name of the measured series.",
            "type": "string"
           },
           "move_10m_pct": {
            "description": "Percent move 10 minutes after the headline, measured from price_before.",
            "type": [
             "number",
             "null"
            ]
           },
           "move_1m_pct": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_1m": {
            "type": [
             "number",
             "null"
            ]
           },
           "price_before": {
            "description": "Price immediately before the headline crossed.",
            "type": [
             "number",
             "null"
            ]
           },
           "symbol": {
            "type": "string"
           },
           "volume_quality": {
            "type": [
             "string",
             "null"
            ]
           },
           "volume_ratio_10m": {
            "type": [
             "number",
             "null"
            ]
           },
           "window_minutes": {
            "type": "integer"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "measured_from": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "published_utc": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "tickers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "why": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "headline"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ticker": {
    "type": "string"
   },
   "window_days": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Ticker event history"
}
