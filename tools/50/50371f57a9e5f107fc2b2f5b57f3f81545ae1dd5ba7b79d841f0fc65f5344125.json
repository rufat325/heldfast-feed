{
 "annotations": {
  "readOnlyHint": true,
  "title": "Check Anomaly"
 },
 "description": "Check if observed behavior from an MCP server is anomalous compared to baselines. Use this when a server seems slow, unreliable, or returns unexpected results. Returns whether the behavior deviates significantly from normal patterns.",
 "inputSchema": {
  "properties": {
   "observed_latency_ms": {
    "description": "The latency you observed",
    "type": "number"
   },
   "observed_success_rate": {
    "description": "Success rate you've observed (0.0 to 1.0)",
    "type": "number"
   },
   "server_url": {
    "description": "The MCP server URL to check",
    "type": "string"
   }
  },
  "required": [
   "server_url"
  ],
  "type": "object"
 },
 "name": "check_anomaly",
 "outputSchema": {
  "properties": {
   "anomalies": {
    "items": {
     "properties": {
      "detail": {
       "description": "Human-readable explanation",
       "type": "string"
      },
      "metric": {
       "description": "Which metric is anomalous (latency, success_rate)",
       "type": "string"
      },
      "severity": {
       "description": "high or medium",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "is_anomalous": {
    "description": "Whether behavior is anomalous",
    "type": "boolean"
   },
   "recommendation": {
    "type": "string"
   },
   "server_baselines": {
    "properties": {
     "avg_latency_ms": {
      "type": "number"
     },
     "success_rate": {
      "type": "number"
     },
     "total_data_points": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "server_url": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
