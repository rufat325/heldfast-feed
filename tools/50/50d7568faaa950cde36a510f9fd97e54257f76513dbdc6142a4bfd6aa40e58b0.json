{
 "description": "List alerts \u2014 Returns alerts for the authenticated application, newest first.\n\nFilters:\n- `status=triggered|resolved` \u2014 useful for an agent checking \"what is currently firing?\"\n- `metric=error_rate|latency|cost|evaluation_score` \u2014 filter to one metric type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environment_id": {
    "type": "string"
   },
   "limit": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "metric": {
    "enum": [
     "error_rate",
     "latency",
     "cost",
     "evaluation_score"
    ],
    "type": "string"
   },
   "offset": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "triggered",
     "resolved"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_alerts"
}
