{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit paid feedback, a symbol request, bug report, or integration suggestion to ForgeMesh Crypto Signals. Costs $0.005 USDC.",
 "inputSchema": {
  "properties": {
   "contact": {
    "description": "Optional contact handle or email",
    "type": "string"
   },
   "endpoint": {
    "description": "Optional related ForgeMesh Crypto endpoint path",
    "type": "string"
   },
   "message": {
    "description": "Feedback message, up to 2,000 characters",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "symbol": {
    "description": "Optional related symbol",
    "type": "string"
   },
   "type": {
    "description": "Feedback category (default general)",
    "enum": [
     "general",
     "symbol_request",
     "logic_suggestion",
     "bug",
     "integration",
     "hello"
    ],
    "type": "string"
   }
  },
  "required": [
   "message"
  ],
  "type": "object"
 },
 "name": "submit_crypto_feedback"
}
