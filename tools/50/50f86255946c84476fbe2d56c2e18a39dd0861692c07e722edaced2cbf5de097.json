{
 "description": "Estimate the credit cost before generating. Video length is derived from script or scriptLength; durationSeconds is accepted only for backwards compatibility and is ignored.",
 "inputSchema": {
  "additionalProperties": false,
  "allOf": [
   {
    "oneOf": [
     {
      "required": [
       "videoModel"
      ]
     },
     {
      "required": [
       "presetSlug"
      ]
     }
    ]
   },
   {
    "anyOf": [
     {
      "required": [
       "script"
      ]
     },
     {
      "required": [
       "scriptLength"
      ]
     }
    ]
   }
  ],
  "properties": {
   "durationSeconds": {
    "description": "Deprecated and ignored; retained for backwards compatibility.",
    "minimum": 1,
    "type": "number"
   },
   "presetSlug": {
    "description": "Preset slug instead of videoModel.",
    "type": "string"
   },
   "script": {
    "minLength": 1,
    "type": "string"
   },
   "scriptLength": {
    "minimum": 1,
    "type": "number"
   },
   "useNativeAudio": {
    "default": false,
    "type": "boolean"
   },
   "videoModel": {
    "description": "Model id returned by list_models.",
    "type": "string"
   },
   "voiceModel": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "estimate_video_cost"
}
