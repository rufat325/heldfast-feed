{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search orders"
 },
 "description": "Find orders in a date range (at most 35 days) or by a list of orderNo/id, optionally filtered by status (e.g. failed, rejected, unscheduled), with order data and/or scheduling info. Up to 500 per page; pass the returned after_tag with the SAME other parameters to get the next page. Read-only despite using POST. OptimoRoute: POST /search_orders.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "after_tag": {
    "description": "Cursor from the previous page's after_tag.",
    "type": "string"
   },
   "dateRange": {
    "description": "A date range, e.g. {\"from\": \"2026-09-28\", \"to\": \"2026-10-02\"}.",
    "properties": {
     "from": {
      "description": "Date in YYYY-MM-DD format, e.g. 2026-09-30.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "to": {
      "description": "Date in YYYY-MM-DD format, e.g. 2026-09-30.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "type": "object"
   },
   "includeOrderData": {
    "description": "Include each order's full data.",
    "type": "boolean"
   },
   "includeScheduleInformation": {
    "description": "Include each order's driver, stop number and scheduled time.",
    "type": "boolean"
   },
   "orderStatus": {
    "description": "Only orders in these statuses.",
    "items": {
     "enum": [
      "unscheduled",
      "scheduled",
      "on_route",
      "servicing",
      "success",
      "failed",
      "rejected",
      "cancelled"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "orders": {
    "description": "Orders to target, each {\"orderNo\": \"...\"} or {\"id\": \"...\"}. At most 500.",
    "items": {
     "properties": {
      "id": {
       "description": "OptimoRoute's unique order id.",
       "type": "string"
      },
      "orderNo": {
       "description": "The user-specified order number.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "optimoroute_search_orders",
 "title": "Search orders"
}
