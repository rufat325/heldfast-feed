{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a reviewed PBS tree to RiskRover Step 3 PBS.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmReplace": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "children": {
       "items": {
        "$ref": "#/properties/items/items"
       },
       "type": "array"
      },
      "title": {
       "maxLength": 255,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mode": {
    "default": "append",
    "enum": [
     "append",
     "replace"
    ],
    "type": "string"
   },
   "projectId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "reviewed": {
    "type": "boolean"
   },
   "testLevelId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "projectId",
   "testLevelId",
   "items",
   "reviewed"
  ],
  "type": "object"
 },
 "name": "submit_pbs_tree"
}
