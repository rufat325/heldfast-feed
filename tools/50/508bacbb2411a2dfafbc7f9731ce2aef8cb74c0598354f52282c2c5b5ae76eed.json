{"description":"Consulta valores unit\u00e1rios de refer\u00eancia D-TISS da ANS por procedimento TUSS. Quando usar: para comparar valores informados por UF, modalidade, porte e semestre. Quando n\u00e3o usar: para glosa ou pre\u00e7o contratado de uma operadora; use as ferramentas de operadoras.","inputSchema":{"additionalProperties":false,"properties":{"codigo":{"pattern":"^[0-9]{1,10}$","type":"string"},"modalidade":{"type":"string"},"porte":{"type":"string"},"semestre":{"pattern":"^[0-9]{4}-[12]$","type":"string"},"tabela":{"pattern":"^[0-9]{2}$","type":"string"},"uf":{"pattern":"^[A-Za-z]{2}$","type":"string"}},"required":["codigo","uf"],"type":"object"},"name":"tiss_referencia","outputSchema":{"additionalProperties":false,"properties":{"atualizado_em":{"type":"string"},"aviso":{"type":["string","null"]},"fonte":{"type":"string"},"minimo_n":{"type":"integer"},"referencia":{"additionalProperties":true,"type":["object","null"]},"semestre":{"type":"string"}},"required":["referencia","semestre","fonte","atualizado_em","aviso","minimo_n"],"type":"object"}}
