{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add trip item"
 },
 "description": "Add an item (hotel, flight, activity, etc.) to a saved trip on a given day.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "day": {
    "description": "Day number within the trip.",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "description": {
    "description": "Optional notes (\u22642000 chars).",
    "type": "string"
   },
   "itineraryPublicId": {
    "description": "The trip's public id (from `list_trips`/`save_trip`).",
    "type": "string"
   },
   "sortOrder": {
    "description": "Order within the day (default 0).",
    "minimum": 0,
    "type": "integer"
   },
   "title": {
    "description": "Item title (1-255 chars).",
    "type": "string"
   },
   "type": {
    "description": "Item type.",
    "enum": [
     "hotel",
     "flight",
     "experience",
     "transfer",
     "activity",
     "meal",
     "note"
    ],
    "type": "string"
   }
  },
  "required": [
   "itineraryPublicId",
   "day",
   "type",
   "title"
  ],
  "type": "object"
 },
 "name": "add_trip_item",
 "title": "Add trip item"
}
