{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update an existing recipe in Nextcloud Cookbook. Only provided fields are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cookTime": {
    "description": "New cook time (ISO 8601 duration)",
    "type": "string"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "folderName": {
    "description": "The recipe folder name",
    "type": "string"
   },
   "image": {
    "description": "New image URL",
    "type": "string"
   },
   "keywords": {
    "description": "New keywords",
    "type": "string"
   },
   "name": {
    "description": "New recipe name",
    "type": "string"
   },
   "nutrition": {
    "description": "Nutrition information",
    "properties": {
     "calories": {
      "description": "Calories (e.g., '450 kJ')",
      "type": "string"
     },
     "carbohydrateContent": {
      "description": "Carbohydrates (e.g., '2 g')",
      "type": "string"
     },
     "fatContent": {
      "description": "Fat (e.g., '10 g')",
      "type": "string"
     },
     "proteinContent": {
      "description": "Protein (e.g., '3 g')",
      "type": "string"
     },
     "sugarContent": {
      "description": "Sugar (e.g., '12 g')",
      "type": "string"
     }
    },
    "type": "object"
   },
   "prepTime": {
    "description": "New prep time (ISO 8601 duration)",
    "type": "string"
   },
   "recipeCategory": {
    "description": "New category",
    "type": "string"
   },
   "recipeIngredient": {
    "description": "New ingredients list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipeInstructions": {
    "description": "New instructions list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipeYield": {
    "description": "New servings count",
    "type": "number"
   },
   "tool": {
    "description": "New tools list",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "totalTime": {
    "description": "New total time (ISO 8601 duration)",
    "type": "string"
   },
   "url": {
    "description": "New source URL",
    "type": "string"
   }
  },
  "required": [
   "folderName"
  ],
  "type": "object"
 },
 "name": "update_recipe",
 "title": "Update Recipe"
}
