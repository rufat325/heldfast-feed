{
 "description": "Inspect a web page and get a structured map of all interactive elements, headings, forms, links, and images \u2014 each with a unique CSS selector. Use this BEFORE run_sequence or record_video to discover what elements exist on the page and get reliable selectors. Returns text (not an image), so it is fast and cheap. Costs 1 API request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authorization": {
    "description": "Authorization header value (e.g. \"Bearer <token>\")",
    "type": "string"
   },
   "blockAds": {
    "description": "Block advertisements on the page",
    "type": "boolean"
   },
   "blockBanners": {
    "description": "Hide cookie consent banners (default: false)",
    "type": "boolean"
   },
   "blockChats": {
    "description": "Block live chat widgets",
    "type": "boolean"
   },
   "blockRequests": {
    "description": "URL patterns to block",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "blockResources": {
    "description": "Resource types to block",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "blockTrackers": {
    "description": "Block tracking scripts",
    "type": "boolean"
   },
   "bypassCSP": {
    "description": "Bypass Content-Security-Policy on the page",
    "type": "boolean"
   },
   "cookies": {
    "description": "Cookies to set \u2014 array of \"name=value\" strings or { name, value, domain? } objects",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "additionalProperties": true,
       "properties": {
        "domain": {
         "type": "string"
        },
        "expirationDate": {
         "type": "number"
        },
        "expires": {
         "type": "number"
        },
        "httpOnly": {
         "type": "boolean"
        },
        "name": {
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "sameSite": {
         "enum": [
          "Strict",
          "Lax",
          "None",
          "strict",
          "lax",
          "no_restriction",
          "unspecified"
         ],
         "type": "string"
        },
        "secure": {
         "type": "boolean"
        },
        "url": {
         "type": "string"
        },
        "value": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "value"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "darkMode": {
    "description": "Emulate dark color scheme (default: false)",
    "type": "boolean"
   },
   "deviceScaleFactor": {
    "description": "Device pixel ratio (default: 1)",
    "maximum": 3,
    "minimum": 1,
    "type": "number"
   },
   "geolocation": {
    "additionalProperties": false,
    "description": "Emulate geolocation",
    "properties": {
     "accuracy": {
      "type": "number"
     },
     "latitude": {
      "type": "number"
     },
     "longitude": {
      "type": "number"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Extra HTTP headers to send with the request",
    "type": "object"
   },
   "height": {
    "description": "Viewport height in pixels (default: 720)",
    "maximum": 2160,
    "minimum": 1,
    "type": "integer"
   },
   "hideSelectors": {
    "description": "Array of CSS selectors to hide before inspecting",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "html": {
    "description": "Raw HTML to inspect (required if no url)",
    "type": "string"
   },
   "includeConsole": {
    "description": "Capture browser console output (console.log/info/warn/error/debug) and uncaught page errors emitted during page load. Adds a \"Console\" section to the result \u2014 lets you debug the page's runtime behavior, not just its static DOM. Default: false.",
    "type": "boolean"
   },
   "injectCss": {
    "description": "Custom CSS to inject before inspecting",
    "type": "string"
   },
   "injectJs": {
    "description": "Custom JavaScript to execute before inspecting",
    "type": "string"
   },
   "mediaType": {
    "description": "Emulate CSS media type",
    "enum": [
     "screen",
     "print"
    ],
    "type": "string"
   },
   "navigationTimeout": {
    "description": "Navigation timeout in ms (default: 25000)",
    "maximum": 30000,
    "minimum": 0,
    "type": "integer"
   },
   "reducedMotion": {
    "description": "Emulate prefers-reduced-motion",
    "type": "boolean"
   },
   "session_id": {
    "description": "Inspect the LIVE state of a persistent session (Starter+; create with create_session) instead of a fresh page load. Omit url to inspect the page exactly as the last run_sequence/take_screenshot left it; pass url to navigate within the session first. Ideal for re-perceiving between agent actions.",
    "type": "string"
   },
   "timeZone": {
    "description": "Override browser timezone",
    "type": "string"
   },
   "url": {
    "description": "URL to inspect (required if no html)",
    "format": "uri",
    "type": "string"
   },
   "userAgent": {
    "description": "Override the browser User-Agent string",
    "type": "string"
   },
   "viewportDevice": {
    "description": "Device preset for viewport emulation (e.g. \"iphone_14_pro\"). Use list_devices to see all presets.",
    "type": "string"
   },
   "viewportHasTouch": {
    "description": "Enable touch event emulation",
    "type": "boolean"
   },
   "viewportLandscape": {
    "description": "Landscape orientation",
    "type": "boolean"
   },
   "viewportMobile": {
    "description": "Enable mobile meta viewport emulation",
    "type": "boolean"
   },
   "waitForSelector": {
    "description": "Wait for this CSS selector to appear before inspecting",
    "type": "string"
   },
   "waitUntil": {
    "description": "When to consider navigation finished (default: networkidle2)",
    "enum": [
     "load",
     "domcontentloaded",
     "networkidle0",
     "networkidle2"
    ],
    "type": "string"
   },
   "width": {
    "description": "Viewport width in pixels (default: 1280)",
    "maximum": 3840,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "inspect_page"
}
