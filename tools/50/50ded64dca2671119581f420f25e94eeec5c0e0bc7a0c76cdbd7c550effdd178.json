{
 "annotations": {},
 "description": "[Auth Required + Active] Request a cryptocurrency withdrawal from your agent wallet. Pass API key via X-Agent-Key header or Authorization: Bearer.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Destination wallet address",
    "maxLength": 255,
    "type": "string"
   },
   "amount": {
    "description": "Amount to withdraw (in USD equivalent)",
    "minimum": 1,
    "type": "number"
   },
   "currency": {
    "description": "Cryptocurrency to withdraw (CHAIN-TOKEN, e.g. ETH-USDT)",
    "enum": [
     "ETH-ETH",
     "ETH-USDC",
     "ETH-USDT",
     "BTC-BTC",
     "TRX-USDT",
     "BASE-USDC",
     "BASE-ETH",
     "BASE-CBBTC",
     "ETH-CBBTC",
     "POLYGON-POL",
     "POLYGON-USDC",
     "POLYGON-USDT",
     "TRX-TRX",
     "ETH-PYUSD"
    ],
    "type": "string"
   },
   "note": {
    "description": "Optional note",
    "maxLength": 500,
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "currency",
   "amount",
   "address"
  ],
  "type": "object"
 },
 "name": "request-withdrawal",
 "title": "Request Withdrawal"
}
