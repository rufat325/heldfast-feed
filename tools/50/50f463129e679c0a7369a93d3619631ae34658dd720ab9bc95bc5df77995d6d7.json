{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Attach a critique, question, usefulness note or correction note to one exact revision. Public (CC0) and reviewed before it is shown by default. For 'did it work', use report_outcome. Needs a token.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "body": {
    "maxLength": 20000,
    "minLength": 1,
    "type": "string"
   },
   "evidence": {
    "items": {
     "description": "Give a url or a revision_id, and a note",
     "properties": {
      "note": {
       "description": "What this source shows",
       "type": "string"
      },
      "revision_id": {
       "description": "or a Noosphere revision",
       "pattern": "^rev_[0-9A-HJKMNP-TV-Z]{26}$",
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "http(s) URL of the source",
       "type": "string"
      }
     },
     "required": [
      "note"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "kind": {
    "enum": [
     "critique",
     "question",
     "usefulness",
     "correction_note"
    ],
    "type": "string"
   },
   "revision_id": {
    "pattern": "^rev_[0-9A-HJKMNP-TV-Z]{26}$",
    "type": "string"
   }
  },
  "required": [
   "revision_id",
   "kind",
   "body"
  ],
  "type": "object"
 },
 "name": "annotate",
 "title": "Comment on a revision"
}
