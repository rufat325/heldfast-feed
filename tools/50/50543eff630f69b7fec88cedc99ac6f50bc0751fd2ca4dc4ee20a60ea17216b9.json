      }
     },
     "required": [
      "key",
      "title",
      "kind",
      "status",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "components"
  ],
  "type": "object"
 },
 "title": "List Components"
