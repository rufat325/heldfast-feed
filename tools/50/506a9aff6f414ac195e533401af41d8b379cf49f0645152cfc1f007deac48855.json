{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Register a task in the farm's field notebook (needs a key with write scope). The entry is attributed to the key owner and marked as written by API in the audit trail; the server stores when it arrived and rejects future dates. It only adds new entries: it never edits or deletes existing ones. Confirm the farm, parcel, product and date with the user before calling it. Official submission to the administration is never done here: it needs a person's session in the app.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"cost_cents":{"description":"Cost in euro cents","minimum":0,"type":"integer"},"crop_code":{"description":"EPPO crop code, e.g. OLVEU","type":"string"},"entry_type":{"description":"Kind of task","enum":["treatment","fertilizing","irrigation","planting","harvest","expense","observation","cultural_work"],"type":"string"},"event_at":{"description":"When it happened (ISO 8601 with offset)","format":"date-time","type":"string"},"farm_id":{"description":"Farm id from list_farms","format":"uuid","type":"string"},"parcel_refcat":{"description":"Cadastral reference of the parcel","minLength":1,"type":"string"},"product_name":{"description":"Product or input used","type":"string"},"quantity":{"description":"Quantity applied","minimum":0,"type":"number"},"registration_number":{"description":"Official registration number of the product (fito)","type":"string"},"safety_days":{"description":"Pre-harvest interval in days","minimum":0,"type":"integer"},"title":{"description":"Short title, e.g. 'Tratamiento \u00b7 Azufre mojable'","maxLength":200,"minLength":1,"type":"string"},"treated_area_ha":{"description":"Treated area in hectares","minimum":0,"type":"number"},"unit":{"description":"Unit, e.g. 'L/ha', 'kg', 'mm'","type":"string"}},"required":["farm_id","parcel_refcat","entry_type","title","event_at"],"type":"object"},"name":"record_entry","title":"Record a notebook entry"}
