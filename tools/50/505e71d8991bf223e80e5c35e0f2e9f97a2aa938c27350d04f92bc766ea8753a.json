{
 "annotations": {
  "readOnlyHint": true,
  "title": "List appointments"
 },
 "description": "Query appointments by client name/email, date range, status, practitioner or last-modified date. Max 100 per page. IntakeQ: GET /appointments.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "client": {
    "description": "Client name or email (partial matches).",
    "type": "string"
   },
   "deleted_only": {
    "description": "true = only appointments deleted in the last 10 days.",
    "type": "boolean"
   },
   "end_date": {
    "description": "Appointments on or before (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "page": {
    "description": "Page number (1, 2, ...). Each page holds at most 100 records.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "practitioner_email": {
    "description": "Only this practitioner's appointments.",
    "type": "string"
   },
   "start_date": {
    "description": "Appointments on or after (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "status": {
    "description": "Only appointments in this status.",
    "enum": [
     "Confirmed",
     "Canceled",
     "WaitingConfirmation",
     "Declined",
     "Missed"
    ],
    "type": "string"
   },
   "updated_since": {
    "description": "Only appointments modified after this date (yyyy-MM-dd).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "intakeq_list_appointments",
 "title": "List appointments"
}
