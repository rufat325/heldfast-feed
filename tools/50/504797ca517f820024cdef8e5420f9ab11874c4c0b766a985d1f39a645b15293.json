  "title": "Save changes to your Brand Kit"
 },
 "description": "Save an explicitly approved patch of business facts, products, style or references to the Brand Kit. Needs manage:brand and confirm: true after owner approval; without confirm it previews and sends nothing. Pass the exact displayed expectedRevision from soclo_brand_read (null only when it reported no original). Ask about inferred money-facing facts before saving. A stable UUID clientRequestId survives lost replies: after interruption read soclo_brand_status with kind brand_profile, never repeat blindly. Debits no customer credits.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
