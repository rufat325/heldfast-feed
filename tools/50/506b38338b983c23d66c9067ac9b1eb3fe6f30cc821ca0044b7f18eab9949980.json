{
 "description": "List events (activity log) in amoCRM. Filter by entity type, entity ID, or event type. Shows status changes, calls, notes, and other activities.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entity": {
    "description": "Filter by entity type",
    "enum": [
     "lead",
     "contact",
     "company",
     "task",
     "customer"
    ],
    "type": "string"
   },
   "entity_id": {
    "description": "Filter by specific entity ID",
    "type": "number"
   },
   "limit": {
    "description": "Items per page (max 100, default 50)",
    "maximum": 100,
    "type": "number"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "type": {
    "description": "Filter by event type (e.g. 'lead_status_changed', 'incoming_call', 'entity_linked')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_events"
}
