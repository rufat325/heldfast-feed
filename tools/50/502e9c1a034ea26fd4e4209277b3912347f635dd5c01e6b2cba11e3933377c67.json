{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "rag",
 "description": "Assemble a complete RAG (Retrieval-Augmented Generation) prompt from retrieved context chunks and a user query. Handles token budgeting, citation numbering, system instruction injection, and source attribution.",
 "inputSchema": {
  "properties": {
   "chunks": {
    "description": "Retrieved context chunks with .text (required), .source (optional), .score (optional)",
    "items": {
     "properties": {
      "score": {
       "type": "number"
      },
      "source": {
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "cite_sources": {
    "description": "Add [1], [2] citation numbers (default: true)",
    "type": "boolean"
   },
   "language": {
    "description": "Response language instruction (e.g. \"French\", \"Spanish\")",
    "type": "string"
   },
   "max_context_tokens": {
    "description": "Max tokens for context section (default: 2000)",
    "type": "number"
   },
   "query": {
    "description": "The user question to answer",
    "type": "string"
   },
   "system_instruction": {
    "description": "Custom system instruction (default: standard RAG grounding instruction)",
    "type": "string"
   }
  },
  "required": [
   "query",
   "chunks"
  ],
  "type": "object"
 },
 "name": "build_rag_prompt",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "chunks_included": {
    "type": "number"
   },
   "chunks_truncated": {
    "type": "number"
   },
   "context_tokens_estimate": {
    "type": "number"
   },
   "included_chunks": {},
   "prompt": {},
   "system_prompt": {},
   "total_tokens_estimate": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
