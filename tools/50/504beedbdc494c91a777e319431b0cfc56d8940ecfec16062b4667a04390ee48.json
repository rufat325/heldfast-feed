{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:settings"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save your creative direction"
 },
 "description": "Direction or kinds changes require patch.directionScope: line/actionId, range/startDate/endDate, or ongoing/startDate. Ask one post, day, several days, week, month or ongoing when unclear; never assume. Read soclo_creative_preferences_read first and pass the exact expectedRevision, a stable UUID clientRequestId and only the approved patch. Omitted direction/templates/targets carry forward unchanged; an explicit empty list clears that list. First call without confirm to review, then confirm the same intended patch. Saves only creative_preferences through the app\u2019s CAS RPC; it never enrolls, enables, schedules or pays for Autopilot. Before inactive setup exists, keep the owner\u2019s words and report agent_config_missing. Needs manage:settings.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "expectedRevision": {
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "patch": {
    "additionalProperties": false,
    "properties": {
     "direction": {
      "type": [
       "string",
       "null"
      ]
     },
     "directionScope": {},
     "targets": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "id",
        "label"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "templates": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "skills": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "id": {
            "maxLength": 200,
            "minLength": 1,
            "type": "string"
           },
           "version": {
            "maximum": 2147483647,
            "minimum": 0,
            "type": "integer"
           }
          },
          "required": [
           "id"
          ],
          "type": "object"
         },
         "maxItems": 24,
         "type": "array"
        },
        "tileId": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "tileVersion": {
         "maximum": 2147483647,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "tileId"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "expectedRevision",
   "patch",
   "clientRequestId"
  ],
  "type": "object"
 },
 "name": "soclo_creative_preferences_save",
 "title": "Save your creative direction"
}
