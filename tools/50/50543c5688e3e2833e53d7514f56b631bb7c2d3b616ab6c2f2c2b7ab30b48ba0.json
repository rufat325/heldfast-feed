{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Query multiple time-series monitoring data from Cloud Insight in a single request. Supports querying multiple metrics at once.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregation": {
    "description": "Aggregation type (default: AVG)",
    "enum": [
     "AVG",
     "MIN",
     "MAX",
     "SUM",
     "COUNT"
    ],
    "type": "string"
   },
   "interval": {
    "description": "Aggregation interval (default: Min5)",
    "enum": [
     "Min1",
     "Min5",
     "Min30",
     "Hour2",
     "Day1"
    ],
    "type": "string"
   },
   "metrics": {
    "description": "Array of metric queries to execute",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dimensions": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Dimension filters",
       "type": "object"
      },
      "metricGroupId": {
       "description": "Metric group ID",
       "type": "string"
      },
      "metricGroupItemId": {
       "description": "Metric group item ID",
       "type": "string"
      },
      "prodKey": {
       "description": "Product key (cw_key)",
       "type": "string"
      }
     },
     "required": [
      "prodKey",
      "metricGroupItemId",
      "metricGroupId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "timeEnd": {
    "description": "End time in Unix epoch milliseconds",
    "type": "number"
   },
   "timeStart": {
    "description": "Start time in Unix epoch milliseconds",
    "type": "number"
   }
  },
  "required": [
   "metrics",
   "timeStart",
   "timeEnd"
  ],
  "type": "object"
 },
 "name": "ncloud_query_monitoring_data_multiple"
}
