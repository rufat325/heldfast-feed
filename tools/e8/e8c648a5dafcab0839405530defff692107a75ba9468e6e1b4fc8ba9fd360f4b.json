    "properties": {
     "maxChars": {
      "default": 12000,
      "maximum": 12000,
      "minimum": 256,
      "type": "integer"
     },
     "section": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "url": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
