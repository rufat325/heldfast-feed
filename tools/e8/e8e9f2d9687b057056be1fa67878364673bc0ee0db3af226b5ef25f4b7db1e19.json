{
 "_meta": {
  "openai/toolInvocation/invoked": "Agent Readiness Score ready",
  "openai/toolInvocation/invoking": "Scanning the site\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether a website is ready for AI agents, agent-ready, AI-agent friendly or WebMCP-ready, or what to fix so agents can use it. Scores one public website out of 100 for agent readiness and returns a grade, the fitness and adoption sub-scores, the five highest-value fixes, the scan time and whether the result came from cache. Reads one public page plus standard discovery files (robots.txt, /.well-known endpoints, sitemaps, llms.txt) and up to ten same-origin script bundles; it never logs in, submits forms or changes the site. Results are cached for about an hour.",
 "inputSchema": {
  "properties": {
   "url": {
    "description": "Public http(s) address, for example example.com",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "score_site",
 "outputSchema": {
  "properties": {
   "axes": {
    "items": {
     "properties": {
      "available": {
       "type": "number"
      },
      "earned": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "question": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "earned",
      "available",
      "question"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cached": {
    "description": "True when this request reused a report already in the server cache.",
    "type": "boolean"
   },
   "excluded": {
    "items": {
     "properties": {
      "id": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fetchedAt": {
    "description": "ISO 8601",
    "type": "string"
   },
   "fixFirst": {
    "items": {
     "properties": {
      "finding": {
       "type": "string"
      },
      "fix": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "points": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "finding",
      "fix",
      "points"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "grade": {
    "enum": [
     "A",
     "B",
     "C",
     "D",
     "F"
    ],
    "type": "string"
   },
   "host": {
    "type": "string"
   },
   "methodology": {
    "format": "uri",
    "type": "string"
   },
   "pillars": {
    "items": {
     "properties": {
      "available": {
       "type": "number"
      },
      "axis": {
       "type": "string"
      },
      "earned": {
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "axis",
      "earned",
      "available"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reportUrl": {
    "format": "uri",
    "type": "string"
   },
   "score": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "host",
   "url",
   "score",
   "grade",
   "fetchedAt",
   "cached",
   "axes",
   "pillars",
   "fixFirst",
   "excluded",
   "reportUrl",
   "methodology"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Score a site for agent readiness"
}
