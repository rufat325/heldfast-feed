{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Great-circle distance between two lat/lon points (haversine formula). Returns km, mi or nm.",
 "inputSchema": {
  "properties": {
   "payload": {
    "properties": {
     "lat1": {
      "maximum": 90,
      "minimum": -90,
      "title": "Lat1",
      "type": "number"
     },
     "lat2": {
      "maximum": 90,
      "minimum": -90,
      "title": "Lat2",
      "type": "number"
     },
     "lon1": {
      "maximum": 180,
      "minimum": -180,
      "title": "Lon1",
      "type": "number"
     },
     "lon2": {
      "maximum": 180,
      "minimum": -180,
      "title": "Lon2",
      "type": "number"
     },
     "unit": {
      "default": "km",
      "pattern": "^(km|mi|nm)$",
      "title": "Unit",
      "type": "string"
     }
    },
    "required": [
     "lat1",
     "lon1",
     "lat2",
     "lon2"
    ],
    "title": "DistanceInput",
    "type": "object"
   }
  },
  "required": [
   "payload"
  ],
  "type": "object"
 },
 "name": "geo_distance",
 "title": "Geo Distance"
}
