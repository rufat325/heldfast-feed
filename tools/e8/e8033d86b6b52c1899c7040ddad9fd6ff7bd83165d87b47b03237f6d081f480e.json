{
 "description": "Evaluate a proposed economic option against caller-supplied alternatives and constraints. Returns EXECUTE, SWITCH, VERIFY, or BLOCK with transparent evidence and measurable savings when available. Does not search external markets.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "constraints": {
    "additionalProperties": false,
    "properties": {
     "max_delivery_days": {
      "minimum": 0,
      "type": "number"
     },
     "max_total_cost": {
      "minimum": 0,
      "type": "number"
     },
     "require_insurance": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "currency": {
    "type": "string"
   },
   "options": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "delivery_days": {
       "minimum": 0,
       "type": "number"
      },
      "id": {
       "type": "string"
      },
      "insurance_included": {
       "type": "boolean"
      },
      "total_cost": {
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id",
      "total_cost"
     ],
     "type": "object"
    },
    "minItems": 2,
    "type": "array"
   },
   "proposed_option_id": {
    "type": "string"
   }
  },
  "required": [
   "proposed_option_id",
   "currency",
   "options"
  ],
  "type": "object"
 },
 "name": "evaluate_economic_decision"
}
