{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Web Tasks"
 },
 "description": "List recent persisted task runs with optional status or session filters. Use this when you need to discover recent runs before fetching one task in detail.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Maximum recent runs to return.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "session_id": {
    "description": "Optional session filter for related runs.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "status": {
    "description": "Optional task status filter.",
    "enum": [
     "completed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "webtask_list_tasks",
 "title": "List Web Tasks"
}
