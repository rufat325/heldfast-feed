{
 "description": "Post a task to the marketplace with agent-signed HCS message. Internally: prepare HCS transaction with agent as payer \u2192 sign with agent's key \u2192 submit to Hedera. Returns { txId, taskId, timestamp }. HCS transaction ID uses agent's account, proving authorship.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capabilities": {
    "description": "Required capabilities (non-empty array)",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "deadline": {
    "description": "Deadline as unix timestamp",
    "type": "number"
   },
   "description": {
    "description": "Task description",
    "minLength": 1,
    "type": "string"
   },
   "posterDid": {
    "description": "Poster DID (did:hcs:tokenId:serial)",
    "minLength": 1,
    "type": "string"
   },
   "posterPrivateKey": {
    "description": "Poster's private key (DER hex or 0x-prefixed ECDSA hex)",
    "minLength": 1,
    "type": "string"
   },
   "priceHbar": {
    "description": "Price in HBAR (must be positive)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "title": {
    "description": "Task title",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "posterDid",
   "title",
   "description",
   "priceHbar",
   "capabilities",
   "posterPrivateKey"
  ],
  "type": "object"
 },
 "name": "post_task_with_key"
}
