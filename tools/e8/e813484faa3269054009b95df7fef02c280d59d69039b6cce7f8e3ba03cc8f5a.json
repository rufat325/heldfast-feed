{
 "description": "Search active real estate listings in Flika's coverage area (SC + GA). Returns up to 25 listings matching the filters. Use scout.coverage() first if you're unsure whether a city is covered.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City name (e.g. 'Greenville', 'Charleston', 'Atlanta').",
    "type": "string"
   },
   "limit": {
    "description": "Max listings to return (1-25, default 10).",
    "type": "integer"
   },
   "max_beds": {
    "description": "Maximum bedroom count.",
    "type": "integer"
   },
   "max_price": {
    "description": "Maximum list price (USD).",
    "type": "integer"
   },
   "min_beds": {
    "description": "Minimum bedroom count.",
    "type": "integer"
   },
   "min_price": {
    "description": "Minimum list price (USD).",
    "type": "integer"
   },
   "state": {
    "description": "Two-letter state code, SC or GA.",
    "enum": [
     "SC",
     "GA"
    ],
    "type": "string"
   },
   "zip": {
    "description": "5-digit ZIP code.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "scout.search_listings"
}
