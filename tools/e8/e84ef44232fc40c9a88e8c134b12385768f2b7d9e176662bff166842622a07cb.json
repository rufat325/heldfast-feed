{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when something went wrong with an agent and you need the facts in order. Pass the `receipt_ids` you hold and attributed `observations`. Returns a verified, source-attributed timeline with an EU AI Act Art. 73 reference aid. No fault, cause or liability finding. Free, read-only, no account; inputs must be public and non-personal.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "ai_system_ref": "example-weather-agent",
    "observations": [
     {
      "observed_at_utc": "2026-09-27T10:00:00Z",
      "source": "our uptime monitor",
      "source_type": "AUTOMATED_MONITOR",
      "statement": "HTTP 503 from the forecast endpoint for 12 minutes"
     }
    ],
    "receipt_ids": [
     "<receipt_id returned by any GAIP tool>"
    ],
    "title": "Forecast endpoint returned errors"
   }
  ],
  "properties": {
   "ai_system_ref": {
    "description": "Optional: public id or URL of the AI system involved.",
    "maxLength": 256,
    "type": "string"
   },
   "data_classification": {
    "default": "PUBLIC",
    "description": "PUBLIC (default) or NON_PERSONAL_PUBLIC. Never send personal data.",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "observations": {
    "description": "Attributed observations, each {source, statement, observed_at_utc}.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "observed_at_utc": {
       "type": "string"
      },
      "receipt_id": {
       "type": "string"
      },
      "source": {
       "maxLength": 120,
       "type": "string"
      },
      "source_type": {
       "enum": [
        "AUTOMATED_MONITOR",
        "PUBLIC_RECORD",
        "REQUESTER",
        "THIRD_PARTY"
       ],
       "type": "string"
      },
      "statement": {
       "maxLength": 2000,
       "type": "string"
      }
     },
     "required": [
      "source",
      "statement"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "receipt_ids": {
    "description": "GAIP receipt ids you hold about the incident.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "title": {
    "description": "Optional: short incident title.",
    "maxLength": 120,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gaip_incident_bundle",
 "title": "Build an incident evidence bundle"
}
