{
 "description": "Update an existing standard campaign",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "advertiser": {
    "description": "Advertiser ID",
    "type": "number"
   },
   "budget": {
    "additionalProperties": false,
    "description": "Budget limits",
    "properties": {
     "daily": {
      "type": "number"
     },
     "lifetime": {
      "type": "number"
     },
     "monthly": {
      "type": "number"
     },
     "weekly": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "contract": {
    "description": "Contract ID",
    "type": "number"
   },
   "id": {
    "description": "Campaign ID",
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Campaign name",
    "type": "string"
   },
   "roadblock_tags": {
    "description": "Roadblock tag",
    "type": "string"
   },
   "scheduling_source": {
    "description": "Scheduling level",
    "enum": [
     "CAMPAIGN",
     "AD_ITEM"
    ],
    "type": "string"
   },
   "targeting_source": {
    "description": "Targeting level",
    "enum": [
     "CAMPAIGN",
     "AD_ITEM"
    ],
    "type": "string"
   },
   "trusted_redirect_domains": {
    "description": "Trusted redirect domains",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_campaign"
}
