  "properties": {
   "comment": {
    "maxLength": 2000,
    "type": "string"
   },
   "reasons": {
    "description": "Only when useful is false",
    "items": {
     "enum": [
      "wrong",
      "old_news",
      "not_relevant",
      "already_knew"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "signal_id": {
    "description": "An id from search_signals or what_changed",
    "type": "integer"
   },
   "useful": {
    "type": "boolean"
   }
  },
  "required": [
   "signal_id",
   "useful"
  ],
  "type": "object"
 },
 "name": "rate_signal",
 "outputSchema": {
  "properties": {
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "rating": {
    "type": "object"
   }
  },
  "required": [
   "ok",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
