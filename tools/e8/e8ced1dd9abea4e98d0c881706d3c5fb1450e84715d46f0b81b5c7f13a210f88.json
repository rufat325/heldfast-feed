{
 "description": "Create a resource-library folder. parent_folder_id (optional) must be a folder in the same community. Names must be unique among siblings (409). price must be > 0 if set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "description": "#RRGGBB hex color",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "icon": {
    "description": "Icon name, defaults to \"folder\"",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "parent_folder_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Parent folder; omit/null for top level"
   },
   "position": {
    "description": "Sort order among siblings",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "hivelearn_create_resource_folder"
}
