{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Add webhook"},"description":"Registers a public HTTPS URL that receives a POST for each chosen event (JSON {id, type, created_at, data}). Returns secret (shown once): verify each delivery with HMAC-SHA256 of \"<Webhook-Timestamp>.<raw body>\" against the Webhook-Signature header (\"v1=<hex>\"). Deliveries are at-least-once \u2014 dedupe by Webhook-Id. Up to 10 endpoints.","inputSchema":{"additionalProperties":false,"properties":{"events":{"description":"Events to deliver. Typical: [\"invoice.paid\",\"invoice.expired\",\"payout.completed\",\"payout.failed\"].","examples":[["invoice.paid","invoice.expired","payout.completed","payout.failed"]],"items":{"enum":["payment.created","payment.detected","payment.credited","payment.expired","payout.created","payout.processing","payout.sent","payout.completed","payout.failed","conversion.completed","conversion.failed","balance.changed","invoice.created","invoice.awaiting","invoice.underpaid","invoice.paid","invoice.partially_paid","invoice.expired","invoice.extra_payment","static_deposit.detected","static_deposit.credited"],"type":"string"},"minItems":1,"type":"array","uniqueItems":true},"url":{"description":"Public HTTPS URL.","examples":["https://shop.example.com/snapex/webhook"],"format":"uri","maxLength":2048,"type":"string"}},"required":["url","events"],"type":"object"},"name":"create_webhook","title":"Add a webhook endpoint"}
