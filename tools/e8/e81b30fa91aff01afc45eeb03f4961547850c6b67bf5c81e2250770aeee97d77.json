{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new project from a catalog or org template. The server prepares media and verified mattes before the project is ready. Pass the returned jobId to wait_job(kind=\"template\").",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "brandKitId": {
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "media": {
    "additionalProperties": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "mediaId": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "mediaId"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "mimeType": {
         "type": "string"
        },
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "sample": {
         "const": true,
         "type": "boolean"
        }
       },
       "required": [
        "sample"
       ],
       "type": "object"
      }
     ]
    },
    "default": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "preset": {
    "minLength": 1,
    "type": "string"
   },
   "projectName": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "template": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "values": {
    "additionalProperties": {},
    "default": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "template",
   "projectName"
  ],
  "type": "object"
 },
 "name": "start_template",
 "title": "Start from Template"
}
