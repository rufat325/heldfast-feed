{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search across document transcriptions using a fulltext query.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Limit search to a specific collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filter": {
    "description": "Filter string",
    "type": "string"
   },
   "legacy": {
    "description": "Use legacy search",
    "type": "boolean"
   },
   "query": {
    "description": "Fulltext search query",
    "type": "string"
   },
   "rows": {
    "description": "Number of results (default 10)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start": {
    "description": "Start offset (default 0)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Filter by document type",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "transkribus_search_fulltext",
 "title": "Fulltext Search"
}
