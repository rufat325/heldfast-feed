{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "One University Senate committee, University council, or past council or task force by name (from senate_list_committees): its page as text (charge, chair, contact), current members with seats and colleges, and the bills it is reviewing. See senate_list_past_committee_legislation for earlier bills and senate_get_committee_meetings for meeting dates. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Name as senate_list_committees gives it, e.g. \"Academic Procedures & Standards\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "senate_get_committee",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "about": {
    "description": "The group's page as plain text: charge, chair, contact",
    "type": [
     "string",
     "null"
    ]
   },
   "active_bills": {
    "description": "Bills the group is reviewing now",
    "items": {
     "additionalProperties": false,
     "properties": {
      "document_number": {
       "description": "Senate document number, e.g. \"26-27-04\": the academic year and a sequence number",
       "type": "string"
      },
      "id": {
       "description": "Bill id, for senate_get_bill",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "description": "Bill title",
       "type": "string"
      },
      "under_review_by": {
       "description": "Group reviewing the bill, as the current stage names it",
       "type": "string"
      },
      "url": {
       "description": "Bill page on senate.umd.edu",
       "type": "string"
      }
     },
     "required": [
      "id",
      "document_number",
      "title",
      "under_review_by",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "links": {
    "description": "Links on the page (documents, forms, email addresses)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "text": {
       "description": "Link text",
       "type": "string"
      },
      "url": {
       "description": "Absolute URL",
       "type": "string"
      }
     },
     "required": [
      "text",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "members": {
    "description": "Current members; empty for past councils",
    "items": {
     "additionalProperties": false,
     "properties": {
      "college": {
       "description": "College or division acronym",
       "type": [
        "string",
        "null"
       ]
      },
      "email": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Name as \"Last, First\"",
       "type": "string"
      },
      "seat": {
       "description": "Seat held, e.g. \"Faculty\", \"Ex-Officio - Provost's Rep\"",
       "type": "string"
      },
      "term_ends": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Calendar year the term ends in; null when not recorded"
      }
     },
     "required": [
      "name",
      "seat",
      "college",
      "email",
      "term_ends"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Name, to pass to senate_get_committee",
    "type": "string"
   },
   "summary": {
    "description": "One-paragraph description from the listing page",
    "type": [
     "string",
     "null"
    ]
   },
   "type": {
    "description": "\"committee\" for a Senate standing or special committee, \"council\" for a University council, \"past_council\" for a dissolved council or task force",
    "enum": [
     "committee",
     "council",
     "past_council"
    ],
    "type": "string"
   },
   "url": {
    "description": "Page on senate.umd.edu",
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "summary",
   "url",
   "about",
   "links",
   "members",
   "active_bills"
  ],
  "type": "object"
 },
 "title": "Get a committee or council"
}
