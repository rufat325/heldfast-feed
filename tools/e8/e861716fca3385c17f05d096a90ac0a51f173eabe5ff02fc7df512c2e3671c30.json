{
 "description": "Hardware Escrow loan actions (EC-6c/6e): action=transition drives the loan state machine (APPROVED/SHIPPED/IN_FIELD/RETURN_REQUESTED); action=verify_return is the serial+condition refund gate (GOOD releases the deposit, graded damage partial-captures); action=mark_lost forfeits a non-return. Deposit outcomes are record-only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "transition",
     "verify_return",
     "mark_lost"
    ],
    "type": "string"
   },
   "assignmentId": {
    "type": "string"
   },
   "capturedCents": {
    "type": "integer"
   },
   "conditionGrade": {
    "enum": [
     "GOOD",
     "DAMAGED",
     "MISSING_PARTS"
    ],
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "serial": {
    "type": "string"
   },
   "to": {
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "action"
  ],
  "type": "object"
 },
 "name": "opentrain_escrow_assignment_action",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
