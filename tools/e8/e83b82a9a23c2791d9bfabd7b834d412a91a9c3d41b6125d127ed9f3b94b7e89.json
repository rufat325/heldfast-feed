{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Modifica una ricorrenza (solo i campi passati). Cambiare cadenza o date ricalcola la prossima esecuzione.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "create",
     "create_and_send_sdi"
    ],
    "type": "string"
   },
   "day_of_month": {
    "maximum": 31,
    "minimum": 1,
    "type": "integer"
   },
   "email": {
    "properties": {
     "body": {
      "description": "HTML",
      "type": "string"
     },
     "enabled": {
      "default": true,
      "type": "boolean"
     },
     "recipient_email": {
      "description": "Default: email del cliente in Fatture in Cloud",
      "type": "string"
     },
     "send_copy": {
      "type": "boolean"
     },
     "subject": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "enabled": {
    "type": "boolean"
   },
   "end_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "every_months": {
    "maximum": 24,
    "minimum": 1,
    "type": "integer"
   },
   "id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "next_run": {
    "description": "Forza la prossima esecuzione",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "overrides": {
    "description": "Modifiche rispetto all'originale. Nei testi puoi usare {{mese}}, {{anno}}, {{mese_precedente}}, {{anno_mese_precedente}}, {{mese_successivo}}, {{trimestre}}, {{data}}; con |maiuscolo l'iniziale diventa maiuscola. Es. 'Consulenza {{mese_precedente}} {{anno_mese_precedente}}'.",
    "properties": {
     "items": {
      "description": "Modifiche alle singole righe (importo, quantit\u00e0, descrizione)",
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "gross_price": {
         "type": "number"
        },
        "index": {
         "description": "Posizione della riga, da 0",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "net_price": {
         "type": "number"
        },
        "qty": {
         "type": "number"
        }
       },
       "required": [
        "index"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "items_list": {
      "description": "Sostituisce tutte le righe",
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "numeration": {
      "description": "Sezionale, es. '/A'",
      "type": "string"
     },
     "subject": {
      "type": "string"
     },
     "type": {
      "description": "Cambia tipo nella copia, es. proforma \u2192 invoice",
      "enum": [
       "invoice",
       "quote",
       "proforma",
       "receipt",
       "delivery_note",
       "credit_note",
       "order",
       "work_report",
       "supplier_order",
       "self_own_invoice",
       "self_supplier_invoice"
      ],
      "type": "string"
     },
     "visible_subject": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "source_document_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "schedule_update"
}
