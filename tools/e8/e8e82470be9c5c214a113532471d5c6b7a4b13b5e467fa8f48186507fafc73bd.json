{
 "_meta": {
  "agents-x402/paymentRequired": true,
  "agents-x402/priceUSD": 0.01
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run deterministic checks and return Ed25519-signed evidence after one explicitly authorized x402 payment. A free precheck receipt and a matching bound payment requirement are required before signing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "intent": {
    "additionalProperties": false,
    "properties": {
     "precheck_receipt_digest": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "request": {
      "additionalProperties": false,
      "properties": {
       "assertions": {
        "items": {
         "oneOf": [
          {
           "additionalProperties": false,
           "properties": {
            "expected_hex": {
             "pattern": "^[a-f0-9]{64}$",
             "type": "string"
            },
            "op": {
             "const": "sha256_equals",
             "type": "string"
            }
           },
           "required": [
            "op",
            "expected_hex"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "op": {
             "const": "json_pointer_exists",
             "type": "string"
            },
            "path": {
             "maxLength": 512,
             "type": "string"
            }
           },
           "required": [
            "op",
            "path"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "expected": {},
            "op": {
             "const": "json_pointer_equals",
             "type": "string"
            },
            "path": {
             "maxLength": 512,
             "type": "string"
            }
           },
           "required": [
            "op",
            "path",
            "expected"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "expected_type": {
             "enum": [
              "null",
              "boolean",
              "number",
              "string",
              "array",
              "object"
             ],
             "type": "string"
            },
            "op": {
             "const": "json_type_is",
             "type": "string"
            },
            "path": {
             "maxLength": 512,
             "type": "string"
            }
           },
           "required": [
            "op",
            "path",
            "expected_type"
           ],
           "type": "object"
          }
         ]
        },
        "maxItems": 16,
        "minItems": 1,
        "type": "array"
       },
       "client_request_id": {
        "maxLength": 64,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9._:-]+$",
        "type": "string"
       },
       "evidence": {
        "additionalProperties": false,
        "properties": {
         "content_base64": {
          "maxLength": 87384,
          "minLength": 4,
          "type": "string"
         },
         "media_type": {
          "const": "application/json",
          "type": "string"
         }
        },
        "required": [
         "media_type",
         "content_base64"
        ],
        "type": "object"
       }
      },
      "required": [
       "client_request_id",
       "evidence",
       "assertions"
      ],
      "type": "object"
     },
     "spend_policy": {
      "additionalProperties": false,
      "properties": {
       "asset": {
        "pattern": "^0x[a-fA-F0-9]{40}$",
        "type": "string"
       },
       "max_amount_atomic": {
        "type": "string"
       },
       "network": {
        "enum": [
         "eip155:84532",
         "eip155:8453"
        ],
        "type": "string"
       },
       "pay_to": {
        "pattern": "^0x[a-fA-F0-9]{40}$",
        "type": "string"
       },
       "policy_version": {
        "const": "agent-economy/precheck-policy/2.0",
        "type": "string"
       }
      },
      "required": [
       "policy_version",
       "max_amount_atomic",
       "network",
       "asset",
       "pay_to"
      ],
      "type": "object"
     }
    },
    "required": [
     "request",
     "spend_policy",
     "precheck_receipt_digest"
    ],
    "type": "object"
   }
  },
  "required": [
   "idempotency_key",
   "intent"
  ],
  "type": "object"
 },
 "name": "verify_evidence",
 "title": "Verify Evidence (paid)"
}
