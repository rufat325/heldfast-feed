{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full-text search in one merchant storefront (slug). Only active merchants and reviewed products; returns sku, title, price_usd, availability, requires_pii, fulfillment_mode. Page with next_cursor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_price_usd": {
    "minimum": 0,
    "type": "number"
   },
   "merchant": {
    "description": "Merchant slug.",
    "type": "string"
   },
   "query": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "merchant"
  ],
  "type": "object"
 },
 "name": "shop.catalog.search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "merchant": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "policy_summary": {
      "additionalProperties": {},
      "type": "object"
     },
     "reputation": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "required": [
     "name",
     "reputation",
     "policy_summary"
    ],
    "type": "object"
   },
   "next_cursor": {
    "type": "string"
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "availability": {
       "enum": [
        "in_stock",
        "out_of_stock"
       ],
       "type": "string"
      },
      "fulfillment_mode": {
       "enum": [
        "instant",
        "merchant",
        "physical"
       ],
       "type": "string"
      },
      "price_usd": {
       "type": "string"
      },
      "requires_pii": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "sku": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "sku",
      "title",
      "price_usd",
      "availability",
      "requires_pii",
      "fulfillment_mode"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "merchant",
   "products"
  ],
  "type": "object"
 },
 "title": "Search a merchant catalog"
}
