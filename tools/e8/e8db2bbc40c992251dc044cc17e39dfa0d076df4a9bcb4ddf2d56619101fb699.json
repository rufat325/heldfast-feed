{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get elevation at coordinates"
 },
 "description": "Look up ground elevation at up to 50 coordinates. Returns an array of [lng, lat, elevation] triples. API: GET /elevation/{locations}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "locations": {
    "description": "1-50 [longitude, latitude] pairs (latitude -85..85).",
    "items": {
     "items": false,
     "maxItems": 2,
     "minItems": 2,
     "prefixItems": [
      {
       "maximum": 180,
       "minimum": -180,
       "type": "number"
      },
      {
       "maximum": 85,
       "minimum": -85,
       "type": "number"
      }
     ],
     "type": "array"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "unit": {
    "description": "Elevation unit. Default meters.",
    "enum": [
     "meters",
     "feet"
    ],
    "type": "string"
   }
  },
  "required": [
   "locations"
  ],
  "type": "object"
 },
 "name": "maptiler_get_elevation",
 "title": "Get elevation at coordinates"
}
