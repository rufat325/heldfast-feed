{
 "description": "Substring search across model name, slug, and provider \u2014 the fast path to a model's provider/slug pair for the detail tools.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Max results (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search text, e.g. 'sonnet'",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_models",
 "title": "Search models"
}
