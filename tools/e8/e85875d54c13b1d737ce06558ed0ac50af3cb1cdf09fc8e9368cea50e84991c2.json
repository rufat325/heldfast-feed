         "null"
        ]
       },
       "latest_complete_quarter": {
        "type": "string"
       },
       "note": {
        "description": "Why the quarter is older than latest_complete_quarter (inactive tickers).",
        "type": [
         "string",
         "null"
        ]
       },
       "period": {
        "type": "string"
       },
       "previous": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "holders": {
            "type": "number"
           },
           "period": {
            "type": "string"
           },
           "quarter": {
            "type": "string"
           },
           "shares": {
            "type": [
             "number",
             "null"
            ]
           },
           "value_usd": {
            "type": [
             "number",
             "null"
            ]
           }
          },
          "required": [
           "quarter",
           "period",
           "holders",
           "shares",
           "value_usd"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "quarter": {
        "type": "string"
       },
       "shares": {
        "type": [
         "number",
         "null"
        ]
       },
       "url": {
        "type": "string"
       },
       "value_usd": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "quarter",
       "period",
       "latest_complete_quarter",
       "in_progress_quarter",
       "holders",
       "shares",
       "value_usd",
       "previous",
       "note",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "holders_url": {
    "type": "string"
   },
   "industry": {
    "type": [
     "string",
     "null"
    ]
   },
   "insider_activity": {
    "additionalProperties": false,
    "properties": {
     "buy_filings": {
      "type": "number"
     },
     "buy_value_usd": {
      "type": [
       "number",
       "null"
      ]
     },
     "sell_filings": {
