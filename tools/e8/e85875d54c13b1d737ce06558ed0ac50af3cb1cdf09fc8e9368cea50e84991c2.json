     },
     "sell_value_usd": {
      "type": [
       "number",
       "null"
      ]
     },
     "window_days": {
      "type": "number"
     }
    },
    "required": [
     "window_days",
     "buy_filings",
     "buy_value_usd",
     "sell_filings",
     "sell_value_usd"
    ],
    "type": "object"
