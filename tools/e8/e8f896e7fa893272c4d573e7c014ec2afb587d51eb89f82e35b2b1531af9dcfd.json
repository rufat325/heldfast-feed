{
 "description": "Manage locations: list, get, create, update, delete",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action",
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete"
    ],
    "type": "string"
   },
   "address_line_1": {
    "description": "Address line 1",
    "type": "string"
   },
   "address_line_2": {
    "description": "Address line 2",
    "type": "string"
   },
   "city": {
    "description": "City",
    "type": "string"
   },
   "confirm": {
    "description": "Confirm delete",
    "type": "boolean"
   },
   "country": {
    "description": "Country code (e.g., ES, US)",
    "type": "string"
   },
   "id": {
    "description": "Location ID (for get/update/delete)",
    "type": "number"
   },
   "limit": {
    "default": 100,
    "description": "Items per page",
    "type": "number"
   },
   "name": {
    "description": "Location name",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number",
    "type": "number"
   },
   "phone_number": {
    "description": "Phone number",
    "type": "string"
   },
   "postal_code": {
    "description": "Postal code",
    "type": "string"
   },
   "state": {
    "description": "State/province",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "factorial_locations",
 "title": "FactorialHR Locations"
}
