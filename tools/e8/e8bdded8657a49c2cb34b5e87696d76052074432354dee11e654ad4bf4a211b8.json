   "limit": {
    "description": "At most 25; default 10.",
    "type": [
     "number",
     "string"
    ]
   },
   "query": {
    "description": "Words (e.g. \"laptop\", \"legal services\") or 2 to 8 digits of a code.",
    "type": "string"
   },
   "type": {
    "description": "Goods (hsn), services (sac) or both (default).",
    "enum": [
     "all",
     "hsn",
     "sac"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_hsn_code",
