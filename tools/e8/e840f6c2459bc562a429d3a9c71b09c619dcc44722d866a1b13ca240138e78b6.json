{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update purchase order line"
 },
 "description": "Update a purchase order line item. Requires purchase_orders:write scope. To receive goods, set quantity_received; for a line with a part, the change is added to (or taken from) that part's stock. A line with stock received cannot change its part.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "What is being ordered",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Purchase order line ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "line_number": {
    "description": "Position on the order",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "part_id": {
    "description": "Part from inventory",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "quantity": {
    "description": "Quantity ordered",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "quantity_received": {
    "description": "Quantity received so far, 0 to quantity",
    "minimum": 0,
    "type": "number"
   },
   "unit_cost": {
    "description": "Price per unit, in the organization currency",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_purchase_order_line",
 "title": "Update purchase order line"
}
