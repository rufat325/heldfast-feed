{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A polished, copy-pasteable card (plain text) for a match (matchId), a team's next fixture (team), a group's standings table (group, e.g. \"A\"), the knockout bracket (bracket: true), a date (default: today), or live matches (live: true). Returns the ready-to-paste snippet plus structured data \u2014 hand the snippet text to the user verbatim. marketComplete:false is stated inside the card as an incomplete optional read. No links; it carries a non-affiliation disclaimer, and any market line stays informational only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bracket": {
    "description": "Knockout bracket card (use with optional knockoutStage)",
    "type": "boolean"
   },
   "date": {
    "description": "Date as YYYY-MM-DD (default: today)",
    "type": "string"
   },
   "flavor": {
    "description": "Commentary flair: off, subtle, full (default: full)",
    "enum": [
     "off",
     "subtle",
     "full"
    ],
    "type": "string"
   },
   "group": {
    "description": "Group letter A\u2013L for a standings card, e.g. A",
    "pattern": "^[A-La-l]$",
    "type": "string"
   },
   "includeHashtag": {
    "description": "Include the #VibingLaVidaLoca tag (default true)",
    "type": "boolean"
   },
   "includeInstallLine": {
    "description": "Include the \"Try it: \u2026\" run cue (default true)",
    "type": "boolean"
   },
   "includeMarkets": {
    "description": "Include the reliable market line when available (default true)",
    "type": "boolean"
   },
   "knockoutStage": {
    "description": "Filter the bracket card to one round",
    "enum": [
     "R32",
     "R16",
     "QF",
     "SF",
     "3P",
     "F"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Locale for dates, provider attribution, and commentary: en, es, pt, fr (the summary scaffold stays English; other locales fall back to en)",
    "type": "string"
   },
   "live": {
    "description": "Snapshot of matches in play right now",
    "type": "boolean"
   },
   "matchId": {
    "description": "Match id (most specific)",
    "type": "string"
   },
   "style": {
    "description": "social (default, full card) or compact (one line per match)",
    "enum": [
     "social",
     "compact"
    ],
    "type": "string"
   },
   "team": {
    "description": "3-letter team code for that team's next fixture, e.g. MEX",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "tz": {
    "description": "IANA timezone for kickoff times, e.g. America/Mexico_City",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_share_snippet",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "degraded": {
    "type": "boolean"
   },
   "group": {
    "type": "string"
   },
   "informationalOnly": {
    "type": "boolean"
   },
   "kind": {
    "type": "string"
   },
   "marketComplete": {
    "description": "False when optional market enrichment did not check every relevant fixture",
    "type": "boolean"
   },
   "marketSignals": {
    "additionalProperties": {
     "$ref": "#/properties/tables/anyOf/0"
    },
    "type": "object"
   },
   "matches": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "away": {
       "$ref": "#/properties/matches/items/properties/home"
      },
      "group": {
       "type": [
        "string",
        "null"
       ]
      },
      "home": {
       "additionalProperties": true,
       "properties": {
        "code": {
         "type": "string"
        },
        "flag": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "kickoff": {
       "type": "string"
      },
      "minute": {
       "type": [
        "number",
        "null"
       ]
      },
      "score": {
       "anyOf": [
        {
         "additionalProperties": true,
         "properties": {
          "away": {
           "type": "number"
          },
          "home": {
           "type": "number"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "shootout": {
       "$ref": "#/properties/matches/items/properties/score/anyOf/0"
      },
      "stage": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "venue": {
       "type": "string"
      },
      "winnerCode": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "responseTruncated": {
    "type": "boolean"
   },
   "responseTruncation": {
    "type": "string"
   },
   "snippet": {
    "type": "string"
   },
   "source": {
    "type": [
     "string",
     "null"
    ]
   },
   "stage": {
    "type": "string"
   },
   "style": {
    "type": "string"
   },
   "tables": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {},
      "type": "object"
     },
     {
      "items": {
       "$ref": "#/properties/tables/anyOf/0"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "target": {
    "type": "string"
   },
   "team": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   },
   "view": {
    "anyOf": [
     {
      "$ref": "#/properties/tables/anyOf/0"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "title": "Shareable match snippet"
}
