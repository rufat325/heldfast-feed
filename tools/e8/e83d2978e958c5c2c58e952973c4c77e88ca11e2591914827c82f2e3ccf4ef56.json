{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search OpenPlanr docs passages. Optional section is the URL's first segment after /docs/ (for example skills or get-started).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "query": {
    "maxLength": 500,
    "type": "string"
   },
   "section": {
    "pattern": "^[a-z][a-z0-9-]*$",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search"
}
