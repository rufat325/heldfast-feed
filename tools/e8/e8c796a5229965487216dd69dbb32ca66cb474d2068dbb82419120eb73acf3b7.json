{
 "description": "Thread memory: add message, compress old ones, ask details, get context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "add",
     "compress",
     "ask",
     "context"
    ],
    "type": "string"
   },
   "role": {
    "default": "user",
    "enum": [
     "user",
     "assistant"
    ],
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "topic": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "thread_memory"
}
