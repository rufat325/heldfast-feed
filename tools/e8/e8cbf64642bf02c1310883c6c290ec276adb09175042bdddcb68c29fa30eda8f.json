{
 "description": "Valor de la Unidad de Valor Adquisitivo del BCRA para una fecha (default hoy), o la serie diaria entre `desde` y `hasta` (m\u00e1x. 366 d\u00edas).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "desde": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "fecha": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hasta": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ar_uva",
 "title": "UVA (Argentina)"
}
