 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get performance report"
 },
 "description": "Your conversions and commission (what you earn), grouped by day, week, month, subid, campaign or status, for up to 366 days (default: last 30). Daily/weekly/monthly series include empty periods. Requires your own Clickwise affiliate API key on the MCP connection (X-API-Key header or Authorization: Bearer); acts only on your account.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "date_from": {
    "description": "YYYY-MM-DD",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "YYYY-MM-DD",
    "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
    "type": "string"
   },
   "group_by": {
    "default": "day",
    "enum": [
     "day",
     "week",
     "month",
     "subid",
     "campaign",
     "status"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "pending",
     "approved",
     "declined"
    ],
    "type": "string"
   },
   "subid": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_performance_report",
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get performance report"
