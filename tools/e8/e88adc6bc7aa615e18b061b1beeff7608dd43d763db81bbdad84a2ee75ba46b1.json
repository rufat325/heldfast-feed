{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List links of an issue (related, dependent, subtask, duplicate, epic links). Pass perPage/page for the paginated variant.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fields": {
    "description": "Comma-separated issue fields (paginated mode only)",
    "type": "string"
   },
   "issueId": {
    "description": "Issue key or id",
    "type": "string"
   },
   "linkTypes": {
    "description": "Filter by link type keys (paginated mode only)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "page": {
    "description": "Page number, default 1",
    "type": "number"
   },
   "perPage": {
    "description": "Results per page (enables paginated mode)",
    "type": "number"
   }
  },
  "required": [
   "issueId"
  ],
  "type": "object"
 },
 "name": "get_issue_links"
}
