  "readOnlyHint": false,
  "title": "Update Contacts"
 },
 "description": "Edit a domain's contacts. Provide `contacts` keyed by role with ANY subset of registrant/admin/tech/billing (unspecified roles keep their current values), or a single `contact` applied to all four. Mirrors the website: pushes to the registry on thick TLDs, and a registrant change (name/organization/email) fires the same new-owner notice/verification email \u2014 no 60-day transfer lock. Supports `dry_run`. Note: a registrant name/organization change on a .au domain, or any registrant change on an address-validation TLD (.de/.nrw), is rejected with REGISTRANT_CHANGE_NOT_SUPPORTED \u2014 do those at porkbun.com; admin/tech/billing edits still work.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address_validation_choice": {
    "description": "For a registrant change on an address-validated TLD (.de/.nrw/.uk/.us/.ca/.nyc/.au/.eu/.in/.nz families) after an ADDRESS_VALIDATION_REQUIRED response: 'accept_suggestion' saves the standardized suggestedAddress returned there; 'use_as_entered' keeps the submitted address (rejected if a real correction was offered).",
    "enum": [
     "accept_suggestion",
     "use_as_entered"
    ],
    "type": "string"
   },
   "contact": {
    "description": "A single contact applied to all four roles. Use this OR `contacts`, not both.",
    "properties": {
     "address1": {
      "description": "Street address line 1. Required.",
      "type": "string"
     },
     "address2": {
      "type": "string"
     },
     "address3": {
      "type": "string"
     },
     "city": {
      "description": "City. Required.",
      "type": "string"
     },
     "country": {
      "description": "ISO 3166-1 alpha-2 country code, e.g. `US`, `GB`. Required.",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "email": {
      "description": "Contact email. Required.",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "fax": {
      "type": "string"
     },
     "firstName": {
      "description": "Given name. Required for a provided role.",
      "type": "string"
     },
     "lastName": {
      "description": "Family name.",
      "type": "string"
     },
     "organization": {
      "description": "Company/organization name.",
      "type": "string"
     },
     "phone": {
      "description": "National phone number, digits only. Required.",
      "type": "string"
     },
     "phoneCountryCode": {
      "description": "Numeric international calling code, e.g. `1`, `44`. Required.",
      "type": "string"
     },
     "postalCode": {
      "description": "Postal/ZIP code. Required.",
      "type": "string"
     },
     "state": {
      "description": "State/province; leave empty where not applicable.",
      "type": "string"
     }
    },
    "required": [
     "firstName",
     "address1",
     "city",
     "postalCode",
     "country",
     "phone",
     "phoneCountryCode",
     "email"
    ],
    "type": "object"
