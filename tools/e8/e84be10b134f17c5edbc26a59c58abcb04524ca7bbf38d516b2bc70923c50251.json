{
 "description": "Preview or apply a symbol rename. Defaults to dry-run preview; set apply=true to execute.",
 "inputSchema": {
  "properties": {
   "apply": {
    "description": "Apply rename (default false = preview only)",
    "type": "boolean"
   },
   "character": {
    "description": "0-based character",
    "type": "number"
   },
   "file": {
    "description": "File containing the symbol",
    "type": "string"
   },
   "line": {
    "description": "0-based line",
    "type": "number"
   },
   "new_name": {
    "description": "New symbol name",
    "type": "string"
   },
   "position": {
    "description": "Alternative: path:line:col (1-based)",
    "type": "string"
   }
  },
  "required": [
   "new_name"
  ],
  "type": "object"
 },
 "name": "rename"
}
