{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Resolve an arbitrary address, including an interior instruction or exact external entry, to its provider-analyzed containing procedure. A negative result distinguishes outside segments from not in a procedure and is never guessed from nearby symbols.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "address": "0x1000"
   }
  ],
  "properties": {
   "address": {
    "description": "A provider-normalized address; default memory uses 0x-prefixed hexadecimal",
    "type": "string"
   },
   "document": {
    "description": "The document name",
    "type": "string"
   },
   "unknown_registry_approved": {
    "const": true,
    "description": "Explicit approval to record typed capability unavailability as a residual unknown",
    "type": "boolean"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "resolve_containing_procedure",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "found": {
        "const": true,
        "type": "boolean"
       },
       "procedure": {
        "additionalProperties": false,
        "properties": {
         "address": {
          "type": "string"
         },
         "classification": {
          "anyOf": [
           {
            "additionalProperties": false,
            "properties": {
             "external": {
              "type": "boolean"
             },
             "provenance": {
              "minLength": 1,
              "type": "string"
             },
             "thunk": {
              "type": "boolean"
             },
             "thunk_target": {
              "anyOf": [
               {
                "type": "string"
               },
               {
                "type": "null"
               }
              ]
             }
            },
            "required": [
             "external",
             "thunk",
             "thunk_target",
             "provenance"
            ],
            "type": "object"
           },
           {
            "type": "null"
           }
          ],
          "default": null
         },
         "name": {
          "type": "string"
         }
        },
        "required": [
         "address",
         "name",
         "classification"
        ],
        "type": "object"
       },
       "query_address": {
        "type": "string"
       }
      },
      "required": [
       "query_address",
       "found",
       "procedure"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "found": {
        "const": false,
        "type": "boolean"
       },
       "procedure": {
        "type": "null"
       },
       "query_address": {
        "type": "string"
       },
       "reason": {
        "enum": [
         "outside_segments",
         "not_in_procedure"
        ],
        "type": "string"
       }
      },
      "required": [
       "query_address",
       "found",
       "procedure",
       "reason"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Resolve Containing Procedure"
}
