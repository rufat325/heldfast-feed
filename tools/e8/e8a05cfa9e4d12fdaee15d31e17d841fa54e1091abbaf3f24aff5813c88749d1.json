{
 "description": "Convenience wrapper over compute for a transit reading: compares a transit `moment` against a `natal` chart and returns transit aspects plus the annual profection (lord of the year).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "moment": {
    "description": "The transit moment (typically \"now\").",
    "properties": {
     "datetimeLocal": {
      "description": "Local civil datetime, ISO without offset, e.g. \"1990-05-21T14:30:00\".",
      "type": "string"
     },
     "houseSystem": {
      "description": "Single-letter house system code, default \"P\".",
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "description": "IANA zone, e.g. \"America/New_York\".",
      "type": "string"
     }
    },
    "required": [
     "datetimeLocal",
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "natal": {
    "description": "The natal chart to compare against.",
    "properties": {
     "datetimeLocal": {
      "description": "Local civil datetime, ISO without offset, e.g. \"1990-05-21T14:30:00\".",
      "type": "string"
     },
     "houseSystem": {
      "description": "Single-letter house system code, default \"P\".",
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "description": "IANA zone, e.g. \"America/New_York\".",
      "type": "string"
     }
    },
    "required": [
     "datetimeLocal",
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "relocation": {
    "properties": {
     "datetimeLocal": {
      "type": "string"
     },
     "houseSystem": {
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "timezone": {
      "type": "string"
     }
    },
    "required": [
     "latitude",
     "longitude"
    ],
    "type": "object"
   }
  },
  "required": [
   "moment",
   "natal"
  ],
  "type": "object"
 },
 "name": "transit",
 "title": "Transit + profection (convenience)"
}
