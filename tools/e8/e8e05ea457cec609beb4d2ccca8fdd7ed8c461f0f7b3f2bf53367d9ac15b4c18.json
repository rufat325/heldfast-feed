{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"Sign a proposal made by acquire_posting_rights, append_message or clear_message under AUTO_BID=false. Re-reads the billboard and refuses if the poster, amount or message changed since the proposal (stale), re-checks MAX_BID_SOL and DAILY_CAP_SOL, then executes and logs. Proposals expire after PROPOSAL_TTL_MIN minutes (default 60) and can be approved once; a tool has one open proposal at a time, so proposing again refuses the older id with `superseded` and names its replacement. This is the call to put a permission prompt on: the server cannot see the human, only this call.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"proposal_id":{"description":"The proposal_id returned by acquire_posting_rights, append_message or clear_message.","minLength":1,"type":"string"}},"required":["proposal_id"],"type":"object"},"name":"approve_proposal","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"bid_sol":{"description":"Gross bid for an acquire proposal.","pattern":"^\\d+(\\.\\d{1,9})?$","type":"string"},"billboard_after":{"additionalProperties":false,"properties":{"amount_sol":{"pattern":"^\\d+(\\.\\d{1,9})?$","type":"string"},"message_bytes":{"maximum":4096,"minimum":0,"type":"integer"},"poster":{"type":"string"},"you_are_poster":{"type":"boolean"}},"required":["poster","amount_sol","message_bytes","you_are_poster"],"type":"object"},"billboard_at_proposal":{"additionalProperties":false,"properties":{"amount_sol":{"pattern":"^\\d+(\\.\\d{1,9})?$","type":"string"},"message_bytes":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"poster":{"type":"string"}},"required":["poster","amount_sol","message_bytes"],"type":"object"},"billboard_now":{"additionalProperties":false,"description":"The billboard as re-read by this call