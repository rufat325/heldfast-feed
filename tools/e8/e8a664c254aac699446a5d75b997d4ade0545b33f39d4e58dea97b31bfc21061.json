{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Write receipt (hubs)"
 },
 "description": "Hubs only (x-hub-key): lodge one receipt for a gate decision \u2014 the hash on the Confidential Ledger, the receipt kept and served by decision_id. Idempotent on decision_id.",
 "inputSchema": {
  "properties": {
   "receipt": {
    "properties": {
     "actor_class": {
      "type": "string"
     },
     "decided_at": {
      "type": "string"
     },
     "decision_id": {
      "description": "the hub gate decision id",
      "pattern": "^gate_[a-f0-9]{16,40}$",
      "type": "string"
     },
     "gtin": {
      "pattern": "^[0-9]{14}$",
      "type": "string"
     },
     "hub": {
      "enum": [
       "a2a-grocery",
       "a2a-cosmetics",
       "a2a-peptides"
      ],
      "type": "string"
     },
     "hub_signature": {
      "description": "the hub's detached JWS over the receipt (keys sorted, compact JSON), verified against the hub keyring",
      "properties": {
       "alg": {
        "type": "string"
       },
       "jws": {
        "type": "string"
       },
       "kid": {
        "type": "string"
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "market": {
      "pattern": "^[A-Z]{2}$",
      "type": "string"
     },
     "reason_code": {
      "type": "string"
     },
     "record": {
      "description": "the gtinfetch answer the decision read: source_page, fetch_date, status, kid",
      "properties": {
       "fetch_date": {
        "type": [
         "string",
         "null"
        ]
       },
       "kid": {
        "type": [
         "string",
         "null"
        ]
       },
       "source_page": {
        "type": [
         "string",
         "null"
        ]
       },
       "status": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "result": {
      "type": "string"
     },
     "rule_set": {
      "properties": {
       "id": {
        "type": "string"
       },
       "version": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     }
    },
    "required": [
     "decision_id",
     "hub",
     "gtin",
     "market",
     "actor_class",
     "result",
     "reason_code",
     "rule_set",
     "decided_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "receipt"
  ],
  "type": "object"
 },
 "name": "write_receipt",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "decision_id": {
    "type": "string"
   },
   "idempotent": {
    "type": "boolean"
   },
   "ledger": {
    "type": "object"
   },
   "page": {
    "type": "string"
   },
   "receipt_url": {
    "type": "string"
   },
   "written": {
    "type": "boolean"
   }
  },
  "required": [
   "written",
   "decision_id",
   "receipt_url",
   "ledger"
  ],
  "type": "object"
 },
 "title": "Write receipt (hubs)"
}
