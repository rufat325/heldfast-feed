{
 "description": "Search marketplace listings by free text, tag, capability, or transport. Returns listing summaries with slug, transport, endpoint, and price. For capability + budget ranking, use discover instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "description": "Filter by capability, e.g. \"flight-booking\"",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search across name, description, slug",
    "type": "string"
   },
   "tag": {
    "description": "Filter by tag, e.g. \"travel\", \"finance\"",
    "type": "string"
   },
   "transport": {
    "description": "Filter by transport type",
    "enum": [
     "mcp-stdio",
     "mcp-http",
     "http-x402",
     "http"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_agents"
}
