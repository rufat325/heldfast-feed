 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare inside and outside IR35"
 },
 "description": "Compare a contractor's take-home pay working inside IR35 (deemed employment payment, employer National Insurance) with working outside IR35 through a limited company, from the day rate and working days, for a tax year. It compares pay; it does not decide IR35 status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accountancyCost": {
    "description": "Accountancy cost a year",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "businessExpenses": {
    "description": "Business expenses a year",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "dayRate": {
    "description": "Day rate charged",
    "maximum": 100000000,
    "minimum": 0,
    "type": "number"
   },
   "taxYear": {
    "description": "UK tax year, e.g. \"2026-27\". Defaults to the current one.",
    "enum": [
     "2026-27",
     "2025-26",
     "2024-25"
    ],
    "type": "string"
   },
   "workingDays": {
    "description": "Days worked in the year",
    "exclusiveMinimum": 0,
    "maximum": 366,
    "type": "number"
   }
  },
  "required": [
   "dayRate",
   "workingDays"
  ],
  "type": "object"
 },
 "name": "compare_inside_and_outside_ir35",
 "title": "Compare inside and outside IR35"
}
