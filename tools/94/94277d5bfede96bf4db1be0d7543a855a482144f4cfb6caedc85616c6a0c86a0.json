{
 "description": "Create a new lead in the CRM. Returns the newly created lead record.",
 "inputSchema": {
  "properties": {
   "company": {
    "description": "Lead's company or organization",
    "type": "string"
   },
   "email": {
    "description": "Lead's email address",
    "type": "string"
   },
   "first_name": {
    "description": "Lead's first name",
    "type": "string"
   },
   "last_name": {
    "description": "Lead's last name",
    "type": "string"
   },
   "linkedin_url": {
    "description": "URL to the lead's LinkedIn profile",
    "type": "string"
   },
   "notes": {
    "description": "Free-form notes about the lead",
    "type": "string"
   },
   "phone": {
    "description": "Lead's phone number",
    "type": "string"
   },
   "source": {
    "description": "How the lead was acquired (e.g. \"mcp\", \"manual\", \"linkedin\")",
    "type": "string"
   },
   "title": {
    "description": "Lead's job title",
    "type": "string"
   }
  },
  "required": [
   "first_name",
   "last_name"
  ],
  "type": "object"
 },
 "name": "create_lead"
}
