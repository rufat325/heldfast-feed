  "readOnlyHint": true,
  "title": "utilpeek: topic trends over time from public attention (Wikipedia views, Hacker News, news), not Google Trends"
 },
 "description": "utilpeek: Use when an agent must tell if interest in a topic is rising or fading: Wikipedia, Hacker News and news over time. For the articles use news_search. Returns daily topic trends for 1 to 5 topics: Wikipedia page views per language, Hacker News counts, news mentions, with 7- and 28-day change, spike days, direction and share. Not Google Trends data. Public attention signals, not Google Trends or search volume. `related`: related Wikipedia topics ranked by page views; not search queries and not Google Trends data. Topic = top English Wikipedia hit (see `article.title`). Complete days to yesterday; news only for the last 14 days. Cached 6 h. Bad input is a 422 and an upstream failure a 503 or 504 (not charged). Typically 3 to 15 s (first call for a topic; cached for 6 hours). Price: USD 0.005. Free: 10 utilpeek calls per IP per UTC day. Docs: https://tanod.dev/learn/topic-trends-attention-api.html",
 "inputSchema": {
  "properties": {
   "end": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Last day, YYYY-MM-DD (UTC), at most yesterday (later is clamped to it). Default: yesterday. The range is at most 365 days.",
    "title": "End"
   },
   "languages": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[A-Za-z]{2,3}$",
       "type": "string"
      },
      "maxItems": 6,
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional Wikipedia language codes, at most 6 (en, de, ja ...). Default: en plus the four most-read languages that have the article. A language without the article is listed under `languages_skipped`.",
    "title": "Languages"
   },
   "related": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Default false. True (one topic only) adds `related`: up to 10 `top` and 10 `rising` related Wikipedia topics, ranked by page views; not search queries and not Google Trends data.",
    "title": "Related"
   },
   "start": {
    "anyOf": [
     {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "First day, YYYY-MM-DD (UTC). Default: 90 days ending at `end`.",
    "title": "Start"
   },
   "topics": {
    "description": "1 to 5 topics (words or a name, up to 100 characters each). Each is resolved to the top English Wikipedia search hit, reported as `article.title`. Several topics are compared: each gets its relative share.",
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "title": "Topics",
    "type": "array"
   }
  },
  "required": [
   "topics"
  ],
