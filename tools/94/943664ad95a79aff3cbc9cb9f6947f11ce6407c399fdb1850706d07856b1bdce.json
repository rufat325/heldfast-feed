     "additionalProperties": false,
     "properties": {
      "path": {
       "type": "string"
      },
      "sha256": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "size_bytes": {
       "minimum": 0,
       "type": "integer"
      },
      "storage_tier": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "candidate_count": {
    "minimum": 0,
