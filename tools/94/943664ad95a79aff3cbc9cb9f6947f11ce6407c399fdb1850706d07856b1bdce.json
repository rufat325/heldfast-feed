    "items": {
     "additionalProperties": false,
     "properties": {
      "fail_bytes": {
       "minimum": 0,
       "type": "integer"
      },
      "path": {
       "type": "string"
      },
      "size_bytes": {
       "minimum": 0,
       "type": "integer"
      },
      "status": {
       "enum": [
        "ok",
        "warn",
        "fail"
       ],
       "type": "string"
      },
      "warn_bytes": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "path",
      "size_bytes",
      "warn_bytes",
      "fail_bytes",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "artifact_count": {
    "minimum": 0,
    "type": "integer"
   },
   "artifact_size_bytes": {
    "minimum": 0,
    "type": "integer"
   },
