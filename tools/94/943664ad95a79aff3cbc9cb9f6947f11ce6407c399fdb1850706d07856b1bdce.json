      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Null on a healthy build. Non-null with dropped_captured > 0 means this build lost every captured schema in the committed index -- validate.ts fails on it."
   },
   "schema_version": {
    "const": 1,
