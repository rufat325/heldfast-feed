{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a custom field"
 },
 "description": "Create a custom field. field_key is permanent after creation. Up to 15 active fields.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "field_key": {
    "pattern": "^[a-z0-9_]{1,50}$",
    "type": "string"
   },
   "label": {
    "maxLength": 100,
    "type": "string"
   },
   "type": {
    "enum": [
     "text",
     "number",
     "date",
     "boolean"
    ],
    "type": "string"
   }
  },
  "required": [
   "field_key",
   "label",
   "type"
  ],
  "type": "object"
 },
 "name": "create_custom_field"
}
