{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a Cloud Insight event rule by directly specifying monitoring targets and metrics (without pre-created groups).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cfgRuleList": {
    "description": "Rule configurations",
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregation": {
       "description": "Aggregation type",
       "enum": [
        "AVG",
        "MIN",
        "MAX",
        "SUM",
        "COUNT"
       ],
       "type": "string"
      },
      "condition": {
       "description": "Threshold condition",
       "enum": [
        "GT",
        "GTE",
        "LT",
        "LTE",
        "EQ"
       ],
       "type": "string"
      },
      "duration": {
       "description": "Duration in minutes",
       "type": "number"
      },
      "eventLevel": {
       "description": "Event severity level",
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "metricGroupItemId": {
       "description": "Metric item ID",
       "type": "string"
      },
      "threshold": {
       "description": "Threshold value",
       "type": "number"
      }
     },
     "required": [
      "metricGroupItemId",
      "condition",
      "threshold",
      "duration",
      "eventLevel"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "groupName": {
    "description": "Name of the rule group",
    "type": "string"
   },
   "prodKey": {
    "description": "Product key (cw_key)",
    "type": "string"
   },
   "recipientNotification": {
    "description": "Notification recipients",
    "items": {
     "additionalProperties": false,
     "properties": {
      "notificationType": {
       "description": "Notification type",
       "enum": [
        "EMAIL",
        "SMS",
        "WEBHOOK"
       ],
       "type": "string"
      },
      "recipient": {
       "description": "Notification recipient",
       "type": "string"
      }
     },
     "required": [
      "notificationType",
      "recipient"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "resourceList": {
    "description": "Array of resource dimension objects to monitor",
    "items": {
     "additionalProperties": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "groupName",
   "prodKey",
   "resourceList",
   "cfgRuleList"
  ],
  "type": "object"
 },
 "name": "ncloud_create_rule_directly"
}
