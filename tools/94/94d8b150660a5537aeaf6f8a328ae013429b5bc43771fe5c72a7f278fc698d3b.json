{
 "description": "Simulate the effect of adding or removing collateral, or borrowing/repaying debt on an Aave V3 position. Returns the projected health factor and collateral/debt totals. No transaction is sent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "add_collateral",
     "remove_collateral",
     "borrow",
     "repay"
    ],
    "type": "string"
   },
   "amountUsd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "asset": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "chain": {
    "default": "ethereum",
    "enum": [
     "ethereum",
     "arbitrum",
     "polygon",
     "base"
    ],
    "type": "string"
   },
   "wallet": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "wallet",
   "action",
   "asset",
   "amountUsd"
  ],
  "type": "object"
 },
 "name": "simulate_position_change"
}
