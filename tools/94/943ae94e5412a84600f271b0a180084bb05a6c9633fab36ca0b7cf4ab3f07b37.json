{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Put two or more frontier models side by side on the benchmark results recorded for them (score, unit, source table and evidence grade per benchmark), optionally with their rows in one profession's ranking. Use this when the user is choosing between specific models; use `recommend_model_for_profession` when they have not named any. No new aggregate is computed. Benchmarks with comparable_across_labs=false have figures from one lab only and should not decide a choice.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"models":{"description":"Model ids or names, e.g. ['claude-opus-5.5', 'GPT-6 Astra'].","items":{"maxLength":128,"minLength":1,"type":"string"},"maxItems":8,"minItems":2,"type":"array"},"profession":{"description":"Optional profession id or name, to include the models' rows in its ranking.","maxLength":128,"minLength":1,"type":"string"}},"required":["models"],"type":"object"},"name":"compare_models","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"available_models":{"items":{"type":"string"},"type":"array"},"benchmarks":{"items":{"additionalProperties":false,"properties":{"benchmark":{"type":"string"},"comparable_across_labs":{"type":"boolean"},"scores":{"items":{"additionalProperties":{},"properties":{},"type":"object"},"type":"array"}},"required":["benchmark","comparable_across_labs","scores"],"type":"object"},"type":"array"},"canonical_url":{"type":"string"},"dataset_version":{"type":"string"},"models":{"items":{"additionalProperties":false,"properties":{"id":{"type":"string"},"name":{"type":"string"},"org":{"type":"string"}},"required":["id","name","org"],"type":"object"},"type":"array"},"note":{"type":"string"},"profession":{"anyOf":[{"additionalProperties":false,"properties":{"evaluation":{"enum":["direct","indirect"],"type":"string"},"id":{"type":"string"},"not_ranked":{"items":{"additionalProperties":{},"properties":{},"type":"object"},"type":"array"},"rows":{"items":{"additionalProperties":{},"properties":{"id":{"type":"string"},"name":{"type":"string"},"org":{"type":"string"},"score":{"type":"number"}},"required":["id","name","org","score"],"type":"object"},"type":"array"}},"required":["id","evaluation","rows","not_ranked"],"type":"object"},{"type":"null"}]},"radar_version":{"type":"string"},"unknown_models":{"items":{"type":"string"},"type":"array"}},"required":["models","unknown_models","available_models","profession","benchmarks","note","dataset_version","radar_version","canonical_url"],"type":"object"},"title":"Compare AI models on published benchmark results"}
