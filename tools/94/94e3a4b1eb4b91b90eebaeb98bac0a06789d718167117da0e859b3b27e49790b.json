{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "List an already-uploaded file on the public Payaion marketplace. The upload must be READY status and have a price set. Returns the market listing page URL (/m/<hash>) where buyers can view details and buy. Requires the agent key owner to own the upload.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Optional file category",
    "enum": [
     "reports",
     "datasets",
     "code",
     "media",
     "models",
     "prompts",
     "other"
    ],
    "type": "string"
   },
   "description": {
    "description": "What the buyer gets (40\u2013500 characters). Required.",
    "maxLength": 500,
    "minLength": 40,
    "type": "string"
   },
   "tags": {
    "description": "Optional tags for discoverability (max 8, alphanumeric with hyphens)",
    "items": {
     "maxLength": 30,
     "pattern": "^[a-zA-Z0-9-]+$",
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "title": {
    "description": "Listing title (3\u2013120 characters).",
    "maxLength": 24,
    "minLength": 3,
    "type": "string"
   },
   "uploadId": {
    "description": "Upload ID to list (e.g. up_a1b2c3d4e5f6g7h8)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "uploadId",
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "list_on_marketplace",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "listed": {
    "description": "Whether the file was successfully listed",
    "type": "boolean"
   },
   "uploadId": {
    "description": "Upload ID that was listed",
    "type": "string"
   },
   "url": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Unified page URL for the listing"
   }
  },
  "required": [
   "listed",
   "uploadId",
   "url"
  ],
  "type": "object"
 },
 "title": "List on Marketplace"
}
