{
 "description": "List the user's issued client invoices (accounts receivable) \u2014 who owes them money, how much, and when it is due. Examples: 'which invoices are outstanding', 'what does Acme still owe me', 'any overdue invoices', 'how much am I waiting to get paid'. status accepts 'active' (default), 'open', 'overdue', 'needs_review', 'paid', 'void', 'superseded', or 'all'. Returns invoice numbers, status, totals by currency, delivery state, and private document links. Read-only.",
 "inputSchema": {
  "properties": {
   "clientEmail": {
    "description": "Client account email. Accountants may use this only for an accepted ExpenseBot client.",
    "format": "email",
    "type": "string"
   },
   "clientName": {
    "description": "Optional: exact client name (case-insensitive).",
    "type": "string"
   },
   "limit": {
    "description": "Max invoices to return (default 25, max 100).",
    "type": "number"
   },
   "status": {
    "description": "Filter by invoice status (default active/outstanding).",
    "enum": [
     "active",
     "open",
     "overdue",
     "needs_review",
     "paid",
     "void",
     "superseded",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_client_invoices",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "invoices": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "advanceApplied": {
       "type": "number"
      },
      "clientName": {
       "type": [
        "string",
        "null"
       ]
      },
      "currency": {
       "type": "string"
      },
      "displayStatus": {
       "enum": [
        "open",
        "overdue",
        "paid",
        "void",
        "superseded",
        "needs_review"
       ],
       "type": "string"
      },
      "grandTotal": {
       "type": "number"
      },
      "invoiceId": {
       "type": "string"
      },
      "invoiceNumber": {
       "type": [
        "string",
        "null"
       ]
      },
      "issueDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": "string"
      },
      "total": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "invoices"
  ],
  "type": "object"
 }
}
