{"description":"Invoices in one shop, newest first. Filter by status or by a customer name or invoice id. Read only. A shop you cannot access is not found. Seeing the amounts needs see_prices, the same as invoices.get.","inputSchema":{"properties":{"cursor":{"maxLength":500,"type":"string"},"limit":{"maximum":200,"minimum":1,"type":"integer"},"q":{"maxLength":200,"type":"string"},"shop_id":{"format":"uuid","type":"string"},"status":{"enum":["draft","sent","partially_paid","paid","partially_refunded","refunded","void"],"type":"string"}},"required":["shop_id"],"type":"object"},"name":"invoices_list","outputSchema":{"properties":{"data":{"items":{"properties":{"created_at":{"format":"date-time","type":"string"},"customer":{"type":["string","null"]},"due_on":{"format":"date","type":["string","null"]},"invoice_id":{"format":"uuid","type":"string"},"issued_at":{"format":"date-time","type":["string","null"]},"job_id":{"format":"uuid","type":"string"},"status":{"type":"string"},"total_minor":{"description":"Amount in minor units of the currency (cents).","type":"integer"}},"required":["invoice_id","job_id","status","customer","total_minor","issued_at","due_on","created_at"],"type":"object"},"type":"array"},"next_cursor":{"type":["string","null"]}},"required":["data","next_cursor"],"type":"object"}}
