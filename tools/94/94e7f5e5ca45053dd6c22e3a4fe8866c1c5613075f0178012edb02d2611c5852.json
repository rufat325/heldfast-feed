{
 "description": "Log an audit event for an agent action. Every agent action should be logged for compliance and traceability. NOTE: events emitted via the MCP server are sent unsigned because the MCP server does not hold the agent's private key. For tamper-evident audit trails sign client-side via @vorim/sdk before emit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "What the agent did (e.g. 'search_documents', 'send_email')",
    "type": "string"
   },
   "agent_id": {
    "description": "The agent that performed the action",
    "type": "string"
   },
   "error_code": {
    "description": "Error code if result is 'error'",
    "type": "string"
   },
   "event_type": {
    "description": "Event category",
    "enum": [
     "tool_call",
     "api_request",
     "message_sent",
     "permission_change",
     "status_change",
     "key_rotation",
     "login",
     "export"
    ],
    "type": "string"
   },
   "latency_ms": {
    "description": "Execution time in milliseconds",
    "type": "number"
   },
   "permission": {
    "description": "Permission scope used",
    "enum": [
     "agent:read",
     "agent:write",
     "agent:execute",
     "agent:transact",
     "agent:communicate",
     "agent:delegate",
     "agent:elevate"
    ],
    "type": "string"
   },
   "resource": {
    "description": "Target resource identifier",
    "type": "string"
   },
   "result": {
    "description": "Outcome",
    "enum": [
     "success",
     "denied",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "event_type",
   "action",
   "result"
  ],
  "type": "object"
 },
 "name": "vorim_emit_event"
}
