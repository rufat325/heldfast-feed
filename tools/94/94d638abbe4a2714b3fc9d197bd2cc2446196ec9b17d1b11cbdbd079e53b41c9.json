{
 "description": "Send a payment directly to a node without an invoice (keysend/spontaneous payment). REQUIRES AGENT KEY.",
 "inputSchema": {
  "properties": {
   "amount_sats": {
    "description": "Amount in satoshis",
    "minimum": 1,
    "type": "integer"
   },
   "destination": {
    "description": "Destination node public key",
    "type": "string"
   },
   "message": {
    "description": "Optional TLV message",
    "maxLength": 1000,
    "type": "string"
   }
  },
  "required": [
   "destination",
   "amount_sats"
  ],
  "type": "object"
 },
 "name": "keysend"
}
