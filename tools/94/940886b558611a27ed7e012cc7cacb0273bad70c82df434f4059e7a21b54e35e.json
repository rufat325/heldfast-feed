{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Recommend by mood"
 },
 "description": "Returns top-N Romanian TV programs ranked for a given mood (obosit/vesel/concentrat/romantic/familie/captivant \u2014 RO/EN aliases accepted). Combines: channel category, mood-fit (genre + duration + keywords), time proximity, and streaming cross-reference. Output includes mood_parts breakdown and freshness embedded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dislike_genres": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dislike_keywords": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "include_streaming_xref": {
    "default": true,
    "type": "boolean"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "mood": {
    "description": "Mood: obosit | vesel | concentrat | romantic | familie | captivant (also accepts tired, happy, focused, family, thrilling, etc.)",
    "maxLength": 40,
    "minLength": 2,
    "type": "string"
   },
   "prefer": {
    "description": "Additional channel-category preferences (additive boost)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeframe": {
    "default": "tonight",
    "description": "now | tonight | primetime | tomorrow | weekend | today | YYYY-MM-DD | ISO range \"A/B\"",
    "type": "string"
   }
  },
  "required": [
   "mood"
  ],
  "type": "object"
 },
 "name": "tv_recommend_by_mood",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asked_at_utc": {
    "type": "string"
   },
   "count": {
    "type": "number"
   },
   "freshness": {
    "additionalProperties": true,
    "properties": {
     "epg_age_min": {
      "type": [
       "number",
       "null"
      ]
     },
     "stale": {
      "type": "boolean"
     },
     "streaming_age_min": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "stale"
    ],
    "type": "object"
   },
   "generated_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "properties": {},
     "type": "object"
    },
    "type": "array"
   },
   "mood": {
    "type": "string"
   },
   "mood_label_ro": {
    "type": "string"
   },
   "timeframe_label": {
    "type": "string"
   },
   "window": {
    "additionalProperties": true,
    "properties": {
     "from_utc": {
      "type": "string"
     },
     "to_utc": {
      "type": "string"
     }
    },
    "required": [
     "from_utc",
     "to_utc"
    ],
    "type": "object"
   }
  },
  "required": [
   "asked_at_utc",
   "mood",
   "mood_label_ro",
   "timeframe_label",
   "window",
   "count",
   "items",
   "freshness"
  ],
  "type": "object"
 },
 "title": "Recommend by mood"
}
