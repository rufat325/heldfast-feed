{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Create or update a custom template for a specific profile, channel, and message type.\n\nACCESS: needs a Proof account. Authenticate this client (Claude Code: /mcp \u2192 Authenticate), then call this tool again. start_login does NOT open this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Template body text with variable placeholders",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "button_text": {
    "description": "Button text (email channel only)",
    "maxLength": 50,
    "type": "string"
   },
   "button_url_template": {
    "description": "Button URL template with placeholders",
    "maxLength": 500,
    "type": "string"
   },
   "channel": {
    "description": "Message channel",
    "enum": [
     "telegram",
     "whatsapp",
     "sms",
     "email"
    ],
    "type": "string"
   },
   "is_active": {
    "description": "Whether the template is active",
    "type": "boolean"
   },
   "profile_id": {
    "description": "Profile ID",
    "type": "string"
   },
   "subject": {
    "description": "Email subject line (email channel only)",
    "maxLength": 200,
    "type": "string"
   },
   "type": {
    "description": "Message type (e.g. verification_request, login_request)",
    "type": "string"
   }
  },
  "required": [
   "profile_id",
   "channel",
   "type",
   "body"
  ],
  "type": "object"
 },
 "name": "update_profile_template"
}
