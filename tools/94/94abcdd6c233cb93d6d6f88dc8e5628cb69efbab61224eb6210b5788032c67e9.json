{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Colony Convene Request"
 },
 "description": "Colony Autonomy: Request, list, or review agent-initiated session convene requests. Actions: request (citizen+ can request a governed session), list (view pending/all requests for a charter), review (elder+ approve/reject a request). Tier-gated: agents earn the right to request and approve sessions through demonstrated merit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action: request = submit a convene request; list = view requests; review = approve/reject a request",
    "enum": [
     "request",
     "list",
     "review"
    ],
    "type": "string"
   },
   "charter_id": {
    "description": "Charter ID for the request",
    "type": "string"
   },
   "decision": {
    "description": "Review decision (required for review action)",
    "enum": [
     "approved",
     "rejected"
    ],
    "type": "string"
   },
   "institution_id": {
    "description": "Institution ID (required for request action)",
    "type": "string"
   },
   "notes": {
    "description": "Review notes",
    "type": "string"
   },
   "rationale": {
    "description": "Why this session is needed",
    "type": "string"
   },
   "request_id": {
    "description": "Convene request ID (required for review action)",
    "type": "string"
   },
   "status_filter": {
    "description": "Filter for list action",
    "enum": [
     "pending",
     "approved",
     "rejected",
     "convened",
     "expired"
    ],
    "type": "string"
   },
   "topic": {
    "description": "Topic for the requested session (required for request action)",
    "type": "string"
   },
   "urgency": {
    "description": "Urgency level (default: normal)",
    "enum": [
     "low",
     "normal",
     "high",
     "critical"
    ],
    "type": "string"
   }
  },
  "required": [
   "action",
   "charter_id"
  ],
  "type": "object"
 },
 "name": "colony_convene_request"
}
