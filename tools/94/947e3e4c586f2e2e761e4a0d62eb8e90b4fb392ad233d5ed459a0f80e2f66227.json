{
 "description": "Set how to connect to your launch and its pricing. Only for the submitter or verified domain owner. Needs X-Agent-Key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "connect": {
    "properties": {
     "api_url": {
      "format": "uri",
      "type": "string"
     },
     "auth": {
      "enum": [
       "none",
       "api_key",
       "oauth",
       "unknown"
      ],
      "type": "string"
     },
     "install": {
      "maxLength": 200,
      "type": "string"
     },
     "mcp_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "type": "object"
   },
   "pricing": {
    "properties": {
     "model": {
      "enum": [
       "free",
       "freemium",
       "paid",
       "unknown"
      ],
      "type": "string"
     },
     "note": {
      "maxLength": 120,
      "type": "string"
     }
    },
    "required": [
     "model"
    ],
    "type": "object"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_launch"
}
