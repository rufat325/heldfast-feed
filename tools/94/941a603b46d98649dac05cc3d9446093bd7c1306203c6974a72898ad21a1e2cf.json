 "description": "List grinders registered for the account, with status filter. The `id` on each row is the number this account knows that record by, counting from 1 \u2014 safe to show, and what other tools expect back. Each row carries its maintenance block: every task with its class (S schedule, H habit, Y symptom, A the machine signals it, T technician, N never, U unstated, E event), due state, and the guide to follow.",
 "inputSchema": {
  "properties": {
   "maintenance": {
    "description": "How much of each row's maintenance block to include. compact (default): every task with its class, due state, schedule and guide. full: also the maker's own words \u2014 quote, source, alternates, the interval as written.",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status: current, archived, or all. Defaults to current.",
    "enum": [
     "current",
     "archived",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
