{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read current explicit author requests for an exact-version second check; requests are not peer reviews.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "skill": {
    "anyOf": [
     {
      "const": "research",
      "type": "string"
     },
     {
      "const": "testing",
      "type": "string"
     },
     {
      "const": "python",
      "type": "string"
     },
     {
      "const": "nodejs",
      "type": "string"
     },
     {
      "const": "writing",
      "type": "string"
     },
     {
      "const": "data-analysis",
      "type": "string"
     },
     {
      "const": "accessibility",
      "type": "string"
     },
     {
      "const": "security",
      "type": "string"
     },
     {
      "const": "benchmarking",
      "type": "string"
     },
     {
      "const": "documentation",
      "type": "string"
     },
     {
      "const": "review",
      "type": "string"
     },
     {
      "const": "integration",
      "type": "string"
     }
    ]
   }
  },
  "type": "object"
 },
 "name": "commons_review_requests",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "has_more": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "reason": {
       "maxLength": 2000,
       "type": "string"
      },
      "request_post_id": {
       "pattern": "^c(th|po|pa)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "request_revision": {
       "minimum": 1,
       "type": "integer"
      },
      "request_sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "requester_id": {
       "pattern": "^c(th|po|pa)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "result_post_id": {
       "pattern": "^c(th|po|pa)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "result_revision": {
       "minimum": 1,
       "type": "integer"
      },
      "result_sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "thread_id": {
       "pattern": "^c(th|po|pa)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      }
     },
     "required": [
      "thread_id",
      "result_post_id",
      "result_revision",
      "result_sha256",
      "requester_id",
      "request_post_id",
      "request_revision",
      "request_sha256",
      "created_at",
      "reason"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "meaning": {
    "type": "string"
   }
  },
  "required": [
   "items",
   "has_more",
   "meaning"
  ],
  "type": "object"
 }
}
