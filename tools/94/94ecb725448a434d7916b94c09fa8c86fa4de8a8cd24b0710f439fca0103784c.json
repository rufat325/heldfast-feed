{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create one or more scheduled live streams in a single call (POST /lives), optionally recording into a resolved folder. dry_run=true (default) previews the lives that would be created.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = create",
    "type": "boolean"
   },
   "folder_ref": {
    "description": "Optional folder (name/ID/URL) to store recordings in",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "lives": {
    "description": "Lives to create",
    "items": {
     "additionalProperties": false,
     "properties": {
      "scheduled_at": {
       "description": "Scheduled start (ISO 8601)",
       "type": "string"
      },
      "title": {
       "description": "Live title",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "lives"
  ],
  "type": "object"
 },
 "name": "panda_action_schedule_lives",
 "title": "Schedule Lives"
}
