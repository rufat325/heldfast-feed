{
 "annotations": {
  "idempotentHint": true
 },
 "description": "Mark resources as refreshed after you have verified their content is still valid",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ids": {
    "description": "Resource IDs to mark as refreshed",
    "items": {
     "exclusiveMinimum": 0,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "mark_resources_refreshed",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "affected": {
    "description": "Number of resources marked as refreshed",
    "type": "number"
   },
   "skillsToReview": {
    "description": "Skills that reference the refreshed resources",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "number"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "affected",
   "skillsToReview"
  ],
  "type": "object"
 },
 "title": "Mark Resources as Refreshed"
}
