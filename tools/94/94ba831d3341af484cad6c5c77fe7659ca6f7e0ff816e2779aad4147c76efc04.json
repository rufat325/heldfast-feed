{
 "description": "Read the App Store surfaces beyond the listing text: search keywords, app tags, product page optimization experiments, custom product pages, in-app events, territory availability and review summarizations. A resource this key cannot read is reported as unavailable rather than as empty. Read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "appId": {
    "description": "App Store Connect numeric app id; provide this or bundleId",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "bundleId": {
    "description": "Bundle id; provide this or appId",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "include": {
    "default": [],
    "description": "Which discovery surfaces to read; empty reads all of them",
    "items": {
     "enum": [
      "searchKeywords",
      "appTags",
      "experiments",
      "customProductPages",
      "appEvents",
      "availability",
      "reviewSummarizations"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "includeRows": {
    "default": false,
    "description": "Include every raw row as well as the counts; off by default so a summary call stays small",
    "type": "boolean"
   },
   "limit": {
    "default": 50,
    "description": "Rows per resource",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "locales": {
    "default": [
     "en-US"
    ],
    "description": "Locales for per-locale resources such as searchKeywords",
    "items": {
     "maxLength": 10,
     "minLength": 2,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "platform": {
    "default": "IOS",
    "description": "Platform for resources that require one",
    "enum": [
     "IOS",
     "MAC_OS",
     "TV_OS",
     "VISION_OS"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "app_store_discovery",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "type": "string"
   },
   "bundleId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "locales": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "resources": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "available": {
       "type": "boolean"
      },
      "count": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "error": {
       "type": "string"
      },
      "rows": {
       "items": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "available",
      "count",
      "rows"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "appId",
   "bundleId",
   "locales",
   "resources",
   "notes"
  ],
  "type": "object"
 }
}
