{
 "description": "List all memories in a given scope. Returns memories sorted by confidence.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category",
    "enum": [
     "fact",
     "insight",
     "preference",
     "outcome"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 50)",
    "type": "number"
   },
   "scope": {
    "description": "Memory scope (default: workflow)",
    "enum": [
     "workspace",
     "workflow"
    ],
    "type": "string"
   },
   "workflowId": {
    "description": "Workflow ID for workflow-scoped list",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_memories"
}
