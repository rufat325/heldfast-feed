{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Multilingual, as the editor does it. status | locales (add/remove) | page (rows: missing, done, outdated) | write (node id+field+value; registry fields only) | auto (machine-fill missing) | review (approve).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "status",
     "locales",
     "page",
     "write",
     "auto",
     "review"
    ],
    "type": "string"
   },
   "add": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "all": {
    "type": "boolean"
   },
   "dry_run": {
    "type": "boolean"
   },
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entity_id": {
       "type": "string"
      },
      "entity_type": {
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "entity_id",
      "field"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "type": "string"
   },
   "locale": {
    "type": "string"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "page_id": {
    "type": "string"
   },
   "remove": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "site_id": {
    "type": "string"
   },
   "source": {
    "enum": [
     "human",
     "machine"
    ],
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "sb_translate"
}
