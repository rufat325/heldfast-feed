{"description":"Apply a plan returned by any plan_* tool, create_plugin or extract_to_plugin. Pass `planId` to apply exactly the reviewed plan, or `plan` (a full plan object) to apply one you hold. The plan is verified against disk first \u2014 if any touched file changed since it was computed, nothing is written (the changed paths are returned). \u26a0\ufe0f Modifies files on disk.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"plan":{"description":"A full, well-formed plan object (planId + fingerprints), if not using planId.","properties":{"fileCreates":{"items":{"properties":{"content":{"type":"string"},"path":{"type":"string"}},"required":["path","content"],"type":"object"},"type":"array"},"fileDeletes":{"items":{"type":"string"},"type":"array"},"fileRenames":{"items":{"properties":{"from":{"type":"string"},"to":{"type":"string"}},"required":["from","to"],"type":"object"},"type":"array"},"fingerprints":{"items":{"properties":{"hash":{"type":"string"},"path":{"type":"string"}},"required":["path","hash"],"type":"object"},"type":"array"},"planId":{"type":"string"},"textEdits":{"items":{"properties":{"end":{"properties":{"character":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"line":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["line","character"],"type":"object"},"filePath":{"type":"string"},"newText":{"type":"string"},"start":{"properties":{"character":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"line":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["line","character"],"type":"object"}},"required":["filePath","start","end","newText"],"type":"object"},"type":"array"}},"required":["textEdits","fileRenames","planId","fingerprints"],"type":"object"},"planId":{"description":"The planId from a plan_* result (preferred).","type":"string"}},"type":"object"},"name":"apply_edits","title":"Apply a reviewed plan to disk (contractual)"}
