{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Create Booking Link"},"description":"Create a one-off booking link for one mailbox. Only create one when the user asked for it. It offers offered_ranges, or the weekly hours of source_page_id. The link stops taking bookings after max_bookings (default 1, null means unlimited) and after expires_at. Share the returned url with the person who should book.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"buffer_minutes":{"maximum":240,"minimum":0,"type":"integer"},"conferencing_provider":{"anyOf":[{"enum":["zoom","google_meet"],"type":"string"},{"type":"null"}],"description":"Opt-in meeting provider. It must already be connected to the link's mailbox. Null means no meeting link."},"description":{"anyOf":[{"maxLength":2000,"type":"string"},{"type":"null"}]},"duration_minutes":{"maximum":480,"minimum":5,"type":"integer"},"expires_at":{"anyOf":[{"description":"UTC instant (ISO 8601).","maxLength":64,"minLength":1,"type":"string"},{"type":"null"}],"description":"A future time after which the link takes no bookings. Null means it never expires."},"idempotency_key":{"description":"Optional idempotency key. If omitted, the MCP server generates one for POST tools.","pattern":"^[\\x20-\\x7E]{1,255}$","type":"string"},"mailbox":{"description":"The mailbox (calendar owner) address.","maxLength":508,"type":"string"},"max_bookings":{"anyOf":[{"maximum":100,"minimum":1,"type":"integer"},{"type":"null"}],"description":"The link stops taking bookings after this many. Default 1. Null means unlimited."},"minimum_notice_minutes":{"maximum":43200,"minimum":0,"type":"integer"},"name":{"maxLength":120,"minLength":1,"type":"string"},"offered_ranges":{"description":"Times visitors can book inside. Each must start in the future, be at least duration_minutes long, and end within 90 days.","items":{"properties":{"end":{"description":"Range end (UTC instant), after start.","maxLength":64,"minLength":1,"type":"string"},"start":{"description":"Range start (UTC instant).","maxLength":64,"minLength":1,"type":"string"}},"required":["start","end"],"type":"object"},"maxItems":50,"minItems":1,"type":"array"},"source_page_id":{"anyOf":[{"description":"Shipmail resource ID.","pattern":"^[A-Za-z0-9_-]{1,100}$","type":"string"},{"type":"null"}],"description":"Booking page whose weekly hours the link offers when it has no offered_ranges."},"timezone":{"description":"IANA time zone.","maxLength":64,"minLength":1,"type":"string"}},"required":["name","mailbox","duration_minutes","timezone"],"type":"object"},"name":"shipmail_create_booking_link","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"booking_link":{"properties":{"bookings_count":{"type":"number"},"buffer_minutes":{"type":"number"},"conferencing_provider":{"anyOf":[{"type":"string"},{"type":"null"}]},"created_at":{"type":"string"},"description":{"anyOf":[{"type":"string"},{"type":"null"}]},"duration_minutes":{"type":"number"},"expires_at":{"anyOf":[{"type":"string"},{"type":"null"}]},"id":{"type":"string"},"mailbox":{"type":"string"},"max_bookings":{"anyOf":[{"type":"number"},{"type":"null"}]},"minimum_notice_minutes":{"type":"number"},"name":{"type":"string"},"object":{"type":"string"},"offered_ranges":{"anyOf":[{"items":{"properties":{"end":{"type":"string"},"start":{"type":"string"}},"required":["start","end"],"type":"object"},"type":"array"},{"type":"null"}]},"slug":{"type":"string"},"source_page_id":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"type":"string"},"timezone":{"type":"string"},"url":{"anyOf":[{"type":"string"},{"type":"null"}]}},"required":["object","id","mailbox","slug","url","name","description","duration_minutes","timezone","offered_ranges","source_page_id","buffer_minutes","minimum_notice_minutes","conferencing_provider","max_bookings","bookings_count","expires_at","status","created_at"],"type":"object"}},"required":["booking_link"],"type":"object","~standard":{"jsonSchema":{},"vendor":"zod","version":1}},"title":"Create Booking Link"}
