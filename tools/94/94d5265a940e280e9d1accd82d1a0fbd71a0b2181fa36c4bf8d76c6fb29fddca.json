 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Talonic Pricing"
 },
 "description": "Read Talonic's machine-readable credit pricing catalog: fixed per-unit rates so you can predict spend BEFORE running anything.\n\nUSE WHEN: estimating the cost of a planned extraction/structuring/matching job, or answering a pricing question. Public \u2014 works without spending credits.\nNOT FOR: the workspace's current balance (use talonic_get_balance) or what it has already spent (use talonic_get_usage).\nARGS: none.\nRETURNS: currency, credits_per_eur, multipliers (e.g. batch 0.5x), and units[] \u2014 each { unit, label, credits, eur, free }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "talonic_get_pricing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "credits_per_eur": {
    "description": "Credits per EUR (e.g. 1000 = \u20ac1).",
    "type": "number"
   },
   "currency": {
    "description": "Billing currency (always EUR).",
    "type": "string"
   },
   "multipliers": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Processing-mode multipliers applied on top of per-unit cost (e.g. { realtime: 1, batch: 0.5 }).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "units": {
    "description": "The per-unit pricing catalog.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "credits": {
       "description": "Credits per unit (0 = free).",
       "type": "number"
      },
      "eur": {
       "description": "EUR per unit.",
       "type": "number"
      },
      "free": {
       "description": "Whether the unit is free.",
       "type": "boolean"
      },
      "label": {
       "description": "Human-readable label.",
       "type": "string"
      },
      "unit": {
       "description": "Billable unit identifier.",
       "type": "string"
      }
     },
     "required": [
      "unit",
      "label",
      "credits",
      "eur",
      "free"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "currency",
   "credits_per_eur",
   "multipliers",
   "units"
  ],
  "type": "object"
 },
 "title": "Get Talonic Pricing"
}
