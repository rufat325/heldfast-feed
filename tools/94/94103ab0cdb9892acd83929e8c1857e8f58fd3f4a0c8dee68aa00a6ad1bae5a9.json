{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a bar, line, or stacked bar chart from numbers. Returns SVG and PNG files plus a hosted result for 24 hours.",
 "inputSchema": {
  "properties": {
   "caption": {
    "maxLength": 400,
    "type": "string"
   },
   "datasets": {
    "items": {
     "properties": {
      "name": {
       "maxLength": 60,
       "type": "string"
      },
      "values": {
       "items": {
        "maximum": 1000000000000,
        "minimum": -1000000000000,
        "type": "number"
       },
       "maxItems": 60,
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "values"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "height": {
    "maximum": 1000,
    "minimum": 360,
    "type": "integer"
   },
   "labels": {
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 60,
    "minItems": 1,
    "type": "array"
   },
   "subtitle": {
    "maxLength": 160,
    "type": "string"
   },
   "theme": {
    "enum": [
     "paper",
     "midnight",
     "sage"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "type": "string"
   },
   "type": {
    "enum": [
     "bar",
     "line",
     "stacked-bar"
    ],
    "type": "string"
   },
   "width": {
    "maximum": 1600,
    "minimum": 480,
    "type": "integer"
   }
  },
  "required": [
   "labels",
   "datasets"
  ],
  "type": "object"
 },
 "name": "chartlink_create_chart"
}
