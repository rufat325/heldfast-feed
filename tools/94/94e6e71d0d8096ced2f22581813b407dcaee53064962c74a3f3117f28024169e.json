{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false
 },
 "description": "Set the same category on up to 500 transactions in one call by taxonomy option code (e.g. \"ai-products\", \"meals\"). Applies the sign-appropriate detail field and the umbrella category per transaction. Returns how many applied plus per-transaction failures. Use this instead of calling transaction_categorize_transaction in a loop. The booking is recorded as Lovie Agent's proposal and changes nothing until the person accepts it, so tell them it is waiting for their review. Returns proposal_ids, one proposal per transaction.",
 "inputSchema": {
  "properties": {
   "categoryOptionCode": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "transactionIds": {
    "items": {
     "description": "UUID value wrapper.",
     "properties": {
      "value": {
       "format": "uuid",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "transaction_batch_categorize_transactions",
 "outputSchema": {
  "properties": {
   "failures": {
    "items": {
     "properties": {
      "message": {
       "type": "string"
      },
      "transactionId": {
       "anyOf": [
        {
         "description": "UUID value wrapper.",
         "properties": {
          "value": {
           "format": "uuid",
           "type": "string"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "optionPath": {
    "type": "string"
   },
   "proposalIds": {
    "items": {
     "description": "UUID value wrapper.",
     "properties": {
      "value": {
       "format": "uuid",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "reportedWarning": {
    "type": "string"
   },
   "updatedCount": {
    "type": "integer"
   }
  },
  "type": "object"
 },
 "title": "Batch Categorize Transactions"
}
