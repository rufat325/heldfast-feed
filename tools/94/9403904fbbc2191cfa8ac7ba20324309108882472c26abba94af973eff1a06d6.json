{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare a checkpoint with current content or another checkpoint without mutation. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkpointId": {
    "$ref": "#/properties/folderId"
   },
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "pageId": {
    "$ref": "#/properties/folderId"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "to": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^(current|[a-z0-9_-]+)$",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "pageId",
   "checkpointId"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_history_compare",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "diff": {
      "additionalProperties": false,
      "properties": {
       "counts": {
        "additionalProperties": false,
        "properties": {
         "blocksAdded": {
          "$ref": "#/properties/result/properties/diff/properties/counts/properties/pagesAdded"
         },
         "blocksChanged": {
          "$ref": "#/properties/result/properties/diff/properties/counts/properties/pagesAdded"
         },
         "blocksRemoved": {
          "$ref": "#/properties/result/properties/diff/properties/counts/properties/pagesAdded"
         },
         "pagesAdded": {
          "minimum": 0,
          "type": "integer"
         },
         "pagesChanged": {
          "$ref": "#/properties/result/properties/diff/properties/counts/properties/pagesAdded"
         },
         "pagesRemoved": {
          "$ref": "#/properties/result/properties/diff/properties/counts/properties/pagesAdded"
         }
        },
        "required": [
         "pagesAdded",
         "pagesRemoved",
         "pagesChanged",
         "blocksAdded",
         "blocksRemoved",
         "blocksChanged"
        ],
        "type": "object"
       },
       "fullReview": {
        "type": "boolean"
       },
       "pages": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "blocks": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "afterText": {
              "type": [
               "string",
               "null"
              ]
             },
             "anchorId": {
              "type": [
               "string",
               "null"
              ]
             },
             "beforeText": {
              "type": [
               "string",
               "null"
              ]
             },
             "blockId": {
              "$ref": "#/properties/result/properties/from/properties/contentDigest"
             },
             "heading": {
              "type": [
               "string",
               "null"
              ]
             },
             "kind": {
              "enum": [
               "ADDED",
               "REMOVED",
               "MOVED",
               "MODIFIED",
               "MEDIA_CHANGED",
               "TABLE_CHANGED"
              ],
              "type": "string"
             },
             "textDelta": {
              "additionalProperties": false,
              "properties": {
               "afterChanged": {
                "$ref": "#/properties/result/properties/from/properties/contentDigest"
               },
               "afterPrefix": {
                "$ref": "#/properties/result/properties/from/properties/contentDigest"
               },
               "afterSuffix": {
                "$ref": "#/properties/result/properties/from/properties/contentDigest"
               },
               "beforeChanged": {
                "$ref": "#/properties/result/properties/from/properties/contentDigest"
               },
               "beforePrefix": {
                "$ref": "#/properties/result/properties/from/properties/contentDigest"
               },
               "beforeSuffix": {
                "$ref": "#/properties/result/properties/from/properties/contentDigest"
               }
              },
              "required": [
               "beforePrefix",
               "beforeChanged",
               "beforeSuffix",
               "afterPrefix",
               "afterChanged",
               "afterSuffix"
              ],
              "type": "object"
             }
            },
            "required": [
             "kind",
             "blockId",
             "anchorId",
             "heading",
             "beforeText",
             "afterText"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "kinds": {
           "items": {
            "enum": [
             "ADDED",
             "REMOVED",
             "RENAMED",
             "MOVED",
             "UPDATED"
            ],
            "type": "string"
           },
           "type": "array"
          },
          "pageId": {
           "$ref": "#/properties/result/properties/pageId"
          },
          "previousTitle": {
           "type": [
            "string",
            "null"
           ]
          },
          "title": {
           "$ref": "#/properties/result/properties/from/properties/contentDigest"
          }
         },
         "required": [
          "pageId",
          "title",
          "previousTitle",
          "kinds",
          "blocks"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "fullReview",
       "pages",
       "counts"
      ],
      "type": "object"
     },
     "from": {
      "additionalProperties": false,
      "properties": {
       "checkpointId": {
        "$ref": "#/properties/result/properties/pageId"
       },
       "checksum": {
        "$ref": "#/properties/result/properties/from/properties/contentDigest"
       },
       "contentDigest": {
        "type": "string"
       },
       "createdAt": {
        "$ref": "#/properties/result/properties/from/properties/contentDigest"
       },
       "kind": {
        "enum": [
         "checkpoint",
         "current"
        ],
        "type": "string"
       },
       "origin": {
        "$ref": "#/properties/result/properties/from/properties/contentDigest"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     "pageId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "to": {
      "$ref": "#/properties/result/properties/from"
     }
    },
    "required": [
     "pageId",
     "from",
     "to",
     "diff"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
