additionalProperties":false,"properties":{"audience":{"default":"project","enum":["project","personal","team","tenant"],"title":"Audience","type":"string"},"channel_id":{"anyOf":[{"pattern":"^[CG][A-Z0-9]{1,63}$","type":"string"},{"type":"null"}],"default":null,"title":"Channel Id"},"execution_plan":{"anyOf":[{"$ref":"#/$defs/ExecutionPlan"},{"type":"null"}],"default":null},"instructions":{"maxLength":4000,"minLength":1,"title":"Instructions","type":"string"},"members":{"items":{"type":"string"},"maxItems":100,"title":"Members","type":"array"},"procedure":{"anyOf":[{"$ref":"#/$defs/Procedure"},{"type":"null"}],"default":null},"project_id":{"anyOf":[{"pattern":"^[a-f0-9-]{36}$","type":"string"},{"type":"null"}],"default":null,"title":"Project Id"},"template":{"default":"team_commitments","enum":["team_commitments","request_intake","document_review","sop"],"title":"Template","type":"string"},"thread_ts":{"anyOf":[{"pattern":"^\\d{1,16}\\.\\d{6}$","type":"string"},{"type":"null"}],"default":null,"title":"Thread Ts"},"title":{"maxLength":160,"minLength":1,"title":"Title","type":"string"}},"required":["title","instructions"],"title":"Definition","type":"object"},"name":"workflow_create","title":"Workflow Create"}
