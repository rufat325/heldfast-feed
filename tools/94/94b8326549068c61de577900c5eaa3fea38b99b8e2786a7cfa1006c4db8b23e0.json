{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Produce a batch from a ready synchronized camera and screen recording, with optional clip count, maximum duration and caption look. Preserves readable screen context through the existing layout pipeline. Can spend existing credits; follows clips_get with the returned batch_id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "captionThemeId": {
    "anyOf": [
     {
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "clipCount": {
    "anyOf": [
     {
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "maxDurationSeconds": {
    "anyOf": [
     {
      "const": 30,
      "type": "integer"
     },
     {
      "const": 60,
      "type": "integer"
     },
     {
      "const": 90,
      "type": "integer"
     },
     {
      "const": 180,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "recordingSetId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "workspaceId",
   "idempotencyKey",
   "recordingSetId",
   "clipCount",
   "maxDurationSeconds",
   "captionThemeId"
  ],
  "type": "object"
 },
 "name": "recording_sets_clips_create",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Clip a Synchronized Recording"
}
