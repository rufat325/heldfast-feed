{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Aggregate CI test data with statistical computations and grouping",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregation": {
    "description": "Aggregation type",
    "enum": [
     "count",
     "avg",
     "sum",
     "min",
     "max",
     "pc75",
     "pc90",
     "pc95",
     "pc99"
    ],
    "type": "string"
   },
   "from": {
    "description": "Start time (ISO 8601 or relative)",
    "type": "string"
   },
   "groupBy": {
    "description": "Field to group results by. Example: @test.service, @test.status",
    "type": "string"
   },
   "metric": {
    "description": "Metric to aggregate on. Example: @duration",
    "type": "string"
   },
   "query": {
    "default": "*",
    "description": "CI test search query for aggregation",
    "type": "string"
   },
   "to": {
    "description": "End time (ISO 8601 or relative)",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to",
   "aggregation"
  ],
  "type": "object"
 },
 "name": "aggregate-ci-tests"
}
