{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Board Foot Calculator"
 },
 "description": "Sum board-foot lumber volumes from entered dimensions and whole piece counts, with per-row optional prices and a priced subtotal. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "rows": [
     {
      "length": 8,
      "pricePerBoardFoot": 4,
      "quantity": 3,
      "thickness": 1,
      "width": 6
     }
    ]
   }
  ],
  "properties": {
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "dimensionUnit": {
       "description": "Thickness/width unit; default in.",
       "enum": [
        "in",
        "cm"
       ],
       "type": "string"
      },
      "length": {
       "description": "Entered length.",
       "exclusiveMinimum": 0,
       "maximum": 1000000.0,
       "type": "number"
      },
      "lengthUnit": {
       "description": "Length unit; default ft.",
       "enum": [
        "ft",
        "m"
       ],
       "type": "string"
      },
      "pricePerBoardFoot": {
       "description": "Optional price per board foot in one common entered currency.",
       "maximum": 1000000000000.0,
       "minimum": 0,
       "type": "number"
      },
      "quantity": {
       "description": "Whole piece count; default 1.",
       "exclusiveMinimum": 0,
       "maximum": 1000000.0,
       "type": "integer"
      },
      "thickness": {
       "description": "Entered nominal or measured thickness.",
       "exclusiveMinimum": 0,
       "maximum": 1000000.0,
       "type": "number"
      },
      "width": {
       "description": "Entered nominal or measured width.",
       "exclusiveMinimum": 0,
       "maximum": 1000000.0,
       "type": "number"
      }
     },
     "required": [
      "thickness",
      "width",
      "length"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "name": "board_feet",
 "outputSchema": {
  "description": "Structured entered quantities, explicit unit labels, calculated results and formula; per-row and total board feet, costs; totalCost null when any row is unpriced.",
  "type": "object"
 },
 "title": "Board Foot Calculator"
}
