{
 "description": "T\u1ea1o link thu ti\u1ec1n, \u0111\u01b0a link cho kh\u00e1ch ho\u1eb7c chuy\u1ec3n h\u01b0\u1edbng checkout; \u0111\u1ee3i webhook CHECKOUT_PAID tr\u01b0\u1edbc khi giao h\u00e0ng. / Create a hosted checkout link; wait for CHECKOUT_PAID before fulfilment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "S\u1ed1 ti\u1ec1n nguy\u00ean VND",
    "maximum": 1000000000,
    "minimum": 1000,
    "type": "integer"
   },
   "cancel_url": {
    "format": "starts_with",
    "pattern": "^https:\\/\\/.*",
    "type": "string"
   },
   "description": {
    "maxLength": 100,
    "type": "string"
   },
   "expires_in": {
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "idempotency_key": {
    "description": "Kho\u00e1 ch\u1ed1ng t\u1ea1o tr\u00f9ng; b\u1ecf tr\u1ed1ng \u0111\u1ec3 MCP t\u1ef1 sinh UUID",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "order_code": {
    "maxLength": 50,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "payer_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "payer_name": {
    "maxLength": 255,
    "type": "string"
   },
   "return_url": {
    "format": "starts_with",
    "pattern": "^https:\\/\\/.*",
    "type": "string"
   },
   "sandbox": {
    "description": "true = phi\u00ean TH\u1eec v\u1edbi VA sandbox, kh\u00f4ng ti\u1ec1n th\u1eadt; d\u00f9ng \u0111\u01b0\u1ee3c khi ch\u01b0a n\u1ed1i ng\u00e2n h\u00e0ng",
    "type": "boolean"
   },
   "virtual_account_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "amount",
   "order_code",
   "return_url"
  ],
  "type": "object"
 },
 "name": "monapay_create_checkout",
 "title": "T\u1ea1o link thu ti\u1ec1n"
}
