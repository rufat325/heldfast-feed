{
 "description": "Remove a distinct mark between two same-type entities (same identity rules as mark-entity-distinct).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entityType": {
    "enum": [
     "STORY",
     "SCENARIO",
     "TEST",
     "ISSUE",
     "EVENT"
    ],
    "type": "string"
   },
   "focusEventTitle": {
    "type": "string"
   },
   "focusOrdinalId": {
    "type": [
     "number",
     "string"
    ]
   },
   "focusTest": {
    "properties": {
     "fileName": {
      "minLength": 1,
      "type": "string"
     },
     "folderPath": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "testName": {
      "minLength": 1,
      "type": "string"
     },
     "testSuite": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "fileName",
     "testName"
    ],
    "type": "object"
   },
   "otherEventTitle": {
    "type": "string"
   },
   "otherOrdinalId": {
    "type": [
     "number",
     "string"
    ]
   },
   "otherTest": {
    "properties": {
     "fileName": {
      "minLength": 1,
      "type": "string"
     },
     "folderPath": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "testName": {
      "minLength": 1,
      "type": "string"
     },
     "testSuite": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "fileName",
     "testName"
    ],
    "type": "object"
   }
  },
  "required": [
   "entityType"
  ],
  "type": "object"
 },
 "name": "unmark-entity-distinct"
}
