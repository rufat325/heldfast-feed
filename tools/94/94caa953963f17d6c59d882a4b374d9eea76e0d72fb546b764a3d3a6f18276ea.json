{
 "description": "Create a new email zone for serving ads in email newsletters",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "auction_tie_break": {
    "description": "Tie-breaking method for auctions",
    "enum": [
     "RANDOM",
     "SCORE"
    ],
    "type": "string"
   },
   "height": {
    "description": "Zone height in pixels",
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom metadata key-value pairs",
    "type": "object"
   },
   "name": {
    "description": "Zone name",
    "type": "string"
   },
   "publisher": {
    "description": "Publisher ID",
    "type": "number"
   },
   "rotate_timer": {
    "additionalProperties": false,
    "description": "Period after which user sees a new ad",
    "properties": {
     "amount": {
      "description": "Period amount",
      "type": "number"
     },
     "interval": {
      "description": "Period interval",
      "enum": [
       "minutes",
       "days"
      ],
      "type": "string"
     }
    },
    "required": [
     "amount",
     "interval"
    ],
    "type": "object"
   },
   "uid_rotate": {
    "description": "Serve different ads per user",
    "type": "boolean"
   },
   "width": {
    "description": "Zone width in pixels",
    "type": "number"
   }
  },
  "required": [
   "name",
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "create_email_zone"
}
