 "description": "REQUIRES API KEY (sessions:read scope). Lists remote sessions on Robotics & AI bookings the authenticated user RENTS (the 50 most recent; no paging) \u2014 status, health, GPU allocation, total compute hours, cost so far. Use before starting a new session to check if one is already active.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "booking_id": {
    "description": "Only sessions on this booking.",
    "format": "uuid",
    "type": "string"
   },
   "status": {
    "description": "Only sessions in this status.",
    "enum": [
     "provisioning",
     "active",
     "paused",
     "terminated",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "rigshare_list_my_sessions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sessions": {
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "sessions"
  ],
  "type": "object"
 },
 "title": "List my sessions"
}
