{
 "description": "Delete a user permanently, reassigning their content to another user",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "User ID to delete",
    "type": "integer"
   },
   "reassign": {
    "description": "User ID to reassign the deleted user's posts and links to",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id",
   "reassign"
  ],
  "type": "object"
 },
 "name": "wp_delete_user"
}
