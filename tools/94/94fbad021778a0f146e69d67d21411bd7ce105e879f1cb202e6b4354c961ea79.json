{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List posts in the workspace, newest first. Filter by status (draft, pending_approval, scheduled, published, failed) or free text.",
 "inputSchema": {
  "properties": {
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "maxLength": 120,
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "pending_approval",
     "requires_edits",
     "scheduled",
     "publishing",
     "published",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_posts",
 "outputSchema": {
  "description": "List of posts matching filter criteria",
  "items": {
   "properties": {
    "channels": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "excerpt": {
     "type": "string"
    },
    "id": {
     "description": "Post ID",
     "type": "string"
    },
    "publishedAt": {
     "nullable": true,
     "type": "string"
    },
    "scheduledAt": {
     "nullable": true,
     "type": "string"
    },
    "status": {
     "description": "Status",
     "type": "string"
    },
    "title": {
     "description": "Post title",
     "type": "string"
    }
   },
   "required": [
    "id",
    "status",
    "channels"
   ],
   "type": "object"
  },
  "type": "array"
 },
 "title": "List posts"
}
