  "title": "chainpeek: perpetual funding compared between Hyperliquid and dYdX, with the annualised spread"
 },
 "description": "chainpeek: Compare perpetual funding rates between Hyperliquid and dYdX. For five venues net of fees use rank_funding_carry. Returns each venue's hourly and annualised funding and the spread (Hyperliquid minus dYdX v4), ranked by absolute spread. Only assets on both venues are compared; the others come back in `symbols_not_found`, and `min_volume_usd` must be met on both. Cached up to 60 s. Data only, not trading advice. Bad input is a 422 (not charged). Typically 0.3-2 s. Price: USD 0.003. Free: 10 chain reads per IP per UTC day. Docs: https://tanod.dev/learn/funding-rate-spread-api.html",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "Rows returned, 1-50 (default 10).",
    "maximum": 50,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_volume_usd": {
    "default": 0,
    "description": "Skip markets whose 24 h volume on either venue is below this (USD). Default 0.",
    "maximum": 10000000000000.0,
    "minimum": 0,
    "title": "Min Volume Usd",
    "type": "number"
   },
   "symbols": {
    "anyOf": [
     {
      "items": {
       "pattern": "^[A-Za-z0-9._-]{1,20}$",
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional: only these base assets (case-insensitive, at most 50), such as BTC. Names not listed on both venues are returned in symbols_not_found.",
    "title": "Symbols"
   }
  },
