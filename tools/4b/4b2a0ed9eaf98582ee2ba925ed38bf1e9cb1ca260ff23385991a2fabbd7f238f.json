{
 "description": "Create a CFDI invoice",
 "inputSchema": {
  "properties": {
   "customer": {
    "description": "Customer ID",
    "type": "string"
   },
   "folio_number": {
    "description": "Invoice folio number",
    "type": "number"
   },
   "items": {
    "description": "Invoice line items",
    "items": {
     "properties": {
      "product": {
       "description": "Product ID or inline product object",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      }
     },
     "required": [
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payment_form": {
    "description": "SAT payment form code (e.g. 01=cash, 03=transfer, 04=credit_card)",
    "type": "string"
   },
   "payment_method": {
    "description": "PUE (single payment) or PPD (deferred)",
    "type": "string"
   },
   "series": {
    "description": "Invoice series",
    "type": "string"
   },
   "use": {
    "description": "CFDI use code (e.g. G01=acquisition, G03=expenses, P01=to_be_defined)",
    "type": "string"
   }
  },
  "required": [
   "customer",
   "items",
   "payment_form"
  ],
  "type": "object"
 },
 "name": "create_invoice"
}
