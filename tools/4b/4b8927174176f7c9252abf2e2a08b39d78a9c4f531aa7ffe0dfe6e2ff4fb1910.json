{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Poll a top-up invoice created by impreza_topup. Returns the invoice status (pending / paid), the amount, and the resulting account balance once paid.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "invoice_id": {
    "description": "The invoice_id returned by impreza_topup.",
    "type": "number"
   }
  },
  "required": [
   "invoice_id"
  ],
  "type": "object"
 },
 "name": "impreza_topup_status",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "type": "number"
     },
     "balance_after": {
      "type": "number"
     },
     "currency": {
      "type": "string"
     },
     "invoice_id": {
      "type": "integer"
     },
     "method": {
      "type": [
       "string",
       "null"
      ]
     },
     "paid_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "invoice_id",
     "amount",
     "currency",
     "method",
     "status",
     "paid_at"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Check top-up status"
}
