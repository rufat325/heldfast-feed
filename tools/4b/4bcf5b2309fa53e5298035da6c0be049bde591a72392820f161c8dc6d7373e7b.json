 "description": "Find gaps, duplicates and ordering violations in an event sequence, per stream. Partitioning matters: auditing a merged multi-stream batch as one sequence would report a gap at every interleave. Gaps are judged on sequence values and ordering on arrival order, because they are different questions. A non-integral sequence is reported as unchecked for contiguity rather than guessed at. Pay 130000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "events": {
    "description": "A batch of records as JSON objects, at most 2000. Nothing is fetched, delivered or acknowledged, and no signature or secret is handled.",
    "example": [
     {
      "event_id": "evt-1",
      "offset": 101,
      "order_id": "o-1",
      "schema_version": "2",
      "stream": "orders-0",
      "total": 42.5,
      "type": "order.created"
     },
     {
      "event_id": "evt-2",
      "offset": 102,
      "order_id": "o-2",
      "schema_version": "2",
      "stream": "orders-0",
      "total": 19.99,
      "type": "order.created"
     },
     {
      "event_id": "evt-4",
      "offset": 104,
      "order_id": "o-4",
      "schema_version": "2",
      "stream": "orders-0",
      "total": 7,
      "type": "order.created"
     },
     {
      "event_id": "evt-4",
      "offset": 105,
      "order_id": "o-4",
      "schema_version": "2",
      "stream": "orders-0",
      "total": 7.5,
      "type": "order.created"
     },
     {
      "event_id": "evt-5",
      "offset": 106,
      "order_id": "o-5",
      "schema_version": "1",
      "stream": "orders-0",
      "total": "12.00",
      "type": "order.created"
     },
     {
      "event_id": "evt-6",
      "offset": 1,
      "order_id": "o-1",
      "reason": "customer",
      "schema_version": "2",
      "stream": "orders-1",
      "type": "order.cancelled"
     },
     {
      "offset": 2,
      "order_id": "o-2",
      "reason": "fraud",
      "schema_version": "2",
      "stream": "orders-1",
      "type": "order.cancelled"
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "expect_contiguous": {
    "description": "Report a gap between consecutive integral values. Defaults to true.",
    "type": "boolean"
   },
   "expect_increasing": {
    "description": "Report an event arriving with a lower sequence than the one before it. Defaults to true.",
    "type": "boolean"
   },
   "partition_field": {
    "description": "The stream, partition or shard the sequence belongs to. Omit to treat the whole batch as one stream. Either a bare property name or an RFC 6901 JSON Pointer, since callers write both.",
    "example": "stream",
    "maxLength": 256,
    "type": "string"
   },
   "sequence_field": {
    "description": "The offset, sequence number or monotonic counter. Either a bare property name or an RFC 6901 JSON Pointer, since callers write both.",
    "example": "offset",
    "maxLength": 256,
    "type": "string"
   }
  },
  "required": [
   "events",
   "sequence_field"
  ],
  "type": "object"
 },
