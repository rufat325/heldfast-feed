{
 "description": "Move rows or columns within a sheet to a new position. Use 0-based indices. The destinationIndex is where the rows/columns will be moved TO.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "destinationIndex": {
    "description": "Index where the rows/columns will be moved to (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "dimension": {
    "description": "Whether to move rows or columns",
    "enum": [
     "ROWS",
     "COLUMNS"
    ],
    "type": "string"
   },
   "endIndex": {
    "description": "Ending index of the range to move (0-based, exclusive)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "startIndex": {
    "description": "Starting index of the range to move (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "gid",
   "dimension",
   "startIndex",
   "endIndex",
   "destinationIndex"
  ],
  "type": "object"
 },
 "name": "dimensions-move",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "destinationIndex": {
        "description": "Index where the range was moved to",
        "type": "number"
       },
       "dimension": {
        "description": "Dimension that was moved",
        "enum": [
         "ROWS",
         "COLUMNS"
        ],
        "type": "string"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "movedCount": {
        "description": "Number of rows/columns moved",
        "type": "number"
       },
       "sheetTitle": {
        "description": "Title of the sheet",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the sheet",
        "type": "string"
       },
       "sourceRange": {
        "additionalProperties": false,
        "properties": {
         "endIndex": {
          "description": "Ending index of the moved range",
          "type": "number"
         },
         "startIndex": {
          "description": "Starting index of the moved range",
          "type": "number"
         }
        },
        "required": [
         "startIndex",
         "endIndex"
        ],
        "type": "object"
       },
       "spreadsheetTitle": {
        "description": "Title of the spreadsheet",
        "type": "string"
       },
       "spreadsheetUrl": {
        "description": "URL of the spreadsheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "spreadsheetTitle",
       "spreadsheetUrl",
       "sheetTitle",
       "sheetUrl",
       "dimension",
       "sourceRange",
       "destinationIndex",
       "movedCount"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
