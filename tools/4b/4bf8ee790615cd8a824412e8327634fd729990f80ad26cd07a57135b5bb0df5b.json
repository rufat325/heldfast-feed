 },
 "description": "Bilateral co-coverage signal for a monitored country pair (e.g. a='cn', b='us'): how much the world's press mentions the two countries together, and in what tone. ~50 strategic pairs are monitored.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "a": {
    "description": "First country ISO2",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "b": {
    "description": "Second country ISO2",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "response_format": {
    "description": "concise (default): summary stats + the latest 30 days of the series. detailed: the full 90-day series and article sample (~3x the tokens).",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "required": [
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "get_relation",
