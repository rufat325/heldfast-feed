 },
 "description": "Add a pet, optionally with its microchip number and date of birth, and links to an existing contact as vet and document as insurance. Returns the new pet's id.",
 "inputSchema": {
  "examples": [
   {
    "dateOfBirth": "2021-06-15",
    "microchipNumber": "985141000123456",
    "name": "Bella",
    "notes": "Allergic to chicken; on prescription food."
   }
  ],
  "properties": {
   "dateOfBirth": {
    "description": "Date of birth, YYYY-MM-DD.",
    "examples": [
     "2021-06-15"
    ],
    "type": "string"
   },
   "insuranceDocumentId": {
    "description": "Insurance document id from create_document.",
    "examples": [
     "doc_1a2b3c4d5e6f"
    ],
    "type": "string"
   },
   "microchipNumber": {
    "description": "Microchip number.",
    "examples": [
     "985141000123456"
    ],
    "type": "string"
   },
   "name": {
    "description": "Name.",
    "examples": [
     "Bella"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Freeform notes, e.g. diet or medical history.",
    "examples": [
     "Allergic to chicken; on prescription food."
    ],
    "type": "string"
   },
   "vetContactId": {
    "description": "Vet contact id from create_contact.",
    "examples": [
     "contact_5e6f7a8b9c0d"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_pet",
