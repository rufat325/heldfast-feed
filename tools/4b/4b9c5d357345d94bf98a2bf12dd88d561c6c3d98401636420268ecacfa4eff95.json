{
 "description": "Lista organizacoes da conta (50 por pagina). Nao altera dados.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "column": {
    "enum": [
     "name",
     "email",
     "creation_date"
    ],
    "type": "string"
   },
   "order": {
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "organization_mother_id": {
    "type": "string"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "show_custom_fields": {
    "maximum": 1,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "tomticket_list_organizations"
}
