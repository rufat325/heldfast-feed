{
 "description": "Identify Liquid templates and sections that are taking longer than a specified threshold to render. Requires OAuth2 authentication.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "pagePath": {
    "description": "The page path to profile",
    "type": "string"
   },
   "storeUrl": {
    "description": "The Shopify store URL",
    "type": "string"
   },
   "thresholdMs": {
    "description": "Threshold in milliseconds. Defaults to 50ms.",
    "type": "number"
   }
  },
  "required": [
   "storeUrl"
  ],
  "type": "object"
 },
 "name": "find_slow_templates"
}
