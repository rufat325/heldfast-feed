{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Stop a timer by its id (TMR-1). The timer keeps its elapsed time and its state becomes stopped. If the timer already stopped or its countdown already ended, nothing changes and alreadyOver is true; do not retry. Use an id from start_timer or from run_query schema=timers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "timer_id": {
    "description": "Timer id from start_timer or run_query schema=timers. Format: TMR-1. Do not invent an id.",
    "type": "string"
   }
  },
  "required": [
   "timer_id"
  ],
  "type": "object"
 },
 "name": "stop_timer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alreadyOver": {
    "type": "boolean"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "timer": {
    "additionalProperties": false,
    "properties": {
     "elapsed_ms": {
      "type": "number"
     },
     "ends_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "remaining_ms": {
      "type": [
       "number",
       "null"
      ]
     },
     "seconds": {
      "type": [
       "number",
       "null"
      ]
     },
     "started_at": {
      "type": "string"
     },
     "state": {
      "enum": [
       "running",
       "finished",
       "stopped"
      ],
      "type": "string"
     },
     "stopped_at": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "label",
     "seconds",
     "state",
     "started_at",
     "ends_at",
     "stopped_at",
     "elapsed_ms",
     "remaining_ms"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "timer",
   "alreadyOver"
  ],
  "type": "object"
 }
}
