{
 "description": "Poll the latest run or a specific run until it reaches a terminal status or a timeout is reached.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pollIntervalSeconds": {
    "exclusiveMinimum": 0,
    "maximum": 30,
    "type": "integer"
   },
   "runId": {
    "minLength": 1,
    "type": "string"
   },
   "timeoutSeconds": {
    "exclusiveMinimum": 0,
    "maximum": 600,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "wait_for_run"
}
