    "maximum": 8,
    "minimum": 0,
    "type": "integer"
   },
   "frekans": {
    "description": "1 g\u00fcnl\u00fck, 2 i\u015f g\u00fcn\u00fc, 3 haftal\u0131k, 4 ayda iki kez, 5 ayl\u0131k, 6 \u00fc\u00e7 ayl\u0131k, 7 alt\u0131 ayl\u0131k, 8 y\u0131ll\u0131k \u2014 verilmezse serinin kendi frekans\u0131",
