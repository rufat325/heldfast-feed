{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Incident metrics over a trailing window (default 30 days): MTTA/MTTR in seconds, total incidents, counts by severity and state, auto- vs human-resolved, and the noisiest monitors. Read-only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`get_incident_metrics` argument.",
  "properties": {
   "window_days": {
    "description": "Trailing window in days (1..=365). Defaults to 30 when omitted.",
    "format": "uint32",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "title": "GetIncidentMetricsArgs",
  "type": "object"
 },
 "name": "get_incident_metrics",
 "outputSchema": {
  "$defs": {
   "MetricCount": {
    "description": "One `{key, count}` bucket in the metrics rollup.",
    "properties": {
     "count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
     },
     "key": {
      "type": "string"
     }
    },
    "required": [
     "key",
     "count"
    ],
    "type": "object"
   },
   "NoisyMonitor": {
    "description": "A monitor and how many incidents it raised in the window.",
    "properties": {
     "count": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
     },
     "monitor_id": {
      "type": "string"
     }
    },
    "required": [
     "monitor_id",
     "count"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "`get_incident_metrics` result: MTTA/MTTR and incident counts over a window.",
  "properties": {
   "auto_resolved": {
    "description": "Resolved automatically on recovery, with no human resolver.",
    "format": "uint64",
    "minimum": 0,
    "type": "integer"
   },
   "by_severity": {
    "items": {
     "$ref": "#/$defs/MetricCount"
    },
    "type": "array"
   },
   "by_state": {
    "items": {
     "$ref": "#/$defs/MetricCount"
    },
    "type": "array"
   },
   "human_resolved": {
    "description": "Resolved by a person.",
    "format": "uint64",
    "minimum": 0,
    "type": "integer"
   },
   "mtta_secs": {
    "description": "Mean time to acknowledge, seconds. `null` if none were acknowledged.",
    "format": "double",
    "type": [
     "number",
     "null"
    ]
   },
   "mttr_secs": {
    "description": "Mean time to resolve, seconds. `null` if none were resolved.",
    "format": "double",
    "type": [
     "number",
     "null"
    ]
   },
   "top_monitors": {
    "description": "Noisiest monitors, most incidents first.",
    "items": {
     "$ref": "#/$defs/NoisyMonitor"
    },
    "type": "array"
   },
   "total": {
    "description": "Incidents opened in the window.",
    "format": "uint64",
    "minimum": 0,
    "type": "integer"
   },
   "window_days": {
    "format": "uint32",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "window_days",
   "total",
   "by_severity",
   "by_state",
   "auto_resolved",
   "human_resolved",
   "top_monitors"
  ],
  "title": "IncidentMetricsResult",
  "type": "object"
 },
 "title": "Incident metrics"
}
