{
 "description": "Update a benefit's details. Audit-logged. Amount changes affect future periods only. Use status 'discontinued' to archive a removed perk.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "pattern": "^[+-]?\\d+(\\.\\d+)?$",
      "type": "string"
     }
    ],
    "description": "Update amount (future periods only)"
   },
   "benefit_id": {
    "description": "The benefit ID to update",
    "type": "string"
   },
   "category": {
    "description": "Update category",
    "type": "string"
   },
   "credit_name": {
    "description": "Update benefit name",
    "type": "string"
   },
   "notes": {
    "description": "Add a note (appended with timestamp)",
    "type": "string"
   },
   "status": {
    "description": "Set to 'discontinued' to archive",
    "enum": [
     "active",
     "discontinued"
    ],
    "type": "string"
   }
  },
  "required": [
   "benefit_id"
  ],
  "type": "object"
 },
 "name": "update_benefit"
}
