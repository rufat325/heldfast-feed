{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Ranked formats, languages or resource types used by research items. Feed values into the corresponding search filters.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "'genres' is an alias of 'formats'. The former 'tags' facet is merged into subjects \u2014 use list_subjects",
    "enum": [
     "formats",
     "genres",
     "languages",
     "resource_types"
    ],
    "type": "string"
   },
   "keyword": {
    "description": "Substring filter on the value",
    "maxLength": 1000,
    "type": "string"
   },
   "limit": {
    "description": "Default 100, max 500",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "list_categories",
 "title": "List a category facet"
}
