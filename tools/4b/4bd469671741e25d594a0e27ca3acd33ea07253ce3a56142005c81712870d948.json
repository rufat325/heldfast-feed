     "additionalProperties": false,
     "properties": {
      "attribute": {
       "type": "string"
      },
      "offered": {},
      "requested": {}
     },
     "required": [
      "attribute",
      "requested",
      "offered"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "missing": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
   "matches",
   "missing",
   "mismatched",
   "extra",
   "scope"
  ],
  "type": "object"
 }
}
