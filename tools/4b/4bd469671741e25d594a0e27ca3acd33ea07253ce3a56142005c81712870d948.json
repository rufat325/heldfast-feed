  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "offered": {
      "maxProperties": 100,
      "type": "object"
     },
     "requested": {
      "maxProperties": 100,
      "type": "object"
     }
    },
    "required": [
     "requested",
     "offered"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "commerce_variant_compare",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "extra": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "matches": {
