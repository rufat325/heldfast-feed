{
 "description": "MCP server health check ($0.01 USDC on Base): connect to any public MCP endpoint over HTTPS, confirm it is reachable, list its tool names and input-schema summaries, compare against expected tool names, and flag risky or misleading tool descriptions. Read-only: inspected tools are never called. Use it before wiring an unknown MCP server into an agent, or to verify your own deployment. Pair with check_url to pre-screen a suspicious endpoint.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "endpoint": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "expected_tools": {
    "items": {
     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "endpoint"
  ],
  "type": "object"
 },
 "name": "mcp_server_inspect",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "capabilities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "duplicate_tool_names": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "endpoint_host": {
    "type": "string"
   },
   "expected_tools": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "missing": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "unexpected": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "missing",
       "unexpected"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "inspected_at": {
    "type": "string"
   },
   "metadata_is_untrusted": {
    "const": true,
    "type": "boolean"
   },
   "read_only_inspection": {
    "const": true,
    "type": "boolean"
   },
   "server": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "version"
    ],
    "type": "object"
   },
   "status": {
    "const": "reachable",
    "type": "string"
   },
   "tool_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "tool_list_truncated": {
    "type": "boolean"
   },
   "tools": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description_excerpt": {
       "type": "string"
      },
      "metadata_is_untrusted": {
       "const": true,
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "risk_flags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "schema": {
       "additionalProperties": false,
       "properties": {
        "fields": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "name": {
            "type": "string"
           },
           "required": {
            "type": "boolean"
           },
           "type": {
            "type": "string"
           }
          },
          "required": [
           "name",
           "required",
           "type"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "valid": {
         "type": "boolean"
        },
        "warnings": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "valid",
        "fields",
        "warnings"
       ],
       "type": "object"
      }
     },
     "required": [
      "name",
      "description_excerpt",
      "schema",
      "risk_flags",
      "metadata_is_untrusted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "tools_were_not_called": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "endpoint_host",
   "inspected_at",
   "server",
   "capabilities",
   "tool_count",
   "tool_list_truncated",
   "duplicate_tool_names",
   "expected_tools",
   "tools",
   "read_only_inspection",
   "tools_were_not_called",
   "metadata_is_untrusted"
  ],
  "type": "object"
 }
}
