{
 "description": "Create a new merchant under your organization. Requires KYC data. Financial fields may be required by specific affiliation providers later.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "Address.",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "default": "BR",
      "type": "string"
     },
     "line": {
      "type": "string"
     },
     "postal_code": {
      "type": "string"
     },
     "state": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "contact": {
    "description": "Contact details.",
    "properties": {
     "birth_date": {
      "description": "ISO 8601 date",
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "occupation": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "declared_income": {
    "description": "Declared personal income, for individual merchants (optional)",
    "type": "number"
   },
   "declared_revenue": {
    "description": "Declared monthly/annual revenue (optional; some affiliation providers require it)",
    "type": "number"
   },
   "document_number": {
    "description": "CNPJ or CPF",
    "type": "string"
   },
   "document_type": {
    "description": "e.g. CNPJ or CPF",
    "type": "string"
   },
   "full_name": {
    "description": "Full legal name (raz\u00e3o social / nome completo)",
    "type": "string"
   },
   "mcc": {
    "description": "Merchant Category Code \u2014 see list_mccs",
    "type": "string"
   },
   "name": {
    "description": "Trading/display name",
    "type": "string"
   },
   "net_worth": {
    "description": "Declared net worth (optional)",
    "type": "number"
   }
  },
  "required": [
   "full_name",
   "name",
   "document_number",
   "document_type",
   "mcc",
   "contact",
   "address"
  ],
  "type": "object"
 },
 "name": "create_merchant"
}
