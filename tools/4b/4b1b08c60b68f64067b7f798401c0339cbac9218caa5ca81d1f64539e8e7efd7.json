{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get ocean conditions"
 },
 "description": "Facts for ONE covered spot over up to 7 days: 3-hour forecast periods with condition score (0-100) and rating, water visibility (ft), swell height/period/direction, wind, tide state and height, water temperature, plus tide events and data quality. Pass a spot id, or lat+lon to use the nearest covered spot within 30 km. Free.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "First day, spot-local YYYY-MM-DD. Default: today.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "lat": {
    "description": "Latitude; snaps to the nearest covered spot within 30 km.",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "description": "Longitude; use with lat.",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "spot": {
    "description": "Spot id, e.g. \"electric-beach\". Pass this OR lat+lon.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "Last day, inclusive. At most 7 days after from. Default: from + 6.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_conditions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "periods": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "score": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "start": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "start",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "schema": {
    "type": "string"
   },
   "source": {
    "additionalProperties": {},
    "properties": {
     "docs": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "url",
     "docs"
    ],
    "type": "object"
   },
   "spot": {
    "additionalProperties": {},
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   }
  },
  "required": [
   "schema",
   "spot",
   "periods",
   "source"
  ],
  "type": "object"
 },
 "title": "Get ocean conditions"
}
