{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing SWSD time entry on an incident, problem, change, or release. Pass name and/or minutes_parsed. WRITE \u2014 honors SWSD_WRITE_MODE and does not retry on transient failure.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Parent record id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "minutes_parsed": {
    "description": "Updated number of minutes.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Updated time entry description.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "object_type": {
    "description": "Parent SWSD object type.",
    "enum": [
     "incidents",
     "problems",
     "changes",
     "releases"
    ],
    "type": "string"
   },
   "time_track_id": {
    "description": "SWSD time track id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "object_type",
   "id",
   "time_track_id"
  ],
  "type": "object"
 },
 "name": "swsd_update_time_track"
}
