{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new status page with name, domain prefix, and type (public/internal)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domainPrefix": {
    "description": "Unique domain prefix for the status page URL",
    "type": "string"
   },
   "name": {
    "description": "Name of the status page",
    "type": "string"
   },
   "subscriptionsEnabled": {
    "description": "Whether email subscriptions are enabled",
    "type": "boolean"
   },
   "type": {
    "description": "Page type: public (internet-accessible) or internal (org-only)",
    "enum": [
     "public",
     "internal"
    ],
    "type": "string"
   },
   "visualizationType": {
    "description": "Visualization type (currently only 'component_list')",
    "enum": [
     "component_list"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "domainPrefix",
   "type",
   "visualizationType"
  ],
  "type": "object"
 },
 "name": "create-status-page"
}
