``unit_count`` and ``property_type`` always win.","properties":{"baths":{"anyOf":[{"maximum":20,"minimum":0,"type":"number"},{"type":"null"}],"default":null},"beds":{"anyOf":[{"maximum":20,"minimum":0,"type":"integer"},{"type":"null"}],"default":null},"property_type":{"anyOf":[{"enum":["single_family","condo","coop","multi_family"],"type":"string"},{"type":"null"}],"default":null},"sqft":{"anyOf":[{"maximum":50000,"minimum":1,"type":"integer"},{"type":"null"}],"default":null},"unit_count":{"anyOf":[{"maximum":50,"minimum":1,"type":"integer"},{"type":"null"}],"default":null},"year_built":{"anyOf":[{"maximum":2027,"minimum":1700,"type":"integer"},{"type":"null"}],"default":null}},"type":"object"},"V1PreviousSale":{"additionalProperties":false,"properties":{"arms_length":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null},"date":{"format":"date","type":"string"},"price":{"maximum":100000000,"minimum":1,"type":"number"}},"required":["price","date"],"type":"object"}},"additionalProperties":false,"properties":{"address":{"maxLength":300,"minLength":1,"type":"string"},"comp_radius_miles":{"anyOf":[{"maximum":5.0,"minimum":0.1,"type":"number"},{"type":"null"}],"default":null},"condition":{"anyOf":[{"$ref":"#/$defs/V1Condition"},{"type":"null"}],"default":null},"confirm_pin":{"anyOf":[{"maxLength":64,"type":"string"},{"type":"null"}],"default":null},"exclude_comps":{"items":{"type":"string"},"maxItems":50,"type":"array"},"facts":{"anyOf":[{"$ref":"#/$defs/V1Facts"},{"type":"null"}],"default":null},"fresh":{"default":false,"type":"boolean"},"include":{"items":{"const":"narrative","type":"string"},"type":"array"},"include_comps":{"items":{"$ref":"#/$defs/CallerComp"},"maxItems":10,"type":"array"},"list_date":{"anyOf":[{"format":"date","type":"string"},{"type":"null"}],"default":null},"list_price":{"anyOf":[{"maximum":100000000,"minimum":0,"type":"number"},{"type":"null"}],"default":null},"listing_status":{"anyOf":[{"enum":["active","contingent","pending"],"type":"string"},{"type":"null"}],"default":null},"manual_pin_override":{"anyOf":[{"maxLength":64,"type":"string"},{"type":"null"}],"default":null},"original_list_price":{"anyOf":[{"maximum":100000000,"minimum":0,"type":"number"},{"type":"null"}],"default":null},"personas":{"items":{"enum":["buyer","seller","investor"],"type":"string"},"type":"array"},"previous_sale":{"anyOf":[{"$ref":"#/$defs/V1PreviousSale"},{"type":"null"}],"default":null},"prior_contract_fell_through":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null},"prior_listings":{"items":{"$ref":"#/$defs/PriorListingPeriod"},"maxItems":10,"type":"array"},"priorities":{"anyOf":[{"$ref":"#/$defs/UserPriorities"},{"type":"null"}],"default":null}},"required":["address"],"title":"V1AnalyzeRequest","type":"object"},"name":"analyze_property","outputSchema":{"additionalProperties":true,"title":"analyze_propertyDictOutput","type":"object"}}
