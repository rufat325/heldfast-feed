{
 "description": "Create a global product attribute (taxonomy pa_{slug})",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "has_archives": {
    "description": "Enable archive pages for terms (default false)",
    "type": "boolean"
   },
   "name": {
    "description": "Attribute name (label)",
    "type": "string"
   },
   "order_by": {
    "description": "Default term sort order (default menu_order)",
    "enum": [
     "menu_order",
     "name",
     "name_num",
     "id"
    ],
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Slug, max 28 chars (default: derived from name)",
    "type": "string"
   },
   "type": {
    "description": "Attribute type (default \"select\"; plugins may add others)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "name"
  ],
  "type": "object"
 },
 "name": "woo_create_attribute"
}
