{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Consulta i contenuti pubblici di Messe Oggi. Scegli topic: places (luoghi di culto), broadcasters (emittenti), articles (approfondimenti), readings (letture e Vangelo), saints (santi del giorno), prayers (testi della Liturgia delle Ore), rosaries (programmi del Rosario). Usa slug per un contenuto specifico, query per cercarlo, page per passare alla pagina successiva o date per i contenuti giornalieri. Cita i link ufficiali.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","oneOf":[{"additionalProperties":false,"properties":{"page":{"maximum":13,"minimum":1,"type":"integer"},"query":{"maxLength":80,"minLength":2,"type":"string"},"slug":{"maxLength":120,"pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$","type":"string"},"topic":{"enum":["places","broadcasters","articles"],"type":"string"}},"required":["topic"],"type":"object"},{"additionalProperties":false,"properties":{"date":{"format":"date","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$","type":"string"},"topic":{"enum":["readings","saints","prayers"],"type":"string"}},"required":["topic"],"type":"object"},{"additionalProperties":false,"properties":{"topic":{"const":"rosaries","type":"string"}},"required":["topic"],"type":"object"}],"type":"object"},"name":"consulta_contenuti"}
