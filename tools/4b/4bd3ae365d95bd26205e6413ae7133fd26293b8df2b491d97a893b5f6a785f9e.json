{
 "description": "Get NFT marketplace stats ranked by an attribute over a timeframe.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attribute": {
    "description": "Attribute to rank by.",
    "enum": [
     "sales",
     "owners",
     "supply",
     "sales_volume",
     "traders"
    ],
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Defaults to 1.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Items per page: 10, 25, 50, or 100. Defaults to 25. Keep small to save context.",
    "enum": [
     10,
     25,
     50,
     100
    ],
    "type": "number"
   },
   "sort": {
    "description": "Sort order. Defaults to \"desc\".",
    "enum": [
     "desc",
     "asc"
    ],
    "type": "string"
   },
   "timeframe": {
    "description": "Time window for the stats.",
    "enum": [
     "day",
     "week",
     "month",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_marketplace_stats"
}
