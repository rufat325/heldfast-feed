  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "carId": {
    "description": "The id of a car from search_cars results.",
    "maxLength": 40,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "carId"
  ],
  "type": "object"
 },
