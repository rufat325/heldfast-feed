{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. Find a Brazilian company's CNPJ by name (legal or trade name, optional state/UF) in the Receita Federal registry of ACTIVE establishments (monthly dump; individual entrepreneurs/MEI not indexed, query those by CNPJ). Returns up to 20 candidates with CNPJ, names, city/state, main activity and opening date. Use the CNPJ with the other tools. Rate limited (50/day).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results, default 10.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Company name, legal or trade (e.g. 'Petrobras', 'construtora alfa').",
    "maxLength": 120,
    "minLength": 3,
    "type": "string"
   },
   "state": {
    "description": "Optional UF to narrow down (e.g. 'SP').",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "br_company_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cached": {
    "type": "boolean"
   },
   "data_freshness": {
    "type": "string"
   },
   "generated_at": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "reference_month": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "cnpj": {
       "type": "string"
      },
      "cnpj_formatted": {
       "type": "string"
      },
      "is_headquarters": {
       "type": "boolean"
      },
      "legal_name": {
       "type": "string"
      },
      "registration_status": {
       "type": "string"
      },
      "state": {
       "type": [
        "string",
        "null"
       ]
      },
      "trade_name": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "cnpj",
