{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":true,"title":"\uc0ac\uc5c5\uc790\u00b7\ub300\ub9ac\uc778 \ub9ac\ud3ec\ud2b8(\uc138\ubb34\u00b7\ub178\ubb34)"},"description":"\uc138\ubb34\uc0ac\u00b7\ub178\ubb34\uc0ac\u00b7\uc18c\uc0c1\uacf5\uc778 \ub2f4\ub2f9\uc790\uac00 **\uac70\ub798\ucc98 1\uacf3**\uc758 \uc2e0\uccad \ud6c4\ubcf4\ub97c \ud55c \ubc88\uc5d0 \ubf51\ub294 \ub9ac\ud3ec\ud2b8. \uc5c5\uc885\u00b7\uc0c1\uc2dc\uadfc\ub85c\uc790 \uc218\u00b7\uc5f0\ub9e4\ucd9c\u00b7\uc5c5\ub825\u00b7\uc18c\uc7ac\uc9c0\ub97c \ub123\uc73c\uba74 \uc18c\uc0c1\uacf5\uc778/\uc18c\uae30\uc5c5 \uae30\uc900 \ud574\ub2f9 \uc5ec\ubd80\ub97c \ucd94\uc815\ud558\uace0, \ud6c4\ubcf4\ub97c \uc18c\uc0c1\uacf5\uc778\u00b7\uc911\uc18c\uae30\uc5c5\u00b7\uace0\uc6a9\u00b7\ub178\ubb34\u00b7\uc815\ucc45\uc790\uae08\u00b7\uc138\uc81c \ub124 \ubb36\uc74c\uc73c\ub85c \ub098\ub220 \uc6b0\uc120\uc21c\uc704\uc640 \ub9c8\uac10 D-day(7\uc77c \uc774\ub0b4 \uac15\uc870)\ub97c \ubd99\uc5ec \uc90d\ub2c8\ub2e4. \uac19\uc740 \uc694\uccad\uc744 `/v1/report/export.csv`\u00b7`/v1/report/print.html` \ub85c \ubcf4\ub0b4\uba74 \uac70\ub798\ucc98 \uc804\ub2ec\uc6a9 CSV\u00b7\uc778\uc1c4\uc6a9 \uc694\uc57d \ubdf0\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uac1c\uc778 \uc2dd\ubcc4 \uc815\ubcf4(\uc0c1\ud638\u00b7\ub300\ud45c\uc790\u00b7\uc5f0\ub77d\ucc98)\ub294 \ubc1b\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4.","inputSchema":{"properties":{"annual_revenue_eok":{"description":"\uc5f0\ub9e4\ucd9c(\uc5b5 \uc6d0) \u2014 \uc6d0 \ub2e8\uc704 \ub300\uc2e0 \uc4f8 \uc218 \uc788\uc74c","minimum":0,"type":"number"},"annual_revenue_krw":{"description":"\uc9c1\uc804 \uc0ac\uc5c5\uc5f0\ub3c4 \uc5f0\ub9e4\ucd9c(\uc6d0)","minimum":0,"type":"integer"},"biz_entity":{"description":"\uae30\uc5c5 \ud615\ud0dc(\ube44\uc6b0\uba74 \uaddc\ubaa8 \ucd94\uc815\uc73c\ub85c \uc815\ud569\ub2c8\ub2e4)","enum":["pre_startup","sole_proprietor","small_business","sme","corporate","venture","social_enterprise"],"type":"string"},"biz_status":{"description":"pre(\uc0ac\uc5c5\uc790\ub4f1\ub85d \uc804) | operating(\uc6b4\uc601 \uc911, \uae30\ubcf8\uac12)","enum":["pre","operating"],"type":"string"},"biz_years":{"description":"\uc5c5\ub825(\ub144)","maximum":60,"minimum":0,"type":"number"},"employees":{"description":"\uc0c1\uc2dc\uadfc\ub85c\uc790 \uc218(\ub300\ud45c\uc790 \uc81c\uc678, \uc6d4 60\uc2dc\uac04 \ubbf8\ub9cc \uc81c\uc678, 60\uc2dc\uac04 \uc774\uc0c1 \ub2e8\uc2dc\uac04\uc740 0.5\uba85)","maximum":100000,"minimum":0,"type":"integer"},"include_closed":{"default":false,"type":"boolean"},"industry":{"description":"\uc5c5\uc885 \u2014 \ucf54\ub4dc \ub610\ub294 \ud55c\uae00 \ubcc4\uce6d: manufacturing(\uc81c\uc870), retail(\ub3c4\uc18c\ub9e4), food(\uc74c\uc2dd\uc219\ubc15), ict(IT\u00b7\uc815\ubcf4\ud1b5\uc2e0), service(\uc11c\ube44\uc2a4), construction(\uac74\uc124), logistics(\ubb3c\ub958), agri(\ub18d\ub9bc\uc5b4\uc5c5), education(\uad50\uc721), health(\ubcf4\uac74\uc758\ub8cc), culture(\ubb38\ud654\uad00\uad11), energy(\ud658\uacbd\uc5d0\ub108\uc9c0), finance(\uae08\uc735), etc(\uae30\ud0c0), \ucc3d\uc5c5(\uc608\ube44\ucc3d\uc5c5\uc790)","type":"string"},"interest":{"description":"\ubcf4\uace0 \uc2f6\uc740 \ubb36\uc74c\ub9cc \uace0\ub974\uae30(\uae30\ubcf8: \ub124 \ubb36\uc74c \uc804\ubd80)","items":{"enum":["small_business","sme","labor","finance_tax"],"type":"string"},"type":"array"},"keyword":{"description":"\uacf5\uace0\uba85 \ud0a4\uc6cc\ub4dc","type":"string"},"limit":{"default":60,"maximum":200,"minimum":1,"type":"integer"},"sido":{"description":"\uc18c\uc7ac\uc9c0 \uc2dc\u00b7\ub3c4 (\uc608: \uc778\ucc9c\uad11\uc5ed\uc2dc)","type":"string"},"sigungu":{"description":"\uc2dc\u00b7\uad70\u00b7\uad6c (\uc608: \uc11c\ud574\uad6c)","type":"string"}},"required":[],"type":"object"},"name":"business_report","title":"\uc0ac\uc5c5\uc790\u00b7\ub300\ub9ac\uc778 \ub9ac\ud3ec\ud2b8(\uc138\ubb34\u00b7\ub178\ubb34)"}
