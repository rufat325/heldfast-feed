{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update or rename a custom data object by name. Entity-generated DTOs are returned by getProject with generated=true and must be changed through their entity fields or REST/frontend options. Background information: https://bootify.io/spring-data/hibernate-json-type.html",
 "inputSchema": {
  "additionalProperties": false,
  "minProperties": 3,
  "properties": {
   "appModule": {
    "description": "Custom app module; null selects base. Available with Bootify Professional. ",
    "maxLength": 255,
    "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
    "type": [
     "string",
     "null"
    ]
   },
   "featurePackage": {
    "description": "Optional dot-separated package path for domain-driven or mixed structure; null uses automatic assignment",
    "maxLength": 255,
    "pattern": "[a-z]+[a-z0-9]*((-|\\.)[a-z]+[a-z0-9]*)*",
    "type": [
     "string",
     "null"
    ]
   },
   "fields": {
    "description": "Complete ordered data object field list.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fileEndings": {
       "description": "Allowed file endings for FILE fields",
       "items": {
        "maxLength": 255,
        "type": "string"
       },
       "maxItems": 255,
       "type": "array",
       "uniqueItems": true
      },
      "max": {
       "description": "Maximum length for STRING or LIST<STRING> fields",
       "maximum": 99999,
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "description": "Field name",
       "maxLength": 255,
       "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
       "type": "string"
      },
      "precision": {
       "description": "Total decimal digits for NUMERIC or LIST<NUMERIC> fields",
       "maximum": 99999,
       "minimum": 1,
       "type": "integer"
      },
      "required": {
       "type": "boolean"
      },
      "scale": {
       "description": "Fractional decimal digits for NUMERIC or LIST<NUMERIC>; must not exceed precision",
       "maximum": 99999,
       "minimum": 1,
       "type": "integer"
      },
      "type": {
       "description": "Built-in types: BOOLEAN, UUID, FILE, STRING, TEXT, INTEGER, LONG, DOUBLE, NUMERIC, LOCAL_DATE, LOCAL_TIME, LOCAL_DATE_TIME, OFFSET_DATE_TIME. Use an existing project enum or custom data object name for custom types; the type must be accessible from the owning module. Entity-generated DTOs cannot be used as field types. Collections use LIST<T> and MAP<K,V>, for example LIST<STRING> or MAP<STRING,OrderStatus>. Container nesting and PAGE fields are not supported. FILE is allowed only as a direct field type; TEXT cannot be a map value. Map keys are BOOLEAN, STRING, INTEGER, LONG, DOUBLE, UUID or an enum name.",
       "maxLength": 255,
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 1024,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "description": "Current name of the data object",
    "maxLength": 255,
    "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
    "type": "string"
   },
   "newName": {
    "description": "New data object name; omit to keep its name",
    "maxLength": 255,
    "pattern": "[a-zA-Z]+[a-zA-Z0-9]*(-[a-zA-Z0-9]+)*",
    "type": "string"
   },
   "projectId": {
    "description": "The project ID returned by startProject",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "name"
  ],
  "type": "object"
 },
 "name": "updateDataObject",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affectedAreas": {
    "description": "Object lists changed directly or by automatic effects. Lists are not returned; use getProject with these details when needed. Empty for no list changes.",
    "items": {
     "enum": [
      "APP_MODULES",
      "ENUMS",
      "DATA_OBJECTS",
      "ENTITIES",
      "RELATIONS",
      "INDEXES",
      "REST_CONTROLLERS",
      "FRONTEND_CONTROLLERS",
      "SECURITY_CONFIGS"
     ],
     "type": "string"
    },
    "type": "array",
    "uniqueItems": true
   },
   "changes": {
    "additionalProperties": false,
    "description": "Only settings whose values actually changed, including automatic effects, using final stored values in MCP format. Nested objects contain changed properties only. Empty when no settings changed; values that are no longer exposed are omitted.",
    "properties": {
     "advancedOptions": {
      "additionalProperties": false,
      "description": "Available with Bootify Professional. ",
      "properties": {
       "actuatorEnabled": {
        "type": "boolean"
       },
       "actuatorEndpoints": {
        "items": {
         "enum": [
          "auditevents",
          "beans",
          "caches",
          "conditions",
          "configprops",
          "env",
          "flyway",
          "health",
          "httpexchanges",
          "info",
          "integrationgraph",
          "loggers",
          "liquibase",
          "metrics",
          "mappings",
          "modulith",
          "quartz",
          "scheduledtasks",
          "sessions",
          "shutdown",
          "startup",
          "threaddump",
          "heapdump",
          "logfile",
          "prometheus"
         ],
         "type": "string"
        },
        "type": "array"
       },
       "hateoasEnabled": {
        "type": "boolean"
       },
       "mapStructEnabled": {
        "type": "boolean"
       },
       "modularization": {
        "enum": [
         "NONE",
         "MODULITH",
         "MULTI_MODULE"
        ],
        "type": "string"
       },
       "multiModulePrefix": {
        "type": "boolean"
       },
       "serviceInterfaceEnabled": {
        "type": "boolean"
       },
       "springSession": {
        "enum": [
         "NONE",
         "JDBC",
         "REDIS"
        ],
        "type": "string"
       },
       "testSetup": {
        "enum": [
         "NONE",
         "TESTCONTAINERS",
         "PLAYWRIGHT",
         "ALL"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "buildType": {
      "enum": [
       "GRADLE",
       "MAVEN"
      ],
      "type": "string"
     },
     "database": {
      "additionalProperties": false,
      "properties": {
       "dateCreatedName": {
        "type": "string"
       },
       "dateFieldsEnabled": {
        "type": "boolean"
       },
       "lastUpdatedName": {
        "type": "string"
       },
       "mongoSchemaType": {
        "enum": [
         "NONE",
         "MONGOCK"
        ],
        "type": "string"
       },
       "namingStrategy": {
        "enum": [
         "NONE",
         "UPPERCASE_ALL",
         "UPPERCASE_TABLES",
         "CAMELCASE_ALL",
         "CAMELCASE_TABLES"
        ],
        "type": "string"
       },
       "pluralizeTableName": {
        "type": "boolean"
       },
       "schemaType": {
        "enum": [
         "NONE",
         "HIBERNATE",
         "FLYWAY",
         "LIQUIBASE"
        ],
        "type": "string"
       },
       "tablePrefix": {
        "type": "string"
       },
       "tableSuffix": {
        "type": "string"
       },
       "type": {
        "enum": [
         "NONE",
         "OTHER",
         "MSSQL",
         "MYSQL",
         "MARIADB",
         "ORACLE",
         "POSTGRES",
         "MONGODB",
         "DERBY",
         "H2",
         "HSQL"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "dependencies": {
      "description": "Dependencies added to the generated Maven or Gradle build. Compatible versions are supplied by Spring Boot dependency management.",
      "items": {
       "type": "string"
      },
      "type": "array",
      "uniqueItems": true
     },
     "developerPreferences": {
      "additionalProperties": false,
      "properties": {
       "applicationFormat": {
        "enum": [
         "YAML",
         "PROPERTIES"
        ],
        "type": "string"
       },
       "deployment": {
        "enum": [
         "NONE",
         "HEROKU_GITHUB",
         "HEROKU_GITLAB"
        ],
        "type": "string"
       },
       "dockerComposeEnabled": {
        "type": "boolean"
       },
       "includeAgentInstructions": {
        "type": "boolean"
       },
       "javaVersion": {
        "enum": [
         17,
         21,
         25
        ],
        "type": "integer"
       },
       "openApiEnabled": {
        "type": "boolean"
       },
       "packageStructure": {
        "description": "Package layout: TECHNICAL groups classes by technical type in packages such as domain, repos, service and rest; DOMAIN_DRIVEN groups all classes related to an entity in a package named after that entity; MIXED creates an entity package with technical subpackages.",
        "enum": [
         "TECHNICAL",
         "DOMAIN_DRIVEN",
         "MIXED"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "frontend": {
      "additionalProperties": false,
      "properties": {
       "buildTool": {
        "enum": [
         "NONE",
         "VITE",
         "WEBPACK"
        ],
        "type": "string"
       },
       "cssFramework": {
        "enum": [
         "BOOTSTRAP",
         "TAILWIND"
        ],
        "type": "string"
       },
       "framework": {
        "enum": [
         "NONE",
         "THYMELEAF",
         "JTE",
         "ANGULAR",
         "REACT"
        ],
        "type": "string"
       },
       "htmxEnabled": {
        "description": "Present only for Thymeleaf and JTE",
        "type": "boolean"
       },
       "typescriptEnabled": {
        "description": "Present only for Vite or Webpack with Thymeleaf and JTE",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "group": {
      "type": "string"
     },
     "includeFileHandling": {
      "description": "Include file handling services and database storage",
      "type": "boolean"
     },
     "includeInputRow": {
      "description": "Include inputRow and supporting form utilities; requires Thymeleaf, jte, Angular or React",
      "type": "boolean"
     },
     "includePaginationAndSorting": {
      "description": "Include frontend pagination and sorting utilities; requires a frontend framework",
      "type": "boolean"
     },
     "includeSearchFilter": {
      "description": "Include frontend search filter utilities; requires a frontend framework",
      "type": "boolean"
     },
     "language": {
      "enum": [
       "JAVA",
       "KOTLIN"
      ],
      "type": "string"
     },
     "lombokEnabled": {
      "description": "Whether Lombok is enabled; present only for Java projects",
      "type": "boolean"
     },
     "mailSettings": {
      "additionalProperties": false,
      "description": "Available with Bootify Professional. ",
      "properties": {
       "connection": {
        "enum": [
         "TLS",
         "SSL"
        ],
        "type": "string"
       },
       "displayName": {
        "type": "string"
       },
       "enabled": {
        "type": "boolean"
       },
       "from": {
        "type": "string"
       },
       "host": {
        "type": "string"
       },
       "username": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "name": {
      "type": "string"
     },
     "planLevel": {
      "description": "The feature level assigned to the project",
      "enum": [
       "FREE",
       "PROFESSIONAL",
       "ENTERPRISE"
      ],
      "type": "string"
     },
     "planStatus": {
      "description": "Whether the project's plan is still valid",
      "enum": [
       "VALID",
       "EXPIRED"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "projectId": {
    "description": "The project ID returned by startProject",
    "type": "string"
   },
   "userProjectChanged": {
    "const": true,
    "description": "Present only once when the project appears to have been changed by the user since the preceding MCP call within the last two hours",
    "type": "boolean"
   }
  },
  "required": [
   "projectId",
   "changes",
   "affectedAreas"
  ],
  "type": "object"
 },
 "title": "Update a project data object"
}
