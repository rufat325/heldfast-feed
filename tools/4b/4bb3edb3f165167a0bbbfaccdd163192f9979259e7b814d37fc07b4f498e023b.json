{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Uninstall a deployment (catalog or custom) by deployment_id. Set purge_data:true to also wipe its data volume. Destructive \u2014 requires the \"manage\" scope. Idempotent (a no-op success on an already-removed deployment). If confirm_token is absent from this connection's input schema, use a connection that exposes it or a supported customer-portal flow. A quote or confirmation request is not completion. IRREVERSIBLE \u2014 takes two calls: the first returns a confirm_token and changes nothing, the second repeats the same arguments plus confirm_token and executes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "purge_data": {
    "description": "Wipe the data volume too. Default false.",
    "type": "boolean"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_uninstall_deployment",
 "outputSchema": {
  "anyOf": [
   {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "command_id": {
        "type": "string"
       },
       "deployment": {
        "type": "object"
       }
      },
      "required": [
       "command_id",
       "deployment"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "deployment_id": {
        "type": "string"
       },
       "note": {
        "type": "string"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "deployment_id",
       "status",
       "note"
      ],
      "type": "object"
     }
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Uninstall app"
}
