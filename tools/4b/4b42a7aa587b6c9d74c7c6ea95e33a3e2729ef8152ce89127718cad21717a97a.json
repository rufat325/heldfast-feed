{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Start selling something in one call: creates a product that people can buy on the linked account's Swop SmartSite and AI agents can buy in USDC over x402, with no store setup, payment processor, or verification needed. To change an existing product use swop_update_product instead. name, description and image are all REQUIRED by the backend. Confirm name and price with the user before creating. Then call swop_feature_product to show it on the SmartSite and swop_get_product_link to share it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Product description (required)",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "digitalDeliveryNote": {
    "description": "Digital goods: what the buyer receives after purchase",
    "maxLength": 500,
    "type": "string"
   },
   "extraImages": {
    "description": "Additional image URLs, shown after the primary one",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 9,
    "type": "array"
   },
   "image": {
    "description": "Primary product image URL (required)",
    "format": "uri",
    "type": "string"
   },
   "keywords": {
    "description": "Search keywords",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "mintLimit": {
    "description": "Inventory available, default 1",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "description": "Product name",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "nftType": {
    "description": "Fine-grained type; overrides productType. phygital/menu are physical, the rest digital",
    "enum": [
     "phygital",
     "menu",
     "collectible",
     "subscription",
     "membership",
     "coupon"
    ],
    "type": "string"
   },
   "priceUsd": {
    "description": "Price in USD (settles in USDC)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "productType": {
    "description": "physical (ships), digital (default), or in_person_checkout",
    "enum": [
     "physical",
     "digital",
     "in_person_checkout"
    ],
    "type": "string"
   },
   "requiresShipping": {
    "description": "Physical goods: collect a shipping address",
    "type": "boolean"
   },
   "royaltyPercentage": {
    "description": "Resale royalty percent",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "royaltyRecipient": {
    "description": "Wallet receiving royalties",
    "type": "string"
   },
   "shippingCost": {
    "description": "Flat shipping cost in USD",
    "minimum": 0,
    "type": "number"
   },
   "variants": {
    "description": "Buyer-selectable options. Replaces the existing set when given.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "Variant group, e.g. \"Color\" or \"Size\"",
       "minLength": 1,
       "type": "string"
      },
      "options": {
       "description": "Choices, e.g. [\"Black\",\"White\"]",
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "options"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "description",
   "priceUsd",
   "image"
  ],
  "type": "object"
 },
 "name": "swop_create_product",
 "title": "Create a product"
}
