 },
 "description": "List public sermons whose start time falls on one selected Europe/Warsaw calendar day, optionally limited to one church. Returns at most 50 compact records with no pagination; total and truncated disclose whether the hard safety ceiling omitted any sermons. Use get_sermon with a returned session_id when full sermon text is needed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "camera_id": {
    "description": "Optional stable public church profile ID. Omit it to list sermons from all churches on the selected day.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "date": {
    "description": "Required Europe/Warsaw calendar date using YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "date"
  ],
  "type": "object"
 },
 "name": "list_sermons_by_date",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "camera_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "maximum": {
    "enum": [
     50
    ],
    "type": "integer"
   },
   "returned": {
    "maximum": 50,
    "minimum": 0,
    "type": "integer"
   },
   "scope": {
    "enum": [
     "date"
    ],
    "type": "string"
   },
   "sermons": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "church": {
       "type": [
        "string",
        "null"
       ]
      },
      "church_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "excerpt": {
       "type": [
        "string",
        "null"
       ]
      },
      "session_id": {
       "type": "string"
      },
      "started_at": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "session_id",
      "title",
      "church_id",
      "church",
      "started_at",
      "excerpt",
      "url"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "total": {
    "minimum": 0,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "scope",
   "date",
   "camera_id",
   "maximum",
   "total",
   "returned",
   "truncated",
   "sermons"
  ],
  "type": "object"
 },
 "title": "List public sermons from one day"
}
