{"description":"Configure the shop's hosted public booking page (/p/book/<slug>) for Google Business Profile and Google Actions Center. Setting google_enabled true requires enabled true, slug, trade, service_zips, contact_phone, and mailing_address matching Google Business Profile (owner only to update contact_phone or mailing_address; owner or office for booking fields).","inputSchema":{"properties":{"contact_phone":{"maxLength":40,"type":["string","null"]},"enabled":{"type":"boolean"},"google_enabled":{"type":"boolean"},"mailing_address":{"maxLength":300,"type":["string","null"]},"service_zips":{"items":{"pattern":"^[0-9]{5}$","type":"string"},"maxItems":500,"type":"array","uniqueItems":true},"shop_id":{"format":"uuid","type":"string"},"show_open_times":{"type":"boolean"},"slug":{"pattern":"^[a-z0-9][a-z0-9-]{2,60}$","type":["string","null"]},"trade":{"enum":["painting","fencing","gutters","roofing","siding","windows_doors","plumbing","electrical","hvac","landscaping","lawn_care","tree_service","concrete_masonry","decks_patios","flooring","drywall","carpentry","cabinets_countertops","remodeling","handyman","cleaning","pressure_washing","pest_control","junk_removal","moving","appliance_repair","garage_doors","insulation","foundation","septic","pools","solar","locksmith","other",null],"type":["string","null"]}},"required":["shop_id"],"type":"object"},"name":"schedule_setBookingPage","outputSchema":{"anyOf":[{"properties":{"booking_url":{"type":["string","null"]},"enabled":{"type":"boolean"},"google_booking_url":{"type":["string","null"]},"google_enabled":{"type":"boolean"},"job_types":{"items":{"properties":{"minutes":{"type":"integer"},"name":{"type":"string"}},"required":["name","minutes"],"type":"object"},"type":"array"},"missing_nap":{"items":{"type":"string"},"type":"array"},"nap":{"properties":{"address":{"type":["string","null"]},"jurisdiction_id":{"type":"string"},"name":{"type":"string"},"phone":{"type":["string","null"]}},"required":["name","phone","addres