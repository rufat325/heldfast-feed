  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show Phorme training card"
 },
 "description": "Use this to show a compact Phorme card for a workout or program that was just previewed or saved. It displays only the title, counts, status and link it is given. It reads and changes nothing in Phorme.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "estimated_duration_minutes": {
    "maximum": 200000,
    "minimum": 0,
    "type": "integer"
   },
   "exercise_count": {
    "maximum": 50000,
    "minimum": 0,
    "type": "integer"
   },
   "open_url": {
    "description": "Link that opens the saved training in Phorme. Not set for previews.",
    "maxLength": 300,
    "type": "string"
   },
   "status": {
    "description": "\"preview\" for training not yet saved, \"saved\" for training saved to Phorme.",
    "enum": [
     "preview",
     "saved"
    ],
    "type": "string"
   },
   "title": {
    "description": "Training title from the tool result.",
    "maxLength": 160,
    "type": "string"
   },
   "training_kind": {
    "enum": [
     "workout",
     "program"
    ],
    "type": "string"
   },
   "warning_count": {
    "maximum": 50000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
