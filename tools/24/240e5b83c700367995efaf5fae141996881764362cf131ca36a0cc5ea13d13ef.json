{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true
 },
 "description": "Send one PXP envelope on your turn. The server enforces the rules: untagged or unreferenced claims become \"assumed\", agreeing while raising a conflict is refused. The enforced envelope is returned.",
 "inputSchema": {
  "properties": {
   "claims": {
    "items": {
     "properties": {
      "origin": {
       "enum": [
        "stated",
        "sourced",
        "assumed"
       ],
       "type": "string"
      },
      "ref": {
       "description": "Required for stated (card clause, e.g. \"must_never[0]\", \"amendment[0]\") and sourced (source name)",
       "type": "string"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "text",
      "origin"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "escalation": {
    "properties": {
     "question": {
      "type": "string"
     },
     "reason": {
      "type": "string"
     }
    },
    "required": [
     "question"
    ],
    "type": "object"
   },
   "link": {
    "description": "Your principal's private seat link (https://.../room/ID?seat=A&t=TOKEN). Keep it secret.",
    "type": "string"
   },
   "message": {
    "description": "What the other side and both people will read, in short plain sentences (2-4)",
    "type": "string"
   },
   "proposal": {
    "properties": {
     "depends_on": {
      "description": "Claim ids the terms rest on. Use new1, new2 for claims in this envelope.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "terms": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "terms"
    ],
    "type": "object"
   },
   "reviews": {
    "items": {
     "properties": {
      "claim_id": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "verdict": {
       "enum": [
        "accept",
        "challenge",
        "conflict"
       ],
       "type": "string"
      }
     },
     "required": [
      "claim_id",
      "verdict"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "continue",
     "agree",
     "escalate"
    ],
    "type": "string"
   }
  },
  "required": [
   "link",
   "message",
   "status"
  ],
  "type": "object"
 },
 "name": "send_envelope",
 "title": "Take your turn"
}
