{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Resolume Arena/Avenue OSC control scaffold with command maps, status DATs, and preview handoff notes. Runtime validation against Resolume remains explicit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "description": "Activate OSC operators immediately.",
    "type": "boolean"
   },
   "clip_count": {
    "default": 8,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "composition_name": {
    "default": "composition",
    "description": "Label stored in status metadata.",
    "type": "string"
   },
   "deck_count": {
    "default": 1,
    "maximum": 16,
    "minimum": 1,
    "type": "integer"
   },
   "layer_count": {
    "default": 3,
    "maximum": 32,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "resolume_arena",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Resolume scaffold.",
    "type": "string"
   },
   "preview_mode": {
    "default": "none",
    "enum": [
     "none",
     "ndi",
     "syphon_spout"
    ],
    "type": "string"
   },
   "receive_port": {
    "default": 7001,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "resolume_host": {
    "default": "127.0.0.1",
    "description": "Resolume OSC host.",
    "type": "string"
   },
   "send_port": {
    "default": 7000,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_resolume_arena",
 "title": "Connect Resolume Arena"
}
