{
 "description": "Get log output from an execution. Use node and stepctx params to filter specific logs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Execution ID",
    "type": "integer"
   },
   "maxlines": {
    "description": "Max log lines to return (default 500)",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "node": {
    "description": "Filter by node name",
    "type": "string"
   },
   "offset": {
    "description": "Log offset for pagination",
    "minimum": 0,
    "type": "integer"
   },
   "stepctx": {
    "description": "Filter by step context (e.g., '1' for first step)",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "rundeck_get_execution_output"
}
