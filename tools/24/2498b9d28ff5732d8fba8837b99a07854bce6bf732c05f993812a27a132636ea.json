{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Runs pip-audit and returns a structured vulnerability report.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Preview fix changes without applying (--dry-run)",
    "type": "boolean"
   },
   "fix": {
    "default": false,
    "description": "Auto-remediate vulnerabilities (--fix)",
    "type": "boolean"
   },
   "ignoreVuln": {
    "description": "Vulnerability IDs to suppress (e.g. PYSEC-2023-001)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "indexUrl": {
    "description": "Custom package index URL for corporate/private registry support",
    "maxLength": 65536,
    "type": "string"
   },
   "local": {
    "default": false,
    "description": "Only audit packages in the local virtualenv (-l, --local)",
    "type": "boolean"
   },
   "noDeps": {
    "default": false,
    "description": "Skip auditing dependencies (--no-deps)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "requirements": {
    "description": "Path to requirements file",
    "maxLength": 4096,
    "type": "string"
   },
   "skipEditable": {
    "default": false,
    "description": "Skip auditing editable packages (--skip-editable)",
    "type": "boolean"
   },
   "strict": {
    "default": false,
    "description": "Fail on skipped dependencies (-S, --strict)",
    "type": "boolean"
   },
   "vulnerabilityService": {
    "description": "Vulnerability service to query (default: pypi)",
    "enum": [
     "osv",
     "pypi"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pip-audit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "byPackage": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      },
      "vulnerabilities": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "cvssScore": {
          "description": "CVSS score if available (0.0-10.0)",
          "type": "number"
         },
         "description": {
          "type": "string"
         },
         "fixVersions": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "id": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "severity": {
          "description": "Severity level (e.g. HIGH, CRITICAL)",
          "type": "string"
         },
         "version": {
          "type": "string"
         }
        },
        "required": [
         "name",
         "version",
         "id",
         "description",
         "fixVersions"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "version",
      "vulnerabilities"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "severityCounts": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Vulnerability counts per severity (set in compact output)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "skipped": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skippedCount": {
    "description": "Count of packages skipped by the audit (set in compact output)",
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "total": {
    "description": "Total vulnerability count (set in compact output)",
    "type": "number"
   },
   "truncated": {
    "description": "Whether the compact vulnerability list was capped (only set when true)",
    "type": "boolean"
   },
   "vulnerabilities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cvssScore": {
       "description": "CVSS score if available (0.0-10.0)",
       "type": "number"
      },
      "description": {
       "type": "string"
      },
      "fixVersions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "severity": {
       "description": "Severity level (e.g. HIGH, CRITICAL)",
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version",
      "id",
      "description",
      "fixVersions"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "pip Audit"
}
