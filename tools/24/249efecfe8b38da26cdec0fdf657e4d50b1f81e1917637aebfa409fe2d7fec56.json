{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "rag",
 "description": "Build a structured system prompt from components: role, task, constraints, output format, tone, language, and examples. Generates a production-ready system prompt with token estimate.",
 "inputSchema": {
  "properties": {
   "constraints": {
    "description": "Rules and constraints to follow",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "examples": {
    "description": "Brief examples to include",
    "type": "string"
   },
   "language": {
    "description": "Response language (e.g. \"French\")",
    "type": "string"
   },
   "output_format": {
    "description": "Expected output format description",
    "type": "string"
   },
   "role": {
    "description": "Role/persona (e.g. \"Senior QA Engineer\", \"JSON extraction assistant\")",
    "type": "string"
   },
   "task": {
    "description": "Main task or objective",
    "type": "string"
   },
   "tone": {
    "description": "Communication tone",
    "enum": [
     "professional",
     "friendly",
     "concise",
     "technical",
     "educational"
    ],
    "type": "string"
   }
  },
  "required": [
   "role"
  ],
  "type": "object"
 },
 "name": "system_prompt_builder",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "sections": {
    "type": "object"
   },
   "system_prompt": {},
   "token_estimate": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
