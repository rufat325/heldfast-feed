{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Same formula as bloomyesim.com/data-calculator: daily MB per activity x days x Wi-Fi factor x 1.15 safety buffer, rounded up.",
 "inputSchema": {
  "properties": {
   "activities": {
    "items": {
     "enum": [
      "maps",
      "messaging",
      "web",
      "music",
      "voice",
      "social",
      "video_call",
      "hotspot_light",
      "video",
      "hotspot_heavy"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "days": {
    "maximum": 180,
    "minimum": 1,
    "type": "integer"
   },
   "wifi": {
    "enum": [
     "rarely",
     "sometimes",
     "often"
    ],
    "type": "string"
   }
  },
  "required": [
   "days",
   "activities"
  ],
  "type": "object"
 },
 "name": "estimate_data",
 "title": "Estimate how much data a trip needs"
}
