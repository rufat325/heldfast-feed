{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Request an async download for a video. Only works for CONVERTED, non-external, non-Hotmart videos. Returns {status, message}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "description": "Download format",
    "enum": [
     "video",
     "audio"
    ],
    "type": "string"
   },
   "language": {
    "description": "Language code (e.g. 'original', 'en', 'pt-BR')",
    "type": "string"
   },
   "quality": {
    "description": "Quality (e.g. '1080', '720', '480')",
    "type": "string"
   },
   "video_external_id": {
    "description": "Video external ID",
    "type": "string"
   },
   "video_title": {
    "description": "Video title (for the download file name)",
    "type": "string"
   }
  },
  "required": [
   "video_external_id",
   "quality",
   "format",
   "language",
   "video_title"
  ],
  "type": "object"
 },
 "name": "panda_request_download",
 "title": "Request Download"
}
