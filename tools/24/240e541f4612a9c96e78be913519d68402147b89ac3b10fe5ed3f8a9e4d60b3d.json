    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "principal": {
    "description": "Starting amount in dollars",
    "maximum": 10000000000,
    "minimum": 0,
    "type": "number"
   },
   "years": {
    "description": "Number of years",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
