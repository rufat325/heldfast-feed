    "minimum": -99,
    "type": "number"
   },
   "compounds_per_year": {
    "description": "1 yearly, 2 twice a year, 4 quarterly, 12 monthly, 365 daily. Default 12",
    "enum": [
     1,
     2,
     4,
     12,
     365
    ],
    "type": "number"
   },
   "monthly_contribution": {
