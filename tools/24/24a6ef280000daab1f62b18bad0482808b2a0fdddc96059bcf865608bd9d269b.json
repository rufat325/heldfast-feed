{
 "annotations": {
  "readOnlyHint": true,
  "title": "Transform coordinates between CRS"
 },
 "description": "Transform up to 50 coordinate pairs from a source coordinate reference system to a target one (EPSG codes). API: GET /coordinates/transform/{coordinates}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "coordinates": {
    "description": "1-50 [x, y] coordinate pairs in the source CRS.",
    "items": {
     "items": false,
     "maxItems": 2,
     "minItems": 2,
     "prefixItems": [
      {
       "type": "number"
      },
      {
       "type": "number"
      }
     ],
     "type": "array"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "ops": {
    "description": "Pipe-separated transformation operation codes to force a path.",
    "type": "string"
   },
   "s_srs": {
    "description": "Source CRS / EPSG code. Default 4326 (WGS84).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "t_srs": {
    "description": "Target CRS / EPSG code. Default 4326 (WGS84).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "coordinates"
  ],
  "type": "object"
 },
 "name": "maptiler_transform_coordinates",
 "title": "Transform coordinates between CRS"
}
