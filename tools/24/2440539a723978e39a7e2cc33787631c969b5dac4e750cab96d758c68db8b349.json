{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Converts a MIDI file (base64, up to 512 KB) into the melody format and validates it for a box, so you can fit, edit and save it. Drums are ignored. Saves nothing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "box": {
    "description": "Box to validate against. Default \"30\".",
    "enum": [
     "15",
     "20",
     "30",
     "freestyle"
    ],
    "type": "string"
   },
   "midi_base64": {
    "description": "The .mid file, base64-encoded.",
    "maxLength": 699056,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "midi_base64"
  ],
  "type": "object"
 },
 "name": "import_midi",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "melody": {
    "additionalProperties": false,
    "properties": {
     "box": {
      "type": "string"
     },
     "bpm": {
      "type": "number"
     },
     "notes": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "beat": {
         "type": "number"
        },
        "pitch": {
         "type": [
          "string",
          "number"
         ]
        },
        "ticks": {
         "type": "number"
        }
       },
       "required": [
        "pitch"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "box",
     "bpm",
     "notes"
    ],
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "notes_in_file": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "skipped_percussion_tracks": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "issues": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "index": {
         "description": "Index of the note in the input, when the issue is about one note.",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning"
         ],
         "type": "string"
        },
        "suggestions": {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ok": {
      "type": "boolean"
     },
     "stats": {
      "additionalProperties": false,
      "properties": {
       "duration_seconds": {
        "type": "number"
       },
       "illegal_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "note_count": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "strip_length_cm": {
        "type": "number"
       }
      },
      "required": [
       "note_count",
       "illegal_count",
       "duration_seconds"
      ],
      "type": "object"
     }
    },
    "required": [
     "ok",
     "issues",
     "stats"
    ],
    "type": "object"
   }
  },
  "required": [
   "name",
   "notes_in_file",
   "skipped_percussion_tracks",
   "melody",
   "validation"
  ],
  "type": "object"
 },
 "title": "Read a MIDI file as a melody"
}
