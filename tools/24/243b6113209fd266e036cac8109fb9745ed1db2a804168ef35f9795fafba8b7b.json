{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Review Dialogue Candidates"
 },
 "description": "Review revision-bound dialogue candidates with surrounding words, silence padding, explicit keep/reject decisions and unioned source-time removal duration. Recomputed review revisions reject stale selections. Local-only; no timeline mapping, transcription or mutation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expected_review_revision": {
    "description": "Revision from the initial review; required when selecting or rejecting entries. A changed input requires a new review.",
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "filler_words": {
    "description": "Exact filler words or phrases to flag for whole-segment review.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 64,
    "type": "array"
   },
   "minimum_silence_seconds": {
    "description": "Minimum silence duration; defaults to 0.7.",
    "maximum": 30,
    "minimum": 0.1,
    "type": "number"
   },
   "padding_seconds": {
    "default": 0.1,
    "description": "Speech retained at both edges of silence cuts; defaults to 0.1 seconds. Does not alter filler-word ranges.",
    "maximum": 2,
    "minimum": 0,
    "type": "number"
   },
   "rejected_ids": {
    "description": "Explicitly rejected entry IDs. Unselected entries remain pending.",
    "items": {
     "maxLength": 512,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 512,
    "type": "array"
   },
   "segments": {
    "description": "Captured transcript segments; each source must have one consistent revision.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "end_seconds": {
       "description": "Source-time end, greater than start.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "id": {
       "description": "Stable transcript segment ID.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "source_project_item_id": {
       "description": "Exact source project-item ID.",
       "maxLength": 512,
       "minLength": 1,
       "type": "string"
      },
      "speaker_label": {
       "description": "Reviewed speaker label.",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "start_seconds": {
       "description": "Source-time start in seconds.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "text": {
       "description": "Supplied transcript text; never uploaded or retained by this tool.",
       "maxLength": 1000,
       "type": "string"
      },
      "transcript_revision": {
       "description": "Revision of the captured source transcript.",
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source_project_item_id",
      "transcript_revision",
      "start_seconds",
      "end_seconds",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "minItems": 1,
    "type": "array"
   },
   "selected_ids": {
    "description": "Explicitly approved entry IDs. Omit for an initial review; an empty array approves nothing.",
    "items": {
     "maxLength": 512,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 512,
    "type": "array"
   },
   "silence_ranges": {
    "description": "Supplied local silence evidence; every source must occur in segments.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "end_seconds": {
       "description": "Source-time end greater than start.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      },
      "source_project_item_id": {
       "description": "Exact source project-item ID.",
       "maxLength": 512,
       "minLength": 1,
       "type": "string"
      },
      "start_seconds": {
       "description": "Source-time start.",
       "maximum": 86400,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "source_project_item_id",
      "start_seconds",
      "end_seconds"
     ],
     "type": "object"
    },
    "maxItems": 2000,
    "type": "array"
   }
  },
  "required": [
   "segments"
  ],
  "type": "object"
 },
 "name": "review_dialogue_candidates",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool-specific result data when ok is true; on failure, diagnostic detail when the tool provides it."
   },
   "error": {
    "description": "Failure detail when ok is false.",
    "type": "string"
   },
   "ok": {
    "description": "Whether the tool completed successfully.",
    "type": "boolean"
   },
   "tool": {
    "description": "The registered MCP tool name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ok",
   "tool"
  ],
  "type": "object"
 },
 "title": "Review Dialogue Candidates"
}
