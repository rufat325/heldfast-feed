{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Bounded official id_list lookup through the shared local cache and rate limiter. Writes immutable version snapshots and inbox discoveries; explicit historic lookups never demote latest metadata.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ids": {
    "items": {
     "maxLength": 100,
     "pattern": "^(?:\\d{4}\\.\\d{4,5}|[a-z][a-z.-]*(?:\\.[A-Z]{2})?\\/\\d{7})(?:v[1-9]\\d*)?$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "radar_lookup_ids",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "const": "candidate-only",
    "type": "string"
   },
   "cache": {
    "additionalProperties": false,
    "properties": {
     "age_seconds": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "cache_key": {
      "type": [
       "string",
       "null"
      ]
     },
     "error": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "class": {
          "type": "string"
         },
         "message": {
          "maxLength": 300,
          "type": "string"
         }
        },
        "required": [
         "class",
         "message"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "expires_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "fetched_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "request_performed": {
      "type": "boolean"
     },
     "snapshot_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "stale": {
      "type": "boolean"
     },
     "status": {
      "enum": [
       "hit",
       "miss",
       "refresh",
       "stale-fallback"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "cache_key",
     "snapshot_id",
     "fetched_at",
     "expires_at",
     "age_seconds",
     "request_performed",
     "stale",
     "error"
    ],
    "type": "object"
   },
   "instruction_authority": {
    "const": "none",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": false,
    "properties": {
     "items_per_page": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "start_index": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "total_results": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "verified": {
      "type": "boolean"
     }
    },
    "required": [
     "total_results",
     "start_index",
     "items_per_page",
     "verified"
    ],
    "type": "object"
   },
   "missing_ids": {
    "items": {
     "maxLength": 100,
     "pattern": "^(?:\\d{4}\\.\\d{4,5}|[a-z][a-z.-]*(?:\\.[A-Z]{2})?\\/\\d{7})(?:v[1-9]\\d*)?$",
     "type": "string"
    },
    "type": "array"
   },
   "papers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "abs_url": {
       "format": "uri",
       "type": "string"
      },
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "content_hash": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "content_trust": {
       "const": "untrusted-external",
       "type": "string"
      },
      "id": {
       "maxLength": 100,
       "pattern": "^(?:\\d{4}\\.\\d{4,5}|[a-z][a-z.-]*(?:\\.[A-Z]{2})?\\/\\d{7})(?:v[1-9]\\d*)?$",
       "type": "string"
      },
      "pdf_url": {
       "format": "uri",
       "type": "string"
      },
      "primary_category": {
       "type": [
        "string",
        "null"
       ]
      },
      "published_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "const": "arxiv-api",
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updated_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "version_id": {
       "anyOf": [
        {
         "maxLength": 100,
         "pattern": "^(?:\\d{4}\\.\\d{4,5}|[a-z][a-z.-]*(?:\\.[A-Z]{2})?\\/\\d{7})(?:v[1-9]\\d*)?$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "version_key": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "version_id",
      "version_key",
      "content_hash",
      "title",
      "summary",
      "authors",
      "categories",
      "primary_category",
      "published_at",
      "updated_at",
      "abs_url",
      "pdf_url",
      "content_trust",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "authority",
   "instruction_authority",
   "cache",
   "metadata",
   "papers",
   "missing_ids"
  ],
  "type": "object"
 },
 "title": "Look up arXiv identifiers and versions"
}
