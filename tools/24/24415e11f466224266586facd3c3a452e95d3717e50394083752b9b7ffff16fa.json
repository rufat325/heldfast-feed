{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search published Agent Readiness report cards. Each card says whether an agent can do one named job on a vendor's service through its machine interfaces: the Operate letter (A+ to F, or a dash when not yet rated) over Discover, Delegation, Pay, Job, Confirm and Sustain, where a person has to step in and how often, the Onboard level, the evidence label, freshness, and the canonical report URL. Service readiness is separate from startup-credit eligibility.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entity": {
    "description": "Current Sourcey Entity slug or immutable Entity ID.",
    "minLength": 1,
    "type": "string"
   },
   "job": {
    "description": "Exact Agent Readiness job key from the job library.",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "label": {
    "description": "Who ran the evidence: sourcey_run, vendor_run_verified, or probed.",
    "enum": [
     "sourcey_run",
     "vendor_run_verified",
     "probed"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum results to return; defaults to 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "onboard_level": {
    "description": "Exact Onboard level, 1 (no account needed) to 6 (sales-gated).",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "operate_letter": {
    "description": "Exact published Operate letter.",
    "enum": [
     "A+",
     "A",
     "B+",
     "B",
     "C+",
     "C",
     "D",
     "F"
    ],
    "type": "string"
   },
   "product": {
    "description": "Exact Agent Readiness product key.",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "query": {
    "description": "Vendor, service, API, product, or job.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_readiness",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entity": {
       "additionalProperties": false,
       "properties": {
        "category": {
         "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
         "type": "string"
        },
        "entity_id": {
         "pattern": "^ent_[0-9a-hjkmnp-tv-z]{26}$",
         "type": "string"
        },
        "identity_assurance": {
         "additionalProperties": false,
         "properties": {
          "assurance_id": {
           "pattern": "^[a-z0-9][a-z0-9_-]*$",
           "type": "string"
          },
          "coverage_policy_digest": {
           "pattern": "^sha256:[a-f0-9]{64}$",
           "type": "string"
          },
          "event_id": {
           "pattern": "^sha256:[a-f0-9]{64}$",
           "type": "string"
          },
          "identity_epoch_digest": {
           "pattern": "^sha256:[a-f0-9]{64}$",
           "type": "string"
          },
          "method_policy_digest": {
           "pattern": "^sha256:[a-f0-9]{64}$",
           "type": "string"
          },
          "receipt_digest": {
           "pattern": "^sha256:[a-f0-9]{64}$",
           "type": "string"
          },
          "status": {
           "const": "verified",
           "type": "string"
          },
          "verified_at": {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          }
         },
         "required": [
          "status",
          "assurance_id",
          "verified_at",
          "identity_epoch_digest",
          "method_policy_digest",
          "coverage_policy_digest",
          "event_id",
          "receipt_digest"
         ],
         "type": "object"
        },
        "name": {
         "minLength": 1,
         "type": "string"
        },
        "revision_digest": {
         "pattern": "^sha256:[a-f0-9]{64}$",
         "type": "string"
        },
        "slug": {
         "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
         "type": "string"
        }
       },
       "required": [
        "entity_id",
        "slug",
        "name",
        "category",
        "revision_digest"
       ],
       "type": "object"
      },
      "freshness": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "checked_at": {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          },
          "next_due_at": {
           "anyOf": [
            {
             "format": "date-time",
             "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "state": {
           "enum": [
            "fresh",
            "stale"
           ],
           "type": "string"
          },
          "succeeded_at": {
           "anyOf": [
            {
             "format": "date-time",
             "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "checked_at",
          "succeeded_at",
          "next_due_at",
          "state"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "profile": {
       "additionalProperties": false,
       "properties": {
        "agent_readiness_profile_id": {
         "pattern": "^arp_[0-9a-hjkmnp-tv-z]{26}$",
         "type": "string"
        },
        "canonical_url": {
         "format": "uri",
         "type": "string"
        },
        "declaration_revision_digest": {
         "pattern": "^sha256:[a-f0-9]{64}$",
         "type": "string"
        },
        "effective_from": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "entity_id": {
         "pattern": "^ent_[0-9a-hjkmnp-tv-z]{26}$",
         "type": "string"
        },
        "label": {
         "enum": [
          "sourcey_run",
          "vendor_run_verified",
          "probed"
         ],
         "type": "string"
        },
        "last_run_at": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "lifecycle": {
         "enum": [
          "active",
          "ended",
          "withdrawn"
         ],
         "type": "string"
        },
        "onboard": {
         "additionalProperties": false,
         "properties": {
          "level": {
           "anyOf": [
            {
             "maximum": 6,
             "minimum": 1,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "level"
         ],
         "type": "object"
        },
        "operate": {
         "additionalProperties": false,
         "properties": {
          "letter": {
           "anyOf": [
            {
             "enum": [
              "A+",
              "A",
              "B+",
              "B",
              "C+",
              "C",
              "D",
              "F"
             ],
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "steps": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "outcome": {
              "enum": [
               "machine",
               "approval",
               "workaround",
               "blocked",
               "not_applicable",
               "not_assessed"
              ],
              "type": "string"
             },
             "step": {
              "enum": [
               "discover",
               "delegation",
               "pay",
               "job",
               "confirm",
               "sustain"
              ],
              "type": "string"
             },
             "timing": {
              "anyOf": [
               {
                "enum": [
                 "setup",
                 "recurring"
                ],
                "type": "string"
               },
               {
                "type": "null"
               }
              ]
             }
            },
            "required": [
             "step",
             "outcome",
             "timing"
            ],
            "type": "object"
           },
           "maxItems": 6,
           "minItems": 6,
           "type": "array"
          }
         },
         "required": [
          "letter",
          "steps"
         ],
         "type": "object"
        },
        "policy_as_of": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "policy_digest": {
         "pattern": "^sha256:[a-f0-9]{64}$",
         "type": "string"
        },
        "policy_version": {
         "minLength": 1,
         "type": "string"
        },
        "projection_digest": {
         "pattern": "^sha256:[a-f0-9]{64}$",
         "type": "string"
        },
        "provenance": {
         "additionalProperties": false,
         "properties": {
          "basis_event_ids": {
           "items": {
            "pattern": "^sha256:[a-f0-9]{64}$",
            "type": "string"
           },
           "type": "array"
          },
          "dispute": {
           "enum": [
            "none",
            "open",
            "resolved"
           ],
           "type": "string"
          },
          "vendor_attestation": {
           "oneOf": [
            {
             "additionalProperties": false,
             "properties": {
              "status": {
               "const": "none",
               "type": "string"
              }
             },
             "required": [
              "status"
             ],
             "type": "object"
            },
            {
             "additionalProperties": false,
             "properties": {
              "attested_at": {
               "format": "date-time",
               "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
               "type": "string"
              },
              "event_id": {
               "pattern": "^sha256:[a-f0-9]{64}$",
               "type": "string"
              },
              "status": {
               "const": "current",
               "type": "string"
              }
             },
             "required": [
              "status",
              "event_id",
              "attested_at"
             ],
             "type": "object"
            }
           ]
          }
         },
         "required": [
          "dispute",
          "vendor_attestation",
          "basis_event_ids"
         ],
         "type": "object"
        },
        "publication": {
         "additionalProperties": false,
         "properties": {
          "reasons": {
           "items": {
            "enum": [
             "lifecycle_not_active",
             "open_dispute"
            ],
            "type": "string"
           },
           "type": "array"
          },
          "visibility": {
           "enum": [
            "discoverable",
            "resolvable_only",
            "private"
           ],
           "type": "string"
          }
         },
         "required": [
          "visibility",
          "reasons"
         ],
         "type": "object"
        },
        "revision_digest": {
         "pattern": "^sha256:[a-f0-9]{64}$",
         "type": "string"
        },
        "scope": {
         "additionalProperties": false,
         "properties": {
          "job": {
           "additionalProperties": false,
           "properties": {
            "key": {
             "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
             "type": "string"
            },
            "name": {
             "maxLength": 160,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "key",
            "name"
           ],
           "type": "object"
          },
          "product": {
           "additionalProperties": false,
           "properties": {
            "key": {
             "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
             "type": "string"
            },
            "name": {
             "maxLength": 160,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "key",
            "name"
           ],
           "type": "object"
          }
         },
         "required": [
          "product",
          "job"
         ],
         "type": "object"
        }
       },
       "required": [
        "agent_readiness_profile_id",
        "entity_id",
        "scope",
        "declaration_revision_digest",
        "lifecycle",
        "effective_from",
        "revision_digest",
        "policy_digest",
        "policy_version",
        "policy_as_of",
        "label",
        "last_run_at",
        "publication",
        "provenance",
        "canonical_url",
        "projection_digest",
        "operate",
        "onboard"
       ],
       "type": "object"
      }
     },
     "required": [
      "entity",
      "profile",
      "freshness"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "release_id": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "release_id",
   "total",
   "truncated",
   "data"
  ],
  "type": "object"
 },
 "title": "Search Agent Readiness"
}
