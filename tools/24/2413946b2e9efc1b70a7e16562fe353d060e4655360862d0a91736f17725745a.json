{
 "description": "List tags",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exclude": {
    "description": "Exclude these term IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "hide_empty": {
    "default": false,
    "description": "Hide terms with no posts",
    "type": "boolean"
   },
   "include": {
    "description": "Limit to these term IDs",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "offset": {
    "description": "Skip this many tags (overrides page)",
    "type": "integer"
   },
   "order": {
    "description": "Sort direction (default asc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "orderby": {
    "description": "Sort field (default name)",
    "enum": [
     "id",
     "include",
     "name",
     "slug",
     "include_slugs",
     "term_group",
     "description",
     "count"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "type": "integer"
   },
   "per_page": {
    "default": 100,
    "description": "Terms per page (max 100)",
    "type": "integer"
   },
   "post": {
    "description": "Limit to terms assigned to this post ID",
    "type": "integer"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Limit to these slugs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_tags"
}
