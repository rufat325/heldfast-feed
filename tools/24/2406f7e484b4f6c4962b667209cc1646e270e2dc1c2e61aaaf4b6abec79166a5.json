{
 "description": "Create a route (source is exactly one of form_id / stream_id)\nA route ties one source (a form or a stream) to one destination, with a mode (instant or digest) and optional filter/transform/quality rules.",
 "inputSchema": {
  "properties": {
   "destination_id": {
    "type": "string"
   },
   "enabled": {
    "default": true,
    "type": "boolean"
   },
   "filter": {
    "type": "string"
   },
   "form_id": {
    "type": "string"
   },
   "mode": {
    "default": {
     "type": "instant"
    },
    "oneOf": [
     {
      "properties": {
       "type": {
        "enum": [
         "instant"
        ],
        "type": "string"
       }
      },
      "required": [
       "type"
      ],
      "type": "object"
     },
     {
      "properties": {
       "cron": {
        "minLength": 1,
        "type": "string"
       },
       "timezone": {
        "minLength": 1,
        "type": "string"
       },
       "type": {
        "enum": [
         "digest"
        ],
        "type": "string"
       }
      },
      "required": [
       "type",
       "cron",
       "timezone"
      ],
      "type": "object"
     }
    ]
   },
   "quality": {
    "properties": {
     "exclude_quarantined": {
      "default": true,
      "type": "boolean"
     },
     "exclude_spam": {
      "default": true,
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "stream_id": {
    "type": "string"
   },
   "transform": {
    "type": "string"
   },
   "window": {
    "properties": {
     "from": {
      "format": "date-time",
      "type": [
       "string",
       "null"
      ]
     },
     "until": {
      "format": "date-time",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "destination_id"
  ],
  "type": "object"
 },
 "name": "routes_create"
}
