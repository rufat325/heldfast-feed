{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List your tweets with optional filtering by status. Returns paginated results.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Results per page (default 20, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Filter by status: \"scheduled\" (upcoming), \"posted\" (published), \"draft\" (unscheduled), \"failed\" (errors)",
    "enum": [
     "scheduled",
     "posted",
     "draft",
     "failed"
    ],
    "type": "string"
   },
   "x_account_id": {
    "description": "Filter by X account ID (for multi-account users)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "opentweet_list_tweets"
}
