{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set Service Tier Pricing"
 },
 "description": "Set the complete pricing and booking-policy configuration for one membership tier on a booking service.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "advanceBookingDays": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "bookingLimits": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "dailyBookingCount": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "isAllowed": {
        "type": "boolean"
       },
       "maxBookableTimeslots": {
        "anyOf": [
         {
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "weeklyBookingCount": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "weeklyHoursLimit": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "isAllowed",
       "dailyBookingCount",
       "weeklyBookingCount",
       "weeklyHoursLimit"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "discountPercent": {
    "anyOf": [
     {
      "pattern": "^\\d+(?:\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "priceOverride": {
    "anyOf": [
     {
      "pattern": "^\\d+(?:\\.\\d{1,2})?$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "serviceId": {
    "description": "Booking service ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "tierId": {
    "description": "Membership tier ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "timeSlotPricing": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": false,
       "properties": {
        "dayOfWeek": {
         "items": {
          "enum": [
           "Mon",
           "Tue",
           "Wed",
           "Thu",
           "Fri",
           "Sat",
           "Sun"
          ],
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        },
        "description": {
         "maxLength": 200,
         "type": "string"
        },
        "endTime": {
         "pattern": "^(?:(?:[01]\\d|2[0-3]):[0-5]\\d|24:00)$",
         "type": "string"
        },
        "price": {
         "minimum": 0,
         "type": "number"
        },
        "priority": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "startTime": {
         "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d$",
         "type": "string"
        }
       },
       "required": [
        "dayOfWeek",
        "startTime",
        "endTime",
        "price"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "serviceId",
   "tierId",
   "priceOverride",
   "discountPercent",
   "advanceBookingDays",
   "timeSlotPricing",
   "bookingLimits"
  ],
  "type": "object"
 },
 "name": "set_service_tier_pricing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
