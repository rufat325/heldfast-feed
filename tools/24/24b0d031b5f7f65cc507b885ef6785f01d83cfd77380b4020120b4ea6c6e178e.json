{"description":"Set up a schedule that issues invoices on its own.\n\nStarts `active`, so the first invoice is issued when the schedule next\nfalls due. The invoices it produces are ordinary documents \u2014 read them with\n`list_generated_invoices`.","inputSchema":{"$defs":{"InvoiceBankAccountInput":{"properties":{"account_name":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["Acme Corp"],"title":"Account Name"},"account_number":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["1234567890"],"title":"Account Number"},"bank_name":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["First National Bank"],"title":"Bank Name"},"iban":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["US82FNBK0000001234567890"],"title":"Iban"},"routing_number":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["021000021"],"title":"Routing Number"},"swift":{"anyOf":[{"type":"string"},{"type":"null"}],"examples":["FNBKUS33"],"title":"Swift"}},"title":"InvoiceBankAccountInput","type":"object"},"InvoiceBrandingInput":{"properties":{"accent_color":{"default":"#111827","title":"Accent Color","type":"string"},"font_family":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Font Family"},"footer_text":{"default":"Generated by InvoicePDFs","title":"Footer Text","type":"string"},"header_text":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Header Text"},"hide_invoicepdfs_branding":{"default":false,"title":"Hide Invoicepdfs Branding","type":"boolean"},"logo_file_id":{"anyOf":[{"type":"string"},{"type":"null"}],"title":"Logo File Id"},"primary_color":{"default":"#111827","title":"Primary Color","type":"string"}},"title":"InvoiceBrandingInput","type":"object"},"InvoiceCustomFieldInput":{"properties":{"label":{"examples":["PO Number"],"title":"Label","type":"string"},"value":{"examples":["PO-2026-001"],"title":"Value","type":"string"}},"required":["label","value"],"title":"InvoiceCustomFieldInput","type":"object"},"InvoiceDiscountInput":{"properties":{"reas