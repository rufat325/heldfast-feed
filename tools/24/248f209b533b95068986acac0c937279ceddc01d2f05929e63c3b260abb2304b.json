{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Synthetics API test (HTTP, SSL, TCP, DNS, etc.)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assertions": {
    "description": "Response assertions. Example: [{\"type\":\"statusCode\",\"operator\":\"is\",\"target\":200}]",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "locations": {
    "description": "Test locations. Example: [\"aws:us-east-1\", \"aws:eu-west-1\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "default": "",
    "description": "Notification message. Example: API is down @slack-alerts",
    "type": "string"
   },
   "method": {
    "default": "GET",
    "description": "HTTP method. Example: GET, POST, PUT",
    "type": "string"
   },
   "name": {
    "description": "Test name. Example: API Health Check - Production",
    "type": "string"
   },
   "status": {
    "default": "paused",
    "description": "Initial test status",
    "enum": [
     "live",
     "paused"
    ],
    "type": "string"
   },
   "subtype": {
    "default": "http",
    "description": "Test subtype. Example: http",
    "enum": [
     "http",
     "ssl",
     "tcp",
     "dns",
     "icmp",
     "udp",
     "websocket",
     "grpc",
     "multi"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Tags for the test. Example: [\"env:prod\", \"team:platform\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Test type (api)",
    "enum": [
     "api"
    ],
    "type": "string"
   },
   "url": {
    "description": "URL to test. Example: https://api.example.com/health",
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "url",
   "locations"
  ],
  "type": "object"
 },
 "name": "create-synthetics-test"
}
