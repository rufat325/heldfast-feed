{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \uc804\uc790\uc138\uae08\uacc4\uc0b0\uc11c\ub97c \ubc1c\uae09\ud569\ub2c8\ub2e4. \ub418\ub3cc\ub9b4 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ubc1c\uae09\ud558\uba74 \uacf5\uae09\ubc1b\ub294\uc790\uc5d0\uac8c \ud1b5\uc9c0\ub418\uace0 \ubd80\uac00\uac00\uce58\uc138 \uc2e0\uace0 \uc790\ub8cc\uc5d0 \ub4e4\uc5b4\uac11\ub2c8\ub2e4. \uace0\uce58\ub824\uba74 \uc218\uc815\uc138\uae08\uacc4\uc0b0\uc11c\ub97c \ubc1c\uae09\ud574\uc57c \ud558\uba70, \uc774 \uc11c\ube44\uc2a4\uc758 \uc218\uc815\ubc1c\uae09 \ub3c4\uad6c\ub294 \uc6d0\ubcf8 \uc804\uccb4\ub97c \ucde8\uc18c\ud558\ub294 \uc218\uc815\uc138\uae08\uacc4\uc0b0\uc11c(\uc0ac\uc720 04, 06)\ub9cc \ubc1c\uae09\ud569\ub2c8\ub2e4. \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ubbf8\ub9ac\ubcf4\uae30\uc5d0\ub294 \ubcf4\ub0b8 \uc8fc\uc694 \uac12\uc774 \ubcf4\uc774\uba70, \uacf5\uae09\uac00\uc561\uacfc \uc138\uc561\uc740 \uc11c\ubc84\uac00 \uacc4\uc0b0\ud558\ubbc0\ub85c \ub4e4\uc5b4 \uc788\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 5\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"bill_method":{"description":"\uccad\uad6c\ubc29\ubc95. '01'=\uc601\uc218, '02'=\uccad\uad6c.","type":"string"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"dmnr_bsno":{"description":"\uad6c\ub9e4\uc790 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638(\uc22b\uc790 10\uc790\ub9ac).","type":"string"},"etxiv_clsf_cd":{"description":"\uc804\uc790\uc138\uae08\uacc4\uc0b0\uc11c \uad6c\ubd84\ucf54\ub4dc. \uc785\ub825\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub429\ub2c8\ub2e4. \uc774 \ucf54\ub4dc\uc640 \uad00\uacc4\uc5c6\uc774 \uc138\uc561\uc740 \uacf5\uae09\uac00\uc561\uc758 10% \uc785\ub2c8\ub2e4.","type":"string"},"etxiv_knd_cd":{"description":"\uc804\uc790\uc138\uae08\uacc4\uc0b0\uc11c \uc885\ub958\ucf54\ub4dc. \uc785\ub825\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub429\ub2c8\ub2e4. \uc774 \ucf54\ub4dc\uc640 \uad00\uacc4\uc5c6\uc774 \uc138\uc561\uc740 \uacf5\uae09\uac00\uc561\uc758 10% \uc785\ub2c8\ub2e4.","type":"string"},"item_name":{"description":"\ud488\ubaa9\uba85.","type":"string"},"item_quantity":{"description":"\uc218\ub7c9.","type":"integer"},"item_unit_price":{"description":"\ub2e8\uac00(\uc6d0 \ub2e8\uc704).","type":"integer"},"splr_mpb_no":{"description":"\uacf5\uae09\uc790 \uc885\uc0ac\uc5c5\uc7a5\ubc88\ud638. \uc8fc\uc0ac\uc5c5\uc7a5\uc774\uba74 \"0\". \uae30\ubcf8 \"0\". \uc785\ub825\ud558\uc9c0 \uc54a\uc544\ub3c4 \ub429\ub2c8\ub2e4.","type":"string"},"splr_tin":{"description":"\uacf5\uae09\uc790 \uc2dd\ubcc4\uac12(tin). \ubcf4\ud1b5 \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc11c\ubc84\uac00 \uae30\uad00 \uc751\ub2f5\uacfc \ub85c\uadf8\uc778 \uc138\uc158\uc5d0\uc11c \uacf5\uae09\uc790 \uac12\uc744 \ucc44\uc6b0\uace0, \uac70\uae30\uc11c \uc5bb\uc9c0 \ubabb\ud560 \ub54c\ub9cc \uc774 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"supply_date":{"description":"\uacf5\uae09\uc77c\uc790 YYYYMMDD.","type":"string"}},"required":["dmnr_bsno","item_name","supply_date","bill_method","item_quantity","item_unit_price"],"type":"object"},"name":"hometax__etax__invoice__issue","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\uc804\uc790\uc138\uae08\uacc4\uc0b0\uc11c \ubc1c\ud589"}
