{
 "_meta": {
  "ui": {
   "resourceUri": "master-detail://display",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "description": "Display a master-detail view with a list of items on the left/top and details on the right/bottom. The detail panel can show tables, images, lists, or custom text/HTML content. Perfect for browsing collections, comparing items, or navigating hierarchical data.",
 "inputSchema": {
  "properties": {
   "defaultSelectedId": {
    "description": "ID of item to select by default",
    "type": "string"
   },
   "detailContents": {
    "additionalProperties": {
     "oneOf": [
      {
       "properties": {
        "data": {
         "description": "Table data following display_table schema",
         "type": "object"
        },
        "type": {
         "enum": [
          "table"
         ],
         "type": "string"
        }
       },
       "required": [
        "type",
        "data"
       ],
       "type": "object"
      },
      {
       "properties": {
        "data": {
         "description": "Image data following display_image schema",
         "type": "object"
        },
        "type": {
         "enum": [
          "image"
         ],
         "type": "string"
        }
       },
       "required": [
        "type",
        "data"
       ],
       "type": "object"
      },
      {
       "properties": {
        "data": {
         "description": "List data following display_list schema",
         "type": "object"
        },
        "type": {
         "enum": [
          "list"
         ],
         "type": "string"
        }
       },
       "required": [
        "type",
        "data"
       ],
       "type": "object"
      },
      {
       "properties": {
        "data": {
         "properties": {
          "content": {
           "description": "Text or HTML content to display",
           "type": "string"
          },
          "isHtml": {
           "default": false,
           "description": "Whether content is HTML",
           "type": "boolean"
          }
         },
         "required": [
          "content"
         ],
         "type": "object"
        },
        "type": {
         "enum": [
          "text"
         ],
         "type": "string"
        }
       },
       "required": [
        "type",
        "data"
       ],
       "type": "object"
      }
     ]
    },
    "description": "Map of item IDs to their detail content. Each key should match a masterItems ID.",
    "type": "object"
   },
   "masterItems": {
    "description": "Array of items to display in the master list",
    "items": {
     "properties": {
      "description": {
       "description": "Optional description shown below the label",
       "type": "string"
      },
      "icon": {
       "description": "Optional icon or emoji to display",
       "type": "string"
      },
      "id": {
       "description": "Unique identifier for the item",
       "type": "string"
      },
      "label": {
       "description": "Display label for the item",
       "type": "string"
      },
      "metadata": {
       "description": "Additional metadata for the item",
       "type": "object"
      }
     },
     "required": [
      "id",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "masterWidth": {
    "default": 300,
    "description": "Width of master panel in pixels (default: 300)",
    "type": "number"
   },
   "orientation": {
    "default": "horizontal",
    "description": "Layout orientation: horizontal (side-by-side) or vertical (stacked)",
    "enum": [
     "horizontal",
     "vertical"
    ],
    "type": "string"
   },
   "title": {
    "description": "Optional title for the master-detail view",
    "type": "string"
   }
  },
  "required": [
   "masterItems",
   "detailContents"
  ],
  "type": "object"
 },
 "name": "display_master_detail",
 "title": "Display Master Detail"
}
