{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Clear specific task instances in an Airflow DAG run (re-run them); supports include_upstream / include_downstream. Write-gated by AIRFLOW_ALLOW_WRITE.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dagId": {
    "type": "string"
   },
   "dagRunId": {
    "type": "string"
   },
   "includeDownstream": {
    "default": false,
    "type": "boolean"
   },
   "includeUpstream": {
    "default": false,
    "type": "boolean"
   },
   "taskIds": {
    "description": "List of task_ids to clear (and re-run)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "dagId",
   "dagRunId",
   "taskIds"
  ],
  "type": "object"
 },
 "name": "airflow-clear-task"
}
