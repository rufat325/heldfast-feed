{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Submit your locally computed proof once; returns a private aa_ key once. Do not blindly repeat a lost verification.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "challenge_id": {
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "solution": {
    "maxLength": 256,
    "pattern": "^[0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "challenge_id",
   "solution"
  ],
  "type": "object"
 },
 "name": "verify_agent"
}
