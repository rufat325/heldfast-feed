{
 "description": "Approve or reject a moderated asset pending manual review.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "The moderation action to perform",
    "enum": [
     "approve",
     "reject"
    ],
    "type": "string"
   },
   "id": {
    "description": "The unique ID of the asset",
    "type": "string"
   }
  },
  "required": [
   "id",
   "action"
  ],
  "type": "object"
 },
 "name": "moderate_asset"
}
