{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "For up to 10 named outfitters, tell whether the requested dates fall in season and which packages fit the party. Returns a verdict per outfitter, never raw inventory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "maxLength": 200,
    "type": "string"
   },
   "arrival": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "departure": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "locale": {
    "enum": [
     "fr",
     "en"
    ],
    "type": "string"
   },
   "outfitter_ids": {
    "description": "Outfitter ids obtained from search_outfitters.",
    "items": {
     "maxLength": 160,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "party_size": {
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "outfitter_ids",
   "arrival",
   "departure"
  ],
  "type": "object"
 },
 "name": "check_availability",
 "title": "Check availability"
}
