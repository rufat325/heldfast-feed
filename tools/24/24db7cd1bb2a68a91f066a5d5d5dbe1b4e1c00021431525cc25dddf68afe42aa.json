{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send email"
 },
 "description": "Send a transactional email from a verified MisarMail account. `from.email` must match an email account you have already verified \u2014 use list_domains to check which sender domains are available. Returns the message ID and queue status.",
 "inputSchema": {
  "properties": {
   "alias_id": {
    "description": "Route via a specific alias SMTP pool",
    "type": "string"
   },
   "bcc": {
    "description": "BCC recipients (max 50, hidden from other recipients)",
    "items": {
     "properties": {
      "email": {
       "description": "Recipient email address",
       "type": "string"
      },
      "name": {
       "description": "Recipient display name",
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cc": {
    "description": "CC recipients (max 50)",
    "items": {
     "properties": {
      "email": {
       "description": "Recipient email address",
       "type": "string"
      },
      "name": {
       "description": "Recipient display name",
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Sender address (must match a verified MisarMail account)",
    "properties": {
     "email": {
      "description": "Sender email address",
      "type": "string"
     },
     "name": {
      "description": "Sender display name shown to recipients",
      "type": "string"
     }
    },
    "required": [
     "email"
    ],
    "type": "object"
   },
   "html": {
    "description": "HTML body (max 500KB, recommended)",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Unique key to prevent duplicate sends (max 128 chars)",
    "type": "string"
   },
   "metadata": {
    "description": "Custom metadata key-value pairs (max 20 pairs)",
    "type": "object"
   },
   "reply_to": {
    "description": "Reply-to address",
    "properties": {
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "subject": {
    "description": "Email subject (max 998 chars)",
    "type": "string"
   },
   "tags": {
    "description": "Tags for tracking (max 10, each max 64 chars)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "text": {
    "description": "Plain text body (max 500KB, fallback for HTML)",
    "type": "string"
   },
   "to": {
    "description": "Recipient list (1\u2013100 addresses)",
    "items": {
     "properties": {
      "email": {
       "description": "Recipient email address",
       "type": "string"
      },
      "name": {
       "description": "Recipient display name",
       "type": "string"
      }
     },
     "required": [
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "from",
   "to",
   "subject"
  ],
  "type": "object"
 },
 "name": "send_email"
}
