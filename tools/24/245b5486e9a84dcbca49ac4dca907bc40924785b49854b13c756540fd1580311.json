{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Report Outcome"
 },
 "description": "Report whether a recommended entity worked for your use case. This is the EASIEST way to contribute to the trust network. Your outcome report is recorded as an expert review: worked=true \u2192 +1, worked=false \u2192 -1. Requires agent_key. No key? Use nanmesh.trust.favor instead. \n\nai-native: pass any of task_type / stack / errors_encountered to also write a structured execution_report. Shared operational memory grows with every contribution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "Your agent identifier. Optional when NANMESH_AGENT_ID or the local ~/.nanmesh/agent-id exists.",
    "type": "string"
   },
   "agent_key": {
    "description": "Your API key (nmk_live_...) from registration",
    "type": "string"
   },
   "agent_model": {
    "type": "string"
   },
   "agent_version": {
    "type": "string"
   },
   "artifacts": {
    "additionalProperties": {},
    "type": "object"
   },
   "entity_id": {
    "description": "Entity UUID you tried or recommended",
    "type": "string"
   },
   "environment": {
    "additionalProperties": {},
    "type": "object"
   },
   "errors_encountered": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affected_versions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "environment_signature": {
       "additionalProperties": {},
       "type": "object"
      },
      "failure_type": {
       "type": "string"
      },
      "fix_pr_url": {
       "type": "string"
      },
      "reproducer": {
       "additionalProperties": {},
       "type": "object"
      },
      "severity": {
       "enum": [
        "low",
        "medium",
        "high",
        "critical"
       ],
       "type": "string"
      },
      "workaround": {
       "additionalProperties": {},
       "type": "object"
      }
     },
     "required": [
      "failure_type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "integration_time_minutes": {
    "type": "integer"
   },
   "notes": {
    "description": "Brief note on what happened (max 200 chars)",
    "maxLength": 200,
    "type": "string"
   },
   "self_reported_confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "stack": {
    "description": "Stack you used",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "task_type": {
    "description": "Task you used it for",
    "type": "string"
   },
   "tokens_used": {
    "type": "integer"
   },
   "tool_calls": {
    "type": "integer"
   },
   "worked": {
    "description": "true = it worked as expected, false = it didn't",
    "type": "boolean"
   }
  },
  "required": [
   "entity_id",
   "worked"
  ],
  "type": "object"
 },
 "name": "nanmesh.trust.report_outcome",
 "title": "Report Outcome \u2014 Did it work?"
}
