{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add a new lead to your pipeline. Warns if another visible lead already has the same phone number. Two-step: draft, then confirm.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "business_name": {
    "minLength": 1,
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "confirm": {
    "default": false,
    "description": "Leave false to get a draft of the change. Only set true after the user has seen the draft and approved it.",
    "type": "boolean"
   },
   "contact_name": {
    "type": "string"
   },
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "industry": {
    "type": "string"
   },
   "notes": {
    "type": "string"
   },
   "phone": {
    "minLength": 7,
    "type": "string"
   },
   "state": {
    "type": "string"
   }
  },
  "required": [
   "business_name",
   "phone"
  ],
  "type": "object"
 },
 "name": "add_lead",
 "title": "Add a lead"
}
