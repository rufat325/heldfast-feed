{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search entries"
 },
 "description": "Search the entries as the site search does: words match titles, subtitles and descriptions; a Wikidata QID finds the entries linked to it; a VHID finds that entry and the entries that link to it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_entries",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "limit": {
    "description": "The page size used: the `limit` asked for, clamped to the endpoint\u2019s range.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "next_offset": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "The `offset` of the next page, or null when this is the last one. Follow it rather than computing it."
   },
   "offset": {
    "description": "The offset used: the `offset` asked for, clamped to 0\u201310,000.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "The query as it was read: trimmed and cut to 100 characters.",
    "type": "string"
   },
   "results": {
    "description": "Best match first.",
    "items": {
     "additionalProperties": {},
     "description": "One entry that matched.",
     "properties": {
      "highlighted": {
       "description": "`snippet` is a real excerpt (true), or there is none (false).",
       "type": "boolean"
      },
      "short": {
       "description": "The entry\u2019s short name (`/<short>`), if it has one.",
       "type": [
        "string",
        "null"
       ]
      },
      "snippet": {
       "description": "Plain text from the description around the words that matched, or null when the match was not in it.",
       "type": [
        "string",
        "null"
       ]
      },
      "subtitle": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "The entry\u2019s page.",
       "type": "string"
      },
      "verified": {
       "type": "boolean"
      },
      "vhid": {
       "description": "The entry\u2019s VHID: 11 digits, permanent.",
       "pattern": "^\\d{11}$",
       "type": "string"
      }
     },
     "required": [
      "vhid",
      "short",
      "title",
      "subtitle",
      "verified",
      "snippet",
      "highlighted",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "How many entries matched in all.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "query",
   "total",
   "results"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search entries"
}
