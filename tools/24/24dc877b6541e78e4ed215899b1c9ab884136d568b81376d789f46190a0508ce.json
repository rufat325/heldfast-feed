{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "DC-DC converter design (CCM): duty cycle, minimum inductance, minimum output capacitance, input current, and peak switch current for buck, boost, or inverting buck-boost.\n\nArgs: topology ('buck'|'boost'|'buckboost'), vin, vout, iout_a, freq_khz (default 100), ripple_current_pct (of Iout, default 30), ripple_voltage_mv (default 50).\nReturns (structured): { duty_percent, l_min_uh, c_min_uf, iin_a, i_peak_a }.\nExample: buck 12->5 V, 1 A, 100 kHz -> D=41.7%, L\u226597.2 \u00b5H, C\u22657.5 \u00b5F. Snap L/C with embedcalc_eseries_nearest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "freq_khz": {
    "default": 100,
    "description": "Switching frequency kHz",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "iout_a": {
    "description": "Output current A",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "ripple_current_pct": {
    "default": 30,
    "description": "Inductor ripple current as % of Iout",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "number"
   },
   "ripple_voltage_mv": {
    "default": 50,
    "description": "Allowed output ripple voltage mV",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "topology": {
    "description": "Converter topology (buckboost = inverting)",
    "enum": [
     "buck",
     "boost",
     "buckboost"
    ],
    "type": "string"
   },
   "vin": {
    "description": "Input voltage V",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "vout": {
    "description": "Output voltage V (magnitude for inverting)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "topology",
   "vin",
   "vout",
   "iout_a"
  ],
  "type": "object"
 },
 "name": "embedcalc_dcdc_converter",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "c_min_uf": {
    "type": "number"
   },
   "duty_percent": {
    "type": "number"
   },
   "i_peak_a": {
    "type": "number"
   },
   "iin_a": {
    "type": "number"
   },
   "l_min_uh": {
    "type": "number"
   }
  },
  "required": [
   "duty_percent",
   "l_min_uh",
   "c_min_uf",
   "iin_a",
   "i_peak_a"
  ],
  "type": "object"
 },
 "title": "Buck / Boost / Buck-Boost Converter Calculator"
}
