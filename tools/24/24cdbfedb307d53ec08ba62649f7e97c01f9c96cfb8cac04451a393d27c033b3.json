{"_meta":{"xdata.kr/credential":{"providers":[],"register_url":null,"required":false,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\uacf5\uacf5\ub370\uc774\ud130\ud3ec\ud138\uc5d0 \uac1c\ubc29\ub41c KISCON \uac74\uc124\uc5c5\uccb4 \uacf5\uc2dc(data.go.kr 15061362)\ub97c \uc870\ud68c\ud569\ub2c8\ub2e4. \uc6d0\ucc9c\uc740 \uae30\uac04(sDate, eDate)\uc73c\ub85c\ub9cc \uc870\ud68c\ud560 \uc218 \uc788\uc5b4, \uc11c\ubc84\uac00 \uadf8 \uae30\uac04\uc758 \uacf5\uc2dc\ub97c \ud6d1\uc5b4 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638(bizno)\uac00 \uac19\uc740 \ud589\uc744 matches \uc5d0 \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uacf5\uc2dc\uc5d0 \ub4f1\ub85d\ubc88\ud638\uac00 \uc5c6\ub294 \ud589\uc740 \uc5c5\uccb4\uba85(corp_name)\uc744 \ub123\uc5c8\uc744 \ub54c \uc774\ub984\uc774 \uac19\uc740 \uac83\uc744 fallback_candidates \uc5d0 \ub2f4\uc2b5\ub2c8\ub2e4. matches \uac00 \ube44\uc5b4 \uc788\uc73c\uba74 \uadf8 \uae30\uac04\uc5d0\uc11c \ucc3e\uc9c0 \ubabb\ud55c \uac83\uc774\uace0, \ucc98\ubd84\uc774 \uc5c6\ub2e4\ub294 \ud655\uc778\uc11c\ub294 \uc544\ub2d9\ub2c8\ub2e4. \ubcc4\ub3c4 \uc5f0\ub3d9 \uc5c6\uc774 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"bizno":{"description":"\uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638 10\uc790\ub9ac. \uc870\ud68c \uae30\uac04\uc758 \uacf5\uc2dc \uac00\uc6b4\ub370 \uc774 \ubc88\ud638\uc758 \uc5c5\uccb4 \uac83\ub9cc \ub3cc\ub824\uc90d\ub2c8\ub2e4.","maxLength":10,"minLength":10,"type":"string"},"corp_name":{"description":"\uc5c5\uccb4\uba85(\uc120\ud0dd) - \uacf5\uc2dc\uc5d0 \ub4f1\ub85d\ubc88\ud638\uac00 \uc5c6\ub294 \uc5c5\uccb4\ub294 \uc774 \uc774\ub984\uc73c\ub85c \ucc3e\uc2b5\ub2c8\ub2e4.","type":"string"},"eDate":{"description":"\uacf5\uc2dc \uae30\uac04 \uc885\ub8cc\uc77c YYYYMMDD. \uaf2d \ubcf4\ub0b4\uc57c \ud569\ub2c8\ub2e4.","type":"string"},"maxPages":{"description":"\ud6d1\uc744 \ucd5c\ub300 \ud398\uc774\uc9c0 \uc218(\uae30\ubcf8 5, \uc0c1\ud55c 20).","maximum":20,"minimum":1,"type":"integer"},"ncrAreaDetailName":{"description":"\ub4f1\ub85d \uc2dc\uad70\uad6c \ud544\ud130(\uc120\ud0dd).","type":"string"},"ncrAreaName":{"description":"\ub4f1\ub85d \uc2dc\ub3c4 \ud544\ud130(\uc120\ud0dd).","type":"string"},"numOfRows":{"description":"\uae30\uad00 \ud398\uc774\uc9c0\ub2f9 \ud589 \uc218(\uae30\ubcf8 100, \ucd5c\ub300 100).","maximum":100,"minimum":1,"type":"integer"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19