{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate total shipment volume (CBM / cubic metres and CFT / cubic feet), total weight, and how that cargo fits into standard shipping containers (20ft Standard, 40ft Standard, 40ft High Cube). Use this whenever someone asks how much space a shipment takes, how many cubic metres or CBM their boxes / pallets / cartons add up to, whether cargo will fit in a container, what container size they need, or how full a container will be. Accepts a list of items with length, width, height, weight and quantity in metric (cm, kg) or imperial (in, lb) units; returns total CBM, CFT, total weight, and per-container fill percentage with an overload flag.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "The cargo line items to total up.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "height": {
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "type": "number"
      },
      "length": {
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "type": "number"
      },
      "name": {
       "description": "Optional label for the item.",
       "maxLength": 100,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "type": "integer"
      },
      "weight": {
       "default": 0,
       "description": "Per-unit weight. Optional (defaults to 0).",
       "maximum": 1000000,
       "minimum": 0,
       "type": "number"
      },
      "width": {
       "exclusiveMinimum": 0,
       "maximum": 100000,
       "type": "number"
      }
     },
     "required": [
      "length",
      "width",
      "height",
      "quantity"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "unitSystem": {
    "default": "metric",
    "description": "Units for the item dimensions and weight. 'metric' = centimetres and kilograms; 'imperial' = inches and pounds.",
    "enum": [
     "metric",
     "imperial"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "calculate_cbm",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "calculatorUrl": {
    "type": "string"
   },
   "containers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "overloaded": {
       "type": "boolean"
      },
      "volumePct": {
       "type": "number"
      },
      "weightPct": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "volumePct",
      "weightPct",
      "overloaded"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalCbm": {
    "type": "number"
   },
   "totalCft": {
    "type": "number"
   },
   "totalWeightKg": {
    "type": "number"
   },
   "totalWeightLbs": {
    "type": "number"
   }
  },
  "required": [
   "totalCbm",
   "totalCft",
   "totalWeightKg",
   "totalWeightLbs",
   "containers",
   "calculatorUrl"
  ],
  "type": "object"
 },
 "title": "Calculate CBM & Container Fit"
}
