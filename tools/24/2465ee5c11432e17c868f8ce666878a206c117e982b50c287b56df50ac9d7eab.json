{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List agent versions"
 },
 "description": "List an agent's saved versions, newest first. Includes manual (named) versions, automatic versions, and system backups taken before a restore.\n(Tags: Agents)",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "The ID of the agent.",
    "type": "number"
   },
   "kind": {
    "description": "Filter versions by kind.",
    "enum": [
     "manual",
     "auto",
     "system"
    ],
    "type": "string"
   },
   "pageno": {
    "default": 1,
    "description": "Page number for pagination.",
    "minimum": 1,
    "type": "integer"
   },
   "pagesize": {
    "default": 30,
    "description": "Number of items per page (max 150).",
    "maximum": 150,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Filter versions whose name matches this substring (case-insensitive).",
    "type": "string"
   }
  },
  "required": [
   "agent_id"
  ],
  "type": "object"
 },
 "name": "listAgentVersions"
}
