{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Schedule a recurring or one-shot prompt using a cron expression.",
 "inputSchema": {
  "properties": {
   "cron": {
    "description": "5-field cron expression (e.g., \"*/5 * * * *\").",
    "type": "string"
   },
   "durable": {
    "description": "True = persisted, false = session-only (default).",
    "type": "boolean"
   },
   "prompt": {
    "description": "The prompt/command to run at each fire time.",
    "type": "string"
   },
   "recurring": {
    "description": "True = repeating (default), false = one-shot.",
    "type": "boolean"
   }
  },
  "required": [
   "cron",
   "prompt"
  ],
  "type": "object"
 },
 "name": "cron_create"
}
