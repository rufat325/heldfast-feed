ary":{"items":{"type":"string"},"type":"array"},"dinners":{"items":{"additionalProperties":false,"properties":{"appUrl":{"type":"string"},"candidates":{"items":{"additionalProperties":false,"properties":{"appUrl":{"type":"string"},"fibreEstimate":{"$ref":"#/properties/dinners/items/properties/fibreEstimate"},"imageUrl":{"type":["string","null"]},"reason":{"type":"string"},"recipeId":{"type":"string"},"title":{"type":"string"},"totalTimeMins":{"type":["number","null"]}},"required":["recipeId","title","reason","totalTimeMins","imageUrl","appUrl"],"type":"object"},"maxItems":5,"type":"array"},"displayLabel":{"type":"string"},"fibreEstimate":{"additionalProperties":false,"properties":{"coveragePercent":{"type":["number","null"]},"grams":{"type":["number","null"]},"source":{"type":["string","null"]},"status":{"enum":["estimated","unknown"],"type":"string"}},"required":["grams","coveragePercent","source","status"],"type":"object"},"imageUrl":{"type":["string","null"]},"locked":{"type":"boolean"},"options":{"items":{"$ref":"#/properties/dinners/items/properties/candidates/items"},"maxItems":4,"type":"array"},"previouslyShownRecipeIds":{"items":{"type":"string"},"type":"array"},"priority":{"enum":["balanced","healthy","speedy","comfort"],"type":"string"},"reason":{"type":"string"},"recipeId":{"type":["string","null"]},"repeatsAllowed":{"type":"boolean"},"requirement":{"$ref":"#/properties/slotIssues/items/properties/requirement"},"selectedRecipeId":{"type":["string","null"]},"servings":{"type":"number"},"slot":{"type":"string"},"slotId":{"type":"string"},"title":{"type":"string"},"totalTimeMins":{"type":["number","null"]}},"required":["slot","recipeId","title","reason","totalTimeMins","imageUrl","appUrl"],"type":"object"},"type":"array"},"diversity":{"anyOf":[{"additionalProperties":false,"properties":{"dimensions":{"additionalProperties":false,"properties":{"fibre":{"type":"number"},"plants":{"type":"number"},"protein":{"type":"number"}},"required":["protein","fibre","plan