{"_meta":{"securitySchemes":[{"type":"noauth"},{"scopes":["verity.read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Verify a signed print locally with ECDSA P-256/SHA-256. Canonical bytes are pulse-index-v1\\n<symbol>\\n<priceText or String(price)>\\n<at>\\n<grade>. The public key ring is read from /api/index/v1/pubkey, cached for five minutes and refreshed at most once per 30 seconds on a failed check. A supplied kid selects only that exact key; old prints without kid are tried against the bounded published ring. valid=true authenticates only the canonical price fields, not kid, sig, quality, cadence, timestamps outside at, or other metadata. When the print carries a v2 block (pulse-index-v2), it is verified too: v2.valid=true means the signature over v2.canonical is valid AND every signed line (sources, tier, confidence, dispersionBps, interval, cadence, engine, price and the rest) matches the supplied fields; v2.signedFields are the signed values and v2.mismatches names any field that differs. recordValid=true and verificationScope=full-record require BOTH price and complete v2 record verification. metadataSigned equals recordValid. Require recordValid before trusting quality fields. A v1-only print has scope price-only, never verified metadata. Neither signature proves freshness or settlement suitability; indicative data must not be used for settlement. An invalid signature can mean an altered print or a key no longer published; it does not by itself prove tampering.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"assetId":{"anyOf":[{"maxLength":160,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$","type":"string"},{"type":"null"}]},"at":{"description":"Timestamp from the print, unchanged","maxLength":40,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$","type":"string"},"cadence":{"anyOf":[{"additionalProperties":false,"properties":{"band":{"anyOf":[{"maxLength":40,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$","type":"string"},{"type":"null"}]},"calculatedAgeMs":{"anyOf":[{"type":"number"},{"type":"null"}]},"newestSourceAgeMs":{"anyOf":[{"type":"number"},{"type":"null"}]},"oldestSourceAgeMs":{"anyOf":[{"type":"number"},{"type":"null"}]},"p50UpdateMs":{"anyOf":[{"type":"number"},{"type":"null"}]},"p95UpdateMs":{"anyOf":[{"type":"number"},{"type":"null"}]}},"type":"object"},{"type":"null"}]},"closeDay":{"anyOf":[{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}]},"confidence":{"anyOf":[{"type":"number"},{"type":"null"}]},"dispersionBps":{"anyOf":[{"type":"number"},{"type":"null"}]},"engine":{"anyOf":[{"maxLength":64,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$","type":"string"},{"type":"null"}]},"grade":{"maxLength":20,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$","type":"string"},"interval":{"anyOf":[{"additionalProperties":false,"properties":{"lower":{"anyOf":[{"type":"number"},{"type":"null"}]},"upper":{"anyOf":[{"type":"number"},{"type":"null"}]}},"required":["lower","upper"],"type":"object"},{"type":"null"}]},"kid":{"description":"Signing key identifier, when provided by the API","pattern":"^[A-Za-z0-9._:-]{1,64}$","type":"string"},"kind":{"const":"daily-close","type":"string"},"price":{"anyOf":[{"maxLength":100,"minLength":1,"pattern":"^[+-]?(?:\\d+(?:\\.\\d*)?|\\.\\d+)(?:[eE][+-]?\\d+)?$","type":"string"},{"type":"number"}]},"priceText":{"$ref":"#/properties/price/anyOf/0","description":"Exact signed price text, when provided by the API; preserve unchanged"},"sig":{"const":"pulse-index-v1","type":"string"},"signature":{"description":"ECDSA P-256 signature in base64","maxLength":88,"minLength":88,"pattern":"^[A-Za-z0-9+/]{86}==$","type":"string"},"sources":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}]},"symbol":{"description":"Crypto ticker symbol, e.g. BTC, ETH, SOL","maxLength":20,"minLength":1,"pattern":"^[A-Za-z0-9]+$","type":"string"},"tier":{"anyOf":[{"maxLength":20,"minLength":1,"pattern":"^[^\\x00-\\x1f\\x7f\\u0085\\u2028\\u2029]+$","type":"string"},{"type":"null"}]},"v2":{"additionalProperties":false,"description":"The v2 block from the print, unchanged: it signs the whole record, quality fields included","properties":{"canonical":{"description":"The exact signed string from the print, unchanged","maxLength":8192,"minLength":1,"type":"string"},"kid":{"$ref":"#/properties/kid"},"sig":{"const":"pulse-index-v2","type":"string"},"signature":{"maxLength":88,"minLength":88,"pattern":"^[A-Za-z0-9+/]{86}==$","type":"string"}},"required":["sig","canonical","signature","kid"],"type":"object"}},"required":["symbol","price","at","grade","signature"],"type":"object"},"name":"verify_print","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"checked":{"maxLength":512,"type":"string"},"error":{"additionalProperties":false,"properties":{"accountUrl":{"const":"https://thepulse.markets/developers/access","type":"string"},"capacityAction":{"enum":["review_plans","contact_support"],"type":"string"},"code":{"pattern":"^[A-Z][A-Z0-9_]{0,79}$","type":"string"},"nextAction":{"enum":["wait","review_access","check_limits","reconnect","check_input","choose_another_symbol","report_issue"],"type":"string"},"resetAt":{"pattern":"^\\d{4}-(0[1-9]|1[0-2])-01T00:00:00\\.000Z$","type":"string"},"retryAfterSeconds":{"maximum":86400,"minimum":1,"type":"integer"},"retryable":{"type":"boolean"},"upgradeUrl":{"maxLength":160,"pattern":"^https:\\/\\/thepulse\\.markets\\/developers(?:\\?ref=[a-z0-9][a-z0-9-]{0,39})?#\\/(?:portal\\/pricing|buy\\/plan\\/(?:basic|builder|commercial)\\/(?:month|year)|buy\\/pack\\/(?:10|50|200)|buy\\/stream-addon)$","type":"string"}},"required":["code","nextAction"],"type":"object"},"keySource":{"maxLength":256,"type":"string"},"metadataSigned":{"type":"boolean"},"recordValid":{"description":"Both signatures and every required v2 field verified. Does not prove freshness or settlement suitability.","type":"boolean"},"requestId":{"description":"Identifier for this MCP call; not a signed price field.","format":"uuid","type":"string"},"v2":{"anyOf":[{"additionalProperties":false,"properties":{"fieldsMatch":{"type":"boolean"},"mismatches":{"items":{"maxLength":80,"type":"string"},"maxItems":18,"type":"array"},"signatureValid":{"type":"boolean"},"signedFields":{"anyOf":[{"additionalProperties":{"anyOf":[{"type":"string"},{"type":"number"},{"type":"boolean"},{"type":"null"}]},"type":"object"},{"type":"null"}]},"valid":{"type":"boolean"},"verifiedWithKid":{"anyOf":[{"$ref":"#/properties/verifiedWithKid/anyOf/0"},{"type":"null"}]}},"required":["valid","signatureValid","fieldsMatch","mismatches","signedFields","verifiedWithKid"],"type":"object"},{"type":"null"}]},"valid":{"description":"Legacy price-only signature check. Use recordValid for quality metadata.","type":"boolean"},"verificationScope":{"enum":["full-record","price-only","invalid"],"type":"string"},"verifiedWithKid":{"anyOf":[{"pattern":"^[A-Za-z0-9._:-]{1,64}$","type":"string"},{"type":"null"}]}},"required":["requestId"],"type":"object"},"securitySchemes":[{"type":"noauth"},{"scopes":["verity.read"],"type":"oauth2"}],"title":"Verify a Signed Print"}
