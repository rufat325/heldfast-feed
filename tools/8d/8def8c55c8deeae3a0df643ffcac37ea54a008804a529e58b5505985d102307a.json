{
 "description": "Analyze feed data-delivery reliability over a date range: success rate, hours with data, coverage %, and average snapshots per day per provider+symbol. Use this to assess how completely a feed delivered data over time \u2014 distinct from get_feed_health (point-in-time status) and get_latency (speed).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "provider": {
    "description": "Filter by oracle provider",
    "enum": [
     "chainlink",
     "api3",
     "redstone",
     "dia",
     "winklink",
     "supra",
     "twap",
     "reflector",
     "flare",
     "band"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Filter by asset symbol",
    "type": "string"
   },
   "to": {
    "description": "End date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_feed_uptime"
}
