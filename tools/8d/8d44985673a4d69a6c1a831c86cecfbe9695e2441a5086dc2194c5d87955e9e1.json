  "additionalProperties": false,
  "properties": {
   "workspace_scope": {
    "description": "Optional workspace for THIS call: use an exact personal/team ID from list_workspaces. Repeat on each call; it does not change the connection default. Must agree with MCP metadata and the effective HTTP workspace selector (header, otherwise connector URL). OAuth connections can only use their granted workspace. Membership and campaign permissions still apply.",
    "maxLength": 64,
    "minLength": 3,
    "pattern": "^[uw]-[a-z0-9](?:[a-z0-9-]{0,61})$",
    "type": "string"
   }
  },
  "type": "object"
 },
