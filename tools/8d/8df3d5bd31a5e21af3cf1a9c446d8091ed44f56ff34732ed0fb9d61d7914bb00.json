{
 "description": "Create a MDF-e (manifesto de documentos fiscais eletr\u00f4nico)",
 "inputSchema": {
  "properties": {
   "ambiente": {
    "description": "1=Produ\u00e7\u00e3o, 2=Homologa\u00e7\u00e3o",
    "enum": [
     1,
     2
    ],
    "type": "number"
   },
   "documentos": {
    "description": "Array of linked documents (NF-e/CT-e keys)",
    "type": "array"
   },
   "emitente": {
    "description": "Issuer data (CNPJ, IE, address)",
    "type": "object"
   },
   "modal": {
    "description": "Transport mode",
    "enum": [
     "rodoviario",
     "aereo",
     "aquaviario",
     "ferroviario"
    ],
    "type": "string"
   },
   "percurso": {
    "description": "Route UFs (array of state codes)",
    "type": "array"
   },
   "veiculos": {
    "description": "Vehicle data (plate, RNTRC, etc.)",
    "type": "object"
   }
  },
  "required": [
   "ambiente",
   "emitente",
   "modal",
   "documentos"
  ],
  "type": "object"
 },
 "name": "create_mdfe"
}
