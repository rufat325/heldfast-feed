{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the hosted articles by relevance (BM25 over titles, tags, descriptions, and full text) and return the best matches. Use it to answer what Fmind has written about a topic instead of listing every publication.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "description": "maximum number of results to return (default 10, maximum 50)",
    "title": "Limit",
    "type": "integer"
   },
   "query": {
    "description": "words to search for across article titles, tags, descriptions, and full text",
    "title": "Query",
    "type": "string"
   },
   "tag": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "optionally keep only articles with this tag, case-insensitive: Agent, Coding, LLM, RAG, MLOps, Cloud, Python, Project, Demo, Guide",
    "title": "Tag"
   }
  },
  "required": [
   "query"
  ],
  "title": "search_articlesArguments",
  "type": "object"
 },
 "name": "search_articles",
 "outputSchema": {
  "$defs": {
   "ArticleSummary": {
    "properties": {
     "canonical": {
      "default": "",
      "title": "Canonical",
      "type": "string"
     },
     "date": {
      "format": "date-time",
      "title": "Date",
      "type": "string"
     },
     "description": {
      "title": "Description",
      "type": "string"
     },
     "image_alt": {
      "title": "Image Alt",
      "type": "string"
     },
     "image_url": {
      "title": "Image Url",
      "type": "string"
     },
     "reading_minutes": {
      "title": "Reading Minutes",
      "type": "integer"
     },
     "slug": {
      "title": "Slug",
      "type": "string"
     },
     "syndicated": {
      "default": "",
      "title": "Syndicated",
      "type": "string"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "title": "Tags",
      "type": "array"
     },
     "title": {
      "title": "Title",
      "type": "string"
     },
     "updated": {
      "format": "date-time",
      "title": "Updated",
      "type": "string"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "date",
     "updated",
     "title",
     "description",
     "slug",
     "url",
     "image_url",
     "image_alt",
     "tags",
     "reading_minutes"
    ],
    "title": "ArticleSummary",
    "type": "object"
   }
  },
  "properties": {
   "articles": {
    "items": {
     "$ref": "#/$defs/ArticleSummary"
    },
    "title": "Articles",
    "type": "array"
   },
   "query": {
    "title": "Query",
    "type": "string"
   },
   "total": {
    "title": "Total",
    "type": "integer"
   }
  },
  "required": [
   "query",
   "articles",
   "total"
  ],
  "title": "SearchArticlesResult",
  "type": "object"
 },
 "title": "Search articles"
}
