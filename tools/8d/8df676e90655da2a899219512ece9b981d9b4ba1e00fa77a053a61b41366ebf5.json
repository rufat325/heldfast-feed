{
 "description": "Enrich multiple wallets or tokens in a single call (1-25). Returns parallel results.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addresses": {
    "description": "Array of Solana addresses (1-25)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "depth": {
    "default": "light",
    "description": "Enrichment depth",
    "enum": [
     "light",
     "full"
    ],
    "type": "string"
   },
   "type": {
    "description": "Address type: wallet or token",
    "enum": [
     "wallet",
     "token"
    ],
    "type": "string"
   }
  },
  "required": [
   "addresses",
   "type"
  ],
  "type": "object"
 },
 "name": "batch_enrich",
 "title": "Batch Enrich"
}
