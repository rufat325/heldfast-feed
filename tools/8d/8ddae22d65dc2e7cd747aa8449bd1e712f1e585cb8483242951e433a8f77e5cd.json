{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Requires an API key. Registers an https URL that receives a signed POST (Standard Webhooks: webhook-id, webhook-timestamp, webhook-signature) for each story event: story.published, story.updated, story.label_changed, story.corrected, story.retracted (default story.published, story.corrected, story.retracted). Optional filters: formats, topics, labels. Returns the subscription and its signing secret (whsec_...), shown only once. At most 5 per key; five failed attempts in a row or a 410 disable it.",
 "inputSchema": {
  "properties": {
   "description": {
    "maxLength": 200,
    "type": "string"
   },
   "events": {
    "items": {
     "enum": [
      "story.published",
      "story.updated",
      "story.label_changed",
      "story.corrected",
      "story.retracted"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "formats": {
    "items": {
     "enum": [
      "breaking",
      "model_drop",
      "the_number",
      "money",
      "explainer",
      "rumor",
      "for_the_minutes",
      "standard"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "labels": {
    "items": {
     "enum": [
      "confirmed",
      "official",
      "reported_single",
      "rumor",
      "benchmark_claim"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "topics": {
    "items": {
     "enum": [
      "models",
      "agents",
      "chips",
      "policy",
      "funding",
      "open_source",
      "research",
      "products",
      "safety",
      "enterprise",
      "business",
      "society"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "description": "https URL on a public host (port 443 or 8443)",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "subscribe_webhook",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "properties": {
     "consecutiveFailures": {
      "type": "integer"
     },
     "createdAt": {
      "type": "string"
     },
     "description": {
      "type": [
       "string",
       "null"
      ]
     },
     "disabledReason": {
      "type": [
       "string",
       "null"
      ]
     },
     "events": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "filters": {
      "type": "object"
     },
     "id": {
      "type": "string"
     },
     "lastError": {
      "type": [
       "string",
       "null"
      ]
     },
     "lastSuccessAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "secret": {
      "type": "string"
     },
     "status": {
      "enum": [
       "active",
       "disabled"
      ],
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "url",
     "events",
     "status",
     "secret"
    ],
    "type": "object"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Subscribe a webhook"
}
