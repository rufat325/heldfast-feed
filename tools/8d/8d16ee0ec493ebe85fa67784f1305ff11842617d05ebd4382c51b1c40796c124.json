{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search Tuki Hotel landings (pousadas, boutiques, hostels listed as /hotel/<slug>). Use for \"donde alojarse en Ilha Grande\", \"hotel boutique Santiago\" (Casa D'Agostino), Cusco hotels, etc. Distinct from search_accommodations (individual rooms/cabins). Returns name, location, price-from, canonical URL.",
 "inputSchema": {
  "properties": {
   "max_results": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset. Use next_offset from a previous response.",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free text (e.g. \"ilha grande\", \"casa dagostino\", \"pousada\").",
    "type": "string"
   },
   "response_format": {
    "default": "concise",
    "description": "concise = high-signal fields + canonical URL (token-cheap, default). detailed = full record.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_hotels",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "has_more": {
    "type": "boolean"
   },
   "next_offset": {
    "type": [
     "integer",
     "null"
    ]
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "offset": {
    "type": "integer"
   },
   "results": {
    "items": {
     "properties": {
      "capacity": {
       "type": [
        "integer",
        "null"
       ]
      },
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "currency": {
       "type": [
        "string",
        "null"
       ]
      },
      "duration_minutes": {
       "type": [
        "integer",
        "null"
       ]
      },
      "is_free_tour": {
       "type": "boolean"
      },
      "is_whatsapp_reservation": {
       "type": "boolean"
      },
      "location": {
       "type": [
        "string",
        "null"
       ]
      },
      "price": {
       "type": [
        "number",
        "string",
        "null"
       ]
      },
      "primary_image": {
       "type": [
        "string",
        "null"
       ]
      },
      "property_type": {
       "type": "string"
      },
      "short_description": {
       "type": [
        "string",
        "null"
       ]
      },
      "slug": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "description": "Canonical Tuki URL \u2014 link/checkout here.",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "count",
   "total",
   "offset",
   "has_more",
   "results"
  ],
  "type": "object"
 },
 "title": "Buscar hoteles / pousadas"
}
