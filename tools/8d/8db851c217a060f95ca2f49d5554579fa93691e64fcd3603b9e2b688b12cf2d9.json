{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Indexed / excluded page-count trend over time (detect deindexing).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_from": {
    "description": "Start date YYYY-MM-DD (default: 30 days ago)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "$ref": "#/properties/date_from",
    "description": "End date YYYY-MM-DD (default: today)"
   },
   "format": {
    "default": "markdown",
    "description": "Output format: 'markdown' (compact, default) or 'json' (raw API response)",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "host_id": {
    "description": "Host ID from get_hosts",
    "type": "string"
   }
  },
  "required": [
   "host_id"
  ],
  "type": "object"
 },
 "name": "get_indexing_history"
}
