{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an environmental sensor scaffold with normalized readings, sensor maps, adapter source, and building-control safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "http_json",
    "enum": [
     "websocket_json",
     "http_json",
     "mqtt_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9093/environment",
    "type": "string"
   },
   "name": {
    "default": "environmental_sensor_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for environment sensors.",
    "type": "string"
   },
   "sensor_count": {
    "default": 12,
    "maximum": 512,
    "minimum": 1,
    "type": "integer"
   },
   "sensor_profile": {
    "default": "co2_temp_humidity",
    "enum": [
     "co2_temp_humidity",
     "air_quality",
     "mixed",
     "manual"
    ],
    "type": "string"
   },
   "zone_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_environmental_sensor_bus",
 "title": "Connect environmental sensor bus"
}
