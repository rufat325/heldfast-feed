{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Account-wide impact: use it when a global customisation is asked for, prefer update_catalogue for a single PDF.",
 "inputSchema": {
  "$defs": {
   "BrandPatch": {
    "additionalProperties": false,
    "properties": {
     "couleur": {
      "default": null,
      "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{6})$",
      "title": "Couleur",
      "type": "string"
     },
     "societe": {
      "default": null,
      "maxLength": 160,
      "minLength": 0,
      "title": "Societe",
      "type": "string"
     },
     "telechargement_pdf_defaut": {
      "default": null,
      "title": "Telechargement Pdf Defaut",
      "type": "boolean"
     }
    },
    "title": "BrandPatch",
    "type": "object"
   }
  },
  "properties": {
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "patch": {
    "$ref": "#/$defs/BrandPatch"
   }
  },
  "required": [
   "patch",
   "expected_revision"
  ],
  "title": "update_brandArguments",
  "type": "object"
 },
 "name": "foliade_update_brand",
 "title": "Change the account brand settings"
}
