{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get the full operator profile by slug including address, phone, listing URL, website (paid listings only), services, venues_served, FAQs, and tipping note. Use this when an agent has a slug from a search tool or directory URL and needs the profile. Returns isError on slug 404 or upstream outage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Canonical kebab-case operator slug (e.g. '12-oaks-parking-llc'). Lowercase letters, digits, hyphens only.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "valet_get_operator",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": false,
    "description": "TOOL-11 ToS and attribution block",
    "properties": {
     "attribution": {
      "type": "string"
     },
     "terms": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "terms",
     "attribution"
    ],
    "type": "object"
   },
   "data_freshness": {
    "additionalProperties": false,
    "description": "TOOL-10 freshness stamp",
    "properties": {
     "indexed_at": {
      "description": "ISO datetime of the Typesense indexed_at stamp",
      "type": "string"
     },
     "source": {
      "description": "Origin of the data; for this tool: typesense:operators",
      "type": "string"
     }
    },
    "required": [
     "indexed_at",
     "source"
    ],
    "type": "object"
   },
   "operator": {
    "additionalProperties": false,
    "description": "The full merged operator profile (Typesense + Payload long-tail fields)",
    "properties": {
     "address": {
      "description": "Full street address; null if none",
      "type": [
       "string",
       "null"
      ]
     },
     "buyer_question_phrasings": {
      "anyOf": [
       {
        "additionalProperties": {
         "type": "string"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "LLM-seeded phrasings of buyer-checklist questions"
     },
     "claimed": {
      "description": "Operator-claim status",
      "type": "boolean"
     },
     "description_text": {
      "description": "Plaintext description; null if none. Lexical AST not exposed.",
      "type": [
       "string",
       "null"
      ]
     },
     "faqs": {
      "description": "Structured FAQs; tipping guidance lives here as one entry",
      "items": {
       "additionalProperties": false,
       "properties": {
        "answer": {
         "type": "string"
        },
        "question": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "question",
        "answer"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "id": {
      "description": "Payload UUID; matches Typesense document id",
      "type": "string"
     },
     "listing_url": {
      "description": "Get Valet Parking profile URL for this operator with ?ref=mcp UTM stamp (TOOL-12); present on every tier",
      "type": "string"
     },
     "name": {
      "description": "Operator business name",
      "type": "string"
     },
     "phone": {
      "description": "E.164 phone number; null if none",
      "type": [
       "string",
       "null"
      ]
     },
     "photo_url": {
      "description": "Profile photo URL; null if none",
      "type": [
       "string",
       "null"
      ]
     },
     "primary_city_name": {
      "description": "HQ proxy city display name",
      "type": "string"
     },
     "primary_city_slug": {
      "description": "HQ proxy city slug (URL-safe)",
      "type": "string"
     },
     "primary_state_name": {
      "description": "HQ proxy state display name",
      "type": "string"
     },
     "primary_state_slug": {
      "description": "HQ proxy state slug (URL-safe)",
      "type": "string"
     },
     "service_area_city_slugs": {
      "description": "All city slugs this operator serves",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "service_area_count": {
      "description": "Count of service-area cities",
      "type": "number"
     },
     "services": {
      "description": "Canonical service slugs from valet_list_services taxonomy",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "slug": {
      "description": "Canonical kebab-case slug; matches the input",
      "type": "string"
     },
     "tier": {
      "description": "Subscription tier: free | paid | custom",
      "type": "string"
     },
     "venues_served": {
      "description": "Venues this operator regularly serves",
      "items": {
       "additionalProperties": false,
       "properties": {
        "venue": {
         "type": "string"
        }
       },
       "required": [
        "venue"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "verified": {
      "description": "Manual verification status",
      "type": "boolean"
     },
     "website": {
      "description": "Operator's own website with ?ref=mcp UTM stamp (TOOL-12). Paid and custom listings only; null on free listings and when none is set",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "id",
     "name",
     "slug",
     "primary_city_name",
     "primary_state_name",
     "primary_city_slug",
     "primary_state_slug",
     "service_area_city_slugs",
     "service_area_count",
     "services",
     "tier",
     "verified",
     "claimed",
     "phone",
     "description_text",
     "photo_url",
     "address",
     "website",
     "listing_url",
     "venues_served",
     "faqs",
     "buyer_question_phrasings"
    ],
    "type": "object"
   }
  },
  "required": [
   "operator",
   "data_freshness",
   "_meta"
  ],
  "type": "object"
 },
 "title": "Get Operator Profile"
}
