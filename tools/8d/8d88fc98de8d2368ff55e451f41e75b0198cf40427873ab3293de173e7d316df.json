{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update service"
 },
 "description": "Update a Tailscale Service's configuration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "autoApproveHosts": {
    "description": "Whether to auto-approve devices that want to host this service",
    "type": "boolean"
   },
   "ports": {
    "description": "Ports the service listens on",
    "items": {
     "properties": {
      "port": {
       "description": "Port number (1-65535)",
       "maximum": 65535,
       "minimum": 1,
       "type": "integer"
      },
      "protocol": {
       "description": "Protocol (tcp or udp)",
       "enum": [
        "tcp",
        "udp"
       ],
       "type": "string"
      }
     },
     "required": [
      "protocol",
      "port"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "serviceName": {
    "description": "The service name to update",
    "type": "string"
   },
   "tags": {
    "description": "ACL tags for the service",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "serviceName"
  ],
  "type": "object"
 },
 "name": "tailscale_update_service",
 "title": "Update service"
}
