{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add one line: description, quantity, rate in whole minor units, and unit hour, each, or day. After the invoice is sealed, a new line is refused until accept_invoice_change applies an add_line suggestion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "invoiceId": {
    "format": "uuid",
    "type": "string"
   },
   "quantity": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "rateMinor": {
    "maximum": 100000000,
    "minimum": 1,
    "type": "integer"
   },
   "unit": {
    "enum": [
     "hour",
     "each",
     "day"
    ],
    "type": "string"
   }
  },
  "required": [
   "invoiceId",
   "description",
   "quantity",
   "rateMinor",
   "unit"
  ],
  "type": "object"
 },
 "name": "place_line",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "place line"
}
