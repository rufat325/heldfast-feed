{
 "description": "Create a new Instance with the given className under the specified parent",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "className": {
    "description": "Roblox class name (e.g. \"Part\", \"RemoteEvent\", \"Folder\")",
    "type": "string"
   },
   "parent": {
    "description": "Dot-notation path to parent (e.g. \"game.Workspace\", \"game.ReplicatedStorage\")",
    "type": "string"
   },
   "properties": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      },
      {
       "type": "null"
      },
      {
       "additionalProperties": {},
       "type": "object"
      }
     ]
    },
    "description": "Map of property names to values. Complex types use _type tags: { Position: { _type: \"Vector3\", x: 0, y: 5, z: 0 } }",
    "type": "object"
   }
  },
  "required": [
   "className",
   "parent"
  ],
  "type": "object"
 },
 "name": "create_instance"
}
