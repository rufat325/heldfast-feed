{
 "description": "[RESEARCHER] Submit research evidence as a signed packet with citations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "claims": {
    "description": "Evidence claims with citations",
    "items": {
     "properties": {
      "claim": {
       "description": "The factual claim",
       "type": "string"
      },
      "confidence": {
       "description": "Confidence level",
       "enum": [
        "high",
        "medium",
        "low",
        "not_found"
       ],
       "type": "string"
      },
      "dimension": {
       "description": "Evaluation dimension",
       "type": "string"
      },
      "quote": {
       "description": "Supporting quote from source (10+ words)",
       "type": "string"
      },
      "source_url": {
       "description": "Verifiable source URL",
       "type": "string"
      },
      "subject": {
       "description": "What's being evaluated",
       "type": "string"
      }
     },
     "required": [
      "dimension",
      "subject",
      "claim",
      "quote",
      "source_url",
      "confidence"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "methodology": {
    "description": "How you gathered this evidence",
    "type": "string"
   },
   "task_id": {
    "description": "Task ID",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "claims",
   "methodology"
  ],
  "type": "object"
 },
 "name": "submit_evidence"
}
