{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search people"
 },
 "description": "Search anonymous worker profiles worldwide by skills, languages, category, remote/on-site location, verification and budget. Results are ranked with explainable match reasons. Use skillsMatch=all for strict skill requirements, or rank for partial matches. weeklyWindow requires stated local weekly hours covering the whole window. Searching does not reserve anyone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "additionalProperties": false,
    "properties": {
     "amountMinor": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     }
    },
    "required": [
     "amountMinor",
     "currency"
    ],
    "type": "object"
   },
   "category": {
    "enum": [
     "research",
     "data_work",
     "writing_translation",
     "software_testing",
     "design_creative",
     "expert_consult",
     "field_check",
     "local_errand",
     "customer_ops",
     "other"
    ],
    "type": "string"
   },
   "city": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "countryCode": {
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "estimatedMinutes": {
    "maximum": 43200,
    "minimum": 5,
    "type": "integer"
   },
   "languages": {
    "items": {
     "pattern": "^[a-z]{2,3}$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "limit": {
    "default": 10,
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "minVerification": {
    "enum": [
     "unverified",
     "identity_verified",
     "skill_verified"
    ],
    "type": "string"
   },
   "mode": {
    "default": "remote",
    "enum": [
     "remote",
     "onsite"
    ],
    "type": "string"
   },
   "skills": {
    "items": {
     "maxLength": 48,
     "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "skillsMatch": {
    "default": "rank",
    "enum": [
     "rank",
     "all"
    ],
    "type": "string"
   },
   "weeklyWindow": {
    "additionalProperties": false,
    "properties": {
     "day": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     "end": {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$|^24:00$",
      "type": "string"
     },
     "start": {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     }
    },
    "required": [
     "day",
     "start",
     "end"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "search_workers",
 "title": "Search people"
}
