{
 "description": "List media library items (id, title, url, mime_type, date; images also alt, width, height) with paging totals",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mime_type": {
    "description": "Filter by MIME type or top-level type (image, video, audio, application, image/png)",
    "type": "string"
   },
   "order": {
    "description": "Sort direction (default DESC)",
    "enum": [
     "ASC",
     "DESC"
    ],
    "type": "string"
   },
   "orderby": {
    "description": "Order by field (default date)",
    "enum": [
     "date",
     "modified",
     "title",
     "name",
     "author",
     "parent",
     "menu_order",
     "rand",
     "none"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Items per page (default 20)",
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Search term",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "mcp_list_media"
}
