        "integer",
        "null"
       ]
      },
      "top10_weight_pct": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "first_file": {
    "type": [
     "string",
     "null"
    ]
   },
   "history": {
    "type": "boolean"
   },
   "last_file": {
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "overlap_by_weight_pct": {
