{
 "description": "Wait for text or selector to appear on the page",
 "inputSchema": {
  "properties": {
   "pageId": {
    "description": "Page ID (uses active page if not specified)",
    "type": "string"
   },
   "selector": {
    "description": "CSS selector to wait for",
    "type": "string"
   },
   "state": {
    "default": "visible",
    "enum": [
     "attached",
     "detached",
     "visible",
     "hidden"
    ],
    "type": "string"
   },
   "text": {
    "description": "Text to wait for",
    "type": "string"
   },
   "timeout": {
    "default": 30000,
    "description": "Timeout in milliseconds",
    "type": "number"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "wait_for"
}
