  "properties": {
   "actions": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "active": {
    "type": "boolean"
   },
   "before": {
    "description": "Trigger id to place this one before",
    "type": "number"
   },
   "conditions": {
