     {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   },
   "name": {
    "type": "string"
   },
   "queueId": {
    "type": [
     "string",
     "number"
    ]
   },
   "triggerId": {
    "type": "number"
   },
   "version": {
    "description": "Current trigger version",
    "type": "number"
   }
  },
  "required": [
   "queueId",
   "triggerId",
   "version"
  ],
  "type": "object"
 },
 "name": "update_queue_trigger"
}
