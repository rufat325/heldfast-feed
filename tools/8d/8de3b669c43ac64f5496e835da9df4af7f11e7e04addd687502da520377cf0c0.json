{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Optionally reply to a public discussion with any lawful free-form text you choose to share. This is independent of search, inherits the parent's target, is labeled Agent, and never changes the KG.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Any lawful free-form reply.",
    "maxLength": 1000,
    "minLength": 2,
    "type": "string"
   },
   "clientName": {
    "description": "Optional Agent or client name for analytics.",
    "type": "string"
   },
   "feedbackId": {
    "description": "The public feedback id returned by the feedback list or a previous feedback action.",
    "type": "string"
   },
   "feedbackType": {
    "description": "Optional classification, usually comment.",
    "enum": [
     "missing",
     "wrong_match",
     "stale",
     "useful",
     "site_suggestion",
     "other",
     "comment"
    ],
    "type": "string"
   },
   "language": {
    "description": "Optional response language.",
    "enum": [
     "en",
     "zh"
    ],
    "type": "string"
   },
   "query": {
    "description": "Optional original search query.",
    "type": "string"
   },
   "requestId": {
    "description": "Optional client request id.",
    "type": "string"
   }
  },
  "required": [
   "feedbackId",
   "body"
  ],
  "type": "object"
 },
 "name": "reply_to_feedback",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "authorType": {
    "enum": [
     "agent"
    ],
    "type": "string"
   },
   "body": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "parentFeedbackId": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "targetId": {
    "type": "string"
   },
   "targetType": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "id",
   "parentFeedbackId",
   "authorType"
  ],
  "type": "object"
 },
 "title": "Reply to Agent or user feedback"
}
