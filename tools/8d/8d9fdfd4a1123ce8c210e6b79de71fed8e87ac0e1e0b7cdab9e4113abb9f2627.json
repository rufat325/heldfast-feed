  "title": "Hold a time for the person's yes"
 },
 "description": "Holds one open time from a quote for 10 minutes and has the shop text the person a link to book it or say it was not them. Nothing is booked until the person taps yes. The same call again, while it is held, texts no one. The quote_id may come from any shop find_help or get_quote gave.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "mobile": {
    "description": "The person's US mobile number, with its area code. The shop texts it once.",
    "type": "string"
   },
   "name": {
    "description": "The person's name.",
    "type": "string"
   },
   "option_id": {
    "description": "One of the quote's prices, by its option_id.",
    "type": "string"
   },
   "quote_id": {
    "description": "The quote_id price gave.",
    "type": "string"
   },
   "street": {
    "description": "The street address of the house, with its number.",
    "type": "string"
   },
   "time_id": {
    "description": "One of the quote's times, by its time_id.",
    "type": "string"
   },
   "unit": {
    "description": "Optional. The unit or apartment.",
    "type": "string"
   }
  },
  "required": [
   "quote_id",
   "option_id",
   "time_id",
   "name",
   "mobile",
   "street"
  ],
  "type": "object"
 },
 "name": "hold_time",
