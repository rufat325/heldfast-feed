    "type": "string"
   },
   "said": {
    "type": "string"
   },
   "state": {
    "enum": [
     "priced",
     "waits_for_owner",
     "waiting",
     "ran_out",
     "declined",
     "booked",
     "canceled",
     "closed"
    ],
    "type": "string"
   },
   "visit": {
    "description": "The booked visit as it stands now: its time, its tech, and what has happened since the yes.",
    "properties": {
     "arrived_at": {
      "format": "date-time",
      "type": "string"
     },
     "canceled_at": {
      "format": "date-time",
