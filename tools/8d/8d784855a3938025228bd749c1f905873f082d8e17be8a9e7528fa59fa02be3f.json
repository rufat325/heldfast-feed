{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get products"
 },
 "description": "Returns the HOUSINGFAX report for a home in Spain (productMode free): a single product, the full report with web view and PDF, free of charge, with the building condition assessment when the building has an IEE/ITE record. Also returns the report limits and the consent text (with its SHA-256) that the person must accept before create_free_report. Use it when someone asks what HOUSINGFAX offers or before ordering. Always tell the person: it is a preliminary, automated report built from public records, not a technical inspection, valuation, certificate, safety assessment or legal advice; probabilities are given as words (very low to very high), never as percentages; a check without data (\u25cb) means unknown, not negative or safe; Navarra is not covered yet; the report is only available as a private link.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "language": {
    "default": "es",
    "description": "Language of the texts in the answer (and of the report): es, en, de, nl or fr. Default es.",
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_products",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "checksCount": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "consent": {
    "additionalProperties": false,
    "properties": {
     "agentContractingTermsUrl": {
      "maxLength": 400,
      "pattern": "^https:\\/\\/[^\\s]+$",
      "type": "string"
     },
     "privacyUrl": {
      "maxLength": 400,
      "pattern": "^https:\\/\\/[^\\s]+$",
      "type": "string"
     },
     "statementSha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "termsUrl": {
      "maxLength": 400,
      "pattern": "^https:\\/\\/[^\\s]+$",
      "type": "string"
     },
     "termsVersion": {
      "maxLength": 16,
      "minLength": 1,
      "type": "string"
     },
     "text": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "text",
     "statementSha256",
     "termsVersion",
     "termsUrl",
     "privacyUrl"
    ],
    "type": "object"
   },
   "contract": {
    "const": "agent-api-1.2.0",
    "type": "string"
   },
   "currency": {
    "const": "EUR",
    "type": "string"
   },
   "disclaimer": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "exampleReportUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "freeReportLimits": {
    "additionalProperties": false,
    "properties": {
     "agentChannelPerDay": {
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     },
     "note": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "perEmail": {
      "additionalProperties": false,
      "properties": {
       "count": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "windowDays": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       }
      },
      "required": [
       "count",
       "windowDays"
      ],
      "type": "object"
     }
    },
    "required": [
     "perEmail",
     "note",
     "agentChannelPerDay"
    ],
    "type": "object"
   },
   "language": {
    "enum": [
     "es",
     "en",
     "de",
     "nl",
     "fr"
    ],
    "type": "string"
   },
   "orderUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "priceNote": {
    "maxLength": 600,
    "minLength": 1,
    "type": "string"
   },
   "pricingUrl": {
    "maxLength": 400,
    "pattern": "^https:\\/\\/[^\\s]+$",
    "type": "string"
   },
   "productMode": {
    "enum": [
     "commercial",
     "free"
    ],
    "type": "string"
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "maxLength": 600,
       "minLength": 1,
       "type": "string"
      },
      "emailRequired": {
       "type": "boolean"
      },
      "format": {
       "enum": [
        "redacted_web_preview",
        "web_and_pdf"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 600,
       "minLength": 1,
       "type": "string"
      },
      "orderChannel": {
       "enum": [
        "agent_api",
        "web"
       ],
       "type": "string"
      },
      "price": {
       "maxLength": 600,
       "minLength": 1,
       "type": "string"
      },
      "priceCents": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "requiresBuildingConditionRecord": {
       "type": "boolean"
      },
      "tier": {
       "enum": [
        "free",
        "simple",
        "complete"
       ],
       "type": "string"
      }
     },
     "required": [
      "tier",
      "name",
      "priceCents",
      "price",
      "description",
      "requiresBuildingConditionRecord",
      "format",
      "emailRequired",
      "orderChannel"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "upgrade": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "from": {
        "const": "simple",
        "type": "string"
       },
       "price": {
        "maxLength": 600,
        "minLength": 1,
        "type": "string"
       },
       "priceCents": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "to": {
        "const": "complete",
        "type": "string"
       }
      },
      "required": [
       "from",
       "to",
       "priceCents",
       "price"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "vatIncluded": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "contract",
   "language",
   "currency",
   "vatIncluded",
   "priceNote",
   "products",
   "freeReportLimits",
   "consent",
   "checksCount",
   "pricingUrl",
   "orderUrl",
   "exampleReportUrl",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Get the HOUSINGFAX report and its consent text"
}
