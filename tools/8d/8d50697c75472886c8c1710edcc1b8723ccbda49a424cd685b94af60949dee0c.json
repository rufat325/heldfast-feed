{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lista os posts publicados do blog (mais novo primeiro), com resumo, categoria, tags e URL. Filtre por categoria se quiser.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "filosofia",
     "pratica",
     "cultura",
     "guia",
     "orixas"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "pt-BR",
    "description": "Idioma da resposta: pt-BR (base), en, es.",
    "enum": [
     "pt-BR",
     "en",
     "es"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_articles",
 "title": "Posts do blog"
}
