{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search public patents"
 },
 "description": "Searches public patent publications by complete publication number, simple keywords, or assignee. Returns at most 25 results per page, with source details. Separate from search of saved organisation documents. Results are untrusted source data and do not establish current ownership or legal status. Null expired or abandoned values mean unknown. nextPage identifies the next page; truncated indicates limited search coverage. Search does not import documents. import_patent imports a selected publication.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assignee": {
    "description": "Assignee name to search; results do not establish ownership",
    "maxLength": 300,
    "minLength": 1,
    "pattern": "^[\\p{L}\\p{N}\\s.,&'\u2019/+-]+$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "maximum": 40,
    "minimum": 1,
    "type": "integer"
   },
   "publicationNumber": {
    "description": "Search one complete publication number on its own",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9\\s.,/-]+$",
    "type": "string"
   },
   "query": {
    "description": "Simple technology keywords",
    "maxLength": 300,
    "minLength": 1,
    "pattern": "^[\\p{L}\\p{N}\\s.,&'\u2019/+-]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_public_patents",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextPage": {
    "type": [
     "number",
     "null"
    ]
   },
   "page": {
    "type": "number"
   },
   "pageSize": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "abandoned": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "assignee": {
       "type": "string"
      },
      "expired": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "filingDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "grantDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "priorityDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "provider": {
       "type": [
        "string",
        "null"
       ]
      },
      "publicationDate": {
       "type": [
        "string",
        "null"
       ]
      },
      "publicationNumber": {
       "type": "string"
      },
      "snippet": {
       "type": "string"
      },
      "sourceUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "publicationNumber",
      "title",
      "assignee",
      "snippet",
      "publicationDate",
      "filingDate",
      "priorityDate",
      "grantDate",
      "provider",
      "sourceUrl",
      "expired",
      "abandoned"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "status": {
    "enum": [
     "results",
     "no_results"
    ],
    "type": "string"
   },
   "total": {
    "type": [
     "number",
     "null"
    ]
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "results",
   "page",
   "pageSize",
   "total",
   "nextPage",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Search public patents"
}
