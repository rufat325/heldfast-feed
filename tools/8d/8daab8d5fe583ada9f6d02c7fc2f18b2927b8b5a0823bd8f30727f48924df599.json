{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new folder under an existing parent folder. Use parentId=-1 for root-level (0 returns 404). Use qtm4j_list_folders first to find valid parentId values.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "Folder description",
    "type": "string"
   },
   "folderName": {
    "description": "Folder name",
    "type": "string"
   },
   "folderType": {
    "description": "Folder type",
    "enum": [
     "TESTCASE",
     "TESTCYCLE",
     "TESTPLAN"
    ],
    "type": "string"
   },
   "parentId": {
    "description": "Parent folder ID (use -1 for root)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "projectId": {
    "description": "Jira project numeric ID (e.g. 10000)",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "projectId",
   "folderName",
   "folderType",
   "parentId"
  ],
  "type": "object"
 },
 "name": "qtm4j_create_folder",
 "title": "Create Folder"
}
