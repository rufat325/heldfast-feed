{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update system"
 },
 "description": "Update an existing system by ID. Requires systems:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "crv_multiplier": {
    "description": "CRV multiplier",
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "description": "Description",
    "maxLength": 2000,
    "type": "string"
   },
   "id": {
    "description": "System ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "name": {
    "description": "System name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "system_group_id": {
    "description": "System group ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_system",
 "title": "Update system"
}
