{
 "description": "Tiles, boxes and cost for a room: room and tile dimensions, grout width, waste factor by layout pattern (straight, offset, diagonal, herringbone...), optional box size and prices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "box_size": {
    "default": 10,
    "description": "Tiles per box",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "grout_mm": {
    "default": 3,
    "minimum": 0,
    "type": "number"
   },
   "layout": {
    "default": "straight",
    "description": "Layout pattern (sets default waste factor)",
    "enum": [
     "straight",
     "offset",
     "diagonal",
     "herringbone",
     "large-format",
     "natural-stone"
    ],
    "type": "string"
   },
   "price_per_box": {
    "minimum": 0,
    "type": "number"
   },
   "price_per_m2": {
    "minimum": 0,
    "type": "number"
   },
   "room_length_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "room_width_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "tile_length_mm": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "tile_width_mm": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "waste_percent": {
    "description": "Overrides the layout default",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "room_width_m",
   "room_length_m",
   "tile_width_mm",
   "tile_length_mm"
  ],
  "type": "object"
 },
 "name": "tile_calculator"
}
