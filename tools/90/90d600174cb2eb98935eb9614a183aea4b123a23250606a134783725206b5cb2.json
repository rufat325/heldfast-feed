{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Can these stops fit in this time, in this order? Judges each stop with its posted hours on the date. The tool does not guess how long a visit takes: visit_min is required.","inputSchema":{"additionalProperties":false,"properties":{"city":{"description":"City key, e.g. \"seoul\".","enum":["seoul","hongkong","osaka","singapore","busan","taipei","tokyo","newyork","bangkok","rome","barcelona","sydney","losangeles"],"type":"string"},"date":{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"end_time":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"from":{"description":"Optional starting station (name or place_id) for the walk to the first stop.","properties":{"station":{"type":"string"}},"required":["station"],"type":"object"},"start_time":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"stops":{"description":"place_id values, in order.","items":{"type":"string"},"maxItems":20,"minItems":1,"type":"array"},"visit_min":{"description":"Minutes at each stop.","maximum":600,"minimum":1,"type":"integer"}},"required":["city","stops","date","start_time","visit_min"],"type":"object"},"name":"plan_local_route","title":"Plan a local route"}
