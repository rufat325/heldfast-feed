{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search discovered agentic resources"
 },
 "description": "Search the StealthStack ARD index for agentic resources (agents, MCP servers, skills, catalogs) discovered across the open web. Free-text query over name/description/tags, ranked by the index's relevance score (best match first). Optionally filter by kind, domain, trust, or accepted payment protocol (paid=x402). Each result includes the connect URL when the publisher provides one; otherwise the inline connection or pull details.",
 "inputSchema": {
  "properties": {
   "domain": {
    "description": "Restrict to one publisher domain (e.g. stealthstack.ai).",
    "type": "string"
   },
   "kind": {
    "description": "Restrict to one resource kind.",
    "enum": [
     "agent",
     "mcp",
     "skill",
     "catalog",
     "registry",
     "api",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results (1-50).",
    "type": "integer"
   },
   "paid": {
    "description": "Only services that list this payment protocol (x402: pay-per-request in stablecoins). A filter, never a ranking.",
    "enum": [
     "x402"
    ],
    "type": "string"
   },
   "query": {
    "description": "Free-text search over name, description, and tags.",
    "type": "string"
   },
   "trust": {
    "description": "verified = the resource's URN authority matches its catalog host (domain-anchored).",
    "enum": [
     "verified",
     "unverified"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_resources",
 "outputSchema": {
  "properties": {
   "mode": {
    "enum": [
     "ranked",
     "substring",
     "unavailable"
    ],
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "connect": {
       "description": "How to reach the resource. mode=url: `url`; mode=connections: `connections[]` (stdio \u2192 command/args, http/sse/streamable-http \u2192 url); mode=pull: `pull.command` (e.g. dirctl pull <cid>); mode=data: inline artifact of unrecognised shape (`dataKeys`; `data` itself when small, get_resource only); mode=none: nothing published.",
       "properties": {
        "connections": {
         "items": {
          "properties": {
           "args": {
            "items": {
             "type": "string"
            },
            "type": "array"
           },
           "command": {
            "type": "string"
           },
           "transport": {
            "type": "string"
           },
           "url": {
            "type": "string"
           }
          },
          "required": [
           "transport"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "data": {
         "type": "object"
        },
        "dataKeys": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "mode": {
         "enum": [
          "url",
          "connections",
          "pull",
          "data",
          "none"
         ],
         "type": "string"
        },
        "pull": {
         "properties": {
          "cid": {
           "type": "string"
          },
          "command": {
           "type": "string"
          }
         },
         "required": [
          "command"
         ],
         "type": "object"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "mode"
       ],
       "type": "object"
      },
      "description": {
       "type": "string"
      },
      "displayName": {
       "type": "string"
      },
      "identifier": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "lastSeen": {
       "type": "string"
      },
      "payment": {
       "description": "Payment terms the service lists (x402): protocol, lowest listed price + currency, network (CAIP-2). Self-declared; never a payee address.",
       "properties": {
        "currency": {
         "type": "string"
        },
        "network": {
         "type": "string"
        },
        "price": {
         "type": "string"
        },
        "protocol": {
         "type": "string"
        },
        "testnet": {
         "type": "boolean"
        }
       },
       "required": [
        "protocol"
       ],
       "type": "object"
      },
      "publisher": {
       "description": "URN authority.",
       "type": "string"
      },
      "representativeQueries": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "score": {
       "description": "Relevance as returned by the index /search (search_resources only).",
       "type": "number"
      },
      "source": {
       "properties": {
        "catalogUrl": {
         "type": "string"
        },
        "domain": {
         "type": "string"
        },
        "via": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "trust": {
       "type": "object"
      },
      "type": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "identifier",
      "displayName",
      "kind",
      "type",
      "connect"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "mode",
   "results"
  ],
  "type": "object"
 },
 "title": "Search discovered agentic resources"
}
