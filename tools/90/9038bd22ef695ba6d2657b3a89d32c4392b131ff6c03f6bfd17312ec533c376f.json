{
 "description": "Run a security audit on the package",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fix": {
    "description": "Automatically fix vulnerabilities",
    "type": "boolean"
   },
   "level": {
    "description": "Minimum vulnerability level to report",
    "enum": [
     "info",
     "low",
     "moderate",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "production": {
    "description": "Only audit production dependencies",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "audit"
}
