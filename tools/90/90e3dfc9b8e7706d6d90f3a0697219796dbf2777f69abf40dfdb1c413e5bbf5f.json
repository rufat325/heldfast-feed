{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free MCP decision for generic search:web_search or browse:fetch proposals only. Returns structuredContent and JSON text, never destination results. Caller supplies cost estimates, post-consultation budget and history, executes tools and retrieves resultReference itself. Reuse requires explicit permission, positive TTL and matching nonempty goal hashes; history must belong to the caller. estimated fees/savings are hypothetical, not receipts; confidence is not calibrated. Paid HTTP is a separate $0.002 per settled POST interface. Full contract: https://agent-preflight.com/docs",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "budget": {
    "properties": {
     "maxToolCallsRemaining": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "remainingUsd": {
      "minimum": 0,
      "type": "number"
     },
     "reservedUsd": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "remainingUsd"
    ],
    "type": "object"
   },
   "capabilities": {
    "properties": {
     "canReduceScope": {
      "type": "boolean"
     },
     "canReusePriorResult": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "freshnessTtlSeconds": {
    "minimum": 0,
    "type": "number"
   },
   "history": {
    "items": {
     "properties": {
      "ageSeconds": {
       "minimum": 0,
       "type": "number"
      },
      "fingerprint": {
       "type": "string"
      },
      "goalHash": {
       "type": "string"
      },
      "outcome": {
       "enum": [
        "success",
        "terminal_failure",
        "transient_failure"
       ],
       "type": "string"
      },
      "resultReference": {
       "type": "string"
      },
      "toolCallId": {
       "type": "string"
      }
     },
     "required": [
      "toolCallId",
      "fingerprint",
      "outcome",
      "ageSeconds"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "preflightPriceUsd": {
    "minimum": 0,
    "type": "number"
   },
   "retryCap": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "runId": {
    "type": "string"
   },
   "stepId": {
    "type": "string"
   },
   "task": {
    "properties": {
     "goalHash": {
      "type": "string"
     }
    },
    "required": [
     "goalHash"
    ],
    "type": "object"
   },
   "tool": {
    "properties": {
     "estimatedExternalCostUsd": {
      "minimum": 0,
      "type": "number"
     },
     "estimatedModelCostUsd": {
      "minimum": 0,
      "type": "number"
     },
     "operation": {
      "type": "string"
     },
     "provider": {
      "type": "string"
     },
     "request": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    },
    "required": [
     "provider",
     "operation",
     "request",
     "estimatedExternalCostUsd"
    ],
    "type": "object"
   }
  },
  "required": [
   "runId",
   "stepId",
   "tool",
   "budget"
  ],
  "type": "object"
 },
 "name": "preflight_tool_call",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "decision": {
    "enum": [
     "allow",
     "block",
     "reuse",
     "defer",
     "advise"
    ],
    "type": "string"
   },
   "enforcement": {
    "enum": [
     "execute",
     "safe_to_skip",
     "advisory"
    ],
    "type": "string"
   },
   "estimated": {
    "additionalProperties": false,
    "properties": {
     "avoidableExternalCostUsd": {
      "type": "number"
     },
     "avoidableModelCostUsd": {
      "type": "number"
     },
     "billable": {
      "description": "Modeled actionable status; MCP is unpaid",
      "type": "boolean"
     },
     "confidence": {
      "description": "Rule constant, not a calibrated probability",
      "type": "number"
     },
     "netSavingsUsd": {
      "type": "number"
     },
     "preflightCostUsd": {
      "type": "number"
     },
     "priceChargedUsd": {
      "description": "Modeled fee, not a settlement receipt",
      "type": "number"
     }
    },
    "required": [
     "preflightCostUsd",
     "priceChargedUsd",
     "avoidableExternalCostUsd",
     "avoidableModelCostUsd",
     "netSavingsUsd",
     "billable",
     "confidence"
    ],
    "type": "object"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matchedCallId": {
    "type": "string"
   },
   "reasonCodes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recommendation": {
    "additionalProperties": false,
    "properties": {
     "action": {
      "type": "string"
     },
     "resultReference": {
      "type": "string"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   "requestFingerprint": {
    "description": "SHA-256 of version-2 exact proposal; absent on invalid input",
    "type": "string"
   }
  },
  "required": [
   "decision",
   "enforcement",
   "reasonCodes",
   "issues"
  ],
  "type": "object"
 },
 "title": "Preflight Tool Call"
}
