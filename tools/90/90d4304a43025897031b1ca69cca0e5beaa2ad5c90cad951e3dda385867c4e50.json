{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "CSV to JSON"
 },
 "description": "Convert CSV, TSV, semicolon, or pipe-delimited text into structured JSON with bounded row output.",
 "inputSchema": {
  "properties": {
   "csv": {
    "description": "Delimited text, up to 100 KB.",
    "type": "string"
   },
   "delimiter": {
    "description": "Delimiter name. Default comma.",
    "enum": [
     "comma",
     "tab",
     "semicolon",
     "pipe"
    ],
    "type": "string"
   },
   "header": {
    "description": "Use the first row as object keys. Default true.",
    "type": "boolean"
   },
   "max_rows": {
    "description": "Maximum data rows to return. Default 100.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "csv"
  ],
  "type": "object"
 },
 "name": "csv_to_json"
}
