{
 "_meta": {
  "stackfacts/http": "GET /v1/package/{ecosystem}/{name}",
  "stackfacts/keywords": [
   "package metadata",
   "latest version",
   "npm package",
   "PyPI package",
   "package licence",
   "SPDX licence",
   "deprecated package",
   "yanked release"
  ],
  "stackfacts/paid": true,
  "stackfacts/price_usd": "0.003"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get an npm or PyPI package's latest version, publish dates, deprecation or yank, SPDX licence, repository and runtime range.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "ecosystem": {
    "description": "npm or pypi",
    "enum": [
     "npm",
     "pypi"
    ],
    "type": "string"
   },
   "name": {
    "description": "Package name, e.g. express, requests; a scoped npm name is URL-encoded in the path (%40types%2Fnode)",
    "maxLength": 214,
    "minLength": 1,
    "pattern": "^@?[A-Za-z0-9][A-Za-z0-9._~/-]*$",
    "type": "string"
   },
   "version": {
    "description": "Version to describe (npm: or a dist-tag); default the latest",
    "maxLength": 64,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9.+_!-]*$",
    "type": "string"
   }
  },
  "required": [
   "ecosystem",
   "name"
  ],
  "type": "object"
 },
 "name": "stackfacts_package_card"
}
