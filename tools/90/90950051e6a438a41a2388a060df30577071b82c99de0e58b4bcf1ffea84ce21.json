{
 "description": "List all known vulnerabilities for a specific package version, grouped by severity with fix versions and advisory links.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "default": "npm",
    "description": "Package ecosystem (default: npm)",
    "enum": [
     "npm",
     "pypi",
     "go",
     "maven",
     "cargo",
     "nuget",
     "rubygems",
     "pub"
    ],
    "type": "string"
   },
   "name": {
    "description": "Package name (e.g. express, lodash)",
    "type": "string"
   },
   "version": {
    "description": "Package version (e.g. 4.18.2)",
    "type": "string"
   }
  },
  "required": [
   "name",
   "version"
  ],
  "type": "object"
 },
 "name": "hound_vulns"
}
