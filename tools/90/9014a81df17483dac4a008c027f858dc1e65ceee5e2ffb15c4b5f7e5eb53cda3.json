    "description": "Control-plane base URL. Configured credentials may only be used on their configured origin; defaults to https://api.thalovant.com.",
    "format": "uri",
    "type": "string"
   },
   "clearExpiresAt": {
    "type": "boolean"
   },
   "consentScope": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "consentVersion": {
