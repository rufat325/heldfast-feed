{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Flights"
 },
 "description": "Searches flights between two airports (IATA codes such as JFK or LHR) on a departure date, with an optional return date, cabin class, passenger count, maximum price and nonstop filter. Results come from Duffel and include airline, flight numbers, times, stops, duration, fare, baggage and refundability. Searching does not reserve anything or charge anyone.",
 "inputSchema": {
  "properties": {
   "cabin_class": {
    "description": "Cabin class (default: economy)",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "departure_date": {
    "description": "Departure date (YYYY-MM-DD)",
    "type": "string"
   },
   "destination": {
    "description": "IATA destination airport code",
    "type": "string"
   },
   "max_price_usd": {
    "description": "Maximum total price in USD",
    "type": "number"
   },
   "nonstop_only": {
    "description": "Only show nonstop flights (default: false)",
    "type": "boolean"
   },
   "origin": {
    "description": "IATA origin airport code (e.g., 'MIA', 'JFK', 'LAX')",
    "type": "string"
   },
   "passengers": {
    "description": "Number of passengers (1-9, default: 1)",
    "type": "number"
   },
   "return_date": {
    "description": "Return date for round-trip (YYYY-MM-DD). Omit for one-way.",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departure_date"
  ],
  "type": "object"
 },
 "name": "search_flights",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [],
   "type": "oauth2"
  }
 ]
}
