{
 "description": "Show recent logged changes for a site (from log_change / `fleets log`).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "since": {
    "description": "time range e.g. 7d, 30d (default 30d)",
    "type": "string"
   },
   "slug": {
    "description": "site slug (from list_sites)",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "recall"
}
