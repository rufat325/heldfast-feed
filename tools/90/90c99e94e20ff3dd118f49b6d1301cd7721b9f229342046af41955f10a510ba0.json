{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Combine Oman property market comparables, price positioning and rental-yield calculations into one investment report. When: Use when an agent needs one structured investment analysis for a property rather than separate market and calculator calls. Selection: specialized; prefer for Use when an agent needs one structured investment analysis for a property rather than separate market and calculator calls.. Input is a strict JSON object; see the schema. Price: $0.75 USD per call. No free preview is advertised for this capability.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "financials": {
    "additionalProperties": false,
    "properties": {
     "annualRent": {
      "minimum": 0,
      "type": "number"
     },
     "maintenance": {
      "minimum": 0,
      "type": "number"
     },
     "maintenanceCost": {
      "minimum": 0,
      "type": "number"
     },
     "otherAnnualCosts": {
      "minimum": 0,
      "type": "number"
     },
     "propertyValue": {
      "minimum": 0,
      "type": "number"
     },
     "serviceCharge": {
      "minimum": 0,
      "type": "number"
     },
     "vacancyRatePct": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "property": {
    "additionalProperties": false,
    "properties": {
     "area": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "askingPriceOMR": {
      "maximum": 1000000000,
      "minimum": 1000,
      "type": "number"
     },
     "bathrooms": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     },
     "bedrooms": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     },
     "furnished": {
      "enum": [
       "furnished",
       "semi_furnished",
       "unfurnished"
      ],
      "type": "string"
     },
     "governorate": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "optionalAnnualMaintenanceOMR": {
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     "optionalAnnualServiceChargeOMR": {
      "maximum": 1000000000,
      "minimum": 0,
      "type": "number"
     },
     "propertyType": {
      "enum": [
       "apartment",
       "villa",
       "townhouse"
      ],
      "type": "string"
     },
     "sizeSqm": {
      "maximum": 5000,
      "minimum": 10,
      "type": "number"
     },
     "wilayat": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "governorate",
     "area",
     "propertyType",
     "sizeSqm",
     "askingPriceOMR"
    ],
    "type": "object"
   }
  },
  "required": [
   "property"
  ],
  "type": "object"
 },
 "name": "property_investment_report",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {},
   "workflow": {
    "type": "string"
   }
  },
  "required": [
   "workflow",
   "result",
   "limitations"
  ],
  "type": "object"
 }
}
