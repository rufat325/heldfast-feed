{
 "description": "Manage mounts (volumes, bind mounts, files) attached to services. Mount changes require a redeploy of the parent service to take effect. create: type+mountPath+serviceId+serviceType (+volumeName for volume, +hostPath for bind, +filePath+content for file). update: mountId (+any field). remove: mountId. get: mountId. listByServiceId: serviceType+serviceId. allNamedByApplicationId: applicationId (named volumes only). serviceType: application|postgres|mysql|mariadb|mongo|redis|compose|libsql.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "create",
     "update",
     "remove",
     "get",
     "listByServiceId",
     "allNamedByApplicationId"
    ],
    "type": "string"
   },
   "applicationId": {
    "type": "string"
   },
   "composeId": {
    "type": "string"
   },
   "content": {
    "description": "File contents for type=file",
    "type": "string"
   },
   "filePath": {
    "description": "Required for type=file",
    "type": "string"
   },
   "hostPath": {
    "description": "Required for type=bind",
    "type": "string"
   },
   "libsqlId": {
    "type": "string"
   },
   "mariadbId": {
    "type": "string"
   },
   "mongoId": {
    "type": "string"
   },
   "mountId": {
    "type": "string"
   },
   "mountPath": {
    "description": "Path inside the container",
    "type": "string"
   },
   "mysqlId": {
    "type": "string"
   },
   "postgresId": {
    "type": "string"
   },
   "redisId": {
    "type": "string"
   },
   "serviceId": {
    "description": "ID of the service the mount attaches to",
    "type": "string"
   },
   "serviceType": {
    "enum": [
     "application",
     "postgres",
     "mysql",
     "mariadb",
     "mongo",
     "redis",
     "compose",
     "libsql"
    ],
    "type": "string"
   },
   "type": {
    "description": "bind | volume | file",
    "enum": [
     "bind",
     "volume",
     "file"
    ],
    "type": "string"
   },
   "volumeName": {
    "description": "Required for type=volume",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "dokploy_mounts"
}
