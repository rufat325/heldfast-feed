{
 "description": "Manage a persistent per-project task queue. Tasks survive index resets. Actions: create, list, list_tree, get, update, complete, delete, from_audit (create tasks from audit violations with deduplication).",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform. One of: create, list, list_tree, get, update, complete, delete, from_audit.",
    "enum": [
     "create",
     "list",
     "list_tree",
     "get",
     "update",
     "complete",
     "delete",
     "from_audit"
    ],
    "type": "string"
   },
   "actionableOnly": {
    "description": "Only open + unblocked.",
    "type": "boolean"
   },
   "analyzers": {
    "description": "Filter violations by analyzer name.",
    "type": "array"
   },
   "auditJobId": {
    "description": "Audit job ID. Omit to use most recent completed audit.",
    "type": "string"
   },
   "blockedBy": {
    "description": "Blocking task IDs.",
    "type": "array"
   },
   "description": {
    "description": "Longer description.",
    "type": "string"
   },
   "dueAt": {
    "description": "ISO 8601 due datetime.",
    "type": "string"
   },
   "hasChildren": {
    "description": "Filter by subtask presence.",
    "type": "boolean"
   },
   "label": {
    "description": "Filter by label.",
    "type": "string"
   },
   "labels": {
    "description": "String tags.",
    "type": "array"
   },
   "limit": {
    "description": "Max results (default 500).",
    "type": "number"
   },
   "metadata": {
    "description": "Arbitrary JSON.",
    "type": "object"
   },
   "mode": {
    "description": "Delete mode.",
    "enum": [
     "reject",
     "detach",
     "cascade"
    ],
    "type": "string"
   },
   "overdueOnly": {
    "description": "Only overdue tasks.",
    "type": "boolean"
   },
   "parentTaskId": {
    "description": "Optional parent.",
    "type": "string"
   },
   "patch": {
    "description": "Partial fields to update.",
    "type": "object"
   },
   "paths": {
    "description": "Filter violations by file path globs.",
    "type": "array"
   },
   "priority": {
    "description": "Priority.",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "projectPath": {
    "description": "Project root.",
    "type": "string"
   },
   "query": {
    "description": "Text search across title/description.",
    "type": "string"
   },
   "relatedFiles": {
    "description": "File paths.",
    "type": "array"
   },
   "relatedSymbols": {
    "description": "Symbol names.",
    "type": "array"
   },
   "severities": {
    "description": "Severities to include (default: critical, severe).",
    "type": "array"
   },
   "sortOrder": {
    "description": "Sort position (default 0).",
    "type": "number"
   },
   "source": {
    "description": "Provenance.",
    "enum": [
     "manual",
     "audit",
     "mcp"
    ],
    "type": "string"
   },
   "status": {
    "description": "Initial status.",
    "enum": [
     "pending",
     "in_progress",
     "blocked",
     "done",
     "cancelled"
    ],
    "type": "string"
   },
   "taskId": {
    "description": "Task ID.",
    "type": "string"
   },
   "title": {
    "description": "Task title.",
    "type": "string"
   }
  },
  "required": [
   "action",
   "title",
   "taskId",
   "patch"
  ],
  "type": "object"
 },
 "name": "tasks"
}
