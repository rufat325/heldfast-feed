 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Sprawd\u017a terminy"
 },
 "description": "PURPOSE: Returns real, currently free appointment slots for a quote_id (new booking) or for an existing booking_reference (rescheduling, needs customer_grant).\nWHEN TO USE: When the customer asks when we can come, after calculate_quote. wanted.type: asap (earliest), date (one day), range (from-to), preferred (a day + nearby days, sorted by preferred_time); optional part_of_day. If type is omitted it follows the fields given (date -> date, from/to -> range, nothing -> asap).\nWHEN NOT TO USE: Never to book - it reserves nothing and holds no slot.\nREQUIRED: quote_id (or booking_reference + customer_grant). Dates as YYYY-MM-DD, Polish time.\nSIDE EFFECTS: none (read-only; slot_id values are valid ~15 minutes).\nRESULT: slots found -> success=true, slots[]. None in the requested period -> success=false, error=\"no_availability\", next_available (date or null) and alternative_slots[] - offer those. Past date -> error date_in_past; beyond the online booking horizon -> error date_out_of_range. Never invent a slot.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "booking_reference": {
    "description": "Existing booking to reschedule (requires customer_grant)",
    "maxLength": 20,
    "minLength": 8,
    "pattern": "^[A-Za-z0-9\\-]{8,20}$",
    "type": "string"
   },
   "customer_grant": {
    "description": "customer_grant returned by verify_phone_code",
    "maxLength": 80,
    "minLength": 20,
    "type": "string"
   },
   "quote_id": {
    "description": "quote_id from calculate_quote (new booking)",
    "maxLength": 40,
    "minLength": 28,
    "pattern": "^q_[0-9a-z]{26}$",
    "type": "string"
   },
   "session_id": {
    "description": "Optional. session_id from the previous result, if you have it. The server also recovers the session from quote_id / slot_id / confirmation_id / customer_grant.",
    "maxLength": 40,
    "minLength": 28,
    "pattern": "^as_[0-9a-z]{26}$",
    "type": "string"
   },
   "wanted": {
    "additionalProperties": false,
    "description": "Optional preference; empty = earliest slots",
    "properties": {
     "date": {
      "description": "YYYY-MM-DD (for date / preferred)",
      "maxLength": 10,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "from": {
      "description": "YYYY-MM-DD (for range)",
      "maxLength": 10,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "part_of_day": {
      "description": "morning <12:00, afternoon 12-16, evening >=16:00",
      "enum": [
       "morning",
       "afternoon",
       "evening"
      ],
      "type": "string"
     },
     "preferred_time": {
      "maxLength": 5,
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     "to": {
      "description": "YYYY-MM-DD (for range, max 30 days)",
      "maxLength": 10,
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "type": {
      "enum": [
       "asap",
       "date",
       "range",
       "preferred"
      ],
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "check_availability",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "alternative_slots": {
    "items": {
     "properties": {
      "date": {
       "type": "string"
      },
      "priority_fee": {
       "type": "number"
      },
      "slot_id": {
       "type": "string"
      },
      "start_at": {
       "type": "string"
      },
      "time": {
       "type": "string"
      },
      "total": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "code": {
    "type": "string"
   },
   "error": {
    "description": "Stable machine-readable error id when success=false, e.g. missing_required_fields, unsupported_postcode, no_availability",
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "missing_fields": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "next_available": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": "string"
   },
   "searched": {
    "type": "object"
   },
   "session_id": {
    "type": "string"
   },
   "slots": {
    "items": {
     "properties": {
      "date": {
       "type": "string"
      },
      "priority_fee": {
       "type": "number"
      },
      "slot_id": {
       "type": "string"
      },
      "start_at": {
       "type": "string"
      },
      "time": {
       "type": "string"
      },
      "total": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "description": "true = operation done / data returned; false = see error",
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
