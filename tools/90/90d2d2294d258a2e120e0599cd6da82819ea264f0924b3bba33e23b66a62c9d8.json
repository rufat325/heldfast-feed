{
 "description": "A picture of the model as Mermaid, from its edges or its schemas. Use to show connections; for edges as data use list_references. Input: `shape`; `id`, `domain` or `type` narrow it. Returns `mermaid`, `nodes`, `links`, `title`, `edges`, `omitted`, schema's `everyType`. A process draws each gate's failure dashed, to a phase or one Stop node, outside `nodes`. At most 50 nodes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "A domain's id, to draw its concepts",
    "type": "string"
   },
   "id": {
    "description": "The process to draw, or the entity at the middle of a neighborhood",
    "type": "string"
   },
   "shape": {
    "enum": [
     "concepts",
     "process",
     "neighborhood",
     "schema"
    ],
    "type": "string"
   },
   "type": {
    "description": "A type, to draw its schema and the types it is declared with",
    "type": "string"
   }
  },
  "required": [
   "shape"
  ],
  "type": "object"
 },
 "name": "diagram",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "edges": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "everyType": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "multiplicity": {
       "type": "string"
      },
      "to": {
       "type": "string"
      },
      "via": {
       "type": "string"
      }
     },
     "required": [
      "via",
      "to",
      "multiplicity"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "links": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "from": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "mermaid": {
    "type": "string"
   },
   "model": {
    "additionalProperties": false,
    "properties": {
     "commit": {
      "type": [
       "string",
       "null"
      ]
     },
     "core": {
      "type": "string"
     },
     "parser": {
      "type": "string"
     },
     "repo": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "commit",
     "repo",
     "core",
     "parser"
    ],
    "type": "object"
   },
   "nodes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "node": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "node",
      "id",
      "title",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "omitted": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "shape": {
    "enum": [
     "concepts",
     "process",
     "neighborhood",
     "schema"
    ],
    "type": "string"
   },
   "title": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "shape",
   "title",
   "mermaid",
   "nodes",
   "links",
   "edges",
   "omitted",
   "model"
  ],
  "type": "object"
 }
}
