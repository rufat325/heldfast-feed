{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Calculate a non-binding, non-persisted transfer quote. This tool cannot hold, book, message, cancel, or charge.",
 "inputSchema": {
  "$defs": {
   "Luggage": {
    "properties": {
     "carry_on": {
      "minimum": 0,
      "title": "Carry On",
      "type": "integer"
     },
     "checked": {
      "minimum": 0,
      "title": "Checked",
      "type": "integer"
     }
    },
    "required": [
     "checked",
     "carry_on"
    ],
    "title": "Luggage",
    "type": "object"
   },
   "TransferLocation": {
    "properties": {
     "address": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Address"
     },
     "google_place_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Google Place Id"
     },
     "hotel_place_id": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Hotel Place Id"
     },
     "iata": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Iata"
     },
     "type": {
      "enum": [
       "airport",
       "hotel",
       "address"
      ],
      "title": "Type",
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "title": "TransferLocation",
    "type": "object"
   }
  },
  "properties": {
   "agent_session_id": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._:-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Agent Session Id"
   },
   "agent_source": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._:-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Agent Source"
   },
   "child_seats": {
    "default": 0,
    "maximum": 6,
    "minimum": 0,
    "title": "Child Seats",
    "type": "integer"
   },
   "children": {
    "default": 0,
    "minimum": 0,
    "title": "Children",
    "type": "integer"
   },
   "customer_preferred_currency": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Customer Preferred Currency"
   },
   "datetime_local": {
    "title": "Datetime Local",
    "type": "string"
   },
   "distance_km": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Distance Km"
   },
   "dropoff": {
    "$ref": "#/$defs/TransferLocation"
   },
   "flight_number": {
    "anyOf": [
     {
      "maxLength": 30,
      "pattern": "^[a-zA-Z0-9 .-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Flight Number"
   },
   "luggage": {
    "$ref": "#/$defs/Luggage"
   },
   "market": {
    "default": "FJ",
    "maxLength": 2,
    "minLength": 2,
    "title": "Market",
    "type": "string"
   },
   "passengers": {
    "maximum": 20,
    "minimum": 1,
    "title": "Passengers",
    "type": "integer"
   },
   "pickup": {
    "$ref": "#/$defs/TransferLocation"
   },
   "quote_currency": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Quote Currency"
   },
   "route_code": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 2,
      "pattern": "^[a-z0-9_]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Route Code"
   },
   "vehicle_class": {
    "enum": [
     "sedan",
     "suv",
     "van",
     "car_4",
     "van_4",
     "van_8",
     "van_12",
     "luxury_car",
     "coaster_22",
     "shared_coach",
     "standard_car",
     "golf_car",
     "executive_minibus",
     "family_minibus",
     "deluxe_suv",
     "luxury_family",
     "luxury_suv"
    ],
    "title": "Vehicle Class",
    "type": "string"
   }
  },
  "required": [
   "pickup",
   "dropoff",
   "datetime_local",
   "passengers",
   "luggage",
   "vehicle_class"
  ],
  "title": "QuoteRequest",
  "type": "object"
 },
 "name": "preview_transfer_quote",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "booking_eligible_from_preview": {
    "const": false,
    "type": "boolean"
   },
   "market": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "persisted": {
    "const": false,
    "type": "boolean"
   },
   "preview": {
    "const": true,
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "market",
   "status",
   "preview",
   "persisted",
   "booking_eligible_from_preview",
   "next_action"
  ],
  "type": "object"
 },
 "title": "Preview an airport transfer quote"
}
