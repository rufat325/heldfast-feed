{
 "description": "Get detailed information and statistics about a GitHub repository",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "owner": {
    "description": "Repository owner",
    "minLength": 1,
    "type": "string"
   },
   "repo": {
    "description": "Repository name",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "github_repo_info"
}
