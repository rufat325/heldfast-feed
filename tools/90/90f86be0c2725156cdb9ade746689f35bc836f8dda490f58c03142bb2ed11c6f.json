{
 "description": "Write an SXO-optimized blog post using the self-improving content engine.\nEach post learns from the performance of previous posts and improves.\n\nUses: BLUF architecture, Table Trap, Information Gain, Schema markup.\n\nExample: sxo_write({ topic: \"How to use MCP servers with Claude\", keywords: [\"MCP\", \"Claude\", \"AI automation\"] })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "keywords": {
    "description": "Target keywords",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "post_to_devto": {
    "description": "Also post to Dev.to (default: false)",
    "type": "boolean"
   },
   "publish": {
    "description": "Auto-publish to blog_posts table (default: false)",
    "type": "boolean"
   },
   "style": {
    "description": "Content style",
    "enum": [
     "guide",
     "tutorial",
     "comparison",
     "case_study",
     "news"
    ],
    "type": "string"
   },
   "target_word_count": {
    "description": "Target word count (default: 1000)",
    "type": "number"
   },
   "topic": {
    "description": "Blog post topic",
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "sxo_write"
}
