{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the taste profile. Use this before creating slides, an interface, an image or any design for a user who has a profile_key, to read the style rules they saved. Returns the saved rules and palette, when they were saved, and the names of the references behind them. Status empty means nothing has been saved yet: use describe_style and ask the user to confirm rules.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "profile_key": {
    "description": "The profile_key that add_refs returned. Keep it: it is the only way back to this profile and it is not recoverable.",
    "pattern": "^tp_[0-9a-f]{32}$",
    "type": "string"
   }
  },
  "required": [
   "profile_key"
  ],
  "type": "object"
 },
 "name": "get_profile",
 "outputSchema": {
  "properties": {
   "as_of": {
    "description": "UTC date of this answer.",
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "profile": {
    "properties": {
     "avoid": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "hierarchy": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "layout": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "palette": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "texture": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "type": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "refs": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "ref_id": {
       "type": "string"
      }
     },
     "required": [
      "ref_id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "refs_total": {
    "type": "integer"
   },
   "retention": {
    "type": "string"
   },
   "saved_day": {
    "type": [
     "string",
     "null"
    ]
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "profile",
   "saved_day",
   "refs",
   "refs_total",
   "retention",
   "source",
   "as_of",
   "notice"
  ],
  "type": "object"
 },
 "title": "Read the taste profile"
}
