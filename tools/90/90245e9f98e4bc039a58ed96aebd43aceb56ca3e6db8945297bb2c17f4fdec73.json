{
 "_meta": {
  "openai/toolInvocation/invoked": "Sharing updated",
  "openai/toolInvocation/invoking": "Updating who can open it\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Share an Artifact"
 },
 "description": "Set who can open an Artifact you own. audience picks the rule; share_with is the complete list of named people (it replaces the previous list; omit it to keep the current one). Going public deletes every comment thread, so a public change on an Artifact with threads is refused unless delete_threads is true. Returns the URL to send.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact_id": {
    "description": "The Artifact id (art_\u2026).",
    "pattern": "^art_[a-zA-Z0-9]+$",
    "type": "string"
   },
   "audience": {
    "description": "Who can open the link. owner: only you. users: the people in share_with. public: anyone with the link.",
    "enum": [
     "owner",
     "users",
     "public"
    ],
    "type": "string"
   },
   "delete_threads": {
    "description": "Allow going public on an Artifact that has comment threads, deleting them.",
    "type": "boolean"
   },
   "listed": {
    "description": "Show it in listings (the org library, public discovery) rather than link-only. Default false.",
    "type": "boolean"
   },
   "share_with": {
    "description": "People to grant access by email (or uid), with a role. [{ \"email\": \"ana@acme.com\", \"role\": \"viewer\" }]. viewer opens it; editor can also publish new content. Implies audience \"users\" when audience is omitted.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "email": {
       "description": "The person's account email.",
       "type": "string"
      },
      "role": {
       "description": "Default viewer.",
       "enum": [
        "viewer",
        "editor"
       ],
       "type": "string"
      },
      "uid": {
       "description": "Their Bisque uid, if known.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "artifact_id",
   "audience"
  ],
  "type": "object"
 },
 "name": "share_artifact",
 "outputSchema": {
  "properties": {
   "artifact_id": {
    "type": "string"
   },
   "audience_mode": {
    "type": "string"
   },
   "discoverability": {
    "enum": [
     "unlisted",
     "listed"
    ],
    "type": "string"
   },
   "external_sharing_allowed": {
    "type": "boolean"
   },
   "grants": {
    "items": {
     "properties": {
      "email": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "principal": {
       "properties": {
        "id": {
         "type": "string"
        },
        "type": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "role": {
       "enum": [
        "viewer",
        "editor"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "public_sharing_allowed": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "artifact_id",
   "audience_mode",
   "discoverability",
   "grants",
   "url"
  ],
  "type": "object"
 },
 "title": "Share an Artifact"
}
