{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "grading:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Adjust an FRQ part score"
 },
 "description": "Changes the points on one rubric part of an AI-scored FRQ in a submission, with the teacher's reason, as on the website. The section's score is recalculated. Reversal restores the previous part points.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "description": "Assignment id from list_coursework or list_submissions_to_review.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "itemId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "part": {
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   },
   "points": {
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "reason": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "reasonCategory": {
    "default": "teacher-judgment",
    "enum": [
     "evidence",
     "reasoning",
     "accuracy",
     "rubric",
     "teacher-judgment",
     "other"
    ],
    "type": "string"
   },
   "submissionId": {
    "description": "Submission id from list_submissions_to_review.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "submissionId",
   "itemId",
   "part",
   "points",
   "reasonCategory",
   "reason"
  ],
  "type": "object"
 },
 "name": "override_submission_part",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "grading:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Adjust an FRQ part score"
}
