{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a reproducible Verity API or MCP bug, missing capability or data-quality report for human review. Requires a developer API key and an enabled feedback service. Include the failed call's requestId when available. Do not send secrets, personal information or conversation transcripts. Saves a private report; does not change prices, start trades or open or merge a PR. Returns a tracking receipt only after storage succeeds.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actual": {
    "maxLength": 1200,
    "minLength": 3,
    "type": "string"
   },
   "category": {
    "enum": [
     "bug",
     "missing_capability",
     "data_quality"
    ],
    "type": "string"
   },
   "expected": {
    "maxLength": 1200,
    "minLength": 3,
    "type": "string"
   },
   "observedAt": {
    "format": "date-time",
    "type": "string"
   },
   "reproduction": {
    "items": {
     "maxLength": 500,
     "minLength": 3,
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "requestId": {
    "maxLength": 96,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]+$",
    "type": "string"
   },
   "surface": {
    "enum": [
     "get_index_price",
     "get_index_batch",
     "list_index_assets",
     "get_settlement_print",
     "verify_print",
     "/api/index/v1/price",
     "/api/index/v1/batch",
     "/api/index/v1/print",
     "/api/index/v1/verity/catalog",
     "/api/index/v1/pubkey",
     "/api/index/v1/sample",
     "/api/index/v1/history",
     "/api/index/v1/metadata",
     "/api/index/v1/research/compare",
     "/api/index/v1/source-health",
     "/api/index/v1/verity/price",
     "/api/index/v1/verity/batch",
     "/api/index/mcp"
    ],
    "type": "string"
   },
   "symbol": {
    "maxLength": 48,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:/-]+$",
    "type": "string"
   }
  },
  "required": [
   "category",
   "surface",
   "expected",
   "actual",
   "reproduction"
  ],
  "type": "object"
 },
 "name": "submit_verity_feedback",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "duplicate": {
    "type": "boolean"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "accountUrl": {
      "const": "https://thepulse.markets/developers/access",
      "type": "string"
     },
     "code": {
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
      "type": "string"
     },
     "nextAction": {
      "enum": [
       "wait",
       "review_access",
       "check_limits",
       "reconnect",
       "check_input",
       "choose_another_symbol",
       "report_issue"
      ],
      "type": "string"
     },
     "retryAfterSeconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "nextAction"
    ],
    "type": "object"
   },
   "feedback": {
    "additionalProperties": false,
    "properties": {
     "expiresAt": {
      "format": "date-time",
      "type": "string"
     },
     "id": {
      "pattern": "^vf_[a-f0-9]{32}$",
      "type": "string"
     },
     "receivedAt": {
      "format": "date-time",
      "type": "string"
     },
     "status": {
      "enum": [
       "received",
       "triaged",
       "in_progress",
       "resolved",
       "closed"
      ],
      "type": "string"
     },
     "updatedAt": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "id",
     "status",
     "receivedAt",
     "updatedAt",
     "expiresAt"
    ],
    "type": "object"
   },
   "requestId": {
    "description": "Identifier for this MCP call; not a signed price field.",
    "format": "uuid",
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "title": "Submit Verity Feedback"
}
