{
 "description": "Rank official indicators; returns match evidence, retrieval health and source failures.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "title": "Limit",
    "type": "integer"
   },
   "query": {
    "title": "Query",
    "type": "string"
   },
   "source_ids": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Source Ids"
   }
  },
  "required": [
   "query"
  ],
  "title": "search_indicatorsArguments",
  "type": "object"
 },
 "name": "search_indicators",
 "outputSchema": {
  "$defs": {
   "IndicatorSearchResult": {
    "properties": {
     "available_dimensions": {
      "items": {
       "type": "string"
      },
      "title": "Available Dimensions",
      "type": "array"
     },
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Description"
     },
     "frequency": {
      "default": "unknown",
      "enum": [
       "annual",
       "quarterly",
       "monthly",
       "other",
       "unknown"
      ],
      "title": "Frequency",
      "type": "string"
     },
     "match_reason": {
      "items": {
       "type": "string"
      },
      "title": "Match Reason",
      "type": "array"
     },
     "match_score": {
      "title": "Match Score",
      "type": "number"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "retrievable": {
      "default": true,
      "title": "Retrievable",
      "type": "boolean"
     },
     "retrieval_health": {
      "default": "available",
      "enum": [
       "live_tested",
       "available",
       "token_required",
       "metadata_only",
       "unknown"
      ],
      "title": "Retrieval Health",
      "type": "string"
     },
     "series_code": {
      "title": "Series Code",
      "type": "string"
     },
     "series_ref": {
      "title": "Series Ref",
      "type": "string"
     },
     "source_id": {
      "title": "Source Id",
      "type": "string"
     },
     "source_note": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Note"
     },
     "source_organization": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Organization"
     },
     "source_unit": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source Unit"
     },
     "source_url": {
      "title": "Source Url",
      "type": "string"
     },
     "topics": {
      "items": {
       "type": "string"
      },
      "title": "Topics",
      "type": "array"
     },
     "unit": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Unit"
     }
    },
    "required": [
     "series_ref",
     "source_id",
     "series_code",
     "name",
     "source_url",
     "match_score"
    ],
    "title": "IndicatorSearchResult",
    "type": "object"
   },
   "SourceError": {
    "properties": {
     "error_code": {
      "title": "Error Code",
      "type": "string"
     },
     "message": {
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     },
     "series_ref": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Series Ref"
     },
     "source_id": {
      "title": "Source Id",
      "type": "string"
     },
     "suggested_action": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Suggested Action"
     }
    },
    "required": [
     "source_id",
     "error_code",
     "message"
    ],
    "title": "SourceError",
    "type": "object"
   }
  },
  "properties": {
   "cache_hit": {
    "default": false,
    "title": "Cache Hit",
    "type": "boolean"
   },
   "cached_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Cached At"
   },
   "failed_sources": {
    "items": {
     "$ref": "#/$defs/SourceError"
    },
    "title": "Failed Sources",
    "type": "array"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/IndicatorSearchResult"
    },
    "title": "Results",
    "type": "array"
   },
   "total": {
    "title": "Total",
    "type": "integer"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "title": "Warnings",
    "type": "array"
   }
  },
  "required": [
   "results",
   "total"
  ],
  "title": "SearchResponse",
  "type": "object"
 }
}
