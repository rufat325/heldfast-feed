{
 "description": "Search tasks for a location with filters and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "assignedTo": {
    "description": "Filter by assigned user ID",
    "type": "string"
   },
   "completed": {
    "description": "Filter by completion status",
    "type": "boolean"
   },
   "contactId": {
    "description": "Filter tasks by contact ID",
    "type": "string"
   },
   "dueDate": {
    "description": "Filter by due date (ISO 8601 format)",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results to return",
    "type": "number"
   },
   "locationId": {
    "description": "The location ID to search tasks in",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "skip": {
    "description": "Number of results to skip for pagination",
    "type": "number"
   },
   "status": {
    "description": "Filter by task status",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_search_location_tasks"
}
