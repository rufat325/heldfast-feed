{
 "description": "Apply a text or image watermark to a PDF. For type='text' provide 'text'; for type='image' provide 'watermarkImagePath'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "description": "The source document ID",
    "type": "string"
   },
   "font": {
    "description": "Standard PDF font name",
    "enum": [
     "times-roman",
     "times-bold",
     "times-italic",
     "times-bolditalic",
     "helvetica",
     "helvetica-bold",
     "helvetica-oblique",
     "helvetica-boldoblique",
     "courier",
     "courier-bold",
     "courier-oblique",
     "courier-boldoblique"
    ],
    "type": "string"
   },
   "fontColor": {
    "description": "Font colour as hex e.g. '#FF0000'",
    "type": "string"
   },
   "fontFilePath": {
    "description": "Local path to a .ttf/.otf font file (overrides 'font')",
    "type": "string"
   },
   "fontSize": {
    "description": "Font size in points",
    "type": "number"
   },
   "imageHeight": {
    "description": "Image watermark height",
    "type": "number"
   },
   "imageWidth": {
    "description": "Image watermark width",
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Custom metadata to attach",
    "type": "object"
   },
   "opacity": {
    "description": "Opacity 0\u20131",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "preSignedUrlExpiresIn": {
    "description": "Pre-signed download URL expiry in seconds (60\u201386400)",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "rotate": {
    "description": "Rotation in degrees (0\u2013360)",
    "maximum": 360,
    "minimum": 0,
    "type": "number"
   },
   "text": {
    "description": "Watermark text (required when type='text')",
    "type": "string"
   },
   "type": {
    "description": "Watermark type",
    "enum": [
     "text",
     "image"
    ],
    "type": "string"
   },
   "watermarkImagePath": {
    "description": "Local path to a .png/.jpg watermark image (required when type='image')",
    "type": "string"
   },
   "xPosition": {
    "description": "Horizontal position",
    "type": "number"
   },
   "yPosition": {
    "description": "Vertical position",
    "type": "number"
   }
  },
  "required": [
   "documentId",
   "type"
  ],
  "type": "object"
 },
 "name": "watermark_pdf"
}
