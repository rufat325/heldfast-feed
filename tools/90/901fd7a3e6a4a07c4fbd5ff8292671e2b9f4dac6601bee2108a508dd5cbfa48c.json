  "properties": {
   "AdditionalInformation": {
    "type": "string"
   },
   "Address": {
    "description": "Full address, or send the components below instead.",
    "type": "string"
   },
   "Archived": {
    "type": "boolean"
   },
   "City": {
    "type": "string"
   },
   "ClientId": {
    "description": "Update this existing client.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "Country": {
    "type": "string"
   },
   "CustomFields": {
    "description": "Custom field values (FieldId + Value).",
    "items": {
     "properties": {
      "FieldId": {
       "description": "The custom field's id.",
       "minLength": 1,
       "type": "string"
      },
      "Text": {
       "description": "The field's label (optional).",
       "type": "string"
      },
      "Value": {
       "description": "The value to store.",
       "type": "string"
      }
     },
     "required": [
      "FieldId",
      "Value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "DateOfBirth": {
    "description": "Unix timestamp in ms.",
    "maximum": 9007199254740991,
