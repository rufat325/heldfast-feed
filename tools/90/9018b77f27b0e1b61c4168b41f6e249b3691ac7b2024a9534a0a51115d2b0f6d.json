{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Watch any TRON address for TRC20 transfers (USDT, USDC, USDD, or any token). Fires webhook on each matching transfer. Persistent - runs 24/7 even when conversation ends.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "TRON address to watch (T...)",
    "type": "string"
   },
   "event_types": {
    "description": "Event types to watch",
    "items": {
     "enum": [
      "usdt_incoming",
      "usdt_outgoing",
      "trx_incoming"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "min_amount_usdt": {
    "description": "Minimum amount filter (default \"0\")",
    "type": "string"
   },
   "ttl_hours": {
    "description": "Watch duration in hours (1-720, default 24)",
    "type": "number"
   },
   "webhook_url": {
    "description": "Webhook URL for notifications",
    "type": "string"
   }
  },
  "required": [
   "address",
   "webhook_url"
  ],
  "type": "object"
 },
 "name": "watch_address"
}
