{
 "description": "Create a signed reserve attestation proving a delegation has actual funds (GPT #15).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "type": "number"
   },
   "assurance_class": {
    "enum": [
     "unbacked",
     "self_attested",
     "gateway_attested",
     "escrow_backed",
     "externally_attested"
    ],
    "type": "string"
   },
   "attestation_basis": {
    "enum": [
     "api_balance_check",
     "bank_statement",
     "escrow_lock",
     "self_declaration"
    ],
    "type": "string"
   },
   "attester_private_key": {
    "type": "string"
   },
   "attester_public_key": {
    "type": "string"
   },
   "charter_anchor": {
    "type": "string"
   },
   "currency": {
    "default": "USD",
    "type": "string"
   },
   "delegation_id": {
    "type": "string"
   },
   "false_attestation_penalty": {
    "default": "reputation_slash",
    "enum": [
     "reputation_slash",
     "bond_forfeit",
     "dispute_eligible",
     "none"
    ],
    "type": "string"
   },
   "office_id": {
    "type": "string"
   },
   "ttl_seconds": {
    "default": 86400,
    "type": "number"
   }
  },
  "required": [
   "delegation_id",
   "assurance_class",
   "amount",
   "attestation_basis",
   "attester_private_key",
   "attester_public_key"
  ],
  "type": "object"
 },
 "name": "create_reserve_attestation"
}
