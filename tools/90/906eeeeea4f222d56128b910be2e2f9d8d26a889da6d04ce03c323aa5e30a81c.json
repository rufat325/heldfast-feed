{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Estimate a project cost range"
 },
 "description": "Estimate the cost range for a specific software project. Uses the same calculation as the estimator on the website, so the answer matches what a person would be shown.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "audience": {
    "description": "Who will use it?",
    "enum": [
     "staff",
     "customers",
     "both"
    ],
    "type": "string"
   },
   "integrations": {
    "description": "What does it need to talk to?",
    "items": {
     "enum": [
      "payments",
      "accounting",
      "crm",
      "calendar",
      "identity",
      "legacy",
      "none"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "newOrReplacement": {
    "description": "Is this new, or replacing something?",
    "enum": [
     "new",
     "replacing",
     "rescue"
    ],
    "type": "string"
   },
   "projectType": {
    "description": "What are you building?",
    "enum": [
     "booking",
     "portal",
     "webApp",
     "aiAutomation",
     "headlessCms",
     "platform",
     "notSure"
    ],
    "type": "string"
   },
   "scale": {
    "description": "Roughly how many people will use it?",
    "enum": [
     "small",
     "medium",
     "large",
     "veryLarge"
    ],
    "type": "string"
   },
   "timeline": {
    "description": "When does it need to be live?",
    "enum": [
     "exploring",
     "sixMonths",
     "threeMonths",
     "urgent"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectType"
  ],
  "type": "object"
 },
 "name": "estimate_project",
 "title": "Estimate a project cost range"
}
