        "enum": [
         "US",
         "CA"
        ],
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "odometer_unit": {
        "enum": [
         "mi",
         "km"
        ],
        "type": "string"
       }
      },
      "required": [
       "country",
       "currency",
       "odometer_unit"
      ],
      "type": "object"
     },
     "unit": {
      "allOf": [
       {
        "description": "The public projection of one inventory unit. No source attributes, internal ids, or ingest metadata ever appear here.",
        "properties": {
         "asking_price": {
          "minimum": 0,
          "type": [
           "number",
           "null"
          ]
         },
         "body_style": {
          "maxLength": 80,
          "type": [
           "string",
           "null"
          ]
         },
         "carfax_one_owner": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "carfax_report_url": {
          "maxLength": 500,
          "type": [
           "string",
           "null"
          ]
         },
         "city_mpg": {
          "maximum": 999,
          "minimum": 1,
          "type": [
           "integer",
           "null"
          ]
         },
         "condition": {
          "description": "Normalized vehicle condition. CLOSED vocabulary: ADN normalizes every dealer feed into exactly these values at ingestion, and the database enforces them, so consumers may switch on this field exhaustively. Certification is separate \u2014 see is_certified.",
          "enum": [
           "new",
           "used"
          ]
         },
         "currency": {
          "maxLength": 3,
          "type": [
           "string",
           "null"
          ]
         },
         "description": {
          "maxLength": 10000,
          "type": [
           "string",
           "null"
          ]
         },
         "doors": {
          "maximum": 10,
          "minimum": 1,
          "type": [
           "integer",
           "null"
          ]
         },
         "drivetrain": {
          "maxLength": 80,
          "type": [
           "string",
           "null"
          ]
         },
         "effective_price": {
          "description": "An unexpired special price when present, otherwise asking price; null when neither is available.",
          "minimum": 0,
          "type": [
           "number",
           "null"
          ]
         },
         "effective_price_source": {
          "description": "The field selected for effective_price, or null when effective_price is null.",
          "enum": [
           "special_price",
           "asking_price",
           null
          ]
         },
         "engine": {
          "maxLength": 120,
          "type": [
           "string",
           "null"
          ]
         },
         "engine_cylinders": {
          "maximum": 16,
          "minimum": 1,
          "type": [
           "integer",
           "null"
          ]
         },
         "engine_displacement": {
          "maxLength": 80,
          "minLength": 1,
          "type": [
           "string",
           "null"
          ]
         },
         "exterior_color": {
          "maxLength": 80,
          "type": [
           "string",
           "null"
          ]
         },
         "fuel_type": {
          "maxLength": 80,
          "type": [
           "string",
           "null"
          ]
         },
         "highway_mpg": {
          "maximum": 999,
          "minimum": 1,
          "type": [
           "integer",
           "null"
          ]
         },
         "identity": {
          "maxLength": 30,
          "minLength": 5,
          "type": "string"
         },
         "interior_color": {
          "maxLength": 80,
          "type": [
           "string",
           "null"
          ]
         },
         "is_certified": {
          "type": [
           "boolean",
           "null"
          ]
         },
         "make": {
          "maxLength": 80,
          "type": "string"
         },
         "model": {
          "maxLength": 80,
          "type": "string"
         },
         "model_year": {
          "maximum": 2100,
          "minimum": 1950,
          "type": "integer"
         },
         "msrp": {
          "minimum": 0,
          "type": [
           "number",
           "null"
          ]
         },
         "odometer": {
          "minimum": 0,
          "type": [
           "integer",
           "null"
          ]
         },
         "odometer_unit": {
          "enum": [
           "mi",
           "km"
          ],
          "type": "string"
         },
         "options": {
          "items": {
           "maxLength": 100,
           "type": "string"
          },
          "maxItems": 100,
          "type": [
           "array",
           "null"
          ]
         },
         "passenger_capacity": {
          "maximum": 20,
          "minimum": 1,
          "type": [
           "integer",
           "null"
          ]
         },
         "photo_urls": {
          "items": {
           "maxLength": 300,
           "type": "string"
          },
          "maxItems": 60,
          "type": [
           "array",
