          ]
         },
         "price_basis": {
          "const": "dealer_published",
          "type": "string"
         },
         "provenance": {
          "additionalProperties": false,
          "properties": {
           "enriched_fields": {
            "items": {
             "enum": [
              "photo_urls",
              "options",
              "description",
              "vdp_url",
              "video_url",
              "city_mpg",
              "highway_mpg",
              "doors",
              "passenger_capacity",
              "engine_cylinders",
              "engine_displacement",
              "carfax_one_owner",
              "carfax_report_url",
              "is_certified",
              "trim",
              "body_style",
              "transmission",
              "drivetrain",
              "asking_price"
             ]
            },
            "maxItems": 19,
            "type": "array",
            "uniqueItems": true
           },
           "merch_updated_at": {
            "format": "date-time",
            "maxLength": 40,
            "type": [
             "string",
             "null"
            ]
           }
          },
          "required": [
           "merch_updated_at",
           "enriched_fields"
          ],
          "type": "object"
         },
         "special_expiry": {
          "format": "date",
          "maxLength": 10,
          "type": [
           "string",
           "null"
          ]
         },
         "special_price": {
          "minimum": 0,
          "type": [
           "number",
           "null"
          ]
         },
         "stock_number": {
          "maxLength": 40,
          "type": [
           "string",
           "null"
          ]
         },
         "transmission": {
          "maxLength": 80,
          "type": [
           "string",
           "null"
          ]
         },
         "trim": {
          "maxLength": 120,
          "type": [
           "string",
           "null"
          ]
         },
         "vdp_url": {
          "maxLength": 500,
          "type": [
           "string",
           "null"
          ]
         },
         "video_url": {
          "maxLength": 500,
          "type": [
           "string",
           "null"
          ]
         }
        },
        "required": [
         "identity",
         "condition",
         "model_year",
         "make",
         "model",
         "odometer_unit",
         "price_basis"
        ],
        "type": "object"
       },
       {
        "not": {
         "required": [
          "date_in_stock"
         ]
        }
       }
      ]
     }
    },
    "required": [
     "unit"
    ],
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "description": "Unknown and foreign thread ids are deliberately indistinguishable: both return invalid_params with message \"unknown thread_id\" (anti-enumeration).",
    "properties": {
     "auth_help_url": {
      "description": "Present only when no credential was supplied for a capability that requires one. Points to human documentation for obtaining a key. Absent for invalid, pending, or disabled credentials, which are deliberately indistinguishable.",
      "format": "uri",
      "maxLength": 500,
      "type": "string"
     },
     "code": {
      "enum": [
       "rooftop_not_found",
       "rooftop_inactive",
       "unit_not_found",
       "invalid_params",
       "rate_limited",
       "upstream_unavailable",
       "capability_unavailable",
       "identity_required",
       "quota_exceeded",
       "unit_held",
       "quote_expired",
       "rooftop_paused",
       "handoff_duplicate",
       "idempotency_conflict",
       "price_unavailable",
       "snapshot_expired",
       "artifact_too_large",
       "cursor_invalid",
       "cursor_expired",
       "ambiguous_identity",
       "unsupported_in_country"
      ]
     },
     "message": {
      "maxLength": 500,
      "type": "string"
     },
     "retry_after_seconds": {
      "minimum": 0,
      "type": "integer"
     },
