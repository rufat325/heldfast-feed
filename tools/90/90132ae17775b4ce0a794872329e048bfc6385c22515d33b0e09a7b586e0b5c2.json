{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get vehicle details"
 },
 "description": "Fetch one available unit by identity (VIN) from a named rooftop (rooftop_slug from network_search results). Returns the full detail shape \u2014 ordered photo gallery, options, plain-text description; embed the first few photo_urls as markdown images when presenting the vehicle. Unknown or ineligible identity/rooftop returns unit_not_found. Listed prices may exclude doc/government fees and tax \u2014 call quote_preview for the estimated total. Totals are estimates at best; when pricing_coverage is \"partial_estimate\", present the total as a subtotal excluding the charges in excluded. Always relay pricing_disclosure.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Optional consistency assertion: must equal the rooftop's country; omit it unless you are checking.",
    "enum": [
     "US",
     "CA"
    ],
    "type": "string"
   },
   "identity": {
    "maxLength": 30,
    "minLength": 5,
    "type": "string"
   },
   "rooftop_slug": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "identity",
   "rooftop_slug"
  ],
  "type": "object"
 },
 "name": "inventory_get",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
