{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "[DEBUG VISUAL] Temporary visual aid in the browser. Nothing to put in code.\nAdd a debug helper to an object: box, axes, skeleton, arrow, grid, camera frustum, light helpers, plane.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "description": "Hex number (default: 0x00ff00)",
    "type": "number"
   },
   "direction": {
    "description": "[x, y, z] for ArrowHelper/PlaneHelper",
    "items": {
     "type": "number"
    },
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "divisions": {
    "description": "GridHelper divisions (default: 10)",
    "type": "number"
   },
   "length": {
    "description": "ArrowHelper length (default: 1)",
    "type": "number"
   },
   "origin": {
    "description": "[x, y, z] origin for ArrowHelper",
    "items": {
     "type": "number"
    },
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "size": {
    "description": "Axes/Grid/light helper size (default: 1)",
    "type": "number"
   },
   "target": {
    "description": "Target object name",
    "type": "string"
   },
   "targetUuid": {
    "description": "Target object UUID",
    "type": "string"
   },
   "type": {
    "description": "Default: box",
    "enum": [
     "box",
     "axes",
     "skeleton",
     "arrow",
     "grid",
     "polar_grid",
     "camera",
     "directional_light",
     "spot_light",
     "point_light",
     "hemisphere_light",
     "plane"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "add_helper"
}
