{
 "description": "Bump the package version",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bump": {
    "description": "Version bump type",
    "enum": [
     "patch",
     "minor",
     "major",
     "prepatch",
     "preminor",
     "premajor",
     "prerelease"
    ],
    "type": "string"
   },
   "noGitTag": {
    "description": "Skip git tag creation",
    "type": "boolean"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "preid": {
    "description": "Prerelease identifier (e.g. alpha, beta)",
    "type": "string"
   }
  },
  "required": [
   "path",
   "bump"
  ],
  "type": "object"
 },
 "name": "version"
}
