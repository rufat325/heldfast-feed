    "type": "boolean"
   },
   "propertyId": {
    "description": "\u0427\u0438\u0441\u043b\u043e\u0432\u043e\u0439 id \u0441\u0432\u043e\u0439\u0441\u0442\u0432\u0430 GA4 (\u0438\u043b\u0438 properties/123). \u041f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e \u2014 GA4_PROPERTY_ID",
