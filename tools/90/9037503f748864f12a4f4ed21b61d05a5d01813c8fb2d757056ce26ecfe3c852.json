{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "A RecWell facility's page: description, regular hours of operation per season (one tab per semester, as tables), access rules, rental and parking information. For today's actual hours use get_facility_hours. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "facility": {
    "description": "Which facility page to read",
    "enum": [
     "eppley_recreation_center",
     "natatorium",
     "ritchie_coliseum",
     "reckord_armory",
     "regents_drive_studios",
     "severn_building_fitness_center",
     "school_of_public_health",
     "terps_esports_center",
     "outdoor_aquatic_center",
     "la_plata_beach",
     "turf_fields",
     "engineering_fields",
     "fraternity_row_fields",
     "tennis_and_pickleball_courts",
     "prince_frederick_fitness_zone",
     "bike_shop",
     "bouldering_zone",
     "climbing_wall",
     "outdoor_gear_rental"
    ],
    "type": "string"
   }
  },
  "required": [
   "facility"
  ],
  "type": "object"
 },
 "name": "recwell_get_facility",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sections": {
    "description": "Content sections in page order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "heading": {
       "description": "Section heading (an accordion title, tab title or h2); null for lead text",
       "type": [
        "string",
        "null"
       ]
      },
      "tables": {
       "description": "Tables in the section",
       "items": {
        "additionalProperties": false,
        "properties": {
         "headers": {
          "description": "Header cells; empty when the table has no header row",
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "rows": {
          "description": "Body rows as cell text",
          "items": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "type": "array"
         }
        },
        "required": [
         "headers",
         "rows"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "text": {
       "description": "The section as plain text, tables excluded",
       "type": "string"
      }
     },
     "required": [
      "heading",
      "text",
      "tables"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Page title",
    "type": "string"
   },
   "url": {
    "description": "Page URL",
    "type": "string"
   }
  },
  "required": [
   "title",
   "url",
   "sections"
  ],
  "type": "object"
 },
 "title": "Get a facility"
}
