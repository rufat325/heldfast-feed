{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get drug class members"
 },
 "description": "Get the drugs belonging to a drug class (RxClass API). RxNav REST: GET /rxclass/classMembers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "classId": {
    "description": "Class id, e.g. 'N02BE' (ATC) or a MED-RT class id.",
    "type": "string"
   },
   "rela": {
    "description": "Relationship filter, e.g. 'may_treat' (source-dependent).",
    "type": "string"
   },
   "relaSource": {
    "description": "Class source, e.g. 'ATC', 'MEDRT', 'VA', 'DAILYMED'.",
    "type": "string"
   },
   "trans": {
    "description": "0 = direct members (default), 1 = include transitive.",
    "enum": [
     "0",
     "1"
    ],
    "type": "string"
   },
   "ttys": {
    "description": "Space-separated term types to include, e.g. 'IN MIN'.",
    "type": "string"
   }
  },
  "required": [
   "classId",
   "relaSource"
  ],
  "type": "object"
 },
 "name": "rxnorm_get_class_members",
 "title": "Get drug class members"
}
