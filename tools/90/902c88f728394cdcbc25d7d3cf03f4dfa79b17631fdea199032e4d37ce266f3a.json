{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a tutorial"
 },
 "description": "Use this when someone wants to add a new tutorial to a project. Returns the new tutorial's id, name, project and default voice. Each call creates another tutorial; it records the tutorial without recording or rendering a video. Not for adding a rendered video.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultVoice": {
    "description": "Optional voice id used when narration is synthesized for this tutorial",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Tutorial name, up to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "description": "Project the tutorial belongs to",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "name"
  ],
  "type": "object"
 },
 "name": "create_tutorial",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "const": "created",
    "type": "string"
   },
   "tutorial": {
    "additionalProperties": false,
    "properties": {
     "creationTime": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "defaultVoice": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "lastEditTime": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "projectId": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "name",
     "projectId",
     "defaultVoice",
     "creationTime",
     "lastEditTime"
    ],
    "type": "object"
   }
  },
  "required": [
   "status",
   "tutorial"
  ],
  "type": "object"
 },
 "title": "Create a tutorial"
}
