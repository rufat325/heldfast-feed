{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get one automatic backup (GET /mysql/v1/clusters/{clusterName}/backups/{backupName}).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backupName": {
    "description": "Backup name (from ncloud_serverless_list_backups)",
    "pattern": "^[a-z0-9-]{3,45}$",
    "type": "string"
   },
   "clusterName": {
    "description": "Cluster name (3-30 chars, lowercase letters/digits/'-', no leading or trailing '-'; immutable after creation)",
    "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
    "type": "string"
   }
  },
  "required": [
   "clusterName",
   "backupName"
  ],
  "type": "object"
 },
 "name": "ncloud_serverless_get_backup"
}
