{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a mockup generation task"
 },
 "description": "Start generating product mockups for a design on a catalog product \u2014 returns a task_key; poll printful_get_mockup_task for the images. Heavily rate-limited (about 10/min for established stores, 2/min for new ones). Printful: POST /mockup-generator/create-task/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "files": {
    "description": "Design files per placement. Give files or product_template_id.",
    "items": {
     "properties": {
      "image_url": {
       "description": "Public URL of the design image.",
       "type": "string"
      },
      "options": {
       "items": {
        "properties": {
         "id": {
          "description": "Option id, e.g. stitch_color or thread_colors.",
          "type": "string"
         },
         "value": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "type": "boolean"
           },
           {
            "items": {
             "type": "string"
            },
            "type": "array"
           }
          ],
          "description": "Option value."
         }
        },
        "required": [
         "id",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "placement": {
       "description": "Placement, e.g. front, back (see printful_get_printfiles).",
       "type": "string"
      },
      "position": {
       "description": "Where the image sits inside the print area, in pixels.",
       "properties": {
        "area_height": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "area_width": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "height": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "left": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "top": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "width": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "area_width",
        "area_height",
        "width",
        "height",
        "top",
        "left"
       ],
       "type": "object"
      }
     },
     "required": [
      "placement",
      "image_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "format": {
    "description": "Output format (png is transparent).",
    "enum": [
     "jpg",
     "png"
    ],
    "type": "string"
   },
   "option_groups": {
    "description": "Mockup option groups to generate.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "options": {
    "description": "Mockup option names to generate (see printfiles).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "product_id": {
    "description": "Catalog product id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "product_options": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      },
      {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     ]
    },
    "description": "Product options, e.g. embroidery thread colors.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "product_template_id": {
    "description": "Use a saved Product Template instead of files.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "store_id": {
    "description": "Store id (numeric) for an ACCOUNT-level token; overrides PRINTFUL_STORE_ID. Not needed with a store-level token.",
    "type": "string"
   },
   "variant_ids": {
    "description": "Catalog variant ids to render.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "width": {
    "description": "Mockup width in px, 50-2000 (default 1000).",
    "maximum": 2000,
    "minimum": 50,
    "type": "integer"
   }
  },
  "required": [
   "product_id",
   "variant_ids"
  ],
  "type": "object"
 },
 "name": "printful_create_mockup_task",
 "title": "Create a mockup generation task"
}
