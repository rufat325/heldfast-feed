{
 "description": "Search available phone numbers to purchase by area code, country, or pattern.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "areaCode": {
    "description": "Area code to search (e.g. 412)",
    "type": "string"
   },
   "contains": {
    "description": "Pattern to search for",
    "type": "string"
   },
   "country": {
    "description": "Country code (US, CA, GB, etc.)",
    "type": "string"
   },
   "limit": {
    "description": "Max results",
    "type": "number"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "type": {
    "description": "Number type: local, tollfree, mobile",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "locationId"
  ],
  "type": "object"
 },
 "name": "crm_search_phone_numbers"
}
