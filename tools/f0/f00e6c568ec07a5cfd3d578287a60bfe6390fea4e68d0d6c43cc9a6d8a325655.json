{
 "description": "List todos from Oden. Filter by status (pending/done) and tag ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results. Default: 20",
    "type": "number"
   },
   "status": {
    "description": "Filter by status. Default: pending",
    "enum": [
     "pending",
     "done"
    ],
    "type": "string"
   },
   "tag_id": {
    "description": "Filter by tag UUID. Use oden_list_tags to see available tags.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "oden_list_todos"
}
