 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get market price candles"
 },
 "description": "OHLC price candles for a market's outcome tokens from the stored Polymarket CLOB price history, the series the market chart draws, for open and resolved markets. The stored series is daily: a 1d candle usually holds one point, so its open, high, low and close are that day's close, and 1w aggregates the daily closes. No intraday detail is invented.\n\nArgs:\n  - condition_id (string, required): Raw provider condition_id or the mkt_-prefixed market id\n  - resolution (string, optional): 1d (default, UTC day) or 1w (ISO week from Monday 00:00 UTC)\n  - from (integer, optional): Exclusive lower bound, unix seconds\n  - to (integer, optional): Inclusive upper bound, unix seconds; from must not be after to\n\nReturns: condition_id, resolution, and outcomes, each with its token_id and candles, plus meta.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "condition_id": {
    "description": "Raw provider condition_id or the mkt_-prefixed market id",
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "Exclusive lower bound in unix seconds",
    "type": "integer"
   },
   "resolution": {
    "description": "1d (the default) buckets by UTC day, 1w by ISO week from Monday 00:00 UTC",
    "enum": [
     "1d",
     "1w"
    ],
    "type": "string"
   },
   "to": {
    "description": "Inclusive upper bound in unix seconds; from must not be after to",
    "type": "integer"
   }
  },
  "required": [
   "condition_id"
  ],
  "type": "object"
 },
 "name": "get_market_candles",
 "outputSchema": {
  "$defs": {
   "Candle": {
    "properties": {
