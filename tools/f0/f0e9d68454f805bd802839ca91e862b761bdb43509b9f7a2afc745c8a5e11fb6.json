{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "campaign.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create player mnemons"
 },
 "description": "Create Player mnemons (party root, character notes, party notes). For playerKind=CHARACTER, supply parentEntryId (the PARTY mnemon), partyId (CampaignParty.id), and characterId (SessionCharacter id) or the entry will be auto-detached. Players with campaign.write may call this for a party they belong to; GMs may call for any party.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignId": {
    "minLength": 1,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "characterId": {
       "description": "SessionCharacter id (required for playerKind=CHARACTER).",
       "type": "string"
      },
      "markdown": {
       "description": "Body content as Markdown. Mentions: @[label](mnemon:<entryId>). Images: ![caption](asset:<assetId>@<campaignId>) \u2014 upload the asset first.",
       "minLength": 1,
       "type": "string"
      },
      "parentEntryId": {
       "description": "For playerKind=CHARACTER: entryId of the parent PARTY-kind PlayerMnemon.",
       "type": "string"
      },
      "partyId": {
       "description": "CampaignParty id (NOT a mnemon entryId).",
       "type": "string"
      },
      "playerKind": {
       "enum": [
        "PARTY",
        "CHARACTER",
        "NOTES"
       ],
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Title of the new entry.",
       "minLength": 1,
       "type": "string"
      },
      "visibility": {
       "enum": [
        "HIDDEN",
        "INTERNAL",
        "PUBLIC"
       ],
       "type": "string"
      }
     },
     "required": [
      "title",
      "markdown"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "campaignId",
   "items"
  ],
  "type": "object"
 },
 "name": "create_player_mnemons",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entryId": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "failedOpIndex": {
       "type": "number"
      },
      "index": {
       "type": "number"
      },
      "success": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "warnings": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "index",
      "success"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Create player mnemons"
}
