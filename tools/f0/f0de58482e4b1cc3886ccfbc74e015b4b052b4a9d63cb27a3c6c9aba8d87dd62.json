{
 "_meta": {
  "sato/effects": [
   "read"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Kit status"
 },
 "description": "Reports how this kit is configured: its version, the network mode (fork, testnet or mainnet), a summary of the policy pre-flight in force, whether a signer is configured, and for each available tool the date it last passed the nightly Sato Status checks when that record can be reached. Use it before a first prepare, or to explain why a call was refused. It reads local configuration and one public status file; it changes nothing.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "status",
 "outputSchema": {
  "properties": {
   "kit_version": {
    "type": "string"
   },
   "network": {
    "enum": [
     "fork",
     "testnet",
     "mainnet"
    ],
    "type": "string"
   },
   "policy": {
    "properties": {
     "allow_chains": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "allow_venues": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "human_approval": {
      "type": "boolean"
     },
     "intent_ttl_s": {
      "type": "integer"
     },
     "max_slippage_bps": {
      "type": "integer"
     },
     "max_usd_per_day": {
      "type": "number"
     },
     "max_usd_per_trade": {
      "type": "number"
     },
     "unknown_verdict": {
      "enum": [
       "refuse",
       "allow"
      ],
      "type": "string"
     }
    },
    "required": [
     "allow_chains",
     "allow_venues",
     "intent_ttl_s",
     "unknown_verdict",
     "human_approval"
    ],
    "type": "object"
   },
   "signer": {
    "description": "Signer kind, or none.",
    "type": "string"
   },
   "status_source": {
    "enum": [
     "reachable",
     "unreachable"
    ],
    "type": "string"
   },
   "tools": {
    "items": {
     "properties": {
      "failing_step": {
       "type": "string"
      },
      "last_green": {
       "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "result": {
       "enum": [
        "green",
        "red",
        "error",
        "not_listed",
        "unknown"
       ],
       "type": "string"
      },
      "upstream_version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "result"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "kit_version",
   "network",
   "signer",
   "policy",
   "status_source",
   "tools"
  ],
  "type": "object"
 },
 "title": "Kit status"
}
