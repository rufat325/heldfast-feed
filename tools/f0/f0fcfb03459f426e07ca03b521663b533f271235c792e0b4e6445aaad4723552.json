 "description": "A Scenario at its latest version (or a specified version_id): metadata (incl. latest_hash) + the version's top_line (margin / EC / viability) + its content hash/prev_hash. EM-119: pass a version_id (or\u2026",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "expected_version_hash": {
    "description": "Optional exact content hash from list_scenario_versions. Requires version_id; a mismatch is refused rather than returning a different saved model.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "include_state": {
    "description": "Include the full per-precinct `state` even for the latest version (for redrawing the map).",
    "type": "boolean"
   },
   "scenario_id": {
    "type": "string"
   },
   "version_id": {
    "description": "Optional; defaults to the latest version. When set, the response includes the full per-precinct `state` for that version.",
    "type": "string"
   },
   "workspace_scope": {
    "description": "Optional workspace for THIS call: use an exact personal/team ID from list_workspaces. Repeat on each call; it does not change the connection default. Must agree with MCP metadata and the effective HTTP workspace selector (header, otherwise connector URL). OAuth connections can only use their granted workspace. Membership and campaign permissions still apply.",
    "maxLength": 64,
    "minLength": 3,
    "pattern": "^[uw]-[a-z0-9](?:[a-z0-9-]{0,61})$",
    "type": "string"
   }
  },
  "required": [
   "scenario_id"
  ],
  "type": "object"
 },
 "name": "get_scenario",
