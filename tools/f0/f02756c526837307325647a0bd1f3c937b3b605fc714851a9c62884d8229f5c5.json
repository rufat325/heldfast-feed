{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calls logged on one lead, or if no lead is given, the calls you logged in the last N days.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "days": {
    "default": 7,
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "lead_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "call_history",
 "title": "Call history"
}
