{
 "description": "Show OpenRouter usage grouped by endpoint for the last 30 UTC days. Optional filters: date (YYYY-MM-DD), api_key_hash, user_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aggregate": {
    "description": "Aggregation: none=raw rows sorted by usage; by_model/by_day/by_provider/by_key=grouped totals",
    "enum": [
     "none",
     "by_model",
     "by_day",
     "by_provider",
     "by_key"
    ],
    "type": "string"
   },
   "api_key_hash": {
    "description": "Filter by inference key hash",
    "type": "string"
   },
   "date": {
    "description": "Single UTC date in YYYY-MM-DD",
    "type": "string"
   },
   "limit": {
    "description": "Max rows in output (default 50)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "user_id": {
    "description": "Org member user_id (org accounts only)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "or_activity"
}
