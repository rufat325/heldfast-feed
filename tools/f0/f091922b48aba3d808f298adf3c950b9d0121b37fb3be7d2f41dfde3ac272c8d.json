{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List anime genres/themes/demographics with their MAL IDs. Use this to discover the numeric IDs that the `genres` parameter of search_anime expects.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filter": {
    "description": "Restrict to one kind of tag. Omit to list all.",
    "enum": [
     "genres",
     "explicit_genres",
     "themes",
     "demographics"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_anime_genres",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "genres": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "genres"
  ],
  "type": "object"
 },
 "title": "Get anime genres"
}
