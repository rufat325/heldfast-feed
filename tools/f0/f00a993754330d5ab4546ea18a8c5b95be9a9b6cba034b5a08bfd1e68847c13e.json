{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Insider Signal"
 },
 "description": "Probe insider filing activity (Form 3, 4, 4/A) for a company over a configurable lookback window. Answers: \"Are insiders filing recently?\" Returns recent Form 4 filing references and counts. NOTE: Direction-aware buy/sell signals (insider_signal, buy_count, sell_count) are null/0 in v0.1 \u2014 Form 4 XML parsing ships in v0.2.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lookback_days": {
    "default": 90,
    "description": "Number of calendar days to look back (default 90, max 730).",
    "maximum": 730,
    "minimum": 1,
    "type": "integer"
   },
   "ticker_or_cik": {
    "description": "Ticker symbol (e.g. \"MSFT\") or numeric CIK.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ticker_or_cik"
  ],
  "type": "object"
 },
 "name": "get_insider_signal",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buy_count": {
    "type": "number"
   },
   "cik": {
    "type": "string"
   },
   "company_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "insider_signal": {
    "anyOf": [
     {
      "enum": [
       "STRONG_BUYING",
       "BUYING",
       "NEUTRAL",
       "SELLING",
       "STRONG_SELLING"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "lookback_days": {
    "type": "number"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "data_delay": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "timestamp",
     "data_delay"
    ],
    "type": "object"
   },
   "net_transaction_count": {
    "type": "number"
   },
   "recent_insider_filings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accession_number": {
       "type": "string"
      },
      "filing_date": {
       "type": "string"
      },
      "sec_url": {
       "type": "string"
      }
     },
     "required": [
      "accession_number",
      "filing_date",
      "sec_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sell_count": {
    "type": "number"
   },
   "ticker": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "ticker",
   "cik",
   "company_name",
   "lookback_days",
   "insider_signal",
   "net_transaction_count",
   "buy_count",
   "sell_count",
   "recent_insider_filings",
   "meta"
  ],
  "type": "object"
 },
 "title": "Insider Signal"
}
