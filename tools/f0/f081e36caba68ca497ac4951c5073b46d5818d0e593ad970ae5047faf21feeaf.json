{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Append Markdown to today's daily note.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Markdown to append.",
    "minLength": 1,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "inline": {
    "description": "Append without a leading newline.",
    "type": "boolean"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "daily_append",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Append to daily note"
}
