{
 "description": "Create a product (catalog item that can be attached to plans or bills)",
 "inputSchema": {
  "properties": {
   "code": {
    "description": "Internal product code",
    "type": "string"
   },
   "description": {
    "description": "Product description",
    "type": "string"
   },
   "name": {
    "description": "Product name",
    "type": "string"
   },
   "pricing_schema": {
    "description": "Pricing schema (e.g. { price: 99.90, schema_type: 'flat' })",
    "properties": {
     "price": {
      "type": "number"
     },
     "schema_type": {
      "enum": [
       "flat",
       "per_unit",
       "volume",
       "step"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "status": {
    "description": "Product status",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "pricing_schema"
  ],
  "type": "object"
 },
 "name": "create_product"
}
