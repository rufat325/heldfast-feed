{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find runs whose tags match all of the given key/value pairs",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "experimentIds": {
    "description": "Experiment IDs (defaults to MLFLOW_EXPERIMENT_ID)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxResults": {
    "default": 100,
    "type": "number"
   },
   "orderBy": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Tag key/value pairs to AND together",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "tags"
  ],
  "type": "object"
 },
 "name": "search-runs-by-tags"
}
