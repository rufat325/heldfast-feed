{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "supovia:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List email campaigns"
 },
 "description": "Use this when someone asks which email campaigns one of their websites has. Returns each campaign's id, name and created and edited times, 20 per page by default (no recipients, subject or content). Not for sending a campaign.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The page.nextCursor of the previous page for the same website; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Campaigns per page, from 1 to 50; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "websiteId": {
    "description": "Website whose campaigns to list",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "websiteId"
  ],
  "type": "object"
 },
 "name": "list_campaigns",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaigns": {
    "description": "Campaign identity only. Recipient lists, subjects, message content, user ids, organization ids and arbitrary metadata are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "websiteId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "websiteId",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "page": {
    "additionalProperties": false,
    "description": "hasMore is true when more campaigns follow; pass nextCursor as cursor to get them",
    "properties": {
     "count": {
      "maximum": 50,
      "minimum": 0,
      "type": "integer"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 4096,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "count",
     "hasMore",
     "nextCursor"
    ],
    "type": "object"
   }
  },
  "required": [
   "campaigns",
   "page"
  ],
  "type": "object"
 },
 "title": "List email campaigns"
}
