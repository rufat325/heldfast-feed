{"_meta":{"action_type":"custom","allowed_actor_types":["human","agent"],"cost_class":"free","examples":[{"arguments":{"assigned_to":"<user id>","id":"<team_assignment id>"},"description":"Hand a job to someone else"}],"failure_modes":[{"code":"FORBIDDEN","recovery":"Ask the assigner or an admin.","when":"the caller is neither the assigner nor admin+"},{"code":"CONFLICT","recovery":"Completed/declined assignments cannot move.","when":"the assignment is terminal"}],"keywords":["reassign","handover","job"],"latency_ms_range":null,"min_trust_level":0,"namespace":"desk","preconditions":["Reassigning resets the job to pending for the new assignee and opens a 30-second undo window."],"requires_approval":false,"streaming":false},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Hands an assignment to a different tenant member \u2014 only the original assigner or an admin+, never the current assignee reassigning themself, and never onto a terminal (completed/declined) row. It resets status to 'pending' for the new assignee and records the prior assignee/status so the move can be undone. NEXT: team_assignment_undo_reassign within 30 seconds reverts it.","inputSchema":{"additionalProperties":false,"properties":{"accepted_at":{"type":"integer"},"artifact_id":{"maxLength":64,"type":"string"},"assigned_to":{"maxLength":64,"type":"string"},"attachment_key":{"maxLength":200,"type":"string"},"attachment_name":{"maxLength":200,"type":"string"},"attachment_type":{"maxLength":100,"type":"string"},"completed_at":{"type":"integer"},"completion_notes":{"maxLength":2000,"type":"string"},"decline_reason":{"maxLength":500,"type":"string"},"declined_at":{"type":"integer"},"description":{"maxLength":2000,"type":"string"},"due_at":{"type":"integer"},"id":{"description":"The team_assignment id (team_assignment_list shows them).","type":"string"},"photos_json":{"maxLength":4000,"type":"string"},"previous_assignee":{"maxLength":64,"type":"string"},"previous_status":{"enum":["pending","accepted","in_progress","completed","declined"],"type":"string"},"priority":{"enum":["low","normal","high","urgent"],"type":"string"},"reassigned_at":{"type":"integer"},"reassigned_by":{"maxLength":64,"type":"string"},"started_at":{"type":"integer"},"status":{"enum":["pending","accepted","in_progress","completed","declined"],"type":"string"},"title":{"maxLength":200,"type":"string"}},"required":["id"],"type":"object"},"name":"team_assignment_reassign"}
