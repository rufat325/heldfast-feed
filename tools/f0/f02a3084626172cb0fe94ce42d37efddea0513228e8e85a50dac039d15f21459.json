{
 "description": "Search for code across GitHub repositories using GitHub code search syntax",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order": {
    "description": "Sort order",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "minimum": 1,
    "type": "number"
   },
   "per_page": {
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Search query (GitHub code search syntax)",
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "Sort field",
    "enum": [
     "indexed"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "github_search_code"
}
