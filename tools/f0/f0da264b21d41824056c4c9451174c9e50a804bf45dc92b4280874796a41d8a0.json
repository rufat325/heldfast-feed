   },
   "points_win": {
    "description": "Points for a win, default 3",
    "type": "number"
   },
   "results": {
    "description": "Match results in any order",
    "items": {
     "properties": {
      "away": {
       "type": "string"
      },
      "away_score": {
       "type": "number"
      },
      "home": {
       "type": "string"
      },
      "home_score": {
       "type": "number"
      }
     },
     "required": [
      "home",
      "away",
      "home_score",
      "away_score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "teams": {
    "description": "Full roster; results for teams outside it are skipped with a warning",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "name": "standings_table"
}
