{
 "description": "Fetch a URL and scan its body for prompt-injection. Useful before feeding scraped page content into another LLM call. Sets the context to web_content automatically.",
 "inputSchema": {
  "properties": {
   "context": {
    "default": "web_content",
    "description": "Override the default web_content context.",
    "enum": [
     "git_commit",
     "web_content",
     "user_input",
     "file_content",
     "email",
     "tool_output",
     "unknown"
    ],
    "type": "string"
   },
   "max_bytes": {
    "default": 50000,
    "description": "Truncate fetched body before scanning. Default 50000.",
    "type": "integer"
   },
   "return_cleaned": {
    "default": true,
    "type": "boolean"
   },
   "sensitivity": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "url": {
    "description": "URL to fetch and scan.",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "scan_url"
}
