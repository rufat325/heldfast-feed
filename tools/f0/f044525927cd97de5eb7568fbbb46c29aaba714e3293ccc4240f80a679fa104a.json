{
 "description": "Set online/offline presence for an instance",
 "inputSchema": {
  "properties": {
   "instance": {
    "description": "Instance name",
    "type": "string"
   },
   "number": {
    "description": "Target number (required for composing/recording)",
    "type": "string"
   },
   "presence": {
    "description": "Presence state",
    "enum": [
     "available",
     "unavailable",
     "composing",
     "recording",
     "paused"
    ],
    "type": "string"
   }
  },
  "required": [
   "instance",
   "presence"
  ],
  "type": "object"
 },
 "name": "set_presence"
}
