{
 "_meta": {
  "fastmcp": {
   "tags": [
    "premium"
   ]
  },
  "openai/outputTemplate": "ui://widget/quotes.html",
  "openai/toolInvocation/invoked": "Quote ready",
  "openai/toolInvocation/invoking": "Loading quote...",
  "openai/widgetAccessible": true
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get quote details by code"
 },
 "description": "Use this to get full details for a quote. Returns complete attribution, sources, and metadata.\n\nWhen to use: User wants more details about a quote from search results. Use the short_code from previous results.\n\nExamples:\n- `quote(\"abc123\")` - get details for quote with short_code\n- `quote(\"xyz789\", response_format=\"detailed\")` - with full metadata\n- `quote(\"abc123\", include_relations=True)` - with translations and variants",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "Quote code (e.g., 'abc123')",
    "minLength": 3,
    "type": "string"
   },
   "include": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Include extra data: 'collections'"
   },
   "include_relations": {
    "default": false,
    "description": "Include related quotes (translations, variants, etc.)",
    "type": "boolean"
   },
   "response_format": {
    "default": "concise",
    "description": "Response detail level",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "quote",
 "title": "Get quote details by code"
}
