  "readOnlyHint": true,
  "title": "Get a batch\u2019s progress"
 },
 "description": "The state of a batch and of each picture in it: queued, running, done, failed or cancelled, the job_id of its run once started (get_job gives the files), credits charged, and whether retry_batch can run it again.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "batch_id": {
    "description": "The batch id start_batch returned.",
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "batch_id"
  ],
  "type": "object"
 },
 "name": "get_batch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "batch_id": {
    "type": "string"
   },
   "charged_credits": {
    "description": "What its runs were charged so far.",
    "type": "number"
   },
   "counts": {
    "additionalProperties": false,
    "properties": {
     "cancelled": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "done": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "failed": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "queued": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "running": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "queued",
     "running",
     "done",
     "failed",
     "cancelled"
    ],
    "type": "object"
   },
   "created_at": {
    "type": "string"
   },
   "item_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "credits": {
       "description": "What its run was charged.",
       "type": "number"
      },
      "error_code": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "item_id": {
       "type": "string"
      },
      "job_id": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Its run once started: pass to get_job for the files."
      },
      "name": {
       "type": "string"
      },
      "position": {
       "description": "The picture\u2019s place in the batch.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "retryable": {
       "description": "retry_batch would run it again.",
       "type": "boolean"
      },
      "state": {
       "enum": [
        "queued",
        "running",
        "done",
        "failed",
        "cancelled"
       ],
       "type": "string"
      }
     },
     "required": [
      "item_id",
      "position",
      "name",
      "state",
      "job_id",
      "credits",
      "error_code",
      "retryable"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "type": "string"
   },
   "per_item_credits": {
    "type": "number"
   },
   "quoted_credits": {
    "description": "What the batch costs if every picture runs.",
    "type": "number"
   },
   "scene": {
    "type": "string"
   },
   "settled_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "running",
     "done",
     "cancelled"
    ],
    "type": "string"
   }
  },
  "required": [
   "batch_id",
   "model",
   "scene",
   "status",
   "item_count",
   "counts",
   "per_item_credits",
   "quoted_credits",
   "charged_credits",
   "created_at",
   "settled_at",
   "items"
  ],
  "type": "object"
 },
 "title": "Get a batch\u2019s progress"
}
