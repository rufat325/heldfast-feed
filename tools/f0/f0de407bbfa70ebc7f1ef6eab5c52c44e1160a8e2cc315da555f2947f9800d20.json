{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create Webhook"
 },
 "description": "Create a webhook endpoint. Its signing secret appears once in the tool result and conversation log.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "maxLength": 500,
    "type": "string"
   },
   "domain_ids": {
    "anyOf": [
     {
      "items": {
       "description": "Shipmail resource ID.",
       "pattern": "^[A-Za-z0-9_-]{1,100}$",
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Only deliver events for these domain IDs and their mailboxes."
   },
   "events": {
    "items": {
     "enum": [
      "message.received",
      "message.sent",
      "message.delivered",
      "message.bounced",
      "message.complained",
      "mailbox.rule_matched",
      "mailbox.export.completed",
      "mailbox.export.failed",
      "domain.verified",
      "domain.verification_failed",
      "domain.degraded",
      "org.reputation_warning",
      "org.sending_throttled",
      "org.sending_suspended",
      "org.reputation_recovered",
      "reply.overdue",
      "conversation.needs_action",
      "calendar.event_starting",
      "booking.created",
      "subscriber.added",
      "newsletter.sent"
     ],
     "type": "string"
    },
    "maxItems": 21,
    "minItems": 1,
    "type": "array"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "mailbox_ids": {
    "anyOf": [
     {
      "items": {
       "description": "Shipmail resource ID.",
       "pattern": "^[A-Za-z0-9_-]{1,100}$",
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Only deliver events for these mailbox IDs (plus mailboxes of domain_ids). Omit for every mailbox. Organization events are always delivered."
   },
   "url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "shipmail_create_webhook",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "webhook": {
    "properties": {
     "active": {
      "type": "boolean"
     },
     "created_at": {
      "type": "string"
     },
     "description": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "domain_ids": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "events": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "mailbox_ids": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "object": {
      "type": "string"
     },
     "secret": {
      "type": "string"
     },
     "updated_at": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "object",
     "id",
     "url",
     "events",
     "active",
     "description",
     "mailbox_ids",
     "domain_ids",
     "created_at",
     "updated_at",
     "secret"
    ],
    "type": "object"
   }
  },
  "required": [
   "webhook"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Create Webhook"
}
