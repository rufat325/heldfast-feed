{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Return a decision-only recommendation for whether prompt text should stay local, go to a cloud model, or be blocked for PII or jailbreak risk. This tool never sends the prompt to an AI model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "prompt": {
    "maxLength": 262144,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "compass_check_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blocked": {
    "type": "boolean"
   },
   "confidence": {
    "type": "number"
   },
   "decision": {
    "enum": [
     "LOCAL_SAFE",
     "CLOUD_COMPLEX",
     "BLOCK_PII",
     "JAILBREAK"
    ],
    "type": "string"
   },
   "quota": {
    "additionalProperties": false,
    "properties": {
     "daily_remaining": {
      "type": [
       "number",
       "null"
      ]
     },
     "monthly_remaining": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "request_id": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "windows": {
    "type": "integer"
   }
  },
  "required": [
   "decision",
   "blocked"
  ],
  "type": "object"
 },
 "title": "Check and route a prompt"
}
