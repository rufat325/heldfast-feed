{
 "description": "Record a significant decision made during development. Helps future sessions understand why choices were made.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "description": "What other options existed",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "choice": {
    "description": "What was decided",
    "type": "string"
   },
   "outcome": {
    "description": "How it turned out (can be updated later)",
    "type": "string"
   },
   "project": {
    "description": "Which project this relates to",
    "type": "string"
   },
   "reasoning": {
    "description": "Why this choice was made",
    "type": "string"
   },
   "related_dead_ends": {
    "description": "Timestamps of dead ends that led to this decision",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tags": {
    "description": "Tags for searching later",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "choice",
   "reasoning"
  ],
  "type": "object"
 },
 "name": "decision_record"
}
