{
 "description": "Get current CPU and memory usage snapshot",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "count": {
    "default": 1,
    "description": "Number of iterations (1-100, 1 = snapshot)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "device": {
    "description": "Device serial",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "adb_top"
}
