{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "List attachable Node/Electron V8 Inspector targets from one approved literal-loopback endpoint. Only targets inside exact canonical file roots or exact HTTP(S) origins are retained; excluded target locations never enter Evidence.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "allowed_file_roots": [
     "/opt/example-app"
    ],
    "allowed_origins": [],
    "approved": true,
    "inspector_endpoint": "http://127.0.0.1:9229",
    "limit": 100,
    "offset": 0
   }
  ],
  "properties": {
   "allowed_file_roots": {
    "default": [],
    "description": "Approved canonical filesystem allowed file roots.",
    "items": {
     "maxLength": 16384,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "allowed_origins": {
    "description": "Value for allowed origins.",
    "items": {
     "maxLength": 2048,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "approved": {
    "const": true,
    "description": "Explicit operator approval to perform this operation.",
    "type": "boolean"
   },
   "inspector_endpoint": {
    "description": "Value for inspector endpoint.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum number of results to return in this page.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based index of the first result to return.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "inspector_endpoint",
   "approved"
  ],
  "type": "object"
 },
 "name": "list_javascript_runtime_targets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "excluded": {
      "additionalProperties": false,
      "properties": {
       "outside_file_roots": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "outside_origins": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unconnectable": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "unsupported_location": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "outside_file_roots",
       "outside_origins",
       "unsupported_location",
       "unconnectable"
      ],
      "type": "object"
     },
     "limitations": {
      "items": {
       "maxLength": 4096,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     "runtime": {
      "additionalProperties": false,
      "properties": {
       "product": {
        "maxLength": 1024,
        "minLength": 1,
        "type": "string"
       },
       "protocol_version": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       "v8_version": {
        "anyOf": [
         {
          "maxLength": 1024,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "product",
       "protocol_version",
       "v8_version"
      ],
      "type": "object"
     },
     "schema_version": {
      "const": 1,
      "type": "number"
     },
     "targets": {
      "additionalProperties": false,
      "properties": {
       "has_more": {
        "type": "boolean"
       },
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "attached": {
           "type": "boolean"
          },
          "location": {
           "oneOf": [
            {
             "additionalProperties": false,
             "properties": {
              "authority": {
               "const": "scope-fallback",
               "type": "string"
              },
              "file_path": {
               "maxLength": 16384,
               "minLength": 1,
               "type": "string"
              },
              "kind": {
               "const": "file",
               "type": "string"
              }
             },
             "required": [
              "kind",
              "file_path"
             ],
             "type": "object"
            },
            {
             "additionalProperties": false,
             "properties": {
              "kind": {
               "const": "url",
               "type": "string"
              },
              "origin": {
               "maxLength": 2048,
               "minLength": 1,
               "type": "string"
              },
              "sanitized_url": {
               "maxLength": 65536,
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "kind",
              "origin",
              "sanitized_url"
             ],
             "type": "object"
            },
            {
             "additionalProperties": false,
             "properties": {
              "kind": {
               "const": "builtin",
               "type": "string"
              },
              "specifier": {
               "maxLength": 4096,
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "kind",
              "specifier"
             ],
             "type": "object"
            }
           ]
          },
          "protocol_type": {
           "maxLength": 100,
           "minLength": 1,
           "type": "string"
          },
          "target_id": {
           "maxLength": 256,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "target_id",
          "protocol_type",
          "attached",
          "location"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "limit": {
        "maximum": 9007199254740991,
        "minimum": 1,
        "type": "integer"
       },
       "next_offset": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "offset": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "total": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "items",
       "offset",
       "limit",
       "total",
       "next_offset",
       "has_more"
      ],
      "type": "object"
     }
    },
    "required": [
     "schema_version",
     "runtime",
     "targets",
     "excluded",
     "limitations"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "List Javascript Runtime Targets"
}
