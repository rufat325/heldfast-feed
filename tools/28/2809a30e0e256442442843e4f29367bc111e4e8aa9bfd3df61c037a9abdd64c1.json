{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search upcoming EventWave public event records by city, category, date window, and keyword. Returns evidence state and original source URLs. Read-only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "Music",
     "Sports",
     "Food",
     "Arts",
     "Community",
     "Comedy",
     "Theater",
     "Conference",
     "Festival",
     "Nightlife",
     "Other"
    ],
    "type": "string"
   },
   "city": {
    "maxLength": 120,
    "type": "string"
   },
   "days_ahead": {
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "maxLength": 160,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_events",
 "title": "Search EventWave events"
}
