{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn chosen songs and licenses into one link that opens the person's Starchild cart with everything already added. Checkout happens on starchild.music. Use license ids from license_options (e.g. song-only, song-instrumental, royalty-free, exclusive-license).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "license": {
       "default": "song-only",
       "maxLength": 40,
       "type": "string"
      },
      "song": {
       "maxLength": 300,
       "type": "string"
      }
     },
     "required": [
      "song"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "build_cart",
 "title": "Make a cart link"
}
