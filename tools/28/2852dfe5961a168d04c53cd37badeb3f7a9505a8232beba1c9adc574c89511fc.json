{
 "annotations": {
  "readOnlyHint": true,
  "title": "List Repositories"
 },
 "description": "List all indexed repositories in your Code-Fundi account. Supports pagination, scope filtering (private/public), and name search.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results per page (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "number"
   },
   "order": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "order_by": {
    "description": "Field to sort by",
    "type": "string"
   },
   "scope": {
    "description": "Filter by repository visibility",
    "enum": [
     "private",
     "public"
    ],
    "type": "string"
   },
   "search": {
    "description": "Case-insensitive substring filter on repo name",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "code-fundi-list-repos"
}
