{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Check and save installation"
 },
 "description": "Fetch the pixel's homepage and store whether the tag is there.\n\n        install_status becomes installed or not_installed. check_error says\n        why a check could not decide. Evaluator accounts fetch only the fixed\n        https://staging.allsourcedata.io/evaluation-test/ page and reject redirects.\n        ",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pixel_id": {
    "description": "pixel_id of the pixel whose homepage to check. Example: px_7a1b2c3d4e5f6a7b",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "title": "Pixel Id",
    "type": "string"
   }
  },
  "required": [
   "pixel_id"
  ],
  "title": "check_installArguments",
  "type": "object"
 },
 "name": "check_install",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "check_error": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Check Error"
   },
   "checked_at": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Checked At"
   },
   "consent_enabled": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Consent Enabled"
   },
   "data_kind": {
    "enum": [
     "synthetic",
     "resolved"
    ],
    "title": "Data Kind",
    "type": "string"
   },
   "domain": {
    "title": "Domain",
    "type": "string"
   },
   "evaluation_mode": {
    "title": "Evaluation Mode",
    "type": "boolean"
   },
   "install_status": {
    "enum": [
     "not_checked",
     "installed",
     "not_installed",
     "unreachable"
    ],
    "title": "Install Status",
    "type": "string"
   },
   "pixel_id": {
    "title": "Pixel Id",
    "type": "string"
   },
   "snippet": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Snippet"
   }
  },
  "required": [
   "pixel_id",
   "domain",
   "install_status",
   "evaluation_mode",
   "data_kind"
  ],
  "title": "Pixel",
  "type": "object"
 },
 "title": "Check and save installation"
}
