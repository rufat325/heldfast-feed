{
 "description": "Get iteration details for actions inside loops (ForEach, Until). Each iteration is a 'repetition' with its own status, inputs, outputs, and trackedProperties. For Standard SKU, workflowName is required. Essential for debugging loop failures.",
 "inputSchema": {
  "properties": {
   "actionName": {
    "description": "Action name (the loop action)",
    "type": "string"
   },
   "logicAppName": {
    "description": "Logic App resource name",
    "type": "string"
   },
   "repetitionName": {
    "description": "Specific repetition to get (e.g., '000000', '000001')",
    "type": "string"
   },
   "resourceGroupName": {
    "description": "Resource group name",
    "type": "string"
   },
   "runId": {
    "description": "Run ID",
    "type": "string"
   },
   "subscriptionId": {
    "description": "Azure subscription ID",
    "type": "string"
   },
   "workflowName": {
    "description": "Workflow name (required for Standard SKU)",
    "type": "string"
   }
  },
  "required": [
   "subscriptionId",
   "resourceGroupName",
   "logicAppName",
   "runId",
   "actionName"
  ],
  "type": "object"
 },
 "name": "get_action_repetitions"
}
