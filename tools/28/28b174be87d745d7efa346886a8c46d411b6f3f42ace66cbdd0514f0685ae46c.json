    "enum": [
     "ko",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 6,
    "description": "How many formats a page.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
