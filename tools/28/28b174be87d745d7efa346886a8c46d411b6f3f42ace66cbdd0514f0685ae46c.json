       "parenting"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The creator's niche, when they have one: beauty, food, fashion, daily, comedy, dance, music, pets, fitness, travel, art, gaming, product, info, ai, household, tech, parenting."
   },
   "cursor": {
    "anyOf": [
     {
      "maxLength": 12,
      "type": "string"
     },
