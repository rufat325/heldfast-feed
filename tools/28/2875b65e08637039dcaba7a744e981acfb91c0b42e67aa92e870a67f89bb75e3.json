  "properties": {
   "dimension": {
    "default": "nether",
    "description": "overworld or nether; defaults to nether.",
    "type": "string"
   },
   "direction": {
    "default": null,
    "description": "Optional compass name: north, northeast, east, southeast, south, southwest, west, northwest.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "name": "get_nocom_highway_activity",
 "outputSchema": {
  "properties": {
   "result": {
    "items": {
