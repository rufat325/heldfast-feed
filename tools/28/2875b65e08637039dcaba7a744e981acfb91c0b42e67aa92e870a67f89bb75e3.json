      "atlasDimension": {
       "type": "integer"
      },
      "canonicalUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "dimension": {
       "type": "string"
      },
      "direction": {
       "type": "string"
      },
      "directionX": {
       "type": "integer"
      },
      "directionZ": {
       "type": "integer"
      },
      "observations": {
       "type": "integer"
      },
      "periodEndExclusiveUtc": {
       "format": "date-time",
       "type": "string"
      },
      "periodStartUtc": {
       "format": "date-time",
       "type": "string"
      }
     },
     "required": [
      "dimension",
      "atlasDimension",
      "direction",
      "directionX",
      "directionZ",
      "periodStartUtc",
      "periodEndExclusiveUtc",
      "observations"
