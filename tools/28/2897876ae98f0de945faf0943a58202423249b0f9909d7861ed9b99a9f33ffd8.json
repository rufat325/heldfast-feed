{
 "description": "Given a list of test failures and a flakiness history, score each failure by how likely it is to be a known flaky test vs a real regression. Returns probability scores per test.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "failures": {
    "description": "Failures to evaluate",
    "items": {
     "properties": {
      "duration": {
       "type": "number"
      },
      "errorMessage": {
       "type": "string"
      },
      "filePath": {
       "type": "string"
      },
      "suiteName": {
       "type": "string"
      },
      "testName": {
       "type": "string"
      }
     },
     "required": [
      "testName",
      "suiteName",
      "errorMessage"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "flakinessHistory": {
    "description": "Historical flakiness data \u2014 testName, suiteName, flakyProbability (0\u20131), recentFailures, totalRuns",
    "items": {
     "properties": {
      "flakyProbability": {
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "recentFailures": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "suiteName": {
       "type": "string"
      },
      "testName": {
       "type": "string"
      },
      "totalRuns": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "testName",
      "suiteName",
      "flakyProbability",
      "recentFailures",
      "totalRuns"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "failures",
   "flakinessHistory"
  ],
  "type": "object"
 },
 "name": "cross_reference_flakiness"
}
