{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Run command batch"
 },
 "description": "Executes multiple canvas manipulation and background job commands in a single round-trip. Use \"handle\" strings to refer to blocks added earlier in the same batch. When adding TextNote annotations, set \"anchors\" to the handles/IDs of the described blocks so auto-layout keeps each note next to them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "commands": {
    "items": {
     "properties": {
      "anchors": {
       "description": "For add_block of a TextNote: handles/IDs of the blocks the note describes. Auto-layout and drag then keep the note beside those blocks.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "blockId": {
       "type": "string"
      },
      "blockType": {
       "type": "string"
      },
      "fromBlockId": {
       "type": "string"
      },
      "fromPortId": {
       "type": "string"
      },
      "handle": {
       "type": "string"
      },
      "jobId": {
       "type": "string"
      },
      "max": {
       "type": "number"
      },
      "maxIterations": {
       "type": "number"
      },
      "measureBlockId": {
       "type": "string"
      },
      "min": {
       "type": "number"
      },
      "objective": {
       "enum": [
        "iae",
        "overshoot",
        "settling_time"
       ],
       "type": "string"
      },
      "paramName": {
       "type": "string"
      },
      "params": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "setpoint": {
       "type": "number"
      },
      "toBlockId": {
       "type": "string"
      },
      "toPortId": {
       "type": "string"
      },
      "type": {
       "enum": [
        "add_block",
        "move_block",
        "connect_blocks",
        "update_params",
        "delete_block",
        "tidy_layout",
        "clear_canvas",
        "start_optimization",
        "get_job_status",
        "cancel_job"
       ],
       "type": "string"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "commands"
  ],
  "type": "object"
 },
 "name": "batch_commands",
 "title": "Run command batch"
}
