{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read a test's results"
 },
 "description": "Fetches a test's results and works out what they mean.\n\nAlongside the raw counts it returns the probability that each combination is genuinely best and the expected cost of stopping now and keeping the leader. Use those rather than comparing conversion rates by eye: a variant ahead 2/10 to 1/10 looks twice as good and is very close to a coin flip, and that mistake is the single most common way an A/B test gets called wrong.\n\nMulti-slot tests also report per-slot marginals: how each variant did across every combination it appeared in.\n\nNeeds the stats secret. If you have the manage URL, its #fragment IS the secret and it will be used automatically.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
   {
    "required": [
     "test"
    ]
   },
   {
    "required": [
     "config"
    ]
   }
  ],
  "properties": {
   "config": {
    "description": "Alias for `test`: the same value under the name build_test returns it as (`config`). Pass one or the other.",
    "minLength": 1,
    "type": "string"
   },
   "statsSecret": {
    "description": "Omit when passing a manage URL that carries it in the fragment.",
    "type": "string"
   },
   "test": {
    "description": "The test: an encoded config, or any LiveVariant URL containing one (serve, click, pixel, manage), or a query-parameter serve URL. Paste whatever you have.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_stats",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bySignal": {
    "additionalProperties": {
     "additionalProperties": {
      "additionalProperties": false,
      "properties": {
       "conversions": {
        "type": "number"
       },
       "pulls": {
        "type": "number"
       }
      },
      "required": [
       "pulls",
       "conversions"
      ],
      "type": "object"
     },
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "combinations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "choice": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "conversionRate": {
       "type": [
        "number",
        "null"
       ]
      },
      "conversions": {
       "type": "number"
      },
      "probabilityBest": {
       "type": "number"
      },
      "pulls": {
       "type": "number"
      }
     },
     "required": [
      "choice",
      "pulls",
      "conversions",
      "conversionRate",
      "probabilityBest"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contextBuckets": {
    "type": "number"
   },
   "decision": {
    "additionalProperties": false,
    "properties": {
     "advice": {
      "type": "string"
     },
     "canStop": {
      "type": "boolean"
     },
     "expectedLossIfStoppingNow": {
      "type": "number"
     },
     "leader": {
      "type": "string"
     },
     "relativeLoss": {
      "type": "number"
     }
    },
    "required": [
     "leader",
     "canStop",
     "expectedLossIfStoppingNow",
     "relativeLoss",
     "advice"
    ],
    "type": "object"
   },
   "excluded": {
    "additionalProperties": false,
    "properties": {
     "bySource": {
      "type": "number"
     },
     "byWindow": {
      "type": "number"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "total",
     "bySource",
     "byWindow"
    ],
    "type": "object"
   },
   "slots": {
    "additionalProperties": {
     "items": {
      "additionalProperties": false,
      "properties": {
       "conversionRate": {
        "type": [
         "number",
         "null"
        ]
       },
       "conversions": {
        "type": "number"
       },
       "name": {
        "type": "string"
       },
       "pulls": {
        "type": "number"
       }
      },
      "required": [
       "name",
       "pulls",
       "conversions",
       "conversionRate"
      ],
      "type": "object"
     },
     "type": "array"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "testId": {
    "type": "string"
   },
   "totalAssignments": {
    "type": "number"
   }
  },
  "required": [
   "testId",
   "totalAssignments",
   "combinations",
   "slots",
   "decision",
   "contextBuckets",
   "bySignal",
   "excluded"
