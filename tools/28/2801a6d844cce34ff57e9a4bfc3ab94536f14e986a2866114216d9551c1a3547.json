{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Multi-signal stock screener"
 },
 "description": "Screen the market across options-flow net premium, open-interest change, FDA catalysts and congressional trading. Filter by direction, minimum premium or OI change, catalyst window, trial phase or congress activity; sort and limit. Use for 'find bullish options-flow names with an FDA catalyst in the next 30 days'. Pro.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "direction": {
    "enum": [
     "any",
     "bullish",
     "bearish"
    ],
    "type": "string"
   },
   "fda_within_days": {
    "description": "Require an FDA catalyst within N days (0 = no requirement)",
    "maximum": 1095,
    "minimum": 0,
    "type": "integer"
   },
   "has_congress": {
    "description": "Require congressional trades in the last 30 days",
    "type": "boolean"
   },
   "limit": {
    "description": "Rows to return (default 25)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "min_abs_premium": {
    "description": "Minimum absolute net premium in dollars",
    "minimum": 0,
    "type": "number"
   },
   "min_oi_change": {
    "description": "Minimum day-over-day OI change",
    "type": "integer"
   },
   "order": {
    "enum": [
     "desc",
     "asc"
    ],
    "type": "string"
   },
   "phase": {
    "enum": [
     "any",
     "PHASE2",
     "PHASE3"
    ],
    "type": "string"
   },
   "session": {
    "description": "Trading date YYYY-MM-DD, or 'latest' (default)",
    "type": "string"
   },
   "signals": {
    "description": "Signals a row must carry",
    "items": {
     "enum": [
      "flow",
      "oi",
      "fda",
      "congress"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "sort_by": {
    "enum": [
     "abs_premium",
     "net_premium",
     "oi_change",
     "order_count",
     "congress_30d",
     "next_fda_days"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "screener",
 "title": "Multi-signal stock screener"
}
