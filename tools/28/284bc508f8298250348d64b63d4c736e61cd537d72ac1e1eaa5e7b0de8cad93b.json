{
 "description": "Calculate journey duration from distance and average speed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "https://roaduser.tools/icons/favicon.svg"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "distance": {
    "additionalProperties": false,
    "description": "Journey distance. Must be finite and non-negative.",
    "properties": {
     "unit": {
      "enum": [
       "km",
       "mi",
       "m"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "speed": {
    "additionalProperties": false,
    "description": "Average speed. Must be finite and greater than zero.",
    "properties": {
     "unit": {
      "enum": [
       "kmh",
       "mph",
       "ms",
       "kn"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   }
  },
  "required": [
   "distance",
   "speed"
  ],
  "type": "object"
 },
 "name": "calculate_journey_time",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "duration": {
    "additionalProperties": false,
    "description": "Duration split into whole hours, minutes, and seconds.",
    "properties": {
     "hours": {
      "type": "number"
     },
     "minutes": {
      "type": "number"
     },
     "seconds": {
      "type": "number"
     }
    },
    "required": [
     "hours",
     "minutes",
     "seconds"
    ],
    "type": "object"
   },
   "formatted": {
    "description": "H:MM:SS presentation of the duration.",
    "type": "string"
   },
   "totalHours": {
    "description": "Total duration in decimal hours.",
    "type": "number"
   },
   "totalSeconds": {
    "description": "Total duration in seconds, full precision.",
    "type": "number"
   }
  },
  "required": [
   "totalSeconds",
   "totalHours",
   "duration",
   "formatted"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "tools:read",
    "tools:calculate"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Calculate journey time"
}
