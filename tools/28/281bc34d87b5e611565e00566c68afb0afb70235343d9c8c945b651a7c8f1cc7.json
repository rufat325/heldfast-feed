 "description": "Which Japanese drone rules apply at this point, time and height? Returns applies / does_not_apply / possible_check_required / unknown per check (DID 2020, 150 m, night, airport screening, Small UAS Act facilities, MLIT emergency airspace, flight methods, 25 kg), the category (I/II/III/unknown) and permission_needed, with a receipt per check. Reference only; uncertain = check DIPS; no applications prepared.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aircraft_cert": {
    "description": "Aircraft certification: none, type2 (2nd class) or type1 (1st class)",
    "enum": [
     "none",
     "type2",
     "type1"
    ],
    "type": "string"
   },
   "aircraft_mass_kg": {
    "description": "Maximum take-off mass in kg",
    "maximum": 1000,
    "minimum": 0,
    "type": "number"
   },
   "altitude_agl_m": {
    "description": "Planned height above ground or water in metres",
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "altitude_msl_m": {
    "description": "Planned altitude above mean sea level in metres (ground elevation from GSI is subtracted). Give this or altitude_agl_m.",
    "maximum": 10000,
    "minimum": -100,
    "type": "number"
   },
   "bvlos": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Beyond visual line of sight (true/false). Omitted = reported unknown"
   },
   "carrying_hazardous": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Carrying hazardous materials (true/false)"
   },
   "datetime": {
    "description": "Planned time, ISO 8601. Without an offset it is read as JST (e.g. 2026-12-21T18:00). Default: now.",
    "maxLength": 40,
    "type": "string"
   },
   "dropping_objects": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Dropping objects (true/false)"
   },
   "entry_control": {
    "description": "Third parties kept out from under the flight path (\u7acb\u5165\u7ba1\u7406\u63aa\u7f6e): in_place or not_in_place",
    "enum": [
     "in_place",
     "not_in_place"
    ],
    "type": "string"
   },
   "lat": {
    "description": "Latitude in decimal degrees (WGS84/JGD2011), Japan only, e.g. 35.6852",
    "maximum": 46,
    "minimum": 20,
    "type": "number"
   },
   "limited_change_bvlos": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Certificate has the limited change allowing BVLOS flight (true/false)"
   },
   "limited_change_night": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Certificate has the limited change allowing night flight (true/false)"
   },
   "lon": {
    "description": "Longitude in decimal degrees, Japan only, e.g. 139.7528",
    "maximum": 154,
    "minimum": 122,
    "type": "number"
   },
   "night": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Night flight (true/false). Omitted = derived from datetime and the location"
   },
   "over_event": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Over an event site where many people gather (true/false)"
   },
   "pilot_cert": {
    "description": "Japanese remote pilot certificate held: none, 2nd or 1st class",
    "enum": [
     "none",
     "2nd",
     "1st"
    ],
    "type": "string"
   },
   "within_30m": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "enum": [
       "true",
       "false"
      ],
      "type": "string"
     }
    ],
    "description": "Within 30 m of people or property not related to the flight (true/false)"
   }
  },
  "required": [
   "lat",
   "lon"
  ],
  "type": "object"
 },
