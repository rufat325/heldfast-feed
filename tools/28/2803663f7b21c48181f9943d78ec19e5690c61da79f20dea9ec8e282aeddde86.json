{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Track event interests"},"description":"Save a persistent watchlist: a place (US ZIP code, city or coordinates, plus radius_km) and/or followed artists or teams, with optional categories, keywords, venues, maximum price and how many days ahead. AgentStructure then checks on a schedule and records newly observed matching events and changes as alerts. Saving again with the same name replaces it. Returns current matches as a preview.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"filters":{"additionalProperties":false,"properties":{"alert_on":{"items":{"enum":["new_events","changes"],"type":"string"},"maxItems":2,"minItems":1,"type":"array"},"artists":{"items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":25,"type":"array"},"categories":{"items":{"maxLength":60,"minLength":1,"type":"string"},"maxItems":20,"type":"array"},"city":{"maxLength":100,"minLength":1,"type":"string"},"country_code":{"pattern":"^[A-Za-z]{2}$","type":"string"},"days_ahead":{"maximum":365,"minimum":1,"type":"integer"},"include_unpriced":{"type":"boolean"},"keywords":{"items":{"maxLength":100,"minLength":1,"type":"string"},"maxItems":10,"type":"array"},"latitude":{"maximum":90,"minimum":-90,"type":"number"},"longitude":{"maximum":180,"minimum":-180,"type":"number"},"max_price":{"maximum":100000,"minimum":0,"type":"number"},"place_label":{"maxLength":60,"minLength":1,"type":"string"},"radius_km":{"exclusiveMinimum":0,"maximum":300,"type":"number"},"venues":{"items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":10,"type":"array"},"zip":{"pattern":"^\\d{5}$","type":"string"}},"type":"object"},"name":{"pattern":"^[A-Za-z0-9 _-]{1,40}$","type":"string"},"preview":{"type":"boolean"}},"required":["name","filters"],"type":"object"},"name":"track_event_interests","title":"Track event interests"}
