    ],
    "type": "string"
   },
   "latestClose": {
    "type": [
     "number",
     "null"
    ]
   },
   "library": {
    "description": "The library that did the calculation",
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "skipped": {
    "description": "Requested indicators that could not be calculated, with the reason",
    "items": {
     "properties": {
      "indicator": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "indicator",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
