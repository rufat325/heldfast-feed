  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Calculates indicators for a currency pair. Use it when the user names a currency pair and wants indicators, such as \"RSI and MACD for EUR/USD\" or \"50-day SMA for USD/JPY on the weekly chart\". Pass symbol as two ISO currency codes (for example EUR/USD), interval 1d (default) or 1w, and indicators from sma, ema, rsi, macd and bollinger; optionally periods and series_length. Reads the European Central Bank's daily euro reference rates, so it covers its 30 currencies and only close-based indicators; stocks, crypto, atr, stochastic and vwap need compute_indicators with the user's own candles. Returns the latest value and a short series for each indicator, with the source and the date of the last rate. Informational only, not financial advice; gives no signals.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "indicators": {
    "description": "Indicators to calculate: sma, ema, rsi, macd (12, 26, 9), bollinger (2 standard deviations), atr, stochastic (%K and %D) and vwap (cumulative over the given candles)",
    "items": {
     "enum": [
      "sma",
      "ema",
      "rsi",
      "macd",
      "bollinger",
      "atr",
      "stochastic",
      "vwap"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "interval": {
    "description": "1d (one value per ECB fixing, the default) or 1w (the last fixing of each week)",
    "enum": [
     "1d",
     "1w"
    ],
    "type": "string"
   },
   "periods": {
    "additionalProperties": false,
    "description": "Lookback length per indicator, in candles; any left out use the default shown",
    "properties": {
     "atr": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "bollinger": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "ema": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "rsi": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "sma": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "stochastic": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "series_length": {
    "description": "How many of the most recent values to return for each indicator, 5 by default",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "symbol": {
    "description": "Currency pair of two ISO codes, such as \"EUR/USD\" or \"USDJPY\"",
    "maxLength": 20,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "indicators"
  ],
  "type": "object"
 },
 "name": "get_indicators",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "Date or time of the last price used",
    "type": "string"
   },
   "candles": {
    "description": "Number of candles the indicators were calculated over",
    "type": "integer"
   },
   "error": {
    "description": "Present when status is not ok: a stable code, what went wrong and what to do next.",
    "properties": {
     "code": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "hint"
    ],
    "type": "object"
   },
   "indicators": {
    "items": {
     "properties": {
      "indicator": {
       "enum": [
        "sma",
        "ema",
        "rsi",
        "macd",
        "bollinger",
        "atr",
        "stochastic",
        "vwap"
       ],
       "type": "string"
      },
      "latest": {
       "description": "One value of the indicator: the candle's position (0 is the first), its time when one was given, and the value or values",
       "properties": {
        "d": {
         "type": "number"
        },
        "histogram": {
         "type": "number"
        },
        "index": {
         "type": "integer"
        },
        "k": {
         "type": "number"
        },
        "lower": {
         "type": "number"
        },
        "macd": {
         "type": "number"
        },
        "middle": {
         "type": "number"
        },
        "signal": {
         "type": "number"
        },
        "time": {
         "type": [
          "string",
          "null"
         ]
        },
        "upper": {
         "type": "number"
        },
        "value": {
         "type": "number"
        }
       },
       "required": [
        "index",
        "time"
       ],
       "type": "object"
      },
      "params": {
       "description": "The settings used",
       "type": "object"
      },
      "series": {
       "description": "The most recent values, oldest first, ending with latest",
       "items": {
        "description": "One value of the indicator: the candle's position (0 is the first), its time when one was given, and the value or values",
        "properties": {
         "d": {
          "type": "number"
         },
         "histogram": {
          "type": "number"
         },
         "index": {
          "type": "integer"
         },
         "k": {
          "type": "number"
         },
         "lower": {
          "type": "number"
         },
         "macd": {
          "type": "number"
         },
         "middle": {
          "type": "number"
         },
         "signal": {
          "type": "number"
         },
         "time": {
          "type": [
           "string",
           "null"
          ]
         },
         "upper": {
          "type": "number"
         },
         "value": {
          "type": "number"
         }
        },
        "required": [
         "index",
         "time"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "indicator",
      "params",
      "latest",
      "series"
     ],
     "type": "object"
