    ],
    "type": "string"
   },
   "symbol": {
    "description": "The pair as BASE/QUOTE; the price is how many QUOTE one BASE costs",
    "type": "string"
   }
  },
  "required": [
   "status",
   "candles",
   "latestClose",
   "indicators",
   "skipped",
   "notice",
   "library",
   "source",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Get indicators"
}
