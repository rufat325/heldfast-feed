{
 "description": "Route one inference call through a LIVE deployment (chat or completion). The stored provider key attaches server-side and never surfaces; real usage meters into the daily rollup. Requires deploy:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deploymentId": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "chat",
     "completion"
    ],
    "type": "string"
   },
   "maxTokens": {
    "type": "number"
   },
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prompt": {
    "type": "string"
   }
  },
  "required": [
   "deploymentId",
   "kind"
  ],
  "type": "object"
 },
 "name": "opentrain_deploy_route_inference",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
