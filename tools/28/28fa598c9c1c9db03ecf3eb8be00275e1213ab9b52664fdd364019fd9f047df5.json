  "title": "Read form responses"
 },
 "description": "Use this when the user wants to see what people submitted to a shareable form they made with create_shared_form \u2014 sign-ups, survey answers, RSVPs, feedback. Takes the form's link. Returns the responses, newest first, each with its answers and time. Only works for forms the user owns.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "form": {
    "description": "the form's share link (https://xenition.com/f/\u2026) or its token, from create_shared_form",
    "type": "string"
   }
  },
  "required": [
   "form"
  ],
  "type": "object"
 },
 "name": "form_responses",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
