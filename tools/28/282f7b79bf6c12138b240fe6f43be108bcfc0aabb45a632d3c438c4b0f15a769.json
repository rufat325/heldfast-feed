    "type": "number"
   },
   "pageOffset": {
    "description": "Offset for pagination",
    "type": "number"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "created_at",
     "-created_at",
     "start_date",
     "-start_date"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-status-page-maintenances"
}
