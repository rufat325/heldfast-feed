{
 "description": "Find spreadsheet by ID, URL, or name. Returns all sheets/tabs in response.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "spreadsheetRef": {
    "description": "Spreadsheet reference: full URL, exact name, or partial name (not ID - use spreadsheet-find to get ID)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "spreadsheetRef"
  ],
  "type": "object"
 },
 "name": "spreadsheet-find",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "items": {
        "description": "Matching spreadsheets sorted by modification time",
        "items": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "description": "Spreadsheet ID (from URL d/{id})",
           "type": "string"
          },
          "modifiedTime": {
           "description": "Last modified timestamp (ISO format)",
           "type": "string"
          },
          "sheets": {
           "description": "All sheets/tabs in this spreadsheet",
           "items": {
            "additionalProperties": false,
            "properties": {
             "gid": {
              "description": "Sheet ID (from URL gid={gid})",
              "type": "string"
             },
             "sheetTitle": {
              "description": "Sheet tab name",
              "type": "string"
             }
            },
            "required": [
             "gid",
             "sheetTitle"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "spreadsheetTitle": {
           "description": "Name of the spreadsheet",
           "type": "string"
          },
          "spreadsheetUrl": {
           "description": "URL to view the spreadsheet",
           "type": "string"
          }
         },
         "required": [
          "id",
          "spreadsheetTitle",
          "sheets"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "items"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
