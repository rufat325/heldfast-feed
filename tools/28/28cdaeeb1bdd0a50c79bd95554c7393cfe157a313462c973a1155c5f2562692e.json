{
 "description": "Resize an image to a target width and/or height (never upscales).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fit": {
    "default": "inside",
    "enum": [
     "cover",
     "contain",
     "fill",
     "inside",
     "outside"
    ],
    "type": "string"
   },
   "format": {
    "type": "string"
   },
   "height": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "input": {
    "description": "Path to the input file (or a data: URL / base64 string).",
    "type": "string"
   },
   "outputPath": {
    "description": "Where to write the result. Defaults to a temp file; the path is returned.",
    "type": "string"
   },
   "quality": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "width": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "image_resize"
}
