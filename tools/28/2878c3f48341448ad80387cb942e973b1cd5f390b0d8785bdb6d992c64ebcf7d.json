 },
 "description": "Funding rounds of AI companies that Minutes of AI reported, newest first: date, stage, amount, lead investors, the article FundingData cites, our story. Filter by company (name, or our entity slug) and/or since (YYYY-MM-DD, round date). Round data from FundingData (fundingdata.com), attributed per record.",
 "inputSchema": {
  "properties": {
   "company": {
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "YYYY-MM-DD",
    "format": "date",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_funding_rounds",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "items": {
     "properties": {
      "amount": {
       "description": "in the currency the article used; null = undisclosed",
       "type": [
        "string",
        "null"
       ]
      },
      "amountUsd": {
       "type": [
        "number",
        "null"
       ]
      },
      "company": {
       "type": "string"
      },
      "data": {
       "description": "the round data's origin and attribution (FundingData)",
       "type": "object"
      },
      "date": {
       "type": "string"
      },
      "entity": {
       "type": [
        "object",
        "null"
       ]
      },
      "investors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "leadInvestors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "source": {
       "description": "the article FundingData cites: {outlet, url}",
       "type": [
        "object",
        "null"
       ]
      },
      "stage": {
       "type": [
        "string",
        "null"
       ]
      },
      "story": {
       "type": [
        "object",
        "null"
       ]
      }
     },
     "required": [
      "company",
      "date",
      "leadInvestors",
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
