{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "LLM Observability Cost Calculator"
 },
 "description": "Use when a user needs to budget LLM observability tooling. Returns monthly cost at given request volume with retention adjustment.",
 "inputSchema": {
  "examples": [
   {
    "provider": "langsmith",
    "requests_per_day": 50000
   }
  ],
  "properties": {
   "avg_log_bytes": {
    "description": "Avg payload bytes per traced request (default 4096)",
    "minimum": 0,
    "type": "number"
   },
   "provider": {
    "description": "Observability provider",
    "enum": [
     "langsmith",
     "langfuse",
     "helicone",
     "portkey",
     "arize",
     "braintrust"
    ],
    "type": "string"
   },
   "requests_per_day": {
    "description": "Average daily LLM requests",
    "minimum": 0,
    "type": "number"
   },
   "retention_days": {
    "description": "Retention in days (default 30)",
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "requests_per_day",
   "provider"
  ],
  "type": "object"
 },
 "name": "observability-cost-calculator",
 "title": "LLM Observability Cost Calculator"
}
