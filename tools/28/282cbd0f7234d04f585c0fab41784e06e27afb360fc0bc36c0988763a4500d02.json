{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "PAID ($0.009 USDC via x402). Audit one public web page the way a search crawler first reads it (the HTML as served, JavaScript not run), plus the site's /robots.txt and XML sitemap: indexability (robots meta, X-Robots-Tag, a robots.txt that blocks everything), HTTPS and mixed content, title and meta-description length, canonical (and whether it points elsewhere), viewport, lang, H1 count and H2s, images without alt text, internal/external/nofollow links, readable word count, Open Graph and Twitter card, JSON-LD blocks and their @types, hreflang, favicon, redirect chain, response time and HTML weight. Returns every issue with a severity (high/medium/low), the raw measurements, and a 0-100 score. Fetched through the SSRF guard; a page we cannot read is not charged. Without payment this returns the 402 challenge; the fiatdock-mcp npm package pays automatically. Any answer the tool cannot produce is >= 400 and is NOT charged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "payment": {
    "description": "Base64 of a single x402 v2 PaymentPayload (EIP-3009 transferWithAuthorization on Base USDC). OMIT it on the first call: the 402 you get back carries `howToPay.payloadTemplate` \u2014 the exact envelope to fill in \u2014 plus the price and the EIP-712 domain. Send it on the second call to complete the purchase; it is forwarded as the PAYMENT-SIGNATURE header, never as body data. Nothing is charged for the 402 itself, and a call that fails after payment settles nothing.",
    "type": "string"
   },
   "url": {
    "description": "The page to audit (https://\u2026 or a bare domain)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "seo_audit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "checkedAt": {
    "description": "ISO time of the audit",
    "type": "string"
   },
   "checks": {
    "additionalProperties": true,
    "description": "The raw on-page measurements behind the issues",
    "properties": {
     "canonical": {
      "additionalProperties": true,
      "properties": {
       "href": {
        "type": [
         "string",
         "null"
        ]
       },
       "sameHost": {
        "type": [
         "boolean",
         "null"
        ]
       }
      },
      "required": [
       "href",
       "sameHost"
      ],
      "type": "object"
     },
     "favicon": {
      "type": "boolean"
     },
     "headings": {
      "additionalProperties": true,
      "properties": {
       "h1": {
        "type": [
         "string",
         "null"
        ]
       },
       "h1Count": {
        "type": "number"
       },
       "h2Count": {
        "type": "number"
       }
      },
      "required": [
       "h1Count",
       "h1",
       "h2Count"
      ],
      "type": "object"
     },
     "hreflangCount": {
      "type": "number"
     },
     "images": {
      "additionalProperties": true,
      "properties": {
       "count": {
        "type": "number"
       },
       "missingAlt": {
        "type": "number"
       }
      },
      "required": [
       "count",
       "missingAlt"
      ],
      "type": "object"
     },
     "indexable": {
      "type": "boolean"
     },
     "lang": {
      "type": [
       "string",
       "null"
      ]
     },
     "links": {
      "additionalProperties": true,
      "properties": {
       "external": {
        "type": "number"
       },
       "internal": {
        "type": "number"
       },
       "nofollow": {
        "type": "number"
       }
      },
      "required": [
       "internal",
       "external",
       "nofollow"
      ],
      "type": "object"
     },
     "metaDescription": {
      "additionalProperties": true,
      "properties": {
       "length": {
        "type": "number"
       },
       "text": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "text",
       "length"
      ],
      "type": "object"
     },
     "mixedContentCount": {
      "type": "number"
     },
     "openGraph": {
      "additionalProperties": true,
      "properties": {
       "description": {
        "type": "boolean"
       },
       "image": {
        "type": "boolean"
       },
       "title": {
        "type": "boolean"
       }
      },
      "required": [
       "title",
       "description",
       "image"
      ],
      "type": "object"
     },
     "robotsMeta": {
      "type": [
       "string",
       "null"
      ]
     },
     "structuredData": {
      "additionalProperties": true,
      "properties": {
       "blocks": {
        "type": "number"
       },
       "invalid": {
        "type": "number"
       },
       "types": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "blocks",
       "invalid",
       "types"
      ],
      "type": "object"
     },
     "title": {
      "additionalProperties": true,
      "properties": {
       "length": {
        "type": "number"
       },
       "text": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "text",
       "length"
      ],
      "type": "object"
     },
     "twitterCard": {
      "type": [
       "string",
       "null"
      ]
     },
     "viewport": {
      "type": "boolean"
     },
     "wordCount": {
      "type": "number"
     },
     "xRobotsTag": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "title",
     "metaDescription",
     "canonical",
     "robotsMeta",
     "xRobotsTag",
     "indexable",
     "viewport",
     "lang",
     "headings",
     "images",
     "links",
     "wordCount",
     "openGraph",
     "twitterCard",
     "structuredData",
     "hreflangCount",
     "favicon",
     "mixedContentCount"
    ],
    "type": "object"
   },
   "defaulted": {
    "additionalProperties": false,
    "description": "Present only when the body was empty: which subject the answer is for, and why",
    "properties": {
     "field": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "to": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "required": [
     "field",
     "to",
     "value",
     "note"
    ],
    "type": "object"
   },
   "finalUrl": {
    "description": "The page actually audited, after redirects (at most 3, each safety-checked)",
    "type": "string"
   },
   "grade": {
    "description": "A (90+), B (80+), C (70+), D (60+), F",
    "type": "string"
   },
   "htmlBytes": {
    "description": "Size of the HTML, in bytes",
    "type": "number"
   },
   "https": {
    "description": "Whether the page is served over HTTPS",
    "type": "boolean"
   },
   "issues": {
    "description": "Every finding, most severe first, with what is wrong",
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "description": "How the page was read, and the limits",
    "type": "string"
   },
   "redirects": {
    "description": "Each redirect hop before the page",
    "items": {
     "additionalProperties": true,
     "properties": {
      "from": {
       "type": "string"
      },
      "status": {
       "type": "number"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "status",
      "to"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "responseMs": {
    "description": "Time to download the page, in ms",
    "type": "number"
   },
   "robotsTxt": {
    "additionalProperties": true,
    "description": "What /robots.txt says to every crawler",
    "properties": {
     "blocksAll": {
      "type": "boolean"
     },
     "disallowRules": {
      "type": "number"
     },
     "sitemaps": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "status",
     "blocksAll",
     "disallowRules",
     "sitemaps"
    ],
    "type": "object"
   },
   "score": {
    "description": "0-100: 100 minus 20 per high, 8 per medium and 3 per low issue",
    "type": "number"
   },
   "sitemap": {
    "additionalProperties": true,
    "description": "The XML sitemap found (from robots.txt, else /sitemap.xml) and how many URLs it lists",
    "properties": {
     "status": {
      "type": [
       "number",
       "null"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     },
     "urlCount": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "url",
     "status",
     "urlCount"
    ],
    "type": "object"
   },
   "status": {
    "description": "HTTP status of the page",
    "type": "number"
   },
   "url": {
    "description": "The URL asked for",
    "type": "string"
   }
  },
  "required": [
   "url",
   "finalUrl",
   "status",
   "https",
   "responseMs",
   "htmlBytes",
   "redirects",
   "score",
   "grade",
   "issues",
   "checks",
   "robotsTxt",
   "sitemap",
   "checkedAt",
   "note"
  ],
  "type": "object"
 },
 "title": "Technical SEO audit of a web page ($0.009)"
}
