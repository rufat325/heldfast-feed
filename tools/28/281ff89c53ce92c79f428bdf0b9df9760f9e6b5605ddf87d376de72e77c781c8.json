{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Confirm and publish an interview plan"
 },
 "description": "Bind an already-previewed interview-plan publish with explicit approval metadata and matching idempotency key.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "interview_plan.publish",
    "type": "string"
   },
   "binding": {
    "additionalProperties": false,
    "properties": {
     "approved_action_key": {
      "minLength": 1,
      "type": "string"
     },
     "approved_idempotency_key": {
      "minLength": 1,
      "type": "string"
     },
     "approved_input_hash": {
      "minLength": 1,
      "type": "string"
     },
     "preview_hash": {
      "minLength": 1,
      "type": "string"
     },
     "resource_version_precondition": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "preview_hash",
     "approved_action_key",
     "approved_input_hash",
     "approved_idempotency_key",
     "resource_version_precondition"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "approval_id": {
      "maxLength": 128,
      "type": "string"
     },
     "draft_id": {
      "pattern": "^ipd_[0-9A-Za-z]{16,64}$",
      "type": "string"
     },
     "expected_draft_version": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "draft_id"
    ],
    "type": "object"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "resource": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "minLength": 1,
      "type": "string"
     },
     "type": {
      "const": "interview_plan",
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "input",
   "binding"
  ],
  "type": "object"
 },
 "name": "yardstick_interview_plans_publish_bind",
 "title": "Confirm and publish an interview plan"
}
