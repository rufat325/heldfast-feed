{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Prepare an invoice, quote or receipt to download"
 },
 "description": "Prepare an invoice, quote, receipt, credit note or pro forma invoice in TapTax's free document generator, without a TapTax account. Returns the totals and a link that opens the generator with the document filled in, where the person checks it, adds a logo if they like, and downloads the PDF. The details travel in the link itself and are not stored by TapTax.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "clientAddress": {
    "maxLength": 500,
    "type": "string"
   },
   "clientEmail": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "clientName": {
    "maxLength": 200,
    "type": "string"
   },
   "date": {
    "description": "Issue date, YYYY-MM-DD; defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "fromAddress": {
    "maxLength": 500,
    "type": "string"
   },
   "fromName": {
    "description": "The business issuing it",
    "maxLength": 200,
    "type": "string"
   },
   "kind": {
    "description": "Which document",
    "enum": [
     "invoice",
     "quote",
     "receipt",
     "credit_note",
     "proforma_invoice"
    ],
    "type": "string"
   },
   "lines": {
    "items": {
     "properties": {
      "description": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "maximum": 99999,
       "type": "number"
      },
      "unit": {
       "description": "Defaults to item",
       "enum": [
        "item",
        "hour",
        "day",
        "week",
        "month",
        "job",
        "mile"
       ],
       "type": "string"
      },
      "unitPrice": {
       "description": "In pounds, before VAT",
       "maximum": 10000000,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity",
      "unitPrice"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "notes": {
    "maxLength": 1000,
    "type": "string"
   },
   "number": {
    "description": "Document number, e.g. INV-0042",
    "maxLength": 40,
    "type": "string"
   },
   "paymentTerms": {
    "maxLength": 300,
    "type": "string"
   },
   "template": {
    "description": "Design; defaults to the generator default",
    "enum": [
     "classic",
     "plain",
     "trades",
     "consultancy",
     "creative",
     "retail"
    ],
    "type": "string"
   },
   "vatRatePercent": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 5,
      "type": "number"
     },
     {
      "const": 20,
      "type": "number"
     }
    ],
    "description": "Defaults to 0"
   }
  },
  "required": [
   "kind",
   "lines"
  ],
  "type": "object"
 },
 "name": "prepare_business_document",
 "title": "Prepare an invoice, quote or receipt to download"
}
