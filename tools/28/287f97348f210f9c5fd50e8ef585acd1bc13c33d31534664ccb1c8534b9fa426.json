{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Service"
 },
 "description": "Create a bookable service. Sets duration, price, capacity, and policies. Use list_service_categories first if you want to attach to an existing category.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowedTierIds": {
    "description": "Required when visibility=members_only",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "capacity": {
    "description": "How many participants per slot (default 1)",
    "type": "number"
   },
   "categoryId": {
    "description": "Existing service category ID",
    "type": "string"
   },
   "commissionCurrency": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Commission currency (ISO code)"
   },
   "commissionType": {
    "anyOf": [
     {
      "enum": [
       "fixed",
       "percentage"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Commission type: \"fixed\" or \"percentage\""
   },
   "commissionValue": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Commission amount as decimal string"
   },
   "cooldownMinutes": {
    "description": "Minimum gap before bookings can be cancelled (default 0)",
    "type": "number"
   },
   "currency": {
    "description": "ISO currency code, default HKD",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "durationMinutes": {
    "description": "Duration of one booking in minutes",
    "type": "number"
   },
   "name": {
    "description": "Service name",
    "type": "string"
   },
   "price": {
    "description": "Decimal string, e.g. \"80.00\". Defaults to \"0\".",
    "type": "string"
   },
   "requireLogin": {
    "description": "Default true \u2014 guests cannot book",
    "type": "boolean"
   },
   "requiresConfirmation": {
    "description": "If true, bookings start as pending and need confirm_booking",
    "type": "boolean"
   },
   "requiresResource": {
    "description": "Whether the service requires a resource (room/equipment)",
    "type": "boolean"
   },
   "requiresStaff": {
    "description": "Whether the service requires staff assignment",
    "type": "boolean"
   },
   "sortOrder": {
    "description": "Sort order (lower = earlier)",
    "type": "number"
   },
   "status": {
    "description": "Default active",
    "enum": [
     "active",
     "inactive",
     "archived"
    ],
    "type": "string"
   },
   "type": {
    "description": "Default one_on_one",
    "enum": [
     "one_on_one",
     "group",
     "class"
    ],
    "type": "string"
   },
   "visibility": {
    "description": "Visibility: public | members_only | hidden",
    "enum": [
     "public",
     "members_only",
     "hidden"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "durationMinutes"
  ],
  "type": "object"
 },
 "name": "create_service",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
