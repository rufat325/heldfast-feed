{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/commerce.pack-plan",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Choose the lowest-cost whole-pack combination for a required count with exact prices and explicit pack limits; up to 20 interchangeable offers. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "minorUnitDigits": {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     "offers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxPacks": {
         "maximum": 1000,
         "minimum": 0,
         "type": "integer"
        },
        "price": {
         "maxLength": 19,
         "pattern": "^(0|[1-9]\\d{0,11})(\\.\\d{1,6})?$",
         "type": "string"
        },
        "unitsPerPack": {
         "maximum": 1000,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "id",
        "unitsPerPack",
        "price",
        "maxPacks"
       ],
       "type": "object"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "requiredUnits": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "currency",
     "minorUnitDigits",
     "requiredUnits",
     "offers"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "commerce_pack_plan",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "currency": {
    "type": "string"
   },
   "excessUnits": {
    "type": [
     "integer",
     "null"
    ]
   },
   "feasible": {
    "type": "boolean"
   },
   "itemSubtotal": {
    "type": [
     "string",
     "null"
    ]
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "lineSubtotal": {
       "type": "string"
      },
      "packs": {
       "type": "number"
      },
      "units": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "packs",
      "units",
      "lineSubtotal"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "minorUnitDigits": {
    "type": "number"
   },
   "packCount": {
    "type": [
     "integer",
     "null"
    ]
   },
   "requiredUnits": {
    "type": "number"
   },
   "scope": {
    "type": "string"
   },
   "totalUnits": {
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "currency",
   "minorUnitDigits",
   "requiredUnits",
   "feasible",
   "totalUnits",
   "excessUnits",
   "itemSubtotal",
   "packCount",
   "lines",
   "scope"
  ],
  "type": "object"
 }
}
