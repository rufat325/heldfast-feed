{
 "description": "Store multiple facts or pieces of information at once. More efficient than calling remember() in a loop.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "Agent that created these memories",
    "type": "string"
   },
   "app_id": {
    "description": "App identifier for scoping",
    "type": "string"
   },
   "memories": {
    "description": "Array of memories to store",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "The fact, note, or information to remember",
       "type": "string"
      },
      "memory_type": {
       "description": "Type hint for the memory. Default: factual",
       "enum": [
        "factual",
        "preference",
        "event",
        "relationship",
        "technical",
        "episodic",
        "procedural",
        "instruction"
       ],
       "type": "string"
      }
     },
     "required": [
      "content"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "session_id": {
    "description": "Scope all memories to a conversation session",
    "type": "string"
   },
   "user_id": {
    "description": "Scope all memories to a specific user",
    "type": "string"
   },
   "volume_id": {
    "description": "Volume (memory space) ID. Uses default if not set.",
    "type": "string"
   }
  },
  "required": [
   "memories"
  ],
  "type": "object"
 },
 "name": "batch_remember"
}
