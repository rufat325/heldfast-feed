{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing SLO's name, description, thresholds, monitorIds, or tags. Fetches current SLO first to merge unspecified fields. Write-gated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "New description (unchanged if omitted)",
    "type": "string"
   },
   "monitorIds": {
    "description": "Replace linked monitor IDs (monitor-type SLOs only)",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "name": {
    "description": "New SLO name (unchanged if omitted)",
    "type": "string"
   },
   "sloId": {
    "description": "SLO ID to update",
    "type": "string"
   },
   "tags": {
    "description": "Replace tags (unchanged if omitted)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "thresholds": {
    "description": "Replace thresholds (unchanged if omitted)",
    "items": {
     "properties": {
      "target": {
       "description": "Target SLI value (e.g. 99.9)",
       "type": "number"
      },
      "timeframe": {
       "description": "SLO time window",
       "enum": [
        "7d",
        "30d",
        "90d"
       ],
       "type": "string"
      },
      "warning": {
       "description": "Optional warning threshold (must be > target)",
       "type": "number"
      }
     },
     "required": [
      "target",
      "timeframe"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "sloId"
  ],
  "type": "object"
 },
 "name": "update-slo"
}
