 "description": "Read a Base wallet native ETH balance and up to five ERC20 token balances at one pinned block. Separate balance lookups each answer at whatever height they happened to see, so they cannot be compared; these are all read at the same block and the block is in the response. Replaces six calls with one. Pay 8000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "tokens": {
    "description": "Up to five ERC20 contract addresses to read balances for.",
    "example": [
     "0x833589fcd6edb6e08f4c7c32d4f71b54bda02913"
    ],
    "items": {
     "pattern": "^0x[0-9a-fA-F]{40}$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "wallet": {
    "description": "Wallet address to read.",
    "example": "0x25e8245f07d5e4873987293dad666afbe56a9608",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "wallet"
  ],
  "type": "object"
 },
 "name": "base_wallet_snapshot",
