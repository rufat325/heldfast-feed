 "description": "List places within a radius (meters) of a lat/lng you already have, such as the user's location or a geocode result, optionally filtered by Places types (e.g. [\"restaurant\"]) and ranked by DISTANCE or POPULARITY. For free-text, name, or city queries use places_search_text instead. Returns place_id, name, formatted address, lat/lng, types, rating, opening hours, and attributions.",
 "inputSchema": {
  "properties": {
   "field_mask": {
    "type": "string"
   },
   "included_types": {
    "description": "Places types, e.g. [\"restaurant\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "language_code": {
    "type": "string"
   },
   "latitude": {
    "type": "number"
   },
   "longitude": {
    "type": "number"
   },
   "max_result_count": {
    "type": "integer"
   },
   "radius": {
    "description": "Circle radius in meters",
    "type": "number"
   },
   "rank_preference": {
    "description": "DISTANCE or POPULARITY",
    "type": "string"
   }
  },
  "required": [
   "latitude",
   "longitude",
   "radius"
  ],
  "type": "object"
 },
