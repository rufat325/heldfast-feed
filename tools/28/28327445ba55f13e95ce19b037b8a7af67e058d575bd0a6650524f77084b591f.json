{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Edit playlist"},"description":"Adds, removes and reorders playlist items with a JSON Patch (RFC 6902) over the document playlist_get returns. All operations apply or none.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"live":{"description":"Apply to the running stream now. Omitted: a live stream keeps its current playlist until restarted.","type":"boolean"},"patch":{"examples":[[{"op":"add","path":"/items/-","value":{"objectId":"obj_123"}},{"from":"/items/4","op":"move","path":"/items/0"}]],"items":{"additionalProperties":false,"properties":{"from":{"description":"move only.","pattern":"^/items/\\d+$","type":"string"},"op":{"enum":["add","remove","move","replace","test"],"type":"string"},"path":{"description":"/items/<index>, /items/- (end), or /version (test only).","pattern":"^/(items/(\\d+|-)|version)$","type":"string"},"value":{"description":"add, replace: {\"objectId\":\"obj_\u2026\"}. test: the version from playlist_get."}},"required":["op","path"],"type":"object"},"minItems":1,"type":"array"},"playlistId":{"pattern":"^pl_","type":"string"}},"required":["playlistId","patch"],"type":"object"},"name":"playlist_patch","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":{},"anyOf":[{"properties":{"customOrderId":{},"hasMore":{},"id":{},"items":{},"kind":{},"live":{},"mode":{},"nextCursor":{},"total":{},"version":{}},"required":["id","kind","version","mode","customOrderId","items","nextCursor","hasMore","total"],"type":"object"},{"properties":{"applied":{},"code":{},"currentRevision":{},"detail":{},"errors":{},"failed":{},"issues":{}},"required":["code","detail"],"type":"object"}],"properties":{},"type":"object"},"title":"Edit playlist"}
