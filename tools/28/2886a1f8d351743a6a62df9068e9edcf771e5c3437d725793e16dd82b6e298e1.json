{
 "description": "Atomically place a READY video in canonical Instructions or LMS draft content and reconcile its reference. This never publishes a release.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "target": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "afterNodeId": {
        "$ref": "#/properties/assetId"
       },
       "instructionNodeId": {
        "$ref": "#/properties/assetId"
       },
       "instructionPageId": {
        "$ref": "#/properties/assetId"
       },
       "surface": {
        "const": "INSTRUCTIONS_PAGE",
        "type": "string"
       }
      },
      "required": [
       "surface",
       "instructionPageId",
       "instructionNodeId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "afterNodeId": {
        "$ref": "#/properties/assetId"
       },
       "lmsCourseId": {
        "$ref": "#/properties/assetId"
       },
       "lmsLessonKey": {
        "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$",
        "type": "string"
       },
       "lmsNodeId": {
        "$ref": "#/properties/assetId"
       },
       "surface": {
        "const": "LMS_COURSE",
        "type": "string"
       }
      },
      "required": [
       "surface",
       "lmsCourseId",
       "lmsLessonKey",
       "lmsNodeId"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "assetId",
   "target",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_video_library_attach_reference",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
