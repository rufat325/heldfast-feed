{
 "description": "Send a prompt to an active ACP session. Returns immediately with { status: \"prompted\" }. Use prompt or prompt_events to consume events.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "prompt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "text": {
           "type": "string"
          },
          "type": {
           "const": "text",
           "type": "string"
          }
         },
         "required": [
          "type",
          "text"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "mimeType": {
           "type": "string"
          },
          "type": {
           "const": "resource_link",
           "type": "string"
          },
          "uri": {
           "type": "string"
          }
         },
         "required": [
          "type",
          "uri"
         ],
         "type": "object"
        }
       ]
      },
      "type": "array"
     }
    ],
    "description": "Prompt text or content blocks"
   },
   "sessionId": {
    "description": "Active session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "prompt"
  ],
  "type": "object"
 },
 "name": "prompt_start"
}
