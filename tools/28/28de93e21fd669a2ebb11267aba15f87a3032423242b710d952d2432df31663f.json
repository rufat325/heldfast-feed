{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Resource"
 },
 "description": "Create a bookable resource (room, equipment, vehicle). Used by services that have requiresResource=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capacity": {
    "description": "How many concurrent bookings (default 1)",
    "type": "number"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "name": {
    "description": "Resource name (e.g. \"Treatment Room A\")",
    "type": "string"
   },
   "status": {
    "description": "Default active",
    "enum": [
     "active",
     "inactive"
    ],
    "type": "string"
   },
   "type": {
    "description": "Free-form type label, e.g. \"room\", \"equipment\"",
    "type": "string"
   }
  },
  "required": [
   "name",
   "type"
  ],
  "type": "object"
 },
 "name": "create_resource",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
