{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save form/checklist data using allowed JSON Patch paths, or update status. For setup and checklists supply factual executionEvidence {source,checkedAt,summary} from the host's connected plugins/tests. Never store credentials. Read get_bucket first. Does not provision infrastructure itself.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bucketKey": {
    "type": "string"
   },
   "executionEvidence": {
    "additionalProperties": true,
    "type": "object"
   },
   "patch": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "op": {
       "enum": [
        "add",
        "replace",
        "remove"
       ],
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "op",
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "phaseKey": {
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "projectName": {
    "type": "string"
   },
   "status": {
    "enum": [
     "not_started",
     "in_progress",
     "done"
    ],
    "type": "string"
   }
  },
  "required": [
   "phaseKey",
   "bucketKey"
  ],
  "type": "object"
 },
 "name": "launchchair_update_bucket"
}
