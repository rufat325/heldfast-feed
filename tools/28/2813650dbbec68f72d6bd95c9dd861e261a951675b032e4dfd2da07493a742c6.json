{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Stress a crypto portfolio"
 },
 "description": "Caller-input linear shocks for 20 exposures: P&L, equity, asset/venue concentration. Symbols are scenario labels. No liquidation/probability model.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "equity_usd": {
    "maximum": 1000000000000.0,
    "minimum": 0.01,
    "type": "number"
   },
   "positions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset": {
       "pattern": "^[A-Z0-9][A-Z0-9._-]{0,15}$",
       "type": "string"
      },
      "cost_usd": {
       "default": 0,
       "maximum": 1000000000000.0,
       "minimum": 0,
       "type": "number"
      },
      "notional_usd": {
       "maximum": 1000000000000.0,
       "minimum": 0.01,
       "type": "number"
      },
      "price_change_pct": {
       "maximum": 1000,
       "minimum": -100,
       "type": "number"
      },
      "side": {
       "enum": [
        "long",
        "short"
       ]
      },
      "venue": {
       "pattern": "^[a-z0-9][a-z0-9._-]{0,31}$",
       "type": "string"
      }
     },
     "required": [
      "asset",
      "side",
      "notional_usd",
      "price_change_pct"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "equity_usd",
   "positions"
  ],
  "type": "object"
 },
 "name": "crypto_portfolio_stress",
 "title": "Stress a crypto portfolio"
}
