{
 "description": "Bind a proposed tool call to declared intent and execution policy; 0.002 USDC.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "call": {
     "arguments": {
      "q": "public filings"
     },
     "cost_atomic": "1000",
     "destination": "api.example",
     "tool": "search"
    },
    "intent": {
     "tools": [
      "search"
     ]
    },
    "policy": {
     "allowed_destinations": [
      "api.example"
     ],
     "allowed_tools": [
      "search"
     ],
     "max_cost_atomic": "2000"
    }
   }
  ],
  "properties": {
   "call": {
    "type": "object"
   },
   "intent": {
    "type": "object"
   },
   "policy": {
    "type": "object"
   }
  },
  "required": [
   "call",
   "intent",
   "policy"
  ],
  "type": "object"
 },
 "name": "tool_call_policy_guard",
 "outputSchema": {
  "required": [
   "charged",
   "assessment",
   "receipt"
  ],
  "type": "object"
 }
}
