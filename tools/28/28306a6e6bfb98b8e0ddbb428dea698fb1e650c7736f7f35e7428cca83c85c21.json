{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Show a note's version history, or diff two versions. Omit from/to to list available versions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "file": {
    "description": "Vault-relative path to the note.",
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "Version number to diff from.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "to": {
    "description": "Version number to diff to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "file"
  ],
  "type": "object"
 },
 "name": "note_diff",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Optional tool-specific structured result data."
   },
   "text": {
    "description": "Human-readable result text.",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "title": "Diff note versions"
}
