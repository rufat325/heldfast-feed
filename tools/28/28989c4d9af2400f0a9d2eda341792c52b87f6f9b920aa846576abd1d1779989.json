{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Normalize hotel feed"
 },
 "description": "Parse a hotel feed and normalize common supplier or platform aliases into a canonical hotel-record shape without changing the source payload.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "Feed content. Paste the JSON, XML, CSV, TSV or NDJSON payload directly. Maximum size is 2 MB.",
    "maxLength": 2000000,
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "description": "Optional input-format override. Omit or use auto to detect JSON, NDJSON, XML, CSV or TSV automatically.",
    "enum": [
     "auto",
     "json",
     "xml",
     "csv",
     "tsv",
     "ndjson"
    ],
    "type": "string"
   },
   "target": {
    "description": "Optional target whose parser conventions should be used while normalizing the feed. Defaults to generic hotel master data.",
    "enum": [
     "wego",
     "google_hotel_center",
     "trivago",
     "meta_catalog",
     "criteo",
     "hotel_master_data"
    ],
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "normalize_hotel_feed",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "JSON",
     "XML",
     "CSV",
     "TSV",
     "NDJSON"
    ],
    "type": "string"
   },
   "recordCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "records": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {},
      "amenities": {},
      "availability": {},
      "brand": {},
      "category": {},
      "city": {},
      "country": {},
      "currency": {},
      "description": {},
      "id": {},
      "image": {},
      "latitude": {},
      "link": {},
      "longitude": {},
      "name": {},
      "phone": {},
      "postalCode": {},
      "price": {},
      "province": {},
      "sourceIndex": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "starRating": {}
     },
     "required": [
      "sourceIndex"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "format",
   "records",
   "recordCount",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Normalize hotel feed"
}
