    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results (default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Max price per call. Omit for no cap.",
    "type": "number"
   },
   "min_score": {
    "description": "Min probe score, 0..1 (0.8 = reliably passing).",
    "type": "number"
   },
   "query": {
