{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Quote an order"
 },
 "description": "Prices a cart exactly as it will be charged (taxes included) and returns a confirmationToken for gpucloud_create_order with the same items. (permission: orders:quote) [Requires a free GPU Cloud account and MCP key]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Billing country (default: the one of the last order, else CA).",
    "enum": [
     "CA",
     "US",
     "OTHER"
    ],
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "addons": {
       "additionalProperties": {
        "type": "boolean"
       },
       "default": {
        "backup": false,
        "monitoring": false,
        "premiumSupport": false
       },
       "properties": {
        "backup": {
         "default": false,
         "type": "boolean"
        },
        "monitoring": {
         "default": false,
         "type": "boolean"
        },
        "premiumSupport": {
         "default": false,
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "billing": {
       "enum": [
        "hourly",
        "monthly",
        "annual"
       ],
       "type": "string"
      },
      "productId": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "default": 1,
       "description": "Always 1: one order line = one GPU server. To order several servers, add one line per server.",
       "maximum": 1,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "productId",
      "billing"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "province": {
    "description": "Province code for taxes, e.g. QC, ON (default: the one of the last order, else QC).",
    "maxLength": 50,
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "gpucloud_quote_order",
 "title": "Quote an order"
}
