{
 "_meta": {
  "openai/toolInvocation/invoked": "Catalog results ready",
  "openai/toolInvocation/invoking": "Searching CareClinic\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "careclinic.wellness.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Finds an owned medication, symptom or sleep care plan before preparing a log. Never invent an item ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "enum": [
     "symptom",
     "medication",
     "sleep"
    ],
    "type": "string"
   },
   "query": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain",
   "query"
  ],
  "type": "object"
 },
 "name": "careclinic_search_catalog",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "enum": [
     "symptom",
     "medication",
     "sleep"
    ],
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "enum": [
        "symptom",
        "medication",
        "sleep"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "secondaryLabel": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "domain"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "kind": {
    "const": "catalog_results",
    "type": "string"
   }
  },
  "required": [
   "kind",
   "domain",
   "items"
  ],
  "type": "object"
 },
 "title": "Search the connected CareClinic catalog"
}
