{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "FX Rate"
 },
 "description": "Live mid-market FX rate for any currency pair. Returns mid rate, bid/ask spread, daily volatility %, regulatory flags for the corridor, and data freshness. Sourced from central bank rates (open.er-api.com, updated hourly, no API key required). Free.",
 "inputSchema": {
  "properties": {
   "from": {
    "description": "Source currency ISO 4217 code (e.g. USD)",
    "type": "string"
   },
   "to": {
    "description": "Target currency ISO 4217 code (e.g. BRL)",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "fx.rate",
 "outputSchema": {
  "properties": {
   "ask": {
    "type": "number"
   },
   "bid": {
    "type": "number"
   },
   "corridorFlags": {
    "description": "Regulatory flags for this corridor",
    "type": "array"
   },
   "dailyVolatilityPct": {
    "description": "Estimated daily FX volatility %",
    "type": "number"
   },
   "mid": {
    "description": "Mid-market rate (from \u2192 to)",
    "type": "number"
   },
   "pair": {
    "type": "string"
   },
   "spreadPct": {
    "description": "Implied interbank spread %",
    "type": "number"
   },
   "updatedAt": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
