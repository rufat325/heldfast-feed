{
 "description": "Create and manage unpublished review comments on merge requests. Actions: create (new draft), update (modify text), publish (make single draft visible), publish_all (submit entire review), delete (discard draft). Related: browse_mr_discussions action 'drafts' to list existing drafts.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform: create, update, publish, publish_all, delete",
    "enum": [
     "create",
     "update",
     "publish",
     "publish_all",
     "delete"
    ],
    "type": "string"
   },
   "commit_id": {
    "description": "SHA of commit to start discussion on Required for 'create' action(s).",
    "type": "string"
   },
   "draft_note_id": {
    "description": "ID of the draft note Required for 'update', 'publish', 'delete' action(s).",
    "minLength": 1,
    "type": "string"
   },
   "in_reply_to_discussion_id": {
    "description": "Discussion ID to reply to Required for 'create' action(s).",
    "type": "string"
   },
   "merge_request_iid": {
    "description": "Internal MR ID unique to project",
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "New content for the draft note Required for 'create', 'update' action(s).",
    "type": "string"
   },
   "position": {
    "additionalProperties": false,
    "description": "Position for diff note Required for 'create', 'update' action(s).",
    "properties": {
     "base_sha": {
      "description": "Base commit SHA for three-way diff.",
      "type": "string"
     },
     "head_sha": {
      "description": "Latest commit SHA in MR source branch.",
      "type": "string"
     },
     "height": {
      "description": "Image height in pixels.",
      "type": "number"
     },
     "line_range": {
      "additionalProperties": false,
      "description": "Line range for multi-line comments.",
      "properties": {
       "end": {
        "additionalProperties": false,
        "properties": {
         "line_code": {
          "type": "string"
         },
         "new_line": {
          "type": "number"
         },
         "old_line": {
          "type": "number"
         },
         "type": {
          "enum": [
           "new",
           "old"
          ],
          "type": "string"
         }
        },
        "required": [
         "line_code"
        ],
        "type": "object"
       },
       "start": {
        "additionalProperties": false,
        "properties": {
         "line_code": {
          "type": "string"
         },
         "new_line": {
          "type": "number"
         },
         "old_line": {
          "type": "number"
         },
         "type": {
          "enum": [
           "new",
           "old"
          ],
          "type": "string"
         }
        },
        "required": [
         "line_code"
        ],
        "type": "object"
       }
      },
      "required": [
       "start",
       "end"
      ],
      "type": "object"
     },
     "new_line": {
      "description": "Line number in changed file.",
      "type": "number"
     },
     "new_path": {
      "description": "Current file path after changes.",
      "type": "string"
     },
     "old_line": {
      "description": "Line number in original file.",
      "type": "number"
     },
     "old_path": {
      "description": "Original file path before changes.",
      "type": "string"
     },
     "position_type": {
      "description": "Comment type: text or image.",
      "enum": [
       "text",
       "image"
      ],
      "type": "string"
     },
     "start_sha": {
      "description": "Starting commit SHA in target branch.",
      "type": "string"
     },
     "width": {
      "description": "Image width in pixels.",
      "type": "number"
     },
     "x": {
      "description": "Horizontal pixel position for image comment.",
      "type": "number"
     },
     "y": {
      "description": "Vertical pixel position for image comment.",
      "type": "number"
     }
    },
    "type": "object"
   },
   "project_id": {
    "description": "Project ID or URL-encoded path",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "action",
   "project_id",
   "merge_request_iid",
   "note"
  ],
  "type": "object"
 },
 "name": "manage_draft_notes"
}
