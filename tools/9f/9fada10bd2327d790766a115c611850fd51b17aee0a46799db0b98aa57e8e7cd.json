{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Area of a rectangle, square, triangle, circle, trapezoid, parallelogram or ellipse from your measurements, with the formula and the working shown. Web page: https://calcbright.com/area-calculator",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "shape": {
    "default": "rectangle",
    "description": "Shape",
    "enum": [
     "rectangle",
     "square",
     "triangle",
     "circle",
     "trapezoid",
     "parallelogram",
     "ellipse"
    ],
    "type": "string"
   },
   "unit": {
    "default": "m",
    "description": "Unit",
    "enum": [
     "none",
     "mm",
     "cm",
     "m",
     "km",
     "in",
     "ft",
     "yd",
     "mi"
    ],
    "type": "string"
   },
   "x": {
    "default": 12,
    "description": "Length",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "y": {
    "default": 8,
    "description": "Width",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "z": {
    "default": 5,
    "description": "",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "area_calculator",
 "title": "Area Calculator"
}
