{
 "annotations": {},
 "description": "Issue a new end-entity certificate from a CA. Returns private key, certificate, and CA chain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "altName": {
    "description": "DNS/Email SANs",
    "type": "string"
   },
   "caTag": {
    "description": "CA tag value of the issuing CA",
    "type": "string"
   },
   "commonName": {
    "description": "Common Name (1-64 chars)",
    "type": "string"
   },
   "country": {
    "description": "Country code (ISO 3166-1 alpha-2)",
    "type": "string"
   },
   "ip": {
    "description": "IP SANs (IP address format)",
    "type": "string"
   },
   "keyType": {
    "description": "Key type for the certificate",
    "enum": [
     "RSA2048",
     "RSA4096",
     "EC256",
     "EC521"
    ],
    "type": "string"
   },
   "locality": {
    "description": "City name (0-128 chars)",
    "type": "string"
   },
   "organization": {
    "description": "Organization name (0-64 chars)",
    "type": "string"
   },
   "organizationUnit": {
    "description": "Organization unit (0-128 chars)",
    "type": "string"
   },
   "period": {
    "description": "Validity period in days (1-3650) or 'MAX'",
    "type": "string"
   },
   "stateProvince": {
    "description": "State/Province (0-128 chars)",
    "type": "string"
   },
   "streetAddress": {
    "description": "Street address (0-128 chars)",
    "type": "string"
   }
  },
  "required": [
   "caTag",
   "commonName"
  ],
  "type": "object"
 },
 "name": "ncloud_pca_issue_end_cert"
}
