{
 "description": "Remove one or more tags from a contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "contactId": {
    "description": "The contact ID to remove tags from",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "tags": {
    "description": "Array of tag strings to remove",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "access_token",
   "contactId",
   "tags"
  ],
  "type": "object"
 },
 "name": "crm_remove_contact_tags"
}
