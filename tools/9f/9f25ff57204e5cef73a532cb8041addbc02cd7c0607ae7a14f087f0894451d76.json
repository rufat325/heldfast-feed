{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Cz\u0119\u015bciowa aktualizacja zam\u00f3wienia \u2014 podajesz tylko te pola, kt\u00f3re chcesz ustawi\u0107 lub zmieni\u0107; reszta zostaje nienaruszona. Zwraca aktualny status i pozosta\u0142e braki. Je\u015bli kt\u00f3rakolwiek warto\u015b\u0107 jest spoza dozwolonej listy, NIC nie zostaje zapisane i dostajesz b\u0142\u0105d INVALID_FIELD_VALUE.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access_token": {
    "description": "access_token zwr\u00f3cony JEDEN RAZ przez create_certificate_order. Bez niego zam\u00f3wienie jest niedost\u0119pne \u2014 zachowaj go na czas rozmowy i nigdy nie pokazuj u\u017cytkownikowi.",
    "maxLength": 200,
    "minLength": 20,
    "type": "string"
   },
   "address": {
    "additionalProperties": false,
    "description": "Adres nieruchomo\u015bci.",
    "properties": {
     "apartment_number": {
      "maxLength": 30,
      "type": "string"
     },
     "building_number": {
      "maxLength": 30,
      "type": "string"
     },
     "city": {
      "maxLength": 120,
      "type": "string"
     },
     "postal_code": {
      "maxLength": 10,
      "type": "string"
     },
     "street": {
      "maxLength": 200,
      "type": "string"
     }
    },
    "type": "object"
   },
   "customer": {
    "additionalProperties": false,
    "description": "Dane kontaktowe klienta.",
    "properties": {
     "email": {
      "maxLength": 200,
      "type": "string"
     },
     "first_name": {
      "maxLength": 100,
      "type": "string"
     },
     "last_name": {
      "maxLength": 100,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     }
    },
    "type": "object"
   },
   "doors": {
    "description": "Tylko dla `dom`: drzwi zewn\u0119trzne i bramy w ogrzewanej bryle.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 50,
       "minimum": 1,
       "type": "integer"
      },
      "height_cm": {
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      },
      "material": {
       "enum": [
        "Stalowe",
        "Aluminiowe",
        "PVC",
        "Drewniane",
        "Nie wiem"
       ],
       "type": "string"
      },
      "width_cm": {
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      }
     },
     "required": [
      "material",
      "count"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "fields": {
    "description": "Pola specyficzne dla typu nieruchomo\u015bci, w formie \u015bcie\u017cka \u2192 warto\u015b\u0107.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "description": "\u015acie\u017cka pola z get_certificate_order_requirements, np. \"heating.heating\".",
       "maxLength": 200,
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "maxLength": 2000,
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "items": {
          "maxLength": 200,
          "type": "string"
         },
         "maxItems": 20,
         "type": "array"
        }
       ],
       "description": "Warto\u015b\u0107 pola. Dla p\u00f3l enum u\u017cyj DOK\u0141ADNIE jednej z warto\u015bci z `options` \u2014 inna warto\u015b\u0107 jest odrzucana b\u0142\u0119dem INVALID_FIELD_VALUE."
      }
     },
     "required": [
      "path",
      "value"
     ],
     "type": "object"
    },
    "maxItems": 80,
    "type": "array"
   },
   "options": {
    "additionalProperties": false,
    "description": "P\u0142atne dodatki: express_24h (Express 8H \u2013 8 godzin roboczych; nazwa pola historyczna), paper_version.",
    "properties": {
     "express_24h": {
      "description": "Dodatek Express 8H \u2013 realizacja w 8 godzin roboczych (nazwa pola historyczna).",
      "type": "boolean"
     },
     "paper_version": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "order_id": {
    "description": "order_id zwr\u00f3cony przez create_certificate_order",
    "format": "uuid",
    "type": "string"
   },
   "property": {
    "additionalProperties": false,
    "description": "Podstawowe parametry: powierzchnia u\u017cytkowa, wysoko\u015b\u0107 pomieszcze\u0144, rok oddania do u\u017cytkowania.",
    "properties": {
     "area_m2": {
      "exclusiveMinimum": 0,
      "maximum": 10000,
      "type": "number"
     },
     "height_m": {
      "exclusiveMinimum": 0,
      "maximum": 20,
      "type": "number"
     },
     "year_built": {
      "maximum": 2100,
      "minimum": 1800,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "windows": {
    "description": "Tylko dla `dom`: wymiary okien. Jednakowe okna podaje si\u0119 raz z liczb\u0105 sztuk.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "count": {
       "maximum": 50,
       "minimum": 1,
       "type": "integer"
      },
      "height_cm": {
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      },
      "width_cm": {
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "number"
      }
     },
     "required": [
      "width_cm",
      "height_cm",
      "count"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   }
  },
  "required": [
   "order_id",
   "access_token"
  ],
  "type": "object"
 },
 "name": "update_certificate_order",
 "title": "Uzupe\u0142nij zam\u00f3wienie"
}
