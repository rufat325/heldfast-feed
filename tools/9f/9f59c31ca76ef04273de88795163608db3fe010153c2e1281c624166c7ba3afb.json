{
 "description": "Update multiple memories at once. Each item needs a memory_id and fields to update. Maximum 50 items per call.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "updates": {
    "description": "Array of update objects (max 50)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "description": "New category",
       "maxLength": 50,
       "type": "string"
      },
      "content": {
       "description": "New content",
       "maxLength": 10000,
       "minLength": 5,
       "type": "string"
      },
      "importance": {
       "description": "New importance",
       "maximum": 10,
       "minimum": 1,
       "type": "integer"
      },
      "memory_id": {
       "description": "Memory ID to update",
       "type": "integer"
      },
      "memory_type": {
       "description": "New memory type",
       "enum": [
        "identity",
        "preference",
        "architecture",
        "decision",
        "bug",
        "dependency",
        "pattern",
        "context",
        "session_summary",
        "task",
        "correction",
        "reminder",
        "skill",
        "rule",
        "principle",
        "intent"
       ],
       "type": "string"
      },
      "scope": {
       "description": "New scope",
       "enum": [
        "global",
        "project"
       ],
       "type": "string"
      },
      "subject": {
       "description": "New subject",
       "maxLength": 100,
       "type": "string"
      },
      "tags": {
       "description": "New tags",
       "items": {
        "maxLength": 30,
        "type": "string"
       },
       "maxItems": 5,
       "type": "array"
      }
     },
     "required": [
      "memory_id"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "updates"
  ],
  "type": "object"
 },
 "name": "bulk_update"
}
