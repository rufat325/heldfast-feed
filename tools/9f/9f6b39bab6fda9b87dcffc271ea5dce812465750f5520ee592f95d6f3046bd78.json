{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a DNS record on an Infomaniak-managed zone. Two-phase commit: first call returns a plan + token, second call (same params + token) actually creates the record.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the prior plan response. Required on the apply phase only.",
    "format": "uuid",
    "type": "string"
   },
   "source": {
    "description": "Subdomain part (e.g. 'www', 'mail') or '.' for the zone apex. Do NOT include the zone itself.",
    "type": "string"
   },
   "target": {
    "description": "Record value. For MX and SRV, embed the priority inline as Infomaniak does, e.g. '5 mta-gw.infomaniak.ch'.",
    "minLength": 1,
    "type": "string"
   },
   "ttl": {
    "default": 3600,
    "description": "Time-to-live in seconds. Min 60, max 86400 (24h). Default 3600 (1h).",
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   },
   "type": {
    "description": "Record type as enum: A, AAAA, CNAME, MX, TXT, NS, SRV, CAA, PTR. Must be UPPERCASE.",
    "enum": [
     "A",
     "AAAA",
     "CNAME",
     "MX",
     "TXT",
     "SRV",
     "NS",
     "CAA",
     "PTR",
     "SPF"
    ],
    "type": "string"
   },
   "zone": {
    "description": "DNS zone (root domain) to add the record to, e.g. 'broz.be'. Must be a domain whose DNS is managed by Infomaniak (check via infomaniak_get_domain).",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "zone",
   "source",
   "type",
   "target"
  ],
  "type": "object"
 },
 "name": "infomaniak_dns_create_record",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "source": {
        "type": "string"
       },
       "target": {
        "type": "string"
       },
       "ttl": {
        "type": "number"
       },
       "type": {
        "enum": [
         "A",
         "AAAA",
         "CNAME",
         "MX",
         "TXT",
         "SRV",
         "NS",
         "CAA",
         "PTR",
         "SPF"
        ],
        "type": "string"
       },
       "zone": {
        "type": "string"
       }
      },
      "required": [
       "zone",
       "source",
       "type",
       "target",
       "ttl"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "message": {
      "type": "string"
     },
     "record": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "number"
       },
       "source": {
        "type": "string"
       },
       "target": {
        "type": "string"
       },
       "ttl": {
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "$ref": "#/anyOf/0/properties/plan/properties/type"
       },
       "updated_at": {
        "type": "number"
       }
      },
      "required": [
       "source",
       "type",
       "ttl",
       "target"
      ],
      "type": "object"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "record",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
