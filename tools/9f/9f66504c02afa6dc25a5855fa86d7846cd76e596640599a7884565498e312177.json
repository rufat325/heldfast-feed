{
 "description": "Search for job listings by title, industry, location, and employment type. Returns jobs with company info, salary ranges, and requirements.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City name",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 country code",
    "type": "string"
   },
   "employment_type": {
    "description": "Employment type",
    "enum": [
     "full-time",
     "part-time",
     "contract",
     "freelance",
     "internship"
    ],
    "type": "string"
   },
   "industry": {
    "description": "Industry sector (e.g., \"technology\", \"healthcare\", \"finance\", \"education\")",
    "type": "string"
   },
   "limit": {
    "description": "Results per page (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_salary": {
    "description": "Minimum salary in local currency",
    "type": "number"
   },
   "page": {
    "description": "Page number",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search query for job title or keywords",
    "type": "string"
   },
   "remote": {
    "description": "Filter for remote positions only",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_jobs"
}
