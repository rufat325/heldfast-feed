{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Create a funnel for a website. confirmed=false (default) returns a preview without writing; confirmed=true creates it.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"confirmed":{"default":false,"description":"false (default) returns a preview without writing; true applies the change.","type":"boolean"},"conversionWindowHours":{"description":"Hours a visitor has to finish the funnel after the first step, 1-720. Defaults to 24. Match the journey's usual length, such as 168 or more for trial-to-paid.","maximum":720,"minimum":1,"type":"integer"},"description":{"description":"What the funnel tracks.","type":"string"},"filters":{"description":"Filters on how the visitor entered the first step; later steps are not filtered.","items":{"additionalProperties":false,"properties":{"field":{"anyOf":[{"enum":["event_name","path","referrer","country","city","device_type","browser_name","os_name","language","utm_source","utm_medium","utm_campaign","utm_term","utm_content","user_agent","screen_resolution"],"type":"string"},{"description":"properties.<key> matches a property on the conversion event itself.","format":"starts_with","maxLength":211,"pattern":"^properties\\..*","type":"string"}]},"operator":{"enum":["contains","ends_with","equals","in","not_contains","not_equals","not_in","starts_with","is_set","is_not_set","gt","gte","lt","lte"],"type":"string"},"value":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"minItems":1,"type":"array"}]}},"required":["field","operator","value"],"type":"object"},"type":"array"},"ignoreHistoricData":{"description":"true counts only data from the funnel's creation date onward.","type":"boolean"},"name":{"description":"Funnel name.","maxLength":100,"minLength":1,"type":"string"},"steps":{"description":"2 to 10 steps in order. Each target is a page path (PAGE_VIEW; * matches any characters, e.g. /docs/*) or event name (EVENT or CUSTOM). A step's filters match properties.<key> on that step's own event.","items":{"additionalProperties":false,"properties":{"filters":{"items":{"properties":{"field":{"type":"string"},"operator":{"enum":["contains","ends_with","equals","in","not_contains","not_equals","not_in","starts_with","is_set","is_not_set","gt","gte","lt","lte"],"type":"string"},"value":{"anyOf":[{"type":"string"},{"items":{"type":"string"},"minItems":1,"type":"array"}]}},"required":["field","operator","value"],"type":"object"},"maxItems":10,"minItems":1,"type":"array"},"name":{"minLength":1,"type":"string"},"target":{"minLength":1,"type":"string"},"type":{"enum":["PAGE_VIEW","EVENT","CUSTOM"],"type":"string"}},"required":["type","target","name"],"type":"object"},"maxItems":10,"minItems":2,"type":"array"},"websiteDomain":{"description":"Website domain. Alternative to websiteId.","type":"string"},"websiteId":{"description":"Website ID from list_websites","type":"string"},"websiteName":{"description":"Website name. Alternative to websiteId.","type":"string"}},"required":["name","steps"],"type":"object"},"name":"create_funnel","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"confirmationRequired":{"type":"boolean"},"message":{"type":"string"},"preview":{"type":"boolean"},"success":{"type":"boolean"}},"required":["message"],"type":"object"},"title":"Create funnel"}
