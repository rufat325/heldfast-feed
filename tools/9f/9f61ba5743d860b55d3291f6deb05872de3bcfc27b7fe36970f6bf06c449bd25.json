{
 "description": "Retrieve a specific provision from a Swedish statute. Do NOT use for keyword search \u2014 use search_legislation instead.",
 "inputSchema": {
  "properties": {
   "as_of_date": {
    "description": "Historical date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "chapter": {
    "description": "Chapter number (e.g., \"3\").",
    "type": "string"
   },
   "document_id": {
    "description": "SFS number (e.g., \"2018:218\")",
    "pattern": "^\\d{4}:\\d+$",
    "type": "string"
   },
   "provision_ref": {
    "description": "Direct provision reference (e.g., \"3:5\"). Alternative to chapter+section.",
    "type": "string"
   },
   "section": {
    "description": "Section number (e.g., \"5\", \"5 a\")",
    "type": "string"
   }
  },
  "required": [
   "document_id"
  ],
  "type": "object"
 },
 "name": "get_provision"
}
