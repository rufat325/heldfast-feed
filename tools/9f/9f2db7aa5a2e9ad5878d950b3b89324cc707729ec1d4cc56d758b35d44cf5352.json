{
 "description": "Fetch the full Markdown article for a topic slug, with infobox, related topics and citations.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "include_sources": {
    "default": true,
    "description": "Append the citation list",
    "type": "boolean"
   },
   "slug": {
    "description": "Topic slug, e.g. 'quantum-computing' (from search results)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "read_topic",
 "title": "Read a topic"
}
