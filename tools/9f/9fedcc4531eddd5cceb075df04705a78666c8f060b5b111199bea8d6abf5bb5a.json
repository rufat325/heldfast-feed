{
 "description": "Generate customized proposal sections tailored to specific buyers. Creates executive summaries, solution overviews, pricing justifications, and more.",
 "inputSchema": {
  "properties": {
   "customer_challenges": {
    "description": "Key challenges identified",
    "type": "string"
   },
   "customer_industry": {
    "description": "Customer industry",
    "type": "string"
   },
   "customer_name": {
    "description": "Customer name",
    "type": "string"
   },
   "implementation_approach": {
    "description": "How you will implement",
    "type": "string"
   },
   "key_differentiators": {
    "description": "Why you vs alternatives",
    "type": "string"
   },
   "pricing": {
    "description": "Pricing details if relevant",
    "type": "string"
   },
   "primary_audience": {
    "description": "Primary reader of proposal",
    "enum": [
     "c_suite",
     "vp_level",
     "director",
     "manager",
     "technical",
     "procurement"
    ],
    "type": "string"
   },
   "section_type": {
    "description": "Proposal section to generate",
    "enum": [
     "executive_summary",
     "problem_statement",
     "solution_overview",
     "implementation_plan",
     "pricing_justification",
     "risk_mitigation",
     "success_metrics",
     "company_overview",
     "case_studies",
     "next_steps"
    ],
    "type": "string"
   },
   "success_metrics": {
    "description": "Expected outcomes/metrics",
    "type": "string"
   },
   "tone": {
    "description": "Tone for the proposal",
    "enum": [
     "formal",
     "consultative",
     "bold",
     "conservative"
    ],
    "type": "string"
   },
   "your_solution": {
    "description": "Your product/solution",
    "type": "string"
   }
  },
  "required": [
   "section_type",
   "your_solution"
  ],
  "type": "object"
 },
 "name": "proposal_section_writer"
}
