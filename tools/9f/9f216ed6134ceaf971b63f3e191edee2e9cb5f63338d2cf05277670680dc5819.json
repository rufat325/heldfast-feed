{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update labels on received emails"
 },
 "description": "Apply the same label changes to up to 100 received messages. If any message is not found, nothing changes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "add_labels": {
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "message_ids": {
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "remove_labels": {
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   }
  },
  "required": [
   "message_ids"
  ],
  "type": "object"
 },
 "name": "bulk_update_message_labels",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "messages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "labels": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "labels"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "messages"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update labels on received emails"
}
