{
 "description": "Get economic calendar events",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category (e.g., 'gov', 'infl')",
    "type": "string"
   },
   "country": {
    "description": "Country code(s) comma-separated",
    "type": "string"
   },
   "currency": {
    "description": "Currency code(s) comma-separated",
    "type": "string"
   },
   "from": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "description": "Number of events to return (default 10)",
    "type": "integer"
   },
   "minImportance": {
    "description": "Minimum importance (0-3)",
    "maximum": 3,
    "minimum": -1,
    "type": "integer"
   },
   "to": {
    "description": "End date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "econ_calendar"
}
