{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Recent tool changes on an MCP server"},"description":"Before you rely on a public MCP server's tools, ask whether apiwatch saw them change: tools removed or renamed, new required parameters, rewritten descriptions, changed safety hints. Give a watched server's slug, URL or registry name. Returns a one line answer and the confirmed changes in the last N days (default 90, max 365), newest first, with flags worth a look. Observations only: no changes is not a statement that a server is safe. Never includes tool description text.","inputSchema":{"additionalProperties":false,"properties":{"days":{"description":"How many days back, default 90","maximum":365,"minimum":1,"type":"integer"},"server":{"description":"Slug (context7), URL (https://mcp.context7.com/mcp) or registry name","maxLength":300,"minLength":1,"type":"string"}},"required":["server"],"type":"object"},"name":"mcp_server_changes","outputSchema":{"properties":{"answer":{"type":"string"},"changes":{"items":{"properties":{"date":{"type":"string"},"events":{"items":{"properties":{"path":{"type":"string"},"severity":{"enum":["breaking","silent","deprecation","additive","info"],"type":"string"},"tool":{"description":"Tool name, or sha256:<hex> when the name is not plain","type":"string"},"type":{"type":"string"}},"required":["type","tool","path","severity"],"type":"object"},"type":"array"},"flags":{"items":{"properties":{"detail":{"type":"string"},"flag":{"enum":["description_changed","annotation_widened","hidden_characters","instruction_like_text","unusual_tool_name"],"type":"string"},"tool":{"type":"string"}},"required":["flag","tool","detail"],"type":"object"},"type":"array"},"truncated":{"type":"boolean"}},"required":["date","events","flags","truncated"],"type":"object"},"type":"array"},"days":{"type":"integer"},"from":{"type":"string"},"index_url":{"type":"string"},"notes":{"items":{"properties":{"date":{"type":"string"},"kind":{"type":"string"}},"required":["date","kind"],"type":"object"},"type":"array"},"query":{"type":"string"},"server":{"properties":{"changes_total":{"type":"integer"},"first_seen":{"type":"string"},"last_change":{"type":"string"},"last_checked":{"type":"string"},"name":{"type":"string"},"open_flags":{"description":"Flags from the last 30 days","items":{"enum":["description_changed","annotation_widened","hidden_characters","instruction_like_text","unusual_tool_name"],"type":"string"},"type":"array"},"page_url":{"type":"string"},"registry_name":{"type":"string"},"slug":{"type":"string"},"status":{"enum":["pending_first_check","ok","needs_login","not_reachable","empty_tools","failing"],"type":"string"},"status_since":{"type":"string"},"tool_count":{"description":"Tools at the last good check; null before the first one","type":["integer","null"]},"url":{"type":"string"}},"type":["object","null"]},"to":{"type":"string"},"truncated":{"type":"boolean"},"watched":{"type":"boolean"}},"required":["query","watched","days","from","to","answer","server","changes","notes","truncated","index_url"],"type":"object"},"title":"Recent tool changes on an MCP server"}
