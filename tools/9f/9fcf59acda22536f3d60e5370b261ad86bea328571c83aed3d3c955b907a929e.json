    "description": "Representation to return.",
    "enum": [
     "markdown",
     "text",
     "html"
    ],
    "type": "string"
   },
   "password": {
    "description": "Password for protected links.",
    "type": "string"
   },
   "url_or_key": {
    "description": "Full ctxt.io URL, /3/<code> path, or bare code.",
    "type": "string"
   }
  },
  "required": [
   "url_or_key"
  ],
  "type": "object"
 },
 "name": "read_context",
 "outputSchema": {
  "properties": {
   "content": {
    "type": "string"
   },
   "created": {
    "type": "string"
   },
   "expires_at": {
    "type": "string"
   },
   "ttl_seconds": {
    "type": "integer"
   }
  },
  "required": [
   "content",
   "ttl_seconds",
   "created",
   "expires_at"
  ],
  "type": "object"
 },
 "title": "Read a ctxt.io link"
}
