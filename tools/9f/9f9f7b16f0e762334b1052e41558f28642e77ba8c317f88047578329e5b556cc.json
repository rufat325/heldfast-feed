{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Criar conta"},"description":"Cria uma CONTA de QUALQUER TIPO na carteira (Conta Corrente, Poupan\u00e7a, Conta Caixa, Cart\u00e3o de Cr\u00e9dito, CDB, Tesouro Direto, A\u00e7\u00f5es, Fundo, Empr\u00e9stimo, Conta a Pagar/Receber, etc.). Obrigat\u00f3rios: tipo_conta e nome. Os tipos v\u00e1lidos v\u00eam de listar_tipos_conta. Nomes (tipo_conta, portfolio, banco, moeda, pa\u00eds) s\u00e3o resolvidos para IDs. Campos banc\u00e1rios (banco, ag\u00eancia, conta) valem para contas com banco. Padr\u00f5es: moeda BRL, pa\u00eds Brasil, data inicial hoje, saldo inicial 0. Portf\u00f3lio: se omitido, o sistema atribui um padr\u00e3o.","inputSchema":{"properties":{"agencia":{"description":"N\u00famero da ag\u00eancia","type":"string"},"aplicacao_cotizacao":{"description":"Investimento: Aplica\u00e7\u00e3o Cotiza\u00e7\u00e3o (D+N)","type":"number"},"aplicacao_inicial":{"description":"Investimento: aplica\u00e7\u00e3o inicial","type":"number"},"aplicacao_liquidacao":{"description":"Investimento: Aplica\u00e7\u00e3o Liquida\u00e7\u00e3o (D+N)","type":"number"},"banco":{"description":"Nome ou n\u00famero do banco (ex: 'Banco do Brasil', '001', 'Inter')","type":"string"},"bolsa":{"description":"Investimento: bolsa (ex.: 'B3')","type":"string"},"cnpj":{"description":"Investimento: CNPJ do emissor/fundo","type":"string"},"codigo_ativo":{"description":"Investimento: c\u00f3digo do ativo (ticker/ISIN, ex.: 'KNCR11', 'BRSTNCNTB...')","type":"string"},"data_de_aplicacao":{"description":"Investimento: data da aplica\u00e7\u00e3o YYYY-MM-DD","type":"string"},"data_inicial":{"description":"Data inicial de controle YYYY-MM-DD (padr\u00e3o: hoje)","type":"string"},"data_vencimento":{"description":"Investimento: vencimento do t\u00edtulo YYYY-MM-DD (grava DataVencimento e DataDeVencimento \u2014 evita o 'Vence em 31/12/1970')","type":"string"},"dia_fechamento_fatura":{"description":"Cart\u00e3o de cr\u00e9dito: dia do m\u00eas de fechamento da fatura (1-31)","type":"number"},"dia_vencimento_fatura":{"description":"Cart\u00e3o de cr\u00e9dito: dia do m\u00eas de vencimento da fatura (1-31)","type":"number"},"digito_agencia":{"description":"D\u00edgito da ag\u00eancia","type":"string"},"digito_conta":{"description":"D\u00edgito da conta","type":"string"},"emissor":{"description":"Investimento: emissor do t\u00edtulo","type":"string"},"grau_de_risco":{"description":"Investimento: grau de risco","type":"string"},"iban":{"description":"IBAN","type":"string"},"internacional":{"description":"Cart\u00e3o de cr\u00e9dito: se \u00e9 internacional","type":"boolean"},"juros_cheque_especial":{"description":"Juros do cheque especial (%)","type":"number"},"limite":{"description":"Cart\u00e3o de cr\u00e9dito: limite do cart\u00e3o","type":"number"},"limite_cheque_especial":{"description":"Limite do cheque especial","type":"number"},"moeda":{"description":"Moeda (padr\u00e3o: 'BRL')","type":"string"},"nib":{"description":"NIB","type":"string"},"nome":{"description":"Nome da conta \u2014 obrigat\u00f3rio","type":"string"},"numero_cartao":{"description":"Cart\u00e3o de cr\u00e9dito: n\u00famero do cart\u00e3o","type":"string"},"numero_conta":{"description":"N\u00famero da conta banc\u00e1ria","type":"string"},"numero_dias":{"description":"Investimento: prazo em dias","type":"number"},"observacoes":{"description":"Observa\u00e7\u00f5es","type":"string"},"pais":{"description":"Pa\u00eds (padr\u00e3o: 'Brasil')","type":"string"},"portfolio":{"description":"Tipo de Portf\u00f3lio (ex: 'Tesouraria', 'Liquidez', 'Renda Fixa', 'Renda Vari\u00e1vel', 'Previd\u00eancia')","type":"string"},"rating":{"description":"Investimento: rating","type":"string"},"rentabilidade_cdi":{"description":"Investimento: % do CDI (ex.: 110 = 110% do CDI)","type":"number"},"rentabilidade_fixa":{"description":"Investimento: taxa pr\u00e9-fixada (% a.a.)","type":"number"},"rentabilidade_igpm":{"description":"Investimento: spread sobre o IGP-M","type":"number"},"rentabilidade_ipca":{"description":"Investimento: spread sobre o IPCA (ex.: 6 = IPCA+6%)","type":"number"},"resgate_cotizacao":{"description":"Investimento: Resgate Cotiza\u00e7\u00e3o (D+N)","type":"number"},"resgate_liquidacao":{"description":"Investimento: Resgate Liquida\u00e7\u00e3o (D+N)","type":"number"},"saldo_inicial":{"description":"Saldo inicial (padr\u00e3o: 0)","type":"number"},"setor_segmento":{"description":"Investimento: setor/segmento","type":"string"},"swift":{"description":"SWIFT","type":"string"},"taxa":{"description":"Investimento: taxa contratada","type":"number"},"tipo_conta":{"description":"Tipo da conta (ex: 'Conta Corrente', 'Poupan\u00e7a', 'CDB', 'Cart\u00e3o de Cr\u00e9dito') \u2014 obrigat\u00f3rio","type":"string"},"valor_aplicado":{"description":"Investimento: valor aplicado","type":"number"}},"required":["tipo_conta","nome"],"type":"object"},"name":"criar_conta"}
