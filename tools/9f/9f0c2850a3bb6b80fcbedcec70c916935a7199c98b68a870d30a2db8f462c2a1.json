{
 "description": "List bounded maintenance candidates for a linked repository after authenticated maintainer checks. Requires a repositories:read MIZUKI_API_TOKEN.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "owner": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   },
   "repo": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_.-]+$",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "mizuki_repository_issues"
}
