{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find VK users by name, optionally narrowed by city, country, sex or age. Returns matches with a total count; page through them with offset.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;utf8,%3Csvg%20xmlns%3D%22http%3A%2F%2Fwww.w3.org%2F2000%2Fsvg%22%20viewBox%3D%220%200%2024%2024%22%20fill%3D%22none%22%20stroke%3D%22currentColor%22%20stroke-width%3D%222%22%20stroke-linecap%3D%22round%22%20stroke-linejoin%3D%22round%22%3E%3Ccircle%20cx%3D%2211%22%20cy%3D%2211%22%20r%3D%227%22%2F%3E%3Cpath%20d%3D%22m21%2021-4.3-4.3%22%2F%3E%3C%2Fsvg%3E"
  }
 ],
 "inputSchema": {
  "properties": {
   "age_from": {
    "description": "Minimum age",
    "type": "number"
   },
   "age_to": {
    "description": "Maximum age",
    "type": "number"
   },
   "city": {
    "description": "City ID to filter by",
    "type": "number"
   },
   "count": {
    "description": "Number of results (max 1000)",
    "type": "number"
   },
   "country": {
    "description": "Country ID to filter by",
    "type": "number"
   },
   "fields": {
    "description": "Additional profile fields to return",
    "type": "string"
   },
   "offset": {
    "description": "Offset for pagination",
    "type": "number"
   },
   "q": {
    "description": "Search query (name or keywords)",
    "type": "string"
   },
   "sex": {
    "description": "Sex filter: 1 \u2014 female, 2 \u2014 male",
    "enum": [
     1,
     2
    ],
    "type": "number"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "vk_users_search",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Total number of matches on VK, which is usually larger than the returned page",
    "type": "number"
   },
   "items": {
    "description": "Matching user profiles",
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "description": "Where this page sits in the whole result. Call the tool again with offset set to next_offset to continue; when next_offset is null there is nothing left to fetch.",
    "properties": {
     "next_from": {
      "description": "Cursor for the next page, on the tools that page by cursor rather than offset",
      "type": "string"
     },
     "next_offset": {
      "description": "Offset for the next page, or null when this page is the last one",
      "type": [
       "number",
       "null"
      ]
     },
     "offset": {
      "description": "The offset this page started at",
      "type": "number"
     },
     "returned": {
      "description": "How many came back on this page",
      "type": "number"
     },
     "total": {
      "description": "How many matches VK has in total",
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "title": "Search users"
}
