{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Progressive discovery of the full Elementor tool surface; returns matching tool names + schemas so advanced tools can be enabled on demand.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 30,
    "type": "integer"
   },
   "prefix": {
    "type": "string"
   },
   "query": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "elementor.tools.search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tools": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "annotations": {},
      "description": {
       "type": "string"
      },
      "enabled": {
       "type": "boolean"
      },
      "inputSchema": {},
      "name": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "title",
      "description",
      "enabled"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "tools",
   "total"
  ],
  "type": "object"
 },
 "title": "Search MCP tools"
}
