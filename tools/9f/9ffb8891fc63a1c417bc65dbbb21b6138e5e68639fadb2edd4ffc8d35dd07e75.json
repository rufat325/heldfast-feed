{
 "description": "Return the Stripe checkout URL for a reserved unpaid visit. Requires the agent bearer token. Never marks the invoice paid.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "session_id": {
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "create_support_checkout",
 "outputSchema": {
  "$defs": {
   "BookingStatus": {
    "properties": {
     "consultation_id": {
      "format": "int64",
      "type": "integer"
     },
     "paid": {
      "type": "boolean"
     },
     "public_token": {
      "type": "string"
     },
     "start_utc": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "ticket_id": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "consultation_id",
     "public_token",
     "status",
     "start_utc",
     "paid"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "checkout_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "paid": {
    "type": "boolean"
   },
   "status": {
    "$ref": "#/$defs/BookingStatus"
   }
  },
  "required": [
   "status",
   "paid"
  ],
  "type": "object"
 }
}
