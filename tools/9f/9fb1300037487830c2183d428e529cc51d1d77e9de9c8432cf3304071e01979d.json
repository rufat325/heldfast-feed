{
 "description": "Manage the npm cache",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action: clean (clear cache), verify (check integrity), ls (list contents)",
    "enum": [
     "clean",
     "verify",
     "ls"
    ],
    "type": "string"
   },
   "force": {
    "description": "Force clean (required for clean action)",
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "cache"
}
