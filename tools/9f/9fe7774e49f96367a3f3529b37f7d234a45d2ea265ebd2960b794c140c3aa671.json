 "description": "Add or remove individual users from a team using JSON Patch (admin).\n\n**Toolset:** Admin\n\n**Parameters:**\n- teamId (string) *required*: UUID of the team\n- operations (array) *required*: JSON Patch operations to apply",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "operations": {
    "description": "JSON Patch operations to apply",
    "items": {
     "properties": {
      "op": {
       "description": "Operation: 'add' or 'remove'",
       "enum": [
        "add",
        "remove"
       ],
       "type": "string"
      },
      "path": {
       "const": "/users",
       "description": "JSON Patch path (must be '/users')",
       "type": "string"
      },
      "value": {
       "properties": {
        "uuid": {
         "description": "UUID of the user",
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        }
       },
       "required": [
        "uuid"
       ],
       "type": "object"
      }
     },
     "required": [
      "op",
      "path",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "teamId": {
    "description": "UUID of the team",
    "type": "string"
   }
  },
  "required": [
   "teamId",
   "operations"
  ],
  "type": "object"
 },
