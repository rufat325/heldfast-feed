{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read:posts"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Recover a draft-save receipt"
 },
 "description": "Read the original receipt of an earlier soclo_posts_save_drafts call after an uncertain result, using the same batchId, draftRevision and clientRequestId. Free; changes nothing.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "batchId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "draftRevision": {
    "maximum": 999999999,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "batchId",
   "draftRevision",
   "clientRequestId"
  ],
  "type": "object"
 },
 "name": "soclo_posts_recover_drafts",
 "title": "Recover a draft-save receipt"
}
