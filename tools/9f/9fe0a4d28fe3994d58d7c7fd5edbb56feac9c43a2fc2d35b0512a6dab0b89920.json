{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only pre-show check: bridge reachability, node errors, topology, cook-time budget, GPU/display topology and perform-mode status in one PASS/UNVERIFIED/WARN/FAIL report. Use before rehearsals or venue handoff to see what is safe, unverified, suspicious, or failing without mutating the project.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "include_displays": {
    "default": true,
    "description": "Include GPU/display/perform-mode checks.",
    "type": "boolean"
   },
   "include_performance": {
    "default": true,
    "description": "Include network cook-time budget checks.",
    "type": "boolean"
   },
   "recursive": {
    "default": true,
    "description": "Inspect nested nodes for topology/performance.",
    "type": "boolean"
   },
   "root_path": {
    "default": "/project1",
    "description": "Network root to inspect before a show.",
    "type": "string"
   },
   "target_fps": {
    "default": 60,
    "description": "Frame-rate target for cook-time warnings.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "show_preflight_report",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "data": {},
      "id": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "status": {
       "enum": [
        "pass",
        "unverified",
        "warn",
        "fail"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "status",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "root_path": {
    "type": "string"
   },
   "status": {
    "enum": [
     "pass",
     "unverified",
     "warn",
     "fail"
    ],
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "fail": {
      "type": "number"
     },
     "pass": {
      "type": "number"
     },
     "unverified": {
      "type": "number"
     },
     "warn": {
      "type": "number"
     }
    },
    "required": [
     "pass",
     "unverified",
     "warn",
     "fail"
    ],
    "type": "object"
   },
   "target_fps": {
    "type": "number"
   }
  },
  "required": [
   "status",
   "root_path",
   "target_fps",
   "summary",
   "checks"
  ],
  "type": "object"
 },
 "title": "Show preflight report"
}
