{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Resolves a verified catalogue place and its IANA timezone before calculating sidereal transits, avoiding manual coordinate and offset entry.",
 "inputSchema": {
  "properties": {
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "natalLagnaSign": {
    "maximum": 11,
    "minimum": 0,
    "type": "integer"
   },
   "place": {
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "date",
   "time",
   "place",
   "natalLagnaSign"
  ],
  "type": "object"
 },
 "name": "calculate_gochara_from_known_place",
 "outputSchema": {
  "properties": {
   "engine": {
    "type": "object"
   },
   "instantJulianDay": {
    "type": "number"
   },
   "natalLagnaSign": {
    "type": "integer"
   },
   "placements": {
    "type": "array"
   },
   "resolvedPlace": {
    "type": "object"
   }
  },
  "required": [
   "instantJulianDay",
   "engine",
   "resolvedPlace",
   "natalLagnaSign",
   "placements"
  ],
  "type": "object"
 },
 "title": "Calculate gochara from a verified place"
}
