{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Free. Status of ANY Circle CCTP v2 USDC transfer (not only Liquid's) by its burn transaction hash: attestation, whether it was minted on the destination, and exactly how to finish a stuck one (receiveMessage with the message and attestation). Chains: Ethereum, Avalanche, OP Mainnet, Arbitrum, Base, Polygon PoS, Unichain, Linea, Sonic, World Chain, Arc.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "from": {
    "description": "Source chain, if known (faster).",
    "enum": [
     "ethereum",
     "avalanche",
     "optimism",
     "arbitrum",
     "base",
     "polygon",
     "unichain",
     "linea",
     "sonic",
     "worldchain",
     "arc"
    ],
    "type": "string"
   },
   "txHash": {
    "description": "Burn transaction hash on the source chain.",
    "pattern": "^0x[0-9a-fA-F]{64}$",
    "type": "string"
   }
  },
  "required": [
   "txHash"
  ],
  "type": "object"
 },
 "name": "cctp_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "amountUsdc": {
    "description": "Amount burned",
    "type": "string"
   },
   "destinationChain": {
    "description": "Destination chain",
    "type": "string"
   },
   "feeExecutedUsdc": {
    "description": "Circle fee charged",
    "type": "string"
   },
   "forwarding": {
    "description": "Uses Circle Forwarding",
    "type": "boolean"
   },
   "found": {
    "description": "Circle has a message for it",
    "type": "boolean"
   },
   "mintRecipient": {
    "description": "Who receives",
    "type": "string"
   },
   "mintTx": {
    "description": "Mint transaction when forwarded",
    "type": "string"
   },
   "nextStep": {
    "description": "What to do now",
    "type": "string"
   },
   "receiveMessage": {
    "additionalProperties": {},
    "description": "When attested but not minted: contract, message and attestation to finish it yourself",
    "properties": {},
    "type": "object"
   },
   "sourceChain": {
    "description": "Source chain",
    "type": "string"
   },
   "state": {
    "description": "not_found | pending_attestation | attested | minted",
    "type": "string"
   },
   "txHash": {
    "description": "Burn transaction",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Track any Circle CCTP transfer"
}
