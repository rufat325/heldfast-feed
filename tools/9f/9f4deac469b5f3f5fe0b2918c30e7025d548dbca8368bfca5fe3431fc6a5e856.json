{
 "description": "TIME MACHINE \u2014 counterfactual replay of a REAL historical transaction: fetch it by hash, apply your field overrides (different Amount, Destination, params, ...), then run the full flight simulator AT THAT HISTORICAL LEDGER (hooks, state and parameters as they were). Answers 'what would have happened if this tx had been X?'. Read-only; nothing is signed or submitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "overrides": {
    "additionalProperties": {},
    "description": "fields to change on the tx before re-simulating (e.g. {\"Amount\": \"99000000\"})",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "txHash": {
    "description": "real validated transaction hash",
    "maxLength": 64,
    "minLength": 64,
    "type": "string"
   }
  },
  "required": [
   "txHash"
  ],
  "type": "object"
 },
 "name": "what_if",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseTxHash": {
    "type": "string"
   },
   "caveat": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "historical": {
    "type": "boolean"
   },
   "hookRuns": {
    "items": {},
    "type": "array"
   },
   "ledgerIndex": {
    "type": "number"
   },
   "notes": {
    "items": {},
    "type": "array"
   },
   "overriddenFields": {
    "items": {},
    "type": "array"
   },
   "scamScore": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "staticChecks": {
    "items": {},
    "type": "array"
   },
   "summary": {
    "type": "string"
   },
   "transactor": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "verdict": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
