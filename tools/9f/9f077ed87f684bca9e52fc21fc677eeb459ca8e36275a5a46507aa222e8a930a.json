            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "license": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "name": {
           "type": "string"
          },
          "projectUrl": {
           "format": "uri",
           "type": "string"
          },
          "resourceId": {
           "type": "string"
          },
          "score": {
           "anyOf": [
            {
             "maximum": 1,
             "minimum": 0,
             "type": "number"
            },
            {
             "type": "null"
            }
           ]
          },
          "sourceUrl": {
           "format": "uri",
           "type": "string"
          },
          "use": {
           "type": "string"
          }
         },
         "required": [
          "resourceId",
          "name",
          "description",
          "use",
          "category",
          "projectUrl",
          "sourceUrl",
          "score",
          "firstAdmissionAt",
          "admissionMeaning",
          "license"
         ],
         "type": "object"
        },
        "maxItems": 5,
        "type": "array"
       },
       "need": {
        "type": "string"
       },
       "source": {
        "additionalProperties": false,
        "properties": {
         "dataAsOf": {
          "anyOf": [
