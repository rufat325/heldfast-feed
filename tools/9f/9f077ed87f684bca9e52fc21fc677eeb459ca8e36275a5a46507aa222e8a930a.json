{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Match one developer need to up to five open projects, libraries and tools in the Jev catalog (risetive.com/jev), each with what it is for, its category, project link and license when verified. Use it for building blocks a developer would adopt, not for competing products \u2014 use risetive_find_competitors for those. Requires signing in with a free Risetive account.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "need": {
    "description": "One concise need, e.g. \"self-hosted vector database with a Python client\". Up to 280 characters.",
    "maxLength": 280,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "need"
  ],
  "type": "object"
 },
 "name": "risetive_search_jev_projects",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
