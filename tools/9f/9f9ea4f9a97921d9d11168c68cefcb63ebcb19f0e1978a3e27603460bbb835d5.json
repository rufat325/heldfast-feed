{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a to-do task"
 },
 "description": "Update a to-do task \u2014 change status (e.g. mark Completed), priority, assignee, due date, title or category, optionally with an update message. Buildium's PUT replaces the whole record, so this reads the current task first and only changes the fields you pass. Buildium: GET then PUT /v1/tasks/todorequests/{toDoTaskId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigned_to_user_id": {
    "description": "Reassign to this staff user id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "category_id": {
    "description": "New task category id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "due_date": {
    "description": "New due date, YYYY-MM-DD.",
    "type": "string"
   },
   "message": {
    "description": "An update note recorded with this change.",
    "maxLength": 65500,
    "type": "string"
   },
   "priority": {
    "description": "New priority.",
    "enum": [
     "Low",
     "Normal",
     "High"
    ],
    "type": "string"
   },
   "property_id": {
    "description": "New active property id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "New status.",
    "enum": [
     "New",
     "InProgress",
     "Completed",
     "Deferred",
     "Closed"
    ],
    "type": "string"
   },
   "subcategory_id": {
    "description": "New task subcategory id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "New title (max 127).",
    "maxLength": 127,
    "type": "string"
   },
   "todo_task_id": {
    "description": "The to-do task id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "unit_id": {
    "description": "New unit id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "todo_task_id"
  ],
  "type": "object"
 },
 "name": "buildium_update_todo_task",
 "title": "Update a to-do task"
}
