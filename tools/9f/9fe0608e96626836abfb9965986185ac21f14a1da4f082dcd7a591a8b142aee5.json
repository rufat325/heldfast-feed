    "type": "string"
   },
   "destination": {
    "type": "string"
   },
   "destination_address": {
    "type": "string"
   },
   "destination_city": {
    "type": "string"
   },
   "destination_country": {
    "type": "string"
   },
   "distance_meters": {
    "type": "number"
   },
   "duration_seconds": {
    "type": "number"
   },
   "expense_id": {
    "type": "string"
   },
   "external_id": {
    "type": "string"
   },
   "geometry_source": {
    "enum": [
     "observed_gps",
     "provider_polyline",
     "reconstructed",
     "straight_line"
