{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Rank current provider offers for up to five canonical model slugs by the USD cost of your input/output token workload. Input tokens are uncached. Estimates use base-context rates and exclude long-context tiers, cache writes, batch discounts, and free-tier quotas. provider_slugs restricts the ranked offers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "input_tokens": {
    "default": 10000000,
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "integer"
   },
   "model_slugs": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "pattern": "^[a-zA-Z0-9._:-]+$",
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array",
    "uniqueItems": true
   },
   "output_tokens": {
    "default": 2000000,
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "integer"
   },
   "provider_slugs": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "model_slugs"
  ],
  "type": "object"
 },
 "name": "offer_compare",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "offers": {
      "items": {
       "properties": {
        "offer": {
         "properties": {
          "id": {
           "type": "string"
          },
          "limits": {
           "properties": {
            "contextTokens": {
             "anyOf": [
              {
               "minimum": 1,
               "type": "integer"
              },
              {
               "type": "null"
              }
             ]
            },
            "maxOutputTokens": {
             "anyOf": [
              {
               "minimum": 1,
               "type": "integer"
              },
              {
               "type": "null"
              }
             ]
            }
           },
           "required": [
            "contextTokens",
            "maxOutputTokens"
           ],
           "type": "object"
          },
          "model": {
           "properties": {
            "name": {
             "type": "string"
            },
            "slug": {
             "type": "string"
            }
           },
           "required": [
            "slug",
            "name"
           ],
           "type": "object"
          },
          "prices": {
           "properties": {
            "cachedInputPerMillionTokens": {
             "anyOf": [
              {
               "minimum": 0,
               "type": "number"
              },
              {
               "type": "null"
              }
             ]
            },
            "inputPerMillionTokens": {
             "minimum": 0,
             "type": "number"
            },
            "outputPerMillionTokens": {
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "inputPerMillionTokens",
            "outputPerMillionTokens",
            "cachedInputPerMillionTokens"
           ],
           "type": "object"
          },
          "provenance": {
           "properties": {
            "checkedAt": {
             "format": "date",
             "type": "string"
            },
            "sourceUrl": {
             "format": "uri",
             "type": "string"
            }
           },
           "required": [
            "sourceUrl",
            "checkedAt"
           ],
           "type": "object"
          },
          "provider": {
           "properties": {
            "name": {
             "type": "string"
            },
            "slug": {
             "type": "string"
            }
           },
           "required": [
            "slug",
            "name"
           ],
           "type": "object"
          },
          "routeType": {
           "enum": [
            "official",
            "cloud",
            "gateway",
            "unverified"
           ],
           "type": "string"
          }
         },
         "required": [
          "id",
          "model",
          "provider",
          "routeType",
          "prices",
          "limits",
          "provenance"
         ],
         "type": "object"
        },
        "workloadCostUsd": {
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "offer",
        "workloadCostUsd"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "offers"
    ],
    "type": "object"
   },
   "meta": {
    "properties": {
     "apiVersion": {
      "const": "v1"
     },
     "currency": {
      "const": "USD"
     },
     "tokenPriceUnit": {
      "const": "per_million_tokens"
     }
    },
    "required": [
     "apiVersion",
     "currency",
     "tokenPriceUnit"
    ],
    "type": "object"
   },
   "workload": {
    "properties": {
     "inputTokens": {
      "minimum": 0,
      "type": "integer"
     },
     "outputTokens": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "inputTokens",
     "outputTokens"
    ],
    "type": "object"
   }
  },
  "required": [
   "meta",
   "workload",
   "data"
  ],
  "type": "object"
 },
 "title": "Compare provider offers"
}
