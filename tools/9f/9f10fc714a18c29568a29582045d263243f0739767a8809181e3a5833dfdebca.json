 "description": "Use this when the user wants a post they wrote adapted for readers in another country or language, such as \"adapt this for a Japanese audience\". Pass the post text, the target market and optionally a platform to check the result against. Returns the adapted text, its language, a short list of what changed and why, and the platform check when one was asked for. It adapts tone, idioms, examples and formats rather than translating word for word, and adds no new claims. Only for the user's own text; it does not publish.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "platform": {
    "description": "Optional. Checks the adapted text against this platform's length and hashtag rules.",
    "enum": [
     "x",
     "bluesky",
     "threads",
     "mastodon",
     "linkedin",
     "instagram",
     "reddit",
     "youtube",
     "pinterest",
     "tiktok"
    ],
    "type": "string"
   },
   "target_market": {
    "description": "The audience, such as \"Japan\", \"Brazil\", \"German-speaking Switzerland\" or \"Spanish speakers in Mexico\".",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "text": {
    "description": "Your own post to adapt. Do not paste other people's posts.",
    "maxLength": 3000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text",
   "target_market"
  ],
  "type": "object"
 },
 "name": "localize_post",
 "outputSchema": {
  "properties": {
   "adaptations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "as_of": {
    "type": "string"
   },
   "check": {
    "properties": {
     "hashtags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "issues": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "length": {
      "properties": {
       "max": {
        "type": "number"
       },
       "unit": {
        "type": "string"
       },
       "used": {
        "type": "number"
       }
      },
      "required": [
       "used",
       "max",
       "unit"
      ],
      "type": "object"
     },
     "passes": {
      "type": "boolean"
     },
     "platform": {
      "type": "string"
     },
     "warnings": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
