 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "mints": {
    "description": "Up to 50 base58 mints",
    "items": {
     "description": "Base58 mint address",
     "maxLength": 44,
     "minLength": 32,
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "mints"
  ],
  "type": "object"
 },
 "name": "get_token_prices"
}
