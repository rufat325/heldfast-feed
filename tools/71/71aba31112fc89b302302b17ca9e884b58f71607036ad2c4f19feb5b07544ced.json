{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get users"
 },
 "description": "Batch fetch of X (Twitter) user profiles by numeric id, @handle, bare handle, or the sentinel `me` (the authenticated user). Returns compact profiles (handle, name, bio, metrics, created) plus a `missing` list for any reference that could not be resolved.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "raw": {
    "type": "boolean"
   },
   "users": {
    "description": "user id, @handle, handle, or 'me'",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "users"
  ],
  "type": "object"
 },
 "name": "x_user_get",
 "outputSchema": {
  "$defs": {
   "compact_user": {
    "properties": {
     "created_at": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "handle": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "location": {
      "type": "string"
     },
     "metrics": {
      "$ref": "#/$defs/user_metrics"
     },
     "name": {
      "type": "string"
     },
     "protected": {
      "type": "boolean"
     },
     "url": {
      "type": "string"
     },
     "verified": {
      "type": "boolean"
     }
    },
    "required": [
     "id",
     "handle"
    ],
    "type": "object"
   },
   "missing": {
    "properties": {
     "id": {
      "type": "string"
     },
     "reason": {
      "enum": [
       "not-found",
       "deleted",
       "suspended",
       "protected",
       "unauthorized",
       "unavailable"
      ],
      "type": "string"
     },
     "resource_type": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "reason"
    ],
    "type": "object"
   },
   "user_metrics": {
    "properties": {
     "followers": {
      "type": "number"
     },
     "following": {
      "type": "number"
     },
     "listed": {
