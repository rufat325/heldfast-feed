{"annotations":{"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Blur a rectangle (given in percent of the image) or the whole image, strength 3-16. Hide plates, names, screens. Runs on our server, files are deleted right after the call, nothing stored. Free: 25 calls/day per IP. Paid: $0.002 per call via x402 at https://radarbg.com/x402/image-blur.","inputSchema":{"examples":[{"area":"all","fileContent":"","fileName":"sample.png"}],"properties":{"area":{"default":"box","description":"box (a rectangle) or all","enum":["box","all"],"type":"string"},"fileContent":{"description":"The file as base64 (a data: URI is fine)","type":"string"},"fileName":{"description":"File name with extension, e.g. report.pdf","type":"string"},"files":{"description":"Or several files: [{fileName, fileContent (base64)}]","items":{"type":"object"},"type":"array"},"height":{"default":30,"description":"Height percent","type":"integer"},"strength":{"default":"6","description":"3, 6, 10 or 16","enum":["3","6","10","16"],"type":"string"},"width":{"default":40,"description":"Width percent","type":"integer"},"x":{"default":30,"description":"Left, percent of width (area=box)","type":"integer"},"y":{"default":30,"description":"Top, percent of height","type":"integer"}},"type":"object"},"name":"image_blur","title":"Image Blur API - blur faces, plates or a whole picture"}
