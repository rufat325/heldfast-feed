{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send a DORA incident event for tracking change failure rate and MTTR",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "environment": {
    "description": "Environment name. Example: production",
    "type": "string"
   },
   "finishedAt": {
    "description": "Unix timestamp (seconds) when incident was resolved",
    "type": "number"
   },
   "name": {
    "description": "Incident name or title",
    "type": "string"
   },
   "service": {
    "description": "Service name affected by the incident. Example: my-api-service",
    "type": "string"
   },
   "severity": {
    "description": "Incident severity. Example: SEV-1, SEV-2",
    "type": "string"
   },
   "startedAt": {
    "description": "Unix timestamp (seconds) when incident started",
    "type": "number"
   },
   "version": {
    "description": "Version that caused the incident",
    "type": "string"
   }
  },
  "required": [
   "service",
   "startedAt"
  ],
  "type": "object"
 },
 "name": "send-dora-incident"
}
