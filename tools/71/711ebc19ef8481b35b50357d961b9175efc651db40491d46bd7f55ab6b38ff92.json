{
 "description": "Look up multiple entities at once. More efficient than individual lookups. Returns summaries for each entity.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "includeSecrets": {
    "default": true,
    "type": "boolean"
   },
   "lookups": {
    "description": "List of entities to look up",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "type": {
       "enum": [
        "monster",
        "npc",
        "location",
        "situation",
        "archetype",
        "item",
        "encounter",
        "condition",
        "faction",
        "arc"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "worldPackId": {
    "description": "World pack ID",
    "type": "string"
   }
  },
  "required": [
   "worldPackId",
   "lookups"
  ],
  "type": "object"
 },
 "name": "batch_lookup"
}
