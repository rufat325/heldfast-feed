{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Replace the source moment for one managed clip using a verified suggestion or explicit time range. Can spend existing account credits. Preserves the other clips; read current state before retrying.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "captionsEnabled": {
    "type": "boolean"
   },
   "clipId": {
    "default": null,
    "type": [
     "string",
     "null"
    ]
   },
   "contentTypeHint": {
    "enum": [
     "auto",
     "podcast",
     "tutorial",
     "demo",
     "generic"
    ],
    "type": "string"
   },
   "endSeconds": {
    "type": "number"
   },
   "idempotencyKey": {
    "default": null,
    "type": [
     "string",
     "null"
    ]
   },
   "layoutMode": {
    "enum": [
     "auto",
     "people_first",
     "screen_first",
     "preserve_full_source",
     "prefer_split",
     "prefer_focus",
     "prefer_tutorial",
     "prefer_demo"
    ],
    "type": "string"
   },
   "lookId": {
    "type": "string"
   },
   "maxDurationSeconds": {
    "type": "number"
   },
   "minDurationSeconds": {
    "type": "number"
   },
   "selectionMode": {
    "default": null,
    "enum": [
     "auto_best",
     "suggestion",
     "time_range"
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "startSeconds": {
    "minimum": 0,
    "type": "number"
   },
   "suggestionId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   },
   "workspaceId": {
    "description": "UUID string.",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "clipId",
   "selectionMode",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "clips_reselect",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Revise Selected Moment"
}
