{
 "annotations": {
  "destructiveHint": true,
  "title": "Update order completion status"
 },
 "description": "Set the completion status of up to 500 orders (e.g. mark success, failed or cancelled from an external system), optionally with service start/end times. Each time takes unixTimestamp, utcTime or localTime. Reversible by setting the status again. Returns a per-order success list. OptimoRoute: POST /update_completion_details.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "updates": {
    "description": "The status updates, at most 500.",
    "items": {
     "properties": {
      "data": {
       "properties": {
        "endTime": {
         "description": "When service ended (success, failed).",
         "properties": {
          "localTime": {
           "type": "string"
          },
          "unixTimestamp": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "utcTime": {
           "type": "string"
          }
         },
         "type": "object"
        },
        "startTime": {
         "description": "When service started (servicing, success, failed).",
         "properties": {
          "localTime": {
           "description": "ISO 8601 local time at the order location.",
           "type": "string"
          },
          "unixTimestamp": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "utcTime": {
           "description": "ISO 8601, e.g. 2026-09-30T14:05:00.",
           "type": "string"
          }
         },
         "type": "object"
        },
        "status": {
         "description": "The new order status.",
         "enum": [
          "unscheduled",
          "scheduled",
          "on_route",
          "servicing",
          "success",
          "failed",
          "rejected",
          "cancelled"
         ],
         "type": "string"
        }
       },
       "required": [
        "status"
       ],
       "type": "object"
      },
      "id": {
       "description": "OptimoRoute's unique order id.",
       "type": "string"
      },
      "orderNo": {
       "description": "The user-specified order number.",
       "type": "string"
      }
     },
     "required": [
      "data"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "updates"
  ],
  "type": "object"
 },
 "name": "optimoroute_update_completion_details",
 "title": "Update order completion status"
}
