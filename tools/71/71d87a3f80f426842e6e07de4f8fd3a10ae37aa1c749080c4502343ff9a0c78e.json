    "type": "number"
   },
   "country": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "free_shipping_threshold": {
    "type": "number"
   },
   "shipping_cost": {
    "type": "number"
   },
   "shop": {
    "type": "string"
   }
  },
  "required": [
   "shop",
   "country",
   "cart_value",
   "shipping_cost",
   "currency"
  ],
  "type": "object"
 },
 "title": "Get Shipping Cost"
}
