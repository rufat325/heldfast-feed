{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants social posts written about a topic, such as \"write posts about our new CLI for X, Bluesky and LinkedIn\". Pass the topic, with every fact and any link to include, and 1 to 6 platforms from x, bluesky, threads, mastodon, linkedin, instagram, reddit, youtube, pinterest, tiktok; optionally a tone. Returns one draft per platform with its length as that platform counts it, hashtags, whether it passes the platform's rules and the issues if not, plus a checklist of rules and image sizes with sources and dates. Uses only the facts given. It does not publish, read accounts or fetch trends or statistics.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "platforms": {
    "description": "Where the posts will go, up to 6 of x, bluesky, threads, mastodon, linkedin, instagram, reddit, youtube, pinterest, tiktok.",
    "items": {
     "enum": [
      "x",
      "bluesky",
      "threads",
      "mastodon",
      "linkedin",
      "instagram",
      "reddit",
      "youtube",
      "pinterest",
      "tiktok"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   },
   "tone": {
    "description": "Optional voice, such as \"friendly and plain\" or \"dry humour\".",
    "maxLength": 80,
    "type": "string"
   },
   "topic": {
    "description": "What the posts are about, with any facts, names and link to include. Posts use only what is given here.",
    "maxLength": 800,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "topic",
   "platforms"
  ],
  "type": "object"
 },
 "name": "draft_posts",
 "outputSchema": {
  "properties": {
   "ai_disclosure": {
    "description": "Set when the topic or a draft declares an AI-generated person or voice; names the label that applies on X, Instagram, TikTok and YouTube drafts.",
    "properties": {
     "flagged": {
      "type": "boolean"
     },
     "labels": {
      "items": {
       "properties": {
        "label": {
         "type": "string"
        },
        "platform": {
         "enum": [
          "tiktok",
          "youtube_shorts",
          "instagram_reels",
          "x_video"
         ],
         "type": "string"
        },
        "rule": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "platform",
        "label",
        "rule",
        "source"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "message": {
      "type": "string"
     },
     "signals": {
      "items": {
       "properties": {
        "kind": {
         "enum": [
          "synthetic_person",
          "synthetic_voice"
         ],
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "kind",
        "text"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "flagged",
     "signals",
     "labels",
     "message"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "as_of": {
    "type": "string"
   },
   "checklist": {
    "items": {
     "properties": {
      "image": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      },
      "rules": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "source": {
       "type": "string"
      }
     },
     "required": [
      "platform",
      "rules",
      "image",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "drafts": {
    "items": {
     "properties": {
      "hashtags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "issues": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "length": {
       "properties": {
        "max": {
         "type": "number"
        },
        "unit": {
         "type": "string"
        },
        "used": {
         "type": "number"
        }
       },
       "required": [
        "used",
        "max",
        "unit"
       ],
       "type": "object"
      },
      "passes": {
       "type": "boolean"
      },
      "platform": {
       "enum": [
        "x",
        "bluesky",
        "threads",
        "mastodon",
        "linkedin",
        "instagram",
        "reddit",
        "youtube",
        "pinterest",
        "tiktok"
       ],
       "type": "string"
      },
      "text": {
       "type": "string"
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "warnings": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "platform",
      "title",
      "text",
      "length",
      "passes",
      "issues"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "rules_as_of": {
    "description": "Date the platform rules were last checked (2026-10-01).",
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "capacity_reached",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "drafts",
   "checklist",
   "ai_disclosure",
   "notice",
   "source",
   "as_of",
   "rules_as_of"
  ],
  "type": "object"
 },
 "title": "Draft posts for each platform"
}
