{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Authenticated tool for creating an outbound destination and connection with retry policy and optional filters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endpointUrl": {
    "format": "uri",
    "type": "string"
   },
   "filterBodyPath": {
    "type": "string"
   },
   "filterBodyValue": {
    "type": "string"
   },
   "filterEntityKey": {
    "type": "string"
   },
   "filterEventTypes": {
    "type": "string"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "rateLimitPerMinute": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "retryBackoffSeconds": {
    "type": "string"
   },
   "retryMaxAttempts": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "signingSecret": {
    "maxLength": 500,
    "type": "string"
   },
   "sourceId": {
    "minLength": 1,
    "type": "string"
   },
   "transformBodyPath": {
    "type": "string"
   },
   "transformExpression": {
    "type": "string"
   }
  },
  "required": [
   "sourceId",
   "name",
   "endpointUrl"
  ],
  "type": "object"
 },
 "name": "create_destination",
 "title": "Create Destination"
}
