{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Analyze up to 500 chronological closed trades supplied by the user, each with net P&L after costs and original risk. Returns win rate, profit factor, expectancy in currency and R, total net R, and optional closed-trade equity drawdown when initial equity is supplied. Use for reviewing an existing trade sample. No account access, deposits, intratrade drawdown, forecasts, signals, or new risk recommendations.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "initialEquity": {
    "description": "Starting equity before the ordered trades. Required only for equity drawdown metrics. No deposits or withdrawals are modeled.",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "quoteCurrency": {
    "description": "Currency shared by all monetary inputs. Defaults to USD; no currency conversion is performed.",
    "pattern": "^[A-Z][A-Z0-9]{1,9}$",
    "type": "string"
   },
   "trades": {
    "description": "Closed trades ordered chronologically, all using the same currency and risk convention. Maximum 500.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "initialRisk": {
       "description": "Original planned risk amount, including planned fees if that is your convention. Do not replace it with a later stop risk.",
       "exclusiveMinimum": 0,
       "maximum": 1000000000000,
       "type": "number"
      },
      "netPnl": {
       "description": "Realized P&L after all fees and costs. Positive is profit; negative is loss.",
       "maximum": 1000000000000,
       "minimum": -1000000000000,
       "type": "number"
      }
     },
     "required": [
      "netPnl",
      "initialRisk"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "trades"
  ],
  "type": "object"
 },
 "name": "analyze_trade_performance",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "calculationVersion": {
    "const": "1.0.0",
    "type": "string"
   },
   "documentationUrl": {
    "format": "uri",
    "type": "string"
   },
   "formulas": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "metrics": {
    "additionalProperties": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "value",
      "unit",
      "label"
     ],
     "type": "object"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "reproduceUrl": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "tool": {
    "enum": [
     "calculate_position_size",
     "calculate_net_risk_reward",
     "analyze_trade_performance"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "tool",
   "calculationVersion",
   "inputs",
   "metrics",
   "assumptions",
   "warnings",
   "formulas",
   "documentationUrl",
   "reproduceUrl"
  ],
  "type": "object"
 },
 "title": "Realized trading performance"
}
