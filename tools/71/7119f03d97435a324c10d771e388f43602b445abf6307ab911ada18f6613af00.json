    "type": "string"
   },
   "collectionFloorEth": {
    "type": "string"
   },
   "collectionSlug": {
    "type": "string"
   },
   "contract": {
    "type": "string"
   },
   "listings": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "marketplace": {
    "enum": [
     "opensea"
    ],
    "type": "string"
   },
   "maxListingAgeMs": {
    "type": "number"
   },
   "maxPriceEth": {
    "type": "string"
   },
   "maxSaleAgeMs": {
    "type": "number"
   },
   "minDiscountBps": {
    "type": "number"
   },
   "minTraitListings": {
    "type": "number"
   },
   "minTraitSales": {
    "type": "number"
   },
   "minTraitVolumeEth": {
    "type": "string"
   },
   "sales": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "traitFloorEth": {
    "type": "string"
   },
   "traitType": {
    "type": "string"
   },
   "traitValue": {
    "type": "string"
   }
  },
  "required": [
   "marketplace",
   "chain",
   "collectionSlug",
   "contract",
   "traitType",
   "traitValue",
   "maxPriceEth",
   "minDiscountBps",
   "minTraitSales",
   "minTraitVolumeEth",
   "traitFloorEth",
   "listings",
   "sales"
  ],
  "type": "object"
 },
 "name": "nft_trait_snipe"
}
