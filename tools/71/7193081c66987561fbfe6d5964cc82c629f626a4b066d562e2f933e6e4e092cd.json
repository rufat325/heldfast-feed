{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Fetch"
 },
 "description": "Returns the full content of a single document \u2014 invention, patent application, strategy, or report \u2014 or a meeting identified by its search result ID. A meeting returns a Markdown snapshot of its canvas text notes and all stored transcript sessions, with speakers, timestamps, and session status. A document has several texts across its lifecycle; a bare document ID returns the most advanced one (the newest application text, else the priority draft, else the innovation description), and the response lists every part with its own ID, such as document:<id>#priority_draft or document:<id>#application_text:<revisionId>. Pass a part ID to read that text instead. Saved own records can also return a structured family overview, including the current saved links and a per-record refresh assessment for readback after updates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "The search result ID, such as meeting:<id>, or a document identifier",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "fetch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "family": {
    "additionalProperties": false,
    "properties": {
     "applicationCount": {
      "description": "Accessible saved application records in this group, including the selected record",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "coverage": {
      "const": "unverified",
      "type": "string"
     },
     "groupingKey": {
      "description": "Representative accessible document key for grouping saved records; can change with links or access, not a global family ID",
      "type": "string"
     },
     "members": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "applicationNumber": {
         "type": [
          "string",
          "null"
         ]
        },
        "applicationType": {
         "type": "string"
        },
        "documentId": {
         "type": "string"
        },
        "filingDate": {
         "type": [
          "string",
          "null"
         ]
        },
        "publicationNumber": {
         "type": [
          "string",
          "null"
         ]
        },
        "recordedStatus": {
         "type": [
          "string",
          "null"
         ]
        },
        "refNum": {
         "type": [
          "string",
          "null"
         ]
        },
        "region": {
         "type": [
          "string",
          "null"
         ]
        },
        "relationship": {
         "enum": [
          "self",
          "parent",
          "child",
          "other_related"
         ],
         "type": "string"
        },
        "title": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "documentId",
        "title",
        "refNum",
        "applicationType",
        "region",
        "applicationNumber",
        "publicationNumber",
        "filingDate",
        "recordedStatus",
        "relationship"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "membersTruncated": {
      "type": "boolean"
     },
     "priorityDate": {
      "type": [
       "string",
       "null"
      ]
     },
     "priorityDateSource": {
      "enum": [
       "imported",
       "earliest_saved_priority_filing",
       "unknown"
      ],
      "type": "string"
     },
     "recordedPublicationCount": {
      "description": "Distinct publication numbers recorded on these applications, not all publications or inventions",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "refresh": {
      "additionalProperties": false,
      "properties": {
       "ambiguousReferenceCount": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "assessment": {
        "description": "Read-only assessment of this record\u2019s stored references. Missing links have accessible saved matches. Unresolved references need investigation; unknown and no_known_gap do not establish complete coverage.",
        "enum": [
         "missing_links",
         "unresolved_references",
         "unknown",
         "no_known_gap",
         "unsupported"
        ],
        "type": "string"
       },
       "eligible": {
        "description": "Whether this own record has a usable publication number; does not establish write permission",
        "type": "boolean"
       },
       "lastRefreshedAt": {
        "description": "Last recorded explicit provider family refresh; null means the refresh date is unknown",
        "type": [
         "string",
         "null"
        ]
       },
       "missingLinkCount": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "references": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "applicationNumber": {
           "type": "string"
          },
          "direction": {
           "enum": [
            "parent",
            "child"
           ],
           "type": "string"
          },
          "documentId": {
           "type": [
            "string",
            "null"
           ]
          },
          "publicationNumber": {
           "type": [
            "string",
            "null"
           ]
          },
          "status": {
           "enum": [
            "linked",
            "missing_link",
            "unmatched",
            "ambiguous"
           ],
           "type": "string"
          }
         },
         "required": [
          "direction",
          "applicationNumber",
          "publicationNumber",
          "status",
          "documentId"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "referencesAvailable": {
        "type": "boolean"
       },
       "referencesTruncated": {
        "type": "boolean"
       },
       "unmatchedReferenceCount": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "eligible",
       "assessment",
       "referencesAvailable",
       "lastRefreshedAt",
       "missingLinkCount",
       "unmatchedReferenceCount",
       "ambiguousReferenceCount",
       "references",
       "referencesTruncated"
      ],
      "type": "object"
     },
     "regions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "scope": {
      "const": "accessible_saved_records",
      "type": "string"
     }
    },
    "required": [
     "groupingKey",
     "scope",
     "applicationCount",
     "recordedPublicationCount",
     "regions",
     "priorityDate",
     "priorityDateSource",
     "members",
     "membersTruncated",
     "coverage",
     "refresh"
    ],
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "part": {
    "type": "string"
   },
   "parts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "label": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "part": {
       "enum": [
        "disclosure",
        "priority_draft",
        "application_text"
       ],
       "type": "string"
      },
      "revisionId": {
       "type": [
        "string",
        "null"
       ]
      },
      "revisionType": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "part",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "title",
   "text",
   "url"
  ],
  "type": "object"
 },
 "title": "Fetch"
}
