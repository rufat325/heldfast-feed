{
 "description": "Get campaign breakdowns by device, platform, placement, age, or gender",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "breakdown_type": {
    "default": "device_platform",
    "description": "Breakdown dimension",
    "enum": [
     "device_platform",
     "publisher_platform",
     "platform_position",
     "age",
     "gender"
    ],
    "type": "string"
   },
   "campaign_id": {
    "description": "Meta campaign ID",
    "type": "string"
   },
   "days": {
    "default": 30,
    "description": "Lookback window in days (default 30)",
    "type": "number"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "meta_ads_breakdowns"
}
