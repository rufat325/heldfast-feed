{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find nearby transit stations using the canonical ROOTE transit taxonomy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "debug": {
    "type": "boolean"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "lon": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "modes": {
    "items": {
     "enum": [
      "bus",
      "tram",
      "metro",
      "cable_car",
      "regional_rail",
      "train",
      "ferry",
      "shuttle"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "minItems": 1,
    "type": "array"
   },
   "radius": {
    "exclusiveMinimum": 0,
    "maximum": 5000,
    "type": "number"
   }
  },
  "required": [
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "transit_nearby",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attributions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "display_name": {
       "type": "string"
      },
      "provider": {
       "$ref": "#/properties/lines/items/properties/network_id/anyOf/0"
      },
      "required": {
       "type": "boolean"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "provider",
      "display_name",
      "url",
      "required"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contract_version": {
    "const": "roote-1.0.0",
    "type": "string"
   },
   "coverage": {
    "additionalProperties": false,
    "properties": {
     "execution": {
      "enum": [
       "complete",
       "partial",
       "failed"
      ],
      "type": "string"
     },
     "exhaustive": {
      "const": false,
      "type": "boolean"
     },
     "structural": {
      "enum": [
       "complete",
       "partial",
       "unknown"
      ],
      "type": "string"
     },
     "truncated": {
      "type": "boolean"
     }
    },
    "required": [
     "execution",
     "structural",
     "truncated",
     "exhaustive"
    ],
    "type": "object"
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "$ref": "#/properties/stations/items/properties/line_ids/items"
      },
      "mode": {
       "$ref": "#/properties/stations/items/properties/modes/items"
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "network_id": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "operator_id": {
       "anyOf": [
        {
         "pattern": "^roote_transport_operator_[a-f0-9]{20}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "qualification": {
       "enum": [
        "established",
        "uncertain",
        "historical"
       ],
       "type": "string"
      },
      "short_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "text_color": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "short_name",
      "mode",
      "color",
      "text_color",
      "network_id",
      "operator_id",
      "qualification"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "applied_limit": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "requested_limit": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "returned_count": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "returned_count",
     "requested_limit",
     "applied_limit"
    ],
    "type": "object"
   },
   "operators": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "$ref": "#/properties/lines/items/properties/operator_id/anyOf/0"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "origin": {
      "additionalProperties": false,
      "properties": {
       "lat": {
        "maximum": 90,
        "minimum": -90,
        "type": "number"
       },
       "lon": {
        "maximum": 180,
        "minimum": -180,
        "type": "number"
       }
      },
      "required": [
       "lat",
       "lon"
      ],
      "type": "object"
     },
     "radius_meters": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "origin",
     "radius_meters"
    ],
    "type": "object"
   },
   "stations": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accessibility": {
       "additionalProperties": false,
       "properties": {
        "wheelchair": {
         "enum": [
          "yes",
          "no",
          "unknown"
         ],
         "type": "string"
        }
       },
       "required": [
        "wheelchair"
       ],
       "type": "object"
      },
      "departures_supported": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "distance_meters": {
       "minimum": 0,
       "type": "number"
      },
      "entity_kind": {
       "enum": [
        "station",
        "stop_area",
        "stop_point",
        "platform"
       ],
       "type": "string"
      },
      "id": {
       "pattern": "^roote_transport_station_[a-f0-9]{20}$",
       "type": "string"
      },
      "line_ids": {
       "items": {
        "pattern": "^roote_transport_line_[a-f0-9]{20}$",
        "type": "string"
       },
       "type": "array"
      },
      "location": {
       "$ref": "#/properties/query/properties/origin"
      },
      "modes": {
       "items": {
        "enum": [
         "bus",
         "tram",
         "metro",
         "cable_car",
         "regional_rail",
         "train",
         "ferry",
         "shuttle",
         "rail",
         "other"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "operator_ids": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "name",
      "entity_kind",
      "location",
      "distance_meters",
      "modes",
      "line_ids",
      "operator_ids",
      "departures_supported",
      "accessibility"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "success",
     "empty",
     "partial",
     "error"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "$ref": "#/properties/lines/items/properties/network_id/anyOf/0"
      },
      "message": {
       "type": "string"
      },
      "scope": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "code",
      "message",
      "scope"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "contract_version",
   "status",
   "query",
   "stations",
   "lines",
   "operators",
   "coverage",
   "warnings",
   "attributions",
   "meta"
  ],
  "type": "object"
 },
 "title": "Find nearby public transit"
}
