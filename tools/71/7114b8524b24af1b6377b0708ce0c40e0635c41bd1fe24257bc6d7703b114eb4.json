{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Record an aggregate technical route outcome using only the structured fields defined below. This tool accepts route class, outcome, optional failure class, region, chain and latency bucket.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "chain": {
    "pattern": "^[a-z0-9_-]{2,32}$",
    "type": "string"
   },
   "failureClass": {
    "enum": [
     "timeout",
     "rate_limit",
     "dns",
     "tls",
     "http_5xx",
     "http_4xx",
     "protocol_error",
     "unavailable",
     "high_latency",
     "other"
    ],
    "type": "string"
   },
   "latencyBucket": {
    "enum": [
     "lt250ms",
     "250ms_1s",
     "1s_3s",
     "gt3s",
     "timeout",
     "unknown"
    ],
    "type": "string"
   },
   "outcome": {
    "enum": [
     "success",
     "failure"
    ],
    "type": "string"
   },
   "region": {
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "routeType": {
    "enum": [
     "api",
     "rpc",
     "mcp",
     "a2a",
     "webhook"
    ],
    "type": "string"
   },
   "targetClass": {
    "enum": [
     "general_api",
     "evm_rpc",
     "mcp_server",
     "a2a_agent",
     "webhook_receiver",
     "agent_backend"
    ],
    "type": "string"
   }
  },
  "required": [
   "routeType",
   "targetClass",
   "outcome"
  ],
  "type": "object"
 },
 "name": "report_traffic_observation",
 "title": "Report Agent Traffic Observation"
}
