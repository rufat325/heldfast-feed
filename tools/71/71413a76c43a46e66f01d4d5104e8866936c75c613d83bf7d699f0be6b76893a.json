{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Explore financing categories"},"description":"The same preliminary analysis, for when someone wants to know which broad kinds of financing they could explore. Categories are unranked and are not lender offers. Works from approximate values the user gives for an Ontario residential property; Clara calculates the result in process and takes no contact details or documents. Results include the assumptions and caveats behind them. A preliminary scenario only, not an eligibility decision, a lender offer or an approval.","inputSchema":{"additionalProperties":false,"properties":{"city":{"maxLength":80,"minLength":1,"type":"string"},"employmentType":{"enum":["employed","self_employed","retired","other","prefer_not_to_say"],"type":"string"},"estimatedPropertyValue":{"exclusiveMinimum":0,"maximum":100000000,"minimum":0,"type":"number"},"existingMortgageBalances":{"items":{"maximum":100000000,"minimum":0,"type":"number"},"maxItems":5,"minItems":1,"type":"array"},"householdIncomeRange":{"enum":["under_50000","50000_to_99999","100000_to_149999","150000_to_199999","200000_plus","prefer_not_to_say"],"type":"string"},"propertyType":{"enum":["detached","semi_detached","townhouse","condo","residential_2_to_4_units","other"],"type":"string"},"province":{"enum":["ON","AB","BC","MB","NB","NL","NS","NT","NU","PE","QC","SK","YT"],"type":"string"},"purpose":{"enum":["explore_options","home_equity","debt_consolidation","home_improvement","other"],"type":"string"},"renewalMonth":{"pattern":"^20\\d{2}-(0[1-9]|1[0-2])$","type":"string"},"requestedAdditionalAmount":{"maximum":100000000,"minimum":0,"type":"number"},"selfReportedCreditRange":{"enum":["excellent","good","fair","poor","unknown","prefer_not_to_say"],"type":"string"},"timing":{"enum":["within_30_days","one_to_three_months","over_three_months","exploring"],"type":"string"}},"type":"object"},"name":"get_financing_options","t