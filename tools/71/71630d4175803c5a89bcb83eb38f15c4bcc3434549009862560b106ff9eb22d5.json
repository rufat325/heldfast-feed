{
 "description": "Register an API in the catalog (REST/GraphQL/gRPC/AsyncAPI). Requires `write` scope. Defaults kind to 'rest' and lifecycle to 'experimental' if omitted.",
 "inputSchema": {
  "properties": {
   "componentId": {
    "description": "Owning project/component id",
    "type": "string"
   },
   "description": {
    "description": "What the API does",
    "type": "string"
   },
   "kind": {
    "description": "API kind, e.g. rest / graphql / grpc / asyncapi",
    "type": "string"
   },
   "lifecycle": {
    "description": "Lifecycle, e.g. experimental / production / deprecated",
    "type": "string"
   },
   "name": {
    "description": "API name (required)",
    "type": "string"
   },
   "ownerTeamId": {
    "description": "Owner team id",
    "type": "string"
   },
   "specUrl": {
    "description": "URL to the OpenAPI/AsyncAPI/GraphQL spec",
    "type": "string"
   },
   "tags": {
    "description": "Free-form tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_api"
}
