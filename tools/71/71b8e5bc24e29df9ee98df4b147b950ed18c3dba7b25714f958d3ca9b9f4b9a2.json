{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Per-region safety news items, or news for an arbitrary place name.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "place": {
    "description": "Place name for ad-hoc news, e.g. 'Kelowna'",
    "maxLength": 60,
    "type": "string"
   },
   "refresh": {
    "description": "Bypass the news cache (API keys with real-time entitlement only)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_news",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "fetchedAt": {
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "image": {
       "type": "string"
      },
      "link": {
       "type": "string"
      },
      "published": {
       "type": "string"
      },
      "region": {
       "type": "string"
      },
      "regionLabel": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "link",
      "source",
      "published"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "place": {
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "title": "Get safety news"
}
