{
 "description": "Get network request logs from the browser",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "session_id": {
    "description": "Browser session ID",
    "type": "string"
   },
   "since_timestamp": {
    "description": "Only return logs after this timestamp",
    "type": "number"
   },
   "status_filter": {
    "description": "Filter by HTTP status (errors: 4xx/5xx, success: 2xx)",
    "enum": [
     "errors",
     "success"
    ],
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "get_browser_network_logs"
}
