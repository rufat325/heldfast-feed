{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Create a car shipping request"},"description":"Creates a REAL shipping request that carriers can bid on. Call it only after the customer has confirmed the route, the vehicle and that we may use their email. The customer is emailed a confirmation link before carriers are alerted; nothing is booked or charged. Afterwards use get_quotes to read the real carrier prices. Needs an API key.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"customer":{"additionalProperties":false,"properties":{"email":{"format":"email","type":"string"},"first_name":{"maxLength":60,"minLength":1,"type":"string"},"last_name":{"maxLength":60,"type":"string"},"phone":{"maxLength":25,"type":"string"}},"required":["first_name","email"],"type":"object"},"delivery":{"additionalProperties":false,"description":"A US location: give a ZIP code, or a city and a state.","properties":{"city":{"maxLength":80,"type":"string"},"state":{"description":"2-letter state code, e.g. FL","maxLength":2,"minLength":2,"type":"string"},"zip":{"description":"5-digit US ZIP code","pattern":"^\\d{5}$","type":"string"}},"type":"object"},"notes":{"maxLength":500,"type":"string"},"pickup":{"additionalProperties":false,"description":"A US location: give a ZIP code, or a city and a state.","properties":{"city":{"maxLength":80,"type":"string"},"state":{"description":"2-letter state code, e.g. FL","maxLength":2,"minLength":2,"type":"string"},"zip":{"description":"5-digit US ZIP code","pattern":"^\\d{5}$","type":"string"}},"type":"object"},"pickup_date":{"description":"Preferred pickup date, YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"timing":{"enum":["asap","few_days","this_week","flexible"],"type":"string"},"trailer":{"enum":["open","enclosed"],"type":"string"},"vehicles":{"items":{"additionalProperties":false,"properties":{"make":{"maxLength":40,"type":"string"},"model":{"maxLength":60,"type":"string"},"running":{"description":"false if the vehicle does not run (adds cost)","type":"boolean"},"type":{"description":"Vehicle class. Required if make and model are not given.","enum":["sedan","suv","pickup","van"],"type":"string"},"year":{"type":"integer"}},"type":"object"},"maxItems":6,"minItems":1,"type":"array"}},"required":["customer","pickup","delivery","vehicles"],"type":"object"},"name":"create_shipping_request","title":"Create a car shipping request"}
