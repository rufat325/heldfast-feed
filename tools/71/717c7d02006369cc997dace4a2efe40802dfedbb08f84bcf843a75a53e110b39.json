{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search services"
 },
 "description": "Finds services in the catalog of 9,700+ status pages by name, with their status now. Use it to find a service\u2019s slug.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "query": {
    "description": "A name, e.g. \"github\" or \"aws\"",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_services",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "query": {
    "type": "string"
   },
   "services": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "color": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "since": {
       "anyOf": [
        {
         "description": "ISO 8601",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "When the status began; null when it was so at our first check"
      },
      "slug": {
       "type": "string"
      },
      "status": {
       "description": "online, issue, major_outage, critical, maintenance or unknown",
       "type": "string"
      },
      "text": {
       "description": "What its status page says, e.g. an incident\u2019s name",
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "status",
      "color",
      "text",
      "since",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "services"
  ],
  "type": "object"
 },
 "title": "Search services"
}
