{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Export multiple media files at once, optionally merged into a single file.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fileType": {
    "description": "Desired export format",
    "enum": [
     "csv",
     "csv-insights",
     "csv-transcript",
     "csv-transcript-sentiment",
     "csv-text-sentiment",
     "docx",
     "html",
     "json",
     "md",
     "pdf",
     "sourceFile",
     "srt",
     "ttml",
     "txt",
     "vtt",
     "mp4"
    ],
    "type": "string"
   },
   "folderId": {
    "description": "Folder ID for the merged export",
    "type": "string"
   },
   "isInsightVisualized": {
    "description": "Include insight visualizations",
    "type": "boolean"
   },
   "isMerged": {
    "description": "Merge all exports into a single file",
    "type": "boolean"
   },
   "isRedacted": {
    "description": "Apply PII redaction to export",
    "type": "boolean"
   },
   "isSpeakerEmail": {
    "description": "Include speaker emails in export",
    "type": "boolean"
   },
   "isSpeakerNames": {
    "description": "Include speaker names in export",
    "type": "boolean"
   },
   "isTimeStamps": {
    "description": "Include timestamps in export",
    "type": "boolean"
   },
   "mediaIds": {
    "description": "Array of media IDs to export",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "mediaIds",
   "fileType"
  ],
  "type": "object"
 },
 "name": "export_multiple_media",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Export Multiple Media Files"
}
