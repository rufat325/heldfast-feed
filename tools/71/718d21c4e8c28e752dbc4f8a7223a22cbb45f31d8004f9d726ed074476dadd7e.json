{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Clinical Trials (ClinicalTrials.gov): Search clinical trials"
 },
 "description": "Find studies by condition, intervention (drug/device), location, sponsor or free text, optionally filtered by status and phase. Free within the daily allowance, then $0.003 USDC per call via x402.",
 "inputSchema": {
  "properties": {
   "condition": {
    "description": "Condition or disease, e.g. \"type 2 diabetes\"",
    "type": "string"
   },
   "intervention": {
    "description": "Drug, device or procedure",
    "type": "string"
   },
   "limit": {
    "description": "Results per page, 1-50 (default 20)",
    "type": "integer"
   },
   "location": {
    "description": "City, region or country",
    "type": "string"
   },
   "page_token": {
    "description": "next_page_token from a previous response",
    "type": "string"
   },
   "phase": {
    "description": "1, 2, 3, 4, EARLY_PHASE1 or NA",
    "type": "string"
   },
   "q": {
    "description": "Free-text search across the record",
    "type": "string"
   },
   "sponsor": {
    "description": "Sponsor or collaborator",
    "type": "string"
   },
   "status": {
    "description": "Comma-separated: RECRUITING, NOT_YET_RECRUITING, ACTIVE_NOT_RECRUITING, COMPLETED, TERMINATED\u2026",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "clinical-trials__search",
 "outputSchema": {
  "additionalProperties": true,
  "description": "This endpoint's JSON response.",
  "type": "object"
 },
 "title": "Clinical Trials (ClinicalTrials.gov): Search clinical trials"
}
