{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Request a file export from a Data Box NAS to an Object Storage bucket; each file needs a 30+ char description and a type for the export review. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Target bucket name (see ncloud_databox_list_buckets)",
    "type": "string"
   },
   "dataBoxNo": {
    "description": "Data Box number (console: My Space > server details > Infra tab)",
    "type": "integer"
   },
   "dryRun": {
    "default": false,
    "description": "If true, returns the request without sending it",
    "type": "boolean"
   },
   "fileList": {
    "description": "Files to export with review metadata",
    "items": {
     "additionalProperties": false,
     "properties": {
      "delimiter": {
       "description": "Custom delimiter (required when tableDetail is CUSTOM)",
       "type": "string"
      },
      "description": {
       "description": "Description of the file (30+ chars; it is the basis of the export review)",
       "minLength": 30,
       "type": "string"
      },
      "imageDetail": {
       "description": "Image extension for IMAGE files",
       "enum": [
        "BMP",
        "GIF",
        "JPEG",
        "TIFF"
       ],
       "type": "string"
      },
      "modelDetail": {
       "description": "Model format for MODEL files",
       "enum": [
        "TENSORFLOW",
        "PYTORCH",
        "SCIKIT_LEARN",
        "R"
       ],
       "type": "string"
      },
      "modelVersion": {
       "description": "Model version (required when type is MODEL)",
       "type": "string"
      },
      "name": {
       "description": "File name to export",
       "type": "string"
      },
      "tableDetail": {
       "description": "Field delimiter for TABLE files",
       "enum": [
        "TAB",
        "SPACE",
        "COMMA",
        "CUSTOM"
       ],
       "type": "string"
      },
      "type": {
       "description": "File type: TABLE (delimited text), IMAGE, MODEL (analysis model), LICENCE",
       "enum": [
        "TABLE",
        "IMAGE",
        "MODEL",
        "LICENCE"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "description",
      "type"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "nasInstanceNo": {
    "description": "Source NAS instance number (see ncloud_databox_list_nas)",
    "type": "integer"
   }
  },
  "required": [
   "dataBoxNo",
   "nasInstanceNo",
   "bucketName",
   "fileList"
  ],
  "type": "object"
 },
 "name": "ncloud_databox_apply_file_export"
}
