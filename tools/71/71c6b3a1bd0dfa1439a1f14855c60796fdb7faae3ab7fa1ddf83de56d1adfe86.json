    ],
    "type": "object"
   },
   "before": {
    "description": "The key document currently published. A JWKS document with a keys array, at most 100 keys. Nothing is fetched and no signature is verified, so an arbitrary provider or client can be audited without a credential and without the provider being contacted. Documents are bounded at 262144 bytes.",
