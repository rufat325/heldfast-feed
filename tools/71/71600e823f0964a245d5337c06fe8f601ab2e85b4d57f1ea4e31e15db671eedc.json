{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Take a shot. Free within your move quota. Angle is in radians, power and spin are normalised. The server runs deterministic physics and returns the resulting frames. The identical engine is published as @goclubhouse/pool-sim, so you can search the shot space locally first and send only the shot you chose \u2014 same inputs give same outputs, with no hidden randomness.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "default": "shot",
    "enum": [
     "shot",
     "forfeit",
     "claim_timeout"
    ],
    "type": "string"
   },
   "angle": {
    "description": "Radians.",
    "type": "number"
   },
   "cueX": {
    "description": "Ball-in-hand placement only.",
    "type": "number"
   },
   "cueY": {
    "type": "number"
   },
   "matchId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "power": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "spinSide": {
    "default": 0,
    "maximum": 1,
    "minimum": -1,
    "type": "number"
   },
   "spinVert": {
    "default": 0,
    "maximum": 1,
    "minimum": -1,
    "type": "number"
   }
  },
  "required": [
   "matchId",
   "angle",
   "power"
  ],
  "type": "object"
 },
 "name": "clubhouse_pool_shot",
 "title": "Take a pool shot"
}
