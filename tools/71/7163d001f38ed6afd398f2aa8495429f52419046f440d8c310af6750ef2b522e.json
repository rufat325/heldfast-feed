 "description": "Pending Replies: change one reply by reply_id: its draft (replaces; null clears), summary, channel, category, received_at, person (person_id, or person_name linked only on one match), source, or status pending (reopen / unsnooze) or snoozed with snooze_until. Unknown or other-user reply_id returns not_found. To mark it sent or dismissed use resolve_pending_reply. Never sends anything. Requires API key or OAuth with context.write. ($0.10; API key required)",
 "destructiveHint": false,
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "personal",
     "work"
    ],
    "type": "string"
   },
   "channel": {
    "description": "Where to reply: whatsapp, email, sms, call, imessage, telegram, instagram, facebook, signal, linkedin, twitter, slack, teams, work_email, zoom, dayze, other. Default email when source is set, else other.",
    "type": "string"
   },
   "draft": {
    "description": "The reply text to send later, max 20,000 characters. Replaces the saved draft; empty or null clears. Alias: draft_message.",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Alias for request_id.",
    "type": "string"
   },
   "person_id": {
    "type": "string"
   },
   "person_name": {
    "type": "string"
   },
   "received_at": {
    "type": "string"
   },
   "reply_id": {
    "description": "From create_pending_reply or get_pending_replies.",
    "type": "string"
   },
   "request_id": {
    "description": "Client idempotency key (retries return original result).",
    "type": "string"
   },
   "snooze_until": {
    "description": "ISO date-time, with status snoozed.",
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "description": "The email the reply answers, as ids only (e.g. a search_gmail id is a message_id). Never a subject, sender or text. On update, null clears it.",
    "properties": {
     "kind": {
      "enum": [
       "gmail",
       "email",
       "other"
      ],
      "type": "string"
     },
     "message_id": {
      "type": "string"
     },
     "thread_id": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "status": {
    "enum": [
     "pending",
     "snoozed"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One line (max 280) in your own words: what the reply is about. Never paste the email body, subject line or sender address.",
    "type": "string"
   }
  },
  "required": [
   "reply_id"
  ],
  "type": "object"
 },
