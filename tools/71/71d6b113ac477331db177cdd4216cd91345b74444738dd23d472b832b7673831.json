{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "FREE. Deterministically inspect an ERC-20 allowance/revocation request against explicit network/token/spender/value policy. No wallet action, no signing, no chain read unless a separately requested preflight asks for it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": false,
    "properties": {
     "amount_atomic": {
      "type": "string"
     },
     "intent": {
      "enum": [
       "SET_ALLOWANCE",
       "REVOKE"
      ],
      "type": "string"
     },
     "kind": {
      "const": "ERC20_ALLOWANCE",
      "type": "string"
     },
     "network": {
      "type": "string"
     },
     "owner": {
      "type": [
       "string",
       "null"
      ]
     },
     "spender": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "kind",
     "network",
     "token",
     "spender",
     "amount_atomic",
     "intent"
    ],
    "type": "object"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "observe_current_allowance": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "acknowledge_unconstrained": {
      "type": "boolean"
     },
     "allowed_networks": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "allowed_spenders": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "allowed_tokens": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ]
     },
     "exact_allowance_atomic": {
      "type": [
       "string",
       "null"
      ]
     },
     "max_allowance_atomic": {
      "type": [
       "string",
       "null"
      ]
     },
     "revoke_only": {
      "type": "boolean"
     },
     "unlimited_allowance": {
      "anyOf": [
       {
        "enum": [
         "ALLOW",
         "REQUIRE_APPROVAL",
         "BLOCK"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "action",
   "policy"
  ],
  "type": "object"
 },
 "name": "inspect_allowance"
}
