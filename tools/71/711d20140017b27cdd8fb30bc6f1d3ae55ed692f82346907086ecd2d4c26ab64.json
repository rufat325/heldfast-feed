{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add or update an anime on the authenticated user's list (status, score, watched episodes, dates). Creates the entry if absent; fields you omit are left unchanged on an existing entry. Provide at least one field besides anime_id. Requires a MyAnimeList login.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "anime_id": {
    "description": "MyAnimeList numeric ID of the target entry. (The read tools call this same id `id`; it's named anime_id/manga_id here to match MAL's own write endpoints.) Obtain it from search_anime/search_manga, or from get_my_anime_list/get_my_manga_list for an entry already on your list.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "comments": {
    "description": "Free-text comments.",
    "type": "string"
   },
   "finish_date": {
    "description": "Date as YYYY-MM-DD.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "is_rewatching": {
    "description": "Whether currently rewatching.",
    "type": "boolean"
   },
   "num_times_rewatched": {
    "description": "Times rewatched.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "num_watched_episodes": {
    "description": "Episodes watched. Note: get_my_anime_list returns this same value as `num_episodes_watched` \u2014 the field name is intentionally different here.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "priority": {
    "description": "List priority: 0 = low, 1 = medium, 2 = high.",
    "maximum": 2,
    "minimum": 0,
    "type": "integer"
   },
   "rewatch_value": {
    "description": "Rewatch/reread value: 0 = none \u2026 5 = very high.",
    "maximum": 5,
    "minimum": 0,
    "type": "integer"
   },
   "score": {
    "description": "Score 0-10 (0 clears the score).",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "start_date": {
    "description": "Date as YYYY-MM-DD.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "status": {
    "description": "List status bucket.",
    "enum": [
     "watching",
     "completed",
     "on_hold",
     "dropped",
     "plan_to_watch"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Comma-separated free-text tags.",
    "type": "string"
   }
  },
  "required": [
   "anime_id"
  ],
  "type": "object"
 },
 "name": "update_my_anime_status",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "score": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Update my anime status"
}
