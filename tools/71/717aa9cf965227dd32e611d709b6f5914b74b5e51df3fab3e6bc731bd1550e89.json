{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get the inner or outer HTML of the first element matching a selector, truncated to a byte budget. Useful for understanding structure you cannot infer from dom_query alone.",
 "inputSchema": {
  "properties": {
   "frame": {
    "default": "main",
    "description": "'main' (default), or a substring of a frame's origin/name.",
    "type": "string"
   },
   "inner": {
    "default": false,
    "description": "innerHTML instead of outerHTML.",
    "type": "boolean"
   },
   "max_bytes": {
    "default": 4000,
    "description": "Truncate beyond this many characters.",
    "maximum": 200000,
    "minimum": 100,
    "type": "number"
   },
   "selector": {
    "description": "CSS selector.",
    "type": "string"
   }
  },
  "required": [
   "selector"
  ],
  "type": "object"
 },
 "name": "dom_get_html"
}
