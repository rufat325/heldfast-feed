{
 "description": "Compress web content from a URL for reduced token usage. Returns markdown with 70-90% fewer tokens than raw HTML.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "maxRetries": {
    "description": "Max retry attempts (default: 3)",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "description": "Fetch mode: 'fast' (plain HTTP), 'stealth' (TLS fingerprint), 'render' (headless browser), 'auto' (fast with fallback). Default: 'auto'",
    "enum": [
     "fast",
     "stealth",
     "render",
     "auto"
    ],
    "type": "string"
   },
   "timeout": {
    "description": "Fetch timeout in milliseconds (default: 10000)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "url": {
    "description": "URL to compress",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "scraper_compress_url"
}
