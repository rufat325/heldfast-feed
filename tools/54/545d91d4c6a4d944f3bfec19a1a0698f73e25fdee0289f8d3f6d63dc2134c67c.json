{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a resize preset"
 },
 "description": "Use this when someone asks about one resize and format preset by name or id. Returns its project, output formats, pixel widths and created and edited times, or not-found. Not for changing it.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "templateIdOrName": {
    "description": "Exact template id or name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "templateIdOrName"
  ],
  "type": "object"
 },
 "name": "get_template",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   },
   "template": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "created": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "edited": {
        "$ref": "#/properties/template/anyOf/0/properties/created"
       },
       "formats": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 5,
        "type": "array"
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 120,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "$ref": "#/properties/template/anyOf/0/properties/id"
       },
       "sizes": {
        "items": {
         "maxLength": 20,
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       }
      },
      "required": [
       "id",
       "name",
       "projectId",
       "formats",
       "sizes",
       "created",
       "edited"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "template"
  ],
  "type": "object"
 },
 "title": "Get a resize preset"
}
