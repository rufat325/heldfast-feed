{
 "annotations": {
  "readOnlyHint": true,
  "title": "Routing"
 },
 "description": "Compute a route between waypoints for a travel mode, returning distance, time and legs. Geoapify REST: GET /v1/routing.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "details": {
    "description": "Comma-separated route detail sets, e.g. 'instruction_details,route_details'.",
    "type": "string"
   },
   "format": {
    "description": "Response format \u2014 'json' (default) or 'geojson'.",
    "type": "string"
   },
   "lang": {
    "description": "Result language as an ISO 639-1 code, e.g. 'en', 'de', 'fr'.",
    "type": "string"
   },
   "mode": {
    "description": "Travel mode: drive, walk, bicycle, truck, hike, transit, etc. (required).",
    "minLength": 1,
    "type": "string"
   },
   "units": {
    "description": "Distance units \u2014 'metric' or 'imperial'.",
    "type": "string"
   },
   "waypoints": {
    "description": "Pipe-separated 'lat,lon' waypoints, e.g. '52.5,13.4|52.6,13.5' (required).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "waypoints",
   "mode"
  ],
  "type": "object"
 },
 "name": "geoapify_routing",
 "title": "Routing"
}
