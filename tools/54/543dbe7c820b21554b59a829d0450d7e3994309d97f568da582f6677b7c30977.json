    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   },
   "hash": {
    "description": "transaction hash, 0x + 64 hex [required]",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "hash"
  ],
  "type": "object"
 },
 "name": "chain_tx_events",
