{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use immediately after opening a target to summarize document, exhaustive procedure/string counts, and a bounded segment sample. detail controls segment fields and limit controls only the returned segment sample.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "examples": [
   {
    "detail": "concise",
    "limit": 10
   }
  ],
  "properties": {
   "detail": {
    "default": "concise",
    "description": "Requested response detail level.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of results to return in this page.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "binary_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "detail": {
      "enum": [
       "concise",
       "detailed"
      ],
      "type": "string"
     },
     "document": {
      "type": "string"
     },
     "procedure_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "segment_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "segments": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "end": {
         "type": "string"
        },
        "length": {
         "minimum": 0,
         "type": "number"
        },
        "name": {
         "type": "string"
        },
        "start": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "start",
        "end"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "string_count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "document",
     "detail",
     "segments",
     "segment_count",
     "procedure_count",
     "string_count"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Binary Overview"
}
