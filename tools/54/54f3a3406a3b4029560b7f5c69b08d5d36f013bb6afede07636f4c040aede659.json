{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List booked transactions. transactionNo/voucherNo filters are applied CLIENT-SIDE (Billy silently ignores them as query params) by scanning up to 5000 records \u2014 bound with dates when possible.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "isVoided": {
    "description": "Filter by voided status (client-side)",
    "type": "boolean"
   },
   "maxEntryDate": {
    "description": "Entry date <= this (client-side)",
    "type": "string"
   },
   "minEntryDate": {
    "description": "Entry date >= this (client-side)",
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Records per page (max 1000, default 50)",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "transactionNo": {
    "description": "Exact transaction number (client-side scan)",
    "type": "string"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   },
   "voucherNo": {
    "description": "Exact voucher number (client-side scan)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_transactions"
}
