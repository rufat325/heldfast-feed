{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Type Text"
 },
 "description": "Type text into an input element. Appends to existing content unless clear_first is set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clear_first": {
    "description": "Clear existing content before typing (default false)",
    "type": [
     "boolean",
     "null"
    ]
   },
   "selector": {
    "description": "CSS selector of the input element",
    "type": "string"
   },
   "session_id": {
    "description": "Session ID returned by browser_navigate",
    "type": "string"
   },
   "text": {
    "description": "Text to type",
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "selector",
   "text"
  ],
  "type": "object"
 },
 "name": "browser_type"
}
