{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false
 },
 "description": "Delete a group post. Members already notified about it are not un-notified.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "groupId": {
    "description": "Exact group ID. Provide groupId or shortCode.",
    "type": "string"
   },
   "postId": {
    "description": "Post ID to delete.",
    "type": "string"
   },
   "shortCode": {
    "description": "Exact group short code. Provide groupId or shortCode.",
    "type": "string"
   }
  },
  "required": [
   "postId"
  ],
  "type": "object"
 },
 "name": "vrchat_group_post_delete",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "groupId": {
    "type": "string"
   },
   "mergedFromExisting": {
    "type": "boolean"
   },
   "post": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "authorId": {
        "type": "string"
       },
       "createdAt": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "imageId": {
        "type": "string"
       },
       "roleIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "text": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "updatedAt": {
        "type": "string"
       },
       "visibility": {
        "type": "string"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "postId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "created",
     "updated",
     "deleted"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "groupId"
  ],
  "type": "object"
 }
}
