{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn a title or phrase into a clean, URL-safe slug (lowercase, hyphenated, accents stripped). Use when generating page paths, filenames or anchor IDs.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "input": {
    "description": "Text to slugify.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "separator": {
    "default": "-",
    "description": "Word separator.",
    "enum": [
     "-",
     "_"
    ],
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "slugify",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "The URL-safe slug.",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "title": "Slugify text for URLs"
}
