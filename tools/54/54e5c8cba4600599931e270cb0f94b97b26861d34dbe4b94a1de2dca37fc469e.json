{
 "description": "Apply a caption template to a scene synchronously (without going through autonomous_edit).",
 "inputSchema": {
  "properties": {
   "mode": {
    "enum": [
     "add",
     "recreate",
     "style",
     "translate",
     "clear",
     "remove_fillers"
    ],
    "type": "string"
   },
   "project_id": {
    "description": "Project / scene id to apply to.",
    "type": "string"
   },
   "scene": {
    "description": "Inline scene (alternative to project_id).",
    "type": "object"
   },
   "template_id": {
    "description": "Template slug / id from list_caption_templates.",
    "type": "string"
   }
  },
  "required": [
   "template_id"
  ],
  "type": "object"
 },
 "name": "apply_caption_template"
}
