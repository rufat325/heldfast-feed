 "description": "Triage a dead letter queue. Groups entries by failure reason, names the dominant cause when one accounts for most of the queue, and separates retryable failures from permanent ones so you know whether replaying will work or fail again. Reports the same item failing more than once, and entries stating no reason at all, which cannot be triaged by anybody. Pay 130000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entries": {
    "description": "Dead letter entries as JSON objects, at most 2000. Nothing is replayed, requeued or deleted.",
    "example": [
     {
      "error": "UPSTREAM_TIMEOUT",
      "failed_at": "2026-10-01T00:00:00Z",
      "message_id": "m-1"
     },
     {
      "error": "UPSTREAM_TIMEOUT",
      "failed_at": "2026-10-01T00:00:05Z",
      "message_id": "m-2"
     },
     {
      "error": "UPSTREAM_TIMEOUT",
      "failed_at": "2026-10-01T00:00:09Z",
      "message_id": "m-3"
     },
     {
      "error": "UPSTREAM_TIMEOUT",
      "failed_at": "2026-10-01T00:05:00Z",
      "message_id": "m-1"
     },
     {
      "error": {
       "code": "SCHEMA_REJECTED",
       "detail": "total was a string"
      },
      "message_id": "m-4"
     },
     {
      "message_id": "m-5"
     }
    ],
    "items": {
     "type": "object"
    },
    "maxItems": 2000,
    "minItems": 1,
    "type": "array"
   },
   "id_field": {
    "description": "The message or event id. Defaults to id. Either a bare property name or an RFC 6901 JSON Pointer, since callers write both.",
    "example": "message_id",
    "maxLength": 256,
    "type": "string"
   },
   "reason_field": {
    "description": "The failure reason. Read from a string, or from a code property when it is an object. Defaults to error. Either a bare property name or an RFC 6901 JSON Pointer, since callers write both.",
    "example": "error",
    "maxLength": 256,
    "type": "string"
   },
   "retryable_reasons": {
    "description": "Substrings that mark a reason retryable. Omit to group and count without classifying.",
    "example": [
     "UPSTREAM_TIMEOUT",
     "RATE_LIMITED"
    ],
    "items": {
     "maxLength": 256,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "entries"
  ],
  "type": "object"
 },
