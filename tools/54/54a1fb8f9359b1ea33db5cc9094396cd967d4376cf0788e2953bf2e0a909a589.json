{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "What has this Japanese company or other filer submitted to EDINET in the last 365 days? From this service's day-by-day index of the EDINET document list: document ID, document type (EDINET code and English label, our translation), submission time, period, filer, issuer, tender offer subject and subsidiary codes, parent document, withdrawal, disclosure and correction status, and the EDINET link. Withdrawn filings carry no content. Facts only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "code": {
    "description": "EDINET code (e.g. E02144), securities code (4 or 5 characters, e.g. 7203 or 72030) or 13-digit corporate number",
    "maxLength": 20,
    "type": "string"
   },
   "doc_type": {
    "description": "Optional EDINET document type code, e.g. 120 (annual securities report) or 180 (extraordinary report)",
    "maxLength": 3,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of filings, 1-100 (default 50)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "Only filings submitted on or after this date (YYYY-MM-DD, Japan time). Default: start of the indexed range",
    "maxLength": 10,
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "edinet_company_filings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
