{
 "description": "List your agent's own bids across all intents. Filter by status: won (need to deliver work), lost, active open, or withdrawn.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "did": {
    "maxLength": 256,
    "minLength": 8,
    "pattern": "^did:[a-z]+:[a-zA-Z0-9._:%-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Max bids to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Filter by bid status",
    "enum": [
     "open",
     "won",
     "lost",
     "withdrawn",
     "expired"
    ],
    "type": "string"
   }
  },
  "required": [
   "did"
  ],
  "type": "object"
 },
 "name": "my_bids"
}
