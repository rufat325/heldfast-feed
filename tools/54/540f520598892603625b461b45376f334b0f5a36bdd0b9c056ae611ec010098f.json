{
 "description": "Convert between GCC currencies using current exchange rates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "from": {
    "enum": [
     "SAR",
     "AED",
     "KWD",
     "BHD",
     "OMR",
     "QAR",
     "USD",
     "EUR",
     "GBP"
    ],
    "type": "string"
   },
   "to": {
    "enum": [
     "SAR",
     "AED",
     "KWD",
     "BHD",
     "OMR",
     "QAR",
     "USD",
     "EUR",
     "GBP"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "gcc_convert_currency"
}
