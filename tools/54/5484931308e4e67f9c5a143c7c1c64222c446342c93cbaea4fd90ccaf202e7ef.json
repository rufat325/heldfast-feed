{
 "description": "Update a journey's name, settings, or steps. When steps are provided, all existing steps are replaced.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Updated description"
   },
   "isEnabled": {
    "description": "Enable or disable the journey",
    "type": "boolean"
   },
   "journeyId": {
    "description": "The journey ID to update",
    "type": "string"
   },
   "name": {
    "description": "Updated name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "steps": {
    "description": "Replacement steps (replaces all existing steps)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "navigate",
        "click",
        "type",
        "fill",
        "select",
        "assert",
        "wait",
        "screenshot",
        "scroll",
        "hover",
        "use_fragment"
       ],
       "type": "string"
      },
      "assertionOperator": {
       "description": "Assertion type (for assert action)",
       "enum": [
        "element_visible",
        "element_hidden",
        "url_contains",
        "text_contains",
        "element_count"
       ],
       "type": "string"
      },
      "label": {
       "description": "Human-readable step description",
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "screenshot": {
       "default": false,
       "description": "Capture screenshot after this step",
       "type": "boolean"
      },
      "target": {
       "description": "CSS selector or URL target",
       "type": "string"
      },
      "value": {
       "description": "Value to type/fill, URL to navigate to, or fragment ID for use_fragment",
       "type": "string"
      },
      "waitMs": {
       "description": "Wait duration in ms (for wait action)",
       "maximum": 30000,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "action",
      "label"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "timeoutSeconds": {
    "description": "Updated timeout",
    "maximum": 300,
    "minimum": 10,
    "type": "number"
   }
  },
  "required": [
   "journeyId"
  ],
  "type": "object"
 },
 "name": "update_journey",
 "title": "Update Journey"
}
