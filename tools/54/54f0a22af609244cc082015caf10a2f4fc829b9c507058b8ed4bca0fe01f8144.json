{
 "description": "Import a .brain file and extract its system prompt for use in any LLM.\nCan import from file path or raw JSON.\n\nExample: brain_import({ path: \"~/.0n/brains/crm-expert-v1.0.0.brain\" })\nExample: brain_import({ brain_data: {...} })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brain_data": {
    "additionalProperties": {},
    "description": "Raw brain data JSON",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "path": {
    "description": "Path to .brain file",
    "type": "string"
   },
   "target_llm": {
    "description": "Target LLM format (default: claude)",
    "enum": [
     "claude",
     "openai",
     "gemini",
     "grok",
     "generic"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "brain_import"
}
