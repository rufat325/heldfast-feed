{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Top-of-book quote \u2014 best bid and ask with their sizes \u2014 for a symbol on a venue, read live from the engine and never cached. For the last traded price use last_trade instead. Returns structuredContent alongside the text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "symbol": {
    "description": "Symbol, e.g. BTCUSD, AAPL, EURUSD.",
    "type": "string"
   },
   "venue": {
    "description": "Live-data venue: stocks, crypto, forex, dex.",
    "type": "string"
   }
  },
  "required": [
   "venue",
   "symbol"
  ],
  "type": "object"
 },
 "name": "last_quote",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "A": {
    "description": "Ask size.",
    "type": "string"
   },
   "B": {
    "description": "Bid size.",
    "type": "string"
   },
   "a": {
    "description": "Ask price.",
    "type": "string"
   },
   "b": {
    "description": "Bid price.",
    "type": "string"
   },
   "t": {
    "description": "Timestamp, Unix epoch milliseconds.",
    "type": "number"
   }
  },
  "required": [
   "b",
   "B",
   "a",
   "A",
   "t"
  ],
  "type": "object"
 },
 "title": "Last quote"
}
