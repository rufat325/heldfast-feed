{
 "description": "Set a hit count condition for a breakpoint. The breakpoint will only pause when the condition is met.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "breakpointId": {
    "description": "The breakpoint ID",
    "type": "string"
   },
   "operator": {
    "description": "Hit count operator (==, >, >=, <, <=, % for modulo)",
    "enum": [
     "==",
     ">",
     ">=",
     "<",
     "<=",
     "%"
    ],
    "type": "string"
   },
   "sessionId": {
    "description": "The debug session ID",
    "type": "string"
   },
   "value": {
    "description": "Hit count value to compare against",
    "type": "number"
   }
  },
  "required": [
   "sessionId",
   "breakpointId",
   "operator",
   "value"
  ],
  "type": "object"
 },
 "name": "debugger_set_hit_count_condition"
}
