{
 "description": "Start a structured NPC dialogue. Loads NPC data from the world pack and switches the frame to the dialogue scene, with portrait and response choices.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "context": {
    "description": "Additional context for the encounter (e.g., 'player just saved them')",
    "type": "string"
   },
   "greeting": {
    "description": "Custom greeting text (overrides auto-generated greeting)",
    "type": "string"
   },
   "npcId": {
    "description": "NPC ID from world pack",
    "type": "string"
   },
   "responses": {
    "description": "Custom response choices (overrides role-based defaults)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "npcId"
  ],
  "type": "object"
 },
 "name": "start_dialogue"
}
