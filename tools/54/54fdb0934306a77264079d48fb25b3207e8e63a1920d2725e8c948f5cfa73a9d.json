{"description":"Generates a migration (ALTER) script from the physical diff between a baseline and the current model \u2014 renames stay renames (stable-id matching), destructive changes come commented out, unsupported changes are flagged as [WARNING] comments. Baselines from the same project lineage ({file}/{erdId}) preserve renames; freshly parsed SQL/DBML text falls back to name matching. Pro plan required; requires login.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"after":{"anyOf":[{"$ref":"#/properties/before/anyOf/0"},{"$ref":"#/properties/before/anyOf/1"},{"$ref":"#/properties/before/anyOf/2"},{"$ref":"#/properties/before/anyOf/3"}],"description":"Target state (the current model)"},"before":{"anyOf":[{"additionalProperties":false,"properties":{"file":{"description":"Path to a local .erd.json file","type":"string"}},"required":["file"],"type":"object"},{"additionalProperties":false,"properties":{"erdId":{"description":"Server ERD id (from list_erds)","type":"string"}},"required":["erdId"],"type":"object"},{"additionalProperties":false,"properties":{"dialect":{"description":"Defaults to mysql","enum":["mysql","postgres","cubrid","oracle","sqlserver","sqlite","h2"],"type":"string"},"sql":{"description":"CREATE TABLE SQL","type":"string"}},"required":["sql"],"type":"object"},{"additionalProperties":false,"properties":{"dbml":{"description":"DBML text","type":"string"}},"required":["dbml"],"type":"object"}],"description":"Baseline (e.g. the state last applied to the database)"},"dialect":{"$ref":"#/properties/before/anyOf/2/properties/dialect","description":"SQL dialect"}},"required":["before","after"],"type":"object"},"name":"export_alter_sql"}
