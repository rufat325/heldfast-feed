{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update fields on ONE workflow action (PATCH \u2014 only fields you supply are changed). Use get_workflow_action first to see its current shape. To change the actions of a whole workflow, see update_workflow.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ai_create_missing": {
    "description": "Type 8: create suggested tags/correspondents/document types/storage paths that don't exist yet",
    "type": "boolean"
   },
   "ai_overwrite_existing": {
    "description": "Type 8: apply suggestions even when the document already has a value",
    "type": "boolean"
   },
   "ai_suggestion_fields": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "title",
        "tags",
        "correspondent",
        "document_type",
        "storage_path",
        "created"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Type 8 (required): which AI suggestions to apply. Needs AI enabled in Paperless."
   },
   "assign_change_groups": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "assign_change_users": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "assign_correspondent": {
    "type": [
     "number",
     "null"
    ]
   },
   "assign_custom_fields": {
    "description": "Type 1: custom field IDs to add",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "assign_custom_fields_values": {
    "anyOf": [
     {
      "additionalProperties": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "number"
        },
        {
         "type": "boolean"
        },
        {
         "items": {
          "type": "number"
         },
         "type": "array"
        },
        {
         "type": "null"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Type 1: values for assign_custom_fields keyed by custom field ID, e.g. {\"7\": \"2026-01-01\"}. The value for the custom field. For monetary fields, use currency code prefix format (e.g., USD10.00, GBP123.45, EUR9.99) \u2014 NOT trailing symbol format (e.g., 10.00$). For documentlink fields, use a single document ID (e.g., 123) or an array of document IDs (e.g., [123, 456])."
   },
   "assign_document_type": {
    "type": [
     "number",
     "null"
    ]
   },
   "assign_owner": {
    "type": [
     "number",
     "null"
    ]
   },
   "assign_storage_path": {
    "type": [
     "number",
     "null"
    ]
   },
   "assign_tags": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "assign_title": {
    "anyOf": [
     {
      "maxLength": 256,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Type 1: Jinja2 title template"
   },
   "assign_view_groups": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "assign_view_users": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "email": {
    "anyOf": [
     {
      "properties": {
       "body": {
        "type": "string"
       },
       "id": {
        "description": "Keep when editing an existing action's email settings",
        "type": [
         "number",
         "null"
        ]
       },
       "include_document": {
        "type": "boolean"
       },
       "subject": {
        "type": "string"
       },
       "to": {
        "description": "Comma-separated email addresses",
        "type": "string"
       }
      },
      "required": [
       "subject",
       "body",
       "to"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Type 3: email configuration"
   },
   "id": {
    "type": "number"
   },
   "passwords": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Type 5 (required): PDF passwords to try, in order. The unlocked file is stored as a new version of the document. Tools return them masked (\"**********\"); send a masked list back unchanged to keep the stored passwords."
   },
   "remove_all_correspondents": {
    "type": "boolean"
   },
   "remove_all_custom_fields": {
    "type": "boolean"
   },
   "remove_all_document_types": {
    "type": "boolean"
   },
   "remove_all_owners": {
    "type": "boolean"
   },
   "remove_all_permissions": {
    "type": "boolean"
   },
   "remove_all_storage_paths": {
    "type": "boolean"
   },
   "remove_all_tags": {
    "type": "boolean"
   },
   "remove_change_groups": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_change_users": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_correspondents": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_custom_fields": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_document_types": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_owners": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_storage_paths": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_tags": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_view_groups": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "remove_view_users": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "type": {
    "description": "Action type: 1=assignment, 2=removal, 3=email, 4=webhook, 5=password removal (needs passwords), 6=move to trash, 7=remote OCR (its workflow must have a type-1 consumption-started trigger), 8=apply AI suggestions (needs ai_suggestion_fields; its workflow must have a trigger other than type 1)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "webhook": {
    "anyOf": [
     {
      "properties": {
       "as_json": {
        "description": "Send params as a JSON body instead of form data",
        "type": "boolean"
       },
       "body": {
        "type": [
         "string",
         "null"
        ]
       },
       "headers": {
        "anyOf": [
         {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "description": "Keep when editing an existing action's webhook settings",
        "type": [
         "number",
         "null"
        ]
       },
       "include_document": {
        "description": "Attach the document file",
        "type": "boolean"
       },
       "params": {
        "anyOf": [
         {
          "additionalProperties": {
           "type": "string"
          },
          "propertyNames": {
           "type": "string"
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "type": "string"
       },
       "use_params": {
        "type": "boolean"
       }
      },
      "required": [
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Type 4: webhook configuration"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_workflow_action"
}
