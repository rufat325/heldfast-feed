{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search procurement opportunities"
 },
 "description": "Search CanadaBuys and Alberta Purchasing Connection together. When configured, search terms or business capabilities may be sent to Cohere to select commodity filters. See /privacy.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Optional category such as services, goods, construction, steel, lumber",
    "type": "string"
   },
   "keywords": {
    "description": "Search words or phrase",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum combined results (default 20, max 50)",
    "type": "integer"
   },
   "province": {
    "description": "Optional province or delivery region filter",
    "type": "string"
   },
   "source": {
    "default": "all",
    "description": "all, federal, or alberta",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_opportunities",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "kind": {
    "type": "string"
   },
   "opportunities": {
    "items": {
     "properties": {
      "buyer": {
       "type": "string"
      },
      "category": {
       "type": "string"
      },
      "closes_at": {
       "description": "Closing time as ISO 8601 in Alberta time with UTC offset; empty when unknown",
       "type": "string"
      },
      "closing": {
       "description": "Closing value exactly as the source published it",
       "type": "string"
      },
      "reference": {
       "type": "string"
      },
      "region": {
       "type": "string"
      },
      "solicitation": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Search procurement opportunities"
}
