{
 "description": "Create a one-time card token (POST /v1/tokens on api.secure.payco.co). The token is then bound to a customer via create_customer and charged via charge_card.",
 "inputSchema": {
  "properties": {
   "card_number": {
    "description": "Card PAN",
    "type": "string"
   },
   "cvc": {
    "description": "Card CVC",
    "type": "string"
   },
   "exp_month": {
    "description": "Expiry month, e.g. 09",
    "type": "string"
   },
   "exp_year": {
    "description": "Expiry year, e.g. 2027",
    "type": "string"
   }
  },
  "required": [
   "card_number",
   "exp_year",
   "exp_month",
   "cvc"
  ],
  "type": "object"
 },
 "name": "tokenize_card"
}
