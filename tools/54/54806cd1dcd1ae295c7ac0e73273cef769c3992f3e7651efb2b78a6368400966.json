{
 "description": "List the platforms the user has connected on One. ALWAYS call this tool first in any workflow. Each connection has the kebab-case `platform` name (e.g., 'ship-station', 'shopify') and the `key` (the connectionKey for execute_one_action) you'll need for subsequent tool calls. Each connection carries an `access` field describing what you may run on it: `full`, a set of allowed HTTP `methods`, or a specific list of `actions` (each with `actionId`, `title`, `method`). When a connection is action-scoped, its `actions` are exactly what may run, so you need not search.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "list_one_integrations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "availablePlatforms": {
    "description": "Platforms that can be connected. Only listed in knowledge/code-gen mode",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      }
     },
     "required": [
      "platform",
      "name",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "connections": {
    "description": "Array of user's active connections, each with the access the current config confers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "access": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "policy": {
           "const": "full",
           "type": "string"
          }
         },
         "required": [
          "policy"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "methods": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "policy": {
           "const": "methods",
           "type": "string"
          }
         },
         "required": [
          "policy",
          "methods"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "actions": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "actionId": {
              "type": "string"
             },
             "method": {
              "type": "string"
             },
             "title": {
              "type": "string"
             }
            },
            "required": [
             "actionId",
             "title",
             "method"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "policy": {
           "const": "actions",
           "type": "string"
          }
         },
         "required": [
          "policy",
          "actions"
         ],
         "type": "object"
        }
       ],
       "description": "What the access config lets you run on this connection: `full`, an allowed `methods` set, or a specific `actions` list. When `actions`, those are exactly what may run, so no search is needed."
      },
      "key": {
       "type": "string"
      },
      "platform": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "platform",
      "key",
      "tags",
      "access"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "additionalProperties": false,
    "description": "Counts of connections (and available platforms in knowledge/code-gen mode)",
    "properties": {
     "availableCount": {
      "type": "number"
     },
     "connectedCount": {
      "type": "number"
     }
    },
    "required": [
     "connectedCount"
    ],
    "type": "object"
   }
  },
  "required": [
   "connections",
   "summary"
  ],
  "type": "object"
 },
 "title": "List One Integrations"
}
