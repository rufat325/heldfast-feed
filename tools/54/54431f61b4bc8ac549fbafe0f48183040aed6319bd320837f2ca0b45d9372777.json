 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Compare Indian localities head-to-head"
 },
 "description": "Compare 2\u20133 localities in one city side-by-side: price trends, livability, investment grade, strengths, and watchouts. Use when the user asks \"X vs Y\" or \"which is better for buying/renting\" about neighborhoods. Covers cities AVnester publishes locality guides for; others return supported=false \u2014 surface the scopeMessage. For specific LISTINGS by ID, use compare_properties instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {
   "city": {
    "description": "Indian city covering all compared localities.",
    "maxLength": 60,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "localities": {
    "description": "2\u20133 localities to compare (array, not comma-separated string).",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 2,
    "type": "array"
   },
   "propertyType": {
    "description": "Property type for comparison.",
    "enum": [
     "apartment",
     "villa",
     "plot",
     "independent_house"
    ],
    "type": "string"
   }
  },
  "required": [
   "city",
   "localities"
  ],
  "type": "object"
 },
 "name": "compare_localities",
 "outputSchema": {
