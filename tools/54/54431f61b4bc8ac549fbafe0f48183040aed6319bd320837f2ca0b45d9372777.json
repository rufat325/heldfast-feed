{
 "_meta": {
  "openai/outputTemplate": "ui://widget/insight-cards-v2.html",
  "openai/widgetDescription": "Locality side-by-side comparison cards.",
  "ui": {
   "csp": {
    "connectDomains": [],
    "frameDomains": [],
    "resourceDomains": []
   },
   "resourceUri": "ui://widget/insight-cards-v2.html"
