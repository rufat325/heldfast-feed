{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "reports.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read saved progress for the owned Grade jobId, with optional after sequence and limit 1-100. Progress is not proof that a saved report is ready; never starts work. Action and version are fixed by this tool; do not supply them.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "jobId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "get_grade_progress",
 "securitySchemes": [
  {
   "scopes": [
    "reports.read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read Grade progress"
}
