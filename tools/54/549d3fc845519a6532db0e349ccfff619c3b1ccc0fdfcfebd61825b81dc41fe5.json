 "description": "See how an MCP server\u2019s advertised capability surface changed. Reports capabilities and features added or removed, and the shift in the aggregate annotation surface: how many tools declare themselves read-only, destructive, idempotent or open-world. That total governs what a client may let an agent do without asking a human. Pay 120000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "An MCP toolset: either the tools/list result object, or the bare array of tool definitions. At most 400 tools are read and the rest are reported. A capabilities or serverInfo object is used when present. Nothing is fetched and no tool is ever called.",
    "example": {
     "capabilities": {
      "resources": {
       "subscribe": true
      },
      "tools": {
       "listChanged": true
      }
     },
     "serverInfo": {
      "name": "orders-mcp",
      "version": "1.3.0"
     },
     "tools": [
      {
       "annotations": {
        "idempotentHint": true,
        "readOnlyHint": true
       },
       "description": "List orders for a tenant, newest first, with optional paging. Returns only orders the caller is entitled to see.",
       "inputSchema": {
        "properties": {
         "page": {
          "description": "Page number, starting at 1.",
          "minimum": 1,
          "type": "integer"
         },
         "status": {
          "description": "Restrict to one status.",
          "enum": [
           "open",
           "shipped"
          ],
          "type": "string"
         },
         "tenant_id": {
          "description": "The tenant whose orders to list.",
          "type": "string"
         }
        },
        "required": [
         "tenant_id"
        ],
        "type": "object"
       },
       "name": "list_orders",
       "outputSchema": {
