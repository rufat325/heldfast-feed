{
 "_meta": {
  "com.oxinsider/docs-group": "content",
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Editorial Content"
 },
 "description": "Search 0xinsider's editorial content by keyword. Returns matching learn articles, glossary entries, comparisons, research, and trading strategies with their canonical URLs.\n\nArgs:\n  - q (string, required): Search query, 1-256 characters before whitespace trimming\n  - limit (number, 1-50, default 10): Max results\n\nReturns: List of matching content items with content_id, kind, slug, title, excerpt, and url.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Max results (1-50, default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Search query (1-256 characters before whitespace trimming, non-empty after trimming)",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_content",
 "outputSchema": {
  "$defs": {
   "ContentSearchResult": {
    "properties": {
     "content_id": {
      "type": "string"
     },
     "excerpt": {
      "type": "string"
     },
     "kind": {
      "enum": [
       "learn",
       "glossary",
       "comparison",
       "research",
       "strategy"
      ],
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "content_id",
     "kind",
     "slug",
     "title",
     "excerpt",
     "url"
    ],
    "type": "object"
   },
   "ResponseMeta": {
    "properties": {
     "cache_age_s": {
      "type": "integer"
     },
     "cached": {
      "type": "boolean"
     },
     "category_skill_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_enriched_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_model_operationally_degraded": {
      "type": "boolean"
     },
     "category_skill_model_version": {
      "type": "string"
     },
     "category_skill_observation_started_at": {
      "format": "date-time",
      "type": "string"
     },
     "category_skill_platform": {
      "const": "polymarket",
      "type": "string"
     },
     "category_skill_scope": {
      "const": "observed_goldsky_primary_taker_fill",
      "type": "string"
     },
     "category_skill_source": {
      "enum": [
       "live",
       "partial",
       "degraded",
       "unavailable"
      ],
      "type": "string"
     },
     "category_skill_source_coverage": {
      "enum": [
       "partial_whale_threshold_fills",
       "graded_wallet_fills"
      ],
      "type": "string"
     },
     "category_skill_status_counts": {
      "properties": {
       "degraded": {
        "minimum": 0,
        "type": "integer"
       },
       "insufficient": {
        "minimum": 0,
        "type": "integer"
       },
       "live": {
        "minimum": 0,
        "type": "integer"
       },
       "stale": {
        "minimum": 0,
        "type": "integer"
       },
       "unknown": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "live",
       "insufficient",
       "stale",
       "unknown",
       "degraded"
      ],
      "type": "object"
     },
     "category_skill_taxonomy_version": {
      "type": "string"
     },
     "cost": {
      "type": "integer"
     },
     "directional_source": {
      "enum": [
       "live",
       "degraded"
      ],
      "type": "string"
     },
     "ranking_as_of": {
      "format": "date-time",
      "type": "string"
     },
     "ranking_generation": {
      "type": "integer"
     },
     "ranking_source": {
      "enum": [
       "live",
       "db_only"
      ],
      "type": "string"
     },
     "request_id": {
      "type": "string"
     }
    },
    "required": [
     "request_id",
     "cached",
     "cost"
    ],
    "type": "object"
   }
  },
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/ContentSearchResult"
      },
      "type": "array"
     },
     "has_more": {
      "const": false,
      "type": "boolean"
     },
     "meta": {
      "$ref": "#/$defs/ResponseMeta"
     },
     "next_cursor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "data",
     "has_more",
     "next_cursor",
     "meta"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "doc_url": {
        "type": "string"
       },
       "param": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "request_id": {
        "type": "string"
       },
       "retry_after_seconds": {
        "minimum": 0,
        "type": "integer"
       },
       "retry_at": {
        "type": "string"
       },
       "status": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "code"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Search Editorial Content"
}
