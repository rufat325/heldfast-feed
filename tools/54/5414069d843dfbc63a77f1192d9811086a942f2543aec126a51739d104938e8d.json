{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Replace a half-open text range in a vault note using zero-based UTF-16 line/ch positions. An optional expected value guards against stale reads.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dryRun": {
    "default": false,
    "description": "Preview the change without applying it: returns the planned action and the exact CLI command.",
    "type": "boolean"
   },
   "end": {
    "description": "Exclusive end position (zero-based line/ch).",
    "properties": {
     "ch": {
      "description": "Zero-based UTF-16 column within the line.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "line": {
      "description": "Zero-based line number.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "line",
     "ch"
    ],
    "type": "object"
   },
   "expected": {
    "description": "Optional exact guard: the current text in the range must match this value.",
    "type": "string"
   },
   "path": {
    "description": "Vault-relative path to the note.",
    "minLength": 1,
    "type": "string"
   },
   "start": {
    "description": "Inclusive start position (zero-based line/ch).",
    "properties": {
     "ch": {
      "description": "Zero-based UTF-16 column within the line.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "line": {
      "description": "Zero-based line number.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "line",
     "ch"
    ],
    "type": "object"
   },
   "text": {
    "description": "Replacement text; may contain newlines.",
    "type": "string"
   }
  },
  "required": [
   "path",
   "start",
   "end",
   "text"
  ],
  "type": "object"
 },
 "name": "note_replace_range",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
