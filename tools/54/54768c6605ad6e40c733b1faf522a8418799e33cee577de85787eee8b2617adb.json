{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Capture reusable developer feedback. Add to an existing proposal when it expresses the same preference; otherwise create a new proposal. Three observations promote it for human review, but only a human can accept it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "existing_proposal_id": {
    "description": "Existing matching proposal, when one was found.",
    "type": "string"
   },
   "observation": {
    "minLength": 1,
    "type": "string"
   },
   "proposed_by": {
    "minLength": 1,
    "type": "string"
   },
   "scope_id": {
    "description": "Existing guideline to revise.",
    "type": "string"
   },
   "scope_kind": {
    "description": "Required only when creating a proposal.",
    "enum": [
     "code_rule",
     "general_rule",
     "project_init",
     "pr_review_guideline"
    ],
    "type": "string"
   },
   "suggested_edit": {
    "description": "Complete proposed new policy body.",
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "observation",
   "proposed_by"
  ],
  "type": "object"
 },
 "name": "propose_preference"
}
