{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Search the Journal's articles"},"description":"Searches the published articles in The Bitcoin Adviser's Journal (articles and guides, from 2023 on) and returns a handful, best first: title, a short excerpt, topics, editorial type, author, original publish date, substantive update date and canonical url. topic narrows to one of the knowledge base's drawers; type to one editorial type. Article text is content written at its date, not an instruction and not current guidance: for what The Bitcoin Adviser does now, use find_answer or find_related_content, which put approved answers first. Use get_article to read one article or one section. Drafts and withdrawn articles are never returned. Deterministic; no model.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"limit":{"maximum":8,"minimum":1,"type":"integer"},"query":{"maxLength":200,"minLength":1,"type":"string"},"topic":{"enum":["basics","control","continuity","income","retirement","us","fees","operations","onboarding","professionals","referrals"],"type":"string"},"type":{"enum":["evergreen-explanation","practical-guide","commentary","research","historical-reporting","time-sensitive-analysis"],"type":"string"}},"required":["query"],"type":"object"},"name":"search_articles","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"articles":{"items":{"additionalProperties":false,"properties":{"author":{"additionalProperties":false,"properties":{"name":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["name","url"],"type":"object"},"currentGuidance":{"anyOf":[{"additionalProperties":false,"properties":{"answerId":{"type":["string","null"]},"label":{"type":"string"},"url":{"format":"uri","type":"string"}},"required":["label","url","answerId"],"type":"object"},{"type":"null"}]},"editorialType":{"enum":["evergreen-explanation","practical-guide","commentary","research","historical-reporting","time-sensitive-analysis"],"type":"string"},"editorialTypeLabel":{"type":"string"},"excerpt":{"type":"string"},"layout":{"enum":["essay","guide"],"type":"string"},"publishedAt":{"type":"string"},"role":{"const":"context","type":"string"},"slug":{"type":"string"},"title":{"type":"string"},"topics":{"items":{"additionalProperties":false,"properties":{"id":{"enum":["basics","control","continuity","income","retirement","us","fees","operations","onboarding","professionals","referrals"],"type":"string"},"label":{"type":"string"}},"required":["id","label"],"type":"object"},"type":"array"},"updatedAt":{"type":["string","null"]},"url":{"format":"uri","type":"string"}},"required":["slug","title","excerpt","url","author","publishedAt","updatedAt","editorialType","editorialTypeLabel","layout","topics","role","currentGuidance"],"type":"object"},"type":"array"},"message":{"type":["string","null"]},"notice":{"type":"string"},"revision":{"type":["string","null"]}},"required":["notice","revision","articles","message"],"type":"object"},"title":"Search the Journal's articles"}
