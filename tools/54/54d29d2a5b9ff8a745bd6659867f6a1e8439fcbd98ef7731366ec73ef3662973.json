{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get personalized recommendations"
 },
 "description": "Personalized bottle picks from taste preferences (flavor keywords like 'caramel', 'smoke', 'cherry'), a budget in USD, and an occasion (e.g. 'gift', 'everyday sipper', 'celebration', 'introducing a friend to bourbon').",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "description": "Max price in USD",
    "minimum": 0,
    "type": "number"
   },
   "category": {
    "description": "Restrict to one spirit category",
    "enum": [
     "bourbon",
     "rye",
     "tennessee",
     "wheat",
     "corn",
     "american_single_malt",
     "scotch_single_malt",
     "scotch_blend",
     "irish",
     "japanese",
     "canadian",
     "world_whisky",
     "rum",
     "tequila",
     "mezcal",
     "cognac",
     "armagnac",
     "brandy",
     "gin",
     "vodka",
     "other"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 5)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "occasion": {
    "description": "What the bottle is for",
    "maxLength": 120,
    "type": "string"
   },
   "taste_preferences": {
    "description": "Flavor keywords the drinker enjoys, e.g. ['caramel','vanilla','oak']",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "taste_preferences"
  ],
  "type": "object"
 },
 "name": "get_recommendations"
}
