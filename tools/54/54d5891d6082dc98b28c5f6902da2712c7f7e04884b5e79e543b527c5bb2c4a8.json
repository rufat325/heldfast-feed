{
 "_meta": {
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit inspected text"
 },
 "description": "Apply inspected edits immediately and atomically as one act. Returned insertion handles exclude unchanged edges.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agent": {
    "type": "string"
   },
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "edits": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "context_handle": {
       "maxLength": 128,
       "type": "string"
      },
      "placement": {
       "enum": [
        "replace",
        "before",
        "after"
       ],
       "type": "string"
      },
      "text": {
       "maxLength": 262144,
       "type": "string"
      }
     },
     "required": [
      "context_handle",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "minItems": 1,
    "type": "array"
   },
   "label": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "operation_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "turn_id": {
    "maxLength": 160,
    "minLength": 1,
    "pattern": "\\S",
    "type": "string"
   }
  },
  "required": [
   "document",
   "edits"
  ],
  "type": "object"
 },
 "name": "document.edit",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Edit inspected text"
}
