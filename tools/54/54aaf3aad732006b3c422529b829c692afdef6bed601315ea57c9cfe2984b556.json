     "error": {
      "anyOf": [
       {},
       {
        "type": "null"
       }
      ]
     },
     "meta": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "next": {
      "items": {},
      "type": "array"
     },
     "payment": {
      "additionalProperties": false,
      "properties": {
       "execution_status": {
        "enum": [
         "not_started",
         "succeeded",
         "failed",
         "unknown"
        ],
        "type": "string"
       },
