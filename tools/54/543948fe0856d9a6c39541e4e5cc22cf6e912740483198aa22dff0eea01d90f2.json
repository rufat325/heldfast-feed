    "description": "Test cycle ID",
    "type": [
     "string",
     "number"
    ]
   },
   "defectIDs": {
    "description": "Jira defect numeric IDs to link (e.g. [14488])",
    "items": {
     "type": [
      "string",
      "number"
     ]
    },
    "type": "array"
   },
   "testCaseExecutionId": {
    "description": "Test case execution ID",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "cycleId",
   "testCaseExecutionId",
   "defectIDs"
  ],
  "type": "object"
