{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Date calculator"
 },
 "description": "Add or subtract a number of days, weeks, months or years from a date. Dates use the YYYY-MM-DD format. Months and years are clamped to the last day of the target month where needed. Returns the resulting date. Source: https://hopi.co.uk/date-calculator/",
 "inputSchema": {
  "properties": {
   "amount": {
    "description": "How many units to move (0 to 100000)",
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "date": {
    "description": "Start date in YYYY-MM-DD format",
    "format": "date",
    "type": "string"
   },
   "direction": {
    "default": "add",
    "description": "'add' to move forwards, 'subtract' to move backwards (default 'add')",
    "enum": [
     "add",
     "subtract"
    ],
    "type": "string"
   },
   "unit": {
    "default": "days",
    "description": "Unit to move by (default 'days')",
    "enum": [
     "days",
     "weeks",
     "months",
     "years"
    ],
    "type": "string"
   }
  },
  "required": [
   "date",
   "amount"
  ],
  "type": "object"
 },
 "name": "hopi_date_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "amount": {
    "type": "number"
   },
   "date": {
    "type": "string"
   },
   "direction": {
    "type": "string"
   },
   "result": {
    "type": "string"
   },
   "resultLong": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "unit": {
    "type": "string"
   },
   "weekday": {
    "type": "string"
   }
  },
  "required": [
   "amount",
   "date",
   "direction",
   "result",
   "resultLong",
   "source_url",
   "summary",
   "unit",
   "weekday"
  ],
  "type": "object"
 },
 "title": "Date calculator"
}
