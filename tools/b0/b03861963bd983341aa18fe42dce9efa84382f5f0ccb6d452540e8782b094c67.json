{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "doctofam:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your medical practices"
 },
 "description": "Use this when someone asks which medical practices or doctor's offices they run in DoctoFam, or a practice's id is needed. Returns each practice's id, name, currency, default language and timezone, 20 per page by default. Not for finding a patient or a visit.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page of this listing; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Practices per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_clinics",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinics": {
    "description": "Medical practices in the signed-in organization, administrative metadata only. Patient, appointment and clinical records are never returned.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "currency": {
       "anyOf": [
        {
         "pattern": "^[A-Za-z]{3}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "defaultLocale": {
       "anyOf": [
        {
         "maxLength": 35,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "type": "string"
      },
      "timezone": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "currency",
      "defaultLocale",
      "timezone",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   }
  },
  "required": [
   "clinics",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List your medical practices"
}
