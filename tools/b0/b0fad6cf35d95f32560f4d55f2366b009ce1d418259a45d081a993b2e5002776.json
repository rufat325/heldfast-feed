{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "V\u00e9rifie qu'une VM clon\u00e9e est une copie fid\u00e8le du syst\u00e8me h\u00f4te",
 "inputSchema": {
  "properties": {
   "compare_content": {
    "default": false,
    "type": "boolean"
   },
   "compare_packages": {
    "default": false,
    "type": "boolean"
   },
   "ip": {
    "anyOf": [
     {
      "format": "ipv4",
      "pattern": "^(?:(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])\\.){3}(?:25[0-5]|2[0-4][0-9]|1[0-9][0-9]|[1-9][0-9]|[0-9])$",
      "type": "string"
     },
     {
      "format": "ipv6",
      "pattern": "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:))$",
      "type": "string"
     }
    ]
   },
   "quick": {
    "default": false,
    "type": "boolean"
   },
   "save_report": {
    "default": false,
    "type": "boolean"
   },
   "self_check": {
    "default": false,
    "type": "boolean"
   },
   "user": {
    "default": "amineutron",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "verbose": {
    "default": false,
    "type": "boolean"
   },
   "vm_name": {
    "default": "neutron-clone",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vm_verify"
}
