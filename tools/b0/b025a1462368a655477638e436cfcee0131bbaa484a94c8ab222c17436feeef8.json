{
 "description": "Generate a cryptographically signed governance block for embedding in HTML pages. Includes terms, revocation policy, and content hash.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "caching": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "content": {
    "description": "Article/page content to hash and govern",
    "type": "string"
   },
   "derivative": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "inference": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "license_url": {
    "type": "string"
   },
   "privateKey": {
    "description": "Publisher's Ed25519 private key (hex)",
    "type": "string"
   },
   "publicKey": {
    "description": "Publisher's Ed25519 public key (hex)",
    "type": "string"
   },
   "redistribution": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   },
   "terms_version": {
    "type": "string"
   },
   "training": {
    "enum": [
     "permitted",
     "prohibited",
     "compensation_required",
     "attribution_required"
    ],
    "type": "string"
   }
  },
  "required": [
   "content",
   "publicKey",
   "privateKey"
  ],
  "type": "object"
 },
 "name": "generate_governance_block"
}
