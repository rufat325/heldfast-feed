{
 "description": "Override the AI-assigned stakeholder role for a specific person on the buying committee DealMap. This is a team-wide override visible to all team members. Use when the AI role is clearly wrong. Free operation. Requires \"outreach\" scope on the API key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "node_id": {
    "description": "The node_id from get_dealmap stakeholders",
    "type": "string"
   },
   "product_id": {
    "description": "The product ID",
    "type": "number"
   },
   "stakeholder_role": {
    "description": "The corrected stakeholder role",
    "enum": [
     "Economic Buyer",
     "Decision Maker",
     "Champion",
     "Executive Sponsor",
     "Evaluator",
     "End User",
     "Procurement / Legal Reviewer",
     "Blocker",
     "Irrelevant"
    ],
    "type": "string"
   },
   "ticker": {
    "description": "Company ticker symbol",
    "type": "string"
   }
  },
  "required": [
   "product_id",
   "ticker",
   "node_id",
   "stakeholder_role"
  ],
  "type": "object"
 },
 "name": "override_stakeholder_role"
}
