{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search long-term memory for anything relevant to a query. Searches every layer by default and returns results ranked by relevance, each tagged with the layer it came from. Use this before answering when the user refers to something from an earlier session.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeContext": {
    "description": "Boost results matching the current context.",
    "type": "boolean"
   },
   "layers": {
    "description": "Restrict the search to these layers. Defaults to all but working.",
    "items": {
     "enum": [
      "working",
      "episodic",
      "semantic",
      "procedural",
      "core"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Maximum results (default 10).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "minConfidence": {
    "description": "Drop results below this confidence.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "What to look for, in plain language.",
    "minLength": 1,
    "type": "string"
   },
   "taskType": {
    "description": "Current task, e.g. 'coding', 'writing' \u2014 used for context matching.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "zenbrain_recall",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "How many memories were returned.",
    "type": "number"
   },
   "results": {
    "description": "Matching memories, most relevant first.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "confidence": {
       "type": "number"
      },
      "content": {
       "type": "string"
      },
      "emotionalWeight": {
       "type": "number"
      },
      "layer": {
       "type": "string"
      },
      "score": {
       "type": "number"
      }
     },
     "required": [
      "content",
      "layer",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "skipped": {
    "description": "Rows that carried no readable content and were left out of `results`.",
    "type": "number"
   }
  },
  "required": [
   "count",
   "results",
   "skipped"
  ],
  "type": "object"
 },
 "title": "Recall memories"
}
