{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store an immutable memory candidate only when its current adoption record cites an ACCEPTED experiment. This does not approve or expose the candidate to default retrieval.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adoption_record_id": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "claim": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   },
   "claim_type": {
    "enum": [
     "setup-fact",
     "workflow-rule",
     "evaluated-lesson",
     "constraint"
    ],
    "type": "string"
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "rationale": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "schema_version": {
    "const": "dwin.memory-candidate/v1",
    "type": "string"
   },
   "scope": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "pattern": "^[a-z0-9][a-z0-9-]{0,39}$",
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "valid_until": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "claim",
   "claim_type",
   "scope",
   "confidence",
   "valid_until",
   "adoption_record_id",
   "rationale",
   "tags"
  ],
  "type": "object"
 },
 "name": "memory_propose",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidate_id": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "created": {
    "type": "boolean"
   },
   "run_id": {
    "type": "string"
   },
   "source": {},
   "status": {
    "type": "string"
   }
  },
  "required": [
   "candidate_id",
   "created",
   "source",
   "run_id",
   "status"
  ],
  "type": "object"
 }
}
