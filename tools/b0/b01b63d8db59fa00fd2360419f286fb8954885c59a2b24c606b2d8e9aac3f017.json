{
 "description": "Gestiona clientes de RISE CRM. Acciones: list, get (id), create, update (id), delete (id), contacts (id), statement_pdf (id, start_date, end_date \u2014 descarga el estado de cuenta PDF).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "contacts",
     "statement_pdf"
    ],
    "type": "string"
   },
   "address": {
    "type": "string"
   },
   "city": {
    "type": "string"
   },
   "client_groups": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "company_name": {
    "type": "string"
   },
   "country": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "currency_symbol": {
    "type": "string"
   },
   "custom_fields": {
    "items": {
     "properties": {
      "custom_field_id": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "custom_field_id",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "disable_online_payment": {
    "type": "number"
   },
   "end_date": {
    "description": "Fecha fin (para statement_pdf)",
    "type": "string"
   },
   "group_id": {
    "type": "number"
   },
   "id": {
    "description": "ID del cliente (requerido para get, update, delete, contacts, statement_pdf)",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "phone": {
    "type": "string"
   },
   "search": {
    "type": "string"
   },
   "start_date": {
    "description": "Fecha inicio (para statement_pdf)",
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "vat_number": {
    "type": "string"
   },
   "website": {
    "type": "string"
   },
   "zip": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "clients"
}
