{
 "description": "Continue the SAME Codex session for an existing worker via `codex exec resume <thread_id>`. Works from a different MCP process or a fresh client session as long as the task recorded a thread_id. The worktree stays on the commit it was cut from unless rebaseOnto names a ref (resolved in the project directory, e.g. HEAD or main): uncommitted edits are stashed, the worker's own commits are replayed onto it, the stash comes back and base_commit moves, so the worker continues on current code. A conflict in either step puts the worktree back as it was, lists the files and does not start the worker. The receipt carries base_behind: how many commits the project's HEAD is past the worktree's base. acceptance replaces the worker's acceptance commands when the ones given at dispatch were wrong; the supervisor runs them again after this run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptance": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "items": {
       "anyOf": [
        {
         "minLength": 1,
         "type": "string"
        },
        {
         "additionalProperties": false,
         "properties": {
          "baseline": {
           "additionalProperties": false,
           "properties": {
            "failures": {
             "items": {
              "additionalProperties": false,
              "properties": {
               "kind": {
                "enum": [
                 "failure",
                 "error"
                ],
                "type": "string"
               },
               "signature": {
                "minLength": 1,
                "type": "string"
               },
               "test_id": {
                "minLength": 1,
                "type": "string"
               }
              },
              "required": [
               "test_id",
               "kind",
               "signature"
              ],
              "type": "object"
             },
             "type": "array"
            },
            "identity": {
             "additionalProperties": {
              "minLength": 1,
              "type": "string"
             },
             "properties": {
              "base_commit": {
               "minLength": 1,
               "type": "string"
              }
             },
             "required": [
              "base_commit"
             ],
             "type": "object"
            },
            "required": {
             "items": {
              "minLength": 1,
              "type": "string"
             },
             "type": "array"
            }
           },
           "required": [
            "identity",
            "failures",
            "required"
           ],
           "type": "object"
          },
          "command": {
           "minLength": 1,
           "type": "string"
          },
          "reportPath": {
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "command",
          "reportPath",
          "baseline"
         ],
         "type": "object"
        }
       ]
      },
      "maxItems": 10,
      "type": "array"
     }
    ]
   },
   "context": {
    "items": {
     "properties": {
      "path": {
       "minLength": 1,
       "type": "string"
      },
      "sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "prompt": {
    "minLength": 1,
    "type": "string"
   },
   "rebaseOnto": {
    "minLength": 1,
    "type": "string"
   },
   "task_id": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "prompt"
  ],
  "type": "object"
 },
 "name": "resume_codex_worker",
 "title": "Resume Codex worker"
}
