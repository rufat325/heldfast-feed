{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Find recent/trending papers on a topic. Sorted by date, with optional filtering to high-impact journals.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 30,
    "description": "Number of days to look back",
    "maximum": 365,
    "minimum": 1,
    "type": "number"
   },
   "highImpactOnly": {
    "default": false,
    "description": "Filter to high-impact journals only",
    "type": "boolean"
   },
   "maxResults": {
    "default": 20,
    "description": "Maximum number of results",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "topic": {
    "description": "Topic or search term",
    "type": "string"
   }
  },
  "required": [
   "topic"
  ],
  "type": "object"
 },
 "name": "trending_papers"
}
