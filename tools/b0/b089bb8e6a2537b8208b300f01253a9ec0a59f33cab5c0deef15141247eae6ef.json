  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Check a Fantasy Pundit weekly commentary and league-roast job returned by generate_weekly_commentary. It never starts generation. When completed, return the exact canonical commentary and share links without rewriting it.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "jobId": {
    "description": "Weekly commentary job ID returned by generate_weekly_commentary.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "get_commentary_result",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "canGenerate": {
    "description": "Whether a request can be made for this week. Creation still requires the user to ask for it.",
    "type": "boolean"
   },
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "adminName": {
       "type": [
        "string",
        "null"
       ]
      },
      "adminTeamName": {
       "type": [
        "string",
        "null"
       ]
      },
      "entryCount": {
       "type": [
        "string",
        "number",
        "null"
       ]
      },
      "id": {
       "description": "Public FPL classic league ID to use after the user chooses this league.",
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "commentary": {
    "additionalProperties": {},
    "description": "The exact published edition. Present its text as returned; do not create a competing rewrite.",
    "properties": {
     "closing": {
      "type": "string"
     },
     "exchanges": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "speaker": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "speaker",
        "text"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "format": {
      "type": "string"
     },
     "headline": {
      "type": "string"
     },
     "intro": {
      "type": "string"
     },
     "sections": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "body": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "body"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "shareLine": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "deduplicated": {
    "type": "boolean"
   },
   "deferredUntilFinal": {
    "description": "The request is saved while FPL scoring settles. This is a normal waiting state.",
    "type": "boolean"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "resetAt": {
      "type": "string"
     },
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "gameweek": {
    "anyOf": [
     {
      "maximum": 38,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "generationMode": {
    "const": "text",
    "type": "string"
   },
   "jobId": {
    "description": "Use this exact ID with get_commentary_result; do not start another job.",
    "type": "string"
   },
   "latestAvailableGameweek": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "latestCompletedGameweek": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "league": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "links": {
