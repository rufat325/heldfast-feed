     }
    },
    "required": [
     "leagueUrl"
    ],
    "type": "object"
   },
   "nextAction": {
    "description": "User-actionable guidance for this result.",
    "type": "string"
   },
   "nextStep": {
    "description": "The next safe action. Reading or checking status never grants permission to create an edition.",
    "enum": [
     "present_commentary",
     "poll",
     "ask_to_generate",
     "choose_league",
     "ask_to_retry",
     "unavailable"
    ],
    "type": "string"
   },
   "pollAfterSeconds": {
    "description": "Minimum delay before the next read-only status call. Stop polling when completed or failed.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "progress": {
    "type": "number"
   },
   "publishedAt": {
    "type": "string"
   },
   "resolution": {
    "additionalProperties": false,
    "properties": {
     "input": {
      "type": "string"
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "input"
    ],
    "type": "object"
   },
   "seasonId": {
    "type": "string"
   },
   "share": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "url",
     "text"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "completed",
     "queued",
     "processing",
     "not_generated",
     "needs_league_selection",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "nextStep"
  ],
  "type": "object"
 },
 "title": "Check Roast Status"
}
