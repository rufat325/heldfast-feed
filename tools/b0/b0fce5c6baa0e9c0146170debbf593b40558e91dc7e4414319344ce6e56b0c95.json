{
 "_meta": {
  "openai/outputTemplate": "ui://tutorializer/tutorial-detail-v2.html",
  "openai/toolInvocation/invoked": "Tutorializer tutorial ready.",
  "openai/toolInvocation/invoking": "Loading Tutorializer tutorial\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://tutorializer/tutorial-detail-v2.html"
  },
  "ui/resourceUri": "ui://tutorializer/tutorial-detail-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a tutorial and its videos"
 },
 "description": "Use this when someone asks about one tutorial and the videos rendered from it. Returns the tutorial's name, project and default voice plus up to 8 of its most recently edited videos with language, device, format, size and media links. Not for every video in a project.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tutorialId": {
    "description": "Tutorial id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "tutorialId"
  ],
  "type": "object"
 },
 "name": "get_tutorial",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   },
   "tutorial": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "defaultVoice": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "projectId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "projectId",
       "defaultVoice",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "videoCount": {
    "maximum": 8,
    "minimum": 0,
    "type": "integer"
   },
   "videoCountIsLowerBound": {
    "type": "boolean"
   },
   "videos": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "chaptersUrl": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "device": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "format": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "height": {
       "anyOf": [
        {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "subtitlesUrl": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "thumbnailUrl": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "url": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "width": {
       "anyOf": [
        {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "locale",
      "device",
      "format",
      "width",
      "height",
      "url",
      "chaptersUrl",
      "subtitlesUrl",
      "thumbnailUrl"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   }
  },
  "required": [
   "status",
   "tutorial",
   "videoCount",
   "videoCountIsLowerBound",
   "videos"
  ],
  "type": "object"
 },
 "title": "Get a tutorial and its videos"
}
