{
 "_meta": {
  "openai/fileParams": [
   "model_file"
  ],
  "openai/outputTemplate": "ui://widget/print-quote-card-v1.html",
  "openai/toolInvocation/invoked": "Quote ready",
  "openai/toolInvocation/invoking": "Pricing your part",
  "ui": {
   "resourceUri": "ui://widget/print-quote-card-v1.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this when someone asks how much it costs to 3D print a part, or wants a quote to have a 3D model (an STL, 3MF, STEP or OBJ file) printed and shipped by 3D Printer on Demand. It reads the attached file, checks that it can be printed, saves the quote, and returns the estimate with a private link that opens the saved quote on our website. When no file is attached, or the file type cannot be read, it returns a link to upload the file on our website. It does not cover drawings or photos.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "Color name for the chosen material. Default is the material's first color.",
    "maxLength": 40,
    "type": "string"
   },
   "material": {
    "default": "petg",
    "description": "Material id, one of the listed values. Default petg.",
    "enum": [
     "petg",
     "pla",
     "abs",
     "pa-cf",
     "petg-cf",
     "opm",
     "tpu"
    ],
    "type": "string"
   },
   "model_file": {
    "additionalProperties": true,
    "description": "The STL, 3MF, STEP or OBJ file the user attached.",
    "properties": {
     "download_url": {
      "description": "Download URL of the attached file.",
      "type": "string"
     },
     "file_id": {
      "description": "Identifier of the attached file.",
      "type": "string"
     },
     "file_name": {
      "type": "string"
     },
     "mime_type": {
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "part_description": {
    "description": "What the user says this part is or what it is for, in their own words, if they said. Leave out if they did not.",
    "maxLength": 500,
    "type": "string"
   },
   "quantity": {
    "default": 1,
    "description": "How many copies of the part.",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_print_quote",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color": {
    "type": "string"
   },
   "currency": {
    "const": "USD",
    "type": "string"
   },
   "file_name": {
    "type": "string"
   },
   "material": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "multi_color": {
    "type": "boolean"
   },
   "next_step": {
    "type": "string"
   },
   "order_fee_usd": {
    "type": "number"
   },
   "outcome": {
    "enum": [
     "instant",
     "needs_upload",
     "needs_review",
     "not_accepted",
     "invalid_choice",
     "try_later"
    ],
    "type": "string"
   },
   "price_held_days": {
    "type": "number"
   },
   "price_per_part_usd": {
    "type": "number"
   },
   "print_fit_notes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quantity": {
    "type": "number"
   },
   "quote_url": {
    "type": "string"
   },
   "review_url": {
    "type": "string"
   },
   "shipping_usd": {
    "type": "number"
   },
   "size_mm": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "subtotal_usd": {
    "type": "number"
   },
   "total_usd": {
    "type": "number"
   },
   "upload_url": {
    "type": "string"
   },
   "valid_colors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "valid_materials": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "outcome",
   "message"
  ],
  "type": "object"
 },
 "title": "Get a 3D print quote"
}
