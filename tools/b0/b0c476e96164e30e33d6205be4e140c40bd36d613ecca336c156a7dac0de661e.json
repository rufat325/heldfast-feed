 "description": "Generate a Solana keypair whose address ends/starts with a vanity pattern. Returns publicKey + secretKey (base58). Caller must save the secret key immediately; it is never stored. Hard timeout: 60 s. Use this before launching a coin when its mint address should carry a recognizable prefix or suffix.",
 "inputSchema": {
  "properties": {
   "caseSensitive": {
    "default": false,
    "type": "boolean"
   },
   "maxAttempts": {
    "default": 5000000,
    "type": "integer"
   },
   "prefix": {
    "description": "Desired address prefix (case-insensitive by default)",
    "type": "string"
   },
   "suffix": {
    "description": "Desired address suffix (case-insensitive by default)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "pumpfun_vanity_mint",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "attempts": {
    "description": "Keypairs ground before the match",
    "type": "integer"
   },
   "ms": {
    "description": "Wall-clock grind time in milliseconds",
    "type": "number"
   },
   "publicKey": {
    "description": "Matched Solana address (base58)",
    "type": "string"
   },
   "secretKey": {
    "description": "Secret key (base58) \u2014 caller is sole custodian",
    "type": "string"
   }
  },
  "required": [
   "publicKey",
   "secretKey",
   "attempts",
   "ms"
  ],
  "type": "object"
 },
 "title": "Vanity Mint Keypair"
}
