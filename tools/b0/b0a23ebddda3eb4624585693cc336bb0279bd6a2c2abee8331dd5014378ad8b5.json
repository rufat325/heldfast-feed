{
 "description": "Replies to an existing message in a mailbox thread.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "format": "starts_with",
    "pattern": "^amk_.*",
    "type": "string"
   },
   "html": {
    "type": "string"
   },
   "mailboxId": {
    "minLength": 1,
    "type": "string"
   },
   "messageId": {
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "mailboxId",
   "messageId"
  ],
  "type": "object"
 },
 "name": "assistantmail_reply_message"
}
