{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create AI-powered presentations, documents, webpages, or social posts with Gamma. ASYNC WORKFLOW: 1) Call gamma_generate \u2192 returns generation_id. 2) Call gamma_get_status(generation_id) repeatedly every 3-5 seconds. 3) Continue polling until status is \"completed\" or \"failed\". THEMES: First call gamma_list_themes, then pass theme_id. EXPORT: Set export_as to \"pdf\" or \"pptx\" for auto-export on completion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "additional_instructions": {
    "description": "Extra instructions for generation (max 2000 chars)",
    "type": "string"
   },
   "card_dimensions": {
    "description": "Card aspect ratio",
    "enum": [
     "fluid",
     "16x9",
     "4x3",
     "pageless",
     "letter",
     "a4",
     "1x1",
     "4x5",
     "9x16"
    ],
    "type": "string"
   },
   "card_split": {
    "description": "How to divide cards",
    "enum": [
     "auto",
     "inputTextBreaks"
    ],
    "type": "string"
   },
   "export_as": {
    "description": "Auto-export format when generation completes",
    "enum": [
     "pdf",
     "pptx"
    ],
    "type": "string"
   },
   "external_access": {
    "description": "Access level for external viewers",
    "enum": [
     "noAccess",
     "view",
     "comment",
     "edit"
    ],
    "type": "string"
   },
   "folder_ids": {
    "description": "Folder IDs to save to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "format": {
    "description": "Content type (default: presentation)",
    "enum": [
     "presentation",
     "document",
     "webpage",
     "social"
    ],
    "type": "string"
   },
   "image_model": {
    "description": "AI image model",
    "type": "string"
   },
   "image_source": {
    "description": "Image source",
    "enum": [
     "aiGenerated",
     "pictographic",
     "unsplash",
     "giphy",
     "webAllImages",
     "webFreeToUse",
     "webFreeToUseCommercially",
     "placeholder",
     "noImages"
    ],
    "type": "string"
   },
   "image_style": {
    "description": "Image style",
    "type": "string"
   },
   "input_text": {
    "description": "The text content to generate from",
    "minLength": 1,
    "type": "string"
   },
   "num_cards": {
    "description": "Number of slides/cards (1-75)",
    "maximum": 75,
    "minimum": 1,
    "type": "integer"
   },
   "text_amount": {
    "description": "How much text per card",
    "enum": [
     "brief",
     "medium",
     "detailed",
     "extensive"
    ],
    "type": "string"
   },
   "text_audience": {
    "description": "Target audience",
    "type": "string"
   },
   "text_language": {
    "description": "Output language code",
    "type": "string"
   },
   "text_mode": {
    "description": "generate: expand, condense: summarize, preserve: keep exact text",
    "enum": [
     "generate",
     "condense",
     "preserve"
    ],
    "type": "string"
   },
   "text_tone": {
    "description": "Tone/voice",
    "type": "string"
   },
   "theme_id": {
    "description": "Theme ID from gamma_list_themes",
    "type": "string"
   },
   "workspace_access": {
    "description": "Access level for workspace members",
    "enum": [
     "noAccess",
     "view",
     "comment",
     "edit",
     "fullAccess"
    ],
    "type": "string"
   }
  },
  "required": [
   "input_text"
  ],
  "type": "object"
 },
 "name": "gamma_generate"
}
