{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Toys Hub's catalogue by words, category, age and price. Returns name, price, availability, photo, product page and a buy-now link for each match.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "age": {
    "description": "Child's age in years; returns products suitable for that age.",
    "maximum": 18,
    "minimum": 0,
    "type": "integer"
   },
   "category": {
    "description": "Category slug from list_categories.",
    "type": "string"
   },
   "in_stock_only": {
    "default": false,
    "type": "boolean"
   },
   "lang": {
    "default": "en",
    "description": "Language of names, descriptions and links: \"sq\" Albanian, \"en\" English.",
    "enum": [
     "sq",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_price": {
    "description": "Highest price, in the store currency.",
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Words to look for in names and descriptions (Albanian or English). Empty lists popular products.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "properties": {
   "products": {
    "items": {
     "properties": {
      "ageRange": {
       "type": [
        "string",
        "null"
       ]
      },
      "availability": {
       "type": "string"
      },
      "buyUrl": {
       "type": "string"
      },
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "currency": {
       "type": "string"
      },
      "image": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "price": {
       "type": "number"
      },
      "slug": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "resultCount": {
    "type": "integer"
   }
  },
  "required": [
   "resultCount",
   "products"
  ],
  "type": "object"
 },
 "title": "Search products"
}
