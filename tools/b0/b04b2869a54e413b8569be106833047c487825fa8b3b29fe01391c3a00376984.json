{
 "description": "Run CHP Profile B capital/spend gate on a proposed action. Returns LOCKED, HITL_REQUIRED, or BLOCKED with claims and a content hash. Hard policy violations cannot be overridden by a human.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": false,
    "description": "Proposed trade / spend / mandate action",
    "properties": {
     "action": {
      "type": "string"
     },
     "asset": {
      "type": "string"
     },
     "confidence": {
      "type": [
       "number",
       "null"
      ]
     },
     "notional": {
      "type": "number"
     },
     "rationale": {
      "type": "string"
     }
    },
    "required": [
     "action",
     "asset",
     "notional"
    ],
    "type": "object"
   },
   "committed_today": {
    "description": "Notional already committed today toward daily_cap (default 0)",
    "type": "number"
   },
   "policy": {
    "additionalProperties": false,
    "description": "Gate policy (limits, HITL threshold, confidence floor)",
    "properties": {
     "allowed_actions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "daily_cap": {
      "type": "number"
     },
     "hitl_threshold": {
      "type": "number"
     },
     "max_notional": {
      "type": "number"
     },
     "min_confidence": {
      "type": "number"
     },
     "per_asset_limits": {
      "additionalProperties": {
       "type": "number"
      },
      "type": "object"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "max_notional",
     "daily_cap",
     "hitl_threshold",
     "min_confidence"
    ],
    "type": "object"
   }
  },
  "required": [
   "action",
   "policy"
  ],
  "type": "object"
 },
 "name": "evaluate_spend_gate"
}
