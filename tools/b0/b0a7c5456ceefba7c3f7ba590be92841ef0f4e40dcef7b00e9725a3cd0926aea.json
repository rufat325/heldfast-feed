  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Manager Portfolio"
 },
 "description": "Returns a 13F filer's full portfolio at a specific period_end (latest by default), with QoQ deltas vs the prior quarter (new / increased / decreased / exited / unchanged).  Specify the filer either by filer_cik (preferred) or filer_name (fuzzy match against entity.name; multiple matches raise an ambiguity error so you can disambiguate by CIK).  Institutional tier only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "as_of_date": {
    "description": "Point-in-time cutoff (YYYY-MM-DD): only 13F filings ACCEPTED by SEC on or before this date are considered, applied BEFORE the latest + prior periods (and the QoQ basis) are resolved. A 13F/A amendment or late filing accepted after this date is excluded (zero look-ahead). Omit for the latest knowable portfolio.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "filer_cik": {
    "description": "CIK of the 13F filer (1-10 digits; will be zero-padded to 10).  Preferred over filer_name when known.",
    "pattern": "^\\d{1,10}$",
    "type": "string"
   },
   "filer_name": {
    "description": "Filer name to fuzzy-match against entity.name.  Case-insensitive substring match.  Multiple matches raise INVALID_ARGUMENT \u2014 use filer_cik in that case.",
    "maxLength": 120,
    "minLength": 2,
    "type": "string"
   },
   "lineage_detail": {
    "default": "compact",
    "description": "Per-row provenance envelope.",
    "enum": [
     "off",
     "compact",
     "full"
    ],
    "type": "string"
   },
   "period_end": {
    "description": "Quarter-end (YYYY-MM-DD).  Omit to use latest available.  This is a REPORTING period, NOT a point-in-time cutoff \u2014 use as_of_date for that.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "top_n": {
    "default": 25,
    "description": "Maximum positions to return, ranked by market_value_usd. Default 25.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_manager_portfolio",
