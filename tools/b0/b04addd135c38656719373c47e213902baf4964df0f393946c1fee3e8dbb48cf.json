{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when an agent task needs a missing fact, resource, owner decision, outside commitment, specialist contribution, connection fix or artifact correction. Provide a sanitized task, exact missing piece and acceptance check. Returns rule-based recovery steps and a qualified brief. It does not save private work, contact anyone, assign a worker or grant authority.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "acceptance_check": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   },
   "attempted": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   },
   "blocker": {
    "enum": [
     "missing_fact",
     "missing_resource",
     "missing_authority",
     "external_commitment",
     "specialist_contribution",
     "compatibility",
     "missing_capability",
     "quality"
    ],
    "type": "string"
   },
   "constraints": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   },
   "missing_contribution": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   },
   "needed_from": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "next_action": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   },
   "task": {
    "maxLength": 1200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "task",
   "blocker",
   "missing_contribution",
   "needed_from",
   "acceptance_check",
   "attempted",
   "constraints",
   "next_action"
  ],
  "type": "object"
 },
 "name": "plan_blocker",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "brief": {
    "type": "string"
   },
   "recovery_steps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "const": "plan_only",
    "type": "string"
   }
  },
  "required": [
   "status",
   "brief",
   "recovery_steps"
  ],
  "type": "object"
 },
 "title": "Plan recovery for a blocked agent task"
}
