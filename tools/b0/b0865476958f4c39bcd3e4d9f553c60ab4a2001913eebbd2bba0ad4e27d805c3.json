{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Funding statistics per time bucket for a Hyperliquid perp: average, minimum, maximum and annualized rate.",
 "inputSchema": {
  "properties": {
   "interval": {
    "description": "Time interval (1h, 4h, 8h, 1d, 7d). Default: 1d",
    "enum": [
     "1h",
     "4h",
     "8h",
     "1d",
     "7d"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Number of data points (default 7)",
    "type": "number"
   },
   "market": {
    "description": "Market symbol \u2014 native HL perp (e.g. \"BTC-PERP\") or HIP-3 builder market \"<issuer>:<base>-PERP\" (e.g. \"flx:GAS-PERP\")",
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "get_funding_stats",
 "outputSchema": {
  "description": "Funding statistics per time bucket",
  "properties": {
   "data": {
    "description": "Buckets",
    "items": {
     "description": "One bucket",
     "properties": {
      "avg_rate": {
       "description": "Average hourly rate"
      },
      "bucket": {
       "description": "Bucket start, Unix milliseconds"
      },
      "cumulative_rate": {
       "description": "Sum of hourly rates in the bucket"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "max_rate": {
       "description": "Highest hourly rate"
      },
      "min_rate": {
       "description": "Lowest hourly rate"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 }
}
