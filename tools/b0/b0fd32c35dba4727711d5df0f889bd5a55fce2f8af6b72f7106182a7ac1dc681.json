  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addresses": {
    "description": "array \u2014 2 to 400 wallets, 0x form.",
    "items": {},
    "type": "array"
   },
   "from_block": {
    "description": "optional int \u2014 the block to start from; default the whole history. If the line runs out mid-scan you get what was scanned so far, marked partial; continue with to_block.",
    "type": "number"
   },
   "line": {
    "description": "optional \u2014 a line credential: the call burns the line's time and carries no payment.",
    "type": "string"
   },
   "to_block": {
    "description": "optional int \u2014 stop; default the head.",
    "type": "number"
   },
   "token": {
    "description": "optional string \u2014 the asset to follow, 0x form; default USDC.",
    "type": "string"
   },
   "window": {
    "description": "optional int \u2014 blocks per snapshot, default 10000; smaller gives a short line its first snapshot sooner.",
    "type": "number"
   }
  },
  "required": [
   "addresses"
  ],
  "type": "object"
 },
