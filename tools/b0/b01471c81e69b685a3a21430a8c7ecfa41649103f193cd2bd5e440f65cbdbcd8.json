{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get property map image"
 },
 "description": "Get a static map image of a tokenized property showing its parcel boundary (or a pin marker if no boundary is available). Returns an inline image. Supports dark/light themes and custom dimensions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "height": {
    "description": "Image height in pixels (100-1280, default 640)",
    "maximum": 1280,
    "minimum": 100,
    "type": "integer"
   },
   "slug": {
    "description": "Property slug from the URL",
    "type": "string"
   },
   "theme": {
    "description": "Map theme (default: 'dark')",
    "enum": [
     "dark",
     "light"
    ],
    "type": "string"
   },
   "tokenId": {
    "description": "The token ID of the property",
    "type": "string"
   },
   "width": {
    "description": "Image width in pixels (100-1280, default 640)",
    "maximum": 1280,
    "minimum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_property_image",
 "title": "Get property map image"
}
