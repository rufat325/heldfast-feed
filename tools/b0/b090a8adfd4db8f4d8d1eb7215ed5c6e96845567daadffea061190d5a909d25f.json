{
 "description": "Ingest (upsert) a batch of products into the BuyWhere catalog. Use this to add or update product listings from any merchant/source. Requires a valid API key with ingest permissions. Accepts up to 1000 products per call with source, SKU, title, price, URL, and optional metadata.",
 "inputSchema": {
  "properties": {
   "products": {
    "description": "Array of product objects to ingest (max 1000)",
    "items": {
     "properties": {
      "brand": {
       "description": "Brand name",
       "type": "string"
      },
      "category": {
       "description": "Product category",
       "type": "string"
      },
      "country_code": {
       "description": "ISO country code (e.g. \"SG\", \"US\")",
       "type": "string"
      },
      "currency": {
       "default": "SGD",
       "description": "Currency code (default: SGD)",
       "type": "string"
      },
      "description": {
       "description": "Product description",
       "type": "string"
      },
      "image_url": {
       "description": "Main product image URL",
       "type": "string"
      },
      "is_active": {
       "description": "Whether the product is active (default: true)",
       "type": "boolean"
      },
      "is_available": {
       "description": "Whether the product is in stock",
       "type": "boolean"
      },
      "merchant_id": {
       "description": "Merchant identifier",
       "type": "string"
      },
      "metadata": {
       "description": "Additional product metadata",
       "type": "object"
      },
      "price": {
       "description": "Current price (must be >= 0)",
       "type": "number"
      },
      "region": {
       "description": "Region identifier (e.g. \"sea\", \"us\")",
       "type": "string"
      },
      "sku": {
       "description": "Unique stock keeping unit identifier",
       "type": "string"
      },
      "title": {
       "description": "Product title",
       "type": "string"
      },
      "url": {
       "description": "Product URL on the merchant site",
       "type": "string"
      }
     },
     "required": [
      "sku",
      "merchant_id",
      "title",
      "price",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "description": "Data source identifier (e.g. \"shopee_sg\", \"amazon_sg\", \"lazada_sg\")",
    "type": "string"
   }
  },
  "required": [
   "source",
   "products"
  ],
  "type": "object"
 },
 "name": "ingest_products"
}
