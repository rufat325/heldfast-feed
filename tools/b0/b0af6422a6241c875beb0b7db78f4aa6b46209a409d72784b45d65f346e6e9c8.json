 },
 "description": "Provider incidents (outages, degradations), open ones first. Filter by state and provider.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "provider": {
    "description": "Provider slug, e.g. \"bright-data\". See list_providers.",
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "state": {
    "description": "Default \"all\".",
    "enum": [
     "open",
     "resolved",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_incidents",
 "title": "List incidents"
}
