{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Turn a list of colors into ready code: CSS custom properties, a Tailwind v4 @theme block, SCSS variables, JSON, W3C design tokens (DTCG), a JavaScript array or an SVG swatch strip. Unnamed colors get their closest color name.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "colors": {
    "items": {
     "properties": {
      "color": {
       "description": "Any color: #ff5733, rgb(255 87 51), hsl(11 100% 60%), oklch(68% 0.21 34), a CSS or common name like navy, or a Tailwind class like sky-500",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "description": "Token name",
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "color"
     ],
     "type": "object"
    },
    "maxItems": 24,
    "minItems": 1,
    "type": "array"
   },
   "format": {
    "default": "css",
    "enum": [
     "css",
     "tailwind",
     "scss",
     "json",
     "dtcg",
     "array",
     "svg"
    ],
    "type": "string"
   },
   "values": {
    "default": "oklch",
    "description": "How color values are written",
    "enum": [
     "oklch",
     "hex",
     "rgb",
     "hsl",
     "display-p3"
    ],
    "type": "string"
   }
  },
  "required": [
   "colors"
  ],
  "type": "object"
 },
 "name": "export_tokens",
 "title": "Export colors as code"
}
