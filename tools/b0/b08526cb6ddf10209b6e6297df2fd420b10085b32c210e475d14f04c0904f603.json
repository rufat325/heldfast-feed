{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Maintain structured belief state with TTL expiration sweeps, exponential confidence decay, and category filtering (actions: update, query, expire, reconcile). Use manage_beliefs instead of query_knowledge when managing dynamic agent epistemic state rather than static heuristic patterns.\n\nReturns belief record, query matches, expired belief count, or reconciliation report.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Belief operation: update, query, expire, reconcile",
    "enum": [
     "update",
     "query",
     "expire",
     "reconcile"
    ],
    "type": "string"
   },
   "belief_id": {
    "description": "Belief ID for specific lookup",
    "type": "string"
   },
   "category": {
    "description": "Belief category",
    "enum": [
     "spatial",
     "entity",
     "state",
     "rule",
     "social"
    ],
    "type": "string"
   },
   "client_request_id": {
    "description": "Idempotency key",
    "type": "string"
   },
   "confidence": {
    "description": "Confidence score (0.0 to 1.0)",
    "type": "number"
   },
   "decay_rate": {
    "description": "Exponential decay rate lambda per hour",
    "type": "number"
   },
   "expires_at": {
    "description": "ISO-8601 expiration timestamp",
    "type": "string"
   },
   "object": {
    "description": "Belief value / state payload"
   },
   "predicate": {
    "description": "Predicate relationship (e.g. \"is_locked\", \"status\")",
    "type": "string"
   },
   "project": {
    "description": "Target project slug",
    "type": "string"
   },
   "source": {
    "description": "Belief provenance source",
    "enum": [
     "observation",
     "deduction",
     "agent_communication",
     "a_priori"
    ],
    "type": "string"
   },
   "subject": {
    "description": "Belief subject (e.g. \"north_gate\", \"enemy_patrol\")",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_beliefs"
}
