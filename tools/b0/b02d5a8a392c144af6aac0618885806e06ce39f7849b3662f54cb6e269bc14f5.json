{
 "description": "Export a bounded page of masked LMS assignment reporting in CSV, JSON, or JSONL, including mastery run-budget columns. CSV/JSONL are spreadsheet-neutralized. Requires lms:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "enum": [
     "csv",
     "json",
     "jsonl"
    ],
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "jobId",
   "format"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_export_assignments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
