{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search call history"
 },
 "description": "Finds phone calls on this Widely seat by date range, direction, contact name, or number. Returns one row per phone call, with direction, duration, outcome, the identity used, and whether a transcript or recording exists.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contact": {
    "description": "Saved contact name to match.",
    "type": "string"
   },
   "days": {
    "description": "Look back this many days (default 30).",
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   },
   "direction": {
    "enum": [
     "inbound",
     "outbound"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max rows to return.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "line": {
    "enum": [
     "sip_extension",
     "business_number",
     "trunk"
    ],
    "type": "string"
   },
   "missed_only": {
    "type": "boolean"
   },
   "number": {
    "description": "Phone number or trailing digits.",
    "type": "string"
   },
   "query": {
    "description": "Words from a stored transcript. Pro.",
    "type": "string"
   },
   "since": {
    "description": "ISO 8601 start (inclusive).",
    "type": "string"
   },
   "until": {
    "description": "ISO 8601 end (exclusive).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_calls",
 "title": "Search call history"
}
