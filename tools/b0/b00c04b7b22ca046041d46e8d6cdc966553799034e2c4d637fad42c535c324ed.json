{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add a firewall rule"
 },
 "description": "Opens a port range (tcp/udp) or icmp on a ready server, from a source CIDR (default 0.0.0.0/0). Ports: single \"8080\" or range with portRangeMin/portRangeMax. (permission: firewall:write) [Requires a free GPU Cloud account and MCP key]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "direction": {
    "default": "ingress",
    "enum": [
     "ingress",
     "egress"
    ],
    "type": "string"
   },
   "ethertype": {
    "default": "IPv4",
    "enum": [
     "IPv4",
     "IPv6"
    ],
    "type": "string"
   },
   "portRangeMax": {
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "portRangeMin": {
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "protocol": {
    "enum": [
     "tcp",
     "udp",
     "icmp"
    ],
    "type": "string"
   },
   "remoteIpPrefix": {
    "description": "Source CIDR, e.g. 203.0.113.0/24 (default: anywhere).",
    "maxLength": 64,
    "type": "string"
   },
   "serverId": {
    "description": "Server id (from gpucloud_list_servers).",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "serverId",
   "protocol"
  ],
  "type": "object"
 },
 "name": "gpucloud_add_firewall_rule",
 "title": "Add a firewall rule"
}
