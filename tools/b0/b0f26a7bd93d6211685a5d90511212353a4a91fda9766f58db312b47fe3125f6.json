{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "category": "integrations",
 "description": "Fetch a complete Jira issue: summary, description converted to Markdown, status, assignee, priority, labels, custom fields, and optionally comments and attachment metadata. BYOK \u2014 credentials transit in-memory only, never stored on ia-qa.com.",
 "inputSchema": {
  "properties": {
   "fields": {
    "description": "Specific Jira field names to return. Omit for all standard fields.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "include_attachments": {
    "description": "Include attachment metadata list (default: false)",
    "type": "boolean"
   },
   "include_comments": {
    "description": "Include issue comments, up to 20 (default: true)",
    "type": "boolean"
   },
   "issue_key": {
    "description": "Jira issue key, e.g. \"PROJ-123\"",
    "type": "string"
   },
   "jira_base_url": {
    "description": "Atlassian base URL, e.g. \"https://mycompany.atlassian.net\"",
    "type": "string"
   },
   "jira_email": {
    "description": "Atlassian account email",
    "type": "string"
   },
   "jira_token": {
    "description": "Atlassian API token (from id.atlassian.com > Security > API tokens)",
    "type": "string"
   }
  },
  "required": [
   "issue_key",
   "jira_base_url",
   "jira_email",
   "jira_token"
  ],
  "type": "object"
 },
 "name": "fetch_jira_issue",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "assignee": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "key": {
    "type": "string"
   },
   "labels": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "priority": {
    "type": "string"
   },
   "reporter": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "type": {
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
