{
 "description": "Publish a carousel (album) post with 2-10 images or videos. All media must be publicly accessible URLs.",
 "inputSchema": {
  "properties": {
   "caption": {
    "description": "Caption for the carousel post (optional)",
    "type": "string"
   },
   "image_urls": {
    "description": "List of 2-10 image/video URLs",
    "items": {
     "format": "uri",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "image_urls"
  ],
  "type": "object"
 },
 "name": "publish_carousel"
}
