{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all automation programs. Use execute_program to trigger them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Filter by program name (substring, case-insensitive)",
    "type": "string"
   },
   "target": {
    "description": "CCU target to read from (default: active). See list_ccu_targets.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_programs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "programs": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "programs"
  ],
  "type": "object"
 },
 "title": "List Programs"
}
