{
 "description": "[skiplagged] Search Skiplagged for rental cars between pickup and dropoff locations/dates, returning prices, companies, and car details.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dropoffDate": {
    "$ref": "#/properties/pickupDate",
    "description": "Dropoff date (YYYY-MM-DD)"
   },
   "dropoffLocation": {
    "$ref": "#/properties/pickupLocation",
    "description": "Dropoff city or airport code (defaults to pickup)"
   },
   "dropoffTime": {
    "$ref": "#/properties/pickupTime",
    "default": "10:00",
    "description": "Dropoff time (HH:mm or HH:mm:ss, default 10:00)"
   },
   "limit": {
    "default": 12,
    "description": "Maximum number of car offers to return",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of car offers to skip for pagination (default: 0)",
    "maximum": 99,
    "minimum": 0,
    "type": "integer"
   },
   "pickupDate": {
    "description": "Pickup date (YYYY-MM-DD)",
    "type": "string"
   },
   "pickupLocation": {
    "description": "Pickup city or airport code",
    "minLength": 1,
    "type": "string"
   },
   "pickupTime": {
    "default": "10:00",
    "description": "Pickup time (HH:mm or HH:mm:ss, default 10:00)",
    "pattern": "^\\d{2}:\\d{2}(?::\\d{2})?$",
    "type": "string"
   }
  },
  "required": [
   "pickupLocation",
   "pickupDate",
   "dropoffDate"
  ],
  "type": "object"
 },
 "name": "skiplagged_sk_cars_search"
}
