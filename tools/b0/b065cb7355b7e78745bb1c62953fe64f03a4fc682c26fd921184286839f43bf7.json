{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Deploy every service of an environment in role order \u2014 database, cache, worker, web \u2014 each stage starting only after the previous one reports a healthy start (disable with require_healthy_start=false). Each stage is a normal smart-replace deploy: project/environment variable groups resolve and the environment's database wiring applies. Returns a batch_id to watch with impreza_get_environment_deploy. A failed stage fails the batch; earlier stages stay deployed. Requires unrestricted account credentials and deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "environment_id": {
    "pattern": "^env_[a-f0-9]{24}$",
    "type": "string"
   },
   "require_healthy_start": {
    "description": "Gate each stage on a healthy start of the previous one (default true).",
    "type": "boolean"
   }
  },
  "required": [
   "environment_id"
  ],
  "type": "object"
 },
 "name": "impreza_deploy_environment",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "batch_id": {
      "type": "string"
     },
     "created_at": {
      "type": "string"
     },
     "cursor": {
      "type": "integer"
     },
     "environment_id": {
      "type": "string"
     },
     "error": {
      "type": [
       "string",
       "null"
      ]
     },
     "finished_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "note": {
      "type": "string"
     },
     "project_id": {
      "type": "string"
     },
     "replayed": {
      "type": "boolean"
     },
     "require_healthy": {
      "type": "boolean"
     },
     "stages": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "command_id": {
         "type": [
          "string",
          "null"
         ]
        },
        "component": {
         "type": "string"
        },
        "deployment_id": {
         "type": "string"
        },
        "role": {
         "type": "string"
        },
        "startup_gate": {
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "component",
        "role",
        "deployment_id",
        "status",
        "command_id",
        "startup_gate"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "batch_id",
     "environment_id",
     "project_id",
     "status",
     "require_healthy",
     "cursor",
     "stages",
     "error",
     "created_at",
     "finished_at",
     "note",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Deploy environment"
}
