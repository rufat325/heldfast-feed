{
 "annotations": {},
 "description": "Set the access control list (ACL) of an Object Storage bucket using a canned ACL",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "acl": {
    "description": "Canned ACL to apply (private, public-read, public-read-write, authenticated-read)",
    "enum": [
     "private",
     "public-read",
     "public-read-write",
     "authenticated-read"
    ],
    "type": "string"
   },
   "bucketName": {
    "description": "Name of the bucket",
    "type": "string"
   }
  },
  "required": [
   "bucketName",
   "acl"
  ],
  "type": "object"
 },
 "name": "ncloud_put_bucket_acl"
}
