{
 "description": "Update an existing user. Only the given fields change. Use mcp_change_user_role for the role.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Biographical info, plain text",
    "type": "string"
   },
   "display_name": {
    "description": "Public display name",
    "type": "string"
   },
   "email": {
    "description": "Email address (must not belong to another user)",
    "format": "email",
    "type": "string"
   },
   "first_name": {
    "description": "First name",
    "type": "string"
   },
   "id": {
    "description": "User ID",
    "type": "integer"
   },
   "last_name": {
    "description": "Last name",
    "type": "string"
   },
   "password": {
    "description": "Write-only new password, never echoed",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "url": {
    "description": "Website URL",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "mcp_update_user"
}
