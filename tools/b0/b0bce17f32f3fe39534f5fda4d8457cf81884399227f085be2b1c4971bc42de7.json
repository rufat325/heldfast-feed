{
 "description": "Search merchant product catalog. Supports text query, category filters, price range, and sorting.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category filter",
    "type": "string"
   },
   "currency": {
    "description": "Currency code (default: USD)",
    "type": "string"
   },
   "maxPrice": {
    "description": "Maximum price",
    "type": "number"
   },
   "merchantId": {
    "description": "Merchant ID (uses default if omitted)",
    "type": "string"
   },
   "minPrice": {
    "description": "Minimum price",
    "type": "number"
   },
   "pageSize": {
    "description": "Results per page",
    "type": "number"
   },
   "pageToken": {
    "description": "Pagination token",
    "type": "string"
   },
   "query": {
    "description": "Search query (e.g. 'wireless headphones')",
    "type": "string"
   },
   "sortBy": {
    "description": "Sort order",
    "enum": [
     "relevance",
     "price_asc",
     "price_desc",
     "rating",
     "newest"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products"
}
