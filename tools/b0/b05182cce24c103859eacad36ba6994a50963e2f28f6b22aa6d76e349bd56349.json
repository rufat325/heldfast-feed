{
 "_meta": {
  "toolset": "entity"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Entity"
 },
 "description": "Update the position, appearance, label, or visibility of an entity. Returns { success: boolean, data?: unknown, message?: string, error?: string }.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "color": {
    "description": "New color (CSS format)",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "entityId": {
    "description": "Entity ID (returned by addMarker/addPolyline etc.)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "label": {
    "description": "New label text",
    "maxLength": 200,
    "type": "string"
   },
   "position": {
    "additionalProperties": false,
    "description": "New position coordinates",
    "properties": {
     "height": {
      "maximum": 50000000,
      "minimum": -12000,
      "type": "number"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "longitude",
     "latitude"
    ],
    "type": "object"
   },
   "scale": {
    "description": "New scale factor",
    "maximum": 100000,
    "minimum": 0,
    "type": "number"
   },
   "sessionId": {
    "description": "Target browser session ID for multi-browser routing (optional)",
    "type": "string"
   },
   "show": {
    "description": "Whether to show",
    "type": "boolean"
   }
  },
  "required": [
   "entityId"
  ],
  "type": "object"
 },
 "name": "updateEntity",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {},
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
