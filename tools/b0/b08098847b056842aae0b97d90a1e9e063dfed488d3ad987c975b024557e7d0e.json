{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List Datadog teams with optional search filtering and pagination",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filterKeyword": {
    "description": "Search keyword to filter teams by name or handle",
    "type": "string"
   },
   "pageNumber": {
    "default": 0,
    "description": "Page number (0-based)",
    "type": "number"
   },
   "pageSize": {
    "default": 25,
    "description": "Number of results per page (default 25, max 100)",
    "type": "number"
   },
   "sort": {
    "default": "name",
    "description": "Sort order",
    "enum": [
     "name",
     "-name",
     "user_count",
     "-user_count"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list-teams"
}
