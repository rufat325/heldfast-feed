{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists Docker images with structured repository, tag, size, and creation info.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all": {
    "default": false,
    "description": "Show all images including intermediates",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "digests": {
    "default": false,
    "description": "Show image digests (default: false)",
    "type": "boolean"
   },
   "filterExpr": {
    "description": "Key-value filter expression (--filter). Examples: 'dangling=true', 'reference=myimage:*', 'before=image:tag', 'since=image:tag', 'label=com.example.version'",
    "maxLength": 255,
    "type": "string"
   },
   "noTrunc": {
    "default": false,
    "description": "Do not truncate image IDs (default: false)",
    "type": "boolean"
   },
   "reference": {
    "description": "Filter by image reference (positional arg, e.g., 'myapp', 'nginx:*'). This is a positional reference filter, not Docker's --filter flag.",
    "maxLength": 255,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "images",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "images": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created": {
       "type": "string"
      },
      "createdAt": {
       "type": "string"
      },
      "digest": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "labels": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "repository": {
       "type": "string"
      },
      "size": {
       "type": "string"
      },
      "sizeBytes": {
       "type": "number"
      },
      "tag": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "repository",
      "tag",
      "size"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "images"
  ],
  "type": "object"
 },
 "title": "Docker Images"
}
