{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate Honolulu County military income (base pay, BAH, BAS, COLA) and a VA purchase price from pay grade, years of service, and dependents. Uses the RealityCents 2026 pay tables. Read-only. Do not send a name or SSN.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dependents": {
    "default": 0,
    "description": "Dependent count. More than zero uses the with-dependents BAH rate. COLA uses this count.",
    "maximum": 12,
    "minimum": 0,
    "type": "integer"
   },
   "downPayment": {
    "default": 0,
    "description": "Down payment in dollars. Default $0.",
    "minimum": 0,
    "type": "number"
   },
   "hoaMonthly": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "insuranceMonthly": {
    "default": 150,
    "minimum": 0,
    "type": "number"
   },
   "maxDti": {
    "default": 55,
    "description": "Planning DTI used by the RealityCents Military Buying Power calculator. Not a VA approval cap.",
    "maximum": 65,
    "minimum": 1,
    "type": "number"
   },
   "monthlyTaxOverride": {
    "minimum": 0,
    "type": "number"
   },
   "otherDebts": {
    "default": 0,
    "description": "Other monthly debt payments.",
    "minimum": 0,
    "type": "number"
   },
   "payGrade": {
    "description": "Military pay grade. BAH is Honolulu County (HI408) 2026.",
    "enum": [
     "E-1",
     "E-2",
     "E-3",
     "E-4",
     "E-5",
     "E-6",
     "E-7",
     "E-8",
     "E-9",
     "W-1",
     "W-2",
     "W-3",
     "W-4",
     "W-5",
     "O-1E",
     "O-2E",
     "O-3E",
     "O-1",
     "O-2",
     "O-3",
     "O-4",
     "O-5",
     "O-6",
     "O-7",
     "O-8",
     "O-9",
     "O-10"
    ],
    "type": "string"
   },
   "propertyTaxRatePercent": {
    "default": 0.35,
    "maximum": 5,
    "minimum": 0,
    "type": "number"
   },
   "rate": {
    "default": 6.5,
    "description": "Example annual rate passed into the site purchase-power solver. Not a quote.",
    "maximum": 25,
    "minimum": 0,
    "type": "number"
   },
   "vaDisabilityExempt": {
    "default": false,
    "type": "boolean"
   },
   "vaFirstUse": {
    "default": true,
    "type": "boolean"
   },
   "yearsOfService": {
    "default": 0,
    "maximum": 40,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "payGrade"
  ],
  "type": "object"
 },
 "name": "va_purchase_power",
 "title": "VA purchase power"
}
