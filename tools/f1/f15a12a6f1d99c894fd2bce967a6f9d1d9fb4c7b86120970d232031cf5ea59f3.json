  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add existing artist photo"
 },
 "description": "Adds a customer photograph to Artist DNA through screened identity-reference services. Inline input accepts canonical base64, MIME type and angle up to 512 KiB. Larger files have dedicated upload/app paths. Validates and deduplicates bytes under existing face-source/publication rules. Returns pack and created flag. No image generation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "angle": {
    "description": "Camera angle shown in this existing photo.",
    "enum": [
     "front",
     "three_quarter_left",
     "three_quarter_right",
     "smiling",
     "left",
     "right",
     "full_body",
     "detail"
    ],
    "type": "string"
   },
   "artistId": {
    "description": "Artist ID returned by studio_artists_list or studio_artist_read. Also identifies this artist when casting a Film.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "bytesBase64": {
    "description": "Canonical base64 file bytes without a data URL prefix, up to 512 KiB decoded. Larger files have an app upload-link path.",
    "maxLength": 699052,
    "minLength": 4,
    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
    "type": "string"
   },
   "mimeType": {
    "description": "Actual photo MIME type; the app also checks bytes.",
    "enum": [
     "image/png",
     "image/jpeg",
     "image/webp"
    ],
    "type": "string"
   }
  },
  "required": [
   "artistId",
   "angle",
   "mimeType",
   "bytesBase64"
  ],
  "type": "object"
 },
 "name": "studio_artist_reference_add",
