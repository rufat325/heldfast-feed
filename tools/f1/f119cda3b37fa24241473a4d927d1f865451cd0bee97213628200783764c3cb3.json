{
 "description": "Create a subscription offer code (custom or one-time-use codes distributed outside the App Store). Requires per-territory prices \u2014 look them up first with apple_get_subscription_price_points.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoRenewEnabled": {
    "description": "Whether the subscription auto-renews after the offer period",
    "type": "boolean"
   },
   "customerEligibilities": {
    "description": "Which customers are eligible",
    "items": {
     "enum": [
      "NEW",
      "EXISTING",
      "EXPIRED"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "duration": {
    "description": "Billing period duration of the offer",
    "enum": [
     "THREE_DAYS",
     "ONE_WEEK",
     "TWO_WEEKS",
     "ONE_MONTH",
     "TWO_MONTHS",
     "THREE_MONTHS",
     "SIX_MONTHS",
     "ONE_YEAR"
    ],
    "type": "string"
   },
   "name": {
    "description": "Internal reference name for the offer code",
    "type": "string"
   },
   "numberOfPeriods": {
    "description": "Number of billing periods the offer applies for",
    "type": "number"
   },
   "offerEligibility": {
    "description": "How this offer interacts with introductory offers",
    "enum": [
     "STACK_WITH_INTRO_OFFERS",
     "REPLACE_INTRO_OFFERS"
    ],
    "type": "string"
   },
   "offerMode": {
    "description": "Offer pricing mode",
    "enum": [
     "PAY_AS_YOU_GO",
     "PAY_UP_FRONT",
     "FREE_TRIAL"
    ],
    "type": "string"
   },
   "prices": {
    "description": "Per-territory prices for the offer",
    "items": {
     "additionalProperties": false,
     "properties": {
      "pricePointId": {
       "description": "Price point ID from apple_get_subscription_price_points / apple_get_iap_price_points",
       "type": "string"
      },
      "territoryId": {
       "description": "Territory ID, e.g. USA",
       "type": "string"
      }
     },
     "required": [
      "territoryId",
      "pricePointId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "subscriptionId": {
    "description": "Subscription ID",
    "type": "string"
   }
  },
  "required": [
   "subscriptionId",
   "name",
   "customerEligibilities",
   "offerEligibility",
   "duration",
   "offerMode",
   "numberOfPeriods",
   "prices"
  ],
  "type": "object"
 },
 "name": "apple_create_subscription_offer_code"
}
