 "description": "Look up one congressional bill from congress.gov (the Library of Congress's official API) by its real-world identifier \u2014 congress number, bill type and bill number, e.g. the 118th Congress H.R. 1. Returns title, sponsor, current status (congress.gov's free-text `latestAction`) with its date, introduced date, whether/which law it became, and the congress.gov link. Does NOT return bill text, cosponsors, committee assignments or vote history. Requires an API key: a free api.data.gov key works \u2014 supplied automatically when called through the Pipeworx gateway.",
 "inputSchema": {
  "examples": [
   {
    "bill_type": "house_bill",
    "congress": 118,
    "number": 1
   }
  ],
  "properties": {
   "bill_type": {
    "description": "Bill type: hr, s, hres, sres, hjres, sjres, hconres or sconres (congress.gov's own short codes). The long GovTrack-era forms (house_bill, senate_bill, ...) and 'h.r.' are also accepted.",
    "type": "string"
   },
   "congress": {
    "description": "Congress number, e.g. 118",
    "type": "number"
   },
   "number": {
    "description": "Bill number within that congress, e.g. 1 for H.R. 1",
    "type": "number"
   }
  },
  "required": [
   "congress",
   "bill_type",
   "number"
  ],
  "type": "object"
 },
 "name": "get_bill",
