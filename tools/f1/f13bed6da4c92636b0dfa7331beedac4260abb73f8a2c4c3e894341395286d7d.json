{
 "description": "Calculate indicator values for a given symbol. Fetches candles and computes the indicator.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exchange": {
    "description": "Exchange name (binance, bybit, okx)",
    "type": "string"
   },
   "indicator_id": {
    "description": "Indicator ID (e.g., rsi, macd, bollinger_bands)",
    "type": "string"
   },
   "limit": {
    "default": 200,
    "description": "Number of candles to use for calculation",
    "type": "number"
   },
   "params": {
    "additionalProperties": {},
    "default": {},
    "description": "Indicator parameters (e.g., { period: 14 })",
    "type": "object"
   },
   "symbol": {
    "description": "Trading pair symbol (e.g., BTCUSDT)",
    "type": "string"
   },
   "timeframe": {
    "description": "Candle timeframe (1m, 5m, 15m, 1h, 4h, 1d)",
    "type": "string"
   }
  },
  "required": [
   "indicator_id",
   "exchange",
   "symbol",
   "timeframe"
  ],
  "type": "object"
 },
 "name": "calculate_indicator"
}
