{
 "description": "One-shot text generation with local Llama. No conversation context.\nGood for: summarization, code generation, analysis, content creation.\n\nExample: ai_generate({ prompt: \"Write a Python function to sort a list\" })\nExample: ai_generate({ prompt: \"Summarize this: ...\", model: \"llama3.1\" })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "description": "Response format",
    "enum": [
     "text",
     "json"
    ],
    "type": "string"
   },
   "max_tokens": {
    "description": "Max tokens (default: 2048)",
    "type": "number"
   },
   "model": {
    "description": "Model (default: llama3.1)",
    "type": "string"
   },
   "prompt": {
    "description": "The prompt to generate from",
    "type": "string"
   },
   "system": {
    "description": "System prompt",
    "type": "string"
   },
   "temperature": {
    "description": "Creativity (0-2, default: 0.7)",
    "type": "number"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "ai_generate"
}
