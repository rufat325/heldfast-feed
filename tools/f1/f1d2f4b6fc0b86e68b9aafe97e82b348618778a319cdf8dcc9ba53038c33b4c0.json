{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a GTFS static/realtime transit scaffold with route maps, stop maps, arrival predictions, adapter source, and public-data notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9070/gtfs",
    "type": "string"
   },
   "agency_label": {
    "default": "local_transit",
    "type": "string"
   },
   "feed_mode": {
    "default": "gtfs_realtime",
    "enum": [
     "gtfs_realtime",
     "static_gtfs_snapshot",
     "manual"
    ],
    "type": "string"
   },
   "name": {
    "default": "gtfs_transit_feed",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the GTFS scaffold.",
    "type": "string"
   },
   "prediction_count": {
    "default": 16,
    "maximum": 1024,
    "minimum": 1,
    "type": "integer"
   },
   "route_count": {
    "default": 8,
    "maximum": 512,
    "minimum": 1,
    "type": "integer"
   },
   "stop_count": {
    "default": 12,
    "maximum": 2048,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_gtfs_transit_feed",
 "title": "Connect GTFS transit feed"
}
