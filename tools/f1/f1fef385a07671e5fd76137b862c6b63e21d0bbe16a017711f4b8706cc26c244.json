{
 "description": "Side-by-side comparison of two packages: vulnerabilities, OpenSSF Scorecard, GitHub stars, release recency, and license. Returns a recommendation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "default": "npm",
    "description": "Package ecosystem (default: npm)",
    "enum": [
     "npm",
     "pypi",
     "go",
     "maven",
     "cargo",
     "nuget",
     "rubygems",
     "pub"
    ],
    "type": "string"
   },
   "package_a": {
    "description": "First package name",
    "type": "string"
   },
   "package_b": {
    "description": "Second package name",
    "type": "string"
   }
  },
  "required": [
   "package_a",
   "package_b"
  ],
  "type": "object"
 },
 "name": "hound_compare"
}
