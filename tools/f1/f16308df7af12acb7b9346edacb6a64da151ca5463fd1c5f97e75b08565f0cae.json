{
 "description": "Generates README, DESIGN, TUTORIAL, or CHANGELOG documents in Markdown format. Supports multiple languages, badges, API reference, FAQ, and more.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
