   "apiReference": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "params": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "returns": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "author": {
    "type": "string"
   },
   "changelog": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "changes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "date": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
