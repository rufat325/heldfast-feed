     "additionalProperties": false,
     "properties": {
      "codeBlocks": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "description": {
          "type": "string"
         },
         "filename": {
          "type": "string"
         },
         "language": {
          "default": "text",
          "type": "string"
         }
        },
        "required": [
         "code"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "conversationSummary": {
       "type": "string"
      },
      "sessionId": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "sessionId",
      "timestamp",
      "codeBlocks",
      "conversationSummary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contributors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "designDecisions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alternatives": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "category": {
       "default": "other",
       "enum": [
        "architecture",
        "library",
        "pattern",
        "implementation",
        "other"
       ],
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "rationale": {
       "type": "string"
      },
      "timestamp": {
       "default": "2026-09-27T06:57:27.795Z",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "description",
      "rationale"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "documentType": {
    "enum": [
     "README",
     "DESIGN",
     "TUTORIAL",
     "CHANGELOG",
     "API",
     "ARCHITECTURE"
