    "type": "object"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "ko"
    ],
    "type": "string"
   },
   "license": {
    "type": "string"
   },
   "projectName": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "documentType"
