{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Running Pace Calculator"
 },
 "description": "Calculate running distance, elapsed time or pace from exactly two values and distance units. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "distance": 5,
    "time": "25:00"
   }
  ],
  "oneOf": [
   {
    "not": {
     "required": [
      "pace"
     ]
    },
    "required": [
     "distance",
     "time"
    ]
   },
   {
    "not": {
     "required": [
      "time"
     ]
    },
    "required": [
     "distance",
     "pace"
    ]
   },
   {
    "not": {
     "required": [
      "distance"
     ]
    },
    "required": [
     "time",
     "pace"
    ]
   }
  ],
  "properties": {
   "distance": {
    "description": "Distance in selected units",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "pace": {
    "description": "Pace in minutes, M:SS or H:MM:SS per selected distance unit",
    "minLength": 1,
    "type": "string"
   },
   "time": {
    "description": "Elapsed time in minutes, M:SS or H:MM:SS",
    "minLength": 1,
    "type": "string"
   },
   "units": {
    "default": "km",
    "enum": [
     "km",
     "mi"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "pace_calculator",
 "outputSchema": {
  "description": "distance, time (seconds), pace, perKm and perMile (seconds per unit), solved",
  "type": "object"
 },
 "title": "Running Pace Calculator"
}
