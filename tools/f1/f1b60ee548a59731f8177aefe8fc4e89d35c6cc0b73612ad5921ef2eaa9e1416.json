{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/free-online-quotation-generator"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Quotation document data"
 },
 "description": "Generate quotation JSON and plain-text draft with percentage discounts per item and tax on discounted amounts. Does not save, send, or render PDF; website provides visual export. Currency is a label, no FX conversion. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "client": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "currency": {
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "lineItems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "discount": {
       "default": 0,
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "itemName": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "maximum": 1000000,
       "type": "number"
      },
      "rate": {
       "maximum": 1000000000000,
       "minimum": 0,
       "type": "number"
      },
      "tax": {
       "default": 0,
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "itemName",
      "quantity",
      "rate"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "quotationNumber": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "sender": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "quotationNumber",
   "sender",
   "client",
   "currency",
   "lineItems"
  ],
  "type": "object"
 },
 "name": "quotation_generate",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "currency": {
    "type": "string"
   },
   "lineItems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "discount": {
       "type": "number"
      },
      "itemName": {
       "type": "string"
      },
      "net": {
       "type": "number"
      },
      "quantity": {
       "type": "number"
      },
      "rate": {
       "type": "number"
      },
      "tax": {
       "type": "number"
      },
      "taxAmount": {
       "type": "number"
      },
      "total": {
       "type": "number"
      }
     },
     "required": [
      "itemName",
      "quantity",
      "rate",
      "discount",
      "tax",
      "net",
      "taxAmount",
      "total"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quotationNumber": {
    "type": "string"
   },
   "subtotal": {
    "type": "number"
   },
   "tax": {
    "type": "number"
   },
   "text": {
    "type": "string"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "quotationNumber",
   "currency",
   "lineItems",
   "subtotal",
   "tax",
   "total",
   "text"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Quotation document data"
}
