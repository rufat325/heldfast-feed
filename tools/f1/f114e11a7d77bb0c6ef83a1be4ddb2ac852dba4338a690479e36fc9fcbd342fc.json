       "additionalProperties": true,
       "properties": {
        "code": {
         "const": "LIMIT_EXCEEDED",
         "type": "string"
        },
        "current_plan": {
         "type": "string"
        },
        "extensions": {
         "additionalProperties": {},
         "type": "object"
        },
        "limit_type": {
         "type": "string"
        },
        "limit_value": {},
