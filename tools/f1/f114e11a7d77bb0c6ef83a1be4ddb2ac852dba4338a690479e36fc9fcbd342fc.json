         "payg_charge",
         "payg_rate_card"
        ],
        "type": "string"
       },
       "billed": {
        "description": "true = this amount was actually charged via PAYG for this call. false = indicative PAYG-equivalent value; your plan already covers this call for free.",
        "type": "boolean"
       }
      },
      "required": [
       "amount_usd",
       "billed",
       "basis"
      ],
      "type": "object"
