{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store or revise a current offer only after the user approves the exact name and terms. Copy may state an offer only while active is true. Set active to false to withdraw an offer. Updates require offerId and expectedRevision from get_brand_guide. A conflicting revision fails without overwriting. An identical retry returns the saved offer.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "default": true,
    "type": "boolean"
   },
   "brandId": {
    "format": "uuid",
    "type": "string"
   },
   "expectedRevision": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "offerId": {
    "$ref": "#/properties/brandId"
   },
   "terms": {
    "maxLength": 12000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "brandId",
   "name",
   "terms"
  ],
  "type": "object"
 },
 "name": "save_offer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save offer"
}
