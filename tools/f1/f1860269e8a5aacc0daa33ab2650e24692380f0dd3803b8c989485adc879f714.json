{
 "description": "Get a specific code example by PrimeReact component and section",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "component": {
    "description": "Component name",
    "type": "string"
   },
   "section": {
    "description": "Section ID (e.g., 'basic', 'controlled', 'template')",
    "type": "string"
   },
   "variant": {
    "description": "Example variant: 'basic' for composition API, 'options' for options API (default: 'basic')",
    "type": "string"
   }
  },
  "required": [
   "component",
   "section"
  ],
  "type": "object"
 },
 "name": "get_example"
}
