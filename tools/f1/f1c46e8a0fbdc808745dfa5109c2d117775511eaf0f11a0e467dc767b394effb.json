    "type": "string"
   },
   "mfu": {
    "description": "Model FLOPs utilization, 0..1.",
    "exclusiveMinimum": 0,
    "maximum": 1,
    "type": "number"
   },
   "optimizer": {
    "enum": [
     "adamw",
     "adamw8bit",
     "muon",
     "sgd_momentum",
     "sgd",
     "bf16_adam"
