    "description": "CIF customs value in EUR",
    "type": "number"
   },
   "hs_code": {
    "description": "HS or TARIC code (e.g. 760421, 640411)",
    "type": "string"
   },
   "origin_country": {
    "description": "ISO-2 origin country code (default: CN)",
    "type": "string"
   }
  },
  "required": [
   "hs_code",
   "customs_value_eur"
  ],
  "type": "object"
 },
 "name": "calculate_customs_duties"
}
