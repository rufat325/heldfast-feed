 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Save submission feedback"
 },
 "description": "Saves teacher-reviewed written feedback on one submission, overall or per section, without changing scores. Students see it once results are released, including immediately if already released. Returns previous text for restoration.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "assignmentId": {
    "description": "Assignment id from list_coursework or list_submissions_to_review.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   },
   "itemFeedback": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "itemId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "text": {
       "maxLength": 10000,
       "type": "string"
      }
     },
     "required": [
      "itemId",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "overallFeedback": {
    "maxLength": 10000,
    "type": "string"
   },
   "submissionId": {
    "description": "Submission id from list_submissions_to_review.",
    "pattern": "^[a-f\\d]{24}$",
    "type": "string"
   }
  },
  "required": [
   "assignmentId",
   "submissionId"
  ],
  "type": "object"
 },
 "name": "save_submission_feedback",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "grading:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Save submission feedback"
}
