  "readOnlyHint": true,
  "title": "Get Orders"
 },
 "description": "Returns lunch orders already placed - items, menu date, status, and total - for the authenticated user's students. Filter by student_id, a single menu_date, or a month; with no filters returns recent orders. Admins (pac_cordinator, lunch_cordinator) see school-wide orders; parents only their own students. For what can be ordered (menu and prices), use get_menu.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "menu_date": {
    "description": "Single day to query, YYYY-MM-DD",
    "type": "string"
   },
   "month": {
    "description": "Calendar month to query, YYYY-MM",
    "type": "string"
   },
   "student_id": {
    "description": "Filter to a specific student (must be your own; from get_user_info)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_orders",
 "outputSchema": {
  "properties": {
   "orders": {
    "description": "Orders matching the filters",
    "items": {
     "properties": {
      "createdAt": {
       "description": "ISO timestamp the order was placed",
       "type": "string"
      },
      "id": {
       "description": "Order ID",
       "type": "string"
      },
      "itemTotalCents": {
       "description": "Item total in cents",
       "type": "integer"
      },
      "items": {
       "description": "Ordered line items",
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "menuDate": {
       "description": "Date the lunch is served, YYYY-MM-DD",
       "type": "string"
      },
      "status": {
       "description": "Order status",
       "type": "string"
      },
      "studentId": {
       "description": "Student the order is for",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Get Orders"
}
