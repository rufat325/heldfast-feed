{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Export a route or track as a GPX file to the user's Nextcloud /Maps folder.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "coords": {
    "description": "Ordered list of coordinates",
    "items": {
     "properties": {
      "lat": {
       "description": "Latitude",
       "type": "number"
      },
      "lng": {
       "description": "Longitude",
       "type": "number"
      }
     },
     "required": [
      "lat",
      "lng"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "myMapId": {
    "description": "Target map ID (defaults to /Maps folder)",
    "type": "number"
   },
   "name": {
    "description": "Route name (used as filename)",
    "type": "string"
   },
   "totDist": {
    "description": "Total distance (for metadata)",
    "type": "number"
   },
   "totTime": {
    "description": "Total time (for metadata)",
    "type": "number"
   },
   "type": {
    "description": "GPX structure type: 'route' (<rte>) or 'track' (<trk>)",
    "enum": [
     "route",
     "track"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "coords"
  ],
  "type": "object"
 },
 "name": "export_map_route",
 "title": "Export Map Route"
}
