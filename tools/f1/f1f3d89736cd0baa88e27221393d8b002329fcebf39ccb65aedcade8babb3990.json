{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Checkpoint design"
 },
 "description": "Snapshot a design under a name you can come back to. Take one before an experiment so tensorcad_restore can put it back exactly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   },
   "label": {
    "description": "What this snapshot is, e.g. \"before widening the FFN\".",
    "type": "string"
   }
  },
  "required": [
   "design_id"
  ],
  "type": "object"
 },
 "name": "tensorcad_checkpoint",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "checkpoint_id": {
    "type": "string"
   },
   "checkpoints": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "checkpoint_id": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "revision": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      }
     },
     "required": [
      "checkpoint_id",
      "label",
      "revision",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "created_at": {
    "type": "string"
   },
   "design_id": {
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "design_id",
   "checkpoint_id",
   "label",
   "revision",
   "created_at",
   "checkpoints"
  ],
  "type": "object"
 },
 "title": "Checkpoint design"
}
