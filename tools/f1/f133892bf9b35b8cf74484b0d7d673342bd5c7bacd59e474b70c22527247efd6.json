   },
   "schemaType": {
    "description": "Schema type",
    "enum": [
     "AVRO",
     "JSON",
     "PROTOBUF"
    ],
    "type": "string"
   },
   "topicId": {
    "description": "Topic ID to create schema for",
    "type": "string"
   }
  },
  "required": [
   "topicId",
   "schemaType",
   "schema"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_create_schema"
}
