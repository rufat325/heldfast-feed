   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "organization": {
    "description": "Exact organization slug.",
    "type": "string"
   },
   "query": {
    "description": "Optional AI research paper title or topic. Required unless organization is provided.",
