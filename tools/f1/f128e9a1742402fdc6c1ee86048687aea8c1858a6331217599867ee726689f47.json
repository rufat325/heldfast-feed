{
 "description": "Compose a rigorous, reusable investigation prompt that tells an MCP client which Claidex tools and resources to use.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "disease": {
    "description": "Optional disease area.",
    "type": "string"
   },
   "objective": {
    "description": "The investigation objective to turn into a reusable MCP prompt.",
    "minLength": 1,
    "type": "string"
   },
   "risk_tolerance": {
    "default": "medium",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "target_gene": {
    "description": "Optional HGNC target symbol.",
    "type": "string"
   }
  },
  "required": [
   "objective",
   "risk_tolerance"
  ],
  "type": "object"
 },
 "name": "claidex_research_prompt",
 "title": "Claidex Research Prompt"
}
