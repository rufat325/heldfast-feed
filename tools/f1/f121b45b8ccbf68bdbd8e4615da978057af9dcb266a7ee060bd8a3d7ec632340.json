{
 "description": "Search and read records from any Odoo model in one call. Returns matching records with the requested fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Odoo search domain, e.g. [[\"is_company\",\"=\",true]]. Omit for all records.",
    "type": "array"
   },
   "fields": {
    "description": "Field names to return. Omit for all fields.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max records (default 50).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "Model technical name, e.g. 'res.partner', 'sale.order', 'account.move'.",
    "type": "string"
   },
   "offset": {
    "description": "Records to skip (default 0).",
    "minimum": 0,
    "type": "integer"
   },
   "order": {
    "description": "Sort spec, e.g. 'create_date desc'.",
    "type": "string"
   }
  },
  "required": [
   "model"
  ],
  "type": "object"
 },
 "name": "odoo_search_read"
}
