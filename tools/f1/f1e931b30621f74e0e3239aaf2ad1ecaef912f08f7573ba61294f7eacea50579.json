     "1"
    ],
    "type": "string"
   },
   "name": {
    "description": "Drug name to look up, e.g. 'cymbalta'.",
    "type": "string"
   },
   "search": {
    "description": "0 exact (default), 1 normalized, 2 exact-or-normalized, 9 approximate.",
    "enum": [
     "0",
     "1",
     "2",
     "9"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "rxnorm_find_rxcui_by_name",
 "title": "Find RxCUI by name"
}
