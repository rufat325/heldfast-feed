{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a manual collection (optional productIds) or a smart collection (ruleSet). Pass publicationIds to publish to explicitly selected channels. Defaults to dryRun:true, which previews the input without creating anything.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "descriptionHtml": {
    "maxLength": 50000,
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "description": "True (the default) returns a before/after preview without changing anything in Shopify. Pass false, after the user authorizes this store and exact change, to apply it; the tool then reads the result back.",
    "type": "boolean"
   },
   "image": {
    "additionalProperties": false,
    "properties": {
     "altText": {
      "maxLength": 1000,
      "type": "string"
     },
     "url": {
      "format": "starts_with",
      "pattern": "^https:\\/\\/.*",
      "type": "string"
     }
    },
    "required": [
     "url"
    ],
    "type": "object"
   },
   "productIds": {
    "items": {
     "pattern": "^gid:\\/\\/shopify\\/Product\\/[0-9]+$",
     "type": "string"
    },
    "maxItems": 250,
    "minItems": 1,
    "type": "array"
   },
   "publicationIds": {
    "default": [],
    "items": {
     "pattern": "^gid:\\/\\/shopify\\/Publication\\/[0-9]+$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "ruleSet": {
    "additionalProperties": false,
    "properties": {
     "appliedDisjunctively": {
      "type": "boolean"
     },
     "rules": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "column": {
         "type": "string"
        },
        "condition": {
         "type": "string"
        },
        "relation": {
         "type": "string"
        }
       },
       "required": [
        "column",
        "relation",
        "condition"
       ],
       "type": "object"
      },
      "maxItems": 60,
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "appliedDisjunctively",
     "rules"
    ],
    "type": "object"
   },
   "sortOrder": {
    "enum": [
     "ALPHA_ASC",
     "ALPHA_DESC",
     "BEST_SELLING",
     "CREATED",
     "CREATED_DESC",
     "MANUAL",
     "PRICE_ASC",
     "PRICE_DESC"
    ],
    "type": "string"
   },
   "store": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "store",
   "title"
  ],
  "type": "object"
 },
 "name": "shopify_create_collection"
}
