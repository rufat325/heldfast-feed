{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Query items in a SharePoint list with optional OData $filter, $select, and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "description": "OData $filter expression applied to item fields, e.g. \"fields/Status eq 'Active'\".",
    "type": "string"
   },
   "list_id": {
    "description": "List ID or display name.",
    "type": "string"
   },
   "select": {
    "description": "Comma-separated field names to include in each item's fields object.",
    "type": "string"
   },
   "site_id": {
    "description": "SharePoint Graph site ID.",
    "type": "string"
   },
   "skip": {
    "description": "Number of items to skip (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "top": {
    "description": "Maximum items to return (default 100).",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "site_id",
   "list_id"
  ],
  "type": "object"
 },
 "name": "list_items"
}
