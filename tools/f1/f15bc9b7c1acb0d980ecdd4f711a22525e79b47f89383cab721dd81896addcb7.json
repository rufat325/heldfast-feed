       ],
       "type": "object"
      },
      "maxProperties": 500,
      "type": "object"
     }
    },
    "required": [
     "by_rooftop"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Get dealership details"
}
