  "readOnlyHint": true,
  "title": "Get dealership details"
 },
 "description": "One named rooftop's store record: name, dealer group, OEM programs, location/contact metadata, and fee schedule. Pass rooftop_slug. Whether a specific unit's listed price already includes a fee varies per unit \u2014 quote_preview returns the estimated total. Fee schedules may be incomplete \u2014 an unlisted fee is not a guarantee that no such fee applies; confirm final charges with the dealer.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "rooftop_slug": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "rooftop_slug"
  ],
  "type": "object"
 },
 "name": "stores",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "store": {
      "allOf": [
       {
        "description": "The public projection of one rooftop's store metadata. NULL holders are omitted, never fabricated.",
        "properties": {
         "address": {
          "maxLength": 200,
          "type": "string"
         },
         "city": {
          "maxLength": 100,
          "type": "string"
         },
         "country": {
          "enum": [
           "US",
           "CA"
          ],
          "type": "string"
         },
         "dealer_group": {
          "additionalProperties": false,
          "properties": {
           "name": {
            "maxLength": 200,
            "type": "string"
           },
           "slug": {
            "maxLength": 80,
            "type": "string"
           }
          },
          "required": [
           "name",
           "slug"
          ],
          "type": "object"
         },
         "hours": {
          "type": "object"
         },
         "latitude": {
          "maximum": 90,
          "minimum": -90,
          "type": "number"
         },
         "limitations": {
          "items": {
           "maxLength": 500,
           "type": "string"
          },
          "maxItems": 1,
          "type": "array"
         },
         "longitude": {
          "maximum": 180,
          "minimum": -180,
          "type": "number"
         },
         "manifest_url": {
          "maxLength": 300,
          "type": "string"
         },
         "name": {
          "maxLength": 200,
          "type": "string"
         },
         "oem_programs": {
          "items": {
           "maxLength": 80,
           "type": "string"
          },
          "maxItems": 20,
          "type": "array"
         },
         "phone": {
          "maxLength": 30,
          "type": "string"
         },
         "slug": {
          "maxLength": 80,
          "type": "string"
         },
         "state": {
          "maxLength": 50,
          "type": "string"
         },
         "website_url": {
          "maxLength": 300,
          "type": "string"
         },
         "zip": {
          "maxLength": 20,
          "type": "string"
         }
        },
        "required": [
         "name",
         "slug",
         "country",
         "dealer_group",
         "oem_programs"
        ],
        "type": "object"
       },
       {
        "properties": {
         "fee_schedule": {
          "items": {
           "additionalProperties": false,
           "properties": {
            "amount": {
             "minimum": 0,
             "type": "number"
            },
            "applies_to": {
             "enum": [
              "new",
              "used",
              "all"
             ]
            },
            "category": {
             "enum": [
              "fee",
              "tax",
              "title_reg"
             ]
            },
            "code": {
             "maxLength": 60,
             "type": "string"
            },
            "effective_from": {
             "format": "date",
             "type": "string"
            },
            "fee_type": {
             "enum": [
              "flat",
              "percent"
             ]
            },
            "jurisdiction": {
             "maxLength": 60,
             "type": [
              "string",
              "null"
             ]
            },
            "label": {
             "maxLength": 200,
             "type": "string"
            },
            "taxable": {
             "type": "boolean"
            }
           },
           "required": [
            "code",
            "label",
            "category",
            "fee_type",
            "amount"
           ],
           "type": "object"
          },
          "maxItems": 100,
          "type": "array"
         }
        },
        "type": "object"
       }
      ]
     }
    },
    "required": [
     "store"
