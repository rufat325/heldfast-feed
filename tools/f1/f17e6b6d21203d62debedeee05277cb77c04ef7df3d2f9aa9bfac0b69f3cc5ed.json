{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Configure log collection on VPC servers in Cloud Log Analytics. Returns the agent install key and the install command to run on each server.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "collectingInfos": {
    "description": "Log collection settings, one entry per log path/server",
    "items": {
     "additionalProperties": false,
     "properties": {
      "instanceNo": {
       "description": "Target server instance number",
       "type": "number"
      },
      "ip": {
       "description": "Target server IP address",
       "type": "string"
      },
      "logPath": {
       "description": "Log path to collect, e.g. /var/log/messages",
       "type": "string"
      },
      "logTemplate": {
       "description": "Log template, e.g. SYSLOG, APACHE, TOMCAT",
       "type": "string"
      },
      "logType": {
       "description": "Log type, e.g. SYSLOG, security_log",
       "type": "string"
      },
      "macAddr": {
       "description": "Target server MAC address (from ncloud_list_log_servers)",
       "type": "string"
      },
      "osType": {
       "description": "Target server OS type (from ncloud_list_log_servers)",
       "type": "string"
      },
      "servername": {
       "description": "Target server name (from ncloud_list_log_servers)",
       "type": "string"
      }
     },
     "required": [
      "logPath",
      "logTemplate",
      "logType",
      "servername",
      "osType",
      "instanceNo",
      "macAddr"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "regionCode": {
    "description": "Region code as a lowercase path segment (kr, jpn, sgn, uswn, den). Default: the client's active region",
    "type": "string"
   }
  },
  "required": [
   "collectingInfos"
  ],
  "type": "object"
 },
 "name": "ncloud_set_server_log_collection"
}
