{"_meta":{"securitySchemes":[{"scopes":["gymflexa:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Book a gym session"},"description":"Use this when someone asks to book a member into a session, class or personal training at their gym. Returns the new session with its time, trainer and services; it takes the gym's usual session length and reminders, so the gym's reminder messages go to the member. Not for finding free slots.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"durationMinutes":{"description":"Length in minutes. Leave it out for the gym's usual session length.","maximum":480,"minimum":5,"type":"integer"},"gymId":{"description":"Id of the gym, from list_gyms. Leave it out when the user has one gym.","maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"memberId":{"description":"Id of the member, from list_members or create_member.","maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"note":{"description":"A note for the gym team.","maxLength":2000,"type":"string"},"providerIds":{"description":"Ids of the trainers who take it, from list_trainers. Leave it out when the gym has one trainer or the user is the trainer.","items":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":5,"type":"array"},"requestId":{"description":"A unique id you choose for this booking, such as a UUID. Calling again with the same requestId returns the first booking instead of booking twice.","maxLength":64,"minLength":1,"pattern":"^[A-Za-z0-9_-]{1,64}$","type":"string"},"serviceIds":{"description":"Ids of the services booked, from list_services.","items":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":20,"type":"array"},"startTime":{"description":"Start as an ISO 8601 time with the gym's UTC offset, such as 2026-11-20T10:00:00+01:00.","format":"date-time","maxLength":40,"type":"string"}},"required":["memberId","startTime","requestId"],"type":"object"},"name":"book_appointment","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"appointment":{"additionalProperties":false,"properties":{"endTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"gymId":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"id":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"lastEditTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"memberId":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"providerIds":{"items":{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},"maxItems":10,"type":"array"},"reminderCount":{"maximum":100000,"minimum":0,"type":"integer"},"serviceCount":{"maximum":100000,"minimum":0,"type":"integer"},"services":{"items":{"additionalProperties":false,"properties":{"id":{"anyOf":[{"maxLength":24,"minLength":24,"pattern":"^[0-9a-f]{24}$","type":"string"},{"type":"null"}]},"name":{"maxLength":200,"type":"string"},"price":{"anyOf":[{"maximum":1000000000,"minimum":-1000000000,"type":"number"},{"type":"null"}]}},"required":["id","name","price"],"type":"object"},"maxItems":20,"type":"array"},"startTime":{"anyOf":[{"maxLength":40,"type":"string"},{"type":"null"}]},"status":{"anyOf":[{"enum":["REQUESTED","SCHEDULED","MEMBER_ARRIVED","NO_SHOW","CANCELED"],"type":"string"},{"type":"null"}]}},"required":["id","gymId","memberId","startTime","endTime","status","lastEditTime","providerIds","serviceCount","services","reminderCount"],"type":"object"},"status":{"enum":["booked","already_booked"],"type":"string"}},"required":["status","appointment"],"type":"object"},"title":"Book a gym session"}
