{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List voiceover lines"
 },
 "description": "Use this when someone asks which voiceover or narration lines a project has, optionally in one language. Returns each line's id, a short text preview, language, project and audio URL, most recently edited first, 25 per page by default. Not for the full text of one line.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "language": {
    "description": "Only lines in this language code, e.g. en, es or de",
    "maxLength": 32,
    "type": "string"
   },
   "limit": {
    "description": "Voiceover lines per page, from 1 to 100; defaults to 25",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "projectId": {
    "description": "Only voiceover lines in this project",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_speeches",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "languageFilter": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "offset": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "projectIdFilter": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "returned": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "speeches": {
    "description": "Voiceover lines with a text preview of up to 120 characters, not the full text",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "language": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "projectId": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "textPreview": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "textTruncated": {
       "type": "boolean"
      },
      "url": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "textPreview",
      "textTruncated",
      "language",
      "projectId",
      "url",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "projectIdFilter",
   "languageFilter",
   "speeches",
   "offset",
   "returned",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List voiceover lines"
}
