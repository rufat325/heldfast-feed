{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the immediate next prayer name, scheduled time, authority calculation method, and remaining countdown in minutes. MANDATORY: The LLM must always explicitly disclose to the user which calculation authority method was used and why it was selected (see authorityNotice in response).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "calculationMethod": {
    "description": "Optional calculation authority override (auto-resolved from location by default)",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "latitude": {
    "description": "Optional explicit latitude override",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Optional explicit longitude override",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "madhab": {
    "description": "Optional Asr shadow jurisprudence override (Shafi or Hanafi)",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "timezone": {
    "description": "Optional IANA timezone override",
    "type": "string"
   },
   "userId": {
    "description": "Optional unique user identifier to load stored preferences. If omitted, pure geographic auto-resolution is applied.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_next_prayer",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authorityDescription": {
    "type": "string"
   },
   "authorityNotice": {
    "additionalProperties": false,
    "properties": {
     "authorityDescription": {
      "description": "Full descriptive name of the calculation authority",
      "type": "string"
     },
     "madhab": {
      "description": "The Asr jurisprudence school",
      "enum": [
       "Shafi",
       "Hanafi"
      ],
      "type": "string"
     },
     "method": {
      "description": "The calculation authority method",
      "enum": [
       "UmmAlQura",
       "MuslimWorldLeague",
       "Egyptian",
       "Karachi",
       "NorthAmerica",
       "Dubai",
       "Qatar",
       "Kuwait",
       "MoonsightingCommittee",
       "Singapore",
       "Turkey",
       "Tehran"
      ],
      "type": "string"
     },
     "requiredDisplayInstruction": {
      "description": "Mandatory theological notice for AI presentation",
      "type": "string"
     },
     "selectionReason": {
      "description": "Rationale for selecting this authority",
      "type": "string"
     }
    },
    "required": [
     "method",
     "madhab",
     "authorityDescription",
     "selectionReason",
     "requiredDisplayInstruction"
    ],
    "type": "object"
   },
   "calculationMethod": {
    "description": "Active calculation authority",
    "enum": [
     "UmmAlQura",
     "MuslimWorldLeague",
     "Egyptian",
     "Karachi",
     "NorthAmerica",
     "Dubai",
     "Qatar",
     "Kuwait",
     "MoonsightingCommittee",
     "Singapore",
     "Turkey",
     "Tehran"
    ],
    "type": "string"
   },
   "currentLocalDate": {
    "description": "Current local date YYYY-MM-DD",
    "type": "string"
   },
   "madhab": {
    "description": "Active Asr jurisprudence",
    "enum": [
     "Shafi",
     "Hanafi"
    ],
    "type": "string"
   },
   "minuteAdjustments": {
    "additionalProperties": false,
    "properties": {
     "asr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "dhuhr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "fajr": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "isha": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "maghrib": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     },
     "sunrise": {
      "maximum": 60,
      "minimum": -60,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "nextPrayer": {
    "description": "Name of the upcoming prayer",
    "type": "string"
   },
   "nextPrayerAtUtc": {
    "description": "UTC timestamp of the upcoming prayer",
    "type": "string"
   },
   "nextPrayerLocalTime": {
    "description": "Formatted local time HH:mm",
    "type": "string"
   },
   "remainingMinutes": {
    "description": "Minutes remaining until prayer start",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "selectionReason": {
    "type": "string"
   },
   "timezone": {
    "description": "Resolved IANA timezone",
    "type": "string"
   }
  },
  "required": [
   "currentLocalDate",
   "timezone",
   "nextPrayer",
   "nextPrayerAtUtc",
   "nextPrayerLocalTime",
   "remainingMinutes",
   "calculationMethod",
   "madhab"
  ],
  "type": "object"
 },
 "title": "Get Upcoming Prayer and Countdown"
}
