{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search a specific library source by name. Use library_ask instead for natural language queries across multiple sources.\n\n  Sources marked [full text] support library_read and library_ingest.\n  Sources marked [metadata] return discovery info and external URLs only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "default": 10,
    "description": "Max results",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Title, author, subject, or keywords",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "response_format": {
    "default": "concise",
    "description": "concise (default) trims results/citations to high-signal fields; detailed returns the full payload, including routing reasons, scores, and stage diagnostics.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "source": {
    "description": "Library source name. Run library_list_sources for the current list and descriptions.",
    "type": "string"
   }
  },
  "required": [
   "query",
   "source"
  ],
  "type": "object"
 },
 "name": "library_search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cluster": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "downloadUrl": {
       "type": "string"
      },
      "hasFullText": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "language": {
       "type": "string"
      },
      "previewUrl": {
       "type": "string"
      },
      "published": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "subjects": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "source",
      "title",
      "hasFullText"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Search Library Source"
}
