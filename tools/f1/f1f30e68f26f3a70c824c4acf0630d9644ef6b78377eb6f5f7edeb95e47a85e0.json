 "description": "Routes between two places in Hong Kong by MTR, bus, minibus, tram and ferry, best first: departure and arrival times, every walk and ride with stops, Octopus fares for the group, live next departures, traffic delays, and a link to open the trip on a live map. Also lists Klook things to do near the destination (affiliate ads).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "default": 1,
    "description": "Aged 12\u201359",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "arrive_by": {
    "default": false,
    "description": "true: time is when to arrive; false: when to leave",
    "type": "boolean"
   },
   "bus": {
    "description": "A preferred bus or green minibus number, e.g. \"33\" or \"1A\": options are then only trips on it (its next departures from the nearest stop within about 10 minutes' walk, heading for the destination), or route_note says why there are none",
    "maxLength": 6,
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Aged 3\u201311",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "currency": {
    "description": "Also show fares in this currency (fares are charged in HKD). Default follows language",
    "enum": [
     "HKD",
     "USD",
     "JPY",
     "TWD",
     "CNY",
     "SGD",
     "KRW"
    ],
    "type": "string"
   },
   "disabled": {
    "default": 0,
    "description": "Persons with disabilities",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "from": {
    "description": "Start: a place name, address or \"lat,lon\" (e.g. \"Tsim Sha Tsui Star Ferry\", \"238 Nathan Road\", \"22.2988,114.1722\")",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "default": "en",
    "description": "Language for place and line names: en, zh-HK (Traditional Chinese), zh-CN (Simplified), ja, ko",
    "enum": [
     "zh-HK",
     "zh-CN",
     "en",
     "ja",
     "ko"
    ],
    "type": "string"
   },
   "options": {
    "default": 3,
    "description": "How many route options",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "seniors": {
    "default": 0,
    "description": "Aged 60+",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "step_free": {
    "default": false,
    "description": "Wheelchair / step-free: avoids stairs, minibuses and trams",
    "type": "boolean"
   },
   "time": {
    "description": "ISO 8601 date-time, e.g. 2026-10-05T09:30:00+08:00 (Hong Kong is UTC+8). Default: now",
    "type": "string"
   },
   "to": {
    "description": "Destination, same forms as from",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
