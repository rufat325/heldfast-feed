{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Preview links"
 },
 "description": "Reads up to 50 links and returns each one's title, description, site and kind (page, video\u2026), or why it could not be read. Useful before making a set, to check the links work and describe them, or to see what links someone sent are about.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "urls": {
    "description": "The links to read (1 to 50)",
    "items": {
     "format": "uri",
     "pattern": "^https?://",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "urls"
  ],
  "type": "object"
 },
 "name": "preview_links",
 "outputSchema": {
  "properties": {
   "links": {
    "items": {
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "error": {
       "description": "Why the link could not be read",
       "type": "string"
      },
      "site": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "description": "page, video\u2026",
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "url",
      "title",
      "description",
      "site",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "links"
  ],
  "type": "object"
 },
 "title": "Preview links"
}
