{
 "description": "Search ClinicalTrials.gov for clinical trials. Can search by drug name, condition, target, or NCT ID. Returns trial status, phase, sponsor, primary endpoints, and why_stopped if terminated.",
 "execution": {
  "taskSupport": "optional"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "max_results": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "phase": {
    "default": "any",
    "enum": [
     "PHASE1",
     "PHASE2",
     "PHASE3",
     "PHASE4",
     "any"
    ],
    "type": "string"
   },
   "query": {
    "description": "Search term: drug name, condition, NCT ID, or target",
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "default": "any",
    "enum": [
     "RECRUITING",
     "ACTIVE_NOT_RECRUITING",
     "TERMINATED",
     "WITHDRAWN",
     "COMPLETED",
     "any"
    ],
    "type": "string"
   }
  },
  "required": [
   "query",
   "status",
   "phase",
   "max_results"
  ],
  "type": "object"
 },
 "name": "query_clinicaltrials",
 "title": "Query Clinicaltrials"
}
