{"_meta":{"openai/toolInvocation/invoked":"\u0417\u043d\u0430\u0439\u0448\u043e\u0432 \u0437\u0430\u043a\u043b\u0430\u0434\u0438","openai/toolInvocation/invoking":"\u0428\u0443\u043a\u0430\u044e \u0437\u0430\u043a\u043b\u0430\u0434\u0438","securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true,"title":"\u041f\u043e\u0448\u0443\u043a \u0437\u0430\u043a\u043b\u0430\u0434\u0456\u0432"},"description":"\u0417\u043d\u0430\u0445\u043e\u0434\u0438\u0442\u044c \u043c\u0456\u0441\u0446\u044f \u043d\u0430 \u043f\u043b\u0430\u0442\u0444\u043e\u0440\u043c\u0456 AOA: \u043a\u0430\u0432\u02bc\u044f\u0440\u043d\u0456, \u0431\u0430\u0440\u0438, \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d\u0438, \u043a\u043e\u0432\u043e\u0440\u043a\u0456\u043d\u0433\u0438, \u043a\u043d\u0438\u0433\u0430\u0440\u043d\u0456, \u043a\u0443\u043b\u044c\u0442\u0443\u0440\u043d\u0456 \u043f\u0440\u043e\u0441\u0442\u043e\u0440\u0438. \u0412\u0438\u043a\u043b\u0438\u043a\u0430\u0439, \u043a\u043e\u043b\u0438 \u043b\u044e\u0434\u0438\u043d\u0430 \u043f\u0438\u0442\u0430\u0454, \u043a\u0443\u0434\u0438 \u043f\u0456\u0442\u0438, \u0434\u0435 \u0432\u0438\u043f\u0438\u0442\u0438 \u043a\u0430\u0432\u0438 \u0447\u0438 \u043f\u043e\u0432\u0435\u0447\u0435\u0440\u044f\u0442\u0438, \u0434\u0435 \u043f\u043e\u043f\u0440\u0430\u0446\u044e\u0432\u0430\u0442\u0438 \u0437 \u043d\u043e\u0443\u0442\u0431\u0443\u043a\u043e\u043c, \u0434\u0435 \u0437\u0443\u0441\u0442\u0440\u0456\u0442\u0438\u0441\u044f \u0437 \u0434\u0440\u0443\u0437\u044f\u043c\u0438 \u0430\u0431\u043e \u043f\u0440\u043e\u0432\u0435\u0441\u0442\u0438 \u043f\u043e\u0431\u0430\u0447\u0435\u043d\u043d\u044f \u2014 \u0430 \u0442\u0430\u043a\u043e\u0436 \u043a\u043e\u043b\u0438 \u0432\u043e\u043d\u0430 \u043d\u0430\u0437\u0438\u0432\u0430\u0454 \u043a\u043e\u043d\u043a\u0440\u0435\u0442\u043d\u0438\u0439 \u0437\u0430\u043a\u043b\u0430\u0434 \u0456 \u0442\u0440\u0435\u0431\u04