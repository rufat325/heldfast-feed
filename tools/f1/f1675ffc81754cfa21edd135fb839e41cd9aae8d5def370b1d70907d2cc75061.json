{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Price printed items delivered to one destination. Returns quote_id, the total that the payer pays (products, shipping and VAT where AgentMade collects it), what is not included, the delivery estimate and the expiry. Needs artwork_id values from validate_artwork. Charges nothing. For a destination where orders are not open, the quote is for information only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyer": {
    "description": "Only for a company purchase with an invoice. Business checkout is not open yet: the quote charges destination VAT.",
    "properties": {
     "company_name": {
      "description": "Registered company name for the invoice.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "vat_id": {
      "description": "EU or UK VAT number with the country prefix, e.g. \"DE123456789\".",
      "maxLength": 20,
      "type": "string"
     }
    },
    "required": [
     "company_name"
    ],
    "type": "object"
   },
   "currency": {
    "description": "ISO 4217 currency of the payer, e.g. \"USD\". Optional. The quote states the currency that it uses.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "deliver_by": {
    "description": "Date by which the parcel should arrive, e.g. \"2026-12-20\". The quote is never refused because of it: if the estimate is later, the quote says so.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "artwork": {
       "description": "One entry per print placement. Each placement may appear once per item.",
       "items": {
        "properties": {
         "artwork_id": {
          "description": "artwork_id returned by validate_artwork.",
          "type": "string"
         },
         "height_mm": {
          "description": "Maximum printed height in millimetres.",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "type": "number"
         },
         "left_mm": {
          "description": "Distance from the left edge of the print area. Default: horizontally centred.",
          "maximum": 1000,
          "minimum": 0,
          "type": "number"
         },
         "placement": {
          "default": "front",
          "description": "Print location on the product, e.g. \"front\" or \"back\". See get_product for the list.",
          "type": "string"
         },
         "preset": {
          "description": "Named position inside the placement, e.g. \"center_chest\", \"left_chest\", \"full_front\". Defaults to the placement default.",
          "type": "string"
         },
         "top_mm": {
          "description": "Distance from the top of the print area to the top of the artwork.",
          "maximum": 1000,
          "minimum": 0,
          "type": "number"
         },
         "width_mm": {
          "description": "Exact printed width of the visible artwork in millimetres. Height follows the aspect ratio.",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "type": "number"
         }
        },
        "required": [
         "artwork_id"
        ],
        "type": "object"
       },
       "maxItems": 4,
       "minItems": 1,
       "type": "array"
      },
      "color": {
       "description": "Colour id or name, e.g. \"black\".",
       "type": "string"
      },
      "product_id": {
       "description": "Product id from search_products, e.g. \"tee-heavyweight\".",
       "type": "string"
      },
      "quantity": {
       "default": 1,
       "maximum": 50,
       "minimum": 1,
       "type": "integer"
      },
      "size": {
       "description": "Size, e.g. \"XL\". For one-size products use \"ONE SIZE\" (\"ONE\" also works).",
       "type": "string"
      }
     },
     "required": [
      "product_id",
      "color",
      "size",
      "artwork"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "preference": {
    "default": "fewest_packages",
    "description": "How AgentMade picks the manufacturing route: fewest_packages (default: fewest parcels, then best price among the fastest routes), cheapest, or fastest.",
    "enum": [
     "fewest_packages",
     "cheapest",
     "fastest"
    ],
    "type": "string"
   },
   "purpose": {
    "description": "What the order is for. Set it only if the user already said it. Do not ask for it.",
    "enum": [
     "gift",
     "personal",
     "group",
     "work",
     "event",
     "sample"
    ],
    "type": "string"
   },
   "ship_to": {
    "description": "Destination. country_code is required; postal_code and state_code improve shipping accuracy.",
    "properties": {
     "city": {
      "maxLength": 60,
      "type": "string"
     },
     "country_code": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "postal_code": {
      "maxLength": 20,
      "type": "string"
     },
     "state_code": {
      "maxLength": 10,
      "type": "string"
     }
    },
    "required": [
     "country_code"
    ],
    "type": "object"
   },
   "speed": {
    "default": "standard",
    "description": "Shipping speed. Only standard is offered now; express returns a note and a standard quote.",
    "enum": [
     "standard",
     "express"
    ],
    "type": "string"
   }
  },
  "required": [
   "items",
   "ship_to"
  ],
  "type": "object"
 },
 "name": "quote",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "assumptions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "currency": {
    "type": "string"
   },
   "delivery_estimate_business_days": {
    "additionalProperties": {},
    "properties": {
     "max": {
      "type": [
       "number",
       "null"
      ]
     },
     "min": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "min",
     "max"
    ],
    "type": "object"
   },
   "delivery_estimate_dates": {
    "additionalProperties": {},
    "description": "Calendar dates (YYYY-MM-DD) for the delivery estimate. Tell the user these dates.",
    "properties": {
     "earliest": {
      "type": "string"
     },
     "latest": {
      "type": "string"
     },
     "note": {
      "type": "string"
     }
    },
    "required": [
     "earliest",
     "latest",
     "note"
    ],
    "type": "object"
   },
   "expires_at": {
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "color": {
       "type": "string"
      },
      "line_id": {
       "type": "string"
      },
      "line_total_minor": {
       "description": "Integer minor units (cents) of `currency`.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "placements": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "artwork_id": {
          "type": "string"
         },
         "placement": {
          "type": "string"
         },
         "validation": {
          "enum": [
           "PASS",
           "WARN",
           "FAIL"
          ],
          "type": "string"
         },
         "warnings": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "artwork_id",
         "placement",
         "validation",
         "warnings"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "size": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "variant_id": {
       "type": "string"
      }
     },
     "required": [
      "line_id",
      "product_id",
      "variant_id",
      "title",
      "color",
      "size",
      "quantity",
      "line_total_minor",
      "placements"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_step": {
    "description": "What the agent should do next, in plain language.",
    "type": "string"
   },
   "notes": {
    "description": "Things to tell the user before purchase.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "package_count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "packages": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "line_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "package": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ships_from": {
       "description": "Country code where the package is printed.",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "package",
      "line_ids",
      "ships_from"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "purchase_open": {
    "description": "False when this destination does not take orders yet or the quote expired. Then do not call purchase.",
    "type": "boolean"
   },
   "quote_id": {
    "description": "Use in purchase before expires_at.",
    "type": "string"
   },
   "ship_to": {
    "additionalProperties": {},
    "properties": {
     "country_code": {
      "type": "string"
     }
    },
    "required": [
     "country_code"
    ],
    "type": "object"
   },
   "shipping": {
    "additionalProperties": {},
    "properties": {
     "name": {
      "type": "string"
     },
     "price_minor": {
      "description": "Integer minor units (cents) of `currency`.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "transit_business_days": {
      "additionalProperties": {},
      "properties": {
       "max": {
        "type": [
         "number",
         "null"
        ]
       },
       "min": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "min",
       "max"
      ],
      "type": "object"
     }
    },
    "required": [
     "name",
     "price_minor",
     "transit_business_days"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "valid",
     "expired"
    ],
    "type": "string"
   },
   "tax": {
    "additionalProperties": {},
    "properties": {
     "amount_minor": {
      "description": "Integer minor units (cents) of `currency`.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "included_in_total": {
      "type": "boolean"
     },
     "label": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "rate_percent": {
      "type": "number"
     }
    },
    "required": [
     "label",
     "rate_percent",
     "amount_minor",
     "included_in_total",
     "note"
    ],
    "type": "object"
   },
   "totals": {
    "additionalProperties": {},
    "description": "total_minor is the full amount that the payer pays. Show total_formatted to the user. products_minor and shipping_minor are before VAT; tax_minor is the VAT included in the total, or 0 when tax is not collected.",
    "properties": {
     "products_minor": {
      "description": "Integer minor units (cents) of `currency`.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "shipping_minor": {
      "description": "Integer minor units (cents) of `currency`.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "tax_minor": {
      "description": "Integer minor units (cents) of `currency`.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total_formatted": {
      "type": "string"
     },
     "total_minor": {
      "description": "Integer minor units (cents) of `currency`.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "products_minor",
     "shipping_minor",
     "tax_minor",
     "total_minor",
     "total_formatted"
    ],
    "type": "object"
   }
  },
  "required": [
   "quote_id",
   "status",
   "expires_at",
   "currency",
   "items",
   "ship_to",
   "shipping",
   "packages",
   "package_count",
   "tax",
   "totals",
   "delivery_estimate_business_days",
   "delivery_estimate_dates",
   "purchase_open",
   "assumptions",
   "notes",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Get a delivered price quote"
}
