{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Publish data"
 },
 "description": "Publish data to a subscriber via the PayPerByte DataStream contract. Hashes the payload, records size on-chain, and settles the fee in USDC. Requires PRIVATE_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "data": {
    "description": "Data payload to publish (will be hashed on-chain)",
    "type": "string"
   },
   "maxFee": {
    "description": "Maximum fee in USDC willing to pay for this publish (e.g. 0.05)",
    "type": "number"
   },
   "subscriber": {
    "description": "Subscriber Ethereum address (0x...)",
    "type": "string"
   }
  },
  "required": [
   "subscriber",
   "data",
   "maxFee"
  ],
  "type": "object"
 },
 "name": "byte_publish_data",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "payloadHash": {
    "description": "keccak256 of the payload as recorded on-chain",
    "type": "string"
   },
   "payloadSize": {
    "description": "Payload size recorded on-chain (bytes)",
    "type": "number"
   },
   "success": {
    "description": "True if publish landed on-chain",
    "type": "boolean"
   },
   "txHash": {
    "description": "Publish transaction hash",
    "type": "string"
   }
  },
  "type": "object"
 }
}
