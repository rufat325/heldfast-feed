{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants the best short stretches of a talk to cut as clips, for example \"find the best 60 seconds\", \"which parts would make good shorts\". Pass the transcript_id from transcribe_media. Optional: count (1 to 5, default 3), min_seconds (default 30) and max_seconds (default 60). Returns each clip's start and end in seconds and as clock times, a hook line, the text, a 0 to 100 rank score and the reasons. Text only: it does not cut any video or audio. Pass library_id only if transcribe_media returned one.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "default": 3,
    "description": "How many clips to suggest (default 3).",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "library_id": {
    "description": "The library_id that transcribe_media returned. Only needed when transcribe_media returned one; leave it out otherwise.",
    "pattern": "^lib_[0-9a-f]{24}$",
    "type": "string"
   },
   "max_seconds": {
    "default": 60,
    "description": "Longest clip (default 60).",
    "maximum": 180,
    "minimum": 15,
    "type": "integer"
   },
   "min_seconds": {
    "default": 30,
    "description": "Shortest clip (default 30).",
    "maximum": 120,
    "minimum": 10,
    "type": "integer"
   },
   "transcript_id": {
    "description": "The transcript_id from transcribe_media or search_transcripts.",
    "pattern": "^tr_[0-9a-f]{16}$",
    "type": "string"
   }
  },
  "required": [
   "transcript_id"
  ],
  "type": "object"
 },
 "name": "suggest_clips",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "clips": {
    "items": {
     "properties": {
      "duration_seconds": {
       "type": "number"
      },
      "end": {
       "type": "number"
      },
      "from": {
       "description": "Start as a clock time",
       "type": "string"
      },
      "hook": {
       "type": "string"
      },
      "score": {
       "type": "integer"
      },
      "start": {
       "type": "number"
      },
      "text": {
       "type": "string"
      },
      "to": {
       "description": "End as a clock time",
       "type": "string"
      },
      "why": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "start",
      "end",
      "hook",
      "text",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "none"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "transcript_id": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "transcript_id",
   "as_of",
   "clips",
   "notes"
  ],
  "type": "object"
 },
 "title": "Suggest short clips from a transcript"
}
