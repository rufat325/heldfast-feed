{
 "description": "Submit a job application. Requires authentication. Returns application confirmation and next steps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "auth_token": {
    "description": "User bearer token for authentication",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 country code",
    "type": "string"
   },
   "cover_letter": {
    "description": "Cover letter text",
    "type": "string"
   },
   "job_id": {
    "description": "Job listing UUID",
    "format": "uuid",
    "type": "string"
   },
   "resume_url": {
    "description": "URL to resume/CV file",
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "auth_token"
  ],
  "type": "object"
 },
 "name": "apply_for_job"
}
