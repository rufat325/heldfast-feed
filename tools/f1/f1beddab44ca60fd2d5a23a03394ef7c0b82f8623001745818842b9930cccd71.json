{
 "description": "Unbiased random pick from a list; returns picked",
 "inputSchema": {
  "properties": {
   "count": {
    "default": 1,
    "description": "Number of picks",
    "type": "integer"
   },
   "names": {
    "items": {
     "description": "List entry",
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "unique": {
    "default": true,
    "description": "true = without replacement",
    "type": "boolean"
   }
  },
  "required": [
   "names"
  ],
  "type": "object"
 },
 "name": "draw"
}
