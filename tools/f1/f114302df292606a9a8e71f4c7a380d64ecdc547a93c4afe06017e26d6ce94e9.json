_kind":{"default":"","title":"Website Kind","type":"string"},"website_url":{"default":"","title":"Website Url","type":"string"}},"required":["slug","name","score"],"title":"SupplierHit","type":"object"}},"properties":{"answer":{"title":"Answer","type":"string"},"brief":{"$ref":"#/$defs/SearchBrief"},"filters":{"items":{"$ref":"#/$defs/AppliedFilter"},"title":"Filters","type":"array"},"follow_up_question":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null,"title":"Follow Up Question"},"has_more":{"default":false,"title":"Has More","type":"boolean"},"index_records":{"default":0,"title":"Index Records","type":"integer"},"limit":{"default":5,"title":"Limit","type":"integer"},"missing":{"items":{"type":"string"},"title":"Missing","type":"array"},"offset":{"default":0,"title":"Offset","type":"integer"},"retrieval":{"additionalProperties":{"anyOf":[{"type":"string"},{"type":"integer"}]},"title":"Retrieval","type":"object"},"suppliers":{"items":{"$ref":"#/$defs/SupplierHit"},"title":"Suppliers","type":"array"},"total_records":{"default":0,"title":"Total Records","type":"integer"}},"required":["answer","brief"],"title":"SearchResponse","type":"object"},"title":"Search CNC Compass suppliers"}
