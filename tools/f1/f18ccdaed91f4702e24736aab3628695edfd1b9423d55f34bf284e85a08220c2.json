    "description": "standard = 63\u00d788 mm; small = 59\u00d786 mm. Japanese Pok\u00e9mon uses standard; Yu-Gi-Oh! uses small. Case/outer whitespace accepted. Example: standard.",
    "enum": [
     "standard",
     "small"
    ],
    "examples": [
     "standard",
     "small"
    ],
    "type": "string"
   },
   "face": {
    "description": "Required: front or back (English). Ask the user before calling if unclear. Case/outer whitespace accepted, e.g. Front; reverse/obverse are rejected.",
    "enum": [
     "front",
     "back"
    ],
    "examples": [
     "front",
     "back"
    ],
    "type": "string"
   },
   "image_base64": {
    "description": "Actual base64 raster image bytes supplied by the client. Image data-URL prefix and whitespace/newlines are accepted and normalization is disclosed. Never invent bytes or substitute an attachment filename. Example syntax: data:image/png;base64,... (ellipsis is not valid bytes).",
    "examples": [
     "data:image/png;base64,iVBORw0KGgo="
    ],
    "maxLength": 12582912,
    "minLength": 4,
    "type": "string"
   },
   "image_url": {
    "description": "Public HTTPS image URL, port 443. Private network addresses and non-image responses are rejected. Use only a URL supplied by the user: never invent one. Example syntax: https://images.example.org/card.jpg (placeholder, never fetch it).",
    "examples": [
     "https://images.example.org/card.jpg"
    ],
    "format": "uri",
    "maxLength": 8192,
    "type": "string"
   }
  },
  "required": [
   "face"
  ],
  "type": "object"
 },
