{
 "description": "Create a GPT-4o Image task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "aspect_ratio": {
    "description": "Declared type: string. Known values: \"1:1\", \"3:2\", \"2:3\".",
    "type": "string"
   },
   "callback_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "enable_prompt_expansion": {
    "description": "Declared type: boolean.",
    "type": "boolean"
   },
   "mask_url": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "type": "string"
   },
   "output_count": {
    "description": "Declared type: integer. Known values: 1, 2, 4.",
    "type": "integer"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Declared type: string.",
    "type": "string"
   },
   "source_image_urls": {
    "description": "Declared type: array.",
    "items": {},
    "type": "array"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "aspect_ratio"
  ],
  "type": "object"
 },
 "name": "text_to_image"
}
