{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check SDK freshness"
 },
 "description": "Compare a published @mushi-mushi/* package version against the catalog (GET /v1/sdk/latest-version). Returns { package, current, latest, outdated } and, when outdated, suggestedActions (Sentry-style, max 1) pointing at search_mushi_docs plus the mushi-sdk-upgrade skill. Read-only. Use when Dependabot or mushi upgrade --check reports a drift, or before dispatching a fix that assumes a current SDK. Does not bump the pin \u2014 that stays a human/Dependabot change.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "current": {
    "description": "Installed version from package.json, if known (e.g. 1.27.0).",
    "type": "string"
   },
   "package": {
    "description": "npm package name (default @mushi-mushi/web). Examples: @mushi-mushi/web, @mushi-mushi/node, @mushi-mushi/core.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "check_sdk_version",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "current": {
    "type": "string"
   },
   "latest": {
    "type": "string"
   },
   "outdated": {
    "type": "boolean"
   },
   "package": {
    "type": "string"
   },
   "suggestedActions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "arguments": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "reason": {
       "type": "string"
      },
      "toolName": {
       "type": "string"
      },
      "type": {
       "const": "tool_call",
       "type": "string"
      }
     },
     "required": [
      "type",
      "toolName",
      "arguments",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "package"
  ],
  "type": "object"
 },
 "title": "Check SDK freshness"
}
