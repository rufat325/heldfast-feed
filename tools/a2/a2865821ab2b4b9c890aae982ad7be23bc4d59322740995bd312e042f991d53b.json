{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cart.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Set quantity for one customer cart item.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "item_id": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
    "type": "string"
   },
   "quantity": {
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "item_id",
   "quantity"
  ],
  "type": "object"
 },
 "name": "set_cart_quantity",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "propertyNames": {
   "type": "string"
  },
  "type": "object"
 },
 "title": "Set Cart Quantity"
}
