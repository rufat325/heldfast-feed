  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find alternatives"
 },
 "description": "Use this when a product is out of stock, too dear, or the person wants something similar to try. Pass one product id from find_products or a teas.co.uk product link. It returns products of the same kind and caffeine, near the same strength, split into cheaper and premium by price per cup, in stock first and closest match first. limit sets how many of each come back (default 3). Next: get_product for details, compare_products to compare, add_to_basket to buy.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Product id from find_products, or a teas.co.uk product link.",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "How many cheaper and how many premium alternatives, 1 to 10. Defaults to 3.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
