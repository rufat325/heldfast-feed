{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Archive / Move / Mark Email"
 },
 "description": "Archive, move (INBOX/ARCHIVE/TRASH/SPAM) or mark read/unread Email Assistant messages, exactly like the Email Assistant buttons (updates QuailOS and mirrors to the IMAP mailbox when the message came from an IMAP account). Nothing is permanently deleted. Owner/admin read/write AI keys only.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "archive | move (needs folder) | mark_read | mark_unread",
    "enum": [
     "archive",
     "move",
     "mark_read",
     "mark_unread"
    ],
    "type": "string"
   },
   "emailId": {
    "description": "Single message id",
    "type": "string"
   },
   "emailIds": {
    "description": "Message ids (1-50). Or use emailId for one.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "folder": {
    "description": "Target folder for action \"move\"",
    "enum": [
     "INBOX",
     "ARCHIVE",
     "TRASH",
     "SPAM"
    ],
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "action"
  ],
  "type": "object"
 },
 "name": "move_email"
}
