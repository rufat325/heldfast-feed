  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blocks": {
    "description": "how many blocks, newest first (max 25) (default 10)",
    "type": "string"
   },
   "chain": {
    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   }
  },
  "required": [
   "chain"
  ],
  "type": "object"
 },
 "name": "chain_block_series",
