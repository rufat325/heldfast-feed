{
 "description": "Gestiona solicitudes de permiso/vacaciones. Acciones: list (page, limit, user_id, status, start_date, end_date), get (id), create, update (id), delete (id), approve (id), reject (id), summary.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "approve",
     "reject",
     "summary"
    ],
    "type": "string"
   },
   "applicant_id": {
    "type": "number"
   },
   "checked_by": {
    "type": "number"
   },
   "end_date": {
    "type": "string"
   },
   "id": {
    "description": "ID de la solicitud",
    "type": "number"
   },
   "leave_type_id": {
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "reason": {
    "type": "string"
   },
   "start_date": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "total_days": {
    "type": "number"
   },
   "total_hours": {
    "type": "string"
   },
   "user_id": {
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "leaves"
}
