{
 "annotations": {},
 "description": "Set layout grids (columns, rows, square) on frames. [] removes them.",
 "inputSchema": {
  "properties": {
   "grids": {
    "description": "Grids. [] removes all.",
    "items": {
     "properties": {
      "alignment": {
       "description": "Default STRETCH",
       "enum": [
        "MIN",
        "MAX",
        "CENTER",
        "STRETCH"
       ],
       "type": "string"
      },
      "color": {
       "description": "Hex (default #FF0000)",
       "type": "string"
      },
      "count": {
       "description": "Count (default 12)",
       "type": "number"
      },
      "gutterSize": {
       "description": "Gutter (default 16)",
       "type": "number"
      },
      "offset": {
       "description": "Margin (default 0)",
       "type": "number"
      },
      "opacity": {
       "description": "Default 0.1",
       "type": "number"
      },
      "pattern": {
       "description": "Default GRID",
       "enum": [
        "COLUMNS",
        "ROWS",
        "GRID"
       ],
       "type": "string"
      },
      "sectionSize": {
       "description": "GRID cell size (default 8)",
       "type": "number"
      },
      "visible": {
       "description": "Default true",
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "mode": {
    "description": "replace (default) or append",
    "type": "string"
   },
   "nodeIds": {
    "description": "Frame, component, or section IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "nodeIds",
   "grids"
  ],
  "type": "object"
 },
 "name": "set_layout_grids"
}
