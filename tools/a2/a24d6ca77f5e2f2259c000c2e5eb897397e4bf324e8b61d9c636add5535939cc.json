   },
   "highUsd": {
    "type": "number"
   },
   "lowUsd": {
    "type": "number"
   },
   "methodologyRev": {
    "type": "string"
   }
  },
  "required": [
   "domain",
   "fairUsd",
   "lowUsd",
   "highUsd",
   "confidence",
   "methodologyRev",
   "contact"
  ],
  "type": "object"
 },
