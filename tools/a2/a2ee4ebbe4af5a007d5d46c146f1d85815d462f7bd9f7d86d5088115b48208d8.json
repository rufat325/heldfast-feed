{
 "description": "Types text on the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device_id": {
    "pattern": "^[\\w\\-.:]{1,256}$",
    "type": "string"
   },
   "text": {
    "maxLength": 10000,
    "type": "string"
   }
  },
  "required": [
   "device_id",
   "text"
  ],
  "type": "object"
 },
 "name": "type_text"
}
