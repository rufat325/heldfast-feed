{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the characters of an anime (by mal_id) with their roles and Japanese voice actors. Get the mal_id from search_anime.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "MyAnimeList numeric ID.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_anime_characters",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "characters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "favorites": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "mal_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "voice_actors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "mal_id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "characters"
  ],
  "type": "object"
 },
 "title": "Get anime characters"
}
