{
 "description": "Search a FAOSTAT domain's area, item, element, unit, or other definition table.",
 "inputSchema": {
  "properties": {
   "cursor": {
    "default": 0,
    "title": "Cursor",
    "type": "integer"
   },
   "dataset": {
    "title": "Dataset",
    "type": "string"
   },
   "dimension": {
    "title": "Dimension",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "title": "Limit",
    "type": "integer"
   },
   "query": {
    "title": "Query",
    "type": "string"
   }
  },
  "required": [
   "dataset",
   "dimension",
   "query"
  ],
  "title": "faostat_search_dimensionArguments",
  "type": "object"
 },
 "name": "faostat_search_dimension",
 "outputSchema": {
  "properties": {
   "cursor": {
    "default": 0,
    "title": "Cursor",
    "type": "integer"
   },
   "items": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "Items",
    "type": "array"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Next Cursor"
   },
   "total": {
    "title": "Total",
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total"
  ],
  "title": "CataloguePage",
  "type": "object"
 }
}
