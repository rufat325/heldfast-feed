{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "marketbrew:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when a team member asks which Google keywords a domain ranks for. This makes one billable DataForSEO request and returns at most 20 keywords.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "languageCode": {
    "default": "en",
    "description": "Two-letter language code.",
    "pattern": "^[a-z]{2}$",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locationCode": {
    "default": 2840,
    "description": "DataForSEO location code; defaults to United States.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "target": {
    "description": "Domain or subdomain without a URL scheme or path.",
    "maxLength": 253,
    "minLength": 1,
    "pattern": "^[a-z0-9.-]+$",
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "dataforseo_ranked_keywords",
 "title": "Get DataForSEO ranked keywords"
}
