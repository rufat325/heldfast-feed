{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Diff citation changes between time windows"
 },
 "description": "Diff cited_for between two time windows for a domain. Returns queries gained (cited now, not before baseline_until) and queries lost (cited before, not since current_since). Cache-only, no API spend. Use to track citation drift over time after publishing or migrating content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseline_until": {
    "description": "ISO date (or ISO datetime). Baseline window = all cache entries fetched on or before this timestamp.",
    "type": "string"
   },
   "current_since": {
    "description": "ISO date floor for the 'current' window. Defaults to baseline_until.",
    "type": "string"
   },
   "domain": {
    "description": "Domain to diff, e.g. 'automatelab.tech'.",
    "minLength": 1,
    "type": "string"
   },
   "engine": {
    "description": "Filter by engine. Omit to include all.",
    "enum": [
     "perplexity",
     "claude",
     "openai",
     "gemini",
     "bing_serp",
     "brave_serp",
     "google_ai_mode"
    ],
    "type": "string"
   }
  },
  "required": [
   "domain",
   "baseline_until"
  ],
  "type": "object"
 },
 "name": "domain_cited_for_diff",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baseline_until": {
    "description": "Upper bound of the baseline window.",
    "type": "string"
   },
   "counts": {
    "additionalProperties": false,
    "properties": {
     "baseline_unique_queries": {
      "type": "number"
     },
     "current_unique_queries": {
      "type": "number"
     },
     "gained": {
      "description": "Queries newly cited in the current window.",
      "type": "number"
     },
     "lost": {
      "description": "Queries cited in baseline but not current.",
      "type": "number"
     },
     "unchanged": {
      "description": "Queries cited in both windows.",
      "type": "number"
     }
    },
    "required": [
     "baseline_unique_queries",
     "current_unique_queries",
     "gained",
     "lost",
     "unchanged"
    ],
    "type": "object"
   },
   "current_since": {
    "description": "Lower bound of the current window.",
    "type": "string"
   },
   "domain": {
    "description": "Domain that was diffed.",
    "type": "string"
   },
   "engine_filter": {
    "description": "Engine filter applied, if any.",
    "type": "string"
   },
   "fetched_at": {
    "description": "UTC ISO-8601 timestamp.",
    "type": "string"
   },
   "gained": {
    "description": "Queries gained (newly cited) since the baseline.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "engine": {
       "type": "string"
      },
      "fetched_at": {
       "type": "string"
      },
      "query": {
       "type": "string"
      },
      "rank": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "query",
      "engine",
      "rank",
      "fetched_at",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lost": {
    "description": "Queries lost (were cited, no longer are).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "engine": {
       "type": "string"
      },
      "fetched_at": {
       "type": "string"
      },
      "query": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "query",
      "engine",
      "fetched_at",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "const": "local_cache",
    "type": "string"
   },
   "unchanged_queries": {
    "description": "Queries cited in both windows.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "domain",
   "baseline_until",
   "current_since",
   "fetched_at",
   "counts",
   "gained",
   "lost",
   "unchanged_queries",
   "source"
  ],
  "type": "object"
 }
}
