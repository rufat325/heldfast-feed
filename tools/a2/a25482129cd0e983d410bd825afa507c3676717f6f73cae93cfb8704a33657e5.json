{
 "description": "Build a one-shot video dossier with core metadata/transcript readiness, optionally extended with comments, sentiment, and provenance. [~3-10s]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "commentSampleSize": {
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "dryRun": {
    "type": "boolean"
   },
   "includeComments": {
    "type": "boolean"
   },
   "includeSentiment": {
    "type": "boolean"
   },
   "includeTranscriptSummary": {
    "type": "boolean"
   },
   "videoIdOrUrl": {
    "type": "string"
   }
  },
  "required": [
   "videoIdOrUrl"
  ],
  "type": "object"
 },
 "name": "buildVideoDossier"
}
