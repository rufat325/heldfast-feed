{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Rank manufacturers for a structured part spec. Returns scored matches with the reasons, so an agent can explain the choice to its user.",
 "inputSchema": {
  "properties": {
   "certifications": {
    "items": {
     "enum": [
      "iso-9001",
      "iso-14001",
      "iatf-16949",
      "iso-13485",
      "as9100",
      "en-1090",
      "iso-45001",
      "itar",
      "nadcap",
      "ul-listed",
      "rohs",
      "fda-registered",
      "cmmc"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "country": {
    "description": "Preferred country, ISO code or slug",
    "type": "string"
   },
   "file_formats": {
    "description": "CAD formats you can supply",
    "items": {
     "enum": [
      "step",
      "dxf",
      "dwg",
      "stl",
      "iges",
      "3mf",
      "gerber"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "industries": {
    "items": {
     "enum": [
      "automotive",
      "aerospace",
      "medical",
      "energy",
      "railway",
      "marine",
      "electronics",
      "food",
      "construction",
      "packaging",
      "defense",
      "consumer"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "type": "integer"
   },
   "materials": {
    "items": {
     "enum": [
      "aluminium",
      "steel",
      "stainless-steel",
      "titanium",
      "brass",
      "copper",
      "plastic"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "process": {
    "enum": [
     "laser-cutting",
     "cnc-machining",
     "sheet-metal",
     "3d-printing",
     "injection-molding",
     "pcb-assembly",
     "die-casting",
     "welding",
     "waterjet-cutting",
     "metal-stamping",
     "forging",
     "heat-treatment",
     "grinding-polishing",
     "casting",
     "wire-forming",
     "steel-construction",
     "surface-finishing"
    ],
    "type": "string"
   },
   "quantity": {
    "description": "Units wanted; favors prototype-friendly shops for small numbers and series producers for large ones",
    "type": "integer"
   },
   "tolerance_mm": {
    "description": "Tightest tolerance you need, in mm",
    "type": "number"
   }
  },
  "required": [
   "process"
  ],
  "type": "object"
 },
 "name": "match_manufacturers"
}
