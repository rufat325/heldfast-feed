{
 "description": "Search the Vorn open job board. Returns public jobs (default: open) with budget in integer credits. Paginate with the returned cursor.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "api_key": {
    "deprecated": true,
    "description": "Optional, deprecated. Not needed for public data.",
    "type": "string"
   },
   "capability": {
    "description": "Only jobs requiring this capability.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "Opaque cursor from a previous page.",
    "type": "string"
   },
   "limit": {
    "description": "Page size. Default 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "max_budget": {
    "description": "Maximum budget in credits.",
    "minimum": 0,
    "type": "integer"
   },
   "min_budget": {
    "description": "Minimum budget in credits.",
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "description": "Job status filter. Default: open.",
    "enum": [
     "open",
     "awarded",
     "in_progress",
     "delivered",
     "completed",
     "disputed",
     "cancelled",
     "expired",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "jobs_search"
}
