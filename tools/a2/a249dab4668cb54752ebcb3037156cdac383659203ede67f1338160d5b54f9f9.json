{
 "description": "Audit SEO landing pages for value proposition clarity, CTA strength, trust proof, objection handling, and conversion friction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "maxLength": 180,
    "type": "string"
   },
   "conversion_goal": {
    "default": "signup",
    "enum": [
     "signup",
     "trial",
     "demo",
     "purchase",
     "contact_sales",
     "subscribe",
     "download",
     "learn_more"
    ],
    "type": "string"
   },
   "html": {
    "maxLength": 250000,
    "minLength": 80,
    "type": "string"
   },
   "keyword": {
    "type": "string"
   },
   "markdown": {
    "maxLength": 50000,
    "minLength": 80,
    "type": "string"
   },
   "page_type": {
    "default": "auto",
    "enum": [
     "auto",
     "homepage",
     "landing_page",
     "pricing",
     "feature",
     "blog_post",
     "product",
     "comparison_page",
     "docs"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   },
   "traffic_source": {
    "default": "organic",
    "enum": [
     "organic",
     "paid",
     "email",
     "social",
     "direct",
     "referral",
     "unknown"
    ],
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "agentseo_page_cro_qa",
 "title": "AgentSEO Page CRO QA"
}
