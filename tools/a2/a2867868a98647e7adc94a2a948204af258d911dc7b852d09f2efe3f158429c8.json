{
 "description": "Render OpenSCAD (SCAD) source code into a PNG preview image. Provide the SCAD text in `scadCode` and optionally set `width`/`height` (pixels). Optional camera control is available via `cameraPreset` (named preset) or `cameraPosition` ({x,y,z}).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cameraPosition": {
    "description": "Camera position as { x,y,z }. Example: { x: 0, y: -25, z: 20 }",
    "properties": {
     "x": {
      "default": 0,
      "description": "Camera X position",
      "type": "number"
     },
     "y": {
      "default": -25,
      "description": "Camera Y position",
      "type": "number"
     },
     "z": {
      "default": 20,
      "description": "Camera Z position",
      "type": "number"
     }
    },
    "type": "object"
   },
   "cameraPreset": {
    "description": "A named camera preset used when `cameraPosition` is not provided",
    "enum": [
     "isometric",
     "front",
     "back",
     "left",
     "right",
     "top",
     "bottom"
    ],
    "type": "string"
   },
   "height": {
    "default": 600,
    "description": "The height of the output image in pixels (default: 600)",
    "type": "number"
   },
   "scadCode": {
    "description": "The OpenSCAD code to render",
    "type": "string"
   },
   "width": {
    "default": 800,
    "description": "The width of the output image in pixels (default: 800)",
    "type": "number"
   }
  },
  "required": [
   "scadCode"
  ],
  "type": "object"
 },
 "name": "render_scad_png",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_meta": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "annotations": {
    "additionalProperties": false,
    "properties": {
     "audience": {
      "items": {
       "enum": [
        "user",
        "assistant"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "lastModified": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "priority": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "data": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "type": {
    "const": "image",
    "type": "string"
   }
  },
  "required": [
   "type",
   "data",
   "mimeType"
  ],
  "type": "object"
 },
 "title": "Render OpenSCAD source to a PNG image"
}
