{
 "description": "Compare an analysis window with the preceding equal period to identify search gainers and losers",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "by": {
    "default": "query",
    "description": "Dimension used to compare performance",
    "enum": [
     "query",
     "page"
    ],
    "type": "string"
   },
   "endDate": {
    "description": "End date in YYYY-MM-DD; defaults to today",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum gainers and losers to return; defaults to 50 each",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "siteUrl": {
    "description": "Search Console property to analyze",
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "description": "Start date in YYYY-MM-DD; defaults to the latest 28-day window",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "compare_search_periods",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "currentTruncated": {
    "description": "Whether Search Console held more than 5000 rows for the current window",
    "type": "boolean"
   },
   "currentWindow": {
    "additionalProperties": false,
    "description": "Current comparison window",
    "properties": {
     "endDate": {
      "description": "Inclusive window end date",
      "type": "string"
     },
     "startDate": {
      "description": "Inclusive window start date",
      "type": "string"
     }
    },
    "required": [
     "startDate",
     "endDate"
    ],
    "type": "object"
   },
   "droppedAsUnknown": {
    "description": "Rows present on only one side whose other side was cut off, and so were excluded rather than counted as zero",
    "type": "number"
   },
   "gainers": {
    "description": "Rows with increased clicks",
    "items": {
     "additionalProperties": false,
     "properties": {
      "clicksCurrent": {
       "description": "Clicks in the current window",
       "type": "number"
      },
      "clicksDelta": {
       "description": "Current clicks minus previous clicks",
       "type": "number"
      },
      "clicksPrevious": {
       "description": "Clicks in the previous window",
       "type": "number"
      },
      "impressionsDelta": {
       "description": "Current impressions minus previous impressions",
       "type": "number"
      },
      "keys": {
       "description": "Dimension values in request order",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "positionDelta": {
       "description": "Current average position minus previous average position",
       "type": "number"
      }
     },
     "required": [
      "keys",
      "clicksCurrent",
      "clicksPrevious",
      "clicksDelta",
      "impressionsDelta",
      "positionDelta"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "losers": {
    "description": "Rows with decreased clicks",
    "items": {
     "additionalProperties": false,
     "properties": {
      "clicksCurrent": {
       "description": "Clicks in the current window",
       "type": "number"
      },
      "clicksDelta": {
       "description": "Current clicks minus previous clicks",
       "type": "number"
      },
      "clicksPrevious": {
       "description": "Clicks in the previous window",
       "type": "number"
      },
      "impressionsDelta": {
       "description": "Current impressions minus previous impressions",
       "type": "number"
      },
      "keys": {
       "description": "Dimension values in request order",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "positionDelta": {
       "description": "Current average position minus previous average position",
       "type": "number"
      }
     },
     "required": [
      "keys",
      "clicksCurrent",
      "clicksPrevious",
      "clicksDelta",
      "impressionsDelta",
      "positionDelta"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "previousTruncated": {
    "description": "Whether Search Console held more than 5000 rows for the previous window",
    "type": "boolean"
   },
   "previousWindow": {
    "additionalProperties": false,
    "description": "Immediately preceding equal-length window",
    "properties": {
     "endDate": {
      "description": "Inclusive window end date",
      "type": "string"
     },
     "startDate": {
      "description": "Inclusive window start date",
      "type": "string"
     }
    },
    "required": [
     "startDate",
     "endDate"
    ],
    "type": "object"
   },
   "siteUrl": {
    "description": "Search Console property analyzed",
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "currentWindow",
   "previousWindow",
   "currentTruncated",
   "previousTruncated",
   "droppedAsUnknown",
   "gainers",
   "losers"
  ],
  "type": "object"
 }
}
