{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List product releases, newest first. Filter by brand, product line, or date. Each release includes recorded case_sizes_mm, size_variants with size-attributable specifications, and buy_links. Unknown sizes are explicitly marked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brand": {
    "description": "One of: garmin, coros, suunto, apple, amazfit, wahoo, polar, whoop, oura",
    "type": "string"
   },
   "limit": {
    "description": "Max results, default 50",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "line": {
    "description": "One of: running, outdoor, cycling, lifestyle, handheld, dive, aviation, golf, marine, accessories, recovery",
    "type": "string"
   },
   "since": {
    "description": "Only releases on/after this date, \"YYYY\" or \"YYYY-MM\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_releases",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_via": {
    "description": "Source attribution for Endurance Wire",
    "type": "string"
   },
   "count": {
    "type": "integer"
   },
   "releases": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "available": {
       "type": "string"
      },
      "brand": {
       "type": "string"
      },
      "buy_links": {
       "description": "Verified buying destinations; an empty list does not mean out of stock",
       "items": {
        "additionalProperties": false,
        "properties": {
         "merchant": {
          "type": "string"
         },
         "region": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "merchant",
         "region",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "case_sizes_mm": {
       "description": "Recorded case sizes in mm; an empty list means unknown",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "colors": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "img": {
          "format": "uri",
          "type": "string"
         },
         "label": {
          "type": "string"
         }
        },
        "required": [
         "label",
         "img"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "date": {
       "description": "Announcement date, YYYY-MM or YYYY-MM-DD",
       "type": "string"
      },
      "family": {
       "type": "string"
      },
      "img": {
       "format": "uri",
       "type": "string"
      },
      "line": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "note": {
       "type": "string"
      },
      "price": {
       "description": "Historical launch price in its original currency, not a current offer",
       "type": "string"
      },
      "priceCurrency": {
       "description": "Defaults to USD when omitted",
       "enum": [
        "USD",
        "EUR"
       ],
       "type": "string"
      },
      "size_data_status": {
       "enum": [
        "recorded",
        "unknown"
       ],
       "type": "string"
      },
      "size_scope_note": {
       "description": "Limits on size-specific claims",
       "type": "string"
      },
      "size_variants": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "case_size_mm": {
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "notes": {
          "additionalProperties": {
           "type": "string"
          },
          "description": "Edition, material and other qualifications",
          "type": "object"
         },
         "specs": {
          "additionalProperties": {
           "type": "string"
          },
          "description": "Verified size-specific specifications, keyed by label",
          "type": "object"
         },
         "unresolved_specs": {
          "description": "Labels with no verified size-specific value",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "name",
         "case_size_mm",
         "specs",
         "notes",
         "unresolved_specs"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "src": {
       "description": "Manufacturer reference",
       "format": "uri",
       "type": "string"
      },
      "take": {
       "type": "string"
      }
     },
     "required": [
      "brand",
      "name",
      "line",
      "date",
      "price",
      "case_sizes_mm",
      "size_data_status",
      "size_scope_note",
      "size_variants",
      "buy_links"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "_via",
   "count",
   "releases"
  ],
  "type": "object"
 },
 "title": "Get releases"
}
