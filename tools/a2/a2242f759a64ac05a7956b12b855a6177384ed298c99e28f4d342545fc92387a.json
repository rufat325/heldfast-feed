{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Add a site"},"description":"Adds a site at a host, such as example.com, and returns the three proofs that can verify it: a DNS TXT record, a meta tag on the home page, and a file under `/.well-known/`. A team holds one site, so a team that already has a live site gets 409 `team_has_site`. A site belongs to one team at a time, so a host another team holds gets 409 `site_taken`. A root domain belongs to one team, so a host under the registrable domain of another team's site gets 409 `domain_taken`. Requires the admin role.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"host":{"type":"string"},"team":{"type":"string"}},"required":["host","team"],"type":"object"},"name":"addSite","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":true,"properties":{"host":{"type":"string"},"id":{"allOf":[{"pattern":"^[^A-Z]*$"}],"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-7[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12})$","type":"string"},"proofs":{"additionalProperties":true,"properties":{"dnsTxt":{"additionalProperties":true,"properties":{"name":{"type":"string"},"value":{"type":"string"}},"required":["name","value"],"type":"object"},"metaTag":{"additionalProperties":true,"properties":{"content":{"type":"string"},"html":{"type":"string"},"name":{"type":"string"},"url":{"type":"string"}},"required":["content","html","name","url"],"type":"object"},"wellKnownFile":{"additionalProperties":true,"properties":{"content":{"type":"string"},"url":{"type":"string"}},"required":["content","url"],"type":"object"}},"required":["dnsTxt","metaTag","wellKnownFile"],"type":"object"},"team":{"additionalProperties":true,"properties":{"id":{"type":"string"},"name":{"type":"string"}},"required":["id","name"],"type":"object"},"verification":{"anyOf":[{"additionalProperties":true,"properties":{"lastVerifiedAt":{"type":"null"},"method":{"anyOf":[{"enum":["dns_txt","meta_tag","well_known_file"],"type":"string"},{"type":"null"}]}},"required":["lastVerifiedAt","method"],"type":"object"},{"additionalProperties":true,"properties":{"lastVerifiedAt":{"type":"string"},"method":{"enum":["dns_txt","meta_tag","well_known_file"],"type":"string"}},"required":["lastVerifiedAt","method"],"type":"object"}]}},"required":["host","id","proofs","team","verification"],"type":"object"},"title":"Add a site"}
