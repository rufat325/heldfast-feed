{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a task"
 },
 "description": "Update a task \u2014 rename, re-describe, reassign (users replaces the whole list), set due date or priority, mark complete/incomplete, move to another task list or workflow status. Only the fields given are changed. Paymo: PUT /api/tasks/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "budget_hours": {
    "description": "New budget hours.",
    "minimum": 0,
    "type": "number"
   },
   "complete": {
    "description": "true = mark complete, false = reopen.",
    "type": "boolean"
   },
   "description": {
    "description": "New description.",
    "type": "string"
   },
   "due_date": {
    "description": "New due date.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "name": {
    "description": "New name.",
    "minLength": 1,
    "type": "string"
   },
   "priority": {
    "anyOf": [
     {
      "const": 25,
      "type": "number"
     },
     {
      "const": 50,
      "type": "number"
     },
     {
      "const": 75,
      "type": "number"
     },
     {
      "const": 100,
      "type": "number"
     }
    ],
    "description": "Priority: 25 low, 50 normal, 75 high, 100 critical."
   },
   "status_id": {
    "description": "Workflow status id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "task_id": {
    "description": "The task id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tasklist_id": {
    "description": "Move to this task list.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "users": {
    "description": "New FULL list of assignee user ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   }
  },
  "required": [
   "task_id"
  ],
  "type": "object"
 },
 "name": "paymo_update_task",
 "title": "Update a task"
}
