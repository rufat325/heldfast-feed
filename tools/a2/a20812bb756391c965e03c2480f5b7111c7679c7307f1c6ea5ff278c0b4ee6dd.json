{
 "description": "Suggest tactically interesting D&D 5e encounter compositions. Goes beyond XP math to recommend monster synergies, role combinations, and tactical notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "difficulty": {
    "default": "medium",
    "description": "Target difficulty",
    "enum": [
     "easy",
     "medium",
     "hard",
     "deadly"
    ],
    "type": "string"
   },
   "num_suggestions": {
    "default": 3,
    "description": "Number of encounter suggestions",
    "maximum": 5,
    "minimum": 1,
    "type": "number"
   },
   "party_level": {
    "description": "Average party level",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "party_size": {
    "description": "Number of party members",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "theme": {
    "description": "Optional theme filter (e.g. \"undead\", \"forest\", \"dungeon\", \"ambush\", \"horror\")",
    "type": "string"
   }
  },
  "required": [
   "party_size",
   "party_level"
  ],
  "type": "object"
 },
 "name": "suggest_encounter"
}
