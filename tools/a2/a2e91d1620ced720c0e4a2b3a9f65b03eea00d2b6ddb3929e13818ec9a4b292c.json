{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find Hyperliquid traders"
 },
 "description": "Use for a historical score or Sharpe ranking of the qualified trader cohort. Returns at most ten rows per page, with next_offset when more are available. Accepts an optional exact asset and leverage-tier filter. Not a market-wide ranking, 30-day PnL sort or personalized recommendation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^(?:[a-z][a-z0-9]*:)?k?[A-Z][A-Z0-9._/-]*$",
    "type": "string"
   },
   "leverage_tier": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "limit": {
    "default": 3,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "sort_by": {
    "default": "trader_score",
    "enum": [
     "trader_score",
     "sharpe"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_hyperliquid_traders",
 "title": "Find Hyperliquid traders"
}
