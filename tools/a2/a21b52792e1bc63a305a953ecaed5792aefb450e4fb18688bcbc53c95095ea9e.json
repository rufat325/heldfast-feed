{
 "description": "Paid Live Product Quote ($0.01 USDC). Retrieves explicitly published product price and stock from a public HTTPS product page before an agent buys; shipping, tax and unknown values remain null. Never purchases.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "destination": {
    "additionalProperties": false,
    "properties": {
     "country": {
      "maxLength": 2,
      "minLength": 2,
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     "postal_code": {
      "maxLength": 20,
      "type": "string"
     }
    },
    "required": [
     "country"
    ],
    "type": "object"
   },
   "quantity": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   },
   "variant": {
    "additionalProperties": false,
    "properties": {
     "color": {
      "maxLength": 80,
      "type": "string"
     },
     "size": {
      "maxLength": 80,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "get_live_quote"
}
