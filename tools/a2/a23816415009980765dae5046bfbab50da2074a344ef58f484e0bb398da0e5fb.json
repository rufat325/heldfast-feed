{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new immutable draft from a known revision with selected scene, character or model changes. Preserves other scene definitions; requires review and production approval again. Does not generate media or overwrite an approved revision.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "character_updates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "anchor_prompt": {
       "maxLength": 3000,
       "minLength": 1,
       "type": "string"
      },
      "canonical_description": {
       "maxLength": 3000,
       "minLength": 1,
       "type": "string"
      },
      "character_id": {
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "character_id"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "image_model_id": {
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "projectId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revisionId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "scene_updates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "character_ids": {
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 2,
       "type": "array"
      },
      "image_prompt": {
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "motion_prompt": {
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "scene_index": {
       "maximum": 11,
       "minimum": 0,
       "type": "integer"
      },
      "title": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "scene_index"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "style_anchor_prompt": {
    "description": "Self-contained prompt for the single reference frame that locks rendering medium, palette, lighting, and grain for every scene. No characters, no text, no interfaces.",
    "maxLength": 3000,
    "minLength": 1,
    "type": "string"
   },
   "video_model": {
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "projectId",
   "revisionId",
   "workspaceId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "video_storyboard_revise",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": true,
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Revise Selected Storyboard Scenes"
}
