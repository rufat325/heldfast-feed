{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Create a contact in FreeAgent \u2014 a client to invoice or a supplier to record bills against. Supply either an organisation name or a first/last name (or both).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address1": {
    "description": "First line of the address",
    "maxLength": 200,
    "type": "string"
   },
   "address2": {
    "description": "Second line of the address",
    "maxLength": 200,
    "type": "string"
   },
   "chargeSalesTax": {
    "description": "Whether to charge sales tax to this contact (default: Auto)",
    "enum": [
     "Auto",
     "Always",
     "Never"
    ],
    "type": "string"
   },
   "contactNameOnInvoices": {
    "description": "Show the person's name rather than the organisation on invoices",
    "type": "boolean"
   },
   "country": {
    "description": "Country (e.g. 'United Kingdom')",
    "maxLength": 100,
    "type": "string"
   },
   "defaultPaymentTermsInDays": {
    "description": "Default payment terms for this contact's invoices, in days",
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "email": {
    "description": "Contact email address",
    "format": "email",
    "type": "string"
   },
   "firstName": {
    "description": "Contact first name",
    "maxLength": 100,
    "type": "string"
   },
   "lastName": {
    "description": "Contact last name",
    "maxLength": 100,
    "type": "string"
   },
   "organisationName": {
    "description": "Company name (e.g. 'Example Client Ltd')",
    "maxLength": 200,
    "type": "string"
   },
   "phoneNumber": {
    "description": "Contact phone number",
    "maxLength": 50,
    "type": "string"
   },
   "postcode": {
    "description": "Postcode or ZIP",
    "maxLength": 20,
    "type": "string"
   },
   "region": {
    "description": "County, region or state",
    "maxLength": 100,
    "type": "string"
   },
   "salesTaxRegistrationNumber": {
    "description": "The contact's VAT registration number (e.g. 'DE123456789'). Required on the invoice for a reverse-charge sale, and for the EC Sales List.",
    "maxLength": 50,
    "type": "string"
   },
   "status": {
    "description": "Contact status (default Active)",
    "enum": [
     "Active",
     "Hidden"
    ],
    "type": "string"
   },
   "town": {
    "description": "Town or city",
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "freeagent_create_contact"
}
