{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search tours"
 },
 "description": "Search the TripWays catalog of bookable tours, day trips, and activities worldwide. Pass a natural-language query plus any filters you already know: destination, price range in USD, duration in hours, activity, theme, or cancellation policy. Returns ranked tours with bokun_id, title, from-price, duration, destinations, rating, cancellation policy, hero_image, the TripWays page (url), and checkout_url. For live dates, remaining seats, or a group total, use check_availability and get_price_quote.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activity": {
    "description": "Activity facet, e.g. food, hiking, snorkeling.",
    "maxLength": 60,
    "type": "string"
   },
   "cancellation": {
    "enum": [
     "free",
     "flexible",
     "partial",
     "non_refundable"
    ],
    "type": "string"
   },
   "destination": {
    "description": "Place name (city, region, country, or well-known area/landmark). Resolved against TripWays destinations; a landmark that is not a destination is added to the search text.",
    "maxLength": 120,
    "type": "string"
   },
   "duration_hours_max": {
    "minimum": 0,
    "type": "number"
   },
   "duration_hours_min": {
    "minimum": 0,
    "type": "number"
   },
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "price_max": {
    "minimum": 0,
    "type": "number"
   },
   "price_min": {
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Natural-language search, e.g. 'family food tour in Rome under $100'.",
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "theme": {
    "maxLength": 60,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_tours",
 "outputSchema": {
  "properties": {
   "destination_resolved": {
    "properties": {
     "alias": {
      "type": "string"
     },
     "browseable": {
      "type": "boolean"
     },
     "country_code": {
      "type": "string"
     },
     "display_name": {
      "type": "string"
     },
     "hierarchy": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "level": {
      "description": "country, region, city, or district.",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "resolved_via": {
      "description": "area_alias when a landmark maps to its parent destination.",
      "type": "string"
     },
     "tour_count": {
      "type": "integer"
     },
     "url": {
      "description": "The destination's TripWays page.",
      "type": "string"
     }
    },
    "type": "object"
   },
   "guidance": {
    "type": "string"
   },
   "note": {
    "description": "Why the list is empty or how the destination was read.",
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "tours": {
    "description": "Ranked tours; empty when nothing matched (see note).",
    "items": {
     "properties": {
      "activities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "bokun_id": {
       "description": "Tour id; the number in tripways.com/t/{id}.",
       "type": "string"
      },
      "bookable_natively": {
       "description": "True when checkout_url opens TripWays checkout; false when it opens the operator calendar.",
       "type": "boolean"
      },
      "cancellation": {
       "description": "free, flexible, partial, or non_refundable.",
       "type": "string"
      },
      "checkout_url": {
       "description": "TripWays checkout for this tour.",
       "type": "string"
      },
      "destinations": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "duration_hours": {
       "type": "number"
      },
      "duration_text": {
       "type": "string"
      },
      "from_price": {
       "description": "Lowest adult price.",
       "properties": {
        "amount": {
         "minimum": 0,
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "gttd_eligible": {
       "description": "Listed on Google Things to Do.",
       "type": "boolean"
      },
      "hero_image": {
       "description": "Main photo URL.",
       "type": "string"
      },
      "hotel_pickup": {
       "type": "boolean"
      },
      "rating": {
       "properties": {
        "count": {
         "type": "integer"
        },
        "low_confidence": {
         "description": "True when there are fewer than 10 reviews.",
         "type": "boolean"
        },
        "value": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "reason": {
       "description": "Why checkout works the way it does, e.g. pickup_required.",
       "type": [
        "string",
        "null"
       ]
      },
      "themes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "The tour's TripWays page.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Search tours"
}
