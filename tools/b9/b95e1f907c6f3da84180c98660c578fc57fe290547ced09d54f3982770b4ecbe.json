{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare feed readiness"
 },
 "description": "Run the same static feed through multiple platform rule packs and compare readiness scores, errors, warnings and validation issues.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content": {
    "description": "Feed content. Paste the JSON, XML, CSV, TSV or NDJSON payload directly. Maximum size is 2 MB.",
    "maxLength": 2000000,
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "description": "Optional input-format override. Omit or use auto to detect JSON, NDJSON, XML, CSV or TSV automatically.",
    "enum": [
     "auto",
     "json",
     "xml",
     "csv",
     "tsv",
     "ndjson"
    ],
    "type": "string"
   },
   "targets": {
    "description": "Optional list of validation targets. Omit to use every supported target.",
    "items": {
     "description": "Validation target. Choose a published-contract validator, readiness checker or the generic hotel master data audit.",
     "enum": [
      "wego",
      "google_hotel_center",
      "trivago",
      "meta_catalog",
      "criteo",
      "hotel_master_data"
     ],
     "type": "string"
    },
    "maxItems": 6,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "compare_feed_readiness",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "JSON",
     "XML",
     "CSV",
     "TSV",
     "NDJSON"
    ],
    "type": "string"
   },
   "records": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "targets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "errors": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "issues": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "code": {
          "type": "string"
         },
         "level": {
          "enum": [
           "error",
           "warning",
           "info"
          ],
          "type": "string"
         },
         "message": {
          "type": "string"
         },
         "rows": {
          "items": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "type": "array"
         }
        },
        "required": [
         "level",
         "code",
         "message"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "score": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "target": {
       "description": "Validation target. Choose a published-contract validator, readiness checker or the generic hotel master data audit.",
       "enum": [
        "wego",
        "google_hotel_center",
        "trivago",
        "meta_catalog",
        "criteo",
        "hotel_master_data"
       ],
       "type": "string"
      },
      "warnings": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "target",
      "score",
      "errors",
      "warnings",
      "issues"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "records",
   "format",
   "targets"
  ],
  "type": "object"
 },
 "title": "Compare feed readiness"
}
