{
 "description": "Get a Starknet block by number, hash, or \"pre_confirmed\".",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "block": {
    "description": "Block number, block hash (0x...), or \"pre_confirmed\".",
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
