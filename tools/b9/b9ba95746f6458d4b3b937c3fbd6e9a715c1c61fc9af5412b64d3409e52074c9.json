{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Open an inline editable email compose form before sending. Use this when the user wants to write or send an email, so they can review and edit the draft first. Do NOT use when the user asks to save a draft (use create_draft). This tool does not send the email directly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bcc": {
    "$ref": "#/properties/cc",
    "description": "BCC recipient(s)"
   },
   "body": {
    "description": "Email body",
    "type": "string"
   },
   "cc": {
    "description": "CC recipient(s)",
    "items": {
     "$ref": "#/properties/to/items"
    },
    "maxItems": 500,
    "type": "array"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address(es), e.g. [\"alice@example.com\"]",
    "items": {
     "format": "email",
     "maxLength": 254,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "to",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "compose_email"
}
