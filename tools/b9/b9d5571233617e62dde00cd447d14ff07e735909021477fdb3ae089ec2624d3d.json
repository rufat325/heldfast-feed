{
 "description": "Run NEAREST, DISTANCE, WITHIN, COUNT, DENSITY, COVERAGE, GAPS, or CLUSTER against cloud, cached, or local features. Optional year narrows year-split snapshots; year-split features default to the newest year (2026, then 2025, ...).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "type": "string"
   },
   "area_id": {
    "type": "string"
   },
   "database": {
    "type": "string"
   },
   "distanceMeters": {
    "default": 500,
    "minimum": 0,
    "type": "number"
   },
   "feature": {
    "items": {
     "type": [
      "string",
      "number"
     ]
    },
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 1000,
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "default": "auto",
    "enum": [
     "cloud",
     "offline",
     "auto"
    ],
    "type": "string"
   },
   "near": {
    "$ref": "#/properties/feature/items"
   },
   "primitive": {
    "enum": [
     "NEAREST",
     "DISTANCE",
     "WITHIN",
     "COUNT",
     "DENSITY",
     "COVERAGE",
     "GAPS",
     "CLUSTER"
    ],
    "type": "string"
   },
   "within": {
    "$ref": "#/properties/feature/items"
   },
   "year": {
    "description": "Optional snapshot year, for example 2026",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "required": [
   "primitive",
   "feature"
  ],
  "type": "object"
 },
 "name": "e2_compute",
 "title": "Compute over features"
}
