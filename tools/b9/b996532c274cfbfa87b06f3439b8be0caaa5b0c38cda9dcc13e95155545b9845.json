{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Content actions (classify pages + playbook)"
 },
 "description": "Return content action buckets and page evidence. By default the window length is N=7 days and GSC data is delayed by 3 days. To choose a window, pass start_date and end_date together: end_date must be today's date in Japan time, and N is end_date minus start_date (2-365 days; e.g. September 21 through September 28 sets N=7), so the pair describes a length ending today rather than the GSC source dates. The response separates `window` (actual JST GSC dates, inclusive) from `session_window` (sessions, revenue and AI metrics over N\u00d724 hours ending at database statement time). `session_window` gives the relative start/end and duration; exact timestamps are unavailable because the RPC does not return its `now()` value. Search classifications, thresholds, bucket_summary, row prioritization, caveats and limits are included in the response. site_id is optional when OAuth-authenticated. Google Search only; data lags 1-2 days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucket": {
    "enum": [
     "decaying",
     "striking",
     "rising",
     "dormant",
     "stable"
    ],
    "type": "string"
   },
   "end_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "site_id": {
    "format": "uuid",
    "type": "string"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
