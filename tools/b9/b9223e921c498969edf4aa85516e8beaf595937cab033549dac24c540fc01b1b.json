{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Keyless read of the public GitHub API for one repository: archived, forked, how long since the last push, open issue count, stars, license, topics \u2014 plus the flags an integrator actually acts on (archived, no license, unmaintained window). Does not read the source, the dependency tree, or anything private, and does not clone or build. Costs $0.001 USDC per call. Byte-identical to GET /market/github-repo-health?owner=modelcontextprotocol&repo=registry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "owner": {
    "description": "repository owner or org [required]",
    "type": "string"
   },
   "repo": {
    "description": "repository name [required]",
    "type": "string"
   }
  },
  "required": [
   "owner",
   "repo"
  ],
  "type": "object"
 },
 "name": "market_github_repo_health",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "archived": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "caveat": {
    "type": [
     "string",
     "null"
    ]
   },
   "createdAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "defaultBranch": {
    "type": [
     "string",
     "null"
    ]
   },
   "flags": {
    "items": {},
    "type": "array"
   },
   "fork": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "found": {
    "type": "boolean"
   },
   "fullName": {
    "type": "string"
   },
   "lastPushAgeDays": {
    "type": [
     "number",
     "null"
    ]
   },
   "licenseSpdx": {
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "openIssues": {
