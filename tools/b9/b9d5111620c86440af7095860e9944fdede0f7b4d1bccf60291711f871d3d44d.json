{
 "_meta": {
  "openai/toolInvocation/invoked": "Transactions ready",
  "openai/toolInvocation/invoking": "Fetching transactions\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "mcp:read"
    ],
    "type": "oauth2"
   }
