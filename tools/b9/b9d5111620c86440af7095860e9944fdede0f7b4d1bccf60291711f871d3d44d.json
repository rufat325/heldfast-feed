 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get recent league transaction activity: adds, drops, waivers, and trades. Completed activity is league-wide unless team_id is provided. For \"my moves,\" pass the selected league's user team ID from get_user_session; session context alone does not filter completed activity. Use get_league_info when team and owner names are needed. Rows are newest first and capped by count; check window, limitations, warning, and dropped_invalid_timestamp_count before claiming completeness. ESPN week selects a matchup period, and its structured source covers failed bids and trade lifecycle; a fallback can limit those types. Sleeper week selects a matchup week. Yahoo ignores week for completed activity and applies Flaim's rolling 30-day timestamp lookup. Yahoo team-filtered requests fetch one page of up to 100 league transactions before filtering; limitations.upstream_bound_reached means older matching rows inside the window may be missing, and raising count will not recover them. Yahoo type=waiver and type=pending_trade return the authenticated user's own pending items with no timestamp window; team_id only narrows those items. Yahoo pending rows can omit timestamp and date until Yahoo stamps them. Read-only. Current date is 2026-10-10.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Maximum transactions to return, newest first (default: 25, max: 100). Check window and limitations before claiming completeness.",
    "type": "number"
   },
   "league_id": {
    "description": "League ID (get from get_user_session)",
    "type": "string"
   },
   "platform": {
    "description": "Fantasy platform (e.g., \"espn\", \"yahoo\", \"sleeper\")",
    "enum": [
     "espn",
     "yahoo",
     "sleeper"
    ],
    "type": "string"
   },
   "season_year": {
    "description": "Season start year \u2014 use the season_year returned by get_user_session for this league; only pass an older year when the user explicitly asks about a past season. Basketball and hockey use the start year of a cross-year season (2024 = the 2024-25 season); football and baseball use the single season year (2025 = the 2025 season).",
    "type": "number"
   },
   "sport": {
    "description": "Sport type (e.g., \"football\", \"baseball\")",
    "enum": [
     "football",
     "baseball",
     "basketball",
     "hockey"
    ],
    "type": "string"
   },
   "team_id": {
    "description": "Optional team filter, applied before count and echoed as window.team_id. For \"my moves,\" pass the selected league's user team ID from get_user_session; omit for league-wide activity. ESPN team ID; Sleeper roster ID; Yahoo full team key or session team ID. limitations.team_filter_unattributed_rows reports rows without team_ids that could not match. An ESPN trade without trade_sides may identify only one side, so filtering for the other side can miss it. Yahoo filters one upstream page of up to 100, so limitations.upstream_bound_reached can mean older matching rows are missing.",
    "type": "string"
   },
   "type": {
    "description": "Optional transaction type filter. Sleeper supports add/drop/trade/waiver. Yahoo supports add/drop/trade plus waiver/pending_trade for the authenticated user's own pending items. ESPN supports every listed type except pending_trade via its structured source, including failed_bid and the trade lifecycle types; if ESPN has fallen back to its activity feed, those structured-only filters return ESPN_TRANSACTION_TYPE_UNAVAILABLE rather than an empty result.",
    "enum": [
     "add",
     "drop",
     "trade",
     "waiver",
     "pending_trade",
     "trade_proposal",
     "trade_decline",
     "trade_veto",
     "trade_uphold",
     "failed_bid"
    ],
    "type": "string"
   },
   "week": {
    "description": "Optional public week selector. ESPN accepts matchup period 0 or later (0 = preseason), including baseball, basketball, and hockey; omit it for the current and previous matchup periods. Sleeper accepts matchup week 1 or later; omit it for the current and previous week. Yahoo ignores week; Flaim applies a rolling 30-day timestamp lookup window for completed Yahoo transactions.",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "platform",
   "sport",
   "league_id",
   "season_year"
  ],
  "type": "object"
 },
 "name": "get_transactions",
