{
 "description": "Add contacts (by ID) to an audience.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "audienceId": {
    "description": "Audience ID",
    "type": "string"
   },
   "contactIds": {
    "description": "Contact IDs to add",
    "items": {
     "type": "string"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "audienceId",
   "contactIds"
  ],
  "type": "object"
 },
 "name": "add_contacts_to_audience"
}
