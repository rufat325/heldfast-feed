{
 "annotations": {
  "openWorldHint": true
 },
 "description": "Runs pip install and returns a structured summary of installed packages. WARNING: may execute untrusted code.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "constraint": {
    "description": "Path to constraints file for version pinning (-c FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "Preview what would be installed without actually installing (--dry-run)",
    "type": "boolean"
   },
   "editable": {
    "description": "Path to local package for editable install (-e PATH)",
    "maxLength": 4096,
    "type": "string"
   },
   "extraIndexUrl": {
    "description": "Extra package index URLs for additional registries",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "forceReinstall": {
    "default": false,
    "description": "Force reinstall of all packages even if already installed (--force-reinstall)",
    "type": "boolean"
   },
   "indexUrl": {
    "description": "Base URL of the Python Package Index (-i URL)",
    "maxLength": 65536,
    "type": "string"
   },
   "noDeps": {
    "default": false,
    "description": "Do not install package dependencies (--no-deps)",
    "type": "boolean"
   },
   "packages": {
    "default": [],
    "description": "Packages to install (empty for requirements.txt)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "path": {
    "description": "Working directory",
    "maxLength": 4096,
    "type": "string"
   },
   "pre": {
    "default": false,
    "description": "Include pre-release and development versions (--pre)",
    "type": "boolean"
   },
   "report": {
    "description": "Write JSON install report to file (--report FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "requirements": {
    "description": "Path to requirements file",
    "maxLength": 4096,
    "type": "string"
   },
   "target": {
    "description": "Install packages into target directory (-t DIR)",
    "maxLength": 4096,
    "type": "string"
   },
   "upgrade": {
    "default": false,
    "description": "Upgrade already-installed packages to the newest version (--upgrade / -U)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "pip-install",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alreadySatisfied": {
    "type": "boolean"
   },
   "dryRun": {
    "type": "boolean"
   },
   "error": {
    "type": "string"
   },
   "exitCode": {
    "type": "number"
   },
   "installed": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "success",
   "alreadySatisfied"
  ],
  "type": "object"
 },
 "title": "pip Install"
}
