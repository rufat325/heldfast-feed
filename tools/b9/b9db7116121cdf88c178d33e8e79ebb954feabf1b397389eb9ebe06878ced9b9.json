{
 "description": "Compute effective reputation score and authority tier for an agent in a given scope. Returns tier name, autonomy level, spend limit, and effective score.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentId": {
    "description": "Agent ID to check",
    "type": "string"
   },
   "principalId": {
    "description": "Principal who delegated authority",
    "type": "string"
   },
   "scope": {
    "description": "Scope to check reputation in (e.g. 'code_execution', 'commerce')",
    "type": "string"
   }
  },
  "required": [
   "agentId",
   "principalId",
   "scope"
  ],
  "type": "object"
 },
 "name": "resolve_authority"
}
