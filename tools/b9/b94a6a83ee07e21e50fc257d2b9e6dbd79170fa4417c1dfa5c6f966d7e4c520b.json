{
 "annotations": {},
 "description": "Create a text node (loads the font). To edit text, use set_text.",
 "inputSchema": {
  "properties": {
   "fillColor": {
    "description": "Text color hex (default black)",
    "type": "string"
   },
   "fontFamily": {
    "description": "Font family e.g. 'Roboto' (default Inter)",
    "type": "string"
   },
   "fontSize": {
    "description": "Font size (default 14)",
    "type": "number"
   },
   "fontStyle": {
    "description": "Font style e.g. 'Bold' (default Regular). The style must exist for the family.",
    "type": "string"
   },
   "name": {
    "description": "Layer name (default: the text)",
    "type": "string"
   },
   "parentId": {
    "description": "Parent node ID (default: current page)",
    "type": "string"
   },
   "text": {
    "description": "Text",
    "type": "string"
   },
   "x": {
    "description": "X (default 0)",
    "type": "number"
   },
   "y": {
    "description": "Y (default 0)",
    "type": "number"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "create_text"
}
