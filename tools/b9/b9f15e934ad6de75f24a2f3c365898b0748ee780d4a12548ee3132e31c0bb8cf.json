{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Sets the C-Corp share structure and returns the resulting total authorized capital. Pass use_default = true for the standard startup setup (10,000,000 shares at $0.0001 par), or use_default = false with authorized_shares and par_value for a custom structure. C-Corp only.",
 "inputSchema": {
  "properties": {
   "authorizedShares": {
    "maximum": 1000000000,
    "minimum": 0,
    "type": "integer"
   },
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "parValue": {
    "maxLength": 30,
    "pattern": "^([0-9]+\\.[0-9]{1,5})?$",
    "type": "string"
   },
   "useDefault": {
    "type": "boolean"
   }
  },
  "required": [
   "formationId"
  ],
  "type": "object"
 },
 "name": "formation_set_share_structure",
 "outputSchema": {
  "properties": {
   "formationId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "shareStructure": {
    "anyOf": [
     {
      "properties": {
       "authorizedShares": {
        "type": "string"
       },
       "isDefault": {
        "type": "boolean"
       },
       "parValuePerShare": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "totalCapital": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Set Share Structure"
}
