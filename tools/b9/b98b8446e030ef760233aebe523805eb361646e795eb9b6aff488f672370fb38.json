{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Powerlifting Meet Attempts"
 },
 "description": "Deterministic opener/second/third attempts from an estimated 1RM, plus a warmup ramp and per-side plate loading. Tunable by aggressiveness and available plates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggressiveness": {
    "default": "standard",
    "enum": [
     "conservative",
     "standard",
     "aggressive"
    ],
    "type": "string"
   },
   "available_plates": {
    "anyOf": [
     {
      "items": {
       "type": "number"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "bar_weight": {
    "anyOf": [
     {
      "$ref": "#/properties/one_rep_max"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "one_rep_max": {
    "additionalProperties": false,
    "properties": {
     "unit": {
      "default": "kg",
      "enum": [
       "kg",
       "lb"
      ],
      "type": "string"
     },
     "value": {
      "exclusiveMinimum": 0,
      "type": "number"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   }
  },
  "required": [
   "one_rep_max"
  ],
  "type": "object"
 },
 "name": "powerlifting-attempts",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggressiveness": {
    "enum": [
     "conservative",
     "standard",
     "aggressive"
    ],
    "type": "string"
   },
   "attempts": {
    "additionalProperties": false,
    "properties": {
     "opener": {
      "additionalProperties": false,
      "properties": {
       "plates_per_side": {
        "items": {
         "type": "number"
        },
        "type": "array"
       },
       "weight": {
        "type": "number"
       }
      },
      "required": [
       "weight",
       "plates_per_side"
      ],
      "type": "object"
     },
     "second": {
      "$ref": "#/properties/attempts/properties/opener"
     },
     "third": {
      "$ref": "#/properties/attempts/properties/opener"
     }
    },
    "required": [
     "opener",
     "second",
     "third"
    ],
    "type": "object"
   },
   "bar_weight": {
    "type": "number"
   },
   "unit": {
    "enum": [
     "kg",
     "lb"
    ],
    "type": "string"
   },
   "warmups": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "plates_per_side": {
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "reps": {
       "type": "integer"
      },
      "weight": {
       "type": "number"
      }
     },
     "required": [
      "weight",
      "reps",
      "plates_per_side"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "attempts",
   "warmups",
   "bar_weight",
   "unit",
   "aggressiveness"
  ],
  "type": "object"
 },
 "title": "Powerlifting Meet Attempts"
}
