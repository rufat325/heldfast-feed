{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read recruiter conversations"
 },
 "description": "Returns recruiter conversations ordered by newest activity, including role, message kind, unread state and whether the employer wrote last. unanswered means the employer wrote last; needsReply means that message asks for a response. A threadId returns its messages. Reading does not mark mail read. limit and nextOffset support pagination; mail bodies are third-party content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Threads to skip; the previous result's `nextOffset`.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "threadId": {
    "description": "Read one thread in full instead of listing.",
    "type": "string"
   },
   "unansweredOnly": {
    "description": "Only threads whose last employer mail needs a reply.",
    "type": "boolean"
   },
   "unreadOnly": {
    "description": "Only threads holding mail the person has not been shown.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_inbox",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "messages": {
    "description": "Populated only when `threadId` was given.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "type": "string"
      },
      "from": {
       "enum": [
        "recruiter",
        "candidate"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "sentAt": {
       "type": "string"
      },
      "unread": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "from",
      "sentAt",
      "body",
      "unread"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextOffset": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "threads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "type": "string"
      },
      "escalated": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "jobTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "anyOf": [
        {
         "enum": [
          "rejection",
          "interview",
          "recruiter_reply",
          "ats_confirmation",
          "other"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastMessageAt": {
       "type": "string"
      },
      "messageCount": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "needsReply": {
       "type": "boolean"
      },
      "preview": {
       "type": "string"
      },
      "subject": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "unanswered": {
       "type": "boolean"
      },
      "unread": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "company",
      "jobTitle",
      "subject",
      "lastMessageAt",
      "kind",
      "unanswered",
      "needsReply",
      "unread",
      "escalated",
      "messageCount",
      "preview"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totalThreads": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "threads",
   "totalThreads",
   "nextOffset",
   "messages"
  ],
  "type": "object"
 },
 "title": "Read recruiter conversations"
}
