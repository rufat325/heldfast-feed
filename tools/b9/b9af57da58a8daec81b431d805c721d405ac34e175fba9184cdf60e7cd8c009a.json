{
 "description": "Set a new expiry, ttl_days from now (1 to 365; must be later than the current expiry). Costs $0.01 USDC.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Item id, e.g. itm_...",
    "type": "string"
   },
   "secret": {
    "description": "The item's secret (sk_...), returned once by store.",
    "type": "string"
   },
   "ttl_days": {
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id",
   "secret",
   "ttl_days"
  ],
  "type": "object"
 },
 "name": "extend"
}
