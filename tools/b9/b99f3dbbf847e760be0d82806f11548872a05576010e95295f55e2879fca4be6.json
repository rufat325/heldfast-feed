   "format": {
    "enum": [
     "talking",
     "faceless",
     "motion"
    ]
   },
   "name": {
    "maxLength": 60,
    "type": "string"
   },
   "operation_id": {
    "description": "A stable ID for this authorized request. Preserve it on retries. Use a new ID only for a deliberate new request.",
    "pattern": "^[a-zA-Z0-9_.:-]{1,100}$",
    "type": "string"
   },
   "reference": {
    "additionalProperties": false,
    "properties": {
     "download_url": {
      "format": "uri",
      "type": "string"
     },
     "file_id": {
      "minLength": 1,
      "type": "string"
     },
     "file_name": {
      "type": "string"
     },
     "mime_type": {
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "reference_url": {
    "format": "uri",
    "type": "string"
   }
  },
  "type": "object"
 },
