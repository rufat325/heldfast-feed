      "boolean|null"
     ],
     "type": "string"
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
