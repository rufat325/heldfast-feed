{
 "description": "List items in the user's media library. Filter by type (image, video, gif, clip) and folder. Paginated.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "type": "string"
   },
   "folder": {
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "enum": [
     "newest",
     "oldest"
    ],
    "type": "string"
   },
   "type": {
    "enum": [
     "image",
     "video",
     "gif",
     "clip"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_media",
 "title": "List media"
}
