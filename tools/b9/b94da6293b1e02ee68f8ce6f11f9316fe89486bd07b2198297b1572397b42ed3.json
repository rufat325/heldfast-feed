{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List all drafts",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeSpamTrash": {
    "default": false,
    "description": "Include spam and trash in results",
    "type": "boolean"
   },
   "maxResults": {
    "default": 10,
    "description": "Maximum number of drafts to return",
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "pageToken": {
    "description": "Page token for pagination",
    "type": "string"
   },
   "q": {
    "description": "Search query to filter drafts",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "drafts_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "drafts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "message": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "threadId": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "threadId"
       ],
       "type": "object"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextPageToken": {
    "type": "string"
   },
   "resultSizeEstimate": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "List drafts"
}
