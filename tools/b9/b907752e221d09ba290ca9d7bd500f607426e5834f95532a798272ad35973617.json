{
 "description": "Bind your EVM wallet after signing the challenge message. This verifies wallet ownership. Required once before confirming USDC deposits in production.",
 "inputSchema": {
  "properties": {
   "chain": {
    "description": "Blockchain network (default: base)",
    "enum": [
     "base"
    ],
    "type": "string"
   },
   "nonce": {
    "description": "Nonce from get_wallet_challenge",
    "type": "string"
   },
   "signature": {
    "description": "Signature over the challenge message (personal_sign)",
    "type": "string"
   },
   "wallet_address": {
    "description": "0x-prefixed EVM address (sender wallet)",
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "nonce",
   "signature"
  ],
  "type": "object"
 },
 "name": "bind_wallet"
}
