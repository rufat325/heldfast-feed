{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate what a Southwest Airlines ticket earns (miles or points, and status credit where it applies), using cwsi.net's calculator and the airline's published rules. Unofficial.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "card": {
    "default": "none",
    "description": "Paying with a Southwest card. none = No; PL = Plus (+2 per $1); PR = Premier (+3 per $1); PY = Priority (+4 per $1).",
    "enum": [
     "none",
     "PL",
     "PR",
     "PY"
    ],
    "type": "string"
   },
   "fare": {
    "default": "CH",
    "description": "Fare type. CE = Choice Extra (14 per $1); CP = Choice Preferred (10 per $1); CH = Choice (6 per $1); BA = Basic (2 per $1).",
    "enum": [
     "CE",
     "CP",
     "CH",
     "BA"
    ],
    "type": "string"
   },
   "flights": {
    "default": 1,
    "description": "Flights on this ticket. A-List also needs 20 flights (A-List Preferred 40), counted in place of points.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "price": {
    "description": "Ticket price (base fare, without taxes and fees) in US dollars. Shown on your receipt as the base fare, before taxes and fees.",
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "status": {
    "default": "Base",
    "description": "Your Rapid Rewards status. Base = Base (No status); A-List = A-List (+25%); A-List Preferred = A-List Preferred (+100%).",
    "enum": [
     "Base",
     "A-List",
     "A-List Preferred"
    ],
    "type": "string"
   }
  },
  "required": [
   "price"
  ],
  "type": "object"
 },
 "name": "calculate_southwest_points",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "airline": {
    "type": "string"
   },
   "breakdown": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "calculator": {
    "type": "string"
   },
   "headline": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "link": {
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "progress": {
    "additionalProperties": false,
    "properties": {
     "earned": {
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "tiers": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "name": {
         "type": "string"
        },
        "threshold": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "threshold"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "title",
     "earned",
     "tiers"
    ],
    "type": "object"
   }
  },
  "required": [
   "airline",
   "calculator",
   "inputs",
   "headline",
   "breakdown",
   "notes",
   "link"
  ],
  "type": "object"
 },
 "title": "Southwest Rapid Rewards Calculator"
}
