          "null"
         ]
        },
        "source_url": {
         "type": "string"
        }
       },
       "required": [
        "fields",
        "source_url",
        "dataset_id",
        "data_vintage",
        "retrieved_at"
       ],
       "type": "object"
      },
      "minItems": 1,
      "type": "array"
     },
     "license": {
      "description": "Regime legal do dado",
      "type": [
       "string",
       "null"
      ]
     },
     "retrieval": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "anomalies": {
          "description": "Anomalias superadas at\u00e9 o sucesso, somadas por classe, em ordem fixa; [] se nenhuma",
          "items": {
