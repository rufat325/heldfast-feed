{
 "_meta": {
  "openai/toolInvocation/invoked": "Workflow ranking ready",
  "openai/toolInvocation/invoking": "Ranking workflows\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Rank 1\u201312 user-described workflows by value, predictability, judgment, sensitivity, and integration complexity, then recommend automate, assist, or discovery. Each workflow requires caller-supplied weekly hours, predictability, judgment required, error cost, data sensitivity, and system count. Ask for missing facts rather than inventing values.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "workflows": {
    "items": {
     "properties": {
      "dataSensitivity": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "errorCost": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "judgmentRequired": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "predictability": {
       "enum": [
        "low",
        "medium",
        "high"
       ],
       "type": "string"
      },
      "systemsCount": {
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "weeklyHours": {
       "maximum": 500,
       "minimum": 0.25,
       "type": "number"
      }
     },
     "required": [
      "name",
      "weeklyHours",
      "predictability",
      "judgmentRequired",
      "errorCost",
      "dataSensitivity",
      "systemsCount"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "workflows"
  ],
  "type": "object"
 },
 "name": "prioritize_automation_workflows",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "guardrails": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rankedWorkflows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "humanReviewRequired": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "rationale": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "recommendation": {
       "enum": [
        "automate",
        "assist",
        "discovery"
       ],
       "type": "string"
      },
      "score": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "score",
      "recommendation",
      "humanReviewRequired",
      "rationale"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "recommendedFirstWorkflow": {
    "type": "string"
   }
  },
  "required": [
   "rankedWorkflows",
   "recommendedFirstWorkflow",
   "guardrails"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Prioritize automation workflows"
}
