 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read Shorti's arena"
 },
 "description": "Shorti(\uc1fc\ud2f0) for \u00abwhat has nobody shot yet?\u00bb or \u00ab\uc544\uc9c1 \uc544\ubb34\ub3c4 \uc548 \ucc0d\uc740 \uac70 \ubb50 \uc788\uc5b4?\u00bb. The arena's open spots, first recorded takes, later breakouts and entrant standings. view='spots': open spots, their words, dates and how to shoot; 'board': first recorded takes and finds; 'entrant': one opted-in entrant's standing; `kind` filters. Unread: not_run, never an empty board.",
 "inputSchema": {
  "properties": {
   "cursor": {
    "description": "A previous answer's next_cursor.",
    "pattern": "^\\d{1,6}$",
    "type": "string"
   },
   "entrant": {
    "pattern": "^ae_[a-z2-7]{16}$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "move",
     "vary",
     "mix",
     "about",
     "found"
    ],
    "type": "string"
   },
   "lang": {
    "default": "ko",
    "enum": [
     "ko",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "How many rows a page.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lineage": {
    "pattern": "^lin_[A-Za-z0-9_.-]{1,156}$",
    "type": "string"
   },
   "view": {
    "enum": [
     "spots",
     "board",
     "entrant"
    ],
    "type": "string"
   }
  },
  "required": [
   "view"
  ],
  "type": "object"
 },
 "name": "shorti_arena",
 "outputSchema": {
  "properties": {},
  "type": "object"
 },
 "title": "Read Shorti's arena"
}
