  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Set sales quotas two ways and compare: top-down (revenue target split across reps at an expected attainment) and bottom-up (what each rep can realistically close). See the full version at https://rahuldsarker.co/calculators/sales-quota-calculator",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attainmentPct": {
    "description": "Expected average quota attainment, as a percentage (e.g. 80)",
    "type": "number"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "cycleMonths": {
    "description": "Average sales cycle in months",
    "type": "number"
   },
   "dealSize": {
    "description": "Average deal size",
    "type": "number"
   },
   "openOppsPerRep": {
    "description": "Opportunities each rep works at a time",
    "type": "number"
   },
   "rampPct": {
    "description": "Average rep productivity after ramp, as a percentage (100 if fully ramped)",
    "type": "number"
   },
   "reps": {
    "description": "Number of quota-carrying reps",
    "type": "number"
   },
   "target": {
    "description": "Annual revenue target for the team",
    "type": "number"
   },
   "winRatePct": {
    "description": "Win rate, as a percentage",
    "type": "number"
   }
  },
  "required": [
   "target",
   "reps",
   "attainmentPct",
   "openOppsPerRep",
   "cycleMonths",
   "winRatePct",
   "dealSize",
   "rampPct"
  ],
  "type": "object"
 },
 "name": "sales_quota_calculator",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
