{
 "description": "Query the verified failure\u2192solution corpus (scrubbed problem/solution pairs with fault attribution; held-out solutions and other orgs\u2019 proprietary entries are never returned). Requires failures:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "Filter by domain hint.",
    "type": "string"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "openOnly": {
    "description": "Only open-contribution entries (cross-org readable).",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "opentrain_query_failure_corpus",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
