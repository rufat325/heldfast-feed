{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Report viewed, called, succeeded, failed or skipped capability status, or task stage. Usage and outcomes remain client-reported.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "current_stage": {
    "maxLength": 100,
    "type": "string"
   },
   "reported_cost_usd": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "reported_tool_turns": {
    "default": 0,
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "request_id": {
    "maxLength": 120,
    "minLength": 8,
    "type": "string"
   },
   "session_id": {
    "maxLength": 80,
    "type": "string"
   },
   "summary": {
    "default": "",
    "maxLength": 500,
    "type": "string"
   },
   "type": {
    "enum": [
     "viewed",
     "called",
     "succeeded",
     "failed",
     "skipped",
     "stage"
    ],
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "request_id",
   "type"
  ],
  "type": "object"
 },
 "name": "record_task_event"
}
