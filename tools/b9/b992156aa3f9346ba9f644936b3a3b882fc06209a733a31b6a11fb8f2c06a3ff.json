{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Suggest completions for the next segment of a partly typed postcode.",
 "inputSchema": {
  "properties": {
   "partial": {
    "description": "The start of a code, e.g. 'EK 01 A'.",
    "maxLength": 32,
    "minLength": 1,
    "title": "Partial",
    "type": "string"
   }
  },
  "required": [
   "partial"
  ],
  "title": "autocomplete_postcodeArguments",
  "type": "object"
 },
 "name": "autocomplete_postcode",
 "outputSchema": {
  "$defs": {
   "Completion": {
    "properties": {
     "code": {
      "description": "The value of the next segment, e.g. A03, not a full prefix.",
      "title": "Code",
      "type": "string"
     },
     "label": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "A name for the code, when NIPOST sends one.",
      "title": "Label"
     }
    },
    "required": [
     "code"
    ],
    "title": "Completion",
    "type": "object"
   }
  },
  "properties": {
   "segment": {
    "anyOf": [
     {
      "enum": [
       "state",
       "lga",
       "district",
       "area",
       "unit"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The segment being completed.",
    "title": "Segment"
   },
   "suggestions": {
    "items": {
     "$ref": "#/$defs/Completion"
    },
    "title": "Suggestions",
    "type": "array"
   }
  },
  "required": [
   "segment",
   "suggestions"
  ],
  "title": "Completions",
  "type": "object"
 },
 "title": "Autocomplete a Nigerian postcode"
}
