{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Fix a video's details"
 },
 "description": "Use this when someone wants to correct a tutorial video's language, device, dimensions, file link, subtitles, chapters or thumbnail. Returns the updated video record; fields left out keep their values and identical values change nothing. Not for re-rendering the video itself.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chaptersUrl": {
    "$ref": "#/properties/url",
    "description": "New public https URL of the chapters track"
   },
   "device": {
    "description": "New device: computer, tablet or smartphone",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "duration": {
    "description": "New duration in seconds, up to 86400",
    "maximum": 86400,
    "minimum": 0,
    "type": "number"
   },
   "fileSize": {
    "description": "New file size in bytes",
    "maximum": 1000000000000000,
    "minimum": 0,
    "type": "number"
   },
   "format": {
    "description": "New container or codec, e.g. mp4 or webm",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "height": {
    "description": "New height in pixels, 1 to 100000",
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   },
   "locale": {
    "description": "New language code, e.g. en or pt-BR",
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "subtitlesUrl": {
    "$ref": "#/properties/url",
    "description": "New public https URL of a WebVTT subtitle track"
   },
   "thumbnailUrl": {
    "$ref": "#/properties/url",
    "description": "New public https URL of the poster image"
   },
   "url": {
    "description": "New public https URL of the video file",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "videoId": {
    "description": "Video to correct",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "width": {
    "description": "New width in pixels, 1 to 100000",
    "exclusiveMinimum": 0,
    "maximum": 100000,
    "type": "integer"
   }
  },
  "required": [
   "videoId"
  ],
  "type": "object"
 },
 "name": "update_video",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "updated",
     "unchanged",
     "not-found"
    ],
    "type": "string"
   },
   "video": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "chaptersUrl": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "device": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "duration": {
        "anyOf": [
         {
          "maximum": 86400,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "fileSize": {
        "anyOf": [
         {
          "maximum": 1000000000000000,
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "format": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "height": {
        "anyOf": [
         {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 64,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locale": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "subtitlesUrl": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "thumbnailUrl": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "tutorialId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "width": {
        "anyOf": [
         {
          "maximum": 100000,
          "minimum": 0,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "projectId",
       "tutorialId",
       "url",
       "locale",
       "device",
       "format",
       "width",
       "height",
       "duration",
       "fileSize",
       "chaptersUrl",
       "subtitlesUrl",
       "thumbnailUrl",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "video"
  ],
  "type": "object"
 },
 "title": "Fix a video's details"
}
