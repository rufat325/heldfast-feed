{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Bricks for a single-wythe wall from its area, the brick face size and the mortar joint. Defaults are a modular brick with a \u215c in joint. Formula: Bricks per sq ft = 144 \u00f7 ((length + joint) \u00d7 (height + joint)); bricks = (wall area \u2212 openings) \u00d7 bricks per sq ft \u00d7 (1 + waste%).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "joint_in": {
    "description": "Mortar joint (in); default 0.375",
    "type": "number"
   },
   "openings_sqft": {
    "description": "Openings to subtract (sq ft); default 0",
    "type": "number"
   },
   "unit_height_in": {
    "description": "Brick height (actual) (in); default 2.25",
    "type": "number"
   },
   "unit_length_in": {
    "description": "Brick length (actual) (in); default 7.625",
    "type": "number"
   },
   "wall_height_ft": {
    "description": "Wall height (ft); default 8",
    "type": "number"
   },
   "wall_length_ft": {
    "description": "Wall length (ft); default 20",
    "type": "number"
   },
   "waste_pct": {
    "description": "Waste allowance (%); default 5",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calc_brick",
 "title": "Brick Calculator (How Many Bricks for a Wall)"
}
