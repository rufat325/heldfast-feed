{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Wait for a run to settle (completed, failed, or needs_input) and return it with the agent's final reply. If it is still running when the wait ends, the reply has wait_timed_out: true \u2014 call wait_for_run again.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "run_id": {
    "description": "A run id (trun_...).",
    "type": "string"
   },
   "timeout_seconds": {
    "description": "How long to wait for the run to finish before returning. Defaults to, and is capped at, 300 s when your client accepts a streamed reply (text/event-stream), 90 s otherwise. The run keeps going when the wait ends first.",
    "maximum": 300,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "run_id"
  ],
  "type": "object"
 },
 "name": "wait_for_run",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A task run \u2014 one delegated job and what is known about its state.",
  "properties": {
   "chat_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "completed_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "created_at": {
    "format": "date-time",
    "type": "string"
   },
   "credits_consumed": {
    "type": "integer"
   },
   "error_message": {
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "object": {
    "const": "task_run",
    "type": "string"
   },
   "pending_approval_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "result": {
    "type": [
     "string",
     "null"
    ]
   },
   "reused": {
    "type": "boolean"
   },
   "started_at": {
    "format": "date-time",
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "enum": [
     "pending",
     "running",
     "completed",
     "failed",
     "needs_input",
     "timed_out",
     "unknown",
     "skipped"
    ],
    "type": "string"
   },
   "summary": {
    "type": [
     "string",
     "null"
    ]
   },
   "task_id": {
    "type": "string"
   },
   "task_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "wait_timed_out": {
    "description": "The wait ended first. The work is still running: follow it with the tool next_step names.",
    "type": "boolean"
   }
  },
  "required": [
   "object",
   "id",
   "task_id",
   "status",
   "created_at"
  ],
  "type": "object"
 }
}
