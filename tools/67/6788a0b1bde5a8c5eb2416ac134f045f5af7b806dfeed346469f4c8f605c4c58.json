{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Apply the exact reviewed database restore after user confirmation with confirm=true and review_digest. Queues one restore into the reviewed NEW database; the current one keeps serving and is never overwritten. Acceptance is not verified completion. Repeating the same plan returns its receipt without a second job. Requires deploy scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "type": "boolean"
   },
   "restore_plan_id": {
    "pattern": "^rspl_[a-f0-9]{24}$",
    "type": "string"
   },
   "review_digest": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "restore_plan_id",
   "review_digest",
   "confirm"
  ],
  "type": "object"
 },
 "name": "impreza_apply_database_restore",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "receipt": {
      "properties": {
       "accepted_at": {
        "type": "string"
       },
       "backup_id": {
        "type": "string"
       },
       "command_id": {
        "type": "string"
       },
       "job_deployment_id": {
        "type": "string"
       },
       "plan_id": {
        "type": "string"
       },
       "restore": {
        "type": "string"
       },
       "restore_database": {
        "type": "string"
       },
       "status": {
        "const": "accepted",
        "type": "string"
       },
       "transport_id": {
        "type": "string"
       }
      },
      "required": [
       "plan_id",
       "command_id",
       "job_deployment_id",
       "transport_id",
       "backup_id",
       "restore_database",
       "status",
       "accepted_at",
       "restore"
      ],
      "type": "object"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "receipt",
     "replayed"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Apply database restore"
}
