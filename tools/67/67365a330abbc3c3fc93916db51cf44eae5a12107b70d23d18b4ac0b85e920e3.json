{
 "_meta": {
  "openai/toolInvocation/invoked": "Deploy sessions listed",
  "openai/toolInvocation/invoking": "Listing deploy sessions"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return staging sessions for the team this token belongs to. Defaults to currently-active ones (open + committing). Up to 50 rows.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "status": {
    "description": "Filter by status. Default lists 'open' and 'committing' (the actionable ones). Pass an explicit status to inspect history.",
    "enum": [
     "open",
     "committing",
     "committed",
     "aborted",
     "expired"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_deploys",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "sessions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "createdAt": {
       "type": "string"
      },
      "deployId": {
       "type": "string"
      },
      "expiresAt": {
       "type": "string"
      },
      "fileCount": {
       "type": "number"
      },
      "lastModifiedAt": {
       "type": "string"
      },
      "mode": {
       "enum": [
        "replace",
        "patch"
       ],
       "type": "string"
      },
      "siteId": {
       "type": "string"
      },
      "siteName": {
       "type": "string"
      },
      "status": {
       "enum": [
        "open",
        "committing",
        "committed",
        "aborted",
        "expired"
       ],
       "type": "string"
      },
      "totalBytes": {
       "type": "number"
      }
     },
     "required": [
      "deployId",
      "siteId",
      "siteName",
      "mode",
      "status",
      "fileCount",
      "totalBytes",
      "createdAt",
      "expiresAt",
      "lastModifiedAt"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "sessions"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List staging sessions"
}
