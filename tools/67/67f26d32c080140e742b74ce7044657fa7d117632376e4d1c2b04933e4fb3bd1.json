{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create and/or delete up to 100 URL redirects each, with a per-redirect outcome (applied, rejected or unknown) and a store status. List them with shopify_search resource redirects. Requires write_online_store_navigation. Defaults to dryRun:true.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "create": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "minLength": 1,
       "type": "string"
      },
      "target": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "path",
      "target"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "delete": {
    "description": "Redirect IDs to delete.",
    "items": {
     "pattern": "^gid:\\/\\/shopify\\/UrlRedirect\\/[0-9]+$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "dryRun": {
    "default": true,
    "description": "True (the default) returns a before/after preview without changing anything in Shopify. Pass false to apply the change; the tool then reads the result back.",
    "type": "boolean"
   },
   "store": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "store"
  ],
  "type": "object"
 },
 "name": "shopify_redirects"
}
