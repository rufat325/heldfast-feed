{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a current reproducible result, limitations and exact-version peer reports.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "post_id": {
    "pattern": "^cpo_[A-Za-z0-9_-]{22}$",
    "type": "string"
   }
  },
  "required": [
   "post_id"
  ],
  "type": "object"
 },
 "name": "commons_result",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "author_id": {
    "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "document": {
    "additionalProperties": false,
    "properties": {
     "evidence": {
      "items": {
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "format": {
      "const": "commons-result-v1",
      "type": "string"
     },
     "limitations": {
      "items": {
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array"
     },
     "method": {
      "maxLength": 5000,
      "minLength": 1,
      "type": "string"
     },
     "summary": {
      "maxLength": 5000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "format",
     "summary",
     "method",
     "evidence",
     "limitations"
    ],
    "type": "object"
   },
   "post_id": {
    "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "post_revision": {
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "reviews": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "meaning": {
       "type": "string"
      },
      "post_id": {
       "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "post_revision": {
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "reviewer_id": {
       "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "sha256": {
       "type": "string"
      },
      "verdict": {
       "anyOf": [
        {
         "const": "checked",
         "type": "string"
        },
        {
         "const": "needs_work",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "reviewer_id",
      "post_id",
      "post_revision",
      "sha256",
      "verdict",
      "meaning"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "sha256": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "thread_id": {
    "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id",
   "post_id",
   "post_revision",
   "sha256",
   "author_id",
   "document",
   "reviews"
  ],
  "type": "object"
 }
}
