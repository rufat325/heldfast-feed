{
 "description": "Calculate required PSV (pressure safety valve) relief area for liquid service per API 520",
 "inputSchema": {
  "properties": {
   "A_unit": {
    "default": "cm2",
    "description": "Output relief area unit",
    "enum": [
     "cm2",
     "ft2",
     "in2",
     "m2"
    ],
    "type": "string"
   },
   "Kc": {
    "description": "Combination correction factor (rupture disk), default 1.0",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "Kd": {
    "description": "Effective coefficient of discharge, default 0.65",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "Kv": {
    "description": "Viscosity correction factor, default 1.0",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "Kw": {
    "description": "Back pressure correction factor (balanced bellows), default 1.0",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "M": {
    "description": "Relieving mass flow rate",
    "properties": {
     "unit": {
      "enum": [
       "kg/day",
       "kg/hr",
       "kg/min",
       "kg/sec",
       "klb/hr",
       "lb/day",
       "lb/hr",
       "ton/day"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "P1": {
    "description": "Upstream relieving pressure (set pressure + overpressure + atm)",
    "properties": {
     "unit": {
      "enum": [
       "MPa",
       "MPag",
       "N/m2",
       "N/m2g",
       "atm",
       "atmg",
       "bar",
       "barg",
       "cmH2O(4C)",
       "cmH2O(4C)g",
       "inH2O(60F)",
       "inH2O(60F)g",
       "inHg(32F)",
       "inHg(32F)g",
       "inHg(60F)",
       "inHg(60F)g",
       "kPa",
       "kPag",
       "kg/cm2",
       "kg/cm2g",
       "lbf/ft2",
       "lbf/ft2g",
       "mmH2O",
       "mmH2Og",
       "mmHg(0C)",
       "mmHg(0C)g",
       "psi",
       "psia",
       "psig",
       "torr",
       "torrg"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "P2": {
    "description": "Downstream (back) pressure",
    "properties": {
     "unit": {
      "enum": [
       "MPa",
       "MPag",
       "N/m2",
       "N/m2g",
       "atm",
       "atmg",
       "bar",
       "barg",
       "cmH2O(4C)",
       "cmH2O(4C)g",
       "inH2O(60F)",
       "inH2O(60F)g",
       "inHg(32F)",
       "inHg(32F)g",
       "inHg(60F)",
       "inHg(60F)g",
       "kPa",
       "kPag",
       "kg/cm2",
       "kg/cm2g",
       "lbf/ft2",
       "lbf/ft2g",
       "mmH2O",
       "mmH2Og",
       "mmHg(0C)",
       "mmHg(0C)g",
       "psi",
       "psia",
       "psig",
       "torr",
       "torrg"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "Pover": {
    "description": "Overpressure fraction (e.g. 0.1 = 10%), default 0.1",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "rho": {
    "description": "Liquid density",
    "properties": {
     "unit": {
      "enum": [
       "API",
       "SG_H2O4",
       "SG_H2O60api",
       "SG_H2O60nbs",
       "g/cm3",
       "g/cm^3",
       "kg/m3",
       "kg/m^3",
       "lb/ft3",
       "lb/ft^3",
       "lbm/ft^3"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   }
  },
  "required": [
   "M",
   "P1",
   "P2",
   "rho"
  ],
  "type": "object"
 },
 "name": "PSVLIQ"
}
