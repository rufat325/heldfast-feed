{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hairdora:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List salon appointments"
 },
 "description": "Use this when someone asks how many appointments are booked on a day or in a period, how many were canceled or no-shows, or when a client is booked. Returns appointments across all the user's salons, or just one, with id, client and salon ids, times and status for any date window, latest first, up to 100. Not for the services inside an appointment.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clientId": {
    "description": "Only appointments of this client, by an id from the client list",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "endTime": {
    "description": "Only appointments ending before this ISO 8601 time",
    "maxLength": 32,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of appointments to return (default 20, maximum 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "salonId": {
    "description": "Only appointments at this salon, by an id from the user's salon list; every salon when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "startTime": {
    "description": "Only appointments starting at or after this ISO 8601 time",
    "maxLength": 32,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_appointments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appointments": {
    "description": "Bookings, latest start first. Free-text notes, reminders, contact details, organization data and payment details are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "clientId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "endTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "pattern": "^[0-9a-f]{24}$",
       "type": "string"
      },
      "salonId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "startTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "SCHEDULED",
          "CLIENT_ARRIVED",
          "NO_SHOW",
          "CANCELED"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "clientId",
      "salonId",
      "startTime",
      "endTime",
      "status"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "count": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "hasMore": {
    "type": "boolean"
   }
  },
  "required": [
   "appointments",
   "count",
   "hasMore"
  ],
  "type": "object"
 },
 "title": "List salon appointments"
}
