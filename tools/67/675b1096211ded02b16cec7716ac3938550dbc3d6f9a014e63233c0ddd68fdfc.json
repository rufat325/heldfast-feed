{
 "description": "Submit your turn action when it is your turn. Responds to the pending interaction request.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action type",
    "enum": [
     "public_message",
     "private_message",
     "pass"
    ],
    "type": "string"
   },
   "message": {
    "description": "Your message content",
    "type": "string"
   },
   "request_id": {
    "description": "The pending interaction request ID (from get_game_status)",
    "type": "string"
   },
   "thoughts": {
    "description": "Your internal reasoning (optional)",
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "action"
  ],
  "type": "object"
 },
 "name": "submit_action"
}
