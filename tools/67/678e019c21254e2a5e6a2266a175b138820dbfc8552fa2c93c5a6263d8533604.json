{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit my listing"
 },
 "description": "Edit fields (title, description, price, currency, location) on one of the USER'S OWN listings, identified by listing_id. Only the owner can edit; vertical/intent_type/role are fixed (publish a new listing to change those). Editing is free (no credit charge). Changing the title, description, or location re-triggers AI moderation (the listing returns to 'pending' until cleared); price/currency-only edits stay live. A price change may be rejected if the listing's price is locked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "currency": {
    "maxLength": 8,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "maxLength": 5000,
    "type": "string"
   },
   "details": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "listing_id": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "location": {
    "additionalProperties": false,
    "description": "New listing coordinates { lat, lon }. Moving a listing re-triggers AI moderation \u2014 it returns to \"pending\" until cleared.",
    "properties": {
     "lat": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lon": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "price": {
    "minimum": 0,
    "type": "number"
   },
   "title": {
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "listing_id"
  ],
  "type": "object"
 },
 "name": "update_listing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "listing": {
    "additionalProperties": {},
    "properties": {
     "currency": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "price": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "status": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "url": {
      "type": "string"
     },
     "vertical": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "listing"
  ],
  "type": "object"
 }
}
