    "additionalProperties": {},
    "description": "Credential field values matching the selected public schema; never returned.",
    "type": "object"
   },
   "isResolvable": {
    "description": "Optional n8n resolvability flag for credential types that support it.",
    "type": "boolean"
   },
   "name": {
    "description": "Human-readable credential name (1-128 characters).",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Public n8n credential type returned by n8n_credentials_schema.",
    "pattern": "^[A-Za-z0-9_.-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "type",
   "data"
  ],
  "type": "object"
 },
