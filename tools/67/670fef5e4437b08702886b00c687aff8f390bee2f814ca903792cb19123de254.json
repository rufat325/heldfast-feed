{
 "description": "Publish a post immediately to one or more social media platforms",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "The text content of the post",
    "type": "string"
   },
   "custom_content": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Platform-specific content overrides, e.g. { twitter: 'short version' }",
    "propertyNames": {
     "enum": [
      "twitter",
      "linkedin",
      "facebook",
      "instagram",
      "threads",
      "tiktok",
      "pinterest",
      "bluesky",
      "telegram",
      "youtube",
      "reddit",
      "google_business",
      "snapchat"
     ]
    },
    "type": "object"
   },
   "media_id": {
    "description": "ID of a previously uploaded media file",
    "type": "number"
   },
   "platforms": {
    "description": "Platforms to publish to",
    "items": {
     "enum": [
      "twitter",
      "linkedin",
      "facebook",
      "instagram",
      "threads",
      "tiktok",
      "pinterest",
      "bluesky",
      "telegram",
      "youtube",
      "reddit",
      "google_business",
      "snapchat"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "content",
   "platforms"
  ],
  "type": "object"
 },
 "name": "publish_post"
}
