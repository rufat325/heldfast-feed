{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a sprint and return it. state is 'future' | 'active' | 'closed' \u2014 moving to 'closed' stamps the completion time, reopening clears it. start_date / end_date are ISO 8601 (or null to clear). Resolve the id via list_sprints; only id is required.",
 "inputSchema": {
  "examples": [
   {
    "id": "spr_123",
    "state": "closed"
   }
  ],
  "properties": {
   "end_date": {
    "description": "End, ISO 8601, or null (optional).",
    "type": "string"
   },
   "goal": {
    "description": "New goal; null clears it (optional).",
    "type": "string"
   },
   "id": {
    "description": "Sprint id, from list_sprints (required).",
    "type": "string"
   },
   "name": {
    "description": "New name (optional).",
    "type": "string"
   },
   "start_date": {
    "description": "Start, ISO 8601, or null (optional).",
    "type": "string"
   },
   "state": {
    "description": "Lifecycle state; 'closed' completes it (optional).",
    "enum": [
     "future",
     "active",
     "closed"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_sprint",
 "title": "Update Sprint"
}
