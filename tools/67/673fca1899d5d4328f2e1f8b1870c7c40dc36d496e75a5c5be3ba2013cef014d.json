{
 "description": "Grant a permission scope to an agent. Optionally set expiry and rate limits.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agent_id": {
    "description": "The agent identifier",
    "type": "string"
   },
   "rate_limit_max": {
    "description": "Maximum uses per window",
    "type": "number"
   },
   "rate_limit_window": {
    "description": "Rate limit window: 1m, 1h, or 1d",
    "type": "string"
   },
   "scope": {
    "description": "Permission scope to grant",
    "enum": [
     "agent:read",
     "agent:write",
     "agent:execute",
     "agent:transact",
     "agent:communicate",
     "agent:delegate",
     "agent:elevate"
    ],
    "type": "string"
   },
   "valid_until": {
    "description": "Expiry timestamp (ISO 8601)",
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "scope"
  ],
  "type": "object"
 },
 "name": "vorim_grant_permission"
}
