{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Run Simulation Trial"
 },
 "description": "Price an EE combination inside a simulation session without creating a real record. Returns the DAC the same combination would cost on create_decision. Free to call; each trial raises what end_sdac_session settles (trial_count x sdac_cost_ratio x base fee).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "access_class": {
    "description": "Optional: read-access class",
    "enum": [
     "self_direct",
     "ara_only",
     "internal_only"
    ],
    "type": "string"
   },
   "auth_token": {
    "description": "Your DA agent auth token. Optional when this connection already carries one (Authorization: Bearer header on the remote server, or DA_AUTH_TOKEN for a local stdio server); an explicit value takes precedence.",
    "type": "string"
   },
   "content_disclosure_scope": {
    "description": "Optional: external exposure scope (affects DAC)",
    "enum": [
     "owner",
     "external",
     "public"
    ],
    "type": "string"
   },
   "delegation_state": {
    "description": "Optional: delegation responsibility state (affects DAC)",
    "enum": [
     "none",
     "partial",
     "full"
    ],
    "type": "string"
   },
   "ee_disclosure_format_policy": {
    "default": "internal",
    "description": "Disclosure format",
    "enum": [
     "internal",
     "shareable",
     "exportable"
    ],
    "type": "string"
   },
   "ee_integrity_verification_level": {
    "default": "basic",
    "description": "Verification rigor",
    "enum": [
     "basic",
     "enhanced",
     "certifiable"
    ],
    "type": "string"
   },
   "ee_responsibility_scope": {
    "default": "standard",
    "description": "Responsibility scope",
    "enum": [
     "minimal",
     "standard",
     "extended"
    ],
    "type": "string"
   },
   "ee_retention_period": {
    "default": "medium",
    "description": "How long the record would be retained",
    "enum": [
     "short",
     "medium",
     "long",
     "extreme_long",
     "indefinite"
    ],
    "type": "string"
   },
   "session_id": {
    "description": "Active sDAC session ID from create_sdac_session",
    "type": "string"
   }
  },
  "required": [
   "session_id"
  ],
  "type": "object"
 },
 "name": "run_sdac_trial",
 "title": "Run Simulation Trial"
}
