{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Create a client project"},"description":"Creates a project for a client's product from its URL. Name, tagline and description are filled from the site in the background when left out. Costs nothing: a launch is spent only by launch_project.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"audience":{"description":"Which audience-restricted directories fit the product","properties":{"ai":{"type":"boolean"},"b2b":{"type":"boolean"},"directory":{"type":"boolean"}},"required":["b2b","ai","directory"],"type":"object"},"category":{"anyOf":[{"enum":["saas","ai_tools","dev_tools","no_code","productivity","other"],"type":"string"},{"type":"null"}]},"competitors":{"description":"Up to 20, some directories need them. Replaces the whole list, so an entry left out is removed","items":{"properties":{"name":{"maxLength":100,"minLength":1,"type":"string"},"url":{"maxLength":500,"type":"string"}},"required":["name","url"],"type":"object"},"maxItems":20,"type":"array"},"contact_email":{"anyOf":[{"maxLength":254,"type":"string"},{"type":"null"}],"description":"Email the directories write to; required before launch"},"excluded_directories":{"description":"Directories never to use for this project. Replaces the whole list, which get_project shows; [] clears it","items":{"description":"Directory id (dir_...)","pattern":"^dir_[0-9A-Za-z]{22}$","type":"string"},"type":"array"},"external_id":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"description":"The agency's own id for this client"},"launch_date":{"anyOf":[{"pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},{"type":"null"}],"description":"YYYY-MM-DD"},"logo_url":{"description":"Public image URL for the logo (PNG, JPEG, GIF or WebP, 5 MB at most)","maxLength":2048,"type":"string"},"long_description":{"anyOf":[{"maxLength":2000,"type":"string"},{"type":"null"}],"description":"Long description"},"maker_name":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"description":"Founder or maker name"},"metadata":{"additionalProperties":{"maxLength":500,"type":"string"},"description":"Up to 20 string pairs for the agency. Replaces all of it; {} clears it","propertyNames":{"maxLength":40,"minLength":1,"type":"string"},"type":"object"},"name":{"description":"Product name; filled from the site when left out","maxLength":100,"minLength":2,"type":"string"},"price_amount_cents":{"anyOf":[{"maximum":9007199254740991,"minimum":0,"type":"integer"},{"type":"null"}],"description":"Price in cents"},"price_period":{"anyOf":[{"enum":["monthly","yearly","one_time"],"type":"string"},{"type":"null"}]},"pricing_model":{"anyOf":[{"enum":["free","freemium","paid","open_source"],"type":"string"},{"type":"null"}]},"promo_code":{"anyOf":[{"maxLength":50,"type":"string"},{"type":"null"}],"description":"Discount code some directories ask for"},"promo_description":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"description":"What the promo code gives"},"screenshot_urls":{"description":"1 to 5 public image URLs","items":{"maxLength":2048,"type":"string"},"maxItems":5,"minItems":1,"type":"array"},"short_description":{"anyOf":[{"maxLength":500,"type":"string"},{"type":"null"}],"description":"Short description"},"tagline":{"anyOf":[{"maxLength":100,"type":"string"},{"type":"null"}],"description":"One-line pitch"},"tags":{"description":"Up to 10. Replaces the whole list","items":{"maxLength":40,"minLength":1,"type":"string"},"maxItems":10,"type":"array"},"twitter_url":{"anyOf":[{"maxLength":2048,"type":"string"},{"type":"null"}],"description":"https://x.com/... profile"},"url":{"description":"The client product's public URL","maxLength":2048,"type":"string"}},"required":["url"],"type":"object"},"name":"create_project","title":"Create a client project"}
