{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Add up to 25 shopping list items at once, for a whole shop. Names are deduplicated within the batch and merged into any matching unbought item already listed.",
 "inputSchema": {
  "examples": [
   {
    "items": [
     {
      "name": "Milk",
      "quantity": 2
     },
     {
      "name": "Eggs",
      "quantity": 1
     }
    ]
   }
  ],
  "properties": {
   "items": {
    "description": "Items to add, up to 25 per call.",
    "examples": [
     [
      {
       "name": "Milk",
       "quantity": 2
      }
     ]
    ],
    "items": {
     "description": "One item to add, with its quantity.",
     "properties": {
      "category": {
       "description": "Store-aisle category to use instead of auto-assigning one; the name is then kept exactly as given. Omit to auto-categorise. Ignored when merged into an existing item.",
       "enum": [
        "FruitAndVegetables",
        "Bakery",
        "DeliAndPreparedFoods",
        "MeatAndSeafood",
        "DairyAndEggs",
        "Frozen",
        "PantryAndDryGoods",
        "SnacksAndConfectionery",
        "Beverages",
        "HouseholdAndCleaning",
        "HealthAndPersonalCare",
        "BabyAndKids",
        "PetSupplies",
        "Online",
        "Other"
       ],
       "examples": [
        "DairyAndEggs"
       ],
       "type": "string"
      },
      "name": {
       "description": "Item name, e.g. 'Milk'. Duplicate names are summed within the batch and merged into any matching unbought item.",
       "examples": [
        "Milk"
       ],
       "type": "string"
      },
      "quantity": {
       "description": "How many to add, 1-9999. Summed quantities are capped at 9999.",
       "examples": [
        2
       ],
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "name",
      "quantity"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "type": "array"
   },
   "shoppingListId": {
    "description": "Target list for every item in this call, an id from list_shopping_lists. Omit for the default. Merging only happens within one list.",
    "examples": [
     "0189c8d4f2b1712a9e4d6c9a1b2e3f4a"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "batch_add_shopping_list_items",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
