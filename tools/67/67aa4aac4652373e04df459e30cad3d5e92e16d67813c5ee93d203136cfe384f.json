{
 "description": "Register a webhook endpoint that Billium will POST events to. Use 'invoice.*' or 'payment.*' to subscribe to every event in a category.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": "string"
   },
   "events": {
    "description": "Event types to subscribe to.",
    "items": {
     "enum": [
      "invoice.*",
      "invoice.created",
      "invoice.updated",
      "invoice.paid",
      "invoice.underpaid",
      "invoice.overpaid",
      "invoice.expired",
      "invoice.cancelled",
      "payment.*",
      "payment.created",
      "payment.updated",
      "payment.detected",
      "payment.confirmed",
      "payment.paid",
      "payment.underpaid",
      "payment.overpaid",
      "payment.expired"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "isActive": {
    "type": "boolean"
   },
   "retryCount": {
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "timeout": {
    "maximum": 30000,
    "minimum": 1000,
    "type": "integer"
   },
   "url": {
    "description": "HTTPS URL Billium will POST events to.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "create_webhook",
 "title": "Create webhook"
}
