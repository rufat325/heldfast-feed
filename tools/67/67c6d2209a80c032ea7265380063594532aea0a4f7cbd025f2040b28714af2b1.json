{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search Loa runtime hospital and provider entity pages by name or state. Use this before get_entity_prices when the user names a hospital or provider but does not know the exact Loa slug.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entity_type": {
    "description": "Optional filter for hospital or provider entities.",
    "enum": [
     "hospital",
     "provider"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of results, default 20, max 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Hospital or provider name to search for.",
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code or full state name, e.g. CA or New York.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_entities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "canonical_name": {
       "type": "string"
      },
      "city": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "data_quality_score": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "display_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "entity_type": {
       "enum": [
        "hospital",
        "provider"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "loa_link": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "Tracked Loa link. Share it when the user wants to book, contact, or learn more about this provider or hospital.",
         "properties": {
          "action": {
           "enum": [
            "book",
            "website",
            "profile"
           ],
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "url",
          "action",
          "label"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "type": "string"
      },
      "state": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "updated_at": {
       "description": "ISO 8601 timestamp",
       "type": "string"
      },
      "zip_code": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "entity_type",
      "slug",
      "canonical_name",
      "display_name",
      "city",
      "state",
      "zip_code",
      "data_quality_score",
      "updated_at",
      "loa_link"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "authoritative",
       "advisory",
       "estimate"
      ],
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "methodology_url": {
      "format": "uri",
      "type": "string"
     },
     "source_scope": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "authority",
     "basis",
     "methodology_url"
    ],
    "type": "object"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "entity_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "query": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "query",
     "entity_type",
     "state"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "total",
   "entities",
   "provenance"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Entity Search"
}
