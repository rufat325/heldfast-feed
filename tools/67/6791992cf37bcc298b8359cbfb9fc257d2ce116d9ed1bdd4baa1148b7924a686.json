{
 "description": "Press a keyboard key or key chord.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Playwright key name, e.g. \"Enter\", \"ArrowDown\", \"Control+A\".",
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "sessionId",
   "key"
  ],
  "type": "object"
 },
 "name": "browser_keyboard_press",
 "title": "Browser Keyboard Press"
}
