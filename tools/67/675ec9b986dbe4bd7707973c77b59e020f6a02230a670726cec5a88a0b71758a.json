{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create change order"
 },
 "description": "Create a new change order. Requires change_orders:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Amount (required, negative for credits)",
    "type": "number"
   },
   "category_id": {
    "description": "Cost category ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "co_number": {
    "description": "Change order number (required)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Description (required)",
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Additional notes",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "reason": {
    "description": "Reason for the change order",
    "type": "string"
   },
   "status": {
    "description": "Status",
    "enum": [
     "draft",
     "submitted",
     "approved",
     "rejected"
    ],
    "type": "string"
   },
   "vendor_id": {
    "description": "Vendor ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "co_number",
   "description",
   "amount",
   "project_id"
  ],
  "type": "object"
 },
 "name": "create_change_order",
 "title": "Create change order"
}
