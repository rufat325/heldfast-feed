{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update a FreeAgent contact \u2014 correct the name or address, add the VAT registration number needed for reverse-charge invoicing, change payment terms, or hide a contact you no longer trade with (status='Hidden'). Only the fields you pass are changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address1": {
    "description": "First line of the address",
    "maxLength": 200,
    "type": "string"
   },
   "address2": {
    "description": "Second line of the address",
    "maxLength": 200,
    "type": "string"
   },
   "chargeSalesTax": {
    "description": "Whether to charge sales tax to this contact",
    "enum": [
     "Auto",
     "Always",
     "Never"
    ],
    "type": "string"
   },
   "contactId": {
    "description": "Numeric FreeAgent contact ID",
    "pattern": "^\\d+$",
    "type": "string"
   },
   "contactNameOnInvoices": {
    "description": "Show the person's name rather than the organisation on invoices",
    "type": "boolean"
   },
   "country": {
    "description": "Country (e.g. 'United Kingdom')",
    "maxLength": 100,
    "type": "string"
   },
   "defaultPaymentTermsInDays": {
    "description": "Default payment terms for this contact's invoices, in days",
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "email": {
    "description": "Contact email address",
    "format": "email",
    "type": "string"
   },
   "firstName": {
    "description": "Contact first name",
    "maxLength": 100,
    "type": "string"
   },
   "lastName": {
    "description": "Contact last name",
    "maxLength": 100,
    "type": "string"
   },
   "organisationName": {
    "description": "Company name",
    "maxLength": 200,
    "type": "string"
   },
   "phoneNumber": {
    "description": "Contact phone number",
    "maxLength": 50,
    "type": "string"
   },
   "postcode": {
    "description": "Postcode or ZIP",
    "maxLength": 20,
    "type": "string"
   },
   "region": {
    "description": "County, region or state",
    "maxLength": 100,
    "type": "string"
   },
   "salesTaxRegistrationNumber": {
    "description": "The contact's VAT registration number (e.g. 'DE123456789')",
    "maxLength": 50,
    "type": "string"
   },
   "status": {
    "description": "Set to 'Hidden' to retire a contact without deleting it",
    "enum": [
     "Active",
     "Hidden"
    ],
    "type": "string"
   },
   "town": {
    "description": "Town or city",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "contactId"
  ],
  "type": "object"
 },
 "name": "freeagent_update_contact"
}
