{
 "description": "Fetch recent AI-summarized crypto news. Public read-only. category: crypto (default), stocks (US markets / macro), sports, or all.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "default": "crypto",
    "enum": [
     "crypto",
     "stocks",
     "sports",
     "all"
    ],
    "type": "string"
   },
   "hoursBack": {
    "default": 24,
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "get_news_summary"
}
