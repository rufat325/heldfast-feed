{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"permission":"api-key-execute","readOnlyHint":false},"description":"Withdraw a market's current research as the approved producer that published it: name its researchedAt and why. Readers then see no research; the venue keeps the record. To fix research instead, publish it with correctionReason.","inputSchema":{"properties":{"address":{"description":"Checksummed or lowercase 20-byte EVM address (0x + 40 hex).","pattern":"^0x[a-fA-F0-9]{40}$","type":"string"},"chainId":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"idempotencyKey":{"description":"Stable retry key. Reuse only with byte-equivalent tool arguments.","maxLength":256,"minLength":1,"type":"string"},"reason":{"description":"Why it is withdrawn, shown to readers after \"Withdrawn because\": one clause, e.g. \"it misread the market's rule\".","maxLength":200,"minLength":1,"type":"string"},"researchedAt":{"description":"The researchedAt of the market's current research, the research withdrawn: a newer version is never withdrawn by mistake.","format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$","type":"string"}},"required":["address","chainId","researchedAt","reason","idempotencyKey"],"type":"object"},"name":"problee_withdraw_research","outputSchema":{"$defs":{"ResearchWithdrawResponse":{"additionalProperties":false,"properties":{"research":{"additionalProperties":false,"properties":{"duplicate":{"type":"boolean"},"researchedAt":{"format":"date-time","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[1