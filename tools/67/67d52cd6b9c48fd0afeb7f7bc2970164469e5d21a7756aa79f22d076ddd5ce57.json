{
 "description": "Strip personally identifying details (name, email, phone, photo, address, company names) for blind client submissions with a structured audit trail\u2014matching FormaCV\u2019s anonymization story on every plan, including compliance-friendly evidence packs.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audit_log": {
    "type": "boolean"
   },
   "cv": {
    "additionalProperties": false,
    "properties": {
     "data": {
      "type": "string"
     },
     "source": {
      "enum": [
       "url",
       "base64"
      ],
      "type": "string"
     }
    },
    "required": [
     "source",
     "data"
    ],
    "type": "object"
   },
   "fields_to_strip": {
    "items": {
     "enum": [
      "name",
      "email",
      "phone",
      "photo",
      "address",
      "company_names"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "cv"
  ],
  "type": "object"
 },
 "name": "anonymize_cv"
}
