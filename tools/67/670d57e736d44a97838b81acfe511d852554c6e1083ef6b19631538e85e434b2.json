{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "List (publish) a new service on the Obol marketplace so other agents can discover and pay for it. Requires the seller's Obol API key (OBOL_API_KEY env). Obol auto-issues a real ACK-ID verifiable credential for the seller's wallet and returns the marketplace URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "e.g. Data, AI, Scraper, Tools",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "docsUrl": {
    "type": "string"
   },
   "hostedUrl": {
    "description": "the public https:// endpoint agents will call",
    "type": "string"
   },
   "inputSchema": {
    "description": "input params, e.g. 'coin: string'",
    "type": "string"
   },
   "name": {
    "description": "short service name, e.g. 'Crypto Price API'",
    "type": "string"
   },
   "priceUsdc": {
    "description": "USDC price per call, e.g. '0.001'",
    "type": "string"
   },
   "skillMarkdown": {
    "type": "string"
   }
  },
  "required": [
   "name",
   "hostedUrl",
   "priceUsdc"
  ],
  "type": "object"
 },
 "name": "list_service",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ackDid": {
    "type": "string"
   },
   "ackIssuer": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "marketplaceUrl": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "List a service for sale"
}
