{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "List markets in the canonical resolution pipeline. Optional category, marketState, cursor, and limit.",
 "inputSchema": {
  "$defs": {
   "Cursor": {
    "description": "Opaque server-generated cursor; pass back verbatim on next page.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "MarketState": {
    "description": "Canonical market state shared by every protocol surface.",
    "enum": [
     "open",
     "closed",
     "creator_proposal",
     "challenge",
     "human_voting",
     "council_review",
     "resolved",
     "void"
    ],
    "type": "string"
   }
  },
  "properties": {
   "category": {
    "description": "Optional market category filter.",
    "enum": [
     "CRYPTO",
     "SPORTS",
     "POLITICS",
     "ELECTIONS",
     "FINANCE",
     "TECH",
     "WORLD",
     "ECONOMY",
     "CULTURE",
     "WEATHER",
     "SCIENCE_HEALTH",
     "AI",
     "GAMING",
     "BUSINESS",
     "FASHION",
     "MOVIES_TV",
     "MUSIC",
     "SHOPPING",
     "BEAUTY",
     "TRAVEL",
     "CLIMATE",
     "DAILY_LIFE",
     "LOCAL",
     "SOCIAL",
     "FUN",
     "OTHER"
    ],
    "type": "string"
   },
   "cursor": {
    "$ref": "#/$defs/Cursor",
    "description": "Opaque pagination cursor from a prior response."
   },
   "limit": {
    "description": "Page size (1\u2013100). Defaults to 50.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "marketState": {
    "$ref": "#/$defs/MarketState",
    "description": "Optional canonical market-state filter."
   }
  },
  "type": "object"
 },
 "name": "problee_list_pending_resolution_markets",
 "outputSchema": {
  "$defs": {
   "DiscoverPendingResolutionResponse": {
    "additionalProperties": false,
    "properties": {
     "markets": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "address": {
         "$ref": "#/$defs/EvmAddress"
        },
        "category": {
         "enum": [
          "CRYPTO",
          "SPORTS",
          "POLITICS",
          "ELECTIONS",
          "FINANCE",
          "TECH",
          "WORLD",
          "ECONOMY",
          "CULTURE",
          "WEATHER",
          "SCIENCE_HEALTH",
          "AI",
          "GAMING",
          "BUSINESS",
          "FASHION",
          "MOVIES_TV",
          "MUSIC",
          "SHOPPING",
          "BEAUTY",
          "TRAVEL",
          "CLIMATE",
          "DAILY_LIFE",
          "LOCAL",
          "SOCIAL",
          "FUN",
          "OTHER"
         ],
         "type": "string",
         "x-extensible-enum": true
        },
        "chainId": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "closeTime": {
         "anyOf": [
          {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "collateralDecimals": {
         "anyOf": [
          {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "collateralToken": {
         "anyOf": [
          {
           "$ref": "#/$defs/EvmAddress"
          },
          {
           "type": "null"
          }
         ]
        },
        "createdAt": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "imageUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "lifecycleStage": {
         "$ref": "#/$defs/MarketLifecycleStage"
        },
        "marketState": {
         "enum": [
          "open",
          "closed",
          "creator_proposal",
          "challenge",
          "human_voting",
          "council_review",
          "resolved",
          "void"
         ],
         "type": "string"
        },
        "marketType": {
         "type": "string"
        },
        "outcome1Label": {
         "type": [
          "string",
          "null"
         ]
        },
        "outcome2Label": {
         "type": [
          "string",
          "null"
         ]
        },
        "outcome3Label": {
         "type": [
          "string",
          "null"
         ]
        },
        "question": {
         "type": "string"
        },
        "resolutionCriteria": {
         "type": [
          "string",
          "null"
         ]
        },
        "seed": {
         "anyOf": [
          {
           "pattern": "^\\d+$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "settlement": {
         "enum": [
          "onchain",
          "committed"
         ],
         "type": "string"
        },
        "spec": {
         "anyOf": [
          {},
          {
           "type": "null"
          }
         ]
        },
        "stageDeadline": {
         "anyOf": [
          {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "tradingEndsAt": {
         "anyOf": [
          {
           "format": "date-time",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "address",
        "chainId",
        "question",
        "category",
        "marketType",
        "outcome1Label",
        "outcome2Label",
        "outcome3Label",
        "closeTime",
        "marketState",
        "tradingEndsAt",
        "lifecycleStage",
        "stageDeadline",
        "imageUrl",
        "seed",
        "createdAt",
        "collateralToken",
        "collateralDecimals",
        "spec",
        "resolutionCriteria"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nextCursor": {
      "anyOf": [
       {
        "maxLength": 256,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "markets",
     "nextCursor"
    ],
    "type": "object"
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "MarketLifecycleStage": {
    "enum": [
     "open",
     "closed",
     "result_proposed",
     "result_challenged",
     "vote_open",
     "vote_closed",
     "under_review",
     "resolved",
     "voided"
    ],
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverPendingResolutionResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Markets waiting for resolution"
}
