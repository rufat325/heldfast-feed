{
 "description": "Create and emit an NFe (nota fiscal eletronica)",
 "inputSchema": {
  "properties": {
   "cnpj_destinatario": {
    "description": "Recipient CNPJ",
    "type": "string"
   },
   "cnpj_emitente": {
    "description": "Emitter CNPJ",
    "type": "string"
   },
   "cpf_destinatario": {
    "description": "Recipient CPF",
    "type": "string"
   },
   "forma_pagamento": {
    "description": "Payment form code",
    "type": "string"
   },
   "items": {
    "description": "NFe items",
    "items": {
     "properties": {
      "cfop": {
       "description": "CFOP code",
       "type": "string"
      },
      "codigo_produto": {
       "description": "Product code",
       "type": "string"
      },
      "descricao": {
       "description": "Product description",
       "type": "string"
      },
      "ncm": {
       "description": "NCM code",
       "type": "string"
      },
      "numero_item": {
       "description": "Item number",
       "type": "number"
      },
      "quantidade_comercial": {
       "description": "Quantity",
       "type": "number"
      },
      "valor_unitario_comercial": {
       "description": "Unit value",
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "natureza_operacao": {
    "description": "Operation nature (e.g. 'Venda de mercadoria')",
    "type": "string"
   },
   "nome_destinatario": {
    "description": "Recipient name",
    "type": "string"
   },
   "ref": {
    "description": "Unique reference ID for this NFe",
    "type": "string"
   },
   "tipo_documento": {
    "description": "Document type (0=entrada, 1=saida)",
    "type": "number"
   }
  },
  "required": [
   "ref",
   "natureza_operacao",
   "tipo_documento",
   "cnpj_emitente",
   "items"
  ],
  "type": "object"
 },
 "name": "create_nfe"
}
