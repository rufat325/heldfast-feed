{
 "_meta": {
  "openai/outputTemplate": "ui://opn/price-card.html",
  "ui": {
   "resourceUri": "ui://opn/price-card.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Estimate a corrugated box price"
 },
 "description": "Price a corrugated RSC box (FEFCO 0201) from internal dimensions and flute (E, B, C, F or double-wall), anchored to the PackIndex RSC benchmark, with a low/mid/high band, optional order total and a next-quarter projection. Returns the sources to cite.",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "Also show the estimate in this currency (ISO code, e.g. CAD, EUR). Defaults to the region's currency; converted at live FX.",
    "type": "string"
   },
   "flute": {
    "default": "B",
    "enum": [
     "E",
     "B",
     "C",
     "F",
     "EB",
     "BC",
     "EC"
    ],
    "type": "string"
   },
   "format": {
    "default": "RSC",
    "enum": [
     "RSC"
    ],
    "type": "string"
   },
   "height_mm": {
    "maximum": 2500,
    "minimum": 30,
    "type": "number"
   },
   "horizon": {
    "default": "now",
    "enum": [
     "now",
     "next_quarter"
    ],
    "type": "string"
   },
   "length_mm": {
    "maximum": 2500,
    "minimum": 30,
    "type": "number"
   },
   "quantity": {
    "minimum": 1,
    "type": "integer"
   },
   "region": {
    "description": "Country or region, e.g. 'US', 'Germany', 'Poland'",
    "type": "string"
   },
   "width_mm": {
    "maximum": 2500,
    "minimum": 30,
    "type": "number"
   }
  },
  "required": [
   "length_mm",
   "width_mm",
   "height_mm"
  ],
  "type": "object"
 },
 "name": "estimate_packaging_price",
 "title": "Estimate a corrugated box price"
}
