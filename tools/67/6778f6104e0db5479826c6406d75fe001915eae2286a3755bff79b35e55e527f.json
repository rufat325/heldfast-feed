{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only falsification tool for agentic purchases, procurement, paid API calls, or other irreversible machine actions. It checks whether the supplied record preserves not only authorization and settlement, but the exact decision-relevant T0 evidence state: source versions, timestamps, authority, contradictions, unresolved dependencies, and separation of later evidence. It does not authorize, block, execute, price, or submit a transaction.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "action_summary": {
    "description": "The bounded transaction/action and why the decision matters.",
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "authority_state": {
    "default": "unknown",
    "enum": [
     "explicit_and_preserved",
     "implicit_or_partial",
     "none",
     "unknown"
    ],
    "type": "string"
   },
   "authorization_record": {
    "default": "unknown",
    "enum": [
     "cryptographic_mandate",
     "signed_checkout",
     "policy_receipt",
     "human_approval",
     "other",
     "none",
     "unknown"
    ],
    "type": "string"
   },
   "checkout_or_terms_snapshot": {
    "default": "unknown",
    "enum": [
     "signed_or_hashed_exact",
     "timestamped_copy",
     "current_only",
     "none",
     "unknown"
    ],
    "type": "string"
   },
   "contradiction_state": {
    "default": "unknown",
    "enum": [
     "preserved",
     "resolved_without_trace",
     "not_present",
     "unknown"
    ],
    "type": "string"
   },
   "dependency_state": {
    "default": "unknown",
    "enum": [
     "preserved",
     "partial",
     "none",
     "unknown"
    ],
    "type": "string"
   },
   "economic_consequence": {
    "description": "Optional spend, loss, dispute, delay, procurement or other consequence. User-supplied and not independently verified.",
    "maxLength": 1800,
    "type": "string"
   },
   "independent_replay": {
    "default": "unknown",
    "enum": [
     "reproducible",
     "partially_reproducible",
     "not_reproducible",
     "unknown"
    ],
    "type": "string"
   },
   "late_evidence_state": {
    "default": "unknown",
    "enum": [
     "separated_from_t0",
     "mixed_with_t0",
     "not_present",
     "unknown"
    ],
    "type": "string"
   },
   "source_time_state": {
    "default": "unknown",
    "enum": [
     "hard_t0_cutoff",
     "mixed_timestamps",
     "current_only",
     "none",
     "unknown"
    ],
    "type": "string"
   },
   "source_version_state": {
    "default": "unknown",
    "enum": [
     "exact_versions_preserved",
     "partial_versions",
     "current_only",
     "none",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "action_summary"
  ],
  "type": "object"
 },
 "name": "assess_agent_transaction_replay_gap",
 "title": "Assess whether an agent transaction has an exact decision-state replay gap"
}
