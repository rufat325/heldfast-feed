{
 "description": "Full-text search across a namespace using FTS5 with BM25 ranking. Costs $0.010 USD. Not covered by Pro subscription.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results. Defaults to 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "namespace": {
    "description": "Namespace.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Search query.",
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "namespace",
   "query"
  ],
  "type": "object"
 },
 "name": "memory.search"
}
