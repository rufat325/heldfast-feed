{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save content to your library as a draft, template, or evergreen content for reuse. Alias for save_to_library.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category for organization",
    "type": "string"
   },
   "evergreenEnabled": {
    "description": "Enable evergreen auto-republishing",
    "type": "boolean"
   },
   "evergreenIntervalDays": {
    "description": "Days between evergreen republishes",
    "type": "number"
   },
   "mediaUrl": {
    "description": "Media URL (image or video)",
    "type": "string"
   },
   "tags": {
    "description": "Tags for organization",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "targetPlatforms": {
    "description": "Which platforms this content is designed for",
    "items": {
     "enum": [
      "x",
      "linkedin",
      "linkedin-page",
      "facebook",
      "instagram",
      "threads",
      "bluesky",
      "mastodon",
      "nostr",
      "youtube",
      "tiktok",
      "lemmy",
      "discord",
      "slack",
      "telegram",
      "pinterest",
      "dribbble",
      "devto",
      "hashnode",
      "gmb",
      "whop",
      "producthunt"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "text": {
    "description": "The content text/caption",
    "type": "string"
   },
   "title": {
    "description": "Title for the saved content",
    "type": "string"
   },
   "type": {
    "description": "Content type (default: draft)",
    "enum": [
     "draft",
     "template",
     "evergreen"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "text"
  ],
  "type": "object"
 },
 "name": "create_library_item",
 "title": "Create Library Item"
}
