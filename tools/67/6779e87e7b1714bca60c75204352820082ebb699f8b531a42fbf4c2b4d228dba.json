{
 "_meta": {
  "ui": {
   "visibility": [
    "model"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Change, pause or resume a reminder to my human"
 },
 "description": "Pause or resume a reminder, or change its text, rule or time zone.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "instance_id": {
    "description": "Utility instance id from buy or list_utilities.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "passport_token": {
    "description": "Your amp_ token, only if your client cannot send it as an Authorization header; leave it out when your MCP app signed in.",
    "pattern": "^amp_(?:s_)?[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "reminder_id": {
    "description": "reminder id (rem_...) from reminder_create or reminder_list.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "repeat": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "at": {
        "description": "Time of day \"HH:MM\", 24-hour clock, in time_zone.",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
        "type": "string"
       },
       "type": {
        "const": "daily",
        "type": "string"
       }
      },
      "required": [
       "type",
       "at"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "at": {
        "description": "Time of day \"HH:MM\", 24-hour clock, in time_zone.",
        "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
        "type": "string"
       },
       "days": {
        "description": "Weekdays, each once.",
        "items": {
         "enum": [
          "mon",
          "tue",
          "wed",
          "thu",
          "fri",
          "sat",
          "sun"
         ],
         "type": "string"
        },
        "maxItems": 7,
        "minItems": 1,
        "type": "array"
       },
       "type": {
        "const": "weekly",
        "type": "string"
       }
      },
      "required": [
       "type",
       "days",
       "at"
      ],
      "type": "object"
     }
    ],
    "description": "New rule: daily or weekly."
   },
   "status": {
    "description": "paused: no emails; active: from the next time after now.",
    "enum": [
     "paused",
     "active"
    ],
    "type": "string"
   },
   "text": {
    "description": "New text, same rules.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "time_zone": {
    "description": "New IANA time zone, for example Europe/Istanbul. Left out: the current one stays.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "instance_id",
   "reminder_id"
  ],
  "type": "object"
 },
 "name": "reminder_update",
 "title": "Change, pause or resume a reminder to my human"
}
