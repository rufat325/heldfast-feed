{
 "annotations": {
  "destructiveHint": true,
  "title": "Publish product"
 },
 "description": "Publish a product to the shop's connected sales channel (e.g. Shopify, Etsy). STATE-CHANGING: this locks the product and pushes the selected fields to the external store. The body is an object of booleans controlling which fields are published; all default to true. Printify REST: POST /v1/shops/{shop_id}/products/{product_id}/publish.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Publish the description (default true).",
    "type": "boolean"
   },
   "images": {
    "description": "Publish the images (default true).",
    "type": "boolean"
   },
   "keyFeatures": {
    "description": "Publish the key features (default true).",
    "type": "boolean"
   },
   "product_id": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "number"
     }
    ],
    "description": "Product id \u2014 required."
   },
   "shipping_template": {
    "description": "Publish the shipping template (default true).",
    "type": "boolean"
   },
   "shop_id": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "number"
     }
    ],
    "description": "Shop id \u2014 required."
   },
   "tags": {
    "description": "Publish the tags (default true).",
    "type": "boolean"
   },
   "title": {
    "description": "Publish the title (default true).",
    "type": "boolean"
   },
   "variants": {
    "description": "Publish the variants (default true).",
    "type": "boolean"
   }
  },
  "required": [
   "shop_id",
   "product_id"
  ],
  "type": "object"
 },
 "name": "printify_publish_product",
 "title": "Publish product"
}
