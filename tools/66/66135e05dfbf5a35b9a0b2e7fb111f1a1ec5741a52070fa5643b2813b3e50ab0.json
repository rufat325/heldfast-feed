{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List all documents in a collection with pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "author": {
    "description": "Filter by author",
    "type": "string"
   },
   "authority": {
    "description": "Filter by authority",
    "type": "string"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "createdfrom": {
    "description": "Created from timestamp",
    "type": "number"
   },
   "createdto": {
    "description": "Created to timestamp",
    "type": "number"
   },
   "description": {
    "description": "Filter by description",
    "type": "string"
   },
   "extId": {
    "description": "Filter by external ID",
    "type": "string"
   },
   "genre": {
    "description": "Filter by genre",
    "type": "string"
   },
   "hierarchy": {
    "description": "Filter by hierarchy",
    "type": "string"
   },
   "includeNulls": {
    "description": "Include null values",
    "type": "boolean"
   },
   "index": {
    "description": "Start index (0-based)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "isDeleted": {
    "default": "false",
    "description": "Include deleted documents",
    "type": "string"
   },
   "labelId": {
    "description": "Filter by label ID",
    "type": "string"
   },
   "language": {
    "description": "Filter by language",
    "type": "string"
   },
   "nValues": {
    "description": "Number of results (-1 for all)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pagingWrapper": {
    "default": false,
    "description": "Use paging wrapper",
    "type": "boolean"
   },
   "scriptType": {
    "description": "Filter by script type",
    "type": "string"
   },
   "sortColumn": {
    "description": "Column to sort by",
    "type": "string"
   },
   "sortDirection": {
    "description": "Sort direction: asc or desc",
    "type": "string"
   },
   "title": {
    "description": "Filter by document title",
    "type": "string"
   },
   "ultimestamp": {
    "description": "Last modified timestamp",
    "type": "number"
   },
   "uploader": {
    "description": "Filter by uploader name",
    "type": "string"
   },
   "uploaderId": {
    "description": "Filter by uploader ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "writer": {
    "description": "Filter by writer",
    "type": "string"
   }
  },
  "required": [
   "collId"
  ],
  "type": "object"
 },
 "name": "transkribus_coll_list_docs",
 "title": "List Documents in Collection"
}
