{"_meta":{"ui":{"resourceUri":"ui://moondasha/transit-card.html"},"ui/resourceUri":"ui://moondasha/transit-card.html"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Transits of Jupiter, Saturn, Rahu and Ketu"},"description":"Follow Jupiter, Saturn, Rahu and Ketu against a Vedic birth chart with Moon Dasha's calculations, over a window (two years from today by default): each sign stay with its dates, the house it transits from the Ascendant and from the Moon, its dignity, its Ashtakavarga points and Moon Dasha's rating of the stay (its own reading, not a probability), the classical good houses from the Moon, the houses it aspects, its stations, the exact days it passes natal planets, and any dasha of that planet the person runs meanwhile; and the transit chart, the nine planets now beside the natal ones, from the Ascendant and from the Moon. Sade Sati's phases and dates come from sade_sati. Needs the birth date, the local birth time and the birthplace (a place_id from find_place). Word transits as tendencies; never predict death, illness, accidents, a relative's death, markets, elections or court cases.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"ayanamsa":{"description":"Default Lahiri. Krishnamurti is the KP ayanamsa.","enum":["Lahiri","TrueLahiri","Krishnamurti","Raman","Fagan","Yukteshwar","Galactic","Dhruva","Pushya","Ushashashi","ChandraHari","TrueRevati","SuryaSiddhanta","Tropical"],"type":"string"},"date":{"description":"Birth date, YYYY-MM-DD.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"from":{"description":"The first day of the window, YYYY-MM-DD. Default today, when the transit chart shows the planets now; on a given day it shows them at noon.","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"months":{"description":"How many months the window covers, 1 to 120. Default 24.","maximum":120,"minimum":1,"type":"integer"},"node":{"description":"Rahu and Ketu by the mean node (default) or the true node.","enum":["mean","true"],"type":"string"},"place_id":{"description":"The place_id find_place returned for the birthplace.","maxLength":80,"type":"string"},"time":{"description":"Local clock time at the birthplace, 24-hour HH:MM or HH:MM:SS. Required: if the person does not know it, ask for their best guess and set time_is_approximate.","pattern":"^([01]\\d|2[0-3]):[0-5]\\d(:[0-5]\\d)?$","type":"string"},"time_is_approximate":{"description":"Set when the birth time is a guess: the answer then says whether the Ascendant or the Moon would be in another sign an hour either side, which shifts the houses counted from it.","type":"boolean"}},"required":["date","time","place_id"],"type":"object"},"name":"transits","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"approximate":{"anyOf":[{"additionalProperties":false,"properties":{"one_hour_earlier":{"anyOf":[{"additionalProperties":false,"properties":{"ascendant_sign":{"type":"string"},"moon_sign":{"type":"string"}},"required":["ascendant_sign","moon_sign"],"type":"object"},{"type":"null"}]},"one_hour_later":{"anyOf":[{"additionalProperties":false,"properties":{"ascendant_sign":{"type":"string"},"moon_sign":{"type":"string"}},"required":["ascendant_sign","moon_sign"],"type":"object"},{"type":"null"}]}},"required":["one_hour_earlier","one_hour_later"],"type":"object"},{"type":"null"}]},"ascendant_sign":{"type":"string"},"birth":{"additionalProperties":false,"properties":{"date":{"type":"string"},"latitude":{"type":"number"},"longitude":{"type":"number"},"time":{"type":"string"},"time_is_approximate":{"type":"boolean"},"time_zone":{"type":"string"},"utc_offset":{"type":"string"}},"required":["date","time","time_is_approximate","utc_offset","latitude","longitude","time_zone"],"type":"object"},"chart":{"additionalProperties":false,"properties":{"at":{"type":"string"},"from