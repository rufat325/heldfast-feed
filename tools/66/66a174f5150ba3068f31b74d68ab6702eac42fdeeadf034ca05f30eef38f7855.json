{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Record the Porter's triage of a GitHub issue.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "classification": {
    "description": "type/* classification, e.g. 'bug'.",
    "type": "string"
   },
   "disposition": {
    "description": "Routing disposition, e.g. 'agent/fix', 'rejected', 'blocked/upstream'.",
    "type": "string"
   },
   "dpop_token": {
    "default": "",
    "type": "string"
   },
   "issue_number": {
    "description": "GitHub issue number.",
    "type": "integer"
   },
   "issue_url": {
    "description": "The issue's actual GitHub URL (gh issue view <n> --json url).",
    "type": "string"
   },
   "npub": {
    "default": "",
    "type": "string"
   },
   "repo_name": {
    "description": "Repository name.",
    "type": "string"
   },
   "repo_url": {
    "description": "The repository's actual GitHub URL (gh repo view --json url).",
    "type": "string"
   },
   "title": {
    "description": "Issue title.",
    "type": "string"
   }
  },
  "required": [
   "title",
   "repo_url",
   "issue_url",
   "repo_name",
   "disposition",
   "issue_number",
   "classification"
  ],
  "type": "object"
 },
 "name": "cypher_record_triage"
}
