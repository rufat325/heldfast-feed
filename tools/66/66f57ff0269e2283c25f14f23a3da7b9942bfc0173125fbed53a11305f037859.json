{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"Starts a large search in the background (same options as search, up to 10000 results) and returns an id with the first page as soon as it is full. Results can be read while the search runs. Read further pages with get_more_search_results; end it early with stop_search. Use search instead for small result sets.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"glob":{"description":"Only files whose name matches, e.g. \"*.ts\"","type":"string"},"ignore_case":{"default":false,"type":"boolean"},"kind":{"default":"content","enum":["content","files"],"type":"string"},"literal":{"default":false,"type":"boolean"},"max_results":{"default":2000,"maximum":10000,"minimum":1,"type":"integer"},"page_size":{"default":100,"maximum":500,"minimum":1,"type":"integer"},"path":{"minLength":1,"type":"string"},"pattern":{"description":"Regular expression, or plain text when literal is true","minLength":1,"type":"string"},"timeout_ms":{"default":120000,"maximum":600000,"minimum":100,"type":"integer"},"wait_ms":{"default":3000,"description":"How long to wait for results before returning","maximum":60000,"minimum":0,"type":"integer"}},"required":["path","pattern"],"type":"object"},"name":"start_search","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"error":{"type":"string"},"id":{"type":"string"},"matches":{"items":{"type":"string"},"type":"array"},"offset":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"running":{"type":"boolean"},"stopped":{"type":"boolean"},"timedOut":{"type":"boolean"},"totalSoFar":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"truncated":{"type":"boolean"},"warnings":{"items":{"type":"string"},"type":"array"}},"required":["id","running","stopped","offset","matche