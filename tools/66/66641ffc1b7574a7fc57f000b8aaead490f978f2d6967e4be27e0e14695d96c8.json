{
 "description": "Get historical quotes for a currency over a date range",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "ISO currency code (e.g. USD, EUR, BRL)",
    "type": "string"
   },
   "date_from": {
    "description": "Start date (YYYY-MM-DD)",
    "type": "string"
   },
   "date_to": {
    "description": "End date (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "description": "Max rows (default 1000, max 1000)",
    "type": "number"
   },
   "offset": {
    "description": "Offset for pagination",
    "type": "number"
   }
  },
  "required": [
   "currency"
  ],
  "type": "object"
 },
 "name": "get_currency_history"
}
