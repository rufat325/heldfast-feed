{
 "description": "Gestiona tareas. Acciones: list (page, limit, project_id, assigned_to, priority_id, status_id, search, labels, deadline, start_date, end_date), get (id), create (soporta subtasks[] para crear subtareas en un solo llamado), update (id), delete (id), comments (id, include_files), add_comment (id, description), update_status (id, status_id), checklist (id), subtasks (id), create_subtask (id, title), copy (id), download_comment_file (task_id, comment_id, file_id).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "comments",
     "add_comment",
     "update_status",
     "checklist",
     "subtasks",
     "create_subtask",
     "copy",
     "download_comment_file"
    ],
    "type": "string"
   },
   "assigned_to": {
    "type": "number"
   },
   "collaborators": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "comment_id": {
    "description": "ID del comentario (para download_comment_file)",
    "type": "number"
   },
   "custom_fields": {
    "items": {
     "properties": {
      "custom_field_id": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "custom_field_id",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cycle_id": {
    "type": "number"
   },
   "cycle_type": {
    "type": "string"
   },
   "deadline": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "end_date": {
    "type": "string"
   },
   "file_id": {
    "description": "ID del archivo (para download_comment_file)",
    "type": "number"
   },
   "id": {
    "description": "ID de la tarea",
    "type": "number"
   },
   "include_files": {
    "default": true,
    "description": "Incluir archivos adjuntos en comentarios (solo en action=comments)",
    "type": "boolean"
   },
   "labels": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "milestone_id": {
    "type": "number"
   },
   "no_of_cycles": {
    "type": "number"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "points": {
    "type": "number"
   },
   "priority_id": {
    "type": "number"
   },
   "project_id": {
    "type": "number"
   },
   "recurring_task_id": {
    "type": "number"
   },
   "repeat_every": {
    "type": "number"
   },
   "search": {
    "type": "string"
   },
   "start_date": {
    "type": "string"
   },
   "status_id": {
    "type": "string"
   },
   "subtasks": {
    "description": "Array de t\u00edtulos para crear subtareas en un solo llamado (solo en action=create)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "task_id": {
    "description": "ID de la tarea (para download_comment_file)",
    "type": "number"
   },
   "task_labels": {
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "tasks"
}
