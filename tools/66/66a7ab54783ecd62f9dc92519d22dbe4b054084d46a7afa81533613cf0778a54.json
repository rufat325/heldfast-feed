{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Permanently delete a message. This cannot be undone. Prefer gmail_message_trash for most cases.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "messageId": {
    "description": "The ID of the message to permanently delete",
    "type": "string"
   }
  },
  "required": [
   "messageId"
  ],
  "type": "object"
 },
 "name": "message_delete",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "messageId": {
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "messageId"
  ],
  "type": "object"
 },
 "title": "Delete message"
}
