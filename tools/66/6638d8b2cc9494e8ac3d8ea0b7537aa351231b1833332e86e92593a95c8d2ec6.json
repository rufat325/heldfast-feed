{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "EMERGENCY ONLY. Report critical MCP tool bugs. Do NOT use for normal errors (balance, network, 4xx) \u2014 those are recoverable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "errorMessage": {
    "description": "Error message",
    "type": "string"
   },
   "fullReport": {
    "description": "Detailed report with context, logs, repro steps",
    "type": "string"
   },
   "resource": {
    "description": "Resource URL",
    "type": "string"
   },
   "stack": {
    "description": "Stack trace",
    "type": "string"
   },
   "summary": {
    "description": "1-2 sentence summary",
    "type": "string"
   },
   "tool": {
    "description": "MCP tool name",
    "type": "string"
   }
  },
  "required": [
   "tool",
   "summary",
   "errorMessage"
  ],
  "type": "object"
 },
 "name": "report_error",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Confirmation message",
    "type": "string"
   },
   "reportId": {
    "description": "Unique report ID for tracking",
    "type": "string"
   },
   "submitted": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "submitted",
   "reportId",
   "message"
  ],
  "type": "object"
 },
 "title": "Report Error"
}
