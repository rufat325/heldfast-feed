{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Daily or hourly price history of one item on one marketplace (lowest listing price and listing count), in the market's currency. Daily covers up to a year and more, hourly up to 30 days. Requires an API key (Enterprise plan).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "market": {
    "description": "Default youpin",
    "enum": [
     "youpin",
     "buff163",
     "c5game",
     "skinport",
     "skinbaron",
     "market-csgo",
     "csfloat",
     "dmarket",
     "ecosteam",
     "lisskins",
     "skinland",
     "shadowpay",
     "waxpeer"
    ],
    "type": "string"
   },
   "market_hash_name": {
    "minLength": 1,
    "type": "string"
   },
   "resolution": {
    "description": "Default daily",
    "enum": [
     "daily",
     "hourly"
    ],
    "type": "string"
   },
   "to": {
    "description": "YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "market_hash_name"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "title": "CS2 price history"
}
