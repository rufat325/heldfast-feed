 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cursor": {
    "maxLength": 320,
    "type": "string"
   },
   "designId": {
    "maxLength": 64,
    "type": "string"
   },
   "nodeId": {
    "maxLength": 64,
    "type": "string"
   },
   "pageId": {
    "maxLength": 64,
    "type": "string"
   },
   "revision": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "view": {
    "enum": [
     "sessions",
     "overview",
     "decisions",
     "graph",
     "rules",
     "focus",
     "next"
    ],
    "type": "string"
   }
  },
  "required": [
   "view"
  ],
  "type": "object"
 },
 "name": "get_design_context"
}
