 "description": "Find reported AI-related legal-error cases, including fabricated citations and authorities. Use query for a case name, error type, or outcome; response distinguishes sanctions from no sanctions. Optional court, judge, state, and date filters narrow results. Returns at most 10 cases with verified decision links or labeled source fallbacks. Describe recorded allegations and outcomes; dataset inclusion alone does not establish a judicial finding of AI use. Empty and bulk searches are unavailable.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "court": {
    "description": "Court name fragment",
    "minLength": 1,
    "type": "string"
   },
   "from_date": {
    "description": "Inclusive earliest decision date",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "judge": {
    "description": "Judge name fragment",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Maximum results, capped at 10",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Case name, error type, ruling text, court, state, or judge search text",
    "minLength": 2,
    "type": "string"
   },
   "response": {
    "description": "Court response, for example Warning or Sanctions",
    "minLength": 1,
    "type": "string"
   },
   "state": {
    "description": "US state name",
    "minLength": 1,
    "type": "string"
   },
   "to_date": {
    "description": "Inclusive latest decision date",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_ai_abuse_cases",
