{
 "_meta": {
  "openai/toolInvocation/invoked": "File hashes listed",
  "openai/toolInvocation/invoking": "Listing file hashes"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return SHA-256 and size of every served file. Before a redeploy, hash your local files, compare, and upload only the changed ones with update_site mode:'patch' or begin_deploy plus add_files.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "name": {
    "description": "Site name as shown by list_sites, e.g. my-portfolio. Provide name or siteId.",
    "type": "string"
   },
   "siteId": {
    "description": "Site id from list_sites or get_site. Use instead of name.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_file_hashes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "path": {
       "description": "Site-relative path.",
       "type": "string"
      },
      "sha256": {
       "description": "Hex-encoded SHA-256 of the file's bytes.",
       "type": "string"
      },
      "size": {
       "description": "Size in bytes.",
       "type": "number"
      }
     },
     "required": [
      "path",
      "sha256",
      "size"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "totalBytes": {
    "type": "number"
   },
   "totalFiles": {
    "type": "number"
   }
  },
  "required": [
   "siteId",
   "name",
   "files",
   "totalFiles",
   "totalBytes"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List SHA-256 hashes of every file on a site"
}
