{
 "description": "List an event's attendees with check-in status and basic profile. source='rsvp' (default) for free RSVPs, 'ticket' for paid ticket purchases. Requires scope read:events.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "event_id": {
    "description": "Event UUID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "description": "Page size, default 20",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Rows to skip, default 0",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "payment_status": {
    "description": "Filter tickets (source=ticket)",
    "enum": [
     "pending",
     "succeeded",
     "failed",
     "refunded",
     "partially_refunded"
    ],
    "type": "string"
   },
   "rsvp_status": {
    "description": "Filter RSVPs (source=rsvp)",
    "enum": [
     "going",
     "maybe",
     "not_going"
    ],
    "type": "string"
   },
   "source": {
    "description": "'rsvp' (default) or 'ticket'",
    "enum": [
     "rsvp",
     "ticket"
    ],
    "type": "string"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "hivelearn_list_event_attendees"
}
