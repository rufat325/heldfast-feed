{
 "description": "Add data validation rules including dropdowns, numeric constraints, text patterns, date ranges, custom formulas. Supports batch operations for efficiency. Use discriminated conditionType to specify rule type. Best for enforcing data integrity and providing user-friendly input controls.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "requests": {
    "description": "Array of validation rules. Batch multiple ranges for efficiency.",
    "items": {
     "properties": {
      "inputMessage": {
       "description": "Help text shown when cell is selected",
       "type": "string"
      },
      "range": {
       "description": "A1 notation range for validation (e.g., \"B2:B100\")",
       "minLength": 1,
       "type": "string"
      },
      "rule": {
       "oneOf": [
        {
         "properties": {
          "conditionType": {
           "const": "ONE_OF_LIST",
           "type": "string"
          },
          "showDropdown": {
           "default": true,
           "description": "Show dropdown UI in cells",
           "type": "boolean"
          },
          "strict": {
           "default": true,
           "description": "Reject invalid entries",
           "type": "boolean"
          },
          "values": {
           "description": "Hardcoded dropdown options",
           "items": {
            "type": "string"
           },
           "minItems": 1,
           "type": "array"
          }
         },
         "required": [
          "conditionType",
          "values"
         ],
         "type": "object"
        },
        {
         "properties": {
          "conditionType": {
           "const": "ONE_OF_RANGE",
           "type": "string"
          },
          "showDropdown": {
           "default": true,
           "description": "Show dropdown UI in cells",
           "type": "boolean"
          },
          "sourceRange": {
           "description": "A1 notation range containing dropdown options (e.g., \"Options!A1:A10\")",
           "minLength": 1,
           "type": "string"
          },
          "strict": {
           "default": true,
           "description": "Reject invalid entries",
           "type": "boolean"
          }
         },
         "required": [
          "conditionType",
          "sourceRange"
         ],
         "type": "object"
        },
        {
         "properties": {
          "conditionType": {
           "enum": [
            "NUMBER_GREATER",
            "NUMBER_LESS",
            "NUMBER_BETWEEN"
           ],
           "type": "string"
          },
          "strict": {
           "default": true,
           "description": "Reject invalid entries",
           "type": "boolean"
          },
          "values": {
           "description": "1 value for GREATER/LESS, 2 values for BETWEEN",
           "items": {
            "type": "number"
           },
           "maxItems": 2,
           "minItems": 1,
           "type": "array"
          }
         },
         "required": [
          "conditionType",
          "values"
         ],
         "type": "object"
        },
        {
         "properties": {
          "conditionType": {
           "enum": [
            "TEXT_CONTAINS",
            "TEXT_IS_EMAIL",
            "TEXT_IS_URL"
           ],
           "type": "string"
          },
          "strict": {
           "default": true,
           "description": "Reject invalid entries",
           "type": "boolean"
          },
          "values": {
           "description": "Text to match (for TEXT_CONTAINS only)",
           "items": {
            "type": "string"
           },
           "type": "array"
          }
         },
         "required": [
          "conditionType"
         ],
         "type": "object"
        },
        {
         "properties": {
          "conditionType": {
           "enum": [
            "DATE_AFTER",
            "DATE_BEFORE",
            "DATE_BETWEEN"
           ],
           "type": "string"
          },
          "strict": {
           "default": true,
           "description": "Reject invalid entries",
           "type": "boolean"
          },
          "values": {
           "description": "ISO date strings (YYYY-MM-DD)",
           "items": {
            "type": "string"
           },
           "maxItems": 2,
           "minItems": 1,
           "type": "array"
          }
         },
         "required": [
          "conditionType",
          "values"
         ],
         "type": "object"
        },
        {
         "properties": {
          "conditionType": {
           "const": "CUSTOM_FORMULA",
           "type": "string"
          },
          "formula": {
           "description": "Custom validation formula (e.g., \"=A1>0\")",
           "minLength": 1,
           "type": "string"
          },
          "strict": {
           "default": true,
           "description": "Reject invalid entries",
           "type": "boolean"
          }
         },
         "required": [
          "conditionType",
          "formula"
         ],
         "type": "object"
        }
       ]
      }
     },
     "required": [
      "range",
      "rule"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "gid",
   "requests"
  ],
  "type": "object"
 },
 "name": "validation-set",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "failedRanges": {
        "description": "Only populated if some validation rules failed",
        "items": {
         "additionalProperties": false,
         "properties": {
          "error": {
           "description": "Why validation failed for this range",
           "type": "string"
          },
          "range": {
           "description": "A1 notation of range that failed validation setup",
           "type": "string"
          }
         },
         "required": [
          "range",
          "error"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "sheetTitle": {
        "description": "Title of the sheet with validation",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL of the sheet with validation",
        "type": "string"
       },
       "successCount": {
        "description": "Number of validation rules successfully applied",
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "sheetTitle",
       "sheetUrl",
       "successCount"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
