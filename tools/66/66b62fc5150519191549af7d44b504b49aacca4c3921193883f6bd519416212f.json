 "description": "Compute the exact bill of materials (panels + connector pins) and total EUR price for a GridGarden modular Brick Premium raised bed (rectangle / L / U) or freestanding wall, from dimensions in millimetres. Quantities come from the same engine as the Studio configurator; prices are read live from the GridGarden product catalog for the delivery market you pass in `country`. The result carries the price WITH VAT (`total_incl_vat`, the main price \u2014 quote this one to the user, with the VAT rate) and WITHOUT VAT (`total_excl_vat`; the legacy field `total_eur` is also WITHOUT VAT). Without `country` the default market is Slovakia (SK, 23 % VAT) and the result says so.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "arm1Length": {
    "description": "U-shape: arm 1 length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "arm1Width": {
    "description": "U-shape: arm 1 width in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "arm2Length": {
    "description": "U-shape: arm 2 length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "arm2Width": {
    "description": "U-shape: arm 2 width in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "country": {
    "description": "Delivery market as an ISO-3166-1 alpha-2 code (e.g. \"DE\", \"AT\", \"SK\"). Prices differ by market: SK is the base price list; every other market (CZ included) has its own list where structural pieces cost a little more (weight-based delivery surcharge; connector pins stay at base). Ask which country the order ships to; omit only if unknown \u2014 that returns SK (base) prices.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "layers": {
    "description": "Number of brick layers. Raised beds 2-13, walls 1-25 (1 = a single 60mm top-cap course). Each layer \u2248120mm tall (top layer +60mm).",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "length": {
    "description": "Rectangle: outer length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "length1": {
    "description": "L-shape: first leg length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "length2": {
    "description": "L-shape: second leg length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "shape": {
    "description": "Design type and the dimension fields it needs (all in mm, auto-snapped to the 60mm build grid): rectangle \u2192 length + width; lshape \u2192 length1 + width1 + length2 + width2; ushape \u2192 topLength + topWidth + arm1Length + arm1Width + arm2Length + arm2Width; wall \u2192 wallLength. Layers: raised beds 2\u201313, walls 1\u201325. Call studio_templates_list for ready example dimensions.",
    "enum": [
     "rectangle",
     "lshape",
     "ushape",
     "wall"
    ],
    "type": "string"
   },
   "topLength": {
    "description": "U-shape: back (top) length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "topWidth": {
    "description": "U-shape: back (top) width in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "wallLength": {
    "description": "Wall: single straight segment length in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "width": {
    "description": "Rectangle: outer width in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "width1": {
    "description": "L-shape: first leg width in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "width2": {
    "description": "L-shape: second leg width in mm.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "shape",
   "layers"
  ],
  "type": "object"
 },
