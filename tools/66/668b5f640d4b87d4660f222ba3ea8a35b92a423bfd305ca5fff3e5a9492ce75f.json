{
 "_meta": {
  "lovie/risk": "read",
  "openai/toolInvocation/invoked": "Loaded",
  "openai/toolInvocation/invoking": "Loading\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
