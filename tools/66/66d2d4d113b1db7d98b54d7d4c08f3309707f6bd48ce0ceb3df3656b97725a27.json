 "inputSchema": {
  "examples": [
   {
    "monthly_tokens": 750000000
   }
  ],
  "properties": {
   "api_cost_per_1m_out": {
    "description": "Current API output cost per 1M tokens",
    "minimum": 0,
    "type": "number"
   },
   "gpu_provider": {
    "description": "GPU provider (e.g. runpod, modal)",
    "type": "string"
   },
   "gpu_type": {
    "description": "GPU type (e.g. h100, a100-80gb)",
    "type": "string"
   },
   "monthly_tokens": {
    "description": "Monthly output token volume",
    "minimum": 0,
    "type": "number"
   },
   "operational_overhead_pct": {
    "description": "Ops overhead % on GPU cost (default 40)",
    "minimum": 0,
    "type": "number"
   },
   "utilization_pct": {
    "description": "Expected GPU utilization % (default 60)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "monthly_tokens"
  ],
  "type": "object"
 },
 "name": "self-host-breakeven-calculator",
 "title": "Self-Host Breakeven Calculator"
}
