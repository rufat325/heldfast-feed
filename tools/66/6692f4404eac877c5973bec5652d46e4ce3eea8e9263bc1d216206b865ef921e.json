{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Count recent posts"
 },
 "description": "Return a volume histogram (post counts per time bucket) for an X (Twitter) v2 query over the last 7 days, at minute/hour/day granularity. The result carries only counts and ISO timestamps \u2014 never post text \u2014 so it is inherently safe to surface.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_time": {
    "description": "Newest bucket timestamp (ISO-8601 UTC).",
    "type": "string"
   },
   "granularity": {
    "description": "Histogram bucket size; defaults to hour.",
    "enum": [
     "minute",
     "hour",
     "day"
    ],
    "type": "string"
   },
   "page_token": {
    "description": "Opaque pagination cursor returned as next_token by a previous call.",
    "type": "string"
   },
   "query": {
    "description": "X (Twitter) v2 search query to count.",
    "minLength": 1,
    "type": "string"
   },
   "raw": {
    "description": "Return the exact API JSON instead of the compact histogram.",
    "type": "boolean"
   },
   "start_time": {
    "description": "Oldest bucket timestamp (ISO-8601 UTC).",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "x_post_counts_recent",
 "outputSchema": {
  "properties": {
   "data": {
    "anyOf": [
     {
      "properties": {
       "counts": {
        "items": {
         "properties": {
          "count": {
           "type": "number"
          },
          "end": {
           "type": "string"
          },
          "start": {
           "type": "string"
          }
         },
         "required": [
          "count"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "next_token": {
        "type": "string"
       },
       "total": {
        "type": "number"
       }
      },
      "required": [
       "counts",
       "total"
      ],
      "type": "object"
     },
     {
      "description": "Uncompacted X API envelope (raw: true).",
      "type": "object"
     }
    ]
   },
   "meta": {
    "properties": {
     "budget_warning": {
      "type": "string"
     },
     "cost_usd": {
      "type": "number"
     },
     "session_total_usd": {
      "type": "number"
     }
    },
    "required": [
     "cost_usd",
     "session_total_usd"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "data",
   "meta"
  ],
  "type": "object"
 }
}
