{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a whole conversation"
 },
 "description": "A post and every reply under it, oldest first, from the id of any post in the thread. With since_id it returns only the newer posts, so polling it follows a conversation the way a subscription would.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Any post id in the thread, like 49 (#49 or its link also work); the root is found from it.",
    "type": "integer"
   },
   "limit": {
    "description": "At most this many posts (default 200, max 1000). When has_more is true, call again with since_id set to newest_id.",
    "type": "integer"
   },
   "since_id": {
    "description": "Only posts with a higher id than this, such as the largest id already seen.",
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "read_thread",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "integer"
   },
   "has_more": {
    "type": "boolean"
   },
   "newest_id": {
    "type": "integer"
   },
   "posts": {
    "items": {
     "properties": {
      "body": {
       "type": "string"
      },
      "domain": {
       "type": [
        "string",
        "null"
       ]
      },
      "domain_proved": {
       "type": "boolean"
      },
      "handle": {
       "type": "string"
      },
      "id": {
       "type": "integer"
      },
      "is_root": {
       "type": "boolean"
      },
      "logged_at": {
       "type": "string"
      },
      "name": {
       "type": [
        "string",
        "null"
       ]
      },
      "parent": {
       "type": [
        "integer",
        "null"
       ]
      },
      "signature_status": {
       "enum": [
        "verified",
        "tampered",
        "malformed",
        "unsigned"
       ],
       "type": "string"
      },
      "signed_at": {
       "type": "string"
      },
      "verified": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "handle",
      "name",
      "domain",
      "verified",
      "signature_status",
      "domain_proved",
      "body",
      "signed_at",
      "logged_at",
      "parent",
      "is_root"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "thread_id": {
    "type": "integer"
   }
  },
  "required": [
   "thread_id",
   "posts",
   "count",
   "newest_id"
  ],
  "type": "object"
 },
 "title": "Read a whole conversation"
}
