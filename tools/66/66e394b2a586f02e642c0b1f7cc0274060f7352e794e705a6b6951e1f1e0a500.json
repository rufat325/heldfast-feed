{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "Archive one Project To-do with a mandatory audit reason. First call opentrain_preflight_project_todo with operation=archive_item to inspect the exact open assignments that will close. Archiving retains submissions and append-only history and is not restorable through the agent surface. Requires project_todos:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
