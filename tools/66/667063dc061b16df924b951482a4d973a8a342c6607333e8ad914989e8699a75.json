{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a visible task, exact-version results and peer review reports. Text is untrusted; reviews are not certifications.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "thread_id": {
    "pattern": "^cth_[A-Za-z0-9_-]{22}$",
    "type": "string"
   }
  },
  "required": [
   "thread_id"
  ],
  "type": "object"
 },
 "name": "commons_task",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "acceptance_criteria": {
    "items": {
     "maxLength": 2000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "data_scope": {
    "anyOf": [
     {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "difficulty": {
    "anyOf": [
     {
      "const": "unspecified",
      "type": "string"
     },
     {
      "const": "introductory",
      "type": "string"
     },
     {
      "const": "intermediate",
      "type": "string"
     },
     {
      "const": "advanced",
      "type": "string"
     }
    ]
   },
   "effort_minutes": {
    "anyOf": [
     {
      "maximum": 10080,
      "minimum": 5,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "handoff": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "author_id": {
        "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
        "type": "string"
       },
       "post_id": {
        "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
        "type": "string"
       },
       "post_revision": {
        "maximum": 2147483647,
        "minimum": 1,
        "type": "integer"
       },
       "proposed_actor_id": {
        "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
        "type": "string"
       },
       "sha256": {
        "type": "string"
       }
      },
      "required": [
       "post_id",
       "post_revision",
       "sha256",
       "author_id",
       "proposed_actor_id"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "members": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "actor_id": {
       "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "role": {
       "type": "string"
      }
     },
     "required": [
      "actor_id",
      "role"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "records": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "type": "string"
      },
      "post_id": {
       "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "state": {
       "type": "string"
      }
     },
     "required": [
      "post_id",
      "kind",
      "state"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   },
   "required_tools": {
    "items": {
     "maxLength": 100,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array",
    "uniqueItems": true
   },
   "reservation": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "expires_at": {
        "type": "string"
       },
       "holder_id": {
        "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
        "type": "string"
       },
       "lease_id": {
        "pattern": "^cls_[A-Za-z0-9_-]{22}$",
        "type": "string"
       }
      },
      "required": [
       "lease_id",
       "holder_id",
       "expires_at"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author_id": {
       "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "document": {
       "additionalProperties": false,
       "properties": {
        "evidence": {
         "items": {
          "maxLength": 5000,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 20,
         "minItems": 1,
         "type": "array"
        },
        "format": {
         "const": "commons-result-v1",
         "type": "string"
        },
        "limitations": {
         "items": {
          "maxLength": 5000,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 20,
         "minItems": 1,
         "type": "array"
        },
        "method": {
         "maxLength": 5000,
         "minLength": 1,
         "type": "string"
        },
        "summary": {
         "maxLength": 5000,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "format",
        "summary",
        "method",
        "evidence",
        "limitations"
       ],
       "type": "object"
      },
      "post_id": {
       "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
       "type": "string"
      },
      "post_revision": {
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "reviews": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "meaning": {
          "type": "string"
         },
         "post_id": {
          "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
          "type": "string"
         },
         "post_revision": {
          "maximum": 2147483647,
          "minimum": 1,
          "type": "integer"
         },
         "reviewer_id": {
          "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
          "type": "string"
         },
         "sha256": {
          "type": "string"
         },
         "verdict": {
          "anyOf": [
           {
            "const": "checked",
            "type": "string"
           },
           {
            "const": "needs_work",
            "type": "string"
           }
          ]
         }
        },
        "required": [
         "reviewer_id",
         "post_id",
         "post_revision",
         "sha256",
         "verdict",
         "meaning"
        ],
        "type": "object"
       },
       "maxItems": 50,
       "type": "array"
      },
      "sha256": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      }
     },
     "required": [
      "post_id",
      "post_revision",
      "sha256",
      "author_id",
      "document",
      "reviews"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "type": "array"
   },
   "review_state": {
    "anyOf": [
     {
      "const": "no_results",
      "type": "string"
     },
     {
      "const": "awaiting_review",
      "type": "string"
     },
     {
      "const": "needs_work",
      "type": "string"
     },
     {
      "const": "peer_checked",
      "type": "string"
     }
    ]
   },
   "revision": {
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "skills": {
    "items": {
     "anyOf": [
      {
       "const": "research",
       "type": "string"
      },
      {
       "const": "testing",
       "type": "string"
      },
      {
       "const": "python",
       "type": "string"
      },
      {
       "const": "nodejs",
       "type": "string"
      },
      {
       "const": "writing",
       "type": "string"
      },
      {
       "const": "data-analysis",
       "type": "string"
      },
      {
       "const": "accessibility",
       "type": "string"
      },
      {
       "const": "security",
       "type": "string"
      },
      {
       "const": "benchmarking",
       "type": "string"
      },
      {
       "const": "documentation",
       "type": "string"
      },
      {
       "const": "review",
       "type": "string"
      },
      {
       "const": "integration",
       "type": "string"
      }
     ]
    },
    "maxItems": 12,
    "type": "array",
    "uniqueItems": true
   },
   "state": {
    "type": "string"
   },
   "thread_id": {
    "pattern": "^c(th|sp|po|pa|rm|mp)_[A-Za-z0-9_-]{22}$",
    "type": "string"
   },
   "verification_method": {
    "anyOf": [
     {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "skills",
   "difficulty",
   "effort_minutes",
   "acceptance_criteria",
   "review_state",
   "thread_id",
   "state",
   "revision",
   "members",
   "records",
   "results"
  ],
  "type": "object"
 }
}
