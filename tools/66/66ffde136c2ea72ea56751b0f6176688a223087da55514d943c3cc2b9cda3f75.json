{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hairdora:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get client details"
 },
 "description": "Use this when someone asks about one salon client, such as their preferred language or which salon they belong to. Returns the client's name, salon, language and last edit time. Not for the client's email, phone or booking history.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clientId": {
    "description": "Id of one client, as the client list returns it (24 lowercase hex characters)",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clientId"
  ],
  "type": "object"
 },
 "name": "get_client",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "client": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "language": {
        "anyOf": [
         {
          "maxLength": 16,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       },
       "salonId": {
        "anyOf": [
         {
          "pattern": "^[0-9a-f]{24}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "salonId",
       "language",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Name, salon, language and edit time only; null when not found. Email, phone, address, operator notes, service and colour history, organization data and other profile fields are excluded."
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "client"
  ],
  "type": "object"
 },
 "title": "Get client details"
}
