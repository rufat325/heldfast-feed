{
 "_meta": {
  "openai/toolInvocation/invoked": "Procurement plan ready",
  "openai/toolInvocation/invoking": "Optimizing buyer economics\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "agentmart:recommend"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Optimize where, how, and for how long a specific buyer should acquire a capability across direct, marketplace, credit, subscription, and commitment purchase paths. Uses buyer-specific entitlements, switching costs, reliability, quality, and expected demand; returns an explainable recommendation plus a cheapest-PAYG counterfactual. Read-only and makes no external provider calls.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "candidates": {
    "items": {
     "properties": {
      "entitlement_expiration": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null
      },
      "fixed_cost": {
       "default": 0,
       "minimum": 0,
       "type": "number"
      },
      "marketplace_source": {
       "default": "direct",
       "type": "string"
      },
      "pricing_model": {
       "default": "payg",
       "enum": [
        "payg",
        "credits",
        "subscription",
        "commitment"
       ],
       "type": "string"
      },
      "provider": {
       "type": "string"
      },
      "purchase_channel": {
       "default": "direct",
       "type": "string"
      },
      "quality": {
       "default": 1,
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "reliability": {
       "default": 1,
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "remaining_entitlement": {
       "default": 0,
       "minimum": 0,
       "type": "number"
      },
      "switching_cost": {
       "default": 0,
       "minimum": 0,
       "type": "number"
      },
      "unit_cost": {
       "default": 0,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "provider"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "expected_remaining_demand": {
    "description": "Expected remaining workload units over the planning horizon.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "minCompletion": {
    "default": 0.99,
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "minQuality": {
    "default": 0.95,
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "expected_remaining_demand",
   "candidates"
  ],
  "type": "object"
 },
 "name": "procure",
 "securitySchemes": [
  {
   "scopes": [
    "agentmart:recommend"
   ],
   "type": "oauth2"
  }
 ],
 "title": "AgentMart Buyer Procurement"
}
