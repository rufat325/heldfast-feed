{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List automation rules in the workspace, with paging and filters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderIds": {
    "description": "Comma-separated folder ids to filter by",
    "type": "string"
   },
   "isActive": {
    "description": "Filter by active state",
    "type": "boolean"
   },
   "page": {
    "description": "0-based page index",
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search over automation names",
    "type": "string"
   },
   "runType": {
    "description": "Filter by run type",
    "enum": [
     "instant",
     "schedule"
    ],
    "type": "string"
   },
   "sortBy": {
    "description": "Sort expression, e.g. \"createdAt:desc\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_automations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "List Automations"
}
