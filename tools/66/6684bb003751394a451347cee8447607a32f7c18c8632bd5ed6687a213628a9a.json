{"_meta":{"xdata.kr/credential":{"providers":["fourinsure"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=fourinsure","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: fourinsure__session__login (\uac19\uc740 account_link_id). \uae30\ubcf8\uc73c\ub85c\ub294 \ucd9c\ub825\ud560 \uc218 \uc788\ub294 \uc99d\uba85\uc11c \uc2e0\uccad \uac74(\uc811\uc218\ubc88\ud638, \uc0c1\ud0dc, \ub0a0\uc9dc)\uc744 \ubbf8\ub9ac \ubcf4\uc5ec \uc8fc\uba70 PDF \ub294 \uc2e3\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc2e4\uc81c PDF \ub97c \uacb0\uacfc artifacts \ub85c \ubc1b\uc73c\ub824\uba74 dry_run=false \uc640 confirm_download=true \ub97c \ud568\uaed8 \ubcf4\ub0b4\uc138\uc694. \ud30c\uc77c: PDF \u00b7 \uae30\uad00\uc774 \ubc1c\uae09\ud55c \uc6d0\ubcf8. \uacb0\uacfc\uc758 artifacts[] \uc5d0 \uc2e4\ub9ac\uace0, \ub0b4\ub824\ubc1b\uae30 \ub9c1\ud06c(download_url)\ub294 15\ubd84 \ub3d9\uc548 \uc5f4\ub9ac\uba70 \ud30c\uc77c\uc740 7\uc77c \ub3d9\uc548 \ubcf4\uad00\ub429\ub2c8\ub2e4. \ub9c1\ud06c\uac00 \ub9cc\ub8cc\ub418\uba74 \uacb0\uacfc\uc758 job_id \ub85c xdata__job__result \ub97c \ub2e4\uc2dc \ubd88\ub7ec \uc0c8 \ub9c1\ud06c\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778 \uc5c6\uc774 \ubc1b\uc740 \uacb0\uacfc\ub294 \ud568\uaed8 \uc628 recovery_receipt \ub97c \ub530\ub85c \ubcf4\uad00\ud588\ub2e4\uac00, \ucc98\uc74c\uc758 job_id \ub098 pack_run_id \uc640 \ud568\uaed8 xdata__job__result \uc5d0 \ubcf4\ub0b4\uc138\uc694. \uc99d\ud45c\ub85c\ub294 \uadf8 \uacb0\uacfc \ud558\ub098\ub9cc, \uc6d0\ub798 \ud30c\uc77c \ubcf4\uad00 \uae30\uac04\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc99d\ud45c\ub294 \uacf5\uac1c\ud558\uc9c0 \ub9c8\uc138\uc694. \uc783\uc5b4\ubc84\ub9ac\uba74 \uac00\uc785\ud574\ub3c4 \ub418\ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub85c\uadf8\uc778\ud574\ub3c4 \uc99d\ud45c\ub294 \uadf8\ub300\ub85c \uc4f0\uc774\uace0, \ub2e4\ub978 \uacb0\uacfc\ub294 \uc5f4\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \uc99d\ud45c\uac00 \uc5c6\uc73c\uba74 \ucc98\uc74c \uacc4\uc815\uacfc \uac19\uc740 \ud658\uacbd(\ub370\ubaa8 \u00b7 \uc815\uc2dd)\uc5d0\uc11c\ub9cc \uacb0\uacfc\ub97c \uc77d\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 5\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"confirm_download":{"description":"\uae30\ubcf8 false. dry_run \uc744 false \ub85c, \uc774 \uac12\uc744 true \ub85c \ud568\uaed8 \uc785\ub825\ud574\uc57c \uc2e4\uc81c PDF \ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \uadf8\ub807\uc9c0 \uc54a\uc73c\uba74 \ubbf8\ub9ac\ubcf4\uae30\ub9cc \ud569\ub2c8\ub2e4. \uc2e4\uc81c PDF \ub97c \ubc1b\uc73c\uba74 \ubc1c\uae09 \uc774\ub825\uc5d0 \ucd9c\ub825 \ucc98\ub9ac \ud45c\uc2dc\uac00 \ub0a8\uc2b5\ub2c8\ub2e4.","type":"boolean"},"cvrc_no":{"description":"\ub300\uc0c1 \uc99d\uba85\uc11c \uc2e0\uccad \uac74\uc744 \uace0\ub974\ub294 \uc811\uc218\ubc88\ud638.","type":"string"},"download_all_available":{"description":"\uae30\ubcf8 false. true \uc774\uba74 cvrc_no \ud558\ub098\uac00 \uc544\ub2c8\ub77c \ucd9c\ub825\ud560 \uc218 \uc788\ub294 \uc2e0\uccad \uac74 \uc804\uccb4\ub97c \ub300\uc0c1\uc73c\ub85c \ud569\ub2c8\ub2e4.","type":"boolean"},"dry_run":{"description":"\uae30\ubcf8 true(\ubbf8\ub9ac\ubcf4\uae30). \uc811\uc218\ubc88\ud638, \uc0c1\ud0dc, \ub0a0\uc9dc\ub9cc \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uc2e4\uc81c PDF \ub97c \uacb0\uacfc artifacts \ub85c \ubc1b\uc73c\ub824\uba74 false \ub85c \ud558\uace0 confirm_download=true \ub97c \ud568\uaed8 \uc785\ub825\ud574 \uc8fc\uc138\uc694.","type":"boolean"}},"type":"object"},"name":"fourinsure__b1__certificate__history__pdf_download","securitySchemes":[{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\uc99d\uba85\uc11c PDF \ub2e4\uc6b4\ub85c\ub4dc"}
