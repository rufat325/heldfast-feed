{
 "description": "Define a pre-authorized emergency pathway at delegation time. Only the delegator can define these.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "delegation_ref": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "expanded_scope_categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max_duration": {
    "default": "PT1H",
    "type": "string"
   },
   "review_authority": {
    "type": "string"
   },
   "review_deadline": {
    "default": "PT24H",
    "type": "string"
   },
   "trigger_field": {
    "type": "string"
   },
   "trigger_operator": {
    "enum": [
     "eq",
     "neq",
     "gt",
     "lt",
     "gte",
     "lte"
    ],
    "type": "string"
   },
   "trigger_value": {
    "type": [
     "string",
     "number",
     "boolean"
    ]
   },
   "trust_epoch": {
    "default": 1,
    "type": "number"
   },
   "valid_until": {
    "type": "string"
   }
  },
  "required": [
   "delegation_ref",
   "description",
   "trigger_field",
   "trigger_operator",
   "trigger_value",
   "expanded_scope_categories",
   "review_authority",
   "valid_until"
  ],
  "type": "object"
 },
 "name": "define_emergency_pathway"
}
