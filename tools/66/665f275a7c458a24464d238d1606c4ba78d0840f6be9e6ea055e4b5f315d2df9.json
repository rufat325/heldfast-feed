{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delete a mailbox. Two-phase commit. WARNING: this also deletes all stored emails for that mailbox.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirmation_token": {
    "description": "Token from the first (plan) phase. The plan response shows the mailbox + a warning that stored mail will be wiped. Re-pass to execute.",
    "format": "uuid",
    "type": "string"
   },
   "mail_hosting_id": {
    "description": "Mail hosting ID. Discover via infomaniak_list_mail_hostings.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "mailbox_name": {
    "description": "Local part of the mailbox WITHOUT the @domain (e.g. 'anthony' for anthony@coden.lu). NOT the full email address. Verify with infomaniak_list_mailboxes before deleting \u2014 this wipes stored mail.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "mail_hosting_id",
   "mailbox_name"
  ],
  "type": "object"
 },
 "name": "infomaniak_delete_mailbox",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "confirmation_token": {
      "type": "string"
     },
     "next_step_markdown": {
      "type": "string"
     },
     "plan": {
      "additionalProperties": false,
      "properties": {
       "mail_hosting_id": {
        "type": "number"
       },
       "mailbox_name": {
        "type": "string"
       }
      },
      "required": [
       "mail_hosting_id",
       "mailbox_name"
      ],
      "type": "object"
     },
     "status": {
      "const": "plan",
      "type": "string"
     },
     "token_expires_at": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "plan",
     "confirmation_token",
     "token_expires_at",
     "next_step_markdown"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "mailbox_name": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "status": {
      "const": "applied",
      "type": "string"
     }
    },
    "required": [
     "status",
     "mailbox_name",
     "message"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
