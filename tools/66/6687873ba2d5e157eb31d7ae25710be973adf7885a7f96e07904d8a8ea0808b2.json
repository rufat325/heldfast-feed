{
 "description": "Wait for a selector to reach a state.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "selector": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "state": {
    "enum": [
     "attached",
     "detached",
     "visible",
     "hidden"
    ],
    "type": "string"
   },
   "timeout": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "sessionId",
   "selector"
  ],
  "type": "object"
 },
 "name": "browser_wait_for_selector",
 "title": "Browser Wait For Selector"
}
