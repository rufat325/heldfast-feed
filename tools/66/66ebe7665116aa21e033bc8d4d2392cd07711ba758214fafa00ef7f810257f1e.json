{
 "description": "Execute a GOAT SDK action (swap, transfer, etc.) with ClawVault rules engine validation. The action is only executed if rules allow it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "GOAT action name (e.g. \"swap_tokens\", \"transfer_token_by_mint_address\")",
    "type": "string"
   },
   "params": {
    "description": "JSON-encoded parameters for the action",
    "type": "string"
   }
  },
  "required": [
   "action",
   "params"
  ],
  "type": "object"
 },
 "name": "goat_execute_action"
}
