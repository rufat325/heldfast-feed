{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update part"
 },
 "description": "Update an existing part/inventory item by ID. Requires parts:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "building_id": {
    "description": "Building ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "category": {
    "description": "Category label",
    "maxLength": 200,
    "type": "string"
   },
   "cost": {
    "description": "Unit cost",
    "minimum": 0,
    "type": "number"
   },
   "desired_quantity": {
    "description": "Target / reorder quantity",
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "Part ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "location_id": {
    "description": "Location ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "name": {
    "description": "Part name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "part_number": {
    "description": "Part number / SKU",
    "maxLength": 200,
    "type": "string"
   },
   "quantity": {
    "description": "Current stock quantity",
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "site_id": {
    "description": "Site ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "specific_location": {
    "description": "Storage location description",
    "maxLength": 500,
    "type": "string"
   },
   "supplier": {
    "description": "DEPRECATED - legacy free-text supplier name. Use supplier_id instead.",
    "maxLength": 500,
    "type": "string"
   },
   "supplier_id": {
    "description": "Vendor ID (resolve via list_vendors)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_part",
 "title": "Update part"
}
