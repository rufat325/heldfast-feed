 "description": "Audit a resource inventory against a tagging contract. The finding that spans the inventory: two tag keys differing only in case, which cloud APIs treat as different keys so every grouping and cost report splits silently across them. Also reports a required tag absent, an empty value that satisfies a presence check and carries no information, a value with surrounding whitespace that groups separately, a value outside a permitted set, and a value a declared pattern does not accept. Pay 140000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contract": {
    "additionalProperties": false,
    "description": "The rules to apply. An unknown property here is refused rather than ignored.",
    "example": {
     "case_sensitive": true,
     "forbid_unknown_keys": false,
     "permitted_values": {
      "environment": [
       "development",
       "staging",
       "production"
      ]
     },
     "required": [
      "owner",
      "environment",
      "cost_centre"
     ],
     "value_patterns": {
      "cost_centre": "CC-[0-9][0-9][0-9][0-9]"
     }
    },
    "properties": {
     "case_sensitive": {
      "description": "Whether a tag key matches the contract only in the exact case written. Defaults to true, which is how cloud APIs behave.",
      "type": "boolean"
     },
     "forbid_unknown_keys": {
      "description": "Defaults to false, since a partial contract is normal.",
      "type": "boolean"
     },
     "permitted_values": {
      "description": "Per tag key, the values permitted.",
      "type": "object"
     },
     "required": {
      "items": {
       "maxLength": 128,
       "type": "string"
      },
      "maxItems": 100,
      "minItems": 1,
      "type": "array"
     },
     "value_patterns": {
      "description": "Per tag key, a pattern the value must match. Character classes, anchors and simple quantifiers only: groups, alternation and escapes are refused so matching is cheap by construction.",
      "type": "object"
     }
    },
    "type": "object"
   },
   "resources": {
    "description": "The inventory, up to 5000 resources. Nothing is fetched: no cloud account is contacted and no credential is accepted, so the document supplied is the whole input.",
    "example": [
     {
      "id": "arn:aws:s3:::exports",
      "tags": {
       "cost_centre": "CC-1001",
       "environment": "production",
       "owner": "data"
      },
      "type": "aws_s3_bucket"
     },
     {
      "id": "arn:aws:s3:::staging-exports",
      "tags": {
       "Owner": "data",
       "cost_centre": "CC1001",
       "environment": "stage"
      },
      "type": "aws_s3_bucket"
     },
     {
      "id": "arn:aws:ec2:us-east-1:123456789012:instance/i-1",
      "tags": {
       "cost_centre": "CC-1002",
       "environment": "production",
       "owner": "  "
      },
      "type": "aws_instance"
     },
     {
      "id": "arn:aws:ec2:us-east-1:123456789012:instance/i-2",
      "type": "aws_instance"
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maxLength": 512,
       "type": "string"
      },
      "tags": {
       "type": "object"
      },
      "type": {
       "maxLength": 128,
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 5000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "resources",
   "contract"
  ],
  "type": "object"
 },
 "name": "resource_tag_contract_audit",
