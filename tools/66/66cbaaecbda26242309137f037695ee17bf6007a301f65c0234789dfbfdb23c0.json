{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "forum.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List forum topics"
 },
 "description": "List topics in a specific forum category. Provide categorySlug and/or categoryId \u2014 given only one, the other is resolved from the category list automatically. Use forum_list_categories to discover categories.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categoryId": {
    "description": "Numeric category ID. Provide this and/or categorySlug.",
    "type": "integer"
   },
   "categorySlug": {
    "description": "Category slug (e.g. 'bug-reports'). Provide this and/or categoryId.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "forum_list_topics",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "topic_list": {
    "additionalProperties": true,
    "properties": {
     "topics": {
      "items": {
       "additionalProperties": true,
       "properties": {
        "category_id": {
         "type": [
          "number",
          "null"
         ]
        },
        "created_at": {
         "type": "string"
        },
        "excerpt": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "type": "number"
        },
        "last_posted_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "posts_count": {
         "type": "number"
        },
        "reply_count": {
         "type": "number"
        },
        "slug": {
         "type": "string"
        },
        "tags": {
         "anyOf": [
          {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          {
           "type": "null"
          }
         ]
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "slug",
        "posts_count",
        "reply_count",
        "created_at"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "topics"
    ],
    "type": "object"
   }
  },
  "required": [
   "topic_list"
  ],
  "type": "object"
 },
 "title": "List forum topics"
}
