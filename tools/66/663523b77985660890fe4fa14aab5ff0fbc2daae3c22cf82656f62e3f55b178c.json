{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update work order schedule"
 },
 "description": "Update a work order schedule entry by ID (date, times, stop_order, notes). work_order_id is immutable. Requires work_order_schedules:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "duration_minutes": {
    "description": "Planned duration in minutes",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "id": {
    "description": "Work order schedule ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "scheduled_date": {
    "description": "Date (YYYY-MM-DD)",
    "type": "string"
   },
   "scheduled_end_time": {
    "description": "End time (HH:MM)",
    "type": "string"
   },
   "scheduled_start_time": {
    "description": "Start time (HH:MM)",
    "type": "string"
   },
   "scheduling_notes": {
    "description": "Scheduling notes",
    "type": "string"
   },
   "stop_order": {
    "description": "1-based stop position in the day plan",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "technician_id": {
    "description": "Technician Clerk user ID",
    "minLength": 1,
    "type": "string"
   },
   "travel_time_minutes": {
    "description": "Travel time from previous stop",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_work_order_schedule",
 "title": "Update work order schedule"
}
