{
 "description": "LAATSTE stap van de bestelling \u2014 gebruik deze tool PAS nadat de gebruiker het voedingsplan \u00e9n de samengestelde musette met de prijs heeft gezien en bevestigt te willen bestellen. Werkwijze: toon EERST het plan (bereken_voedingsplan) en de musette met producten + totaalprijs (stel_musette_samen). Vraag PAS daarna, als de gebruiker wil afrekenen, om e-mailadres en bezorgadres (voornaam, achternaam, straat + huisnummer, postcode, plaats, land). Deze tool berekent het plan opnieuw, stelt dezelfde musette samen en maakt een directe Stripe-betaallink met winkelwagen + bezorgadres al ingevuld \u2014 \u00e9\u00e9n klik om af te rekenen. Gebruik dezelfde rit-gegevens als bereken_voedingsplan. Alleen Nederland en Belgi\u00eb. Voor alleen een overzicht zonder afrekenen: gebruik 'stel_musette_samen'.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "achternaam": {
    "description": "Achternaam van de ontvanger",
    "minLength": 1,
    "type": "string"
   },
   "afstand_km": {
    "description": "Ritafstand in km (alternatief voor duur_minuten)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "binnen": {
    "description": "Indoor/hometrainer (meer zweetverlies)",
    "type": "boolean"
   },
   "darmgetraind": {
    "description": "Kan de renner >75 g/uur verdragen?",
    "type": "boolean"
   },
   "duur_minuten": {
    "description": "Geschatte rijduur in minuten (nauwkeuriger dan afstand)",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "email": {
    "description": "E-mailadres voor de bevestiging",
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "ftp_percentage": {
    "description": "Exact % van FTP (overschrijft 'intensiteit')",
    "maximum": 150,
    "minimum": 20,
    "type": "number"
   },
   "gem_snelheid_kmh": {
    "description": "Gemiddelde snelheid, voor duurschatting uit afstand",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "geslacht": {
    "description": "Voor FTP-schatting wanneer alleen vermogen bekend is",
    "enum": [
     "M",
     "V"
    ],
    "type": "string"
   },
   "hoogtemeters": {
    "description": "Totale klim in meters",
    "minimum": 0,
    "type": "number"
   },
   "intensiteit": {
    "description": "Inspanningsniveau van de rit",
    "enum": [
     "herstel",
     "endurance",
     "tempo",
     "drempel",
     "wedstrijd"
    ],
    "type": "string"
   },
   "land": {
    "description": "Land: NL of BE (standaard NL)",
    "enum": [
     "NL",
     "BE"
    ],
    "type": "string"
   },
   "merk_voorkeur": {
    "description": "Merkvoorkeur voor de producten (standaard: amacx)",
    "enum": [
     "amacx",
     "maurten",
     "geen"
    ],
    "type": "string"
   },
   "plaats": {
    "description": "Woonplaats",
    "minLength": 1,
    "type": "string"
   },
   "postcode": {
    "description": "Postcode",
    "minLength": 1,
    "type": "string"
   },
   "straat_huisnummer": {
    "description": "Straat + huisnummer, bv. 'Weesperstraat 107'",
    "minLength": 1,
    "type": "string"
   },
   "temperatuur_celsius": {
    "description": "Verwachte buitentemperatuur",
    "maximum": 55,
    "minimum": -20,
    "type": "number"
   },
   "voornaam": {
    "description": "Voornaam van de ontvanger",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "email",
   "voornaam",
   "achternaam",
   "straat_huisnummer",
   "postcode",
   "plaats"
  ],
  "type": "object"
 },
 "name": "bestel_musette"
}
