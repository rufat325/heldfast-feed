{
 "description": "Find source pages that link to competitor targets but not excluded/user targets, then prioritize link-gap outreach and quality review.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backlinks_status_type": {
    "default": "live",
    "enum": [
     "live",
     "all",
     "lost"
    ],
    "type": "string"
   },
   "broken_only": {
    "default": false,
    "type": "boolean"
   },
   "dofollow_only": {
    "default": false,
    "type": "boolean"
   },
   "exclude_internal_backlinks": {
    "default": true,
    "type": "boolean"
   },
   "exclude_targets": {
    "default": [],
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "include_indirect_links": {
    "default": true,
    "type": "boolean"
   },
   "include_subdomains": {
    "default": true,
    "type": "boolean"
   },
   "internal_list_limit": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "max_spam_score": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "min_domain_rank": {
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "min_page_rank": {
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "min_rank": {
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 20000,
    "minimum": 0,
    "type": "integer"
   },
   "rank_scale": {
    "default": "one_hundred",
    "enum": [
     "one_hundred",
     "one_thousand"
    ],
    "type": "string"
   },
   "sort_by": {
    "default": "rank",
    "enum": [
     "rank",
     "domain_rank",
     "page_rank",
     "first_seen",
     "last_seen"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "targets": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "targets"
  ],
  "type": "object"
 },
 "name": "agentseo_backlinks_page_intersection",
 "title": "AgentSEO Backlinks Page Intersection"
}
