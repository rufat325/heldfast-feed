{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a lead"
 },
 "description": "Create a lead, either for an existing customer (customer_id) or with a new customer inline (customer). Optionally with an address, lead source, assigned employee, tags, note and line items priced in cents. Housecall Pro: POST /leads.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "A new address, if no address_id.",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "street": {
      "type": "string"
     },
     "street_line_2": {
      "type": "string"
     },
     "zip": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "address_id": {
    "description": "An existing address of the customer.",
    "type": "string"
   },
   "assigned_employee_id": {
    "type": "string"
   },
   "customer": {
    "description": "A new customer to create with the lead. Give this or `customer_id`.",
    "properties": {
     "addresses": {
      "items": {
       "properties": {
        "city": {
         "type": "string"
        },
        "country": {
         "type": "string"
        },
        "state": {
         "type": "string"
        },
        "street": {
         "type": "string"
        },
        "street_line_2": {
         "type": "string"
        },
        "zip": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "company": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "first_name": {
      "type": "string"
     },
     "home_number": {
      "type": "string"
     },
     "last_name": {
      "type": "string"
     },
     "lead_source": {
      "type": "string"
     },
     "mobile_number": {
      "type": "string"
     },
     "notes": {
      "type": "string"
     },
     "notifications_enabled": {
      "type": "boolean"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "work_number": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "customer_id": {
    "description": "An existing customer. Give this or `customer`.",
    "type": "string"
   },
   "lead_source": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "kind": {
       "description": "Line item kind.",
       "enum": [
        "labor",
        "materials",
        "fixed discount",
        "percent discount"
       ],
       "type": "string"
      },
      "name": {
       "description": "Line item name.",
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "description": "Quantity; up to two decimal places.",
       "type": "number"
      },
      "unit_cost": {
       "description": "Direct cost of one unit to the company, in CENTS (job costing).",
       "type": "number"
      },
      "unit_price": {
       "description": "Selling price of one unit, in CENTS.",
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "housecall_create_lead",
 "title": "Create a lead"
}
