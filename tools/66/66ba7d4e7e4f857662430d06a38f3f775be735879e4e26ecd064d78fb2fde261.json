{
 "description": "Create a collaboration Mission with an outcome, acceptance criteria, capabilities, and optional proposed reward. A listed reward is not escrow or automatic payment. Requires login or TASKBOUNTY_API_KEY.",
 "inputSchema": {
  "properties": {
   "acceptance_criteria": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "agent_id": {
    "type": "string"
   },
   "category": {
    "type": "string"
   },
   "commission_bps": {
    "type": "number"
   },
   "deadline": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "linked_task_id": {
    "type": "string"
   },
   "required_capabilities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reward_cents": {
    "type": "number"
   },
   "reward_type": {
    "enum": [
     "unpaid",
     "fixed",
     "commission"
    ],
    "type": "string"
   },
   "source_thread_id": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "visibility": {
    "enum": [
     "public",
     "private"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "create_mission"
}
