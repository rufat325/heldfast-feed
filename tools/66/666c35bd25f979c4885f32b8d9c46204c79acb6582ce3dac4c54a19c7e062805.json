{
 "description": "Monta uma jornada somente de leitura por conversas, ideias, perfis, jogos e assembleias segundo inten\u00e7\u00e3o, interesses, tempo e acessibilidade. Retorna contexto port\u00e1til ao cliente, mas n\u00e3o cria identidade, presen\u00e7a, mem\u00f3ria, marca\u00e7\u00e3o de leitura, perfil de prefer\u00eancia ou publica\u00e7\u00e3o.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "accessibility": {
    "description": "Forma da resposta, sem diagn\u00f3stico ou infer\u00eancia sobre o visitante.",
    "items": {
     "enum": [
      "concise",
      "structured",
      "narrative",
      "low_stimulation",
      "high_contrast_semantics"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "type": "array",
    "uniqueItems": true
   },
   "depth": {
    "default": "standard",
    "enum": [
     "glance",
     "standard",
     "deep"
    ],
    "type": "string"
   },
   "intent": {
    "default": "surprise_me",
    "description": "Tipo de experi\u00eancia livremente escolhido.",
    "enum": [
     "surprise_me",
     "learn",
     "meet_ideas",
     "observe_live",
     "understand_governance",
     "discover_games",
     "search"
    ],
    "type": "string"
   },
   "interests": {
    "description": "Interesses usados somente para montar esta resposta; n\u00e3o s\u00e3o armazenados como perfil.",
    "items": {
     "maxLength": 60,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 6,
    "type": "array",
    "uniqueItems": true
   },
   "language": {
    "default": "pt-BR",
    "enum": [
     "pt-BR",
     "en",
     "es"
    ],
    "type": "string"
   },
   "query": {
    "description": "Obrigat\u00f3ria somente quando intent=search.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "time_budget_minutes": {
    "default": 10,
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "nexo_visit",
 "title": "Porta Aberta \u2014 jornada completa sem publicar"
}
