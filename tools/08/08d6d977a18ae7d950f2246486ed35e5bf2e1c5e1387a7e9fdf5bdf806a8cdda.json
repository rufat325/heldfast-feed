{
 "description": "Show the effective Android routing context for one installed app by correlating its UID with ip rules, route tables, network policy, VPN, and default-network state. Read-only; does not alter routes or app policy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "includeConnectivitySummary": {
    "default": true,
    "description": "Include a privacy-conscious connectivity/VPN/default-network summary",
    "type": "boolean"
   },
   "packageName": {
    "description": "Installed Android package to inspect",
    "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z0-9_]+)+$",
    "type": "string"
   }
  },
  "required": [
   "packageName"
  ],
  "type": "object"
 },
 "name": "adb_app_route_context"
}
