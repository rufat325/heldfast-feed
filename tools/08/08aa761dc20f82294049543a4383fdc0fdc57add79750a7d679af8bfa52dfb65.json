{
 "description": "Create and emit an NFSe (nota fiscal de servico)",
 "inputSchema": {
  "properties": {
   "cnpj": {
    "description": "CNPJ of emitter",
    "type": "string"
   },
   "inscricao_municipal": {
    "description": "Municipal registration",
    "type": "string"
   },
   "razao_social": {
    "description": "Company name",
    "type": "string"
   },
   "ref": {
    "description": "Unique reference ID for this NFSe",
    "type": "string"
   },
   "servico": {
    "description": "Service details",
    "properties": {
     "aliquota": {
      "description": "ISS tax rate",
      "type": "number"
     },
     "codigo_tributacao_municipio": {
      "description": "Municipal tax code",
      "type": "string"
     },
     "discriminacao": {
      "description": "Service description",
      "type": "string"
     },
     "item_lista_servico": {
      "description": "Service list item code",
      "type": "string"
     },
     "valor_servicos": {
      "description": "Service value",
      "type": "number"
     }
    },
    "type": "object"
   },
   "tomador": {
    "description": "Service taker (client) info",
    "properties": {
     "cnpj": {
      "description": "Client CNPJ",
      "type": "string"
     },
     "cpf": {
      "description": "Client CPF",
      "type": "string"
     },
     "email": {
      "description": "Client email",
      "type": "string"
     },
     "razao_social": {
      "description": "Client name",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "ref",
   "cnpj",
   "servico"
  ],
  "type": "object"
 },
 "name": "create_nfse"
}
