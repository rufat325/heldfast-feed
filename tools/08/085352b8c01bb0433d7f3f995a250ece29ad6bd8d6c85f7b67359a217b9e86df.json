{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new Zendesk ticket.\n\nRequired: subject and either comment (for new ticket with initial message) or description.\nOptional: priority, type, tags, assignee_id, group_id, custom_fields.\n\nFor custom_fields, use list_zendesk_ticket_fields to find field IDs first.\nFor group_id, use list_zendesk_groups to find available groups.\n\nExample:\n{\n  \"subject\": \"Login issue\",\n  \"comment\": \"User cannot log in after password reset\",\n  \"priority\": \"high\",\n  \"type\": \"incident\"\n}",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignee_id": {
    "description": "Agent ID to assign ticket to",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "comment": {
    "description": "Initial ticket comment/description (visible to requester)",
    "type": "string"
   },
   "custom_fields": {
    "description": "Custom field values (use list_zendesk_ticket_fields for IDs)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "value": {}
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "group_id": {
    "description": "Group ID (use list_zendesk_groups to find)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "priority": {
    "description": "Ticket priority",
    "enum": [
     "low",
     "normal",
     "high",
     "urgent"
    ],
    "type": "string"
   },
   "requester_email": {
    "description": "Requester email (creates user if needed)",
    "format": "email",
    "type": "string"
   },
   "status": {
    "description": "Initial status (default: new)",
    "enum": [
     "new",
     "open",
     "pending",
     "hold",
     "solved"
    ],
    "type": "string"
   },
   "subdomain": {
    "description": "Zendesk subdomain (optional if only one account connected)",
    "type": "string"
   },
   "subject": {
    "description": "Ticket subject line",
    "type": "string"
   },
   "tags": {
    "description": "Tags to apply",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "Ticket type",
    "enum": [
     "problem",
     "incident",
     "question",
     "task"
    ],
    "type": "string"
   }
  },
  "required": [
   "subject",
   "comment"
  ],
  "type": "object"
 },
 "name": "create_zendesk_ticket"
}
