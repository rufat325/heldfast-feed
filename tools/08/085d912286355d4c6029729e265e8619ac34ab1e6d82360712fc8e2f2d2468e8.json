    "type": "string"
   },
   "backgroundColor": {
    "description": "Background color (RGBA values 0-1)",
    "properties": {
     "alpha": {
      "type": "number"
     },
     "blue": {
      "type": "number"
     },
     "green": {
      "type": "number"
     },
     "red": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "pageObjectIds": {
    "description": "Array of slide IDs to update",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "presentationId": {
    "description": "Presentation ID",
    "type": "string"
   }
  },
  "required": [
   "presentationId",
   "pageObjectIds",
   "backgroundColor"
  ],
  "type": "object"
 },
 "name": "setGoogleSlidesBackground"
}
