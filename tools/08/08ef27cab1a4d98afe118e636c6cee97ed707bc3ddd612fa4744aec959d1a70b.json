{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Verify an emitted app"
 },
 "description": "Needs a subscription. Checks an emitted app before it is built: missing files, altered verbatim files, absent packages, the expo-router config merge, whether the installed Xcode can build it, and whether a change needs a new native build.",
 "inputSchema": {
  "properties": {
   "appId": {
    "description": "the share code given to emit_app; `appId` in .opointo/files.json",
    "type": "string"
   },
   "config": {
    "properties": {
     "icon": {
      "description": "app.json",
      "type": "string"
     },
     "main": {
      "description": "package.json \"main\"",
      "type": "string"
     },
     "moduleSuffixes": {
      "description": "tsconfig compilerOptions",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "monochromeImage": {
      "description": "app.json android.adaptiveIcon",
      "type": "string"
     },
     "nativeModulesDir": {
      "description": "package.json expo.autolinking; omit if unset",
      "type": "string"
     },
     "plugins": {
      "description": "app.json",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "scheme": {
      "description": "app.json",
      "type": "string"
     },
     "supportsTablet": {
      "description": "app.json ios",
      "type": "boolean"
     },
     "userInterfaceStyle": {
      "description": "app.json",
      "type": "string"
     }
    },
    "type": "object"
   },
   "dependencies": {
    "description": "package.json dependencies' keys",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "files": {
    "description": "each file written, the hidden .opointo/files.json included: { path, bytes }, path from the project root",
    "items": {
     "properties": {
      "bytes": {
       "description": "size in bytes on disk as `wc -c` reports, not the character count",
       "type": "number"
      },
      "path": {
       "type": "string"
      },
      "sha": {
       "description": "optional; when sent, the byte check is skipped",
       "type": "string"
      }
     },
     "required": [
      "path"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "toolchain": {
    "properties": {
     "enableSceneSupport": {
      "description": "app.json expo-build-properties ios.enableSceneSupport",
      "type": "boolean"
     },
     "expoBuildProperties": {
      "description": "the INSTALLED expo-build-properties version; omit if absent",
      "type": "string"
     },
     "expoSdk": {
      "description": "the INSTALLED expo version, e.g. \"56.0.15\" (`npm ls expo`)",
      "type": "string"
     },
     "lastBuildFingerprint": {
      "type": "string"
     },
     "nativeFingerprint": {
      "type": "string"
     },
     "xcode": {
      "description": "`xcodebuild -version`, e.g. \"26.2\"; omit without Xcode",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "files"
  ],
  "type": "object"
 },
 "name": "verify_app",
 "title": "Verify an emitted app"
}
