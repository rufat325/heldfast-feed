 "description": "Measure an error budget against real counts, with exact decimal arithmetic rather than floating point. Reports the budget exhausted or mostly consumed, the objective not met, and a burn rate per interval above the sustainable one. A budget that rounds to fewer than one event is reported as carrying no information, since any failure is then a breach. Intervals are sorted by start, so the order supplied does not change the answer. Pay 220000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "intervals": {
    "description": "The measured intervals. good must not exceed total.",
    "example": [
     {
      "good": 7000,
      "start": "2026-09-07T00:00:00Z",
      "total": 7000
     },
     {
      "good": 6965,
      "start": "2026-09-14T00:00:00Z",
      "total": 7000
     },
     {
      "good": 6997,
      "start": "2026-09-21T00:00:00Z",
      "total": 7000
     },
     {
      "good": 6998,
      "start": "2026-09-28T00:00:00Z",
      "total": 7000
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "good": {
       "minimum": 0,
       "type": "integer"
      },
      "start": {
       "description": "When the interval begins. An RFC 3339 timestamp or an epoch number in milliseconds. A string with no UTC offset is reported, because it is not a point in time.",
       "type": [
        "string",
        "number"
       ]
      },
      "total": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "start",
      "good",
      "total"
     ],
     "type": "object"
    },
    "maxItems": 10000,
    "minItems": 1,
    "type": "array"
   },
   "objective": {
    "description": "The objective as a percentage, such as 99.9 or \"99.95%\". Parsed exactly to nine decimal places.",
    "example": "99.9",
    "type": [
     "string",
     "number"
    ]
   },
   "window_days": {
    "description": "The budget window, which sets what a sustainable burn rate is.",
    "example": 28,
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "objective",
   "window_days",
   "intervals"
  ],
  "type": "object"
 },
