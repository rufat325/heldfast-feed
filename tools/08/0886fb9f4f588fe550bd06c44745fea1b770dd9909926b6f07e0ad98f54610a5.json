{
 "annotations": {
  "destructiveHint": true,
  "title": "Dig tunnel"
 },
 "description": "Dig a straight tunnel from the bot in a horizontal direction. `length` blocks long, `width` wide (centered, default 1), `height` tall (default 2 so the bot fits). Cancellable; reports progress.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "direction": {
    "description": "Horizontal direction to tunnel",
    "enum": [
     "north",
     "south",
     "east",
     "west",
     "forward"
    ],
    "type": "string"
   },
   "height": {
    "description": "Tunnel height (default 2)",
    "maximum": 16,
    "minimum": 1,
    "type": "integer"
   },
   "length": {
    "description": "How many blocks forward",
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "width": {
    "description": "Tunnel width, centered (default 1)",
    "maximum": 16,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "direction",
   "length"
  ],
  "type": "object"
 },
 "name": "dig_tunnel"
}
