{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search public opportunities, vendors, awards, exclusions, or reference collections. Results include provenance and a generation-pinned cursor.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "collection": {
    "description": "Public collection name, such as opportunities, vendors, awards, exclusions, or naics.",
    "type": "string"
   },
   "cursor": {
    "description": "Opaque next_cursor from the preceding search page.",
    "type": [
     "string",
     "null"
    ]
   },
   "limit": {
    "description": "Maximum records to return, from 1 to 50.",
    "format": "uint",
    "maximum": 50,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "q": {
    "default": "",
    "description": "Plain-language search terms; empty lists the selected collection.",
    "type": "string"
   }
  },
  "required": [
   "collection"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$defs": {
   "AwardAvailability": {
    "properties": {
     "artifact_http_status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "check_interval_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
     },
     "checked_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "inventory_http_status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "latest_release_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "latest_release_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "max_check_age_seconds": {
      "format": "int64",
      "type": "integer"
     },
     "state": {
      "type": "string"
     }
    },
    "required": [
     "state",
     "check_interval_seconds",
     "max_check_age_seconds"
    ],
    "type": "object"
   },
   "AwardCoverage": {
    "properties": {
     "dataset": {
      "type": "string"
     },
     "freshness": {
      "$ref": "#/$defs/AwardFreshness"
     },
     "source_date": {
      "type": "string"
     },
     "source_url": {
      "type": "string"
     }
    },
    "required": [
     "dataset",
     "source_date",
     "source_url",
     "freshness"
    ],
    "type": "object"
   },
   "AwardFreshness": {
    "properties": {
     "age_state": {
      "type": "string"
     },
     "age_warning_after_days": {
      "format": "int64",
      "type": "integer"
     },
     "effective_source_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_age_days": {
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "upstream": {
      "$ref": "#/$defs/AwardAvailability"
     },
     "warning": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "age_state",
     "age_warning_after_days",
     "upstream"
    ],
    "type": "object"
   },
   "ExclusionCoverage": {
    "properties": {
     "freshness": {
      "$ref": "#/$defs/SourceFreshness",
      "description": "Fresh, stale, unknown or unavailable, with age and the 24-hour warning policy."
     },
     "observed_at": {
      "description": "Observation time does not replace the official source timestamp.",
      "type": [
       "string",
       "null"
      ]
     },
     "scope": {
      "type": [
       "string",
       "null"
      ]
     },
     "sha256": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "description": "Present as unavailable when no SAM coverage exists in this generation.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "freshness"
    ],
    "type": "object"
   },
   "FreshnessState": {
    "enum": [
     "fresh",
     "stale",
     "unknown",
     "unavailable"
    ],
    "type": "string"
   },
   "JsonObject": {
    "description": "Source-specific JSON map. The envelope is stable; map keys vary by official source.",
    "type": "object"
   },
   "RecordSummary": {
    "properties": {
     "data": {
      "$ref": "#/$defs/JsonObject",
      "description": "Source-specific fields, including provenance and official identifiers."
     },
     "id": {
      "description": "Stable identifier for a record in this generation.",
      "type": "string"
     },
     "summary": {
      "description": "Short searchable text, when returned by this operation.",
      "type": [
       "string",
       "null"
      ]
     },
     "title": {
      "description": "Human-readable record title.",
      "type": "string"
     },
     "url": {
      "description": "Public canonical path for the record.",
      "type": "string"
     }
    },
    "required": [
     "id",
     "title",
     "url",
     "data"
    ],
    "type": "object"
   },
   "SourceFreshness": {
    "properties": {
     "attention_required": {
      "type": "boolean"
     },
     "evaluated_at": {
      "description": "UTC time when age was evaluated; source and observation dates are unchanged.",
      "type": "string"
     },
     "max_age_seconds": {
      "description": "Explicit warning threshold for this daily snapshot. Not a scheduler promise.",
      "format": "int64",
      "type": "integer"
     },
     "source_age_seconds": {
      "description": "Age of the official source timestamp, never the import or enrichment timestamp.",
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "state": {
      "$ref": "#/$defs/FreshnessState"
     },
     "warn_age_seconds": {
      "description": "Early-warning boundary, separate from the stale-source boundary.",
      "format": "int64",
      "type": "integer"
     },
     "warning": {
      "description": "User-facing warning, or null when within the warning threshold.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "state",
     "evaluated_at",
     "max_age_seconds",
     "warn_age_seconds",
     "attention_required"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "award_coverage": {
    "description": "Dated award coverage and official release availability, when applicable.",
    "items": {
     "$ref": "#/$defs/AwardCoverage"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "collection": {
    "description": "Collection searched, such as opportunities or awards.",
    "type": "string"
   },
   "coverage": {
    "anyOf": [
     {
      "$ref": "#/$defs/ExclusionCoverage"
     },
     {
      "type": "null"
     }
    ],
    "description": "Exclusion-specific source age and freshness warnings, when applicable."
   },
   "coverage_url": {
    "description": "Public source-date endpoint, when this collection supplies it.",
    "type": [
     "string",
     "null"
    ]
   },
   "generation": {
    "description": "UUID of the snapshot used for every result on this page.",
    "type": "string"
   },
   "items": {
    "description": "Matching public records.",
    "items": {
     "$ref": "#/$defs/RecordSummary"
    },
    "type": "array"
   },
   "next_cursor": {
    "description": "Opaque cursor for the next page, or null at the end.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "generation",
   "collection",
   "items"
  ],
  "type": "object"
 },
 "title": "Search federal records"
}
