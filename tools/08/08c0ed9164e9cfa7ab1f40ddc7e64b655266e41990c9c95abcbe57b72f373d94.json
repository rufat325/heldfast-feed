{
 "_legacy": {
  "bucket": "checkout",
  "successor": "https://api.trusteed.xyz/demo-store/mcp/checkout"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a UCP (Universal Commerce Protocol) checkout session from line items. Returns a UCP checkout object with status 'incomplete'. Starts the UCP flow (ucp_* tools); for the standard flow use create_cart instead. Do not mix the two flows on the same purchase. Checkout guide: read the MCP resource trusteed://guides/checkout.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "agent_key": {
    "description": "Sandbox credential from `create_sandbox_key`. Use this when your client cannot set an `Authorization: Bearer` header.",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 currency code (e.g. USD)",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "idempotency_key": {
    "description": "REQUIRED for this write unless sent as the `Idempotency-Key` header or `params._meta[\"trusteed/idempotency-key\"]`. 1-128 chars from [A-Za-z0-9._:/-]. Reuse the same value when retrying the same operation.",
    "maxLength": 128,
    "pattern": "^[A-Za-z0-9._:/-]{1,128}$",
    "type": "string"
   },
   "intent": {
    "additionalProperties": true,
    "description": "Intent context for relevance and personalization",
    "properties": {
     "action": {
      "description": "Intent action (e.g. 'purchase', 'gift', 'compare')",
      "type": "string"
     },
     "context": {
      "description": "Natural language context for personalization",
      "type": "string"
     },
     "locale": {
      "description": "ISO locale",
      "type": "string"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   "label": {
    "description": "Optional label for additional identifiers (e.g. external order ref, multi-PSP reference)",
    "type": "string"
   },
   "line_items": {
    "description": "Line items for the checkout",
    "items": {
     "additionalProperties": true,
     "properties": {
      "price": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "description": "Ignored: the catalogue price is used and returned per line. Any non-negative integer is accepted.",
         "minimum": 0,
         "type": "number"
        },
        "currency": {
         "description": "ISO 4217 currency code",
         "maxLength": 3,
         "minLength": 3,
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "product_id": {
       "description": "Product identifier",
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "description": "Quantity",
       "exclusiveMinimum": 0,
       "type": "integer"
      },
      "title": {
       "description": "Ignored: the catalogue title is used. Any non-empty string is accepted.",
       "minLength": 1,
       "type": "string"
      },
      "variant_id": {
       "description": "Variant (size/colour) id as listed by get_product_details. Required when the product has more than one variant; the price and stock of THAT variant apply.",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "product_id",
      "title",
      "quantity",
      "price"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "meta": {
    "description": "UCP request metadata. meta['ucp-agent'].profile = URL of the platform profile; it must be an https URL without credentials (at most 2048 characters)."
   }
  },
  "required": [
   "currency",
   "line_items"
  ],
  "type": "object"
 },
 "name": "ucp_create_checkout",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "approval_url": {
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "expires_at": {
    "description": "ISO-8601 UTC instant at which this checkout SESSION stops being usable. It is not a stock reservation and not a price guarantee.",
    "type": "string"
   },
   "expires_in_seconds": {
    "description": "Whole seconds left on this checkout SESSION at response time (0 when already past). It is not a stock reservation and not a price guarantee.",
    "minimum": 0,
    "type": "integer"
   },
   "extensions": {
    "additionalProperties": {},
    "description": "`warnings[]` with `code`, `message`, `severity`.",
    "type": "object"
   },
   "fulfillment": {
    "additionalProperties": {},
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "intent": {
    "additionalProperties": {},
    "type": "object"
   },
   "label": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "price": {
       "additionalProperties": true,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "variant_id": {
       "type": "string"
      },
      "variant_title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "product_id",
      "title",
      "quantity",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_action": {
    "additionalProperties": {},
    "description": "Only when a person must approve or pay: `url`, `kind`, `retry`.",
    "type": "object"
   },
   "next_step": {
    "description": "Next-action code, not a tool name: provide_shipping_destination, refresh_shipping_rates, choose_shipping_option, preview_ucp_checkout, review_not_available_in_ucp.",
    "type": "string"
   },
   "next_step_message": {
    "type": "string"
   },
   "payment_options": {
    "description": "When present, ask the person which option they want; never choose for them.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "incomplete",
     "requires_escalation",
     "ready_for_complete",
     "complete_in_progress",
     "completed",
     "canceled"
    ],
    "type": "string"
   },
   "totals": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "amount": {
       "type": "number"
      },
      "currency": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "amount",
      "currency"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "updated_at": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "status",
   "currency",
   "line_items",
   "totals",
   "created_at",
   "updated_at"
  ],
  "type": "object"
 }
}
