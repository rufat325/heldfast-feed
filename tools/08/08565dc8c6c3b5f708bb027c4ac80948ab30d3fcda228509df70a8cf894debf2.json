{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the brand's Insights and standing findings. Increase weeks to read earlier entries.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brandSlug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "weeks": {
    "default": 2,
    "maximum": 26,
    "minimum": 2,
    "type": "integer"
   }
  },
  "required": [
   "brandSlug"
  ],
  "type": "object"
 },
 "name": "parse_dashboard_insights",
 "securitySchemes": [
  {
   "scopes": [
    "parse:dashboard:read",
    "user:org:read"
   ],
   "type": "oauth2"
  }
 ]
}
