{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Resolve a heading ID, footnote label, node type, or current AST path to reviewable PART 12 AST paths without silently choosing among multiple matches.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "ast": {
    "description": "PART 12 AST (maximum 1000000 JSON bytes)"
   },
   "selector": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "heading-id",
       "footnote-label",
       "node-type",
       "ast-path"
      ],
      "type": "string"
     },
     "value": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "kind",
     "value"
    ],
    "type": "object"
   }
  },
  "required": [
   "ast",
   "selector"
  ],
  "type": "object"
 },
 "name": "carve_select_ast_nodes",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "matchCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "matches": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "identity": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "preview": {
       "type": "string"
      },
      "previewTruncated": {
       "type": "boolean"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "type",
      "preview",
      "previewTruncated"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "selector": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "heading-id",
       "footnote-label",
       "node-type",
       "ast-path"
      ],
      "type": "string"
     },
     "value": {
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "kind",
     "value"
    ],
    "type": "object"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "selector",
   "matchCount",
   "matches",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Find AST nodes by semantic selector"
}
