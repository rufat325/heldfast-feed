{"_meta":{"co.trooth/access":"write","co.trooth/category":"Build and publish","co.trooth/cli":"trooth semanto sign","co.trooth/route":"POST /os/semanto/{trooth_id}/sign"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Sign and publish"},"description":"Signs the confirmed version under the company's key and publishes it, witnessed and logged. Leave version out for the newest. With two-officer signing on, the answer says who else must approve. The approval is recorded as this agent for the person it acts for. Needs an agent key with write scope (owner scope where only the owner may).","icons":[{"mimeType":"image/png","src":"data:image/png;base64,","theme":"light"},{"mimeType":"image/png","src":"data:image/png;base64,","theme":"dark"}],"inputSchema":{"additionalProperties":false,"properties":{"trooth_id":{"description":"The company's Trooth ID, for example acme. Leave it out to use the company the agent key belongs to.","type":"string"},"version":{"description":"Optional: the version to sign, from semanto_review_get.","type":"integer"}},"type":"object"},"name":"semanto_sign","title":"Sign and publish"}
