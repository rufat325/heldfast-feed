{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Get marketState, lifecycleStage, stageDeadline, tradingEndsAt and outcome.",
 "inputSchema": {
  "properties": {
   "chainId": {
    "type": "number"
   },
   "marketAddress": {
    "type": "string"
   }
  },
  "required": [
   "marketAddress"
  ],
  "type": "object"
 },
 "name": "problee_get_market_state",
 "outputSchema": {
  "$defs": {
   "MarketLifecycleStage": {
    "enum": [
     "open",
     "closed",
     "result_proposed",
     "result_challenged",
     "vote_open",
     "vote_closed",
     "under_review",
     "resolved",
     "voided"
    ],
    "type": "string"
   },
   "McpMarketStateResponse": {
    "additionalProperties": false,
    "properties": {
     "market": {
      "additionalProperties": false,
      "properties": {
       "address": {
        "pattern": "^0x[a-fA-F0-9]{40}$",
        "type": "string"
       },
       "lifecycleStage": {
        "$ref": "#/$defs/MarketLifecycleStage"
       },
       "marketState": {
        "enum": [
         "open",
         "closed",
         "creator_proposal",
         "challenge",
         "human_voting",
         "council_review",
         "resolved",
         "void"
        ],
        "type": "string"
       },
       "outcome": {
        "anyOf": [
         {
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "stageDeadline": {
        "anyOf": [
         {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "tradingEndsAt": {
        "anyOf": [
         {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "address",
       "marketState",
       "tradingEndsAt",
       "lifecycleStage",
       "stageDeadline",
       "outcome"
      ],
      "type": "object"
     }
    },
    "required": [
     "market"
    ],
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/McpMarketStateResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Canonical market-state graph"
}
