{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "WHOIS"
 },
 "description": "Retrieves WHOIS registration data for a domain: registrar, creation, update and expiry dates, EPP status codes, nameservers and the contact roles the registry still publishes (personal data is usually redacted). tldSupported=false means the TLD has no queryable WHOIS server, which differs from an unregistered domain (found=false). domain_expiry returns the expiry with the remaining days computed. Anonymous, rate-limited per IP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "domain": {
    "description": "Domain name, e.g. deinkunde.com",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "whois",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "contacts": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "role": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "createdAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "error": {
    "type": [
     "string",
     "null"
    ]
   },
   "expiresAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "found": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "nameservers": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "ok": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "registrar": {
    "type": [
     "string",
     "null"
    ]
   },
   "statuses": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "tld": {
    "type": [
     "string",
     "null"
    ]
   },
   "tldSupported": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "updatedAt": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "title": "WHOIS"
}
