{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Suggest stories for this project"
 },
 "description": "Given a short description of the current project (stack, what you're building, recent problems), suggest up to 3 worklore stories worth reproducing here, with why each fits and its tier.",
 "inputSchema": {
  "properties": {
   "context": {
    "description": "Project context: stack, goal, recent TODOs/problems.",
    "type": "string"
   }
  },
  "required": [
   "context"
  ],
  "type": "object"
 },
 "name": "suggest_for_project",
 "outputSchema": {
  "properties": {
   "about_tiers": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "suggested": {
    "items": {
     "properties": {
      "capability": {
       "anyOf": [
        {
         "pattern": "^T[0-4] \u00b7 ",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "slug": {
       "type": "string"
      },
      "stack": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "tier": {
       "anyOf": [
        {
         "enum": [
          "T0",
          "T1",
          "T2",
          "T3",
          "T4"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "visibility": {
       "enum": [
        "public",
        "private"
       ],
       "type": "string"
      },
      "why": {
       "minLength": 1,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 3,
    "type": "array"
   }
  },
  "required": [
   "suggested"
  ],
  "type": "object"
 }
}
