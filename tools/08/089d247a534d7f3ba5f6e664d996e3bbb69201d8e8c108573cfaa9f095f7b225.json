{
 "description": "Build a spoken narration script from a list of session milestone events (VibeEvent[]), then speak it aloud. Kind may be task-done, pr-opened, tests-pass, tests-fail, error, spec-completed, prototype-finished, session-end, or manual.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "events": {
    "description": "Session milestone events (VibeEvent[] / RawEvent[]).",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "mode": {
    "description": "summary (terse) or podcast (walkthrough).",
    "enum": [
     "summary",
     "podcast"
    ],
    "type": "string"
   },
   "style": {
    "description": "monologue (single voice) or podcast (two-host).",
    "enum": [
     "monologue",
     "podcast"
    ],
    "type": "string"
   }
  },
  "required": [
   "events"
  ],
  "type": "object"
 },
 "name": "recap",
 "title": "Recap a session"
}
