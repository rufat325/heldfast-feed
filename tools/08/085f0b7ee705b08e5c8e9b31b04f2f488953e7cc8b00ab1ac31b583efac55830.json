 "description": "Changes the project title and presentation: aspect ratio, narrator voice, speaking pace, subtitles and their size and colour, background music and volume. Both setting and value are required. If you need the current value or accepted choices, call huasheng_get_style first. Calling this twice with the same arguments is safe. **Exception \u2014 setting=voice after production has started re-records every clip, re-renders the video and spends credits (not refundable).** Call it with cost_only:true first to get the price, show it to the user, and only then change it; the result then has pending:true and the project reports voice_changing until it finishes, and the receipt carries action.operation.id for huasheng_wait_for_action.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client_action_id": {
    "description": "MCP App only: submission id; reuse for the same click. Models omit.",
    "type": "string"
   },
   "cost_only": {
    "description": "Only for setting=voice: quote what the change would cost and change nothing. Free while production has not started; after that, credits per billed character",
    "type": "boolean"
   },
   "pid": {
    "description": "The 15-digit video id; no default.",
    "type": "integer"
   },
   "setting": {
    "description": "Which setting to change",
    "enum": [
     "aspect",
     "voice",
     "speed",
     "subtitle",
     "subtitle-size",
     "subtitle-color",
     "subtitle-outline",
     "bgm",
     "bgm-volume",
     "voice-volume",
     "auto-dub",
     "sync",
     "portrait-style",
     "name"
    ],
    "type": "string"
   },
   "ui_lang": {
    "description": "MCP App only: follow-up language. Models omit.",
    "type": "string"
   },
   "value": {
    "description": "What to change it to",
    "type": "string"
   }
  },
  "required": [
   "pid",
   "setting",
   "value"
  ],
  "type": "object"
 },
