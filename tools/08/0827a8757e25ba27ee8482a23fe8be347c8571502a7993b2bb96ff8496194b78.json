{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Retrieve a known public identifier. Supply generation from search for a consistent result.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "collection": {
    "description": "Public collection name returned by search.",
    "type": "string"
   },
   "generation": {
    "description": "Retained generation UUID from search for a consistent record snapshot.",
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "description": "Exact stable record ID returned by search, not a page URL or slug.",
    "type": "string"
   }
  },
  "required": [
   "collection",
   "id"
  ],
  "type": "object"
 },
 "name": "detail",
 "outputSchema": {
  "$defs": {
   "AwardAvailability": {
    "properties": {
     "artifact_http_status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "check_interval_seconds": {
      "format": "uint64",
      "minimum": 0,
      "type": "integer"
     },
     "checked_at": {
      "type": [
       "string",
       "null"
      ]
     },
     "inventory_http_status": {
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "latest_release_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "latest_release_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "max_check_age_seconds": {
      "format": "int64",
      "type": "integer"
     },
     "state": {
      "type": "string"
     }
    },
    "required": [
     "state",
     "check_interval_seconds",
     "max_check_age_seconds"
    ],
    "type": "object"
   },
   "AwardCoverage": {
    "properties": {
     "dataset": {
      "type": "string"
     },
     "freshness": {
      "$ref": "#/$defs/AwardFreshness"
     },
     "source_date": {
      "type": "string"
     },
     "source_url": {
      "type": "string"
     }
    },
    "required": [
     "dataset",
     "source_date",
     "source_url",
     "freshness"
    ],
    "type": "object"
   },
   "AwardFreshness": {
    "properties": {
     "age_state": {
      "type": "string"
     },
     "age_warning_after_days": {
      "format": "int64",
      "type": "integer"
     },
     "effective_source_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_age_days": {
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "upstream": {
      "$ref": "#/$defs/AwardAvailability"
     },
     "warning": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "age_state",
     "age_warning_after_days",
     "upstream"
    ],
    "type": "object"
   },
   "ExclusionCoverage": {
    "properties": {
     "freshness": {
      "$ref": "#/$defs/SourceFreshness",
      "description": "Fresh, stale, unknown or unavailable, with age and the 24-hour warning policy."
     },
     "observed_at": {
      "description": "Observation time does not replace the official source timestamp.",
      "type": [
       "string",
       "null"
      ]
     },
     "scope": {
      "type": [
       "string",
       "null"
      ]
     },
     "sha256": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "source_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "description": "Present as unavailable when no SAM coverage exists in this generation.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "freshness"
    ],
    "type": "object"
   },
   "FreshnessState": {
    "enum": [
     "fresh",
     "stale",
     "unknown",
     "unavailable"
    ],
    "type": "string"
   },
   "JsonObject": {
    "description": "Source-specific JSON map. The envelope is stable; map keys vary by official source.",
    "type": "object"
   },
   "SourceFreshness": {
    "properties": {
     "evaluated_at": {
      "description": "UTC time when age was evaluated; source and observation dates are unchanged.",
      "type": "string"
     },
     "max_age_seconds": {
      "description": "Explicit warning threshold for this daily snapshot. Not a scheduler promise.",
      "format": "int64",
      "type": "integer"
     },
     "source_age_seconds": {
      "description": "Age of the official source timestamp, never the import or enrichment timestamp.",
      "format": "int64",
      "type": [
       "integer",
       "null"
      ]
     },
     "state": {
      "$ref": "#/$defs/FreshnessState"
     },
     "warning": {
      "description": "User-facing warning, or null when within the warning threshold.",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "state",
     "evaluated_at",
     "max_age_seconds"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "award_coverage": {
    "description": "Award snapshot age and latest official release evidence.",
    "items": {
     "$ref": "#/$defs/AwardCoverage"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "collection": {
    "description": "Absent for curated reference records.",
    "type": [
     "string",
     "null"
    ]
   },
   "coverage": {
    "anyOf": [
     {
      "$ref": "#/$defs/ExclusionCoverage"
     },
     {
      "type": "null"
     }
    ],
    "description": "Present for exclusions, including explicit source-age warnings."
   },
   "data": {
    "$ref": "#/$defs/JsonObject"
   },
   "generation": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "text_has_more": {
    "description": "Whether another text chunk is available.",
    "type": [
     "boolean",
     "null"
    ]
   },
   "text_length": {
    "description": "Total text characters; absent from internal brief notices.",
    "format": "uint",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "generation",
   "id",
   "title",
   "text",
   "data"
  ],
  "type": "object"
 },
 "title": "Read a federal record"
}
