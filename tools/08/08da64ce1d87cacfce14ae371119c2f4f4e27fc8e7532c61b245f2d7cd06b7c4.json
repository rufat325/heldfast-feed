{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find likely US judges by identifying search text, optionally narrowed by court, state, or county. Use this before requesting a profile when the canonical KnowJudges profile URL is unknown. Specifically named matches may have historical or uncertain service; retain their reported status. Returns at most 10 matches linked to canonical KnowJudges profiles; empty and bulk searches are unavailable.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "county": {
    "description": "County name fragment",
    "type": "string"
   },
   "court": {
    "description": "Court name fragment",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "Maximum results, capped at 10",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Judge name or other identifying search text",
    "minLength": 2,
    "type": "string"
   },
   "state": {
    "description": "US state name or postal abbreviation, for example DC or California",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "find_judges",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "additionalProperties": false,
    "properties": {
     "county": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "court": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "state": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "state",
     "court",
     "county"
    ],
    "type": "object"
   },
   "limit": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "county": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "court_level": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "court_name": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "display_name": {
       "type": "string"
      },
      "guidance_scopes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "judicial_role": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "presentation_posture": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "profile_url": {
       "type": "string"
      },
      "service_status": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "state": {
       "anyOf": [
        {
         "type": "string"
