{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Runs a make or just target and returns structured output (stdout, stderr, exit code, duration). Auto-detects make vs just.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alwaysMake": {
    "description": "Force rebuild regardless of timestamps (make -B, make only)",
    "type": "boolean"
   },
   "args": {
    "default": [],
    "description": "Additional arguments to pass to the target. Each element is validated to prevent flag injection.",
    "items": {
     "maxLength": 65536,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "dryRun": {
    "description": "Preview commands without executing (make -n / just --dry-run)",
    "type": "boolean"
   },
   "env": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Environment variables to pass to the target execution (key-value pairs)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "file": {
    "description": "Path to a non-default makefile or justfile (maps to make -f FILE / just --justfile FILE)",
    "maxLength": 4096,
    "type": "string"
   },
   "jobs": {
    "description": "Number of parallel jobs (make -j N, make only)",
    "type": "number"
   },
   "keepGoing": {
    "description": "Continue after errors in independent targets (make -k, make only)",
    "type": "boolean"
   },
   "path": {
    "description": "Project root path",
    "maxLength": 4096,
    "type": "string"
   },
   "question": {
    "description": "Check if target is up to date without executing (make -q, make only). Exit code 0 = up to date.",
    "type": "boolean"
   },
   "silent": {
    "description": "Suppress command echoing (make -s / just --quiet)",
    "type": "boolean"
   },
   "target": {
    "description": "Target to run",
    "maxLength": 255,
    "type": "string"
   },
   "tool": {
    "default": "auto",
    "description": "Task runner to use: \"auto\" detects from files, or force \"make\"/\"just\"",
    "enum": [
     "auto",
     "make",
     "just"
    ],
    "type": "string"
   },
   "trace": {
    "description": "Trace execution order (make --trace, make only)",
    "type": "boolean"
   },
   "verbose": {
    "description": "Enable verbose output (just --verbose, just only)",
    "type": "boolean"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "run",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exitCode": {
    "type": "number"
   },
   "stderr": {
    "type": "string"
   },
   "stdout": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "timedOut": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "exitCode",
   "timedOut"
  ],
  "type": "object"
 },
 "title": "Make/Just Run"
}
