{
 "description": "List FaceSign sessions with optional filtering by status, date range, and search term. Supports pagination via cursor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clientReferenceId": {
    "description": "Filter by client reference ID",
    "type": "string"
   },
   "cursor": {
    "description": "Pagination cursor from a previous response",
    "type": "string"
   },
   "flowId": {
    "description": "Filter sessions by flow ID",
    "type": "string"
   },
   "fromDate": {
    "description": "Start of date range (Unix timestamp in ms)",
    "type": "number"
   },
   "limit": {
    "description": "Max sessions to return (1-100, default 10)",
    "type": "number"
   },
   "search": {
    "description": "Search term to filter sessions",
    "type": "string"
   },
   "sortBy": {
    "description": "Field to sort by",
    "enum": [
     "createdAt",
     "status",
     "finishedAt"
    ],
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "created",
       "inProgress",
       "incomplete",
       "complete"
      ],
      "type": "string"
     },
     {
      "items": {
       "$ref": "#/properties/status/anyOf/0"
      },
      "type": "array"
     }
    ],
    "description": "Filter by session status"
   },
   "toDate": {
    "description": "End of date range (Unix timestamp in ms)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "list_sessions"
}
