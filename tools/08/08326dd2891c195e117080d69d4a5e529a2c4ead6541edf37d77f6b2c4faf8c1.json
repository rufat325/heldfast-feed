{
 "description": "Generate an API contract test or mock boilerplate for Playwright, Jest, Vitest, or MSW. Use to answer: how do I write a test that validates this API endpoint against this schema?",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "base_url": {
    "default": "http://localhost:3000",
    "description": "Base URL of the API",
    "type": "string"
   },
   "endpoint": {
    "description": "API endpoint path (e.g., /api/users)",
    "type": "string"
   },
   "framework": {
    "default": "playwright",
    "description": "Testing framework to generate code for",
    "enum": [
     "playwright",
     "jest",
     "vitest",
     "msw"
    ],
    "type": "string"
   },
   "method": {
    "default": "GET",
    "description": "HTTP method",
    "enum": [
     "GET",
     "POST",
     "PUT",
     "DELETE",
     "PATCH"
    ],
    "type": "string"
   },
   "schema_code": {
    "description": "Zod schema code for the response body",
    "type": "string"
   },
   "test_name": {
    "default": "API Contract Validation",
    "description": "Name of the generated test",
    "type": "string"
   }
  },
  "required": [
   "endpoint",
   "schema_code"
  ],
  "type": "object"
 },
 "name": "scaffold_api_contract_test"
}
