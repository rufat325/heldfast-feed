{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Settings \u2192 Users \u2192 Edit on a saved user. Change scopes, and send a password only when it should change. Needs an admin credential",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "password": {
    "description": "4\u2013128 characters. Omit, or send an empty string, to keep the current password.",
    "type": "string"
   },
   "scopes": {
    "description": "Replaces the saved scopes. Omit to keep them.",
    "items": {
     "enum": [
      "read",
      "write",
      "admin"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "username": {
    "description": "A saved username from list_users. Built-in and environment users stay as they are.",
    "type": "string"
   }
  },
  "required": [
   "username"
  ],
  "type": "object"
 },
 "name": "update_user",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "passwordChanged": {
    "type": "boolean"
   },
   "scopes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "username": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "username",
   "scopes",
   "passwordChanged",
   "next"
  ],
  "type": "object"
 },
 "title": "Edit a user"
}
