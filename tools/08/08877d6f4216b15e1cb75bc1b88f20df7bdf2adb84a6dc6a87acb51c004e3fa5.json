{
 "description": "Generate a complete Express.js REST API with routes, error handling, CORS, and optional JWT auth",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endpoints": {
    "description": "Array of endpoint definitions",
    "items": {
     "properties": {
      "description": {
       "description": "What this endpoint does",
       "type": "string"
      },
      "method": {
       "description": "HTTP method",
       "enum": [
        "GET",
        "POST",
        "PUT",
        "DELETE"
       ],
       "type": "string"
      },
      "path": {
       "description": "Route path (e.g. /users, /users/:id)",
       "type": "string"
      }
     },
     "required": [
      "method",
      "path",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "name": {
    "description": "Project/API name (kebab-case, e.g. my-api)",
    "type": "string"
   },
   "with_auth": {
    "default": false,
    "description": "Include JWT authentication middleware",
    "type": "boolean"
   }
  },
  "required": [
   "name",
   "endpoints"
  ],
  "type": "object"
 },
 "name": "generate_express_api"
}
