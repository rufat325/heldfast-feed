{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check the status of a processing job. When status is 'completed', the response includes a download URL valid for 1 hour. An AI result's credits are charged once, when it's ready; if the balance is short the result stays locked and this returns an error saying what's needed \u2014 top up, then call get_job again.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Job ID returned by create_job",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_job",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "completedAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "ISO 8601 timestamp"
   },
   "createdAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "ISO 8601 timestamp"
   },
   "creditsCharged": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "AI credits paid for the result (0 for non-AI tools)"
   },
   "creditsReserved": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Always 0: nothing is held when a job is created"
   },
   "errorMessage": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "type": "string"
   },
   "metrics": {
    "additionalProperties": false,
    "properties": {
     "cpuTimeMs": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "peakMemoryBytes": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "wallTimeMs": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "wallTimeMs",
     "cpuTimeMs",
     "peakMemoryBytes"
    ],
    "type": "object"
   },
   "outputFilename": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "outputSize": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Output size in bytes"
   },
   "outputUrl": {
    "description": "Presigned download URL, valid 1 hour (completed jobs only)",
    "type": "string"
   },
   "progress": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "0-100"
   },
   "progressMessage": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "description": "queued | processing | completed | failed | cancelled",
    "type": "string"
   },
   "tool": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "id",
   "status",
   "tool",
   "progress",
   "progressMessage",
   "errorMessage",
   "creditsReserved",
   "creditsCharged",
   "createdAt",
   "completedAt"
  ],
  "type": "object"
 },
 "title": "Get Job Status"
}
