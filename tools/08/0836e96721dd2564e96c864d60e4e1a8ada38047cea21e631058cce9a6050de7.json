{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Query Kibi entities"
 },
 "description": "Read entities from the KB with filters. Use for discovery and lookup before edits. Do not use for writes. No mutation side effects. Tags filter by metadata tags only, not entity IDs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "id": {
    "description": "Optional exact entity ID. Example: 'REQ-cli-gc'. If omitted, returns matching entities by other filters.",
    "type": "string"
   },
   "limit": {
    "description": "Optional max rows to return after filtering. Default: 100 when omitted. Example: 25.",
    "type": "number"
   },
   "offset": {
    "description": "Optional zero-based pagination offset. Default: 0. Example: 50 to skip first 50 rows.",
    "type": "number"
   },
   "sourceFile": {
    "description": "Optional source-file substring filter. Example: 'src/auth/login.ts'. Uses KB source linkage, not file-system scanning.",
    "type": "string"
   },
   "tags": {
    "description": "Optional tag filter. Matches entities that contain any provided tag. Example: ['security','billing'].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "anyOf": [
     {
      "const": "req",
      "type": "string"
     },
     {
      "const": "scenario",
      "type": "string"
     },
     {
      "const": "test",
      "type": "string"
     },
     {
      "const": "adr",
      "type": "string"
     },
     {
      "const": "flag",
      "type": "string"
     },
     {
      "const": "event",
      "type": "string"
     },
     {
      "const": "symbol",
      "type": "string"
     },
     {
      "const": "fact",
      "type": "string"
     }
    ],
    "description": "Optional entity type filter. Allowed: req, scenario, test, adr, flag, event, symbol, fact. Example: 'req'."
   },
   "workspaceRoot": {
    "description": "Optional absolute path of the workspace this call is about when it differs from the one the server started in, for example the git worktree you are working in. The server answers from that workspace's knowledge base when it is a worktree of the same repository or lies under the client's MCP roots; otherwise it answers from its own workspace and adds a workspace_mismatch diagnostic. Host hooks fill this in automatically where available.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "kb_query",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "entities": {
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "entities",
     "count"
    ],
    "type": "object"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "code": {
       "type": "string"
      },
      "detail": {},
      "file": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "anyOf": [
        {
         "const": "info",
         "type": "string"
        },
        {
         "const": "warning",
         "type": "string"
        },
        {
         "const": "error",
         "type": "string"
        }
       ]
      },
      "suggestion": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "effects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {},
      "errorCode": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "status": {
       "anyOf": [
        {
         "const": "completed",
         "type": "string"
        },
        {
         "const": "failed",
         "type": "string"
        },
        {
         "const": "not_applicable",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "kind",
      "status"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   },
   "kibiProtocol": {
    "const": 1,
    "type": "number"
   },
   "nextActions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "input": {},
      "operation": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      }
     },
     "required": [
      "operation",
      "reason",
      "required"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "operation": {
    "const": "kb_query",
    "type": "string"
   },
   "resultVersion": {
    "const": "kibi.kb_query.v1",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "const": "success",
      "type": "string"
     },
     {
      "const": "committed_with_repairs",
      "type": "string"
     },
     {
      "const": "error",
      "type": "string"
     }
    ]
   }
  },
  "required": [
   "kibiProtocol",
   "operation",
   "resultVersion",
   "status",
   "data",
   "effects",
   "diagnostics",
   "nextActions"
  ],
  "type": "object"
 }
}
