{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "A screenshot PNG named in the report or returned by capture_screenshot; a large one comes back as links.file to fetch with the jobToken. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filename": {
    "description": "A screenshot filename from the report.",
    "pattern": "^[a-zA-Z0-9_-]+\\.png$",
    "type": "string"
   },
   "jobId": {
    "description": "The jobId returned when the job was created, e.g. web-1a2b3c.",
    "pattern": "^web-[a-z0-9-]+$",
    "type": "string"
   },
   "jobToken": {
    "description": "The jobToken returned when the job was created. Optional when the request carries the prepaid key that paid the job (Authorization: Bearer dck_\u2026).",
    "maxLength": 200,
    "minLength": 20,
    "type": "string"
   }
  },
  "required": [
   "jobId",
   "filename"
  ],
  "type": "object"
 },
 "name": "get_screenshot",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "code": {
    "type": "string"
   },
   "dimensions": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "filename": {
    "type": "string"
   },
   "jobId": {
    "type": "string"
   },
   "jobToken": {
    "type": "string"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "file": {
      "type": "string"
     }
    },
    "required": [
     "file"
    ],
    "type": "object"
   },
   "payment": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "type": "string"
     },
     "balance": {
      "type": "string"
     },
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "rail": {
      "const": "prepaid",
      "type": "string"
     }
    },
    "required": [
     "amount",
     "currency",
     "rail",
     "balance"
    ],
    "type": "object"
   },
   "url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Get screenshot"
}
