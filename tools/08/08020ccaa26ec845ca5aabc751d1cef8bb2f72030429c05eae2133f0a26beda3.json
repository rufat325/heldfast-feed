{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "veterical:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check Veterical plan and limits"
 },
 "description": "Use this when someone asks which Veterical plan their clinic is on, whether it is active, or how many users, seats, patients, appointments or reminders it allows. Returns plan name, status, billing frequency and plan caps per subscription; caps are limits, not usage. Not for invoices or amounts billed.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Only this clinic (24 lowercase hexadecimal characters); every clinic when absent",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 4096,
    "type": "string"
   },
   "limit": {
    "description": "Subscriptions per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_subscriptions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 4096,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "subscriptions": {
    "description": "Plan entitlements, newest first. Subscription or customer ids, billed amounts, payment methods, invoices and every processor field are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "billingFrequency": {
       "anyOf": [
        {
         "enum": [
          "MONTHLY",
          "ONCE",
          "YEARLY"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "clinicId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "limits": {
       "additionalProperties": false,
       "description": "Plan caps, not record counts; null when the subscription carries no cap",
       "properties": {
        "appointments": {
         "type": [
          "number",
          "null"
         ]
        },
        "patients": {
         "type": [
          "number",
          "null"
         ]
        },
        "reminders": {
         "type": [
          "number",
          "null"
         ]
        },
        "seats": {
         "type": [
          "number",
          "null"
         ]
        },
        "users": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "required": [
        "appointments",
        "patients",
        "reminders",
        "seats",
        "users"
       ],
       "type": "object"
      },
      "plan": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "anyOf": [
        {
         "enum": [
          "ACTIVE",
          "CANCELED",
          "INCOMPLETE",
          "PAST_DUE"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "clinicId",
      "status",
      "plan",
      "billingFrequency",
      "limits"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "subscriptions",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Check Veterical plan and limits"
}
