    "type": "boolean"
   },
   "allowed_domains": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "auto_open": {
    "type": "boolean"
   },
   "auto_open_delay_ms": {
    "minimum": 0,
    "type": "integer"
   },
   "greeting_message": {
    "type": "string"
   },
   "language": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "position": {
    "enum": [
     "bottom-right",
     "bottom-left"
    ],
    "type": "string"
   },
   "primary_color": {
    "type": "string"
   },
   "voice_mode": {
    "type": "string"
   },
   "widget_id": {
    "description": "The widget id. Call call2me_list_widgets first if unknown.",
    "type": "string"
   }
  },
  "required": [
   "widget_id"
  ],
  "type": "object"
 },
 "name": "call2me_update_widget",
 "title": "Update chat widget"
}
