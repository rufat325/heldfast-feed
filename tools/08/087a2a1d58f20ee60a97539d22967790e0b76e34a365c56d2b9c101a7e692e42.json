{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a paced list campaign's name, message source, batch size, schedule, exhaust behavior, or send settings. Changing the schedule reschedules the next run.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batchSize": {
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "botId": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "channelId": {
    "anyOf": [
     {
      "format": "uuid",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "description": "Campaign ID",
    "format": "uuid",
    "type": "string"
   },
   "loopCooldownMs": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "messageSource": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "static",
        "type": "string"
       },
       "text": {
        "description": "The message body sent to each contact in the batch",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "text"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "rotation",
        "type": "string"
       },
       "messages": {
        "description": "Pool of messages",
        "items": {
         "minLength": 1,
         "type": "string"
        },
        "minItems": 1,
        "type": "array"
       },
       "mode": {
        "description": "Rotate in order (default) or pick randomly per run",
        "enum": [
         "sequential",
         "random"
        ],
        "type": "string"
       }
      },
      "required": [
       "kind",
       "messages"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "const": "content",
        "type": "string"
       },
       "ref": {
        "description": "A Neuron Note ID; its content becomes the message, fetched live at each run",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "ref"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "description": "AI-written message generated live at each run (BYOK-aware)",
      "properties": {
       "botId": {
        "description": "Bot whose system prompt supplies business context",
        "format": "uuid",
        "type": "string"
       },
       "kind": {
        "const": "ai",
        "type": "string"
       },
       "perContact": {
        "description": "Generate a distinct message per recipient (slower, more tokens). Default false = one message for the whole batch",
        "type": "boolean"
       },
       "personaId": {
        "description": "Persona whose voice the message is written in",
        "format": "uuid",
        "type": "string"
       },
       "prompt": {
        "description": "Instruction for the message the AI should write",
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "kind",
       "prompt"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "description": "Message fetched from your webhook at each run",
      "properties": {
       "kind": {
        "const": "webhook",
        "type": "string"
       },
       "perContact": {
        "description": "Call once per recipient with the contact in the payload. Default false = one call per batch",
        "type": "boolean"
       },
       "url": {
        "description": "POSTed { campaignId, listId, contact? }; returns { message } or a bare string",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "url"
      ],
      "type": "object"
     }
    ],
    "description": "How the message is resolved live at each batch run: 'static' (fixed), 'rotation' (cycle through several), 'ai' (AI-written), 'webhook' (from your service), or 'content' (a saved Neuron Note)."
   },
   "name": {
    "maxLength": 255,
    "type": "string"
   },
   "onExhaust": {
    "enum": [
     "stop",
     "loop"
    ],
    "type": "string"
   },
   "schedule": {
    "allOf": [
     {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "everyMs": {
          "description": "Milliseconds between runs, e.g. 86400000 for daily",
          "minimum": 60000,
          "type": "integer"
         },
         "kind": {
          "const": "interval",
          "type": "string"
         }
        },
        "required": [
         "kind",
         "everyMs"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "hour": {
          "description": "UTC hour",
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
         },
         "kind": {
          "const": "daily",
          "type": "string"
         },
         "minute": {
          "maximum": 59,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "kind",
         "hour"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "days": {
          "description": "Days of week, 0=Sun \u2026 6=Sat",
          "items": {
           "maximum": 6,
           "minimum": 0,
           "type": "integer"
          },
          "minItems": 1,
          "type": "array"
         },
         "hour": {
          "description": "UTC hour",
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
         },
         "kind": {
          "const": "weekly",
          "type": "string"
         },
         "minute": {
          "maximum": 59,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "kind",
         "days",
         "hour"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "dayOfMonth": {
          "maximum": 31,
          "minimum": 1,
          "type": "integer"
         },
         "hour": {
          "description": "UTC hour",
          "maximum": 23,
          "minimum": 0,
          "type": "integer"
         },
         "kind": {
          "const": "monthly",
          "type": "string"
         },
         "minute": {
          "maximum": 59,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "kind",
         "dayOfMonth",
         "hour"
        ],
        "type": "object"
       }
      ]
     },
     {
      "properties": {
       "endAt": {
        "description": "ISO date; the campaign completes after this",
        "type": "string"
       },
       "maxRuns": {
        "description": "Stop after this many runs",
        "minimum": 1,
        "type": "integer"
       },
       "timezone": {
        "description": "IANA timezone the daily/weekly/monthly time is interpreted in, e.g. 'Africa/Lagos'. Defaults to UTC. Ignored for 'interval'. The schedule holds its local wall-clock time across DST.",
        "type": "string"
       }
      },
      "type": "object"
     }
    ],
    "description": "When each batch fires. e.g. daily at 9am in Africa/Lagos, or every weekend."
   },
   "sendMode": {
    "enum": [
     "message",
     "bot"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "neuron_update_list_campaign",
 "title": "Update List Campaign"
}
