   "MLCLookupStatus": {
    "description": "Why an MLC lookup produced (or failed to produce) a work.\n\nMLC answers come from TrackForge's copy of The MLC's bulk data feed\n(BWARM), never from The MLC's API, so every status is true *as of* the\nsnapshot date carried in ``MLCLookup.as_of``.\n\n``NOT_FOUND`` and ``UNRESOLVED`` are negative statements about MLC's data:\nno MLC work is linked to this recording in the snapshot. Neither says the\nwork is unregistered: a registered work whose recording has not been\nmatched looks the same, which is why the verdict adds a title check. Every\nindeterminate value is a statement about *our* ability to read the snapshot\ncopy and must be surfaced as inconclusive.",
    "enum": [
     "matched",
     "recording_unmatched",
     "not_found",
     "unresolved",
     "empty_response",
     "error",
     "timeout",
     "rate_limited",
     "not_configured",
     "not_attempted"
    ],
    "title": "MLCLookupStatus",
    "type": "string"
   },
