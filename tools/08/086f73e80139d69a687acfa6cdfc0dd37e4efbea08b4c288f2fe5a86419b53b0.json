{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "clipper"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get source links"
 },
 "description": "Use this when the user asks where to get a campaign's footage: every source link we found in the brief. Public videos and channels (YouTube, Twitch, Kick, TikTok, Instagram, X and more) with platform, title, length, the video details we store (channel, publish date, views, language, speakers, chapters, format and a short summary in our own words) and a link to the video at each top moment. Signed in, also the brand asset links (Google Drive, Dropbox, Frame.io, WeTransfer, OneDrive, Box, Mega), which are for clippers who join. Links only, never a file copy or a transcript. Read only.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "campaign": {
    "description": "The campaign as brand/series (for example lovable/clipping), its clippingalpha.com page URL, or its numeric campaignId from another tool.",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "campaign"
  ],
  "type": "object"
 },
 "name": "get_assets",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "brandAssetCount": {
    "type": "number"
   },
   "brandAssets": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "campaign": {
    "additionalProperties": {},
    "properties": {
     "brand": {
      "type": "string"
     },
     "campaignId": {
      "type": "string"
     },
     "joinUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "pageUrl": {
      "type": "string"
     },
     "ref": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "campaignId",
     "ref",
     "title",
     "brand",
     "pageUrl",
     "joinUrl"
    ],
    "type": "object"
   },
   "library": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "analysed": {
        "type": "number"
       },
       "total": {
        "type": "number"
       }
      },
      "required": [
       "total",
       "analysed"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "videos": {
    "items": {
     "additionalProperties": {},
     "properties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "campaign",
   "videos",
   "brandAssets",
   "brandAssetCount",
   "library"
  ],
  "type": "object"
 },
 "title": "Get source links"
}
