    },
    "type": "array"
   },
   "billed": {
    "type": "boolean"
   },
   "changeCount": {
    "type": "number"
   },
   "changes": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "found": {
    "type": "boolean"
   },
   "meaning": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "service": {
    "type": "string"
   },
   "suggestion": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "API breaking changes"
}
