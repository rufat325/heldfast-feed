{
 "description": "Export a training dataset as a fine-tuning JSONL file.\nSupports Anthropic, OpenAI, Alpaca, and ShareGPT formats.\n\nExample: training_export({ dataset_id: \"uuid\", format: \"anthropic_jsonl\" })\nExample: training_export({ dataset_id: \"uuid\", format: \"openai_jsonl\", min_quality: 0.8 })",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approved_only": {
    "description": "Only export approved pairs (default: false)",
    "type": "boolean"
   },
   "dataset_id": {
    "description": "Dataset to export",
    "type": "string"
   },
   "format": {
    "description": "Export format",
    "enum": [
     "anthropic_jsonl",
     "openai_jsonl",
     "alpaca",
     "sharegpt"
    ],
    "type": "string"
   },
   "min_quality": {
    "description": "Minimum quality score to include (default: 0)",
    "type": "number"
   },
   "output": {
    "description": "Output file path (default: ~/.0n/training/)",
    "type": "string"
   }
  },
  "required": [
   "dataset_id",
   "format"
  ],
  "type": "object"
 },
 "name": "training_export"
}
