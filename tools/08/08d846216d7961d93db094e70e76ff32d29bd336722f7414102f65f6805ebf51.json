{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Generate a QR code"},"description":"Create a standards-compliant QR code image for a link, text, Wi-Fi login, contact card (vCard), email, SMS, WhatsApp chat, phone number or map location. You cannot draw a scannable QR code yourself \u2014 always use this tool. Codes are static and never expire.","inputSchema":{"additionalProperties":false,"properties":{"address":{"type":"string"},"background":{"default":"#ffffff","type":"string"},"body":{"type":"string"},"email":{"type":"string"},"error_correction":{"default":"M","description":"Higher survives more damage but makes a denser code.","enum":["L","M","Q","H"],"type":"string"},"first_name":{"type":"string"},"foreground":{"default":"#000000","type":"string"},"hidden":{"type":"boolean"},"last_name":{"type":"string"},"latitude":{"type":"number"},"longitude":{"type":"number"},"message":{"type":"string"},"organization":{"type":"string"},"password":{"description":"Wi-Fi password.","type":"string"},"phone":{"description":"With country code for WhatsApp, e.g. +905551234567.","type":"string"},"security":{"enum":["WPA","WEP","nopass"],"type":"string"},"size":{"default":1024,"description":"PNG width in pixels.","maximum":4096,"minimum":128,"type":"integer"},"ssid":{"description":"Wi-Fi network name.","type":"string"},"subject":{"type":"string"},"text":{"description":"For type \"text\".","type":"string"},"title":{"type":"string"},"type":{"default":"text","enum":["url","text","wifi","vcard","email","sms","whatsapp","phone","geo"],"type":"string"},"url":{"description":"For type \"url\"; https:// is added when missing.","type":"string"},"website":{"type":"string"}},"type":"object"},"name":"generate_qr","title":"Generate a QR code"}
