{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Upload a new file to Google Drive.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "The content of the file. For binary files (images, PDFs, etc.), provide base64-encoded content.",
    "type": "string"
   },
   "description": {
    "description": "Description of the file",
    "type": "string"
   },
   "isBase64": {
    "description": "Set to true if content is base64-encoded (required for binary files like images)",
    "type": "boolean"
   },
   "mimeType": {
    "description": "The MIME type of the file (e.g., \"text/plain\", \"image/jpeg\", \"application/pdf\")",
    "type": "string"
   },
   "name": {
    "description": "The name of the file",
    "type": "string"
   },
   "parents": {
    "description": "Parent folder IDs. If not specified, file is created in root.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "content",
   "mimeType"
  ],
  "type": "object"
 },
 "name": "file_upload",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "id": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "parents": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "webContentLink": {
    "type": "string"
   },
   "webViewLink": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "mimeType"
  ],
  "type": "object"
 },
 "title": "Upload file"
}
