{
 "description": "Issue a signed delegation contract (POST /v1/agents/{parent_agent_id}/delegate). Signs locally with passport key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "additionalProperties": {},
    "default": {},
    "description": "Assumptions map stored in contract.",
    "type": "object"
   },
   "conflict_policy": {
    "default": "last_writer_wins_audit",
    "description": "Only accepted value: \"last_writer_wins_audit\".",
    "type": "string"
   },
   "parent_agent_id": {
    "description": "Delegating parent UUID; inferred from GET /v1/me when omitted.",
    "format": "uuid",
    "type": "string"
   },
   "read_set": {
    "default": [
     "memory"
    ],
    "description": "Declarative read scope labels.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recipient_agent_id": {
    "description": "Recipient agent UUID \u2014 typically child_agent_id from lithtrix_spawn.",
    "format": "uuid",
    "type": "string"
   },
   "task_id": {
    "$ref": "#/properties/parent_agent_id",
    "description": "Task UUID correlating delegation + trace; auto-generated when omitted."
   },
   "ttl_seconds": {
    "default": 3600,
    "description": "Contract TTL in seconds.",
    "minimum": 1,
    "type": "integer"
   },
   "verifier_obligations": {
    "anyOf": [
     {
      "anyOf": [
       {
        "not": {}
       },
       {}
      ]
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "version_refs": {
    "default": [],
    "description": "Optional version pin references.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "write_set": {
    "default": [
     "memory"
    ],
    "description": "Declarative write scope labels (authoritative).",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "recipient_agent_id"
  ],
  "type": "object"
 },
 "name": "lithtrix_delegate"
}
