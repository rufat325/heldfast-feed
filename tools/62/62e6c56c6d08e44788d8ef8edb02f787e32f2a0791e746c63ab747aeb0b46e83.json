{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only planning step that turns an objective into bounded scope, verifier proposal, policy pack, and risk recommendation. Use for authorized software changes before preflight/run. Do not use to mutate files or replace the verifier. Next: call martin_preflight with the chosen scope, budget, and verifier.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowedPaths": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "context": {
    "description": "Optional extra issue or bug context.",
    "type": "string"
   },
   "deniedPaths": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "maxCommands": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxFilesChanged": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxIterations": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxMinutes": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxTokens": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxUsd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "objective": {
    "description": "The coding objective to plan.",
    "type": "string"
   },
   "policyPack": {
    "enum": [
     "solo-founder",
     "startup-team",
     "enterprise-strict",
     "oss-maintainer",
     "security-sensitive"
    ],
    "type": "string"
   },
   "verificationPlan": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workingDirectory": {
    "description": "Optional repo-root override resolved under the MCP workspace root.",
    "type": "string"
   }
  },
  "required": [
   "objective"
  ],
  "type": "object"
 },
 "name": "martin_plan",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 }
}
