{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return source/translation pairs plus review criteria so YOU can judge translation quality with your own reasoning. The server performs no model call and needs no API key. Structurally broken keys are excluded \u2014 run check_locales for those.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lang": {
    "description": "Language to review",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Maximum pairs to return",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "path": {
    "description": "Path to the locale tree, .arb directory, or .xcstrings file",
    "type": "string"
   },
   "source": {
    "default": "en",
    "description": "Source language code",
    "type": "string"
   }
  },
  "required": [
   "path",
   "lang"
  ],
  "type": "object"
 },
 "name": "review_locales",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "criteria": {
    "type": "array"
   },
   "excludedStructurallyBroken": {
    "type": "number"
   },
   "instructions": {
    "type": "string"
   },
   "lang": {
    "type": "string"
   },
   "pairs": {
    "type": "array"
   },
   "returned": {
    "type": "number"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "instructions",
   "criteria",
   "lang",
   "source",
   "returned",
   "excludedStructurallyBroken",
   "pairs"
  ],
  "type": "object"
 },
 "title": "Get translation pairs for semantic review"
}
