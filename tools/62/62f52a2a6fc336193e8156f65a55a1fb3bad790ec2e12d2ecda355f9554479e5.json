{
 "description": "Generate a URL-safe slug from text",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "lowercase": {
    "default": true,
    "description": "Convert to lowercase",
    "type": "boolean"
   },
   "max_length": {
    "description": "Maximum slug length",
    "type": "number"
   },
   "separator": {
    "default": "-",
    "description": "Word separator (default: hyphen)",
    "type": "string"
   },
   "text": {
    "description": "Text to convert to a slug",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "generate_slug"
}
