{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit a translation"
 },
 "description": "Use this when someone asks to fix or change the text of one key in one language. Returns the previous and new text and the projects sharing that string; the change applies in all of them and marks the text as human-edited. Not for adding a new key.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "description": "Exact existing key",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "language": {
    "description": "Locale code of the translation to change, such as en or it",
    "maxLength": 35,
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "description": "Project name; an id matches nothing",
    "maxLength": 128,
    "type": "string"
   },
   "value": {
    "description": "New text for that language, 1 to 2,000 characters",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project",
   "key",
   "language",
   "value"
  ],
  "type": "object"
 },
 "name": "update_phrase",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "key": {
    "maxLength": 256,
    "type": "string"
   },
   "language": {
    "maxLength": 35,
    "type": "string"
   },
   "previousValue": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "project": {
    "maxLength": 128,
    "type": "string"
   },
   "sharedProjects": {
    "description": "Every project using this string; the change applies to all of them",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "status": {
    "enum": [
     "not-found",
     "no-change",
     "updated"
    ],
    "type": "string"
   },
   "value": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "status",
   "project",
   "key",
   "language",
   "previousValue",
   "value",
   "sharedProjects"
  ],
  "type": "object"
 },
 "title": "Edit a translation"
}
