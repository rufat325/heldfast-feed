{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Current provider alert observations for an explicit geographic network sample. Never infer normal circulation from empty alerts. Unresolved line, stop, mode or non-current time returns unavailable. Preserve partial coverage and unknown source freshness.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "at": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "line_ref": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "lon": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "network_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "stop_ref": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "transit_mode": {
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "transit_disruptions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alerts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "active_periods": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "end": {
          "$ref": "#/properties/source_updated_at"
         },
         "start": {
          "$ref": "#/properties/source_updated_at"
         }
        },
        "required": [
         "start",
         "end"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "cause": {
       "$ref": "#/properties/query/properties/network_id"
      },
      "created_at": {
       "$ref": "#/properties/source_updated_at"
      },
      "description": {
       "type": "string"
      },
      "effect": {
       "$ref": "#/properties/query/properties/network_id"
      },
      "id": {
       "pattern": "^roote_alert_[a-f0-9]{20}$",
       "type": "string"
      },
      "provenance": {
       "additionalProperties": false,
       "properties": {
        "fetched_at": {
         "$ref": "#/properties/source_updated_at"
        },
        "provider": {
         "const": "transit",
         "type": "string"
        },
        "queried_network_ids": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "source_updated_at": {
         "$ref": "#/properties/source_updated_at"
        }
       },
       "required": [
        "provider",
        "queried_network_ids",
        "fetched_at",
        "source_updated_at"
       ],
       "type": "object"
      },
      "route_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "severity": {
       "$ref": "#/properties/query/properties/network_id"
      },
      "stop_ids": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "$ref": "#/properties/query/properties/network_id"
      }
     },
     "required": [
      "id",
      "effect",
      "cause",
      "severity",
      "title",
      "description",
      "created_at",
      "route_ids",
      "stop_ids",
      "active_periods",
      "provenance"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "contract_version": {
    "const": "roote.disruptions.v1",
    "type": "string"
   },
   "coverage": {
    "additionalProperties": false,
    "properties": {
     "available_networks": {
      "minimum": 0,
      "type": "integer"
     },
     "complete": {
      "const": false,
      "type": "boolean"
     },
     "line_resolved": {
      "const": false,
      "type": "boolean"
     },
     "queried_networks": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "stop_resolved": {
      "const": false,
      "type": "boolean"
     },
     "temporal": {
      "const": "current_only",
      "type": "string"
     }
    },
    "required": [
     "available_networks",
     "queried_networks",
     "complete",
     "line_resolved",
     "stop_resolved",
     "temporal"
    ],
    "type": "object"
   },
   "evaluated_at": {
    "format": "date-time",
    "type": "string"
   },
   "fetched_at": {
    "$ref": "#/properties/source_updated_at"
   },
   "freshness": {
    "additionalProperties": false,
    "properties": {
     "source_timestamp_known": {
      "const": false,
      "type": "boolean"
     },
     "status": {
      "enum": [
       "stale",
       "recent_provider_fetch"
      ],
      "type": "string"
     }
    },
    "required": [
     "status",
     "source_timestamp_known"
    ],
    "type": "object"
   },
   "normality_confirmed": {
    "const": false,
    "type": "boolean"
   },
   "provider": {
    "const": "transit",
    "type": "string"
   },
   "provider_calls": {
    "$ref": "#/properties/coverage/properties/available_networks"
   },
   "provider_invocations": {
    "$ref": "#/properties/coverage/properties/available_networks"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "at": {
      "anyOf": [
       {
        "exclusiveMinimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "lat": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "line_ref": {
      "$ref": "#/properties/query/properties/network_id"
     },
     "lon": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "network_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "stop_ref": {
      "$ref": "#/properties/query/properties/network_id"
     },
     "transit_mode": {
      "$ref": "#/properties/query/properties/network_id"
     }
    },
    "required": [
     "lat",
     "lon",
     "network_id",
     "line_ref",
     "stop_ref",
     "transit_mode",
     "at"
    ],
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "scope": {
    "const": "network_sample",
    "type": "string"
   },
   "source_updated_at": {
    "anyOf": [
     {
      "format": "date-time",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "unavailable",
     "stale",
     "disrupted",
     "no_known_alert"
    ],
    "type": "string"
   },
   "total": {
    "$ref": "#/properties/coverage/properties/available_networks"
   },
   "truncated": {
    "type": "boolean"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "contract_version",
   "query",
   "scope",
   "provider",
   "evaluated_at",
   "source_updated_at",
   "normality_confirmed",
   "status",
   "coverage",
   "provider_calls",
   "provider_invocations",
   "alerts"
  ],
  "type": "object"
 },
 "title": "Read current transit disruption observations"
}
