{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "OCR uploads and quota"
 },
 "description": "List documents sent to OCR (newest first) with their recognition status, or get one recognised document with its lines (give document_type and id). Also reports the remaining OCR quota.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "document_type": {
    "description": "bill = \u043f\u043e\u043a\u0443\u043f\u043a\u0430 (purchase), invoice = \u043f\u0440\u043e\u0434\u0430\u0436\u0431\u0430 (sale)",
    "enum": [
     "bill",
     "invoice"
    ],
    "type": "string"
   },
   "id": {
    "description": "Upload id; requires document_type",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "include_quota": {
    "description": "Include remaining scans (default true)",
    "type": "boolean"
   },
   "limit": {
    "description": "Max records (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "since": {
    "description": "Only uploads changed since this ISO 8601 time",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "status": {
    "enum": [
     "processing",
     "done",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nula_ocr_status",
 "title": "OCR uploads and quota"
}
