{
 "description": "Edit or combine images per a text prompt. First image is the base; any others are references (style, characters, objects). Saves to disk and returns the file path.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspectRatio": {
    "description": "e.g. 1:1, 16:9, 9:16, 4:3, 21:9",
    "type": "string"
   },
   "filename": {
    "description": "Base filename without extension",
    "type": "string"
   },
   "grounding": {
    "description": "Ground with Google Search for factual accuracy",
    "type": "boolean"
   },
   "images": {
    "description": "Input image file path(s)",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "description": "Gemini image model id (default: gemini-3.1-flash-image)",
    "type": "string"
   },
   "outputDir": {
    "description": "Save directory (default: ./nano-banana)",
    "type": "string"
   },
   "prompt": {
    "description": "Edit instruction",
    "type": "string"
   },
   "size": {
    "description": "Output resolution",
    "enum": [
     "1K",
     "2K",
     "4K"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt",
   "images"
  ],
  "type": "object"
 },
 "name": "edit_image"
}
