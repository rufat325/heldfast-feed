{
 "description": "List files/objects stored in Rebase storage.",
 "inputSchema": {
  "properties": {
   "bucket": {
    "description": "Filter by storage bucket name",
    "type": "string"
   },
   "maxResults": {
    "description": "Maximum number of results to return (default 50)",
    "type": "number"
   },
   "pageToken": {
