{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate balances and minimal payments to settle shared household costs. Use when you need to resolve debts among housemates. Do NOT use when you need to create a roommate agreement; use roommate_agreement instead.",
 "inputSchema": {
  "properties": {
   "costs": {
    "description": "Shared costs to split equally",
    "items": {
     "properties": {
      "amount": {
       "type": "number"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "payments": {
    "description": "What each housemate paid",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "paid": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "paid"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "costs",
   "payments"
  ],
  "type": "object"
 },
 "name": "settle_up",
 "outputSchema": {
  "properties": {
   "balances": {
    "description": "List of balances for each housemate",
    "items": {
     "properties": {
      "balance": {
       "description": "The balance owed or due by the housemate",
       "type": "number"
      },
      "name": {
       "description": "The name of the housemate",
       "type": "string"
      }
     },
     "required": [
      "name",
      "balance"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "transactions": {
    "description": "List of transactions to settle the balances",
    "items": {
     "properties": {
      "amount": {
       "description": "The amount to be paid",
       "type": "number"
      },
      "from": {
       "description": "The name of the housemate paying",
       "type": "string"
      },
      "to": {
       "description": "The name of the housemate receiving the payment",
       "type": "string"
      }
     },
     "required": [
      "from",
      "to",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "balances",
   "transactions"
  ],
  "type": "object"
 },
 "title": "Settle up"
}
