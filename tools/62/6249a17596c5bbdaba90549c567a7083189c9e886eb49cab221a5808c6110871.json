{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a Live Card render was queued and you have its job_id. Call it again while status is queued or rendering. When status is ready, downloads holds four links (jpeg, mov, mp4, gif) and content_identifier is the Apple id shared by the JPEG and the MOV. Give the user every link and say they expire at expires_at (24 hours). The JPEG and MOV are the Live Photo pair. The MP4 and GIF play elsewhere. status failed includes error_code. status expired means the files were deleted. A wrong job_id is not_found. It does not start a render.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "job_id": {
    "description": "The job_id returned by render_live_card.",
    "pattern": "^[0-9a-f]{32}$",
    "type": "string"
   }
  },
  "required": [
   "job_id"
  ],
  "type": "object"
 },
 "name": "live_card_status",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "type": "string"
   },
   "content_identifier": {
    "type": [
     "string",
     "null"
    ]
   },
   "downloads": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "filename": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "jpeg",
        "mov",
        "mp4",
        "gif"
       ],
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "url",
      "filename"
     ],
     "type": "object"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "error_code": {
    "type": [
     "string",
     "null"
    ]
   },
   "expires_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "job_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "queued",
     "rendering",
     "ready",
     "failed",
     "expired"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "job_id",
   "message",
   "source",
   "as_of"
  ],
  "type": "object"
 },
 "title": "Check a Live Card render"
}
