{
 "description": "Every account a transaction touched, from its metadata (AffectedNodes). Because the Touch amendment forces all transactional stakeholders into metadata \u2014 even ones nothing else changed for \u2014 this is the authoritative participant list, not a guess from tx fields. Returns each account with its roles, the ledger entry types it appeared in, and whether it materially changed. 1 RPC read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "network": {
    "default": "mainnet",
    "enum": [
     "mainnet",
     "testnet"
    ],
    "type": "string"
   },
   "txHash": {
    "maxLength": 64,
    "minLength": 64,
    "type": "string"
   }
  },
  "required": [
   "txHash"
  ],
  "type": "object"
 },
 "name": "trace_transaction_stakeholders",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "type": "string"
   },
   "metaPresent": {
    "type": "boolean"
   },
   "network": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "originator": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "stakeholderCount": {
    "type": "number"
   },
   "stakeholders": {
    "items": {},
    "type": "array"
   },
   "summary": {
    "type": "string"
   },
   "txHash": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
