{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Ask the owner a question"},"description":"Send a traveler's question to the owner of a stay by email, for example about early check-in or a longer stay. The owner replies to the traveler's email directly. Use only with the traveler's name, email and question, and only after they have agreed to send it. This does not book or hold the dates.","inputSchema":{"properties":{"checkIn":{"description":"Check-in date, YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"checkOut":{"description":"Check-out date, YYYY-MM-DD","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"guestEmail":{"description":"Where the owner should reply","type":"string"},"guestName":{"description":"The traveler's name","type":"string"},"guestPhone":{"description":"Optional phone number","type":"string"},"guests":{"maximum":40,"minimum":1,"type":"integer"},"message":{"description":"The traveler's question, 10\u20132000 characters","type":"string"},"slug":{"description":"The stay's slug, from search_stays","type":"string"}},"required":["slug","guestName","guestEmail","message"],"type":"object"},"name":"send_inquiry","title":"Ask the owner a question"}
