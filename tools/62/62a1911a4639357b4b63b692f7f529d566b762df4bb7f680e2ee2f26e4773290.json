{
 "description": "[OPERATOR] Close the task unit with final status and retrospective.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "retrospective": {
    "description": "What went well, what didn't",
    "type": "string"
   },
   "status": {
    "description": "Final status",
    "enum": [
     "completed",
     "failed",
     "partial"
    ],
    "type": "string"
   },
   "task_id": {
    "description": "Task ID",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "status"
  ],
  "type": "object"
 },
 "name": "complete_task"
}
