{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Draft a reply"
 },
 "description": "Compose a reply to a message as a draft, inside the thread it answers and quoting it below the reply: to whoever wrote it, or with replyAll to everyone on it. Nothing leaves the mailbox until the draft is sent.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attachments": {
    "description": "Files to carry: one held by a connected mailbox of the draft's own provider, or content you write out.",
    "items": {
     "anyOf": [
      {
       "properties": {
        "attachmentId": {
         "description": "An attachment id, as a message read named it.",
         "maxLength": 2048,
         "pattern": "^(?:\\d+(?:\\.\\d+)*|[A-Za-z0-9_=-]+)$",
         "type": "string"
        },
        "mailbox": {
         "description": "The mailbox holding the message the file is in, of the same provider as the one written from.",
         "minLength": 1,
         "type": "string"
        },
        "messageId": {
         "description": "The provider's own identifier.",
         "pattern": "^[A-Za-z0-9_=-]{1,512}$",
         "type": "string"
        }
       },
       "required": [
        "mailbox",
        "messageId",
        "attachmentId"
       ],
       "type": "object"
      },
      {
       "properties": {
        "content": {
         "contentEncoding": "base64",
         "description": "The file's own bytes, base64.",
         "format": "base64",
         "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$",
         "type": "string"
        },
        "filename": {
         "description": "What the file is called.",
         "minLength": 1,
         "type": "string"
        },
        "mimeType": {
         "description": "The file's media type.",
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "filename",
        "mimeType",
        "content"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "bcc": {
    "description": "Who to blind-copy. The other recipients are not told.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "body": {
    "description": "The reply text.",
    "minLength": 1,
    "type": "string"
   },
   "cc": {
    "description": "Who to copy, instead of those replyAll copies.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "type": "array"
   },
   "html": {
    "description": "The message as HTML, for formatting; body stays its plain-text version. An Outlook mailbox keeps only the HTML and writes the plain version from it.",
    "minLength": 1,
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox's name or its email address.",
    "minLength": 1,
    "type": "string"
   },
   "messageId": {
    "description": "The provider's own identifier.",
    "pattern": "^[A-Za-z0-9_=-]{1,512}$",
    "type": "string"
   },
   "replyAll": {
    "description": "Also address everyone the message was sent to and copied - never its blind copies, never this mailbox.",
    "type": "boolean"
   },
   "to": {
    "description": "Who the reply goes to, instead of whoever wrote the message and, with replyAll, those it was sent to.",
    "items": {
     "format": "email",
     "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "mailbox",
   "messageId",
   "body"
  ],
  "type": "object"
 },
 "name": "drafts_reply",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "link": {
    "type": "string"
   },
   "threadId": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "link"
  ],
  "type": "object"
 },
 "title": "Draft a reply"
}
