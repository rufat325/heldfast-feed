{
 "description": "Find the nearest indexed feature and route to it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "type": "string"
   },
   "area_id": {
    "type": "string"
   },
   "body": {
    "additionalProperties": {},
    "type": "object"
   },
   "feature": {
    "type": [
     "string",
     "number"
    ]
   },
   "from": {
    "items": [
     {
      "type": "number"
     },
     {
      "type": "number"
     }
    ],
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "mode": {
    "default": "driving",
    "enum": [
     "driving",
     "walking",
     "cycling",
     "multimodal",
     "truck",
     "motorcycle",
     "motor_scooter",
     "bus",
     "taxi",
     "hov",
     "transit"
    ],
    "type": "string"
   }
  },
  "required": [
   "feature",
   "from"
  ],
  "type": "object"
 },
 "name": "e2_route_to_feature",
 "title": "Route to a feature"
}
