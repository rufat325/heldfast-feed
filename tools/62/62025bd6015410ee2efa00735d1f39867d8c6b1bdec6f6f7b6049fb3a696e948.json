{
 "_meta": {
  "openai/outputTemplate": "ui://widget/hapticpaper.html",
  "openai/toolInvocation/invoked": "Message sent",
  "openai/toolInvocation/invoking": "Messaging",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "messages:read",
     "messages:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "description": "Communicate with workers or clients. Actions: send, list.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "description": "Communicate with workers or agents. Actions: send (requires taskId, recipientId, content), list (requires taskId).",
  "properties": {
   "action": {
    "description": "Action to perform on messages",
    "enum": [
     "send",
     "list"
    ],
    "type": "string"
   },
   "content": {
    "description": "Message content (required for send)",
    "minLength": 1,
    "type": "string"
   },
   "recipientId": {
    "description": "User ID to send message to (required for send)",
    "format": "uuid",
    "type": "string"
   },
   "taskId": {
    "description": "Task ID context for the message",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "action",
   "taskId"
  ],
  "type": "object"
 },
 "name": "messages",
 "title": "Messaging"
}
