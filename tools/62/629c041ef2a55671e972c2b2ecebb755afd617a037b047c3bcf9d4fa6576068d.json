{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get forum tags"
 },
 "description": "List the tags available on a forum channel (id, name, emoji, moderated flag). Read-only. Use these IDs with discord_create_forum_post or discord_update_forum_post; manage the tag set with discord_set_forum_tags.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "forum_channel_id": {
    "description": "ID (snowflake) of the forum channel to read tags from.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "forum_channel_id"
  ],
  "type": "object"
 },
 "name": "discord_get_forum_tags",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "tags": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "emoji": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "moderated": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "emoji",
      "moderated"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tags"
  ],
  "type": "object"
 }
}
