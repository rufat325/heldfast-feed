{
 "description": "Create a reusable step sequence that can be shared across multiple Journeys. Fragment names must be unique per team.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Fragment description",
    "maxLength": 2000,
    "type": "string"
   },
   "name": {
    "description": "Fragment name (unique per team)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "steps": {
    "description": "Ordered list of browser actions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "navigate",
        "click",
        "type",
        "fill",
        "select",
        "assert",
        "wait",
        "screenshot",
        "scroll",
        "hover"
       ],
       "type": "string"
      },
      "assertionOperator": {
       "enum": [
        "element_visible",
        "element_hidden",
        "url_contains",
        "text_contains",
        "element_count"
       ],
       "type": "string"
      },
      "label": {
       "description": "Step description",
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "screenshot": {
       "default": false,
       "type": "boolean"
      },
      "target": {
       "description": "CSS selector or URL",
       "type": "string"
      },
      "value": {
       "description": "Value to type/fill or URL to navigate",
       "type": "string"
      },
      "waitMs": {
       "maximum": 30000,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "action",
      "label"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "name",
   "steps"
  ],
  "type": "object"
 },
 "name": "create_page_fragment",
 "title": "Create Page Fragment"
}
