  "additionalProperties": false,
  "properties": {
   "domain": {
    "type": "string"
   },
   "email": {
    "format": "email",
    "type": "string"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "timeframe": {
    "enum": [
     "24h",
     "7d",
     "14d",
     "30d",
     "90d",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "query_visitor_data",
 "title": "Query Visitor Data"
}
