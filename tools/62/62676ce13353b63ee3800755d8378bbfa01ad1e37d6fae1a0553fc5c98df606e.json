{
 "description": "Preview rendered HTML string without writing",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budget": {
    "additionalProperties": false,
    "properties": {
     "max_tokens": {
      "type": "number"
     }
    },
    "required": [
     "max_tokens"
    ],
    "type": "object"
   },
   "content": {
    "type": "string"
   },
   "html": {
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "properties": {
     "compression": {
      "enum": [
       "none",
       "low",
       "high",
       "ai"
      ],
      "type": "string"
     },
     "css_vars": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "inject_css": {
      "type": "string"
     },
     "inject_js": {
      "type": "string"
     },
     "line_width": {
      "type": "number"
     },
     "mode": {
      "enum": [
       "normal",
       "stream"
      ],
      "type": "string"
     },
     "skip_format": {
      "type": "boolean"
     },
     "theme": {
      "enum": [
       "dark",
       "light"
      ],
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "sections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "children": {
       "type": "array"
      },
      "component": {
       "type": "string"
      },
      "props": {
       "additionalProperties": {},
       "type": "object"
      }
     },
     "required": [
      "component"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "template": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "preview_html"
}
