{
 "description": "Generate a complete README.md for a project.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "author": {
    "default": "",
    "description": "Author name",
    "type": "string"
   },
   "description": {
    "default": "",
    "description": "Detailed description",
    "type": "string"
   },
   "features": {
    "default": "",
    "description": "Comma-separated feature list",
    "type": "string"
   },
   "install_cmd": {
    "default": "npm install",
    "description": "Installation command",
    "type": "string"
   },
   "license": {
    "default": "MIT",
    "description": "License type",
    "type": "string"
   },
   "project_name": {
    "description": "Project name",
    "type": "string"
   },
   "tagline": {
    "default": "",
    "description": "Short tagline/description",
    "type": "string"
   },
   "tech_stack": {
    "default": "",
    "description": "Comma-separated technologies",
    "type": "string"
   }
  },
  "required": [
   "project_name"
  ],
  "type": "object"
 },
 "name": "generate_readme"
}
