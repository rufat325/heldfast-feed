{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Seal an AI action (demo receipt)"
 },
 "description": "Append the HASHES of an AI action to GBLIN's public RFC 6962 transparency log and return a portable receipt: Ed25519 signature, inclusion proof, operator-signed C2SP checkpoint, plus the latest on-chain anchor (EAS on Base, daily). mode=demo (the only mode over MCP): 5 seals/day/IP, receipts marked demo:true. Unlimited seals are a paid x402 HTTP endpoint (resource gblin://howto/seal). Provenance is self-reported: the receipt proves existence and time of the record, not that the action happened. The action/agent_id/tool/meta strings are PUBLISHED in the log: identifiers only, never secrets. Fields not listed here are ignored and NOT recorded.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "action": {
    "description": "What the AI did, short label. PUBLISHED in the log.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "agent_id": {
    "description": "Your agent identifier (optional). PUBLISHED.",
    "maxLength": 128,
    "type": "string"
   },
   "input_hash": {
    "description": "sha256 of the input/prompt, 64 hex chars (0x prefix optional)",
    "pattern": "^\\s*(0x)?[0-9a-fA-F]{64}\\s*$",
    "type": "string"
   },
   "meta": {
    "description": "Extra JSON object as a string (optional). PUBLISHED.",
    "maxLength": 512,
    "type": "string"
   },
   "mode": {
    "default": "demo",
    "description": "Only 'demo' is available over MCP (5/day/IP). Paid seals go through x402 HTTP.",
    "enum": [
     "demo"
    ],
    "type": "string"
   },
   "output_hash": {
    "description": "sha256 of the output, 64 hex chars (optional; empty or blank = omitted)",
    "pattern": "^\\s*((0x)?[0-9a-fA-F]{64})?\\s*$",
    "type": "string"
   },
   "tool": {
    "description": "Tool/model used (optional). PUBLISHED.",
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "action",
   "input_hash"
  ],
  "type": "object"
 },
 "name": "receipts.seal",
 "outputSchema": {
  "properties": {
   "anchor": {
    "description": "Latest daily EAS anchor of the tree root on Base and whether it already covers this receipt",
    "properties": {
     "anchored_tree_size": {
      "type": [
       "integer",
       "null"
      ]
     },
     "chain": {
      "type": "string"
     },
     "covers_this_receipt": {
      "description": "deprecated alias of root_covers_this_receipt",
      "type": "boolean"
     },
     "eas_schema_uid": {
      "type": "string"
     },
     "explorer": {
      "type": "string"
     },
     "last_anchor": {
      "properties": {
       "day": {
        "type": "string"
       },
       "root": {
        "type": "string"
       },
       "tree_size": {
        "type": "integer"
       },
       "tx": {
        "type": "string"
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "method": {
      "type": "string"
     },
     "promise_id": {
      "type": "string"
     },
     "root_covers_this_receipt": {
      "description": "true iff index < anchored_tree_size: the anchored ROOT commits to this leaf via the inclusion proof",
      "type": "boolean"
     },
     "what_is_anchored": {
      "type": "string"
     }
    },
    "required": [
     "root_covers_this_receipt",
     "anchored_tree_size",
     "what_is_anchored"
    ],
    "type": "object"
   },
   "canonicalization": {
    "description": "The serialisation rule these bytes were produced with, named in the receipt itself so a later verifier can recompute them without consulting our repository. Frozen as gblin-canonical-json/1.",
    "properties": {
     "frozen_since": {
      "type": "string"
     },
     "leaf": {
      "type": "string"
     },
     "node": {
      "type": "string"
     },
     "rule": {
      "const": "gblin-canonical-json/1",
      "type": "string"
     },
     "signed_message": {
      "type": "string"
     },
     "spec": {
      "type": "string"
     },
     "verifier": {
      "type": "string"
     }
    },
    "required": [
     "rule",
     "spec"
    ],
    "type": "object"
   },
   "checkpoint": {
    "description": "C2SP signed note (origin, size, root)",
    "type": "string"
   },
   "format": {
    "const": "gblin-receipt/v1",
    "type": "string"
   },
   "inclusion_proof": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "index": {
    "type": "integer"
   },
   "leaf": {
    "description": "base64 SHA256(0x00 || canonical)",
    "type": "string"
   },
   "payload": {
    "description": "The signed, canonicalized record (gblin-canonical-json/1)",
    "properties": {
     "action": {
      "type": "string"
     },
     "agent_id": {
      "type": [
       "string",
       "null"
      ]
     },
     "by": {
      "description": "Present only when this server sealed its own action; set server-side, cannot be supplied by a caller",
      "enum": [
       "operator"
      ],
      "type": "string"
     },
     "demo": {
      "type": "boolean"
     },
     "index": {
      "type": "integer"
     },
     "input_hash": {
      "type": "string"
     },
     "log": {
      "type": "string"
     },
     "meta": {},
     "output_hash": {
      "type": [
       "string",
       "null"
      ]
     },
     "tool": {
      "type": [
       "string",
       "null"
      ]
     },
     "ts": {
      "type": "string"
     },
     "v": {
      "type": "integer"
     }
    },
    "required": [
     "v",
     "log",
     "index",
     "ts",
     "action",
     "input_hash"
    ],
    "type": "object"
   },
   "provenance": {
    "description": "What the receipt does and does not prove",
    "properties": {
     "level": {
      "enum": [
       "self-reported",
       "server-observed",
       "externally-verified"
      ],
      "type": "string"
     },
     "levels": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "levels_meaning": {
      "type": "object"
     },
     "meaning": {
      "type": "string"
     }
    },
    "required": [
     "level",
     "levels"
    ],
    "type": "object"
   },
   "root": {
    "description": "base64 Merkle root at tree_size",
    "type": "string"
   },
   "signature": {
    "description": "base64 Ed25519 over 'gblin-receipt/v1\\n' + canonical",
    "type": "string"
   },
   "tree_size": {
    "type": "integer"
   },
   "verifier_key": {
    "description": "C2SP note verifier key: origin+hash+base64(0x01||pub)",
    "type": "string"
   }
  },
  "required": [
   "format",
   "payload",
   "leaf",
   "index",
   "tree_size",
   "root",
   "signature",
   "verifier_key",
   "inclusion_proof",
   "checkpoint",
   "anchor",
   "provenance"
  ],
  "type": "object"
 }
}
