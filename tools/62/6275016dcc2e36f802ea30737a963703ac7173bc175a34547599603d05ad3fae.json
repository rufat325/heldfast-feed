{
 "description": "Format, prettify, or minify JSON data",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "indent": {
    "default": 2,
    "description": "Indent spaces (default 2)",
    "type": "number"
   },
   "json": {
    "description": "Raw JSON string",
    "type": "string"
   },
   "minify": {
    "default": false,
    "description": "If true, minify instead of prettify",
    "type": "boolean"
   }
  },
  "required": [
   "json"
  ],
  "type": "object"
 },
 "name": "format_json"
}
