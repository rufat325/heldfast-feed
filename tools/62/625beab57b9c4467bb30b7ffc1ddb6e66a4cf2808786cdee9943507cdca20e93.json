    "items": {
     "additionalProperties": false,
     "description": "One grant entry: the database this user should be allowed to access, with the rights to give. Defaults to full read+write+admin.",
     "properties": {
      "admin": {
       "default": true,
       "type": "boolean"
      },
      "database": {
       "description": "Database name (e.g. `acct_WP1234066`).",
       "minLength": 1,
       "type": "string"
      },
      "read": {
       "default": true,
       "type": "boolean"
      },
      "write": {
       "default": true,
       "type": "boolean"
      }
     },
     "required": [
      "database"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hosting_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "user_name": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "hosting_id",
   "user_name",
   "grants"
  ],
  "type": "object"
 },
