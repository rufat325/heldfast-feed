{
 "description": "Hybrid (dense + lexical) retrieval over a workspace, filtered by the caller\u2019s permissions. Returns the top matching chunks.",
 "inputSchema": {
  "properties": {
   "lanes": {
    "description": "Retrieval lanes (default dense+lexical).",
    "items": {
     "enum": [
      "dense",
      "lexical",
      "graph"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "permissions": {
    "description": "Caller permissions; only chunks whose permissionSet intersects are returned.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "query": {
    "description": "Natural-language query.",
    "type": "string"
   },
   "topK": {
    "default": 8,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "workspaceId": {
    "type": "string"
   }
  },
  "required": [
   "workspaceId",
   "query"
  ],
  "type": "object"
 },
 "name": "search"
}
