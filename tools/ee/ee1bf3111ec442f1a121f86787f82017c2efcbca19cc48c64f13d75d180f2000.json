{
 "description": "Create a new assessment. Call get_authoring_guide first. Pass workspace_directory to give candidates starter files. Dry-run it (get_dry_run_guide) before inviting anyone.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assessment_type": {
    "default": "coding",
    "enum": [
     "coding",
     "gtm",
     "fde"
    ],
    "type": "string"
   },
   "custom_agent_instructions": {
    "type": [
     "string",
     "null"
    ]
   },
   "custom_features": {
    "anyOf": [
     {
      "properties": {
       "seniorityLevels": {
        "items": {
         "properties": {
          "additionalGradingInstructions": {
           "type": "string"
          },
          "id": {
           "type": "string"
          },
          "name": {
           "type": "string"
          },
          "timeLimitMinutes": {
           "maximum": 240,
           "minimum": 10,
           "type": "number"
          }
         },
         "required": [
          "id",
          "name",
          "timeLimitMinutes"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "timeLimitMode": {
        "enum": [
         "single",
         "seniority"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "enable_browser_preview": {
    "default": false,
    "type": "boolean"
   },
   "enable_followup": {
    "default": false,
    "type": "boolean"
   },
   "followup_duration_minutes": {
    "anyOf": [
     {
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "followup_guidance": {
    "type": [
     "string",
     "null"
    ]
   },
   "followup_skip_generation": {
    "default": false,
    "type": "boolean"
   },
   "grading_instructions": {
    "anyOf": [
     {
      "properties": {
       "categories": {
        "items": {
         "anyOf": [
          {
           "properties": {
            "instructions": {
             "type": "string"
            },
            "name": {
             "enum": [
              "problem_completion",
              "prompt_crafting",
              "problem_solving",
              "design_taste",
              "code_quality",
              "ai_native_execution",
              "gtm_judgment",
              "operational_rigor",
              "analytical_thinking",
              "communication",
              "requirements_discovery",
              "stakeholder_communication"
             ],
             "type": "string"
            },
            "weight": {
             "maximum": 100,
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "name"
           ],
           "type": "object"
          },
          {
           "properties": {
            "instructions": {
             "type": "string"
            },
            "name": {
             "minLength": 1,
             "type": "string"
            },
            "weight": {
             "maximum": 100,
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "name",
            "weight",
            "instructions"
           ],
           "type": "object"
          }
         ]
        },
        "type": "array"
       },
       "instructions": {
        "type": "string"
       },
       "weights": {
        "additionalProperties": {
         "type": "number"
        },
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "machine_type": {
    "default": "standard",
    "enum": [
     "standard",
     "gpu",
     "performance"
    ],
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "problem": {
    "description": "Candidate-facing problem statement: a ProseMirror JSON document serialized to a string. Markdown is not accepted. Call get_authoring_guide for the format.",
    "type": "string"
   },
   "time_limit_minutes": {
    "default": 30,
    "type": "number"
   },
   "welcome_email_markdown": {
    "type": [
     "string",
     "null"
    ]
   },
   "welcome_email_signature": {
    "type": [
     "string",
     "null"
    ]
   },
   "workspace_directory": {
    "description": "Absolute path of a local directory to use as the starter workspace candidates begin from. Its contents become the workspace root; VCS, dependency, build-output, and .env files are excluded. Omit to leave the workspace unchanged.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "problem"
  ],
  "type": "object"
 },
 "name": "create_assessment",
 "title": "Create assessment"
}
