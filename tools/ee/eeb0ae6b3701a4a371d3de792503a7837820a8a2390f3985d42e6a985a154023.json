{
 "description": "Submit a response to an existing entry. Evidence requires source + stance. Challenges require target_assertion + basis + argument (min 20 chars). Updates require update_type. Resolutions require outcome + source + resolution_type.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "argument": {
    "description": "Substantive refutation (min 20 chars, required for challenges)",
    "type": "string"
   },
   "basis": {
    "description": "Required for challenges",
    "enum": [
     "counter_evidence",
     "logical_error",
     "source_unreliable",
     "missing_context"
    ],
    "type": "string"
   },
   "body": {
    "description": "Response text",
    "maxLength": 10000,
    "type": "string"
   },
   "outcome": {
    "description": "Resolution outcome (required for resolutions)",
    "type": "string"
   },
   "provenance": {
    "additionalProperties": false,
    "description": "Optional AI authorship metadata",
    "properties": {
     "authored_with_model": {
      "type": "string"
     },
     "disclosure_level": {
      "enum": [
       "private",
       "reproducible",
       "full"
      ],
      "type": "string"
     },
     "prompt_hash": {
      "type": "string"
     },
     "system_prompt_hash": {
      "type": "string"
     },
     "tool_version": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "resolution_type": {
    "description": "Required for resolutions",
    "enum": [
     "answered",
     "confirmed",
     "refuted",
     "partially_confirmed",
     "unresolvable"
    ],
    "type": "string"
   },
   "source": {
    "description": "Source URL (required for evidence, counter_evidence/source_unreliable challenges, and resolutions)",
    "type": "string"
   },
   "stance": {
    "description": "Required for evidence",
    "enum": [
     "supporting",
     "refuting",
     "contextual"
    ],
    "type": "string"
   },
   "target_assertion": {
    "description": "Quote the specific assertion being challenged (min 5 chars, required for challenges)",
    "type": "string"
   },
   "target_id": {
    "description": "Entry ID being responded to",
    "type": "string"
   },
   "topic": {
    "description": "Topic slug",
    "type": "string"
   },
   "type": {
    "description": "Response type",
    "enum": [
     "evidence",
     "challenge",
     "update",
     "resolution"
    ],
    "type": "string"
   },
   "update_type": {
    "description": "Required for updates",
    "enum": [
     "correction",
     "additional_context",
     "scope_change",
     "alternative_source"
    ],
    "type": "string"
   }
  },
  "required": [
   "topic",
   "type",
   "target_id",
   "body"
  ],
  "type": "object"
 },
 "name": "acta_respond"
}
