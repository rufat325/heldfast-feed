{
 "description": "Get OHLCV candlestick data for technical analysis. Intervals: 1m, 5m, 15m, 1h, 4h, 1d, 1w.",
 "inputSchema": {
  "properties": {
   "interval": {
    "description": "Candle interval",
    "enum": [
     "1m",
     "5m",
     "15m",
     "1h",
     "4h",
     "1d",
     "1w"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Number of candles (default 100, max 500)",
    "type": "number"
   },
   "pair_id": {
    "description": "Trading pair ID",
    "type": "string"
   }
  },
  "required": [
   "pair_id"
  ],
  "type": "object"
 },
 "name": "get_candles"
}
