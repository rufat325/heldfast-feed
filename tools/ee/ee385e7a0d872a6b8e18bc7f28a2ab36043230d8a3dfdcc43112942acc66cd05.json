{
 "description": "List known constants, error codes, defined structs, or search strings in a module",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Type of list to retrieve",
    "enum": [
     "constants",
     "error_codes",
     "structs",
     "strings"
    ],
    "type": "string"
   },
   "module": {
    "description": "Module name (required for strings action)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_database"
}
