{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Track added, changed, withdrawn, and removed startup credits, discounts, free tiers, perks, and deals through Sourcey's signed change feed after an optional cursor.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque signed cursor returned by the previous change-feed page.",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_changes",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "basis_event_ids": {
       "items": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "type": "array"
      },
      "change_id": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "kind": {
       "description": "Append-only release change kind. Known values are examples; new kinds may appear within public API v1.",
       "examples": [
        "entity.added",
        "entity.updated",
        "entity.retired",
        "program.added",
        "program.updated",
        "program.retired",
        "offer.added",
        "offer.updated",
        "offer.ended",
        "offer.retired",
        "offer.withdrawn",
        "policy.added",
        "policy.updated",
        "policy.retired",
        "agent-readiness.added",
        "agent-readiness.updated",
        "agent-readiness.regraded",
        "agent-readiness.relocated",
        "agent-readiness.ended",
        "agent-readiness.withdrawn",
        "asset.bound",
        "asset.updated",
        "asset.withdrawn"
       ],
       "pattern": "^[a-z][a-z0-9-]*(?:\\.[a-z][a-z0-9-]*)+$",
       "type": "string",
       "x-sourcey-extensible-enum": true
      },
      "previous_projection_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "previous_revision_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "projection_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "revision_digest": {
       "pattern": "^sha256:[a-f0-9]{64}$",
       "type": "string"
      },
      "subject_id": {
       "anyOf": [
        {
         "pattern": "^[a-z0-9][a-z0-9_-]*$",
         "type": "string"
        },
        {
         "pattern": "^sha256:[a-f0-9]{64}$",
         "type": "string"
        }
       ]
      },
      "subject_type": {
       "enum": [
        "entity",
        "program",
        "offer",
        "policy",
        "agent_readiness_profile",
        "asset_binding"
       ],
       "type": "string"
      },
      "tombstone": {
       "additionalProperties": false,
       "properties": {
        "canonical_route": {
         "format": "starts_with",
         "pattern": "^\\/.*",
         "type": "string"
        },
        "reason": {
         "enum": [
          "retired",
          "ended",
          "withdrawn"
         ],
         "type": "string"
        }
       },
       "required": [
        "reason"
       ],
       "type": "object"
      }
     },
     "required": [
      "change_id",
      "kind",
      "subject_type",
      "subject_id",
      "basis_event_ids"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diff_digest": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "feed_contract": {
    "const": "sourcey.catalog-feed/v1alpha1",
    "type": "string"
   },
   "next_cursor": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "release_id": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "retained_from_release_id": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   },
   "snapshot_id": {
    "pattern": "^sha256:[a-f0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "feed_contract",
   "release_id",
   "snapshot_id",
   "diff_digest",
   "retained_from_release_id",
   "data",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Get changes"
}
