   {
    "scopes": [
     "guild.admin"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add guild calendar event"
 },
 "description": "Add a new event to the guild's shared calendar. Owner/Admin only. startDateTime / endDateTime are ISO-8601 (e.g. 2026-06-12T19:00:00).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "description": "Optional event description.",
    "type": "string"
   },
   "endDateTime": {
    "description": "Event end, ISO-8601 \u2014 optional.",
    "type": "string"
   },
   "guildId": {
    "description": "Guild ID.",
    "minLength": 1,
    "type": "string"
   },
   "startDateTime": {
    "description": "Event start, ISO-8601 (e.g. 2026-06-12T19:00:00).",
    "type": "string"
   },
   "title": {
    "description": "Event title.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "guildId",
   "title",
   "startDateTime"
  ],
  "type": "object"
 },
 "name": "add_guild_calendar_event",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "title": "Add guild calendar event"
}
