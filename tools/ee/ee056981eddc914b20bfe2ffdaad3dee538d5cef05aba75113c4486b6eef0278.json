{
 "description": "List token transfers involving a contract, with filters (token, counterparties, time range). Keyset pagination via `cursor`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractAddress": {
    "description": "Starknet contract address (0x-prefixed hex).",
    "type": "string"
   },
   "cursor": {
    "description": "Keyset pagination cursor: the `id` of the last item from the previous response.",
    "type": "string"
   },
   "from": {
    "description": "Filter by sender address (0x-prefixed).",
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "orderBy": {
    "description": "Sort order. Defaults to \"desc\".",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "pageSize": {
    "description": "Items per page: 10, 25, 50, or 100. Defaults to 25. Keep small to save context.",
    "enum": [
     10,
     25,
     50,
     100
    ],
    "type": "number"
   },
   "timestampFrom": {
    "description": "Start of time range (Unix seconds).",
    "type": "integer"
   },
   "timestampTo": {
    "description": "End of time range (Unix seconds).",
    "type": "integer"
   },
   "to": {
    "description": "Filter by recipient address (0x-prefixed).",
    "type": "string"
   },
   "tokenAddress": {
    "description": "Filter by token contract address (0x-prefixed).",
    "type": "string"
   },
   "type": {
    "description": "Token standard. Defaults to \"erc20\".",
    "enum": [
     "erc20",
     "erc721",
     "erc1155"
    ],
    "type": "string"
   }
  },
  "required": [
   "contractAddress"
  ],
  "type": "object"
 },
 "name": "get_contract_transfers"
}
