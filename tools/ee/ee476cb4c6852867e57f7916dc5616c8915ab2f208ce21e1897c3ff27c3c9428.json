{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Export a saved company list to CSV, optionally including selected firmographic and enrichment columns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "__requestBody": {
    "additionalProperties": {},
    "description": "Request body",
    "properties": {
     "fields": {
      "description": "Optional firmographic columns to include after the fixed `name` and\n`website` columns, in the order specified. Unknown values return 422.\n",
      "example": [
       "industry",
       "size",
       "country_code"
      ],
      "items": {
       "enum": [
        "industry",
        "size",
        "founded",
        "city",
        "state",
        "country_code"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "signalTemplateIds": {
      "description": "IDs of signal templates whose subscriptions should be included as\ncolumns. Two columns are added per subscription:\n`{signal_name}_answer` and `{signal_name}_confidence`. If absent\nor empty, no signal columns are added.\n",
      "example": [
       "123e4567-e89b-12d3-a456-426614174000"
      ],
      "items": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "listId": {
    "description": "The unique identifier of the company list",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "listId"
  ],
  "type": "object"
 },
 "name": "company_lists-export"
}
