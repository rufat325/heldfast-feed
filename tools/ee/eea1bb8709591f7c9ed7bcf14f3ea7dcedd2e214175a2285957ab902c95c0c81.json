  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Aircraft types of the game catalog: seats in two classes, range, cruise speed, required runway, entry into service and end of production, and the list price in millions of US dollars of the entry-into-service year. With year, only types already flying that year are returned and availabilityInYear says whether they are sold new or only on the used market.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "PISTON",
     "TURBOPROP",
     "NARROWBODY",
     "WIDEBODY",
     "JUMBO",
     "SST",
     "REGIONAL_JET"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Language for the human-readable labels next to keys, one of the 25 game locales (en, ru, de, fr, es, ja, zh-CN and others); unknown values fall back to English",
    "maxLength": 10,
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 150,
    "minimum": 1,
    "type": "integer"
   },
   "manufacturer": {
    "description": "Substring, case-insensitive",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Substring of the model name or id, case-insensitive (A320, 747, dc-3)",
    "maxLength": 40,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Only aircraft already in service in this year; also fills availabilityInYear",
    "maximum": 2030,
    "minimum": 1950,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "aircraft_catalog",
