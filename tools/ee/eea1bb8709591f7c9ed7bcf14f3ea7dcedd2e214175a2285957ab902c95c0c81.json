          "used-only"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "category": {
       "enum": [
        "PISTON",
        "TURBOPROP",
        "NARROWBODY",
        "WIDEBODY",
        "JUMBO",
        "SST",
        "REGIONAL_JET"
       ],
       "type": "string"
      },
      "categoryName": {
       "type": "string"
      },
      "cruiseKmh": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "eisPlanned": {
       "type": "boolean"
      },
      "eisYear": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "eopYear": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "family": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "listPriceUsdMlnAtEis": {
       "type": "number"
      },
      "manufacturer": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "priceEstimated": {
       "type": "boolean"
      },
      "rangeKm": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "runwayRequiredM": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
