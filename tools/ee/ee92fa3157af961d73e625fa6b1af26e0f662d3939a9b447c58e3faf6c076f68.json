{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find location records added/modified in Atlas during inclusive UTC dates, newest matching timestamp first. Not historical capture dates or a complete change log; render-only changes may not update a location. Example: {\"from\":\"2026-09-01\",\"to\":\"2026-09-14\",\"kind\":\"added\"}. Prefer interactiveUrl for human links and citations. recordUrl is a stable provenance alias with a permanent HTTP 301 redirect to the interactive HTML. Use apiUrl or JSONL for JSON. Derivatives use locationInteractiveUrl/locationRecordUrl.",
 "inputSchema": {
  "properties": {
   "dimension": {
    "default": null,
    "description": "Optional dimension 0, 1 or 2.",
    "type": [
     "integer",
     "null"
    ]
   },
   "from": {
    "description": "Inclusive UTC date YYYY-MM-DD.",
    "type": "string"
   },
   "kind": {
    "default": "either",
    "description": "added, modified, or either.",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Maximum results, 1\u2013100.",
    "type": "integer"
   },
   "to": {
    "description": "Inclusive UTC date YYYY-MM-DD.",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "find_recently_added_or_modified",
 "outputSchema": {
  "properties": {
   "result": {
    "items": {
     "properties": {
      "canonicalUrl": {
       "type": "string"
      },
      "dateAddedUtc": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "dimension": {
       "type": "string"
      },
      "id": {
       "type": "integer"
      },
      "interactiveUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "matchedKind": {
       "type": "string"
      },
      "matchedUtc": {
       "format": "date-time",
       "type": "string"
      },
      "modifiedUtc": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "recordUrl": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "id",
      "name",
      "dimension",
      "dateAddedUtc",
      "modifiedUtc",
      "matchedUtc",
      "matchedKind",
      "canonicalUrl"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
