{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List statuses for a module (testcase / testcycle / testplan). Returns id, name, color, isDefault, isArchive.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "module": {
    "description": "Module whose statuses to fetch",
    "enum": [
     "testcase",
     "testcycle",
     "testplan"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "Jira project numeric ID (e.g. 10000)",
    "type": [
     "string",
     "number"
    ]
   },
   "status": {
    "items": {
     "enum": [
      "active",
      "archive"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId",
   "module"
  ],
  "type": "object"
 },
 "name": "qtm4j_get_statuses",
 "title": "Get Statuses"
}
