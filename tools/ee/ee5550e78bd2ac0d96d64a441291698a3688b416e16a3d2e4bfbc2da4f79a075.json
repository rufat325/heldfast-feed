{"description":"Write a whole new circuit file from a netlist in one call: parts (no positions) and nets (pin lists). Unless place is false the board is then placed (fitted when no board is given) as a second entry. A block used more than once goes in sheets, used by instances. Nothing is written if anything is wrong; the answer says what. An existing file is refused unless replace. Details: guide { topic: \"writing-circuits\" }.","inputSchema":{"properties":{"board":{"description":"mm; default 30 x 20; kind \"perfboard\"/\"stripboard\": 2.54 mm holes","properties":{"height":{"type":"number"},"kind":{"enum":["pcb","perfboard","stripboard"],"type":"string"},"width":{"type":"number"}},"type":"object"},"file":{"description":"e.g. power.circuit.tsx","type":"string"},"holes":{"items":{"properties":{"diameter":{"description":"Drill, mm","type":"number"},"x":{"description":"Centre, mm","type":"number"},"y":{"description":"Centre, mm","type":"number"}},"required":["x","y","diameter"],"type":"object"},"type":"array"},"instances":{"items":{"properties":{"base":{"description":"100 makes R1 into R101; default 100, 200, \u2026","exclusiveMinimum":0,"type":"integer"},"connections":{"additionalProperties":{"type":"string"},"description":"e.g. { \"VIN\": \"VBUS\" }","type":"object"},"name":{"description":"e.g. PS1","type":"string"},"sheet":{"type":"string"}},"required":["sheet","name","connections"],"type":"object"},"type":"array"},"nets":{"additionalProperties":{"items":{"type":"string"},"minItems":1,"type":"array"},"description":"e.g. { \"GND\": [\"R1.pin2\", \"U1.GND\"] }; optional","type":"object"},"pages":{"description":"Pages after \"Main\", which holds the rest","items":{"properties":{"name":{"type":"string"},"parts":{"items":{"type":"string"},"type":"array"}},"required":["name","parts"],"type":"object"},"type":"array"},"parts":{"description":"May be empty when instances make them","items":{"properties":{"footprint":{"type":"string"},"kind":{"description":"Built-in, e.g. res