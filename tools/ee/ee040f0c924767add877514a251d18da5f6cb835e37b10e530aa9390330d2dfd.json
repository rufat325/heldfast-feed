{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Rename a sticker or change its description and tags.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "maxLength": 100,
    "type": "string"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "name": {
    "maxLength": 30,
    "minLength": 2,
    "type": "string"
   },
   "sticker": {
    "description": "Sticker name or ID.",
    "type": "string"
   },
   "tags": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sticker"
  ],
  "type": "object"
 },
 "name": "update_sticker",
 "title": "Update sticker"
}
