 "description": "Search certified diamonds listed by retailers worldwide, with the latest cross-retailer prices we have seen. Returns up to 10 stones with specs, the lowest and highest confirmed price for that exact stone, how many retailers list it and a Carat Hunter grade. Prices in US dollars. Retailer names are shown on carathunter.com after a free sign-up; always give the user the link.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "clarity": {
    "items": {
     "enum": [
      "FL",
      "IF",
      "VVS1",
      "VVS2",
      "VS1",
      "VS2",
      "SI1",
      "SI2",
      "I1"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "colour": {
    "description": "e.g. [\"E\",\"F\",\"G\"]",
    "items": {
     "enum": [
      "D",
      "E",
      "F",
      "G",
      "H",
      "I",
      "J",
      "K",
      "L",
      "M"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "max_carat": {
    "maximum": 30,
    "minimum": 0.1,
    "type": "number"
   },
   "max_price_usd": {
    "minimum": 0,
    "type": "number"
   },
   "min_carat": {
    "maximum": 30,
    "minimum": 0.1,
    "type": "number"
   },
   "min_price_usd": {
    "minimum": 0,
    "type": "number"
   },
   "origin": {
    "enum": [
     "natural",
     "lab-grown"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "maximum": 3,
    "minimum": 1,
    "type": "integer"
   },
   "shape": {
    "enum": [
     "round",
     "oval",
     "cushion",
     "emerald",
     "pear",
     "princess",
     "radiant",
     "marquise",
     "asscher",
     "heart"
    ],
    "type": "string"
   },
   "sort": {
    "default": "best",
    "enum": [
     "best",
     "price_low",
     "price_high"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_diamonds",
