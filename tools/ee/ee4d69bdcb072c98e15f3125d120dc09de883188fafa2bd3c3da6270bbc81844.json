 "description": "Scheduled future flights at one airport, from Aviationstack's /flightsFuture endpoint \u2014 what flies a route on a day next week. Requires an IATA airport code, a direction (departure or arrival), and a date; returns each flight's number, airline, aircraft model, and scheduled terminal/gate/time. Aviationstack's booking-view window for this endpoint currently covers only the next 7 days (apilayer notice, 2026-10-06): date must be between tomorrow and 7 days from today \u2014 a date outside that window is refused before the call is made, not after a wasted round trip.",
 "inputSchema": {
  "examples": [
   {
    "date": "2026-10-09",
    "iataCode": "JFK",
    "type": "departure"
   },
   {
    "airline_iata": "AA",
    "date": "2026-10-10",
    "iataCode": "LAX",
    "limit": 25,
    "type": "arrival"
   }
  ],
  "properties": {
   "airline_iata": {
    "description": "Filter by airline IATA code",
    "type": "string"
   },
   "airline_icao": {
    "description": "Filter by airline ICAO code",
    "type": "string"
   },
   "date": {
    "description": "Future date, format YYYY-MM-DD, must fall within tomorrow through 7 days from today (UTC) \u2014 Aviationstack's current flightsFuture window.",
    "type": "string"
   },
   "flight_number": {
    "description": "Filter by flight number",
    "type": "string"
   },
   "iataCode": {
    "description": "3-letter IATA airport code whose schedule to look up (e.g. \"JFK\")",
    "type": "string"
   },
   "limit": {
    "description": "1-100 (default 100)",
    "type": "number"
   },
   "offset": {
    "description": "0-based offset",
    "type": "number"
   },
   "type": {
    "description": "Whether to return flights scheduled to depart or arrive at iataCode",
    "enum": [
     "departure",
     "arrival"
    ],
    "type": "string"
   }
  },
  "required": [
   "iataCode",
   "type",
   "date"
  ],
  "type": "object"
 },
