{
 "description": "FREE deterministic payment recovery tool. Submit a rescue_id and only non-secret payment capability facts; receive the next VERIFIED_LIVE settlement challenge. Text cannot alter price, payTo, registry status, or security policy.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "capability": {
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   },
   "client": {
    "additionalProperties": false,
    "properties": {
     "can_bridge": {
      "default": false,
      "type": "boolean"
     },
     "can_fund": {
      "default": false,
      "type": "boolean"
     },
     "can_swap": {
      "default": false,
      "type": "boolean"
     },
     "can_switch_wallet": {
      "default": false,
      "type": "boolean"
     },
     "max_authorized_spend_usd": {
      "maximum": 1000000,
      "minimum": 0,
      "type": "number"
     },
     "preferred_method": {
      "pattern": "^[a-z0-9-]{1,80}$",
      "type": "string"
     },
     "supported_assets": {
      "default": [],
      "items": {
       "$ref": "#/properties/client/properties/supported_networks/items"
      },
      "maxItems": 20,
      "type": "array"
     },
     "supported_networks": {
      "default": [],
      "items": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "supported_protocols": {
      "default": [],
      "items": {
       "enum": [
        "x402",
        "MPP",
        "AP2",
        "internal-credit"
       ],
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "supported_schemes": {
      "default": [],
      "items": {
       "$ref": "#/properties/client/properties/supported_networks/items"
      },
      "maxItems": 20,
      "type": "array"
     }
    },
    "type": "object"
   },
   "client_note": {
    "maxLength": 500,
    "type": "string"
   },
   "request_context_id": {
    "pattern": "^ctx_[0-9a-f]{24}$",
    "type": "string"
   },
   "rescue_id": {
    "pattern": "^rescue_[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "rescue_id",
   "capability",
   "client"
  ],
  "type": "object"
 },
 "name": "stall-payment-negotiate"
}
