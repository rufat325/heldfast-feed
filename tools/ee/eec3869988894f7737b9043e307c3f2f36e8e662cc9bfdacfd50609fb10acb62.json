  "additionalProperties": false,
  "properties": {
   "airlines": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Restrict to these airline names or codes, e.g. [\"IndiGo\",\"6E\"]."
   },
   "cabin": {
    "default": "economy",
    "description": "economy | premium economy | business | first (default economy).",
    "type": "string"
   },
   "children": {
    "default": 0,
    "description": "Number of child travellers (default 0).",
    "type": "integer"
   },
   "depart_after": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Earliest outbound departure hour, e.g. 6 or \"06:00\"\n(inclusive). Use with depart_before for a narrow window that the\ncoarse time_slot buckets cannot express."
   },
   "depart_before": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Exclusive end \u2014 \"09:00\" means the last acceptable\ndeparture is 08:59. 9 and \"09:00\" are the same instant. \"09:30\"\nkeeps 09:15. A window whose end is earlier than its start is\nrejected; this search does not cross midnight."
   },
   "departure_date": {
    "description": "Outbound date as YYYY-MM-DD.",
    "type": "string"
   },
   "destination": {
    "description": "Arrival IATA code, e.g. \"DXB\".",
    "type": "string"
   },
   "infants": {
    "default": 0,
    "description": "Number of infant travellers (default 0).",
    "type": "integer"
   },
   "max_price": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Budget cap in INR. For one_way this is the per-flight fare;\nfor round_trip it is the COMBINED both-legs total."
   },
   "non_stop": {
    "default": false,
    "description": "Only non-stop flights.",
    "type": "boolean"
   },
   "origin": {
    "description": "Departure IATA code, e.g. \"DEL\".",
    "type": "string"
   },
   "passengers": {
    "default": 1,
    "description": "Number of adult travellers (default 1).",
    "type": "integer"
   },
   "refundable": {
    "default": false,
    "description": "Only refundable fares.",
    "type": "boolean"
   },
   "return_date": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Return date YYYY-MM-DD (required for round_trip)."
   },
   "return_depart_after": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Earliest RETURN departure hour, e.g. \"19:00\"."
   },
   "return_depart_before": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Latest RETURN departure hour, exclusive."
   },
   "return_time_slot": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Same buckets, for the RETURN leg of a round trip. Omit\nto leave the return leg unfiltered by time."
   },
   "sort_by": {
    "default": "cheapest",
    "description": "best | cheapest | fastest (default cheapest).",
    "type": "string"
   },
   "time_slot": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "OUTBOUND departure bucket: early_morning [00:00, 06:00) |\nmorning [06:00, 12:00) | afternoon [12:00, 18:00) |\nevening [18:00, 24:00). Applies to the outbound leg only.\n\"early morning\" is accepted. \"night\" is rejected. An unrecognised\nvalue is rejected, not ignored."
   },
   "trip_type": {
    "default": "one_way",
    "description": "\"one_way\" or \"round_trip\" (round_trip needs return_date).",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "departure_date"
  ],
  "type": "object"
 },
