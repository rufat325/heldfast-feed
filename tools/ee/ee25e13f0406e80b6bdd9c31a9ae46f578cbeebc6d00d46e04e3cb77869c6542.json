{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Delete a processed image batch"
 },
 "description": "Use this when someone wants one processed image batch deleted for good. Returns the deleted batch's id, slug and project. Its original, main output and every resized or converted file are erased and the batch.deleted webhook fires, with no undo. Not for removing a resize preset.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batchId": {
    "description": "Exact batch id to permanently delete; obtain it",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "batchId"
  ],
  "type": "object"
 },
 "name": "delete_batch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "batch": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "projectId": {
        "$ref": "#/properties/batch/anyOf/0/properties/id"
       },
       "slug": {
        "$ref": "#/properties/batch/anyOf/0/properties/id"
       }
      },
      "required": [
       "id",
       "slug",
       "projectId"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "deleted",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "batch"
  ],
  "type": "object"
 },
 "title": "Delete a processed image batch"
}
