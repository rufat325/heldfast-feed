   },
   "format": {
    "default": "json",
    "description": "Response shape. 'json' returns structured records; 'text' returns the same content rendered as a short narrative paragraph for chat surfaces.",
    "enum": [
     "json",
     "text"
    ],
    "type": "string"
   },
   "hours": {
    "default": 3,
    "description": "How many hours ahead to look (1-12). Default 3.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   },
   "language": {
    "description": "BCP-47 language code for human-readable fields (e.g., 'en', 'fr-FR'). Defaults to English when omitted.",
    "type": "string"
   },
   "latitude": {
    "description": "Optional latitude to bias toward nearby venues.",
    "type": "number"
   },
   "longitude": {
    "description": "Optional longitude to bias toward nearby venues.",
    "type": "number"
   }
  },
  "required": [
   "city"
  ],
  "type": "object"
 },
