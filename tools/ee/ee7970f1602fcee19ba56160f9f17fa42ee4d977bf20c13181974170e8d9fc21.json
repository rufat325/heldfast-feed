{
 "description": "Run the Oksigenia Checker against a domain and return a scored security report from real live checks (SSL/TLS, email authentication, DNS & infrastructure, web security). Accepts a bare domain or a URL. Optionally restrict to specific categories.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categories": {
    "description": "Optional subset of categories. Defaults to all: ssl, email, dns, web.",
    "items": {
     "enum": [
      "ssl",
      "email",
      "dns",
      "web"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "domain": {
    "description": "Domain or URL to scan, e.g. 'oksigenia.com' or 'https://oksigenia.com/blog'.",
    "minLength": 1,
    "type": "string"
   },
   "format": {
    "description": "Output format: human-readable 'report' (default) or raw 'json'.",
    "enum": [
     "report",
     "json"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Report language: 'es' or 'en'. Defaults to $OKSIGENIA_LANG or 'en'.",
    "enum": [
     "es",
     "en"
    ],
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "check_domain",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "enum": [
        "ssl",
        "email",
        "dns",
        "web"
       ],
       "type": "string"
      },
      "detail": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "remediation": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "pass",
        "warn",
        "fail",
        "info"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "weight": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "category",
      "severity",
      "weight",
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "domain": {
    "type": "string"
   },
   "grade": {
    "type": "string"
   },
   "lang": {
    "enum": [
     "es",
     "en"
    ],
    "type": "string"
   },
   "score": {
    "type": "number"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "fail": {
      "type": "number"
     },
     "info": {
      "type": "number"
     },
     "pass": {
      "type": "number"
     },
     "warn": {
      "type": "number"
     }
    },
    "required": [
     "pass",
     "warn",
     "fail",
     "info"
    ],
    "type": "object"
   }
  },
  "required": [
   "domain",
   "lang",
   "score",
   "grade",
   "summary",
   "checks"
  ],
  "type": "object"
 },
 "title": "Check a domain's security"
}
