      "type": "integer"
     },
     "e164": {
      "description": "E.164 form.",
      "examples": [
       "+442070313000"
      ],
      "type": "string"
     },
     "input": {
      "description": "The request.",
      "properties": {
       "number": {
        "description": "The number as given.",
        "examples": [
