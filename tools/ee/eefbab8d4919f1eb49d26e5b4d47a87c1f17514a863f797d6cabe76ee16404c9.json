        ],
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "number",
       "region"
      ],
      "type": "object"
     },
     "international": {
      "description": "International format.",
      "examples": [
       "+44 20 7031 3000"
      ],
      "type": "string"
     },
     "line_type": {
      "description": "Kind of line.",
      "enum": [
       "fixed_line",
       "mobile",
       "fixed_line_or_mobile",
       "toll_free",
       "premium_rate",
       "shared_cost",
       "voip",
       "personal_number",
       "pager",
       "uan",
       "voicemail",
       "unknown"
      ],
      "examples": [
       "fixed_line"
      ],
      "type": "string"
     },
     "location": {
      "description": "Area the number was issued to (city or region); null when unknown.",
      "examples": [
       "London"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "metadata_version": {
      "description": "libphonenumber metadata version used.",
      "examples": [
       "9.0.40"
      ],
      "type": "string"
     },
     "national": {
      "description": "National format.",
      "examples": [
       "020 7031 3000"
      ],
      "type": "string"
     },
     "notes": {
      "description": "Caveats.",
      "examples": [
       []
      ],
      "items": {
       "description": "A caveat.",
       "examples": [
        "Answered from the number alone."
       ],
       "type": "string"
      },
      "type": "array"
     },
     "possible": {
      "description": "The length is possible for the country.",
      "examples": [
       true
      ],
      "type": "boolean"
     },
     "region": {
      "description": "ISO country code the number belongs to.",
      "examples": [
       "GB"
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "time_zones": {
      "description": "Time zones the number's area uses.",
      "examples": [
       [
        "Europe/London"
       ]
      ],
      "items": {
       "description": "An IANA time zone.",
       "examples": [
        "Europe/London"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "valid": {
      "description": "A valid number in its country's numbering plan.",
      "examples": [
       true
      ],
      "type": "boolean"
     }
    },
    "required": [
     "input",
     "valid",
     "possible",
     "e164",
     "international",
     "national",
     "country_code",
     "region",
     "country",
     "location",
     "carrier",
     "line_type",
     "time_zones",
     "metadata_version",
     "notes",
     "checked_at"
    ],
    "type": "object"
   },
   "status": {
    "const": "ok",
    "description": "Present only on a delivered result.",
    "type": "string"
   },
   "worker": {
