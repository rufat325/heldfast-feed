{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the status for a PDF job using its unguessable capability.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Short-lived capability returned by generate_pdf.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "job_id": {
    "description": "Job UUID returned by generate_pdf.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "capability"
  ],
  "type": "object"
 },
 "name": "get_pdf_job",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "PDF job status, download capability, and settlement details.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "artifactBytes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "capability": {
    "type": "string"
   },
   "createdAt": {
    "type": "string"
   },
   "downloadUrl": {
    "format": "uri",
    "type": "string"
   },
   "error": {},
   "errorCode": {
    "type": "string"
   },
   "expiresAt": {
    "type": "string"
   },
   "extensions": {},
   "jobId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "resource": {},
   "resumed": {
    "type": "boolean"
   },
   "settlement": {},
   "state": {
    "type": "string"
   },
   "statusUrl": {
    "format": "uri",
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Get PDF job status"
}
