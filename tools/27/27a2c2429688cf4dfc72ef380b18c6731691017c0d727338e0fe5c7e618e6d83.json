{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Converts one or more Invoice JSON objects to an Excel (.xlsx) file. The output_path is required since Excel files are binary.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "invoices": {
    "description": "Array of Invoice objects to export",
    "items": {
     "additionalProperties": false,
     "properties": {
      "additional_data": {
       "additionalProperties": false,
       "properties": {
        "customer_id": {
         "type": "string"
        },
        "delivery_id": {
         "type": "string"
        },
        "invoicing_period": {
         "additionalProperties": false,
         "properties": {
          "end": {
           "description": "Period end date (YYYY-MM-DD)",
           "type": "string"
          },
          "start": {
           "description": "Period start date (YYYY-MM-DD)",
           "type": "string"
          }
         },
         "required": [
          "start",
          "end"
         ],
         "type": "object"
        },
        "leitweg_id": {
         "description": "Leitweg-ID for German government invoicing",
         "type": "string"
        },
        "order_id": {
         "type": "string"
        },
        "preceeding_invoice_number": {
         "type": "string"
        },
        "project": {
         "description": "Project reference",
         "type": "string"
        },
        "reverse_charge": {
         "description": "True if VAT reverse charge applies",
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "buyer": {
       "additionalProperties": false,
       "description": "The party receiving the invoice",
       "properties": {
        "contact": {
         "$ref": "#/properties/invoices/items/properties/seller/properties/contact"
        },
        "name": {
         "$ref": "#/properties/invoices/items/properties/seller/properties/name"
        },
        "postal_address": {
         "$ref": "#/properties/invoices/items/properties/seller/properties/postal_address"
        },
        "vat_identifier": {
         "$ref": "#/properties/invoices/items/properties/seller/properties/vat_identifier"
        }
       },
       "required": [
        "name",
        "postal_address",
        "contact"
       ],
       "type": "object"
      },
      "category": {
       "description": "Invoice category",
       "type": "string"
      },
      "delivery_information": {
       "additionalProperties": false,
       "properties": {
        "deliver_to": {
         "description": "Delivery recipient name",
         "type": "string"
        },
        "deliver_to_address": {
         "additionalProperties": false,
         "properties": {
          "address_line_1": {
           "description": "Street address line 1",
           "type": "string"
          },
          "address_line_2": {
           "type": "string"
          },
          "address_line_3": {
           "type": "string"
          },
          "city": {
           "type": "string"
          },
          "country_code": {
           "maxLength": 2,
           "minLength": 2,
           "type": "string"
          },
          "country_subdivision": {
           "type": "string"
          },
          "post_code": {
           "type": "string"
          }
         },
         "required": [
          "address_line_1",
          "city",
          "post_code",
          "country_code"
         ],
         "type": "object"
        },
        "delivery_date": {
         "description": "Delivery date (YYYY-MM-DD)",
         "type": "string"
        },
        "delivery_instructions": {
         "type": "string"
        },
        "delivery_method": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "invoice_currency_code": {
       "description": "ISO 4217 currency code, e.g. 'EUR', 'USD', 'GBP'",
       "type": "string"
      },
      "invoice_date": {
       "description": "Issue date in YYYY-MM-DD format",
       "type": "string"
      },
      "invoice_description": {
       "description": "Short description of the invoice",
       "type": "string"
      },
      "invoice_note": {
       "type": "string"
      },
      "invoice_number": {
       "description": "Unique invoice identifier, e.g. 'INV-2025-001'",
       "type": "string"
      },
      "invoice_type": {
       "description": "'incoming' = received from vendor/supplier; 'outgoing' = sent to customer",
       "enum": [
        "incoming",
        "outgoing"
       ],
       "type": "string"
      },
      "items": {
       "description": "Invoice line items (at least 1)",
       "items": {
        "additionalProperties": false,
        "properties": {
         "item_identifier": {
          "description": "Unique line-item identifier",
          "type": "string"
         },
         "item_information": {
          "description": "Description of the item or service",
          "type": "string"
         },
         "item_quantity": {
          "description": "Quantity of items",
          "type": "number"
         },
         "item_quantity_unit_of_measure_code": {
          "description": "UN/ECE Recommendation 20 unit code, e.g. 'C62' (unit), 'HUR' (hour), 'KGM' (kg)",
          "type": "string"
         },
         "item_total_amount_with_vat": {
          "description": "Total line amount including VAT",
          "type": "number"
         },
         "item_total_amount_without_vat": {
          "description": "Total line amount excluding VAT",
          "type": "number"
         },
         "price_details": {
          "additionalProperties": false,
          "properties": {
           "item_price_discount": {
            "description": "Discount per unit",
            "type": "number"
           },
           "item_price_with_vat": {
            "description": "Unit price with VAT",
            "type": "number"
           },
           "item_price_without_vat": {
            "description": "Unit price without VAT",
            "type": "number"
           },
           "item_vat_percentage": {
            "description": "VAT rate as percentage, e.g. 19",
            "type": "number"
           },
           "vat_category_code": {
            "description": "VAT category: S=Standard, Z=Zero-rated, E=Exempt, AE=Reverse charge, K=Intra-community, G=Export, O=Outside scope, L=Canary Islands, M=Ceuta/Melilla",
            "enum": [
             "S",
             "Z",
             "E",
             "AE",
             "K",
             "G",
             "O",
             "L",
             "M"
            ],
            "type": "string"
           }
          },
          "required": [
           "item_price_without_vat",
           "item_price_with_vat",
           "item_vat_percentage",
           "vat_category_code"
          ],
          "type": "object"
         }
        },
        "required": [
         "item_identifier",
         "item_quantity",
         "item_quantity_unit_of_measure_code",
         "item_total_amount_with_vat",
         "price_details"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "payment_information": {
       "additionalProperties": false,
       "properties": {
        "credit_card_number": {
         "type": "string"
        },
        "credit_card_type": {
         "type": "string"
        },
        "payment_account_number": {
         "description": "IBAN or account number",
         "type": "string"
        },
        "payment_due_date": {
         "description": "Due date (YYYY-MM-DD)",
         "type": "string"
        },
        "payment_instructions": {
         "type": "string"
        },
        "payment_payed_date": {
         "description": "Date payment was made (YYYY-MM-DD)",
         "type": "string"
        },
        "payment_reference": {
         "type": "string"
        },
        "payment_terms": {
         "type": "string"
        },
        "payment_type": {
         "description": "Payment method",
         "enum": [
          "credit_card",
          "credit_transfer",
          "cash",
          "online_payment_service"
         ],
         "type": "string"
        }
       },
       "type": "object"
      },
      "seller": {
       "additionalProperties": false,
       "description": "The party issuing the invoice",
       "properties": {
        "contact": {
         "additionalProperties": false,
         "properties": {
          "email_address": {
           "description": "Email address",
           "type": "string"
          },
          "telephone_number": {
           "description": "Phone number",
           "type": "string"
          }
         },
         "type": "object"
        },
        "name": {
         "description": "Full formal name of the party",
         "type": "string"
        },
        "postal_address": {
         "additionalProperties": false,
         "properties": {
          "address_line_1": {
           "description": "Street address line 1",
           "type": "string"
          },
          "address_line_2": {
           "description": "Street address line 2",
           "type": "string"
          },
          "address_line_3": {
           "description": "Street address line 3",
           "type": "string"
          },
          "city": {
           "description": "City name",
           "type": "string"
          },
          "country_code": {
           "description": "ISO 3166-1 alpha-2 country code, e.g. 'DE', 'US', 'FR'",
           "maxLength": 2,
           "minLength": 2,
           "type": "string"
          },
          "country_subdivision": {
           "description": "State / province / region",
           "type": "string"
          },
          "post_code": {
           "description": "Postal / ZIP code",
           "type": "string"
          }
         },
         "required": [
          "address_line_1",
          "city",
          "post_code",
          "country_code"
         ],
         "type": "object"
        },
        "vat_identifier": {
         "description": "VAT identification number",
         "type": "string"
        }
       },
       "required": [
        "name",
        "postal_address",
        "contact"
       ],
       "type": "object"
      },
      "totals": {
       "additionalProperties": false,
       "properties": {
        "amount_due_for_payment": {
         "description": "Amount due for payment",
         "type": "number"
        },
        "invoice_total_without_vat": {
         "type": "number"
        },
        "paid_amount": {
         "description": "Amount already paid",
         "type": "number"
        },
        "rounding_amount": {
         "type": "number"
        },
        "sum_of_allowances": {
         "type": "number"
        },
        "sum_of_charges": {
         "type": "number"
        },
        "total_amount_with_vat": {
         "description": "Sum of all line items with VAT",
         "type": "number"
        },
        "total_amount_without_vat": {
         "description": "Sum of all line items without VAT",
         "type": "number"
        },
        "total_vat_amount": {
         "description": "Total VAT amount",
         "type": "number"
        }
       },
       "required": [
        "total_amount_without_vat",
        "total_amount_with_vat",
        "total_vat_amount",
        "amount_due_for_payment",
        "paid_amount"
       ],
       "type": "object"
      }
     },
     "required": [
      "invoice_number",
      "invoice_date",
      "invoice_currency_code",
      "invoice_type",
      "seller",
      "buyer",
      "payment_information",
      "totals",
      "items",
      "invoice_description"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "output_path": {
    "description": "File path to save the .xlsx file",
    "type": "string"
   }
  },
  "required": [
   "invoices",
   "output_path"
  ],
  "type": "object"
 },
 "name": "invapi_convert_json_to_xlsx",
 "title": "Convert Invoices to Excel"
}
