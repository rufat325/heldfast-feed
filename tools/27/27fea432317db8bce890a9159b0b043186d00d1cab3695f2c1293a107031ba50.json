{
 "description": "Poll a transaction about every 15 seconds until confirmed or reverted, reusing returned next-check state. Costs $0.003 USDC on Base via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "network": {
    "enum": [
     "base",
     "ethereum"
    ],
    "type": "string"
   },
   "previous_state_hash": {
    "pattern": "^[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "tx_hash": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   }
  },
  "required": [
   "tx_hash"
  ],
  "type": "object"
 },
 "name": "watch_transaction"
}
