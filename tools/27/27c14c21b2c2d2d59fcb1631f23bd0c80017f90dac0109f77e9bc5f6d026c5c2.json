{
 "description": "Gestiona propuestas. Acciones: list, get (id), create (soporta template_id y proposal_items), update (id, soporta content), delete (id), items (id), add_item (id, title, description, quantity, unit_type, rate, total), comments (id), update_status (id, status), download_pdf (id, descarga el PDF generado).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "delete",
     "items",
     "add_item",
     "comments",
     "update_status",
     "download_pdf"
    ],
    "type": "string"
   },
   "amount": {
    "type": "number"
   },
   "client_id": {
    "type": "number"
   },
   "content": {
    "description": "HTML del cuerpo de la propuesta (para update o post-template)",
    "type": "string"
   },
   "custom_fields": {
    "items": {
     "properties": {
      "custom_field_id": {
       "type": "number"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "custom_field_id",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "Descripci\u00f3n del item (para add_item)",
    "type": "string"
   },
   "discount_amount": {
    "type": "number"
   },
   "discount_percentage": {
    "type": "number"
   },
   "discount_type": {
    "type": "string"
   },
   "end_date": {
    "type": "string"
   },
   "id": {
    "type": "number"
   },
   "labels": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "proposal_date": {
    "type": "string"
   },
   "proposal_items": {
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "rate": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "total": {
       "type": "number"
      },
      "unit_type": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "quantity": {
    "description": "Cantidad (para add_item)",
    "type": "number"
   },
   "rate": {
    "description": "Valor unitario (para add_item)",
    "type": "number"
   },
   "search": {
    "type": "string"
   },
   "start_date": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "status_id": {
    "type": "string"
   },
   "tax_id": {
    "type": "number"
   },
   "tax_id2": {
    "type": "number"
   },
   "template_id": {
    "description": "ID del template a aplicar (solo en action=create/update)",
    "type": "number"
   },
   "title": {
    "description": "T\u00edtulo del item (para add_item)",
    "type": "string"
   },
   "total": {
    "description": "Total (para add_item)",
    "type": "number"
   },
   "unit_type": {
    "description": "Tipo de unidad (para add_item)",
    "type": "string"
   },
   "valid_until": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "proposals"
}
