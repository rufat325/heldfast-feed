{
 "description": "Measure TCP-level latency to a specific port on a target from multiple global regions. More reliable than ICMP ping for hosts that block ICMP.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "port": {
    "description": "Port number to TCP ping (e.g., 443)",
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "target": {
    "description": "Hostname or IP to test (e.g., \"example.com\")",
    "type": "string"
   }
  },
  "required": [
   "target",
   "port"
  ],
  "type": "object"
 },
 "name": "tcp_ping"
}
