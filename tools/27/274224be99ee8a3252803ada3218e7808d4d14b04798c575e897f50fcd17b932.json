{
 "annotations": {},
 "description": "Send custom JSON monitoring data to Cloud Insight for user-defined metrics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Array of data entries to send",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dimensions": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Dimension key-value pairs identifying the resource",
       "type": "object"
      },
      "metrics": {
       "description": "Array of metric data points",
       "items": {
        "additionalProperties": false,
        "properties": {
         "metricGroupId": {
          "description": "Metric group ID",
          "type": "string"
         },
         "metricGroupItemId": {
          "description": "Metric group item ID",
          "type": "string"
         },
         "timestamp": {
          "description": "Timestamp in Unix epoch milliseconds (default: current time)",
          "type": "number"
         },
         "value": {
          "description": "Metric value",
          "type": "number"
         }
        },
        "required": [
         "metricGroupId",
         "metricGroupItemId",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "dimensions",
      "metrics"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key) for the custom schema",
    "type": "string"
   }
  },
  "required": [
   "prodKey",
   "data"
  ],
  "type": "object"
 },
 "name": "ncloud_send_monitoring_data"
}
