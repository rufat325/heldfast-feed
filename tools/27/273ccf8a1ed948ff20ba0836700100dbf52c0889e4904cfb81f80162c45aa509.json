{
 "description": "VAT calculator for EU-27 + UK: net\u2192gross or gross\u2192net at standard or reduced rate. Includes rates table snapshot date. Paid per call: $0.002 in USDC via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "minimum": 0,
    "type": "number"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2, e.g. DE, FR, GB",
    "type": "string"
   },
   "direction": {
    "description": "default net_to_gross",
    "enum": [
     "net_to_gross",
     "gross_to_net"
    ],
    "type": "string"
   },
   "rate": {
    "description": "default standard",
    "enum": [
     "standard",
     "reduced"
    ],
    "type": "string"
   }
  },
  "required": [
   "amount",
   "country"
  ],
  "type": "object"
 },
 "name": "vat"
}
