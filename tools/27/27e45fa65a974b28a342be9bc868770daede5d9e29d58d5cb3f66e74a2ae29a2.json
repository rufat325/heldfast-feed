{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "permission": "none",
  "readOnlyHint": true
 },
 "description": "Read human comments on a market (newest first, read-only): comment body + timestamps, the commenter wallet, their black-box reputation tier, and the position they held plus the market prices frozen when they wrote it (shares per outcome, avg entry, prices at write) \u2014 position- and reputation-tagged sentiment for trade decisions.",
 "inputSchema": {
  "$defs": {
   "EvmAddress": {
    "description": "Checksummed or lowercase 20-byte EVM address (0x + 40 hex).",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "properties": {
   "address": {
    "$ref": "#/$defs/EvmAddress",
    "description": "Market contract address."
   },
   "cursor": {
    "description": "nextCursor from a prior call.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "problee_list_market_comments",
 "outputSchema": {
  "$defs": {
   "CommentPositionSnapshot": {
    "additionalProperties": false,
    "properties": {
     "avgEntry": {
      "additionalProperties": false,
      "properties": {
       "outcome1": {
        "type": [
         "number",
         "null"
        ]
       },
       "outcome2": {
        "type": [
         "number",
         "null"
        ]
       },
       "outcome3": {
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "outcome1",
       "outcome2"
      ],
      "type": "object"
     },
     "capturedAt": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "collateralDecimals": {
      "maximum": 36,
      "minimum": 0,
      "type": "integer"
     },
     "outcome1Shares": {
      "$ref": "#/$defs/WeiString"
     },
     "outcome2Shares": {
      "$ref": "#/$defs/WeiString"
     },
     "outcome3Shares": {
      "$ref": "#/$defs/WeiString"
     },
     "prices": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "outcome1": {
          "type": "number"
         },
         "outcome2": {
          "type": "number"
         },
         "outcome3": {
          "type": "number"
         },
         "pricingTimestampMs": {
          "anyOf": [
           {
            "maximum": 9007199254740991,
            "minimum": -9007199254740991,
            "type": "integer"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "outcome1",
         "outcome2",
         "pricingTimestampMs"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "v": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "v",
     "capturedAt",
     "collateralDecimals",
     "outcome1Shares",
     "outcome2Shares",
     "outcome3Shares",
     "avgEntry",
     "prices"
    ],
    "type": "object"
   },
   "DiscoverMarketCommentsResponse": {
    "additionalProperties": false,
    "properties": {
     "comments": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "authorReputationTier": {
         "anyOf": [
          {
           "$ref": "#/$defs/ReputationTier"
          },
          {
           "type": "null"
          }
         ]
        },
        "content": {
         "type": "string"
        },
        "createdAt": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "id": {
         "type": "string"
        },
        "positionSnapshot": {
         "anyOf": [
          {
           "$ref": "#/$defs/CommentPositionSnapshot"
          },
          {
           "type": "null"
          }
         ]
        },
        "reactionCount": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "replies": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "authorReputationTier": {
            "anyOf": [
             {
              "$ref": "#/$defs/ReputationTier"
             },
             {
              "type": "null"
             }
            ]
           },
           "content": {
            "type": "string"
           },
           "createdAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
           },
           "id": {
            "type": "string"
           },
           "positionSnapshot": {
            "anyOf": [
             {
              "$ref": "#/$defs/CommentPositionSnapshot"
             },
             {
              "type": "null"
             }
            ]
           },
           "updatedAt": {
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
            "type": "string"
           },
           "walletAddress": {
            "$ref": "#/$defs/EvmAddress"
           }
          },
          "required": [
           "id",
           "walletAddress",
           "content",
           "createdAt",
           "updatedAt",
           "authorReputationTier",
           "positionSnapshot"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "replyCount": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "updatedAt": {
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
         "type": "string"
        },
        "walletAddress": {
         "$ref": "#/$defs/EvmAddress"
        }
       },
       "required": [
        "id",
        "walletAddress",
        "content",
        "createdAt",
        "updatedAt",
        "authorReputationTier",
        "positionSnapshot",
        "reactionCount",
        "replyCount",
        "replies"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "hasMore": {
      "type": "boolean"
     },
     "nextCursor": {
      "type": [
       "string",
       "null"
      ]
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "comments",
     "nextCursor",
     "hasMore"
    ],
    "type": "object"
   },
   "EvmAddress": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "ReputationTier": {
    "enum": [
     "banned",
     "new",
     "established",
     "trusted",
     "expert",
     "legend"
    ],
    "type": "string"
   },
   "WeiString": {
    "pattern": "^\\d+$",
    "type": "string"
   }
  },
  "additionalProperties": false,
  "properties": {
   "result": {
    "$ref": "#/$defs/DiscoverMarketCommentsResponse"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
 "title": "Position- and reputation-tagged human comments on a market (read-only)"
}
