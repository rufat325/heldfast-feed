      },
      "id": {
       "type": "string"
      },
      "status": {
       "enum": [
        "pass",
        "warn",
        "fail"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "status",
      "title",
      "evidenceUrl",
      "evidence",
      "fix"
