{
 "description": "Send a chat message during a concert. Returns your message, recent messages from others, and ambient social context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "message": {
    "description": "Chat message",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "description": "Concert slug",
    "type": "string"
   },
   "stream_time": {
    "description": "Stream position when chatting",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "slug",
   "message"
  ],
  "type": "object"
 },
 "name": "chat"
}
