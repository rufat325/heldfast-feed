{
 "description": "Create a draft order that can be reviewed and edited on the Probo platform before being submitted. Same as placeOrder but saved as draft instead of submitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "description": "Delivery address",
    "properties": {
     "address_addition": {
      "description": "House number addition",
      "type": "string"
     },
     "address_city": {
      "description": "City",
      "type": "string"
     },
     "address_company_name": {
      "description": "Company name (required by Probo API)",
      "type": "string"
     },
     "address_country": {
      "description": "Country code (ISO 3166-1 alpha-2)",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "address_email": {
      "description": "Email address",
      "format": "email",
      "type": "string"
     },
     "address_first_name": {
      "description": "First name",
      "type": "string"
     },
     "address_house_number": {
      "description": "House number",
      "type": [
       "string",
       "number"
      ]
     },
     "address_last_name": {
      "description": "Last name",
      "type": "string"
     },
     "address_postal_code": {
      "description": "Postal code",
      "type": "string"
     },
     "address_street": {
      "description": "Street name",
      "type": "string"
     },
     "address_telephone_number": {
      "description": "Phone number",
      "type": "string"
     }
    },
    "required": [
     "address_company_name",
     "address_first_name",
     "address_street",
     "address_postal_code",
     "address_city",
     "address_country"
    ],
    "type": "object"
   },
   "configuration": {
    "additionalProperties": false,
    "description": "Products to include in the draft",
    "properties": {
     "language": {
      "description": "Language code (ISO 639-1)",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "products": {
      "description": "Products to order",
      "items": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "code": {
           "description": "Probo product code",
           "minLength": 2,
           "type": "string"
          },
          "files": {
           "description": "Product files",
           "items": {
            "additionalProperties": false,
            "description": "Product file",
            "properties": {
             "amount": {
              "description": "Times to print",
              "minimum": 1,
              "type": "number"
             },
             "fill": {
              "description": "Fill canvas",
              "type": "boolean"
             },
             "fill_even": {
              "description": "Fill proportionally",
              "type": "boolean"
             },
             "id": {
              "description": "External file ID",
              "minimum": 1,
              "type": "number"
             },
             "mirror": {
              "description": "Mirror image",
              "type": "boolean"
             },
             "page": {
              "description": "Page number",
              "minimum": 1,
              "type": "number"
             },
             "rotation": {
              "description": "Rotation in degrees",
              "enum": [
               0,
               90,
               180,
               270
              ],
              "type": "number"
             },
             "side": {
              "description": "Print side",
              "enum": [
               "front",
               "back"
              ],
              "type": "string"
             },
             "tiling": {
              "description": "Tiling mode",
              "enum": [
               "none",
               "horizontal",
               "vertical"
              ],
              "type": "string"
             },
             "uri": {
              "description": "URL to print file (.pdf, .jpg, .png)",
              "type": "string"
             }
            },
            "type": "object"
           },
           "type": "array"
          },
          "id": {
           "description": "Product ID",
           "type": [
            "number",
            "string"
           ]
          },
          "options": {
           "description": "Product options",
           "items": {
            "additionalProperties": false,
            "description": "Product configuration option",
            "properties": {
             "code": {
              "description": "Option code",
              "type": "string"
             },
             "value": {
              "description": "Option value",
              "type": [
               "string",
               "number",
               "boolean"
              ]
             }
            },
            "required": [
             "code"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "reference": {
           "description": "Product reference",
           "maxLength": 255,
           "type": "string"
          },
          "uploader": {
           "description": "Use uploader after submitting",
           "type": "boolean"
          },
          "uploaders": {
           "description": "Product uploaders",
           "items": {
            "additionalProperties": false,
            "description": "Product uploader",
            "properties": {
             "external_id": {
              "description": "External uploader ID",
              "type": "number"
             },
             "id": {
              "description": "Uploader ID",
              "type": "number"
             }
            },
            "required": [
             "id",
             "external_id"
            ],
            "type": "object"
           },
           "type": "array"
          }
         },
         "required": [
          "code"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "customer_code": {
           "description": "Customer API product code",
           "minLength": 2,
           "type": "string"
          },
          "files": {
           "description": "Product files",
           "items": {
            "$ref": "#/properties/configuration/properties/products/items/anyOf/0/properties/files/items"
           },
           "type": "array"
          },
          "id": {
           "description": "Product ID",
           "type": [
            "number",
            "string"
           ]
          },
          "options": {
           "description": "Product options",
           "items": {
            "$ref": "#/properties/configuration/properties/products/items/anyOf/0/properties/options/items"
           },
           "type": "array"
          },
          "reference": {
           "description": "Product reference",
           "maxLength": 255,
           "type": "string"
          },
          "uploader": {
           "description": "Use uploader after submitting",
           "type": "boolean"
          },
          "uploaders": {
           "description": "Product uploaders",
           "items": {
            "$ref": "#/properties/configuration/properties/products/items/anyOf/0/properties/uploaders/items"
           },
           "type": "array"
          }
         },
         "required": [
          "customer_code"
         ],
         "type": "object"
        }
       ],
       "description": "Order product (by Probo code or customer code)"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "required": [
     "products"
    ],
    "type": "object"
   },
   "contactEmail": {
    "description": "Contact email",
    "format": "email",
    "type": "string"
   },
   "id": {
    "description": "Unique draft ID",
    "pattern": "^[\\w-]+$",
    "type": "string"
   },
   "language": {
    "description": "ISO 639-1 language code",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "reference": {
    "description": "Your order reference",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "reference",
   "configuration",
   "address"
  ],
  "type": "object"
 },
 "name": "createDraft"
}
