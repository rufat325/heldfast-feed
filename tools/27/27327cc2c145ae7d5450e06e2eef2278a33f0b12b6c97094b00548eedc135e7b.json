 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare products"
 },
 "description": "Use this to compare two to four teas.co.uk products side by side, for example on strength, caffeine, price per cup, pack size or brewing. ids takes product ids from find_products; product links work too. A repeated id counts once. Ids that are not recognised are listed in not_found and the rest are still compared. Fewer than two recognised products returns an error. Search first if you only have names. For everything about one product use get_product.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "ids": {
    "description": "Two to four product ids from find_products.",
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "compare_products",
