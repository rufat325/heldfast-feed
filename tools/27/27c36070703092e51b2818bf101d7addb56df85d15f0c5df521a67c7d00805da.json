{
 "description": "Core memory operations: read, write, info, allocate, free, protect, map",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "read",
        "type": "string"
       },
       "address": {
        "description": "Hex string or expression",
        "type": "string"
       },
       "size": {
        "default": "256",
        "description": "Size in bytes (decimal)",
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "write",
        "type": "string"
       },
       "address": {
        "description": "Hex string or expression",
        "type": "string"
       },
       "bytes": {
        "description": "Hex bytes (e.g. '90 90' or 'CC')",
        "type": "string"
       },
       "verify": {
        "default": false,
        "description": "Verify write success",
        "type": "boolean"
       }
      },
      "required": [
       "action",
       "address",
       "bytes"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "info",
        "type": "string"
       },
       "address": {
        "description": "Address to query page info",
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "is_valid",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "is_code",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "allocate",
        "type": "string"
       },
       "size": {
        "default": "0x1000",
        "description": "Size in hex",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "free",
        "type": "string"
       },
       "address": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "address"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "protect",
        "type": "string"
       },
       "address": {
        "type": "string"
       },
       "protection": {
        "description": "E.g. 'PAGE_EXECUTE_READWRITE'",
        "type": "string"
       },
       "size": {
        "default": "0x1000",
        "type": "string"
       }
      },
      "required": [
       "action",
       "address",
       "protection"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "map",
        "type": "string"
       },
       "address": {
        "description": "Return region info for address, or full map if omitted",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "update_map",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_memory"
}
