{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/html.feeds",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Discover up to 50 RSS, Atom and JSON Feed links declared in supplied HTML. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "baseUrl": {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     "html": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "html"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "html_feeds",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "feeds": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "title": {
       "type": "string"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "url",
      "type",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "feeds",
   "truncated"
  ],
  "type": "object"
 }
}
