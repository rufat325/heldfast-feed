{
 "description": "Get detailed information about a specific tender",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fullRaw": {
    "default": false,
    "description": "Include the complete unmodified API response as JSON at the end of the output. Verbose \u2014 only enable when the structured fields are insufficient.",
    "type": "boolean"
   },
   "lang": {
    "default": "en",
    "description": "Preferred language",
    "enum": [
     "de",
     "fr",
     "it",
     "en"
    ],
    "type": "string"
   },
   "projectId": {
    "description": "Project ID (UUID)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "publicationId": {
    "description": "Publication ID (UUID)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "publicationId"
  ],
  "type": "object"
 },
 "name": "get_tender_details"
}
