{
 "description": "Build an X (Twitter) advanced search URL from structured filters. Returns a clickable URL using X's official advanced search operators (from:, since:, until:, min_faves:, lang:, filter:media etc).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "excludeReplies": {
    "default": false,
    "description": "-filter:replies \u2014 exclude replies",
    "type": "boolean"
   },
   "excludeRetweets": {
    "default": false,
    "description": "-filter:retweets \u2014 exclude reposts",
    "type": "boolean"
   },
   "from": {
    "description": "Posts from a specific username (no @)",
    "type": "string"
   },
   "lang": {
    "description": "ISO 639-1 language code (e.g. 'en', 'es', 'tr')",
    "type": "string"
   },
   "mediaFilter": {
    "description": "Media type filter",
    "enum": [
     "any",
     "videos",
     "native_video",
     "images",
     "links"
    ],
    "type": "string"
   },
   "mentions": {
    "description": "Posts mentioning a username (no @)",
    "type": "string"
   },
   "minBookmarks": {
    "description": "Minimum bookmarks (the strongest save signal in 2026)",
    "minimum": 0,
    "type": "integer"
   },
   "minFaves": {
    "description": "Minimum likes",
    "minimum": 0,
    "type": "integer"
   },
   "minReplies": {
    "description": "Minimum replies",
    "minimum": 0,
    "type": "integer"
   },
   "minRetweets": {
    "description": "Minimum reposts",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free-text keywords (e.g. 'AI agents')",
    "type": "string"
   },
   "sinceDate": {
    "description": "YYYY-MM-DD lower bound (inclusive)",
    "type": "string"
   },
   "sortMode": {
    "default": "top",
    "description": "'top' (relevance) or 'live' (recent)",
    "enum": [
     "top",
     "live"
    ],
    "type": "string"
   },
   "to": {
    "description": "Posts replying to a specific username (no @)",
    "type": "string"
   },
   "untilDate": {
    "description": "YYYY-MM-DD upper bound (inclusive)",
    "type": "string"
   },
   "verifiedOnly": {
    "default": false,
    "description": "filter:verified \u2014 verified accounts only",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "build_x_search_url"
}
