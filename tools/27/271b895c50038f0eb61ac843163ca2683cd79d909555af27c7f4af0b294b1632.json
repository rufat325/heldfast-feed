{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find Meeting Time"
 },
 "description": "Find slots when multiple agents are free across Chronary calendars and any human calendars authorized for each agent. This tool is fail-closed: always inspect `availability_state` and `warnings` before using slots. Accepts `agents`/`start`/`end` or their aliases.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agent_ids": {
    "description": "Alias for `agents` (matches REST/scheduling-proposal naming).",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "agents": {
    "description": "Array of agent IDs to find common free time for. All agents must be free during the returned slots. Alias: agent_ids.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "calendars": {
    "description": "Additional shared calendar IDs to treat as busy",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "duration": {
    "description": "Requested slot length (15m/30m/45m/1h/2h). Preferred over the deprecated slot_duration. Defaults to 30m.",
    "enum": [
     "15m",
     "30m",
     "45m",
     "1h",
     "2h"
    ],
    "type": "string"
   },
   "end": {
    "description": "Search range end (ISO 8601). Alias: end_time.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "end_time": {
    "description": "Alias for `end` (matches REST events naming).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "include_busy": {
    "default": false,
    "description": "Include per-agent busy blocks in response",
    "type": "boolean"
   },
   "slot_duration": {
    "description": "Deprecated alias for `duration` \u2014 minimum slot length. Prefer `duration`.",
    "enum": [
     "15m",
     "30m",
     "45m",
     "1h",
     "2h"
    ],
    "type": "string"
   },
   "start": {
    "description": "Search range start (ISO 8601). Alias: start_time.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "start_time": {
    "description": "Alias for `start` (matches REST events naming).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_meeting_time"
}
