{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Upload a JPEG, PNG, GIF, or WebP image to DeepSeek and return a reusable `file_id`. Supply base64 image data directly; server-local file paths are intentionally not accepted. Optional expiry is 3,600 to 2,592,000 seconds.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "expires_after_seconds": {
    "maximum": 2592000,
    "minimum": 3600,
    "type": "integer"
   },
   "file_data": {
    "type": "string"
   },
   "filename": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "filename",
   "file_data"
  ],
  "type": "object"
 },
 "name": "upload_file",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "bytes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "created_at": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "error_type": {
    "enum": [
     "deepseek_api_error",
     "tool_execution_error"
    ],
    "type": "string"
   },
   "expires_at": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "filename": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "object": {
    "const": "file",
    "type": "string"
   },
   "purpose": {
    "const": "user_data",
    "type": "string"
   },
   "retryable": {
    "type": "boolean"
   },
   "status": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "suggestion": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
