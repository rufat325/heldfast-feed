{
 "description": "Return the append-only activity log for an engagement, plus a Markdown rendering.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "engagementId"
  ],
  "type": "object"
 },
 "name": "get_activity_log",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "events": {
    "items": {},
    "type": "array"
   },
   "markdown": {
    "type": "string"
   }
  },
  "required": [
   "count",
   "markdown",
   "events"
  ],
  "type": "object"
 },
 "title": "Get the activity log"
}
