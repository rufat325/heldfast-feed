{
 "description": "Japanese payment terms (shimebi/shiharaibi) calculator, e.g. month-end close paid end of next month; shifts to the previous/next business day on weekends/holidays. Price: $0.01 USDC via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adjust": {
    "description": "Shift when not a business day; default previous",
    "enum": [
     "previous",
     "next",
     "none"
    ],
    "type": "string"
   },
   "calendar": {
    "description": "national (default): weekends + national holidays. bank: also Dec 31 - Jan 3 bank holidays",
    "enum": [
     "national",
     "bank"
    ],
    "type": "string"
   },
   "closing": {
    "anyOf": [
     {
      "maximum": 31,
      "minimum": 1,
      "type": "integer"
     },
     {
      "const": "end",
      "type": "string"
     }
    ],
    "description": "Closing day of month (1-31) or 'end'"
   },
   "date": {
    "description": "Transaction or invoice date (YYYY-MM-DD)",
    "type": "string"
   },
   "monthOffset": {
    "description": "Months after closing; default 1 (next month)",
    "maximum": 3,
    "minimum": 0,
    "type": "integer"
   },
   "payDay": {
    "anyOf": [
     {
      "$ref": "#/properties/closing/anyOf/0"
     },
     {
      "$ref": "#/properties/closing/anyOf/1"
     }
    ],
    "description": "Payment day of month (1-31) or 'end'"
   }
  },
  "required": [
   "date",
   "closing",
   "payDay"
  ],
  "type": "object"
 },
 "name": "payment_due_date"
}
