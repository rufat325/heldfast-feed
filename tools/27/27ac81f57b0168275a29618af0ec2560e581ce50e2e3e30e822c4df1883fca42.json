{
 "description": "Call a Home Assistant service (e.g. turn on a light, lock a door, send a notification)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "description": "Service data (e.g. {brightness: 255, color_name: 'blue'})",
    "type": "object"
   },
   "domain": {
    "description": "Service domain (e.g. 'light', 'switch', 'notify', 'automation')",
    "type": "string"
   },
   "service": {
    "description": "Service name (e.g. 'turn_on', 'turn_off', 'toggle', 'trigger')",
    "type": "string"
   },
   "target": {
    "additionalProperties": {},
    "description": "Target entities/areas/devices. Example: {entity_id: 'light.living_room'} or {area_id: 'living_room'}",
    "type": "object"
   }
  },
  "required": [
   "domain",
   "service"
  ],
  "type": "object"
 },
 "name": "ha_call_service"
}
