{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Edit storyboard clips using 1-based numbers from huasheng_list_clips. applied=false is not a failure: track action.operation.id with huasheng_wait_for_action. For redub, follow next_call to apply the existing recording; never restart generation. Undo via huasheng_list_project_versions.",
 "inputSchema": {
  "additionalProperties": false,
  "allOf": [
   {
    "if": {
     "properties": {
      "action": {
       "enum": [
        "edit"
       ]
      }
     }
    },
    "then": {
     "anyOf": [
      {
       "required": [
        "text"
       ]
      },
      {
       "properties": {
        "target": {
         "required": [
          "readings"
         ]
        }
       },
       "required": [
        "target"
       ]
      }
     ],
     "properties": {
      "operation_id": false,
      "target": {
       "additionalProperties": false,
       "properties": {
        "readings": {
         "type": "array"
        }
       },
       "required": [],
       "type": "object"
      }
     },
     "required": [
      "clip"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "action": {
       "enum": [
        "add"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "clip": false,
      "operation_id": false,
      "target": {
       "additionalProperties": false,
       "not": {
        "required": [
         "before",
         "after"
        ]
       },
       "properties": {
        "after": {
         "minimum": 1,
         "type": "integer"
        },
        "before": {
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [],
       "type": "object"
      }
     },
     "required": [
      "text"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "action": {
       "enum": [
        "remove",
        "retry",
        "restore_dub",
        "cancel_dub"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "operation_id": false,
      "target": false,
      "text": false
     },
     "required": [
      "clip"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "action": {
       "enum": [
        "split"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "operation_id": false,
      "target": {
       "additionalProperties": false,
       "properties": {
        "line": {
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "line"
       ],
       "type": "object"
      },
      "text": false
     },
     "required": [
      "clip",
      "target"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "action": {
       "enum": [
        "merge"
       ]
      }
     }
    },
    "then": {
     "properties": {
      "operation_id": false,
      "target": {
       "additionalProperties": false,
       "properties": {
        "into": {
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "into"
       ],
       "type": "object"
      },
      "text": false
     },
     "required": [
      "clip",
      "target"
     ]
    }
   },
   {
    "if": {
     "properties": {
      "action": {
       "enum": [
        "redub"
       ]
      }
     }
    },
    "then": {
     "anyOf": [
      {
       "properties": {
        "operation_id": false
       },
       "required": [
        "clip"
       ]
      },
      {
       "properties": {
        "clip": false,
        "expected_revision": false,
        "text": false
       },
       "required": [
        "operation_id"
       ]
      }
     ],
     "properties": {
      "target": false
     }
    }
   }
  ],
  "properties": {
   "action": {
    "description": "The reversible storyboard operation to perform",
    "enum": [
     "edit",
     "add",
     "remove",
     "split",
     "merge",
     "retry",
     "redub",
     "restore_dub",
     "cancel_dub"
    ],
    "type": "string"
   },
   "client_action_id": {
    "description": "MCP App only: submission id; reuse for the same click. Models omit.",
    "type": "string"
   },
   "clip": {
    "description": "The main clip, counting from 1. Omit for add; use target for insertion",
    "minimum": 1,
    "type": "integer"
   },
   "expected_revision": {
    "description": "Reject if the clip has changed since this revision.",
    "minimum": 0,
    "type": "integer"
   },
   "operation_id": {
    "description": "For redub only: continue the existing recording, without generating it again. Omit clip, text and expected_revision.",
    "type": "string"
   },
   "pid": {
    "description": "The 15-digit video id; no default.",
    "type": "integer"
   },
   "target": {
    "additionalProperties": false,
    "description": "For add: {before: n} or {after: n}; for split: {line: n}; for merge: {into: n}; for edit: {readings: [{text, say}]} sets how specific words are read (pinyin or homophones, at most 3x the word's length). Omit readings to keep the ones already on the clip (they follow the words into the new text); an empty readings array removes them all",
    "properties": {
     "after": {
      "minimum": 1,
      "type": "integer"
     },
     "before": {
      "minimum": 1,
      "type": "integer"
     },
     "into": {
      "minimum": 1,
      "type": "integer"
     },
     "line": {
      "minimum": 1,
      "type": "integer"
     },
     "readings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "say": {
         "description": "How to read it",
         "type": "string"
        },
        "text": {
         "description": "The word exactly as it appears in the narration",
         "type": "string"
        }
       },
       "required": [
        "text",
        "say"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "text": {
    "description": "Narration for edit/add, or optional pronunciation text for redub. For edit it may be omitted when only target.readings change",
    "type": "string"
   },
   "ui_lang": {
    "description": "MCP App only: follow-up language. Models omit.",
    "type": "string"
   }
  },
  "required": [
   "pid",
   "action"
  ],
  "type": "object"
 },
 "name": "huasheng_edit_clip",
 "outputSchema": {
  "properties": {
   "action": {
    "properties": {
     "accepted": {
      "type": "boolean"
     },
     "action_id": {
      "type": "string"
     },
     "client_action_id": {
      "description": "App-supplied id; repeats reuse the first result",
      "type": "string"
     },
     "entity": {
      "properties": {
       "id": {
        "type": "string"
       },
       "snapshot": {
        "type": "object"
       },
       "type": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "id"
      ],
      "type": "object"
     },
     "error": {
      "properties": {
       "code": {
        "type": "string"
       },
       "retryable": {
        "type": "boolean"
       },
       "suggested_action": {
        "type": "string"
       }
      },
      "required": [
       "code",
       "retryable"
      ],
      "type": "object"
     },
     "followup": {
      "properties": {
       "prompt": {
        "type": "string"
       },
       "required": {
        "description": "Deprecated; always false",
        "type": "boolean"
       }
      },
      "required": [
       "required"
      ],
      "type": "object"
     },
     "kind": {
      "description": "e.g. footage.replace",
      "type": "string"
     },
     "next_call": {
      "properties": {
       "arguments": {
        "type": "object"
       },
       "tool": {
        "type": "string"
       }
      },
      "required": [
       "tool",
       "arguments"
      ],
      "type": "object"
     },
     "operation": {
      "properties": {
       "id": {
        "description": "Pass to huasheng_wait_for_action",
        "type": "string"
       },
       "poll_after_ms": {
        "type": "integer"
       },
       "progress": {
        "type": "number"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     "phase": {
      "enum": [
       "ACCEPTED",
       "PROCESSING",
       "SUCCEEDED",
       "FAILED",
       "CANCELLED",
       "STALE"
      ],
      "type": "string"
     },
     "pid": {
      "type": "integer"
     },
     "revision": {
      "type": "integer"
     },
     "summary": {
      "type": "string"
     },
     "terminal": {
      "type": "boolean"
     }
    },
    "required": [
     "action_id",
     "pid",
     "kind",
     "phase",
     "accepted",
     "terminal",
     "summary",
     "followup"
    ],
    "type": "object"
   },
   "answered": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "applied": {
    "description": "Whether the change has landed. If false, track action.operation.id and follow action.next_call when present",
    "type": "boolean"
   },
   "can_be": {
    "description": "When only reading: what it accepts",
    "type": "string"
   },
   "clip": {
    "description": "Which clip was changed",
    "type": "integer"
   },
   "current": {
    "description": "When only reading: the current value",
    "type": "string"
   },
   "label": {
    "description": "Human-readable name of the changed setting",
    "type": "string"
   },
   "note": {
    "description": "What to do next, in plain words",
    "type": "string"
   },
   "options": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "outcome": {
    "enum": [
     "started",
     "queued",
     "busy"
    ],
    "type": "string"
   },
   "pid": {
    "description": "The 15-digit video id",
    "type": "integer"
   },
   "run_id": {
    "type": "string"
   },
   "selected": {
    "properties": {
     "id": {
      "type": "string"
     },
     "position": {
      "type": "integer"
     },
     "type": {
      "enum": [
       "clip",
       "motion"
      ],
      "type": "string"
     }
    },
    "required": [
     "type",
     "position",
     "id"
    ],
    "type": "object"
   },
   "setting": {
    "type": "string"
   },
   "url": {
    "description": "Link to the video in Huasheng",
    "type": "string"
   },
   "value": {
    "type": "string"
   }
  },
  "required": [
   "pid",
   "url"
  ],
  "type": "object"
 },
 "title": "Edit the storyboard"
}
