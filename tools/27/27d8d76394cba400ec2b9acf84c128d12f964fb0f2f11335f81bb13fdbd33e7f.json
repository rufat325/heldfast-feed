{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Records one statement line by hand, for an installation without a bank feed. `amount` is signed: positive is money in. It books nothing \u2014 the line waits as pending until a payment is recorded.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Signed: positive is money in, negative is money out.",
    "type": [
     "string",
     "number"
    ]
   },
   "bank_account_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "company_id": {
    "description": "The company to work in. Ask list_companies if unsure.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "contact_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "counterpart_iban": {
    "minLength": 1,
    "type": "string"
   },
   "counterpart_name": {
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "reference": {
    "minLength": 1,
    "type": "string"
   },
   "statement_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "structured_reference": {
    "description": "A structured communication, e.g. +++000/0000/00000+++ or RF\u2026",
    "minLength": 1,
    "type": "string"
   },
   "transaction_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "value_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "company_id",
   "bank_account_id",
   "transaction_date",
   "amount"
  ],
  "type": "object"
 },
 "name": "create_bank_transaction",
 "title": "Add a bank transaction"
}
