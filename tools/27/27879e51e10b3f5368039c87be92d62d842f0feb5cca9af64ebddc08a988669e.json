{
 "description": "Translate one bounded, caller-supplied Materials Project elasticity API response projection into source-bound computed-crystal reference evidence. Optional retrieval metadata binds the raw upstream bytes separately and records that an allowlisted projection changed the representation. The adapter verifies response shape, one exact material ID, non-deprecated successful state, modulus bounds, Poisson consistency, source versions, and record license; derives an isotropic VRH Young's modulus deterministically; and preserves warnings. It performs no network call, does not verify Materials Project origin, and grants no engineering-product, simulation-input, supplier, order, payment, or fabrication authority.",
 "inputSchema": {
  "$id": "https://a2a2p.com/schema/materials-project-elasticity",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Translate one bounded caller-supplied Materials Project elasticity response projection into computed-crystal reference evidence. Optional caller retrieval metadata binds the raw upstream digest separately. The public adapter performs no upstream network request.",
  "properties": {
   "material_id": {
    "pattern": "^mp-[A-Za-z0-9]+$",
    "type": "string"
   },
   "refresh_after": {
    "format": "date-time",
    "type": "string"
   },
   "response": {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "builder_meta": {
         "additionalProperties": false,
         "properties": {
          "batch_id": {
           "maxLength": 200,
           "type": [
            "string",
            "null"
           ]
          },
          "build_date": {
           "format": "date-time",
           "type": [
            "string",
            "null"
           ]
          },
          "database_version": {
           "minLength": 1,
           "type": "string"
          },
          "emmet_version": {
           "minLength": 1,
           "type": "string"
          },
          "license": {
           "enum": [
            "BY-C",
            "BY-NC"
           ]
          },
          "pymatgen_version": {
           "minLength": 1,
           "type": "string"
          },
          "run_id": {
           "maxLength": 200,
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "emmet_version",
          "pymatgen_version",
          "run_id",
          "batch_id",
          "database_version",
          "build_date",
          "license"
         ],
         "type": "object"
        },
        "bulk_modulus": {
         "additionalProperties": false,
         "properties": {
          "reuss": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "voigt": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "vrh": {
           "exclusiveMinimum": 0,
           "type": "number"
          }
         },
         "required": [
          "voigt",
          "reuss",
          "vrh"
         ],
         "type": "object"
        },
        "deprecated": {
         "const": false
        },
        "deprecation_reasons": {
         "maxItems": 0,
         "type": [
          "array",
          "null"
         ]
        },
        "fitting_method": {
         "maxLength": 1000,
         "minLength": 1,
         "type": "string"
        },
        "formula_pretty": {
         "minLength": 1,
         "type": "string"
        },
        "homogeneous_poisson": {
         "exclusiveMaximum": 0.5,
         "exclusiveMinimum": -1,
         "type": "number"
        },
        "last_updated": {
         "format": "date-time",
         "type": "string"
        },
        "material_id": {
         "pattern": "^mp-[A-Za-z0-9]+$",
         "type": "string"
        },
        "shear_modulus": {
         "additionalProperties": false,
         "properties": {
          "reuss": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "voigt": {
           "exclusiveMinimum": 0,
           "type": "number"
          },
          "vrh": {
           "exclusiveMinimum": 0,
           "type": "number"
          }
         },
         "required": [
          "voigt",
          "reuss",
          "vrh"
         ],
         "type": "object"
        },
        "state": {
         "const": "successful"
        },
        "universal_anisotropy": {
         "minimum": 0,
         "type": "number"
        },
        "warnings": {
         "items": {
          "maxLength": 1000,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 100,
         "type": "array"
        }
       },
       "required": [
        "builder_meta",
        "material_id",
        "formula_pretty",
        "deprecated",
        "deprecation_reasons",
        "last_updated",
        "warnings",
        "bulk_modulus",
        "shear_modulus",
        "universal_anisotropy",
        "homogeneous_poisson",
        "fitting_method",
        "state"
       ],
       "type": "object"
      },
      "maxItems": 1,
      "minItems": 1,
      "type": "array"
     },
     "errors": {
      "oneOf": [
       {
        "type": "null"
       },
       {
        "maxItems": 0,
        "type": "array"
       }
      ]
     },
     "meta": {
      "additionalProperties": false,
      "properties": {
       "api_version": {
        "minLength": 1,
        "type": "string"
       },
       "time_stamp": {
        "format": "date-time",
        "type": "string"
       },
       "total_doc": {
        "const": 1
       }
      },
      "required": [
       "api_version",
       "time_stamp",
       "total_doc"
      ],
      "type": "object"
     }
    },
    "required": [
     "data",
     "errors",
     "meta"
    ],
    "type": "object"
   },
   "retrieval": {
    "oneOf": [
     {
      "type": "null"
     },
     {
      "additionalProperties": false,
      "properties": {
       "client_contract": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "projection": {
        "additionalProperties": false,
        "properties": {
         "changes_indicated": {
          "const": true
         },
         "document_fields": {
          "const": [
           "builder_meta",
           "material_id",
           "formula_pretty",
           "deprecated",
           "deprecation_reasons",
           "last_updated",
           "warnings",
           "bulk_modulus",
           "shear_modulus",
           "universal_anisotropy",
           "homogeneous_poisson",
           "fitting_method",
           "state"
          ]
         },
         "response_meta_fields": {
          "const": [
           "api_version",
           "time_stamp",
           "total_doc"
          ]
         }
        },
        "required": [
         "document_fields",
         "response_meta_fields",
         "changes_indicated"
        ],
        "type": "object"
       },
       "raw_response_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "source_url": {
        "format": "uri",
        "pattern": "^https://api\\.materialsproject\\.org/materials/elasticity/\\?",
        "type": "string"
       }
      },
      "required": [
       "client_contract",
       "source_url",
       "raw_response_sha256",
       "projection"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "material_id",
   "response",
   "retrieval",
   "refresh_after"
  ],
  "title": "a2a2p Materials Project elasticity adapter",
  "type": "object"
 },
 "name": "translate_materials_project_elasticity",
 "outputSchema": {
  "type": "object"
 }
}
