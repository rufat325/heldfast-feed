{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Validate cart"},"description":"Check a cart before quoting: every item is checked against the shop catalogue (exists, available, current price, required and valid options) and all problems are returned at once, with the price per item. With fulfillment, date and time (and address for delivery) the time, address and minimum order are checked too. Saves nothing.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"address":{"description":"For delivery","properties":{"city":{"maxLength":60,"minLength":2,"type":"string"},"postal_code":{"maxLength":10,"minLength":3,"type":"string"},"street":{"description":"Street and number","maxLength":120,"minLength":2,"type":"string"}},"required":["street","postal_code","city"],"type":"object"},"date":{"description":"YYYY-MM-DD (from available_times)","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"fulfillment":{"enum":["pickup","delivery"],"type":"string"},"items":{"items":{"properties":{"options":{"description":"Answers to the product's options from get_menu (option_id + choice_id, option_id + text, or option_id + choices for choose_many). Required options must be answered; ask the customer, never pick for them.","items":{"anyOf":[{"additionalProperties":false,"properties":{"choice_id":{"description":"choice_id from get_menu","maxLength":32,"minLength":1,"type":"string"},"option_id":{"maxLength":32,"minLength":1,"type":"string"}},"required":["option_id","choice_id"],"type":"object"},{"additionalProperties":false,"properties":{"option_id":{"maxLength":32,"minLength":1,"type":"string"},"text":{"description":"The customer's own words, e.g. \"uden l\u00f8g\"","maxLength":500,"type":"string"}},"required":["option_id","text"],"type":"object"},{"additionalProperties":false,"properties":{"choices":{"description":"choose_many: the chosen choices; the total 