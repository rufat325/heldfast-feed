{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use for evidence-first manual process analysis of a specific recurring workflow before automation or AI: handoffs, approval delays, ownership stalls, rework, duplicate entry, exceptions or evidence gaps. Produces a diagnosis from user-supplied facts only: strongest-current-baseline status, owner/authority readiness, evidence availability, next-episode measurements, falsification rule, and the smallest defensible next step. It deliberately does not estimate savings or claim feasibility.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assay_id": {
    "enum": [
     "handoff_approval_loop",
     "exception_rework_loop",
     "evidence_closeout_gap",
     "duplicate_entry_reconciliation",
     "ownership_dispatch_stall"
    ],
    "type": "string"
   },
   "consequence": {
    "maxLength": 1600,
    "minLength": 1,
    "type": "string"
   },
   "current_approach": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "current_systems": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "evidence_state": {
    "default": "unknown",
    "enum": [
     "sanitized_available",
     "likely_available",
     "unknown",
     "not_available"
    ],
    "type": "string"
   },
   "failure_modes": {
    "items": {
     "enum": [
      "handoff_delay",
      "approval_delay",
      "rework",
      "exception_chasing",
      "duplicate_entry",
      "unclear_ownership",
      "evidence_gap",
      "other"
     ],
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "metric_already_tracked": {
    "maxLength": 500,
    "type": "string"
   },
   "next_occurrence": {
    "maxLength": 500,
    "type": "string"
   },
   "recurrence": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "responsible_owner": {
    "default": "unknown",
    "enum": [
     "identified",
     "can_involve",
     "unknown"
    ],
    "type": "string"
   },
   "strongest_baseline_status": {
    "default": "unknown",
    "enum": [
     "not_checked",
     "checked_cannot_resolve",
     "checked_can_resolve",
     "current_manual_process_is_baseline",
     "unknown"
    ],
    "type": "string"
   },
   "workflow": {
    "maxLength": 2400,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "diagnose_workflow_bottleneck",
 "title": "Diagnose a recurring workflow bottleneck before automation"
}
