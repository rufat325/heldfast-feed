{
 "description": "Assign taxonomy terms to a post. Terms can be IDs, slugs or names; slugs/names that match no term are skipped silently.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "append": {
    "description": "Append to existing terms instead of replacing them (default false)",
    "type": "boolean"
   },
   "post_id": {
    "description": "Post ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "taxonomy": {
    "description": "Taxonomy name (e.g. category, post_tag, product_cat)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "terms": {
    "description": "Term IDs, slugs or names (an empty array with append false removes all terms)",
    "items": {
     "anyOf": [
      {
       "type": "integer"
      },
      {
       "type": "string"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "site",
   "post_id",
   "taxonomy",
   "terms"
  ],
  "type": "object"
 },
 "name": "mcp_assign_terms"
}
