{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a Menlo quote form link"
 },
 "description": "Returns the website quote form link for a published formId. Does not create or submit an application or read private quotes.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "formId": {
    "pattern": "^[a-z][a-z0-9-]{0,60}$",
    "type": "string"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "es"
    ],
    "type": "string"
   }
  },
  "required": [
   "formId"
  ],
  "type": "object"
 },
 "name": "get_quote_link",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "nextStep": {
    "type": "string"
   },
   "product": {
    "additionalProperties": false,
    "properties": {
     "availableStates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "formId": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "quoteUrl": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "formId",
     "label",
     "quoteUrl",
     "availableStates"
    ],
    "type": "object"
   }
  },
  "required": [
   "product",
   "nextStep"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Get a Menlo quote form link"
}
