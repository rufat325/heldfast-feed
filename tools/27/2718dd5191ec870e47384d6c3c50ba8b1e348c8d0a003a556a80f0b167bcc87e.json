{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search species by free text in any of eight languages or by scientific name, with optional category, habitat and ISO country filters. Ranked by iNaturalist observations. One page of card-sized records.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "enum": [
     "mammals",
     "birds",
     "reptiles",
     "amphibians",
     "fish",
     "insects",
     "other"
    ],
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2.",
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "habitat": {
    "enum": [
     "forest",
     "grassland",
     "freshwater",
     "sea",
     "mountains",
     "urban",
     "farm",
     "zoo",
     "savanna",
     "jungle",
     "arctic",
     "desert"
    ],
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Display language.",
    "enum": [
     "en",
     "de",
     "es",
     "fr",
     "it",
     "nl",
     "pt",
     "pl"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "per": {
    "default": 20,
    "maximum": 120,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Free text, for example `red fox` or `Vulpes`.",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_animals",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "description": "Card-sized animal taxon used by list and search answers.",
     "properties": {
      "categoryId": {
       "enum": [
        "mammals",
        "birds",
        "reptiles",
        "amphibians",
        "fish",
        "insects",
        "other"
       ],
       "type": "string"
      },
      "habitats": {
       "items": {
        "enum": [
         "forest",
         "grassland",
         "freshwater",
         "sea",
         "mountains",
         "urban",
         "farm",
         "zoo",
         "savanna",
         "jungle",
         "arctic",
         "desert"
        ],
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "description": "Slug of the animal taxon, for example `red-fox`.",
       "examples": [
        "red-fox"
       ],
       "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
       "type": "string"
      },
      "image": {
       "properties": {
        "url": {
         "format": "uri",
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "name": {
       "description": "Name in the requested language, English when none exists.",
       "type": "string"
      },
      "nameEn": {
       "description": "English common name.",
       "type": "string"
      },
      "nameSci": {
       "description": "Scientific name.",
       "examples": [
        "Vulpes vulpes"
       ],
       "type": "string"
      },
      "parentNameSci": {
       "description": "Parent species scientific name for a subspecies. Null for species.",
       "type": [
        "string",
        "null"
       ]
      },
      "sourceUrl": {
       "format": "uri",
       "type": "string"
      },
      "taxonRank": {
       "default": "species",
       "description": "Taxonomic rank. Legacy records default to species.",
       "type": "string"
      },
      "tickable": {
       "description": "Whether a new checklist sighting is allowed.",
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "name",
      "nameEn",
      "nameSci",
      "categoryId",
      "habitats",
      "image"
     ],
     "title": "AnimalSummary",
     "type": "object"
    },
    "type": "array"
   },
   "page": {
    "type": "integer"
   },
   "per": {
    "type": "integer"
   },
   "total": {
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "page",
   "per"
  ],
  "type": "object"
 },
 "title": "Search animals"
}
