{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add job manually"
 },
 "description": "Adds a job to the account's private pipeline using title, company and optional description, URL, contact email and application method. No application is submitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicationMethod": {
    "enum": [
     "email",
     "web",
     "api",
     "unknown"
    ],
    "type": "string"
   },
   "company": {
    "description": "Company name",
    "type": "string"
   },
   "contactEmail": {
    "format": "email",
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "title": {
    "description": "Job title",
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "title",
   "company"
  ],
  "type": "object"
 },
 "name": "add_jobs",
 "title": "Add job manually"
}
