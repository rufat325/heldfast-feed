{
 "description": "Aggregated time statistics per activity type for a date range. Returns overall totals plus per-DAY/WEEK/MONTH buckets.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date yyyy-MM-dd (use with `to`)",
    "type": "string"
   },
   "group_by": {
    "description": "Bucket size for the periods breakdown (default DAY)",
    "enum": [
     "DAY",
     "WEEK",
     "MONTH"
    ],
    "type": "string"
   },
   "period": {
    "description": "Named period; alternative to explicit from/to",
    "enum": [
     "today",
     "yesterday",
     "this_week",
     "last_week",
     "this_month",
     "last_month",
     "last_7_days",
     "last_30_days"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Filter to these tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timezone": {
    "description": "IANA timezone (default: user's timezone)",
    "type": "string"
   },
   "to": {
    "description": "End date yyyy-MM-dd, inclusive",
    "type": "string"
   },
   "type_ids": {
    "description": "Filter to these exact activity type ids (internal \u2014 never show ids to the user)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type_names": {
    "description": "Filter to these activity type names (groups allowed)",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "time_report"
}
