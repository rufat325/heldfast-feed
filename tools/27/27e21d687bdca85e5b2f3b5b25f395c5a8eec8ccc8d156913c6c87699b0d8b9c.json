{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List tracked keywords"
 },
 "description": "Use this when someone asks which keywords they track for an app, or before adding or deleting one. Returns each tracked keyword's id, search term, language, country and bid, up to 500 per call. Not for current rankings or search volume.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "description": "Keywords to return, from 1 to 500; omit for all tracked keywords, capped at 500",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "skip": {
    "description": "Keywords to skip before the first one returned, for paging; defaults to 0",
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "appId"
  ],
  "type": "object"
 },
 "name": "list_keywords",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keywords": {
    "description": "Tracked keywords for the app, at most 500 per call",
    "items": {
     "additionalProperties": false,
     "properties": {
      "bid": {
       "anyOf": [
        {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Bid amount stored for the keyword; null when none is set"
      },
      "country": {
       "anyOf": [
        {
         "maxLength": 10,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "language": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "term": {
       "$ref": "#/properties/keywords/items/properties/id"
      }
     },
     "required": [
      "id",
      "term",
      "language",
      "country",
      "bid"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "offset": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "returned": {
    "maximum": 500,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   },
   "truncated": {
    "description": "True when more than 500 keywords matched; page with skip",
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "keywords",
   "offset",
   "returned",
   "truncated"
  ],
  "type": "object"
 },
 "title": "List tracked keywords"
}
