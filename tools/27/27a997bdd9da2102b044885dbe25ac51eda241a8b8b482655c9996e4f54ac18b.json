{
 "description": "Cancels a checkout.\n\nPrices in the response are integers in the currency's ISO 4217 minor units, paired with\na currency code: {\"amount\": 600, \"currency\": \"USD\"} is $6.00 and {\"amount\": 2500,\n\"currency\": \"USD\"} is $25.00. Convert to major units before quoting a price to a buyer\n(divide by 100 for two-decimal currencies such as USD and EUR; zero-decimal currencies\nsuch as JPY are already whole units).\n\n",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "The ID of the checkout to update. Format: 'gid://shopify/Checkout/abc123'",
    "type": "string"
   },
   "meta": {
    "description": "Metadata for UCP agent profile discovery.",
    "properties": {
     "ucp-agent": {
      "properties": {
       "profile": {
        "description": "Agent profile URI for UCP discovery.",
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "profile"
      ],
      "type": "object"
     }
    },
    "required": [
     "ucp-agent"
    ],
    "type": "object"
   }
  },
  "required": [
   "meta",
   "id"
  ],
  "type": "object"
 },
