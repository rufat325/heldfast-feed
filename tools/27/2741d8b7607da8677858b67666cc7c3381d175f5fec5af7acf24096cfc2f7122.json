 "description": "Use this when a user gives their SSC (matric), HSSC Part-I (FSc first year) and entry test (ECAT/TCAT) marks and wants their UET Taxila merit aggregate, eligibility, or which programs they might get. Applies the official 17% SSC + 50% HSSC Part-I + 33% entry test formula. Ask for any missing marks; never guess them. BS Mathematics and BS Physics have no entry test and use 30% SSC + 70% HSSC Part-I (basicSciencesAggregate); for those alone, pass 0 entry test marks if the user took no test. Do not use it for other universities' formulas.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entryTestMarks": {
    "description": "Entry test (ECAT or TCAT) marks obtained.",
    "minimum": 0,
    "type": "number"
   },
   "entryTestTotal": {
    "default": 400,
    "description": "Entry test total marks, 400 for ECAT.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "hafizOrNcc": {
    "default": false,
    "description": "True only if the user says they are Hafiz-e-Quran or hold an NCC certificate (+20 HSSC marks for merit only, not for eligibility).",
    "type": "boolean"
   },
   "hsscMarks": {
    "description": "HSSC Part-I (FSc first year) marks obtained.",
    "minimum": 0,
    "type": "number"
   },
   "hsscTotal": {
    "default": 550,
    "description": "HSSC Part-I total marks, usually 550.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sscMarks": {
    "description": "SSC (matric) marks obtained.",
    "minimum": 0,
    "type": "number"
   },
   "sscTotal": {
    "default": 1100,
    "description": "SSC total marks, usually 1100 (1200 on some boards).",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "sscMarks",
   "hsscMarks",
   "entryTestMarks"
  ],
  "type": "object"
 },
 "name": "calculate_merit_aggregate",
