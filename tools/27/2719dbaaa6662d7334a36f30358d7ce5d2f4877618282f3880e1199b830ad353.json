{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Estimates what a market order on Ripio Trade would cost or return right now: unit price for that size, gross value, your taker fee and the total. Read-only: nothing is executed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Amount in the base currency, e.g. \"100\" to buy 100 USDT on USDT_ARS.",
    "pattern": "^(?=.*[1-9])\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "pair": {
    "description": "Ripio Trade pair, e.g. USDT_ARS.",
    "pattern": "^[A-Za-z0-9]{2,12}_[A-Za-z0-9]{2,12}$",
    "type": "string"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   }
  },
  "required": [
   "pair",
   "side",
   "amount"
  ],
  "type": "object"
 },
 "name": "ripio_estimate_trade",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "type": "string"
   },
   "estimated_fee": {
    "type": "string"
   },
   "estimated_total": {
    "type": "string"
   },
   "estimated_unit_price": {
    "type": "string"
   },
   "gross_value": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "pair": {
    "type": "string"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "taker_fee_pct": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "pair",
   "side",
   "amount",
   "estimated_unit_price",
   "gross_value",
   "estimated_total",
   "note",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Estimate a Ripio Trade order"
}
