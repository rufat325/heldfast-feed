{"_meta":{"ui":{"resourceUri":"ui://iwac/charts.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Find similar items"},"description":"Nearest stored embeddings by cosine similarity. Articles and documents lead with the dataset's published top 10. Scores run high (unrelated ~0.7) and rank reading candidates; >= 0.97 suggests a near-duplicate, but no threshold proves a reprint. Returns source IDs and dates. Corpus-wide candidate generation belongs offline.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"id":{"description":"Item id \u2014 either a bare o:id ('3064') or the namespaced form search returns ('articles:3064')","type":"string"},"limit":{"description":"Neighbours returned (default 12, max 50)","type":"integer"},"min_score":{"description":"Minimum cosine similarity (-1 to 1)","maximum":1,"minimum":-1,"type":"number"},"subset":{"description":"articles (default) | documents | publications | references","type":"string"}},"required":["id"],"type":"object"},"name":"get_similar_items","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"neighbours":{"items":{"additionalProperties":{},"properties":{},"type":"object"},"type":"array"},"neighbours_source":{"type":"string"},"note":{"type":"string"},"source":{"additionalProperties":{},"properties":{},"type":"object"},"stored_count":{"type":"number"},"subset":{"type":"string"},"view":{"type":"string"}},"required":["view","subset","source","neighbours","neighbours_source","stored_count","note"],"type":"object"},"title":"Find similar items"}
