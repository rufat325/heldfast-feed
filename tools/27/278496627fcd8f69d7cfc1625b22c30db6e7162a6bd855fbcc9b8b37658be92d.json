{"_meta":{"openai/outputTemplate":"ui://berrys/media-gallery-v4.html","openai/toolInvocation/invoked":"Media request processed","openai/toolInvocation/invoking":"Preparing media request","openai/widgetAccessible":false,"ui":{"resourceUri":"ui://berrys/media-gallery-v4.html","visibility":["model"]}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Generate images, videos and audio as new nodes"},"description":"Batch-generate 1\u201320 images, videos or audio tracks in one request. Each image/video item becomes a new node, with its prompt Text node and wired referenceNodeIds; each audio item becomes an audio node holding its words (prompt), modelId (default minimax:speech-2.8-hd), voice or style. Write each image/video prompt yourself from the references, following the model's prompt guide (quotes return promptGuides); never paste the user's request into it. Nodes are placed in free space in one revision-checked canvas edit, then run like playground_node_run. quote: true validates references, saves a ten-minute quoteId, prices every item and changes no canvas nodes; execution requires that quoteId (canvas:read). Otherwise it needs media:spend; every paid request returns approval_required for the user to confirm in their agent chat. A retried idempotencyKey never creates or charges twice.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"expectedRevision":{"description":"Current canvas revision from canvas_read; on revision_conflict, read again and rebuild the change.","maximum":9007199254740991,"minimum":0,"type":"integer"},"idempotencyKey":{"description":"Unique key for this request; reuse only when retrying the identical request after a lost response. Use a new key after quoting or changing inputs.","maxLength":200,"minLength":1,"type":"string"},"items":{"items":{"properties":{"aspectRatio":{"description":"Output width-to-height ratio supported by the selected model, such as 1:1 or 9:16.","maxLength":30,"type":"string"},"duration":{"description":"Requested video duration in seconds, supported by the selected model. Video seconds (default 5).","maximum":15,"minimum":2,"type":"integer"},"kind":{"description":"Media type to create or import, selected from the supported values.","enum":["image","video","audio"],"type":"string"},"modelId":{"description":"Canonical model ID returned by model discovery or resolution; preserve the user\u2019s selected model. Accepts canonical IDs or common model names; ambiguous names return suggestions. Omit only when the user did not choose a model. Defaults: images google:nano-banana-2; videos bytedance:seedance-2.0-mini.","maxLength":120,"minLength":1,"type":"string"},"prompt":{"description":"Complete creative instructions for this output; describe the subject, composition and requested result. Image/video: the prompt. Audio: the words to speak (speech) or the lyrics (music).","maxLength":4000,"minLength":1,"type":"string"},"referenceNodeIds":{"default":[],"description":"Existing canvas image or media node IDs to use as visual references for this output. Existing image nodes wired into the new node as references (image/video only).","items":{"maxLength":150,"minLength":1,"type":"string"},"maxItems":3,"type":"array"},"style":{"description":"Style direction for the generated audio, such as tone, delivery or musical mood. Audio music models only: genre, mood, instruments, tempo.","maxLength":1000,"minLength":1,"type":"string"},"title":{"description":"Human-readable label to display for this item in Playground.","maxLength":120,"minLength":1,"type":"string"},"voice":{"description":"Voice identifier supported by the selected speech model. Audio speech models only: a MiniMax voice id (default English_Trustworth_Man).","maxLength":120,"minLength":1,"type":"string"}},"required":["kind","prompt"],"type":"object"},"maxItems":20,"minItems":1,"type":"array"},"projectId":{"description":"ID of the Playground pro