(?:02)-(?:0[1-9]|1\\d|2[0-8])))$","type":"string"},{"type":"null"}]},"work_mode":{"enum":["onsite","home_office_possible","remote"],"type":"string"}},"required":["job_id","title","company_name","logo_url","location_label","work_mode","categories","job_types","employment_types","salary_stated_by_employer","salary_estimate","posted_at","application_deadline","excerpt","excerpt_is_untrusted","apply_route","url","description_text","description_truncated","skills","benefits","valid_through","public_sector"],"type":"object"},"postings_series_id":{"const":"jobjump_job_postings","description":"Provenance entry of the postings in this response.","type":"string"},"provenance":{"items":{"additionalProperties":false,"properties":{"as_of":{"description":"Vintage or reference period as published: 'YYYY', 'YYYY-MM' or an ISO date.","maxLength":20,"type":"string"},"basis":{"description":"Whether amounts are gross, net, or not a money amount.","enum":["gross","net","not_applicable"],"type":"string"},"dataset":{"description":"Name of the dataset, e.g. 'Entgeltatlas' or 'JobJump salary aggregate'.","maxLength":160,"type":"string"},"estimated":{"description":"True when JobJump modelled or derived the value rather than observing or receiving it.","type":"boolean"},"geography":{"description":"Geographic coverage, e.g. 'Germany' or 'Kreis 05315 (K\u00f6ln)'.","maxLength":120,"type":"string"},"label":{"description":"Short English name of what this series measures.","maxLength":160,"type":"string"},"license":{"description":"Licence or terms of use that apply to redistributing this series.","maxLength":200,"type":"string"},"methodology_url":{"anyOf":[{"format":"uri","type":"string"},{"type":"null"}],"description":"Public page describing how the series is produced, or null."},"population":{"description":"Who or what is counted, e.g. 'full-time employees subject to social insurance'.","maxLength":200,"type":"string"},"publisher":{"description":"Who produced the underlying figures.","enum":["jo