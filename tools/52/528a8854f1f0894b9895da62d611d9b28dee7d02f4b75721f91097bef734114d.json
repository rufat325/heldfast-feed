{
 "description": "View your GitLab todo queue (notifications requiring action). Actions: list (filter by state, action type, target type). Todos are auto-created for assignments, mentions, reviews, and pipeline failures. Related: manage_todos to mark done/restore.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Action to perform: list",
    "enum": [
     "list"
    ],
    "type": "string"
   },
   "author_id": {
    "description": "Filter by author ID.",
    "type": "number"
   },
   "group_id": {
    "description": "Filter by group ID.",
    "type": "number"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 20,
    "description": "Number of items per page (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "project_id": {
    "description": "Filter by project ID.",
    "type": "number"
   },
   "state": {
    "description": "Filter todos by state: pending=active, done=completed.",
    "enum": [
     "pending",
     "done"
    ],
    "type": "string"
   },
   "todo_action": {
    "description": "Filter by action type.",
    "enum": [
     "assigned",
     "mentioned",
     "build_failed",
     "marked",
     "approval_required",
     "unmergeable",
     "directly_addressed",
     "merge_train_removed",
     "review_requested",
     "member_access_requested",
     "review_submitted"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by target type.",
    "enum": [
     "Issue",
     "MergeRequest",
     "Commit",
     "Epic",
     "DesignManagement::Design",
     "AlertManagement::Alert"
    ],
    "type": "string"
   }
  },
  "required": [
   "action",
   "per_page"
  ],
  "type": "object"
 },
 "name": "browse_todos"
}
