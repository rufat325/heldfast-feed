{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search UX & product-design jobs"
 },
 "description": "Search live UX, product-design, UX-research, content-design and design-leadership roles on jobs.uxjobs.io. Filter by keywords, location/country, remote, seniority, discipline, company, posted salary and recency. Returns a page of compact results (newest first, keyword relevance when a query is given) plus the total match count.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "company": {
    "description": "Company name (substring match).",
    "maxLength": 80,
    "type": "string"
   },
   "country": {
    "description": "ISO-3166 alpha-2 country code, e.g. \"US\", \"GB\", \"DE\".",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "employment_type": {
    "description": "e.g. \"Full-time\", \"Contract\", \"Part-time\", \"Intern\".",
    "maxLength": 30,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Results per page (1\u201350).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "City/state/country text to match in the posted location, e.g. \"London\", \"New York\", \"Germany\". Use \"remote\" for remote roles.",
    "maxLength": 80,
    "type": "string"
   },
   "min_salary_usd": {
    "description": "Only roles whose posted annual USD salary range reaches at least this figure. Roles that post no USD range never match, and most roles post none.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Skip this many results (for paging).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "posted_within_days": {
    "description": "Only roles posted in the last N days (1\u201360).",
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Keywords matched against title, company, location and description, e.g. \"senior product designer fintech\". All words must match.",
    "maxLength": 200,
    "type": "string"
   },
   "remote": {
    "description": "true = only fully-remote roles; false = exclude remote roles.",
    "type": "boolean"
   },
   "remote_from": {
    "description": "Remote roles open to candidates in this region (implies remote). Roles open \"Anywhere\" match every region; roles that only say \"Remote\" with no region are not matched. Same rules as the Remote-from filter on jobs.uxjobs.io.",
    "enum": [
     "Anywhere",
     "Latin America",
     "US & Canada",
     "Europe, Middle East & Africa",
     "Asia-Pacific"
    ],
    "type": "string"
   },
   "role_family": {
    "description": "Design discipline derived from the title.",
    "enum": [
     "Product design",
     "UX / UI",
     "Research",
     "Content / writing",
     "Design systems",
     "Service design",
     "Interaction",
     "Design lead / mgr",
     "Other design"
    ],
    "type": "string"
   },
   "seniority": {
    "description": "Seniority derived from the title.",
    "enum": [
     "Junior / Entry",
     "Mid-level",
     "Senior",
     "Lead / Staff",
     "Principal",
     "Director+"
    ],
    "type": "string"
   },
   "workplace": {
    "description": "Workplace arrangement when the employer stated one.",
    "enum": [
     "remote",
     "hybrid",
     "onsite"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_jobs",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attribution": {
    "type": "string"
   },
   "generated_at": {
    "type": "string"
   },
   "offset": {
    "type": "number"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "type": "string"
      },
      "country": {
       "type": [
        "string",
        "null"
       ]
      },
      "employment_type": {
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "type": "string"
      },
      "location": {
       "type": "string"
      },
      "posted_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "remote": {
       "type": "boolean"
      },
      "remote_from": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "salary": {
       "type": [
        "string",
        "null"
       ]
      },
      "seniority": {
       "enum": [
        "Junior / Entry",
        "Mid-level",
        "Senior",
        "Lead / Staff",
        "Principal",
        "Director+"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "workplace": {
       "anyOf": [
        {
         "enum": [
          "remote",
          "hybrid",
          "onsite"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "title",
      "company",
      "location",
      "country",
      "remote",
      "remote_from",
      "workplace",
      "seniority",
      "salary",
      "employment_type",
      "posted_at",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "returned": {
    "type": "number"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "offset",
   "returned",
   "generated_at",
   "results",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Search UX & product-design jobs"
}
