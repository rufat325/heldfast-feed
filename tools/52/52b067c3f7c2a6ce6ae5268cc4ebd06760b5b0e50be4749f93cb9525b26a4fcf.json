{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update LoS measurement"
 },
 "description": "Update an existing LoS measurement by ID. Requires los_measurements:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "actual_value": {
    "description": "Measured value",
    "type": "number"
   },
   "id": {
    "description": "LoS measurement ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "is_auto": {
    "description": "Whether this is auto-calculated",
    "type": "boolean"
   },
   "notes": {
    "description": "Notes or context",
    "maxLength": 2000,
    "type": "string"
   },
   "period_end": {
    "description": "Period end date (ISO 8601)",
    "type": "string"
   },
   "period_start": {
    "description": "Period start date (ISO 8601)",
    "type": "string"
   },
   "period_type": {
    "description": "Period type",
    "enum": [
     "monthly",
     "quarterly",
     "semi_annual",
     "annual"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_los_measurement",
 "title": "Update LoS measurement"
}
