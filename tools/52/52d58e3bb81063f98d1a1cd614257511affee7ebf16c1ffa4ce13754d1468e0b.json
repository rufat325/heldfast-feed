{
 "_meta": {
  "openai/outputTemplate": "ui://genosys/checkout-v1.html",
  "openai/toolInvocation/invoked": "Checkout ready",
  "openai/toolInvocation/invoking": "Preparing checkout\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://genosys/checkout-v1.html"
  },
  "ui/resourceUri": "ui://genosys/checkout-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Show the shopper a checkout form for these items: shade picker where needed, quantities, delivery details (name, email, phone, emirate, address), live total and a button that creates the order and opens secure Stripe payment. Use when the shopper wants to buy. Pass any details the shopper already gave as prefill.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "items": {
    "items": {
     "properties": {
      "color": {
       "maxLength": 60,
       "type": "string"
      },
      "product_id": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "maximum": 20,
       "minimum": 1,
       "type": "integer"
      },
      "size": {
       "maxLength": 40,
       "type": "string"
      }
     },
     "required": [
      "product_id"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "locale": {
    "description": "Language of descriptions and links: en (default), ru or ar. Product names stay in English.",
    "enum": [
     "en",
     "ru",
     "ar"
    ],
    "type": "string"
   },
   "prefill": {
    "properties": {
     "address": {
      "maxLength": 500,
      "type": "string"
     },
     "email": {
      "maxLength": 200,
      "type": "string"
     },
     "emirate": {
      "enum": [
       "Dubai",
       "Abu Dhabi",
       "Sharjah",
       "Ajman",
       "Ras Al Khaimah",
       "Fujairah",
       "Umm Al Quwain"
      ],
      "type": "string"
     },
     "name": {
      "maxLength": 100,
      "type": "string"
     },
     "notes": {
      "maxLength": 1000,
      "type": "string"
     },
     "phone": {
      "maxLength": 30,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "open_checkout",
 "title": "Open GENOSYS checkout"
}
