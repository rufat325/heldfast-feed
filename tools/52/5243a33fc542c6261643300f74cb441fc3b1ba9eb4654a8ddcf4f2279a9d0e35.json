{
 "description": "Parse TOML configuration files (Cargo.toml, pyproject.toml, etc.). Extract sections, list dependencies, compare versions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Action: parse, extract_section, list_deps, compare_versions",
    "enum": [
     "parse",
     "extract_section",
     "list_deps",
     "compare_versions"
    ],
    "type": "string"
   },
   "content": {
    "description": "TOML content to parse (for parse/extract_section/list_deps)",
    "type": "string"
   },
   "section": {
    "description": "Dot-separated section path (for extract_section)",
    "type": "string"
   },
   "version_a": {
    "description": "First version string (for compare_versions)",
    "type": "string"
   },
   "version_b": {
    "description": "Second version string (for compare_versions)",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "toml_parser"
}
