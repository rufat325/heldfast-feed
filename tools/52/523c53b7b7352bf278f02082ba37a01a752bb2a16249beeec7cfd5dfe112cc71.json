{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Update Customer"
 },
 "description": "Edit an existing customer (name, email, phones, address) by id or externalId. Only the fields you pass are sent. Returns {success}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address_city": {
    "description": "Updated city",
    "type": "string"
   },
   "address_region": {
    "description": "Updated region/state",
    "type": "string"
   },
   "address_text": {
    "description": "Updated full address text",
    "type": "string"
   },
   "by": {
    "default": "id",
    "description": "Lookup field",
    "enum": [
     "id",
     "externalId"
    ],
    "type": "string"
   },
   "email": {
    "description": "Updated email",
    "type": "string"
   },
   "first_name": {
    "description": "Updated first name",
    "type": "string"
   },
   "id": {
    "description": "Customer ID or externalId to edit",
    "type": "string"
   },
   "last_name": {
    "description": "Updated last name",
    "type": "string"
   },
   "patronymic": {
    "description": "Updated patronymic",
    "type": "string"
   },
   "phones": {
    "description": "Replace phone numbers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_customer"
}
