{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return a structured choice list at a selected hierarchy level. MICS exports require one codelist_id and never merge unrelated answer lists.",
 "inputSchema": {
  "properties": {
   "classification_id": {
    "title": "Classification Id",
    "type": "string"
   },
   "codelist_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Codelist Id"
   },
   "format": {
    "default": "xlsform",
    "enum": [
     "xlsform",
     "simple"
    ],
    "title": "Format",
    "type": "string"
   },
   "level": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Level"
   },
   "limit": {
    "default": 1000,
    "maximum": 10000,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   }
  },
  "required": [
   "classification_id"
  ],
  "title": "export_choice_listArguments",
  "type": "object"
 },
 "name": "export_choice_list",
 "outputSchema": {
  "properties": {
   "classification_id": {
    "title": "Classification Id",
    "type": "string"
   },
   "codelist_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Codelist Id"
   },
   "codelist_title": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Codelist Title"
   },
   "format": {
    "title": "Format",
    "type": "string"
   },
   "level": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "title": "Level"
   },
   "option_count": {
    "title": "Option Count",
    "type": "integer"
   },
   "rows": {
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "title": "Rows",
    "type": "array"
   },
   "warning": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Warning"
   }
  },
  "required": [
   "classification_id",
   "option_count",
   "level",
   "format",
   "rows"
  ],
  "title": "ChoiceListResponse",
  "type": "object"
 },
 "title": "Export a choice list"
}
