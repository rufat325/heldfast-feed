{
 "description": "Find functions, classes, types, and other symbols by name or pattern in an indexed codebase.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "directory": {
    "description": "Absolute path to the indexed project",
    "type": "string"
   },
   "kind": {
    "description": "Filter by symbol kind",
    "enum": [
     "function",
     "class",
     "method",
     "interface",
     "type",
     "enum",
     "variable"
    ],
    "type": "string"
   },
   "maxResults": {
    "default": 20,
    "description": "Maximum results to return",
    "type": "number"
   },
   "query": {
    "description": "Symbol name or pattern to search for",
    "type": "string"
   }
  },
  "required": [
   "directory",
   "query"
  ],
  "type": "object"
 },
 "name": "search_symbols"
}
