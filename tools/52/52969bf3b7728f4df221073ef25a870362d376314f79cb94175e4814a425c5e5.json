{
 "description": "Update a line item on a storyline \u2014 select/deselect, retitle, change description, targetDate, or config. Pass only the fields to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "config": {
    "additionalProperties": {},
    "description": "Replacement channel/type-specific configuration",
    "type": "object"
   },
   "description": {
    "description": "New description for the line item",
    "type": "string"
   },
   "itemId": {
    "description": "Line item ID from storyline_get_strategy",
    "type": "string"
   },
   "selected": {
    "description": "Include (true) or exclude (false) this line item from execution",
    "type": "boolean"
   },
   "storylineId": {
    "description": "Storyline ID",
    "type": "string"
   },
   "targetDate": {
    "description": "New target publish date (ISO 8601)",
    "type": "string"
   },
   "title": {
    "description": "New title for the line item",
    "type": "string"
   }
  },
  "required": [
   "storylineId",
   "itemId"
  ],
  "type": "object"
 },
 "name": "storyline_update_line_item"
}
