    "maximum": 1000000,
    "minimum": 0,
    "type": "integer",
    "x-serving-bound": true
   },
   "ref": {
    "description": "Block reference: either a block NUMBER or a 0x-prefixed block HASH. Both forms are accepted and resolve to the same block.",
