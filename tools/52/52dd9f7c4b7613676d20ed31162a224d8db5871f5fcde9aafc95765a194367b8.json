{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Manage countdown timers in the active Novel. Mutating actions persist to the Novel and are audited; read-only actions do not mutate state. Revert the most recent mutation with manage_history (action: undo). set's direction shifts NPC dispositions only when scope is also set. Use when: starting, advancing, removing, or listing clocks. Do NOT use when: tracking a vow's progress \u2014 use manage_vow (action: milestone).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "set, advance, remove, or list.",
    "enum": [
     "set",
     "advance",
     "remove",
     "list"
    ],
    "type": "string"
   },
   "direction": {
    "description": "Optional direction: increment or decrement (set).",
    "type": "string"
   },
   "name": {
    "description": "Countdown name (set/advance/remove).",
    "type": "string"
   },
   "on_scene_transition": {
    "description": "When true, advance on each scene transition (set).",
    "type": "boolean"
   },
   "scope": {
    "description": "Optional scope name (set).",
    "type": "string"
   },
   "ticks": {
    "description": "Starting ticks (set).",
    "minimum": 1,
    "type": "number"
   },
   "triggers": {
    "description": "Optional world-model triggers (set).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "description": "round or narrative (set).",
    "enum": [
     "round",
     "narrative"
    ],
    "type": "string"
   },
   "world_effect": {
    "description": "Optional world-model effect applied when the countdown fires (set).",
    "properties": {
     "destination": {
      "description": "Optional destination (for exits).",
      "type": "string"
     },
     "direction": {
      "description": "Optional direction (for exits).",
      "type": "string"
     },
     "property": {
      "description": "Optional property (for property effects).",
      "type": "string"
     },
     "target": {
      "description": "The effect target.",
      "type": "string"
     },
     "type": {
      "description": "The effect kind.",
      "enum": [
       "describe",
       "property",
       "exit"
      ],
      "type": "string"
     },
     "value": {
      "description": "Optional value (for property effects).",
      "type": "string"
     }
    },
    "required": [
     "type",
     "target"
    ],
    "type": "object"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_countdown",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Machine-readable result status: OK, NEED_INPUT, WARNING, PARTIAL, or an error category (REQ-002, REQ-548c).",
    "type": "string"
   },
   "text": {
    "description": "Human-readable text envelope mirroring the structured result (REQ-001, REQ-548a).",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Countdown Manager"
}
