 "description": "Steam games similar to ONE game, ranked by imho.run's recommender (the list on that game's imho.run page), each with a one-line reason, price, Steam Deck status, year, review numbers, the imho.run page URL and the Steam URL. Use it for 'games like X', optionally only free, co-op or Steam Deck games. Use `recommend` instead when the user names 2-3 games, wants other filters (no PvP, no microtransactions, release years, niche) or describes what they want in words. Games rated for adults only (explicit sexual content) are not covered; filtering is best effort.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "coop": {
    "default": false,
    "description": "Only co-op games.",
    "type": "boolean"
   },
   "coop_mode": {
    "description": "Kind of co-op (implies coop): online co-op (Remote Play Together does not count), or local same-screen / split-screen co-op.",
    "enum": [
     "online",
     "local"
    ],
    "type": "string"
   },
   "free": {
    "default": false,
    "description": "Only free games.",
    "type": "boolean"
   },
   "game": {
    "description": "Game name (typos and Russian names are fine), Steam appid or Steam store URL.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "lang": {
    "default": "en",
    "description": "Language of the `why` lines.",
    "enum": [
     "en",
     "ru"
    ],
    "type": "string"
   },
   "n": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "steam_deck": {
    "description": "Steam Deck verified, or playable-or-better.",
    "enum": [
     "verified",
     "playable"
    ],
    "type": "string"
   }
  },
  "required": [
   "game"
  ],
  "type": "object"
 },
