{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Report a mistake or a missing election, with a URL that proves it (ideally the official authority page). The report is public and is checked like any other claim; it never changes the data by itself. Returns the report id; follow it at https://electionindex.org/corrections.",
 "inputSchema": {
  "properties": {
   "claim": {
    "description": "What is wrong and what is right, 10 to 2000 characters",
    "type": "string"
   },
   "election": {
    "description": "Election id, if the report is about a listed election",
    "type": "string"
   },
   "evidence": {
    "description": "http(s) URL of the page that proves it",
    "type": "string"
   },
   "race": {
    "description": "Race id within that election, if the report is about one race",
    "type": "string"
   }
  },
  "required": [
   "claim",
   "evidence"
  ],
  "type": "object"
 },
 "name": "submit_correction",
 "outputSchema": {
  "properties": {
   "meta": {
    "description": "What this answer was built from; cite dataset_version",
    "properties": {
     "built_at": {
      "description": "When the dataset was built",
      "type": "string"
     },
     "dataset_version": {
      "description": "Dataset version",
      "type": "string"
     },
     "docs": {
      "description": "Documentation URL",
      "type": "string"
     },
     "generated_at": {
      "description": "When this answer was generated",
      "type": "string"
     },
     "licence": {
      "description": "Licence and required credit",
      "type": "string"
     }
    },
    "required": [
     "dataset_version",
     "licence"
    ],
    "type": "object"
   },
   "result": {
    "properties": {
     "at": {
      "description": "Filed at (ISO)",
      "type": "string"
     },
     "claim": {
      "description": "The report",
      "type": "string"
     },
     "evidence": {
      "description": "Evidence URL",
      "type": "string"
     },
     "id": {
      "description": "Report id",
      "type": "string"
     },
     "status": {
      "description": "open until checked",
      "type": "string"
     },
     "url": {
      "description": "Where to follow the report",
      "type": "string"
     }
    },
    "required": [
     "id",
     "status",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "meta"
  ],
  "type": "object"
 },
 "title": "Submit a correction"
}
