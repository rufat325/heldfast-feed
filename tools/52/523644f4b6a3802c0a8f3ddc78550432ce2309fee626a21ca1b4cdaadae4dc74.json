{
 "description": "Convert a webpage URL or raw HTML to a PDF document. Supports page size, orientation, margins, and background printing. Returns PDF as base64.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "block_ads": {
    "description": "Block ads and trackers",
    "type": "boolean"
   },
   "cookies": {
    "description": "Cookies to set before capture (e.g., [{\"name\": \"session\", \"value\": \"abc123\"}])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "path": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "css": {
    "description": "Custom CSS to inject before PDF generation",
    "type": "string"
   },
   "dark_mode": {
    "description": "Enable dark mode emulation",
    "type": "boolean"
   },
   "disable_javascript": {
    "description": "Disable JavaScript execution on the page",
    "type": "boolean"
   },
   "evaluate": {
    "description": "JavaScript code to execute on the page before PDF generation (max 10KB). Runs in the browser context.",
    "type": "string"
   },
   "headers": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Custom HTTP headers to send with the request (e.g., {\"Authorization\": \"Bearer token\"})",
    "type": "object"
   },
   "html": {
    "description": "Raw HTML to convert to PDF (provide html OR url, not both)",
    "type": "string"
   },
   "ignore_https_errors": {
    "description": "Ignore HTTPS/TLS certificate errors",
    "type": "boolean"
   },
   "landscape": {
    "description": "Landscape orientation (default: false)",
    "type": "boolean"
   },
   "latitude": {
    "description": "Geolocation latitude (-90 to 90)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "locale": {
    "description": "BCP 47 locale tag for the browser context (e.g., \"en-US\")",
    "type": "string"
   },
   "longitude": {
    "description": "Geolocation longitude (-180 to 180)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "pdf_format": {
    "description": "Page size (default: A4)",
    "enum": [
     "A4",
     "A3",
     "A5",
     "Letter",
     "Legal",
     "Tabloid"
    ],
    "type": "string"
   },
   "pdf_scale": {
    "description": "Content scale 0.1-2 (default: 1)",
    "maximum": 2,
    "minimum": 0.1,
    "type": "number"
   },
   "print_background": {
    "description": "Include background colors/images (default: true)",
    "type": "boolean"
   },
   "timezone": {
    "description": "IANA timezone for the browser context (e.g., \"America/New_York\")",
    "type": "string"
   },
   "url": {
    "description": "URL to convert to PDF (provide url OR html, not both)",
    "type": "string"
   },
   "wait_until": {
    "description": "Page load strategy (default: domcontentloaded). Use \"networkidle\" for SPAs.",
    "enum": [
     "commit",
     "domcontentloaded",
     "load",
     "networkidle"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_pdf"
}
