{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Sets activation, page, blocking mode, fields and consent. A plan with lead capture is required; email is mandatory.",
 "inputSchema": {
  "$defs": {
   "LeadPatch": {
    "additionalProperties": false,
    "properties": {
     "actif": {
      "default": null,
      "title": "Actif",
      "type": "boolean"
     },
     "bloquant": {
      "default": null,
      "title": "Bloquant",
      "type": "boolean"
     },
     "champs": {
      "default": null,
      "items": {
       "enum": [
        "email",
        "nom",
        "societe",
        "telephone"
       ],
       "type": "string"
      },
      "maxItems": 4,
      "title": "Champs",
      "type": "array"
     },
     "consentement": {
      "default": null,
      "maxLength": 4000,
      "minLength": 1,
      "title": "Consentement",
      "type": "string"
     },
     "page": {
      "default": null,
      "maximum": 100000,
      "minimum": 1,
      "title": "Page",
      "type": "integer"
     }
    },
    "title": "LeadPatch",
    "type": "object"
   }
  },
  "properties": {
   "catalogue_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Catalogue Id",
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "patch": {
    "$ref": "#/$defs/LeadPatch"
   }
  },
  "required": [
   "catalogue_id",
   "patch",
   "expected_revision"
  ],
  "title": "set_lead_captureArguments",
  "type": "object"
 },
 "name": "foliade_set_lead_capture",
 "title": "Configure the lead capture form"
}
