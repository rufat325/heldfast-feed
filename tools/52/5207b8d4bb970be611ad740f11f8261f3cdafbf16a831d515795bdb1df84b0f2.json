{
 "description": "Export stored signed AI task receipts, optionally filtered by wallet.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "wallet": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "export_ai_receipts"
}
