{
 "description": "Add one node to the stored flow graph. Wire it with connect_flow_nodes, then validate_asset_flow before running.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetRef": {
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "globalRules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "type": "string"
   },
   "label": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "modelId": {
    "type": "string"
   },
   "negativeConstraints": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "palette": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "position": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y"
    ],
    "type": "object"
   },
   "provider": {
    "type": "string"
   },
   "sessionId": {
    "description": "Persisted flow session id (flow_session_\u2026) from create_asset_flow or list_asset_flows.",
    "minLength": 1,
    "type": "string"
   },
   "stageIndex": {
    "type": "number"
   },
   "stageLabel": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "storagePath": {
    "type": "string"
   },
   "strategy": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "themeStyle": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "tone": {
    "type": "string"
   },
   "type": {
    "description": "Node kind: prompt/style/reference feed a generate node; generate calls a provider; output is a display sink; frame/note are canvas annotations.",
    "enum": [
     "prompt",
     "reference",
     "style",
     "generate",
     "output",
     "frame",
     "note"
    ],
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "type"
  ],
  "type": "object"
 },
 "name": "add_flow_node"
}
