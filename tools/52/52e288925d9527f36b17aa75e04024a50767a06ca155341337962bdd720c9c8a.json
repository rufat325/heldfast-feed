      "snippet": {
       "type": "string"
      },
      "text": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "title",
      "url",
      "snippet",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "usage": {
    "description": "Measured provider usage and estimated request costs.",
    "type": "object"
   }
  },
  "required": [
   "answer",
   "sources",
   "usage"
