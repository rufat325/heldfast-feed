{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search for users in a Canvas account by name, login, or email. Use `include` to request email, last_login, avatar_url, time_zone, or uuid in the response.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "account_id": {
    "description": "The Canvas account ID",
    "type": "number"
   },
   "include": {
    "description": "Extra fields to include on each user (Canvas include[] param)",
    "items": {
     "enum": [
      "email",
      "last_login",
      "avatar_url",
      "time_zone",
      "uuid"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "order": {
    "description": "Sort order",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "search_term": {
    "description": "The search term (name, login, or email)",
    "type": "string"
   },
   "sort": {
    "description": "Sort field",
    "enum": [
     "username",
     "email",
     "sis_id",
     "integration_id",
     "last_login"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "search_term"
  ],
  "type": "object"
 },
 "name": "search_users",
 "title": "Search Users"
}
