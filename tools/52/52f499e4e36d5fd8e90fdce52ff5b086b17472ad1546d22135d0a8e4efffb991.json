{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List Supported Assets"
 },
 "description": "List supported collateral assets on Arcadia. Returns compact list (address, symbol, decimals, type). Use search to filter by symbol substring. For USD prices, use read.asset.prices.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain_id": {
    "default": 8453,
    "description": "Chain ID: 8453 (Base), 130 (Unichain), or 10 (Optimism)",
    "type": "number"
   },
   "search": {
    "description": "Filter assets by symbol (case-insensitive substring match)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "read.asset.list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {},
      "decimals": {},
      "symbol": {},
      "type": {}
     },
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "total",
   "assets"
  ],
  "type": "object"
 }
}
