{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Changes the document size without resampling layers. Layers keep their pixels and are offset according to the anchor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "anchor": {
    "default": "center",
    "enum": [
     "top-left",
     "top",
     "top-right",
     "left",
     "center",
     "right",
     "bottom-left",
     "bottom",
     "bottom-right"
    ],
    "type": "string"
   },
   "height": {
    "maximum": 30000,
    "minimum": 1,
    "type": "integer"
   },
   "path": {
    "description": "Path to the .comp project package (a directory ending in .comp)",
    "type": "string"
   },
   "width": {
    "maximum": 30000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "path",
   "width",
   "height"
  ],
  "type": "object"
 },
 "name": "resize_canvas",
 "title": "Resize canvas"
}
