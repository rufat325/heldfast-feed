{
 "description": "Return a bounded list of actionable backlinks and classify each one for protection, repair, reclaim, quality review, or outreach reference.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backlinks_status_type": {
    "default": "live",
    "enum": [
     "live",
     "all",
     "lost"
    ],
    "type": "string"
   },
   "broken_only": {
    "default": false,
    "type": "boolean"
   },
   "dofollow_only": {
    "default": false,
    "type": "boolean"
   },
   "exclude_internal_backlinks": {
    "default": true,
    "type": "boolean"
   },
   "include_indirect_links": {
    "default": true,
    "type": "boolean"
   },
   "include_subdomains": {
    "default": true,
    "type": "boolean"
   },
   "intersection_mode": {
    "default": "partial",
    "enum": [
     "all",
     "partial"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_rank": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "default": "one_per_domain",
    "enum": [
     "as_is",
     "one_per_domain",
     "one_per_anchor"
    ],
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 20000,
    "minimum": 0,
    "type": "integer"
   },
   "rank_scale": {
    "default": "one_hundred",
    "enum": [
     "one_hundred",
     "one_thousand"
    ],
    "type": "string"
   },
   "sort_by": {
    "default": "rank",
    "enum": [
     "rank",
     "page_rank",
     "first_seen",
     "lost_date"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_backlinks_list",
 "title": "AgentSEO Backlinks List"
}
