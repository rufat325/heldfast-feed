{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Private CA (Root CA or Sub CA). Requires alias, keyType, period, and x509Parameters.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alias": {
    "description": "CA name (3-15 chars, alphanumeric + '-' + '_', starts with letter)",
    "type": "string"
   },
   "altName": {
    "description": "DNS/Email SANs (domain/host name or email format)",
    "type": "string"
   },
   "caType": {
    "description": "CA type: PRIVATE_ROOT (Root CA) or PRIVATE_SUB (Intermediate CA)",
    "enum": [
     "PRIVATE_ROOT",
     "PRIVATE_SUB"
    ],
    "type": "string"
   },
   "commonName": {
    "description": "Common Name (1-64 chars)",
    "type": "string"
   },
   "country": {
    "description": "Country code (ISO 3166-1 alpha-2)",
    "type": "string"
   },
   "ip": {
    "description": "IP SANs (IP address format)",
    "type": "string"
   },
   "issuerTag": {
    "description": "Issuer CA tag value (required for PRIVATE_SUB when using internal signing)",
    "type": "string"
   },
   "keyType": {
    "description": "Key type for the CA",
    "enum": [
     "RSA2048",
     "RSA4096",
     "EC256",
     "EC521"
    ],
    "type": "string"
   },
   "locality": {
    "description": "City name (0-128 chars)",
    "type": "string"
   },
   "memo": {
    "description": "CA memo/description",
    "type": "string"
   },
   "organization": {
    "description": "Organization name (0-64 chars)",
    "type": "string"
   },
   "organizationUnit": {
    "description": "Organization unit name (0-128 chars)",
    "type": "string"
   },
   "period": {
    "description": "Validity period in days (1-3650) or 'MAX' for maximum",
    "type": "string"
   },
   "stateProvince": {
    "description": "State/Province name (0-128 chars)",
    "type": "string"
   }
  },
  "required": [
   "caType",
   "alias",
   "keyType",
   "period",
   "commonName"
  ],
  "type": "object"
 },
 "name": "ncloud_pca_create_ca"
}
