{
 "description": "Compare two text strings line-by-line and show added, removed, and unchanged lines",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "text1": {
    "description": "First (original) text",
    "type": "string"
   },
   "text2": {
    "description": "Second (modified) text",
    "type": "string"
   },
   "unified": {
    "default": true,
    "description": "If true, return unified diff format; otherwise return structured diff",
    "type": "boolean"
   }
  },
  "required": [
   "text1",
   "text2"
  ],
  "type": "object"
 },
 "name": "text_diff"
}
