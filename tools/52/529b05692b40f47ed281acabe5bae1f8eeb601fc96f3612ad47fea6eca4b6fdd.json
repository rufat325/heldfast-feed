{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the NightMarquee catalog of website and mobile app build prompts by keyword, category (hero, landing, saas, portfolio, ecommerce, 3d, mobile) or tier. Returns matching slugs, taglines and demo links to pass to nightmarquee_get_prompt.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Restrict to one section of the catalog",
    "enum": [
     "hero",
     "landing",
     "saas",
     "portfolio",
     "ecommerce",
     "3d",
     "mobile"
    ],
    "type": "string"
   },
   "limit": {
    "description": "How many matches to return, 1 to 50, default 10",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free text, matched against titles, taglines and style keywords",
    "type": "string"
   },
   "tier": {
    "description": "\"free\" needs no account; \"unlimited\" needs a signed-in Unlimited plan",
    "enum": [
     "free",
     "unlimited"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nightmarquee_search_prompts",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "error": {
    "description": "Set only when the catalog could not be reached",
    "type": "string"
   },
   "results": {
    "description": "Matches, capped at `limit`",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "demoUrl": {
       "description": "Live, scrollable build",
       "type": "string"
      },
      "slug": {
       "description": "Pass to nightmarquee_get_prompt",
       "type": "string"
      },
      "tagline": {
       "type": "string"
      },
      "tier": {
       "enum": [
        "free",
        "unlimited"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "title",
      "tagline",
      "category",
      "tier",
      "demoUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Matches before `limit` was applied",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "results"
  ],
  "type": "object"
 },
 "title": "Search NightMarquee prompts"
}
