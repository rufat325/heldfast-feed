{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Colour picker"
 },
 "description": "Given a six-digit hex colour code (with or without a leading #), return its hex, RGB and HSL values. Source: https://hopi.co.uk/colour-picker/",
 "inputSchema": {
  "properties": {
   "hex": {
    "description": "Six-digit hex colour code, e.g. #1F8A70",
    "pattern": "^#?[0-9a-fA-F]{6}$",
    "type": "string"
   }
  },
  "required": [
   "hex"
  ],
  "type": "object"
 },
 "name": "hopi_colour_picker",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "hex": {
    "type": "string"
   },
   "hsl": {
    "type": "array"
   },
   "hslString": {
    "type": "string"
   },
   "rgb": {
    "type": "array"
   },
   "rgbString": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Colour picker"
}
