{
 "description": "Update an existing appointment via PUT. Id and UtcDateTime are required. Cannot change client or practitioner.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "Id": {
    "description": "Appointment ID (required)",
    "minLength": 1,
    "type": "string"
   },
   "LocationId": {
    "description": "Location ID",
    "type": "string"
   },
   "ReminderType": {
    "description": "Reminder type",
    "type": "string"
   },
   "SendClientEmailNotification": {
    "description": "Whether to send client email notification",
    "type": "boolean"
   },
   "ServiceId": {
    "description": "Service ID",
    "type": "string"
   },
   "Status": {
    "description": "Appointment status",
    "type": "string"
   },
   "UtcDateTime": {
    "description": "New UTC date/time in Unix milliseconds (required)",
    "type": "integer"
   }
  },
  "required": [
   "Id",
   "UtcDateTime"
  ],
  "type": "object"
 },
 "name": "update_appointment"
}
