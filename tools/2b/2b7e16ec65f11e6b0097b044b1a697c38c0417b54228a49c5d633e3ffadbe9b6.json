{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Lists Docker containers with structured status, ports, and state information.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "all": {
    "default": true,
    "description": "Show all containers (default: true, includes stopped)",
    "type": "boolean"
   },
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "filter": {
    "description": "Filter by status, name, label, network (--filter)",
    "maxLength": 255,
    "type": "string"
   },
   "last": {
    "description": "Show only the N most recently created containers",
    "type": "number"
   },
   "size": {
    "default": false,
    "description": "Display total file sizes per container (default: false)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "ps",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "containers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "image": {
       "type": "string"
      },
      "labels": {
       "additionalProperties": {
        "type": "string"
       },
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "name": {
       "type": "string"
      },
      "networks": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ports": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "container": {
          "type": "number"
         },
         "host": {
          "type": "number"
         },
         "protocol": {
          "enum": [
           "tcp",
           "udp"
          ],
          "type": "string"
         }
        },
        "required": [
         "container",
         "protocol"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "state": {
       "enum": [
        "running",
        "exited",
        "paused",
        "restarting",
        "dead",
        "created",
        "removing"
       ],
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "image",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "containers"
  ],
  "type": "object"
 },
 "title": "Docker PS"
}
