{
 "description": "Update an existing campaign assignment",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "description": "Whether assignment is active",
    "type": "boolean"
   },
   "data_key_target": {
    "description": "Data Key Target ID",
    "type": "number"
   },
   "geo_target": {
    "description": "Geo Target ID",
    "type": "number"
   },
   "id": {
    "description": "Campaign assignment ID",
    "type": "number"
   },
   "keywords": {
    "description": "Comma-separated keywords",
    "type": "string"
   },
   "keywords_match_method": {
    "description": "Keyword matching method",
    "enum": [
     "required",
     "preferred",
     "filtered"
    ],
    "type": "string"
   },
   "list_target": {
    "description": "List Target ID",
    "type": "number"
   },
   "platform_target": {
    "description": "Platform Target ID",
    "type": "number"
   },
   "schedule": {
    "description": "Schedule ID",
    "type": "number"
   },
   "weight": {
    "description": "Relative delivery weight",
    "type": "number"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_campaign_assignment"
}
