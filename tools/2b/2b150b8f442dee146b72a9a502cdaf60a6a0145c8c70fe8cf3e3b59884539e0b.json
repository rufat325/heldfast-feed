{
 "description": "Level B: create a protection offer via authenticated POST /agent/protection/offer. Requires SIMA_AGENT_ACCESS_TOKEN. Does not purchase, pay, or activate certificates.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assetAddress": {
    "description": "Protected asset address.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "assetSymbol": {
    "description": "Optional asset symbol.",
    "maxLength": 32,
    "type": "string"
   },
   "assetType": {
    "description": "Protected asset type.",
    "enum": [
     "TOKEN",
     "NFT",
     "MEMECOIN",
     "NEW_LAUNCH"
    ],
    "type": "string"
   },
   "chain": {
    "description": "Wallet chain for the protection offer.",
    "enum": [
     "SOLANA",
     "ETHEREUM",
     "BASE",
     "BSC"
    ],
    "type": "string"
   },
   "protectedAmount": {
    "description": "Asset-denominated protected amount (required for PRESERVE_TRADE_SIZE).",
    "type": "string"
   },
   "purchaseMode": {
    "description": "Optional purchase mode. Defaults to PRESERVE_TRADE_SIZE when omitted.",
    "enum": [
     "PRESERVE_TRADE_SIZE",
     "WITHIN_TOTAL_BUDGET"
    ],
    "type": "string"
   },
   "totalBudget": {
    "description": "Asset-denominated total budget (required for WITHIN_TOTAL_BUDGET).",
    "type": "string"
   },
   "walletAddress": {
    "description": "Wallet address to protect.",
    "maxLength": 255,
    "minLength": 20,
    "type": "string"
   }
  },
  "required": [
   "chain",
   "walletAddress",
   "assetAddress",
   "assetType"
  ],
  "type": "object"
 },
 "name": "sima_create_protection_offer"
}
