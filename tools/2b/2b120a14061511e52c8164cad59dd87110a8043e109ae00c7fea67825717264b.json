{
 "annotations": {
  "destructiveHint": true,
  "title": "Book Shipment"
 },
 "description": "Book a quoted shipment using any quote_id or option id returned from a quote tool (Warp or market carrier). Requires quote_id + pickup and delivery addresses. Auth required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessorials": {
    "additionalProperties": false,
    "description": "Pickup/delivery accessorial services. Should match the accessorials used when quoting.",
    "properties": {
     "delivery": {
      "description": "Delivery accessorials: liftgate-delivery, residential-delivery, inside-delivery, limited-access-delivery, delivery-appointment",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "pickup": {
      "description": "Pickup accessorials: liftgate-pickup, residential-pickup, inside-pickup, limited-access-pickup, pickup-appointment",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "delivery": {
    "additionalProperties": false,
    "description": "Delivery address. Required if this lane has not been shipped before.",
    "properties": {
     "city": {
      "description": "City name",
      "type": "string"
     },
     "contactName": {
      "description": "Contact full name",
      "type": "string"
     },
     "email": {
      "description": "Email address (optional \u2014 consignee email is often unknown)",
      "type": "string"
     },
     "phone": {
      "description": "Phone number",
      "type": "string"
     },
     "specialInstruction": {
      "description": "Special instructions",
      "type": "string"
     },
     "state": {
      "description": "2-letter state code",
      "type": "string"
     },
     "street": {
      "description": "Street address",
      "type": "string"
     },
     "zipCode": {
      "description": "5-digit ZIP",
      "pattern": "^\\d{5}$",
      "type": "string"
     }
    },
    "required": [
     "zipCode",
     "city",
     "state",
     "street",
     "contactName",
     "phone"
    ],
    "type": "object"
   },
   "delivery_window": {
    "additionalProperties": false,
    "description": "Delivery time window, 24h HH:MM, e.g. { from: '09:00', to: '12:00' }. Defaults to a full business day if omitted.",
    "properties": {
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "type": "object"
   },
   "notes": {
    "description": "Special instructions for the shipment",
    "type": "string"
   },
   "pickup": {
    "additionalProperties": false,
    "description": "Pickup address. Required if no default shipper is saved on your account.",
    "properties": {
     "city": {
      "description": "City name",
      "type": "string"
     },
     "contactName": {
      "description": "Contact full name",
      "type": "string"
     },
     "email": {
      "description": "Email address",
      "type": "string"
     },
     "phone": {
      "description": "Phone number",
      "type": "string"
     },
     "specialInstruction": {
      "description": "Special instructions",
      "type": "string"
     },
     "state": {
      "description": "2-letter state code",
      "type": "string"
     },
     "street": {
      "description": "Street address",
      "type": "string"
     },
     "zipCode": {
      "description": "5-digit ZIP",
      "pattern": "^\\d{5}$",
      "type": "string"
     }
    },
    "required": [
     "zipCode",
     "city",
     "state",
     "street",
     "contactName",
     "phone",
     "email"
    ],
    "type": "object"
   },
   "pickup_window": {
    "additionalProperties": false,
    "description": "Pickup time window, 24h HH:MM, e.g. { from: '08:00', to: '17:00' }. Defaults to a full business day if omitted.",
    "properties": {
     "from": {
      "type": "string"
     },
     "to": {
      "type": "string"
     }
    },
    "required": [
     "from",
     "to"
    ],
    "type": "object"
   },
   "quote_id": {
    "description": "Quote ID from warp_quote_id (Warp) or id field of any market option returned by a quote tool. Use the id from your MOST RECENT quote \u2014 market-option ids rotate on every quote call and stale ids are rejected.",
    "type": "string"
   },
   "reference": {
    "description": "Your internal reference number",
    "type": "string"
   }
  },
  "required": [
   "quote_id"
  ],
  "type": "object"
 },
 "name": "book",
 "title": "Book Shipment"
}
