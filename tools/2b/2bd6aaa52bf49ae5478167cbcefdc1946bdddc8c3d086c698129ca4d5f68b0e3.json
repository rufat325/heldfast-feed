{"_meta":{"openai/toolInvocation/invoked":"Logo project saved","openai/toolInvocation/invoking":"Saving the image logo project"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Saves a new 3D logo project from a mark stored with upload_logo_image or request_logo_image_upload, with a material and lighting, so it appears in the user's Projects. The image is traced into 3D the first time the project opens; open it once and save before publishing. Does not spend credits.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"background":{"description":"Hex colour, e.g. #1a1a1a","pattern":"^#[0-9a-fA-F]{6}$","type":"string"},"depth":{"description":"Extrusion depth, default 30","maximum":500,"minimum":1,"type":"number"},"environment":{"description":"Lighting room","enum":["studio","sunset","dawn","night","warehouse","forest","apartment","city"],"type":"string"},"mark":{"description":"Mark id from upload_logo_image or request_logo_image_upload","pattern":"^m[a-z0-9]{31}$","type":"string"},"material":{"description":"Material id from list_materials (e.g. gold-clean-optimised)","type":"string"},"motion":{"enum":["none","orbit","rotate","tumble","reveal","pulse"],"type":"string"},"title":{"description":"Project name; defaults to the file name","maxLength":200,"minLength":1,"type":"string"}},"required":["mark"],"type":"object"},"name":"create_image_logo_project","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"id":{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},"inputType":{"type":["string","null"]},"isPublic":{"type":"boolean"},"kind":{"enum":["logo","coin","mesh"],"type":"string"},"kindLabel":{"type":"string"},"mark":{"type":"string"},"modelUr