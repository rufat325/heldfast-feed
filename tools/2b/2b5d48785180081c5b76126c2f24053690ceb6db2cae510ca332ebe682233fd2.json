{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Mark up to 100 messages read (default) or unread, e.g. to leave one unread for a person. get_message and get_thread already mark what they return read.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"message_ids":{"description":"Message ids.","items":{"description":"Message id.","pattern":"^[A-Za-z0-9_-]{1,128}$","type":"string"},"maxItems":100,"minItems":1,"type":"array"},"read":{"description":"false marks them unread (default true).","type":"boolean"}},"required":["message_ids"],"type":"object"},"name":"mark_read","title":"Mark read or unread"}
