{
 "description": "Draw a shape/line on the chart",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "overrides": {
    "description": "JSON string of style overrides (e.g., '{\"linecolor\": \"#ff0000\", \"linewidth\": 2}')",
    "type": "string"
   },
   "point": {
    "description": "{ time: unix_timestamp, price: number }",
    "properties": {
     "price": {
      "type": "number"
     },
     "time": {
      "type": "number"
     }
    },
    "required": [
     "time",
     "price"
    ],
    "type": "object"
   },
   "point2": {
    "description": "Second point for two-point shapes (trend_line, rectangle)",
    "properties": {
     "price": {
      "type": "number"
     },
     "time": {
      "type": "number"
     }
    },
    "required": [
     "time",
     "price"
    ],
    "type": "object"
   },
   "shape": {
    "description": "Shape type: horizontal_line, vertical_line, trend_line, rectangle, text",
    "type": "string"
   },
   "text": {
    "description": "Text content for text shapes",
    "type": "string"
   }
  },
  "required": [
   "shape",
   "point"
  ],
  "type": "object"
 },
 "name": "draw_shape"
}
