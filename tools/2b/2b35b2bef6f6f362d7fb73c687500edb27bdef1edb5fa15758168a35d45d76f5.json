{
 "description": "Generate profile-aware physical rack blocks, rack-plan candidates, and site layout data from a nested design request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "design": {
    "additionalProperties": {},
    "description": "Nested design request that drives layout.",
    "properties": {
     "customInputs": {
      "additionalProperties": {},
      "description": "Optional project-specific design inputs.",
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "gpuGen": {
      "description": "NVIDIA GPU generation: hopper, blackwell, or rubin.",
      "enum": [
       "hopper",
       "blackwell",
       "rubin"
      ],
      "type": "string"
     },
     "hallCount": {
      "description": "Optional requested data-hall count.",
      "exclusiveMinimum": 0,
      "maximum": 48,
      "type": "integer"
     },
     "itLoadMw": {
      "description": "IT load in megawatts. 0 < x <= 1000.",
      "exclusiveMinimum": 0,
      "maximum": 1000,
      "type": "number"
     },
     "options": {
      "description": "Optional redundancy, cooling-mode, and PUE overrides.",
      "properties": {
       "coolingMode": {
        "enum": [
         "air",
         "hybrid",
         "liquid"
        ],
        "type": "string"
       },
       "pueTarget": {
        "maximum": 2.5,
        "minimum": 1,
        "type": "number"
       },
       "redundancy": {
        "enum": [
         "n",
         "n_plus_1",
         "2n"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "parcels": {
      "description": "Optional bounded GeoJSON parcel features.",
      "items": {
       "additionalProperties": {},
       "properties": {
        "geometry": {
         "anyOf": [
          {
           "properties": {
            "coordinates": {
             "items": {
              "items": {
               "items": {
                "type": "number"
               },
               "maxItems": 3,
               "minItems": 2,
               "type": "array"
              },
              "maxItems": 512,
              "minItems": 4,
              "type": "array"
             },
             "maxItems": 16,
             "minItems": 1,
             "type": "array"
            },
            "type": {
             "const": "Polygon",
             "type": "string"
            }
           },
           "required": [
            "type",
            "coordinates"
           ],
           "type": "object"
          },
          {
           "properties": {
            "coordinates": {
             "items": {
              "items": {
               "items": {
                "items": {
                 "type": "number"
                },
                "maxItems": 3,
                "minItems": 2,
                "type": "array"
               },
               "maxItems": 512,
               "minItems": 4,
               "type": "array"
              },
              "maxItems": 16,
              "minItems": 1,
              "type": "array"
             },
             "maxItems": 8,
             "minItems": 1,
             "type": "array"
            },
            "type": {
             "const": "MultiPolygon",
             "type": "string"
            }
           },
           "required": [
            "type",
            "coordinates"
           ],
           "type": "object"
          }
         ]
        },
        "id": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "number"
          }
         ]
        },
        "properties": {
         "additionalProperties": {},
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "type": {
         "const": "Feature",
         "type": "string"
        }
       },
       "required": [
        "type",
        "geometry"
       ],
       "type": "object"
      },
      "maxItems": 25,
      "type": "array"
     },
     "rackDensityKw": {
      "description": "Requested per-rack power in kW. 0 < x <= 500.",
      "exclusiveMinimum": 0,
      "maximum": 500,
      "type": "number"
     },
     "region": {
      "description": "Metropolitan or regional site class.",
      "enum": [
       "metropolitan",
       "regional"
      ],
      "type": "string"
     },
     "siteAreaSqm": {
      "description": "Total site area in square meters.",
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "type": "number"
     }
    },
    "required": [
     "itLoadMw",
     "rackDensityKw",
     "gpuGen",
     "siteAreaSqm",
     "region"
    ],
    "type": "object"
   },
   "siteAreaSqm": {
    "description": "Optional layout-specific site area override.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "siteCentroid": {
    "description": "Optional WGS84 site centroid.",
    "properties": {
     "lat": {
      "type": "number"
     },
     "lng": {
      "type": "number"
     }
    },
    "required": [
     "lat",
     "lng"
    ],
    "type": "object"
   }
  },
  "required": [
   "design"
  ],
  "type": "object"
 },
 "name": "layout",
 "title": "Generate rack and site layout"
}
