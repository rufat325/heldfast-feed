{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change how often an app is backed up automatically and how many copies are kept. Every running app is on a schedule by DEFAULT \u2014 daily, keeping 3 \u2014 even with nothing configured, so this tool changes an existing policy rather than creating one; to see the current setting call impreza_list_backups with that deployment_id. Set enabled=false to stop automatic backups for the app (manual ones still work). Old copies are only removed once a NEWER one has completed and been verified, and only automatic copies are ever pruned \u2014 a backup taken by hand stays until someone deletes it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "enabled": {
    "description": "Whether automatic backups run at all. Default true.",
    "type": "boolean"
   },
   "frequency": {
    "description": "How often. Default daily.",
    "enum": [
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "keep": {
    "description": "How many automatic copies to keep, 1-30. Default 3.",
    "type": "integer"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_backup_schedule",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "schedule": {
      "properties": {
       "consecutive_failures": {
        "type": "integer"
       },
       "deployment_id": {
        "type": "string"
       },
       "enabled": {
        "type": "boolean"
       },
       "frequency": {
        "enum": [
         "daily",
         "weekly"
        ],
        "type": "string"
       },
       "is_default": {
        "type": "boolean"
       },
       "keep": {
        "type": "integer"
       },
       "last_error": {
        "type": [
         "string",
         "null"
        ]
       },
       "last_error_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "last_run_at": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "deployment_id",
       "enabled",
       "frequency",
       "keep",
       "last_run_at",
       "is_default"
      ],
      "type": "object"
     }
    },
    "required": [
     "schedule"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Set app backup schedule"
}
