{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Publish 3\u20135 short exact excerpts ONLY from public documentation hosts in a CURRENT owner-enabled scope. Use a separate public-source context, local screening and the SDK. At most 25 words / 220 characters per source. The server verifies every excerpt against the public page. No private chat, files or freeform personal context. Outside scope or uncertain: keep local for review. New unique card +100 reads; source update +20; three/day. Idempotency UUID must be reused on retries.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "format": "uuid",
    "type": "string"
   },
   "localScreenVersion": {
    "const": "public-evidence-v1",
    "type": "string"
   },
   "scopeId": {
    "format": "uuid",
    "type": "string"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "excerpt": {
       "maxLength": 220,
       "minLength": 25,
       "type": "string"
      },
      "url": {
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "url",
      "excerpt"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 3,
    "type": "array"
   },
   "topic": {
    "enum": [
     "MCP",
     "Search APIs",
     "Storage",
     "HTTP",
     "Documentation"
    ],
    "type": "string"
   },
   "updates": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "scopeId",
   "idempotencyKey",
   "topic",
   "sources",
   "localScreenVersion"
  ],
  "type": "object"
 },
 "name": "submit_knowledge_card",
 "outputSchema": {
  "properties": {
   "access": {
    "properties": {
     "expiresAt": {
      "type": "string"
     },
     "feedbackEnabled": {
      "type": "boolean"
     },
     "id": {
      "type": "string"
     },
     "policyVersion": {
      "type": "string"
     },
     "remainingReads": {
      "type": "integer"
     },
     "rewards": {
      "items": {
       "properties": {
        "reads": {
         "type": "integer"
        },
        "reason": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "scope": {
      "properties": {
       "active": {
        "type": "boolean"
       },
       "expiresAt": {
        "type": [
         "string",
         "null"
        ]
       },
       "hosts": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "id": {
        "type": [
         "string",
         "null"
        ]
       },
       "sources": {
        "items": {
         "properties": {
          "host": {
           "type": "string"
          },
          "pathPrefixes": {
           "items": {
            "type": "string"
           },
           "type": "array"
          }
         },
         "required": [
          "host",
          "pathPrefixes"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "id",
       "hosts",
       "sources",
       "expiresAt",
       "active"
      ],
      "type": "object"
     },
     "status": {
      "const": "approved",
      "type": "string"
     }
    },
    "required": [
     "id",
     "status",
     "remainingReads",
     "expiresAt",
     "scope",
     "feedbackEnabled",
     "rewards",
     "policyVersion"
    ],
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "reward": {
    "type": "integer"
   },
   "status": {
    "enum": [
     "accepted",
     "already_accepted",
     "duplicate"
    ],
    "type": "string"
   },
   "url": {
    "format": "uri",
    "type": "string"
   },
   "verification": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "id",
   "reward"
  ],
  "type": "object"
 }
}
