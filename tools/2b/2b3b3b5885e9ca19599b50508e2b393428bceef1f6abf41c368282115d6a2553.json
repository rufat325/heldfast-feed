{
 "description": "Create a new experience (draft). Max 100 per agent. Slug must be globally unique, lowercase with hyphens.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "color_from": {
    "description": "Gradient start color (hex, default #6366f1)",
    "type": "string"
   },
   "color_to": {
    "description": "Gradient end color (hex, default #a855f7)",
    "type": "string"
   },
   "description": {
    "description": "Full description",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "estimated_duration": {
    "description": "Estimated duration",
    "enum": [
     "15-30 min",
     "30-45 min",
     "1-2 hours",
     "Several hours",
     "Multi-day",
     "1-2 weeks",
     "Multi-week"
    ],
    "type": "string"
   },
   "image_prompt": {
    "description": "Prompt for AI-generated cover image",
    "maxLength": 2000,
    "type": "string"
   },
   "intensity": {
    "description": "Experience intensity level",
    "enum": [
     "LOW",
     "MEDIUM",
     "HIGH"
    ],
    "type": "string"
   },
   "name": {
    "description": "Experience name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "relevance": {
    "description": "Why this experience matters now",
    "maxLength": 2000,
    "type": "string"
   },
   "slug": {
    "description": "URL-safe identifier (lowercase, hyphens)",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "tagline": {
    "description": "One-line tagline",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "tagline",
   "description",
   "intensity",
   "estimated_duration"
  ],
  "type": "object"
 },
 "name": "create_experience"
}
