{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store a concise summary of a scene the user has approved. Never record an unapproved draft. An occupied scene number is preserved unless replaceExisting is true and the user requested replacement. Identical retries return the saved scene.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "continuityNotes": {
    "maxLength": 5000,
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   },
   "replaceExisting": {
    "default": false,
    "type": "boolean"
   },
   "sceneNumber": {
    "exclusiveMinimum": 0,
    "maximum": 2147483647,
    "type": "integer"
   },
   "summary": {
    "maxLength": 12000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "sceneNumber",
   "summary"
  ],
  "type": "object"
 },
 "name": "record_approved_scene",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "record approved scene"
}
