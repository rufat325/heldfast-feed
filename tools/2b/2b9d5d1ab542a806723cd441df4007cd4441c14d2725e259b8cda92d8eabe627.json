  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a listing"
 },
 "description": "Create a new product listing (seller tool)",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Catalogue category. One of: electronics, apparel, home_goods, beauty, sports, kitchenware, office_supplies, toys, food_beverage, tools, other.",
    "enum": [
     "electronics",
     "apparel",
     "home_goods",
     "beauty",
     "sports",
     "kitchenware",
     "office_supplies",
     "toys",
     "food_beverage",
     "tools",
     "other"
    ],
    "type": "string"
   },
   "condition": {
    "description": "Standard liquidation condition grade (Task #72)",
    "enum": [
     "salvage",
     "customer_returns",
     "shelf_pulls",
     "overstock",
     "new_or_refurbished"
    ],
    "type": "string"
   },
   "description": {
    "description": "Listing body copy: condition detail, packaging, lot composition. Buyers filter on its presence and agents summarise it.",
    "type": "string"
   },
   "name": {
    "description": "Listing title shown to buyers and matched by catalogue search.",
    "type": "string"
   },
   "original_retail_price": {
    "description": "Original retail price in cents",
    "type": "integer"
   },
   "price_per_unit": {
    "description": "Price in cents",
    "type": "integer"
   },
   "quantity": {
    "description": "Units available in this lot.",
    "minimum": 1,
    "type": "integer"
   },
   "sku": {
    "description": "Seller's own stock-keeping unit, shown to buyers and used for reconciliation.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "category",
   "condition",
   "quantity",
   "price_per_unit"
  ],
  "type": "object"
 },
 "name": "create_listing",
 "outputSchema": {
  "properties": {
   "listing": {
    "properties": {
     "category": {
      "type": "string"
     },
     "condition": {
      "type": [
       "string",
       "null"
      ]
     },
     "id": {
      "type": "string"
     },
     "image_url": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "original_retail": {
      "type": [
       "integer",
       "null"
      ]
     },
     "price": {
      "description": "Unit price in cents.",
      "type": "integer"
     },
     "quantity": {
      "type": "integer"
     },
     "sku": {
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": "string"
     },
     "view_url": {
      "description": "Buyer-facing listing page.",
      "type": "string"
     }
    },
    "required": [
     "id",
     "name",
     "category",
     "quantity",
     "price",
     "status",
     "view_url"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "message",
   "listing"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "seller:write"
   ],
   "type": "oauth2"
  }
 ],
