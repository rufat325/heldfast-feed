    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Max results, 1-1000 (Buildium default 50).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Zero-based record offset for paging (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "orderby": {
