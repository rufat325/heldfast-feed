{
 "_meta": {
  "openai/outputTemplate": "ui://tutorializer/project-overview-v2.html",
  "openai/toolInvocation/invoked": "Tutorializer project overview ready.",
  "openai/toolInvocation/invoking": "Loading Tutorializer project\u2026",
  "ui": {
   "resourceUri": "ui://tutorializer/project-overview-v2.html"
  },
  "ui/resourceUri": "ui://tutorializer/project-overview-v2.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show project overview"
 },
 "description": "Use this when someone wants a quick visual overview of one Tutorializer project. Returns a card with the project's name, domain and logo, how many tutorials, videos and voiceover lines it has (counted up to 100 each) and its 8 most recently edited tutorials. Not for missing languages or devices.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "projectId": {
    "description": "Project id or its stable public vanity id",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "show_project_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "domain": {
        "anyOf": [
         {
          "maxLength": 253,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "logo": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "domain",
       "logo"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "speechCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "speechCountIsLowerBound": {
    "type": "boolean"
   },
   "tutorialCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "tutorialCountIsLowerBound": {
    "type": "boolean"
   },
   "tutorials": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "defaultVoice": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "lastEditTime": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "defaultVoice",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 8,
    "type": "array"
   },
   "videoCount": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "videoCountIsLowerBound": {
    "type": "boolean"
   }
  },
  "required": [
   "project",
   "tutorialCount",
   "tutorialCountIsLowerBound",
   "videoCount",
   "videoCountIsLowerBound",
   "speechCount",
   "speechCountIsLowerBound",
   "tutorials"
  ],
  "type": "object"
 },
 "title": "Show project overview"
}
