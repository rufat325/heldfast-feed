{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search purchase bills"
 },
 "description": "Find purchase documents (\u043f\u043e\u043a\u0443\u043f\u043a\u0438, \u0432\u0445\u043e\u0434\u044f\u0449\u0438 \u0444\u0430\u043a\u0442\u0443\u0440\u0438 \u043e\u0442 \u0434\u043e\u0441\u0442\u0430\u0432\u0447\u0438\u0446\u0438) by period, supplier or number. Pass bill_id to get one bill in full with its lines.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "bill_id": {
    "description": "Get this bill in full, with lines",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "date_from": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Max records to return from the page (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "number": {
    "description": "Supplier's document number",
    "pattern": "^\\d{1,10}$",
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "response_format": {
    "description": "\"concise\" (default) returns key fields; \"detailed\" adds lines and the raw nula.bg record",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "supplier_eik": {
    "type": "string"
   },
   "supplier_name": {
    "type": "string"
   },
   "supplier_vat_number": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nula_search_bills",
 "title": "Search purchase bills"
}
