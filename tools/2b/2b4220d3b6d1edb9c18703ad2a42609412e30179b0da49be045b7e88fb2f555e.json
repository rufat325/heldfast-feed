{
 "annotations": {
  "destructiveHint": true,
  "title": "Update company"
 },
 "description": "Update fields on an existing company. Only provided fields are changed; list-valued fields REPLACE the existing values. Folk REST: PATCH /v1/companies/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "addresses": {
    "description": "Replace the company's addresses.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "customFieldValues": {
    "additionalProperties": {},
    "description": "Custom field values, keyed by field.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Freeform description / notes.",
    "type": "string"
   },
   "emails": {
    "description": "Replace the company's email addresses.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "employeeRange": {
    "description": "Employee-count range bucket.",
    "enum": [
     "1-10",
     "11-50",
     "51-200",
     "201-500",
     "501-1000",
     "1001-5000",
     "5001-10000",
     "10000+"
    ],
    "type": "string"
   },
   "foundationYear": {
    "description": "Year the company was founded.",
    "type": [
     "string",
     "number"
    ]
   },
   "fundingRaised": {
    "description": "Total funding raised.",
    "type": [
     "string",
     "number"
    ]
   },
   "groups": {
    "description": "Replace the company's groups (array of {id}).",
    "items": {
     "description": "A reference to a group by id.",
     "properties": {
      "id": {
       "description": "The group id.",
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "The company id to update.",
    "type": "string"
   },
   "industry": {
    "description": "Industry.",
    "type": "string"
   },
   "lastFundingDate": {
    "description": "Date of last funding round, formatted YYYY-MM-DD.",
    "type": "string"
   },
   "name": {
    "description": "The company name.",
    "type": "string"
   },
   "phones": {
    "description": "Replace the company's phone numbers.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "urls": {
    "description": "Replace the company's URLs.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "folk_update_company",
 "title": "Update company"
}
