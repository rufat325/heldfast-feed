{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read-only: search TouchDesigner Python API classes, methods and members from the embedded offline knowledge base. Supports class category filters and conservative stable-version compatibility filtering where compatibility metadata exists.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category": {
    "description": "Optional Python class category filter, e.g. General or Operator.",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results per group.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "query": {
    "description": "Search query for TD Python classes, methods, or members.",
    "minLength": 1,
    "type": "string"
   },
   "search_in": {
    "default": "all",
    "description": "Where to search: all, classes, methods, or members.",
    "enum": [
     "all",
     "classes",
     "methods",
     "members"
    ],
    "type": "string"
   },
   "version": {
    "description": "Optional stable TouchDesigner version filter, e.g. 099, 2020, 2023, or 2024.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_python_api",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "classes": {
    "description": "Matching Python API classes.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "className": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "displayName": {
       "type": "string"
      }
     },
     "required": [
      "className",
      "displayName",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "count": {
    "description": "Number of returned results.",
    "type": "number"
   },
   "filters": {
    "additionalProperties": false,
    "description": "Filters applied to the search.",
    "properties": {
     "category": {
      "description": "Category filter, if requested.",
      "type": "string"
     },
     "resolvedVersion": {
      "description": "Resolved TouchDesigner version id.",
      "type": "string"
     },
     "search_in": {
      "description": "Surface that was searched.",
      "enum": [
       "all",
       "classes",
       "methods",
       "members"
      ],
      "type": "string"
     },
     "version": {
      "description": "Version filter, if requested.",
      "type": "string"
     }
    },
    "required": [
     "search_in"
    ],
    "type": "object"
   },
   "members": {
    "description": "Matching Python API members.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "addedIn": {
       "type": "string"
      },
      "className": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "readOnly": {
       "type": "boolean"
      },
      "returnType": {
       "type": "string"
      }
     },
     "required": [
      "className",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "methods": {
    "description": "Matching Python API methods.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "addedIn": {
       "type": "string"
      },
      "className": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "returns": {
       "type": "string"
      },
      "signature": {
       "type": "string"
      }
     },
     "required": [
      "className",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "description": "Echo of the search query.",
    "type": "string"
   },
   "tips": {
    "description": "Follow-up hints when no results are found.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "filters",
   "count",
   "classes",
   "methods",
   "members",
   "tips"
  ],
  "type": "object"
 },
 "title": "Search TD Python API"
}
