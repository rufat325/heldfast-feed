{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search the complete Watermelon UI catalog across components, animated components, blocks, dashboards, and templates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "type": "string"
   },
   "kinds": {
    "items": {
     "enum": [
      "components",
      "animated-components",
      "blocks",
      "dashboards",
      "templates"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Natural-language UI need, such as \"animated pricing card\".",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "title": "Search UI Catalog"
}
