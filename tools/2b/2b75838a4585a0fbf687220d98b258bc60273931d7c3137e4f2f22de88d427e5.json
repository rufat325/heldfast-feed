{
 "_meta": {
  "openai/toolInvocation/invoked": "Requested evidence returned",
  "openai/toolInvocation/invoking": "Returning requested evidence\u2026",
  "openai/visibility": "private",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Component-only: validates and returns a bounded Evidence IR query projection for the same attachment. No model bytes, state persistence, or runtime execution. Result digests establish consistency, not independent server attestation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": false,
    "properties": {
     "analysis_location": {
      "const": "chatgpt_browser_sandbox",
      "type": "string"
     },
     "analyzer_version": {
      "type": "string"
     },
     "artifact": {
      "additionalProperties": false,
      "properties": {
       "filename": {
        "type": "string"
       },
       "format": {
        "type": "string"
       },
       "sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "filename",
       "format",
       "sha256"
      ],
      "type": "object"
     },
     "context": {
      "type": "object"
     },
     "coverage": {
      "additionalProperties": false,
      "properties": {
       "detail_truncated": {
        "type": "boolean"
       },
       "matched_rows": {
        "minimum": 0,
        "type": "integer"
       },
       "next_offset": {
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "offset": {
        "minimum": 0,
        "type": "integer"
       },
       "returned_rows": {
        "maximum": 40,
        "minimum": 0,
        "type": "integer"
       },
       "total_rows": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "total_rows",
       "matched_rows",
       "returned_rows",
       "offset",
       "next_offset",
       "detail_truncated"
      ],
      "type": "object"
     },
     "evidence_boundary": {
      "type": "string"
     },
     "model_ir_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "query": {
      "additionalProperties": false,
      "properties": {
       "limit": {
        "default": 20,
        "maximum": 40,
        "minimum": 1,
        "type": "integer"
       },
       "offset": {
        "default": 0,
        "minimum": 0,
        "type": "integer"
       },
       "profile_ids": {
        "description": "Exact static backend profile IDs returned by section=profiles. Independent eligibility profiles, not runtime assignments.",
        "items": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 4,
        "type": "array",
        "uniqueItems": true
       },
       "search": {
        "description": "Literal case-insensitive filter over row names and references.",
        "maxLength": 160,
        "type": "string"
       },
       "section": {
        "enum": [
         "operators",
         "operator",
         "findings",
         "placement",
         "fusion",
         "improvements",
         "profiles",
         "weights"
        ],
        "type": "string"
       },
       "source_index": {
        "description": "Native serialized operator index, not display order. Ambiguous indices require subject_ref.",
        "minimum": 0,
        "type": "integer"
       },
       "subject_ref": {
        "description": "Exact Model IR subject_ref from a previous result; preferred over an index.",
        "maxLength": 512,
        "minLength": 1,
        "type": "string"
       },
       "target": {
        "description": "Optional TFLite CPU planning profile ID from capabilities. Not detected hardware or a GPU delegate selector.",
        "maxLength": 128,
        "minLength": 1,
        "type": "string"
       },
       "weight_view": {
        "description": "Only for section=weights: explicitly opt into bounded payload analysis; use returned weight subject_ref to select a tensor. Default distribution.",
        "enum": [
         "distribution",
         "channels",
         "similarity",
         "spectrum",
         "sparsity",
         "quantization"
        ],
        "type": "string"
       }
      },
      "required": [
       "section"
      ],
      "type": "object"
     },
     "query_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "result_sha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "rows": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "detail_truncations": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "details": {
         "type": "object"
        },
        "kind": {
         "type": "string"
        },
        "subject_ref": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "subject_ref",
        "kind",
        "title",
        "details",
        "detail_truncations"
       ],
       "type": "object"
      },
      "maxItems": 40,
      "type": "array"
     },
     "schema": {
      "const": "deepbom.evidence_query_result.v1",
      "type": "string"
     },
     "status": {
      "enum": [
       "complete",
       "partial",
       "not_assessable",
       "no_matches"
      ],
      "type": "string"
     },
     "transfer_boundary": {
      "const": "model_bytes_not_sent_to_deepbom_service",
      "type": "string"
     }
    },
    "required": [
     "schema",
     "analyzer_version",
     "analysis_location",
     "artifact",
     "model_ir_sha256",
     "query",
     "query_sha256",
     "status",
     "coverage",
     "context",
     "rows",
     "evidence_boundary",
     "transfer_boundary",
     "result_sha256"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
