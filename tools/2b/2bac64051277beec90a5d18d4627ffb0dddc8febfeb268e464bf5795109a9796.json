    "default": null,
    "description": "Optional private grouping name. The same case-sensitive name, after trimming outer whitespace, reuses one group for this user. Omit it for an independent operation. Keep the name on retries; each calculation still needs its own idempotency_key.",
    "title": "Analysis Name"
   },
   "base_currency": {
    "default": "USD",
