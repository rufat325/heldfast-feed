     },
     "metric": {
      "enum": [
       "single_holding_weight",
       "selected_holdings_weight",
       "filtered_holdings_weight",
       "top_n_holdings_weight",
       "holding_count",
       "total_weight"
      ],
      "title": "Metric",
      "type": "string"
     },
     "min_value": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
