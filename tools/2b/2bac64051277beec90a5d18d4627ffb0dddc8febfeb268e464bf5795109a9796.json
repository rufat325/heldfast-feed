    "type": "string"
   },
   "composition_scope": {
    "default": "unknown",
    "enum": [
     "complete",
     "partial",
     "unknown"
    ],
    "title": "Composition Scope",
    "type": "string"
   },
   "constraints": {
    "items": {
     "$ref": "#/$defs/DeterministicConstraint"
    },
    "maxItems": 250,
    "minItems": 1,
    "title": "Constraints",
    "type": "array"
   },
   "holdings": {
    "items": {
     "$ref": "#/$defs/AlignmentHolding"
