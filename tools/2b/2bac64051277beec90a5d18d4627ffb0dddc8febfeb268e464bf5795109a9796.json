        "maximum": 1000,
        "minimum": 1,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Top N"
     }
    },
    "required": [
     "id",
     "metric",
     "operator"
    ],
    "title": "DeterministicConstraint",
    "type": "object"
   },
   "ExposureFilter": {
    "additionalProperties": false,
    "properties": {
     "dimension": {
      "enum": [
       "denomination_currency",
       "country",
       "domicile",
       "issuer_country",
       "listing_country",
       "asset_class",
       "rating",
       "sector"
