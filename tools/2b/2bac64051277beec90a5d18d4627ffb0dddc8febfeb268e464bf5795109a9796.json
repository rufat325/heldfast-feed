    "maxItems": 1000,
    "minItems": 1,
    "title": "Holdings",
    "type": "array"
   },
   "idempotency_key": {
    "maxLength": 255,
    "minLength": 1,
    "title": "Idempotency Key",
    "type": "string"
   },
   "source_warnings": {
    "anyOf": [
     {
      "items": {
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 100,
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Source Warnings"
   }
  },
  "required": [
   "holdings",
   "constraints",
   "idempotency_key"
  ],
  "title": "calculate_portfolio_constraintsArguments",
  "type": "object"
 },
