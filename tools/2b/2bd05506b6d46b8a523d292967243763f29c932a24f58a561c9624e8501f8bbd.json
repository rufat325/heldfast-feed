{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Review a pull request against Agentic SDLC standards.\n\nStandards:\n  - basic: Core checks (tests, description, draft status, commit count)\n  - strict: basic + large diff detection, missing docs\n  - security-focused: strict + mature secret-scanner CI evidence + supplemental patch heuristics, .env files, lockfile changes, dist files\n\nOwnership check (independent of standard, runs when checkOwnership is true and a CODEOWNERS file exists):\n  Matches changed files against .github/CODEOWNERS (or CODEOWNERS / docs/CODEOWNERS), and flags any\n  matched owner who is neither the PR author, a requested reviewer, nor an actual reviewer.\n\nArgs:\n  - owner, repo: Repository coordinates.\n  - pullNumber (number): The PR to review.\n  - standard: \"basic\" | \"strict\" | \"security-focused\". Default: \"basic\".\n  - checkOwnership (boolean, default: true): Enable the CODEOWNERS ownership check.\n\nReturns: Sorted findings by severity, test coverage signal, ownership routing gaps, release risk, and conclusion.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "checkOwnership": {
    "default": true,
    "description": "Check changed files against .github/CODEOWNERS and flag owners who were neither requested nor have reviewed. Requires read access to repo contents and PR reviewers/reviews.",
    "type": "boolean"
   },
   "owner": {
    "description": "GitHub owner. Falls back to GITHUB_OWNER.",
    "type": "string"
   },
   "pullNumber": {
    "description": "The pull request number to review.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "repo": {
    "description": "GitHub repo. Falls back to GITHUB_REPO.",
    "type": "string"
   },
   "standard": {
    "default": "basic",
    "description": "Review standard: 'basic', 'strict', or 'security-focused'.",
    "enum": [
     "basic",
     "strict",
     "security-focused"
    ],
    "type": "string"
   },
   "workType": {
    "description": "Optional explicit work type. When omitted, it is inferred from PR metadata and paths.",
    "enum": [
     "docs",
     "feature",
     "bugfix",
     "refactor",
     "security",
     "release",
     "infra"
    ],
    "type": "string"
   }
  },
  "required": [
   "pullNumber"
  ],
  "type": "object"
 },
 "name": "review_pr_against_standard",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appliedPolicyRules": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "source": {
       "const": "repository",
       "type": "string"
      }
     },
     "required": [
      "id",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "codeownersFound": {
    "type": "boolean"
   },
   "conclusion": {
    "enum": [
     "pass",
     "needs_changes",
     "risky_but_acceptable"
    ],
    "type": "string"
   },
   "errors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "dimension": {
       "enum": [
        "intent",
        "scope",
        "evidence",
        "ownership",
        "policy",
        "fallback",
        "security"
       ],
       "type": "string"
      },
      "paths": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "reason": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
       ],
       "type": "string"
      },
      "suggestion": {
       "type": "string"
      }
     },
     "required": [
      "severity",
      "category",
      "description",
      "suggestion",
      "dimension",
      "paths",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hasTests": {
    "type": "boolean"
   },
   "ownershipRoutingGaps": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "owner": {
       "type": "string"
      },
      "paths": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "owner",
      "paths"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "policyDegraded": {
    "type": "boolean"
   },
   "policyDigest": {
    "type": "string"
   },
   "policySources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "blobSha": {
       "type": [
        "string",
        "null"
       ]
      },
      "digest": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "default",
        "repository"
       ],
       "type": "string"
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "ref": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "kind",
      "path",
      "ref",
      "blobSha",
      "digest"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pullNumber": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "releaseRisk": {
    "enum": [
     "low",
     "moderate",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "secretScannerEvidence": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "degraded": {
        "type": "boolean"
       },
       "providers": {
        "items": {
         "enum": [
          "gitleaks",
          "trufflehog",
          "secretlint",
          "detect-secrets",
          "github-secret-scanning"
         ],
         "type": "string"
        },
        "type": "array"
       },
       "reason": {
        "type": "string"
       },
       "signals": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "appId": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "name": {
           "type": "string"
          },
          "provenanceVerified": {
           "type": "boolean"
          },
          "provider": {
           "enum": [
            "gitleaks",
            "trufflehog",
            "secretlint",
            "detect-secrets",
            "github-secret-scanning"
           ],
           "type": "string"
          },
          "source": {
           "enum": [
            "check_run",
            "commit_status"
           ],
           "type": "string"
          },
          "state": {
           "enum": [
            "passing",
            "failing",
            "pending",
            "skipped"
           ],
           "type": "string"
          },
          "trusted": {
           "type": "boolean"
          },
          "url": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "name",
          "provider",
          "source",
          "appId",
          "trusted",
          "provenanceVerified",
          "state",
          "url"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "status": {
        "enum": [
         "passing",
         "failing",
         "pending",
         "unverified"
        ],
        "type": "string"
       },
       "verified": {
        "type": "boolean"
       }
      },
      "required": [
       "status",
       "verified",
       "degraded",
       "providers",
       "signals",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "standard": {
    "type": "string"
   },
   "testCoverageSignal": {
    "enum": [
     "adequate",
     "missing",
     "not_required",
     "insufficient_evidence"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "totalChangedLines": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "trustBoundary": {
    "additionalProperties": false,
    "properties": {
     "callerAndRepositoryContent": {
      "const": "untrusted",
      "type": "string"
     },
     "instructionHandling": {
      "const": "never_execute",
      "type": "string"
     },
     "permissionHandling": {
      "const": "never_expand",
      "type": "string"
     },
     "secretHandling": {
      "const": "never_reveal",
      "type": "string"
     }
    },
    "required": [
     "callerAndRepositoryContent",
     "instructionHandling",
     "secretHandling",
     "permissionHandling"
    ],
    "type": "object"
   },
   "workType": {
    "enum": [
     "docs",
     "feature",
     "bugfix",
     "refactor",
     "security",
     "release",
     "infra"
    ],
    "type": "string"
   },
   "workTypeConfidence": {
    "enum": [
     "high",
     "medium",
     "low"
    ],
    "type": "string"
   },
   "workTypeReasoning": {
    "type": "string"
   }
  },
  "required": [
   "pullNumber",
   "title",
   "standard",
   "conclusion",
   "findings",
   "hasTests",
   "totalChangedLines",
   "codeownersFound",
   "workType",
   "workTypeConfidence",
   "workTypeReasoning",
   "releaseRisk",
   "testCoverageSignal",
   "ownershipRoutingGaps",
   "errors",
   "secretScannerEvidence",
   "policyDigest",
   "policySources",
   "appliedPolicyRules",
   "policyDegraded"
  ],
  "type": "object"
 },
 "title": "Review PR Against SDLC Standard"
}
