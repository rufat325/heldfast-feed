{"_meta":{"xdata.kr/credential":{"providers":[],"register_url":null,"required":false,"windows_pc_needed":false}},"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\uacf5\uacf5\ub370\uc774\ud130\ud3ec\ud138\uc5d0 \uac1c\ubc29\ub41c \uad6d\ubbfc\uc5f0\uae08 \uac00\uc785 \uc0ac\uc5c5\uc7a5 \uc815\ubcf4(data.go.kr 3046071)\ub97c \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638\uc640 \uc0c1\ud638\ub85c \uc870\ud68c\ud569\ub2c8\ub2e4. \uc6d0\ucc9c\uc774 \uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638\ub97c \uc55e 6\uc790\ub9ac\ub9cc \uc81c\uacf5\ud558\ubbc0\ub85c candidates \uc5d0\ub294 \uac19\uc740 \uc55e\uc790\ub9ac\uc758 \ub2e4\ub978 \uc0ac\uc5c5\uc7a5\uc774 \uc11e\uc77c \uc218 \uc788\uace0, \uc0c1\ud638\uac00 \uc815\ud655\ud788 \uc77c\uce58\ud558\ub294 \uc0ac\uc5c5\uc7a5\ub9cc matched \uc5d0 \uac00\uc785\uc790\uc218, \ub2f9\uc6d4\uace0\uc9c0\uae08\uc561, \uc0ac\uc5c5\uc7a5\ub4f1\ub85d\uc77c, \ud0c8\ud1f4\uc77c, \uc5c5\uc885\uc744 \ud568\uaed8 \ub3cc\ub824\uc90d\ub2c8\ub2e4. \uac00\uc785\uc790 3\uc778 \uc774\uc0c1 \ubc95\uc778\uacfc 10\uc778 \uc774\uc0c1 \uac1c\uc778\uc0ac\uc5c5\uc7a5\ub9cc \uac1c\ubc29\ub418\uc5b4 \ube48 \uacb0\uacfc\uac00 \ubbf8\uac00\uc785\uc744 \ub73b\ud558\uc9c0\ub294 \uc54a\uc2b5\ub2c8\ub2e4. \ubcc4\ub3c4 \uc5f0\ub3d9 \uc5c6\uc774 \uc0ac\uc6a9\ud560 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ud30c\uc77c: \uc5d1\uc140(xlsx) \u00b7 \uc774 \uc791\uc5c5\uc758 \uacb0\uacfc\ub85c \ub9cc\ub4e0 \ubb38\uc11c - output_formats \ub85c \uccad\ud560 \ub54c\ub9cc \ub9cc\ub4ed\ub2c8\ub2e4. \uacb0\uacfc\uc758 artifacts[] \uc5d0 \uc2e4\ub9ac\uace0, \ub0b4\ub824\ubc1b\uae30 \ub9c1\ud06c(download_url)\ub294 15\ubd84 \ub3d9\uc548 \uc5f4\ub9ac\uba70 \ud30c\uc77c\uc740 7\uc77c \ub3d9\uc548 \ubcf4\uad00\ub429\ub2c8\ub2e4. \ub9c1\ud06c\uac00 \ub9cc\ub8cc\ub418\uba74 \uacb0\uacfc\uc758 job_id \ub85c xdata__job__result \ub97c \ub2e4\uc2dc \ubd88\ub7ec \uc0c8 \ub9c1\ud06c\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778 \uc5c6\uc774 \ubc1b\uc740 \uacb0\uacfc\ub294 \ud568\uaed8 \uc628 recovery_receipt \ub97c \ub530\ub85c \ubcf4\uad00\ud588\ub2e4\uac00, \ucc98\uc74c\uc758 job_id \ub098 pack_run_id \uc640 \ud568\uaed8 xdata__job__result \uc5d0 \ubcf4\ub0b4\uc138\uc694. \uc99d\ud45c\ub85c\ub294 \uadf8 \uacb0\uacfc \ud558\ub098\ub9cc, \uc6d0\ub798 \ud30c\uc77c \ubcf4\uad00 \uae30\uac04\uc774 \ub05d\ub0a0 \ub54c\uae4c\uc9c0 \uc5f4 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \uc99d\ud45c\ub294 \uacf5\uac1c\ud558\uc9c0 \ub9c8\uc138\uc694. \uc783\uc5b4\ubc84\ub9ac\uba74 \uac00\uc785\ud574\ub3c4 \ub418\ucc3e\uc744 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \ub098\uc911\uc5d0 \ub85c\uadf8\uc778\ud574\ub3c4 \uc99d\ud45c\ub294 \uadf8\ub300\ub85c \uc4f0\uc774\uace0, \ub2e4\ub978 \uacb0\uacfc\ub294 \uc5f4\uc9c0 \ubabb\ud569\ub2c8\ub2e4. \uc99d\ud45c\uac00 \uc5c6\uc73c\uba74 \ucc98\uc74c \uacc4\uc815\uacfc \uac19\uc740 \ud658\uacbd(\ub370\ubaa8 \u00b7 \uc815\uc2dd)\uc5d0\uc11c\ub9cc \uacb0\uacfc\ub97c \uc77d\uc744 \uc218 \uc788\uc2b5\ub2c8\ub2e4. \ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc774\uba74 \uccab \uc694\uccad \uc804\uc5d0 request_idempotency_key \uac12\uc744 \ub9cc\ub4e4\uc5b4 \uc800\uc7a5\ud558\uc138\uc694. \uc751\ub2f5\uc744 \ubc1b\uc9c0 \ubabb\ud55c \uadf8 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c\ub9cc \uac19\uc740 \uc778\uc790\uc640 \ud568\uaed8 \uadf8 \uac12\uc744 \ub2e4\uc2dc \ubcf4\ub0b4\uace0, \uc0c8\ub85c \uc2e4\ud589\ud560 \ub54c\ub294 \uc0c8 \uac12\uc744 \uc4f0\uc138\uc694. \uc774 \uac12 \uc5c6\uc774 \ub2e4\uc2dc \ubd80\ub974\uba74 \uc0c8 \uc694\uccad\uc774 \ub429\ub2c8\ub2e4. \uacc4\uc815 \uc5c6\uc774 \ub9db\ubcf4\uae30\ub85c \ubd80\ub97c \ub54c\ub294 \uc774 \uc120\ud0dd \uce78\uc744 \uc4f8 \uc218 \uc5c6\uc2b5\ub2c8\ub2e4. \uae30\uad00 \uc5c5\ubb34\uc5d0 \ub530\ub85c \uc788\ub294 idempotency_key \uce78\uc740 \ub2e4\ub978 \uce78\uc774\ub2c8 \uadf8\ub300\ub85c \ub450\uc138\uc694. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 2\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"bizno":{"description":"\uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638 10\uc790\ub9ac(\ud558\uc774\ud508 \ud5c8\uc6a9). \uc55e 6\uc790\ub9ac\ub85c \ud6c4\ubcf4\ub97c \ucc3e\uc2b5\ub2c8\ub2e4.","maxLength":12,"minLength":10,"type":"string"},"numOfRows":{"description":"\ud6c4\ubcf4 \ud55c \ud398\uc774\uc9c0 \ud589 \uc218(\uc120\ud0dd, \uae30\ubcf8 100).","maximum":100,"minimum":1,"type":"integer"},"output_formats":{"description":"\uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \uacb0\uacfc\ub97c \uc5d1\uc140(xlsx) \ud30c\uc77c\ub85c\ub3c4 \ubc1b\uc73c\ub824\uba74 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \ud30c\uc77c\uc740 \uacb0\uacfc\uc758 artifacts[] \uc5d0 \uc2e4\ub9bd\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \ub370\uc774\ud130\ub9cc \ubc1b\uc2b5\ub2c8\ub2e4.","items":{"enum":["xlsx"],"type":"string"},"minItems":1,"type":"array","uniqueItems":true},"pageNo":{"description":"\ud6c4\ubcf4 \ud398\uc774\uc9c0 \ubc88\ud638(\uc120\ud0dd, \uae30\ubcf8 1).","minimum":1,"type":"integer"},"request_idempotency_key":{"description":"\ub85c\uadf8\uc778\ud55c \ud638\ucd9c\uc5d0\uc11c \uc751\ub2f5\uc744 \ubabb \ubc1b\uc740 \uac19\uc740 \uc694\uccad\uc744 \ub418\ucc3e\uc744 \ub54c \uc4f0\ub294 \uc120\ud0dd \uac12\uc785\ub2c8\ub2e4. \uc4f0\ub294 \ubc95\uc740 \ub3c4\uad6c \uc124\uba85\uc5d0 \uc788\uc2b5\ub2c8\ub2e4.","maxLength":128,"minLength":1,"pattern":"^[\\x20-\\x7E]+$","type":"string"},"wkplNm":{"description":"\uc0ac\uc5c5\uc7a5 \uc0c1\ud638(\uc120\ud0dd). \ube44\uc6b0\uba74 \ubc95\uc778 \uc0c1\ud638\ub97c \uae30\uc5c5\uac1c\uc694\uc5d0\uc11c \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uc0ac\uc5c5\uc790\ub4f1\ub85d\uc99d\uc758 \uc0c1\ud638\ub97c \uadf8\ub300\ub85c \uc8fc\uba74 \uac00\uc7a5 \uc815\ud655\ud569\ub2c8\ub2e4.","type":"string"}},"required":["bizno"],"type":"object"},"name":"opendata__nps__workplace","securitySchemes":[{"type":"noauth"},{"scopes":["mcp:tools:list","mcp:tools:call"],"type":"oauth2"}],"title":"\uad6d\ubbfc\uc5f0\uae08 \uac00\uc785 \uc0ac\uc5c5\uc7a5 \uc870\ud68c"}
