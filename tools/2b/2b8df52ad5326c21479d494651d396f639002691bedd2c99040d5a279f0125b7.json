{
 "description": "[OPERATOR] Create a scoped delegation from one agent to another.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "delegated_to": {
    "description": "Public key of the agent receiving delegation",
    "type": "string"
   },
   "expires_in_hours": {
    "default": 24,
    "description": "Delegation validity in hours",
    "type": "number"
   },
   "max_depth": {
    "default": 1,
    "description": "How many levels of sub-delegation",
    "type": "number"
   },
   "scope": {
    "description": "Scopes to grant (e.g. ['web_search', 'code_execution'])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "spend_limit": {
    "default": 500,
    "description": "Maximum spend allowed",
    "type": "number"
   }
  },
  "required": [
   "delegated_to",
   "scope"
  ],
  "type": "object"
 },
 "name": "create_delegation"
}
