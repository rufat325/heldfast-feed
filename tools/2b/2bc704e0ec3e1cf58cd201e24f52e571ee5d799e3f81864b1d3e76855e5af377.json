{"_meta":{"securitySchemes":[{"scopes":["workspace:read","appointments:write"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Replace a staff or resource schedule. Supply its current revision, or null when it has no saved schedule. Hours follow the business time zone.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"kind":{"enum":["staff","resource"],"type":"string"},"schedule":{"properties":{"revision":{"anyOf":[{"format":"uuid","pattern":"^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$","type":"string"},{"type":"null"}]},"timeOff":{"items":{"properties":{"end":{"pattern":"^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"start":{"pattern":"^\\d{4}-\\d{2}-\\d{2}T([01]\\d|2[0-3]):[0-5]\\d$","type":"string"}},"required":["start","end"],"type":"object"},"maxItems":50,"type":"array"},"weeklyHours":{"anyOf":[{"items":{"anyOf":[{"properties":{"closes":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"opens":{"pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"}},"required":["opens","closes"],"type":"object"},{"type":"null"}]},"maxItems":7,"minItems":7,"type":"array"},{"type":"null"}]}},"required":["weeklyHours","timeOff","revision"],"type":"object"},"targetId":{"maxLength":200,"minLength":1,"type":"string"}},"required":["kind","targetId","schedule"],"type":"object"},"name":"save_booking_schedule"}
