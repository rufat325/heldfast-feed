{
 "description": "Create a new subscription product with a base plan.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "basePlanId": {
    "description": "Base plan ID (e.g., \"monthly\", \"yearly\")",
    "type": "string"
   },
   "benefits": {
    "description": "List of subscription benefits shown to users",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "billingPeriod": {
    "description": "ISO 8601 billing period (P1M = monthly, P1Y = yearly, P1W = weekly)",
    "type": "string"
   },
   "defaultLanguage": {
    "description": "Default language code (e.g., \"en-US\")",
    "type": "string"
   },
   "description": {
    "description": "Subscription description",
    "type": "string"
   },
   "productId": {
    "description": "Unique subscription product ID",
    "type": "string"
   },
   "title": {
    "description": "Subscription title",
    "type": "string"
   }
  },
  "required": [
   "productId",
   "defaultLanguage",
   "title",
   "basePlanId",
   "billingPeriod"
  ],
  "type": "object"
 },
 "name": "gpc_create_subscription"
}
