{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "customer",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Book (creates a real reservation)"
 },
 "description": "Creates a REAL booking from a hold. Call only after the user explicitly confirmed time and price. Needs the user's name and at least one contact: phone, email or Telegram. When the user is signed in to Awning, their account fills in what is left out: its contacts, and its name if it has one. Pass the same idempotency_key when retrying.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "additionalProperties": {},
    "description": "Where to come or deliver, e.g. {\"line1\":\"Rawai Beach Resort\"}",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "customer": {
    "properties": {
     "email": {
      "maxLength": 200,
      "type": "string"
     },
     "language": {
      "maxLength": 10,
      "type": "string"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "phone": {
      "maxLength": 40,
      "type": "string"
     },
     "telegram": {
      "maxLength": 64,
      "type": "string"
     },
     "timezone": {
      "maxLength": 64,
      "type": "string"
     }
    },
    "type": "object"
   },
   "hold_id": {
    "type": "string"
   },
   "idempotency_key": {
    "description": "Random string; reuse it on retries",
    "maxLength": 100,
    "minLength": 8,
    "type": "string"
   },
   "intake_answers": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "note": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "hold_id"
  ],
  "type": "object"
 },
 "name": "create_booking",
 "title": "Book (creates a real reservation)"
}
