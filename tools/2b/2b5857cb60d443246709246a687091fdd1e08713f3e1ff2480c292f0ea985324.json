{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change several Settings fields in one call. Needs the write scope, which is open when auth mode is off. For one Settings form with the page's admin sign-in, use set_clock, set_auth_mode, set_audit, set_rate_limit, set_protocols, set_ui_auth, set_tool_gate, set_tool_lock, or set_push",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alarmTime": {
    "description": "Empty, or HH:MM such as 07:30. The HTTP process pushes once when the saved time zone hits that minute. Leave empty to clear it.",
    "type": "string"
   },
   "auditMode": {
    "type": "boolean"
   },
   "authMode": {
    "enum": [
     "off",
     "write",
     "all"
    ],
    "type": "string"
   },
   "clientPush": {
    "description": "Allow push_quote to send the current line to GET /events immediately.",
    "type": "boolean"
   },
   "defaultCount": {
    "description": "Lines returned when count is omitted.",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "defaultSource": {
    "description": "literature, books, mix, surprise, or a voice id.",
    "type": "string"
   },
   "hourClock": {
    "description": "12-hour or 24-hour clock in the header and on the clock page.",
    "enum": [
     "12",
     "24"
    ],
    "type": "string"
   },
   "mqttClearPassword": {
    "description": "Remove the saved MQTT password.",
    "type": "boolean"
   },
   "mqttClientId": {
    "description": "Default literature-clock.",
    "type": "string"
   },
   "mqttEnabled": {
    "description": "Publish the same quote JSON to an MQTT broker.",
    "type": "boolean"
   },
   "mqttPassword": {
    "description": "Stored for the broker. get_settings never returns it. Omit to keep the saved password.",
    "type": "string"
   },
   "mqttTopic": {
    "description": "Broker topic. Default literature-clock/quote.",
    "type": "string"
   },
   "mqttUrl": {
    "description": "mqtt://host:port or mqtts://host:port. Put the username and password in their own fields.",
    "type": "string"
   },
   "mqttUsername": {
    "type": "string"
   },
   "pushEvents": {
    "description": "Push on GET /events as an SSE event named quote.",
    "type": "boolean"
   },
   "pushEveryMinutes": {
    "description": "0 is off. Otherwise 5, 10, 15, 30, or 60. The HTTP process pushes the current quote on that interval.",
    "type": "integer"
   },
   "pushHttp": {
    "description": "Push that notification on open Streamable HTTP sessions.",
    "type": "boolean"
   },
   "pushSse": {
    "description": "Push notifications/literature-clock/quote on open legacy SSE sessions.",
    "type": "boolean"
   },
   "rateLimit": {
    "description": "Calls allowed per window.",
    "minimum": 1,
    "type": "integer"
   },
   "rateLimitEnabled": {
    "type": "boolean"
   },
   "rateLimitWindowSec": {
    "minimum": 1,
    "type": "integer"
   },
   "sseEnabled": {
    "description": "GET /sse. At least one protocol must stay on.",
    "type": "boolean"
   },
   "stdioEnabled": {
    "description": "stdio transport. At least one protocol must stay on.",
    "type": "boolean"
   },
   "streamableHttpEnabled": {
    "description": "POST /mcp. At least one protocol must stay on.",
    "type": "boolean"
   },
   "timeZone": {
    "description": "device, or an IANA zone such as America/Toronto.",
    "type": "string"
   },
   "tool": {
    "description": "One tool name to enable, disable, or lock.",
    "type": "string"
   },
   "toolEnabled": {
    "type": "boolean"
   },
   "toolRequireAuth": {
    "description": "Require a credential for this tool even when auth mode is off.",
    "type": "boolean"
   },
   "uiRequireAuth": {
    "description": "Hide the HTML pages until someone signs in at /admin.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "update_settings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeApiKeys": {
    "type": "number"
   },
