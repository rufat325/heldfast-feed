      "type": "string"
     },
     "destinations": {
      "additionalProperties": false,
      "properties": {
       "events": {
        "type": "boolean"
       },
       "mqtt": {
        "type": "boolean"
       },
       "sse": {
        "type": "boolean"
       },
       "streamableHttp": {
        "type": "boolean"
       }
      },
      "required": [
       "events",
       "sse",
       "streamableHttp",
       "mqtt"
      ],
      "type": "object"
     },
     "everyMinutes": {
      "type": "number"
     },
     "last": {
      "additionalProperties": false,
      "properties": {
       "at": {
        "type": "string"
       },
       "error": {
        "type": "string"
       },
       "ok": {
        "type": "boolean"
       },
       "time": {
        "type": "string"
       }
      },
      "required": [
       "at",
       "time",
       "ok",
       "error"
      ],
      "type": "object"
     },
     "live": {
      "additionalProperties": false,
      "properties": {
       "events": {
        "type": "number"
       },
       "sse": {
        "type": "number"
       },
       "streamableHttp": {
        "type": "number"
       }
      },
      "required": [
       "events",
       "sse",
       "streamableHttp"
      ],
      "type": "object"
     },
     "mqtt": {
      "additionalProperties": false,
      "properties": {
       "clientId": {
        "type": "string"
       },
       "passwordSet": {
        "type": "boolean"
       },
       "topic": {
        "type": "string"
       },
       "url": {
        "type": "string"
       },
       "username": {
        "type": "string"
       }
      },
      "required": [
       "url",
       "topic",
       "username",
       "clientId",
       "passwordSet"
      ],
      "type": "object"
     }
    },
    "required": [
     "everyMinutes",
     "alarmTime",
     "destinations",
     "mqtt",
     "live",
     "last"
    ],
    "type": "object"
   },
   "rateLimit": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "limit": {
      "type": "number"
     },
     "windowMs": {
      "type": "number"
     }
    },
    "required": [
     "enabled",
     "limit",
     "windowMs"
    ],
    "type": "object"
   },
   "tools": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "enabled": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "requireAuth": {
       "type": "boolean"
      },
      "scope": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "scope",
      "enabled",
      "requireAuth"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "uiRequireAuth": {
    "type": "boolean"
   },
   "version": {
    "description": "Package version shown in the page header.",
    "type": "string"
   }
  },
  "required": [
   "ok",
   "version",
   "clock",
   "authMode",
   "authModes",
   "rateLimit",
   "auditMode",
   "protocols",
   "uiRequireAuth",
   "push",
   "tools",
   "activeApiKeys",
   "next"
  ],
  "type": "object"
 },
 "title": "Update settings"
}
