{
 "description": "Update a resource folder (rename, recolor, reorder, reprice, or move). parent_folder_id=null moves it to top level; moving a folder into itself or a descendant is rejected. Only supplied fields change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "description": "#RRGGBB hex color",
    "pattern": "^#[0-9A-Fa-f]{6}$",
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "icon": {
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "parent_folder_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "position": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "price": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "hivelearn_update_resource_folder"
}
