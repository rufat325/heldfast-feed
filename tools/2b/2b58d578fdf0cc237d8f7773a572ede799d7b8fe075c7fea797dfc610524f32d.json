{
 "description": "Submit feedback entry (issue, status report, security alert, feature request, etc.).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "context": {
    "additionalProperties": true,
    "properties": {
     "clientInfo": {
      "properties": {
       "name": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "environment": {
      "additionalProperties": true,
      "type": "object"
     },
     "requestId": {
      "type": "string"
     },
     "serverVersion": {
      "type": "string"
     },
     "sessionId": {
      "type": "string"
     },
     "toolName": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "description": {
    "maxLength": 10000,
    "type": "string"
   },
   "metadata": {
    "additionalProperties": true,
    "type": "object"
   },
   "severity": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   },
   "type": {
    "enum": [
     "issue",
     "status",
     "security",
     "feature-request",
     "bug-report",
     "performance",
     "usability",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "severity",
   "title",
   "description"
  ],
  "type": "object"
 },
 "name": "feedback_submit"
}
