{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a DRM policy. Disable any site using this policy before updating.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "drmPolicyConfig": {
    "additionalProperties": false,
    "description": "Per-DRM policy settings (widevine/playready/fairplay)",
    "properties": {
     "fairplay": {
      "additionalProperties": false,
      "description": "FairPlay Streaming policy configuration",
      "properties": {
       "allowAirPlay": {
        "description": "Allow AirPlay playback",
        "type": "boolean"
       },
       "allowAvAdaptor": {
        "description": "Allow digital AV adapter output",
        "type": "boolean"
       },
       "hdcpEnforcement": {
        "description": "HDCP enforcement: '-1' (none), '0' (Type 0), '1' (Type 1)",
        "type": "string"
       },
       "useYn": {
        "description": "Enable/disable FairPlay Streaming",
        "type": "boolean"
       }
      },
      "required": [
       "useYn"
      ],
      "type": "object"
     },
     "playready": {
      "additionalProperties": false,
      "description": "PlayReady policy configuration",
      "properties": {
       "analogVideoProtectionLevel": {
        "description": "Analog video protection: 100, 150, 200, 201",
        "type": "number"
       },
       "digitalAudioProtectionLevel": {
        "description": "Digital audio protection: 100, 250, 300, 301",
        "type": "number"
       },
       "digitalVideoProtectionLevel": {
        "description": "Digital video protection: 100, 250, 270, 300, 301",
        "type": "number"
       },
       "hdcpUseYn": {
        "description": "Require HDCP 2.2+ (Type 1)",
        "type": "boolean"
       },
       "securityLevel": {
        "description": "Security level: 150, 2000, 3000",
        "type": "number"
       },
       "useYn": {
        "description": "Enable/disable PlayReady",
        "type": "boolean"
       }
      },
      "required": [
       "useYn"
      ],
      "type": "object"
     },
     "widevine": {
      "additionalProperties": false,
      "description": "Widevine policy configuration",
      "properties": {
       "cgms": {
        "description": "Analog output security (CGMS)",
        "enum": [
         "CGMS_NONE",
         "COPY_FREE",
         "COPY_ONCE",
         "COPY_NEVER"
        ],
        "type": "string"
       },
       "deviceRevocation": {
        "description": "Allow licenses for revoked Android devices",
        "type": "boolean"
       },
       "disableAnalogOutputYn": {
        "description": "Block analog output",
        "type": "boolean"
       },
       "hdcp": {
        "description": "HDCP level",
        "enum": [
         "HDCP_NONE",
         "HDCP_V1",
         "HDCP_V2",
         "HDCP_V2_1",
         "HDCP_V2_2",
         "HDCP_NO_DIGITAL_OUTPUT"
        ],
        "type": "string"
       },
       "hdcpSrmRule": {
        "description": "SRM handling",
        "enum": [
         "HDCP_SRM_RULE_NONE",
         "CURRENT_SRM"
        ],
        "type": "string"
       },
       "securityLevel": {
        "description": "Security level 1-5 (higher = stronger)",
        "type": "number"
       },
       "useYn": {
        "description": "Enable/disable Widevine",
        "type": "boolean"
       }
      },
      "required": [
       "useYn"
      ],
      "type": "object"
     }
    },
    "required": [
     "widevine",
     "playready",
     "fairplay"
    ],
    "type": "object"
   },
   "persistent": {
    "description": "Offline license retention",
    "type": "boolean"
   },
   "playbackDuration": {
    "description": "License validity in seconds from first playback (0~2147483647)",
    "type": "number"
   },
   "policyId": {
    "description": "DRM policy ID to update",
    "type": "number"
   },
   "policyName": {
    "description": "Policy name (3-20 chars: letters, numbers, '_')",
    "type": "string"
   },
   "rentalDuration": {
    "description": "Seconds until first playback (0~2147483647)",
    "type": "number"
   }
  },
  "required": [
   "policyId",
   "policyName",
   "persistent",
   "rentalDuration",
   "playbackDuration",
   "drmPolicyConfig"
  ],
  "type": "object"
 },
 "name": "ncloud_drm_update_policy"
}
