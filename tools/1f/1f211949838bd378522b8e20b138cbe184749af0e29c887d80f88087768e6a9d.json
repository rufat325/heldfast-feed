 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search India property listings"
 },
 "description": "Search residential property listings anywhere in Tamil Nadu, India \u2014 any city or town. Use when the user names a place, locality, price band, BHK, or transaction type. Returns sanitized listing cards with handoff URLs and a per-listing verification summary (verified + caveats); never returns seller contact details. Places outside Tamil Nadu return supported=false + scopeMessage \u2014 surface it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {
   "bedrooms": {
    "description": "Number of bedrooms (BHK).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "city": {
    "description": "City or town in Tamil Nadu (e.g., \"Coimbatore\", \"Madurai\"). Omit to search every Tamil Nadu city.",
    "maxLength": 60,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "furnishing": {
    "description": "Furnishing status (rental queries).",
    "enum": [
     "furnished",
     "semi-furnished",
     "unfurnished"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of listings to return (cap: 20). v1 abuse defense.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locality": {
    "description": "Locality/neighborhood within the city (e.g., \"Saravanampatti\").",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9 .,'\u2019()\\-\u0b80-\u0bff\u0900-\u097f]+$",
    "type": "string"
   },
   "maxPrice": {
    "description": "Maximum price in INR.",
    "minimum": 0,
    "type": "integer"
   },
   "minPrice": {
    "description": "Minimum price in INR.",
    "minimum": 0,
    "type": "integer"
   },
   "propertyType": {
    "description": "Property type.",
    "enum": [
     "apartment",
     "villa",
     "plot",
     "independent_house"
    ],
    "type": "string"
   },
   "rentalStructure": {
    "description": "Rental money structure: monthly rent, or a lump-sum lease (one refundable amount for a fixed tenure, no monthly rent). Only meaningful with transactionType=rent. Omit to include both.",
    "enum": [
     "monthly",
     "lease"
    ],
    "type": "string"
   },
   "transactionType": {
    "description": "Whether to search for sale or rent. Omit to include both.",
    "enum": [
     "sale",
     "rent"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
