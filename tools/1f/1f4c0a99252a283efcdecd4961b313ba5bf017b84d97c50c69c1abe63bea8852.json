{"description":"Move files/folders to destination folder. Returns oldParents for undo. Use \"root\" for My Drive root.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"destinationFolderId":{"description":"Destination folder ID (use \"root\" for My Drive root)","minLength":1,"type":"string"},"fileIds":{"anyOf":[{"minLength":1,"type":"string"},{"items":{"minLength":1,"type":"string"},"maxItems":100,"minItems":1,"type":"array"}],"description":"File or folder ID(s) to move. Single ID or array (max 100 for batch)"},"returnOldParents":{"description":"Include old parent IDs in response for manual undo (recommended: true)","type":"boolean"}},"required":["fileIds","destinationFolderId"],"type":"object"},"name":"file-move","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"result":{"oneOf":[{"additionalProperties":false,"properties":{"failed":{"description":"Files that failed to move","items":{"additionalProperties":false,"properties":{"code":{"description":"API error code if available","type":"string"},"error":{"description":"Error message explaining the failure","type":"string"},"fileId":{"description":"ID of the file that failed to move","type":"string"}},"required":["fileId","error"],"type":"object"},"type":"array"},"moved":{"description":"Successfully moved files","items":{"additionalProperties":false,"properties":{"fileId":{"description":"ID of the moved file","type":"string"},"fileName":{"description":"Name of the moved file","type":"string"},"newParent":{"description":"New parent folder ID","type":"string"},"oldParents":{"description":"Previous parent folder IDs (for undo)","items":{"type":"string"},"type":"array"},"webViewLink":{"description":"URL to view the file","type":"string"}},"required":["fileId","fileName","oldParents","newParent"],"type":"object"},"type":"array"},"totalFailed":{"description":"Number of files that failed to move","type":"number"},"totalMov