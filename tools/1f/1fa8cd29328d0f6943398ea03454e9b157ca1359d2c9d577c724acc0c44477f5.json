        "type": "string"
       },
       "type": "array"
      },
      "priceRange": {
       "properties": {
        "currency": {
         "type": "string"
        },
        "max": {
         "type": "number"
        },
        "min": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "queueDepth": {
       "type": "number"
      },
      "type": {
