{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false
 },
 "description": "Resolve and close a support ticket (destructive, idempotent). Sets status to solved and records resolved_at. Optionally appends resolution as the final comment. If the ticket is already solved this is a no-op and returns alreadyClosed=true \u2014 do not retry. Use a real ticket_id from run_query schema=tickets. Use add_comment first if you want a longer explanation before closing. This is a write tool and may require a credential.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "closed_by": {
    "description": "Who is closing, e.g. support@example.com. Defaults to the service account.",
    "type": "string"
   },
   "resolution": {
    "description": "Optional note appended as the final comment, e.g. Fixed by using an absolute cwd in mcp.json.",
    "type": "string"
   },
   "ticket_id": {
    "description": "Existing ticket id from run_query schema=tickets. Format: TCK-1001. Do not invent an id.",
    "type": "string"
   }
  },
  "required": [
   "ticket_id"
  ],
  "type": "object"
 },
 "name": "close_ticket",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alreadyClosed": {
    "type": "boolean"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "ticket": {
    "additionalProperties": false,
    "properties": {
     "attribution": {
      "enum": [
       "customer",
       "service_account"
      ],
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "comments": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "at": {
         "type": "string"
        },
        "author": {
         "type": "string"
        },
        "body": {
         "type": "string"
        }
       },
       "required": [
        "author",
        "body",
        "at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "created_at": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "requester_email": {
      "type": "string"
     },
     "resolved_at": {
      "type": "string"
     },
     "status": {
      "enum": [
       "open",
       "pending",
       "solved"
      ],
      "type": "string"
     },
     "subject": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "subject",
     "body",
     "status",
     "requester_email",
     "attribution",
     "comments",
     "created_at"
    ],
    "type": "object"
   }
  },
  "required": [
   "ok",
   "ticket",
   "alreadyClosed"
  ],
  "type": "object"
 }
}
