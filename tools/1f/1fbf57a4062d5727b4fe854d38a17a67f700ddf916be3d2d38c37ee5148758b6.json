{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Execute one local browser action and return the updated snapshot. Match accessible roles/names from the snapshot. Actions count toward the session step limit. done records the planner outcome; it does not independently verify success.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "command": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "goto",
        "type": "string"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "action",
       "url"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "click",
        "type": "string"
       },
       "target": {
        "additionalProperties": false,
        "properties": {
         "index": {
          "description": "Zero-based index for duplicate names",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "name": {
          "description": "Exact accessible name from the snapshot",
          "maxLength": 500,
          "type": "string"
         },
         "role": {
          "description": "Accessible role, e.g. button, link, textbox",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "role",
         "name"
        ],
        "type": "object"
       }
      },
      "required": [
       "action",
       "target"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "fill",
        "type": "string"
       },
       "target": {
        "additionalProperties": false,
        "properties": {
         "index": {
          "description": "Zero-based index for duplicate names",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "name": {
          "description": "Exact accessible name from the snapshot",
          "maxLength": 500,
          "type": "string"
         },
         "role": {
          "description": "Accessible role, e.g. button, link, textbox",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "role",
         "name"
        ],
        "type": "object"
       },
       "text": {
        "maxLength": 20000,
        "type": "string"
       }
      },
      "required": [
       "action",
       "target",
       "text"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "press",
        "type": "string"
       },
       "key": {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       "target": {
        "additionalProperties": false,
        "properties": {
         "index": {
          "description": "Zero-based index for duplicate names",
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "name": {
          "description": "Exact accessible name from the snapshot",
          "maxLength": 500,
          "type": "string"
         },
         "role": {
          "description": "Accessible role, e.g. button, link, textbox",
          "maxLength": 40,
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "role",
         "name"
        ],
        "type": "object"
       }
      },
      "required": [
       "action",
       "key"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "scroll",
        "type": "string"
       },
       "y": {
        "maximum": 5000,
        "minimum": -5000,
        "type": "number"
       }
      },
      "required": [
       "action",
       "y"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "wait",
        "type": "string"
       },
       "ms": {
        "maximum": 5000,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "action",
       "ms"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "tab",
        "type": "string"
       },
       "index": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "action",
       "index"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "done",
        "type": "string"
       },
       "text": {
        "maxLength": 2000,
        "type": "string"
       }
      },
      "required": [
       "action",
       "text"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "command"
  ],
  "type": "object"
 },
 "name": "browser_action"
}
