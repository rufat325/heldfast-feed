{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Extract fields as JSON"
 },
 "description": "Structured data extraction / text to JSON: pull the fields you name out of any text into a JSON object with exactly those keys, null where the text does not state a value (Gemini, no invented values). Use it to turn emails, invoices, pages or documents into clean records. Input: text, fields[]. From a live web page: research.page_facts. $0.25 per call. Returns: fields{} with one key per requested field.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "fields": {
    "description": "Field names to extract.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "language": {
    "description": "Optional answer language, BCP-47 (en, ja, pt-BR). Default: the input's.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "fields"
  ],
  "type": "object"
 },
 "name": "hubvibe_llm_extract",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "attribution": {
    "items": {},
    "type": "array"
   },
   "billing_warning": {
    "type": "string"
   },
   "price_usd": {
    "type": "number"
   },
   "provenance": {
    "type": "object"
   },
   "receipt_id": {
    "type": "string"
   },
   "receipt_url": {
    "type": "string"
   },
   "result": {
    "type": "object"
   },
   "status": {
    "const": "ok",
    "type": "string"
   },
   "worker": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "worker",
   "price_usd",
   "result",
   "provenance",
   "receipt_id",
   "receipt_url"
  ],
  "type": "object"
 },
 "title": "Extract fields as JSON"
}
