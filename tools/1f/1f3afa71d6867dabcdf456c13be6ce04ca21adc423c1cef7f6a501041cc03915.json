{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update alt text and/or metadata for an existing image",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "alt_text": {
    "description": "New alt text value",
    "maxLength": 1000,
    "type": "string"
   },
   "asset_id": {
    "description": "The asset ID of the image to update",
    "maxLength": 256,
    "type": "string"
   },
   "lang": {
    "description": "Language code for the alt text (default: 'en')",
    "maxLength": 64,
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {
     "maxLength": 256,
     "type": "string"
    },
    "description": "Replace metadata (string key-value pairs)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "overwrite": {
    "description": "If false, skip language entries that already exist",
    "type": "boolean"
   },
   "tags": {
    "description": "Replace tags",
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "asset_id"
  ],
  "type": "object"
 },
 "name": "update_image",
 "title": "Update Image"
}
