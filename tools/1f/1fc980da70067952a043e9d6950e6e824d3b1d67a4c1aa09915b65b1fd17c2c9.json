{
 "description": "Send an email. If inbox_id is omitted, uses the default inbox (auto-created if needed).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "html": {
    "description": "HTML body",
    "type": "string"
   },
   "inbox_id": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "string"
     }
    ],
    "description": "Inbox ID to send from (optional, uses default inbox)"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "text": {
    "description": "Plain text body",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address",
    "type": "string"
   }
  },
  "required": [
   "to",
   "subject"
  ],
  "type": "object"
 },
 "name": "send_email"
}
