{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Store a refund rule the user has explicitly approved. matchTerms must name a specific situation. The word refund alone is not a rule. remedy is the only wording that may later be approved. decision ALLOW grants that wording. decision DENY refuses a refund and records the denial script.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "decision": {
    "enum": [
     "ALLOW",
     "DENY"
    ],
    "type": "string"
   },
   "deskId": {
    "format": "uuid",
    "type": "string"
   },
   "expectedRevision": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "matchTerms": {
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "remedy": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "default": "APPROVED",
    "enum": [
     "APPROVED",
     "RETIRED"
    ],
    "type": "string"
   },
   "windowDays": {
    "anyOf": [
     {
      "maximum": 3650,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "deskId",
   "name",
   "matchTerms",
   "decision",
   "remedy"
  ],
  "type": "object"
 },
 "name": "save_refund_rule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "save refund rule"
}
