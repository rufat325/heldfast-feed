{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Post a native Discord poll: a question, two to ten answers, and a duration of up to 32 days.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "answers": {
    "items": {
     "maxLength": 55,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "channel": {
    "description": "Channel name or ID.",
    "type": "string"
   },
   "content": {
    "description": "Optional message text above the poll.",
    "maxLength": 2000,
    "type": "string"
   },
   "duration_hours": {
    "description": "How long the poll runs. Default 24.",
    "maximum": 768,
    "minimum": 1,
    "type": "integer"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "multi_select": {
    "description": "Allow choosing several answers.",
    "type": "boolean"
   },
   "question": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "channel",
   "question",
   "answers"
  ],
  "type": "object"
 },
 "name": "create_poll",
 "title": "Create poll"
}
