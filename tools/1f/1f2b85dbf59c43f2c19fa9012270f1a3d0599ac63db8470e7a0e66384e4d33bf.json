{
 "description": "Fetch row data from a specific range in A1 notation. Best used after values-search to get surrounding context. Use a1-notation prompt for syntax reference.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "range": {
    "description": "A1 notation range to fetch (e.g., \"B5\", \"A5:D5\", \"B:B\", \"5:5\")",
    "minLength": 1,
    "type": "string"
   },
   "render": {
    "description": "How to render cell values. FORMATTED_VALUE (default): calculated with formatting. UNFORMATTED_VALUE: calculated without formatting. FORMULA: show formula text instead of result.",
    "enum": [
     "FORMATTED_VALUE",
     "UNFORMATTED_VALUE",
     "FORMULA"
    ],
    "type": "string"
   }
  },
  "required": [
   "id",
   "gid",
   "range"
  ],
  "type": "object"
 },
 "name": "rows-get",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "range": {
        "description": "The A1 notation range that was retrieved",
        "type": "string"
       },
       "rows": {
        "description": "2D array of row data (each inner array is a row)",
        "items": {
         "items": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "number"
           },
           {
            "const": null,
            "type": "number"
           },
           {
            "const": null,
            "type": "number"
           },
           {
            "type": "boolean"
           },
           {
            "type": "null"
           }
          ]
         },
         "type": "array"
        },
        "type": "array"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "range",
       "rows"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
