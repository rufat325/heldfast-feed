{
 "description": "Record that you touched a file. If a task key is given, the response reports files other agents already changed for that task (conflict awareness).",
 "inputSchema": {
  "properties": {
   "agent": {
    "description": "acting agent identity (defaults to OCTOBOARD_AGENT)",
    "type": "string"
   },
   "change": {
    "default": "modified",
    "enum": [
     "added",
     "modified",
     "deleted"
    ],
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "task": {
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "board_file_changed"
}
