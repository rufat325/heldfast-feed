{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Page search trend over time"
 },
 "description": "Return how ONE page's Google Search performance changed over time. Pass start_date and end_date together as inclusive JST dates; comparison dates are not supported. Omitting both preserves the current now-minus-30-days rolling window, which may touch 31 JST dates because GSC filters by date inclusively. Explicit dates are converted to JST day boundaries for GSC rows. `granularity` defaults to day for windows up to about 35 days and week for longer windows; pass it to override. Buckets without GSC rows are omitted. Google-search only; data lags 1-2 days. site_id is optional when OAuth-authenticated. For cross-page snapshots use get_breakdown(dimension='page'); for query trends use get_keyword_performance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_date": {
    "$ref": "#/properties/start_date"
   },
   "granularity": {
    "enum": [
     "day",
     "week"
    ],
    "type": "string"
   },
   "page": {
    "minLength": 1,
    "type": "string"
   },
   "site_id": {
    "format": "uuid",
    "type": "string"
   },
   "start_date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "page"
  ],
  "type": "object"
 },
 "name": "get_page_trend",
