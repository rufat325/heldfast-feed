{
 "description": "Generate a cron expression from common schedule descriptions or explicit fields",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "day_of_month": {
    "default": "*",
    "description": "Day of month field (1-31, *, */n)",
    "type": "string"
   },
   "day_of_week": {
    "default": "*",
    "description": "Day of week field (0-7, *, 0=Sunday, MON-SUN)",
    "type": "string"
   },
   "hour": {
    "default": "*",
    "description": "Hour field (0-23, *, */n, or comma-separated)",
    "type": "string"
   },
   "minute": {
    "default": "0",
    "description": "Minute field (0-59, *, */n, or comma-separated)",
    "type": "string"
   },
   "month": {
    "default": "*",
    "description": "Month field (1-12, *, */n, or JAN-DEC)",
    "type": "string"
   },
   "preset": {
    "description": "Common schedule description (e.g. 'every 5 minutes', 'every day at midnight', 'every weekday')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_cron_expression"
}
