{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Edits the maintenance entry itself: title, description, time window, list of affected servers. This does not append a timeline message \u2014 use `status_page_maintenance_update_add` for progress updates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Set to true to authorize this write/destructive call even if STATUSER_ALLOW_WRITE is not enabled in the server config. Required for one-off overrides.",
    "type": "boolean"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "ended_at": {
    "type": "string"
   },
   "maintenance_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "servers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "description": "Status-page server id (from `status_page_get`).",
       "exclusiveMinimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "started_at": {
    "type": "string"
   },
   "status_page_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "title": {
    "maxLength": 255,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "status_page_id",
   "maintenance_id"
  ],
  "type": "object"
 },
 "name": "status_page_maintenance_update",
 "title": "Edit planned maintenance fields"
}
