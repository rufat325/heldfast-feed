{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "rank"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Pages whose Search Console position got worse, whose clicks fell, or that disappeared from the current response. Does not invent zeros for pages the current response omitted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compareEndDate": {
    "$ref": "#/properties/startDate"
   },
   "compareStartDate": {
    "$ref": "#/properties/startDate"
   },
   "country": {
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "device": {
    "enum": [
     "DESKTOP",
     "MOBILE",
     "TABLET"
    ],
    "type": "string"
   },
   "endDate": {
    "$ref": "#/properties/startDate"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "searchType": {
    "enum": [
     "web",
     "image",
     "video",
     "news",
     "discover",
     "googleNews"
    ],
    "type": "string"
   },
   "siteUrl": {
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "startDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "siteUrl"
  ],
  "type": "object"
 },
 "name": "dropped_pages",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "Dropped pages"
}
