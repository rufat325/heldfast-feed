{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Build the semantic index for specific books (required: bookId, ids, or query \u2014 full-library indexing is deferred). Extracts, chunks, and embeds each book. Set keywordOnly=true (or when the embedding model is absent, it happens automatically) to build a keyword-only index that powers mode:\"keyword\" search with zero ML dependencies. Re-run after adding books; use force to re-index unchanged ones. Set prune=true to also drop index entries for books that no longer exist in the library (removals/merges leave searchable orphans behind).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bookId": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "enableFts": {
    "type": "boolean"
   },
   "force": {
    "type": "boolean"
   },
   "ids": {
    "items": {
     "anyOf": [
      {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      {
       "minLength": 1,
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "keywordOnly": {
    "type": "boolean"
   },
   "library": {
    "type": "string"
   },
   "prune": {
    "type": "boolean"
   },
   "query": {
    "maxLength": 512,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "calibre_build_index",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bookDetails": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "backend": {
       "type": "string"
      },
      "bookId": {
       "type": "number"
      },
      "cached": {
       "type": "boolean"
      },
      "chars": {
       "type": "number"
      },
      "chunks": {
       "type": "number"
      },
      "figures": {
       "type": "number"
      },
      "format": {
       "type": "string"
      },
      "frontMatterChunks": {
       "type": "number"
      },
      "unplaced": {
       "type": "number"
      }
     },
     "required": [
      "bookId",
      "format",
      "backend",
      "cached",
      "chars",
      "chunks",
      "frontMatterChunks",
      "figures",
      "unplaced"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "booksIndexed": {
    "type": "number"
   },
   "booksRequested": {
    "type": "number"
   },
   "booksSkipped": {
    "type": "number"
   },
   "chunks": {
    "type": "number"
   },
   "elapsedMs": {
    "type": "number"
   },
   "failures": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "figures": {
    "type": "number"
   },
   "keywordOnly": {
    "type": "boolean"
   },
   "prunedBooks": {
    "type": "number"
   },
   "prunedChunks": {
    "type": "number"
   },
   "prunedFigures": {
    "type": "number"
   },
   "semanticAvailable": {
    "type": "boolean"
   },
   "semanticReason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Build semantic index"
}
