          "totals"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "dimension",
       "lastDate",
       "rows"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "datesPresent": {
