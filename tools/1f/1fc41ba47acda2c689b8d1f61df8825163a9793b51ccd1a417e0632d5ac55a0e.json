{
 "description": "Read Google Play bulk reports for an app: active device installs and store-listing visitors and acquisitions by traffic source. installsDimension picks which installs breakdown is read (overview, country, language, device, os_version, carrier or app_version), include adds the ratings, crashes and reviews report families, and startDate with endDate reads every month the window touches instead of the single month in month. Reads the reporting bucket named by SEO_MCP_PLAY_BUCKET; read-only",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "crashesDimension": {
    "default": "app_version",
    "description": "Dimension for the crashes report",
    "enum": [
     "device",
     "os_version",
     "app_version"
    ],
    "type": "string"
   },
   "endDate": {
    "description": "Window end in YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "include": {
    "default": [],
    "description": "Extra report families to read. Missing files are normal: Google emits a report only when there is something to report",
    "items": {
     "enum": [
      "ratings",
      "crashes",
      "reviews"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "installsDimension": {
    "default": "overview",
    "description": "Which installs report to read. overview is undocumented by Google but present in real buckets; the others are the documented breakdowns",
    "enum": [
     "overview",
     "country",
     "language",
     "device",
     "os_version",
     "carrier",
     "app_version"
    ],
    "type": "string"
   },
   "month": {
    "description": "Report month as YYYYMM; defaults to the current UTC month. Ignored when startDate and endDate are given",
    "pattern": "^\\d{6}$",
    "type": "string"
   },
   "packageName": {
    "description": "Android package name, e.g. app.getpsst",
    "maxLength": 200,
    "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$",
    "type": "string"
   },
   "ratingsDimension": {
    "default": "country",
    "description": "Dimension for the ratings report",
    "enum": [
     "country",
     "language",
     "device",
     "os_version",
     "carrier",
     "app_version"
    ],
    "type": "string"
   },
   "startDate": {
    "description": "Window start in YYYY-MM-DD. With endDate, reads every month the window touches and filters rows to it",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "storePerformanceDimension": {
    "default": "traffic_source",
    "description": "Which store performance breakdown to read",
    "enum": [
     "traffic_source",
     "country"
    ],
    "type": "string"
   },
   "storePerformanceTotals": {
    "default": false,
    "description": "Read the total_ variant instead. It is a different report, not a rollup of the same one: it carries acquisitions only, with no visitors and no conversion rate, and for some apps it covers far fewer dates and attributes every acquisition to a placeholder source",
    "type": "boolean"
   }
  },
  "required": [
   "packageName"
  ],
  "type": "object"
 },
 "name": "play_store_stats",
