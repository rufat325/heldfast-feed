             {
              "type": "number"
             },
             {
              "type": "string"
             }
            ]
           },
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          },
          "totals": {
           "additionalProperties": {
            "type": "number"
           },
           "propertyNames": {
