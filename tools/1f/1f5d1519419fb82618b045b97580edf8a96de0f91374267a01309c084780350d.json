{
 "description": "[OPERATOR] Create a new task with roles, deliverables, and acceptance criteria.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "acceptance_criteria": {
    "description": "What 'done' looks like",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "deadline": {
    "description": "ISO 8601 deadline",
    "type": "string"
   },
   "deliverables": {
    "description": "Expected outputs",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "format": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "produced_by": {
       "description": "Which role produces this",
       "type": "string"
      }
     },
     "required": [
      "name",
      "description",
      "format",
      "produced_by"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "What needs to be done",
    "type": "string"
   },
   "roles": {
    "description": "Roles needed for this task",
    "items": {
     "properties": {
      "allowed_scopes": {
       "description": "What this role CAN do",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "description": "What this role does",
       "type": "string"
      },
      "forbidden_scopes": {
       "description": "What this role CANNOT do",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "required_capabilities": {
       "description": "Agent must have these capabilities",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "role": {
       "description": "Role name (researcher, analyst, builder, reviewer, or custom)",
       "type": "string"
      }
     },
     "required": [
      "role",
      "description",
      "allowed_scopes",
      "forbidden_scopes"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "Task title",
    "type": "string"
   }
  },
  "required": [
   "title",
   "description",
   "roles",
   "deliverables",
   "acceptance_criteria"
  ],
  "type": "object"
 },
 "name": "create_task_brief"
}
