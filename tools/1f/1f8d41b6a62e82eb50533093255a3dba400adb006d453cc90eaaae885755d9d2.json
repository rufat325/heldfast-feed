{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an agreed category for an explicit brand_id. List that brand first to avoid slug conflicts. Reuse the stable operation key and exact body after a lost response; never rotate a key to evade a 409.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": false,
    "description": "Create a category.",
    "properties": {
     "brand_id": {
      "format": "uuid",
      "title": "Brand Id",
      "type": "string"
     },
     "color": {
      "anyOf": [
       {
        "pattern": "^#[0-9A-Fa-f]{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Color"
     },
     "description": {
      "anyOf": [
       {
        "maxLength": 500,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Description"
     },
     "icon": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Icon"
     },
     "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "parent_id": {
      "anyOf": [
       {
        "format": "uuid",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Parent Id"
     },
     "slug": {
      "anyOf": [
       {
        "maxLength": 100,
        "minLength": 1,
        "pattern": "^[a-z0-9-]+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Slug"
     },
     "sort_order": {
      "default": 0,
      "title": "Sort Order",
      "type": "integer"
     }
    },
    "required": [
     "brand_id",
     "name"
    ],
    "title": "PublicCategoryCreate",
    "type": "object"
   },
   "idempotency_key": {
    "description": "Stable operation key. Reuse for the same request after a dropped response; use a new key for a new intended operation.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[!-~]+$",
    "type": "string"
   }
  },
  "required": [
   "body",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_category"
}
