{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Find meeting overlap"},"description":"Given 2-5 IANA time zones (e.g. America/New_York, Europe/London, Asia/Tokyo), a local working window applied in every zone (default 09:00-17:00) and up to 7 calendar days, returns up to 5 ranked meeting slots in UTC with each zone's local time, UTC offset and abbreviation, DST-aware, plus an optional ICS event for the top slot. Read-only, pure computation (no calendars are read). Same engine as POST /v1/overlap on the free BASIC plan.","inputSchema":{"additionalProperties":false,"properties":{"days":{"description":"Dates YYYY-MM-DD (default: today + 6 days, UTC)","items":{"maxLength":10,"pattern":"^[0-9]{4}-[0-9]{2}-[0-9]{2}$","type":"string"},"maxItems":7,"type":"array"},"duration_minutes":{"description":"Meeting length in minutes (default 30)","maximum":480,"minimum":5,"type":"integer"},"include_ics":{"description":"Include an ICS VEVENT for the top slot (default true)","type":"boolean"},"limit":{"description":"Max ranked slots (default 5, max 5)","maximum":5,"minimum":1,"type":"integer"},"work_hours":{"additionalProperties":false,"description":"Local working window applied in each zone (default 09:00-17:00)","properties":{"end":{"maxLength":5,"pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","type":"string"},"start":{"maxLength":5,"pattern":"^([01][0-9]|2[0-3]):[0-5][0-9]$","type":"string"}},"required":["start","end"],"type":"object"},"zones":{"description":"IANA zone ids, e.g. [\"America/New_York\",\"Europe/London\"]","items":{"maxLength":64,"minLength":1,"type":"string"},"maxItems":5,"minItems":2,"type":"array"}},"required":["zones"],"type":"object"},"name":"find_meeting_overlap","outputSchema":{"properties":{"count":{"type":"number"},"ics":{"type":"string"},"ok":{"type":"boolean"},"plan_note":{"type":"string"},"query":{"properties":{"days":{"items":{"type":"string"},"type":"array"},"duration_minutes":{"type":"number"},"plan_note":{"type":"string"},"work_hours":{"properties":{"end":{"type":"string"},"start":{"type":"string"}},"type":"object"},"zones":{"items":{"type":"string"},"type":"array"}},"type":"object"},"slots":{"items":{"properties":{"duration_minutes":{"type":"number"},"end_utc":{"type":"string"},"local":{"items":{"properties":{"abbreviation":{"type":"string"},"end_local":{"type":"string"},"start_local":{"type":"string"},"utc_offset_minutes":{"type":"number"},"zone":{"type":"string"}},"type":"object"},"type":"array"},"rank":{"type":"number"},"start_utc":{"type":"string"}},"type":"object"},"type":"array"}},"required":["ok","count","slots"],"type":"object"},"title":"Find meeting times that overlap working hours across time zones"}
