{
 "annotations": {
  "_meta": {
   "ui": {
    "resourceUri": "ui://srt-health"
   }
  },
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Run SRT Watchdog"
 },
 "description": "Run real health check probes from the MCP container (API health, frontend, disk, memory, TLS cert, DB, DNS). Returns actual measured values \u2014 never uses AI-provided data. Classification: INFORMATIONAL \u2014 read-only, no side effects.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "check_results": {
    "description": "IGNORED \u2014 real probes are always used. This parameter exists for backward compatibility only.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "check_id": {
       "description": "Check identifier (e.g. disk-usage, api-healthz)",
       "type": "string"
      },
      "message": {
       "description": "Status message",
       "type": "string"
      },
      "name": {
       "description": "Human-readable check name",
       "type": "string"
      },
      "status": {
       "description": "Check result status",
       "enum": [
        "PASS",
        "WARNING",
        "CRITICAL",
        "ERROR",
        "TIMEOUT"
       ],
       "type": "string"
      },
      "threshold": {
       "description": "Threshold that was compared against",
       "type": "number"
      },
      "unit": {
       "description": "Unit (%, ms, days, count, bool)",
       "type": "string"
      },
      "value": {
       "description": "Measured value",
       "type": "number"
      }
     },
     "required": [
      "check_id",
      "name",
      "status",
      "value",
      "unit",
      "threshold",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "srt_run_watchdog"
}
