{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue fixed public synthetic pi (CPU/CUDA) or one of three discrete schedule scenarios (CPU only). No private data/custom code. Returns a ticket; poll get_network_job. Coordinator recomputes every accepted shard; no net speedup claim. Jobs may expire.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backend": {
    "default": "auto",
    "enum": [
     "auto",
     "cpu",
     "cuda"
    ],
    "type": "string"
   },
   "samples": {
    "maximum": 5000000,
    "minimum": 100,
    "type": "integer"
   },
   "scenario_id": {
    "enum": [
     "single_80_deadline_90",
     "pair_60_40_deadline_100",
     "pair_60_40_deadline_110"
    ],
    "type": "string"
   },
   "seed": {
    "default": 42,
    "maximum": 4294967295,
    "minimum": 0,
    "type": "integer"
   },
   "workload": {
    "default": "pi_chunk_v1",
    "enum": [
     "pi_chunk_v1",
     "schedule_probe_v1"
    ],
    "type": "string"
   }
  },
  "required": [
   "samples"
  ],
  "type": "object"
 },
 "name": "submit_network_job"
}
