{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Item"
 },
 "description": "Edit fields on one or more saved items. Pass a single id or an array of ids for batch updates (same fields applied to all). For batch: attributes are REPLACED not merged, og:image fallback is skipped.",
 "inputSchema": {
  "properties": {
   "attributes": {
    "additionalProperties": {
     "oneOf": [
      {
       "maxLength": 500,
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      }
     ]
    },
    "description": "Merge into existing attributes",
    "type": "object"
   },
   "category": {
    "description": "Item category",
    "enum": [
     "electronics",
     "furniture",
     "home",
     "clothing",
     "vehicles",
     "kids",
     "sports",
     "collectibles",
     "tools",
     "other"
    ],
    "type": "string"
   },
   "description": {
    "description": "Item description (max 2000 chars)",
    "maxLength": 2000,
    "type": "string"
   },
   "id": {
    "description": "Item ID or array of item IDs to update",
    "oneOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    ]
   },
   "image_url": {
    "description": "Main image URL",
    "format": "uri",
    "maxLength": 2000,
    "type": "string"
   },
   "images": {
    "description": "All image URLs \u2014 replaces the entire images array",
    "items": {
     "format": "uri",
     "maxLength": 2000,
     "type": "string"
    },
    "type": "array"
   },
   "is_favorite": {
    "description": "Set true to favorite, false to unfavorite",
    "type": "boolean"
   },
   "item_type": {
    "description": "What kind of item this is",
    "enum": [
     "product",
     "rental",
     "service",
     "course",
     "listing",
     "event",
     "other"
    ],
    "type": "string"
   },
   "notes": {
    "description": "User or AI notes \u2014 personal comments, thoughts, comparisons",
    "maxLength": 2000,
    "type": "string"
   },
   "quantity": {
    "description": "How many of this item",
    "maximum": 1000000,
    "minimum": 1,
    "type": "integer"
   },
   "reason": {
    "description": "Why this change was made (shown to user in change history)",
    "maxLength": 1000,
    "type": "string"
   },
   "status": {
    "description": "Decision status: considering, shortlisted, decided, bought, rejected",
    "enum": [
     "considering",
     "shortlisted",
     "decided",
     "bought",
     "rejected"
    ],
    "type": "string"
   },
   "tags": {
    "description": "Replace all tags with this list",
    "items": {
     "maxLength": 100,
     "type": "string"
    },
    "type": "array"
   },
   "target_price": {
    "description": "What the user wants to pay \u2014 not the actual price, but the goal price",
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "title": {
    "description": "Item title",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_item"
}
