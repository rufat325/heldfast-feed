{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true,
  "title": "Search the Swiss directory"
 },
 "description": "Full-text search over the Swiss public phone/business directory (1820.ch). Matches ALL words in query, so a short keyword works best; put any place name in location, not query. For \"business type X in place Y\", browse_business_category with a category slug is an alternative. Use get_directory_entry for phone numbers and opening hours of a specific result.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "entry_type": {
    "default": "all",
    "description": "Restrict results to person, business, or all entries.",
    "enum": [
     "person",
     "business",
     "all"
    ],
    "type": "string"
   },
   "lang": {
    "description": "Response language: de, fr, it, or en. Defaults to de.",
    "enum": [
     "de",
     "fr",
     "it",
     "en"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of results, 1-20.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "Locality, postcode, or canton (e.g. \"Baden\", \"5400\", \"ZH\") to narrow the search. Always put a place name here, never in query.",
    "maxLength": 200,
    "type": "string"
   },
   "query": {
    "description": "One short keyword: a person's or company name, or ONE business type (e.g. \"M\u00fcller\", \"Migros\", \"Coiffeur\"). Every word must match, so no sentences or extra adjectives. Never put a place name here \u2014 use location instead.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_swiss_directory",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "advertising_block_note": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "additionalProperties": false,
       "properties": {
        "canton": {
         "type": "string"
        },
        "country": {
         "type": "string"
        },
        "locality": {
         "type": "string"
        },
        "post_code": {
         "type": "string"
        },
        "street": {
         "type": "string"
        },
        "street_number": {
         "type": "string"
        }
       },
       "type": [
        "null",
        "object"
       ]
      },
      "advertising_block": {
       "type": "boolean"
      },
      "category": {
       "type": "string"
      },
      "entry_id": {
       "type": "string"
      },
      "entry_type": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "source_url": {
       "type": "string"
      }
     },
     "required": [
      "entry_id",
      "entry_type",
      "advertising_block"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "retrieved_at": {
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "name": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "results",
   "source",
   "retrieved_at",
   "advertising_block_note"
  ],
  "type": "object"
 },
 "title": "Search the Swiss directory"
}
