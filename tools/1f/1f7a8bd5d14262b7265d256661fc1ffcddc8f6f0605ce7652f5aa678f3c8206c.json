 "description": "Show a word search a child can play in the chat: drag across the letters to find each word, and found words cross off the list. Also returns the grid as text and a link to print the PDF. Pass a seed for a new grid; a slug and seed always give the same grid here, on the site and in the PDF.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "seed": {
    "description": "Grid layout. Leave out for the site's default grid.",
    "maximum": 2147483647,
    "minimum": 0,
    "type": "integer"
   },
   "slug": {
    "description": "Word search slug, for example \"farm-friends\".",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "show_word_search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "directions": {
    "type": "string"
   },
   "grid": {
    "items": {
     "items": {
      "type": "string"
     },
     "type": "array"
    },
    "type": "array"
   },
   "level": {
    "enum": [
     "easy",
     "challenge",
     "expert"
    ],
    "type": "string"
   },
   "levelName": {
    "type": "string"
   },
   "pdfUrl": {
    "type": "string"
   },
   "playUrl": {
    "type": "string"
   },
   "seed": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "size": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "slug": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "words": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "title",
   "level",
   "levelName",
   "size",
   "directions",
   "seed",
   "words",
   "grid",
   "playUrl",
   "pdfUrl",
   "slug"
  ],
  "type": "object"
 },
 "title": "Show a word search"
