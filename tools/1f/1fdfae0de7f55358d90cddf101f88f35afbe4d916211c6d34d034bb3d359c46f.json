{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create an alert for a question that triggers on specified conditions",
 "inputSchema": {
  "properties": {
   "alert_above_goal": {
    "default": true,
    "description": "Alert when above goal (for goal condition)",
    "type": "boolean"
   },
   "alert_condition": {
    "default": "rows",
    "description": "Alert condition type",
    "enum": [
     "rows",
     "goal"
    ],
    "type": "string"
   },
   "alert_first_only": {
    "default": false,
    "description": "Only alert on first occurrence",
    "type": "boolean"
   },
   "card_id": {
    "description": "Question/Card ID to create alert for",
    "type": "number"
   },
   "channels": {
    "description": "Notification channels",
    "items": {
     "properties": {
      "channel_type": {
       "enum": [
        "email",
        "slack"
       ],
       "type": "string"
      },
      "details": {
       "type": "object"
      },
      "enabled": {
       "type": "boolean"
      },
      "recipients": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "schedule_day": {
       "type": "string"
      },
      "schedule_hour": {
       "type": "number"
      },
      "schedule_type": {
       "enum": [
        "hourly",
        "daily",
        "weekly"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "card_id"
  ],
  "type": "object"
 },
 "name": "mb_alert_create",
 "title": "Create Alert"
}
