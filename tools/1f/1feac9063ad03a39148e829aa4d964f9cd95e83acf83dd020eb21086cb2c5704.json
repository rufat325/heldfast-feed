{
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "The action to perform",
    "enum": [
     "screenshot",
     "cursor_crop",
     "diff_check",
     "set_baseline",
     "mouse_click",
     "mouse_double_click",
     "mouse_move",
     "hover",
     "nudge",
     "mouse_drag",
     "scroll",
     "key_tap",
     "key_combo",
     "key_type",
     "paste",
     "detect_elements",
     "configure",
     "get_timing",
     "wait",
     "health",
     "shutdown"
    ],
    "type": "string"
   },
   "amount": {
    "description": "Scroll amount (default 3)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "button": {
    "description": "Mouse button",
    "enum": [
     "left",
     "right",
     "middle"
    ],
    "type": "string"
   },
   "click_hold_ms": {
    "description": "Click hold duration",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "combo_mod_ms": {
    "description": "Modifier settle delay",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "cursor_crop_radius": {
    "description": "Cursor crop radius",
    "maximum": 500,
    "minimum": 50,
    "type": "integer"
   },
   "direction": {
    "description": "Scroll direction",
    "enum": [
     "up",
     "down",
     "left",
     "right"
    ],
    "type": "string"
   },
   "double_click_gap_ms": {
    "description": "Double-click gap",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "drag_min_steps": {
    "description": "Min interpolation steps",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "drag_pixels_per_step": {
    "description": "Point density per pixel",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "drag_position_ms": {
    "description": "Pre-drag position wait",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "drag_press_ms": {
    "description": "Drag press hold",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "drag_settle_ms": {
    "description": "Settle before release",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "drag_step_ms": {
    "description": "Between interpolation pts",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "dx": {
    "description": "Relative X offset (nudge)",
    "maximum": 50,
    "minimum": -50,
    "type": "integer"
   },
   "dy": {
    "description": "Relative Y offset (nudge)",
    "maximum": 50,
    "minimum": -50,
    "type": "integer"
   },
   "hover_settle_ms": {
    "description": "Hover settle wait",
    "maximum": 2000,
    "minimum": 1,
    "type": "integer"
   },
   "key": {
    "description": "Key name or combo string (e.g. \"cmd+c\")",
    "type": "string"
   },
   "key_hold_ms": {
    "description": "Key hold duration",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "keys": {
    "description": "Array of key names for combo (e.g. [\"cmd\",\"shift\",\"3\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "max_dimension": {
    "description": "Max screenshot dimension",
    "maximum": 3840,
    "minimum": 320,
    "type": "integer"
   },
   "ms": {
    "description": "Wait duration in ms (default 500)",
    "maximum": 10000,
    "minimum": 50,
    "type": "integer"
   },
   "paste_settle_ms": {
    "description": "Post-clipboard write wait",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "reset": {
    "description": "Reset all params to defaults",
    "type": "boolean"
   },
   "scroll_press_ms": {
    "description": "Scroll press-release gap",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "scroll_tick_ms": {
    "description": "Inter-tick delay",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "text": {
    "description": "Text to type or paste",
    "type": "string"
   },
   "toX": {
    "description": "Drag target X",
    "maximum": 1279,
    "minimum": 0,
    "type": "integer"
   },
   "toY": {
    "description": "Drag target Y",
    "maximum": 799,
    "minimum": 0,
    "type": "integer"
   },
   "type_inter_key_ms": {
    "description": "Inter-character delay",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "type_key_ms": {
    "description": "Key hold during typing",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "type_shift_ms": {
    "description": "Shift key settle",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "x": {
    "description": "X coordinate",
    "maximum": 1279,
    "minimum": 0,
    "type": "integer"
   },
   "y": {
    "description": "Y coordinate",
    "maximum": 799,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "vnc_command"
}
