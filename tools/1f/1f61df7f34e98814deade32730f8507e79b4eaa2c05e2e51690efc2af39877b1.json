{
 "description": "Query installed packages using CSS-like selectors",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "selector": {
    "description": "CSS-like dependency selector (e.g. ':root > .prod', '.dev', '#lodash')",
    "type": "string"
   }
  },
  "required": [
   "path",
   "selector"
  ],
  "type": "object"
 },
 "name": "query"
}
