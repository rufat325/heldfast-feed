{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get revenue metrics"
 },
 "description": "Fetch revenue and subscription metrics over a date range, bucketed by interval \u2014 orders, revenue, MRR, active subscriptions. Polar: GET /v1/metrics/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_id": {
    "description": "Only this customer's metrics.",
    "type": "string"
   },
   "end_date": {
    "description": "End of the window, YYYY-MM-DD.",
    "type": "string"
   },
   "interval": {
    "description": "Bucket size for the series.",
    "enum": [
     "hour",
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "organization_id": {
    "description": "Restrict to this organisation id. Needed when the token spans several organisations.",
    "type": "string"
   },
   "product_id": {
    "description": "Only this product's metrics.",
    "type": "string"
   },
   "start_date": {
    "description": "Start of the window, YYYY-MM-DD.",
    "type": "string"
   }
  },
  "required": [
   "start_date",
   "end_date",
   "interval"
  ],
  "type": "object"
 },
 "name": "polar_get_metrics",
 "title": "Get revenue metrics"
}
