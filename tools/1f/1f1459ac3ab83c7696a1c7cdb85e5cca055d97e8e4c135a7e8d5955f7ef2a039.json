{
 "description": "BM25 full-text search across all files in an indexed codebase. Returns ranked results with matching lines.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "directory": {
    "description": "Absolute path to the indexed project",
    "type": "string"
   },
   "maxResults": {
    "default": 15,
    "description": "Maximum results to return",
    "type": "number"
   },
   "query": {
    "description": "Search query (keywords or code patterns)",
    "type": "string"
   }
  },
  "required": [
   "directory",
   "query"
  ],
  "type": "object"
 },
 "name": "search_code"
}
