{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Log a GPS location point for a device. The device is auto-created by user_agent if it doesn't exist.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accuracy": {
    "description": "GPS accuracy in meters",
    "type": "number"
   },
   "altitude": {
    "description": "Altitude in meters",
    "type": "number"
   },
   "battery": {
    "description": "Battery level percentage",
    "type": "number"
   },
   "lat": {
    "description": "Latitude",
    "type": "number"
   },
   "lng": {
    "description": "Longitude",
    "type": "number"
   },
   "timestamp": {
    "description": "Unix timestamp (defaults to now)",
    "type": "number"
   },
   "user_agent": {
    "description": "Device identifier (defaults to HTTP User-Agent)",
    "type": "string"
   }
  },
  "required": [
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "add_map_device_point",
 "title": "Add Map Device Point"
}
