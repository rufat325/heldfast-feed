{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free signature and declaration verification. To try before buying, read datoka-api://demo-receipt or /demo/receipt.json and pass the returned JSON here. No wallet needed for public verification. Verifies issuer, scope and event commitment; compare original response bytes locally with the SDK or /verify/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "event": {
    "additionalProperties": false,
    "description": "Commitment-only HTTP exchange declaration built locally with the SDK. No raw URLs, headers or bodies.",
    "properties": {
     "apiId": {
      "description": "Caller-chosen API identifier; not a certified provider identity.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "attestation": {
      "const": "client_declared",
      "description": "The caller declares the exchange; Datoka does not independently observe it.",
      "type": "string"
     },
     "bodyEncoding": {
      "const": "application_bytes",
      "description": "Hash application bytes after HTTP decoding, without JSON reserialization.",
      "type": "string"
     },
     "completedAt": {
      "description": "Declared UTC completion with milliseconds; must be at or after startedAt.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "exchangeId": {
      "description": "Stable identifier for one declared HTTP exchange.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "headerEncoding": {
      "const": "jcs-selected-headers-v1",
      "description": "Use the SDK header selection and JCS canonicalization before hashing.",
      "type": "string"
     },
     "method": {
      "description": "Actual HTTP method of the locally captured exchange, for example GET.",
      "enum": [
       "GET",
       "HEAD",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "OPTIONS"
      ],
      "type": "string"
     },
     "requestBodyHash": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "algorithm": {
          "const": "sha256",
          "description": "Digest algorithm; always sha256.",
          "type": "string"
         },
         "digest": {
          "description": "SHA-256 of exact locally captured bytes, encoded as 64 lowercase hexadecimal characters.",
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         }
        },
        "required": [
         "algorithm",
         "digest"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "SHA-256 of exact application request bytes; null means no body, not an empty body."
     },
     "requestHeadersHash": {
      "additionalProperties": false,
      "description": "SHA-256 of locally canonicalized selected request headers. Never send raw headers.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Digest algorithm; always sha256.",
        "type": "string"
       },
       "digest": {
        "description": "SHA-256 of exact locally captured bytes, encoded as 64 lowercase hexadecimal characters.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "responseBodyHash": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "algorithm": {
          "const": "sha256",
          "description": "Digest algorithm; always sha256.",
          "type": "string"
         },
         "digest": {
          "description": "SHA-256 of exact locally captured bytes, encoded as 64 lowercase hexadecimal characters.",
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         }
        },
        "required": [
         "algorithm",
         "digest"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "SHA-256 of exact application response bytes after HTTP decoding. Preserve those bytes; do not reserialize JSON."
     },
     "responseHeadersHash": {
      "additionalProperties": false,
      "description": "SHA-256 of locally canonicalized selected response headers.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Digest algorithm; always sha256.",
        "type": "string"
       },
       "digest": {
        "description": "SHA-256 of exact locally captured bytes, encoded as 64 lowercase hexadecimal characters.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "startedAt": {
      "description": "Declared UTC start with milliseconds, for example 2026-10-07T08:00:00.000Z.",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "status": {
      "description": "Actual HTTP response status, including error responses; for example 200 or 404.",
      "maximum": 599,
      "minimum": 200,
      "type": "integer"
     },
     "targetHash": {
      "additionalProperties": false,
      "description": "SHA-256 of the exact UTF-8 target URL, computed locally. Never invent a digest or send the URL itself.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "description": "Digest algorithm; always sha256.",
        "type": "string"
       },
       "digest": {
        "description": "SHA-256 of exact locally captured bytes, encoded as 64 lowercase hexadecimal characters.",
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "version": {
      "const": "datoka.api.exchange.v1",
      "description": "Declaration format version; preserve this literal.",
      "type": "string"
     }
    },
    "required": [
     "version",
     "attestation",
     "apiId",
     "exchangeId",
     "method",
     "status",
     "startedAt",
     "completedAt",
     "targetHash",
     "requestBodyHash",
     "responseBodyHash",
     "requestHeadersHash",
     "responseHeadersHash",
     "bodyEncoding",
     "headerEncoding"
    ],
    "type": "object"
   },
   "receipt": {
    "additionalProperties": false,
    "description": "Unmodified signed receipt returned by issuance or the public synthetic demo; verify against trusted issuer keys.",
    "properties": {
     "algorithm": {
      "const": "Ed25519",
      "type": "string"
     },
     "body": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "issuedAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
        "type": "string"
       },
       "issuer": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
       },
       "keyId": {
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
        "type": "string"
       },
       "previous": {
        "anyOf": [
         {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "request": {
        "additionalProperties": false,
        "properties": {
         "chain": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
         },
         "eventType": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
         },
         "scope": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
          "type": "string"
         },
         "subject": {
          "additionalProperties": false,
          "properties": {
           "algorithm": {
            "const": "sha256",
            "type": "string"
           },
           "digest": {
            "pattern": "^[a-f0-9]{64}$",
            "type": "string"
           },
           "encoding": {
            "enum": [
             "jcs",
             "bytes"
            ],
            "type": "string"
           }
          },
          "required": [
           "algorithm",
           "encoding",
           "digest"
          ],
          "type": "object"
         }
        },
        "required": [
         "scope",
         "chain",
         "eventType",
         "subject"
        ],
        "type": "object"
       },
       "sequence": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       },
       "version": {
        "const": "datoka.receipt.v1",
        "type": "string"
       }
      },
      "required": [
       "version",
       "id",
       "issuer",
       "keyId",
       "issuedAt",
       "request",
       "sequence",
       "previous"
      ],
      "type": "object"
     },
     "signature": {
      "pattern": "^[A-Za-z0-9_-]{86}$",
      "type": "string"
     }
    },
    "required": [
     "body",
     "algorithm",
     "signature"
    ],
    "type": "object"
   }
  },
  "required": [
   "event",
   "receipt"
  ],
  "type": "object"
 },
 "name": "verify_api_receipt",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "apiId": {
    "description": "Caller-chosen API identifier; not a certified provider identity.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "attestation": {
    "const": "client_declared",
    "type": "string"
   },
   "exchangeId": {
    "description": "Stable identifier for one declared HTTP exchange.",
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "receiptId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "scope": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
    "type": "string"
   },
   "valid": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "valid",
   "receiptId",
   "scope",
   "apiId",
   "exchangeId",
   "attestation"
  ],
  "type": "object"
 },
 "title": "Verify API Receipt"
}
