{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Push instead of polling ($0.50): buys a 7-day pack of up to 200 webhook deliveries to your public HTTPS URL, signed with HMAC-SHA256. Events: decision_change (hourly decision flips), unusual_flow, funding_extreme (Hyperliquid), news (materiality filter), token_risk_change (up to 5 watched tokens). Returns the subscription id and its secret (shown once).",
 "inputSchema": {
  "properties": {
   "categories": {
    "items": {
     "enum": [
      "crypto",
      "stocks",
      "europe",
      "policy",
      "filings"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "events": {
    "items": {
     "enum": [
      "decision_change",
      "unusual_flow",
      "funding_extreme",
      "news",
      "token_risk_change"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "minMateriality": {
    "default": 4,
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "symbols": {
    "description": "Optional: only these symbols",
    "items": {
     "type": "string"
    },
    "maxItems": 25,
    "type": "array"
   },
   "tokens": {
    "description": "For token_risk_change: [{\"address\": \"0x...\", \"chain\": \"base\"}]",
    "items": {
     "properties": {
      "address": {
       "type": "string"
      },
      "chain": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "url": {
    "description": "Public HTTPS URL that receives the POSTs",
    "type": "string"
   }
  },
  "required": [
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "subscribe_alerts"
}
