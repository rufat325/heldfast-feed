{
 "description": "Batch notify Google about multiple URL updates or removals via the Indexing API. Combines up to 100 notifications into a single HTTP request for efficiency.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "notifications": {
    "description": "Array of URL notifications (1-100 items). Each item has a url and type.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "type": {
       "description": "Notification type: URL_UPDATED or URL_DELETED",
       "enum": [
        "URL_UPDATED",
        "URL_DELETED"
       ],
       "type": "string"
      },
      "url": {
       "description": "The fully-qualified URL",
       "type": "string"
      }
     },
     "required": [
      "url",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "notifications"
  ],
  "type": "object"
 },
 "name": "indexing_batch_publish"
}
