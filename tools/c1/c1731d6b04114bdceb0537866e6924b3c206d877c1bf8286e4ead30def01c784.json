{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Batch Screenshots"},"description":"Create a batch screenshot job for multiple URLs (1-50). Returns immediately with a job ID. Use get_batch_status to poll for results (wait 2-5 seconds between polls). All URLs share the same screenshot options. Each URL consumes one credit; failed URLs get credits rolled back.","inputSchema":{"properties":{"block_ads":{"description":"Block ads (default: true)","type":"boolean"},"block_cookie_banners":{"description":"Remove cookie banners (default: true)","type":"boolean"},"click_selector":{"description":"CSS selector to click","type":"string"},"dark_mode":{"description":"Enable dark mode (default: false)","type":"boolean"},"delay":{"description":"Milliseconds to wait after load (default: 0)","maximum":10000,"minimum":0,"type":"integer"},"device":{"description":"Device preset for emulation","enum":["iphone_14","iphone_15_pro","pixel_7","ipad_pro","macbook_pro"],"type":"string"},"format":{"description":"Output format (default: png)","enum":["png","jpeg","webp","pdf"],"type":"string"},"full_page":{"description":"Capture entire scrollable page (default: false)","type":"boolean"},"height":{"description":"Viewport height in pixels (default: 800)","maximum":10000,"minimum":200,"type":"integer"},"hide_selectors":{"description":"CSS selectors to hide","type":"string"},"lazy_load":{"description":"For full-page captures: scroll through the page first so lazy-loaded images below the first screen appear (default: false). Slower, usually 1-5 seconds more. Ignored unless full_page is true. Some sites can still differ.","type":"boolean"},"quality":{"description":"Image quality (default: 90)","maximum":100,"minimum":1,"type":"integer"},"urls":{"description":"Array of URLs to capture (1-50)","items":{"type":"string"},"maxItems":50,"minItems":1,"type":"array"},"user_agent":{"description":"Custom user agent","type":"string"},"width":{"description":"Viewport width in pixels (default: 1280)","maximum":3840,"minimum":320,"type":"integer"}},"required":["urls"],"type":"object"},"name":"batch_screenshots"}
