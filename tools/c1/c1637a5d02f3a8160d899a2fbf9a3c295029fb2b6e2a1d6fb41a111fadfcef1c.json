{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when a user asks how fast they are burning their error budget, or whether their current error rate will exhaust their SLO window. Takes error count, total requests, SLO target, and observation window. Returns burn rate and budget consumption per hour.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "errors": {
    "description": "Number of failed requests observed in the measurement window.",
    "examples": [
     1
    ],
    "minimum": 0,
    "type": "number"
   },
   "slo": {
    "description": "Service-level objective target expressed as a percentage.",
    "examples": [
     1
    ],
    "maximum": 99.9999,
    "minimum": 0,
    "type": "number"
   },
   "total": {
    "description": "Total number of requests observed in the measurement window.",
    "examples": [
     1
    ],
    "minimum": 1,
    "type": "number"
   },
   "window_hours": {
    "description": "Length of the observed measurement window in hours.",
    "examples": [
     1
    ],
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "errors",
   "total",
   "slo",
   "window_hours"
  ],
  "type": "object"
 },
 "name": "slo-burn-rate-calculator",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affiliate_context": {
    "additionalProperties": false,
    "properties": {
     "affiliate": {
      "type": "string"
     },
     "cta_label": {
      "type": "string"
     },
     "disclosure": {
      "type": "string"
     },
     "framing": {
      "type": "string"
     },
     "posture": {
      "enum": [
       "secondary"
      ],
      "type": "string"
     },
     "slot_id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "variant": {
      "type": "string"
     }
    },
    "required": [
     "affiliate",
     "cta_label",
     "disclosure",
     "framing",
     "posture",
     "slot_id",
     "url",
     "variant"
    ],
    "type": "object"
   },
   "budget_consumed_pct_per_hour": {
    "type": "number"
   },
   "burn_rate": {
    "type": "number"
   },
   "computation_basis": {
    "type": "string"
   },
   "error_rate_pct": {
    "type": "number"
   },
   "interpretation": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "next_step_url": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "why_follow_up": {
    "type": "string"
   },
   "window_hours": {
    "type": "number"
   }
  },
  "required": [
   "budget_consumed_pct_per_hour",
   "burn_rate",
   "computation_basis",
   "error_rate_pct",
   "interpretation",
   "next_step",
   "next_step_url",
   "status",
   "why_follow_up",
   "window_hours"
  ],
  "type": "object"
 }
