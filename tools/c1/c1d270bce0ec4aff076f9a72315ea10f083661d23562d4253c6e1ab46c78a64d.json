{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Full details of one TerpLink event: description, venue or meeting link, hosts, categories, perks and RSVP capacity. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "event_id": {
    "description": "Event id from terplink_search_events",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "event_id"
  ],
  "type": "object"
 },
 "name": "terplink_get_event",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "description": "Where the event is held",
    "properties": {
     "city": {
      "type": [
       "string",
       "null"
      ]
     },
     "instructions": {
      "description": "Directions or joining instructions",
      "type": [
       "string",
       "null"
      ]
     },
     "latitude": {
      "type": [
       "number",
       "null"
      ]
     },
     "longitude": {
      "type": [
       "number",
       "null"
      ]
     },
     "name": {
      "description": "Venue name, e.g. \"Online\" or a building",
      "type": [
       "string",
       "null"
      ]
     },
     "online_location": {
      "description": "Meeting link for online events",
      "type": [
       "string",
       "null"
      ]
     },
     "provider": {
      "description": "Online meeting provider, e.g. \"Zoom\"",
      "type": [
       "string",
       "null"
      ]
     },
     "state": {
      "type": [
       "string",
       "null"
      ]
     },
     "street": {
      "description": "Street lines, blank lines dropped",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "zip": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "street",
     "city",
     "state",
     "zip",
     "name",
     "latitude",
     "longitude",
     "online_location",
     "instructions",
     "provider"
    ],
    "type": "object"
   },
   "benefits": {
    "description": "Perks advertised, e.g. \"Free Food\"",
    "items": {
     "enum": [
      "Credit",
      "Free Food",
      "Free Stuff"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "categories": {
    "description": "Category names",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "co_hosts": {
    "description": "Ids of every hosting organization",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "description": {
    "description": "Description as plain text",
    "type": [
     "string",
     "null"
    ]
   },
   "ends_on": {
    "description": "End, ISO 8601",
    "type": "string"
   },
   "id": {
    "description": "Event id, for terplink_get_event",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "image_url": {
    "description": "Event image",
    "type": [
     "string",
     "null"
    ]
   },
   "name": {
    "description": "Event name",
    "type": "string"
   },
   "organization": {
    "additionalProperties": false,
    "description": "The hosting organization",
    "properties": {
     "id": {
      "description": "Organization id",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "name": {
      "description": "Organization name",
      "type": "string"
     }
    },
    "required": [
     "id",
     "name"
    ],
    "type": "object"
   },
   "rsvp": {
    "additionalProperties": false,
    "description": "RSVP settings and counts",
    "properties": {
     "invite_only": {
      "description": "true when RSVPs need an invitation",
      "type": "boolean"
     },
     "spots_available": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Spots left; null when unlimited"
     },
     "total": {
      "description": "RSVPs so far",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total_allowed": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "description": "Capacity; null when unlimited"
     }
    },
    "required": [
     "total",
     "total_allowed",
     "spots_available",
     "invite_only"
    ],
    "type": "object"
   },
   "rsvp_total": {
    "description": "RSVPs so far",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "starts_on": {
    "description": "Start, ISO 8601",
    "type": "string"
   },
   "theme": {
    "description": "Theme the host picked",
    "enum": [
     "Arts",
     "Athletics",
     "CommunityService",
     "Cultural",
     "Fundraising",
     "GroupBusiness",
     "Social",
     "Spirituality",
     "ThoughtfulLearning",
     "Unknown"
    ],
    "type": "string"
   },
   "url": {
    "description": "Public TerpLink page",
    "type": "string"
   },
   "visibility": {
    "description": "Who can see the event, e.g. \"Public\"",
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "description",
   "starts_on",
   "ends_on",
   "organization",
   "theme",
   "categories",
   "benefits",
   "rsvp_total",
   "image_url",
   "url",
   "address",
   "co_hosts",
   "rsvp",
   "visibility"
  ],
  "type": "object"
 },
 "title": "Get an event"
}
