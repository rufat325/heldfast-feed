{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get a Pollar film"
 },
 "description": "Fetches one Pollar film by slug (from list_films, or the film field of get_event) with its full transcript in the requested language, taken from the reviewed captions. Returns a canonical pollar.news url.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "pl",
     "de",
     "fr"
    ],
    "type": "string"
   },
   "slug": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_film",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "durationS": {
    "type": "number"
   },
   "event": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "slug": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "url": {
        "format": "uri",
        "type": "string"
       }
      },
      "required": [
       "slug",
       "title",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "publishedAt": {
    "type": "string"
   },
   "question": {
    "type": "string"
   },
   "recordedAt": {
    "type": "string"
   },
   "slug": {
    "type": "string"
   },
   "transcript": {
    "type": [
     "string",
     "null"
    ]
   },
   "transcriptTruncated": {
    "type": "boolean"
   },
   "url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "question",
   "recordedAt",
   "durationS",
   "publishedAt",
   "url",
   "event",
   "transcript",
   "transcriptTruncated"
  ],
  "type": "object"
 },
 "title": "Get a Pollar film"
}
