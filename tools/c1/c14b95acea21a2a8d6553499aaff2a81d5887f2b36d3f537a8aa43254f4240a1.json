{
 "description": "Create an Action that maps an event name to a transactional template. Each matching event sends one email to the contact.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "delaySeconds": {
    "description": "Delay before sending",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "enabled": {
    "default": true,
    "type": "boolean"
   },
   "eventName": {
    "description": "Event name to match (e.g. 'order.placed')",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Display name",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "sendOnce": {
    "description": "Only send once per contact regardless of how many times the event fires",
    "type": "boolean"
   },
   "templateSlug": {
    "description": "Transactional template slug to send",
    "type": "string"
   }
  },
  "required": [
   "name",
   "eventName",
   "templateSlug"
  ],
  "type": "object"
 },
 "name": "create_action"
}
