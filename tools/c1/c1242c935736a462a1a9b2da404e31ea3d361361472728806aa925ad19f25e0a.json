{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change user information (password) in a Cloud DB for MongoDB instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudMongoDbInstanceNo": {
    "description": "Cloud MongoDB instance number",
    "type": "string"
   },
   "cloudMongoDbUserList": {
    "description": "List of users to change",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "description": "User name",
       "type": "string"
      },
      "password": {
       "description": "New password",
       "type": "string"
      }
     },
     "required": [
      "name",
      "password"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "cloudMongoDbInstanceNo",
   "cloudMongoDbUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_change_mongodb_users"
}
