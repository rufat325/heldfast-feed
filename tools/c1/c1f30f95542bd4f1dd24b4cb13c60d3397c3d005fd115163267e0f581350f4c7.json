{
 "description": "Updates an existing docker daemon connection. Use listDockerHosts to find the docker host ID. Only the fields you pass are changed \u2014 the others are preserved.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dockerDaemon": {
    "description": "New socket path or TCP URL",
    "type": "string"
   },
   "dockerHostID": {
    "description": "The ID of the docker host to update",
    "minimum": 0,
    "type": "integer"
   },
   "dockerType": {
    "description": "New connection type",
    "enum": [
     "socket",
     "tcp"
    ],
    "type": "string"
   },
   "name": {
    "description": "New human-readable name",
    "type": "string"
   }
  },
  "required": [
   "dockerHostID"
  ],
  "type": "object"
 },
 "name": "updateDockerHost",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "number"
   },
   "msg": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Update Docker Host"
}
