{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Pause / resume / re-time a flow schedule"
 },
 "description": "Changes one schedule: `enabled: false` pauses it (configuration kept), `enabled: true` resumes and recomputes the next fire time from now; `interval` / `scheduleTime` / `scheduleTimezone` / `scheduleDayOfWeek` change the cadence; `label`, `delivery`, and `input` can change too. Pass only what changes. Get the scheduleId from workbench_flows_schedules_list. May return `needs_confirmation`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation response. Omit on the first call.",
    "type": "string"
   },
   "delivery": {
    "enum": [
     "history",
     "notification",
     "email"
    ],
    "type": "string"
   },
   "enabled": {
    "description": "false pauses, true resumes.",
    "type": "boolean"
   },
   "flowId": {
    "description": "Flow the schedule belongs to.",
    "type": "string"
   },
   "input": {
    "description": "New fixed input envelope \u2014 {\"kind\":\"chat\",\"messages\":[\u2026]} or {\"kind\":\"form\",\"values\":{\u2026}}.",
    "oneOf": [
     {
      "properties": {
       "kind": {
        "const": "chat",
        "type": "string"
       },
       "messages": {
        "items": {
         "additionalProperties": {},
         "properties": {
          "content": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "items": {},
             "type": "array"
            },
            {
             "type": "null"
            }
           ]
          },
          "name": {
           "type": "string"
          },
          "role": {
           "type": "string"
          },
          "tool_call_id": {
           "type": "string"
          },
          "tool_calls": {
           "items": {
            "additionalProperties": {},
            "properties": {
             "function": {
              "additionalProperties": {},
              "properties": {
               "arguments": {},
               "name": {
                "type": "string"
               }
              },
              "type": "object"
             },
             "id": {
              "type": "string"
             },
             "type": {
              "type": "string"
             }
            },
            "type": "object"
           },
           "type": "array"
          }
         },
         "required": [
          "role"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "values": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       }
      },
      "required": [
       "kind",
       "messages"
      ],
      "type": "object"
     },
     {
      "properties": {
       "kind": {
        "const": "form",
        "type": "string"
       },
       "values": {
        "additionalProperties": {},
        "propertyNames": {
         "type": "string"
        },
        "type": "object"
       }
      },
      "required": [
       "kind",
       "values"
      ],
      "type": "object"
     }
    ]
   },
   "interval": {
    "description": "New cadence: hourly, daily, or weekly.",
    "enum": [
     "hourly",
     "daily",
     "weekly"
    ],
    "type": "string"
   },
   "label": {
    "anyOf": [
     {
      "maxLength": 120,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleDayOfWeek": {
    "anyOf": [
     {
      "maximum": 6,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleId": {
    "description": "Schedule id, from workbench_flows_schedules_list.",
    "type": "string"
   },
   "scheduleTime": {
    "anyOf": [
     {
      "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "scheduleTimezone": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this; tokens with a default can override per call. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "flowId",
   "scheduleId"
  ],
  "type": "object"
 },
 "name": "workbench_flows_schedules_update",
 "title": "Pause / resume / re-time a flow schedule"
}
