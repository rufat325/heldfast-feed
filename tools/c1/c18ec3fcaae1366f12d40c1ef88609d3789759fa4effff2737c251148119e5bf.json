{"annotations":{"openWorldHint":true,"readOnlyHint":true,"title":"Ticker price history"},"description":"Daily close-price history for one ticker over the given period.\n\nLong periods are evenly sampled down to `max_points` bars rather than\ncut short, so the series still spans the whole period \u2014 `5Y` and `MAX`\nreturn the shape of the history, not its last year. `last_close`,\n`change_pct` and the `range_low`/`range_high` extremes are computed\nover every bar regardless of sampling.","inputSchema":{"properties":{"max_points":{"default":260,"title":"Max Points","type":"integer"},"period":{"default":"1Y","enum":["1M","6M","YTD","1Y","5Y","MAX"],"title":"Period","type":"string"},"symbol":{"title":"Symbol","type":"string"}},"required":["symbol"],"title":"rayana_ai_ticker_priceArguments","type":"object"},"name":"rayana_ai_ticker_price","outputSchema":{"$defs":{"PricePoint":{"properties":{"close":{"title":"Close","type":"number"},"date":{"title":"Date","type":"string"}},"required":["date","close"],"title":"PricePoint","type":"object"}},"properties":{"change_pct":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Change Pct"},"last_close":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Last Close"},"period":{"title":"Period","type":"string"},"points":{"items":{"$ref":"#/$defs/PricePoint"},"title":"Points","type":"array"},"range_high":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Range High"},"range_low":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null,"title":"Range Low"},"ticker":{"title":"Ticker","type":"string"}},"required":["ticker","period","points"],"title":"PriceHistoryResponse","type":"object"},"title":"Ticker price history"}
