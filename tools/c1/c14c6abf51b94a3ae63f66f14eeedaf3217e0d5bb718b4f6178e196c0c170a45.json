{
 "annotations": {},
 "description": "Add, edit, delete, or bind component properties. bind links a layer: BOOLEAN shows/hides it, TEXT sets its text, INSTANCE_SWAP swaps it. Names work without the '#1:2' suffix.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "add, edit, delete, or bind",
    "type": "string"
   },
   "defaultValue": {
    "description": "Default, for add: boolean, string, or component ID (INSTANCE_SWAP)"
   },
   "name": {
    "description": "Name (add), or new name (edit)",
    "type": "string"
   },
   "nodeId": {
    "description": "COMPONENT or COMPONENT_SET node ID",
    "type": "string"
   },
   "preferredValues": {
    "description": "INSTANCE_SWAP: components shown first",
    "items": {
     "properties": {
      "key": {
       "description": "Component key",
       "type": "string"
      },
      "type": {
       "enum": [
        "COMPONENT",
        "COMPONENT_SET"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "key"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "property": {
    "description": "Property to change, e.g. 'Size' or 'Size#1:2'",
    "type": "string"
   },
   "targetNodeId": {
    "description": "bind: layer inside the component",
    "type": "string"
   },
   "type": {
    "description": "Type, for add. VARIANT needs a COMPONENT_SET.",
    "type": "string"
   }
  },
  "required": [
   "nodeId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_component_properties"
}
