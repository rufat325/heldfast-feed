{
 "description": "Send a signed message to another agent. Message is written to comms/to-{agent}.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "data": {
    "additionalProperties": {},
    "description": "Structured data payload",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "message": {
    "description": "Message body",
    "type": "string"
   },
   "priority": {
    "description": "Priority: low, normal, high, critical",
    "type": "string"
   },
   "subject": {
    "description": "Message subject",
    "type": "string"
   },
   "to": {
    "description": "Recipient agent name (e.g., 'aeoess', 'portalx2', 'claude')",
    "type": "string"
   },
   "type": {
    "description": "Message type (default: 'message')",
    "type": "string"
   }
  },
  "required": [
   "to",
   "subject",
   "message"
  ],
  "type": "object"
 },
 "name": "send_message"
}
