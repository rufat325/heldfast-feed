{
 "description": "Start an async proof report job with export storage enabled by default. Requires evals:run for API keys.",
 "inputSchema": {
  "properties": {
   "artifactBundleId": {
    "format": "uuid",
    "type": "string"
   },
   "auditRunId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateFileId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateFileVersionId": {
    "format": "uuid",
    "type": "string"
   },
   "candidateVersionNumber": {
    "minimum": 1,
    "type": "integer"
   },
   "evalRunId": {
    "format": "uuid",
    "type": "string"
   },
   "includeExport": {
    "default": true,
    "type": "boolean"
   },
   "rubricVersion": {
    "type": "string"
   },
   "sourceFileId": {
    "format": "uuid",
    "type": "string"
   },
   "sourceFileVersionId": {
    "format": "uuid",
    "type": "string"
   },
   "sourceVersionNumber": {
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "artifactBundleId"
  ],
  "type": "object"
 },
 "name": "rubrkit_export_proof_report",
 "title": "Export proof report"
}
