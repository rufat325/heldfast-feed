{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Constraint"
 },
 "description": "Use this when you need to add a sketch constraint to a list. Append one validated sketch constraint to a constraint list. Side-effect-free: pass { constraints, constraint } and receive the updated list.",
 "inputSchema": {
  "properties": {
   "constraint": {
    "description": "The constraint to append.",
    "properties": {
     "entities": {
      "description": "Ids of the entities the constraint relates.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "id": {
      "type": "string"
     },
     "type": {
      "enum": [
       "COINCIDENT",
       "DISTANCE",
       "HORIZONTAL",
       "VERTICAL",
       "PARALLEL",
       "PERPENDICULAR",
       "EQUAL_LENGTH",
       "TANGENT",
       "RADIUS",
       "ANGLE",
       "CONCENTRIC",
       "SYMMETRIC"
      ],
      "type": "string"
     },
     "value": {
      "description": "Required for DISTANCE, RADIUS, and ANGLE.",
      "type": "number"
     }
    },
    "required": [
     "id",
     "type",
     "entities"
    ],
    "type": "object"
   },
   "constraints": {
    "description": "Existing constraint list to append to (omit for an empty list).",
    "items": {
     "properties": {
      "entities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "type": {
       "enum": [
        "COINCIDENT",
        "DISTANCE",
        "HORIZONTAL",
        "VERTICAL",
        "PARALLEL",
        "PERPENDICULAR",
        "EQUAL_LENGTH",
        "TANGENT",
        "RADIUS",
        "ANGLE",
        "CONCENTRIC",
        "SYMMETRIC"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "type",
      "entities"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "constraint"
  ],
  "type": "object"
 },
 "name": "add_constraint",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "constraints": {
    "description": "Updated constraint list.",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "errors": {
    "description": "Validation errors (present on failure).",
    "items": {
     "additionalProperties": true,
     "type": "object"
    },
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "constraints"
  ],
  "type": "object"
 },
 "title": "Add Constraint"
}
