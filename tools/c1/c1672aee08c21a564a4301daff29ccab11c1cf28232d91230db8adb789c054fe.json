{
 "description": "Register an already-deployed BaseAlpha launch that never called /v1/launch/register (or whose register step failed after the on-chain tx). Pass txHash and/or tokenAddress \u2014 the API resolves the deploy tx from the V4 curve when only the token address is known. Idempotent. Use this to make an \"Unregistered Launch\" token appear in Trending / New / search.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "animationUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "bannerUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "category": {
    "maxLength": 50,
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "descriptionShort": {
    "maxLength": 200,
    "type": "string"
   },
   "discord": {
    "maxLength": 255,
    "type": "string"
   },
   "docsUrl": {
    "$ref": "#/properties/logoUrl"
   },
   "extra_links": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "feeMode": {
    "enum": [
     "cashback",
     "stay"
    ],
    "type": "string"
   },
   "github": {
    "maxLength": 255,
    "type": "string"
   },
   "logoUrl": {
    "format": "uri",
    "type": "string"
   },
   "social_links": {
    "additionalProperties": {
     "type": "string"
    },
    "type": "object"
   },
   "squadMembers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "minLength": 1,
       "type": "string"
      },
      "label": {
       "maxLength": 24,
       "type": "string"
      }
     },
     "required": [
      "address"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "tagline": {
    "maxLength": 100,
    "type": "string"
   },
   "teamStatus": {
    "maxLength": 50,
    "type": "string"
   },
   "telegram": {
    "maxLength": 255,
    "type": "string"
   },
   "tokenAddress": {
    "description": "Token address when the deploy tx hash was lost",
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   },
   "twitter": {
    "maxLength": 255,
    "type": "string"
   },
   "txHash": {
    "description": "Deploy transaction hash from createFairLaunch",
    "pattern": "^0x[0-9a-fA-F]{64}$",
    "type": "string"
   },
   "website": {
    "$ref": "#/properties/logoUrl"
   },
   "whitepaperUrl": {
    "$ref": "#/properties/logoUrl"
   }
  },
  "type": "object"
 },
 "name": "register_launch"
}
