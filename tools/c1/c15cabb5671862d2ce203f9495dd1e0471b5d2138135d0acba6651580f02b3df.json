{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create or update a Cloud Functions trigger",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "link": {
    "additionalProperties": {},
    "description": "Link configuration for GitHub type: { productId, apiName, stageName }",
    "type": "object"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   },
   "trigger": {
    "additionalProperties": {},
    "description": "Trigger configuration object (structure varies by type)",
    "type": "object"
   },
   "triggerName": {
    "description": "Name of the trigger to create or update",
    "type": "string"
   },
   "type": {
    "description": "Trigger type",
    "enum": [
     "cron",
     "github",
     "insight",
     "object_storage",
     "source_commit"
    ],
    "type": "string"
   }
  },
  "required": [
   "triggerName",
   "type",
   "trigger"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_create_trigger"
}
