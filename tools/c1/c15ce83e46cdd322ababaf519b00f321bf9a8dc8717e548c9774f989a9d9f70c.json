{
 "description": "Get the top gainers or losers \u2014 either by today's change or by total return since purchase. Use this for 'best/worst performers'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "Filter by depot ID(s)",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "max": {
    "default": 5,
    "description": "How many to return",
    "type": "number"
   },
   "mode": {
    "description": "'gainers'/'losers' for today; 'gainersTotal'/'losersTotal' for total return",
    "enum": [
     "gainers",
     "losers",
     "gainersTotal",
     "losersTotal"
    ],
    "type": "string"
   }
  },
  "required": [
   "mode"
  ],
  "type": "object"
 },
 "name": "get_gainers_and_losers"
}
