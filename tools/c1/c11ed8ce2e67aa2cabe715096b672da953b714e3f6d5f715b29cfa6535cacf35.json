{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Delete a tag that no ticket holds (use tag_remove on its tickets first). Tickets' tag history is kept.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "prefix": {
    "description": "Tag prefix",
    "type": "string"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "value": {
    "description": "Tag value",
    "type": "string"
   }
  },
  "required": [
   "prefix",
   "value"
  ],
  "type": "object"
 },
 "name": "tag_delete",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "deleted": {
    "const": true,
    "type": "boolean"
   },
   "tag": {
    "type": "string"
   }
  },
  "required": [
   "deleted",
   "tag"
  ],
  "type": "object"
 }
}
