{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "xcut.read",
     "xcut.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a brand memory fact"
 },
 "description": "Use this when the user asks to change a saved brand memory fact. Replaces that fact's text and category (the old text is not kept). Needs the fact's id from xcut_get_brand. Free. Do not use to add a new fact (use xcut_save_memory).",
 "inputSchema": {
  "properties": {
   "canvas_id": {
    "description": "Canvas id (a UUID) from xcut_list_canvases.",
    "pattern": "^[0-9a-fA-F-]{36}$",
    "title": "Canvas Id",
    "type": "string"
   },
   "category": {
    "anyOf": [
     {
      "enum": [
       "subject_type",
       "brand_name",
       "niche",
       "brand_voice",
       "language",
       "visual_style",
       "audience",
       "content_format",
       "content_pillars",
       "hook_patterns",
       "cta_style",
       "kpi_focus",
       "platform",
       "posting_schedule",
       "offer",
       "competitors",
       "constraint",
       "content_preference",
       "fact",
       "other"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "New kind of fact. Omit to keep the current one.",
    "title": "Category"
   },
   "memory_id": {
    "description": "Id of the fact to change, from xcut_get_brand.",
    "maxLength": 100,
    "minLength": 1,
    "title": "Memory Id",
    "type": "string"
   },
   "text": {
    "description": "The fact's new text.",
    "maxLength": 2000,
    "minLength": 2,
    "title": "Text",
    "type": "string"
   }
  },
  "required": [
   "canvas_id",
   "memory_id",
   "text"
  ],
  "title": "xcut_update_memoryArguments",
  "type": "object"
 },
 "name": "xcut_update_memory",
 "securitySchemes": [
  {
   "scopes": [
    "xcut.read",
    "xcut.write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update a brand memory fact"
}
