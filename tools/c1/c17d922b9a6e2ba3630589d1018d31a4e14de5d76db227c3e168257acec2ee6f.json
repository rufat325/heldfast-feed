{
 "annotations": {
  "destructiveHint": true,
  "title": "Book an appointment"
 },
 "description": "Book an appointment on the shop calendar, optionally for a customer, vehicle and order and assigned to technicians. Confirmation/reminder messages are only sent if you ask. Shopmonkey: POST /v3/appointment.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allDay": {
    "description": "All-day appointment.",
    "type": "boolean"
   },
   "color": {
    "default": "blue",
    "description": "Calendar color. Default blue.",
    "enum": [
     "aqua",
     "black",
     "blue",
     "brown",
     "gray",
     "green",
     "orange",
     "purple",
     "red",
     "yellow"
    ],
    "type": "string"
   },
   "customerId": {
    "description": "The customer's id.",
    "type": "string"
   },
   "endDate": {
    "description": "End, ISO 8601 date-time.",
    "type": "string"
   },
   "name": {
    "description": "What the appointment is for, e.g. 'Oil change'.",
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "Notes for the appointment.",
    "type": "string"
   },
   "orderId": {
    "description": "A work order to link.",
    "type": "string"
   },
   "sendConfirmation": {
    "description": "Send the customer a confirmation now.",
    "type": "boolean"
   },
   "sendReminder": {
    "description": "Send the customer a reminder before the appointment.",
    "type": "boolean"
   },
   "startDate": {
    "description": "Start, ISO 8601 date-time.",
    "type": "string"
   },
   "technicianIds": {
    "description": "User ids of the assigned technicians.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "useEmail": {
    "description": "Use email for confirmation/reminder.",
    "type": "boolean"
   },
   "useSMS": {
    "description": "Use SMS for confirmation/reminder.",
    "type": "boolean"
   },
   "vehicleId": {
    "description": "The vehicle's id.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "shopmonkey_create_appointment",
 "title": "Book an appointment"
}
