{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Set which days the person is free (YYYY-MM-DD, today up to 2 years ahead). mode: \"replace\" (default) sets exactly these days, \"add\" / \"remove\" change them. Only with the user's confirmation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dates": {
    "items": {
     "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
     "type": "string"
    },
    "maxItems": 370,
    "type": "array"
   },
   "mode": {
    "enum": [
     "replace",
     "add",
     "remove"
    ],
    "type": "string"
   },
   "participant_id": {
    "description": "From create_plan or join_plan.",
    "type": "string"
   },
   "participant_token": {
    "description": "From create_plan or join_plan.",
    "type": "string"
   },
   "plan": {
    "description": "Plan link (e.g. https://lesgooo.fun/ab12/when) or its 4-character id.",
    "type": "string"
   }
  },
  "required": [
   "plan",
   "participant_id",
   "participant_token",
   "dates"
  ],
  "type": "object"
 },
 "name": "set_availability",
 "title": "Set available days"
}
