     "published",
     "all"
    ],
    "type": "string"
   },
   "tier": {
    "description": "1 descriptive | 2 model-bound | 3 decision/value.",
    "enum": [
     "1",
     "2",
     "3"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
