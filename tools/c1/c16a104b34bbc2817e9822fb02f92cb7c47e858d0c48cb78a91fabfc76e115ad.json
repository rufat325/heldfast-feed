{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Run PyLaia HTR recognition on a document using a specific model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "allowConcurrentExecution": {
    "description": "Allow concurrent execution (default false)",
    "type": "boolean"
   },
   "b2pBackend": {
    "description": "Baseline to polygon backend (default \"Legacy\")",
    "type": "string"
   },
   "batchSize": {
    "description": "Batch size (default 10)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "clearLines": {
    "description": "Clear existing lines before recognition",
    "type": "boolean"
   },
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "credits": {
    "description": "Credits parameter",
    "type": "string"
   },
   "doLinePolygonSimplification": {
    "description": "Simplify line polygons (default true)",
    "type": "boolean"
   },
   "doNotDeleteWorkDir": {
    "description": "Do not delete working directory",
    "type": "boolean"
   },
   "doStructures": {
    "description": "Structure analysis mode",
    "type": "string"
   },
   "doWordSeg": {
    "description": "Perform word segmentation",
    "type": "boolean"
   },
   "docId": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "keepOriginalLinePolygons": {
    "description": "Keep original line polygons (default false)",
    "type": "boolean"
   },
   "languageModel": {
    "description": "Language model to use",
    "type": "string"
   },
   "modelId": {
    "description": "Model/HTR ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "nBest": {
    "description": "Number of best results (default 1)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pages": {
    "description": "Page range (e.g. \"1-5\")",
    "type": "string"
   },
   "printedLanguageModel": {
    "description": "Language model for printed text",
    "type": "string"
   },
   "printedModelId": {
    "description": "Printed text model ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "useExistingLinePolygons": {
    "description": "Use existing line polygons (default false)",
    "type": "boolean"
   },
   "writeKwsIndex": {
    "description": "Write KWS index (default false)",
    "type": "boolean"
   },
   "writeLineConfScore": {
    "description": "Write line confidence scores",
    "type": "boolean"
   },
   "writeWordConfScores": {
    "description": "Write word confidence scores",
    "type": "boolean"
   }
  },
  "required": [
   "collId",
   "modelId",
   "docId"
  ],
  "type": "object"
 },
 "name": "transkribus_pylaia_recognize",
 "title": "Run PyLaia Recognition"
}
