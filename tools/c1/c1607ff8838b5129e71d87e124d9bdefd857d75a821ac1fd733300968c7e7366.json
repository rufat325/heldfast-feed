{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Assignments in an ELMS (Canvas) course, ordered by due date, each with the signed-in student's submission status and score. Narrow with a bucket such as \"upcoming\" or \"unsubmitted\". Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bucket": {
    "description": "Only assignments in this bucket (default: all)",
    "enum": [
     "upcoming",
     "past",
     "overdue",
     "undated",
     "ungraded",
     "unsubmitted",
     "future"
    ],
    "type": "string"
   },
   "course_id": {
    "description": "Canvas course id, from elms_list_courses",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "course_id"
  ],
  "type": "object"
 },
 "name": "elms_list_assignments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assignments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "allowed_extensions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "course_id": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "description": {
       "description": "Assignment instructions, converted from HTML to plain text; null when empty",
       "type": [
        "string",
        "null"
       ]
      },
      "due_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "grading_type": {
       "anyOf": [
        {
         "enum": [
          "pass_fail",
          "percent",
          "letter_grade",
          "gpa_scale",
          "points",
          "not_graded"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "description": "Canvas assignment id",
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "is_quiz": {
       "type": "boolean"
      },
      "lock_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "points_possible": {
       "type": [
        "number",
        "null"
       ]
      },
      "published": {
       "type": "boolean"
      },
      "submission": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "attempt": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "comments": {
           "description": "Instructor and student comments, when requested",
           "items": {
            "additionalProperties": false,
            "properties": {
             "author": {
              "type": [
               "string",
               "null"
              ]
             },
             "comment": {
              "type": "string"
             },
             "created_at": {
              "description": "ISO 8601 timestamp (UTC); null when unset",
              "type": [
               "string",
               "null"
              ]
             }
            },
            "required": [
             "author",
             "comment",
             "created_at"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "excused": {
           "type": "boolean"
          },
          "grade": {
           "type": [
            "string",
            "null"
           ]
          },
          "graded_at": {
           "description": "ISO 8601 timestamp (UTC); null when unset",
           "type": [
            "string",
            "null"
           ]
          },
          "late": {
           "type": "boolean"
          },
          "missing": {
           "type": "boolean"
          },
          "score": {
           "type": [
            "number",
            "null"
           ]
          },
          "state": {
           "enum": [
            "submitted",
            "unsubmitted",
            "graded",
            "pending_review"
           ],
           "type": "string"
          },
          "submitted_at": {
           "description": "ISO 8601 timestamp (UTC); null when unset",
           "type": [
            "string",
            "null"
           ]
          },
          "url": {
           "description": "Preview link for the submission",
           "type": [
            "string",
            "null"
           ]
          }
         },
         "required": [
          "state",
          "score",
          "grade",
          "submitted_at",
          "graded_at",
          "late",
          "missing",
          "excused",
          "attempt",
          "url",
          "comments"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "The user's submission; null when none exists"
      },
      "submission_types": {
       "description": "e.g. \"online_upload\", \"external_tool\"",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "unlock_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "course_id",
      "name",
      "description",
      "due_at",
      "unlock_at",
      "lock_at",
      "points_possible",
      "grading_type",
      "submission_types",
      "allowed_extensions",
      "published",
      "is_quiz",
      "url",
      "submission"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "assignments"
  ],
  "type": "object"
 },
 "title": "List ELMS assignments"
}
