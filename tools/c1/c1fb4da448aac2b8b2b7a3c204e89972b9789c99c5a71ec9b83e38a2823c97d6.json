{
 "description": "Add a new MCP server to the configuration",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "mcpServer": {
    "additionalProperties": false,
    "properties": {
     "args": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "automaticSSEFallback": {
      "type": "boolean"
     },
     "command": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "headers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "name": {
      "type": "string"
     },
     "reconnect": {
      "additionalProperties": false,
      "properties": {
       "enabled": {
        "type": "boolean"
       }
      },
      "required": [
       "enabled"
      ],
      "type": "object"
     },
     "transport": {
      "enum": [
       "stdio",
       "streamable-http",
       "sse"
      ],
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "description"
    ],
    "type": "object"
   }
  },
  "required": [
   "mcpServer"
  ],
  "type": "object"
 },
 "name": "add_mcp_server"
}
