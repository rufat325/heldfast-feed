{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send an email message. Can also be used to reply to existing threads.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bcc": {
    "description": "BCC recipients, comma-separated",
    "type": "string"
   },
   "body": {
    "description": "Email body (plain text). Used as the plain-text alternative when htmlBody is also provided.",
    "type": "string"
   },
   "cc": {
    "description": "CC recipients, comma-separated",
    "type": "string"
   },
   "from": {
    "description": "Sender email address (for send-as aliases)",
    "type": "string"
   },
   "htmlBody": {
    "description": "Optional HTML body. When set alongside body, the message is sent as multipart/alternative; when set alone, as text/html.",
    "type": "string"
   },
   "inReplyTo": {
    "description": "Message-ID header of the message being replied to",
    "type": "string"
   },
   "subject": {
    "description": "Email subject",
    "type": "string"
   },
   "threadId": {
    "description": "Thread ID to reply to",
    "type": "string"
   },
   "to": {
    "description": "Recipient email address(es), comma-separated for multiple",
    "type": "string"
   }
  },
  "required": [
   "to",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "message_send",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "type": "string"
   },
   "labelIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "threadId": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "threadId"
  ],
  "type": "object"
 },
 "title": "Send message"
}
