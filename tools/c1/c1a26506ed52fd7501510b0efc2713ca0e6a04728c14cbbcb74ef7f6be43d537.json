{
 "annotations": {
  "destructiveHint": true,
  "title": "Add a note"
 },
 "description": "WRITE: add a note to a constituent's record. Bloomerang: POST /note.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "constituent_id": {
    "description": "The API Id of the constituent (not the CRM AccountNumber).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "date": {
    "description": "Note date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "note": {
    "description": "The note text.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "constituent_id",
   "date",
   "note"
  ],
  "type": "object"
 },
 "name": "bloomerang_create_note",
 "title": "Add a note"
}
