 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Pok\u00e9mon sets"
 },
 "description": "Use this when the user names a Pok\u00e9mon TCG set or asks which sets exist. Sets by name or code, or every set newest first. Each set has its id, code, release date, logo, and its card list and sealed product pages on pokefocus.com.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 20,
    "description": "Results per page.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Page of results.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Set name or code. Leave empty to list sets, newest release first.",
    "maxLength": 120,
    "type": "string"
   },
   "sort": {
    "description": "relevance (the default with q), releaseDate (newest first, the default without q), set (A to Z), or year (newest first).",
    "enum": [
     "relevance",
     "releaseDate",
     "set",
     "year"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_sets",
 "outputSchema": {
  "properties": {
   "capturedAt": {
    "description": "When PokeFocus answered; market.asOf is when a price was refreshed.",
