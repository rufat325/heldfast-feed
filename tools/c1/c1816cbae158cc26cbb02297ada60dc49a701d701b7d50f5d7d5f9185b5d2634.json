{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete Mailbox Rule"
 },
 "description": "Delete one deterministic inbox rule by exact rule ID. Bulk deletion is unavailable. expected_position detects concurrent reordering.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "expected_position": {
    "description": "Optional optimistic check. Fail with conflict when the rule's current position differs.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "Mailbox ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "rule_id": {
    "description": "Exact rule ID to delete. Bulk delete is not supported.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "id",
   "rule_id"
  ],
  "type": "object"
 },
 "name": "shipmail_delete_mailbox_rule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "properties": {
     "id": {
      "type": "string"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "ok",
     "id"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Delete Mailbox Rule"
}
