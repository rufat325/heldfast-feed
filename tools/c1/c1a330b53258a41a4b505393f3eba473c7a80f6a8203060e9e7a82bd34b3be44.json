{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estad\u00edsticas de mercado de subastas resueltas (tasa de adjudicaci\u00f3n, descuento real, precios) por provincia y/o tipo de inmueble. Requiere cuenta (scope `informes:read`) y plan Pro o superior; si no, `plan_required` con `locked`.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "provincia": {
    "description": "Slug en min\u00fasculas (p. ej. `madrid`)",
    "pattern": "^[a-z0-9-]{1,80}$",
    "type": "string"
   },
   "tipo": {
    "description": "Tipo de inmueble (valor exacto)",
    "maxLength": 60,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mercado",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "ambito": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "cta": {
    "additionalProperties": {},
    "properties": {
     "text": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "url"
    ],
    "type": "object"
   },
   "disclosure": {
    "type": "string"
   },
   "locked": {
    "additionalProperties": {},
    "properties": {
     "feature": {
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "locked": {
      "const": true,
      "type": "boolean"
     },
     "loginUrl": {
      "type": "string"
     },
     "plansLabel": {
      "type": "string"
     },
     "requiredPlan": {
      "anyOf": [
       {
        "additionalProperties": {},
        "properties": {
         "key": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "priceMonth": {
          "type": "number"
         },
         "priceMonthLabel": {
          "type": "string"
         }
        },
        "required": [
         "key",
         "name",
         "priceMonth",
         "priceMonthLabel"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "type": "string"
     },
     "upgradeUrl": {
      "type": "string"
     }
    },
    "required": [
     "locked",
     "feature",
     "label",
     "plansLabel",
     "requiredPlan",
     "upgradeUrl",
     "loginUrl"
    ],
    "type": "object"
   },
   "minimo": {
    "type": "number"
   },
   "muestra_insuficiente": {
    "type": "boolean"
   },
   "stats": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "ambito",
   "stats"
  ],
  "type": "object"
 },
 "title": "Estad\u00edsticas de mercado"
}
