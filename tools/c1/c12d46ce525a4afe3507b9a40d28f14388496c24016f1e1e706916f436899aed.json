{"_meta":{"securitySchemes":[{"scopes":["mcp"],"type":"oauth2"}]},"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Set connector access"},"description":"Change who may connect to a connector project: public on/off, the email allowlist (replaces it), allowed sign-in providers (github, google, microsoft; null = all) and email/password accounts on/off. Omitted fields stay. Workspace owners only.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"allowed_emails":{"items":{"format":"email","maxLength":254,"pattern":"^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"maxItems":500,"type":"array"},"password_accounts":{"type":"boolean"},"project_id":{"description":"The project id","pattern":"^[A-Za-z0-9_-][A-Za-z0-9._:-]{0,127}$","type":"string"},"public":{"type":"boolean"},"sign_in_providers":{"anyOf":[{"items":{"enum":["github","google","microsoft"],"type":"string"},"type":"array"},{"type":"null"}]}},"required":["project_id"],"type":"object"},"name":"set_connector_access","title":"Set connector access"}
