 "description": "List a node's access rules (IP and Origin allowlists, Global nodes only).\n\nWith no active rules, the node accepts requests from any IP and origin.\nIf correctly configured rules still return 403, that's a support case:\noffer contact_chainstack.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "node_id": {
    "description": "Node ID (e.g., ND-123-456-789).",
    "type": "string"
   },
   "rule_type": {
    "anyOf": [
     {
      "enum": [
       "ip",
       "origin"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only return ip or origin rules."
   },
   "status": {
    "anyOf": [
     {
      "enum": [
       "activated",
       "deactivated"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only return activated or deactivated rules."
   }
  },
  "required": [
   "node_id"
  ],
  "type": "object"
 },
 "name": "list_node_access_rules",
