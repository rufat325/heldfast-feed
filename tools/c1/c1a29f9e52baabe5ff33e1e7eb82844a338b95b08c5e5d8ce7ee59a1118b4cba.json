{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Append-only log"},"description":"Append-only log: every reader sees every entry in order (unlike a queue). append(data: any JSON) returns\nseq; entries(after=cursor) returns entries and next; wait_seconds (up to 30) waits for new entries. Oldest\nentries are dropped at the size limit (truncated true).","inputSchema":{"properties":{"action":{"enum":["create","read","append","entries","touch","delete"],"title":"Action","type":"string"},"after":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"After"},"data":{"default":null,"title":"Data"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"limit":{"anyOf":[{"maximum":500,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Limit"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"logArguments","type":"object"},"name":"log","title":"Append-only log"}
