{
 "description": "Get top or recent media for a hashtag. Use search_hashtag first to get the hashtag ID.",
 "inputSchema": {
  "properties": {
   "hashtag_id": {
    "description": "Hashtag ID from search_hashtag",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Number of posts (max 50)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "media_type": {
    "default": "top",
    "description": "Get top or recent media",
    "enum": [
     "top",
     "recent"
    ],
    "type": "string"
   }
  },
  "required": [
   "hashtag_id"
  ],
  "type": "object"
 },
 "name": "get_hashtag_media"
}
