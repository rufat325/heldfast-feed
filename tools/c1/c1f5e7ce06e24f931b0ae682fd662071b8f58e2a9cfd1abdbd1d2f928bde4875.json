{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an agreed tag for an explicit brand_id. List that brand first to avoid slug conflicts. Reuse the stable operation key and exact body after a lost response; never rotate a key to evade a 409.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "additionalProperties": false,
    "description": "Create a tag.",
    "properties": {
     "brand_id": {
      "format": "uuid",
      "title": "Brand Id",
      "type": "string"
     },
     "name": {
      "maxLength": 50,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "slug": {
      "anyOf": [
       {
        "maxLength": 50,
        "minLength": 1,
        "pattern": "^[a-z0-9-]+$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Slug"
     }
    },
    "required": [
     "brand_id",
     "name"
    ],
    "title": "PublicTagCreate",
    "type": "object"
   },
   "idempotency_key": {
    "description": "Stable operation key. Reuse for the same request after a dropped response; use a new key for a new intended operation.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[!-~]+$",
    "type": "string"
   }
  },
  "required": [
   "body",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_tag"
}
