 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create, reserve, or reuse Fantasy Pundit\u2019s one official weekly commentary and league roast for the current available Gameweek. At full-time, a request can be saved and starts automatically as soon as FPL scoring is ready, which may be before FPL changes its public Gameweek label. This can consume shared generation capacity, so call it only after the user explicitly asks. Repeated calls return the same canonical league/Gameweek job. There are no tone or audio controls.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "gameweek": {
    "description": "Expected current Gameweek from the read or failed job. Refuses creation if the available week changed; cannot create historical editions.",
    "maximum": 38,
    "minimum": 1,
    "type": "integer"
   },
   "league": {
    "description": "A public FPL classic league ID, a Fantasy Premier League league URL, or a league name search term. If the user has not provided one, ask them for it before calling this tool.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "league"
  ],
  "type": "object"
 },
 "name": "generate_weekly_commentary",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "canGenerate": {
    "description": "Whether a request can be made for this week. Creation still requires the user to ask for it.",
    "type": "boolean"
   },
   "candidates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "adminName": {
       "type": [
        "string",
        "null"
       ]
      },
      "adminTeamName": {
       "type": [
        "string",
        "null"
       ]
      },
      "entryCount": {
       "type": [
        "string",
        "number",
        "null"
       ]
      },
      "id": {
       "description": "Public FPL classic league ID to use after the user chooses this league.",
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "commentary": {
    "additionalProperties": {},
    "description": "The exact published edition. Present its text as returned; do not create a competing rewrite.",
    "properties": {
     "closing": {
      "type": "string"
     },
     "exchanges": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "speaker": {
         "type": "string"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "speaker",
        "text"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "format": {
      "type": "string"
     },
     "headline": {
      "type": "string"
     },
     "intro": {
      "type": "string"
     },
     "sections": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "body": {
         "type": "string"
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "body"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "shareLine": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "deduplicated": {
    "type": "boolean"
   },
   "deferredUntilFinal": {
    "description": "The request is saved while FPL scoring settles. This is a normal waiting state.",
    "type": "boolean"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     },
     "resetAt": {
      "type": "string"
     },
     "retryAfterSeconds": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "gameweek": {
    "anyOf": [
     {
      "maximum": 38,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "generationMode": {
    "const": "text",
    "type": "string"
   },
   "jobId": {
    "description": "Use this exact ID with get_commentary_result; do not start another job.",
    "type": "string"
   },
   "latestAvailableGameweek": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "latestCompletedGameweek": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "league": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "leagueUrl": {
      "type": "string"
     }
    },
    "required": [
     "leagueUrl"
    ],
    "type": "object"
   },
   "nextAction": {
    "description": "User-actionable guidance for this result.",
    "type": "string"
   },
   "nextStep": {
    "description": "The next safe action. Reading or checking status never grants permission to create an edition.",
    "enum": [
     "present_commentary",
     "poll",
     "ask_to_generate",
     "choose_league",
     "ask_to_retry",
     "unavailable"
    ],
    "type": "string"
   },
   "pollAfterSeconds": {
    "description": "Minimum delay before the next read-only status call. Stop polling when completed or failed.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "progress": {
    "type": "number"
   },
   "publishedAt": {
    "type": "string"
   },
   "resolution": {
    "additionalProperties": false,
    "properties": {
     "input": {
      "type": "string"
     },
     "source": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "input"
    ],
    "type": "object"
   },
   "seasonId": {
    "type": "string"
   },
   "share": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "url",
     "text"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "completed",
     "queued",
     "processing",
     "not_generated",
     "needs_league_selection",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "nextStep"
  ],
  "type": "object"
 },
 "title": "Create Weekly League Roast"
}
