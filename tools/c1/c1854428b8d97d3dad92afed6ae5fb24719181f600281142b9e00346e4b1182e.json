{"annotations":{"destructiveHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Save provision movements"},"description":"Upsert provision movements (additions, amounts utilised) per provision line. Omitted saved lines stay unchanged. To remove selected saved lines, pass remove_leaf_codes; to remove the entire saved set, pass clear_all (never both). An actual removal first returns an approval request; nothing changes then. Review current movements in the Schedule III workspace, then resend the unchanged request with the approval details to proceed.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"clear_all":{"type":"boolean"},"client_id":{"description":"The entity (client) id \u2014 from list_clients.","format":"uuid","type":"string"},"movements":{"items":{"additionalProperties":false,"properties":{"additions":{"pattern":"^\\d{1,16}(\\.\\d{1,2})?$","type":"string"},"leaf_code":{"maxLength":80,"minLength":1,"type":"string"},"utilised":{"$ref":"#/properties/movements/items/properties/additions"}},"required":["leaf_code","additions","utilised"],"type":"object"},"maxItems":500,"type":"array"},"period_id":{"format":"uuid","type":"string"},"removal_count":{"maximum":2000,"minimum":1,"type":"integer"},"removal_token":{"maxLength":200,"minLength":20,"type":"string"},"remove_leaf_codes":{"items":{"$ref":"#/properties/movements/items/properties/leaf_code"},"maxItems":500,"type":"array"},"template_id":{"maxLength":80,"minLength":1,"type":"string"}},"required":["client_id","template_id","period_id","movements"],"type":"object"},"name":"save_provision_movements","title":"Save provision movements"}
