{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Presence list"},"description":"Who is live: announce(member, data, ttl_seconds 1\u2013300, default 60) and refresh before it lapses; list\nreturns live members and a membership value; pass membership with wait_seconds (up to 30) to wait for a\njoin or leave. For announce, ttl_seconds is the member TTL; for create and touch, the set's lifetime.","inputSchema":{"properties":{"action":{"enum":["create","list","announce","leave","touch","delete"],"title":"Action","type":"string"},"data":{"default":null,"title":"Data"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"member":{"anyOf":[{"pattern":"^[A-Za-z0-9][A-Za-z0-9_.:@-]{0,99}$","type":"string"},{"type":"null"}],"default":null,"title":"Member"},"membership":{"anyOf":[{"maxLength":64,"type":"string"},{"type":"null"}],"default":null,"title":"Membership"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"presenceArguments","type":"object"},"name":"presence","title":"Presence list"}
