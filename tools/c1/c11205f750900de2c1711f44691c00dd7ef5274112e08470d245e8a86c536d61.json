{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false
 },
 "description": "Open a support ticket on behalf of a customer. ALWAYS pass requester_email as the real customer email. If you omit it the call still succeeds (201) but the service account owns the ticket and every reply is mailed to the bot, not the customer \u2014 that is the attribution scar. A tool is not done when the API call succeeds; it is done when the next thing that happens is right. This is a write tool and may require a credential.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Required. What happened, in the customer's words.",
    "type": "string"
   },
   "requester_email": {
    "description": "The real customer's email, e.g. ada@example.com. Omit ONLY to reproduce the attribution scar.",
    "type": "string"
   },
   "subject": {
    "description": "Required. Short customer-facing subject, e.g. Cannot find the deployed MCP URL.",
    "type": "string"
   }
  },
  "required": [
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "create_ticket",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "created": {
    "type": "boolean"
   },
   "next": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "status": {
    "type": "number"
   },
   "ticket": {
    "additionalProperties": false,
    "properties": {
     "attribution": {
      "enum": [
       "customer",
       "service_account"
      ],
      "type": "string"
     },
     "body": {
      "type": "string"
     },
     "comments": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "at": {
         "type": "string"
        },
        "author": {
         "type": "string"
        },
        "body": {
         "type": "string"
        }
       },
       "required": [
        "author",
        "body",
        "at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "created_at": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "requester_email": {
      "type": "string"
     },
     "resolved_at": {
      "type": "string"
     },
     "status": {
      "enum": [
       "open",
       "pending",
       "solved"
      ],
      "type": "string"
     },
     "subject": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "subject",
     "body",
     "status",
     "requester_email",
     "attribution",
     "comments",
     "created_at"
    ],
    "type": "object"
   },
   "warning": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "status",
   "created",
   "ticket"
  ],
  "type": "object"
 }
}
