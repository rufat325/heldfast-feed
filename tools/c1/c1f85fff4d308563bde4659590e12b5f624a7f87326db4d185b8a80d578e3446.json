{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Past and current seasons a sport has a schedule for, with the schedule id to pass to athletics_get_schedule for a past season. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "sport_id": {
    "description": "Sport id from athletics_list_sports, e.g. 3 for Football",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "sport_id"
  ],
  "type": "object"
 },
 "name": "athletics_list_seasons",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "seasons": {
    "description": "Newest season first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "current": {
       "type": "boolean"
      },
      "schedule_id": {
       "description": "Pass as `season_schedule_id` to athletics_get_schedule",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "season": {
       "description": "e.g. \"2025\"",
       "type": "string"
      }
     },
     "required": [
      "schedule_id",
      "season",
      "current"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "seasons"
  ],
  "type": "object"
 },
 "title": "List seasons"
}
