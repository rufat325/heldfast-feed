{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read what happened to one application"
 },
 "description": "Returns an application's event timeline and separate submitted, employerConfirmed and replied facts. An application id or pipeline matchId resolves the application. Coverage identifies inspected mail sources and whether a personal inbox is connected; employer mail outside that coverage is unknown. The board column alone is not submission evidence. submittedAnswers contains captured employer-form values and cover-letter delivery for the proven submitted attempt, or null when submission, the attempt or a capture is unproven or unavailable.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicationId": {
    "description": "Application id. A pipeline card's `matchId` is accepted and resolved to the application behind it.",
    "type": "string"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "get_application_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applicationId": {
    "type": "string"
   },
   "company": {
    "type": "string"
   },
   "recoveryState": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "type": "string"
   },
   "submittedAnswers": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "attemptId": {
        "type": "string"
       },
       "capturedAt": {
        "type": "string"
       },
       "coverLetterDelivered": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ]
       },
       "items": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "id": {
           "type": "string"
          },
          "kind": {
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "omitted": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "order": {
           "maximum": 9007199254740991,
           "minimum": -9007199254740991,
           "type": "integer"
          },
          "value": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          },
          "values": {
           "anyOf": [
            {
             "items": {
              "type": "string"
             },
             "type": "array"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "id",
          "order",
          "label",
          "kind",
          "value",
          "values",
          "omitted"
         ],
         "type": "object"
        },
        "type": "array"
       }
      },
      "required": [
       "attemptId",
       "capturedAt",
       "coverLetterDelivered",
       "items"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "timeline": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "at": {
       "type": "string"
      },
      "detail": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "at",
      "kind",
      "source",
      "summary",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "truth": {
    "additionalProperties": false,
    "properties": {
     "coverage": {
      "additionalProperties": false,
      "properties": {
       "personalInboxConnected": {
        "description": "Whether the person connected a personal mailbox. False means employer mail sent anywhere else is invisible to this read.",
        "type": "boolean"
       },
       "relayInspectedThrough": {
        "description": "Instant through which Dreamwork's own relay mail was read.",
        "type": "string"
       },
       "sources": {
        "description": "The mailboxes this read covered, e.g. [\"relay\"].",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "relayInspectedThrough",
       "personalInboxConnected",
       "sources"
      ],
      "type": "object"
     },
     "employerConfirmed": {
      "description": "The employer's own confirmation was received.",
      "type": "boolean"
     },
     "replied": {
      "description": "A recruiter reply reached the person's inbox.",
      "type": "boolean"
     },
     "submitted": {
      "description": "A submission status the schema counts as sent.",
      "type": "boolean"
     }
    },
    "required": [
     "submitted",
     "employerConfirmed",
     "replied",
     "coverage"
    ],
    "type": "object"
   }
  },
  "required": [
   "applicationId",
   "title",
   "company",
   "status",
   "truth",
   "timeline",
   "recoveryState",
   "submittedAnswers"
  ],
  "type": "object"
 },
 "title": "Read what happened to one application"
}
