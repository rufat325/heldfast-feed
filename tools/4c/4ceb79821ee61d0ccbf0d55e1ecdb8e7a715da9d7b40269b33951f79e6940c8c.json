{
 "description": "Commission a directed red-team of a connected model or agent: escrow a bounty pool (record-only until money-go) and open it to vetted red-teamers. Validated breaks accrue severity-weighted payouts and enter your buyer-scoped safety corpus. Requires red_team:write + the red_team rollout.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "anonymize": {
    "description": "Hide the target identity from red-teamers.",
    "type": "boolean"
   },
   "categories": {
    "description": "Attack categories in scope (taxonomy keys). Prohibited categories are rejected.",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "embargoDays": {
    "description": "Disclosure embargo (days).",
    "minimum": 0,
    "type": "integer"
   },
   "firstBreakBonusCents": {
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "enum": [
     "SELF_SERVE",
     "MANAGED"
    ],
    "type": "string"
   },
   "perBreakCents": {
    "description": "Per-validated-break payout (cents).",
    "minimum": 0,
    "type": "integer"
   },
   "poolCents": {
    "description": "Bounty pool (cents), escrowed record-only.",
    "minimum": 0,
    "type": "integer"
   },
   "targetDescription": {
    "description": "Description of the connected target.",
    "type": "string"
   },
   "targetKind": {
    "description": "What is being attacked.",
    "enum": [
     "MODEL",
     "AGENT"
    ],
    "type": "string"
   },
   "title": {
    "description": "Challenge title shown to red-teamers.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "categories",
   "poolCents"
  ],
  "type": "object"
 },
 "name": "opentrain_red_team_commission",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
