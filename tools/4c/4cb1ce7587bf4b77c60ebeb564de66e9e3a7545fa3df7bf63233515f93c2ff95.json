{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Parse expense text"
 },
 "description": "Parse a natural language expense description into structured fields. Does NOT add the expense \u2014 just returns the parsed fields for review. Example: \"Lunch at Chipotle $15.50 today\" \u2192 {merchant: \"Chipotle\", total: 15.50, ...}",
 "inputSchema": {
  "properties": {
   "text": {
    "description": "Natural language expense (e.g., \"Coffee at Starbucks $6.50 yesterday\")",
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "parse_expense",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "categoryNames": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expenses": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "amount": {
       "type": "number"
      },
      "category": {
       "type": "string"
      },
      "currency": {
       "type": "string"
      },
      "date": {
       "format": "date",
       "type": "string"
      },
      "merchant": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "success": {
    "type": "boolean"
   },
   "validationErrors": {
    "items": {},
    "type": "array"
   }
  },
  "required": [
   "success",
   "expenses",
   "validationErrors",
   "categoryNames"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "expenses.write"
   ],
   "type": "oauth2"
  }
 ]
}
