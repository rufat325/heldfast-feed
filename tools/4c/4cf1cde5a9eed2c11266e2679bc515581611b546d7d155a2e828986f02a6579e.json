{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Service Schedule"
 },
 "description": "Update a service schedule window. Pass only fields to change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "byWeekday": {
    "anyOf": [
     {
      "items": {
       "maximum": 6,
       "minimum": 0,
       "type": "integer"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Weekdays (0=Mon..6=Sun) for weekly recurrence"
   },
   "date": {
    "description": "Date (YYYY-MM-DD)",
    "type": "string"
   },
   "endTime": {
    "description": "End time (HH:mm)",
    "type": "string"
   },
   "maxCapacity": {
    "description": "Maximum capacity for this slot",
    "type": "number"
   },
   "notes": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Free-form notes"
   },
   "recurrence": {
    "description": "Recurrence rule: none | daily | weekly | monthly",
    "enum": [
     "none",
     "daily",
     "weekly",
     "monthly"
    ],
    "type": "string"
   },
   "recurrenceEndDate": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Recurrence end date (YYYY-MM-DD)"
   },
   "recurrenceInterval": {
    "description": "Recurrence interval (e.g. every N weeks)",
    "type": "number"
   },
   "resourceId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Resource ID (room/equipment)"
   },
   "scheduleId": {
    "description": "Schedule ID",
    "type": "string"
   },
   "staffId": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Staff member ID"
   },
   "startTime": {
    "description": "Start time (HH:mm)",
    "type": "string"
   }
  },
  "required": [
   "scheduleId"
  ],
  "type": "object"
 },
 "name": "update_service_schedule",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
