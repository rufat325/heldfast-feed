{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Register a webhook endpoint to receive HonkIO event notifications. Live keys only: a test key gets 403 LIVE_KEY_REQUIRED. The signing_secret in the response is shown once; store it to verify X-HonkIO-Signature on incoming requests. Email events (email.* and email_domain.*) are accepted only once email is enabled on the platform; before that the API answers 422 VALIDATION_ERROR.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "events": {
    "description": "Event types to subscribe to.",
    "items": {
     "enum": [
      "message.queued",
      "message.sending",
      "message.sent",
      "message.delivered",
      "message.failed",
      "message.undelivered",
      "message.received",
      "opt_out.recorded",
      "opt_out.reinstated",
      "consent.double_opt_in_confirmed",
      "account.delivery_warning",
      "account.sending_paused",
      "account.spend_warning",
      "account.inbound_email_capped",
      "account.inbound_sms_capped",
      "account.auto_topup_succeeded",
      "account.auto_topup_paused",
      "email.queued",
      "email.sent",
      "email.delivered",
      "email.delivery_delayed",
      "email.bounced",
      "email.complained",
      "email.rejected",
      "email.failed",
      "email.opened",
      "email.clicked",
      "email.unsubscribed",
      "email.cancelled",
      "email.rescheduled",
      "email.received",
      "email_domain.verified",
      "email_domain.verification_failed",
      "email_domain.receiving_verified",
      "email_domain.receiving_failed",
      "phone_number.suspended",
      "phone_number.released",
      "toll_free_verification.approved",
      "toll_free_verification.rejected",
      "toll_free_verification.changes_requested"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "url": {
    "description": "HTTPS URL to deliver events to.",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "events"
  ],
  "type": "object"
 },
 "name": "create_webhook",
 "title": "Create webhook"
}
