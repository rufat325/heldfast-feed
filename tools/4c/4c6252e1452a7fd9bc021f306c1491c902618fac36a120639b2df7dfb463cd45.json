{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get event subscribers"
 },
 "description": "List the users who marked themselves 'Interested' in a scheduled event. Returns { subscribers: [...], nextCursor }. A page holds up to 100 users; if nextCursor is non-null, pass it back as `after` to fetch the next page. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "Pagination cursor: a user ID (snowflake). Pass the previous response's nextCursor to fetch the next page.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "event_id": {
    "description": "ID (snowflake) of the scheduled event.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Max subscribers per page (1\u2013100). Default 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "guild_id",
   "event_id"
  ],
  "type": "object"
 },
 "name": "discord_get_event_subscribers",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "subscribers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "avatar": {
       "type": "string"
      },
      "user_id": {
       "type": "string"
      },
      "username": {
       "type": "string"
      }
     },
     "required": [
      "user_id",
      "username",
      "avatar"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "subscribers",
   "nextCursor"
  ],
  "type": "object"
 }
}
