{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "read:ads",
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Confirm cap and launch campaign"
 },
 "description": "Activates the paused campaign. Restate the exact candidate approvalHash, account/campaign or OpenAI ad, platform, current budget amount/type/currency from a fresh soclo_campaign_chat_preview and pass confirmed:true; it re-reads, then sets the campaign active with soclo_ads_update_ad_campaign_status and reads the provider status back. Manual launch does not require Ads Watch. No new campaign, changed targeting, guessed price or automatic payment. Unknown activation must be read back with soclo_campaign_chat_status, never retried.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "adId": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "approvalHash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "campaignId": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "confirmed": {
    "description": "true only for the exact freshly displayed launch candidate.",
    "type": "boolean"
   },
   "countries": {
    "description": "Proposed country display only; never proof of live targeting.",
    "items": {
     "pattern": "^[A-Z]{2}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "expectedBudgetAmount": {
    "minimum": 0,
    "type": "number"
   },
   "expectedBudgetType": {
    "enum": [
     "daily",
     "lifetime"
    ],
    "type": "string"
   },
   "expectedCurrency": {
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "platform": {
    "enum": [
     "meta",
     "google",
     "openai-ads",
     "tiktok-ads",
     "linkedin-ads",
     "pinterest-ads",
     "x-ads"
    ],
    "type": "string"
   },
   "requestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "accountId",
   "platform"
  ],
  "type": "object"
 },
 "name": "soclo_campaign_chat_confirm",
 "title": "Confirm cap and launch campaign"
}
