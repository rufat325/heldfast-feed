{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search my library"
 },
 "description": "Search the Library of past generations kept by this account, newest first: filter by words in the prompt or title and by kind (3d, image, \u2026). Returns the job id, model, status and result file URLs of each run. Use next_cursor to page. Only runs of this account are ever searched. For the full detail of one run call get_job.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cursor": {
    "description": "The next_cursor of the previous result.",
    "maxLength": 8,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "How many to return, 1 to 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "media_type": {
    "description": "Only runs of this kind, e.g. '3d' or 'image'.",
    "enum": [
     "music",
     "image",
     "video",
     "text",
     "speech",
     "3d"
    ],
    "type": "string"
   },
   "query": {
    "description": "Words to look for in the prompt or title.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_library",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "credits_charged": {
       "type": "number"
      },
      "files": {
       "description": "Up to 4 result files with download URLs.",
       "items": {
        "additionalProperties": false,
        "properties": {
         "alternates": {
          "description": "The same model in other formats the provider returned.",
          "items": {
           "additionalProperties": false,
           "properties": {
            "format": {
             "type": "string"
            },
            "source": {
             "anyOf": [
              {
               "type": "string"
              },
              {
               "type": "null"
              }
             ]
            },
            "url": {
             "description": "Public https download URL.",
             "type": "string"
            }
           },
           "required": [
            "format",
            "url",
            "source"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "asset_id": {
          "description": "The output file id inside the job.",
          "type": "string"
         },
         "content_type": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "duration_seconds": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "format": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "File format, e.g. 'glb', 'fbx', 'png'; null if unknown."
         },
         "height": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "media_type": {
          "description": "What the file is: '3d', 'image', 'video' or 'music'.",
          "type": "string"
         },
         "role": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ],
          "description": "What the output is within its job, e.g. 'normal' for a map."
         },
         "size_bytes": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         },
         "thumbnail_url": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "url": {
          "description": "Public https download URL.",
          "type": "string"
         },
         "width": {
          "anyOf": [
           {
            "type": "number"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "asset_id",
         "media_type",
         "format",
         "url",
         "thumbnail_url",
         "content_type",
         "size_bytes",
         "width",
         "height",
         "duration_seconds",
         "role",
         "alternates"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "job_id": {
       "description": "Pass to get_job for the full result.",
       "type": "string"
      },
      "media_type": {
       "type": "string"
      },
      "model": {
       "type": "string"
      },
      "prompt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "The start of the prompt."
      },
      "scene": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "enum": [
        "pending",
        "processing",
        "success",
        "partial",
        "failed",
        "canceled"
       ],
       "type": "string"
      },
      "title": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "job_id",
      "title",
      "prompt",
      "media_type",
      "model",
      "scene",
      "status",
      "credits_charged",
      "created_at",
      "files"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass as cursor for the next page; null at the end."
   },
   "total": {
    "description": "How many runs match in all.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Search my library"
}
