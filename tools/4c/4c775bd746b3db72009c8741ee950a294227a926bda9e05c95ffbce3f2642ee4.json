{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/web.page-delta",
  "agent-utilities/priceMicroUsd": 0
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return added and removed content blocks from supplied before/after HTML; avoid rereading unchanged text. Explicit shared output budget and scope. FREE during validation. No key, credits or wallet. Existing source and input limits apply.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "afterHtml": {
      "maxLength": 100000,
      "type": "string"
     },
     "beforeHtml": {
      "maxLength": 100000,
      "type": "string"
     },
     "maxChars": {
      "default": 6000,
      "maximum": 12000,
      "minimum": 256,
      "type": "integer"
     },
     "sourceUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "beforeHtml",
     "afterHtml"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "web_page_delta",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "added": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "addedBlocks": {
    "type": "number"
   },
   "changed": {
    "type": "boolean"
   },
   "measurement": {
    "additionalProperties": false,
    "properties": {
     "estimateMethod": {
      "type": "string"
     },
     "estimatedInputTokens": {
      "type": "number"
     },
     "estimatedPayloadTokens": {
      "type": "number"
     },
     "inputBytes": {
      "type": "number"
     },
     "payloadBytes": {
      "type": "number"
     }
    },
    "required": [
     "inputBytes",
     "payloadBytes",
     "estimatedInputTokens",
     "estimatedPayloadTokens",
     "estimateMethod"
    ],
    "type": "object"
   },
   "removed": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "removedBlocks": {
    "type": "number"
   },
   "reorderedOnly": {
    "type": "boolean"
   },
   "scope": {
    "type": "string"
   },
   "sourceUrl": {
    "type": [
     "string",
     "null"
    ]
   },
   "titleAfter": {
    "type": "string"
   },
   "titleBefore": {
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "sourceUrl",
   "changed",
   "titleBefore",
   "titleAfter",
   "added",
   "removed",
   "addedBlocks",
   "removedBlocks",
   "reorderedOnly",
   "truncated",
   "scope",
   "measurement"
  ],
  "type": "object"
 }
}
