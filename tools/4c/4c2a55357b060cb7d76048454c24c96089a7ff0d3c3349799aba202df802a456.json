{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Connect to a Thalovant hub with a saved identity and return runtime transport health.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configPath": {
    "description": "Path to a Thalovant SDK config file.",
    "minLength": 1,
    "type": "string"
   },
   "fromEnv": {
    "default": false,
    "description": "Load the identity from Thalovant SDK environment variables.",
    "type": "boolean"
   },
   "identityFile": {
    "description": "Path to a Thalovant identity JSON file.",
    "minLength": 1,
    "type": "string"
   },
   "profile": {
    "description": "SDK config profile name.",
    "minLength": 1,
    "type": "string"
   },
   "protocol": {
    "default": "wss",
    "description": "Runtime transport protocol.",
    "enum": [
     "wss",
     "https",
     "mqtt"
    ],
    "type": "string"
   },
   "timeoutMs": {
    "default": 10000,
    "maximum": 300000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "thalovant_healthcheck",
 "title": "Runtime Healthcheck"
}
