{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Price chart: candlestick chart and indicators for a public ticker. Use it when someone wants a chart, a candlestick chart, a price chart or indicators on a symbol, such as a daily chart of AAPL with SMA and RSI. Pass symbol (AAPL, BRK-B, EUR/USD, BTC-USD, GOLD), optional timeframe (5m, 15m, 1h, 1d, 1w; 1d by default), optional indicators (sma, ema, rsi, macd, bollinger, atr, stochastic, vwap; up to 4; volume is always drawn) and optional theme (dark or light). Returns a self-contained interactive HTML candlestick chart plus a short plain-language read of the last price and the indicator values, with the source and as-of time. Public prices only. Informational only, not financial advice: no orders, no signals, no recommendations.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "indicators": {
    "description": "Up to 4 of sma, ema, rsi, macd, bollinger, atr, stochastic, vwap. Volume is always drawn. Defaults to sma and rsi when omitted.",
    "items": {
     "enum": [
      "sma",
      "ema",
      "rsi",
      "macd",
      "bollinger",
      "atr",
      "stochastic",
      "vwap"
     ],
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 1,
    "type": "array"
   },
   "periods": {
    "additionalProperties": false,
    "description": "Lookback per indicator, in bars. MACD stays 12, 26, 9.",
    "properties": {
     "atr": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "bollinger": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "ema": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "rsi": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "sma": {
      "description": "20 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     },
     "stochastic": {
      "description": "14 by default",
      "maximum": 100,
      "minimum": 2,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "symbol": {
    "description": "Ticker, currency pair or crypto pair, such as AAPL, EUR/USD or BTC-USD",
    "maxLength": 24,
    "minLength": 1,
    "type": "string"
   },
   "theme": {
    "description": "dark (default) or light",
    "enum": [
     "dark",
     "light"
    ],
    "type": "string"
   },
   "timeframe": {
    "description": "5m, 15m, 1h, 1d (default) or 1w",
    "enum": [
     "5m",
     "15m",
     "1h",
     "1d",
     "1w"
    ],
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "chart",
 "outputSchema": {
  "properties": {
   "asOf": {
    "type": "string"
   },
   "bars": {
    "type": "integer"
   },
   "changePercent": {
    "description": "Percent change from the previous close to the last close",
    "type": [
     "number",
     "null"
    ]
   },
   "chartLibrary": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "error": {
    "properties": {
     "code": {
      "type": "string"
     },
     "hint": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "hint"
    ],
    "type": "object"
   },
   "html": {
    "description": "Self-contained interactive HTML candlestick chart. Open it in a browser. Vela attribution stays on.",
    "type": "string"
   },
   "indicators": {
    "items": {
     "properties": {
      "indicator": {
       "enum": [
        "sma",
        "ema",
        "rsi",
        "macd",
        "bollinger",
        "atr",
        "stochastic",
        "vwap"
       ],
       "type": "string"
      },
      "latest": {
       "properties": {
        "d": {
         "type": "number"
        },
        "histogram": {
         "type": "number"
        },
        "k": {
         "type": "number"
        },
        "lower": {
         "type": "number"
        },
        "macd": {
         "type": "number"
        },
        "middle": {
         "type": "number"
        },
        "signal": {
         "type": "number"
        },
        "upper": {
         "type": "number"
        },
        "value": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "params": {
       "type": "object"
      },
      "read": {
       "type": "string"
      }
     },
     "required": [
      "indicator",
      "params",
      "latest",
      "read"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "lastClose": {
    "type": [
     "number",
     "null"
    ]
   },
   "name": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "openUrl": {
    "description": "Same chart on chart.openkrill.app, redrawn from public prices",
    "type": "string"
   },
   "read": {
    "description": "Plain-language description of the chart. Not financial advice.",
    "type": "string"
   },
   "skipped": {
    "items": {
     "properties": {
      "indicator": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      }
     },
     "required": [
      "indicator",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "invalid_input",
     "no_data",
     "unavailable",
     "daily_limit"
    ],
    "type": "string"
   },
   "symbol": {
    "type": "string"
   },
   "timeframe": {
    "enum": [
     "5m",
     "15m",
     "1h",
     "1d",
     "1w"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "bars",
   "lastClose",
   "changePercent",
   "indicators",
   "skipped",
   "read",
   "notice",
   "source",
   "asOf"
  ],
  "type": "object"
 },
 "title": "Price chart"
}
