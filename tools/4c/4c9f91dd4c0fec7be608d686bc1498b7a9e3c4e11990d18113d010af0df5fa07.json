{
 "description": "Store a typed memory (user|feedback|project|reference) with mandatory provenance. Returns a stable memory_id; idempotent for identical content+source.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "key": {
    "type": "string"
   },
   "source": {
    "additionalProperties": false,
    "properties": {
     "author": {
      "enum": [
       "human",
       "agent"
      ],
      "type": "string"
     },
     "origin": {
      "type": "string"
     },
     "timestamp": {
      "type": "string"
     }
    },
    "required": [
     "origin",
     "author"
    ],
    "type": "object"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ttl": {
    "type": "number"
   },
   "type": {
    "type": "string"
   }
  },
  "required": [
   "content",
   "type"
  ],
  "type": "object"
 },
 "name": "remember"
}
