{
 "description": "Replace the draft's fields at expectedRevision (at most 200). Each field binds to a signer role (merge fields take mergeKey instead) and a placement: token ({{...}} text in the PDF), text_anchor (text plus place), structural (end_of_document) or coordinate (units pt or pct of the visible page, origin top-left of the CropBox). Returns the placed records, typed warnings and fieldsHash; a stale revision fails REVISION_CONFLICT. Preview before publishing. Receipt-backed. Requires agreements:write. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expectedRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "fields": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "fieldId": {
       "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,63}$",
       "type": "string"
      },
      "key": {
       "pattern": "^[a-z][a-z0-9_]{0,47}$",
       "type": "string"
      },
      "label": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "mergeKey": {
       "enum": [
        "freelancer.legal_name",
        "freelancer.email",
        "freelancer.work_location",
        "contract.start_date",
        "contract.hourly_rate_usd",
        "job.title",
        "employer.legal_name",
        "today"
       ],
       "type": "string"
      },
      "placement": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "kind": {
           "const": "token",
           "type": "string"
          },
          "occurrence": {
           "maximum": 10000,
           "minimum": 1,
           "type": "integer"
          },
          "token": {
           "maxLength": 200,
           "minLength": 5,
           "type": "string"
          }
         },
         "required": [
          "kind",
          "token"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "kind": {
           "const": "text_anchor",
           "type": "string"
          },
          "occurrence": {
           "$ref": "#/properties/fields/items/properties/placement/anyOf/0/properties/occurrence"
          },
          "offsetPt": {
           "additionalProperties": false,
           "properties": {
            "x": {
             "type": "number"
            },
            "y": {
             "type": "number"
            }
           },
           "required": [
            "x",
            "y"
           ],
           "type": "object"
          },
          "place": {
           "default": "right",
           "enum": [
            "right",
            "left",
            "above",
            "below",
            "over"
           ],
           "type": "string"
          },
          "text": {
           "maxLength": 200,
           "minLength": 1,
           "type": "string"
          }
         },
         "required": [
          "kind",
          "text"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "after": {
           "enum": [
            "end_of_document"
           ],
           "type": "string"
          },
          "kind": {
           "const": "structural",
           "type": "string"
          }
         },
         "required": [
          "kind",
          "after"
         ],
         "type": "object"
        },
        {
         "additionalProperties": false,
         "properties": {
          "kind": {
           "const": "coordinate",
           "type": "string"
          },
          "page": {
           "maximum": 10000,
           "minimum": 1,
           "type": "integer"
          },
          "rect": {
           "additionalProperties": false,
           "properties": {
            "height": {
             "$ref": "#/properties/fields/items/properties/size/properties/width"
            },
            "width": {
             "$ref": "#/properties/fields/items/properties/size/properties/width"
            },
            "x": {
             "minimum": 0,
             "type": "number"
            },
            "y": {
             "$ref": "#/properties/fields/items/properties/placement/anyOf/3/properties/rect/properties/x"
            }
           },
           "required": [
            "x",
            "y",
            "width",
            "height"
           ],
           "type": "object"
          },
          "units": {
           "enum": [
            "pt",
            "pct"
           ],
           "type": "string"
          }
         },
         "required": [
          "kind",
          "units",
          "page",
          "rect"
         ],
         "type": "object"
        }
       ]
      },
      "required": {
       "default": true,
       "type": "boolean"
      },
      "role": {
       "pattern": "^[a-z][a-z0-9_]{0,31}$",
       "type": "string"
      },
      "size": {
       "additionalProperties": false,
       "properties": {
        "height": {
         "$ref": "#/properties/fields/items/properties/size/properties/width"
        },
        "width": {
         "exclusiveMinimum": 0,
         "maximum": 2000,
         "type": "number"
        }
       },
       "required": [
        "width",
        "height"
       ],
       "type": "object"
      },
      "type": {
       "enum": [
        "signature",
        "initials",
        "date",
        "name",
        "email",
        "text",
        "checkbox",
        "merge"
       ],
       "type": "string"
      }
     },
     "required": [
      "fieldId",
      "type",
      "placement"
     ],
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key sent as the Idempotency-Key header. Same key + same payload replays the stored outcome (replayed: true); same key + a changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "waivedWarnings": {
    "items": {
     "enum": [
      "ANCHOR_NOT_FOUND",
      "ANCHOR_AMBIGUOUS",
      "FIELD_OVERLAP",
      "FIELD_OUT_OF_BOUNDS",
      "FIELD_OVER_TEXT",
      "ROLE_HAS_NO_SIGNATURE",
      "MERGE_VALUE_MISSING",
      "GLYPH_UNSUPPORTED"
     ],
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "documentId",
   "expectedRevision",
   "fields",
   "idempotencyKey"
  ],
  "type": "object"
 },
