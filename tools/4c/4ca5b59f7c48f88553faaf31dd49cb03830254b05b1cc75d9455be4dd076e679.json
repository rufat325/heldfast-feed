        "description": "Stable error code.",
        "type": "string"
       },
       "message": {
        "description": "Human-readable error message.",
        "type": "string"
       }
      },
      "required": [
       "code",
       "message"
      ],
      "type": "object"
     },
     "success": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "success",
     "error"
    ],
    "type": "object"
