  "additionalProperties": false,
  "properties": {
   "agentName": {
    "description": "Optional agent or platform name for support attribution.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "printing.sessions.start",
