      "properties": {
       "accessTier": {
        "description": "Granted access tier.",
        "type": "string"
       },
       "accessToken": {
        "description": "Bearer token for subsequent ordering tools.",
        "type": "string"
       },
       "expiresAt": {
        "description": "Credential expiration time.",
        "format": "date-time",
        "type": "string"
       },
       "quoteAllowance": {
        "description": "Quotes available during this guest session.",
        "type": "integer"
       },
       "rateLimitPerMinute": {
        "description": "Maximum requests per minute.",
        "type": "integer"
       },
       "scopes": {
        "description": "Operations authorized by the token.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "tokenType": {
        "description": "Token scheme.",
        "type": "string"
       }
      },
      "required": [
       "accessToken",
       "tokenType",
       "expiresAt",
       "scopes"
      ],
      "type": "object"
     },
     "success": {
