{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Score Due Claims"
 },
 "description": "Find every auto-gradable claim that is due (assertions in open/needs_review/stale; predictions whose horizon has passed) and resolve each against fundamentals. Operates on the caller's OWN claims \u2014 omit `customer_id`. Targeting another user's `customer_id` is reserved for Valuein's internal scoring service and is rejected for every plan, including Institutional. Returns a summary + per-claim results. Idempotent \u2014 re-calling only re-resolves what changed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "description": "Snapshot date for the fundamentals window. Defaults to today UTC.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "customer_id": {
    "description": "Target user's Stripe customer_id. Defaults to the caller's own \u2014 leave it unset. Supplying a DIFFERENT customer_id is restricted to Valuein's internal scoring service and is rejected on every plan, Institutional included.",
    "pattern": "^[a-zA-Z0-9_]{4,80}$",
    "type": "string"
   },
   "max": {
    "description": "Soft cap on claims scored per call (default 100).",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "score_due_claims",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
