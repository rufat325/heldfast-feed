{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Log Mileage Trip"
 },
 "description": "Log a vehicle travel trip with automatic trip-date IRS rate calculations. Supports confirm and idempotency validation.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Tax category (defaults to BUSINESS)",
    "enum": [
     "BUSINESS",
     "PERSONAL",
     "MEDICAL",
     "CHARITY"
    ],
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "date": {
    "description": "Optional trip date (YYYY-MM-DD)",
    "type": "string"
   },
   "destination": {
    "description": "The trip destination location",
    "type": "string"
   },
   "distance": {
    "description": "The travel distance in miles (positive finite number <= 5000)",
    "type": "number"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "notes": {
    "description": "Optional notes",
    "type": "string"
   },
   "purpose": {
    "description": "The business purpose of the trip",
    "type": "string"
   },
   "vehicleId": {
    "description": "Optional ID of the vehicle used",
    "type": "string"
   },
   "vehicleName": {
    "description": "Optional name of the vehicle",
    "type": "string"
   }
  },
  "required": [
   "farmId",
   "distance",
   "purpose",
   "destination"
  ],
  "type": "object"
 },
 "name": "log_mileage"
}
