{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Edit a post's title or tags, pin or unpin it within the forum, lock or unlock replies, or archive it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "archived": {
    "type": "boolean"
   },
   "guild": {
    "description": "Guild (server) name or ID. Omit to use the default guild.",
    "type": "string"
   },
   "locked": {
    "type": "boolean"
   },
   "pinned": {
    "type": "boolean"
   },
   "post": {
    "description": "Post title or thread ID.",
    "type": "string"
   },
   "tags": {
    "description": "Replace the applied tags with these.",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "title": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "post"
  ],
  "type": "object"
 },
 "name": "update_forum_post",
 "title": "Update forum post"
}
