{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "readOnlyHint": false
 },
 "description": "Update a file's content or metadata. Provide content to update file content, or just metadata fields to update metadata only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "New content for the file",
    "type": "string"
   },
   "description": {
    "description": "New description for the file",
    "type": "string"
   },
   "fileId": {
    "description": "The ID of the file to update",
    "type": "string"
   },
   "mimeType": {
    "description": "MIME type of the content (required if content is provided)",
    "type": "string"
   },
   "name": {
    "description": "New name for the file",
    "type": "string"
   },
   "starred": {
    "description": "Star or unstar the file",
    "type": "boolean"
   },
   "supportsAllDrives": {
    "default": true,
    "description": "Support shared drives",
    "type": "boolean"
   },
   "trashed": {
    "description": "Move to trash (true) or restore from trash (false). Trashed files can be restored within 30 days.",
    "type": "boolean"
   }
  },
  "required": [
   "fileId"
  ],
  "type": "object"
 },
 "name": "file_update",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "id": {
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   },
   "modifiedTime": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "parents": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "webViewLink": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "name",
   "mimeType"
  ],
  "type": "object"
 },
 "title": "Update file"
}
