{
 "_meta": {
  "openai/visibility": "private",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "taptax:write"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://taptax/send-invoice.html",
   "visibility": [
    "app"
   ]
  },
  "ui/resourceUri": "ui://taptax/send-invoice.html"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send the invoice shown on the card"
 },
 "description": "Emails the invoice shown on a TapTax send card to its client, when the person presses Send on that card. Needs the one-time token the card was given.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "invoiceId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "sendToken": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "invoiceId",
   "sendToken"
  ],
  "type": "object"
 },
 "name": "send_invoice_from_card",
 "title": "Send the invoice shown on the card"
}
