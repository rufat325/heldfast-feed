{
 "description": "Compare download counts across multiple packages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "packages": {
    "description": "Package names to compare",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "period": {
    "default": "last-month",
    "description": "Period: last-day, last-week, last-month, last-year",
    "type": "string"
   }
  },
  "required": [
   "packages"
  ],
  "type": "object"
 },
 "name": "compare_downloads"
}
