{
 "description": "Get top DeFi yields across 40+ chains (DeFiLlama, 15,000+ pools). Filter by chain, project, symbol, min APY, min TVL, stablecoins.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Chain: Ethereum, Arbitrum, Solana, Base...",
    "maxLength": 30,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Max results (1-50)",
    "maximum": 50,
    "type": "number"
   },
   "minApy": {
    "description": "Minimum APY percentage",
    "type": "number"
   },
   "minTvl": {
    "description": "Minimum TVL in USD",
    "type": "number"
   },
   "project": {
    "description": "Protocol: lido, aave, uniswap...",
    "maxLength": 50,
    "type": "string"
   },
   "stablecoins": {
    "description": "Only stablecoin pools",
    "type": "boolean"
   },
   "symbol": {
    "description": "Token symbol: USDC, ETH, SOL...",
    "maxLength": 20,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "defi_yields"
}
