{
 "description": "Find potential dead code: unused variables, unreachable code after return/throw, empty catch blocks, commented-out code blocks, and TODO/FIXME/HACK comments.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "checkCommentedCode": {
    "default": true,
    "description": "Check for commented-out code blocks",
    "type": "boolean"
   },
   "checkEmptyCatch": {
    "default": true,
    "description": "Check for empty catch blocks",
    "type": "boolean"
   },
   "checkTodos": {
    "default": true,
    "description": "Check for TODO/FIXME/HACK comments",
    "type": "boolean"
   },
   "checkUnreachable": {
    "default": true,
    "description": "Check for unreachable code after return/throw",
    "type": "boolean"
   },
   "checkUnused": {
    "default": true,
    "description": "Check for unused variables",
    "type": "boolean"
   },
   "code": {
    "description": "The source code to analyze",
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "find_dead_code"
}
