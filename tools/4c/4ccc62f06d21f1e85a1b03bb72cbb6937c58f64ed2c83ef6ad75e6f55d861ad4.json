{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\uc6b0\ub9ac \uc544\uc774 \ucd9c\uc0b0\u00b7\uc591\uc721 \uc9c0\uc6d0\uae08 \ub9de\ucda4 \uacc4\uc0b0"},"description":"\uc9c0\uc5ed\u00b7\ucd9c\uc0dd \uc21c\uc11c\u00b7\uc544\uc774 \uc6d4\ub839\uc73c\ub85c \uc911\uc559\uc815\ubd80 \ud604\uae08 \uc9c0\uc6d0(\uccab\ub9cc\ub0a8\uc774\uc6a9\uad8c\u00b7\ubd80\ubaa8\uae09\uc5ec\u00b7\uc544\ub3d9\uc218\ub2f9)\uc758 \ucd9c\uc0dd \uae30\uc900 \ucd1d\uc561\uacfc \uc9c0\uae08\ubd80\ud130 \ub0a8\uc740 \uae08\uc561\uc744 \uacc4\uc0b0\ud558\uace0, \uc0ac\ub78c\uc774 \ud655\uc778\ud55c \uc9c0\uc790\uccb4 \uae08\uc561\ud45c(\uc788\ub294 \uc9c0\uc5ed\ub9cc)\uc640 \uc9c0\uae08 \uc2dc\uae30\uc5d0 \ub9de\ub294 \uc9c0\uc5ed \uc9c0\uc6d0\uc0ac\uc5c5\uc744 \ud568\uaed8 \ub3cc\ub824\uc900\ub2e4. \uae08\uc561 \uadfc\uac70\ub294 \ubcf4\uac74\ubcf5\uc9c0\ubd80\u00b7\ubcf5\uc9c0\ub85c \uae30\uc900\ud45c\uc774\uba70 \uc9c0\uc790\uccb4 \uc9c0\uc6d0\uae08\uc740 \ud569\uacc4\uc5d0 \ub123\uc9c0 \uc54a\ub294\ub2e4.","inputSchema":{"properties":{"birth_order":{"description":"\ucd9c\uc0dd \uc21c\uc11c(1 \uccab\uc9f8, 2 \ub458\uc9f8, 3 \uc14b\uc9f8 \uc774\uc0c1, \uae30\ubcf8 1)","maximum":5,"minimum":1,"type":"integer"},"child_age_months":{"description":"\uc544\uc774\uac00 \uc774\ubbf8 \uc9c0\ub09c \ub9cc \uac1c\uc6d4 \uc218(0~107). \ube44\uc6b0\uba74 \uc784\uc2e0 \uc911\u00b7\ucd9c\uc0dd \uc804","maximum":107,"minimum":0,"type":"integer"},"sgg":{"description":"\uc2dc\u00b7\uad70\u00b7\uad6c(\uc608: \ub9c8\ud3ec\uad6c, \uc120\ud0dd)","type":"string"},"sido":{"description":"\uc2dc\u00b7\ub3c4(\uc608: \uc11c\uc6b8\ud2b9\ubcc4\uc2dc)","type":"string"}},"required":["sido"],"type":"object"},"name":"plan_birth_support","title":"\uc6b0\ub9ac \uc544\uc774 \ucd9c\uc0b0\u00b7\uc591\uc721 \uc9c0\uc6d0\uae08 \ub9de\ucda4 \uacc4\uc0b0"}
