{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find every page whose extracted text contains an exact phrase, whole word or regular expression - for a quotation, a dollar figure, a cause or exhibit number, a name or a defined term, where search ranks by meaning and may miss the exact words. Returns the total count, counts per filing, and each match's page id, citation and snippet. Case-insensitive unless case_sensitive; curly quotes, dashes, ligatures and line breaks are normalized. `document` filters by filename substring. Matches are automatically extracted text, not verified: fetch the page before quoting it. Zero matches means zero in the extracted text, not that the record lacks the words.",
 "inputSchema": {
  "properties": {
   "case": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Case"
   },
   "case_sensitive": {
    "default": false,
    "title": "Case Sensitive",
    "type": "boolean"
   },
   "document": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Document"
   },
   "limit": {
    "default": 50,
    "title": "Limit",
    "type": "integer"
   },
   "mode": {
    "default": "phrase",
    "enum": [
     "phrase",
     "word",
     "regex"
    ],
    "title": "Mode",
    "type": "string"
   },
   "pattern": {
    "title": "Pattern",
    "type": "string"
   }
  },
  "required": [
   "pattern"
  ],
  "title": "grepArguments",
  "type": "object"
 },
