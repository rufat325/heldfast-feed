{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check SSL/TLS certificate"
 },
 "description": "Run a live TLS handshake against host:port and audit the certificate the server presents. Returns an A/B/C/F grade and summary, expiry (days remaining), hostname match, chain completeness and trust against Mozilla's root store, negotiated TLS version and cipher suite, key type/size, findings, and a link to the full report. Revocation (OCSP/CRL) is NOT checked. Hosts on Cloudflare's own network cannot be checked live (result: isError with code live_check_unavailable, no grade); a failed handshake returns check_failed with no grade. Read-only: it only opens a TLS connection to the public host. Same engine, cache and limits as the CertGuard JSON API (GET /api/v1/check).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "host": {
    "description": "Hostname or public IP to check, e.g. example.com. An https:// URL is accepted and reduced to its host (and port). Private, internal and reserved addresses are rejected.",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   },
   "include_raw": {
    "default": false,
    "description": "Also return the full /api/v1/check JSON (all chain certificates, SANs, handshake attempts) in structuredContent.raw. Larger output.",
    "type": "boolean"
   },
   "port": {
    "default": 443,
    "description": "TCP port (default 443). Allowed: 443, 8443, 465, 993, 995.",
    "enum": [
     443,
     8443,
     465,
     993,
     995
    ],
    "type": "integer"
   }
  },
  "required": [
   "host"
  ],
  "type": "object"
 },
 "name": "check_certificate",
 "outputSchema": {
  "properties": {
   "apiUrl": {
    "type": "string"
   },
   "cached": {
    "type": "boolean"
   },
   "certificate": {
    "properties": {
     "issuer": {
      "type": "string"
     },
     "issuerOrg": {
      "type": "string"
     },
     "key": {
      "type": "string"
     },
     "sanCount": {
      "type": "integer"
     },
     "sans": {
      "description": "First 20 DNS names",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sha256Fingerprint": {
      "type": "string"
     },
     "signatureAlgorithm": {
      "type": "string"
     },
     "subject": {
      "type": "string"
     },
     "validationType": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "chain": {
    "properties": {
     "complete": {
      "type": "boolean"
     },
     "presented": {
      "type": "integer"
     },
     "trustAnchor": {
      "type": "string"
     },
     "trusted": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "checkedAt": {
    "type": "string"
   },
   "expiry": {
    "properties": {
     "daysRemaining": {
      "type": "integer"
     },
     "notAfter": {
      "type": "string"
     },
     "notBefore": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "warning",
       "critical",
       "expired",
       "not_yet_valid"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "grade": {
    "enum": [
     "A",
     "B",
     "C",
     "F"
    ],
    "type": "string"
   },
   "gradeEstimated": {
    "description": "true when the result was inferred from Certificate Transparency logs instead of a live handshake",
    "type": "boolean"
   },
   "host": {
    "type": "string"
   },
   "hostname": {
    "properties": {
     "matchedName": {
      "type": "string"
     },
     "matches": {
      "type": "boolean"
     },
     "note": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "issues": {
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "severity",
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notChecked": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "plan": {
    "enum": [
     "anonymous",
     "key"
    ],
    "type": "string"
   },
   "port": {
    "type": "integer"
   },
   "raw": {
    "description": "Full /api/v1/check response (only when include_raw is true)",
    "type": "object"
   },
   "reportUrl": {
    "type": "string"
   },
   "revocation_checked": {
    "description": "Always false: OCSP/CRL status is not queried",
    "type": "boolean"
   },
   "source": {
    "properties": {
     "ip": {
      "type": "string"
     },
     "live": {
      "type": "boolean"
     },
     "method": {
      "enum": [
       "live_tls_handshake",
       "certificate_transparency"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "status": {
    "enum": [
     "checked"
    ],
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "tls": {
    "properties": {
     "cipherSuite": {
      "type": "string"
     },
     "keyExchangeGroup": {
      "type": "string"
     },
     "ocspStapled": {
      "type": "boolean"
     },
     "version": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "host",
   "port",
   "status",
   "grade",
   "summary",
   "revocation_checked",
   "reportUrl"
  ],
  "type": "object"
 },
 "title": "Check a server's SSL/TLS certificate (expiry, chain, hostname, TLS version)"
}
