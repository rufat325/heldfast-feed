{
 "description": "Add a note to an order",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customer_note": {
    "description": "Customer-facing note, emailed to the customer (default false = private)",
    "type": "boolean"
   },
   "id": {
    "description": "Order ID",
    "type": "integer"
   },
   "note": {
    "description": "Note content",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id",
   "note"
  ],
  "type": "object"
 },
 "name": "woo_add_order_note"
}
