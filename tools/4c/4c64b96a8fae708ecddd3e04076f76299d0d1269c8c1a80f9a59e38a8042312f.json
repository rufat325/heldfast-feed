{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "plan:create"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Save a batch of post drafts"
 },
 "description": "Save 1-12 supplied photo-post drafts to the account. Pass each draft id, owned Library assetId, mediaUri, caption and proposed scheduledFor. Without confirm:true, return the supplied drafts as a preview; with confirm:true, submit the batch and return its save receipt and status. This does not create pictures, write captions, schedule or publish posts. Keep batchId, draftRevision and clientRequestId for soclo_posts_recover_drafts if the result is pending or uncertain. Free; needs plan:create.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "batchId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "description": "true only after the owner agreed to cancel that exact post. Omit or pass false to get a preview instead: nothing is cancelled and nothing else is fetched.",
    "type": "boolean"
   },
   "draftRevision": {
    "maximum": 999999999,
    "minimum": 0,
    "type": "integer"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assetId": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "caption": {
       "maxLength": 4000,
       "minLength": 1,
       "type": "string"
      },
      "id": {
       "format": "uuid",
       "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
       "type": "string"
      },
      "mediaUri": {
       "format": "uri",
       "maxLength": 4096,
       "type": "string"
      },
      "scheduledFor": {
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      }
     },
     "required": [
      "id",
      "assetId",
      "mediaUri",
      "caption",
      "scheduledFor"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "batchId",
   "draftRevision",
   "clientRequestId",
   "items"
  ],
  "type": "object"
 },
 "name": "soclo_posts_save_drafts",
 "title": "Save a batch of post drafts"
}
