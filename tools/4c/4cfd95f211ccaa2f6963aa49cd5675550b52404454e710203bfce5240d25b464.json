{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get article"
 },
 "description": "Get a published article by id. Defaults to the current version at full detail (body, claims, evidence).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "article_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "detail": {
    "default": "full",
    "enum": [
     "headline",
     "summary",
     "full"
    ],
    "type": "string"
   },
   "version": {
    "description": "A specific version; defaults to the current one.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "article_id"
  ],
  "type": "object"
 },
 "name": "get_article",
 "title": "Get article"
}
