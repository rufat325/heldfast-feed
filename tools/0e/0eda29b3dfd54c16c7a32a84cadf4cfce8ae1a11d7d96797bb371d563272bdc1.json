{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Send Reminder"
 },
 "description": "Send a reminder email for a document (optionally to a specific recipient).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document_id": {
    "minLength": 1,
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "recipient_email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "document_id"
  ],
  "type": "object"
 },
 "name": "document_send_reminder"
}
