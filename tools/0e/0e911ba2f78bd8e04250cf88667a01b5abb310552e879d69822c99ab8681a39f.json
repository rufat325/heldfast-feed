  "properties": {
   "domain": {
    "description": "Target domain or hostname to inspect over HTTPS (e.g. datasnag.com).",
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "inspect_ssl_cert",
 "outputSchema": {
