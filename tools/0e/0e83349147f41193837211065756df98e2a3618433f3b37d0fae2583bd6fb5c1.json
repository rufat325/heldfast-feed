{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find listings of Venues Abroad with the filters of the site, 20 per page, most checked facts first. list_categories names the filters and values of each category.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category, default: wedding-venues",
    "enum": [
     "wedding-venues",
     "wedding-planners"
    ],
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "capacity_max": {
      "description": "Capacity: at least this number",
      "minimum": 0,
      "type": "integer"
     },
     "ceremony_on_site": {
      "description": "Ceremony on site",
      "type": "boolean"
     },
     "chapel": {
      "description": "Chapel on site",
      "type": "boolean"
     },
     "destination_couples": {
      "description": "Works with couples from abroad",
      "type": "boolean"
     },
     "exclusive_use": {
      "description": "Exclusive use",
      "type": "boolean"
     },
     "in_house_catering": {
      "description": "In-house catering",
      "type": "boolean"
     },
     "outside_catering": {
      "description": "Outside caterers allowed",
      "type": "boolean"
     },
     "planner_languages": {
      "description": "Languages: any of these values",
      "items": {
       "enum": [
        "pt",
        "en",
        "es",
        "fr",
        "de",
        "nl",
        "it"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "rooms_on_site": {
      "description": "Rooms on site",
      "type": "boolean"
     },
     "venue_type": {
      "description": "Venue type: any of these values",
      "items": {
       "enum": [
        "quinta_estate",
        "hotel",
        "rural_lodging",
        "palace_manor",
        "winery",
        "convent_monastery",
        "beach_venue",
        "restaurant_hall",
        "other"
       ],
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free text: a name or a word",
    "type": "string"
   },
   "sort": {
    "enum": [
     "relevance",
     "name",
     "checked"
    ],
    "type": "string"
   },
   "where": {
    "description": "A place: town, region, or state (a part of the name is enough)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_listings",
 "title": "Search listings"
}
