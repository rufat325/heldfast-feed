{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create LoS measure"
 },
 "description": "Create a new LoS measure within a service area. Requires los_measures:write scope. Resolve service_area_id first via list_service_areas.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Measure category (required)",
    "enum": [
     "quality",
     "reliability",
     "responsiveness",
     "safety",
     "sustainability",
     "cost_efficiency",
     "capacity",
     "scope"
    ],
    "type": "string"
   },
   "community_statement": {
    "description": "Community-facing statement (for community type measures)",
    "maxLength": 2000,
    "type": "string"
   },
   "data_source": {
    "description": "Data source type (required). Use \"manual\" if values will be entered by hand.",
    "enum": [
     "manual",
     "custom_formula",
     "asset_condition_avg",
     "asset_condition_pct_above",
     "asset_condition_pct_below",
     "risk_score_avg",
     "risk_pct_critical",
     "wo_response_time_avg",
     "wo_completion_time_avg",
     "wo_backlog_count",
     "wo_overdue_count",
     "pm_compliance_rate",
     "compliance_score",
     "fci",
     "deferred_maintenance_ratio",
     "asset_past_useful_life_pct"
    ],
    "type": "string"
   },
   "data_source_config": {
    "additionalProperties": {},
    "description": "Data source configuration (JSONB). E.g., {\"threshold\": 3} for pct_above/below, {\"days_back\": 90} for WO metrics.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "description": {
    "description": "Description",
    "maxLength": 2000,
    "type": "string"
   },
   "is_active": {
    "description": "Whether the measure is active (default: true)",
    "type": "boolean"
   },
   "minimum_acceptable": {
    "description": "Minimum acceptable value",
    "type": "number"
   },
   "name": {
    "description": "Measure name (required, unique per service area)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "service_area_id": {
    "description": "Service area ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "sort_order": {
    "description": "Sort order for display",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "stretch_goal": {
    "description": "Stretch goal value",
    "type": "number"
   },
   "target_value": {
    "description": "Target value",
    "type": "number"
   },
   "trend_direction": {
    "description": "Which direction is better",
    "enum": [
     "higher_is_better",
     "lower_is_better",
     "target_is_optimal"
    ],
    "type": "string"
   },
   "type": {
    "description": "Measure type (required)",
    "enum": [
     "community",
     "technical"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Unit of measurement (e.g., \"%\", \"hours\", \"count\")",
    "maxLength": 100,
    "type": "string"
   },
   "weight": {
    "description": "Weight for composite score calculation (default: 1.0)",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "service_area_id",
   "name",
   "category",
   "type",
   "data_source"
  ],
  "type": "object"
 },
 "name": "create_los_measure",
 "title": "Create LoS measure"
}
