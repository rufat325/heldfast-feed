{
 "description": "Store a new key (password, public key, or private key) in the key storage",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "path": {
    "description": "Storage path for the key (e.g., 'keys/myapp/db-password')",
    "type": "string"
   },
   "type": {
    "description": "Type of key to store",
    "enum": [
     "password",
     "publicKey",
     "privateKey"
    ],
    "type": "string"
   },
   "value": {
    "description": "The key/password value to store",
    "type": "string"
   }
  },
  "required": [
   "path",
   "type",
   "value"
  ],
  "type": "object"
 },
 "name": "rundeck_create_key"
}
