{
 "description": "Create a task for a human oracle to complete in the real world. Requires x402 payment. Returns a task_id to poll with task_status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "instructions": {
    "description": "Detailed instructions for the human",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "intent": {
    "description": "What you want the human to do",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "proof_type": {
    "description": "Type of proof",
    "enum": [
     "photo",
     "form"
    ],
    "type": "string"
   },
   "service_tier": {
    "default": "integration_test",
    "enum": [
     "integration_test",
     "evaluation_test",
     "quick_check",
     "photo_visit",
     "urgent_visit",
     "complex_visit"
    ],
    "type": "string"
   },
   "target_location": {
    "description": "Optional target location and allowed capture radius",
    "properties": {
     "label": {
      "description": "Human-readable store or site name",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "radius_meters": {
      "default": 150,
      "maximum": 5000,
      "minimum": 25,
      "type": "integer"
     }
    },
    "required": [
     "label",
     "latitude",
     "longitude"
    ],
    "type": "object"
   },
   "timeout_seconds": {
    "default": 3600,
    "maximum": 86400,
    "minimum": 60,
    "type": "integer"
   }
  },
  "required": [
   "intent",
   "proof_type",
   "instructions"
  ],
  "type": "object"
 },
 "name": "human_do",
 "title": "Human Do"
}
