{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Return the scanned image of a page as an image content block, so a multimodal client can read the manuscript itself. Defaults to the thumbnail and a 5000000-byte cap; ask for size \"full\" to get the full-resolution scan.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Collection ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "id": {
    "description": "Document ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "maxBytes": {
    "description": "Reject an image larger than this many bytes (default 5000000)",
    "maximum": 20000000,
    "minimum": 1000,
    "type": "integer"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "size": {
    "description": "Which image to fetch (default \"thumb\")",
    "enum": [
     "thumb",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "collId",
   "id",
   "page"
  ],
  "type": "object"
 },
 "name": "transkribus_page_get_image",
 "title": "Get Page Image"
}
