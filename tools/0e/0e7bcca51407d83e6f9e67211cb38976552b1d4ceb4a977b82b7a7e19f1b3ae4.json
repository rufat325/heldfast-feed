{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check what applying still needs"
 },
 "description": "Returns readiness for one-off submission and Autopilot, plan entitlement and missing onboarding answers. Missing items include question, answerShape, choices, current value, available suggestion and webUrl. A null answerShape means the step requires the person's action in the web app. This read sends nothing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "get_application_readiness",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autopilotAvailable": {
    "type": "boolean"
   },
   "autopilotReady": {
    "type": "boolean"
   },
   "entitlement": {
    "additionalProperties": false,
    "properties": {
     "autoApply": {
      "type": "boolean"
     },
     "reason": {
      "anyOf": [
       {
        "enum": [
         "tier",
         "lapsed"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "autoApply",
     "reason"
    ],
    "type": "object"
   },
   "missing": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "answerShape": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "The save_application_answers key that carries the answer. Null: only the person can fix it, at `webUrl`."
      },
      "choices": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "for": {
           "type": "string"
          },
          "options": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "label": {
              "type": "string"
             },
             "value": {
              "type": "string"
             }
            },
            "required": [
             "value",
             "label"
            ],
            "type": "object"
           },
           "type": "array"
          }
         },
         "required": [
          "for",
          "options"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "current": {
       "description": "What is stored now, or null."
      },
      "field": {
       "type": "string"
      },
      "group": {
       "enum": [
        "setup",
        "contact",
        "resume",
        "eligibility",
        "workPreferences",
        "availability",
        "compensation"
       ],
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "mustBeStatedByPerson": {
       "type": "boolean"
      },
      "question": {
       "description": "Ask the person this, in your own words.",
       "type": "string"
      },
      "suggestion": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "needsConfirmation": {
           "const": true,
           "type": "boolean"
          },
          "source": {
           "enum": [
            "default",
            "profile"
           ],
           "type": "string"
          },
          "value": {}
         },
         "required": [
          "value",
          "source",
          "needsConfirmation"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Offer it as a question; save it only once they agree."
      },
      "webUrl": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "label",
      "group",
      "question",
      "answerShape",
      "choices",
      "current",
      "suggestion",
      "mustBeStatedByPerson",
      "webUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "onboarding": {
    "additionalProperties": false,
    "properties": {
     "completed": {
      "type": "boolean"
     },
     "completedVersion": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "gateMode": {
      "enum": [
       "off",
       "canary",
       "live"
