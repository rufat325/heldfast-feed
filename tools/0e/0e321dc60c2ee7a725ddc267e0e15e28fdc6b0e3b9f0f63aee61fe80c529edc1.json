{
 "description": "FREE, no wallet or document upload: choose the lowest priced Invoice Preflight tool from document type, PDF page count, and optional byte size. Call this before a paid invoice tool when the tier is uncertain. It does not inspect or validate the document.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "document_type": {
    "enum": [
     "ubl_xml",
     "pdf",
     "image"
    ],
    "type": "string"
   },
   "file_size_bytes": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_count": {
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "document_type"
  ],
  "type": "object"
 },
 "name": "invoice_preflight_quote",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "document_not_inspected": {
    "const": true,
    "type": "boolean"
   },
   "final_validation_on_paid_call": {
    "const": true,
    "type": "boolean"
   },
   "network": {
    "enum": [
     "eip155:8453",
     "eip155:84532"
    ],
    "type": "string"
   },
   "no_payment_taken": {
    "const": true,
    "type": "boolean"
   },
   "price_usdc": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": "string"
   },
   "recommended_tool": {
    "anyOf": [
     {
      "enum": [
       "invoice_preflight",
       "invoice_preflight_10_pages",
       "invoice_preflight_50_pages"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "ready",
     "needs_page_count",
     "unsupported",
     "temporarily_unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "recommended_tool",
   "price_usdc",
   "network",
   "reason",
   "no_payment_taken",
   "document_not_inspected",
   "final_validation_on_paid_call"
  ],
  "type": "object"
 }
}
