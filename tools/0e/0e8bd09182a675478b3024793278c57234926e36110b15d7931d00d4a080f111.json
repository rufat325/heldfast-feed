{"description":"Search live Allegro.pl marketplace offers by phrase, with optional price range, condition and sort. Returns titles, prices, sellers and offer URLs. Data is scraped live via a stealth browser, so a call may take ~30\u2013120s. Result shape: { source, fetchedAt, query, count, offers: [...], note } \u2014 the list key is `offers`, never `items` or `results`. Each offer: { title, price, currency, url, seller, condition, imageUrl }; `price` is the formatted string Allegro renders (e.g. \"3 499,00\"), not a number.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"condition":{"description":"Item condition filter","enum":["new","used"],"type":"string"},"limit":{"description":"Max offers to return (default 24)","maximum":60,"minimum":1,"type":"integer"},"phrase":{"description":"Search text, e.g. 'iphone 15 128gb'","minLength":1,"type":"string"},"priceFrom":{"description":"Minimum price in PLN","minimum":0,"type":"number"},"priceTo":{"description":"Maximum price in PLN","minimum":0,"type":"number"},"sort":{"description":"Result ordering (default: relevance)","enum":["relevance","price-asc","price-desc","newest","popularity"],"type":"string"}},"required":["phrase"],"type":"object"},"name":"allegro_search","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":{},"properties":{"count":{"type":"number"},"fetchedAt":{"type":"string"},"note":{"type":"string"},"offers":{"items":{"additionalProperties":{},"properties":{"condition":{"anyOf":[{"type":"string"},{"type":"null"}]},"currency":{"type":"string"},"imageUrl":{"anyOf":[{"type":"string"},{"type":"null"}]},"price":{"type":"string"},"seller":{"anyOf":[{"type":"string"},{"type":"null"}]},"title":{"type":"string"},"url":{"type":"string"}},"required":["title","price","currency","url"],"type":"object"},"type":"array"},"query":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"source":{"type":"string"}},"required":["source","fetchedAt","query","count","offers","note"],"type":"object"},"title":"Search Allegro offers"}
