 "description": "Creates a private NiceVois job and returns a one-time PUT upload URL. Do not ask for consent before the first attempt because NiceVois remembers the current standing account agreement. If the server returns CONSENT_REQUIRED, ask for one acceptance of the linked standing agreement and retry once with acceptsStandingAgreement=true. This allocates a private training slot but does not start GPU work until the audio is uploaded and start_training is called.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "acceptsStandingAgreement": {
    "const": true,
    "description": "Set only when the user explicitly accepts the linked standing voice-training agreement after CONSENT_REQUIRED. Omit for accounts that have already accepted.",
    "type": "boolean"
   },
   "contentType": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "durationSeconds": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "epochs": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "fileName": {
    "description": "Original WAV, MP3, FLAC, M4A, or OGG filename.",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "modelName": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "sizeBytes": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "submissionId": {
    "maxLength": 80,
    "minLength": 8,
    "type": "string"
   }
  },
  "required": [
   "fileName",
   "contentType",
   "sizeBytes",
   "durationSeconds",
   "epochs",
   "modelName",
   "submissionId"
  ],
  "type": "object"
 },
