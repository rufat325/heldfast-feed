{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Is this e-mail really from who it says? (SPF, DKIM, DMARC, lookalike sender)"
 },
 "description": "Checks whether an e-mail is from who it claims. Input: the raw headers of a message (as shown by Show original or View source). Returns checks and a read (headline, recommendation engage | verify_first | do_not_engage, failed checks, lookup links): DMARC/SPF/DKIM as the receiving server recorded them, DKIM alignment with From, Reply-To going to another domain, and a From domain or display name that imitates a known business. The headers are processed in memory and never stored. Deterministic, no AI. Counts as 1 check with a key; free tier without one.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "headers": {
    "description": "The raw message headers, as one string (the body is not needed)",
    "maxLength": 65536,
    "type": "string"
   }
  },
  "required": [
   "headers"
  ],
  "type": "object"
 },
 "name": "check_email",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "authentication": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "dmarc": {
        "type": [
         "string",
         "null"
        ]
       },
       "spf": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "checked_at": {
    "type": "string"
   },
   "checks": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "evidence": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      },
      "status": {
       "description": "pass | fail | unknown | not_applicable",
       "type": "string"
      }
     },
     "required": [
      "id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "checks_used": {
    "type": "number"
   },
   "from_domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "note": {
    "description": "Terms of use for the facts",
    "type": "string"
   },
   "read": {
    "additionalProperties": {},
    "description": "What a person sees: headline, recommendation, failed checks and lookup links",
    "properties": {
     "failed": {
      "description": "Failed checks, worst first, at most 3",
      "items": {
       "additionalProperties": {},
       "properties": {
        "evidence": {
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "lookup": {
         "additionalProperties": {},
         "properties": {
          "label": {
           "type": "string"
          },
          "url": {
           "type": "string"
          }
         },
         "type": "object"
        }
       },
       "required": [
        "label",
        "evidence"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "headline": {
      "description": "One line, e.g. \"Passed all 7 checks Jid could run. Recommendation: engage.\"",
      "type": "string"
     },
     "not_checked": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "passed": {
      "type": "number"
     },
     "reason": {
      "type": "string"
     },
     "recommendation": {
      "description": "engage | verify_first | do_not_engage",
      "type": "string"
     },
     "total": {
      "type": "number"
     }
    },
    "required": [
     "headline",
     "recommendation",
     "passed",
     "total",
     "failed"
    ],
    "type": "object"
   },
   "reply_to_domain": {
    "type": [
     "string",
     "null"
    ]
   },
   "rules_version": {
    "type": "string"
   }
  },
  "required": [
   "read",
   "checks",
   "from_domain",
   "checks_used",
   "note"
  ],
  "type": "object"
 },
 "title": "Is this e-mail really from who it says? (SPF, DKIM, DMARC, lookalike sender)"
}
