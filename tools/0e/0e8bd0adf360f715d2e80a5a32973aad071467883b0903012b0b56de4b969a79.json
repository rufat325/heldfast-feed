{
 "description": "List form submissions, optionally filtered by form and status; paginated. Returns submission rows with their data and status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "formIdOrSlug": {
    "description": "Optional form id or slug to filter submissions by",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "skip": {
    "default": 0,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "Optional status filter",
    "enum": [
     "pending",
     "processed",
     "spam",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_form_submissions"
}
