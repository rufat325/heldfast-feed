{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Real airlines that operated in a given year (1950-2030) as the game knows them: name, IATA code when reliably known, home country and region, type, years of operation, and the countries each one served that year. Network data has decade precision: a country listed for the 1960s may have been added mid-decade. servedCountries lists destinations from home; when networkKnown is false only the home country is known. Sorted by the airline size in the dataset.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "country": {
    "description": "Home country of the airline, ISO 3166-1 alpha-2 (GB, US, FR)",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "kind": {
    "description": "flag carrier, major, regional, low-cost or charter",
    "enum": [
     "flag",
     "major",
     "regional",
     "lowcost",
     "charter"
    ],
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "At most this many airlines",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "region": {
    "description": "Game region of the airline base",
    "enum": [
     "wnam",
     "enam",
     "weur",
     "eeur",
     "apac-ne",
     "apac-se",
     "oc"
    ],
    "type": "string"
   },
   "year": {
    "description": "Calendar year, 1950-2030",
    "maximum": 2030,
    "minimum": 1950,
    "type": "integer"
   }
  },
  "required": [
   "year"
  ],
  "type": "object"
 },
 "name": "historical_airlines",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "airlines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": [
        "string",
        "null"
       ]
      },
      "confidence": {
       "anyOf": [
        {
         "enum": [
          "high",
          "medium",
          "low"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "country": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "flag",
        "major",
        "regional",
        "lowcost",
        "charter"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "networkKnown": {
       "type": "boolean"
      },
      "region": {
       "enum": [
        "wnam",
        "enam",
        "weur",
        "eeur",
        "apac-ne",
        "apac-se",
        "oc"
       ],
       "type": "string"
      },
      "servedCountries": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "since": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "until": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name",
      "code",
      "country",
      "region",
      "kind",
      "since",
      "until",
      "servedCountries",
      "confidence",
      "networkKnown"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "year": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "year",
   "total",
   "airlines"
  ],
  "type": "object"
 },
 "title": "Historical airlines of a year"
}
