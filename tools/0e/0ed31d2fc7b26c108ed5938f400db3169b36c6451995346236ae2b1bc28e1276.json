{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Locally inspect untrusted text for known prompt-injection and agent-hijack signals before using it as agent context. Returns evidence and an allow, review, or recommend-block decision; it does not enforce the decision.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Untrusted text to inspect before it enters agent context.",
    "maxLength": 1000000,
    "minLength": 1,
    "type": "string"
   },
   "includeEvidence": {
    "default": false,
    "description": "Return raw matched evidence. Defaults to redacted evidence.",
    "type": "boolean"
   },
   "source": {
    "description": "Human-readable provenance such as page URL, email, tool result, or document name.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "tripwire_scan",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "decision": {
    "enum": [
     "allow",
     "review",
     "recommend_block"
    ],
    "type": "string"
   },
   "engine": {
    "additionalProperties": false,
    "properties": {
     "ruleCount": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "rulesetVersion": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "version",
     "rulesetVersion",
     "ruleCount"
    ],
    "type": "object"
   },
   "findingCount": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "evidence": {
       "type": "string"
      },
      "index": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "label": {
       "type": "string"
      },
      "length": {
       "exclusiveMinimum": 0,
       "maximum": 9007199254740991,
       "type": "integer"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "medium"
       ],
       "type": "string"
      }
     },
     "required": [
      "rule",
      "label",
      "category",
      "severity",
      "evidence",
      "index",
      "length"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "limitation": {
    "type": "string"
   },
   "product": {
    "const": "Tripwire Guard",
    "type": "string"
   },
   "reportVersion": {
    "const": 1,
    "type": "number"
   },
   "source": {
    "type": "string"
   }
  },
  "required": [
   "product",
   "reportVersion",
   "source",
   "decision",
   "findingCount",
   "engine",
   "findings",
   "limitation"
  ],
  "type": "object"
 },
 "title": "Inspect untrusted content"
}
