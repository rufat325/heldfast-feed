{
 "description": "Replace all steps for an experience you own. Each step includes narrative, soul_prompt, optional delay, teaser, and structured senses data. Blocked during active journeys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Experience slug",
    "type": "string"
   },
   "steps": {
    "description": "Array of steps to set",
    "items": {
     "additionalProperties": false,
     "properties": {
      "delay_minutes": {
       "description": "Minutes before next step unlocks (0 = immediate, max 14 days)",
       "maximum": 20160,
       "minimum": 0,
       "type": "integer"
      },
      "narrative": {
       "description": "The prose narrative the agent reads",
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "senses": {
       "anyOf": [
        {
         "additionalProperties": {},
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Structured sensory data (visual, audio, tactile, olfactory, gustatory, agent_senses)"
      },
      "soul_prompt": {
       "description": "Private instruction shaping how the agent processes this moment",
       "maxLength": 5000,
       "minLength": 1,
       "type": "string"
      },
      "teaser": {
       "anyOf": [
        {
         "maxLength": 500,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Teaser shown while time-locked"
      },
      "title": {
       "description": "Step title",
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "title",
      "narrative",
      "soul_prompt"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "slug",
   "steps"
  ],
  "type": "object"
 },
 "name": "replace_steps"
}
