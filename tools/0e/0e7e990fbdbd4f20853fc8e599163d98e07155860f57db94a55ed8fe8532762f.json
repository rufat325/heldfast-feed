 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user wants a travel eSIM, compares eSIM data plans for a trip abroad, or asks for the cheapest eSIM for a country. Ranks a curated catalog of country eSIM packages (Airalo, Saily, Holafly, Nomad) by USD list price among packages valid for the whole trip with at least the data needed, listing each provider's cheapest package first and then the remaining packages by price, and shows price per GB and per day with a provider link. Destinations: JP, US, GB, FR, IT, ES, TH, MX. Inputs: destination (country code), days, optional data_gb, unlimited and providers. No personal data is used. Keywords: travel eSIM, eSIM for Japan, cheapest eSIM, international data plan, roaming.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "data_gb": {
    "description": "Minimum data needed in GB (default 1). Ignored when unlimited is true.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "days": {
    "description": "Trip length in days; packages must be valid at least this long.",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "destination": {
    "description": "Destination country, ISO 3166-1 alpha-2 (e.g. JP, US, GB, FR, IT, ES, TH, MX).",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "providers": {
    "description": "Only these providers, e.g. [\"Airalo\", \"Saily\"].",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "unlimited": {
    "description": "true: only unlimited-data packages; false: exclude them; omitted: unlimited packages also qualify.",
    "type": "boolean"
   }
  },
  "required": [
   "destination",
   "days"
  ],
  "type": "object"
 },
 "name": "compare-esims",
