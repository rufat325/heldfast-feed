   "resourceUri": "ui://rds/widget.html"
  },
  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Score a pricing page's choice architecture across six weighted criteria (tiers, highlighting, anchoring, comparison, CTA, billing toggle) into a 0-100 score. See the full version at https://rahuldsarker.co/calculators/pricing-page-architecture-grader",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "anchoringPresent": {
    "description": "Anchoring, a high tier frames the others (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "billingToggleWithSavings": {
    "description": "Monthly/annual toggle with savings shown (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "clearFeatureComparison": {
    "description": "Clear feature comparison across tiers (weight 20)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "oneCtaPerTier": {
    "description": "One clear CTA per tier (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "recommendedPlanHighlighted": {
    "description": "A recommended / most-popular plan is highlighted (weight 20)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "threeToFourTiers": {
    "description": "3-4 tiers, not too few, not overwhelming (weight 15)",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   }
  },
  "required": [
   "threeToFourTiers",
   "recommendedPlanHighlighted",
   "anchoringPresent",
   "clearFeatureComparison",
   "oneCtaPerTier",
   "billingToggleWithSavings"
  ],
  "type": "object"
 },
 "name": "pricing_page_architecture_grader",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
         "enum": [
          "currency",
          "x",
          "%",
          "months"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "label",
      "value",
      "unit",
      "display"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "tool": {
