{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get one meter by its exact slug from list_meters (not its UUID). Use this when the slug is known; this is not a text search. Returns the stored API data without recalculating values, or a tool error if the meter does not exist.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Exact meter slug from list_meters or search_meters, for example electricity-ai-today.",
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_meter",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "meter": {
    "additionalProperties": true,
    "properties": {
     "calculationMode": {
      "enum": [
       "snapshot",
       "live_today",
       "live_ytd",
       "rolling_window",
       "manual_estimate"
      ],
      "type": "string"
     },
     "confidenceLevel": {
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     },
     "group": {
      "type": "string"
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "lastUpdate": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     },
     "ratePerSecond": {
      "type": "number"
     },
     "slug": {
      "type": "string"
     },
     "sourceNote": {
      "anyOf": [
       {
        "description": "Source note supplied by the backend.",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "titleKey": {
      "type": "string"
     },
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "id",
     "slug",
     "label",
     "unit",
     "value",
     "titleKey",
     "ratePerSecond",
     "lastUpdate",
     "group",
     "calculationMode",
     "confidenceLevel",
     "sourceNote"
    ],
    "type": "object"
   }
  },
  "required": [
   "meter"
  ],
  "type": "object"
 }
}
