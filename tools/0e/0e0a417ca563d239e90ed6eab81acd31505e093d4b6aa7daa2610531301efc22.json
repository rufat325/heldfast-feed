{
 "description": "List past Forge optimization sessions with their results. Useful for checking what has already been optimized.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 10,
    "description": "Number of sessions to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "default": "all",
    "description": "Filter by session status",
    "enum": [
     "all",
     "completed",
     "failed",
     "running"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "forge_sessions",
 "title": "List Optimization Sessions"
}
