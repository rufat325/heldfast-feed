 "annotations": {
  "readOnlyHint": true
 },
 "description": "Liquidation history for one coin's perpetuals: market-wide long/short liquidations (USD) in 4h buckets and the 24h split by venue, plus a minute-level timing sample of individual liquidation orders from venues that publish them (OKX, Gate) with detected cascades (time, side, size, order count, price range) and the largest orders. The sample is a share of the market, stated per bucket, never scaled up. Use it to say WHEN and WHICH SIDE was forced out, instead of inferring liquidations from price and open interest: flat OI can hide heavy liquidations that new positions replaced. A 1y baseline ranks the trailing ~24h of longs and shorts against a year of daily totals (percentile, 'largest since' date, median day, the year's three largest days per side), so a figure can be called big or routine for this coin.",
 "inputSchema": {
  "properties": {
   "hours": {
    "description": "Trailing window in hours, 1\u201372. Default 24.",
    "type": "integer"
   },
   "interval": {
    "description": "Bucket size for the timing sample. Default 15m.",
    "enum": [
     "5m",
     "15m",
     "1h"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Coin symbol, e.g. \"BTC\".",
    "type": "string"
   },
   "top_orders": {
    "description": "Largest individual liquidations to list, 0\u201320. Default 5.",
    "type": "integer"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "derivatives_liquidations",
 "outputSchema": {
  "properties": {
   "baseline1y": {
    "description": "The trailing ~24h (newest six 4h buckets) ranked against a year of CoinGlass daily totals over the same venues",
    "properties": {
     "available": {
      "type": "boolean"
     },
     "days": {
      "description": "Settled days ranked against",
      "type": [
       "integer",
       "null"
      ]
     },
     "largestLongDays": {
      "items": {
       "properties": {
        "timeMs": {
         "type": "integer"
        },
        "usd": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "largestShortDays": {
      "items": {
       "properties": {
        "timeMs": {
         "type": "integer"
        },
        "usd": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "longs": {
      "properties": {
       "largestSinceMs": {
        "description": "Newest day at or above this total, set only from the 75th percentile up; null there means above every day of the year",
        "type": [
         "integer",
         "null"
        ]
       },
       "medianDayUsd": {
        "type": "number"
       },
       "percentile": {
        "description": "Rank among the year's settled daily totals, 0-100",
        "type": "number"
       },
       "usd": {
        "description": "Trailing-window total",
        "type": "number"
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "note": {
      "description": "Why the baseline is missing",
      "type": [
       "string",
       "null"
      ]
     },
     "shorts": {
      "properties": {
       "largestSinceMs": {
        "description": "Newest day at or above this total, set only from the 75th percentile up; null there means above every day of the year",
        "type": [
         "integer",
         "null"
        ]
       },
       "medianDayUsd": {
        "type": "number"
       },
       "percentile": {
        "description": "Rank among the year's settled daily totals, 0-100",
        "type": "number"
       },
       "usd": {
        "description": "Trailing-window total",
        "type": "number"
       }
      },
      "type": [
       "object",
       "null"
      ]
     },
     "trailingFromMs": {
