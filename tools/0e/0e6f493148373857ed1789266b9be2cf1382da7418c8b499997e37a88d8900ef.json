{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Confirm a date"
 },
 "description": "Locks in the winning date for a live event, ending voting. On an autopilot poll this also mails every guest the confirmation and needs the send permission; a classic poll only needs the write permission and mails nobody.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dateOptionId": {
    "minLength": 1,
    "type": "string"
   },
   "event_id": {
    "type": "string"
   },
   "message": {
    "maxLength": 300,
    "type": "string"
   },
   "time": {
    "pattern": "^\\d{2}:\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "event_id",
   "dateOptionId"
  ],
  "type": "object"
 },
 "name": "confirm",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirmed_date_option_id": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "events:write",
    "events:send"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Confirm a date"
}
