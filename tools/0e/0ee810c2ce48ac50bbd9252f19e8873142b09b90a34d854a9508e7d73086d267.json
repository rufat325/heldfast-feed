{
 "description": "Contribute de-identified non-clinical patterns/outcomes to noosphere seed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "deidentified": {
    "default": true,
    "type": "boolean"
   },
   "domain": {
    "default": "general",
    "type": "string"
   },
   "evidence": {
    "default": "",
    "type": "string"
   },
   "namespace": {
    "default": "global",
    "type": "string"
   },
   "opt_in": {
    "default": true,
    "type": "boolean"
   },
   "outcome_signal": {
    "default": 0,
    "maximum": 1,
    "minimum": -1,
    "type": "number"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "noosphere_contribute"
}
