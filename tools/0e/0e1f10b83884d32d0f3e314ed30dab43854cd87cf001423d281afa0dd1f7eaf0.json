{
 "description": "Schedule clips or media to post on supported social platforms. Ask the user for platform, post_type, caption, and scheduled_at if missing. Instagram carousels need 2-10 items. YouTube, TikTok, and Instagram single posts require media.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "posts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "asset_id": {
       "maxLength": 64,
       "type": "string"
      },
      "caption": {
       "maxLength": 2200,
       "type": "string"
      },
      "carousel_items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "asset_id": {
          "maxLength": 64,
          "type": "string"
         },
         "media_url": {
          "maxLength": 2048,
          "type": "string"
         }
        },
        "type": "object"
       },
       "maxItems": 10,
       "minItems": 2,
       "type": "array"
      },
      "media_url": {
       "maxLength": 2048,
       "type": "string"
      },
      "platform": {
       "enum": [
        "x",
        "instagram",
        "tiktok",
        "youtube",
        "facebook",
        "linkedin",
        "threads",
        "bluesky"
       ],
       "type": "string"
      },
      "platform_settings": {
       "additionalProperties": {},
       "type": "object"
      },
      "post_type": {
       "enum": [
        "single",
        "carousel",
        "text"
       ],
       "type": "string"
      },
      "scheduled_at": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "platform",
      "post_type",
      "caption",
      "scheduled_at"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "posts"
  ],
  "type": "object"
 },
 "name": "schedule_post"
}
