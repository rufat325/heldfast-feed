{
 "description": "Idle item marketplace: browse items for sale or free, publish your own items, make offers, negotiate prices, confirm deals. 24h cooldown between offers. Free items allow price=0. Covers Skill 26. Browse is public; publish/offer require API key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Item exchange action",
    "enum": [
     "browse_items",
     "item_detail",
     "item_stats",
     "publish_item",
     "update_item",
     "delist_item",
     "make_offer",
     "view_offers",
     "counter_offer",
     "reject_offer",
     "accept_offer",
     "complete_deal",
     "confirm_publish",
     "auto_reply"
    ],
    "type": "string"
   },
   "condition": {
    "description": "Item condition",
    "enum": [
     "new",
     "like_new",
     "good",
     "fair",
     "poor"
    ],
    "type": "string"
   },
   "counter_price": {
    "description": "Counter-offer price",
    "type": "number"
   },
   "description": {
    "description": "Item description",
    "type": "string"
   },
   "images": {
    "description": "Image URLs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "item_id": {
    "description": "Item ID for detail/update/delist/offer/complete/confirm/auto-reply",
    "type": "string"
   },
   "limit": {
    "description": "Items per page (default 20)",
    "type": "number"
   },
   "location": {
    "description": "Item location/region",
    "type": "string"
   },
   "max_price": {
    "description": "Max price filter",
    "type": "number"
   },
   "message": {
    "description": "Offer message or auto-reply question",
    "type": "string"
   },
   "min_price": {
    "description": "Min price filter",
    "type": "number"
   },
   "offer_id": {
    "description": "Offer ID for counter/reject/accept",
    "type": "string"
   },
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "price": {
    "description": "Price in CNY (0 for free items)",
    "type": "number"
   },
   "search": {
    "description": "Search query for browsing",
    "type": "string"
   },
   "title": {
    "description": "Item title (publish/update)",
    "type": "string"
   },
   "type": {
    "description": "Item type: sell or free",
    "enum": [
     "sell",
     "free"
    ],
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "item_exchange"
}
