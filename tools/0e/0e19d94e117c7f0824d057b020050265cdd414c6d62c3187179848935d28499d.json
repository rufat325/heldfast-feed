 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "default": 7,
    "description": "Lookback window in days",
    "maximum": 365,
    "minimum": 1,
    "type": "number"
   },
   "event": {
    "description": "Filter by event name (e.g. page_view)",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "property": {
    "default": "path",
    "description": "Property key to group by (e.g. path, referrer, utm_source)",
    "type": "string"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "analytics_breakdown",
