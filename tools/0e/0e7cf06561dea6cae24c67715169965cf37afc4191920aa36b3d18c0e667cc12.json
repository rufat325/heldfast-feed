  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get flea market details"
 },
 "description": "Get the full public details of one German flea market by its UUID, as returned in the id field of search_events or recently_updated_events: description text, street address, date and opening times, market type and topics, entrance fee and seller stand fee, stand sizes and table rental, whether sellers can still sign up, and the public my-flohmarkt.de event URL. Use it when a search hit is not enough to answer about price, address or what is sold. Unknown or non-public UUIDs return not_found.",
 "execution": {
  "taskSupport": "forbidden"
 },
