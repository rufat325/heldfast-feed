{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Calculate structured synastry relationships between two birth charts. The relationship-level node_type applies one True/Mean convention to both charts; do not mix conventions implicitly. Returns factual inter-chart data without compatibility scores or relationship conclusions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "node_type": {
    "enum": [
     "true",
     "mean"
    ],
    "type": "string"
   },
   "person_a": {
    "additionalProperties": false,
    "description": "First person's birth data.",
    "properties": {
     "additional_points": {
      "items": {
       "enum": [
        "mean_lilith",
        "true_lilith",
        "osculating_lilith",
        "part_of_fortune",
        "vertex"
       ],
       "type": "string"
      },
      "maxItems": 32,
      "type": "array"
     },
     "altitude_m": {
      "type": "number"
     },
     "aspect_preset": {
      "enum": [
       "standard",
       "extended",
       "custom",
       "modern-major-v1"
      ],
      "type": "string"
     },
     "ayanamsa": {
      "enum": [
       "lahiri",
       "true_citra",
       "fagan_bradley",
       "krishnamurti",
       "raman"
      ],
      "type": "string"
     },
     "custom_aspect_rules": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "exact_angle": {
         "maximum": 180,
         "minimum": 0,
         "type": "number"
        },
        "orb": {
         "maximum": 15,
         "minimum": 0,
         "type": "number"
        },
        "type": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "type",
        "exact_angle",
        "orb"
       ],
       "type": "object"
      },
      "maxItems": 64,
      "type": "array"
     },
     "date": {
      "description": "Local civil birth date in YYYY-MM-DD format.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "fold": {
      "enum": [
       0,
       1
      ],
      "type": "number"
     },
     "house_system": {
      "enum": [
       "placidus",
       "koch",
       "porphyry",
       "campanus",
       "regiomontanus",
       "alcabitius",
       "topocentric",
       "morinus",
       "meridian",
       "whole_sign",
       "equal"
      ],
      "type": "string"
     },
     "latitude": {
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "longitude": {
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     },
     "node_type": {
      "enum": [
       "true",
       "mean"
      ],
      "type": "string"
     },
     "place": {
      "description": "Optional caller-side place label; it is not geocoded.",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "time": {
      "description": "Local clock time in HH:mm or HH:mm:ss format.",
      "pattern": "^(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d)?$",
      "type": "string"
     },
     "timezone": {
      "description": "IANA timezone identifier, such as America/New_York.",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "unknown_time": {
      "description": "Set true when no reliable birth time is available.",
      "type": "boolean"
     },
     "zodiac": {
      "enum": [
       "tropical",
       "sidereal"
      ],
      "type": "string"
     }
    },
    "required": [
     "date",
     "latitude",
     "longitude",
     "timezone"
    ],
    "type": "object"
   },
   "person_b": {
    "additionalProperties": false,
    "description": "Second person's birth data.",
    "properties": {
     "additional_points": {
      "$ref": "#/properties/person_a/properties/additional_points"
     },
     "altitude_m": {
      "$ref": "#/properties/person_a/properties/altitude_m"
     },
     "aspect_preset": {
      "$ref": "#/properties/person_a/properties/aspect_preset"
     },
     "ayanamsa": {
      "$ref": "#/properties/person_a/properties/ayanamsa"
     },
     "custom_aspect_rules": {
      "$ref": "#/properties/person_a/properties/custom_aspect_rules"
     },
     "date": {
      "$ref": "#/properties/person_a/properties/date"
     },
     "fold": {
      "$ref": "#/properties/person_a/properties/fold"
     },
     "house_system": {
      "$ref": "#/properties/person_a/properties/house_system"
     },
     "latitude": {
      "$ref": "#/properties/person_a/properties/latitude"
     },
     "longitude": {
      "$ref": "#/properties/person_a/properties/longitude"
     },
     "node_type": {
      "$ref": "#/properties/person_a/properties/node_type"
     },
     "place": {
      "$ref": "#/properties/person_a/properties/place"
     },
     "time": {
      "$ref": "#/properties/person_a/properties/time"
     },
     "timezone": {
      "$ref": "#/properties/person_a/properties/timezone"
     },
     "unknown_time": {
      "$ref": "#/properties/person_a/properties/unknown_time"
     },
     "zodiac": {
      "$ref": "#/properties/person_a/properties/zodiac"
     }
    },
    "required": [
     "date",
     "latitude",
     "longitude",
     "timezone"
    ],
    "type": "object"
   },
   "relationship_type": {
    "enum": [
     "general",
     "romantic",
     "friendship",
     "family",
     "work"
    ],
    "type": "string"
   },
   "target_instant": {
    "format": "date-time",
    "type": "string"
   },
   "topic": {
    "enum": [
     "overall",
     "emotional",
     "communication",
     "attraction",
     "stability",
     "growth",
     "conflict",
     "patterns",
     "direction"
    ],
    "type": "string"
   }
  },
  "required": [
   "person_a",
   "person_b"
  ],
  "type": "object"
 },
 "name": "calculate_synastry",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {},
  "type": "object"
 }
}
