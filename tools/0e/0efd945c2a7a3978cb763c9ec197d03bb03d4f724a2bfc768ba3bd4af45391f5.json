      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "kind": {
      "enum": [
       "provide_input",
       "read_status",
       "reconnect",
       "handoff"
      ],
      "type": "string"
     },
     "reason": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
