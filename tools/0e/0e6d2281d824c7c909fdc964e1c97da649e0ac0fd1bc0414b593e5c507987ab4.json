{
 "_meta": {
  "openai/toolInvocation/invoked": "Timeline organised.",
  "openai/toolInvocation/invoking": "Organising the timeline\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Build health timeline"
 },
 "description": "Sorts non-identifying, user-authored observations into a factual chronology while preserving supplied dates and uncertainty. Requires explicit consent for transient processing. PHI and diagnosis are outside its scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "consentConfirmed": {
    "const": true,
    "description": "Set to true only after the user explicitly agrees to transient processing of their non-identifying, user-authored health notes. Do not submit PHI, medical-record identifiers, contact details, credentials, or provider documents.",
    "type": "boolean"
   },
   "observations": {
    "items": {
     "properties": {
      "category": {
       "maxLength": 120,
       "type": "string"
      },
      "date": {
       "maxLength": 80,
       "type": "string"
      },
      "impact": {
       "maxLength": 1000,
       "type": "string"
      },
      "observation": {
       "maxLength": 2000,
       "type": "string"
      },
      "uncertainty": {
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "observation"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "consentConfirmed",
   "observations"
  ],
  "type": "object"
 },
 "name": "build_health_timeline",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "changePoints": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "maxLength": 120,
       "type": "string"
      },
      "date": {
       "maxLength": 80,
       "type": "string"
      },
      "impact": {
       "maxLength": 1000,
       "type": "string"
      },
      "observation": {
       "maxLength": 2000,
       "type": "string"
      },
      "uncertainty": {
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "date",
      "observation",
      "category",
      "impact",
      "uncertainty"
     ],
     "type": "object"
    },
    "maxItems": 6,
    "type": "array"
   },
   "disclaimer": {
    "maxLength": 2000,
    "type": "string"
   },
   "timeline": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "maxLength": 120,
       "type": "string"
      },
      "date": {
       "maxLength": 80,
       "type": "string"
      },
      "impact": {
       "maxLength": 1000,
       "type": "string"
      },
      "observation": {
       "maxLength": 2000,
       "type": "string"
      },
      "uncertainty": {
       "maxLength": 500,
       "type": "string"
      }
     },
     "required": [
      "date",
      "observation",
      "category",
      "impact",
      "uncertainty"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "timeline",
   "changePoints",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Build health timeline"
}
