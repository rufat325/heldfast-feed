{
 "description": "Create an RFQ in AuraVMS. SAFETY: by default this saves a DRAFT and emails nobody. Pass send:true ONLY after the user has explicitly confirmed \u2014 sending emails a zero-signup quote link to every invited supplier. Supplier IDs come from list_suppliers / add_supplier.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "expected_delivery_date": {
       "description": "YYYY-MM-DD",
       "type": "string"
      },
      "product_name": {
       "minLength": 1,
       "type": "string"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "specifications": {
       "description": "Pinned spec: grade/standard, dimensions+tolerances, certifications, substitutions policy",
       "type": "string"
      },
      "uom": {
       "description": "Unit of measure, e.g. kg, pcs, meters",
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "product_name",
      "quantity",
      "uom"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "payment_terms": {
    "description": "e.g. 'Net 30 from invoice'",
    "type": "string"
   },
   "send": {
    "default": false,
    "description": "false (default) = save draft only. true = send to suppliers NOW (requires explicit user confirmation).",
    "type": "boolean"
   },
   "shipping_terms": {
    "description": "e.g. 'FOB destination'",
    "type": "string"
   },
   "suppliers": {
    "description": "Supplier UUIDs to invite",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "terms_and_condition": {
    "type": "string"
   },
   "title": {
    "description": "RFQ title, e.g. 'Q3 Raw Materials'",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "items",
   "suppliers"
  ],
  "type": "object"
 },
 "name": "create_rfq",
 "title": "Create RFQ (draft by default)"
}
