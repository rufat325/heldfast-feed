{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Generate LocalBusiness schema"
 },
 "description": "Turn a local business's facts into schema.org JSON-LD. Chooses the most specific LocalBusiness subtype from business_type (for example \"roofing company\" becomes RoofingContractor) or takes schema_type as given, writes only properties schema.org defines for that type, formats hours, phone and 24 hour or closed days the way Google documents, then validates the output against the schema.org vocabulary. Returns the JSON-LD, a ready-to-paste script tag, the type chosen with alternatives, and cited notes on anything left out. No network access; nothing is published.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "accepts_reservations": {
    "description": "Food businesses only.",
    "type": "boolean"
   },
   "address_country": {
    "description": "Two-letter ISO country code, such as \"US\".",
    "maxLength": 60,
    "type": "string"
   },
   "address_locality": {
    "description": "City or town.",
    "maxLength": 100,
    "type": "string"
   },
   "address_region": {
    "description": "State, province or region, such as \"MT\".",
    "maxLength": 100,
    "type": "string"
   },
   "area_served": {
    "description": "Places served: plain names, or objects with a type (City, State, AdministrativeArea, Country, Place) and an optional Wikidata or Wikipedia URL in same_as.",
    "items": {
     "anyOf": [
      {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      {
       "properties": {
        "name": {
         "maxLength": 120,
         "minLength": 1,
         "type": "string"
        },
        "same_as": {
         "maxLength": 2048,
         "type": "string"
        },
        "type": {
         "enum": [
          "City",
          "State",
          "AdministrativeArea",
          "Country",
          "Place"
         ],
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 50,
    "type": "array"
   },
   "business_type": {
    "description": "Plain words for what the business is, such as \"plumber\", \"dental office\" or \"coffee shop\".",
    "maxLength": 120,
    "type": "string"
   },
   "currencies_accepted": {
    "description": "ISO 4217 codes such as USD.",
    "items": {
     "maxLength": 3,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "description": {
    "maxLength": 1000,
    "type": "string"
   },
   "email": {
    "maxLength": 200,
    "type": "string"
   },
   "founders": {
    "items": {
     "maxLength": 120,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "founding_date": {
    "description": "YYYY-MM-DD.",
    "maxLength": 10,
    "type": "string"
   },
   "hide_street_address": {
    "description": "True for a service-area business that does not serve customers at its address.",
    "type": "boolean"
   },
   "hours": {
    "description": "Regular opening hours. Days not listed read as closed.",
    "items": {
     "properties": {
      "closes": {
       "description": "Such as \"17:30\" or \"5:30 PM\". \"24:00\" means midnight.",
       "maxLength": 20,
       "type": "string"
      },
      "days": {
       "description": "Day names, \"weekdays\", \"weekends\" or a range like \"Monday-Friday\".",
       "items": {
        "maxLength": 30,
        "type": "string"
       },
       "maxItems": 7,
       "minItems": 1,
       "type": "array"
      },
      "opens": {
       "description": "Such as \"8:00\", \"8 AM\" or \"08:00\".",
       "maxLength": 20,
       "type": "string"
      }
     },
     "required": [
      "days",
      "opens",
      "closes"
     ],
     "type": "object"
    },
    "maxItems": 14,
    "type": "array"
   },
   "images": {
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "logo": {
    "description": "Logo image URL.",
    "maxLength": 2048,
    "type": "string"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "menu_url": {
    "description": "Food businesses only.",
    "maxLength": 2048,
    "type": "string"
   },
   "name": {
    "description": "Business name as shown on the storefront, website and Google profile.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "open_24_7": {
    "description": "True when the business is open 24 hours every day. Overrides hours.",
    "type": "boolean"
   },
   "payment_accepted": {
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "postal_code": {
    "maxLength": 20,
    "type": "string"
   },
   "price_range": {
    "description": "Such as \"$$\" or \"$100-$300\". Under 100 characters.",
    "maxLength": 99,
    "type": "string"
   },
   "same_as": {
    "description": "Official profile URLs that identify the business: Google Business Profile, Facebook, LinkedIn, Yelp, Wikidata.",
    "items": {
     "maxLength": 2048,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "schema_type": {
    "anyOf": [
     {
      "maxLength": 80,
      "type": "string"
     },
     {
      "items": {
       "maxLength": 80,
       "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
     }
    ],
    "description": "An exact schema.org LocalBusiness subtype, or up to three, such as \"Plumber\". Overrides business_type."
   },
   "seasonal_closures": {
    "description": "Closed periods, dates as YYYY-MM-DD.",
    "items": {
     "properties": {
      "valid_from": {
       "maxLength": 10,
       "type": "string"
      },
      "valid_through": {
       "maxLength": 10,
       "type": "string"
      }
     },
     "required": [
      "valid_from",
      "valid_through"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "serves_cuisine": {
    "description": "Food businesses only.",
    "items": {
     "maxLength": 60,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "services": {
    "description": "Services offered, written as Offer items.",
    "items": {
     "maxLength": 120,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "street_address": {
    "maxLength": 200,
    "type": "string"
   },
   "telephone": {
    "description": "Primary customer phone number. North American numbers are written as +1-AAA-BBB-CCCC.",
    "maxLength": 40,
    "type": "string"
   },
   "url": {
    "description": "The business website or location page.",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "generate_local_business_schema",
 "title": "Generate LocalBusiness schema"
}
