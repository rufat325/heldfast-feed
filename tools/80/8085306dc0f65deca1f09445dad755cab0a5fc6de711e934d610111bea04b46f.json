{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Browse curated public RegusciLabs social posts with real post URLs, platform, language, topic and verified-date filters and pagination. Not a real-time feed; unverified post dates are null and platforms without approved sources may be empty.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Reuse nextCursor with identical filters.",
    "pattern": "^\\d{1,7}$",
    "type": "string"
   },
   "from": {
    "description": "Only posts with verified dates can match this lower bound.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "all",
    "enum": [
     "all",
     "es",
     "en"
    ],
    "type": "string"
   },
   "platform": {
    "default": "all",
    "enum": [
     "all",
     "youtube",
     "instagram",
     "linkedin",
     "tiktok",
     "reddit"
    ],
    "type": "string"
   },
   "to": {
    "description": "Only posts with verified dates can match this upper bound.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "topic": {
    "description": "Match only public titles, summaries, tags and approved project names.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_latest_activity"
}
