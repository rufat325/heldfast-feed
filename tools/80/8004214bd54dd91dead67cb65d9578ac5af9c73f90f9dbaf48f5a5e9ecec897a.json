{
 "description": "Generate personalized sales outreach for email, LinkedIn, or SMS. Returns subject line variants, body copy, a follow-up, and channel-specific tips.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callToAction": {
    "default": "15-min call",
    "enum": [
     "15-min call",
     "demo",
     "reply with interest",
     "visit website"
    ],
    "type": "string"
   },
   "channel": {
    "default": "email",
    "enum": [
     "email",
     "linkedin",
     "sms"
    ],
    "type": "string"
   },
   "painPoint": {
    "description": "Specific pain point you know this prospect has",
    "type": "string"
   },
   "prospect": {
    "additionalProperties": false,
    "properties": {
     "company": {
      "type": "string"
     },
     "firstName": {
      "type": "string"
     },
     "industry": {
      "type": "string"
     },
     "lastName": {
      "type": "string"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "firstName",
     "lastName",
     "title",
     "company",
     "industry"
    ],
    "type": "object"
   },
   "senderName": {
    "description": "Your name",
    "type": "string"
   },
   "senderTitle": {
    "description": "Your title or role",
    "type": "string"
   },
   "socialProof": {
    "description": "Relevant case study, client, or stat to mention",
    "type": "string"
   },
   "tone": {
    "default": "conversational",
    "enum": [
     "formal",
     "conversational",
     "bold"
    ],
    "type": "string"
   },
   "valueProposition": {
    "description": "Your core value prop \u2014 what problem you solve",
    "type": "string"
   }
  },
  "required": [
   "prospect",
   "valueProposition",
   "senderName",
   "senderTitle"
  ],
  "type": "object"
 },
 "name": "generate_outreach"
}
