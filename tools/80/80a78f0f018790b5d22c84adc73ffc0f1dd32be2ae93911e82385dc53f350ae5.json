{
 "description": "Import a buyer's shopping-preference appraisal (derived by a Mind from the owner's email) onto their VIA Personal Shopper. Requires a link_token the owner minted in their VIA dashboard; it scopes the write to exactly one buyer. Pass the structured appraisal (categories, brands, sizes, cadence, budget signal). VIA never receives raw email. Taste signals shape matching and negotiation immediately; the budget signal becomes a PROPOSED spending cap that the owner must approve in the dashboard before it gates any autonomous spend.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appraisal": {
    "additionalProperties": false,
    "description": "The structured shopping-preference appraisal. Use evidence_summary for prose only; never include raw quoted email.",
    "properties": {
     "brands_avoided": {
      "default": [],
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 60,
      "type": "array"
     },
     "brands_liked": {
      "default": [],
      "items": {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 60,
      "type": "array"
     },
     "budget_signal": {
      "additionalProperties": false,
      "properties": {
       "monthly_spend_usd_estimate": {
        "minimum": 0,
        "type": "number"
       },
       "single_item_ceiling_usd": {
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "categories": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "affinity": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "category": {
         "maxLength": 60,
         "minLength": 1,
         "type": "string"
        },
        "typical_price_usd_high": {
         "minimum": 0,
         "type": "number"
        },
        "typical_price_usd_low": {
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "category"
       ],
       "type": "object"
      },
      "maxItems": 40,
      "type": "array"
     },
     "confidence": {
      "default": 0.5,
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "evidence_summary": {
      "maxLength": 4000,
      "type": "string"
     },
     "notable_recent_purchases": {
      "default": [],
      "items": {
       "additionalProperties": false,
       "properties": {
        "category": {
         "maxLength": 60,
         "type": "string"
        },
        "item": {
         "maxLength": 200,
         "type": "string"
        },
        "price_usd": {
         "minimum": 0,
         "type": "number"
        },
        "when": {
         "maxLength": 40,
         "type": "string"
        }
       },
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "purchase_cadence": {
      "enum": [
       "frequent",
       "occasional",
       "rare"
      ],
      "type": "string"
     },
     "sizes": {
      "additionalProperties": {
       "maxLength": 40,
       "type": "string"
      },
      "default": {},
      "type": "object"
     }
    },
    "type": "object"
   },
   "link_token": {
    "description": "The link token the buyer owner minted in their VIA dashboard (POST /api/buyer/[buyerId]/appraisal action=mint_link).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "link_token",
   "appraisal"
  ],
  "type": "object"
 },
 "name": "import_preference_appraisal"
}
