    },
    "type": "array"
   },
   "assigneeTypes": {
    "description": "Filter by assignee type",
    "items": {
     "enum": [
      "USER",
      "GENERIC"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "from": {
    "description": "Start date (YYYY-MM-DD) \u2014 required",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "genericResourceIds": {
    "description": "Filter by generic resource ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "issueIds": {
    "description": "Filter by Jira issue ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max results (max 5000)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "planIds": {
    "description": "Filter by specific plan ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "planItemIds": {
    "description": "Filter by plan item ids (issue or project ids)",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "planItemTypes": {
    "description": "Filter by plan item type",
    "items": {
     "enum": [
      "ISSUE",
      "PROJECT"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "plannedTimeBreakdown": {
    "description": "Time breakdown granularity",
    "items": {
     "enum": [
      "DAILY",
      "PERIOD"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "projectIds": {
    "description": "Filter by Jira project ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "to": {
    "description": "End date (YYYY-MM-DD) \u2014 required",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "updatedFrom": {
    "description": "Filter by update date",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "view": {
    "description": "Response shape: \"compact\" (default) drops fields the response already carries elsewhere; \"full\" returns every field this server understands. compact strips image/avatar URLs from the response; \"full\" returns Tempo's payload untouched. No field projection: this server has no verified record of which Tempo fields matter, and inventing one would risk dropping a field a caller needs.",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
