{
 "description": "Report whether a resolver request actually worked and how much agent friction it required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agentSteps": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "failureReason": {
    "maxLength": 500,
    "type": "string"
   },
   "latencyMs": {
    "maximum": 86400000,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "maxLength": 200,
    "minLength": 4,
    "type": "string"
   },
   "selectedServer": {
    "maxLength": 300,
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "requestId",
   "success"
  ],
  "type": "object"
 },
 "name": "report_outcome"
}
