{
 "description": "Query search traffic data from Google Search Console. Returns clicks, impressions, CTR, and position data with flexible filtering and grouping.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregationType": {
    "description": "How data is aggregated (default: auto)",
    "enum": [
     "auto",
     "byPage",
     "byProperty",
     "byNewsShowcasePanel"
    ],
    "type": "string"
   },
   "dataState": {
    "description": "'all' includes fresh (possibly incomplete) data, 'final' only finalized data, 'hourly_all' required when using 'hour' dimension",
    "enum": [
     "all",
     "final",
     "hourly_all"
    ],
    "type": "string"
   },
   "dimensionFilterGroups": {
    "description": "Filter groups to apply to the query",
    "items": {
     "additionalProperties": false,
     "properties": {
      "filters": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "dimension": {
          "description": "The dimension to filter on",
          "enum": [
           "country",
           "device",
           "page",
           "query",
           "searchAppearance",
           "date",
           "hour"
          ],
          "type": "string"
         },
         "expression": {
          "description": "The value to filter by",
          "type": "string"
         },
         "operator": {
          "description": "Filter operator (default: 'equals')",
          "enum": [
           "contains",
           "equals",
           "notContains",
           "notEquals",
           "includingRegex",
           "excludingRegex"
          ],
          "type": "string"
         }
        },
        "required": [
         "dimension",
         "expression"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "groupType": {
       "description": "How filters are combined (only 'and' is supported)",
       "enum": [
        "and"
       ],
       "type": "string"
      }
     },
     "required": [
      "filters"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dimensions": {
    "description": "Dimensions to group by: country, device, page, query, searchAppearance, date, hour (hour requires dataState='hourly_all')",
    "items": {
     "enum": [
      "country",
      "device",
      "page",
      "query",
      "searchAppearance",
      "date",
      "hour"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "endDate": {
    "description": "End date in YYYY-MM-DD format",
    "type": "string"
   },
   "rowLimit": {
    "description": "Maximum number of rows to return (1-25000, default: 1000)",
    "maximum": 25000,
    "minimum": 1,
    "type": "number"
   },
   "siteUrl": {
    "description": "The site URL",
    "type": "string"
   },
   "startDate": {
    "description": "Start date in YYYY-MM-DD format",
    "type": "string"
   },
   "startRow": {
    "description": "Zero-based row offset for pagination",
    "minimum": 0,
    "type": "number"
   },
   "type": {
    "description": "Search type filter: web, image, video, news, discover, googleNews (default: web)",
    "enum": [
     "web",
     "image",
     "video",
     "news",
     "discover",
     "googleNews"
    ],
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "search_analytics_query"
}
