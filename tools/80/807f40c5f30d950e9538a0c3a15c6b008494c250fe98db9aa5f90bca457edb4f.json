{
 "description": "List your posts with optional status filter",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "description": "Page number (default 1)",
    "type": "number"
   },
   "status": {
    "description": "Filter by post status",
    "enum": [
     "pending",
     "scheduled",
     "published",
     "partial",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_posts"
}
