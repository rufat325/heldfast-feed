{
 "description": "Manage package.json fields programmatically",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "get",
     "set",
     "delete"
    ],
    "type": "string"
   },
   "field": {
    "description": "Field name (e.g. 'name', 'scripts.build', 'keywords')",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "value": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {},
      "type": "array"
     },
     {
      "additionalProperties": {},
      "type": "object"
     }
    ],
    "description": "JSON value to set; strings are literal strings, objects/arrays are accepted directly"
   }
  },
  "required": [
   "path",
   "action",
   "field"
  ],
  "type": "object"
 },
 "name": "pkg"
}
