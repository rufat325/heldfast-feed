     "maxLength": 128,
     "minLength": 1,
     "type": "string"
    },
    "type": "object"
   },
   "type": {
    "description": "Live-creatable same-family TouchDesigner operator type, e.g. nullTOP.",
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[A-Za-z][A-Za-z0-9]*$",
    "type": "string"
   }
  },
  "required": [
   "type",
   "expected_context",
   "idempotency_key"
  ],
  "type": "object"
 },
