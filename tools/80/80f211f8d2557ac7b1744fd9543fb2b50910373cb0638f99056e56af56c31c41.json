    "description": "Exact active Network Editor owner/current/single-selection snapshot to compare immediately before mutation.",
    "properties": {
     "current_path": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
     },
     "owner_path": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
     },
     "selected_path": {
      "maxLength": 1024,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "owner_path",
     "selected_path",
     "current_path"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "description": "Opaque retry key; exact retries replay and conflicting payloads fail closed.",
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "name": {
    "description": "Optional valid TouchDesigner operator name; TD generates one when omitted.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
    "type": "string"
   },
   "parameters": {
    "additionalProperties": {},
    "description": "At most 64 bounded JSON parameter values applied only to the new operator.",
