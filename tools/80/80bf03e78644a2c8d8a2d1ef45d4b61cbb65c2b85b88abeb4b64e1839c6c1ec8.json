{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Create a deterministic rotation with balanced minutes, goalkeeper duties and preferred positions. Returns each substitution window, player minutes and a shareable printable link. Duplicate names receive numbered suffixes. Without designated goalkeepers, everyone is available in goal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "format": {
    "anyOf": [
     {
      "enum": [
       "7v7",
       "9v9",
       "11v11"
      ],
      "type": "string"
     },
     {
      "const": 7,
      "type": "number"
     },
     {
      "const": 9,
      "type": "number"
     },
     {
      "const": 11,
      "type": "number"
     },
     {
      "enum": [
       "7",
       "9",
       "11"
      ],
      "type": "string"
     }
    ],
    "description": "7v7, 9v9 or 11v11; also accepts numbers 7, 9, 11 and strings \"7\", \"9\", \"11\"."
   },
   "formation": {
    "description": "Full formation including GK, for example 1-2-3-1. Omit for the recommended formation.",
    "type": "string"
   },
   "gameMinutes": {
    "description": "Defaults: 7v7 50, 9v9 60, 11v11 70 minutes.",
    "maximum": 120,
    "minimum": 10,
    "type": "number"
   },
   "goalkeepers": {
    "description": "Roster names in keeper rotation order; combined with canPlayGK flags.",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "periods": {
    "anyOf": [
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 4,
      "type": "number"
     }
    ],
    "description": "2 halves (default) or 4 quarters."
   },
   "players": {
    "items": {
     "anyOf": [
      {
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      {
       "properties": {
        "canPlayGK": {
         "type": "boolean"
        },
        "name": {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        "preferred": {
         "items": {
          "maxLength": 10,
          "minLength": 1,
          "type": "string"
         },
         "maxItems": 11,
         "type": "array"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 30,
    "minItems": 7,
    "type": "array"
   },
   "rotateGoalkeeper": {
    "description": "Designated keepers rotate at period breaks by default if more than one. Without designated keepers, defaults to keeping the current keeper until benched; true requests segment rotation, false fixes the first player in goal.",
    "type": "boolean"
   },
   "segmentsPerPeriod": {
    "description": "Equal substitution windows per period; default aims for about 8 minutes per segment.",
    "maximum": 12,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "players",
   "format"
  ],
  "type": "object"
 },
 "name": "generate_fair_lineup",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "format": {
    "enum": [
     "7v7",
     "9v9",
     "11v11"
    ],
    "type": "string"
   },
   "formation": {
    "type": "string"
   },
   "gameMinutes": {
    "maximum": 120,
    "minimum": 10,
    "type": "number"
   },
   "minutes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "minutes": {
       "type": "number"
      },
      "percent": {
       "type": "number"
      },
      "player": {
       "type": "string"
      }
     },
     "required": [
      "player",
      "minutes",
      "percent"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "periods": {
    "anyOf": [
     {
      "const": 2,
      "type": "number"
     },
     {
      "const": 4,
      "type": "number"
     }
    ]
   },
   "segments": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bench": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "endMinute": {
       "type": "number"
      },
      "index": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "onField": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "player": {
          "type": "string"
         },
         "position": {
          "type": "string"
         }
        },
        "required": [
         "position",
         "player"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "period": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "startMinute": {
       "type": "number"
      }
     },
     "required": [
      "index",
      "period",
      "startMinute",
      "endMinute",
      "onField",
      "bench"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shareUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "format",
   "formation",
   "gameMinutes",
   "periods",
   "segments",
   "minutes",
   "notes",
   "shareUrl"
  ],
  "type": "object"
 },
 "title": "Generate a fair youth soccer lineup"
}
