{
 "description": "Declare a missing capability by bounded technical slug and category. This records aggregate research evidence only; it will not execute, charge, provision, queue or promise future delivery.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "connection_diagnostics",
     "evaluation",
     "report_export",
     "history_monitoring",
     "comparison",
     "policy_authorization",
     "task_execution",
     "task_status",
     "payment_settlement",
     "data_integration",
     "other"
    ],
    "type": "string"
   },
   "horizon": {
    "enum": [
     "now",
     "later",
     "unspecified"
    ],
    "type": "string"
   },
   "requested_capability": {
    "maxLength": 64,
    "minLength": 3,
    "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+){0,7}$",
    "type": "string"
   }
  },
  "required": [
   "category",
   "requested_capability"
  ],
  "type": "object"
 },
 "name": "request_machine_capability",
 "title": "Request an AIWebSignals Machine Capability for a Future Release"
}
