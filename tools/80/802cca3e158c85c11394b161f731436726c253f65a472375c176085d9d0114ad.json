{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true
 },
 "description": "\u26a0\ufe0f Destructive: Permanently delete a Cloud Functions action. Set confirm=true to execute.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actionName": {
    "description": "Name of the action to delete",
    "type": "string"
   },
   "confirm": {
    "default": false,
    "description": "Must be true to actually execute the destructive operation",
    "type": "boolean"
   },
   "packageName": {
    "description": "Package name containing the action",
    "type": "string"
   },
   "platform": {
    "default": "vpc",
    "description": "Platform type (default: vpc)",
    "enum": [
     "vpc",
     "classic"
    ],
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "actionName"
  ],
  "type": "object"
 },
 "name": "ncloud_functions_delete_action"
}
