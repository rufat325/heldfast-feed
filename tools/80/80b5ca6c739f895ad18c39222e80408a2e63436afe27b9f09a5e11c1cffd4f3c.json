{
 "description": "Turns images, ports, resources and a term into a complete, correctly formatted v8 specification, with public ports auto-picked and data replication enabled. Returns the spec plus local validation errors and warnings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "components": {
    "items": {
     "properties": {
      "commands": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cpu": {
       "description": "Cores, 0.1 to 15 in 0.1 steps.",
       "type": "number"
      },
      "dataPath": {
       "description": "Path inside the container to persist. Default \"/data\".",
       "type": "string"
      },
      "description": {
       "maxLength": 256,
       "type": "string"
      },
      "env": {
       "anyOf": [
        {
         "additionalProperties": {
          "type": "string"
         },
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        {
         "items": {
          "type": "string"
         },
         "type": "array"
        }
       ]
      },
      "hdd": {
       "description": "GB.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "image": {
       "description": "Docker image with an explicit tag.",
       "type": "string"
      },
      "name": {
       "maxLength": 63,
       "type": "string"
      },
      "ports": {
       "items": {
        "properties": {
         "containerPort": {
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
         },
         "domain": {
          "type": "string"
         },
         "port": {
          "description": "Public port; auto-picked from 31000-39999 when omitted.",
          "maximum": 65535,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "containerPort"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "ram": {
       "description": "MB, multiple of 100.",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "replicateData": {
       "description": "Replicate the data path across instances. Default true.",
       "type": "boolean"
      },
      "repoauth": {
       "type": "string"
      }
     },
     "required": [
      "image",
      "cpu",
      "ram",
      "hdd"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "contacts": {
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "description": {
    "maxLength": 256,
    "type": "string"
   },
   "expireBlocks": {
    "description": "Exact term in blocks; overrides months.",
    "maximum": 1056000,
    "minimum": 1,
    "type": "integer"
   },
   "geolocation": {
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "instances": {
    "description": "Copies on distinct nodes. Default 3.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "months": {
    "description": "Term in network months (88000 blocks each). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 12,
    "type": "number"
   },
   "name": {
    "description": "Unique app name: letters, digits, inner hyphens. Not starting with \"flux\" or \"zel\".",
    "maxLength": 63,
    "minLength": 1,
    "type": "string"
   },
   "nodes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "owner": {
    "description": "Flux ID that will own the app. Defaults to the configured or passed key.",
    "type": "string"
   },
   "staticip": {
    "type": "boolean"
   }
  },
  "required": [
   "name",
   "components"
  ],
  "type": "object"
 },
 "name": "flux_build_spec",
 "title": "Build a Flux app specification from a simple description"
}
