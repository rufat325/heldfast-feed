{
 "description": "List all users currently connected to a presence channel. Only works with channels that start with 'presence-'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "channel": {
    "description": "Presence channel name (must start with 'presence-')",
    "format": "starts_with",
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^presence-.*",
    "type": "string"
   }
  },
  "required": [
   "channel"
  ],
  "type": "object"
 },
 "name": "get_presence_users"
}
