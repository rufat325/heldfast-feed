{"_meta":{"securitySchemes":[{"type":"noauth"}]},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Wedding day timeline builder"},"description":"Use this when someone wants a minute-by-minute wedding day schedule: getting ready, first look, ceremony, cocktail hour, reception, send-off. Needs the ceremony start time; everything else has defaults. Do not use for the months-long planning checklist or vendor payment schedules.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"ceremony_minutes":{"default":30,"maximum":90,"minimum":15,"type":"integer"},"ceremony_time":{"description":"Ceremony start, 24-hour HH:MM.","pattern":"^([01]\\d|2[0-3]):[0-5]\\d$","type":"string"},"cocktail_hour_minutes":{"default":60,"maximum":90,"minimum":45,"type":"integer"},"first_look":{"default":true,"type":"boolean"},"hair_and_makeup_people":{"default":4,"maximum":12,"minimum":1,"type":"integer"},"location":{"description":"City and state, for sunset.","maxLength":120,"type":"string"},"photo_priorities":{"default":["couple","family","wedding_party","sunset","detail"],"items":{"enum":["couple","family","wedding_party","sunset","detail"],"type":"string"},"type":"array"},"reception_hours":{"default":4.5,"maximum":6,"minimum":3,"type":"number"},"same_venue":{"default":true,"type":"boolean"},"send_off":{"default":"none","enum":["none","sparklers","bubbles","car"],"type":"string"},"travel_minutes":{"default":0,"maximum":120,"minimum":0,"type":"integer"},"wedding_date":{"description":"YYYY-MM-DD, for sunset.","format":"date","pattern":"^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$","type":"string"}},"required":["ceremony_time"],"type":"object"},"name":"build_wedding_timeline","outputSchema":{"$schema":"https://json-schema.org/draft/20