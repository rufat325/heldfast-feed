{
 "description": "Pause, resume, delete, or edit a monitored account. Requires factories:write + PUBLIC_API_WRITE + a live key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "pause",
     "resume",
     "delete"
    ],
    "type": "string"
   },
   "autoscanEnabled": {
    "type": "boolean"
   },
   "destinationUrl": {
    "description": "Per-account tracking destination override.",
    "type": "string"
   },
   "factoryAccountId": {
    "description": "Monitored-account membership id.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "id": {
    "description": "Factory id.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "tags": {
    "description": "Replace the account tags.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "id",
   "factoryAccountId"
  ],
  "type": "object"
 },
 "name": "vibevo_patch_factory_account",
 "title": "Pause/resume/remove factory account"
}
