{
 "description": "Deploy Python code to Floom and get a usable URL. Accepts raw Python source or a base64-encoded ZIP. Optionally include a floom.yaml config to declare endpoint schemas, secrets, and resource requirements. If your code makes HTTP requests (requests, httpx, urllib), set config.network to true. Without it, outbound network access is blocked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "Python source code or base64-encoded ZIP bundle",
    "type": "string"
   },
   "config": {
    "additionalProperties": false,
    "description": "floom.yaml configuration: declare endpoint schemas, required secrets, and resource settings",
    "properties": {
     "dependencies": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "endpoints": {
      "additionalProperties": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "type": "string"
        },
        "inputs": {
         "additionalProperties": {},
         "type": "object"
        },
        "lane": {
         "enum": [
          "cpu",
          "gpu"
         ],
         "type": "string"
        },
        "outputs": {
         "additionalProperties": {},
         "type": "object"
        },
        "summary": {
         "type": "string"
        },
        "timeout_seconds": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "type": "object"
     },
     "entrypoint": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "network": {
      "type": "boolean"
     },
     "runtime": {
      "type": "string"
     },
     "secrets": {
      "anyOf": [
       {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       {
        "additionalProperties": {},
        "type": "object"
       }
      ]
     },
     "version": {
      "type": [
       "number",
       "string"
      ]
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Project name (lowercase, hyphens allowed)",
    "type": "string"
   },
   "requirements": {
    "description": "Python package requirements (e.g. [\"requests==2.31.0\", \"pandas\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "code",
   "name"
  ],
  "type": "object"
 },
 "name": "deploy"
}
