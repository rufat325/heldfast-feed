{
 "description": "Change cvrt-woo-helper invoice settings; only the keys given change, an invalid value is a 400 and nothing is written. api_keys is WRITE-ONLY (a blank key keeps the stored one) and is never returned; clear_api_keys deletes keys. dry_run stays on until explicitly switched off: with it off, paid orders create REAL invoices in the live ledger.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_keys": {
    "additionalProperties": false,
    "description": "WRITE-ONLY API keys per provider; blank keeps the stored key",
    "properties": {
     "lexware": {
      "type": "string"
     },
     "sevdesk": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "attach_emails": {
    "description": "Emails that get the invoice PDF",
    "items": {
     "enum": [
      "customer_processing_order",
      "customer_completed_order",
      "customer_invoice"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "clear_api_keys": {
    "description": "Delete these providers' stored keys",
    "items": {
     "enum": [
      "sevdesk",
      "lexware"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "create_contacts": {
    "description": "Create provider contacts for customers",
    "type": "boolean"
   },
   "dry_run": {
    "description": "true = build and show the request only, never write to the provider",
    "type": "boolean"
   },
   "einvoice": {
    "description": "E-invoice (XRechnung/ZUGFeRD) where the provider supports it",
    "type": "boolean"
   },
   "enabled": {
    "description": "Create invoices for paid orders",
    "type": "boolean"
   },
   "introduction": {
    "type": "string"
   },
   "lexware_payment_condition": {
    "$ref": "#/properties/sevdesk_contact_person"
   },
   "lexware_print_layout": {
    "$ref": "#/properties/sevdesk_contact_person"
   },
   "lexware_unit_name": {
    "type": "string"
   },
   "own_email": {
    "description": "Separate 'Your invoice' email",
    "enum": [
     "off",
     "fallback",
     "always"
    ],
    "type": "string"
   },
   "price_mode": {
    "enum": [
     "auto",
     "gross",
     "net"
    ],
    "type": "string"
   },
   "provider": {
    "enum": [
     "none",
     "sevdesk",
     "lexware"
    ],
    "type": "string"
   },
   "reference": {
    "description": "Invoice reference; must contain {order_number} or {order_id}",
    "type": "string"
   },
   "refunds": {
    "description": "Credit notes / cancellation for refunds",
    "type": "boolean"
   },
   "remark": {
    "type": "string"
   },
   "sevdesk_contact_person": {
    "type": [
     "string",
     "number"
    ]
   },
   "sevdesk_letterpaper": {
    "$ref": "#/properties/sevdesk_contact_person"
   },
   "sevdesk_payment_method": {
    "$ref": "#/properties/sevdesk_contact_person"
   },
   "sevdesk_template": {
    "$ref": "#/properties/sevdesk_contact_person"
   },
   "sevdesk_unity": {
    "$ref": "#/properties/sevdesk_contact_person"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "trigger_statuses": {
    "description": "Also create when a paid order reaches these statuses",
    "items": {
     "enum": [
      "processing",
      "completed"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "vat_id_meta": {
    "description": "Order meta key holding the customer's VAT id",
    "type": "string"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "woo_helper_put_invoices"
}
