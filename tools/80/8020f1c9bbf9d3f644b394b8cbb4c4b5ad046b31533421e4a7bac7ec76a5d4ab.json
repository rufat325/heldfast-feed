{
 "description": "List files and folders from the CRM media library. Supports pagination, search, and folder browsing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (default 50)",
    "type": "number"
   },
   "location_id": {
    "description": "CRM location ID",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset",
    "type": "number"
   },
   "parent_id": {
    "description": "Folder ID to browse into (omit for root)",
    "type": "string"
   },
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "sort_by": {
    "description": "Sort field (default: createdAt)",
    "type": "string"
   },
   "sort_order": {
    "description": "asc or desc (default: desc)",
    "type": "string"
   },
   "type": {
    "description": "Filter: file, folder, or all (default: all)",
    "type": "string"
   }
  },
  "required": [
   "location_id"
  ],
  "type": "object"
 },
 "name": "crm_media_list"
}
