{
 "description": "Get history of all activities in a specific project across the workspace",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "boardIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "createdBy": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dateRangeEnd": {
    "type": "string"
   },
   "dateRangeStart": {
    "type": "string"
   },
   "entityTypes": {
    "items": {
     "enum": [
      "task",
      "project",
      "board",
      "document",
      "milestone"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "excludeKeys": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "keys": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 50,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "projectId": {
    "minLength": 1,
    "type": "string"
   },
   "taskIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "get_project_history"
}
