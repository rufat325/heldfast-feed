{
 "description": "Record a memory modification for audit trail. Track all changes to agent memory including adds, updates, deletes, and clears. Essential for compliance and trust scoring.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Unique identifier for the agent",
    "type": "string"
   },
   "authorized": {
    "default": true,
    "description": "Whether this modification was authorized (default: true)",
    "type": "boolean"
   },
   "authorized_by": {
    "description": "Who/what authorized the modification",
    "type": "string"
   },
   "key_path": {
    "description": "Path to the modified key (e.g., 'user.preferences.theme')",
    "type": "string"
   },
   "metadata": {
    "description": "Additional metadata about the modification",
    "type": "object"
   },
   "modification_type": {
    "description": "Type of modification being made",
    "enum": [
     "add",
     "update",
     "delete",
     "clear"
    ],
    "type": "string"
   },
   "new_value": {
    "description": "New value (for adds and updates)",
    "type": "object"
   },
   "old_value": {
    "description": "Previous value (for updates and deletes)",
    "type": "object"
   },
   "reason": {
    "description": "Reason for the modification",
    "type": "string"
   }
  },
  "required": [
   "agent_id",
   "modification_type"
  ],
  "type": "object"
 },
 "name": "tork_memory_track_modification"
}
