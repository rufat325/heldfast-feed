{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Build a Mermaid sequence diagram from participants and ordered messages, with optional activation, notes and alt/loop blocks. Rejects unknown participants.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"messages":{"items":{"additionalProperties":false,"properties":{"activate":{"default":false,"type":"boolean"},"block":{"additionalProperties":false,"properties":{"kind":{"enum":["alt","else","loop","opt","par","end"],"type":"string"},"label":{"default":"","maxLength":80,"type":"string"}},"required":["kind","label"],"type":"object"},"from":{"pattern":"^[a-zA-Z][a-zA-Z0-9_]{0,39}$","type":"string"},"note":{"maxLength":140,"type":"string"},"style":{"default":"sync","enum":["sync","async","reply","reply-async"],"type":"string"},"text":{"maxLength":140,"minLength":1,"type":"string"},"to":{"pattern":"^[a-zA-Z][a-zA-Z0-9_]{0,39}$","type":"string"}},"required":["from","to","text","style","activate"],"type":"object"},"maxItems":60,"minItems":1,"type":"array"},"participants":{"items":{"additionalProperties":false,"properties":{"id":{"pattern":"^[a-zA-Z][a-zA-Z0-9_]{0,39}$","type":"string"},"kind":{"default":"participant","enum":["actor","participant"],"type":"string"},"label":{"maxLength":200,"minLength":1,"type":"string"}},"required":["id","label","kind"],"type":"object"},"maxItems":15,"minItems":2,"type":"array"},"title":{"maxLength":200,"minLength":1,"type":"string"}},"required":["title","participants","messages"],"type":"object"},"name":"sequence_diagram","outputSchema":{"additionalProperties":true,"properties":{"kind":{"type":["string","null"]},"limitation":{"type":["string","null"]},"mermaid":{"type":["string","null"]},"messages":{"type":["number","null"]},"sources":{"type":"array"},"validated":{"type":["boolean","null"]}},"type":"object"}}
