{
 "description": "Strict reorder of a job's checklists: orderedDefinitionIds must contain EVERY definition exactly once and expectedOrderedDefinitionIds is a compare-and-set precondition on the current order (a 409 carries the live order). Requires job_checklists:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expectedOrderedDefinitionIds": {
    "items": {
     "$ref": "#/properties/jobId"
    },
    "maxItems": 200,
    "type": "array"
   },
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key. Same key + same payload replays the stored receipt; same key + changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "jobId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "orderedDefinitionIds": {
    "items": {
     "$ref": "#/properties/jobId"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "jobId",
   "orderedDefinitionIds",
   "expectedOrderedDefinitionIds",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_job_checklists_reorder",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
