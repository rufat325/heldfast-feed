{
 "description": "List your invoices (as issuer or payer). Filter by state and/or role.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max rows (default 50)",
    "type": "number"
   },
   "role": {
    "description": "Filter by your role",
    "enum": [
     "issuer",
     "payer",
     "any"
    ],
    "type": "string"
   },
   "state": {
    "description": "Filter by state",
    "enum": [
     "open",
     "paid",
     "cancelled",
     "expired"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "spawnpay_invoice_list"
}
