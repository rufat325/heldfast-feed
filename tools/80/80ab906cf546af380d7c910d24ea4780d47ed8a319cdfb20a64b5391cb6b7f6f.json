{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Lists web hostings (classic + Node.js) for a given Infomaniak organization. Use infomaniak_list_organizations first to discover account IDs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "description": "Organization/account ID. Optional: if omitted, falls back to the first account the token has access to. Use infomaniak_overview to enumerate.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "include_nodejs": {
    "default": true,
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "infomaniak_list_hostings",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "account_id": {
    "type": "number"
   },
   "hostings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "account_id": {
       "type": "number"
      },
      "created_at": {
       "type": "number"
      },
      "customer_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "expired_at": {
       "type": [
        "number",
        "null"
       ]
      },
      "has_maintenance": {
       "type": "boolean"
      },
      "has_operation_in_progress": {
       "type": "boolean"
      },
      "id": {
       "type": "number"
      },
      "internal_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "is_locked": {
       "type": "boolean"
      },
      "is_nodejs": {
       "type": "boolean"
      },
      "parent_id": {
       "type": "number"
      },
      "parent_service_name": {
       "type": "string"
      },
      "service_id": {
       "type": "number"
      },
      "service_name": {
       "type": "string"
      },
      "unique_id": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "account_id",
      "service_id",
      "service_name",
      "customer_name",
      "is_nodejs"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "account_id",
   "hostings"
  ],
  "type": "object"
 }
}
