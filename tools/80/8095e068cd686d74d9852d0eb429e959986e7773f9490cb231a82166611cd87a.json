{
 "description": "What a buy or a sale of any BNB Chain token would get right now: amounts, minimum after slippage, taxes, site fee and price impact. Sends nothing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "buy: pair currency to spend (e.g. BNB); sell: whole tokens",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "slippageBps": {
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "token": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "token",
   "side",
   "amount"
  ],
  "type": "object"
 },
 "name": "quote"
}
