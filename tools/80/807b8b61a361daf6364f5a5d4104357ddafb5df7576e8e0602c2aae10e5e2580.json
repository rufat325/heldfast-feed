  "properties": {
   "category": {
    "type": "string"
   },
   "family": {
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "partsBaseUrl": {
    "description": "Opt-in remote endpoint; no default value ships with kernelCAD.",
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "source": {
    "enum": [
     "local",
     "remote",
     "auto"
    ],
    "type": "string"
   },
   "standard": {
    "type": "string"
   },
   "tag": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_part",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "error": {
    "type": "string"
   },
   "errorCode": {
    "type": "string"
   },
   "errorHint": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "remoteEnabled": {
    "description": "Whether the remote tier was queried (success).",
    "type": "boolean"
   },
   "results": {
