          },
          "customLabel2": {
           "maxLength": 100,
           "type": "string"
          },
          "customLabel3": {
           "maxLength": 100,
           "type": "string"
          },
          "customLabel4": {
           "maxLength": 100,
           "type": "string"
          },
          "description": {
           "maxLength": 9999,
           "type": "string"
          },
          "gender": {
           "enum": [
            "female",
            "male",
            "unisex"
           ],
           "type": "string"
          },
          "googleProductCategory": {
           "maxLength": 250,
           "type": "string"
