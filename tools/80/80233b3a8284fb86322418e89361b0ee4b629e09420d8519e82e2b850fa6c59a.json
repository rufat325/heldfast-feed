{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Append items to the Uwear Shoot Board.",
 "inputSchema": {
  "properties": {
   "board_id": {
    "description": "The open Shoot Board's board_id, from Open Shoot Board or your context.",
    "type": "string"
   },
   "board_version": {
    "description": "Pass 2 to receive board v2 state, including the board's output settings",
    "enum": [
     2
    ],
    "type": "integer"
   },
   "context_items": {
    "description": "Shoot Board items to append to the current list",
    "items": {
     "properties": {
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "gender": {
       "maxLength": 40,
       "type": "string"
      },
      "id": {
       "oneOf": [
        {
         "type": "integer"
        },
        {
         "type": "string"
        }
       ]
      },
      "intake": {
       "description": "Board v2: intake state of an item still being sorted; absent means ready",
       "properties": {
        "candidates": {
         "items": {
          "enum": [
           "clothing",
           "models",
           "outfits",
           "generations",
           "files",
           "locations",
           "art_directions",
           "automations"
          ],
          "type": "string"
         },
         "type": "array"
        },
        "source_hash": {
         "description": "sha256 hex of the source file",
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "enum": [
          "sorting",
          "needs_answer",
          "ready"
         ],
         "type": "string"
        }
       },
       "required": [
        "status"
       ],
       "type": [
        "object",
        "null"
       ]
      },
      "isVideo": {
       "type": "boolean"
      },
      "key": {
       "type": "string"
      },
      "mediaUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "meta": {
       "description": "Short display facts, e.g. ['female', 'ID 7']",
       "items": {
        "type": [
         "string",
         "number",
         "boolean"
        ]
       },
       "maxItems": 8,
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "posterUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "refs": {
       "type": "object"
      },
      "schemaVersion": {
       "type": "integer"
      },
      "thumbnailUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "enum": [
        "clothing",
        "models",
        "outfits",
        "generations",
        "files",
        "locations",
        "art_directions",
        "automations"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "expected_revision": {
    "description": "Board revision this write is based on; a stale revision returns a revision_conflict error with the current board instead of overwriting it",
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "context_items",
   "board_id",
   "expected_revision"
  ],
  "type": "object"
 },
 "name": "mcp_add_context",
 "securitySchemes": [
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Add to Shoot Board"
}
