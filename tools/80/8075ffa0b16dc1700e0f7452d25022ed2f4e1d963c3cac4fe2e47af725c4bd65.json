{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Generate a professional invoice PDF from structured JSON (parties, line items, tax, discount). Returns a download URL valid for 24 hours plus computed totals. No account needed for up to 10 documents/day; pass api_key or an Authorization header for plan quotas.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"api_key":{"description":"Optional Slipstack API key (psk_...). With a key, usage bills against your plan quota. Without one, the shared demo quota applies (10 documents/day per IP). Get a key at https://slipstack.dev/pricing","type":"string"},"data":{"additionalProperties":false,"properties":{"accentColor":{"description":"Hex color for the template accent, e.g. #0ea5e9","type":"string"},"buyerReference":{"description":"Buyer reference, e.g. a German Leitweg-ID (e-invoice BT-10; required by XRechnung)","type":"string"},"currency":{"description":"ISO 4217 code, default USD","type":"string"},"date":{"description":"Issue date, e.g. 2026-06-09","type":"string"},"discount":{"description":"Absolute discount amount","minimum":0,"type":"number"},"dueDate":{"description":"Payment due date (invoices)","type":"string"},"from":{"additionalProperties":false,"description":"The party issuing the document","properties":{"address":{"description":"Postal address, newlines allowed","type":"string"},"city":{"description":"City name (improves e-invoice address quality)","type":"string"},"countryCode":{"description":"ISO 3166-1 alpha-2 country code, e.g. FR (required for e-invoices)","maxLength":2,"minLength":2,"type":"string"},"email":{"type":"string"},"logoUrl":{"description":"HTTPS URL of a logo image (issuer only)","type":"string"},"name":{"description":"Legal or display name","minLength":1,"type":"string"},"phone":{"type":"string"},"postalCode":{"description