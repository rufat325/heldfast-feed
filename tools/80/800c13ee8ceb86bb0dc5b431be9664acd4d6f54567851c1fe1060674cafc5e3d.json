{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Estimate body-fat % using the U.S. Navy circumference method, with a Deurenberg BMI-based cross-check and ACE category. Needs sex, age, height, weight and tape measurements of neck and waist (plus hip for women).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "age": {
    "description": "Age in years (18\u201380). The Deurenberg cross-check and the ACE bands are adult references; the Navy equation itself does not use age.",
    "maximum": 80,
    "minimum": 18,
    "type": "integer"
   },
   "height_cm": {
    "description": "Height in centimeters (or use height_ft + height_in).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "height_ft": {
    "description": "Height, feet component (imperial).",
    "maximum": 8,
    "minimum": 1,
    "type": "number"
   },
   "height_in": {
    "description": "Height, inches component (imperial).",
    "maximum": 11.9,
    "minimum": 0,
    "type": "number"
   },
   "hip_cm": {
    "description": "Hip circumference in cm \u2014 required for women (or hip_in).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "hip_in": {
    "description": "Hip circumference in inches (women).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "neck_cm": {
    "description": "Neck circumference in cm (or neck_in).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "neck_in": {
    "description": "Neck circumference in inches.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "sex": {
    "description": "Biological sex.",
    "enum": [
     "male",
     "female"
    ],
    "type": "string"
   },
   "waist_cm": {
    "description": "Waist circumference in cm (or waist_in).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "waist_in": {
    "description": "Waist circumference in inches.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "weight_kg": {
    "description": "Weight in kilograms (or use weight_lb).",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "weight_lb": {
    "description": "Weight in pounds (imperial).",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "sex",
   "age"
  ],
  "type": "object"
 },
 "name": "calculate_body_fat",
 "title": "Estimate body-fat percentage"
}
