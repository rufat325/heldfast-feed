{
 "description": "Generate a structured case brief from a support ticket thread. Returns an assessment, what has been tried, current status, and recommended next step.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ticket_content": {
    "description": "The full support ticket thread \u2014 customer messages, agent replies, internal notes",
    "maxLength": 50000,
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "ticket_content"
  ],
  "type": "object"
 },
 "name": "generate_case_brief",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "full_brief": {
    "additionalProperties": false,
    "properties": {
     "actions_taken": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "current_problem": {
      "type": "string"
     },
     "key_context": {
      "type": "string"
     }
    },
    "required": [
     "current_problem",
     "actions_taken",
     "key_context"
    ],
    "type": "object"
   },
   "metadata": {
    "additionalProperties": false,
    "properties": {
     "brief_length": {
      "type": "number"
     },
     "compression_ratio": {
      "type": "number"
     },
     "input_length": {
      "type": "number"
     }
    },
    "required": [
     "input_length",
     "brief_length",
     "compression_ratio"
    ],
    "type": "object"
   },
   "quick_scan": {
    "additionalProperties": false,
    "properties": {
     "assessment": {
      "type": "string"
     },
     "next_step": {
      "type": "string"
     },
     "status": {
      "type": "string"
     }
    },
    "required": [
     "assessment",
     "next_step",
     "status"
    ],
    "type": "object"
   }
  },
  "required": [
   "quick_scan",
   "full_brief",
   "metadata"
  ],
  "type": "object"
 },
 "title": "Generate case brief"
}
