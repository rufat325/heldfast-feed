{
 "description": "Detect overlapping SEO pages and recommend safe consolidation, differentiation, canonical, and internal-link fixes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "focus_keywords": {
    "default": [],
    "items": {
     "maxLength": 120,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 250,
    "type": "array"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "avg_position": {
       "maximum": 100,
       "minimum": 1,
       "type": "number"
      },
      "backlinks": {
       "minimum": 0,
       "type": "number"
      },
      "canonical_url": {
       "format": "uri",
       "type": "string"
      },
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "description": {
       "maxLength": 500,
       "type": "string"
      },
      "headings": {
       "default": [],
       "items": {
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 30,
       "type": "array"
      },
      "impressions": {
       "minimum": 0,
       "type": "number"
      },
      "indexable": {
       "default": true,
       "type": "boolean"
      },
      "last_updated": {
       "maxLength": 40,
       "type": "string"
      },
      "page_type": {
       "default": "unknown",
       "enum": [
        "unknown",
        "homepage",
        "blog_post",
        "landing_page",
        "product",
        "software",
        "local_business",
        "comparison_page",
        "guide",
        "docs"
       ],
       "type": "string"
      },
      "primary_keyword": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "ranking_queries": {
       "default": [],
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "target_keywords": {
       "default": [],
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 50,
       "type": "array"
      },
      "title": {
       "maxLength": 180,
       "minLength": 1,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 2,
    "type": "array"
   },
   "sensitivity": {
    "default": "balanced",
    "enum": [
     "conservative",
     "balanced",
     "aggressive"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "type": "string"
   }
  },
  "required": [
   "pages"
  ],
  "type": "object"
 },
 "name": "agentseo_content_cannibalization",
 "title": "AgentSEO Content Cannibalization"
}
