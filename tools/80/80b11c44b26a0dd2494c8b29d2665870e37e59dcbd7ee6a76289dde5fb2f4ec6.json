     "small",
     "medium",
     "large",
     "xlarge"
    ],
    "type": "string"
   },
   "billing": {
    "default": "monthly",
    "enum": [
     "monthly",
     "annual"
    ],
    "type": "string"
   },
   "namedUsers": {
