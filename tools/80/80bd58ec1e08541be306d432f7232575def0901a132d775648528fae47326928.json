{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Request an on-site walkthrough at 1-5 times the person proposes: 24 h to 60 days out, starting Mon-Fri 8 AM-4 PM or Sat 9 AM-12 PM Pacific. Kolmo confirms one within 1 business day; until then it is \"requested\", not \"booked\". Without quoteLink, pass the person's own name, email, phone, address and scope. dryRun: true previews.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Property street address and city",
    "minLength": 5,
    "type": "string"
   },
   "dryRun": {
    "type": "boolean"
   },
   "email": {
    "format": "email",
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "description": "Access, parking, pets",
    "maxLength": 2000,
    "type": "string"
   },
   "phone": {
    "minLength": 7,
    "type": "string"
   },
   "proposedTimes": {
    "description": "ISO 8601 with offset",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "quoteLink": {
    "description": "The person's kolmo.io/quotes/<id> link, as Kolmo sent it. Never guess one.",
    "maxLength": 300,
    "minLength": 36,
    "type": "string"
   },
   "scope": {
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "proposedTimes"
  ],
  "type": "object"
 },
 "name": "request_walkthrough",
 "outputSchema": {
  "properties": {
   "message": {
    "type": "string"
   },
   "proposedTimes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reference": {
    "description": "Give this to the person.",
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Request an on-site walkthrough"
}
