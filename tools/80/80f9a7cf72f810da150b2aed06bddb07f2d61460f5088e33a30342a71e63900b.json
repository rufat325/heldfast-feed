     "romantic",
     "friendship",
     "coparenting"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Maximum rows to return (1-100, default 25).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_relationships",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "relationships": {
    "description": "Saved pairings with their context.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "List saved pairings"
}
