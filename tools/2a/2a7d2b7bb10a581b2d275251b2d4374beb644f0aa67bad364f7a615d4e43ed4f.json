{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Dictionary word completion"
 },
 "description": "Autocomplete a partial Hebrew/Aramaic word against a dictionary (\"Jastrow Dictionary\", \"Klein Dictionary\", \"BDB Augmented Strong\").",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dictionary": {
    "default": "Jastrow Dictionary",
    "type": "string"
   },
   "limit": {
    "default": 15,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "prefix": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "prefix"
  ],
  "type": "object"
 },
 "name": "dictionary_autocomplete",
 "title": "Dictionary word completion"
}
