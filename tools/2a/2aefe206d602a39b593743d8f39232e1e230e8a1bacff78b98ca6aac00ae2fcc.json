{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get fields and tax rules for a document"
 },
 "description": "Returns what to collect before creating a document of a given type and country: required, recommended and optional fields, the tax ID and tax names, the country's invoicing rules (for example India GST rule 46, UK VAT invoice contents), the CGST/SGST versus IGST split and state codes for India, and credit-note reasons. Read-only.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "ISO alpha-2 of the seller, e.g. IN, US, GB, DE.",
    "type": "string"
   },
   "document_type": {
    "description": "The kind of document.",
    "enum": [
     "invoice",
     "quote",
     "proforma",
     "credit_note",
     "receipt"
    ],
    "type": "string"
   }
  },
  "required": [
   "document_type",
   "country"
  ],
  "type": "object"
 },
 "name": "get_document_rules",
 "outputSchema": {
  "properties": {
   "country": {
    "type": "string"
   },
   "country_name": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "disclaimer": {
    "type": "string"
   },
   "document_type": {
    "type": "string"
   },
   "fields": {
    "items": {
     "properties": {
      "field": {
       "type": "string"
      },
      "need": {
       "enum": [
        "required",
        "recommended",
        "optional"
       ],
       "type": "string"
      },
      "note": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "need"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "formats": {
    "properties": {
     "date": {
      "type": "string"
     },
     "money": {
      "type": "string"
     }
    },
    "required": [
     "money",
     "date"
    ],
    "type": "object"
   },
   "gst": {
    "description": "India only: the CGST/SGST versus IGST split, place of supply and state codes.",
    "properties": {},
    "required": [],
    "type": "object"
   },
   "locale": {
    "type": "string"
   },
   "reasons": {
    "description": "Credit notes only.",
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "label": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rules": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "tax": {
    "properties": {
     "name": {
      "type": "string"
     },
     "seller_tax_id": {
      "type": "string"
     },
     "seller_tax_id_example": {
      "type": "string"
     },
     "vat_country": {
      "type": "boolean"
     }
    },
    "required": [
     "name",
     "seller_tax_id"
    ],
    "type": "object"
   },
   "what_to_include": {
    "items": {
     "properties": {
      "field": {
       "type": "string"
      },
      "what": {
       "type": "string"
      }
     },
     "required": [
      "field",
      "what"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "document_type",
   "country",
   "currency",
   "tax",
   "fields",
   "rules",
   "disclaimer"
  ],
  "type": "object"
 },
 "title": "Get fields and tax rules for a document"
}
