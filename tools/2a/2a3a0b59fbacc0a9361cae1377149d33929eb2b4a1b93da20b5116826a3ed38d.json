{
 "description": "Read the tail of a configured log file with optional filter.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filter": {
    "type": "string"
   },
   "jsonField": {
    "type": "string"
   },
   "path": {
    "minLength": 1,
    "type": "string"
   },
   "tail": {
    "default": 200,
    "exclusiveMinimum": 0,
    "maximum": 10000,
    "type": "integer"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "read_logs",
 "title": "Read logs"
}
