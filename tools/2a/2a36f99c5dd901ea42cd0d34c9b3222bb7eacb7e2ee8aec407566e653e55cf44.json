{
 "description": "Fetch one provider API operation's full contract \u2014 method, path, parameters, request/response schemas \u2014 live from Alter's provider-spec catalog, plus the spec's source and freshness. Get operation ids from list_operations first.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "kind": {
    "description": "Provider family: oauth (user-authorized) or managed (API-key).",
    "enum": [
     "oauth",
     "managed"
    ],
    "type": "string"
   },
   "operation_id": {
    "description": "Operation id from list_operations, e.g. \"gmail.users.messages.list\".",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "provider_id": {
    "description": "Provider id, e.g. \"google\" or \"github\".",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "provider_id",
   "operation_id"
  ],
  "type": "object"
 },
 "name": "get_operation_schema"
}
