    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "reason": {
    "type": "string"
   },
   "resolved": {
    "items": {},
    "type": "array"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "call": {
       "additionalProperties": {},
