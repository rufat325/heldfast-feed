  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Endpoints to return (default 3).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "platform": {
    "description": "Only this platform's endpoints (slug, e.g. 'tiktok'); alone, lists them.",
    "type": "string"
   },
   "task": {
    "description": "The job in plain words; URLs and @handles in it are resolved and filled. Omit to list platforms.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "socialcrawl_find",
