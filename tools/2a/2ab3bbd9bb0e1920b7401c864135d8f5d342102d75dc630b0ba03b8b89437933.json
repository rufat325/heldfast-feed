{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Is this Robinhood Chain project still being built, what did it ship, what changed, is this contract its own? One bounded answer, cited. capability: research_project or builder_status (q: a name or $TICKER, or address, or project: a slug; a name several projects share lists them); what_changed (project or chain, 1\u201330 days); verify_project (address, project?); compare_builders (2\u20134, no winner); unknowns (every coverage state). Claims FACT/DERIVED/UNKNOWN with freshness and evidence ids. Not price advice or a safety verdict.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "address": {
    "pattern": "^0[xX][a-fA-F0-9]{40}$",
    "type": "string"
   },
   "building": {
    "const": "only",
    "type": "string"
   },
   "capability": {
    "enum": [
     "research_project",
     "what_changed",
     "builder_status",
     "verify_project",
     "compare_builders",
     "unknowns"
    ],
    "type": "string"
   },
   "days": {
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "detail": {
    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "project": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "projects": {
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array"
   },
   "q": {
    "maxLength": 64,
    "minLength": 2,
    "type": "string"
   },
   "types": {
    "items": {
     "pattern": "^[a-z_]+\\.[a-z_]+$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "capability"
  ],
  "type": "object"
 },
 "name": "research_answer",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "answer": {
    "additionalProperties": true,
    "properties": {
     "text": {
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "capability": {
    "enum": [
     "research_project",
     "what_changed",
     "builder_status",
     "verify_project",
     "compare_builders",
     "unknowns"
    ],
    "type": "string"
   },
   "claims": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "status": {
       "enum": [
        "FACT",
        "DERIVED",
        "UNKNOWN"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "data": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "evidence": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "schema": {
    "const": "hey.agent-intelligence-response",
    "type": "string"
   },
   "schemaVersion": {
    "const": "1",
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "not_found",
     "moved",
     "invalid_request",
     "unavailable"
    ],
    "type": "string"
   }
  },
  "required": [
   "schema",
   "schemaVersion",
   "capability",
   "status",
   "answer",
   "claims",
   "evidence",
   "data"
  ],
  "type": "object"
 },
 "title": "Research a Robinhood Chain project"
}
