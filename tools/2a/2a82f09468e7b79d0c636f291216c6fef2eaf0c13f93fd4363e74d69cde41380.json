{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Write, destructive. Same plan as previewDeadlinePlan, then PATCH that owned deck to the recommended integer. deckId is required. Discuss the number first.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "alreadyLearned": {
    "minimum": 0,
    "type": "integer"
   },
   "asOf": {
    "description": "UTC ISO-8601 timestamp ending in Z",
    "type": "string"
   },
   "bufferStudyDays": {
    "maximum": 3650,
    "minimum": 0,
    "type": "integer"
   },
   "currentNewCardsPerDay": {
    "maximum": 9999,
    "minimum": 0,
    "type": "integer"
   },
   "dayBoundaryHour": {
    "maximum": 23,
    "minimum": 0,
    "type": "integer"
   },
   "deadline": {
    "description": "YYYY-MM-DD or a UTC ISO-8601 timestamp ending in Z.",
    "type": "string"
   },
   "deckId": {
    "format": "uuid",
    "type": "string"
   },
   "remainingNewCards": {
    "minimum": 0,
