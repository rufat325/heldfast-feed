{
 "_meta": {
  "openai/securitySchemes": [
   {
    "scopes": [
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ],
  "securitySchemes": [
   {
    "scopes": [
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search current YouTube results with discovery filters and cursor pagination.\n\nFilter by upload window, popularity, result type, duration, country, and language.\nPass next_cursor back as cursor for the next page. Each page is one metered request.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content_type": {
    "default": "all",
    "enum": [
     "all",
     "videos"
    ],
    "type": "string"
   },
   "country_code": {
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "cursor": {
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "duration": {
    "default": "any",
    "enum": [
     "any",
     "short",
     "medium",
     "long"
    ],
    "type": "string"
   },
   "language_code": {
    "default": "en",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "sort_by": {
    "default": "relevance",
    "enum": [
     "relevance",
     "popular"
    ],
    "type": "string"
   },
   "upload_date": {
    "default": "any",
    "enum": [
     "any",
     "last_hour",
     "today",
     "this_week",
     "this_month",
     "this_year"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_youtube",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "count": {
    "type": "number"
   },
   "data": {},
   "has_more": {
    "type": "boolean"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "not_found": {
    "items": {},
    "type": "array"
   },
   "ok": {
    "type": "boolean"
   },
   "results": {
    "items": {},
    "type": "array"
   },
   "suggested_followups": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "reason": {
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Search YouTube"
}
