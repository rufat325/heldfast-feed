{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "List project tasks in FreeAgent. Time is always logged against a task, so use this to find the task URL before creating a timeslip.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 50,
    "description": "Maximum tasks to return (default 50, max 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "project": {
    "description": "Only tasks belonging to this project",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "view": {
    "default": "active",
    "description": "Which tasks to return (default: active)",
    "enum": [
     "all",
     "active",
     "completed",
     "hidden"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "freeagent_list_tasks"
}
