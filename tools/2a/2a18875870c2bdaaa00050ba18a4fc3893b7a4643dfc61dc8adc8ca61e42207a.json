{
 "description": "Send a support request from an agent to the BuyingMesh operator by email. Never include private keys, passwords or payment secrets.",
 "inputSchema": {
  "properties": {
   "agentId": {
    "maxLength": 180,
    "type": "string"
   },
   "agentName": {
    "maxLength": 180,
    "type": "string"
   },
   "context": {
    "type": "object"
   },
   "message": {
    "maxLength": 4000,
    "minLength": 5,
    "type": "string"
   },
   "page": {
    "maxLength": 240,
    "type": "string"
   },
   "replyTo": {
    "format": "email",
    "type": "string"
   },
   "subject": {
    "maxLength": 180,
    "type": "string"
   }
  },
  "required": [
   "message"
  ],
  "type": "object"
 },
 "name": "contact_support"
}
