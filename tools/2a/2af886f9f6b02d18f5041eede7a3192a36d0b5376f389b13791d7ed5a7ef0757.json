{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Latest Maryland Athletics news stories, newest first, optionally for one sport. Pass a story id to athletics_get_article for the full text. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "page": {
    "default": 1,
    "description": "Page number, starting at 1 (default 1)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 10,
    "description": "Maximum number of records to return, 1-50 (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "sport_id": {
    "description": "Sport id from athletics_list_sports, e.g. 3 for Football",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "athletics_get_news",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pages": {
    "description": "Number of pages at this page size",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "stories": {
    "description": "Stories on the requested page, newest first",
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Published, ISO 8601 in US Eastern time",
       "type": "string"
      },
      "id": {
       "description": "Story id to pass to athletics_get_article",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "image_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "sport": {
       "description": "e.g. \"Football\"",
       "type": [
        "string",
        "null"
       ]
      },
      "sport_id": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "subheadline": {
       "type": [
        "string",
        "null"
       ]
      },
      "teaser": {
       "description": "Plain-text teaser",
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "Story page",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "subheadline",
      "teaser",
      "date",
      "sport",
      "sport_id",
      "url",
      "image_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Total stories matching",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "stories",
   "total",
   "pages"
  ],
  "type": "object"
 },
 "title": "Get news"
}
