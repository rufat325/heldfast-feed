{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search tasks"
 },
 "description": "Search/list tasks. All filters optional; returns a page of tasks. Copper REST: POST /tasks/search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_ids": {
    "description": "Filter to tasks owned by these user ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "name": {
    "description": "Task-name filter (substring match).",
    "type": "string"
   },
   "page_number": {
    "description": "1-based page number to fetch (default 1).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (default 20, max 200).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "sort_by": {
    "description": "Field to sort by, e.g. 'name', 'due_date', 'date_created' (default 'name').",
    "type": "string"
   },
   "sort_direction": {
    "description": "Sort direction \u2014 'asc' or 'desc' (default asc).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by task status.",
    "enum": [
     "Open",
     "Completed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "copper_search_tasks",
 "title": "Search tasks"
}
