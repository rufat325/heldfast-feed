{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a live chat ban. Use this tool to ban a user from a live chat.",
 "inputSchema": {
  "properties": {
   "ban_duration_seconds": {
    "description": "Duration of the ban in seconds (only for temporary bans)",
    "minimum": 0,
    "type": "number"
   },
   "ban_type": {
    "description": "permanent|temporary",
    "enum": [
     "permanent",
     "temporary"
    ],
    "type": "string"
   },
   "banned_user_channel_id": {
    "description": "Channel ID of the user to ban",
    "type": "string"
   },
   "live_chat_id": {
    "description": "ID of the live chat",
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|silent",
    "enum": [
     "json",
     "yaml",
     "silent"
    ],
    "type": "string"
   },
   "parts": {
    "default": [
     "snippet"
    ],
    "description": "Parts to include in the response",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "live_chat_id",
   "banned_user_channel_id",
   "ban_type"
  ],
  "type": "object"
 },
 "name": "liveChatBan-insert",
 "title": "Create a live chat ban"
}
