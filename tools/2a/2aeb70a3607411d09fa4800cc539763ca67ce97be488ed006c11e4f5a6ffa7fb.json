{
 "description": "Get the ERC-20 balance history of a contract over a time range.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractAddress": {
    "description": "Starknet contract address (0x-prefixed hex).",
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "timerange": {
    "description": "Time range.",
    "enum": [
     "1w",
     "1m",
     "3m",
     "6m",
     "1y"
    ],
    "type": "string"
   },
   "tokenAddress": {
    "description": "Filter by token address (0x-prefixed).",
    "type": "string"
   }
  },
  "required": [
   "contractAddress"
  ],
  "type": "object"
 },
 "name": "get_contract_erc20_balance_history"
}
