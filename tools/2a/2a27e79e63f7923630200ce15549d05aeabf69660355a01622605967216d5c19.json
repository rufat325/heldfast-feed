{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "FREE, no key. Normalize locale-explicit pack-size expressions and multipacks to exact grams, millilitres or counts; reject ambiguous text. Entire JSON input: 4096 UTF-8 bytes, at most 5 quantities. Supplied data only; no fetch, payment or automatic paid fallback.",
 "inputSchema": {
  "additionalProperties": false,
  "examples": [
   {
    "locale": "pt-BR",
    "quantities": [
     {
      "id": "milk",
      "text": "6 x 1,5 litros"
     },
     {
      "id": "chicken",
      "text": "Aprox. 2,8 Kg"
     },
     {
      "id": "unclear",
      "text": "500g + 20% free"
     }
    ]
   }
  ],
  "properties": {
   "locale": {
    "enum": [
     "en-US",
     "en-GB",
     "de-DE",
     "fr-FR",
     "pt-BR"
    ],
    "type": "string"
   },
   "quantities": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maxLength": 100,
       "minLength": 1,
       "type": "string"
      },
      "text": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "text"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "locale",
   "quantities"
  ],
  "type": "object"
 },
 "name": "agent_utilities_pack_size_normalize_preview",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "chargedMicroUsd": {
    "const": "0"
   },
   "executionPerformed": {
    "const": true
   },
   "limits": {
    "additionalProperties": false,
    "properties": {
     "maxInputBytes": {
      "const": 4096,
      "type": "integer"
     },
     "maxQuantities": {
      "const": 5,
      "type": "integer"
     }
    },
    "required": [
     "maxInputBytes",
     "maxQuantities"
    ],
    "type": "object"
   },
   "mode": {
    "const": "free-preview"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "allNormalized": {
      "type": "boolean"
     },
     "locale": {
      "type": "string"
     },
     "quantities": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "approximate": {
         "type": "boolean"
        },
        "baseUnit": {
         "type": [
          "string",
          "null"
         ]
        },
        "dimension": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "type": "string"
        },
        "issue": {
         "type": [
          "string",
          "null"
         ]
        },
        "packCount": {
         "type": [
          "integer",
          "null"
         ]
        },
        "quantity": {
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "enum": [
          "normalized",
          "unsupported"
         ],
         "type": "string"
        },
        "totalQuantity": {
         "type": [
          "string",
          "null"
         ]
        },
        "unit": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "status",
        "quantity",
        "unit",
        "packCount",
        "totalQuantity",
        "baseUnit",
        "dimension",
        "approximate",
        "issue"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "scope": {
      "type": "string"
     }
    },
    "required": [
     "locale",
     "quantities",
     "allNormalized",
     "scope"
    ],
    "type": "object"
   }
  },
  "required": [
   "mode",
   "chargedMicroUsd",
   "executionPerformed",
   "result",
   "limits"
  ],
  "type": "object"
 }
