{
 "description": "Get recent intent signals (new hires, departures, tech-stack changes, job postings) for a school or across all schools.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Max results (default 50)",
    "type": "number"
   },
   "school_id": {
    "description": "Filter by school (optional)",
    "type": "string"
   },
   "since": {
    "description": "ISO date \u2014 only return signals after this date",
    "type": "string"
   },
   "type": {
    "description": "Filter by signal type (optional)",
    "enum": [
     "new_hire",
     "departure",
     "title_change",
     "tech_add",
     "tech_drop",
     "job_posting"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_signals"
}
