{
 "description": "Create a new Meta ad with creative (image, copy, link). Ad is created PAUSED for review.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ad_account_id": {
    "description": "Meta ad account ID",
    "type": "string"
   },
   "ad_set_id": {
    "description": "Ad set ID",
    "type": "string"
   },
   "body": {
    "description": "Ad body text",
    "type": "string"
   },
   "call_to_action": {
    "default": "LEARN_MORE",
    "description": "Call to action button",
    "enum": [
     "LEARN_MORE",
     "SHOP_NOW",
     "SIGN_UP",
     "CONTACT_US",
     "GET_OFFER",
     "APPLY_NOW"
    ],
    "type": "string"
   },
   "image_url": {
    "description": "Image URL for the ad creative",
    "type": "string"
   },
   "link_url": {
    "description": "Destination URL",
    "format": "uri",
    "type": "string"
   },
   "name": {
    "description": "Ad name",
    "type": "string"
   },
   "page_id": {
    "description": "Facebook page ID",
    "type": "string"
   },
   "title": {
    "description": "Ad headline/title",
    "type": "string"
   }
  },
  "required": [
   "ad_account_id",
   "ad_set_id",
   "name",
   "page_id",
   "title",
   "body",
   "link_url"
  ],
  "type": "object"
 },
 "name": "meta_ads_create_ad"
}
