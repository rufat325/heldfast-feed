{
 "description": "Compare two features in one area or one feature across two areas using the compute backend. Optional year narrows year-split snapshots.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "area": {
    "type": "string"
   },
   "area_id": {
    "type": "string"
   },
   "area_ids": {
    "items": [
     {
      "type": "string"
     },
     {
      "type": "string"
     }
    ],
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "areas": {
    "items": [
     {
      "type": "string"
     },
     {
      "type": "string"
     }
    ],
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "database": {
    "type": "string"
   },
   "feature": {
    "$ref": "#/properties/features/items/0"
   },
   "features": {
    "items": [
     {
      "type": [
       "string",
       "number"
      ]
     },
     {
      "$ref": "#/properties/features/items/0"
     }
    ],
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "mode": {
    "default": "auto",
    "enum": [
     "cloud",
     "offline",
     "auto"
    ],
    "type": "string"
   },
   "primitive": {
    "default": "COUNT",
    "enum": [
     "NEAREST",
     "DISTANCE",
     "WITHIN",
     "COUNT",
     "DENSITY",
     "COVERAGE",
     "GAPS",
     "CLUSTER"
    ],
    "type": "string"
   },
   "year": {
    "description": "Optional snapshot year, for example 2026",
    "type": [
     "string",
     "number"
    ]
   }
  },
  "type": "object"
 },
 "name": "e2_compare",
 "title": "Compare features or areas"
}
