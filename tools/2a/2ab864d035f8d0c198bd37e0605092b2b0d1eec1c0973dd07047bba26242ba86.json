{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Stops Docker Compose services and returns structured status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "dryRun": {
    "default": false,
    "description": "Run in dry-run mode without actually stopping services (default: false)",
    "type": "boolean"
   },
   "file": {
    "description": "Compose file path (default: docker-compose.yml)",
    "maxLength": 4096,
    "type": "string"
   },
   "path": {
    "description": "Directory containing docker-compose.yml",
    "maxLength": 4096,
    "type": "string"
   },
   "removeOrphans": {
    "default": false,
    "description": "Remove orphan containers (default: false)",
    "type": "boolean"
   },
   "rmi": {
    "description": "Remove images: \"all\" removes all, \"local\" removes only untagged images",
    "enum": [
     "all",
     "local"
    ],
    "type": "string"
   },
   "services": {
    "default": [],
    "description": "Specific services to tear down (default: all)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "timeout": {
    "description": "Timeout in seconds for graceful shutdown of services",
    "type": "number"
   },
   "volumes": {
    "default": false,
    "description": "Also remove named volumes (default: false)",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "compose-down",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "containers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "networksRemoved": {
    "type": "number"
   },
   "stopped": {
    "type": "number"
   },
   "success": {
    "type": "boolean"
   },
   "volumesRemoved": {
    "type": "number"
   }
  },
  "required": [
   "success",
   "stopped"
  ],
  "type": "object"
 },
 "title": "Docker Compose Down"
}
