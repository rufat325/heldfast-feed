{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a customer"
 },
 "description": "Create a customer (a person) or a fleet account. Add an email afterwards with shopmonkey_add_customer_email. Shopmonkey: POST /v3/customer.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address1": {
    "description": "Street address, line 1.",
    "type": "string"
   },
   "address2": {
    "description": "Street address, line 2.",
    "type": "string"
   },
   "city": {
    "description": "City.",
    "type": "string"
   },
   "companyName": {
    "description": "Company name (for fleet / business customers).",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 country code, e.g. US or CA.",
    "pattern": "^[A-Z]{2}$",
    "type": "string"
   },
   "customerType": {
    "description": "Customer (individual) or Fleet (business account).",
    "enum": [
     "Customer",
     "Fleet"
    ],
    "type": "string"
   },
   "discountPercent": {
    "description": "Default discount percent.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "externalId": {
    "description": "Your own id for this customer in another system.",
    "type": "string"
   },
   "firstName": {
    "description": "First name.",
    "type": "string"
   },
   "lastName": {
    "description": "Last name.",
    "type": "string"
   },
   "locationId": {
    "description": "The shop location id (see shopmonkey_get_current_user for the key's own location).",
    "type": "string"
   },
   "note": {
    "description": "Internal note on the customer.",
    "type": "string"
   },
   "postalCode": {
    "description": "Postal / ZIP code.",
    "type": "string"
   },
   "preferredContactMethod": {
    "description": "SMS, Email or All.",
    "enum": [
     "SMS",
     "Email",
     "All"
    ],
    "type": "string"
   },
   "preferredLanguage": {
    "description": "en, en_US, fr_CA or es_MX.",
    "enum": [
     "en",
     "en_US",
     "fr_CA",
     "es_MX"
    ],
    "type": "string"
   },
   "state": {
    "description": "State / province.",
    "type": "string"
   },
   "taxExempt": {
    "description": "US tax exemption.",
    "type": "boolean"
   },
   "website": {
    "description": "Website.",
    "type": "string"
   }
  },
  "required": [
   "customerType"
  ],
  "type": "object"
 },
 "name": "shopmonkey_create_customer",
 "title": "Create a customer"
}
