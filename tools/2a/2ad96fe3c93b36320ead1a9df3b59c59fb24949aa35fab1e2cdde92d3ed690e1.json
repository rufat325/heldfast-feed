{
 "description": "Get train/bus connections between two Swiss locations",
 "inputSchema": {
  "properties": {
   "date": {
    "description": "Date YYYY-MM-DD (default: today)",
    "type": "string"
   },
   "from": {
    "description": "Departure station/address",
    "type": "string"
   },
   "isArrivalTime": {
    "description": "True if time is arrival time",
    "type": "boolean"
   },
   "limit": {
    "description": "Number of connections (1-16, default: 4)",
    "type": "number"
   },
   "time": {
    "description": "Time HH:MM (default: now)",
    "type": "string"
   },
   "to": {
    "description": "Arrival station/address",
    "type": "string"
   }
  },
  "required": [
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "get_connections"
}
