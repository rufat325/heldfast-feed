{
 "description": "Manage Datadog users. Actions: list (with filters), get (by ID). Use for: access management, user auditing, team organization.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "list",
     "get"
    ],
    "type": "string"
   },
   "filter": {
    "description": "Filter users by name or email",
    "type": "string"
   },
   "id": {
    "description": "User ID (required for get action)",
    "type": "string"
   },
   "pageNumber": {
    "description": "Page number for pagination",
    "type": "number"
   },
   "pageSize": {
    "description": "Number of users to return per page",
    "minimum": 1,
    "type": "number"
   },
   "status": {
    "description": "Filter by user status",
    "enum": [
     "Active",
     "Pending",
     "Disabled"
    ],
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "users"
}
