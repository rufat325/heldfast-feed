{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "stories:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a personalized story and spend the connected account's credits. Call only after the user explicitly approves the credit spend.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvedCreditSpend": {
    "const": true,
    "description": "True only after the user has explicitly approved spending TaleSpinner credits for this generation.",
    "type": "boolean"
   },
   "audience": {
    "default": "children",
    "enum": [
     "children",
     "adult"
    ],
    "type": "string"
   },
   "characterAge": {
    "maxLength": 30,
    "minLength": 1,
    "type": "string"
   },
   "characterGender": {
    "maxLength": 40,
    "type": "string"
   },
   "characterName": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "characterType": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "illustratePages": {
    "default": "all",
    "enum": [
     "all",
     "none",
     "cover"
    ],
    "type": "string"
   },
   "illustrationQuality": {
    "default": "medium",
    "enum": [
     "medium",
     "high"
    ],
    "type": "string"
   },
   "illustrationStyle": {
    "default": "vivid",
    "maxLength": 80,
    "type": "string"
   },
   "pageCount": {
    "default": 10,
    "maximum": 24,
    "minimum": 4,
    "type": "integer"
   },
   "specialMessage": {
    "maxLength": 500,
    "type": "string"
   },
   "storyLanguage": {
    "default": "en",
    "maxLength": 12,
    "type": "string"
   },
   "theme": {
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "characterName",
   "characterAge",
   "characterType",
   "theme",
   "approvedCreditSpend"
  ],
  "type": "object"
 },
 "name": "create_story",
 "title": "Create a TaleSpinner Story"
}
