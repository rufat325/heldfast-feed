{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search sales invoices"
 },
 "description": "Find sales documents (\u0444\u0430\u043a\u0442\u0443\u0440\u0438, \u043f\u0440\u043e\u0444\u043e\u0440\u043c\u0438, \u0434\u0435\u0431\u0438\u0442\u043d\u0438/\u043a\u0440\u0435\u0434\u0438\u0442\u043d\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u0438\u044f) by period, customer, type or number. Pass `number` to get one document in full, including its lines. Without document_type, proformas are excluded.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "customer_eik": {
    "type": "string"
   },
   "customer_name": {
    "type": "string"
   },
   "customer_vat_number": {
    "type": "string"
   },
   "date_from": {
    "description": "Start of period (YYYY-MM-DD), by date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "description": "End of period (YYYY-MM-DD), inclusive",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "document_type": {
    "enum": [
     "invoice",
     "proforma",
     "debit_note",
     "credit_note"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max records to return from the page (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "number": {
    "description": "Exact document number; returns that document in full, with its lines",
    "pattern": "^\\d{1,10}$",
    "type": "string"
   },
   "page": {
    "description": "Page number, starting at 1",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "response_format": {
    "description": "\"concise\" (default) returns key fields; \"detailed\" adds lines and the raw nula.bg record",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "nula_search_invoices",
 "title": "Search sales invoices"
}
