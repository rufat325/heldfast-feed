{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a scheduled report (pulse) that sends dashboards/questions on a schedule",
 "inputSchema": {
  "properties": {
   "cards": {
    "description": "Cards to include in the pulse",
    "items": {
     "properties": {
      "id": {
       "type": "number"
      },
      "include_csv": {
       "type": "boolean"
      },
      "include_xls": {
       "type": "boolean"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "channels": {
    "description": "Delivery channels (email/slack)",
    "items": {
     "properties": {
      "channel_type": {
       "type": "string"
      },
      "recipients": {
       "type": "array"
      },
      "schedule_day": {
       "type": "string"
      },
      "schedule_hour": {
       "type": "number"
      },
      "schedule_type": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "collection_id": {
    "description": "Collection to save pulse in",
    "type": "number"
   },
   "name": {
    "description": "Pulse name",
    "type": "string"
   },
   "skip_if_empty": {
    "default": true,
    "description": "Skip sending if no results",
    "type": "boolean"
   }
  },
  "required": [
   "name",
   "cards",
   "channels"
  ],
  "type": "object"
 },
 "name": "mb_pulse_create",
 "title": "Create Pulse"
}
