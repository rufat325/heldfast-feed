  "title": "Rank countries by climate and disaster risk"
 },
 "description": "The countries most or least at climate and disaster risk, overall or on one dimension (climate, nature, social, governance, adaptation), each with its score, risk class and rank, optionally only those in a region, subregion or income group.\n\nAnswers \"which countries are most exposed to climate risk\", \"the riskiest countries in Southern Asia\" or \"low-income countries with the lowest adaptation score\". For countries named in advance use compare_countries; for one country in depth, get_country_profile.\n\nRegions, subregions and income groups are named as the countries' meta names them; a name no country has is refused with the names there are. The filters combine, and a combination that matches nothing returns an empty list; limit cuts the list, while matched counts every country that passed the filters. Scores run 0 to 100, higher is riskier. A country's rank is among all 194 countries, 1 being the highest risk: a filter narrows the list but not the rank. Countries without a score on the dimension are counted in no_score.",
 "inputSchema": {
  "properties": {
   "dimension": {
    "default": "overall",
    "description": "The score to rank by",
    "enum": [
     "overall",
     "climate",
     "nature",
     "social",
     "governance",
     "adaptation"
    ],
    "title": "Dimension",
    "type": "string"
   },
   "income_group": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only countries in this World Bank income group, e.g. Low income",
    "title": "Income Group"
   },
   "limit": {
    "default": 10,
    "description": "How many countries to list",
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "order": {
    "default": "highest_risk",
    "description": "Most at risk first, or least at risk first",
    "enum": [
     "highest_risk",
     "lowest_risk"
    ],
    "title": "Order",
    "type": "string"
   },
   "region": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only countries in this UN region, e.g. Asia",
    "title": "Region"
   },
   "subregion": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only countries in this UN M49 subregion, e.g. Southern Asia",
    "title": "Subregion"
   }
  },
  "title": "rank_countriesArguments",
  "type": "object"
 },
