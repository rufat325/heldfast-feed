{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decision Import"
 },
 "description": "Mine local git history and decision-bearing Markdown into provenance-tagged Decision Graph extraction prompts. Imported history remains review-only until decision_commit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "doc_globs": {
    "default": [
     "docs/adr/**/*.md",
     "docs/decisions/**/*.md",
     "docs/decision*/*.md",
     "DECISIONS.md",
     "DESIGN.md",
     "figma-comments-archive/**/*.md"
    ],
    "description": "Repository-relative Markdown globs. Supports * and **.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   },
   "max_chunk_chars": {
    "default": 24000,
    "description": "Maximum material characters per extraction chunk. Oversized single items are continuation-split (cap 60000).",
    "maximum": 60000,
    "minimum": 1,
    "type": "integer"
   },
   "max_commits": {
    "default": 200,
    "description": "Maximum git commits to inspect (cap 1000).",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "repo_path": {
    "description": "Local repository directory to inspect.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "repo_path"
  ],
  "type": "object"
 },
 "name": "decision_import"
}
