{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Analyze a hard-to-identify or hard-to-source part problem before purchase. Returns cautious identity clues, function, missing evidence, search lanes, safety gate and a recommended hunt tier. Does not create a charge.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_info": {
    "maxLength": 2500,
    "type": "string"
   },
   "domain": {
    "enum": [
     "AUTO",
     "HEAVY",
     "AG",
     "INDUSTRIAL",
     "CONSTRUCTION",
     "MARINE",
     "ELECTRONICS",
     "APPLIANCE",
     "POWERSPORTS",
     "AEROSPACE",
     "OTHER"
    ],
    "type": "string"
   },
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "location": {
    "maxLength": 240,
    "type": "string"
   },
   "part_description": {
    "maxLength": 5000,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "part_description"
  ],
  "type": "object"
 },
 "name": "free_part_triage",
 "title": "Build a free FindMyPart Part Passport"
}
