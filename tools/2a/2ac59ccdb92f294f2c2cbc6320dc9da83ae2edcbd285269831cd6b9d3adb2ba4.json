  "properties": {
   "idea": {
    "description": "A product idea in one sentence (\"an app that turns meeting notes into tasks\"), a product name (\"Notion\") or a website (\"notion.so\" or \"https://notion.so\"). Up to 300 characters.",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "idea"
  ],
  "type": "object"
 },
