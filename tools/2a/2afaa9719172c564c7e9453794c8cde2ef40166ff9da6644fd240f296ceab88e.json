{
 "annotations": {
  "destructiveHint": true,
  "title": "Create deal"
 },
 "description": "Create a new deal. `title` is required; link it to a person/org/pipeline/stage/owner as needed. Pipedrive REST: POST /api/v2/deals.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "description": "Currency code for `value`, e.g. 'USD'.",
    "type": "string"
   },
   "expected_close_date": {
    "description": "Expected close date, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "org_id": {
    "description": "Link to this organization id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "owner_id": {
    "description": "Assign to this owner (user) id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "person_id": {
    "description": "Link to this person id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "pipeline_id": {
    "description": "Place in this pipeline id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "stage_id": {
    "description": "Place in this stage id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "Deal status \u2014 'open' (default), 'won' or 'lost'.",
    "enum": [
     "open",
     "won",
     "lost"
    ],
    "type": "string"
   },
   "title": {
    "description": "Deal title (required).",
    "minLength": 1,
    "type": "string"
   },
   "value": {
    "description": "Deal monetary value.",
    "type": "number"
   },
   "visible_to": {
    "description": "Visibility group id (Pipedrive visibility setting).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "pipedrive_create_deal",
 "title": "Create deal"
}
