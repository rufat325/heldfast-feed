  "title": "Time zones + date math"
 },
 "description": "Current time in any time zones, convert a time between zones (DST-correct), and date arithmetic: add/subtract durations, days between dates, weekday, ISO week, Unix time. Computed locally from the IANA time-zone database \u2014 no rate limits, exact. Zones are IANA names (America/New_York, Asia/Tokyo, UTC). Price: free. Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "add": {
    "description": "e.g. \"+3d 4h\", \"-90m\", \"+2w\"",
    "type": "string"
   },
   "from_tz": {
    "default": "UTC",
    "description": "IANA time zone the input time is in, e.g. \"America/New_York\". Default \"UTC\".",
    "type": "string"
   },
   "time": {
    "description": "ISO time, \"now\", or a Unix timestamp; naive times are read in from_tz",
    "type": "string"
   },
   "to_tz": {
    "default": [
     "UTC"
    ],
    "description": "IANA time zones to convert into. 0-20 items. Default [\"UTC\"].",
    "items": {
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "until": {
    "description": "second ISO date: returns the difference",
    "type": "string"
   }
  },
  "type": "object"
 },
