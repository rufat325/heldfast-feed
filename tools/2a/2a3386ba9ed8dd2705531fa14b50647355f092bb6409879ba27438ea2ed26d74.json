{
 "description": "Build + sign + submit in one step. Requires TRADEROUTER_PRIVATE_KEY.",
 "inputSchema": {
  "properties": {
   "action": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "amount": {
    "type": "integer"
   },
   "holdings_percentage": {
    "type": "integer"
   },
   "slippage": {
    "default": 1500,
    "maximum": 2500,
    "minimum": 100,
    "type": "integer"
   },
   "token_address": {
    "type": "string"
   },
   "wallet_address": {
    "type": "string"
   }
  },
  "required": [
   "wallet_address",
   "token_address",
   "action"
  ],
  "type": "object"
 },
 "name": "auto_swap"
}
