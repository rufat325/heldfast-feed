 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Start Guided Page Onboarding"
 },
 "description": "Guided visual setup (category, layout, palette, primary action) that does NOT create a page. Use it ONLY when the user explicitly wants to choose the style/layout step by step; for normal requests call page_create_from_brief (asking at most one round of questions first). IMPORTANT: this flow is STATELESS \u2014 page_onboarding_update does not remember earlier calls, so each update must resend the FULL set of selections + knownFields gathered so far. As soon as you have a business name and a primary action, stop and call page_create_from_brief (you do not need to reach a 'ready' step).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "locale": {
    "description": "Preferred UI locale: en or es. If omitted, Spanish is used only when originalRequest is clearly Spanish; otherwise English. The result echoes the resolved locale \u2014 pass it on every page_onboarding_update call.",
    "type": "string"
   },
   "originalRequest": {
    "maxLength": 12000,
    "type": "string"
   },
   "suggestedSelection": {
    "additionalProperties": false,
    "properties": {
     "confidence": {
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     },
     "mainCategory": {
      "description": "Normalized id from the AI client, for example physical-business or online-business. The app does not infer this from raw text.",
      "type": "string"
     },
     "source": {
      "enum": [
       "user_agent_inference",
       "user_selected",
       "imported_source"
      ],
      "type": "string"
     },
     "subCategory": {
      "description": "Normalized subcategory id valid for the selected mainCategory, for example health.",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
