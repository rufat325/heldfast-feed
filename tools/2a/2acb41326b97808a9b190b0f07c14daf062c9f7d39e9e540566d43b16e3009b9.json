{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "marketbrew:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when a team member asks for current Google search results for a keyword. This makes one billable DataForSEO request with a depth of 10.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keyword": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "languageCode": {
    "default": "en",
    "description": "Two-letter language code.",
    "pattern": "^[a-z]{2}$",
    "type": "string"
   },
   "locationCode": {
    "default": 2840,
    "description": "DataForSEO location code; defaults to United States.",
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "dataforseo_google_serp",
 "title": "Get a live Google SERP from DataForSEO"
}
