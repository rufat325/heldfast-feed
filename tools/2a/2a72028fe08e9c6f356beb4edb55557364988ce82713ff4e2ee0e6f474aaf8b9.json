 "description": "Trace a bounded film or television public-record rights dossier when an agent needs more than candidate lookup. Resolve the work, reconcile maintained Copyright Office evidence, build only source-supported relationships, and return provenance, ambiguity, and bounded freshness. $0.50 per completed authorized invocation. For candidate lookup or free applicability evaluation, use filmrightsproof.search_public_records instead. Not legal clearance, definitive ownership, exhaustive chain of title, or private-contract analysis.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "Identify a film, television title, or underlying creative work for bounded U.S. Copyright Office public-record research. Title is required; creator, year, and workType are disambiguation hints; limit only bounds returned or inspected candidates.",
  "examples": [
   {
    "limit": 10,
    "title": "The Godfather",
    "workType": "motion picture",
    "year": 1972
   },
   {
    "creator": "Frank Herbert",
    "limit": 10,
    "title": "Dune",
    "workType": "book"
   }
  ],
  "properties": {
   "creator": {
    "description": "Optional creator, author, writer, director, producer, or other credited name used to disambiguate similarly titled works.",
    "examples": [
     "Francis Ford Coppola"
    ],
    "maxLength": 300,
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of candidate public-record matches to return or inspect.",
    "examples": [
     10
    ],
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "title": {
    "description": "Film, television, or underlying creative-work title to search in U.S. Copyright Office public records.",
    "examples": [
     "The Godfather"
    ],
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "workType": {
    "description": "Optional work-type hint, such as motion picture, television, screenplay, book, or other underlying creative work.",
    "examples": [
     "motion picture"
    ],
    "maxLength": 120,
    "type": "string"
   },
   "year": {
    "description": "Optional release, publication, creation, or registration year used to narrow candidate matches.",
    "examples": [
     1972
    ],
    "maximum": 2100,
    "minimum": 1700,
    "type": "integer"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
