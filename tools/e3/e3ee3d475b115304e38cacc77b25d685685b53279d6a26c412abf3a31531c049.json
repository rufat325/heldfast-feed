{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update fields of an existing entry. Only the fields you pass are changed. Setting status back to draft unpublishes the entry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Entry body in Markdown",
    "type": "string"
   },
   "entry_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "project_id": {
    "description": "The project id (ULID)",
    "type": "string"
   },
   "published_at": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "published"
    ],
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "type": "string"
   },
   "type": {
    "enum": [
     "feature",
     "fix",
     "improvement",
     "security"
    ],
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "entry_id"
  ],
  "type": "object"
 },
 "name": "update_entry",
 "title": "Update a changelog entry"
}
