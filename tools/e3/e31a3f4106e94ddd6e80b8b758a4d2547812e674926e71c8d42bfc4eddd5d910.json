{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Lists the user's projects from their local projects file: each project's id, name and members (a repository key, optionally narrowed to a path inside it and branch patterns). A turn counts in at most one project, the most specific matching member. Use it to pick a `projectId` for list_repositories or list_sessions; `problems` lists what is wrong with the file, if anything. Client names and billing codes are not shared here; a statement (get_statement) has them.","inputSchema":{"properties":{},"type":"object"},"name":"list_projects","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"problems":{"items":{"additionalProperties":false,"properties":{"message":{"type":"string"},"path":{"type":"string"}},"required":["path","message"],"type":"object"},"type":"array"},"projects":{"items":{"additionalProperties":false,"properties":{"billingCode":{"minLength":1,"type":"string"},"client":{"minLength":1,"type":"string"},"id":{"pattern":"^[a-z0-9][a-z0-9-]{0,63}$","type":"string"},"members":{"items":{"additionalProperties":false,"properties":{"branches":{"items":{"minLength":1,"type":"string"},"minItems":1,"type":"array"},"path":{"minLength":1,"type":"string"},"repository":{"minLength":1,"type":"string"}},"required":["repository"],"type":"object"},"minItems":1,"type":"array"},"name":{"minLength":1,"type":"string"}},"required":["id","name","members"],"type":"object"},"type":"array"},"reason":{"type":"string"},"status":{"enum":["missing","valid","invalid"],"type":"string"}},"required":["status","projects","problems"],"type":"object"},"title":"List projects"}
