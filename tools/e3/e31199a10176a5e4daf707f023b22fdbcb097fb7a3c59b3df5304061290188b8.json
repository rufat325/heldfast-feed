{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "read:library"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search your Library"
 },
 "description": "Search owned Library content (pictures, videos, audio), or look one item up by assetId. Needs read:library. Free; changes nothing and debits no customer credits.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assetId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "clip",
     "audio",
     "brand_asset",
     "edit",
     "image",
     "video",
     "ai_image",
     "ai_video"
    ],
    "type": "string"
   },
   "limit": {
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "maxLength": 100,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "soclo_library_find",
 "title": "Search your Library"
}
