{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Export 1-10 log files of an instance to Object Storage (POST \u2026/logs/export \u2192 202 Operation). Requires an Object Storage subscription.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Destination bucket",
    "type": "string"
   },
   "clusterName": {
    "description": "Cluster name (3-30 chars, lowercase letters/digits/'-', no leading or trailing '-'; immutable after creation)",
    "pattern": "^[a-z0-9][a-z0-9-]{1,28}[a-z0-9]$",
    "type": "string"
   },
   "instanceName": {
    "description": "Instance name ({clusterName}-{suffix}, from ncloud_serverless_list_instances)",
    "pattern": "^[a-z0-9-]{3,39}$",
    "type": "string"
   },
   "logs": {
    "description": "Log files to export (1-10)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "logType": {
       "enum": [
        "BIN",
        "SLOW_QUERY",
        "ERROR",
        "GENERAL"
       ],
       "type": "string"
      },
      "name": {
       "description": "Log file name (e.g. slow-query.log.1)",
       "type": "string"
      }
     },
     "required": [
      "name",
      "logType"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "uploadPath": {
    "description": "Path inside the bucket (default root, e.g. logs/2026)",
    "type": "string"
   }
  },
  "required": [
   "clusterName",
   "instanceName",
   "logs",
   "bucketName"
  ],
  "type": "object"
 },
 "name": "ncloud_serverless_export_logs"
}
