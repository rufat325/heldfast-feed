{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Configure OIDC (OpenID Connect) authentication for an NKS cluster",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clientId": {
    "description": "OIDC provider Client ID",
    "type": "string"
   },
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "groupsClaim": {
    "description": "JWT claim for groups",
    "type": "string"
   },
   "groupsPrefix": {
    "description": "Prefix for groups claim",
    "type": "string"
   },
   "issuerURL": {
    "description": "OIDC provider URL",
    "type": "string"
   },
   "requiredClaim": {
    "description": "Required claim as key=value pair",
    "type": "string"
   },
   "status": {
    "description": "OIDC activation status (true=enable, false=disable)",
    "type": "boolean"
   },
   "usernameClaim": {
    "description": "JWT claim for username",
    "type": "string"
   },
   "usernamePrefix": {
    "description": "Prefix for username claim",
    "type": "string"
   }
  },
  "required": [
   "clusterUuid",
   "status",
   "clientId",
   "issuerURL"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_set_oidc"
}
