 "description": "Per-persona StoryBrand arguments for each product. The persona \u00d7 goal argument layer (SB7-shaped). Stable ?id is globally exact; ?product + ?persona + ?variant selects one exact scoped variant, while ?variant alone remains a compatible filter. Live is the default; ?status=draft|all opts into authoring records with capability readiness kept separate.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Select one stable BrandScript id exactly.",
    "type": "string"
   },
   "persona": {
    "description": "Filter to one persona slug.",
    "type": "string"
   },
   "product": {
    "description": "Filter to one product's arguments.",
    "type": "string"
   },
   "status": {
    "description": "live (default) | draft | all.",
    "enum": [
     "live",
     "draft",
     "all"
    ],
    "type": "string"
   },
   "variant": {
    "description": "Stable goal variant scoped to product + persona; use all three to select exactly.",
    "type": "string"
   }
  },
  "type": "object"
 },
