{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List Secret References"
 },
 "description": "List Secret References without returning authentication configuration or resolved secret values. Filter by manager type, tags, or name and use a returned UUID or slug with get_secret_reference.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "current_page": {
    "description": "Zero-based page number; defaults to 0",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "manager_type": {
    "description": "Filter by external secret manager: aws_sm, azure_kv, or hashicorp_vault",
    "enum": [
     "aws_sm",
     "azure_kv",
     "hashicorp_vault"
    ],
    "type": "string"
   },
   "page_size": {
    "description": "References per page, from 1 to 100; defaults to 20",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "search": {
    "description": "Search references by name",
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Return references matching these tags",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "list_secret_references",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "description": "Structured success payload when ok is true",
    "properties": {
     "secret_references": {
      "description": "Current page of Secret References without authentication values",
      "items": {
       "additionalProperties": false,
       "properties": {
        "created_at": {
         "description": "ISO 8601 creation timestamp",
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
         "type": "string"
        },
        "id": {
         "description": "Secret Reference UUID",
         "format": "uuid",
         "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
         "type": "string"
        },
        "last_updated_at": {
         "description": "ISO 8601 last-update timestamp",
         "format": "date-time",
         "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
         "type": "string"
        },
        "manager_type": {
         "description": "External secret manager type",
         "enum": [
          "aws_sm",
          "azure_kv",
          "hashicorp_vault"
         ],
         "type": "string"
        },
        "name": {
         "description": "Human-readable name",
         "type": "string"
        },
        "slug": {
         "description": "Stable Secret Reference slug",
         "type": "string"
        },
        "status": {
         "const": "ACTIVE",
         "description": "Current reference status",
         "type": "string"
        }
       },
       "required": [
        "id",
        "name",
        "slug",
        "manager_type",
        "status",
        "created_at",
        "last_updated_at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "total": {
      "description": "Total matching references",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "total",
     "secret_references"
    ],
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
