{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a product with options, variants and images, and optionally add it to a manual collection. Defaults to status DRAFT and to dryRun:true, which previews the input without creating anything.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "collectionId": {
    "pattern": "^gid:\\/\\/shopify\\/Collection\\/[0-9]+$",
    "type": "string"
   },
   "descriptionHtml": {
    "maxLength": 50000,
    "type": "string"
   },
   "dryRun": {
    "default": true,
    "description": "True (the default) returns a before/after preview without changing anything in Shopify. Pass false, after the user authorizes this store and exact change, to apply it; the tool then reads the result back.",
    "type": "boolean"
   },
   "images": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "altText": {
       "maxLength": 1000,
       "type": "string"
      },
      "url": {
       "format": "starts_with",
       "pattern": "^https:\\/\\/.*",
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "options": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "price": {
    "pattern": "^\\d+(\\.\\d{1,4})?$",
    "type": "string"
   },
   "productType": {
    "type": "string"
   },
   "status": {
    "default": "DRAFT",
    "enum": [
     "ACTIVE",
     "DRAFT",
     "ARCHIVED"
    ],
    "type": "string"
   },
   "store": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "maxItems": 250,
    "type": "array"
   },
   "title": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "variants": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "inventoryItem": {
       "additionalProperties": false,
       "properties": {
        "tracked": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "optionValues": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "minLength": 1,
          "type": "string"
         },
         "optionName": {
          "minLength": 1,
          "type": "string"
         }
        },
        "required": [
         "optionName",
         "name"
        ],
        "type": "object"
       },
       "maxItems": 3,
       "minItems": 1,
       "type": "array"
      },
      "price": {
       "pattern": "^\\d+(\\.\\d{1,4})?$",
       "type": "string"
      },
      "sku": {
       "type": "string"
      }
     },
     "required": [
      "price"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "vendor": {
    "type": "string"
   }
  },
  "required": [
   "store",
   "title"
  ],
  "type": "object"
 },
 "name": "shopify_create_product"
}
