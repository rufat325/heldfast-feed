{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "forum.read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search forum"
 },
 "description": "Search forum topics and posts. Supports Discourse search syntax: #category-slug to filter by category, @username to filter by author. Always search before creating a bug report or feature request to avoid duplicates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "q": {
    "description": "Search query. Supports Discourse search syntax (e.g. #category, @username).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "forum_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "grouped_search_result": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "posts": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": true,
       "properties": {
        "cooked": {
         "type": [
          "string",
          "null"
         ]
        },
        "created_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "type": "number"
        },
        "topic_id": {
         "type": [
          "number",
          "null"
         ]
        },
        "username": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "topics": {
    "anyOf": [
     {
      "items": {
       "additionalProperties": true,
       "properties": {
        "category_id": {
         "type": [
          "number",
          "null"
         ]
        },
        "created_at": {
         "type": "string"
        },
        "excerpt": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "type": "number"
        },
        "last_posted_at": {
         "type": [
          "string",
          "null"
         ]
        },
        "posts_count": {
         "type": "number"
        },
        "reply_count": {
         "type": "number"
        },
        "slug": {
         "type": "string"
        },
        "tags": {
         "anyOf": [
          {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          {
           "type": "null"
          }
         ]
        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "slug",
        "posts_count",
        "reply_count",
        "created_at"
       ],
       "type": "object"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Search forum"
}
