{
 "description": "Run N 1C OData queries in parallel (1..50). Each query reported individually. No server-side join (1C does not support $batch) \u2014 combine results client-side.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "concurrency": {
    "default": 5,
    "description": "Max parallel HTTP requests. Default 5.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "queries": {
    "description": "Array of OData GET specs (1..50). Each runs as a separate HTTP request.",
    "items": {
     "properties": {
      "entity": {
       "description": "OData entity (e.g. Catalog_\u041d\u043e\u043c\u0435\u043d\u043a\u043b\u0430\u0442\u0443\u0440\u0430).",
       "type": "string"
      },
      "expand": {
       "description": "$expand clause.",
       "type": "string"
      },
      "filter": {
       "description": "$filter clause.",
       "type": "string"
      },
      "orderby": {
       "type": "string"
      },
      "select": {
       "description": "$select clause.",
       "type": "string"
      },
      "skip": {
       "default": 0,
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "top": {
       "default": 100,
       "maximum": 5000,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "entity"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "queries"
  ],
  "type": "object"
 },
 "name": "batch_query"
}
