{
 "annotations": {
  "destructiveHint": true,
  "title": "Create or update a category"
 },
 "description": "Create an item category, or rename/recolor one by passing its `id`. Loyverse: POST /categories.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "color": {
    "description": "Display color on the POS.",
    "enum": [
     "GREY",
     "RED",
     "PINK",
     "ORANGE",
     "GREEN",
     "BLUE",
     "PURPLE"
    ],
    "type": "string"
   },
   "id": {
    "description": "Existing category id to update. Omit to create.",
    "type": "string"
   },
   "name": {
    "description": "The category name (required).",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "loyverse_upsert_category",
 "title": "Create or update a category"
}
