{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update per-video config (POST /player?type=video). Send only fields you want to change.\nFields: chapters, default_subtitle, redirect_video_id, custom_pixels, on_funnel, panda_branding, questions (AI quiz), mindmap (AI), abstract (AI ebook), retention_markers, ai.\nNOT for: controls, autoplay, Smart Autoplay, colors, speed, big play button, save progress \u2014 use panda_update_profile for those.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "abstract": {
    "description": "Enable/disable AI eBook/Abstract feature",
    "type": "boolean"
   },
   "ai": {
    "additionalProperties": {},
    "description": "AI configuration object (search, tutor settings)",
    "type": "object"
   },
   "chapters": {
    "description": "Chapters/bookmarks. Send [] to remove all.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "time": {
       "description": "Position in seconds (e.g. 0 for beginning, 60 for 1min)",
       "type": "number"
      },
      "title": {
       "description": "Chapter title",
       "type": "string"
      }
     },
     "required": [
      "title",
      "time"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "custom_pixels": {
    "description": "Array of custom pixel objects (fbPixel, gtagIds, custom script)",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "default_subtitle": {
    "description": "Default subtitle language code (e.g. 'pt-BR', 'en') or 'false' to disable",
    "type": "string"
   },
   "mindmap": {
    "description": "Enable/disable AI MindMap feature",
    "type": "boolean"
   },
   "on_funnel": {
    "description": "Enable/disable funnel integration",
    "type": "boolean"
   },
   "panda_branding": {
    "description": "Show/hide Panda logo branding on player",
    "type": "boolean"
   },
   "questions": {
    "description": "Enable/disable AI Quiz feature",
    "type": "boolean"
   },
   "redirect_video_id": {
    "description": "Video ID to redirect to at end, or null to remove redirect",
    "type": [
     "string",
     "null"
    ]
   },
   "retention_markers": {
    "description": "Retention markers (pitch points) for analytics",
    "items": {
     "additionalProperties": false,
     "properties": {
      "time": {
       "description": "Position in seconds",
       "type": "number"
      },
      "title": {
       "description": "Marker label",
       "type": "string"
      },
      "type": {
       "description": "Marker type",
       "enum": [
        "pitch",
        "custom"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "time"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "video_id": {
    "description": "Video ID",
    "type": "string"
   }
  },
  "required": [
   "video_id"
  ],
  "type": "object"
 },
 "name": "panda_update_video_config",
 "title": "Update Video Config"
}
