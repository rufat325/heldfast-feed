  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the currently displayed settled public Spotlight, including labeled house advertisements. Does not bid or pay.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "includeHouseAds": {
    "default": true,
    "description": "When false, a current house advertisement is reported as unavailable instead of returned.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "get_current_spotlight",
 "outputSchema": {
  "anyOf": [
   {
    "properties": {
     "data": {
      "additionalProperties": false,
      "properties": {
       "advertiser": {
        "type": "string"
       },
       "canonicalUrl": {
        "format": "uri",
        "type": "string"
       },
       "contentType": {
        "enum": [
         "paid_advertisement",
         "house_advertisement"
        ],
        "type": "string"
       },
       "day": {
        "description": "Settled auction date in UTC, YYYY-MM-DD.",
        "format": "date",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "headline": {
        "type": "string"
       }
      },
      "required": [
       "day",
       "headline",
       "description",
       "advertiser",
       "canonicalUrl",
       "contentType"
      ],
      "type": "object"
     }
    },
    "required": [
     "data"
    ],
    "type": "object"
   },
   {
    "properties": {
     "detail": {
      "type": "string"
     },
     "docs": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "type": "integer"
     },
     "title": {
      "type": "string"
     },
     "type": {
      "type": "string"
     }
    },
    "required": [
     "type",
     "title",
     "status",
     "detail"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Get current Spotlight"
}
