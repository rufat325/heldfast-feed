  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "path": {
    "enum": [
     "APPLICATION_PATH_WARM_FORMATION",
     "APPLICATION_PATH_COLD_MANUAL"
    ],
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
