{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List SWSD time entries for an incident, problem, change, or release. Use this before adding/updating time when you need existing work-log context.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "description": "Parent record id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "object_type": {
    "description": "Parent SWSD object type.",
    "enum": [
     "incidents",
     "problems",
     "changes",
     "releases"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 25,
    "description": "Results per page (1-100). SWSD caps at 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "object_type",
   "id"
  ],
  "type": "object"
 },
 "name": "swsd_list_time_tracks",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "True when more pages exist beyond this one.",
      "type": "boolean"
     },
     "next_page": {
      "description": "The next page number to request, when has_more is true.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "description": "Current page (1-indexed).",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "per_page": {
      "description": "Items per page used in the request.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "description": "Total record count when SWSD returns X-Total-Count.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "per_page",
     "has_more"
    ],
    "type": "object"
   },
   "time_tracks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "created_at": {
       "type": "string"
      },
      "creator": {
       "additionalProperties": false,
       "properties": {
        "email": {
         "type": "string"
        },
        "id": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "minutes_parsed": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "time_tracks",
   "pagination"
  ],
  "type": "object"
 }
}
