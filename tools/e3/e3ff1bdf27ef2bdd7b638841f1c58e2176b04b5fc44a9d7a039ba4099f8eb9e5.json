{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tutorializer:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a voiceover line"
 },
 "description": "Use this when someone wants new narration or voiceover in a project. Returns the new line's id, language, voice and audio URL. Without url the audio is synthesized from the text with the project's voice provider, spending the organization's synthesis credits; with url it records audio you already have. Not for fixing an existing line.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "Language code of the narration, e.g. en or pt-BR",
    "maxLength": 32,
    "minLength": 2,
    "type": "string"
   },
   "projectId": {
    "description": "Project the voiceover line belongs to",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "text": {
    "description": "Words to speak, up to 5000 characters",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "translatedText": {
    "description": "Optional translation spoken instead of the source text",
    "maxLength": 5000,
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Public https URL of audio you already produced. Supplying it records the segment without synthesizing anything.",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   },
   "voice": {
    "description": "Optional voice id; defaults to the project's default voice",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "text",
   "language"
  ],
  "type": "object"
 },
 "name": "create_speech",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "speech": {
    "additionalProperties": false,
    "properties": {
     "creationTime": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "duration": {
      "anyOf": [
       {
        "maximum": 86400,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "language": {
      "anyOf": [
       {
        "maxLength": 32,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "lastEditTime": {
      "anyOf": [
       {
        "maxLength": 64,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "projectId": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "textPreview": {
      "anyOf": [
       {
        "maxLength": 5000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "url": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "voice": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "projectId",
     "language",
     "voice",
     "url",
     "duration",
     "textPreview",
     "creationTime",
     "lastEditTime"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "created",
     "recorded"
    ],
    "type": "string"
   },
   "synthesized": {
    "description": "True when audio was synthesized and synthesis credits were spent; false when a url was recorded",
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "synthesized",
   "speech"
  ],
  "type": "object"
 },
 "title": "Create a voiceover line"
}
