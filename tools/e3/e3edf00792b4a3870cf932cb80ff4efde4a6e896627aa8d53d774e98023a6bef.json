{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Create one or more precise freehand strokes as a single undoable composition. A stroke accepts arbitrary chart points; line accepts two endpoints; ellipse and rectangle accept two opposite corners and are generated smoothly. Use highlighter for translucent emphasis and brush for circles, paths and marks. Changes the chart you are building; finish with chart_link, or analysis_prepare for a sharing draft that needs human review.","inputSchema":{"properties":{"arrowEnd":{"type":"boolean"},"arrowStart":{"type":"boolean"},"color":{"description":"A palette name. \u201cup\u201d and \u201cdown\u201d are the reserved green and red \u2014 they assert a bullish or bearish claim, so use them for position zones and not for a measurement.","enum":["blue","orange","violet","aqua","yellow","magenta","neutral","white","up","down"],"type":"string"},"extendLeft":{"type":"boolean"},"extendRight":{"type":"boolean"},"fill":{"description":"Palette fill colour, or \u201cnone\u201d.","type":"string"},"fillOpacity":{"description":"Shape fill opacity from 0 to 1.","type":"number"},"fontSize":{"description":"Label/text size from 8 to 28.","type":"number"},"labelPosition":{"enum":["left","center","right"],"type":"string"},"labelVertical":{"enum":["above","middle","below"],"type":"string"},"lineStyle":{"enum":["solid","dashed","dotted"],"type":"string"},"mode":{"enum":["brush","highlighter"],"type":"string"},"opacity":{"description":"Strength of the whole drawing, 0.1 to 1. Fade a level that is context rather than the decision.","type":"number"},"ratioFormat":{"enum":["value","percent"],"type":"string"},"ref":{"type":"string"},"showLabels":{"type":"boolean"},"showPrices":{"type":"boolean"},"showRatios":{"type":"boolean"},"showStats":{"type":"boolean"},"strokes":{"items":{"properties":{"points":{"items":{"properties":{"price":{"type":"number"},"time":{"type":"number"}},"required":["time","price"],"type":"object"},"type":"array"},"shape":{"enum":["stroke","line","ellipse","rectangle"],"type":"string"}},"required":["shape","points"],"type":"object"},"type":"array"},"symbol":{"type":"string"},"text":{"description":"Text for annotation tools.","type":"string"},"textBold":{"type":"boolean"},"textColor":{"enum":["blue","orange","violet","aqua","yellow","magenta","neutral","white","up","down"],"type":"string"},"width":{"description":"Stroke width in pixels, 1 to 6.","type":"number"}},"required":["strokes"],"type":"object"},"name":"drawing_freehand"}
