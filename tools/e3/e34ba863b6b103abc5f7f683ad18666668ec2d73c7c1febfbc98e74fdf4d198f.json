{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Draft a blog post with AI"
 },
 "description": "Use this when someone asks you to write a new blog post on a topic or saved topic idea. Returns the draft's id, URL, title, word count and internal links (text only; published only with autoPublish). It uses paid AI and can take about a minute, and a call that times out can still save the draft. Not for saving your own text.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoPublish": {
    "description": "true publishes the post immediately; defaults to false, a draft",
    "type": "boolean"
   },
   "blogId": {
    "description": "Blog to write for",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Language of the post, an ISO 639-1 code; defaults to the blog's default locale",
    "maxLength": 50,
    "type": "string"
   },
   "persist": {
    "description": "false returns a preview without saving anything; defaults to true",
    "type": "boolean"
   },
   "sitemapMaxUrls": {
    "description": "How many sitemap URLs to offer as internal links, from 1 to 500; defaults to 150",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "topic": {
    "additionalProperties": false,
    "description": "Title and optional angle to write about; omit when topicIdeaId is given",
    "properties": {
     "angle": {
      "description": "One-line angle / framing for the article",
      "maxLength": 500,
      "type": "string"
     },
     "title": {
      "description": "Article topic title",
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "title"
    ],
    "type": "object"
   },
   "topicIdeaId": {
    "description": "Saved topic idea to write about; omit when topic is given",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "blogId"
  ],
  "type": "object"
 },
 "name": "generate_article",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "article": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "imageGeneration": {
      "const": "disabled",
      "type": "string"
     },
     "internalLinksDropped": {
      "$ref": "#/properties/article/properties/wordCount/anyOf/0"
     },
     "internalLinksKept": {
      "$ref": "#/properties/article/properties/wordCount/anyOf/0"
     },
     "locale": {
      "anyOf": [
       {
        "maxLength": 50,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "published": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "slug": {
      "anyOf": [
       {
        "maxLength": 300,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "title": {
      "anyOf": [
       {
        "maxLength": 300,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "url": {
      "anyOf": [
       {
        "maxLength": 2048,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "wordCount": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "id",
     "url",
     "title",
     "slug",
     "locale",
     "wordCount",
     "internalLinksKept",
     "internalLinksDropped",
     "imageGeneration",
     "published"
    ],
    "type": "object"
   },
   "status": {
    "const": "generated",
    "type": "string"
   }
  },
  "required": [
   "status",
   "article"
  ],
  "type": "object"
 },
 "title": "Draft a blog post with AI"
}
