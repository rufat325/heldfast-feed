{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Rank the open jobs at up to 3 companies for a person's profile. Use it when the user wants to know which jobs suit them, for questions like \"which of these jobs fit a senior backend engineer with 7 years of Go?\". Pass companies and the profile the user gave: targetTitles, and where known recentTitles, level, yearsExperience, skills, locations and openToRemote. Every posting is scored on title, level, location and then, for the best ones, skills and years asked. Returns the jobs ranked with a score, a level-fit verdict (match, step_up, stretch, step_down), the reasons it fits and the gaps. A rule-based match to public postings, not a prediction of being hired. The profile is used only while the call runs.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "companies": {
    "description": "Company names or careers page links to rank jobs from. At most 3.",
    "items": {
     "maxLength": 300,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "level": {
    "description": "Their current level, if known. Otherwise it is read from recentTitles or yearsExperience.",
    "enum": [
     "intern",
     "entry",
     "mid",
     "senior",
     "lead",
     "staff",
     "principal",
     "manager",
     "director",
     "executive"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Most ranked jobs to return (default 10)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "locations": {
    "description": "Cities or countries they would work in, such as \"London\" or \"DE\". Up to 5.",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 0,
    "type": "array"
   },
   "openToRemote": {
    "description": "true if remote roles are fine, false to avoid them. Leave out if no preference.",
    "type": "boolean"
   },
   "recentTitles": {
    "description": "Titles of their most recent one or two roles; recruiters weigh these most.",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 2,
    "minItems": 0,
    "type": "array"
   },
   "skills": {
    "description": "Key skills and tools, such as \"Go\" or \"PostgreSQL\". Up to 30.",
    "items": {
     "maxLength": 40,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 30,
    "minItems": 0,
    "type": "array"
   },
   "targetTitles": {
    "description": "Job titles the person is aiming for, such as \"Backend Engineer\". 1 to 5.",
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "yearsExperience": {
    "description": "Years of relevant experience",
    "maximum": 60,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "companies",
   "targetTitles"
  ],
  "type": "object"
 },
 "name": "rank_jobs_for_profile",
 "outputSchema": {
  "properties": {
   "boards": {
    "items": {
     "properties": {
      "boardUrl": {
       "type": "string"
      },
      "company": {
       "type": "string"
      },
      "jobsOnBoard": {
       "type": "integer"
      },
      "message": {
       "type": "string"
      },
      "query": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "status": {
       "enum": [
        "ok",
        "not_found",
        "unavailable"
       ],
       "type": "string"
      }
     },
     "required": [
      "query",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "ranked": {
    "items": {
     "properties": {
      "applyUrl": {
       "type": "string"
      },
      "company": {
       "type": "string"
      },
      "fit": {
       "enum": [
        "strong",
        "possible",
        "weak"
       ],
       "type": "string"
      },
      "gaps": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "levelFit": {
       "properties": {
        "basis": {
         "type": "string"
        },
        "job": {
         "type": [
          "string",
          "null"
         ]
        },
        "verdict": {
         "enum": [
          "match",
          "step_up",
          "stretch",
          "step_down",
          "unknown"
         ],
         "type": "string"
        },
        "you": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "locations": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "rank": {
       "type": "integer"
      },
      "score": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "whyFit": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "workplace": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "rank",
      "title",
      "company",
      "applyUrl",
      "score",
      "fit",
      "levelFit",
      "whyFit",
      "gaps"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shortlisted": {
    "type": "integer"
   }
  },
  "required": [
   "ranked",
   "boards",
   "shortlisted",
   "notes"
  ],
  "type": "object"
 },
 "title": "Rank company jobs for profile"
}
