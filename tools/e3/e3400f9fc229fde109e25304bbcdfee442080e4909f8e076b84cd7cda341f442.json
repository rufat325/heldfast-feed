{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Generate robots.txt rules for AI crawlers from a policy: \"open\" (allow all), \"balanced\" (allow search and user-triggered fetchers, block bulk training crawlers) or \"block\" (block all). Optional per-bot overrides, allowed/blocked paths, sitemap and crawl delay. No network access.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allow_paths": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "crawl_delay": {
    "maximum": 60,
    "minimum": 1,
    "type": "integer"
   },
   "disallow_paths": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "overrides": {
    "additionalProperties": {
     "enum": [
      "allow",
      "block"
     ],
     "type": "string"
    },
    "description": "e.g. {\"GPTBot\":\"allow\",\"CCBot\":\"block\"}",
    "type": "object"
   },
   "policy": {
    "default": "balanced",
    "enum": [
     "open",
     "balanced",
     "block"
    ],
    "type": "string"
   },
   "site_url": {
    "type": "string"
   },
   "sitemap_url": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_ai_robots_txt",
 "title": "Generate robots.txt rules for AI crawlers"
}
