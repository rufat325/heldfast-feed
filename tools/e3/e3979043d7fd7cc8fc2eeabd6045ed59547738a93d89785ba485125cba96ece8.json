    "$ref": "#/properties/boxesToBuy"
   },
   "planksPerBox": {
    "$ref": "#/properties/boxesToBuy"
   },
   "planksSavedBetweenRooms": {
    "$ref": "#/properties/boxesToBuy"
   },
   "planksToBuy": {
    "$ref": "#/properties/boxesToBuy"
   },
   "rooms": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "areaSqFt": {
       "$ref": "#/properties/floorAreaSqFt"
