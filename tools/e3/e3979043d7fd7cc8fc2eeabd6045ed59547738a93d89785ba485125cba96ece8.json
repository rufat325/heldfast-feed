{
 "_meta": {
  "openai/outputTemplate": "ui://calculiva/planner-v3.html",
  "openai/toolInvocation/invoked": "Cut plan ready",
  "openai/toolInvocation/invoking": "Planning the cuts\u2026",
  "ui": {
   "resourceUri": "ui://calculiva/planner-v3.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Plan a plank flooring order"
 },
 "description": "Plans laminate, vinyl plank (LVP) or engineered plank flooring for 1 to 12 rooms, rectangles or L shapes, with the plank size and planks per carton from the carton: cartons to buy, every cut piece traced to its source plank, offcuts carried from one room to the next, the 8 scenarios (direction x offset 1/3 or 1/2 x reuse, plus aligned joints in the chosen direction when offset 0 is chosen) and the best one when no other ties it (fewest cartons, then least offcut, then fewest planks), and how many planks a flat waste allowance would miss. Up to 3,000 planks per call. Lengths accept feet and inches. Returns a link per room to the full plan on calculiva.com.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowancePercent": {
    "description": "Flat waste allowance you would otherwise buy (e.g. 10): the answer says how many planks it misses.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "balancedRows": {
    "description": "Split the partial row width between the first and last rows (default true).",
    "type": "boolean"
   },
   "carryBetweenRooms": {
    "description": "Offcuts of a room feed the next rooms (default true).",
    "type": "boolean"
   },
   "clearance": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Expansion gap on every wall, from the product instructions. Default 0. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "direction": {
    "description": "horizontal = planks run along the room width (default); vertical = along the room length.",
    "enum": [
     "horizontal",
     "vertical"
    ],
    "type": "string"
   },
   "firstStarter": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Length of the first row starter; 0 = full plank. Default 0. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "kerf": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Saw kerf, charged on each cut. Default 1/8 in. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "minJointSpacing": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Minimum distance between end joints of adjacent rows; 0 disables the check. Default 0. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "minReuse": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Shortest offcut worth carrying to another room. Default 0 (any offcut long enough). Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "minRowWidth": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Minimum edge-row width; 0 disables the check. Default 0. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "minStarter": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Minimum row starter length; 0 disables the check. Default 0. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "offset": {
    "description": "End-joint stagger between rows, as a fraction of the plank: 1/3 (default), 1/2 or 0 (aligned).",
    "enum": [
     "0",
     "1/3",
     "1/2"
    ],
    "type": "string"
   },
   "order": {
    "description": "Laying order by room name; offcuts only flow forward. Default: the order of rooms.",
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "plankLength": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Installed plank length (face), from the carton. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "plankWidth": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     {
      "minimum": 0,
      "type": "number"
     }
    ],
    "description": "Installed plank width (face), from the carton. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
   },
   "planksPerBox": {
    "description": "Planks per carton, from the carton label.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "reuse": {
    "description": "Cut a row end from the offcut of a row start in the same room (default true).",
    "type": "boolean"
   },
   "rooms": {
    "description": "Rooms to floor with the same plank, 1 to 12, in laying order unless order is given.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "length": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Room length, wall to wall (overall outside dimension for an L). Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      },
      "name": {
       "description": "Room name, e.g. \"living room\". Default \"room 1\", \"room 2\"\u2026",
       "maxLength": 40,
       "type": "string"
      },
      "notch": {
       "additionalProperties": false,
       "description": "L-shaped room: the rectangle missing from one corner of width x length.",
       "properties": {
        "corner": {
         "description": "Missing corner on the plan. Default top-right.",
         "enum": [
          "top-right",
          "top-left",
          "bottom-right",
          "bottom-left"
         ],
         "type": "string"
        },
        "length": {
         "anyOf": [
          {
           "maxLength": 80,
           "minLength": 1,
           "type": "string"
          },
          {
           "minimum": 0,
           "type": "number"
          }
         ],
         "description": "Length of the missing corner rectangle. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
        },
        "width": {
         "anyOf": [
          {
           "maxLength": 80,
           "minLength": 1,
           "type": "string"
          },
          {
           "minimum": 0,
           "type": "number"
          }
         ],
         "description": "Width of the missing corner rectangle. Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
        }
       },
       "required": [
        "width",
        "length"
       ],
       "type": "object"
      },
      "width": {
       "anyOf": [
        {
         "maxLength": 80,
         "minLength": 1,
         "type": "string"
        },
        {
         "minimum": 0,
         "type": "number"
        }
       ],
       "description": "Room width, wall to wall (overall outside dimension for an L). Length with its unit, e.g. \"12 ft 6 in\", \"12'6\\\"\", \"150 in\", \"3m80\"; a bare number is read as inches."
      }
     },
     "required": [
      "width",
      "length"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "rooms",
   "plankLength",
   "plankWidth",
   "planksPerBox"
  ],
  "type": "object"
 },
 "name": "plan_flooring_order",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowance": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "boxes": {
        "$ref": "#/properties/floorAreaSqFt"
       },
       "missingPlanks": {
        "$ref": "#/properties/boxesToBuy"
       },
       "percent": {
        "$ref": "#/properties/floorAreaSqFt"
       },
       "planksBought": {
        "$ref": "#/properties/boxesToBuy"
       }
      },
      "required": [
       "percent",
       "planksBought",
       "boxes",
       "missingPlanks"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "bestDecidedBy": {
    "description": "The first criterion of comparisonRule on which the two options differ.",
    "type": [
     "string",
     "null"
    ]
   },
   "bestScenario": {
    "description": "The single best of the scenarios (8, or 10 when offset 0 is chosen) by comparisonRule; null when several tie.",
    "type": [
     "string",
     "null"
    ]
   },
   "boxesToBuy": {
    "type": "integer"
   },
   "comparisonRule": {
    "description": "The ranking used for every \"better\" statement in this result; a tie recommends nothing.",
    "type": "string"
   },
   "floorAreaSqFt": {
    "type": "number"
   },
   "method": {
    "$ref": "#/properties/scenario/properties/layingOrder/items"
   },
