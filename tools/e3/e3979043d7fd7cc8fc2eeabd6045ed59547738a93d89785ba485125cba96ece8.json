      "bestScenario": {
       "type": [
        "string",
        "null"
       ]
      },
      "boxesAlone": {
       "$ref": "#/properties/boxesToBuy"
      },
      "name": {
       "$ref": "#/properties/scenario/properties/layingOrder/items"
      },
      "piecesFromOffcuts": {
       "$ref": "#/properties/boxesToBuy"
      },
      "planksAlone": {
       "$ref": "#/properties/boxesToBuy"
      },
      "scenarios": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "boxes": {
          "$ref": "#/properties/boxesToBuy"
         },
         "direction": {
          "$ref": "#/properties/scenarios/items/properties/direction"
         },
         "offset": {
          "$ref": "#/properties/scenario/properties/offset"
         },
         "reuse": {
          "$ref": "#/properties/scenario/properties/reuse"
         },
         "sourcePlanks": {
          "$ref": "#/properties/boxesToBuy"
         },
         "wastePercent": {
          "$ref": "#/properties/floorAreaSqFt"
         }
        },
        "required": [
         "direction",
         "offset",
         "reuse",
         "sourcePlanks",
         "boxes",
         "wastePercent"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "shape": {
       "enum": [
        "rectangle",
        "L"
       ],
       "type": "string"
      },
      "shareUrl": {
       "$ref": "#/properties/scenario/properties/layingOrder/items"
      },
      "sourcePlanks": {
       "$ref": "#/properties/boxesToBuy"
      }
     },
     "required": [
      "name",
      "shape",
      "areaSqFt",
      "sourcePlanks",
      "planksAlone",
      "boxesAlone",
      "piecesFromOffcuts",
      "bestScenario",
      "scenarios",
      "shareUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "roomsAlonePlanks": {
    "$ref": "#/properties/boxesToBuy"
   },
   "scenario": {
    "additionalProperties": false,
    "properties": {
     "carryBetweenRooms": {
      "$ref": "#/properties/scenario/properties/reuse"
     },
     "direction": {
      "enum": [
       "horizontal",
       "vertical"
      ],
      "type": "string"
     },
     "layingOrder": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "offset": {
      "enum": [
       "0",
       "1/3",
       "1/2"
      ],
      "type": "string"
     },
     "reuse": {
      "type": "boolean"
     }
    },
    "required": [
     "direction",
     "offset",
     "reuse",
     "carryBetweenRooms",
     "layingOrder"
    ],
    "type": "object"
   },
   "scenarios": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "boxes": {
       "$ref": "#/properties/boxesToBuy"
      },
      "direction": {
       "enum": [
        "horizontal",
        "vertical"
       ],
       "type": "string"
      },
      "missingPlanksAtAllowance": {
       "anyOf": [
        {
         "$ref": "#/properties/boxesToBuy"
        },
        {
