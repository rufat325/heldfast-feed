{
 "description": "Create a lightweight shared goal with one concrete proposed action.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "artifactRefs": {
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "goal": {
    "maxLength": 200,
    "minLength": 3,
    "type": "string"
   },
   "matchId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "proposedAction": {
    "maxLength": 400,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "matchId",
   "goal",
   "proposedAction"
  ],
  "type": "object"
 },
 "name": "propose_shared_goal",
 "title": "Propose Shared Goal"
}
