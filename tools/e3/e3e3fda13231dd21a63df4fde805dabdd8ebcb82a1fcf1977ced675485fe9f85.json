{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update location"
 },
 "description": "Update an existing location by ID. Requires locations:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "area": {
    "description": "Area (sq ft or sq m)",
    "minimum": 0,
    "type": "number"
   },
   "building_id": {
    "description": "Building ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "floor": {
    "description": "Floor identifier",
    "maxLength": 50,
    "type": "string"
   },
   "id": {
    "description": "Location ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "location_type_id": {
    "description": "Location type ID (from location_types)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "name": {
    "description": "Location name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Location type label",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_location",
 "title": "Update location"
}
