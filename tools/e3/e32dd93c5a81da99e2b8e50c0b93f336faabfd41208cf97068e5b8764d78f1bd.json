{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Wikidata entity candidates by name, with local place/type filtering. Default 3, maximum 5 candidates. Google and fallback are disabled remotely.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "fallback": {
    "default": false,
    "title": "Fallback",
    "type": "boolean"
   },
   "lang": {
    "default": "en",
    "maxLength": 512,
    "title": "Lang",
    "type": "string"
   },
   "limit": {
    "anyOf": [
     {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Limit"
   },
   "place": {
    "anyOf": [
     {
      "maxLength": 512,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Place"
   },
   "provider": {
    "default": "wikidata",
    "enum": [
     "wikidata",
     "google"
    ],
    "maxLength": 512,
    "title": "Provider",
    "type": "string"
   },
   "query": {
    "maxLength": 512,
    "title": "Query",
    "type": "string"
   },
   "type": {
    "anyOf": [
     {
      "maxLength": 512,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Type"
   }
  },
  "required": [
   "query"
  ],
  "title": "kg_searchArguments",
  "type": "object"
 },
 "name": "kg_search"
}
