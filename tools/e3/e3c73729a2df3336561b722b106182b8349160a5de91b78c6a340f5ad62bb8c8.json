","minimum":0,"type":"integer"},"count":{"minimum":0,"type":"integer"},"default_cap":{"description":"max_pct is the default cap.","type":"boolean"},"dimension":{"enum":["sectors","countries","asset_classes"],"type":"string"},"group":{"type":"string"},"held":{"description":"Both bounds hold, counted as the selection counts them. False when the list or the other limits could not meet one; reason says why.","type":"boolean"},"locked":{"description":"Names in the group the person locked.","minimum":0,"type":"integer"},"max_pct":{"type":["number","null"]},"min_pct":{"type":["number","null"]},"reason":{"description":"Only when held is false: why the bound could not be met.","type":"string"},"share_pct":{"description":"Names held as a share of the seats the selection was made for, percent.","type":"number"}},"required":["dimension","group","count","share_pct","held"],"type":"object"},"type":"array"},"relaxed":{"items":{"type":"string"},"type":"array"},"seat_target":{"description":"Names found plus empty seats held as cash.","type":["integer","null"]},"selected":{"type":"integer"},"skipped":{"items":{"additionalProperties":false,"properties":{"correlation":{"description":"1-year daily-return correlation, -1 to 1.","type":"number"},"symbol":{"type":"string"},"with":{"description":"The picked name it moved with.","type":"string"}},"required":["symbol","with","correlation"],"type":"object"},"type":"array"},"stale":{"items":{"type":"string"},"type":"array"},"target":{"description":"Seats the allocation limits were counted against.","type":["integer","null"]}},"type":"object"},"status":{"enum":["created","running"],"type":"string"},"strategy":{"$ref":"#/$defs/StrategySummary"},"strategy_id":{"description":"Set only with detail_unavailable.","format":"uuid","type":"string"},"truncated":{"type":"boolean"}},"type":"object"},"title":"Create an agent"}
