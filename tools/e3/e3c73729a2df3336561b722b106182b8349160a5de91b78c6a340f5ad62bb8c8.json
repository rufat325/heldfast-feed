{"_meta":{"acubic/rate_class":"compute","acubic/scopes":["strategies:write"],"acubic/task_support":"optional","acubic/task_support_requires":"2026-07-28","ui":{"resourceUri":"ui://acubic/strategy-card.83936ec0a01f.html"},"ui/resourceUri":"ui://acubic/strategy-card.83936ec0a01f.html"},"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Create an agent"},"description":"Creates and saves a new draft strategy from the acubic.ai builder's choices: universe, include lists, asset count, sizes, ranking, weighting, filter rules, limits, and tickers to add, exclude or lock. A preset (template_id) fixes the menu; without one every engine argument is open. It uses one portfolio generation from the plan's allowance; with a candidates_id from acubic_rank_candidates it saves that pick at no generation cost. A saved strategy keeps its method: to try another, build again (see allocation); acubic_regenerate_suggestion does not change it. May return a build_id for acubic_get_build_status. To edit one use acubic_update_strategy. Always show the automation.url it returns (automate on acubic.ai).","inputSchema":{"$defs":{"FilterRule":{"additionalProperties":false,"description":"One rule: metric op value.","properties":{"metric":{"description":"A filter metric id (acubic_list_strategy_options, section filters).","pattern":"^[a-z][a-z0-9_]{1,40}$","type":"string"},"op":{"enum":[">=","<=",">","<"],"type":"string"},"value":{"description":"The metric's unit: US dollars for market_cap, percent for pct metrics (40 = 40%).","type":"number"}},"required":["metric","op","value"],"type":"object"},"McpBlendEntry":{"additionalProperties":false,"description":"One factor of a blend.","properties":{"factor":{"description":"A ranking factor id (acubic_list_strategy_options).","pattern":"^[a-z][a-z0-9_]{1,40}$","type":"string"},"weight":{"description":"Relative; normalised to sum to 1.","exclusiveMinimum":0,"type":"number"},"window_days":{"description":"Look-back in days (per factor).","enum":[7,30,90,180,365,730,1095],"type":"integer"}},"required":["factor","weight"],"type":"object"},"McpCountRange":{"additionalProperties":false,"description":"Number of assets, min and max.","examples":[{"max":25,"min":15}],"properties":{"max":{"description":"1 to 50.","maximum":50,"minimum":1,"type":"integer"},"min":{"description":"1 to 50.","maximum":50,"minimum":1,"type":"integer"}},"required":["min","max"],"type":"object"},"McpDefaultMax":{"additionalProperties":false,"properties":{"countries":{"maximum":100,"minimum":0,"type":"number"},"sectors":{"maximum":100,"minimum":0,"type":"number"}},"type":"object"},"McpGroupBound":{"additionalProperties":false,"description":"Share of the selection by count, percent.","properties":{"max_pct":{"maximum":100,"minimum":0,"type":"number"},"min_pct":{"maximum":100,"minimum":0,"type":"number"}},"type":"object"},"McpRanking":{"additionalProperties":false,"description":"A preset: card. The engine: rank_method or rank_blend.","examples":[{"card":"momentum"},{"rank_method":"momentum_1y"}],"properties":{"card":{"description":"A preset's ranking card, from its menu in acubic_list_strategy_templates (by template_id, or experience and risk_level).","enum":["market_cap","momentum","sortino_momentum","market_cap_sortino","market_cap_sharpe","momentum_market_cap"],"type":"string"},"rank_blend":{"description":"Up to 20 weighted factors.","items":{"$ref":"#/$defs/McpBlendEntry","type":"object"},"maxItems":20,"type":"array"},"rank_method":{"description":"A ranking method id.","pattern":"^[a-z][a-z0-9_]{1,40}$","type":"string"}},"type":"object"},"McpSelectionLimits":{"additionalProperties":false,"description":"Group names as acubic_rank_candidates rows show them.","properties":{"asset_classes":{"additionalProperties":{"$ref":"#/$defs/McpGroupBound","type":"object"},"propertyNames":{"enum":["equities","etfs","commodities","bonds","crypto"]},"type":"object"},"countries":{"additionalProperties":{"$re