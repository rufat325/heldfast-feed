","crypto"]},"type":"object"},"client_request_id":{"description":"Idempotency key.","maxLength":64,"minLength":1,"type":"string"},"correlation_limit":{"description":"Not offered yet: omit it unless acubic_list_strategy_options shows it offered; then 0.50-0.95, step 0.05 (preset: 0.80).","maximum":0.95,"minimum":0.5,"type":"number"},"custom_symbols":{"description":"Tickers to add to the pool, checked as on acubic.ai.","items":{"maxLength":32,"type":"string"},"maxItems":20,"type":"array","uniqueItems":true},"description":{"maxLength":1000,"type":"string"},"excluded_symbols":{"description":"Names removed from the screened pool (Step 1).","items":{"maxLength":32,"type":"string"},"maxItems":50,"type":"array"},"experience":{"description":"Legacy: beginner or intermediate with risk_level selects a preset; prefer template_id. Omit for an engine build.","enum":["beginner","intermediate","advanced"],"type":"string"},"filter_rules":{"description":"Each rule: metric, op, value in the metric's unit (US dollars for market_cap, percent for pct metrics: 40 = 40%).","items":{"$ref":"#/$defs/FilterRule","type":"object"},"maxItems":20,"type":"array"},"include":{"additionalProperties":false,"description":"Ids per acubic_list_strategy_options section (index: indices).","properties":{"countries":{"type":"array"},"country_groups":{"type":"array"},"crypto":{"type":"array"},"currencies":{"type":"array"},"etf_exposures":{"type":"array"},"exchanges":{"type":"array"},"exclude_leveraged":{"type":"boolean"},"index":{"type":"array"},"industries":{"type":"array"},"instrument_types":{"type":"array"},"symbols_only":{"type":"array"},"themes":{"type":"array"}},"type":"object"},"index_card":{"description":"Build the level's index card (template level_mix.index_card) instead of ranked stocks; no ranking or allocation.","type":"boolean"},"locale":{"description":"The language of this conversation.","enum":["en","de","it","fr","es","pt-PT"],"type":"string"},"locked_symbols":{"description":"Always held, exempt from every filter.","items":{"maxLength":32,"type":"string"},"maxItems":20,"type":"array"},"name":{"maxLength":200,"minLength":1,"type":"string"},"position_sizing":{"$ref":"#/$defs/McpSizing","description":"Default: the sizes recommended for the number of assets.","type":"object"},"ranking":{"$ref":"#/$defs/McpRanking","description":"A preset: card (its menu: acubic_list_strategy_templates). The engine: rank_method or rank_blend.","type":"object"},"recipe_id":{"description":"A recipe id (acubic_list_strategy_options, recipes): sets ranking, sectors, allocation and asset count unless given; your filter_rules add to its own.","pattern":"^[a-z][a-z0-9_]{1,40}$","type":"string"},"regions":{"items":{"enum":["north_america","latin_america","europe","asia_pacific","middle_east_africa"],"type":"string"},"type":"array","uniqueItems":true},"response_format":{"default":"concise","enum":["concise","detailed"],"type":"string"},"risk_level":{"description":"Preset only (legacy path): largest acceptable drawdown; prefer template_id.","enum":["low","medium","high","unconstrained"],"type":"string"},"sectors":{"items":{"enum":["technology","healthcare","financials","energy","consumer_discretionary","consumer_staples","industrials","materials","utilities","real_estate","communication_services"],"type":"string"},"type":"array","uniqueItems":true},"select_count":{"description":"Top N to select (10, 15, 20, 30 or 50 within the count range; see selection.select_counts). Not with selected_symbols.","maximum":100,"minimum":1,"type":"integer"},"selected_symbols":{"description":"Hand-picked names of the candidates_id list (not with allocation or correlation limits).","items":{"maxLength":32,"type":"string"},"maxItems":100,"minItems":1,"type":"array","uniqueItems":true},"selection_limits":{"$ref":"#/$defs/McpSelectionLimits","description":"Min/max share of the selection per sector, country or asset class.","type":"object"},"template_id":{"description":"An id from acubic_list_strategy_templa