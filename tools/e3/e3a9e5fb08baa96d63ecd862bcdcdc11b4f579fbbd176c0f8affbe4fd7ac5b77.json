  "readOnlyHint": true,
  "title": "Overflow contents"
 },
 "description": "The contents view of the customer-owned offload S3 bucket \u2014 per-pattern bytes, event count, time-first-seen, time-last-seen, and growth rate. Filtered to action=offload via the cap-CSV the MCP wrote (`drop` patterns are NOT in S3; `compact` and `tier_down` route elsewhere). Call this as the maintenance-loop review: \"what's accumulating in my overflow queue?\" Routes the agent to log10x_retriever_query for rehydration when an incident or audit needs the data back in the SIEM.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environment": {
    "description": "Environment nickname",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "description": "Cap on the number of per-pattern rows returned. Total bytes always reflect the full overflow, even when rows are truncated.",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   },
   "service": {
    "description": "Filter to a single service. Omit for the full overflow queue across every service that routes to S3.",
    "type": "string"
   },
   "timeRange": {
    "default": "30d",
    "description": "Window over which to compute overflow contents. 30d matches the maintenance-loop cadence; sub-30d windows for incident-window probes. '24h' and '1d' are equivalent.",
    "enum": [
     "15m",
     "1h",
     "6h",
     "24h",
     "1d",
     "7d",
     "30d"
    ],
    "type": "string"
   },
   "view": {
    "const": "summary",
    "default": "summary",
    "description": "Output format. Always \"summary\" \u2014 the typed envelope (data.patterns[], data.totals).",
    "type": "string"
   }
  },
  "type": "object"
 },
