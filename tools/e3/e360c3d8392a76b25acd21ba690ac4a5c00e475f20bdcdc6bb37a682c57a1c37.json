 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "packageName": {
    "description": "Package name (e.g., 'com.example.app')",
    "type": "string"
   },
   "permission": {
    "description": "Full permission string (e.g., 'android.permission.CAMERA')",
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "permission"
  ],
  "type": "object"
 },
 "name": "adb_revoke_permission"
}
