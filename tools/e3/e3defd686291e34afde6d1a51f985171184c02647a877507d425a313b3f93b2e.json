{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Service Package"
 },
 "description": "Create a service package/prepaid session bundle. Use applicableType=SELECTED with applicableItems to limit the package to specific booking services or events.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "applicableItems": {
    "description": "Items used when applicableType=SELECTED",
    "items": {
     "properties": {
      "itemId": {
       "type": "string"
      },
      "itemType": {
       "enum": [
        "booking_service",
        "event"
       ],
       "type": "string"
      }
     },
     "required": [
      "itemType",
      "itemId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "applicableType": {
    "description": "Default ALL",
    "enum": [
     "ALL",
     "ALL_BOOKINGS",
     "ALL_EVENTS",
     "SELECTED"
    ],
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "name": {
    "description": "Package name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "price": {
    "description": "Package price",
    "minimum": 0,
    "type": "number"
   },
   "sessionCount": {
    "description": "Number of included sessions",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "description": "Default ACTIVE",
    "enum": [
     "ACTIVE",
     "INACTIVE"
    ],
    "type": "string"
   },
   "validDays": {
    "description": "Validity window after purchase, in days",
    "maximum": 3650,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "name",
   "sessionCount",
   "price",
   "validDays"
  ],
  "type": "object"
 },
 "name": "create_service_package",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
