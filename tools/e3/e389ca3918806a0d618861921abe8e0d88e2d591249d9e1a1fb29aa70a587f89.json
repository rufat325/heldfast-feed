{
 "annotations": {
  "readOnlyHint": true,
  "title": "Insider transactions"
 },
 "description": "Insider transactions (Form 3/4/5 filings) for a company, optionally within a date range. Finnhub REST: GET /stock/insider-transactions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "Start date, yyyy-mm-dd (optional).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "symbol": {
    "description": "Stock ticker symbol, e.g. 'AAPL' (required).",
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "End date, yyyy-mm-dd (optional).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "finnhub_insider_transactions",
 "title": "Insider transactions"
}
