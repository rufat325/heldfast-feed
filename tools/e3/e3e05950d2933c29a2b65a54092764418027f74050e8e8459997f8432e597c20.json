{
 "description": "Edit the last generated/edited image with new text instructions. Uses the output of the previous generate_image or edit_image call as input.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "description": "Aspect ratio",
    "enum": [
     "1:1",
     "2:3",
     "3:2",
     "3:4",
     "4:3",
     "9:16",
     "16:9"
    ],
    "type": "string"
   },
   "background": {
    "description": "Background transparency (OpenAI only)",
    "enum": [
     "transparent",
     "opaque",
     "auto"
    ],
    "type": "string"
   },
   "model": {
    "description": "Model name",
    "type": "string"
   },
   "output": {
    "description": "Output file path",
    "type": "string"
   },
   "output_dir": {
    "description": "Output directory",
    "type": "string"
   },
   "output_format": {
    "description": "Output format",
    "enum": [
     "png",
     "jpeg",
     "webp"
    ],
    "type": "string"
   },
   "prompt": {
    "description": "Edit instruction",
    "type": "string"
   },
   "provider": {
    "description": "Provider name",
    "type": "string"
   },
   "quality": {
    "description": "Image quality (OpenAI only)",
    "enum": [
     "low",
     "medium",
     "high",
     "auto"
    ],
    "type": "string"
   },
   "resolution": {
    "description": "Output resolution",
    "enum": [
     "1K",
     "2K",
     "4K"
    ],
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "edit_last"
}
