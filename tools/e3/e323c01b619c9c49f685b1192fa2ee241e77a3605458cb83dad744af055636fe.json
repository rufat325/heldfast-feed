{
 "description": "Compare two people's birth charts: inter-chart aspects with orbs, house overlays both ways, plus ranked citable fact atoms and a ready `brief` (synastry/composite ids for auditCitations). Each person needs date+lat+lon. House overlays always use Placidus (not configurable here).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "a": {
    "additionalProperties": false,
    "description": "Person A birth data (UTC date, lat, lon)",
    "properties": {
     "date": {
      "description": "UTC date-time, ISO 8601, e.g. 1990-06-10T14:30:00Z. Convert local birth time to UTC first.",
      "type": "string"
     },
     "lat": {
      "description": "Latitude, north positive",
      "maximum": 90,
      "minimum": -90,
      "type": "number"
     },
     "lon": {
      "description": "Longitude, EAST positive (Americas are negative)",
      "maximum": 180,
      "minimum": -180,
      "type": "number"
     }
    },
    "required": [
     "date",
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "b": {
    "additionalProperties": false,
    "description": "Person B birth data (UTC date, lat, lon)",
    "properties": {
     "date": {
      "$ref": "#/properties/a/properties/date"
     },
     "lat": {
      "$ref": "#/properties/a/properties/lat"
     },
     "lon": {
      "$ref": "#/properties/a/properties/lon"
     }
    },
    "required": [
     "date",
     "lat",
     "lon"
    ],
    "type": "object"
   },
   "orb": {
    "default": 4,
    "description": "Max orb in degrees",
    "maximum": 10,
    "minimum": 0.5,
    "type": "number"
   },
   "zodiac": {
    "default": "tropical",
    "description": "tropical (default) or sidereal:<ayanamsa>",
    "enum": [
     "tropical",
     "sidereal:lahiri",
     "sidereal:fagan_bradley",
     "sidereal:krishnamurti",
     "sidereal:raman",
     "sidereal:yukteshwar",
     "sidereal:galcent_0sag",
     "sidereal:true_citra"
    ],
    "type": "string"
   }
  },
  "required": [
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "synastry"
}
