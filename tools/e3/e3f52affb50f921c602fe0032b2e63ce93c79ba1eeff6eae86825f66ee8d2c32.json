{
 "description": "Screen a name against OFAC SDN, EU, UK, and UN sanctions lists. Costs 0.10 credits (tier 2).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "description": "Optional ISO country hint.",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional Idempotency-Key header.",
    "type": "string"
   },
   "match_threshold": {
    "description": "Similarity threshold, default 0.85.",
    "maximum": 1,
    "minimum": 0.5,
    "type": "number"
   },
   "name": {
    "description": "Name to screen.",
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "screen_sanctions"
}
