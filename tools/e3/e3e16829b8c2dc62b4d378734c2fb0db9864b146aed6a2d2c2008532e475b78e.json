{
 "description": "Create a Veo 3.1 task on RunAPI (text to video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aspect_ratio": {
    "enum": [
     "16:9",
     "9:16",
     "auto"
    ],
    "type": "string"
   },
   "callback_url": {
    "type": "string"
   },
   "duration_seconds": {
    "enum": [
     4,
     6,
     8
    ],
    "type": "number"
   },
   "enable_translation": {
    "type": "boolean"
   },
   "first_frame_image_url": {
    "type": "string"
   },
   "input_mode": {
    "enum": [
     "text",
     "first_and_last_frames",
     "reference"
    ],
    "type": "string"
   },
   "last_frame_image_url": {
    "type": "string"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "veo-3.1",
     "veo-3.1-fast",
     "veo-3.1-lite"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "prompt": {
    "type": "string"
   },
   "reference_image_urls": {
    "items": {},
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   },
   "seeds": {
    "type": "number"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "text_to_video"
}
