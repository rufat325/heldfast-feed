{
 "description": "List training and evaluation job status. This read-only tool does not start, approve, or promote a model.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "demo_only": {
    "type": "boolean"
   },
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "queued",
     "running",
     "awaiting_promotion",
     "promoted",
     "rejected",
     "failed",
     "cancelled",
     "insufficient_data"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_training_jobs"
}
