{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the validated official 2026 USA Pickleball Rulebook, used by MYOPL under an official licensing agreement with USA Pickleball. Returns English evidence, edition and rule citations, plus a grounded answer when the private resolver is enabled. Preserve requests for clarification; excerpts alone do not establish a complete ruling. No package download.",
 "inputSchema": {
  "additionalProperties": false,
  "description": "Arguments for search_pickleball_rules.",
  "properties": {
   "language": {
    "default": "en",
    "description": "Use en for official rulebook evidence; preserve original citations when translating the reply.",
    "enum": [
     "en",
     "es"
    ],
    "type": "string"
   },
   "query": {
    "description": "Pickleball play scenario, rule topic or official rule number to look up.",
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_pickleball_rules",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "MYOPL structured response for search_pickleball_rules.",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "answer": {
      "description": "Grounded answer with rule citations when supplied.",
      "type": "string"
     },
     "clarification": {
      "description": "Required clarification of the play, or null.",
      "type": [
       "string",
       "null"
      ]
     },
     "edition": {
      "description": "Rulebook edition year as a string.",
      "type": "string"
     },
     "evidence": {
      "description": "Up to five cited rule excerpts.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "authority": {
         "description": "Authority classification of the source record.",
         "type": "string"
        },
        "canonical_url": {
         "description": "MYOPL rulebook guide citation URL.",
         "format": "uri",
         "type": "string"
        },
        "canonical_url_type": {
         "const": "rulebook_guide",
         "description": "Identifies the linked source as a rulebook guide.",
         "type": "string"
        },
        "official_text": {
         "description": "Verbatim rule excerpt, or null if contact redaction was required.",
         "maxLength": 4000,
         "type": [
          "string",
          "null"
         ]
        },
        "rule": {
         "description": "Rule identifier.",
         "type": "string"
        },
        "rule_number": {
         "description": "Official rule identifier for citation.",
         "type": "string"
        },
        "text": {
         "description": "Rule excerpt with contact details redacted where necessary.",
         "maxLength": 4000,
         "type": "string"
        },
        "title": {
         "description": "Rule title.",
         "type": "string"
        },
        "truncated": {
         "description": "True when the excerpt is shorter than the source rule.",
         "type": "boolean"
        }
       },
       "required": [
        "rule",
        "rule_number",
        "official_text",
        "canonical_url",
        "canonical_url_type",
        "title",
        "text",
        "truncated",
        "authority"
       ],
       "type": "object"
      },
      "maxItems": 5,
      "type": "array"
     },
     "governing_body": {
      "description": "Organization responsible for the rulebook.",
      "type": "string"
     },
     "guidance": {
      "description": "Instructions for preserving citations, exceptions and clarification questions.",
      "type": "string"
     },
     "language": {
      "description": "Language of the rulebook evidence.",
      "type": "string"
     },
     "myopl_url": {
      "description": "MYOPL rulebook guide to cite.",
      "format": "uri",
      "type": "string"
     },
     "source": {
