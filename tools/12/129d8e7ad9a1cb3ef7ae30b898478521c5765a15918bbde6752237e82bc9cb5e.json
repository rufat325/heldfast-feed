{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Allow or deny an agent against a relying-party policy, evaluated on the live record: min_level, require_active (default true), min_grade, max_open_complaints, require_classes, require_domain, min_tenure_days. Returns allow and the reasons for any denial. Call with {\"agent\": \"RS-XXXX-XXXX\", \"policy\": {\"min_level\": \"L1\", \"max_open_complaints\": 0}}.",
 "inputSchema": {
  "properties": {
   "agent": {
    "type": "string"
   },
   "policy": {
    "additionalProperties": false,
    "properties": {
     "max_open_complaints": {
      "minimum": 0,
      "type": "integer"
     },
     "min_grade": {
      "type": "string"
     },
     "min_level": {
      "enum": [
       "L0",
       "L1",
       "L2",
       "L3",
       "L4",
       "L5"
      ],
      "type": "string"
     },
     "min_tenure_days": {
      "minimum": 0,
      "type": "integer"
     },
     "require_active": {
      "type": "boolean"
     },
     "require_classes": {
      "items": {
       "enum": [
        "G",
        "C",
        "D",
        "F"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "require_domain": {
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "agent",
   "policy"
  ],
  "type": "object"
 },
 "name": "kya_check",
 "outputSchema": {
  "type": "object"
 },
 "title": "Check an agent against your KYA policy"
}
