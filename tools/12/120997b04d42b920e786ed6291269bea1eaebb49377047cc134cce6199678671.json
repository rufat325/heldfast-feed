{
 "_meta": {
  "openai/fileParams": [
   "model_file"
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when someone attaches an STL, 3MF, STEP or OBJ file and wants to know whether it will 3D print well: size, walls, mesh problems and what to change. It reads the file, runs the same automatic design checks as our website, and stores nothing. It gives no quote. When no file is attached, it returns a link to upload the file on our website.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "material": {
    "description": "Material id the part would be printed in, if the user named one, one of the listed values.",
    "enum": [
     "petg",
     "pla",
     "abs",
     "pa-cf",
     "petg-cf",
     "opm",
     "tpu"
    ],
    "type": "string"
   },
   "model_file": {
    "additionalProperties": true,
    "description": "The STL, 3MF, STEP or OBJ file the user attached.",
    "properties": {
     "download_url": {
      "description": "Download URL of the attached file.",
      "type": "string"
     },
     "file_id": {
      "description": "Identifier of the attached file.",
      "type": "string"
     },
     "file_name": {
      "type": "string"
     },
     "mime_type": {
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "part_description": {
    "description": "What the user says this part is or what it is for, in their own words, if they said. Leave out if they did not.",
    "maxLength": 500,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "check_printability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "design_check_url": {
    "type": "string"
   },
   "file_name": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "area": {
       "type": "string"
      },
      "detail": {
       "type": "string"
      },
      "learn_more_url": {
       "type": "string"
      },
      "needs_person": {
       "type": "boolean"
      },
      "severity": {
       "enum": [
        "pass",
        "note",
        "needs_change"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "what_to_do": {
       "type": "string"
      }
     },
     "required": [
      "area",
      "severity",
      "needs_person",
      "title",
      "detail"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "fits_instant_size_limit": {
    "type": "boolean"
   },
   "material": {
    "type": "string"
   },
   "material_pricing_mode": {
    "enum": [
     "instant",
     "reviewed_by_a_person"
    ],
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "multi_color": {
    "type": "boolean"
   },
   "needs_person": {
    "type": "boolean"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "outcome": {
    "enum": [
     "checked",
     "needs_upload",
     "not_accepted",
     "try_later"
    ],
    "type": "string"
   },
   "person_reasons": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "review_url": {
    "type": "string"
   },
   "size_limit": {
    "type": "string"
   },
   "size_mm": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     },
     "z": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "z"
    ],
    "type": "object"
   },
   "upload_url": {
    "type": "string"
   },
   "volume_cm3": {
    "type": "number"
   }
  },
  "required": [
   "outcome",
   "message"
  ],
  "type": "object"
 },
 "title": "Check a 3D model for printing"
}
