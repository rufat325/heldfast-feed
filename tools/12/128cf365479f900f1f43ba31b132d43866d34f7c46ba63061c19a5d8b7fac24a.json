{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Generate Password"
 },
 "description": "Generate cryptographically secure random passwords. Configurable length, character sets, and exclusions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "description": "Number of passwords to generate (default: 1, max: 20)",
    "type": "number"
   },
   "exclude": {
    "description": "Characters to exclude (e.g., \"0O1lI\" for ambiguous characters)",
    "type": "string"
   },
   "length": {
    "description": "Password length (default: 16, range: 8-128)",
    "type": "number"
   },
   "lowercase": {
    "description": "Include lowercase letters a-z (default: true)",
    "type": "boolean"
   },
   "numbers": {
    "description": "Include numbers 0-9 (default: true)",
    "type": "boolean"
   },
   "symbols": {
    "description": "Include symbols !@#$... (default: true)",
    "type": "boolean"
   },
   "uppercase": {
    "description": "Include uppercase letters A-Z (default: true)",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "generate_password"
}
