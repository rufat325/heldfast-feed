{
 "description": "Record a bug to build personal pattern profile.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bug_type": {
    "description": "race_condition | null_pointer | off_by_one | memory_leak | etc.",
    "type": "string"
   },
   "trigger_context": {
    "description": "Context when bug appeared",
    "type": "string"
   }
  },
  "required": [
   "bug_type"
  ],
  "type": "object"
 },
 "name": "timps_record_bug"
}
