{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a postcard"
 },
 "description": "Create a postcard order (4x6, 6x9 or 6x11) and get a payment link. Front layouts: a big headline on a color, one photo, a photo with a caption, or a collage of 2-4 photos; the back carries the message (handwriting, serif or sans) and addresses. Set express for USPS Priority Mail (2-3 days, tracked). Mails only after the user pays.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content": {
    "description": "Front (an image URL or a headline) and the message on the back",
    "properties": {
     "caption": {
      "description": "photo_caption: short text over a band at the bottom of the photo",
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     },
     "front_headline": {
      "description": "headline layout: big text for the front, e.g. 'Happy birthday, Sam!'",
      "maxLength": 60,
      "type": "string"
     },
     "front_image_url": {
      "description": "https URL of a photo or design for the front (JPG or PNG); for photo and photo_caption",
      "maxLength": 2000,
      "type": "string"
     },
     "front_images": {
      "description": "Collage: 2 to 4 https photo URLs, laid out in a grid",
      "items": {
       "maxLength": 2000,
       "type": "string"
      },
      "maxItems": 4,
      "minItems": 2,
      "type": "array"
     },
     "front_theme": {
      "default": "ink",
      "description": "headline layout: color theme (ink, sky, sunset, forest, rose, sand, night, mint)",
      "enum": [
       "ink",
       "sky",
       "sunset",
       "forest",
       "rose",
       "sand",
       "night",
       "mint"
      ],
      "type": "string"
     },
     "headline_font": {
      "default": "serif",
      "description": "Font for the headline or caption: serif, sans or script (handwritten)",
      "enum": [
       "serif",
       "sans",
       "script"
      ],
      "type": "string"
     },
     "layout": {
      "description": "Front layout: headline (big text on a color), photo (one full-bleed photo), photo_caption (photo with a caption band), collage (2-4 photos). Inferred from the fields when omitted.",
      "enum": [
       "headline",
       "photo",
       "photo_caption",
       "collage"
      ],
      "type": "string"
     },
     "message": {
      "description": "The message on the back",
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "message_font": {
      "default": "handwriting",
      "description": "Font for the message on the back",
      "enum": [
       "handwriting",
       "serif",
       "sans"
      ],
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "customer_email": {
    "description": "Where to send the receipt and status updates",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "express": {
    "default": false,
    "description": "Send by express (USPS Priority Mail, usually 2\u20133 days, with tracking) for an extra charge; see get_pricing. Not available with certified.",
    "type": "boolean"
   },
   "from": {
    "description": "Return address; printed on the mail piece",
    "properties": {
     "city": {
      "description": "City",
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "company": {
      "description": "Company name, printed under the person's name",
      "maxLength": 60,
      "type": "string"
     },
     "line1": {
      "description": "Street address",
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
     },
     "line2": {
      "description": "Apartment, suite, unit",
      "maxLength": 64,
      "type": "string"
     },
     "name": {
      "description": "Recipient or sender full name",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "description": "Two-letter US state code, e.g. NY",
      "type": "string"
     },
     "zip": {
      "description": "5-digit US ZIP code, or ZIP+4",
      "pattern": "^\\d{5}(-\\d{4})?$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "city",
     "state",
     "zip"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "description": "Any unique string; retrying with the same key returns the original order instead of creating a duplicate",
    "maxLength": 120,
    "type": "string"
   },
   "recipients": {
    "description": "Send the same piece to several people: 2-25 US addresses, used INSTEAD of to. Each gets their own order and tracking; one payment covers all.",
    "items": {
     "properties": {
      "city": {
       "description": "City",
       "maxLength": 40,
       "minLength": 2,
       "type": "string"
      },
      "company": {
       "description": "Company name, printed under the person's name",
       "maxLength": 60,
       "type": "string"
      },
      "line1": {
       "description": "Street address",
       "maxLength": 64,
       "minLength": 3,
       "type": "string"
      },
      "line2": {
       "description": "Apartment, suite, unit",
       "maxLength": 64,
       "type": "string"
      },
      "name": {
       "description": "Recipient or sender full name",
       "maxLength": 60,
       "minLength": 1,
       "type": "string"
      },
      "state": {
       "description": "Two-letter US state code, e.g. NY",
       "type": "string"
      },
      "zip": {
       "description": "5-digit US ZIP code, or ZIP+4",
       "pattern": "^\\d{5}(-\\d{4})?$",
       "type": "string"
      }
     },
     "required": [
      "name",
      "line1",
      "city",
      "state",
      "zip"
     ],
     "type": "object"
    },
    "maxItems": 25,
    "minItems": 2,
    "type": "array"
   },
   "size": {
    "default": "4x6",
    "description": "Postcard size: 4x6, 6x9 or 6x11 (see get_pricing for prices)",
    "enum": [
     "4x6",
     "6x9",
     "6x11"
    ],
    "type": "string"
   },
   "to": {
    "description": "Recipient's US mailing address (or use recipients for several people)",
    "properties": {
     "city": {
      "description": "City",
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "company": {
      "description": "Company name, printed under the person's name",
      "maxLength": 60,
      "type": "string"
     },
     "line1": {
      "description": "Street address",
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
     },
     "line2": {
      "description": "Apartment, suite, unit",
      "maxLength": 64,
      "type": "string"
     },
     "name": {
      "description": "Recipient or sender full name",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "description": "Two-letter US state code, e.g. NY",
      "type": "string"
     },
     "zip": {
      "description": "5-digit US ZIP code, or ZIP+4",
      "pattern": "^\\d{5}(-\\d{4})?$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "city",
     "state",
     "zip"
    ],
    "type": "object"
   }
  },
  "required": [
   "from",
   "content"
  ],
  "type": "object"
 },
 "name": "create_postcard",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "batch": {
    "additionalProperties": false,
    "description": "Present when the order was created with recipients: the whole group. The top-level fields describe the first recipient's order; use batch.price and batch.checkout_url for the total and payment.",
    "properties": {
     "checkout_url": {
      "description": "One payment link for every unpaid order in the group",
      "type": [
       "string",
       "null"
      ]
     },
     "count": {
      "description": "How many recipients (one order each)",
      "type": "number"
     },
     "discount": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "amount_cents": {
          "type": "number"
         },
         "display": {
          "type": "string"
         },
         "reason": {
          "type": "string"
         }
        },
        "required": [
         "amount_cents",
         "display",
         "reason"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "id": {
      "type": "string"
     },
     "price": {
      "additionalProperties": false,
      "description": "Total for the whole group",
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "currency": {
        "type": "string"
       },
       "display": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "currency",
       "display"
      ],
      "type": "object"
     },
     "url": {
      "description": "Group page listing every recipient",
      "type": "string"
     }
    },
    "required": [
     "id",
     "count",
     "url",
     "checkout_url",
     "price",
     "discount"
    ],
    "type": "object"
   },
   "certified": {
    "description": "none, certified or certified_return_receipt",
    "type": "string"
   },
   "checkout_url": {
    "description": "Where the user pays; null once paid or cancelled",
    "type": [
     "string",
     "null"
    ]
   },
   "discount": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "display": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "display",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "First-order discount, already taken off price; null when none applies"
   },
   "id": {
    "description": "Order id, ord_\u2026",
    "type": "string"
   },
   "object": {
    "enum": [
     "postcard",
     "letter"
    ],
    "type": "string"
   },
   "order_url": {
    "description": "Order status page",
    "type": "string"
   },
   "orders": {
    "description": "Every order in the group, when created with recipients",
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "order_url": {
       "type": "string"
      },
      "preview_url": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "to",
      "order_url",
      "preview_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "preview_image_url": {
    "description": "PNG picture of the piece (postcard front and back, or the letter's first page) to show the user",
    "type": "string"
   },
   "preview_url": {
    "description": "Exact print preview",
    "type": "string"
   },
   "price": {
    "additionalProperties": false,
    "properties": {
     "amount_cents": {
      "type": "number"
     },
     "currency": {
      "type": "string"
     },
     "display": {
      "type": "string"
     }
    },
    "required": [
     "amount_cents",
     "currency",
     "display"
    ],
    "type": "object"
   },
   "product": {
    "description": "Product id, e.g. postcard_4x6 or letter_certified",
    "type": "string"
   },
   "product_name": {
    "type": "string"
   },
   "status": {
    "description": "awaiting_payment, paid, printing, mailed, cancelled or refunded",
    "type": "string"
   },
   "status_detail": {
    "description": "Plain-English status to show the user",
    "type": "string"
   },
   "tracking": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "number": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "number",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "USPS tracking, for Certified Mail once printed"
   }
  },
  "required": [
   "id",
   "object",
   "product",
   "product_name",
   "certified",
   "status",
   "status_detail",
   "price",
   "checkout_url",
   "order_url",
   "preview_url",
   "tracking",
   "discount"
  ],
  "type": "object"
 },
 "title": "Create a postcard"
}
