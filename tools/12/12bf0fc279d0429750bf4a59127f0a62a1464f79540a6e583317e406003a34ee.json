            "percentage"
           ],
           "type": "object"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
         }
        },
        "required": [
         "code"
        ],
        "type": "object"
       },
       "maxItems": 7,
       "minItems": 1,
       "type": "array"
      },
      "testLevelId": {
       "exclusiveMinimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "testLevelId",
      "activities"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
