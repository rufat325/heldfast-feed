           "INFRA",
           "CTRL",
           "PREP",
           "SPEC",
           "EXEC",
           "COMPL"
          ],
          "type": "string"
         },
         "percentage": {
          "maximum": 100,
          "minimum": 0,
          "type": "integer"
         },
