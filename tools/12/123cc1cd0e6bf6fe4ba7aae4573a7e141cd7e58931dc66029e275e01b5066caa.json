{
 "description": "Update the name, description, or any listing field. Send null to remove a field. Changes run the automatic checks again; the listing stays in review until they pass.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alternatives": {
    "anyOf": [
     {
      "description": "Websites of similar products.",
      "items": {
       "maxLength": 2048,
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "app_store_url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "audience": {
    "anyOf": [
     {
      "description": "Who the project is for.",
      "maxLength": 500,
      "minLength": 10,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "category": {
    "maxLength": 100,
    "type": "string"
   },
   "control_token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "description": {
    "default": "",
    "maxLength": 500,
    "type": "string"
   },
   "faq": {
    "anyOf": [
     {
      "description": "Answer the faq_questions from get_submission, or your own. Answers must match the website.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "answer": {
         "maxLength": 1000,
         "minLength": 20,
         "type": "string"
        },
        "question": {
         "maxLength": 200,
         "minLength": 5,
         "type": "string"
        }
       },
       "required": [
        "question",
        "answer"
       ],
       "type": "object"
      },
      "maxItems": 10,
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "icon_url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional public HTTPS icon URL. Omit or set null to discover the first Apple touch icon, then the favicon."
   },
   "id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "links": {
    "anyOf": [
     {
      "additionalProperties": {
       "maxLength": 2048,
       "type": "string"
      },
      "description": "Official profiles and pages of the project.",
      "propertyNames": {
       "enum": [
        "x",
        "bluesky",
        "mastodon",
        "linkedin",
        "github",
        "discord",
        "youtube",
        "reddit",
        "producthunt",
        "docs",
        "changelog",
        "pricing",
        "status",
        "blog"
       ],
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "long_description": {
    "anyOf": [
     {
      "description": "Plain text, 200-800 words. Separate paragraphs with a blank line. Explain what it does, how it works, and how it differs. Do not copy website text.",
      "maxLength": 6000,
      "minLength": 300,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "mcp_url": {
    "anyOf": [
     {
      "description": "Remote MCP endpoint. We check that it answers initialize.",
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "not_for": {
    "anyOf": [
     {
      "description": "Who should choose something else.",
      "maxLength": 500,
      "minLength": 10,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "openapi_url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "platforms": {
    "anyOf": [
     {
      "items": {
       "enum": [
        "web",
        "ios",
        "ipados",
        "watchos",
        "visionos",
        "android",
        "macos",
        "windows",
        "linux",
        "chrome",
        "firefox",
        "safari",
        "vscode",
        "cli",
        "api",
        "mcp",
        "wordpress",
        "figma",
        "slack",
        "other"
       ],
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "play_store_url": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "pricing": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "free_plan": {
        "type": "boolean"
       },
       "model": {
        "enum": [
         "free",
         "freemium",
         "free_trial",
         "paid",
         "open_source",
         "contact_sales"
        ],
        "type": "string"
       },
       "starting_price": {
        "description": "For example: $6/month.",
        "maxLength": 40,
        "type": "string"
       }
      },
      "required": [
       "model"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "route": {
    "default": "badge",
    "enum": [
     "badge",
     "paid"
    ],
    "type": "string"
   },
   "screenshots": {
    "anyOf": [
     {
      "description": "Up to 8 screenshots. We copy them; hosted images must stay public until verification finishes.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "alt": {
         "maxLength": 200,
         "minLength": 3,
         "type": "string"
        },
        "url": {
         "description": "Public HTTPS PNG, JPEG, or WebP, max 2 MB.",
         "maxLength": 2048,
         "type": "string"
        }
       },
       "required": [
        "url",
        "alt"
       ],
       "type": "object"
      },
      "maxItems": 8,
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "tagline": {
    "anyOf": [
     {
      "description": "One line, in your own words. Shown on cards.",
      "maxLength": 100,
      "minLength": 10,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "tags": {
    "maxLength": 1500,
    "type": "string"
   },
   "video_url": {
    "anyOf": [
     {
      "description": "Public demo video page.",
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_submission"
}
