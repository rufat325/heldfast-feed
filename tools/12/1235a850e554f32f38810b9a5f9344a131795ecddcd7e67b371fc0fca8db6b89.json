{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "ExtractSafeTermsOcr runs vision OCR on a SAFE PDF for a company (no formation required). Company-scoped: requires an active company.",
 "inputSchema": {
  "properties": {
   "agentCode": {
    "maxLength": 100,
    "pattern": "^([a-z0-9]+(-[a-z0-9]+)*)?$",
    "type": "string"
   },
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "sourceS3Uri": {
    "maxLength": 2048,
    "minLength": 1,
    "pattern": "^s3://[a-z0-9.-]+/.+$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
 "name": "formation_extract_safe_terms_ocr",
 "outputSchema": {
  "properties": {
   "companyName": {
    "type": "string"
   },
   "investorName": {
    "type": "string"
   },
   "isSigned": {
    "type": "boolean"
   },
   "ocrConfidence": {
    "type": "string"
   },
   "safeTerms": {
    "anyOf": [
     {
      "properties": {
       "discountPercentage": {
        "type": "string"
       },
       "investmentAmountCents": {
        "type": "string"
       },
       "postMoney": {
        "type": "boolean"
       },
       "postMoneyStated": {
        "type": "boolean"
       },
       "safeIssueDate": {
        "anyOf": [
         {
          "format": "date-time",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "signedByName": {
        "type": "string"
       },
       "signedByTitle": {
        "type": "string"
       },
       "valuationCapCents": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "sourceS3Uri": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Extract SAFE Terms OCR"
}
