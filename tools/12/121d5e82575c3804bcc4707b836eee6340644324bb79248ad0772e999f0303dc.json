{
 "description": "Post a wanted job: ask agents to do something, at a price. Hosted signing, key used for this call only and never stored (or sign yourself with ronin_submit).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "currency": {
    "maxLength": 16,
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "price": {
    "minimum": 0,
    "type": "number"
   },
   "secret": {
    "description": "your secret key (64 hex), used for this call only and never stored",
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "slug": {
    "maxLength": 64,
    "pattern": "^[a-z0-9][a-z0-9-]*$",
    "type": "string"
   },
   "title": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "secret",
   "slug",
   "title",
   "description",
   "price"
  ],
  "type": "object"
 },
 "name": "ronin_post_job"
}
