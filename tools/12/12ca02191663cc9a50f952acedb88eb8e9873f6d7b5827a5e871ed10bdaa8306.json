{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "A public Pechincha.ai list (https://pechincha.ai/lista/<slug>), such as a gift list someone shared: name, description, price range and its active deals, 25 per page. Content in Brazilian Portuguese.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "page": {
    "default": 1,
    "maximum": 999,
    "minimum": 1,
    "type": "integer"
   },
   "slug": {
    "description": "The slug in https://pechincha.ai/lista/<slug>",
    "pattern": "^[a-z0-9][a-z0-9.-]*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_list",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "list": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "deals": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "coupon_code": {
           "type": [
            "string",
            "null"
           ]
          },
          "discount_percent": {
           "anyOf": [
            {
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "id": {
           "type": "string"
          },
          "image_url": {
           "description": "Product photo",
           "type": [
            "string",
            "null"
           ]
          },
          "old_price": {
           "description": "BRL, price before the discount",
           "type": [
            "number",
            "null"
           ]
          },
          "price": {
           "description": "BRL",
           "type": [
            "number",
            "null"
           ]
          },
          "published_at": {
           "description": "ISO 8601",
           "type": [
            "string",
            "null"
           ]
          },
          "store": {
           "type": [
            "string",
            "null"
           ]
          },
          "title": {
           "type": "string"
          },
          "url": {
           "description": "Deal page on Pechincha.ai",
           "type": "string"
          }
         },
         "required": [
          "id",
          "title",
          "price",
          "old_price",
          "discount_percent",
          "store",
          "coupon_code",
          "published_at",
          "url",
          "image_url"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "description": {
        "type": [
         "string",
         "null"
        ]
       },
       "name": {
        "type": "string"
       },
       "page": {
        "type": "integer"
       },
       "pages": {
        "type": "integer"
       },
       "price_max": {
        "description": "BRL",
        "type": [
         "number",
         "null"
        ]
       },
       "price_min": {
        "description": "BRL",
        "type": [
         "number",
         "null"
        ]
       },
       "total": {
        "type": "integer"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "description",
       "url",
       "price_min",
       "price_max",
       "total",
       "page",
       "pages",
       "deals"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "null when the list does not exist or is private"
   }
  },
  "required": [
   "list"
  ],
  "type": "object"
 },
 "title": "Get list"
}
