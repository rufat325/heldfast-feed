{
 "description": "Verify that a passport was officially issued by AEOESS. Checks the issuer countersignature against the published AEOESS public key. Returns false for self-signed passports.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "passport": {
    "description": "The signed passport object to verify",
    "properties": {
     "issuerSignature": {
      "properties": {
       "issuerId": {
        "type": "string"
       },
       "issuerPublicKey": {
        "type": "string"
       },
       "signature": {
        "type": "string"
       },
       "signedAt": {
        "type": "string"
       }
      },
      "required": [
       "issuerId",
       "issuerPublicKey",
       "signature",
       "signedAt"
      ],
      "type": "object"
     },
     "passport": {},
     "signature": {
      "type": "string"
     },
     "signedAt": {
      "type": "string"
     }
    },
    "required": [
     "passport",
     "signature",
     "signedAt"
    ],
    "type": "object"
   }
  },
  "required": [
   "passport"
  ],
  "type": "object"
 },
 "name": "verify_issuer"
}
