{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Measure structural coverage against the approved absolute scene graph and report missing editable elements.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fileName": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*\\.drawio$",
    "type": "string"
   },
   "planId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "planId",
   "revision"
  ],
  "type": "object"
 },
 "name": "compare_reference_recreation",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expectedElements": {
    "type": "number"
   },
   "matchedElements": {
    "type": "number"
   },
   "missingElementIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "structuralScore": {
    "type": "number"
   }
  },
  "required": [
   "structuralScore",
   "expectedElements",
   "matchedElements",
   "missingElementIds"
  ],
  "type": "object"
 },
 "title": "Compare a Recreation to its Reference Plan"
}
