{
 "description": "Top DeFi yield / farming pools by APY. Optionally filter by chain (e.g. 'Ethereum'), project (e.g. 'aave'), and minimum TVL in USD to avoid tiny risky pools.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "Chain name filter, e.g. 'Ethereum', 'Arbitrum'",
    "type": "string"
   },
   "limit": {
    "description": "How many to return (default 15)",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "integer"
   },
   "minTvlUsd": {
    "description": "Minimum pool TVL in USD",
    "minimum": 0,
    "type": "number"
   },
   "project": {
    "description": "Project name filter, e.g. 'aave', 'lido'",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_yield_pools"
}
