{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Mark one memory as valid, needing review, stale, incorrect, or superseded. This never deletes memory content.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actor": {
    "default": "nuzo:mcp",
    "description": "Ignored compatibility field; the MCP audit actor remains nuzo:mcp.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "expected_revision": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "valid",
     "needs_review",
     "stale",
     "incorrect",
     "superseded"
    ],
    "type": "string"
   },
   "reason": {
    "maxLength": 1000,
    "minLength": 1,
    "type": "string"
   },
   "superseded_by_memory_id": {
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "outcome",
   "reason"
  ],
  "type": "object"
 },
 "name": "memory.challenge"
}
