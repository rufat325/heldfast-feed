{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Verify that actual tool call arguments match a declared intent with zero tolerance. Catches cross-model parameter drift (planner says amount=100, executor writes amount=10000). No LLM needed \u2014 pure deterministic comparison. Supports exact match, numeric tolerance, and regex pattern binding modes.",
 "inputSchema": {
  "properties": {
   "arguments": {
    "additionalProperties": true,
    "description": "Actual tool call arguments",
    "type": "object"
   },
   "intent": {
    "description": "Structured intent declaration from the agent framework",
    "properties": {
     "evidence_ref": {
      "description": "Optional hash of external evidence (invoice, authorization VC)",
      "type": "string"
     },
     "fields": {
      "additionalProperties": {
       "properties": {
        "binding_mode": {
         "enum": [
          "exact",
          "numeric_tolerance",
          "pattern"
         ],
         "type": "string"
        },
        "pattern": {
         "description": "Regex for pattern mode",
         "type": "string"
        },
        "tolerance": {
         "description": "Tolerance for numeric_tolerance mode",
         "type": "number"
        },
        "value": {
         "description": "Expected value"
        }
       },
       "required": [
        "value"
       ],
       "type": "object"
      },
      "description": "Map of field name to binding specification",
      "type": "object"
     },
     "intent_id": {
      "description": "Unique intent identifier (UUID v7 recommended)",
      "type": "string"
     },
     "intent_type": {
      "description": "e.g. payment, file_write, api_call",
      "type": "string"
     },
     "issued_at": {
      "description": "Unix ms when intent was issued",
      "type": "integer"
     },
     "ttl_ms": {
      "description": "Time-to-live in ms (default 30000)",
      "type": "integer"
     }
    },
    "required": [
     "intent_id",
     "intent_type",
     "fields",
     "issued_at"
    ],
    "type": "object"
   },
   "tool": {
    "description": "Tool being called, e.g. payments.send",
    "type": "string"
   }
  },
  "required": [
   "intent",
   "tool",
   "arguments"
  ],
  "type": "object"
 },
 "name": "verify_intent_binding",
 "title": "Verify intent-to-arguments binding (L4)"
}
