{
 "description": "Score a supplied keyword list with search metrics and page-priority guidance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "keywords": {
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "min_search_volume": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "sort_by": {
    "default": "priority",
    "enum": [
     "priority",
     "search_volume",
     "cpc",
     "difficulty"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "keywords"
  ],
  "type": "object"
 },
 "name": "agentseo_keyword_metrics_overview",
 "title": "AgentSEO Keyword Metrics Overview"
}
