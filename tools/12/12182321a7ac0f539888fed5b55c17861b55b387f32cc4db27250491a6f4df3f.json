{
 "description": "Execute an Agent Studio agent. Send a message and get a response. Use executionId to maintain conversation sessions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "agentId": {
    "description": "Agent ID",
    "type": "string"
   },
   "contactId": {
    "description": "Contact ID for context",
    "type": "string"
   },
   "executionId": {
    "description": "Previous execution ID to continue a conversation session. Omit for new sessions.",
    "type": "string"
   },
   "locationId": {
    "description": "Location ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "message": {
    "description": "User message to send to the agent",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "agentId",
   "locationId",
   "message"
  ],
  "type": "object"
 },
 "name": "crm_execute_agent"
}
