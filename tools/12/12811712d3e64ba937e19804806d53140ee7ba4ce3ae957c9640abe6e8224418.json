{
 "description": "List investment bookings: buys, sells, dividends, splits. Use this to see the trade history for a specific security or depot.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accountId": {
    "description": "Depot ID(s) to filter by",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "isin": {
    "description": "Filter by ISIN",
    "type": "string"
   },
   "maxDate": {
    "description": "End date (yyyy-MM-dd)",
    "type": "string"
   },
   "minDate": {
    "description": "Start date (yyyy-MM-dd)",
    "type": "string"
   },
   "perPage": {
    "default": 100,
    "description": "Max results to return (up to 500)",
    "type": "number"
   },
   "type": {
    "description": "Filter by booking type(s)",
    "items": {
     "enum": [
      "buy",
      "sell",
      "dividend",
      "split",
      "book_in",
      "book_out"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_bookings"
}
