{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Configure alert thresholds for response time, uptime, and consecutive failures.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consecutive_failures_before_alert": {
    "default": 3,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "max_response_time_ms": {
    "description": "Alert if response time exceeds this",
    "type": "integer"
   },
   "min_uptime_percent": {
    "description": "Alert if uptime drops below this",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "name": {
    "description": "Server name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "set_alert",
 "title": "Set Alert Thresholds"
}
