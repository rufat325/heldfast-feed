    "enum": [
     "standard",
     "high"
    ],
    "type": "string"
   },
   "chemical_exposure": {
    "description": "Contact with oils, fuels, cleaners or solvents. Default none.",
    "enum": [
     "none",
     "some",
     "harsh"
    ],
    "type": "string"
   },
   "cost_sensitivity": {
    "description": "high when keeping material cost low matters most.",
    "enum": [
     "standard",
     "high"
    ],
    "type": "string"
   },
   "environment": {
    "description": "Where the part lives. Default indoor.",
    "enum": [
     "indoor",
     "outdoor"
    ],
    "type": "string"
   },
   "flexibility": {
    "description": "flexible for parts that must bend and spring back, rigid for parts that must not.",
    "enum": [
     "no_preference",
     "flexible",
     "rigid"
    ],
    "type": "string"
   },
   "heat_exposure": {
    "description": "How much heat the part sees in use. Default none.",
    "enum": [
     "none",
     "warm",
     "hot"
    ],
    "type": "string"
   },
   "impact": {
    "description": "high when the part takes knocks or drops.",
    "enum": [
     "no_preference",
     "high"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
