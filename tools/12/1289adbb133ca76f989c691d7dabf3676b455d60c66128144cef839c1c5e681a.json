{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List revision history across all tickets in a project: newest first, or with since the revisions right after it, oldest first. Use instead of calling ticket_history per ticket. Page with limit and offset.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Maximum number of revisions to return",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Number of revisions to skip",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "since": {
    "description": "Only show revisions after this ISO timestamp (then oldest first)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "project_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "benefit": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "estimate": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "penalty": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "revised_at": {
       "description": "ISO timestamp",
       "type": "string"
      },
      "risk": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "tags": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "prefix": {
          "type": "string"
         },
         "value": {
          "type": "string"
         }
        },
        "required": [
         "prefix",
         "value"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "ticket_id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticket_title": {
       "description": "The ticket's current title",
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "ticket_id",
      "title",
      "description",
      "benefit",
      "penalty",
      "estimate",
      "risk",
      "tags",
      "revised_at",
      "ticket_title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
