{
 "description": "List media files and assets in the CRM file library with sorting, pagination, and type filtering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "altId": {
    "description": "Alternate ID (location ID or agency ID)",
    "type": "string"
   },
   "altType": {
    "description": "Alternate ID type ('location' or 'agency')",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of files to return",
    "type": "number"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "offset": {
    "description": "Number of records to skip for pagination",
    "type": "number"
   },
   "query": {
    "description": "Free-text search query for file names",
    "type": "string"
   },
   "sortBy": {
    "description": "Field to sort results by (e.g. 'createdAt', 'name')",
    "type": "string"
   },
   "sortOrder": {
    "description": "Sort order: 'asc' or 'desc'",
    "type": "string"
   },
   "type": {
    "description": "Filter by file type (e.g. 'image', 'video', 'document')",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "altId",
   "altType"
  ],
  "type": "object"
 },
 "name": "crm_list_media_files"
}
