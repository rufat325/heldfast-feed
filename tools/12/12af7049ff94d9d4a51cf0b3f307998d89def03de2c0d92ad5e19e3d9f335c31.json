{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Mapbox Tilequery Tool"
 },
 "description": "Query vector and raster data from Mapbox tilesets at geographic coordinates",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bands": {
    "description": "Specific band names to query (for rasterarray tilesets)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dedupe": {
    "default": true,
    "description": "Whether to deduplicate identical features (default: true)",
    "type": "boolean"
   },
   "geometry": {
    "description": "Filter results by geometry type",
    "enum": [
     "polygon",
     "linestring",
     "point"
    ],
    "type": "string"
   },
   "latitude": {
    "description": "Latitude coordinate to query",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "layers": {
    "description": "Specific layer names to query from the tileset",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "default": 5,
    "description": "Number of features to return (1-50, default: 5)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "longitude": {
    "description": "Longitude coordinate to query",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "radius": {
    "default": 0,
    "description": "Radius in meters to search for features (default: 0)",
    "minimum": 0,
    "type": "number"
   },
   "tilesetId": {
    "default": "mapbox.mapbox-streets-v8",
    "description": "Tileset ID to query (default: mapbox.mapbox-streets-v8)",
    "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "longitude",
   "latitude"
  ],
  "type": "object"
 },
 "name": "tilequery_tool",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "features": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "geometry": {
         "additionalProperties": false,
         "properties": {
          "coordinates": {
           "additionalItems": false,
           "items": [
            {
             "type": "number"
            },
            {
             "type": "number"
            }
           ],
           "maxItems": 2,
           "minItems": 2,
           "type": "array"
          },
          "type": {
           "const": "Point",
           "type": "string"
          }
         },
         "required": [
          "type",
          "coordinates"
         ],
         "type": "object"
        },
        "id": {
         "description": "Feature identifier (string or number per GeoJSON spec)",
         "type": [
          "string",
          "number"
         ]
        },
        "properties": {
         "allOf": [
          {
           "additionalProperties": false,
           "properties": {
            "tilequery": {
             "additionalProperties": false,
             "properties": {
              "distance": {
               "description": "Approximate surface distance from feature to queried point, in meters",
               "type": "number"
              },
              "geometry": {
               "description": "Original geometry type of the feature",
               "enum": [
                "point",
                "linestring",
                "polygon"
               ],
               "type": "string"
              },
              "layer": {
               "description": "The vector tile layer of the feature result",
               "type": "string"
              }
             },
             "required": [
              "distance",
              "geometry",
              "layer"
             ],
             "type": "object"
            }
           },
           "required": [
            "tilequery"
           ],
           "type": "object"
          },
          {
           "additionalProperties": {},
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          }
         ]
        },
        "type": {
         "const": "Feature",
         "type": "string"
        }
       },
       "required": [
        "type",
        "id",
        "geometry",
        "properties"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "geometry": {
         "additionalProperties": false,
         "properties": {
          "coordinates": {
           "additionalItems": false,
           "items": [
            {
             "type": "number"
            },
            {
             "type": "number"
            }
           ],
           "maxItems": 2,
           "minItems": 2,
           "type": "array"
          },
          "type": {
           "const": "Point",
           "type": "string"
          }
         },
         "required": [
          "type",
          "coordinates"
         ],
         "type": "object"
        },
        "id": {
         "type": "null"
        },
        "properties": {
         "additionalProperties": false,
         "properties": {
          "tilequery": {
           "additionalProperties": false,
           "properties": {
            "band": {
             "description": "The band that the feature belongs to",
             "type": "string"
            },
            "layer": {
             "description": "The layer that the feature belongs to",
             "type": "string"
            },
            "units": {
             "description": "The unit of measurement for the point value",
             "type": "string"
            },
            "zoom": {
             "description": "The maxzoom level at which the point value was extracted",
             "type": "number"
            }
           },
           "required": [
            "layer",
            "band",
            "zoom",
            "units"
           ],
           "type": "object"
          },
          "val": {
           "anyOf": [
            {
             "type": "number"
            },
            {
             "items": {
              "type": "number"
             },
             "type": "array"
            }
           ],
           "description": "Point value at the requested location (number for single-band, array for multi-dimensional data)"
          }
         },
         "required": [
          "tilequery",
          "val"
         ],
         "type": "object"
        },
        "type": {
         "const": "Feature",
         "type": "string"
        }
       },
       "required": [
        "type",
        "id",
        "geometry",
        "properties"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "type": {
    "const": "FeatureCollection",
    "type": "string"
   }
  },
  "required": [
   "type",
   "features"
  ],
  "type": "object"
 },
 "title": "Mapbox Tilequery Tool"
}
