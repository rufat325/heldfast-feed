{
 "description": "[OPERATOR] Transfer approved evidence from researcher to analyst.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "packet_id": {
    "description": "Approved evidence packet ID",
    "type": "string"
   },
   "review_id": {
    "description": "Review ID that approved it",
    "type": "string"
   },
   "task_id": {
    "description": "Task ID",
    "type": "string"
   },
   "to_agent_key": {
    "description": "Destination agent's public key",
    "type": "string"
   },
   "to_role": {
    "description": "Destination role (e.g. analyst)",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "packet_id",
   "review_id",
   "to_role",
   "to_agent_key"
  ],
  "type": "object"
 },
 "name": "handoff_evidence"
}
