{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Select, rename, derive and convert columns using a caller-owned version-1 recipe. Rules reference original input headers; output follows recipe order and omitted columns are listed. All input rows remain. Any failed conversion returns valid=false, all findings and csv_text=null, never a partially transformed file. No arithmetic, arbitrary code, schema inference or destination writes. One completed report costs one operation, including valid=false. Use reconcile_tables for two-file matching.",
 "inputSchema": {
  "$defs": {
   "OutputColumn": {
    "additionalProperties": false,
    "properties": {
     "actions": {
      "description": "Ordered rules. Dates explicitly use DD/MM/YYYY or MM/DD/YYYY; failed conversions block the output.",
      "items": {
       "enum": [
        "trim",
        "lowercase",
        "uppercase",
        "decimal_comma",
        "date_dmy",
        "date_mdy"
       ],
       "type": "string"
      },
      "maxItems": 10,
      "title": "Actions",
      "type": "array"
     },
     "concat": {
      "anyOf": [
       {
        "items": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Concat"
     },
     "literal": {
      "anyOf": [
       {
        "maxLength": 10000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Literal"
     },
     "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "separator": {
      "default": "",
      "maxLength": 100,
      "title": "Separator",
      "type": "string"
     },
     "source": {
      "anyOf": [
       {
        "maxLength": 100,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Source"
     }
    },
    "required": [
     "name"
    ],
    "title": "OutputColumn",
    "type": "object"
   },
   "Recipe": {
    "additionalProperties": false,
    "properties": {
     "columns": {
      "description": "Explicit output order; unselected input columns are omitted and reported.",
      "items": {
       "$ref": "#/$defs/OutputColumn"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Columns",
      "type": "array"
     },
     "output_delimiter": {
      "default": ",",
      "enum": [
       ",",
       ";",
       "\t",
       "|"
      ],
      "title": "Output Delimiter",
      "type": "string"
     },
     "spreadsheet_safe": {
      "default": false,
      "title": "Spreadsheet Safe",
      "type": "boolean"
     },
     "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
     }
    },
    "required": [
     "columns"
    ],
    "title": "Recipe",
    "type": "object"
   },
   "TableInput": {
    "additionalProperties": false,
    "properties": {
     "columns": {
      "anyOf": [
       {
        "items": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 100,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Columns"
     },
     "csv_text": {
      "anyOf": [
       {
        "maxLength": 1000000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "CSV including headers; no paths or URLs.",
      "title": "Csv Text"
     },
     "delimiter": {
      "default": ",",
      "enum": [
       ",",
       ";",
       "\t",
       "|"
      ],
      "title": "Delimiter",
      "type": "string"
     },
     "rows": {
      "anyOf": [
       {
        "items": {
         "items": {
          "maxLength": 10000,
          "type": "string"
         },
         "maxItems": 100,
         "type": "array"
        },
        "maxItems": 10000,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rows"
     }
    },
    "title": "TableInput",
    "type": "object"
   }
  },
  "properties": {
   "recipe": {
    "$ref": "#/$defs/Recipe"
   },
   "request_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Request Id"
   },
   "table": {
    "$ref": "#/$defs/TableInput"
   }
  },
  "required": [
   "table",
   "recipe"
  ],
  "title": "prepare_tableArguments",
  "type": "object"
 },
 "name": "prepare_table",
 "title": "Prepare a table using reusable column rules"
}
