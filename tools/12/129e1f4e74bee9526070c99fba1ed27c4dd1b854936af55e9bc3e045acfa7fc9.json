{
 "description": "Start a browser session using the configured provider.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "provider": {
    "enum": [
     "browserbase",
     "anchor",
     "playwright",
     "cloudflare"
    ],
    "type": "string"
   },
   "sessionName": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "start_session",
 "title": "Start Session"
}
