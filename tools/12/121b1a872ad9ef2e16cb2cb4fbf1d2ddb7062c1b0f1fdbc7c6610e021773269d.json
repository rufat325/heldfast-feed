{"_meta":{"xdata.kr/credential":{"providers":["hometax"],"register_url":"https://console.xdata.kr/credentials?link=1&provider=hometax","required":true,"windows_pc_needed":true}},"annotations":{"destructiveHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"\uba3c\uc800 \ud638\ucd9c\ud560 \ub3c4\uad6c: hometax__session__login (\uac19\uc740 account_link_id). \uc624\ub298 \ubc1c\uae09\ud55c \ud604\uae08\uc601\uc218\uc99d\uc744 \ucde8\uc18c\ud569\ub2c8\ub2e4. aprv_no \uc640 cshpt_cncl_rsn_cd \ub9cc \uc788\uc73c\uba74 \ub429\ub2c8\ub2e4. \ub098\uba38\uc9c0 \uce78\uc740 \ubcf4\ub0b4\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc73c\ub85c \uc804\uc1a1\ud569\ub2c8\ub2e4(aprv_no \ub294 hometax__cash_receipt__daily_issue__search \uc5d0\uc11c \uc5bb\uc2b5\ub2c8\ub2e4). \uc774 \ub3c4\uad6c\ub294 \uae30\uad00\uc758 \uae30\ub85d\uc744 \ubc14\uafc9\ub2c8\ub2e4. \uccab \ud638\ucd9c\uc740 \uc2e4\ud589\ub418\uc9c0 \uc54a\uace0, \uc804\uc1a1\ud560 \ub0b4\uc6a9\uc758 \ubbf8\ub9ac\ubcf4\uae30\uc640 1\ud68c\uc6a9 confirmation_token \uc744 \ub3cc\ub824\uc90d\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uadf8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \uc0ac\uc6a9\uc790\uc5d0\uac8c \uadf8\ub300\ub85c \ubcf4\uc5ec \uc90d\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub3d9\uc758\ud55c \ub4a4\uc5d0\ub9cc \uac19\uc740 \uc778\uc790\uc5d0 \uadf8 confirmation_token \uc744 \ub354\ud574 \ub2e4\uc2dc \ud638\ucd9c\ud569\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uc758 \ub3d9\uc758 \uc5c6\uc774 \ud1a0\ud070\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc778\uc790\ub97c \ud558\ub098\ub77c\ub3c4 \ubc14\uafb8\uba74 \ud1a0\ud070\uc740 \ubb34\ud6a8\uac00 \ub429\ub2c8\ub2e4. \uadf8\ub54c\ub294 \ud1a0\ud070 \uc5c6\uc774 \ud638\ucd9c\ud574 \uc0c8 \ubbf8\ub9ac\ubcf4\uae30\ub97c \ubc1b\uc2b5\ub2c8\ub2e4. \ud638\ucd9c\ub9c8\ub2e4 \ud1a0\ud070 1\uc18c\uc9c4 \uc694\uccad \ucc98\ub9ac \uc2dc XBOSS \uc791\uc5c5\uc744 \uc0dd\uc131\ud558\uace0 \ucc98\ub9ac \uacb0\uacfc\ub97c \uc800\uc7a5\ud569\ub2c8\ub2e4. \uae30\uad00 \uc6d0\ubcf8\uc758 \uc870\ud68c \uc5ec\ubd80\uc640 \ubcc4\uac1c\ub85c \uc774 \ud638\ucd9c\uc740 \uc21c\uc218 \uc77d\uae30 \uc804\uc6a9\uc774 \uc544\ub2d9\ub2c8\ub2e4. \uae30\uad00 \ub370\uc774\ud130 \ubcc0\uacbd\uc740 \ub3c4\uad6c\ubcc4 \uc2e4\ud589 \ub0b4\uc6a9\uacfc \uae30\uc874 \ud655\uc778 \uc808\ucc28\ub97c \ub530\ub985\ub2c8\ub2e4.","inputSchema":{"properties":{"account_link_id":{"description":"\uc5f0\ub3d9 ID(UUID v4). \uc120\ud0dd \uc785\ub825\uc785\ub2c8\ub2e4. \ube44\uc6cc \ub450\uba74 \uc11c\ubc84\uac00 API \ud0a4\ub85c \uc5f0\ub3d9\uc744 \ucc3e\uc544 \uc501\ub2c8\ub2e4. \uac19\uc740 \uae30\uad00\uc5d0 \uc778\uc99d\uc11c\ub97c \uc5ec\ub7ec \uac1c \uc5f0\ub3d9\ud588\uc744 \ub54c\ub9cc \uc9c1\uc811 \uc785\ub825\ud574 \uc8fc\uc138\uc694. \uae30\uad00\ub9c8\ub2e4 ID \uac00 \ub2e4\ub985\ub2c8\ub2e4.","type":"string"},"aprv_no":{"description":"\uc2b9\uc778\ubc88\ud638.","type":"string"},"confirmation_token":{"description":"\uccab \ud638\ucd9c\uc774 \ub3cc\ub824\uc900 1\ud68c\uc6a9 \ud655\uc778 \ud1a0\ud070\uc785\ub2c8\ub2e4(\uc624\ub958 WRITE_CONFIRMATION_REQUIRED). \uac19\uc740 \uc778\uc790\uc5d0 \uc774 \uac12\uc744 \uadf8\ub300\ub85c \ub123\uc5b4 \ub2e4\uc2dc \ud638\ucd9c\ud558\uba74 \uc2e4\ud589\ub429\ub2c8\ub2e4. 10\ubd84 \ub4a4 \ub9cc\ub8cc\ub418\uace0 \ud55c \ubc88\ub9cc \uc4f8 \uc218 \uc788\uc2b5\ub2c8\ub2e4.","type":"string"},"cshpt_cncl_rsn_cd":{"description":"\ucde8\uc18c\uc0ac\uc720\ucf54\ub4dc. 1=\uac70\ub798\ucde8\uc18c, 2=\uc624\ub958\ubc1c\uae09, 3=\uae30\ud0c0.","enum":["1","2","3"],"type":"string"},"cshpt_trs_type_cd":{"description":"\uac70\ub798\uc720\ud615\ucf54\ub4dc. 01=\uacfc\uc138, 02=\uba74\uc138, 03=\uac04\uc774. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"cshpt_usg_cl_cd":{"description":"\uc6a9\ub3c4\uad6c\ubd84\ucf54\ub4dc. 0=\uc18c\ub4dd\uacf5\uc81c\uc6a9, 1=\uc9c0\ucd9c\uc99d\ube59\uc6a9. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"rcpr_tin":{"description":"\uc218\ucde8\uc790 \ub0a9\uc138\uc790 \ubc88\ud638(TIN). \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"spl_cft":{"description":"\uacf5\uae09\uac00\uc561. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"spst_cnfr_cl_cd":{"description":"\ubc1c\uae09\uc218\ub2e8\uad6c\ubd84\ucf54\ub4dc. 01=\uc8fc\ubbfc\ub4f1\ub85d\ubc88\ud638, 02=\uc0ac\uc5c5\uc790\ub4f1\ub85d\ubc88\ud638, 03=\ud734\ub300\uc804\ud654\ubc88\ud638, 04=\uce74\ub4dc\ubc88\ud638. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"spst_cnfr_no_enc_cntn":{"description":"\ubc1c\uae09\uc218\ub2e8\ubc88\ud638. \ubc1c\uae09\uc218\ub2e8\uad6c\ubd84\ucf54\ub4dc\uc5d0 \ub9de\ub294 \ubc88\ud638\ub97c \uc22b\uc790\ub9cc \uc785\ub825\ud569\ub2c8\ub2e4. \uc785\ub825\ud55c \uac12 \uadf8\ub300\ub85c \uae30\uad00\uc5d0 \ubcf4\ub0b4\ubbc0\ub85c \uc554\ud638\ud654\ud558\uac70\ub098 \ud574\uc2dc\ud558\uc9c0 \uc54a\uace0, \uc2b9\uc778\ubc88\ud638\ub97c \uc5ec\uae30\uc5d0 \uc785\ub825\ud558\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"tip":{"description":"\ubd09\uc0ac\ub8cc. \uc785\ub825\ud558\uc9c0 \uc54a\uc73c\uba74 \uc624\ub298 \ubc1c\uae09\ud55c \uc6d0\ubcf8\uc758 \uac12\uc744 \uc501\ub2c8\ub2e4.","type":"string"},"tota_trs_amt":{"description":"\ucd1d \uac70\ub798\uae08\uc561. \uc6d0 \ub2e8\uc704 \uc22b\uc790\ub97c \ubb38\uc790\uc5f4\ub85c \uc785\ub825\ud558\uba70 1 \uc774\uc0c1\uc774\uc5b4\uc57c \ud569\ub2c8\ub2e4. \uc785\ub825\ud558\