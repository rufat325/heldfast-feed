{
 "description": "Place an order from a saved template. You can override reference, address, or options.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "additionalProperties": false,
    "description": "Override the template address (optional)",
    "properties": {
     "address_addition": {
      "description": "House number addition",
      "type": "string"
     },
     "address_city": {
      "description": "City",
      "type": "string"
     },
     "address_company_name": {
      "description": "Company name (required by Probo API)",
      "type": "string"
     },
     "address_country": {
      "description": "Country code (ISO 3166-1 alpha-2)",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "address_email": {
      "description": "Email address",
      "format": "email",
      "type": "string"
     },
     "address_first_name": {
      "description": "First name",
      "type": "string"
     },
     "address_house_number": {
      "description": "House number",
      "type": [
       "string",
       "number"
      ]
     },
     "address_last_name": {
      "description": "Last name",
      "type": "string"
     },
     "address_postal_code": {
      "description": "Postal code",
      "type": "string"
     },
     "address_street": {
      "description": "Street name",
      "type": "string"
     },
     "address_telephone_number": {
      "description": "Phone number",
      "type": "string"
     }
    },
    "required": [
     "address_company_name",
     "address_first_name",
     "address_street",
     "address_postal_code",
     "address_city",
     "address_country"
    ],
    "type": "object"
   },
   "isTest": {
    "description": "Test order (default: based on PROBO_API_MODE env)",
    "type": "boolean"
   },
   "name": {
    "description": "Template name",
    "minLength": 1,
    "type": "string"
   },
   "reference": {
    "description": "Your order reference for this specific order",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "reference"
  ],
  "type": "object"
 },
 "name": "placeOrderFromTemplate"
}
