{
 "description": "Dry-run a changeset (create/update/delete notes). Returns a change_id and a before/after diff. Nothing is written until commit_changes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ops": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "content": {
         "type": "string"
        },
        "frontmatter": {
         "additionalProperties": {},
         "type": "object"
        },
        "note_id": {
         "type": "string"
        },
        "op": {
         "const": "create",
         "type": "string"
        }
       },
       "required": [
        "op",
        "note_id",
        "content"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "content": {
         "type": "string"
        },
        "frontmatter": {
         "additionalProperties": {},
         "type": "object"
        },
        "note_id": {
         "type": "string"
        },
        "op": {
         "const": "update",
         "type": "string"
        }
       },
       "required": [
        "op",
        "note_id"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "note_id": {
         "type": "string"
        },
        "op": {
         "const": "delete",
         "type": "string"
        }
       },
       "required": [
        "op",
        "note_id"
       ],
       "type": "object"
      }
     ]
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "ops"
  ],
  "type": "object"
 },
 "name": "propose_changes"
}
