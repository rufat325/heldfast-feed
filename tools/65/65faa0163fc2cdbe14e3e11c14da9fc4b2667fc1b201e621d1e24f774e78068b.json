{
 "description": "Request a payment transaction through ClawVault. The transaction will be validated against your rules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount to send (e.g. \"10.00\")",
    "type": "string"
   },
   "chain": {
    "description": "Blockchain network (e.g. 'base', 'ethereum', 'arbitrum', 'polygon', 'bnb', 'avalanche', 'tempo', 'zerog', 'solana')",
    "type": "string"
   },
   "reason": {
    "description": "Reason for the payment (optional)",
    "type": "string"
   },
   "recipient": {
    "description": "Recipient wallet address",
    "type": "string"
   },
   "token": {
    "description": "Token symbol (e.g. \"USDC\", \"ETH\")",
    "type": "string"
   }
  },
  "required": [
   "amount",
   "token",
   "recipient",
   "chain"
  ],
  "type": "object"
 },
 "name": "request_payment"
}
