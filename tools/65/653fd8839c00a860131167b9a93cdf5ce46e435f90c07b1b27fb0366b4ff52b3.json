{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Edits an announcement: `title`, `body`, `type`, display window and link. Pass `null` for `started_at`, `ended_at` or `link` to clear them. To stop an active announcement immediately, set `ended_at` to the current time.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "announcement_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "body": {
    "minLength": 1,
    "type": "string"
   },
   "confirm": {
    "description": "Set to true to authorize this write/destructive call even if STATUSER_ALLOW_WRITE is not enabled in the server config. Required for one-off overrides.",
    "type": "boolean"
   },
   "ended_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "link": {
    "anyOf": [
     {
      "format": "uri",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "started_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "status_page_id": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "title": {
    "maxLength": 255,
    "minLength": 3,
    "type": "string"
   },
   "type": {
    "description": "Severity of the announcement: `info` (blue), `warning` (yellow) or `critical` (red).",
    "enum": [
     "info",
     "warning",
     "critical"
    ],
    "type": "string"
   }
  },
  "required": [
   "status_page_id",
   "announcement_id"
  ],
  "type": "object"
 },
 "name": "status_page_announcement_update",
 "title": "Edit an announcement"
}
