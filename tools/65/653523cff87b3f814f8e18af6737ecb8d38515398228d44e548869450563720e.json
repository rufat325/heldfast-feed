{
 "description": "Solana pump.fun graduations from the last 1-240 minutes: time on the curve (gradMin), the curve path into graduation from our own curve reads, the buyer burst that preceded it when there was one, and returns 1, 5 and 15 minutes after graduation from our own sampled series. Data rewritten every 20 s; refused (503, not charged) if older than 120 s. Costs $0.01 USDC per call (x402).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "minutes": {
    "description": "Look-back window in minutes, 1-240 (default 60)",
    "maximum": 240,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "sol_grads_live",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ageSec": {
    "type": "number"
   },
   "chain": {
    "type": "string"
   },
   "generatedAt": {
    "type": "number"
   },
   "grads": {
    "items": {
     "$ref": "#/properties/method"
    },
    "type": "array"
   },
   "latest": {
    "anyOf": [
     {
      "$ref": "#/properties/method"
     },
     {
      "type": "null"
     }
    ]
   },
   "method": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "minutes": {
    "type": "number"
   },
   "note": {
    "type": "string"
   },
   "schemaVersion": {
    "type": "number"
   }
  },
  "required": [
   "chain",
   "schemaVersion",
   "generatedAt",
   "ageSec",
   "minutes",
   "grads"
  ],
  "type": "object"
 }
}
