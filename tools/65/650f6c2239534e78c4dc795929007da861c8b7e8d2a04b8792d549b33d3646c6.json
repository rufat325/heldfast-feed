{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Render Carve to HTML, Markdown, plain text, or ANSI terminal text, with loss reporting.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "allowRawHtml": {
    "default": false,
    "description": "Pass trusted raw HTML through on HTML output. Disabled by default.",
    "type": "boolean"
   },
   "asciiHeadingIds": {
    "description": "Heading ID policy; explicit values override the preset.",
    "enum": [
     "off",
     "fold",
     "strict"
    ],
    "type": "string"
   },
   "extensions": {
    "default": [],
    "description": "Opt-in extensions; semantic-spans is HTML-only.",
    "items": {
     "enum": [
      "autolink",
      "semantic-spans",
      "wikilinks"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "lowercaseHeadingIds": {
    "description": "Lowercase generated heading IDs; explicit values override the preset.",
    "type": "boolean"
   },
   "maxRenderLosses": {
    "description": "Maximum detailed losses to return.",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "preset": {
    "default": "default",
    "description": "portable lowercases IDs and transliterates where possible; static-html is HTML-only.",
    "enum": [
     "default",
     "portable",
     "static-html"
    ],
    "type": "string"
   },
   "sanitizeUrls": {
    "default": true,
    "description": "Block dangerous authored URL schemes. Keep enabled for untrusted input.",
    "type": "boolean"
   },
   "smartTypography": {
    "description": "Render typographic glyphs or the punctuation the author typed.",
    "enum": [
     "glyph",
     "source"
    ],
    "type": "string"
   },
   "source": {
    "description": "Document source (maximum 1000000 UTF-8 bytes)",
    "type": "string"
   },
   "strictLosses": {
    "default": false,
    "description": "Fail instead of returning output when a raw-format node would be dropped.",
    "type": "boolean"
   },
   "target": {
    "enum": [
     "html",
     "markdown",
     "plain",
     "ansi"
    ],
    "type": "string"
   }
  },
  "required": [
   "source",
   "target"
  ],
  "type": "object"
 },
 "name": "carve_render",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "losses": {
    "items": {},
    "type": "array"
   },
   "totalLosses": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "truncated": {
    "type": "boolean"
   },
   "value": {
    "type": "string"
   }
  },
  "required": [
   "value",
   "losses",
   "totalLosses",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Render Carve"
}
