{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Render Cover Letter PDF"
 },
 "description": "Render a saved cover letter as PDF with template and styling settings. Costs 1 API credit.",
 "inputSchema": {
  "properties": {
   "colorId": {
    "description": "Color scheme identifier",
    "type": "string"
   },
   "coverLetterId": {
    "description": "Cover letter UUID to render",
    "type": "string"
   },
   "font": {
    "description": "Font family name",
    "type": "string"
   },
   "fontSize": {
    "description": "Base font size in points",
    "type": "number"
   },
   "locale": {
    "description": "Language/locale code",
    "type": "string"
   },
   "margin": {
    "description": "Page margin in millimeters",
    "type": "number"
   },
   "pageNumbering": {
    "description": "Page numbering style",
    "enum": [
     "none",
     "simple",
     "fraction",
     "page"
    ],
    "type": "string"
   },
   "spacing": {
    "description": "Line spacing multiplier",
    "type": "number"
   },
   "templateId": {
    "description": "Template identifier (e.g. GRAPHITE)",
    "type": "string"
   }
  },
  "required": [
   "coverLetterId",
   "templateId"
  ],
  "type": "object"
 },
 "name": "laddro.coverLetters.render",
 "outputSchema": {
  "properties": {
   "content": {
    "description": "Base64-encoded PDF data",
    "type": "string"
   },
   "mimeType": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
