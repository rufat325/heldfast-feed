{
 "description": "Get the holders of a token (paginated): addresses, balances, and aliases.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Token contract address (0x-prefixed hex).",
    "type": "string"
   },
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Defaults to 1.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Items per page: 10, 25, 50, or 100. Defaults to 25. Keep small to save context.",
    "enum": [
     10,
     25,
     50,
     100
    ],
    "type": "number"
   },
   "type": {
    "description": "Token standard. Defaults to \"erc20\".",
    "enum": [
     "erc20",
     "erc721",
     "erc1155"
    ],
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_token_holders"
}
