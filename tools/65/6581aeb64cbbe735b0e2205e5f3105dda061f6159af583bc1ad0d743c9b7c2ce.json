{
 "description": "List your scheduled jobs with optional filters and pagination.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Filter by name (regex)",
    "type": "string"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "enum": [
     "active",
     "paused",
     "completed",
     "failed"
    ],
    "type": "string"
   },
   "tag": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_jobs"
}
