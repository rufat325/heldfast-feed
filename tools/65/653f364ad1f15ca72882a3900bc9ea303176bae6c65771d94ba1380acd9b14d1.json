{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lists the public objects of one tenant. Without type: the tenant's object types and counts. With type: one page (100 per page) of that type's objects.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "namespace": {
    "description": "Tenant namespace from list_tenants.",
    "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$",
    "type": "string"
   },
   "page": {
    "description": "Page number, from 1.",
    "minimum": 1,
    "type": "integer"
   },
   "type": {
    "description": "Object type from the tenant's types.",
    "pattern": "^[a-z_]{1,40}$",
    "type": "string"
   }
  },
  "required": [
   "namespace"
  ],
  "type": "object"
 },
 "name": "list_objects",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "properties": {
      "canonicalPublicUrl": {
       "type": "string"
      },
      "dateModified": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "type",
      "label",
      "canonicalPublicUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "links": {
    "type": "object"
   },
   "namespace": {
    "type": "string"
   },
   "page": {
    "type": "integer"
   },
   "pageCount": {
    "type": "integer"
   },
   "totalObjects": {
    "type": "integer"
   },
   "type": {
    "type": "string"
   },
   "types": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "namespace",
   "totalObjects"
  ],
  "type": "object"
 },
 "title": "List public objects"
}
