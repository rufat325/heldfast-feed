{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Aggregated single-coin dossier: market data (spot/perp price, funding, market-wide OI, long/short, liquidations \u2014 the same enriched line as market_quotes), global market context (dominance, Fear & Greed), multi-timeframe technicals computed in-house from candles (4h + 1d: RSI, EMA/SMA, MACD, ATR, Bollinger, ADX, trend \u2014 the same numbers as ta_technicals), on-chain TVL/fees (when the symbol is a tracked chain), news, a grounded narrative synthesis with citations, upcoming catalyst events, social sentiment, ETF flows, prediction-market odds, live provider coverage, and a per-section status list that distinguishes an empty section from a failed feed \u2014 for one symbol (e.g. 'ETH').",
 "inputSchema": {
  "properties": {
   "symbol": {
    "description": "Coin symbol, e.g. 'ETH' or 'BTC'",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "research_token_view",
 "outputSchema": {
  "properties": {
   "catalysts": {
    "items": {
     "properties": {
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "coins": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "dateAdded": {
       "type": "string"
      },
      "eventDate": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "etfFlow": {
    "properties": {
     "ageHours": {
      "description": "How old the flow date is now, in hours. ETF flows settle behind spot and skip weekends, so this is routinely >24.",
      "type": "number"
     },
     "asOfAt": {
      "description": "Flow date, ISO-8601 UTC",
      "type": "string"
     },
     "asset": {
      "type": "string"
     },
     "byTicker": {
      "items": {
       "properties": {
        "flowUsd": {
         "description": "Per-fund net flow, USD",
         "type": "number"
        },
        "ticker": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "dateMs": {
      "description": "Flow date, Unix epoch milliseconds",
      "type": "integer"
     },
     "priceUsd": {
      "description": "The underlying's price ON THE FLOW DATE, not spot \u2014 compare against ageHours before reading it as current",
      "type": "number"
     },
     "stale": {
      "description": "True when the flow date is more than 96h old \u2014 the series has missed a publication",
      "type": "boolean"
     },
     "totalFlowUsd": {
      "description": "Net flow across all funds, USD (positive = inflow)",
      "type": "number"
     }
    },
    "type": "object"
   },
   "market": {
    "description": "Same shape as one market_quotes item; omitted when no provider covers the symbol",
    "type": "object"
   },
   "marketContext": {
    "description": "Same shape as market_overview",
    "type": "object"
   },
   "narrative": {
    "properties": {
     "answer": {
      "type": "string"
     },
     "citations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "news": {
    "items": {
     "properties": {
      "coins": {
       "description": "Coin symbols the feed tagged on the item, e.g. [\"BTC\",\"ETH\"]",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "date": {
       "description": "Publish date; omitted when unknown",
       "type": "string"
      },
      "impact": {
       "description": "Measured price move after the headline broke; omitted when not measured",
       "properties": {
        "coin": {
         "type": "string"
        },
        "down": {
         "description": "Worst move reached in the window, percentage points",
         "type": "number"
        },
        "pct": {
         "description": "Net move over the window, percentage points, e.g. 1.9",
         "type": "number"
        },
        "up": {
         "description": "Best move reached in the window, percentage points",
         "type": "number"
        },
        "windowMs": {
         "description": "Measurement window in milliseconds, e.g. 3600000",
         "type": "number"
        }
       },
       "type": "object"
      },
      "kind": {
       "description": "Item type: article, tweet or exchange (announcement); empty when the feed doesn't say",
       "type": "string"
      },
      "snippet": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "onChain": {
    "properties": {
     "chainName": {
      "type": "string"
     },
     "fees24hUsd": {
      "type": "number"
     },
     "fees30dUsd": {
      "type": "number"
     },
     "fees7dUsd": {
      "type": "number"
     },
     "feesChangePct24h": {
      "description": "24h fees change, percentage points",
      "type": "number"
     },
     "tvlUsd": {
      "description": "Total value locked, USD",
      "type": "number"
     }
    },
    "type": "object"
   },
   "predictionMarkets": {
    "items": {
     "properties": {
      "endDate": {
       "type": "string"
      },
      "liquidityUsd": {
       "type": "number"
      },
      "outcomes": {
       "items": {
        "properties": {
         "outcome": {
          "type": "string"
         },
         "probability": {
          "description": "Market-implied probability, 0-1",
          "type": "number"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "question": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "volumeUsd": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "providerCoverage": {
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "reason": {
       "description": "Present only when degraded or offline",
       "type": "string"
      },
      "status": {
       "description": "healthy, degraded, or offline",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "sections": {
    "description": "Per-section outcome, so an empty section can be told apart from a failed feed. Check this before reading an empty array as a real absence.",
    "items": {
     "properties": {
      "name": {
       "description": "Section key, e.g. news, narrative, catalysts",
       "type": "string"
      },
      "reason": {
       "description": "Present for not_applicable and unavailable",
       "type": "string"
      },
      "status": {
       "description": "ok, empty (feed answered, nothing for this symbol), not_applicable, or unavailable (feed failed)",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "social": {
    "properties": {
     "altRank": {
      "description": "1-based rank, lower is stronger",
      "type": "number"
     },
     "galaxyScore": {
      "description": "0-100 composite",
      "type": "number"
     },
     "interactions24h": {
      "type": "number"
     },
     "sentimentPct": {
      "description": "Bullish share, percentage points",
      "type": "number"
     },
     "socialDominancePct": {
      "description": "Share of total crypto social volume, percentage points",
      "type": "number"
     },
     "socialVolume24h": {
      "type": "number"
     },
     "symbol": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "symbol": {
    "type": "string"
   },
   "technicals": {
    "description": "In-house per-timeframe snapshots; same item shape as ta_technicals's timeframes. Empty when no timeframe could be analyzed.",
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "title": "Token Deep Dive"
}
