{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Dockerfile Linter"
 },
 "description": "Lint a Dockerfile against a rule-based subset of Hadolint checks: untagged or :latest base images, interactive or unpinned apt-get installs, apt list cleanup, apk cache, ADD for local files, shell-form CMD/ENTRYPOINT, running as root and a missing HEALTHCHECK. Lines joined with a trailing backslash count as one instruction, and each issue reports its line in the original file.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dockerfile": {
    "description": "Dockerfile content (full or partial), up to 8,192 characters.",
    "examples": [
     "example"
    ],
    "maxLength": 8192,
    "type": "string"
   }
  },
  "required": [
   "dockerfile"
  ],
  "type": "object"
 },
 "name": "dockerfile-linter",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "affiliate_context": {
    "additionalProperties": false,
    "properties": {
     "affiliate": {
      "type": "string"
     },
     "cta_label": {
      "type": "string"
     },
     "disclosure": {
      "type": "string"
     },
     "framing": {
      "type": "string"
     },
     "posture": {
      "enum": [
       "secondary"
      ],
      "type": "string"
     },
     "slot_id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     },
     "variant": {
      "type": "string"
     }
    },
    "required": [
     "affiliate",
     "cta_label",
     "disclosure",
     "framing",
     "posture",
     "slot_id",
     "url",
     "variant"
    ],
    "type": "object"
   },
   "computation_basis": {
    "type": "string"
   },
   "error_count": {
    "type": "number"
   },
   "info_count": {
    "type": "number"
   },
   "instruction_count": {
    "type": "number"
   },
   "interpretation": {
    "type": "string"
   },
   "issue_count": {
    "type": "number"
   },
   "issues": {
