{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Poll"},"description":"Ask people to vote: create returns url, a page to share. results returns status (open, closed, expired),\ntotal votes and each option's votes and percent; pass the last version with wait_seconds up to 30 to wait\nfor the next vote, or no version to wait until it closes. The poll closes after closes_in seconds, at\nmax_votes, or on close. One vote per browser and a per-address cap are soft guards, not identity.","inputSchema":{"properties":{"action":{"enum":["create","results","close","delete"],"title":"Action","type":"string"},"closes_in":{"anyOf":[{"maximum":604800,"minimum":10,"type":"integer"},{"type":"null"}],"default":null,"title":"Closes In"},"id":{"anyOf":[{"pattern":"^[A-Za-z0-9_-]{16,64}$","type":"string"},{"type":"null"}],"default":null,"title":"Id"},"max_choices":{"anyOf":[{"maximum":10,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Max Choices"},"max_votes":{"anyOf":[{"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Max Votes"},"multiple":{"anyOf":[{"type":"boolean"},{"type":"null"}],"default":null,"title":"Multiple"},"options":{"anyOf":[{"items":{"maxLength":200,"minLength":1,"type":"string"},"maxItems":10,"minItems":2,"type":"array"},{"type":"null"}],"default":null,"title":"Options"},"question":{"anyOf":[{"maxLength":300,"minLength":1,"type":"string"},{"type":"null"}],"default":null,"title":"Question"},"results":{"anyOf":[{"enum":["always","after_vote","after_close"],"type":"string"},{"type":"null"}],"default":null,"title":"Results"},"ttl_seconds":{"anyOf":[{"maximum":604800,"minimum":1,"type":"integer"},{"type":"null"}],"default":null,"title":"Ttl Seconds"},"version":{"anyOf":[{"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Version"},"wait_seconds":{"anyOf":[{"maximum":30,"minimum":0,"type":"integer"},{"type":"null"}],"default":null,"title":"Wait Seconds"}},"required":["action"],"title":"pollArguments","type":"object"},"name":"poll","title":"Poll"}
