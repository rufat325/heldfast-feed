{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check your store listing and review status"
 },
 "description": "Use this when someone asks about their own app's listing text per language, such as the title, subtitle, keywords or release notes, or whether the latest version is still in review or approved. Returns the metadata AppSkyline last synced for each locale, with the version, its review state and the keyword field's length against Apple's 100-character limit; longer texts are cut to 600 characters. Not for a live competitor listing.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "locale": {
    "description": "Only this locale, written as in the listing such as en-US or it; every synced locale when absent",
    "maxLength": 32,
    "type": "string"
   },
   "store": {
    "description": "Store listing to read: ios-app-store, macos-app-store, google-play or microsoft-store",
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   }
  },
  "required": [
   "appId",
   "store"
  ],
  "type": "object"
 },
 "name": "get_store_metadata",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "listings": {
    "description": "Metadata as last synced into AppSkyline, one row per locale; it may differ from what the store shows now. Long texts are cut to 600 characters.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "anyOf": [
        {
         "maxLength": 600,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "keywordCharacters": {
       "anyOf": [
        {
         "maximum": 200,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "keywords": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastSyncedAt": {
       "anyOf": [
        {
         "maxLength": 64,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "maxLength": 32,
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "promotionalText": {
       "anyOf": [
        {
         "maxLength": 600,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "state": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "subtitle": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "version": {
       "anyOf": [
        {
         "maxLength": 100,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "whatsNew": {
       "anyOf": [
        {
         "maxLength": 600,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "locale",
      "name",
      "subtitle",
      "keywords",
      "keywordCharacters",
      "promotionalText",
      "whatsNew",
      "description",
      "version",
      "state",
      "lastSyncedAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "localeFilter": {
    "anyOf": [
     {
      "maxLength": 32,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "returned": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "enum": [
     "found",
     "empty"
    ],
    "type": "string"
   },
   "store": {
    "enum": [
     "ios-app-store",
     "macos-app-store",
     "google-play",
     "microsoft-store"
    ],
    "type": "string"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "status",
   "appId",
   "store",
   "localeFilter",
   "listings",
   "returned",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Check your store listing and review status"
}
