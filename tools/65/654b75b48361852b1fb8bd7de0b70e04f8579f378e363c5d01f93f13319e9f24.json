{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Audit Auto Repair Quote"
 },
 "description": "Audit a mechanic quote, repair estimate, or bill from an image URL or pasted text against US fair market labor rates and parts benchmarks. Identifies potential overcharges, checks state statutory inspection fee caps, flags OBD-II diagnostic inconsistencies, and matches active shop coupons or manufacturer rebates to reduce out-of-pocket costs without adversarial confrontation. US only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "image_url": {
    "description": "URL or base64 data URI of the mechanic quote, invoice, or estimate image/PDF.",
    "type": "string"
   },
   "text": {
    "description": "Pasted plain text of the repair estimate, invoice, or list of line items with prices.",
    "type": "string"
   },
   "vehicle": {
    "description": "Vehicle details if known. Overrides or supplements details extracted from the document.",
    "properties": {
     "make": {
      "description": "Vehicle make, e.g. \"Toyota\"",
      "type": "string"
     },
     "mileage": {
      "description": "Vehicle mileage, e.g. \"65000\"",
      "type": "string"
     },
     "model": {
      "description": "Vehicle model, e.g. \"RAV4\"",
      "type": "string"
     },
     "vin": {
      "description": "17-character VIN if known",
      "type": "string"
     },
     "year": {
      "description": "Vehicle year, e.g. \"2019\"",
      "type": "string"
     }
    },
    "type": "object"
   },
   "zip": {
    "description": "5-digit US ZIP code where the repair is quoted. Used for localized labor rates and regional price parity.",
    "pattern": "^\\d{5}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "audit_repair_quote",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "best_coupon": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "merchant": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "same_shop": {
        "type": "boolean"
       },
       "title": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "url": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "merchant",
       "title",
       "amount",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Highest-value coupon or discount found for this repair job."
   },
   "clunker_alert": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Warning if the repair quote exceeds 50% of the vehicle value."
   },
   "coupon_savings": {
    "description": "Dollar savings specifically from active coupons or promotions.",
    "type": "number"
   },
   "document_type": {
    "description": "Type of document analyzed.",
    "enum": [
     "estimate",
     "receipt",
     "unknown"
    ],
    "type": "string"
   },
   "is_international": {
    "description": "True if the quote was detected as non-US or non-USD.",
    "type": "boolean"
   },
   "items": {
    "description": "Line-by-line audit of each repair task on the bill.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "advice": {
       "type": "string"
      },
      "fair_range": {
       "additionalProperties": false,
       "properties": {
        "high": {
         "type": "number"
        },
        "low": {
         "type": "number"
        }
       },
       "required": [
        "low",
        "high"
       ],
       "type": "object"
      },
      "is_diy_friendly": {
       "type": "boolean"
      },
      "quoted_price": {
       "type": "number"
      },
      "task": {
       "type": "string"
      },
      "verdict": {
       "enum": [
        "fair",
        "high",
        "questionable"
       ],
       "type": "string"
      }
     },
     "required": [
      "task",
      "quoted_price",
      "fair_range",
      "verdict",
      "advice",
      "is_diy_friendly"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "market_position": {
    "description": "How the total quote compares to fair market benchmarks.",
    "type": "string"
   },
   "potential_savings": {
    "description": "Actionable savings in USD available through verified coupons or rebates.",
    "type": "number"
   },
   "shop": {
    "additionalProperties": false,
    "properties": {
     "city": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "state": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "summary": {
    "description": "Human-readable breakdown of the audit, line item verdicts, and actionable deal savings.",
    "type": "string"
   },
   "total_quoted": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Total price quoted on the document in USD."
   },
   "vehicle": {
    "additionalProperties": false,
    "properties": {
     "make": {
      "type": "string"
     },
     "mileage": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "vin": {
      "type": "string"
     },
     "year": {
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "summary",
   "document_type",
   "is_international",
   "total_quoted",
   "potential_savings",
   "coupon_savings",
   "best_coupon",
   "items",
   "clunker_alert"
  ],
  "type": "object"
 },
 "title": "Audit Auto Repair Quote & Find Deals"
}
