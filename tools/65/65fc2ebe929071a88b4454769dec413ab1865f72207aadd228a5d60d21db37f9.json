{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "xcut.read",
     "xcut.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List calendar posts"
 },
 "description": "Use this when the user asks what content is planned or scheduled: posts on their XcutAI content calendar between two dates, optionally for one canvas, with status (draft, in review, approved, scheduled, published). Free. Do not use for posts already live on social media (use xcut_profile_analytics).",
 "inputSchema": {
  "properties": {
   "canvas_id": {
    "anyOf": [
     {
      "pattern": "^[0-9a-fA-F-]{36}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Only posts planned for this canvas (UUID). Omit for all canvases.",
    "title": "Canvas Id"
   },
   "end": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ISO date, e.g. 2026-10-31.",
    "title": "End"
   },
   "limit": {
    "default": 60,
    "description": "Most posts to return, 1-200. Default 60.",
    "maximum": 200,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "start": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ISO date, e.g. 2026-10-01.",
    "title": "Start"
   }
  },
  "title": "xcut_list_calendarArguments",
  "type": "object"
 },
 "name": "xcut_list_calendar",
 "securitySchemes": [
  {
   "scopes": [
    "xcut.read",
    "xcut.write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "List calendar posts"
}
