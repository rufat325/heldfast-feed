{
 "_meta": {
  "openai/outputTemplate": "ui://appskyline/app-overview-v13.html",
  "openai/toolInvocation/invoked": "Appskyline overview ready.",
  "openai/toolInvocation/invoking": "Loading Appskyline overview\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "appskyline:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://appskyline/app-overview-v13.html"
  },
  "ui/resourceUri": "ui://appskyline/app-overview-v13.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show app overview"
 },
 "description": "Use this when someone wants a quick overview of one of the apps they track in AppSkyline. Returns an overview card with the app's connected stores, locales and up to 50 tracked keywords. Not for keyword rankings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "appId": {
    "description": "AppSkyline app id (uuid)",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "appId"
  ],
  "type": "object"
 },
 "name": "show_app_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "app": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "defaultLocale": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "googlePlayId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "iosAppStoreId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locales": {
        "items": {
         "maxLength": 32,
         "type": "string"
        },
        "maxItems": 100,
        "type": "array"
       },
       "macosAppStoreId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "microsoftStoreId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "defaultLocale",
       "locales",
       "iosAppStoreId",
       "macosAppStoreId",
       "googlePlayId",
       "microsoftStoreId"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "keywordCount": {
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "keywords": {
    "description": "The first 50 tracked keywords; keywordCount has the total",
    "items": {
     "additionalProperties": false,
     "properties": {
      "country": {
       "anyOf": [
        {
         "maxLength": 10,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "language": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "term": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "term",
      "language",
      "country"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "storeCount": {
    "maximum": 4,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "app",
   "keywordCount",
   "storeCount",
   "keywords"
  ],
  "type": "object"
 },
 "title": "Show app overview"
}
