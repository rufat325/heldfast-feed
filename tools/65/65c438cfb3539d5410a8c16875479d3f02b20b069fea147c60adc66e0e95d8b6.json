{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Current rumors, leaks and confirmed items with confidence status and sources.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "description": "One of: released, confirmed, strong, speculative",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_rumors",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_via": {
    "description": "Source attribution for Endurance Wire",
    "type": "string"
   },
   "rumors": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "brand": {
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "detail": {
       "type": "string"
      },
      "href": {
       "type": "string"
      },
      "sources": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "label": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "label",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "released",
        "confirmed",
        "strong",
        "speculative"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "brand",
      "title",
      "status",
      "date",
      "detail",
      "sources"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "statuses": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Meaning of each confidence status",
    "type": "object"
   }
  },
  "required": [
   "_via",
   "statuses",
   "rumors"
  ],
  "type": "object"
 },
 "title": "Rumor tracker"
}
