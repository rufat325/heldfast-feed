{
 "_meta": {
  "category": "cost",
  "tier": "reporter"
 },
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Commitment report"
 },
 "description": "CFO-facing weekly aggregate against a previously-opened commitment record. Applies a Bayesian Beta(2,2) prior to realized-savings estimates and renders a markdown summary suitable for sharing. REQUIRES a commitment record opened by a prior configure_engine apply; without one there is no baseline to report against.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action_intent_path": {
    "description": "Override path to data/action-intent.json (relative to the gitops repo root or absolute). Used only when format=weekly_digest.",
    "type": "string"
   },
   "commitment_id": {
    "description": "Commitment record id (created by log10x_configure_engine on PR-merge). If omitted, resolves the most recent commitment for the active service.",
    "type": "string"
   },
   "environment": {
    "description": "Environment nickname; defaults to the active env.",
    "type": "string"
   },
   "format": {
    "default": "cfo_md",
    "description": "cfo_md=executive markdown with weekly chart and forward confidence; summary=typed envelope only; json=full structured data; weekly_digest=7-day operational digest from the recurring tick audit trail.",
    "enum": [
     "cfo_md",
     "summary",
     "json",
     "weekly_digest"
    ],
    "type": "string"
   },
   "history_path": {
    "description": "Override path to the recurring-tick JSONL audit trail (default: $LOG10X_RECUR_HISTORY_PATH or /tmp/log10x-recur-history.jsonl). Used only when format=weekly_digest.",
    "type": "string"
   },
   "period": {
    "default": "90d",
    "description": "Reporting window. 30d=last 30 days, 90d=last 90 days, ytd=since Jan 1 of current year.",
    "enum": [
     "30d",
     "90d",
     "ytd"
    ],
    "type": "string"
   },
   "service": {
    "description": "Service name to resolve a commitment by \u2014 used when commitment_id is omitted. When both are present, commitment_id wins.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "log10x_commitment_report",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "actions": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "args": {
       "additionalProperties": {},
       "default": {},
       "type": "object"
      },
      "reason": {
       "type": "string"
      },
      "role": {
       "enum": [
        "required-next",
        "recommended-next",
        "optional-followup",
        "alternative"
       ],
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "data": {},
   "generated_at": {
    "type": "string"
   },
   "images": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alt": {
       "type": "string"
      },
      "data": {
       "type": "string"
      },
      "mimeType": {
       "default": "image/png",
       "enum": [
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp"
       ],
       "type": "string"
      }
     },
     "required": [
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": "string"
   },
   "render_hint": {
    "additionalProperties": false,
    "properties": {
     "callouts": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "chart": {
      "enum": [
       "sparkline",
       "timeseries",
       "bar",
       "none"
      ],
      "type": "string"
     },
     "units": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "schema_epoch": {
    "type": "string"
   },
   "schema_version": {
    "const": "1.0",
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "bullets": {
      "items": {
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     "callout": {
      "type": "string"
     },
     "headline": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "headline"
    ],
    "type": "object"
   },
   "tool": {
    "type": "string"
   },
   "truncated": {
    "default": false,
    "type": "boolean"
   },
   "view": {
    "default": "summary",
    "enum": [
     "summary",
     "markdown"
    ],
    "type": "string"
   },
   "warnings": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "schema_version",
   "schema_epoch",
   "tool",
   "generated_at",
   "summary"
  ],
  "type": "object"
 },
 "title": "Commitment report"
}
