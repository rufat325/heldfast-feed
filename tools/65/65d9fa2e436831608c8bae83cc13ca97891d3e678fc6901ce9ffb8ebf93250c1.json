{
 "description": "Exports vibe coding sessions to various formats (Markdown, JSON, HTML). Use for creating shareable documentation, backups, or reports from session history.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bundleMultiple": {
    "default": true,
    "type": "boolean"
   },
   "format": {
    "enum": [
     "markdown",
     "json",
     "html"
    ],
    "type": "string"
   },
   "includeCodeBlocks": {
    "default": true,
    "type": "boolean"
   },
   "includeDesignDecisions": {
    "default": true,
    "type": "boolean"
   },
   "includeMetadata": {
    "default": true,
    "type": "boolean"
   },
   "outputPath": {
    "type": "string"
   },
   "sessionIds": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "template": {
    "default": "default",
    "enum": [
     "default",
     "minimal",
     "detailed",
     "report"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   }
  },
  "required": [
   "format"
  ],
  "type": "object"
 },
 "name": "muse_export_session"
}
