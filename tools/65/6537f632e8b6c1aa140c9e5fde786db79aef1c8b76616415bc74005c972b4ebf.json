{
 "description": "Get user notifications with filtering and pagination support",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "groups": {
    "items": {
     "enum": [
      "Comments",
      "DocumentChanges",
      "Mentions",
      "Security",
      "Space",
      "TaskChanges",
      "Team",
      "Import"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "lastLoadedDate": {
    "default": 0,
    "type": "number"
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "pinned": {
    "type": "boolean"
   },
   "readStatus": {
    "enum": [
     "All",
     "Read",
     "Unread"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_notifications"
}
