{
 "description": "Returns a written question",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "Written question on date specified",
    "type": "string"
   },
   "expandMember": {
    "description": "Expand the details of Members in the results",
    "type": [
     "boolean",
     "string"
    ]
   },
   "sessionStatus": {
    "anyOf": [
     {
      "const": "Current",
      "type": "string"
     },
     {
      "const": "Any",
      "type": "string"
     }
    ],
    "description": "Session status to get the Questions data for"
   },
   "uin": {
    "description": "Written question with uid specified",
    "type": "string"
   }
  },
  "required": [
   "date",
   "uin"
  ],
  "type": "object"
 },
 "name": "get_written_question_by_date_and_uin",
 "title": "get_written_question_by_date_and_uin"
}
