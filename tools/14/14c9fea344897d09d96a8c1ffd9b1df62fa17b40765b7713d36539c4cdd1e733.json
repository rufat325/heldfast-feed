{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Validate a manifest format"
 },
 "description": "Format check of a workflow YAML with the bundled Q-Core validator. The created-workflow policy of the local Q-Core is not applied. Runs no steps; accepts no secrets.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "registryPin": {
    "additionalProperties": false,
    "properties": {
     "catalog": {
      "maxLength": 200,
      "type": "string"
     },
     "catalogSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
     },
     "release": {
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$",
      "type": "string"
     }
    },
    "required": [
     "release",
     "catalog",
     "catalogSha256"
    ],
    "type": "object"
   },
   "yaml": {
    "maxLength": 65536,
    "type": "string"
   }
  },
  "required": [
   "yaml"
  ],
  "type": "object"
 },
 "name": "validate",
 "title": "Validate a manifest format"
}
