{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a Grok Bot guide"
 },
 "description": "One guide as plain text with its evidence label, update date and sources. Text is capped at about 12,000 characters; the URL has the full page.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "slug": {
    "description": "Guide slug from search_guides, e.g. 'skills-vs-routines'.",
    "maxLength": 120,
    "minLength": 1,
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_guide",
 "title": "Read a Grok Bot guide"
}
