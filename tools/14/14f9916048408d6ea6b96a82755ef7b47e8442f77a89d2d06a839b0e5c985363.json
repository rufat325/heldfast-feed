{
 "_meta": {
  "threadlinqs/catalog_note": "Served from the public catalog, not your authenticated tool list. Check THREADLINQS_API_KEY.",
  "threadlinqs/catalog_source": "public_catalog",
  "ui": {
   "resourceUri": "ui://threadlinqs/vulns",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Vulnerabilities"
 },
 "description": "Query the real-time CVE feed \u2014 validated against CVE.org and enriched from open sources (CVSS, EPSS exploitation probability, CISA KEV, public PoCs/exploits, nuclei detection templates, affected products/packages, plus platform-native trending/priority). Sort by trending|latest|priority|cvss|epss; filter by severity, kev (KEV-only), has_poc, nuclei, epss_min, window (days), vendor, cwe, or free-text query. Returns COMPACT cards {cve_id, severity, cvss, epss_percentile, is_kev, has_poc/exploit/nuclei, priority, trending, vendors, age} \u2014 call get_cve(id) for full detail.",
 "inputSchema": {
  "properties": {
   "cwe": {
    "description": "Weakness id, e.g. CWE-79",
    "type": "string"
   },
   "epss_min": {
    "description": "Minimum EPSS exploitation probability, 0-1",
    "type": "number"
   },
   "has_poc": {
    "description": "Only CVEs with a public proof-of-concept",
    "type": "boolean"
   },
   "kev": {
    "description": "Only CISA KEV (known-exploited) CVEs",
    "type": "boolean"
   },
   "limit": {
    "description": "default 30, max 100",
    "type": "number"
   },
   "nuclei": {
    "description": "Only CVEs with a nuclei detection template",
    "type": "boolean"
   },
   "query": {
    "description": "Free-text: a CVE id or keyword (matches id + description)",
    "type": "string"
   },
   "severity": {
    "description": "CRITICAL | HIGH | MEDIUM | LOW",
    "type": "string"
   },
   "sort": {
    "description": "trending (default) | latest | priority | cvss | epss",
    "type": "string"
   },
   "vendor": {
    "description": "Affected vendor/product substring",
    "type": "string"
   },
   "window": {
    "description": "Only CVEs published within the last N days",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_vulnerabilities",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "facets": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "pagination": {
    "additionalProperties": true,
    "properties": {
     "has_more": {
      "type": "boolean"
     },
     "limit": {
      "type": "integer"
     },
     "offset": {
      "type": "integer"
     }
    },
    "type": "object"
   },
   "sort": {
    "type": "string"
   },
   "total": {
    "type": "integer"
   },
   "vulnerabilities": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "cve_id": {
       "description": "Pass to get_cve / get_cve_intelligence / bulk_get_cves.",
       "type": "string"
      },
      "cvss": {
       "type": "number"
      },
      "epss": {
       "type": "number"
      },
      "has_poc": {
       "type": "boolean"
      },
      "is_kev": {
       "type": "boolean"
      },
      "priority": {
       "type": "number"
      },
      "severity": {
       "type": "string"
      },
      "threat_count": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "vulnerabilities"
  ],
  "type": "object"
 },
 "title": "Search Vulnerabilities"
}
