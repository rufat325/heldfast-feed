{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "category": "qa",
 "description": "Define a test suite for a prompt: provide the system prompt, user prompt, and expected output criteria. Returns a test plan with scored rubric \u2014 use this as input for manual or automated LLM evaluation.",
 "inputSchema": {
  "properties": {
   "adversarial_prompts": {
    "description": "Auto-generate adversarial test variants (jailbreak, injection, edge cases)",
    "type": "boolean"
   },
   "check_safety": {
    "description": "Include safety/PII checks in the rubric",
    "type": "boolean"
   },
   "expected_behavior": {
    "description": "Description of what the LLM should do (free text)",
    "type": "string"
   },
   "expected_format": {
    "description": "Expected output format",
    "enum": [
     "json",
     "markdown",
     "code",
     "plain",
     "any"
    ],
    "type": "string"
   },
   "max_tokens": {
    "description": "Max token budget for the test",
    "type": "number"
   },
   "must_include": {
    "description": "Required content (comma-separated)",
    "type": "string"
   },
   "must_not_include": {
    "description": "Forbidden content (comma-separated)",
    "type": "string"
   },
   "system_prompt": {
    "description": "The system prompt under test",
    "type": "string"
   },
   "temperature": {
    "description": "Temperature to use",
    "type": "number"
   },
   "user_prompt": {
    "description": "The user prompt to send",
    "type": "string"
   }
  },
  "required": [
   "system_prompt",
   "user_prompt"
  ],
  "type": "object"
 },
 "name": "prompt_test_suite",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "categories": {
    "type": "array"
   },
   "instructions": {
    "type": "string"
   },
   "rubric": {},
   "test_suite_name": {
    "type": "string"
   },
   "total_tests": {
    "type": "number"
   }
  },
  "type": "object"
 }
}
