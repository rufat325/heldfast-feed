{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Export a built-in example as DXF or tiled 1:1 PDF and return a temporary download_url. Uploaded-part exports require the signed-in website or an authenticated local adapter; this hosted workspace cannot be linked to a website account. Use layout=true with a layout_id to export all example pieces. Download before workspace expiry.",
 "inputSchema": {
  "properties": {
   "format": {
    "default": "dxf",
    "enum": [
     "dxf",
     "pdf"
    ],
    "title": "Format",
    "type": "string"
   },
   "grid": {
    "default": 0,
    "maximum": 50,
    "minimum": 0,
    "title": "Grid",
    "type": "integer"
   },
   "layout": {
    "default": false,
    "title": "Layout",
    "type": "boolean"
   },
   "paper": {
    "default": "a4",
    "enum": [
     "a4",
     "letter",
     "a3"
    ],
    "title": "Paper",
    "type": "string"
   },
   "result_id": {
    "pattern": "^[A-Za-z0-9_-]{1,80}$",
    "title": "Result Id",
    "type": "string"
   },
   "workspace_id": {
    "pattern": "^[0-9a-f]{48}$",
    "title": "Workspace Id",
    "type": "string"
   }
  },
  "required": [
   "workspace_id",
   "result_id"
  ],
  "title": "export_patternArguments",
  "type": "object"
 },
 "name": "export_pattern",
 "outputSchema": {
  "additionalProperties": true,
  "title": "export_patternDictOutput",
  "type": "object"
 }
}
