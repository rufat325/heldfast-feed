{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validate whether a structured authority envelope contains enough explicit constraints for ScopeProof to evaluate one action. Free. Returns no substantive authorization verdict and accepts no credentials, raw prompts, arbitrary request bodies, or secrets.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": false,
    "properties": {
     "amount": {
      "additionalProperties": false,
      "properties": {
       "amountMinor": {
        "minimum": 0,
        "type": "integer"
       },
       "currency": {
        "pattern": "^[A-Z]{3}$",
        "type": "string"
       }
      },
      "required": [
       "amountMinor",
       "currency"
      ],
      "type": "object"
     },
     "dataClass": {
      "maxLength": 80,
      "type": "string"
     },
     "destructive": {
      "description": "Set true when the proposed action is destructive even if its action type or HTTP method is not intrinsically classified as destructive.",
      "type": "boolean"
     },
     "environment": {
      "maxLength": 80,
      "type": "string"
     },
     "irreversible": {
      "type": "boolean"
     },
     "method": {
      "maxLength": 12,
      "type": "string"
     },
     "resource": {
      "maxLength": 1024,
      "type": "string"
     },
     "tool": {
      "maxLength": 200,
      "type": "string"
     },
     "type": {
      "maxLength": 64,
      "type": "string"
     }
    },
    "required": [
     "type",
     "resource"
    ],
    "type": "object"
   },
   "authority": {
    "additionalProperties": false,
    "properties": {
     "allowDestructive": {
      "type": "boolean"
     },
     "allowIrreversible": {
      "type": "boolean"
     },
     "allowedActions": {
      "items": {
       "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
     },
     "allowedResources": {
      "items": {
       "type": "string"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
     },
     "approvalRequiredFor": {
      "items": {
       "type": "string"
      },
      "maxItems": 32,
      "type": "array"
     },
     "dataClasses": {
      "items": {
       "type": "string"
      },
      "maxItems": 32,
      "type": "array"
     },
     "deniedActions": {
      "items": {
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     },
     "deniedResources": {
      "items": {
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     },
     "environments": {
      "items": {
       "type": "string"
      },
      "maxItems": 32,
      "type": "array"
     },
     "expiresAt": {
      "format": "date-time",
      "type": "string"
     },
     "issuedAt": {
      "format": "date-time",
      "type": "string"
     },
     "maxSpend": {
      "additionalProperties": false,
      "properties": {
       "amountMinor": {
        "minimum": 0,
        "type": "integer"
       },
       "currency": {
        "pattern": "^[A-Z]{3}$",
        "type": "string"
       }
      },
      "required": [
       "amountMinor",
       "currency"
      ],
      "type": "object"
     },
     "methods": {
      "items": {
       "type": "string"
      },
      "maxItems": 24,
      "type": "array"
     },
     "notBefore": {
      "format": "date-time",
      "type": "string"
     },
     "principal": {
      "maxLength": 160,
      "type": "string"
     },
     "schemaVersion": {
      "maxLength": 64,
      "type": "string"
     },
     "tools": {
      "items": {
       "type": "string"
      },
      "maxItems": 64,
      "type": "array"
     }
    },
    "required": [
     "allowedActions",
     "allowedResources"
    ],
    "type": "object"
   },
   "context": {
    "additionalProperties": false,
    "properties": {
     "humanApprovalPresent": {
      "description": "Caller assertion that required human approval has already occurred. ScopeProof records this as caller-asserted and does not independently verify the human identity or approval event.",
      "type": "boolean"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "authority",
   "action"
  ],
  "type": "object"
 },
 "name": "preflight",
 "title": "Preflight authority envelope"
}
