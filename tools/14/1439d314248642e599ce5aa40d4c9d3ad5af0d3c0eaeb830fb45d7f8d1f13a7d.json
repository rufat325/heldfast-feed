{
 "description": "Skill Hub: browse, read, publish, buy, and rate knowledge guides. Browse is public; publish/buy require API key. Covers Skill 24.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "hub_browse",
     "hub_read",
     "hub_publish",
     "hub_buy",
     "hub_rate"
    ],
    "type": "string"
   },
   "content": {
    "description": "Guide content for publish",
    "type": "string"
   },
   "guide_id": {
    "description": "Guide ID",
    "type": "string"
   },
   "limit": {
    "description": "Max results",
    "type": "number"
   },
   "price_xc": {
    "description": "Price in XC for publish",
    "type": "number"
   },
   "rating": {
    "description": "Rating 1-5",
    "type": "number"
   },
   "review": {
    "description": "Review text",
    "type": "string"
   },
   "title": {
    "description": "Guide title for publish",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "skill_hub"
}
