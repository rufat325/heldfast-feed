{
 "description": "Records how a day or session actually felt, rated 1-10: perceived effort (rpe), soreness, or mood. Garmin has no equivalent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "description": "ISO date the rating is for",
    "type": "string"
   },
   "kind": {
    "description": "Which rating this is",
    "enum": [
     "rpe",
     "soreness",
     "mood"
    ],
    "type": "string"
   },
   "note": {
    "description": "Optional free-text detail",
    "type": "string"
   },
   "value": {
    "description": "A rating from 1 to 10",
    "type": "number"
   }
  },
  "required": [
   "kind",
   "value"
  ],
  "type": "object"
 },
 "name": "log_subjective"
}
