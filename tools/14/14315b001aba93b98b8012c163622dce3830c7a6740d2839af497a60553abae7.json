  "title": "Screen a name against US, UK and EU sanctions lists"
 },
 "description": "Is this person, company, vessel or aircraft sanctioned? One name screened against the OFAC SDN and consolidated lists, the UK Sanctions List and the EU financial sanctions list, read from the governments' own files (each list's date returned). Fuzzy, word-order-free: aliases and one-letter typos match, a different surname does not. Each match gives list, programmes, countries, birth dates and UN reference. Optional type, country, birth year. Input: name. $0.05 per call. Returns: query{}, verdict (potential_match | no_match), match_count, matches[{list, list_name, id, name, matched_name, score, type, programs[], countries[], birth_dates[], un_reference, listed_on, source_url}], lists[{list, name, publisher, license, source_url, as_of, entries, loaded}], notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "birth_year": {
    "description": "Optional, for people: a listing whose recorded birth years are all more than a year away is dropped.",
    "maximum": 2030,
    "minimum": 1880,
    "type": "integer"
   },
   "country": {
    "description": "Optional country (Iran, Russia): a listing that records only other countries is dropped.",
    "maxLength": 60,
    "type": "string"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "limit": {
    "description": "Most matches returned, 1-50. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "lists": {
    "description": "Optional subset of lists to screen. Default all four.",
    "items": {
     "enum": [
      "ofac_sdn",
      "ofac_consolidated",
      "uk",
      "eu"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "The person, company, vessel or aircraft name, in any word order.",
    "maxLength": 200,
    "minLength": 2,
    "type": "string"
   },
   "threshold": {
    "description": "Minimum match score, 0.6-1. Default 0.85.",
    "maximum": 1,
    "minimum": 0.6,
    "type": "number"
   },
   "type": {
    "description": "Only match this kind of listing. Default any.",
    "enum": [
     "any",
     "person",
     "entity",
     "vessel",
     "aircraft"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
