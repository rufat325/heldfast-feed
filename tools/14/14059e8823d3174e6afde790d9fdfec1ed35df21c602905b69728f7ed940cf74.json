{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new editable text file at a new project path from supplied content. Pass an explicit empty string to create an empty file. Existing paths are never overwritten.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "type": "string"
   },
   "path": {
    "minLength": 1,
    "type": "string"
   },
   "projectId": {
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "path",
   "content"
  ],
  "type": "object"
 },
 "name": "create_file",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "file": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "source",
       "asset"
      ],
      "type": "string"
     },
     "mimeType": {
      "type": [
       "string",
       "null"
      ]
     },
     "path": {
      "type": "string"
     },
     "revision": {
      "type": "integer"
     },
     "sizeBytes": {
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "required": [
     "kind",
     "mimeType",
     "path",
     "revision",
     "sizeBytes"
    ],
    "type": "object"
   },
   "status": {
    "const": "created",
    "type": "string"
   }
  },
  "required": [
   "file",
   "status"
  ],
  "type": "object"
 },
 "title": "Create a text project file"
}
