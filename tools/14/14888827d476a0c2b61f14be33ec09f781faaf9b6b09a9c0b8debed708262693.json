{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create project phase"
 },
 "description": "Create a new project phase. Requires project_phases:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "description": {
    "description": "Description",
    "type": "string"
   },
   "end_date": {
    "description": "End date (ISO 8601)",
    "type": "string"
   },
   "name": {
    "description": "Phase name (required)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "project_id": {
    "description": "Project ID (required)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "sequence_order": {
    "description": "Order within the project. Defaults to after the last existing phase.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "start_date": {
    "description": "Start date (ISO 8601)",
    "type": "string"
   },
   "status": {
    "description": "Phase status",
    "enum": [
     "pending",
     "in_progress",
     "completed",
     "skipped"
    ],
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_project_phase",
 "title": "Create project phase"
}
