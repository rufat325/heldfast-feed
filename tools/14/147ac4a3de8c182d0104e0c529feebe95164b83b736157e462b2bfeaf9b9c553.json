{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Delegate a task to the fundi agent, or check on one. Submit-and-poll: `submit` returns a task id immediately and never waits for the run. Needs sign-in: fundi runs as your Mzizi console user.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "submit",
     "task_status",
     "cancel"
    ],
    "type": "string"
   },
   "instruction": {
    "description": "What fundi should do. Required for submit.",
    "type": "string"
   },
   "skill": {
    "description": "Required for submit.",
    "enum": [
     "security-scan",
     "chaos-run",
     "a11y-audit",
     "heal-issue"
    ],
    "type": "string"
   },
   "taskId": {
    "description": "Required for task_status and cancel.",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mzizi_fundi",
 "title": "fundi"
}
