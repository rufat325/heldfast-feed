{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List the sets you created for this learner, newest first, each with a progress summary. Use it to find a setId, or to see at a glance which sets were never opened.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "includeProgress": {
    "description": "Attach a progress summary to each set (default true)",
    "type": "boolean"
   },
   "limit": {
    "description": "How many sets to return, newest first (default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "topic": {
    "description": "Only sets with this exact topic tag",
    "maxLength": 500,
    "type": "string"
   },
   "userId": {
    "description": "Firebase UID of the learner. Omit to use the server default",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_study_sets",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "sets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "cardCount": {
       "type": "number"
      },
      "createdAt": {
       "type": "number"
      },
      "progress": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "coveragePercent": {
           "type": "number"
          },
          "dueNow": {
           "type": "number"
          },
          "firstActivity": {
           "type": [
            "number",
            "null"
           ]
          },
          "lastActivity": {
           "type": [
            "number",
            "null"
           ]
          },
          "learning": {
           "type": "number"
          },
          "mastered": {
           "type": "number"
          },
          "masteryPercent": {
           "type": "number"
          },
          "notStarted": {
           "type": "number"
          },
          "struggling": {
           "type": "number"
          },
          "studied": {
           "type": "number"
          },
          "totalCards": {
           "type": "number"
          },
          "totalReviews": {
           "type": "number"
          }
         },
         "required": [
          "totalCards",
          "studied",
          "notStarted",
          "struggling",
          "learning",
          "mastered",
          "coveragePercent",
          "masteryPercent"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "setId": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "topic": {
       "type": [
        "string",
        "null"
       ]
      },
      "updatedAt": {
       "type": "number"
      },
      "userId": {
       "type": "string"
      },
      "visibility": {
       "type": "string"
      }
     },
     "required": [
      "setId",
      "title",
      "cardCount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "sets"
  ],
  "type": "object"
 },
 "title": "List study sets"
}
