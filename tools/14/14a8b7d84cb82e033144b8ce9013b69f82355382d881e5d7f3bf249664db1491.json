{
 "description": "Create a new data key for custom targeting",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Data key name (max 32 chars, must be unique)",
    "type": "string"
   },
   "type": {
    "description": "Data key value type",
    "enum": [
     "STRING",
     "NUMBER",
     "DATE",
     "DATETIME",
     "TIME"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "type"
  ],
  "type": "object"
 },
 "name": "create_data_key"
}
