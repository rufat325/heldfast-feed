{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check room availability and prices"
 },
 "description": "Use this when someone asks if rooms are free for certain dates or what a stay would cost. Returns the room types and rate plans with a free room every night for the party, with rooms left and nightly and total prices in minor currency units. Stays of 1\u201330 nights, check-in within 365 days. Not for making a booking.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "description": "Adults staying, from 1 to 20; defaults to 2",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "checkInDate": {
    "description": "Arrival date as YYYY-MM-DD, from today to 365 days ahead in the hotel's timezone",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "checkOutDate": {
    "description": "Departure date as YYYY-MM-DD, 1 to 30 nights after checkInDate",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "children": {
    "description": "Children staying, from 0 to 20; defaults to 0",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "hotelId": {
    "description": "Hotel id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "infants": {
    "description": "Infants staying, from 0 to 20; defaults to 0",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "hotelId",
   "checkInDate",
   "checkOutDate"
  ],
  "type": "object"
 },
 "name": "get_hotel_availability",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "offers": {
    "description": "One row per bookable room type and rate plan with a free room every night. Amounts are integer minor currency units (12000 is 120.00 in a two-decimal currency). Guest records, reservations, room assignments, access data, notes, payments, channel references, photos, free-text descriptions and credentials are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "availableRooms": {
       "anyOf": [
        {
         "maximum": 100000,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "currency": {
       "$ref": "#/properties/offers/items/properties/roomTypeName"
      },
      "mealPlan": {
       "$ref": "#/properties/offers/items/properties/roomTypeName"
      },
      "nightlyRate": {
       "anyOf": [
        {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "nightlyRates": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "date": {
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "type": "string"
         },
         "price": {
          "$ref": "#/properties/offers/items/properties/nightlyRate"
         }
        },
        "required": [
         "date",
         "price"
        ],
        "type": "object"
       },
       "maxItems": 30,
       "type": "array"
      },
      "ratePlanId": {
       "$ref": "#/properties/offers/items/properties/roomTypeId"
      },
      "ratePlanTitle": {
       "$ref": "#/properties/offers/items/properties/roomTypeName"
      },
      "roomTypeId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "roomTypeName": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sellMode": {
       "$ref": "#/properties/offers/items/properties/roomTypeName"
      },
      "totalPrice": {
       "$ref": "#/properties/offers/items/properties/nightlyRate"
      }
     },
     "required": [
      "roomTypeId",
      "roomTypeName",
      "ratePlanId",
      "ratePlanTitle",
      "mealPlan",
      "sellMode",
      "availableRooms",
      "nightlyRate",
      "totalPrice",
      "currency",
      "nightlyRates"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "offersAreTruncated": {
    "description": "True when more than 100 offers matched the search",
    "type": "boolean"
   },
   "search": {
    "additionalProperties": false,
    "properties": {
     "adults": {
      "maximum": 20,
      "minimum": 1,
      "type": "integer"
     },
     "checkInDate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "checkOutDate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "children": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     },
     "infants": {
      "maximum": 20,
      "minimum": 0,
      "type": "integer"
     },
     "nights": {
      "maximum": 30,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "checkInDate",
     "checkOutDate",
     "nights",
     "adults",
     "children",
     "infants"
    ],
    "type": "object"
   }
  },
  "required": [
   "search",
   "offers",
   "offersAreTruncated"
  ],
  "type": "object"
 },
 "title": "Check room availability and prices"
}
