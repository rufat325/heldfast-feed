{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add a collection to a model by type and model ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Collection ID to add",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "modelId": {
    "description": "Model/HTR ID",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Model type (e.g. htr, la, ocr)",
    "pattern": "^[^/\\s]+$",
    "type": "string"
   }
  },
  "required": [
   "type",
   "modelId",
   "collId"
  ],
  "type": "object"
 },
 "name": "transkribus_model_add_collection",
 "title": "Add Collection to Model"
}
