{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"Generate a GST-compliant tax invoice as a PDF on the user's computer (supplier and buyer details, HSN/SAC, tax split, place of supply, reverse charge, amount in words, bank/UPI details). Returns the file path and the tax breakdown. Ask the user for any missing supplier or buyer details instead of inventing them.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"bank_details":{"properties":{"account_name":{"type":"string"},"account_number":{"type":"string"},"bank":{"type":"string"},"ifsc":{"type":"string"},"upi_id":{"type":"string"}},"type":"object"},"buyer":{"properties":{"address":{"type":"string"},"email":{"type":"string"},"gstin":{"type":"string"},"name":{"type":"string"},"phone":{"type":"string"},"state":{"description":"State name; needed if the party has no GSTIN","type":"string"}},"required":["name","address"],"type":"object"},"due_date":{"description":"YYYY-MM-DD","type":"string"},"invoice_date":{"description":"YYYY-MM-DD, defaults to today","type":"string"},"invoice_number":{"description":"Unique invoice number, max 16 chars (letters, digits, / or -)","type":"string"},"items":{"items":{"properties":{"cess_rate":{"description":"Compensation cess in percent, if any","minimum":0,"type":"number"},"description":{"description":"Item or service description","type":"string"},"discount":{"description":"Flat discount in rupees for this line","minimum":0,"type":"number"},"gst_rate":{"description":"GST rate in percent, e.g. 5, 18, 40","maximum":100,"minimum":0,"type":"number"},"hsn_sac":{"description":"HSN code (goods) or SAC code (services)","type":"string"},"quantity":{"exclusiveMinimum":0,"type":"number"},"rate":{"description":"Price per unit in rupees","minimum":0,"type":"number"},"unit":{"description":"Unit, e.g. Nos, Kg, Hrs","type":"string"}},"required":["description","quantity","rate","gst_rat