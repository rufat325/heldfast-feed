    "description": "Exact npm package name",
    "maxLength": 214,
    "minLength": 1,
    "type": "string"
   },
   "version": {
    "description": "Exact version string, e.g. \"4.17.21\"",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "name",
   "version"
  ],
  "type": "object"
 },
 "name": "get_package_version",
