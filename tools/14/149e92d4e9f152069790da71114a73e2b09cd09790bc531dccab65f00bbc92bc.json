{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Npi Search Provider"
 },
 "description": "Search individual US healthcare providers by name. Requires a last_name (first_name, state, city optional). Returns NPI, specialty, location for each match.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "city": {
    "description": "City to narrow results (optional).",
    "type": "string"
   },
   "first_name": {
    "description": "Provider first name (optional).",
    "type": "string"
   },
   "last_name": {
    "description": "Provider last name (required).",
    "type": "string"
   },
   "limit": {
    "description": "Max results (1-50, default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "description": "Two-letter state code to narrow results (optional).",
    "type": "string"
   }
  },
  "required": [
   "last_name"
  ],
  "type": "object"
 },
 "name": "npi_search_provider"
}
