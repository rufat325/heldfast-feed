{
 "description": "Create a two-hour worker-equivalent Preview session pinned to one exact draft revision or published version. Preview state is isolated from worker progress, Forms attempts, Project To-dos, notifications, reporting, and completion events. Requires lms:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "completionPolicy": {
    "enum": [
     "SYSTEM",
     "EMPLOYER_REVIEW"
    ],
    "type": "string"
   },
   "courseId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "draftRevision": {
    "minimum": 0,
    "type": "integer"
   },
   "idempotencyKey": {
    "description": "Stable idempotency key. Reuse only for the identical operation.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "itemId": {
    "$ref": "#/properties/courseId"
   },
   "lessonKey": {
    "$ref": "#/properties/courseId"
   },
   "masteryAntiGuessPolicy": {
    "additionalProperties": false,
    "properties": {
     "cooldownStepsSeconds": {
      "items": {
       "maximum": 3600,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 10,
      "minItems": 1,
      "type": "array"
     },
     "restartScope": {
      "enum": [
       "WHOLE_MODULE",
       "MISSED_QUESTIONS"
      ],
      "type": "string"
     },
     "schemaVersion": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "schemaVersion",
     "cooldownStepsSeconds",
     "restartScope"
    ],
    "type": "object"
   },
   "masteryMode": {
    "type": "boolean"
   },
   "masteryRunLimit": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "moduleKey": {
    "$ref": "#/properties/courseId"
   },
   "publishedVersionId": {
    "$ref": "#/properties/courseId"
   }
  },
  "required": [
   "courseId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_create_preview_session",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
