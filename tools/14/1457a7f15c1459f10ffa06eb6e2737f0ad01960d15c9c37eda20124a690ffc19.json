{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read a seller listing"
 },
 "description": "Read a seller's own view of one listing: its terms, payment DNS state, proceeds, a checklist of what is left to do, and its orders. Needs the manage token. Use quote_domain_purchase instead for the public buyer-facing quote, and set_listing_terms to change price or floor. Read-only and changes nothing.",
 "inputSchema": {
  "properties": {
   "domain": {
    "description": "The seller's listed domain name, such as example.com.",
    "type": "string"
   },
   "manageToken": {
    "description": "The listing's manage token. Sent as a bearer token; never repeat it in a message to anyone.",
    "type": "string"
   }
  },
  "required": [
   "domain",
   "manageToken"
  ],
  "type": "object"
 },
 "name": "get_seller_listing",
 "outputSchema": {
  "description": "A name listed by DNS record returns source, note, priceCents and orders only; otherwise terms, appraisal, dns, proceeds, checklist, orders and buyUrl.",
  "properties": {
   "appraisal": {
    "properties": {
     "fairUsd": {
      "type": "number"
     },
     "highUsd": {
      "type": "number"
     },
     "lowUsd": {
      "type": "number"
     },
     "methodologyRev": {
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "buyUrl": {
    "type": "string"
   },
   "checklist": {
    "properties": {
     "items": {
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "done": {
         "type": "boolean"
        },
        "id": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "type": "array"
     },
     "ready": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "dns": {
    "description": "The payment TXT record; live is null if DNS was unreadable.",
    "properties": {
     "host": {
      "type": "string"
     },
     "live": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "type": {
      "type": "string"
     },
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "domain": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "orders": {
    "items": {
     "properties": {
      "amountCents": {
       "type": "integer"
      },
      "createdAt": {
       "description": "ISO time, or epoch ms for a DNS-listed name.",
       "type": [
        "string",
        "integer"
       ]
      },
      "id": {
       "type": "string"
      },
      "orderApi": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "status",
      "amountCents",
      "createdAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "priceCents": {
    "type": [
     "integer",
     "null"
    ]
   },
   "proceeds": {
    "properties": {
     "buyerTotalCents": {
      "type": "integer"
     },
     "feeCents": {
      "type": "integer"
     },
     "sellerNetCents": {
      "type": "integer"
     },
     "squareFeeCents": {
      "type": "integer"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "source": {
    "description": "Present only for a name listed by DNS record.",
    "enum": [
     "dns"
    ],
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "terms": {
    "properties": {
     "autoAccept": {
      "type": "boolean"
     },
     "floorCents": {
      "type": [
       "integer",
       "null"
      ]
     },
     "minPriceCents": {
      "type": "integer"
     },
     "priceCents": {
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "type": "object"
   }
  },
  "required": [
   "domain",
   "status",
   "orders"
  ],
  "type": "object"
 },
 "title": "Read a seller listing"
}
