    "description": "The bounce message, the SMTP reply or the Authentication-Results line, as pasted. When the bounce runs past 4,000 characters, pass the lines with the error code and the reason.",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
