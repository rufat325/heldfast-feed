{
 "description": "Immutable daily rates for uids and UTC days (POST /v1/rates/daily). Days are UTC calendar dates (YYYY-MM-DD) in the past. Crypto history older than about a year is served at daily granularity from daily candles (source s8) back to the earliest day each asset has; an asset with no such history is out_of_range. Each item carries a status: ok = exact immutable rate; out_of_range = the day is before the archive start, after today UTC, before the first available day of a crypto asset, or before the asset was listed (final, do not retry); pending = transient upstream miss, retry after retry_after seconds; unsupported = unknown uid. Limits (assets, quotes, assets times days) are in get_meta. Edge cases: read resource ratehub://docs/behavior (behaviour notes).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "assets": {
    "description": "Catalog uids",
    "items": {
     "maximum": 4294967295,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "days": {
    "description": "Past UTC calendar days, YYYY-MM-DD",
    "items": {
     "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
     "type": "string"
    },
    "maxItems": 1000,
    "minItems": 1,
    "type": "array"
   },
   "vs": {
    "description": "Quote currencies",
    "items": {
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "assets",
   "vs",
   "days"
  ],
  "type": "object"
 },
 "name": "get_daily",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "build": {
    "type": "string"
   },
   "rates": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "day": {
       "type": "string"
      },
      "prices": {
       "additionalProperties": {
        "type": "string"
       },
       "type": [
        "null",
        "object"
       ]
      },
      "retry_after": {
       "type": [
        "null",
        "integer"
       ]
      },
      "source": {
       "type": [
        "null",
        "string"
       ]
      },
      "status": {
       "type": "string"
      },
      "type": {
       "type": [
        "null",
        "string"
       ]
      },
      "uid": {
       "maximum": 4294967295,
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "day",
      "status",
      "uid"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "server_time": {
    "type": "string"
   }
  },
  "required": [
   "build",
   "rates",
   "server_time"
  ],
  "type": "object"
 }
}
