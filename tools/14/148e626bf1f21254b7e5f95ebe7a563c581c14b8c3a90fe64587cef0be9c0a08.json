 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Citation / DOI lookup"
 },
 "description": "Resolve a DOI \u2014 or search a paper title \u2014 to full citation metadata: title, authors, journal, year, citations count, publisher, license, and a ready-made APA/BibTeX citation. Crossref's open metadata (150M+ works). Search mode returns the top matches for a title/author query. When to use: For citation metadata of a known paper; to search preprints by topic use arxiv_search. Price: $0.001 per call (10 free/day; after that a payment-required result lists x402 options). Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "doi": {
    "description": "e.g. 10.1038/nature14539",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "description": "How many matches to return when searching by title. Range 1-20. Default 5.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "title/author search instead of a DOI",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "doi_lookup",
 "outputSchema": {
