{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Latest parsed reserve attestation for one stablecoin issuer as JSON: as_of date, total reserves, composition by asset category, attestor, source_url, current on-chain supply (DefiLlama) and the reserve ratio. Use it when an agent needs machine-readable backing data instead of reading the issuer's PDF. Pass symbol (USDC, USDT, ...) or issuer; period=YYYY-MM selects an earlier month. Issuers without a third-party attestation return supply only with confidence 'none'. Paid: $0.02 per call; without credit you get a PAYMENT_REQUIRED result. Set sample=true for a free example response.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "issuer": {
    "description": "Issuer name or registry id when the symbol is unknown, e.g. \"circle\" or \"paxos\"",
    "minLength": 1,
    "type": "string"
   },
   "period": {
    "description": "Report month as YYYY-MM. Default: the newest parsed month. See history_available.",
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   },
   "sample": {
    "default": false,
    "description": "Set true to return an example response at no charge (sample mode). Default false.",
    "type": "boolean"
   },
   "symbol": {
    "description": "Token symbol, case-insensitive: USDC, USDT, PYUSD, RLUSD, ... (see stablecoin_list_issuers)",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "stablecoin_reserves",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "type": [
     "string",
     "null"
    ]
   },
   "attestation_type": {
    "type": "string"
   },
   "attestor": {
    "type": [
     "string",
     "null"
    ]
   },
   "backing": {
    "type": "string"
   },
   "cadence": {
    "type": "string"
   },
   "checks": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "composition_gap": {
        "type": "number"
       },
       "composition_sums_to_total": {
        "type": "boolean"
       },
       "reserves_cover_circulation": {
        "type": [
         "boolean",
         "null"
        ]
       }
      },
      "required": [
       "composition_sums_to_total",
       "composition_gap",
       "reserves_cover_circulation"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "composition": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount_usd": {
       "type": "number"
      },
      "category": {
       "enum": [
        "cash_at_banks",
        "cash_in_fund",
        "us_treasury_bills",
        "us_treasury_repo",
        "money_market_fund",
        "tokenized_fund",
        "other_government_securities",
        "commercial_paper",
        "corporate_bonds",
        "precious_metals",
        "bitcoin",
        "secured_loans",
        "crypto_collateral",
        "receivables_adjustments",
        "other"
       ],
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "share": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "category",
      "label",
      "amount_usd",
      "share"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "confidence": {
    "enum": [
     "high",
     "medium",
     "low",
     "none"
    ],
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "history_available": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "issued_on": {
    "type": [
     "string",
     "null"
    ]
   },
   "issuer": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "onchain_supply": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount": {
        "type": "number"
       },
       "as_of": {
        "type": "string"
       },
       "currency": {
        "type": "string"
       },
       "defillama_id": {
        "type": "string"
       },
       "price_usd": {
        "type": [
         "number",
         "null"
        ]
       },
       "source": {
        "const": "defillama",
        "type": "string"
       }
      },
      "required": [
       "amount",
       "currency",
       "as_of",
       "source",
       "defillama_id",
       "price_usd"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "peg": {
    "type": "string"
   },
   "period": {
    "type": [
     "string",
     "null"
    ]
   },
   "report_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "reserve_ratio": {
    "type": [
     "number",
     "null"
    ]
   },
   "reserve_ratio_vs_onchain_supply": {
    "type": [
     "number",
     "null"
    ]
   },
   "sample": {
    "type": "boolean"
   },
   "source_url": {
    "type": "string"
   },
   "sources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "symbol": {
    "type": "string"
   },
   "tokens_in_circulation_reported": {
    "type": [
     "number",
     "null"
    ]
   },
   "total_reserves_usd": {
    "type": [
     "number",
     "null"
    ]
   }
  },
  "required": [
   "issuer",
   "symbol",
   "name",
   "peg",
   "backing",
   "as_of",
   "period",
   "currency",
   "total_reserves_usd",
   "tokens_in_circulation_reported",
   "composition",
   "attestor",
   "attestation_type",
   "cadence",
   "source_url",
   "report_url",
   "issued_on",
   "onchain_supply",
   "reserve_ratio",
   "reserve_ratio_vs_onchain_supply",
   "confidence",
   "checks",
   "history_available",
   "sources",
   "sample",
   "notice"
  ],
  "type": "object"
 },
 "title": "Stablecoin reserve attestation"
}
