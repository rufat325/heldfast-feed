{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Enterprise-gated. List registered self-hosted Gateway deployments with status, type, default state, and connection health. Use this before get_deployment, update_deployment, or archive_deployment to resolve a deployment ID. Enterprise-gated. Returns 403 on non-Enterprise Portkey plans.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "organisation_id": {
    "description": "Filter by organisation UUID",
    "type": "string"
   },
   "search": {
    "description": "Search deployment names",
    "type": "string"
   },
   "status": {
    "description": "Filter by deployment status",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   },
   "tags": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Match deployments with all supplied tags",
    "propertyNames": {
     "pattern": "^[a-zA-Z0-9_-]+$",
     "type": "string"
    },
    "type": "object"
   },
   "type": {
    "description": "Filter by deployment type",
    "enum": [
     "production",
     "non_production"
    ],
    "type": "string"
   },
   "workspace_slug": {
    "description": "Filter by one or more workspace slugs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_deployments",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
