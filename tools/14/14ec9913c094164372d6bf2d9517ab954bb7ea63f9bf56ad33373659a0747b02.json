{
 "_meta": {
  "com.oxinsider/docs-group": "combos",
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get live combo count"
 },
 "description": "The stored count of traded Polymarket combos whose YES conjunction is still pending, and when it was computed. Requires a Pro or Max API key. The count refreshes at most every five minutes and is cached for 60 seconds. A null live value is unknown, never zero.\n\nReturns: live (count and computed_at, or null) and meta.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {},
  "type": "object"
 },
 "name": "get_combos_summary",
 "outputSchema": {
  "$defs": {
   "ComboLiveCount": {
    "properties": {
     "computed_at": {
      "format": "date-time",
      "type": "string"
     },
     "count": {
      "format": "int64",
      "type": "integer"
     }
    },
    "required": [
     "count",
     "computed_at"
    ],
    "type": "object"
   },
   "CombosSummary": {
    "properties": {
     "live": {
      "anyOf": [
       {
        "$ref": "#/$defs/ComboLiveCount"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "live"
    ],
    "type": "object"
   },
   "ResponseMeta": {
    "properties": {
     "cache_age_s": {
      "type": "integer"
     },
     "cached": {
      "type": "boolean"
     },
     "category_skill_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_enriched_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_model_operationally_degraded": {
      "type": "boolean"
     },
     "category_skill_model_version": {
      "type": "string"
     },
     "category_skill_observation_started_at": {
      "format": "date-time",
      "type": "string"
     },
     "category_skill_platform": {
      "const": "polymarket",
      "type": "string"
     },
     "category_skill_scope": {
      "const": "observed_goldsky_primary_taker_fill",
      "type": "string"
     },
     "category_skill_source": {
      "enum": [
       "live",
       "partial",
       "degraded",
       "unavailable"
      ],
      "type": "string"
     },
     "category_skill_source_coverage": {
      "enum": [
       "partial_whale_threshold_fills",
       "graded_wallet_fills"
      ],
      "type": "string"
     },
     "category_skill_status_counts": {
      "properties": {
       "degraded": {
        "minimum": 0,
        "type": "integer"
       },
       "insufficient": {
        "minimum": 0,
        "type": "integer"
       },
       "live": {
        "minimum": 0,
        "type": "integer"
       },
       "stale": {
        "minimum": 0,
        "type": "integer"
       },
       "unknown": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "live",
       "insufficient",
       "stale",
       "unknown",
       "degraded"
      ],
      "type": "object"
     },
     "category_skill_taxonomy_version": {
      "type": "string"
     },
     "cost": {
      "type": "integer"
     },
     "directional_source": {
      "enum": [
       "live",
       "degraded"
      ],
      "type": "string"
     },
     "ranking_as_of": {
      "format": "date-time",
      "type": "string"
     },
     "ranking_generation": {
      "type": "integer"
     },
     "ranking_source": {
      "enum": [
       "live",
       "db_only"
      ],
      "type": "string"
     },
     "request_id": {
      "type": "string"
     }
    },
    "required": [
     "request_id",
     "cached",
     "cost"
    ],
    "type": "object"
   }
  },
  "anyOf": [
   {
    "allOf": [
     {
      "$ref": "#/$defs/CombosSummary"
     },
     {
      "properties": {
       "meta": {
        "$ref": "#/$defs/ResponseMeta"
       }
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ]
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "doc_url": {
        "type": "string"
       },
       "param": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "request_id": {
        "type": "string"
       },
       "retry_after_seconds": {
        "minimum": 0,
        "type": "integer"
       },
       "retry_at": {
        "type": "string"
       },
       "status": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "code"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get live combo count"
}
