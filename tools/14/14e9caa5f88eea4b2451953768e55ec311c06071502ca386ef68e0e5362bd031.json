{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Propose a durable higher-signal conclusion. Approval is required by default before it can be recalled.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "evidenceIds": {
    "description": "Raw memory IDs supporting this conclusion. Used for provenance and consolidation coverage.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "expiresAt": {
    "type": "string"
   },
   "namespace": {
    "minLength": 1,
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "text": {
    "description": "Conclusion text to save.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "create_conclusion",
 "title": "Create conclusion"
}
