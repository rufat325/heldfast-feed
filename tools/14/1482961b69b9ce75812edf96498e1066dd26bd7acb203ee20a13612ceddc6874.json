{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record a decision with reasoning and alternatives.",
 "inputSchema": {
  "properties": {
   "alternatives": {
    "maxLength": 10000,
    "type": "string"
   },
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "decision": {
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "project": {
    "type": "string"
   },
   "reasoning": {
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "decision",
   "reasoning"
  ],
  "type": "object"
 },
 "name": "memory_decide"
}
