{
 "description": "Execute x64dbg commands, scripts, eval expressions, or manage debug session",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "execute",
        "type": "string"
       },
       "command": {
        "description": "x64dbg command string",
        "type": "string"
       }
      },
      "required": [
       "action",
       "command"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "script",
        "type": "string"
       },
       "commands": {
        "description": "Array of commands",
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "action",
       "commands"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "evaluate",
        "type": "string"
       },
       "expression": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "expression"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "format",
        "type": "string"
       },
       "format": {
        "type": "string"
       }
      },
      "required": [
       "action",
       "format"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set_init_script",
        "type": "string"
       },
       "file": {
        "description": "Path to script file",
        "type": "string"
       }
      },
      "required": [
       "action",
       "file"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_init_script",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_hash",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_events",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_command"
}
