{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Review client close readiness"
 },
 "description": "Accountant-only month-end overview of accepted client workspaces. Returns page-level readiness and affected-client category counts with an authenticated Client Reports link. Use for 'how many clients need attention before month end'. No client identities, amounts, or individual items are returned; select a client in ExpenseBot to resolve items. Unavailable sources remain unknown. Each page uses the current roster; do not combine pages into a verified total.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Client workspaces per page; default and maximum 5.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "page": {
    "description": "Page number; starts at 1. Use nextPage from the previous result.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "period": {
    "description": "Calendar month YYYY-MM; defaults to the last completed UTC month.",
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_client_close_readiness",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "type": "string"
   },
   "categories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affectedClientCount": {
       "minimum": 1,
       "type": "integer"
      },
      "code": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "label",
      "affectedClientCount",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "coverage": {
    "enum": [
     "complete_page",
     "incomplete_page"
    ],
    "type": "string"
   },
   "evaluatedClientCount": {
    "minimum": 0,
    "type": "integer"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "links": {
    "additionalProperties": false,
    "properties": {
     "clients": {
      "type": "string"
     }
    },
    "required": [
     "clients"
    ],
    "type": "object"
   },
   "message": {
    "type": "string"
   },
   "pageInfo": {
    "additionalProperties": false,
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "limit": {
      "maximum": 5,
      "minimum": 1,
      "type": "integer"
     },
     "nextPage": {
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "page": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "limit",
     "hasMore",
     "nextPage"
    ],
    "type": "object"
   },
   "period": {
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   },
   "scope": {
    "enum": [
     "page"
    ],
    "type": "string"
   },
   "statusCounts": {
    "additionalProperties": false,
    "properties": {
     "blocked": {
      "minimum": 0,
      "type": "integer"
     },
     "needs_action": {
      "minimum": 0,
      "type": "integer"
     },
     "ready": {
      "minimum": 0,
      "type": "integer"
     },
     "unknown": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "ready",
     "needs_action",
     "blocked",
     "unknown"
    ],
    "type": "object"
   },
   "success": {
    "type": "boolean"
   },
   "unavailableCandidateCount": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "success",
   "period",
   "asOf",
   "scope",
   "coverage",
   "statusCounts",
   "evaluatedClientCount",
   "unavailableCandidateCount",
   "categories",
   "pageInfo",
   "links",
   "limitations",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "expenses.read"
   ],
   "type": "oauth2"
  }
 ]
}
