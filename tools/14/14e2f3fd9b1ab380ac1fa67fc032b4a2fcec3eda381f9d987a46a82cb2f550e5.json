  "readOnlyHint": true
 },
 "description": "Dated record of verified Codex usage-limit resets and related announcements (boosts, unlocks, credits), newest first, each with its source URL.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Earliest date, YYYY-MM-DD.",
    "type": "string"
   },
   "group": {
    "description": "Kind of event. Default reset.",
    "enum": [
     "reset",
     "boost",
     "unlock",
     "credits"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Number of events. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Language of the human-readable copy. Default en.",
    "enum": [
     "en",
     "zh",
     "ja",
     "es"
    ],
    "type": "string"
   },
   "to": {
    "description": "Latest date, YYYY-MM-DD.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_reset_timeline",
 "title": "Codex reset record"
}
