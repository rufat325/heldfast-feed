{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Register a webhook URL for YooKassa events (payment.succeeded, refund.succeeded, etc.).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "event": {
    "description": "Event type to subscribe to",
    "enum": [
     "payment.succeeded",
     "payment.waiting_for_capture",
     "payment.canceled",
     "refund.succeeded",
     "payout.succeeded",
     "payout.canceled",
     "deal.closed"
    ],
    "type": "string"
   },
   "url": {
    "description": "HTTPS URL to receive webhook notifications",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "event",
   "url"
  ],
  "type": "object"
 },
 "name": "create_webhook",
 "title": "Create webhook"
}
