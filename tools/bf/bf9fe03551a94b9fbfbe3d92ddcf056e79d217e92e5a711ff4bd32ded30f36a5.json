{
 "description": "Send an agent event to your Pixel Squads office. The agent will appear as a character. Use this to report what you are doing \u2014 tool calls, status changes, messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "agentId": {
    "description": "Unique agent identifier (e.g. \"claude-desktop-session\")",
    "type": "string"
   },
   "displayName": {
    "description": "Human-readable agent name",
    "type": "string"
   },
   "status": {
    "description": "Agent status (for agent.status events)",
    "enum": [
     "active",
     "idle",
     "waiting",
     "error"
    ],
    "type": "string"
   },
   "text": {
    "description": "Message text (for agent.message events)",
    "type": "string"
   },
   "tool": {
    "description": "Tool name (for tool.start events)",
    "type": "string"
   },
   "type": {
    "description": "Event type (AEP protocol)",
    "enum": [
     "agent.created",
     "agent.tool.start",
     "agent.tool.done",
     "agent.status",
     "agent.message",
     "agent.handoff",
     "agent.closed"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "agentId"
  ],
  "type": "object"
 },
 "name": "pixel_squads_send_event"
}
