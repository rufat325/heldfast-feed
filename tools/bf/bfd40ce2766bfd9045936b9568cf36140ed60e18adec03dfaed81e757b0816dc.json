{
 "description": "Paid Whale Intelligence ($0.02 USDC). Summarizes large public GeckoTerminal-indexed DEX trades for a token address on a supported chain. Large-trader labels are size-based heuristics, not verified whale identities; data is not chain-wide. Wallet mode uses Helius (Solana) or Etherscan API V2 (EVM) when configured, returning recent indexed transactions only; it does not claim complete balances or whale labels.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "asset": {
      "maxLength": 90,
      "minLength": 1,
      "type": "string"
     },
     "chain": {
      "enum": [
       "solana",
       "ethereum",
       "base",
       "arbitrum",
       "optimism",
       "polygon"
      ],
      "type": "string"
     },
     "limit": {
      "default": 50,
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "min_transaction_usd": {
      "default": 100000,
      "maximum": 1000000000,
      "minimum": 1,
      "type": "number"
     },
     "mode": {
      "const": "asset",
      "type": "string"
     },
     "window": {
      "default": "1h",
      "enum": [
       "5m",
       "15m",
       "1h",
       "4h",
       "24h"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode",
     "chain",
     "asset"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "address": {
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "chain": {
      "enum": [
       "solana",
       "ethereum",
       "base",
       "arbitrum",
       "optimism",
       "polygon"
      ],
      "type": "string"
     },
     "mode": {
      "const": "wallet",
      "type": "string"
     }
    },
    "required": [
     "mode",
     "chain",
     "address"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "analyze_whale_activity",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "cache": {
      "additionalProperties": false,
      "properties": {
       "age_ms": {
        "minimum": 0,
        "type": "number"
       },
       "hit": {
        "type": "boolean"
       }
      },
      "required": [
       "hit",
       "age_ms"
      ],
      "type": "object"
     },
     "failed_sources": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "reason": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "latency_ms": {
      "minimum": 0,
      "type": "number"
     },
     "partial": {
      "type": "boolean"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "latency_ms",
     "partial",
     "failed_sources",
     "cache"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "timestamp": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "tool",
   "timestamp",
   "data",
   "meta"
  ],
  "type": "object"
 }
}
