{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "LLM Provider Cost Calculator"
 },
 "description": "Use when a user asks what an LLM workload costs on a specific provider/model, or wants to compare cost across providers. Given tokens per call and call volume, returns monthly cost plus a tier comparison table.",
 "inputSchema": {
  "examples": [
   {
    "calls_per_month": 100000,
    "tokens_in": 1200,
    "tokens_out": 400
   }
  ],
  "properties": {
   "calls_per_month": {
    "description": "Monthly call volume",
    "minimum": 1,
    "type": "number"
   },
   "include_comparison": {
    "description": "Include tier comparison table (default true)",
    "type": "boolean"
   },
   "model": {
    "description": "Target model (e.g. claude-sonnet-4-6)",
    "type": "string"
   },
   "provider": {
    "description": "Target provider (e.g. anthropic, openai, together)",
    "type": "string"
   },
   "tokens_in": {
    "description": "Input tokens per call",
    "minimum": 0,
    "type": "number"
   },
   "tokens_out": {
    "description": "Output tokens per call",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "tokens_in",
   "tokens_out"
  ],
  "type": "object"
 },
 "name": "provider-cost-calculator",
 "title": "LLM Provider Cost Calculator"
}
