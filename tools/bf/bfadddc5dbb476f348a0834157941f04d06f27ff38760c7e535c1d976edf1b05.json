{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Bucket GSC clicks/impressions/avg-position into ~weekly windows for the last N weeks (default 12) and classify the trend: decay / plateau / growth.\n\nUnderpins the verdict engine's decay rules. Read-only GSC query.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Canonical URL of the post.",
    "format": "uri",
    "type": "string"
   },
   "weeks": {
    "default": 12,
    "maximum": 52,
    "minimum": 4,
    "type": "integer"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "posts_decay_curve",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "buckets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "clicks": {
       "type": "number"
      },
      "impressions": {
       "type": "number"
      },
      "position": {
       "type": "number"
      },
      "week_start": {
       "type": "string"
      }
     },
     "required": [
      "week_start",
      "clicks",
      "impressions",
      "position"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "decay_pct": {
    "type": "number"
   },
   "trend": {
    "enum": [
     "decay",
     "plateau",
     "growth"
    ],
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "buckets",
   "trend",
   "decay_pct"
  ],
  "type": "object"
 },
 "title": "Weekly GSC decay curve"
}
