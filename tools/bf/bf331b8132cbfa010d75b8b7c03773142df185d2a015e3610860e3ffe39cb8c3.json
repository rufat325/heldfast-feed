{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Buy a portable signed commitment to a declared API exchange when a recipient needs independently verifiable receipt integrity: response handoff, archived decision input, or change investigation. Costs 0.002 USDC per receipt via x402 when enabled; verification is free. A local log may suffice for disposable data. Requires caller-approved budget. Keep event, idempotency key and original payment unchanged on retry. Attests a client declaration, not provider origin, content truth or independent observation.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "event": {
    "additionalProperties": false,
    "properties": {
     "apiId": {
      "description": "Caller-chosen API identifier; not a certified provider identity.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "attestation": {
      "const": "client_declared",
      "type": "string"
     },
     "bodyEncoding": {
      "const": "application_bytes",
      "type": "string"
     },
     "completedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "exchangeId": {
      "description": "Stable identifier for one declared HTTP exchange.",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$",
      "type": "string"
     },
     "headerEncoding": {
      "const": "jcs-selected-headers-v1",
      "type": "string"
     },
     "method": {
      "enum": [
       "GET",
       "HEAD",
       "POST",
       "PUT",
       "PATCH",
       "DELETE",
       "OPTIONS"
      ],
      "type": "string"
     },
     "requestBodyHash": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "algorithm": {
          "const": "sha256",
          "type": "string"
         },
         "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         }
        },
        "required": [
         "algorithm",
         "digest"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "SHA-256 of exact application request bytes; null means no body, not an empty body."
     },
     "requestHeadersHash": {
      "additionalProperties": false,
      "description": "SHA-256 of locally canonicalized selected request headers. Never send raw headers.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "type": "string"
       },
       "digest": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "responseBodyHash": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "algorithm": {
          "const": "sha256",
          "type": "string"
         },
         "digest": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
         }
        },
        "required": [
         "algorithm",
         "digest"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "SHA-256 of exact application response bytes after HTTP decoding. Preserve those bytes; do not reserialize JSON."
     },
     "responseHeadersHash": {
      "additionalProperties": false,
      "description": "SHA-256 of locally canonicalized selected response headers.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "type": "string"
       },
       "digest": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "startedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{3}(?:Z))$",
      "type": "string"
     },
     "status": {
      "maximum": 599,
      "minimum": 200,
      "type": "integer"
     },
     "targetHash": {
      "additionalProperties": false,
      "description": "SHA-256 of the exact UTF-8 target URL, computed locally. Never invent a digest or send the URL itself.",
      "properties": {
       "algorithm": {
        "const": "sha256",
        "type": "string"
       },
       "digest": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       }
      },
      "required": [
       "algorithm",
       "digest"
      ],
      "type": "object"
     },
     "version": {
      "const": "datoka.api.exchange.v1",
      "type": "string"
     }
    },
    "required": [
     "version",
     "attestation",
     "apiId",
     "exchangeId",
     "method",
     "status",
     "startedAt",
     "completedAt",
     "targetHash",
     "requestBodyHash",
     "responseBodyHash",
     "requestHeadersHash",
     "responseHeadersHash",
     "bodyEncoding",
     "headerEncoding"
    ],
    "type": "object"
   },
   "idempotencyKey": {
    "description": "One stable key per purchase, saved before payment. Keep it, the event and original payment authorization unchanged on retries.",
    "pattern": "^[\\x21-\\x7e]{16,200}$",
    "type": "string"
   }
  },
  "required": [
   "event",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "issue_api_receipt"
}
