{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/coaching-agreement-template"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Coaching agreement template"
 },
 "description": "Generate the website's coaching agreement as plain text. Missing text fields use placeholders. Draft only; legal review may be needed. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "businessName": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "cancellationPolicy": {
    "default": "24 hours notice required",
    "enum": [
     "24 hours notice required",
     "48 hours notice required",
     "No refunds after session 1"
    ],
    "type": "string"
   },
   "clientName": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "coachName": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "coachingType": {
    "default": "life coaching",
    "maxLength": 2000,
    "type": "string"
   },
   "fee": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "paymentTerms": {
    "default": "Full payment upfront",
    "enum": [
     "Full payment upfront",
     "50% upfront, 50% at midpoint",
     "Monthly installments",
     "Pay per session"
    ],
    "type": "string"
   },
   "programLength": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   },
   "sessionFormat": {
    "default": "1:1 video calls",
    "enum": [
     "1:1 video calls",
     "1:1 phone calls",
     "In-person sessions",
     "Group sessions"
    ],
    "type": "string"
   },
   "sessionLength": {
    "default": 60,
    "exclusiveMinimum": 0,
    "maximum": 1440,
    "type": "integer"
   },
   "startDate": {
    "default": "",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "coaching_agreement",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "format": {
    "const": "text/plain",
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "text",
   "format",
   "notice"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Coaching agreement template"
}
