{
 "description": "Export all pages from a Figma file as images",
 "inputSchema": {
  "properties": {
   "fileKey": {
    "description": "Figma file key",
    "type": "string"
   },
   "format": {
    "default": "PNG",
    "description": "Export format",
    "enum": [
     "PNG",
     "SVG",
     "PDF",
     "JPG"
    ],
    "type": "string"
   },
   "scale": {
    "default": 1,
    "description": "Scale factor",
    "type": "number"
   }
  },
  "required": [
   "fileKey"
  ],
  "type": "object"
 },
 "name": "export_file_pages"
}
