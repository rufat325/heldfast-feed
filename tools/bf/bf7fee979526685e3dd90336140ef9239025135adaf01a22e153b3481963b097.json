{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create an IAM access entry for an NKS cluster: maps an IAM USER or ROLE (NRN) to Kubernetes groups and/or NKS access policies. Requires authType=API.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterUuid": {
    "description": "UUID of the cluster",
    "type": "string"
   },
   "entry": {
    "description": "NRN of the IAM USER or ROLE",
    "type": "string"
   },
   "groups": {
    "description": "Kubernetes group names to bind the principal to",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "policies": {
    "description": "NKS access policies to attach (type + scope, namespaces when scope is 'namespace')",
    "items": {
     "additionalProperties": false,
     "properties": {
      "namespaces": {
       "description": "Target namespaces \u2014 required when scope is 'namespace'",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "scope": {
       "description": "Policy scope",
       "enum": [
        "cluster",
        "namespace"
       ],
       "type": "string"
      },
      "type": {
       "description": "NKS access policy type",
       "enum": [
        "NKSClusterAdminPolicy",
        "NKSAdminPolicy",
        "NKSEditPolicy",
        "NKSViewPolicy"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "scope"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "type": {
    "description": "IAM principal type",
    "enum": [
     "USER",
     "ROLE"
    ],
    "type": "string"
   }
  },
  "required": [
   "clusterUuid",
   "type",
   "entry"
  ],
  "type": "object"
 },
 "name": "ncloud_nks_create_access_entry"
}
