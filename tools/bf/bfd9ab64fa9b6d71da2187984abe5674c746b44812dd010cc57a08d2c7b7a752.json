{
 "description": "Create a new tenant and its first API key with no key required. Returns a tga_ key shown ONCE \u2014 persist it, then set it as the session credential.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "email": {
    "description": "Contact email (optional)",
    "type": "string"
   },
   "name": {
    "description": "Tenant display name",
    "type": "string"
   },
   "password": {
    "description": "First user password (min 8 chars)",
    "type": "string"
   },
   "slug": {
    "description": "Desired tenant slug (free-form; normalized server-side)",
    "type": "string"
   },
   "username": {
    "description": "First user username",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "username",
   "password"
  ],
  "type": "object"
 },
 "name": "analyga_signup",
 "outputSchema": {
  "additionalProperties": true,
  "description": "The created tenant and its first API key",
  "properties": {
   "apiKey": {
    "additionalProperties": true,
    "description": "First API key \u2014 key shown once",
    "properties": {
     "id": {
      "description": "API key id",
      "type": "string"
     },
     "key": {
      "description": "The plaintext tga_ key. Store it now; it cannot be recovered.",
      "type": "string"
     },
     "name": {
      "description": "API key name",
      "type": "string"
     }
    },
    "type": "object"
   },
   "tenant": {
    "additionalProperties": true,
    "description": "New tenant",
    "properties": {
     "id": {
      "description": "Tenant id",
      "type": "string"
     },
     "slug": {
      "description": "Tenant slug",
      "type": "string"
     },
     "status": {
      "description": "Tenant status",
      "type": "string"
     },
     "trialEndsAt": {
      "description": "Trial end timestamp, if any",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "tenant",
   "apiKey"
  ],
  "type": "object"
 }
}
