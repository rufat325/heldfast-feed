{
 "description": "Create a fee policy \u2014 pricing rules applied to merchants.",
 "inputSchema": {
  "properties": {
   "cashout_price": {
    "description": "Flat cashout fee, in cents",
    "type": "integer"
   },
   "description": {
    "type": "string"
   },
   "is_active": {
    "type": "boolean"
   },
   "name": {
    "type": "string"
   },
   "rules": {
    "items": {
     "properties": {
      "conditions": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "price": {
       "description": "At least one of percentage / flat (cents) / minimum_price (cents)",
       "properties": {
        "flat": {
         "type": "integer"
        },
        "minimum_price": {
         "type": "integer"
        },
        "percentage": {
         "type": "number"
        }
       },
       "type": "object"
      },
      "priority": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "is_active",
   "cashout_price",
   "rules"
  ],
  "type": "object"
 },
 "name": "create_fee_policy"
}
