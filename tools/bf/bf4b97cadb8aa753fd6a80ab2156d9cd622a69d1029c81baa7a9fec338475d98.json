{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get invite"
 },
 "description": "Look up a single invite by its code: target server and channel, inviter, and expiry. Works for any public invite, but this endpoint never returns usage counters (uses/max_uses/max_age read 0); use discord_list_invites or discord_list_channel_invites for real counters. Read-only. Returns a JSON object.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "invite_code": {
    "description": "The invite code, e.g. 'abc123'. A full discord.gg/abc123 URL is also accepted and stripped.",
    "type": "string"
   }
  },
  "required": [
   "invite_code"
  ],
  "type": "object"
 },
 "name": "discord_get_invite",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "channel_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "channel_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "code": {
    "type": "string"
   },
   "created_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "expires_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "guild_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "guild_name": {
    "type": [
     "string",
     "null"
    ]
   },
   "inviter": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "username": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "username"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "max_age": {
    "type": "number"
   },
   "max_uses": {
    "type": "number"
   },
   "temporary": {
    "type": "boolean"
   },
   "url": {
    "type": "string"
   },
   "uses": {
    "type": "number"
   }
  },
  "required": [
   "code",
   "url",
   "guild_id",
   "guild_name",
   "channel_id",
   "channel_name",
   "inviter",
   "uses",
   "max_uses",
   "max_age",
   "temporary",
   "created_at",
   "expires_at"
  ],
  "type": "object"
 }
}
