{
 "_meta": {
  "spellbook.finance/limitations": [
   "Preview reports bounded customer impacts and status only. It never publishes, reprices or changes saved configuration.",
   "Raw rows, demand telemetry, actors and demand behavior are unavailable through this tool.",
   "A queued or processing status is not a completed preview; poll spellbook_pricing_amendment_preview_status."
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Preview a seller pricing amendment"
 },
 "description": "Start or run a bounded preview for one saved amendment or one seller-selected draft. Returns customer-safe per-channel impact counts and status evidence, with no raw inventory rows or demand telemetry. Preview is not publication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "amendment": {
    "additionalProperties": false,
    "description": "Draft amendment; provide this or amendmentId.",
    "properties": {
     "enabled": {
      "default": true,
      "description": "Whether the draft is enabled for preview.",
      "type": "boolean"
     },
     "marketplaceScope": {
      "anyOf": [
       {
        "const": "all",
        "description": "Apply across all supported marketplaces.",
        "type": "string"
       },
       {
        "additionalProperties": false,
        "properties": {
         "channels": {
          "description": "Specific marketplace channels for this amendment.",
          "items": {
           "enum": [
            "ebay",
            "tcg",
            "manapool",
            "shopify",
            "cardtrader"
           ],
           "type": "string"
          },
          "maxItems": 5,
          "minItems": 1,
          "type": "array"
         }
        },
        "required": [
         "channels"
        ],
        "type": "object"
       }
      ],
      "description": "Preview marketplace scope."
     },
     "mode": {
      "additionalProperties": false,
      "description": "Preview absolute multiplier and protected band.",
      "properties": {
       "multiplier": {
        "description": "Absolute multiplier applied by this amendment. Required.",
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "protectedBand": {
        "additionalProperties": false,
        "description": "Optional seller-approved protected band.",
        "properties": {
         "multiplier": {
          "description": "Protected multiplier at or above the threshold.",
          "exclusiveMinimum": 0,
          "type": "number"
         },
         "thresholdUsd": {
          "description": "Original market anchor threshold in USD.",
          "exclusiveMinimum": 0,
          "type": "number"
         }
        },
        "required": [
         "thresholdUsd",
         "multiplier"
        ],
        "type": "object"
       }
      },
      "required": [
       "multiplier"
      ],
      "type": "object"
     },
     "priority": {
      "description": "Preview precedence priority.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "selector": {
      "additionalProperties": false,
      "description": "Preview selector.",
      "properties": {
       "condition": {
        "description": "Optional condition selector.",
        "enum": [
         "NM",
         "LP",
         "MP",
         "HP",
         "DMG"
        ],
        "type": "string"
       },
       "finish": {
        "description": "Optional finish selector.",
        "enum": [
         "nf",
         "fo",
         "etched",
         "surge",
         "rh",
         "1e",
         "1e-fo"
        ],
        "type": "string"
       },
       "originalAnchorPriceBand": {
        "additionalProperties": false,
        "description": "Optional original market anchor band selector.",
        "properties": {
         "maxUsd": {
          "description": "Protected band upper bound in USD.",
          "minimum": 0,
          "type": "number"
         },
         "minUsd": {
          "description": "Protected band lower bound in USD.",
          "minimum": 0,
          "type": "number"
         }
        },
        "type": "object"
       },
       "releaseFamilyCode": {
        "description": "Release family selector.",
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
       },
       "scryfallId": {
        "description": "Exact Scryfall printing selector. Requires setCode when supplied.",
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "setCode": {
        "description": "Set code selector.",
        "maxLength": 32,
        "minLength": 1,
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "required": [
     "priority",
     "selector",
     "marketplaceScope",
     "mode"
    ],
    "type": "object"
   },
   "amendmentId": {
    "description": "The exact saved amendment id from a prior amendment read. Required.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "channels": {
    "description": "Optional marketplace channels to preview.",
    "items": {
     "enum": [
      "ebay",
      "tcg",
      "manapool",
      "shopify",
      "cardtrader"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "workspaceId": {
    "description": "The workspace the seller selected. The caller must own it. Required.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "workspaceId"
  ],
  "type": "object"
 },
 "name": "spellbook_pricing_amendment_preview"
}
