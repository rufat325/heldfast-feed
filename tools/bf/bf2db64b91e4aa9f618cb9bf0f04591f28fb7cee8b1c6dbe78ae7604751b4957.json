{
 "description": "Append a new section (heading + body content) to the end of an existing .docx document. The document is updated in place.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "Section body content (markdown supported)",
    "type": "string"
   },
   "filePath": {
    "description": "Path to the existing .docx file",
    "minLength": 1,
    "type": "string"
   },
   "heading": {
    "description": "Section heading text",
    "minLength": 1,
    "type": "string"
   },
   "headingLevel": {
    "default": 2,
    "description": "Heading level: 1 = H1 (largest) through 6 = H6 (smallest). Default: 2",
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "filePath",
   "heading",
   "content"
  ],
  "type": "object"
 },
 "name": "add_section"
}
