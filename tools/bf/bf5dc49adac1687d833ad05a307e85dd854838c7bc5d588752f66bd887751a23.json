{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List rate-limit policies with their current condition, grouping, rate unit, target, status, and scope. Filter before retrieving or changing one policy, especially when archived policies should be included.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "current_page": {
    "description": "Zero-based page number",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "page_size": {
    "description": "Number of policies to return per page",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "status": {
    "description": "Filter by active or archived status",
    "enum": [
     "active",
     "archived"
    ],
    "type": "string"
   },
   "target": {
    "description": "Filter by LLM or MCP-tool target",
    "enum": [
     "llm",
     "mcp_tools"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by counter type",
    "enum": [
     "requests",
     "tokens"
    ],
    "type": "string"
   },
   "unit": {
    "description": "Filter by reset interval",
    "enum": [
     "rpm",
     "rph",
     "rpd",
     "rpw"
    ],
    "type": "string"
   },
   "workspace_id": {
    "description": "Filter by workspace UUID",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_rate_limits",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
