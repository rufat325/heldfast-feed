{
 "description": "Classify a control deficiency as deficiency / significant deficiency / material weakness from likelihood \u00d7 magnitude (escalates for a pervasive control).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "compensatingControl": {
    "type": "string"
   },
   "controlId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "description": {
    "minLength": 1,
    "type": "string"
   },
   "engagementId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "exceptionIds": {
    "default": [],
    "items": {
     "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
     "type": "string"
    },
    "type": "array"
   },
   "likelihood": {
    "enum": [
     "remote",
     "more-than-remote",
     "reasonably-possible"
    ],
    "type": "string"
   },
   "magnitude": {
    "enum": [
     "inconsequential",
     "more-than-inconsequential",
     "material"
    ],
    "type": "string"
   },
   "pervasive": {
    "default": false,
    "type": "boolean"
   },
   "remediation": {
    "properties": {
     "actions": {
      "type": "string"
     },
     "dueDate": {
      "type": "string"
     },
     "owner": {
      "type": "string"
     },
     "retestPlan": {
      "type": "string"
     },
     "rootCause": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "testResultId": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   },
   "title": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "engagementId",
   "title",
   "description",
   "likelihood",
   "magnitude"
  ],
  "type": "object"
 },
 "name": "classify_deficiency",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "deficiency": {}
  },
  "required": [
   "deficiency"
  ],
  "type": "object"
 },
 "title": "Classify a deficiency"
}
