{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Break a URL into its components: scheme, host, port, path, decoded query parameters and fragment. Use to inspect or debug a URL instead of parsing it by eye.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "The URL to parse (absolute, with scheme).",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "url_parse",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "fragment": {
    "type": "string"
   },
   "host": {
    "type": "string"
   },
   "path": {
    "type": "string"
   },
   "port": {
    "description": "Port, or empty if the scheme default.",
    "type": "string"
   },
   "query": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scheme": {
    "type": "string"
   },
   "username": {
    "type": "string"
   }
  },
  "required": [
   "scheme",
   "host",
   "port",
   "path",
   "query",
   "fragment"
  ],
  "type": "object"
 },
 "title": "Parse a URL into parts"
}
