{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when the user shares a quote, offer, invoice or cost breakdown from an Employer of Record, PEO or payroll provider and asks whether it is fair, correct, overpriced or what it includes (e.g. \"here is my EOR quote for Germany: salary 5,900, employer contributions 1,350, fee 560 a month, is it honest?\", \"voici le devis de mon EOR, est-il correct ?\"). Checks the quote lines against the statutory ledger of the country at the same salary: expected and quoted amount per statutory line, statutory lines missing from a detailed quote, charges with no statutory counterpart, and the gap split into fee lines, charges above the statutory ledger and the salary-line difference (often an exchange-rate margin). When the quote gives employer charges as one total, that total is compared with the statutory total and the expected line-by-line breakdown is returned. A monthly quote in a country paying more than 12 monthly salaries a year (e.g. 14 in Spain) is read against one monthly payment, the extra payments being owed outside its lines. Amounts given in the local currency come back in it, with the USD in brackets. Pass the amounts as written on the quote; the provider's name is never needed. Do not use without figures from the user. Data snapshot 2026-10-13. Cost comparison, not legal or tax advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amounts_currency": {
    "default": "USD",
    "description": "Currency of the quote line amounts",
    "enum": [
     "USD",
     "local"
    ],
    "type": "string"
   },
   "assumptions": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Override an adjustable assumption the country declares, e.g. {\"basic_share_of_gross\": 0.6}. See `assumptions` in an employer_cost answer.",
    "type": "object"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code (\"DE\") or country name (\"Germany\")",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "lines": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "maximum": 1000000000000,
       "minimum": -1000000000000,
       "type": "number"
      },
      "label": {
       "description": "The line as written on the quote",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "statutory_id": {
       "description": "Id of the statutory line it stands for, from employer_cost lines, when the label alone does not match",
       "maxLength": 60,
       "type": "string"
      },
      "type": {
       "description": "salary; employer_charge (social security, pension, insurance, levy); fee (service, FX, onboarding, deposit); other",
       "enum": [
        "salary",
        "employer_charge",
        "fee",
        "other"
       ],
       "type": "string"
      }
     },
     "required": [
      "label",
      "amount",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 60,
    "minItems": 1,
    "type": "array"
   },
   "payments_per_year": {
    "description": "With salary_period \"month\" only: the total number of monthly salaries the contract pays in a year, statutory ones included (e.g. 14). Omit to use the statutory number of the country.",
    "maximum": 16,
    "minimum": 12,
    "type": "number"
   },
   "period": {
    "default": "month",
    "description": "Whether the quote line amounts are per month or per year (one employee)",
    "enum": [
     "month",
     "year"
    ],
    "type": "string"
   },
   "salary": {
    "description": "Gross salary the quote is for, a year unless salary_period is \"month\"",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "salary_currency": {
    "default": "USD",
    "description": "Currency of `salary`: USD, or the local currency of the country",
    "enum": [
     "USD",
     "local"
    ],
    "type": "string"
   },
   "salary_period": {
    "default": "year",
    "description": "Whether the salary is a year (default) or a month. Pass a monthly salary as the user gives it, with \"month\": the statutory number of monthly payments of the country (13th, 14th month) is applied, see salary_basis in the answer.",
    "enum": [
     "year",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "country",
   "salary",
   "lines"
  ],
  "type": "object"
 },
