{
 "description": "Expand and analyze a playlist in one call with partial success and aggregate benchmarks. [~5-20s, scales with playlist size]",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "analyses": {
    "items": {
     "enum": [
      "video_info",
      "transcript",
      "comments",
      "sentiment",
      "hook_patterns",
      "tag_title_patterns"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "commentsSampleSize": {
    "maximum": 200,
    "minimum": 1,
    "type": "number"
   },
   "dryRun": {
    "type": "boolean"
   },
   "maxVideos": {
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "playlistUrlOrId": {
    "type": "string"
   },
   "transcriptMode": {
    "enum": [
     "summary",
     "key_moments",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "playlistUrlOrId",
   "analyses"
  ],
  "type": "object"
 },
 "name": "analyzePlaylist"
}
