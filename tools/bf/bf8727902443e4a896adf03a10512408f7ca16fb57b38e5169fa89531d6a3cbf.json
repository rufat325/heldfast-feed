{
 "annotations": {
  "readOnlyHint": true,
  "title": "Quote a stay"
 },
 "description": "Calculate what a stay at a listing would cost \u2014 total price plus the component breakdown (base rate, cleaning fee, taxes, discounts). A calculation only: nothing is booked or held. Hostaway: POST /v1/listings/{listingId}/calendar/priceDetails (version 2).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "endingDate": {
    "description": "Departure date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "listingId": {
    "description": "Listing id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "markup": {
    "description": "Price markup multiplier (must be more than 1.0).",
    "minimum": 1,
    "type": "number"
   },
   "numberOfGuests": {
    "description": "Number of guests.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "reservationCouponId": {
    "description": "Reservation coupon id to apply.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "startingDate": {
    "description": "Arrival date (YYYY-MM-DD).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "listingId",
   "startingDate",
   "endingDate",
   "numberOfGuests"
  ],
  "type": "object"
 },
 "name": "hostaway_calculate_price",
 "title": "Quote a stay"
}
