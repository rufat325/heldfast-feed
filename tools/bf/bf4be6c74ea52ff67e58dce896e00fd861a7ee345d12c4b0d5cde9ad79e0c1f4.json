 "description": "Adds DNS records (A, AAAA, CNAME, CAA, MX, TXT, NS) to a domain the company purchased through Lovie and applies them at the registrar \u2014 no registrar login needed. Use when the founder wants to point their domain at a website host or set up email records. Host is relative to the domain (\"@\" for the root, \"www\" for a subdomain). This ADDS records: it cannot delete one, and it cannot reliably overwrite a record that already exists \u2014 the registrar's own tools are needed for either. Full nameserver delegation changes are not supported. Call LookupDomainDnsRecords first to see what is already there.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "dnsRecords": {
    "items": {
     "properties": {
      "host": {
       "maxLength": 253,
       "minLength": 1,
       "pattern": "^(@|\\*|[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?(\\.[a-z0-9_]([a-z0-9_-]*[a-z0-9_])?)*)$",
       "type": "string"
      },
      "priority": {
       "maximum": 65535,
       "type": "integer"
      },
      "ttl": {
       "maximum": 86400,
       "minimum": 60,
       "type": "integer"
      },
      "type": {
       "enum": [
        "DNS_RECORD_TYPE_A",
        "DNS_RECORD_TYPE_AAAA",
        "DNS_RECORD_TYPE_CNAME",
        "DNS_RECORD_TYPE_CAA",
        "DNS_RECORD_TYPE_MX",
        "DNS_RECORD_TYPE_TXT",
        "DNS_RECORD_TYPE_NS"
       ],
       "type": "string"
      },
      "value": {
       "maxLength": 1024,
       "minLength": 1,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 50,
    "type": "array"
   },
   "domain": {
    "maxLength": 253,
    "minLength": 1,
    "pattern": "^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)+\\.?)$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
