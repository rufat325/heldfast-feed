{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false,"title":"Batch edit"},"description":"Apply many edits as one change: one new timeline_id, one preview. All apply or none do. Use {\"$ref\":\"ops[N].clip_id\"} (or track_id, clip_ids[M]) to use an id an earlier op made. Returns the edit result plus results: [{tool, clip_id?, clip_ids?, track_id?}] per op.","inputSchema":{"properties":{"ops":{"description":"Edits applied in order as one change. An arg may be {\"$ref\":\"ops[2].clip_id\"} to use an id made by an earlier op","items":{"properties":{"args":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"tool":{"enum":["timeline.set_sequence","track.add","track.remove","track.set","clip.add","clip.remove","clip.move","clip.trim","clip.split","clip.link","clip.unlink","clip.set_enabled","clip.set_speed","clip.freeze","clip.roll","clip.slip","clip.slide","clip.replace","range.lift","range.extract","title.add","caption.add","text.set","audio.set_gain","audio.set_pan","audio.fade","audio.set_master","filter.add","filter.set","filter.remove","adjustment.add","transition.add","transition.set","transition.remove","clip.set_transform","clip.set_blend","clip.set_mask","clip.set_animation"],"type":"string"}},"required":["tool","args"],"type":"object"},"maxItems":200,"minItems":1,"type":"array"},"preview":{"default":"link","description":"inline: image in the result; link: URI that renders on read; none","enum":["inline","link","none"],"type":"string"},"timeline_id":{"description":"Timeline handle; every edit returns a new one","pattern":"^tl_[0-9a-f]{32}$","type":"string"}},"required":["timeline_id","ops"],"type":"object"},"name":"edit.batch","outputSchema":{"properties":{"changed":{"items":{"properties":{"change":{"enum":["added","removed","modified"],"type":"string"},"end":{"type":"integer"},"id":{"type":"string"},"kind":{"type":"string"},"start":{"type":"integer"},"track_id":{"type":"string"},"typ