{
 "description": "Independently verify a revealed commitment; optionally check it against\n    the digest of content you received.",
 "inputSchema": {
  "properties": {
   "commitment_id": {
    "title": "Commitment Id",
    "type": "string"
   },
   "content_digest": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Content Digest"
   }
  },
  "required": [
   "commitment_id"
  ],
  "title": "verifyArguments",
  "type": "object"
 },
 "name": "verify",
 "outputSchema": {
  "properties": {
   "result": {
    "title": "Result",
    "type": "string"
   }
  },
  "required": [
   "result"
  ],
  "title": "verifyOutput",
  "type": "object"
 }
}
