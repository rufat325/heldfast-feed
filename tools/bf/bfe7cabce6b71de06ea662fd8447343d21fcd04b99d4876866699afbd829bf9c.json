{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Compare evidence before/after an observed successful deployment or explicitly labelled release marker. Uses compatible archived snapshots and historical logs; missing baselines are not zero. Separates changes, unchanged metrics, time correlation and optional hypotheses. Current follow-up checks are not historical evidence. Appends an immutable local archive when configured.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "afterMinutes": {
    "default": 60,
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "beforeMinutes": {
    "default": 60,
    "maximum": 1440,
    "minimum": 1,
    "type": "integer"
   },
   "deploymentId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "logLimit": {
    "default": 100,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "question": {
    "default": "What broke after the last deployment?",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "sourceId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "investigate_deployment_regression",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "status": {
    "enum": [
     "ok",
     "error"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 }
}
