{
 "annotations": {},
 "description": "Create or update a scheduled action for an Auto Scaling Group",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "autoScalingGroupNo": {
    "description": "Auto Scaling Group number",
    "type": "string"
   },
   "desiredCapacity": {
    "description": "Desired capacity at scheduled time",
    "type": "number"
   },
   "endTime": {
    "description": "End time in ISO 8601 format (e.g. 2024-12-31T23:59:59+0900)",
    "type": "string"
   },
   "maxSize": {
    "description": "Maximum size at scheduled time",
    "type": "number"
   },
   "minSize": {
    "description": "Minimum size at scheduled time",
    "type": "number"
   },
   "recurrenceInKST": {
    "description": "Cron expression in KST (e.g. '0 9 * * 1-5' for weekdays at 9am KST)",
    "type": "string"
   },
   "scheduledActionName": {
    "description": "Scheduled action name",
    "type": "string"
   },
   "startTime": {
    "description": "Start time in ISO 8601 format (e.g. 2024-01-01T00:00:00+0900)",
    "type": "string"
   }
  },
  "required": [
   "autoScalingGroupNo",
   "scheduledActionName"
  ],
  "type": "object"
 },
 "name": "ncloud_put_scheduled_action"
}
