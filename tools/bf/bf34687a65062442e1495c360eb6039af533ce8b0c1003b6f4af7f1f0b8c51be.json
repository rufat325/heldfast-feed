 "description": "Pesquisa fontes externas pelo SearXNG local, consulta URLs HTTPS com prote\u00e7\u00e3o SSRF/robots, extrai texto localmente e devolve proveni\u00eancia e refer\u00eancia cache\u00e1vel. Tamb\u00e9m expande ref, lista derivados por source_ref ou confere original+recibo+URL por source_ref/receipt_sha256/url_declarada; referencia_em opcional informa se a aquisi\u00e7\u00e3o j\u00e1 existia naquele dia UTC; provas permite 1-4 verifica\u00e7\u00f5es parciais independentes, sem certificar vig\u00eancia. Exige token de operador com escopo pesquisa:consultar.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "consulta": {
    "description": "consulta externa; use exatamente um de consulta, ref ou source_ref",
    "type": "string"
   },
   "cursor_derivados": {
    "description": "cursor opaco da p\u00e1gina anterior; somente com source_ref",
    "type": "string"
   },
   "detalhe_max_bytes": {
    "description": "bytes de texto ao expandir ref, padr\u00e3o 32768, teto 65536",
    "type": "integer"
   },
   "dominios": {
    "description": "filtro p\u00f3s-descoberta por dom\u00ednio DNS, por exemplo planalto.gov.br; subdom\u00ednios leg\u00edtimos s\u00e3o aceitos",
    "items": {
     "type": "string"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "limite_derivados": {
    "description": "quantidade de derivados por p\u00e1gina; padr\u00e3o 5, teto 5; somente com source_ref",
    "type": "integer"
   },
   "limite_documentos": {
    "description": "fontes realmente consultadas, padr\u00e3o 2, teto 5",
    "type": "integer"
   },
   "limite_resultados": {
    "description": "candidatos de discovery, padr\u00e3o 10, teto 20",
    "type": "integer"
   },
   "offset": {
    "description": "offset em bytes UTF-8 ao expandir ref",
    "type": "integer"
   },
   "provas": {
    "description": "verifica\u00e7\u00e3o offline em lote, uma a quatro fontes com recibos; exclusivo de consulta, ref e source_ref",
    "items": {
     "additionalProperties": false,
     "properties": {
      "receipt_sha256": {
       "type": "string"
      },
      "referencia_em": {
       "type": "string"
      },
      "source_ref": {
       "type": "string"
      },
      "url_declarada": {
       "type": "string"
      }
     },
     "required": [
      "source_ref",
      "receipt_sha256",
      "url_declarada"
     ],
     "type": "object"
    },
    "type": [
     "null",
     "array"
    ]
   },
   "receipt_sha256": {
    "description": "SHA-256 exato do recibo, somente em modo source_ref para provar origem e URL",
    "type": "string"
   },
   "ref": {
    "description": "refer\u00eancia research:sha256:... de consulta ou research-derived:sha256:... de extra\u00e7\u00e3o local retida",
    "type": "string"
   },
   "referencia_em": {
    "description": "data ISO YYYY-MM-DD (UTC) para conferir se a aquisi\u00e7\u00e3o j\u00e1 existia at\u00e9 o encerramento do dia, sem afirmar vig\u00eancia",
    "type": "string"
   },
   "source_ref": {
    "description": "original research-source:sha256:... para descobrir derivados ou verificar recibo local",
    "type": "string"
   },
   "url_declarada": {
    "description": "URL HTTPS exata que deve coincidir com o recibo da aquisi\u00e7\u00e3o, somente em modo source_ref",
    "type": "string"
   }
  },
  "type": "object"
 },
