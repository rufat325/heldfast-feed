{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "visibility": [
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Acknowledge editor presentation"
 },
 "description": "Records whether the editor presented or refused a requested passage or difference, and when a shown pointer ends.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "document": {
    "maxLength": 64,
    "type": "string"
   },
   "editorKey": {
    "maxLength": 512,
    "type": "string"
   },
   "expectedRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "reason": {
    "maxLength": 160,
    "type": "string"
   },
   "status": {
    "enum": [
     "presented",
     "refused",
     "expired"
    ],
    "type": "string"
   },
   "viewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "document",
   "editorKey",
   "expectedRevision",
   "viewId",
   "status"
  ],
  "type": "object"
 },
 "name": "document.view_ack",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "outcome": {
    "type": "string"
   },
   "reason": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
