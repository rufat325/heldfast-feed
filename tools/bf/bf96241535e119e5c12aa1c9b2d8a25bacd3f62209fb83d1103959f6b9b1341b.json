{
 "annotations": {
  "readOnlyHint": true,
  "title": "Company news"
 },
 "description": "Latest company news for a symbol over a date range (up to 1 year back). Finnhub REST: GET /company-news.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "Start date, yyyy-mm-dd (required).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "symbol": {
    "description": "Stock ticker symbol, e.g. 'AAPL' (required).",
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "End date, yyyy-mm-dd (required).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "symbol",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "finnhub_company_news",
 "title": "Company news"
}
