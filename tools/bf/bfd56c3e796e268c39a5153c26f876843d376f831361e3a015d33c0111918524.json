  "title": "Save People As List"
 },
 "description": "Save who a find_people rule matches now as a STATIC list (list_name, optional list_id for a new list). Idempotent (re-running adds nobody twice); refuses a list_id that names a deleted or different list; never records consent. For a list that keeps itself up to date, use edit_email_campaign librarySaveAudience with the same rules.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "exclude_rules": {
    "description": "Leave out anyone matching these (e.g. came to the October dinners).",
    "items": {
     "additionalProperties": false,
     "properties": {
      "campaignId": {
       "pattern": "^[\\w-]{1,160}$",
       "type": "string"
      },
      "communityId": {
       "pattern": "^[\\w-]{1,160}$",
       "type": "string"
      },
      "currency": {
       "pattern": "^[A-Z]{3}$",
       "type": "string"
      },
      "eventId": {
       "description": "One event.",
       "pattern": "^[\\w-]{1,160}$",
       "type": "string"
      },
      "eventIds": {
       "description": "Several events (ids from list_events).",
       "items": {
        "pattern": "^[\\w-]{1,160}$",
        "type": "string"
       },
       "maxItems": 50,
       "minItems": 1,
       "type": "array"
      },
      "field": {
       "description": "eventsAttended = events they were a guest at (ticket or RSVP); attended = events checked in at the door; tickets = tickets they BOUGHT; giftedTickets = tickets bought for someone else; noShows = held a ticket but never checked in, only at events where check-in was used; netSpend / refundCents (cents, needs currency); orders; rsvp; lastAttendedAtMs / firstSeenAtMs = date of their last / first event (value may be an ISO date).",
       "enum": [
        "eventsAttended",
        "noShows",
        "giftedTickets",
        "refundCents",
        "lastAttendedAtMs",
        "firstSeenAtMs",
        "emailAccepted",
        "emailDelivered",
        "emailClicked",
        "emailReplied",
        "externalVisits",
        "externalOrders",
        "externalSpend",
        "orders",
        "surveyAnswer",
        "surveyAnswered",
        "attended",
        "rsvp",
        "tickets",
        "netSpend",
        "memberDays",
        "upgrades",
        "pageViews",
        "checkoutAttempts",
        "checkoutCompleted",
        "checkoutFailed",
        "checkoutAbandoned",
        "checkoutIncomplete",
        "lastActivityDays"
       ],
       "type": "string"
      },
      "group": {
       "description": "AND inside a group, OR across groups (0-9).",
       "maximum": 9,
       "minimum": 0,
       "type": "integer"
      },
      "op": {
       "enum": [
        "gte",
        "lte",
        "eq",
        "contains",
        "known",
        "unknown"
       ],
       "type": "string"
      },
      "questionId": {
       "pattern": "^[\\w-]{1,160}$",
       "type": "string"
      },
      "scope": {
       "description": "With eventIds or dates: 'any' = at least ONE event alone meets the condition (e.g. 2+ tickets at any one dinner); 'sum' (default) = totalled across them.",
       "enum": [
        "any",
        "sum"
       ],
       "type": "string"
      },
      "since": {
       "description": "Only events held on/after this date (no eventIds = all your events from then).",
       "maxLength": 40,
       "type": "string"
      },
      "siteId": {
       "pattern": "^[\\w-]{1,160}$",
       "type": "string"
      },
      "surveyId": {
       "pattern": "^[\\w-]{1,160}$",
       "type": "string"
      },
      "until": {
       "description": "Only events held on/before this date (inclusive).",
       "maxLength": 40,
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "maxLength": 120,
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "field",
      "op"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
