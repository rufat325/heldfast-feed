{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true,"title":"Draw a template"},"description":"Draw one of the brand's post templates with your words, as PNG or JPEG, and get a link to it that works for an hour. Templates: promotion, hours, menu, pix (send the Pix key), new-product, status-offer and carousel (5 pages). Sizes: ig-post, ig-square, ig-story, wa-status and share-card. Words that don't fit are refused, with which slot to shorten. Uses the draft unless you name a version. Costs no credits, within the hourly render allowance.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"format":{"default":"png","enum":["png","jpeg"],"type":"string"},"locale":{"enum":["pt-BR","en","es"],"type":"string"},"page":{"default":0,"maximum":19,"minimum":0,"type":"integer"},"pix":{"additionalProperties":false,"properties":{"amount":{"exclusiveMinimum":0,"maximum":1000000,"type":"number"},"city":{"maxLength":15,"minLength":1,"type":"string"},"key":{"maxLength":77,"minLength":1,"type":"string"}},"required":["key"],"type":"object"},"size":{"enum":["ig-post","ig-square","ig-story","wa-status","share-card"],"type":"string"},"slug":{"pattern":"^[a-z0-9](?:[a-z0-9-]{0,46}[a-z0-9])?$","type":"string"},"template":{"enum":["promotion","hours","menu","pix","new-product","status-offer","carousel"],"type":"string"},"text":{"additionalProperties":{"maxLength":500,"type":"string"},"default":{},"propertyNames":{"pattern":"^[a-z0-9-]{1,40}$","type":"string"},"type":"object"},"version":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["slug","template"],"type":"object"},"name":"render_template","title":"Draw a template"}
