{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Retrieve metadata for one or more FRED series \u2014 title, units, frequency, seasonal adjustment status, observation range, popularity, and notes. Accepts up to 50 series IDs. Returns partial success when some IDs fail.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "series_ids": {
    "anyOf": [
     {
      "description": "Single series ID (e.g., \"UNRATE\").",
      "minLength": 1,
      "type": "string"
     },
     {
      "description": "Array of up to 50 series IDs.",
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 1,
      "type": "array"
     }
    ],
    "description": "One series ID or an array of up to 50 series IDs."
   }
  },
  "required": [
   "series_ids"
  ],
  "type": "object"
 },
 "name": "fedreserve_get_series",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "series",
     "failed"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `series_not_found`: A series ID exists in format but FRED returns no data for it. `partial_failure`: Some IDs in the batch returned errors; partial results are returned. Other values are possible when a failure originates below the handler.",
        "examples": [
         "series_not_found",
         "partial_failure"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "failed": {
    "description": "Series IDs that could not be resolved, with per-ID error details.",
    "items": {
     "additionalProperties": false,
     "description": "A failed series fetch with its error.",
     "properties": {
      "error": {
       "description": "Error message.",
       "type": "string"
      },
      "id": {
       "description": "Series ID that failed.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "error"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "series": {
    "description": "Successfully resolved series metadata.",
    "items": {
     "additionalProperties": false,
     "description": "Metadata for one FRED series.",
     "properties": {
      "frequency": {
       "description": "Data frequency.",
       "type": "string"
      },
      "id": {
       "description": "FRED series ID.",
       "type": "string"
      },
      "last_updated": {
       "description": "ISO 8601 last update date.",
       "type": "string"
      },
      "notes": {
       "description": "Free-text notes from FRED when provided.",
       "type": "string"
      },
      "observation_end": {
       "description": "Latest available observation date.",
       "type": "string"
      },
      "observation_start": {
       "description": "Earliest available observation date.",
       "type": "string"
      },
      "popularity": {
       "description": "Popularity score (0\u2013100) when provided.",
       "type": "number"
      },
      "seasonal_adjustment": {
       "description": "Seasonal adjustment status.",
       "type": "string"
      },
      "title": {
       "description": "Series title.",
       "type": "string"
      },
      "units": {
       "description": "Units of measurement.",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "units",
      "frequency",
      "seasonal_adjustment",
      "last_updated"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Get FRED Series Metadata"
}
