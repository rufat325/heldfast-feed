{"description":"Returns du'as from a curated du'a corpus for a life context (e.g. anxiety, travel, gratitude), with source and grading where recorded. Show any crisis_resource block verbatim.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"audience":{"description":"Optional: curious, revert or practising, from the user's own self-description only. Teaching context attaches whenever an entry exists; omit when the audience is unknown.","enum":["curious","revert","practising"],"type":"string"},"context":{"description":"Life context to match against. Examples: 'anxiety', 'morning', 'travel', 'forgiveness', 'gratitude'. Send this or id, not both.","minLength":2,"type":"string"},"id":{"description":"A du'a id taken from a related reference in an earlier response. Send this or context, not both.","pattern":"^[A-Za-z0-9-]{3,40}$","type":"string"},"limit":{"description":"Number of du'as to return for a context; default 3, max 10. The response says how many more exist. Ignored with id.","maximum":10,"minimum":1,"type":"integer"},"locale":{"description":"Locale; defaults to \"en\". Du'a records are English for every locale; a crisis resource is given in the request locale, or, with no locale or \"en\", in the language of the crisis words (Indonesian, Urdu, Arabic, Turkish, Bengali or Persian).","enum":["en","id","ur","ar","tr"],"type":"string"},"offset":{"description":"Number of du'as to skip before the page, for paging with limit; default 0. Ignored with id, and on the bereaved set.","minimum":0,"type":"integer"}},"type":"object"},"name":"get_dua","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"_sakina_meta":{"additionalProperties":true,"properties":{"content_type":{"enum":["dua_collection","not_found","crisis_resource_only"],"type":"string"},"disclaimer":{"type":"string"},"disclaimer_locale":{"const":"en","type":"string"},"educational_context":{"type":"string"},"llm_directives":{"additionalProperties":true,"properties":{"CRITICAL_RULES":{"items":{"type":"string"},"type":"array"}},"required":["CRITICAL_RULES"],"type":"object"},"presentation_contract":{"additionalProperties":true,"properties":{},"type":"object"},"source":{"type":"string"},"version":{"type":"string"}},"required":["version","source","content_type","disclaimer","llm_directives","presentation_contract","educational_context"],"type":"object"},"content":{"anyOf":[{"additionalProperties":true,"properties":{"context":{"type":"string"},"duas":{"items":{"additionalProperties":true,"properties":{"arabic":{"type":"string"},"context_tags":{"items":{"type":"string"},"type":"array"},"dua_block":{"type":"string"},"grading":{"type":"string"},"grading_status":{"type":"string"},"source":{"type":"string"},"title":{"type":"string"},"translation":{"type":"string"},"transliteration":{"type":"string"}},"required":["dua_block","title","arabic","transliteration","translation","source","grading","grading_status","context_tags"],"type":"object"},"type":"array"},"grading_summary":{"additionalProperties":true,"properties":{"graded":{"type":"integer"},"not_a_narration":{"type":"integer"},"not_recorded":{"type":"integer"},"quranic":{"type":"integer"}},"required":["quranic","graded","not_a_narration","not_recorded"],"type":"object"},"id":{"type":"string"},"matched_by":{"additionalProperties":true,"properties":{"method":{"type":"string"}},"required":["method"],"type":"object"},"total_available":{"type":"integer"},"total_results":{"type":"integer"},"truncated":{"type":"boolean"}},"required":["duas","total_results"],"type":"object"},{"additionalProperties":true,"properties":{"reason":{"type":"string"},"requested":{"additionalProperties":true,"properties":{"context":{"type":"string"},"id":{"type":"string"}},"type":"object"}},"required":["requested","reason"],"type":"object"},{"additionalProperties":true,"properties":{"reason":{"type":"string"},"requested":{"additionalProperties":true,"properties":{"context":{"type":"string"},"id":{"type":"string"}},"type":"object"},"withheld":{"type":"string"}},"required":["requested","withheld","reason"],"type":"object"}]},"crisis_resource":{"additionalProperties":true,"description":"Present this block exactly, before anything else, and add nothing religious when content_type is crisis_resource_only.","properties":{"crisis_type":{"type":"string"},"directive":{"type":"string"},"level":{"enum":["hard","soft"],"type":"string"},"locale":{"type":"string"},"text":{"type":"string"}},"required":["level","locale","directive","text"],"type":"object"}},"required":["_sakina_meta","content"],"type":"object"},"title":"get_dua"}
