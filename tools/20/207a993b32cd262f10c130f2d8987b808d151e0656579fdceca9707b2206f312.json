{
 "description": "Enable or disable a test definition globally, or update its schedule/timeout. Requires admin scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "defaultSchedule": {
    "description": "Cron schedule (e.g. \"0 */6 * * *\")",
    "type": "string"
   },
   "enabled": {
    "description": "Enable or disable the test globally",
    "type": "boolean"
   },
   "slug": {
    "description": "Test plugin slug (e.g. \"http-protocol-check\")",
    "type": "string"
   },
   "timeout": {
    "description": "Timeout in milliseconds",
    "type": "number"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "update_test",
 "title": "Update Test Definition"
}
