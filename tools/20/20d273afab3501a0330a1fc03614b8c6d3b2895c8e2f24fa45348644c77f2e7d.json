  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "procedure_codes": {
    "description": "CPT procedure codes to price (e.g. [\"99213\", \"85025\"])",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "zip_code": {
    "description": "ZIP code used to pick the state (omit for national figures)",
    "type": "string"
   }
  },
  "required": [
   "procedure_codes"
  ],
  "type": "object"
 },
