{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Create a new course in a Canvas account. Returns the created course object.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "account_id": {
    "description": "The Canvas account ID to create the course in",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "course_code": {
    "description": "The course code (e.g. CS101)",
    "type": "string"
   },
   "end_at": {
    "description": "Course end date in ISO 8601 format (e.g. 2026-05-15T00:00:00Z)",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "name": {
    "description": "The name of the course",
    "type": "string"
   },
   "start_at": {
    "description": "Course start date in ISO 8601 format (e.g. 2026-01-15T00:00:00Z)",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "name"
  ],
  "type": "object"
 },
 "name": "create_course",
 "title": "Create Course"
}
