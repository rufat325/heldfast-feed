{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Clipform Results"
 },
 "description": "View response counts, choice/action answer breakdowns, and recent open-text answers for a form. Contact, file, draw, camera, and payment answers are counts only - use the dashboard for per-response detail.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "form_id": {
    "description": "The form UUID (returned by clipform_create_form, not the short share_id from the URL)",
    "type": "string"
   }
  },
  "required": [
   "form_id"
  ],
  "type": "object"
 },
 "name": "clipform_get_results",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "nodes": {
    "description": "Nodes in form order. Contact/file/draw/camera/payment nodes carry only total_responses/total_views - no per-response detail.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "node_id": {
       "type": "string"
      },
      "node_type": {
       "type": "string"
      },
      "options": {
       "description": "Answer breakdown - choice and action-category (booking/file_download/shopping) nodes only",
       "items": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "type": "number"
         },
         "label": {
          "type": "string"
         },
         "percentage": {
          "type": "number"
         }
        },
        "required": [
         "label",
         "count",
         "percentage"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "prompt": {
       "type": "string"
      },
      "recent_answers": {
       "description": "Most recent open-text answers, capped at 20 - open questions only",
       "items": {
        "additionalProperties": false,
        "properties": {
         "submitted_at": {
          "type": "string"
         },
         "text": {
          "type": "string"
         }
        },
        "required": [
         "text",
         "submitted_at"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "total_responses": {
       "type": "number"
      },
      "total_views": {
       "type": "number"
      }
     },
     "required": [
      "node_id",
      "node_type",
      "prompt",
      "total_responses",
      "total_views"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "results_url": {
    "description": "Dashboard Responses tab for this form. Not present for an anonymous caller.",
    "type": "string"
   },
   "total_responses": {
    "description": "Total unique respondents to the form",
    "type": "number"
   }
  },
  "required": [
   "total_responses",
   "nodes"
  ],
  "type": "object"
 },
 "title": "Get Clipform Results"
}
