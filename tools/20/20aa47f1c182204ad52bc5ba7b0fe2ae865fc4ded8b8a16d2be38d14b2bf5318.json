{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read one exact, current published group by publication ID. Optionally require its expected version. Withdrawn, expired, changed-address or stale-version groups fail rather than falling back to another group. Published availability remains unknown.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "expectedVersion": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "locale": {
    "enum": [
     "pt-BR",
     "pt-PT",
     "en",
     "ru",
     "es"
    ],
    "type": "string"
   },
   "publicationId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "publicationId"
  ],
  "type": "object"
 },
 "name": "get_offering",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "bookingSemantics": {
    "additionalProperties": false,
    "properties": {
     "availability": {
      "const": "unknown",
      "type": "string"
     },
     "bookingMode": {
      "const": "request_confirmation",
      "type": "string"
     },
     "createsRequest": {
      "const": false,
      "type": "boolean"
     },
     "requiresOrganizationConfirmation": {
      "const": true,
      "type": "boolean"
     },
     "reservesSeat": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "availability",
     "bookingMode",
     "createsRequest",
     "reservesSeat",
     "requiresOrganizationConfirmation"
    ],
    "type": "object"
   },
   "generation": {
    "type": "string"
   },
   "item": {
    "additionalProperties": {},
    "properties": {
     "freshness": {
      "additionalProperties": false,
      "properties": {
       "checkedAt": {
        "type": "string"
       },
       "source": {
        "const": "organization_confirmation",
        "type": "string"
       },
       "validUntil": {
        "type": "string"
       }
      },
      "required": [
       "source",
       "checkedAt",
       "validUntil"
      ],
      "type": "object"
     },
     "id": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "organizationId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "version": {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "id",
     "organizationId",
     "version",
     "freshness"
    ],
    "type": "object"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "syncedAt": {
    "type": "string"
   }
  },
  "required": [
   "revision",
   "syncedAt",
   "generation",
   "item",
   "bookingSemantics"
  ],
  "type": "object"
 }
}
