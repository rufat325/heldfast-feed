{
 "description": "Find the cheapest travel dates for a route within a date range. Scans multiple departure dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "adults": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "cabinClass": {
    "default": "economy",
    "enum": [
     "economy",
     "premium_economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "destination": {
    "description": "Arrival airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "endDate": {
    "description": "End of date range (YYYY-MM-DD)",
    "type": "string"
   },
   "origin": {
    "description": "Departure airport IATA code",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "startDate": {
    "description": "Start of date range (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "get_price_insights"
}
