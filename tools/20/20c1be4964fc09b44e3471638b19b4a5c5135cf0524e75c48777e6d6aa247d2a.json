{
 "annotations": {
  "readOnlyHint": true,
  "title": "List Files"
 },
 "description": "List files in an indexed Code-Fundi repository. Supports search by file name/path and pagination. Use the returned file IDs with code-fundi-file-docs to get documentation.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max results per page",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "number"
   },
   "order": {
    "description": "Sort direction",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "order_by": {
    "description": "Sort field (default: file_path)",
    "type": "string"
   },
   "repo_key": {
    "description": "Repository UUID or clone URL",
    "type": "string"
   },
   "search": {
    "description": "Case-insensitive substring filter on file name/path",
    "type": "string"
   }
  },
  "required": [
   "repo_key"
  ],
  "type": "object"
 },
 "name": "code-fundi-list-files"
}
