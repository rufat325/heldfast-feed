{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check whether an AI answer cites or names you"
 },
 "description": "Check one AI answer the user pasted: whether it cites the business with a link, names it without one, or leaves it out. Classifies every cited source, such as review sites, best-of lists, forums, competitors and the business's own pages, reads Google and Gemini redirect links to the pages they point to, summarizes which source types dominate, and gives the likely reason and fix when the business is not cited. Runs no AI queries of its own.",
 "inputSchema": {
  "properties": {
   "answer": {
    "maxLength": 64000,
    "minLength": 1,
    "title": "Answer",
    "type": "string"
   },
   "brand_name": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Brand Name"
   },
   "business_url": {
    "maxLength": 2048,
    "minLength": 1,
    "title": "Business Url",
    "type": "string"
   },
   "competitor_domains": {
    "default": [],
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "title": "Competitor Domains",
    "type": "array"
   },
   "language": {
    "anyOf": [
     {
      "maxLength": 20,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Language"
   },
   "platform": {
    "anyOf": [
     {
      "enum": [
       "chatgpt",
       "perplexity",
       "gemini",
       "claude",
       "ai_mode",
       "grok",
       "deepseek",
       "other"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Platform"
   }
  },
  "required": [
   "answer",
   "business_url"
  ],
  "title": "analyzedArguments",
  "type": "object"
 },
 "name": "surfacedby_analyze_answer_evidence",
 "outputSchema": {
  "$defs": {
   "AnswerDiagnosis": {
    "additionalProperties": false,
    "description": "Why an answer that does not cite the business most likely leaves it out.",
    "properties": {
     "basis": {
      "title": "Basis",
      "type": "string"
     },
     "failure_mode": {
      "title": "Failure Mode",
      "type": "string"
     },
     "label": {
      "title": "Label",
      "type": "string"
     },
     "play": {
      "title": "Play",
      "type": "string"
     }
    },
    "required": [
     "failure_mode",
     "label",
     "play",
     "basis"
    ],
    "title": "AnswerDiagnosis",
    "type": "object"
   },
   "CitedSource": {
    "additionalProperties": false,
    "description": "One link an answer cites, classified by what kind of source it is.",
    "properties": {
     "destination": {
      "title": "Destination",
      "type": "string"
     },
     "domain": {
      "title": "Domain",
      "type": "string"
     },
     "owner": {
      "enum": [
       "business",
       "competitor",
       "third_party"
      ],
      "title": "Owner",
      "type": "string"
     },
     "redirect": {
      "anyOf": [
       {
        "enum": [
         "resolved",
         "unresolved"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Redirect"
     },
     "source_type": {
      "title": "Source Type",
      "type": "string"
     },
     "source_type_label": {
      "title": "Source Type Label",
      "type": "string"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url",
     "destination",
     "domain",
     "source_type",
     "source_type_label",
     "owner"
    ],
    "title": "CitedSource",
    "type": "object"
   },
   "LinkEvidence": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "title": "Label",
      "type": "string"
     },
     "url": {
      "title": "Url",
      "type": "string"
     }
    },
    "required": [
     "url",
     "label"
    ],
    "title": "LinkEvidence",
    "type": "object"
   },
   "NextStep": {
    "additionalProperties": false,
    "description": "A deterministic pointer to the audit step this result supports next.",
    "properties": {
     "action": {
      "title": "Action",
      "type": "string"
     },
     "step": {
      "title": "Step",
      "type": "string"
     },
     "tool": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Tool"
     }
    },
    "required": [
     "step",
     "action"
    ],
    "title": "NextStep",
    "type": "object"
   },
   "SourceConcentration": {
    "additionalProperties": false,
    "properties": {
     "classified_sources": {
      "title": "Classified Sources",
      "type": "integer"
     },
     "dominant_share_percent": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Dominant Share Percent"
     },
     "dominant_source_type": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Dominant Source Type"
     },
     "placement_dominant": {
      "default": false,
      "title": "Placement Dominant",
      "type": "boolean"
     },
     "placement_share_percent": {
      "anyOf": [
       {
        "type": "number"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Placement Share Percent"
     }
    },
    "required": [
     "classified_sources"
    ],
    "title": "SourceConcentration",
    "type": "object"
   }
  },
  "additionalProperties": false,
  "properties": {
   "answer_sha256": {
    "title": "Answer Sha256",
    "type": "string"
   },
   "brand_name_ambiguous": {
    "title": "Brand Name Ambiguous",
    "type": "boolean"
   },
   "business_citations": {
    "items": {
     "$ref": "#/$defs/LinkEvidence"
    },
    "title": "Business Citations",
    "type": "array"
   },
   "cited_sources": {
    "items": {
     "$ref": "#/$defs/CitedSource"
    },
    "title": "Cited Sources",
    "type": "array"
   },
   "diagnosis": {
    "anyOf": [
     {
      "$ref": "#/$defs/AnswerDiagnosis"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "evidence_kind": {
    "const": "supplied_answer_observation",
    "default": "supplied_answer_observation",
    "title": "Evidence Kind",
    "type": "string"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "title": "Limitations",
    "type": "array"
   },
   "matched_terms": {
    "items": {
     "type": "string"
    },
    "title": "Matched Terms",
    "type": "array"
   },
   "next_steps": {
    "items": {
     "$ref": "#/$defs/NextStep"
    },
    "title": "Next Steps",
    "type": "array"
   },
   "platform": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Platform"
   },
   "presence": {
    "enum": [
     "cited",
     "named",
     "not_observed"
    ],
    "title": "Presence",
    "type": "string"
   },
   "source_concentration": {
    "anyOf": [
     {
      "$ref": "#/$defs/SourceConcentration"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "visible_citations": {
    "items": {
     "$ref": "#/$defs/LinkEvidence"
    },
    "title": "Visible Citations",
    "type": "array"
   }
  },
  "required": [
   "presence",
   "brand_name_ambiguous",
   "matched_terms",
   "visible_citations",
   "business_citations",
   "answer_sha256"
  ],
  "title": "AnswerResult",
  "type": "object"
 },
 "title": "Check whether an AI answer cites or names you"
}
