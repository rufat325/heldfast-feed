{
 "description": "Compute pairwise Pearson correlation of oracle provider deviations for an asset over a date range. Helps identify independent vs correlated providers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "symbol": {
    "description": "Asset symbol, e.g. BTC, ETH",
    "type": "string"
   },
   "to": {
    "description": "End date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "get_correlation"
}
