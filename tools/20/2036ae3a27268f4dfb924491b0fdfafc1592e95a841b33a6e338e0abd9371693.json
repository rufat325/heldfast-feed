{
 "description": "Search npm packages by keyword",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "query": {
    "description": "Search query",
    "type": "string"
   },
   "size": {
    "default": 10,
    "description": "Number of results",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "npm_search"
}
