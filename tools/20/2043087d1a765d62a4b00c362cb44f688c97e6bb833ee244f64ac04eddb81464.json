{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "Run a Microsoft Search query across SharePoint content with full control over entity types and result shape.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entity_types": {
    "description": "Entity types to search (default: ['driveItem', 'listItem']).",
    "items": {
     "enum": [
      "driveItem",
      "listItem",
      "list",
      "site",
      "drive"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "fields": {
    "description": "Specific managed properties to include in results.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "from": {
    "description": "Offset for pagination (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query_string": {
    "description": "Search query string. KQL syntax supported.",
    "type": "string"
   },
   "size": {
    "description": "Number of results (default 25).",
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "query_string"
  ],
  "type": "object"
 },
 "name": "search"
}
