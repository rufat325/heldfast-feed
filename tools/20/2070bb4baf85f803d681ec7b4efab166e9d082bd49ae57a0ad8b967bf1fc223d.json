{
 "description": "Generate a PDF from a URL or HTML content. Supports custom margins, headers/footers, page ranges, and scaling. Saves the PDF to disk and returns the file path.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delay": {
    "description": "Milliseconds to wait before rendering (default: 0)",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "displayHeaderFooter": {
    "description": "Show header and footer (default: false)",
    "type": "boolean"
   },
   "footerTemplate": {
    "description": "HTML template for page footer",
    "type": "string"
   },
   "format": {
    "description": "Paper format: A4, Letter, Legal, Tabloid, A3, A5 (default: A4)",
    "type": "string"
   },
   "headerTemplate": {
    "description": "HTML template for page header (uses Chromium templating)",
    "type": "string"
   },
   "html": {
    "description": "Raw HTML to render as PDF (required if no url)",
    "type": "string"
   },
   "landscape": {
    "description": "Landscape orientation (default: false)",
    "type": "boolean"
   },
   "margin": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "bottom": {
        "type": "string"
       },
       "left": {
        "type": "string"
       },
       "right": {
        "type": "string"
       },
       "top": {
        "type": "string"
       }
      },
      "type": "object"
     }
    ],
    "description": "CSS margin \u2014 string for all sides (e.g. \"1cm\") or object { top, right, bottom, left }"
   },
   "pageRanges": {
    "description": "Page ranges to include, e.g. \"1-5, 8\"",
    "type": "string"
   },
   "printBackground": {
    "description": "Include CSS backgrounds (default: true)",
    "type": "boolean"
   },
   "saveTo": {
    "description": "Output file path (default: ./output.pdf)",
    "type": "string"
   },
   "scale": {
    "description": "Rendering scale 0.1-2 (default: 1)",
    "maximum": 2,
    "minimum": 0.1,
    "type": "number"
   },
   "url": {
    "description": "URL to render as PDF (required if no html)",
    "format": "uri",
    "type": "string"
   },
   "width": {
    "description": "Page width (overrides format) \u2014 CSS value like \"8.5in\"",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_pdf"
}
