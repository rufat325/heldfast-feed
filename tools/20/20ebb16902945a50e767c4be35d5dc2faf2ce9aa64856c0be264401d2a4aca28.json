{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Before relying on another agent or API, check its claims against what was actually observed. Pass `claims` (each with an `id`), optional `observations` ({claim_id, result: PASS|FAIL, detail}) and its `metadata`. Returns per-claim OBSERVED_AS_REPORTED / CONTRADICTED / MIXED / UNTESTED with pass/fail counts and evidence, warnings for unusable observations, an interface check and a receipt. Not a certification. Free, read-only, no account. Inputs must be public and non-personal; calling declares that (data_classification defaults to PUBLIC).",
 "inputSchema": {
  "additionalProperties": true,
  "examples": [
   {
    "claims": [
     {
      "id": "c1",
      "text": "Returns JSON forecasts over MCP"
     },
     {
      "id": "c2",
      "text": "Responds within 2 seconds"
     }
    ],
    "counterparty_id": "example-weather-agent",
    "metadata": {
     "protocolVersion": "2025-06-18",
     "url": "https://weather.example.com/mcp"
    },
    "observations": [
     {
      "claim_id": "c1",
      "detail": "tools/call returned valid JSON",
      "result": "PASS"
     },
     {
      "claim_id": "c2",
      "detail": "p95 latency 4.8 s over 20 calls",
      "result": "FAIL"
     }
    ]
   }
  ],
  "properties": {
   "claims": {
    "items": {
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "continuity_handle": {
    "additionalProperties": false,
    "properties": {
     "continuity_id": {
      "type": "string"
     },
     "token": {
      "type": "string"
     }
    },
    "required": [
     "continuity_id",
     "token"
    ],
    "type": "object"
   },
   "counterparty_id": {
    "description": "Name or URL of the agent/service. Optional.",
    "type": "string"
   },
   "data_classification": {
    "default": "PUBLIC",
    "enum": [
     "PUBLIC",
     "NON_PERSONAL_PUBLIC"
    ],
    "type": "string"
   },
   "episode_id": {
    "type": "string"
   },
   "independent_operator_id": {
    "type": "string"
   },
   "metadata": {
    "type": "object"
   },
   "observations": {
    "items": {
     "type": "object"
    },
    "maxItems": 30,
    "type": "array"
   },
   "protocol": {
    "description": "Counterparty protocol. Inferred from metadata when omitted, otherwise MCP.",
    "enum": [
     "A2A",
     "MCP",
     "OPENAPI"
    ],
    "type": "string"
   },
   "synthetic": {
    "type": "boolean"
   },
   "task_class": {
    "default": "supplier_claim_check",
    "type": "string"
   }
  },
  "required": [
   "claims",
   "metadata"
  ],
  "type": "object"
 },
 "name": "gaip_verify_supplier_claims",
 "title": "Compare supplier claims"
}
