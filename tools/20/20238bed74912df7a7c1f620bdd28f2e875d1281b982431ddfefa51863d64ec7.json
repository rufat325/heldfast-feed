{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch clean, source-grounded text for a public article or YouTube URL, budgeted to a token limit and addressable by paragraph anchor. Returns an outline of headings (empty when the source has none), the requested window, and a next_cursor when more remains. Prefer search_article when you have a specific question rather than needing the whole text.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "minimum": 1,
    "type": "integer"
   },
   "max_tokens": {
    "maximum": 25000,
    "minimum": 100,
    "type": "integer"
   },
   "url": {
    "format": "uri",
    "maxLength": 4096,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "get_article",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "author": {
    "type": [
     "string",
     "null"
    ]
   },
   "cache_hit": {
    "type": "boolean"
   },
   "content_quality": {
    "type": [
     "string",
     "null"
    ]
   },
   "extraction_source": {
    "type": "string"
   },
   "from_anchor": {
    "type": [
     "number",
     "null"
    ]
   },
   "language": {
    "type": [
     "string",
     "null"
    ]
   },
   "next_cursor": {
    "type": [
     "number",
     "null"
    ]
   },
   "outline": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "anchor": {
       "type": "number"
      },
      "text": {
       "type": "string"
      }
     },
     "required": [
      "anchor",
      "text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "published_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "publisher": {
    "type": [
     "string",
     "null"
    ]
   },
   "reader_url": {
    "type": "string"
   },
   "responded_at": {
    "type": "string"
   },
   "source_url": {
    "type": "string"
   },
   "text": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "to_anchor": {
    "type": [
     "number",
     "null"
    ]
   },
   "tokens_returned": {
    "type": "number"
   },
   "total_blocks": {
    "type": "number"
   },
   "total_tokens": {
    "type": "number"
   }
  },
  "required": [
   "source_url",
   "reader_url",
   "title",
   "author",
   "publisher",
   "published_at",
   "language",
   "extraction_source",
   "content_quality",
   "cache_hit",
   "responded_at",
   "total_blocks",
   "total_tokens",
   "text",
   "from_anchor",
   "to_anchor",
   "tokens_returned",
   "next_cursor",
   "outline"
  ],
  "type": "object"
 },
 "title": "Read an article with smry"
}
