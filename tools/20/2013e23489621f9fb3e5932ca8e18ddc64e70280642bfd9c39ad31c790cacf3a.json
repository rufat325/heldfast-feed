{
 "description": "Create a Veo 3.1 task on RunAPI (upscale video). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "callback_url": {
    "type": "string"
   },
   "index": {
    "type": "number"
   },
   "output_resolution": {
    "enum": [
     "1080p",
     "4k"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "source_task_id": {
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "upscale_video"
}
