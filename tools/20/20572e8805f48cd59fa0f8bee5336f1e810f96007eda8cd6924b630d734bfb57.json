{
 "description": "Plan a full D&D 5e adventuring day. Calculates the daily XP budget, suggests encounter difficulty distribution, and recommends short rest placement.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "difficulty_mix": {
    "description": "Specific difficulty for each encounter (length must match num_encounters). If omitted, defaults to a balanced mix.",
    "items": {
     "enum": [
      "easy",
      "medium",
      "hard",
      "deadly"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "num_encounters": {
    "default": 6,
    "description": "Planned number of encounters",
    "maximum": 12,
    "minimum": 1,
    "type": "number"
   },
   "party_level": {
    "description": "Average party level",
    "maximum": 20,
    "minimum": 1,
    "type": "number"
   },
   "party_size": {
    "description": "Number of party members",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "party_size",
   "party_level"
  ],
  "type": "object"
 },
 "name": "plan_adventuring_day"
}
