   "bulkNote": {
    "description": "Step 2 note prepended to confirmed rows (max 120 characters).",
    "type": "string"
   },
   "confirm": {
    "description": "Step 2: true writes the staged selection only after user approval.",
    "type": "boolean"
   },
   "csvContent": {
    "description": "Step 1 ChatGPT attachment; securely downloaded and decoded.",
    "properties": {
     "download_url": {
      "description": "Temporary HTTPS URL supplied by ChatGPT for downloading the attachment.",
      "format": "uri",
      "type": "string"
     },
     "file_id": {
      "description": "Attachment identifier supplied by ChatGPT.",
      "type": "string"
     },
     "file_name": {
      "description": "Original attachment filename supplied by ChatGPT.",
      "type": "string"
     },
     "mime_type": {
      "description": "Attachment MIME type supplied by ChatGPT.",
      "type": "string"
     }
    },
    "required": [
     "download_url",
     "file_id"
    ],
    "type": "object"
   },
   "csvText": {
    "description": "Step 1 inline CSV/TSV/text fallback; ChatGPT should use csvContent.",
    "type": "string"
   },
   "keepBothIndexes": {
    "description": "Step 2 duplicate indexes the user explicitly approved keeping.",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
