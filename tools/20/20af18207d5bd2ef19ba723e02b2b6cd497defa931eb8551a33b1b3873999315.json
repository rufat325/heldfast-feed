{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "moderated prices/store/date/promos. Not MOET/live offers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "area": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "page_size": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "product_id": {
    "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$",
    "type": "string"
   },
   "purchased_since": {
    "format": "date",
    "type": "string"
   },
   "sort": {
    "default": "-purchased_on",
    "enum": [
     "-purchased_on",
     "purchased_on",
     "unit_price_aed"
    ]
   },
   "store_id": {
    "pattern": "^[a-z0-9][a-z0-9._-]{0,119}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "shopper_price_reports",
 "outputSchema": {
  "$defs": {},
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "moderation_status": {
         "const": "accepted"
        },
        "product_id": {
         "type": "string"
        },
        "promo": {
         "type": "boolean"
        },
        "provenance": {
         "additionalProperties": true,
         "required": [
          "source_id",
          "license_id",
          "source_url",
          "observed_on",
          "observed_at",
          "published_on",
          "published_at",
          "retrieved_at",
          "stale",
          "status",
          "paused_since",
          "flags"
         ],
         "type": "object"
        },
        "purchased_on": {
         "type": "string"
        },
        "report_id": {
         "type": "string"
        },
        "store_id": {
         "type": "string"
        },
        "unit_price_aed": {
         "type": "number"
        }
       },
       "required": [
        "report_id",
        "product_id",
        "store_id",
        "purchased_on",
        "unit_price_aed",
        "promo",
        "moderation_status",
        "provenance"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "links": {
      "additionalProperties": false,
      "properties": {
       "docs": {
        "type": "string"
       },
       "next": {
        "type": [
         "string",
         "null"
        ]
       },
       "open_in_browser": {
        "type": [
         "string",
         "null"
        ]
       },
       "self": {
        "type": "string"
       }
      },
      "required": [
       "self",
       "next",
       "open_in_browser",
       "docs"
      ],
      "type": "object"
     },
     "meta": {
      "additionalProperties": true,
      "required": [
       "api_version",
       "content_language",
       "generated_at",
       "currency",
       "attribution",
       "disclaimer",
       "dataset",
       "page"
      ],
      "type": "object"
     }
    },
    "required": [
     "meta",
     "data",
     "links"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "retry_after_s": {
        "type": [
         "integer",
         "null"
        ]
       },
       "retryable": {
        "type": "boolean"
       }
      },
      "required": [
       "code",
       "message",
       "retryable",
       "retry_after_s"
      ],
      "type": "object"
     },
     "request_id": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "error",
     "request_id"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
