  "title": "Check Crypto Buying Power"
 },
 "description": "Checks whether the user's VERIFIED crypto appears to cover a property price. Compares target_price_usd against verified buying power (the most a Proof of Funds letter can state, from verified wallets only) and lists what is still incomplete: identity check, wallet verification, or a shortfall. Optionally narrows to one asset. Use for \"can my Bitcoin cover a $2 million home?\" and before generating a Proof of Funds letter for a specific amount. Unverified wallets never count. This is an estimate of coverage, not a loan decision. Read-only: it does not move, sell, convert, or reserve any crypto.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asset": {
    "description": "Limit the check to one crypto asset, as a ticker or name (BTC, Bitcoin, ZEC)",
    "type": "string"
   },
   "target_price_usd": {
    "description": "Property price or Proof of Funds amount in US dollars. Omit to use the saved price, or to just report verified buying power.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
