{
 "description": "Update an existing automation rule. Any field not provided will remain unchanged.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "description": "Updated actions",
    "items": {
     "additionalProperties": false,
     "properties": {
      "delayMs": {
       "maximum": 600000,
       "minimum": 0,
       "type": "integer"
      },
      "note": {
       "maxLength": 1000,
       "type": "string"
      },
      "severity": {
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "type": {
       "enum": [
        "escalate",
        "suppress",
        "rerun",
        "notify",
        "webhook",
        "add_note"
       ],
       "type": "string"
      },
      "webhookUrl": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "conditions": {
    "additionalProperties": false,
    "description": "Updated conditions",
    "properties": {
     "minRecurrence": {
      "minimum": 1,
      "type": "integer"
     },
     "severities": {
      "items": {
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "targetIds": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "testSlugs": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "isEnabled": {
    "description": "Enable or disable the rule",
    "type": "boolean"
   },
   "name": {
    "description": "Updated rule name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "priorityOrder": {
    "description": "Updated priority order",
    "type": "integer"
   },
   "ruleId": {
    "description": "The automation rule ID to update",
    "type": "string"
   },
   "targetId": {
    "description": "Updated target scope (null to remove target scoping)",
    "type": [
     "string",
     "null"
    ]
   },
   "trigger": {
    "description": "Updated trigger event",
    "enum": [
     "TEST_FAILED",
     "TEST_RECOVERED",
     "INCIDENT_CREATED",
     "INCIDENT_RESOLVED",
     "TARGET_DOWN",
     "TARGET_RECOVERED"
    ],
    "type": "string"
   }
  },
  "required": [
   "ruleId"
  ],
  "type": "object"
 },
 "name": "update_automation_rule",
 "title": "Update Automation Rule"
}
