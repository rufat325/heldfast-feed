{
 "description": "Compute an A+-F trust score for an MCP server across 8 security dimensions (like SSL Labs for MCP)",
 "inputSchema": {
  "properties": {
   "authMethod": {
    "description": "Authentication method",
    "enum": [
     "none",
     "api_key",
     "oauth2",
     "oauth2_mtls"
    ],
    "type": "string"
   },
   "cveCount": {
    "description": "Number of known CVEs",
    "type": "number"
   },
   "maxCvss": {
    "description": "Maximum CVSS score",
    "type": "number"
   },
   "serverName": {
    "description": "Server name to score",
    "type": "string"
   },
   "transport": {
    "description": "Transport protocol",
    "enum": [
     "stdio",
     "http",
     "https",
     "mTLS"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "compute_trust_score"
}
