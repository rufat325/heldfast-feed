{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new contact (customer or supplier) in Billy. Returns the created contact including its ID.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "cityText": {
    "description": "City name",
    "type": "string"
   },
   "contactNo": {
    "description": "Your own reference number for the contact",
    "type": "string"
   },
   "countryId": {
    "description": "Country code, e.g. 'DK', 'US'",
    "type": "string"
   },
   "email": {
    "description": "Email used for invoicing (creates a contact person)",
    "type": "string"
   },
   "isCustomer": {
    "description": "Contact can receive invoices",
    "type": "boolean"
   },
   "isSupplier": {
    "description": "Contact can have bills",
    "type": "boolean"
   },
   "name": {
    "description": "Company or person name",
    "type": "string"
   },
   "paymentTermsDays": {
    "description": "Days for the payment terms mode",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "paymentTermsMode": {
    "description": "Payment terms mode, e.g. 'net'",
    "type": "string"
   },
   "phone": {
    "description": "Phone number",
    "type": "string"
   },
   "registrationNo": {
    "description": "VAT/CVR/tax registration number",
    "type": "string"
   },
   "street": {
    "description": "Street address",
    "type": "string"
   },
   "type": {
    "description": "Contact type (default 'company')",
    "enum": [
     "company",
     "person"
    ],
    "type": "string"
   },
   "verbose": {
    "description": "Return the full Billy response. Default false: compact records with key fields only (saves ~90% context)",
    "type": "boolean"
   },
   "zipcodeText": {
    "description": "Zip/postal code",
    "type": "string"
   }
  },
  "required": [
   "name",
   "countryId"
  ],
  "type": "object"
 },
 "name": "create_contact"
}
