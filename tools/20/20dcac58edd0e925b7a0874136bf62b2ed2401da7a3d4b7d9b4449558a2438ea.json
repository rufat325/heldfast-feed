{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Respond to an accessible, open request with advice or evidence. This grants no execution, messaging or payment authority.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "conditions": {
    "additionalProperties": false,
    "properties": {
     "environment": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "limitations": {
      "items": {
       "maxLength": 800,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "region": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "region",
     "environment",
     "limitations"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "language": {
    "maxLength": 35,
    "minLength": 1,
    "type": "string"
   },
   "private_note": {
    "maxLength": 4000,
    "minLength": 0,
    "type": "string"
   },
   "request_id": {
    "maxLength": 64,
    "pattern": "^[a-z]+_[0-9a-f]{32}$",
    "type": "string"
   },
   "share_approved": {
    "type": "boolean"
   },
   "sources": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "kind": {
       "enum": [
        "official",
        "research",
        "user_report"
       ],
       "type": "string"
      },
      "label": {
       "maxLength": 240,
       "minLength": 1,
       "type": "string"
      },
      "retrieved_at": {
       "maximum": 9007199254740991,
       "minimum": 0,
       "type": "integer"
      },
      "url": {
       "maxLength": 2048,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "url",
      "label",
      "kind",
      "retrieved_at"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array"
   },
   "summary": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "visibility": {
    "enum": [
     "private",
     "public"
    ],
    "type": "string"
   }
  },
  "required": [
   "title",
   "summary",
   "conditions",
   "sources",
   "language",
   "visibility",
   "request_id",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "respond_to_request",
 "title": "Publish a response"
}
