{
 "description": "Buy a token with its pair currency (BNB for most). DRY RUN unless the owner set MM_LIVE=1; always within the owner's caps and allowlist.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "how much of the pair currency to spend",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "referrer": {
    "$ref": "#/properties/token"
   },
   "slippageBps": {
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "token": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "required": [
   "token",
   "amount"
  ],
  "type": "object"
 },
 "name": "buy"
}
