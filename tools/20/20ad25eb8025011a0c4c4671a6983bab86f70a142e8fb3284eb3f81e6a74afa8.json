{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get Calendar"
 },
 "description": "Get a day-by-day grid of recovery, sleep, and strain for a date range. Perfect for weekly/monthly overviews.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "description": "Number of days to show. Default: 7. Max: 90.",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "start": {
    "description": "ISO 8601 start date (YYYY-MM-DD). When provided, the calendar grid starts at this date and iterates forward for `days` days, clamped to today.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_calendar",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "averages": {
    "additionalProperties": false,
    "properties": {
     "recovery": {
      "type": [
       "number",
       "null"
      ]
     },
     "sleep_hours": {
      "type": [
       "number",
       "null"
      ]
     },
     "strain": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "recovery",
     "sleep_hours",
     "strain"
    ],
    "type": "object"
   },
   "days": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "day_strain": {
       "type": [
        "number",
        "null"
       ]
      },
      "recovery_score": {
       "type": [
        "number",
        "null"
       ]
      },
      "recovery_zone": {
       "anyOf": [
        {
         "enum": [
          "green",
          "yellow",
          "red"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "sleep_hours": {
       "type": [
        "number",
        "null"
       ]
      },
      "sleep_performance_pct": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "date",
      "recovery_score",
      "recovery_zone",
      "sleep_hours",
      "sleep_performance_pct",
      "day_strain"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "period": {
    "additionalProperties": false,
    "properties": {
     "days": {
      "type": "number"
     },
     "end": {
      "type": "string"
     },
     "start": {
      "type": "string"
     }
    },
    "required": [
     "start",
     "end",
     "days"
    ],
    "type": "object"
   }
  },
  "required": [
   "period",
   "days",
   "averages"
  ],
  "type": "object"
 }
}
