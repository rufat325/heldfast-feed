{
 "description": "Create a saved WorkspaceView manifest over live workspace data.\n\nWorkspace Views are general operating surfaces, not KG-only reports. Data sources can include KG lists/text, workflow executions/output pages/timelines, pending approvals, agent approvals, action queues, routine runs, external APIs, and custom sources. Creating the view writes only the manifest; it does not read sources, run workflows, insert KG rows, send messages, call providers, make approval decisions, or spend credits.\n\nRequires write access when connected with OAuth.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "description": "View action manifest",
    "items": {
     "additionalProperties": false,
     "properties": {
      "actionId": {
       "description": "Action id for app.action actions",
       "type": "string"
      },
      "appId": {
       "description": "App id for app.action actions",
       "type": "string"
      },
      "approvalRequired": {
       "description": "Set true for writes, sends, approvals, provider actions, and other side effects",
       "type": "boolean"
      },
      "config": {
       "additionalProperties": {},
       "description": "Action-specific config",
       "type": "object"
      },
      "dataSourceId": {
       "description": "Source id whose row data feeds this action",
       "type": "string"
      },
      "destructive": {
       "description": "Set true for delete/archive/destructive actions",
       "type": "boolean"
      },
      "id": {
       "description": "Stable action id",
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "description": "Action kind. Writes/sends/destructive operations still require normal approval gates.",
       "enum": [
        "open_url",
        "navigate",
        "kg.update_rows",
        "kg.upsert_rows",
        "workflow.start",
        "workflow.open",
        "approval.request",
        "approval.decide",
        "app.action",
        "custom"
       ],
       "type": "string"
      },
      "label": {
       "description": "Button/menu label",
       "minLength": 1,
       "type": "string"
      },
      "targetPath": {
       "description": "Path in the selected row/source to use as the action target",
       "type": "string"
      },
      "urlPath": {
       "description": "Path in row data for open_url actions",
       "type": "string"
      },
      "workflowId": {
       "description": "Workflow id for workflow actions",
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "agentIds": {
    "description": "Linked agent ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "approvalIds": {
    "description": "Linked approval ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "collaboratorUserIds": {
    "description": "Collaborator user ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "config": {
    "additionalProperties": {},
    "description": "Additional config",
    "type": "object"
   },
   "dataSourceIds": {
    "description": "Linked data source ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dataSources": {
    "description": "Data source manifest",
    "items": {
     "additionalProperties": false,
     "properties": {
      "actionId": {
       "description": "Action id for app/action-backed sources",
       "type": "string"
      },
      "agentId": {
       "description": "Agent id for agent-backed sources",
       "type": "string"
      },
      "appId": {
       "description": "App id for app/action-backed sources",
       "type": "string"
      },
      "approvalSource": {
       "description": "Approval source for approval-backed views",
       "enum": [
        "workflow",
        "agent",
        "any"
       ],
       "type": "string"
      },
      "config": {
       "additionalProperties": {},
       "description": "Source-specific config",
       "type": "object"
      },
      "dataPath": {
       "description": "Path in the source response to bind into the view data object",
       "type": "string"
      },
      "executionId": {
       "description": "Optional execution id for execution-specific sources",
       "type": "string"
      },
      "id": {
       "description": "Stable source id used by layout/transforms, e.g. \"followups\"",
       "minLength": 1,
       "type": "string"
      },
      "kind": {
       "description": "Source kind. KG is supported but not required; views can use workflows, approvals, agents, routines, app queues, external APIs, or custom sources.",
       "enum": [
        "kg.list",
        "kg.text",
        "workflow.executions",
        "workflow.output_page",
        "workflow.timeline",
        "approvals.pending",
        "agent.approvals",
        "actions.queue",
        "routine.runs",
        "external.api",
        "custom"
       ],
       "type": "string"
      },
      "label": {
       "description": "Human-readable source label",
       "type": "string"
      },
      "limit": {
       "description": "Optional source-specific row limit",
       "exclusiveMinimum": 0,
       "maximum": 1000,
       "type": "integer"
      },
      "listKey": {
       "description": "Knowledge list key when kind is kg.list",
       "type": "string"
      },
      "outputPagePathname": {
       "description": "Output page pathname for workflow.output_page sources",
       "type": "string"
      },
      "required": {
       "description": "Whether the view is incomplete when this source is missing",
       "type": "boolean"
      },
      "routineId": {
       "description": "Routine id for routine-backed sources",
       "type": "string"
      },
      "status": {
       "description": "Optional source-specific status filter",
       "type": "string"
      },
      "textKey": {
       "description": "Knowledge text key when kind is kg.text",
       "type": "string"
      },
      "timelineId": {
       "description": "Optional timeline id for timeline-specific sources",
       "type": "string"
      },
      "url": {
       "description": "External API URL for external.api or custom sources",
       "type": "string"
      },
      "workflowId": {
       "description": "Workflow id for workflow-backed sources",
       "type": "string"
      }
     },
     "required": [
      "id",
      "kind"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "description": "View description",
    "type": "string"
   },
   "executionIds": {
    "description": "Linked execution ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "externalSourceIds": {
    "description": "Linked external source ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filters": {
    "additionalProperties": {},
    "description": "Filter manifest",
    "type": "object"
   },
   "iconName": {
    "description": "Lucide icon name",
    "type": "string"
   },
   "key": {
    "description": "Stable workspace-local key, e.g. linkedin-operating-view",
    "type": "string"
   },
   "knowledgeListKeys": {
    "description": "Linked KG list keys",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "knowledgeTextKeys": {
    "description": "Linked KG text keys",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "layout": {
    "additionalProperties": {},
    "description": "ConfigLayout-compatible renderer manifest",
    "type": "object"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Additional metadata",
    "type": "object"
   },
   "name": {
    "description": "View display name",
    "minLength": 1,
    "type": "string"
   },
   "ownerUserId": {
    "description": "Owner user id",
    "type": "string"
   },
   "pinned": {
    "description": "Whether this view is a workspace-level operating surface",
    "type": "boolean"
   },
   "refreshPolicy": {
    "additionalProperties": {},
    "description": "Refresh policy",
    "type": "object"
   },
   "routineIds": {
    "description": "Linked routine ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "source": {
    "description": "How this view was created; defaults to agent",
    "enum": [
     "agent",
     "user",
     "system",
     "template",
     "imported"
    ],
    "type": "string"
   },
   "status": {
    "description": "Lifecycle status; defaults to draft",
    "enum": [
     "draft",
     "active",
     "paused",
     "archived"
    ],
    "type": "string"
   },
   "transforms": {
    "additionalProperties": {},
    "description": "Transform manifest",
    "type": "object"
   },
   "useCaseIds": {
    "description": "Linked WorkspaceUseCase ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "validation": {
    "additionalProperties": {},
    "description": "Validation metadata",
    "type": "object"
   },
   "viewType": {
    "description": "View type",
    "enum": [
     "dashboard",
     "list",
     "funnel",
     "approval_queue",
     "report",
     "custom"
    ],
    "type": "string"
   },
   "workflowIds": {
    "description": "Linked workflow ids",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workspaceSlug": {
    "description": "Optional workspace slug for readable ids when known",
    "type": "string"
   }
  },
  "required": [
   "name",
   "dataSources",
   "layout"
  ],
  "type": "object"
 },
 "name": "create_workspace_view"
}
