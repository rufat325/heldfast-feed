{
 "description": "Browse published concerts with filtering, sorting, and search. Returns catalog with stats, ratings, listen links, and display tags. Authenticated requests include recommended_concerts (top 5 personalized).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "genre": {
    "description": "Filter by genre",
    "type": "string"
   },
   "limit": {
    "description": "Results per page",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "mode": {
    "description": "Filter by concert mode",
    "enum": [
     "loop",
     "scheduled"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Full-text + semantic search across concert and track titles/artists",
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "newest",
     "oldest",
     "title"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_concerts"
}
