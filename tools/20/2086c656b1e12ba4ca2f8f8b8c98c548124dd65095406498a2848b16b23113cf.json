{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\uc804 \uc5c5\uc885 \uc5c5\uccb4 \ucc3e\uae30(\uc804\uad6d 270\ub9cc \uacf3 \ub118\uac8c \u00b7 \uc804\ud1b5\uc2dc\uc7a5 \ud3ec\ud568)"},"description":"Find operating businesses of any industry in a Korean province, city or district (2.7M+ public store records; name order, not a ranking). With category \uc804\ud1b5\uc2dc\uc7a5 (or \uc624\uc77c\uc7a5, \uc7a5\ub0a0, \"traditional market\") it also returns that area's traditional markets with market days. [\ubcf4\uc784 \u2014 \ud55c\uad6d \uc5c5\uccb4\u00b7\uc785\ucc30 \uacf5\uace0 \ucc3e\uae30] \uc74c\uc2dd\u00b7\uc18c\ub9e4\u00b7\uc218\ub9ac\u00b7\uac1c\uc778 \uc11c\ube44\uc2a4\u00b7\uacfc\ud559\u00b7\uae30\uc220\u00b7\uad50\uc721\u00b7\ubcf4\uac74\uc758\ub8cc\u00b7\ubd80\ub3d9\uc0b0\u00b7\uc219\ubc15\u00b7\uc2dc\uc124\uad00\ub9ac\u00b7\uc784\ub300\u00b7\uc608\uc220\u00b7\uc2a4\ud3ec\uce20 \ub4f1 \ubaa8\ub4e0 \uc5c5\uc885(\uc0c1\uad8c\uc5c5\uc885 \uc18c\ubd84\ub958 247\uac1c)\uc758 \uc804\uad6d \uc601\uc5c5 \uc911 \uc5c5\uccb4\ub97c \uc2dc\u00b7\ub3c4\u00b7\uc2dc\uad70\uad6c(\u00b7\ud589\uc815\ub3d9)\uc640 \uc5c5\uc885\uc73c\ub85c \ucc3e\uc2b5\ub2c8\ub2e4(\uc9c0\uc5ed \ud544\uc218). \uc18c\uc0c1\uacf5\uc778\uc2dc\uc7a5\uc9c4\ud765\uacf5\ub2e8 \uc0c1\uac00(\uc0c1\uad8c)\uc815\ubcf4 \uacf5\uacf5 \ub370\uc774\ud130\ub85c, \uc0c1\ud638\u00b7\uc5c5\uc885\u00b7\ud589\uc815\ub3d9\ub9cc \uc788\uace0(\uc0c1\uc138 \uc8fc\uc18c\u00b7\uc804\ud654 \uc5c6\uc74c) \uc21c\uc11c\ub294 \uc774\ub984\uc21c\uc785\ub2c8\ub2e4(\ud3c9\uac00 \uc544\ub2d8). \uacb0\uacfc\ub9c8\ub2e4 \uc2dc\uad70\uad6c\u00d7\uc5c5\uc885 \ubaa9\ub85d \uc8fc\uc18c(list_page)\uc640, \uc5c5\uccb4\uac00 \uc9c1\uc811 \ub4f1\ub85d\ud574 \ud558\ub294 \uc77c\u00b7\uc5f0\ub77d\ucc98\u00b7\uac00\uaca9 \uc548\ub0b4\ub97c \uc62c\ub838\ub294\uc9c0 \ud655\uc778\ud560 \uc218 \uc788\ub294 AI \uc900\ube44\ub3c4 \uc8fc\uc18c(ready)\uac00 \ubd99\uc2b5\ub2c8\ub2e4. \uacf5\uacf5 \uc870\ub2ec \uc2e4\uc801\uc774\ub098 \uc5c5\uccb4\uac00 \uc9c1\uc811 \ub4f1\ub85d\ud55c \uc815\ubcf4\uac00 \uc788\ub294 \uc5c5\uccb4 \uce74\ub4dc\ub294 search_vendors\uac00 \ub354 \uc790\uc138\ud569\ub2c8\ub2e4. category\uc5d0 '\uc804\ud1b5\uc2dc\uc7a5'\u00b7'\uc624\uc77c\uc7a5'\u00b7'\uc7a5\ub0a0'\uc744 \ub123\uc73c\uba74 \uadf8 \uc9c0\uc5ed \uc804\ud1b5\uc2dc\uc7a5(\uc7a5\ub0a0\u00b7\uc810\ud3ec\u00b7\uc8fc\ucc28\u00b7\ud654\uc7a5\uc2e4, \uacf5\uacf5\ub370\uc774\ud130)\uc744 markets \uce78\uc73c\ub85c \ud568\uaed8 \ub3cc\ub824\uc90d\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"category":{"description":"\uc5c5\uc885(\uc608: \ud55c\uc2dd, \uce74\ud398, \ubbf8\uc6a9\uc2e4, \uce58\uacfc, \uc138\ud0c1\uc18c, \uc778\ud14c\ub9ac\uc5b4, \ud559\uc6d0, \uc804\ud1b5\uc2dc\uc7a5). \uc18c\ubd84\ub958\u00b7\uc911\ubd84\ub958\u00b7\ub300\ubd84\ub958 \uc774\ub984 \uc77c\ubd80","type":"string"},"limit":{"default":20,"description":"\ubcf4\uc5ec \uc904 \ucd5c\ub300 \uac74\uc218(1~50). \uacb0\uacfc\uac00 \uc774\ubcf4\ub2e4 \ub9ce\uac70\ub098 \uacf5\uac1c \ud55c\ub3c4(5\uac74)\ub97c \ub118\uc73c\uba74 \ub098\uba38\uc9c0\ub294 \uacb0\uacfc\uc758 not_shown \uc218\uc640 more \uc8fc\uc18c\ub85c \uc54c\ub824 \uc90d\ub2c8\ub2e4","maximum":50,"minimum":1,"type":"integer"},"query":{"description":"\uc0c1\ud638\uc5d0 \ub4e4\uc5b4\uac04 \ub9d0(region \uc548\uc5d0\uc11c \ucc3e\ub294\ub2e4)","type":"string"},"region":{"description":"\uc2dc\u00b7\ub3c4\uc640 \uc2dc\u00b7\uad70\u00b7\uad6c(\uc608: \uc138\uc885, \ub300\uc804 \uc720\uc131\uad6c, \uc11c\uc6b8 \uac15\ub0a8\uad6c). \ub9c8\uc9c0\ub9c9 \ub0b1\ub9d0\uc774 \ud589\uc815\ub3d9\uc774\uba74 \ub3d9\uc73c\ub85c \uc881\ud78c\ub2e4(\uc608: \uc138\uc885 \ubcf4\ub78c\ub3d9)","type":"string"}},"required":["region"],"type":"object"},"name":"find_businesses","outputSchema":{"properties":{"categories":{"description":"\uc54c\uc544\ub4e4\uc740 \uc5c5\uc885"},"cite":{"description":"\ub2f5\uc5d0 \ubd99\uc77c \ucd9c\ucc98 \ud55c \uc904"},"data_as_of":{"description":"\uc790\ub8cc \uae30\uc900(\uc0c1\uac00\uc815\ubcf4 \uae30\uc900 \uc5f0\uc6d4)"},"error":{"description":"\uc2e4\ud328 \uc0ac\uc720(isError\uc77c \ub54c\ub9cc)"},"markets":{"description":"\uc804\ud1b5\uc2dc\uc7a5 \uce78(\uc5c5\uc885\uc774 \uc804\ud1b5\uc2dc\uc7a5\u00b7\uc624\uc77c\uc7a5\u00b7\uc7a5\ub0a0\uc77c \ub54c\ub9cc)","properties":{"data_as_of":{"description":"\uae30\uc900\uc77c"},"more":{"description":"\uc2dc\uc7a5 \ubaa9\ub85d \uc8fc\uc18c"},"not_shown":{"description":"\ub098\uba38\uc9c0 \uc218"},"note":{"description":"\uc7a5\ub0a0 \uc77d\ub294 \ubc95\u00b7\uc548\ub0b4"},"order":{"description":"\uc21c\uc11c \uae30\uc900(\ud3c9\uac00 \uc544\ub2d8)"},"results":{"description":"\uacb0\uacfc \uc904(\ud55c \ubc88\uc5d0 5\uac74\uae4c\uc9c0)","items":{"properties":{"area":{"description":"\uc2dc\uad70\uad6c"},"market_day":{"description":"\uc7a5\ub0a0(\ub0a0\uc9dc \ub05d\uc790\ub9ac)"},"md":{"description":"\uc2dc\uc7a5 \ucabd \ub9c8\ud06c\ub2e4\uc6b4 \uc8fc\uc18c"},"name":{"description":"\uc2dc\uc7a5 \uc774\ub984"},"onnuri_merchants":{"description":"\uc628\ub204\ub9ac\uc0c1\ud488\uad8c \uac00\ub9f9\uc810 \uc218(\uc2dc\uc7a5 \uc774\ub984\uc73c\ub85c \uc13c \uc218)"},"opens_on":{"description":"\ub2e4\uc74c \uc7a5\ub0a0(\ud55c\uad6d \ub0a0\uc9dc)"},"parking":{"description":"\uc8fc\ucc28\uc7a5 \uc788\uc74c"},"stores":{"description":"\uc810\ud3ec \uc218"},"toilet":{"description":"\uacf5\uc911\ud654\uc7a5\uc2e4 \uc788\uc74c"},"type":{"description":"\uc2dc\uc7a5 \uc720\ud615"},"url":{"description":"\uc2dc\uc7a5 \ucabd \uc8fc\uc18c"}},"type":"object"},"type":"array"},"shown":{"description":"\ubcf4\uc778 \uc218"},"source":{"description":"\ucd9c\ucc98\u00b7\uc774\uc6a9\ud5c8\ub77d\ubc94\uc704"},"title":{"description":"\uce78 \uc81c\ubaa9"},"total":{"description":"\uace0\ub978 \uc2dc\uc7a5 \uc218"}},"type":"object"},"more":{"description":"\ub098\uba38\uc9c0\ub97c \ubcfc \ubcf4\uc784 \uc6f9 \ubaa9\ub85d \uc8fc\uc18c(\ub204\uad6c\ub098 \uc5f4\ub78c)"},"not_shown":{"description":"\ubcf4\uc774\uc9c0 \uc54a\uc740 \ub098\uba38\uc9c0 \uc218(\uc788\uc744 \ub54c)"},"note":{"description":"\uc870\uac74 \ud480\uc774\u00b7\uc548\ub0b4"},"order":{"description":"\uc21c\uc11c \uae30\uc900(\uad00\ub828\ub3c4\u00b7\uc774\ub984\uc21c \ub4f1 \u2014 \ud3c9\uac00\u00b7\uc21c\uc704 \uc544\ub2d8)"},"results":{"description":"\uacb0\uacfc \uc904(\ud55c \ubc88\uc5d0 5\uac74\uae4c\uc9c0)","items":{"properties":{"area":{"description":"\uc2dc\uad70\uad6c\u00b7\ud589\uc815\ub3d9"},"category":{"description":"\uc5c5\uc885"},"list_page":{"description":"\uadf8 \ub3d9\ub124\u00b7\uc5c5\uc885 \ubaa9\ub85d \uc8fc\uc18c(\uace0\uc720 \uc904 \ud45c\uc2dc \ud3ec\ud568)"},"name":{"description":"\uc0c1\ud638"},"ready":{"description":"AI \uc900\ube44\ub3c4 \ud655\uc778 \uc8fc\uc18c"}},"type":"object"},"type":"array"},"shown":{"description":"\uc774\ubc88\uc5d0 \ubcf4\uc778 \uc218"},"source":{"description":"\uc790\ub8cc \ucd9c\ucc98"},"total":{"description":"\uc870\uac74\uc5d0 \ub9de\ub294 \uc804\uccb4 \uc218"}},"type":"object"},"title":"\uc804 \uc5c5\uc885 \uc5c5\uccb4 \ucc3e\uae30(\uc804\uad6d 270\ub9cc \uacf3 \ub118\uac8c \u00b7 \uc804\ud1b5\uc2dc\uc7a5 \ud3ec\ud568)"}
