{
 "description": "Cancel one internally funded milestone through the restricted canonical-admin surface. Existing ownership, payout, refund, contract-state and idempotency guards remain active. The agent surface is limited to ADMIN_BALANCE funding and returns NO_MONEY_MOVED; card/credit funding is refused with HUMAN_APPROVAL_REQUIRED and remains on the human-only path. Notifications are suppressed by default for bulk cleanup and require explicit notifyCounterparty: true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contractId": {
    "description": "Contract that owns the milestone.",
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Request-bound idempotency key. Reuse the same key for safe retries.",
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "milestoneId": {
    "description": "Existing funded milestone id.",
    "minLength": 1,
    "type": "string"
   },
   "notifyCounterparty": {
    "description": "Explicitly notify the worker; defaults to false for administrative cleanup.",
    "type": "boolean"
   }
  },
  "required": [
   "contractId",
   "milestoneId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_cancel_admin_balance_milestone",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "contractId": {
      "type": "string"
     },
     "fundingDisposition": {
      "const": "NO_MONEY_MOVED",
      "type": "string"
     },
     "humanApprovalRequired": {
      "const": false,
      "type": "boolean"
     },
     "idempotentReplay": {
      "type": "boolean"
     },
     "milestoneId": {
      "type": "string"
     },
     "moneyMoved": {
      "const": false,
      "type": "boolean"
     },
     "refundId": {
      "type": "null"
     },
     "refundLedgerId": {
      "type": "null"
     },
     "refundReasonCode": {
      "const": "admin_balance_funded_milestone_cancellation",
      "type": "string"
     },
     "releaseRequiresHumanApproval": {
      "const": false,
      "type": "boolean"
     },
     "reviewProvenance": {
      "const": "ADMIN_NO_START",
      "type": "string"
     },
     "success": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "success",
     "contractId",
     "milestoneId",
     "refundLedgerId",
     "refundId",
     "refundReasonCode",
     "fundingDisposition",
     "moneyMoved",
     "humanApprovalRequired",
     "releaseRequiresHumanApproval",
     "reviewProvenance",
     "idempotentReplay"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
