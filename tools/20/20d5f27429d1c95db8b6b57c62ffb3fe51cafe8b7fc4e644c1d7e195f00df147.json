{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send additional information to the human operator working on the job, including when the job is waiting for agent input.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "job_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "job_token": {
    "minLength": 16,
    "type": "string"
   },
   "message": {
    "maxLength": 10000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "job_id",
   "job_token",
   "message"
  ],
  "type": "object"
 },
 "name": "human_reply_to_job",
 "title": "Reply to human clarification"
}
