{
 "_meta": {
  "veriko/cost": "quota",
  "veriko/family": "validations",
  "veriko/operationId": "validateOcr",
  "veriko/risk": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Extrae y valida una transferencia desde una imagen, un PDF o una URL HTTPS. Cada validaci\u00f3n consume cuota del plan del usuario y se descuenta al aceptar la petici\u00f3n.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "async": {
    "default": false,
    "type": "boolean"
   },
   "clientRef": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[^\\x00-\\x1f\\x7f]+$",
    "type": "string"
   },
   "cuentaBeneficiaria": {
    "pattern": "^(?:\\d{10}|\\d{16}|\\d{18})$",
    "type": "string"
   },
   "cuentasCandidatas": {
    "items": {
     "pattern": "^(?:\\d{10}|\\d{16}|\\d{18})$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9_-]{1,255}$",
    "type": "string"
   },
   "imageBase64": {
    "minLength": 1,
    "type": "string"
   },
   "imageUrl": {
    "format": "uri",
    "type": "string"
   },
   "retainImage": {
    "type": "boolean"
   },
   "retryPolicy": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "interval_seconds": {
      "maximum": 86400,
      "minimum": 300,
      "type": "integer"
     },
     "max_retries": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "outcomes": {
      "items": {
       "enum": [
        "not_found",
        "cep_unavailable",
        "error"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "veriko_validate_ocr",
 "title": "Validar un comprobante por OCR"
}
