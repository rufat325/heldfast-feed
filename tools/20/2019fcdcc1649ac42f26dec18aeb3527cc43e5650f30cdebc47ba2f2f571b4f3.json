{
 "description": "Add a recipe to a meal slot on the planner. Returns the newly created event (id, date, section, servings, ...).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "frozen_id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass to schedule from a frozen recipe; null for \"from frozen, no specific recipe\"."
   },
   "recipe_id": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "section": {
    "enum": [
     "breakfast",
     "lunch",
     "dinner",
     "snacks"
    ],
    "type": "string"
   }
  },
  "required": [
   "recipe_id",
   "date",
   "section"
  ],
  "type": "object"
 },
 "name": "add_planner_recipe"
}
