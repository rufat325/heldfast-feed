{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create an entity explicitly (without an initial observation). Idempotent on name+entityType. Embeds name+summary so vector/hybrid search over entities finds it.",
 "inputSchema": {
  "properties": {
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "entityType": {
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "summary": {
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "name",
   "entityType"
  ],
  "type": "object"
 },
 "name": "memory_entity_create"
}
