{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Join two bounded tables using exact string or composite keys. Both sides must have non-empty unique keys: duplicates block the entire output, including many-to-many matches. Choose left, inner or full retention explicitly; unmatched records are reported even if excluded. Optional compare fields flag changed values without resolving them. Output includes row lineage; missing-side fields are empty strings. No trimming, fuzzy matching or destination writes. Combined inputs share 1 MB/10,000 records/250,000 cells. One completed report costs one operation; reuse request_id for identical retries. Full findings or an uncharged size error, never silent truncation.",
 "inputSchema": {
  "$defs": {
   "JoinColumn": {
    "additionalProperties": false,
    "properties": {
     "column": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Column",
      "type": "string"
     },
     "name": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Name",
      "type": "string"
     },
     "side": {
      "enum": [
       "left",
       "right"
      ],
      "title": "Side",
      "type": "string"
     }
    },
    "required": [
     "name",
     "side",
     "column"
    ],
    "title": "JoinColumn",
    "type": "object"
   },
   "JoinRecipe": {
    "additionalProperties": false,
    "properties": {
     "columns": {
      "items": {
       "$ref": "#/$defs/JoinColumn"
      },
      "maxItems": 100,
      "minItems": 1,
      "title": "Columns",
      "type": "array"
     },
     "compare": {
      "description": "Optional paired fields; unequal matched values produce value_changed warnings, not automatic resolution.",
      "items": {
       "$ref": "#/$defs/KeyPair"
      },
      "maxItems": 100,
      "title": "Compare",
      "type": "array"
     },
     "keys": {
      "description": "Exact string composite key. Empty or duplicate keys on either side block output.",
      "items": {
       "$ref": "#/$defs/KeyPair"
      },
      "maxItems": 10,
      "minItems": 1,
      "title": "Keys",
      "type": "array"
     },
     "mode": {
      "description": "Explicit row-retention choice. Unmatched rows are always reported, including those excluded from output.",
      "enum": [
       "left",
       "inner",
       "full"
      ],
      "title": "Mode",
      "type": "string"
     },
     "output_delimiter": {
      "default": ",",
      "enum": [
       ",",
       ";",
       "\t",
       "|"
      ],
      "title": "Output Delimiter",
      "type": "string"
     },
     "spreadsheet_safe": {
      "default": false,
      "title": "Spreadsheet Safe",
      "type": "boolean"
     },
     "version": {
      "const": 1,
      "default": 1,
      "title": "Version",
      "type": "integer"
     }
    },
    "required": [
     "keys",
     "mode",
     "columns"
    ],
    "title": "JoinRecipe",
    "type": "object"
   },
   "KeyPair": {
    "additionalProperties": false,
    "properties": {
     "left": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Left",
      "type": "string"
     },
     "right": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Right",
      "type": "string"
     }
    },
    "required": [
     "left",
     "right"
    ],
    "title": "KeyPair",
    "type": "object"
   },
   "TableInput": {
    "additionalProperties": false,
    "properties": {
     "columns": {
      "anyOf": [
       {
        "items": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "maxItems": 100,
        "minItems": 1,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Columns"
     },
     "csv_text": {
      "anyOf": [
       {
        "maxLength": 1000000,
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "CSV including headers; no paths or URLs.",
      "title": "Csv Text"
     },
     "delimiter": {
      "default": ",",
      "enum": [
       ",",
       ";",
       "\t",
       "|"
      ],
      "title": "Delimiter",
      "type": "string"
     },
     "rows": {
      "anyOf": [
       {
        "items": {
         "items": {
          "maxLength": 10000,
          "type": "string"
         },
         "maxItems": 100,
         "type": "array"
        },
        "maxItems": 10000,
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "title": "Rows"
     }
    },
    "title": "TableInput",
    "type": "object"
   }
  },
  "properties": {
   "left": {
    "$ref": "#/$defs/TableInput"
   },
   "recipe": {
    "$ref": "#/$defs/JoinRecipe"
   },
   "request_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Request Id"
   },
   "right": {
    "$ref": "#/$defs/TableInput"
   }
  },
  "required": [
   "left",
   "right",
   "recipe"
  ],
  "title": "reconcile_tablesArguments",
  "type": "object"
 },
 "name": "reconcile_tables",
 "title": "Reconcile two tables with exact keys and complete findings"
}
