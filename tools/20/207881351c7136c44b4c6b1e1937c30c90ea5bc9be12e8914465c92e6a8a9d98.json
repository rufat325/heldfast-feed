{"description":"\u041f\u043e\u0434\u043e\u0431\u0440\u0430\u0442\u044c \u0432\u0430\u0440\u0438\u0430\u043d\u0442\u044b \u043e\u0431\u043e\u0440\u0443\u0434\u043e\u0432\u0430\u043d\u0438\u044f \u043f\u043e\u0434 \u043e\u0431\u044a\u0435\u043a\u0442.\n\nobject_type \u2014 \u0434\u0430\u0447\u0430, \u0434\u043e\u043c, \u043a\u0432\u0430\u0440\u0442\u0438\u0440\u0430, \u043e\u0444\u0438\u0441, \u043c\u0430\u0433\u0430\u0437\u0438\u043d, \u0441\u043a\u043b\u0430\u0434, \u043f\u043e\u0434\u0432\u0430\u043b, \u043f\u0440\u043e\u0438\u0437\u0432\u043e\u0434\u0441\u0442\u0432\u043e, \u0440\u0435\u0441\u0442\u043e\u0440\u0430\u043d, \u0442\u043e\u0440\u0433\u043e\u0432\u044b\u0439 \u0446\u0435\u043d\u0442\u0440, \u0430\u0432\u0442\u043e\u043c\u043e\u0431\u0438\u043b\u044c;\narea_m2 \u2014 \u043f\u043b\u043e\u0449\u0430\u0434\u044c \u043f\u043e\u043c\u0435\u0449\u0435\u043d\u0438\u044f; operators \u2014 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u044b (\u041c\u0422\u0421, \u0411\u0438\u043b\u0430\u0439\u043d, \u041c\u0435\u0433\u0430\u0424\u043e\u043d, T2);\nbands_mhz \u2014 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u043f\u043e \u0437\u0430\u043c\u0435\u0440\u0443 (\u0441\u0430\u043c\u043e\u0435 \u043d\u0430\u0434\u0451\u0436\u043d\u043e\u0435: \u0435\u0441\u043b\u0438 \u0438\u0437\u0432\u0435\u0441\u0442\u043d\u044b, \u043e\u043d\u0438 \u0432\u0430\u0436\u043d\u0435\u0435 \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u043e\u0432);\nneed \u2014 calls (\u0437\u0432\u043e\u043d\u043a\u0438) | internet | both; ready_kit \u2014 \u0438\u0441\u043a\u0430\u0442\u044c \u0433\u043e\u0442\u043e\u0432\u044b\u0435 \u043a\u043e\u043c\u043f\u043b\u0435\u043a\u0442\u044b (\u0438\u043d\u0430\u0447\u0435 \u0440\u0435\u043f\u0438\u0442\u0435\u0440\u044b);\nmax_price \u2014 \u0431\u044e\u0434\u0436\u0435\u0442 \u0432 \u0440\u0443\u0431\u043b\u044f\u0445.\n\u0412\u043e\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442 \u043f\u043e\u0434\u0445\u043e\u0434\u044f\u0449\u0438\u0435 \u043c\u043e\u0434\u0435\u043b\u0438 (\u0432 \u043d\u0430\u043b\u0438\u0447\u0438\u0438 \u2014 \u043f\u0435\u0440\u0432\u044b\u043c\u0438) \u0438 \u043f\u043e\u044f\u0441\u043d\u0435\u043d\u0438\u0435, \u043f\u043e \u043a\u0430\u043a\u0438\u043c \u043f\u0440\u0430\u0432\u0438\u043b\u0430\u043c \u043e\u0442\u043e\u0431\u0440\u0430\u043d\u044b.\n\u042d\u0442\u043e \u043f\u0440\u0435\u0434\u0432\u0430\u0440\u0438\u0442\u0435\u043b\u044c\u043d\u044b\u0439 \u043f\u043e\u0434\u0431\u043e\u0440: \u0442\u043e\u0447\u043d\u044b\u0439 \u0432\u044b\u0431\u043e\u0440 \u0447\u0430\u0441\u0442\u043e\u0442\u044b \u0434\u0435\u043b\u0430\u0435\u0442 \u0437\u0430\u043c\u0435\u0440 \u0441\u0438\u0433\u043d\u0430\u043b\u0430 \u2014 \u043f\u0440\u0435\u0434\u043b\u0430\u0433\u0430\u0439\u0442\u0435 \u0435\u0433\u043e (\u043f\u043e \u041c\u043e\u0441\u043a\u0432\u0435 \u0431\u0435\u0441\u043f\u043b\u0430\u0442\u043d\u043e).","inputSchema":{"properties":{"area_m2":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Area M2"},"bands_mhz":{"anyOf":[{"items":{"type":"integer"},"type":"array"},{"type":"null"}],"default":null,"title":"Bands Mhz"},"limit":{"default":8,"title":"Limit","type":"integer"},"max_price":{"anyOf":[{"type":"integer"},{"type":"null"}],"default":null,"title":"Max Price"},"need":{"default":"both","title":"Need","type":"string"},"object_type":{"title":"Object Type","type":"string"},"operators":{"anyOf":[{"items":{"type":"string"},"type":"array"},{"type":"null"}],"default":null,"title":"Operators"},"ready_kit":{"default":true,"title":"Ready Kit","type":"boolean"}},"required":["object_type"],"title":"usilitel_equipment_pickArguments","type":"object"},"name":"usilitel_equipment_pick"}
