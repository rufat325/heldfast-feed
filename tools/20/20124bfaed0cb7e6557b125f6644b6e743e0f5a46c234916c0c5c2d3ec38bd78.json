{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Summarize a price or return series"
 },
 "description": "A long price or return series in about 100 words plus fields: growth, risk, dated drawdowns, trend, volatility regime, tails, jumps, stale data. Use instead of reading raw bars. Nothing here is a forecast or advice.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmark_returns": {
    "description": "Same-period benchmark returns; adds beta.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "dates": {
    "description": "Optional ISO dates, one per value.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Label for the text.",
    "type": "string"
   },
   "periods_per_year": {
    "description": "252 daily (default), 365 crypto, 52 weekly, 12 monthly.",
    "type": "number"
   },
   "prices": {
    "description": "Prices, oldest first; or returns, or series_file.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "returns": {
    "description": "Returns as fractions, oldest first.",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "series_column": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Column name or 1-based position."
   },
   "series_file": {
    "description": "CSV or JSON of prices or returns on this machine; local server only.",
    "type": "string"
   },
   "series_kind": {
    "description": "series_file holds; default prices.",
    "enum": [
     "prices",
     "returns"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "summarize_series",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "description": "text is the summary to read; the other fields hold each figure by the rule named in it.",
  "properties": {
   "drawdown": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "growth": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "jumps": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "limits": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risk": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "source": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "tails": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "text": {
    "type": "string"
   },
   "trend": {
    "additionalProperties": {},
    "properties": {},
    "type": "object"
   },
   "volatility": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Summarize a price or return series"
}
