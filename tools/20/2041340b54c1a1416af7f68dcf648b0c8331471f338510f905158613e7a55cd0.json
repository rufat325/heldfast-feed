{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Save a reference without a confirmed DOI using metadata supplied by the user. Requires its HTTPS article URL and exact title. Optionally saves directly to an accessible writable group. Checks all target pages for the same URL before writing. Do not invent missing metadata or claim the DOI is verified. Use only when the user asks to save it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "authors": {
    "items": {
     "properties": {
      "first_name": {
       "maxLength": 255,
       "type": "string"
      },
      "last_name": {
       "maxLength": 255,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "last_name"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "groupId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "source": {
    "maxLength": 255,
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "default": "journal",
    "enum": [
     "journal",
     "book",
     "generic",
     "book_section",
     "conference_proceedings",
     "working_paper",
     "report",
     "web_page",
     "thesis",
     "magazine_article",
     "newspaper_article"
    ],
    "type": "string"
   },
   "url": {
    "format": "uri",
    "maxLength": 5000,
    "type": "string"
   },
   "year": {
    "maximum": 3000,
    "minimum": 1000,
    "type": "integer"
   }
  },
  "required": [
   "url",
   "title"
  ],
  "type": "object"
 },
 "name": "campus_mendeley_save_reference"
}
