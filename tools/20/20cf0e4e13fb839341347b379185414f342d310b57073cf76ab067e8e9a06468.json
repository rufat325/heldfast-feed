{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get member info"
 },
 "description": "Get full details for one server member: roles, effective permissions, account/join dates, bot flag, and current timeout status. Read-only. Returns a JSON object.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "guild_id": {
    "description": "Discord server (guild) ID (snowflake).",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   },
   "user_id": {
    "description": "Discord user ID (snowflake) of the member.",
    "pattern": "^\\d{17,20}$",
    "type": "string"
   }
  },
  "required": [
   "guild_id",
   "user_id"
  ],
  "type": "object"
 },
 "name": "discord_get_member_info",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "bot": {
    "type": "boolean"
   },
   "createdAt": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "joinedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "nickname": {
    "type": [
     "string",
     "null"
    ]
   },
   "permissions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "roles": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "timedOutUntil": {
    "type": [
     "string",
     "null"
    ]
   },
   "username": {
    "type": "string"
   }
  },
  "required": [
   "id",
   "username",
   "nickname",
   "roles",
   "permissions",
   "joinedAt",
   "createdAt",
   "bot",
   "timedOutUntil"
  ],
  "type": "object"
 }
}
