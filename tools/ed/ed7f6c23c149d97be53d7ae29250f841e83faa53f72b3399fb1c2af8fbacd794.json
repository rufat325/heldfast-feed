  "readOnlyHint": true
 },
 "description": "Returns details for one vehicle by ID: position, route, destination, license plate, and its upcoming stops with names and estimated arrival times. Use when the user wants to follow a particular vehicle, e.g. \"where does this tram go next?\" or \"when will it reach X?\". Vehicle IDs come from `get_route_realtime`, `get_nearby_vehicles`, or `get_stop_realtime` results. Do NOT use this to get all vehicles on a route \u2014 use `get_route_realtime` instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "vehicle_id": {
    "description": "Vehicle ID as returned by get_route_realtime, get_nearby_vehicles, or get_stop_realtime.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "vehicle_id"
  ],
  "type": "object"
 },
 "name": "get_vehicle_info",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "bearing": {
      "type": [
       "number",
       "null"
      ]
     },
     "destination": {
      "type": [
       "string",
       "null"
      ]
     },
     "direction": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "lat": {
      "type": [
       "number",
       "null"
      ]
     },
     "license_plate": {
      "type": [
       "string",
       "null"
      ]
     },
     "lng": {
      "type": [
       "number",
       "null"
      ]
     },
     "route": {
      "type": [
       "string",
       "null"
      ]
     },
     "upcoming_stops": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "arrival": {
         "type": [
          "string",
          "null"
         ]
        },
        "departure": {
         "type": [
          "string",
          "null"
         ]
        },
        "id": {
         "type": "string"
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "id",
        "name",
        "arrival",
        "departure"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "updated_at": {
      "type": "string"
     },
     "vehicle_id": {
      "type": "string"
     }
    },
    "required": [
     "vehicle_id",
     "route",
     "license_plate",
     "lat",
     "lng",
     "bearing",
     "direction",
     "destination",
     "upcoming_stops",
     "updated_at"
    ],
    "type": "object"
   },
   "ui_blocks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "data": {
       "additionalProperties": false,
       "properties": {
        "center": {
         "additionalItems": false,
         "items": [
          {
           "type": [
            "number",
            "null"
           ]
          },
          {
           "type": [
            "number",
            "null"
           ]
          }
         ],
         "maxItems": 2,
         "minItems": 2,
