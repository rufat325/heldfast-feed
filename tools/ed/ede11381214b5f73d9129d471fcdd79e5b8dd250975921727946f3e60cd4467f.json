{
 "description": "Scrape Baidu (Chinese-market) search results as structured JSON.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ct": {
    "description": "Language filter: 1=all, 2=Simplified Chinese, 3=Traditional Chinese.",
    "type": "string"
   },
   "html": {
    "description": "Return raw HTML instead of parsed JSON. (API default: false)",
    "type": "boolean"
   },
   "pn": {
    "description": "Pagination offset (0=first page, 10=second, ...). (API default: 0)",
    "type": "number"
   },
   "query": {
    "description": "Baidu search query; supports Baidu operators (site:, inurl:, intitle:).",
    "type": "string"
   },
   "rn": {
    "description": "Results per page (max 50). (API default: 10)",
    "type": "number"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "baidu_search",
 "title": "Baidu Search API"
}
