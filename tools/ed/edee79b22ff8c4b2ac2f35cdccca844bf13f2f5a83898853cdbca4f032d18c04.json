{
 "description": "Pause or unpause a SaaS-enabled CRM location.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "companyId": {
    "description": "Company / agency ID",
    "type": "string"
   },
   "locationId": {
    "description": "Location / sub-account ID to pause or unpause",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "paused": {
    "description": "Set true to pause the location, false to unpause",
    "type": "boolean"
   }
  },
  "required": [
   "access_token",
   "companyId",
   "locationId",
   "paused"
  ],
  "type": "object"
 },
 "name": "crm_saas_pause"
}
