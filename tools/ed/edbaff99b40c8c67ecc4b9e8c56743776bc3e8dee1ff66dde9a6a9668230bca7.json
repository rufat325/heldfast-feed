{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Use this after the user has confirmed style rules, to keep them as their taste profile. Pass the profile_key and the confirmed layout, palette (#RRGGBB), type, texture and hierarchy rules, things to avoid, and notes; send at least one. It replaces the rules saved before. Returns the saved profile. Do not save rules the user has not agreed to.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "avoid": {
    "description": "Things the user does not want.",
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "hierarchy": {
    "description": "Confirmed visual hierarchy rules.",
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "layout": {
    "description": "Confirmed layout rules, each one short and concrete.",
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "notes": {
    "description": "Anything else the user confirmed. No personal details.",
    "maxLength": 600,
    "type": "string"
   },
   "palette": {
    "description": "Confirmed colors as #RRGGBB.",
    "items": {
     "pattern": "^#[0-9A-Fa-f]{6}$",
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "profile_key": {
    "description": "The profile_key that add_refs returned. Keep it: it is the only way back to this profile and it is not recoverable.",
    "pattern": "^tp_[0-9a-f]{32}$",
    "type": "string"
   },
   "texture": {
    "description": "Confirmed texture and finish rules.",
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "type": {
    "description": "Confirmed typography rules.",
    "items": {
     "maxLength": 240,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   }
  },
  "required": [
   "profile_key"
  ],
  "type": "object"
 },
 "name": "save_profile",
 "outputSchema": {
  "properties": {
   "as_of": {
    "description": "UTC date of this answer.",
    "type": "string"
   },
   "profile": {
    "properties": {
     "avoid": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "hierarchy": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "layout": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "palette": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "texture": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "type": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "layout",
     "palette",
     "type",
     "texture",
     "hierarchy",
     "avoid",
     "notes"
    ],
    "type": "object"
   },
   "retention": {
    "type": "string"
   },
   "saved_day": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "saved"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "profile",
   "saved_day",
   "retention",
   "source",
   "as_of"
  ],
  "type": "object"
 },
 "title": "Save the taste profile"
}
