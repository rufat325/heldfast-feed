{
 "description": "Manage S3-compatible backup destinations. list. get: destinationId. create: name+accessKey+bucket+region+endpoint+secretAccessKey, provider?, additionalFlags? (rclone flags). update: destinationId+fields. remove: destinationId. test: same fields as create (without persisting).",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accessKey": {
    "type": "string"
   },
   "action": {
    "enum": [
     "list",
     "get",
     "create",
     "update",
     "remove",
     "test"
    ],
    "type": "string"
   },
   "additionalFlags": {
    "description": "Extra rclone flags, e.g. ['--s3-no-check-bucket']",
    "items": {
     "pattern": "^--[a-zA-Z0-9-]+(=[a-zA-Z0-9._:/@-]+)?$",
     "type": "string"
    },
    "type": "array"
   },
   "bucket": {
    "type": "string"
   },
   "destinationId": {
    "type": "string"
   },
   "endpoint": {
    "description": "S3 endpoint URL",
    "type": "string"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "description": "Provider hint for rclone (e.g. AWS, Cloudflare, MinIO)",
    "type": "string"
   },
   "region": {
    "type": "string"
   },
   "secretAccessKey": {
    "type": "string"
   },
   "serverId": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "dokploy_destination"
}
