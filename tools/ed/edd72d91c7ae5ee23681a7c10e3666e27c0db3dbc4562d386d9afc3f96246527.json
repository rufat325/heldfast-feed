{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Trigger one or more Synthetics tests on demand",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "tests": {
    "description": "List of tests to trigger",
    "items": {
     "properties": {
      "publicId": {
       "description": "Synthetics test public ID. Example: abc-def-ghi",
       "type": "string"
      }
     },
     "required": [
      "publicId"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tests"
  ],
  "type": "object"
 },
 "name": "trigger-synthetics"
}
