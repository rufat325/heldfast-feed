     "DOMAIN_SOP",
     "PLAYBOOK",
     "REGULATORY",
     "RISK_GUARDRAILS",
     "HEURISTIC",
     "KNOWLEDGE"
    ],
    "type": "string"
   },
   "version": {
    "default": "1.0.0",
    "description": "Semantic version",
    "type": "string"
   }
  },
  "required": [
   "pack_id",
   "type",
   "trust_level",
   "domain",
   "scope",
   "ttl_hours",
   "created_by",
   "principles",
   "sop",
   "heuristics",
   "anti_patterns"
