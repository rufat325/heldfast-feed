  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allowed_roles": {
    "default": [],
    "description": "RBAC roles allowed to load this pack",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "anti_patterns": {
    "description": "Prohibited patterns",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "created_by": {
    "description": "Creator identity",
    "maxLength": 100,
    "type": "string"
   },
   "domain": {
    "description": "Domain (e.g., va-claims, finance, cyber-ir)",
    "maxLength": 100,
    "type": "string"
   },
   "heuristics": {
    "description": "Decision heuristics",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pack_id": {
    "description": "Unique identifier for the memory pack",
    "maxLength": 100,
    "type": "string"
   },
   "principles": {
    "description": "Core principles",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "risk_level": {
    "default": "ADVISORY",
    "description": "MAI classification",
    "enum": [
     "MANDATORY",
     "ADVISORY",
     "INFORMATIONAL"
    ],
    "type": "string"
   },
   "scope": {
    "description": "Scope tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sealer_role": {
    "description": "Role of the sealer (for trust level enforcement)",
    "type": "string"
   },
   "sop": {
    "description": "Standard operating procedures",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "trust_level": {
    "description": "Trust level (SYSTEM > ORG > CASE > EPHEMERAL)",
    "enum": [
