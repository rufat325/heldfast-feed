{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "Opens a new funding round on a company's cap table \u2014 the container investors and their agreements are attached to. Writes. It does not raise money or close anything: a new round starts OPEN and holds no capital until investors are added to it.",
 "inputSchema": {
  "properties": {
   "pastRound": {
    "type": "boolean"
   },
   "round": {
    "properties": {
     "closedAt": {
      "format": "date-time",
      "type": "string"
     },
     "companyId": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "createdAt": {
      "format": "date-time",
      "type": "string"
     },
     "fullyDilutedShares": {
      "minimum": 0,
      "type": "integer"
     },
     "id": {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     "isPriced": {
      "type": "boolean"
     },
     "name": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
     },
     "optionPoolPct": {
      "maxLength": 50,
      "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
      "type": "string"
     },
     "optionPoolShares": {
      "minimum": 0,
      "type": "integer"
     },
     "postMoneyValuation": {
      "maxLength": 50,
      "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
      "type": "string"
     },
     "preMoneyValuation": {
      "maxLength": 50,
      "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
      "type": "string"
     },
     "pricePerShare": {
      "maxLength": 50,
      "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
      "type": "string"
     },
     "status": {
      "enum": [
       "CAP_TABLE_ROUND_STATUS_UNSPECIFIED",
       "CAP_TABLE_ROUND_STATUS_OPEN",
       "CAP_TABLE_ROUND_STATUS_CLOSING",
       "CAP_TABLE_ROUND_STATUS_CLOSED"
      ],
      "type": "string"
     },
     "totalRaiseTarget": {
      "maxLength": 50,
      "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
      "type": "string"
     },
     "updatedAt": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "companyId"
    ],
    "type": "object"
   }
  },
  "required": [
   "round"
  ],
  "type": "object"
 },
 "name": "cap_table_create_cap_table_round",
 "outputSchema": {
  "properties": {
   "roundId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "roundId"
  ],
  "type": "object"
 },
 "title": "Create Cap Table Round"
}
