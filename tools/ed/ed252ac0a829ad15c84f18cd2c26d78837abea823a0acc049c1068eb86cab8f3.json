{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Inspect names, datatypes, units, and descriptions for an exact metadata-discovered table before constructing ADQL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "service": {
    "description": "Known Starfetch TAP service preset selected for this workflow; use this or url.",
    "minLength": 1,
    "type": "string"
   },
   "table": {
    "description": "Exact TAP table name returned by prior metadata inspection.",
    "minLength": 1,
    "type": "string"
   },
   "url": {
    "description": "Explicit TAP base URL selected for this workflow; use this or service.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "table"
  ],
  "type": "object"
 },
 "name": "starfetch_tap_columns",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "datatype": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "ucd": {
       "type": "string"
      },
      "unit": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "diagnostics": {
    "additionalProperties": false,
    "properties": {
     "count": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "table": {
      "type": "string"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "baseUrl": {
        "type": "string"
       },
       "label": {
        "type": "string"
       },
       "service": {
        "type": "string"
       }
      },
      "required": [
       "baseUrl"
      ],
      "type": "object"
     }
    },
    "required": [
     "target",
     "count",
     "table"
    ],
    "type": "object"
   }
  },
  "required": [
   "data",
   "diagnostics"
  ],
  "type": "object"
 },
 "title": "List TAP columns"
}
