{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "hotelumo:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Show daily prices and restrictions"
 },
 "description": "Use this when someone asks what a rate costs on specific nights, or about minimum stays, stop-sell or closed-to-arrival dates. Returns the stored per-day price and restrictions of one rate plan over up to 90 days; days without a row use the plan's base price. Not for whether rooms are free.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateFrom": {
    "description": "First night as YYYY-MM-DD (inclusive)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dateTo": {
    "description": "Last night as YYYY-MM-DD (inclusive); the range covers at most 90 days",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "hotelId": {
    "description": "Hotel id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   },
   "ratePlanId": {
    "description": "Rate plan id, belonging to hotelId: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "hotelId",
   "ratePlanId",
   "dateFrom",
   "dateTo"
  ],
  "type": "object"
 },
 "name": "list_daily_rates",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dailyRates": {
    "description": "Stored per-day rows sorted by date; a date without a row sells at the plan's base price. price is in integer minor currency units. Guest, payment, channel, credential and arbitrary metadata are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "closedToArrival": {
       "type": "boolean"
      },
      "closedToDeparture": {
       "type": "boolean"
      },
      "date": {
       "anyOf": [
        {
         "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "minStay": {
       "anyOf": [
        {
         "maximum": 365,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "price": {
       "anyOf": [
        {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "ratePlanId": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "stopSell": {
       "type": "boolean"
      }
     },
     "required": [
      "ratePlanId",
      "date",
      "price",
      "minStay",
      "closedToArrival",
      "closedToDeparture",
      "stopSell"
     ],
     "type": "object"
    },
    "maxItems": 90,
    "type": "array"
   },
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "dailyRates"
  ],
  "type": "object"
 },
 "title": "Show daily prices and restrictions"
}
