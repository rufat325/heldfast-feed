{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\ubd80\uce59 \uc801\uc6a9\ub840 \uc870\ud68c"},"description":"\uc870\ubb38\uc758 \uc801\uc6a9\ub840\u00b7\uacbd\uacfc\uc870\uce58\ub97c \ubd80\uce59\uc5d0\uc11c \ucc3e\ub294\ub2e4. \uc5b8\uc81c\ubd80\ud130 \uc801\uc6a9\ub418\ub294\uc9c0\ub294 \uc870\ubb38\uc774 \uc544\ub2c8\ub77c \ubd80\uce59\uc5d0 \uc788\ub2e4. period_start\u00b7period_end(\ucde8\ub4dd\u00b7\uc99d\uc5ec\u00b7\uc591\ub3c4\uc77c \ub4f1 \uc0ac\uac74 \ub0a0\uc9dc)\ub97c \uc8fc\uba74 \uadf8 \uae30\uac04\uc5d0 \uac78\ub9ac\ub294 \ubd80\uce59\uc744 \uacbd\uacfc\uc870\uce58\u2192\uc801\uc6a9\ub840\u2192\ub2f9\uc2dc \ud310\u2192\ud6c4\uc18d \uac1c\uc815 \uc21c\uc73c\ub85c \uace0\ub974\uace0, \uadf8 \uc870\ubb38\uc744 \uc5b8\uae09\ud55c \uc870\ud56d\ub9cc \ubc1c\ucdcc\ud558\uba70, \uae30\uac04 \uc548\uc5d0\uc11c \uc870\ubb38 \ud310\uc774 \ubc14\ub010 \uacbd\uacc4\uc758 \ubc14\ub010 \ub9d0\ub3c4 \ubd99\uc778\ub2e4. \ub0a0\uc9dc\uac00 \uc5c6\uc73c\uba74 \ucd5c\uadfc \uacf5\ud3ec \uc21c.","inputSchema":{"additionalProperties":false,"properties":{"article_number":{"description":"\uc870\ubc88\ud638 (\uc608: '\uc81c97\uc870\uc7582', '97\uc870\uc7582')","type":"string"},"law_name":{"description":"\ubc95\ub839\uba85 (\uc57d\uce6d\u00b7\ub744\uc5b4\uc4f0\uae30 \ucc28\uc774\ub3c4 \ubc1b\ub294\ub2e4)","type":"string"},"limit":{"description":"\ubd80\uce59 \uc218 (\uae30\ubcf8 6, \ucd5c\ub300 10)","type":"integer"},"period_end":{"description":"\uae30\uc900 \uae30\uac04 \ub05d (\uc608: \uc99d\uc5ec \ub4a4 \uc591\ub3c4\uc77c '2026-05-01')","type":"string"},"period_start":{"description":"\uae30\uc900 \uae30\uac04 \uc2dc\uc791 (\uc608: '2022-03-01', \uc5f0\ub3c4\ub9cc '2022'\ub3c4 \uac00\ub2a5). \uc0ac\uac74\uc774 \ud558\ub098\uba74 \uc774\uac83\ub9cc \uc900\ub2e4","type":"string"}},"required":["law_name","article_number"],"type":"object"},"name":"get_amendments"}
