{
 "annotations": {},
 "description": "Record a buy or sell transaction. By default this also adjusts inventory (BUY adds, SELL subtracts). This is a real write. Requires IWMM_API_KEY.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cardId": {
    "description": "Internal IWMM card UUID.",
    "type": "string"
   },
   "date": {
    "description": "ISO 8601 date (YYYY-MM-DD).",
    "type": "string"
   },
   "fees": {
    "minimum": 0,
    "type": "number"
   },
   "isFoil": {
    "type": "boolean"
   },
   "notes": {
    "type": "string"
   },
   "pricePerUnit": {
    "description": "Per-unit price in USD.",
    "minimum": 0,
    "type": "number"
   },
   "quantity": {
    "minimum": 1,
    "type": "integer"
   },
   "skipInventorySync": {
    "description": "If true, record the transaction without adjusting inventory. Default false - transactions normally update inventory.",
    "type": "boolean"
   },
   "source": {
    "description": "Where the transaction happened (e.g. 'TCGPlayer', 'LGS').",
    "type": "string"
   },
   "type": {
    "enum": [
     "BUY",
     "SELL"
    ],
    "type": "string"
   }
  },
  "required": [
   "cardId",
   "type",
   "quantity",
   "pricePerUnit",
   "isFoil",
   "date"
  ],
  "type": "object"
 },
 "name": "record_transaction"
}
