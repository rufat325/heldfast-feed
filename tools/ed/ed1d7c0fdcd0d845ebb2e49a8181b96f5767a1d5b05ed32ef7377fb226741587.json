{
 "description": "List all App Store versions for an app",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "platform": {
    "enum": [
     "IOS",
     "MAC_OS",
     "TV_OS",
     "VISION_OS"
    ],
    "type": "string"
   },
   "state": {
    "description": "Filter by state (e.g. PREPARE_FOR_SUBMISSION, READY_FOR_SALE)",
    "type": "string"
   }
  },
  "required": [
   "appId"
  ],
  "type": "object"
 },
 "name": "apple_list_versions"
}
