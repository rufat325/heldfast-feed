{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "[EXPERIMENTAL] Download a feedback file that a professor attached to a graded attempt. Use the fileId from blackboard_get_assignment_feedback \u2192 attempt.feedbackFiles. The download endpoint may not be available on all Blackboard versions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "attemptId": {
    "description": "Attempt ID from blackboard_get_assignment_feedback",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "columnId": {
    "description": "Gradebook column (assignment) ID",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "courseId": {
    "description": "Blackboard course ID",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "fileId": {
    "description": "File ID from blackboard_get_assignment_feedback \u2192 attempt.feedbackFiles",
    "pattern": "^_\\d+_\\d+$",
    "type": "string"
   },
   "filename": {
    "description": "Filename to save as (defaults to the name from feedbackFiles)",
    "type": "string"
   },
   "outputDir": {
    "description": "Relative subdirectory inside ~/Downloads/campus-cli (or CAMPUS_DOWNLOAD_DIR)",
    "type": "string"
   }
  },
  "required": [
   "courseId",
   "columnId",
   "attemptId",
   "fileId"
  ],
  "type": "object"
 },
 "name": "blackboard_download_feedback_file"
}
