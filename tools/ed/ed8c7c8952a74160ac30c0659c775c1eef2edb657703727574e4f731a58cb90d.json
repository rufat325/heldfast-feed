{"_meta":{"openai/toolInvocation/invoked":"Checked scheduling options","openai/toolInvocation/invoking":"Checking scheduling options"},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Check LVOS scheduling status"},"description":"Scheduling status for LVOS. Live availability is not connected, so the result is always integration_unavailable with no slots, plus the FlexBook online booking link, the phone number and the appointment types observed in the portal. No calendar is queried and nothing is booked. Takes practice_id LVOS.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"practice_id":{"description":"The practice's exact, case-sensitive Resident registry ID from its connection documentation. Do not guess an ID from a practice name.","pattern":"^[A-Z0-9][A-Z0-9_-]{0,31}$","type":"string"}},"required":["practice_id"],"type":"object"},"name":"get_available_appointments","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"appointment_types_source":{"type":"string"},"available_slots":{"description":"Null means availability was not checked; it does not mean the practice is fully booked.","type":"null"},"booking_url":{"format":"uri","type":"string"},"code":{"enum":["PROVIDER_NOT_FOUND","PROVIDER_UNAVAILABLE","RATE_LIMITED","INVALID_SUBMISSION","SUBMISSIONS_UNAVAILABLE","PRACTICE_NOT_READY","DUPLICATE_REQUEST","SUBMISSION_FAILED","DOCUMENT_NOT_FOUND"],"type":"string"},"live_availability_accessible":{"const":false,"type":"boolean"},"message":{"type":"string"},"observed_appointment_types":{"items":{"additionalProperties":false,"properties":{"duration_minutes":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"name":{"type":"string"}},"required":["name","duration_minutes"],"type":"object"},"type":"array"},"phone":{"type":"string"},"practice_id":{"pattern":"^[A-Z0-9][A-Z0-9_-]{0,31}$","type":"string"},"retry_after_seconds":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"status":{"const":"integration_unavailable","type":"string"}},"type":"object"},"title":"Check LVOS scheduling status"}
