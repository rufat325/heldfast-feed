{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Model calibration record"
 },
 "description": "Returns the public calibration record of the model: every probability published before kick-off and scored after the result, with count, hit rate, Brier score and reliability buckets (predicted probability against observed frequency), overall and by question type (match result, total goals over 2.5 and 3.5, half-time goals over 1.5, both teams to score), plus the 50 most recent scored predictions. Misses are included. days sets the lookback window (default 90).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "days": {
    "anyOf": [
     {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Lookback window in days (default 90)"
   }
  },
  "type": "object"
 },
 "name": "get_track_record",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "attribution": {
    "description": "Cite as \"Data by football-charts.com\"",
    "type": [
     "string",
     "null"
    ]
   },
   "track_record": {
    "additionalProperties": true,
    "properties": {
     "accuracy": {
      "anyOf": [
       {
        "additionalProperties": true,
        "properties": {
         "brier": {
          "description": "Brier score over scored probabilities; lower is better, 0.25 = coin flip"
         },
         "buckets": {
          "anyOf": [
           {
            "items": {
             "additionalProperties": true,
             "properties": {
              "avg_prob": {},
              "hi": {},
              "hit_rate": {},
              "lo": {},
              "n": {}
             },
             "type": "object"
            },
            "type": "array"
           },
           {
            "type": "null"
           }
          ]
         },
         "n": {}
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "by_question": {
      "anyOf": [
       {
        "additionalProperties": {
         "additionalProperties": true,
         "properties": {
          "correct": {},
          "hit_rate": {
           "description": "correct / (correct + incorrect)"
          },
          "incorrect": {},
          "n": {
           "description": "Scored predictions"
          },
          "void": {
           "description": "Postponed or abandoned; not scored"
          }
         },
         "type": "object"
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "pending": {
      "description": "Published but not yet scored"
     },
     "recent": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "properties": {
          "away_team": {},
          "home_team": {},
          "league": {},
          "line": {},
          "match_date": {},
          "model_prob": {},
          "outcome": {
           "description": "'correct' | 'incorrect' | 'void'"
          },
          "question": {},
          "result_score": {},
          "side": {},
          "slug": {}
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "The 50 most recent scored predictions"
     },
     "summary": {
      "anyOf": [
       {
        "additionalProperties": true,
        "properties": {
         "correct": {},
         "hit_rate": {
          "description": "correct / (correct + incorrect)"
         },
         "incorrect": {},
         "n": {
          "description": "Scored predictions"
         },
         "void": {
          "description": "Postponed or abandoned; not scored"
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Whole window"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "track_record"
  ],
  "type": "object"
 },
 "title": "Model calibration record"
}
