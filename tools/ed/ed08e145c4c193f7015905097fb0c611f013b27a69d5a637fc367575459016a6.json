{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search"
 },
 "description": "Search Croatian news by meaning (semantic + text). Write the query in Croatian when you can (e.g. \"po\u017ear Split\", \"izbori\", \"cijene goriva\"); English works too. Optional category, portal, period and badge (breaking, urgent, big, world, clickbait, sponsored). Returns matching articles, newest-relevant first, each with its signals and badges (urgent, big, world, clickbait, sponsored).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "badge": {
    "description": "Only stories with a badge: breaking (urgent, big and world together, as on Udarne vijesti), urgent, big, world, clickbait, sponsored.",
    "enum": [
     "breaking",
     "urgent",
     "big",
     "world",
     "clickbait",
     "sponsored"
    ],
    "type": "string"
   },
   "category": {
    "description": "Category: crime, politics, sport\u2026 (see /v1/categories).",
    "enum": [
     "general",
     "politics",
     "economy",
     "sport",
     "crime",
     "weather",
     "technology",
     "health",
     "entertainment",
     "show",
     "culture",
     "world",
     "lifestyle",
     "travel",
     "science",
     "education",
     "automotive"
    ],
    "type": "string"
   },
   "from": {
    "description": "From (YYYY-MM-DD or ISO time), within the plan's archive.",
    "type": "string"
   },
   "include_filler": {
    "description": "Filler (horoscopes, quizzes, reality shows, celebrity gossip, promos) is left out of every list; true brings it back.",
    "type": "boolean"
   },
   "limit": {
    "description": "How many results (default 20, at most what the plan allows).",
    "type": "integer"
   },
   "offset": {
    "description": "Skip this many.",
    "type": "integer"
   },
   "provider": {
    "description": "Only one portal, by its slug (see /v1/providers).",
    "type": "string"
   },
   "q": {
    "description": "The question, e.g. \"po\u017ear Split\" or \"inflation\".",
    "type": "string"
   },
   "sort": {
    "description": "relevance (default) or newest.",
    "enum": [
     "relevance",
     "newest"
    ],
    "type": "string"
   },
   "to": {
    "description": "To (YYYY-MM-DD or ISO time).",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_news",
 "outputSchema": {
  "properties": {
   "data": {
    "items": {
     "properties": {
      "badges": {
       "default": null,
       "items": {
        "type": "string"
       },
       "type": [
        "array",
        "null"
       ]
      },
      "categories": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "clickbait_score": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "discovered_at": {
       "format": "date-time",
       "type": "string"
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "image_url": {
       "type": [
        "string",
        "null"
       ]
      },
      "portals": {
       "pattern": "^-?(?:0|[1-9]\\d*)$",
       "type": [
        "string",
        "integer"
       ]
      },
      "published_at": {
       "format": "date-time",
       "type": [
        "string",
        "null"
       ]
      },
      "signals": {
       "default": null,
       "properties": {
        "clickbait": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "importance": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "in_croatia": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "sponsored": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "urgency": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        },
        "world_event": {
         "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
         "type": [
          "string",
          "number",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "source": {
       "properties": {
        "name": {
         "type": "string"
        },
        "slug": {
         "type": [
          "string",
          "null"
         ]
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "url"
       ],
       "type": "object"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "url",
      "source",
      "discovered_at",
      "categories",
      "portals"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "description": "count, plan, include_filler, the limits applied (e.g. radius_limited_to), and for a nearby search its center.",
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Search"
}
