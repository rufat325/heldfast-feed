{
 "_meta": {
  "group": "schedule"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Reschedule or reassign a schedule entry, or mark it done. Times are ISO-8601. Only provided fields change.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "done": {
    "description": "Mark the entry done (true) or not done (false)",
    "type": "boolean"
   },
   "entry_id": {
    "description": "The schedule entry ID (from cw_list_schedule_entries)",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "member": {
    "description": "Reassign to this member identifier",
    "type": "string"
   },
   "response_format": {
    "default": "markdown",
    "description": "Output format: human-readable markdown (default) or structured JSON",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "time_end": {
    "description": "New end time, ISO-8601",
    "type": "string"
   },
   "time_start": {
    "description": "New start time, ISO-8601",
    "type": "string"
   }
  },
  "required": [
   "entry_id"
  ],
  "type": "object"
 },
 "name": "cw_update_schedule_entry",
 "title": "Update a ConnectWise Schedule Entry"
}
