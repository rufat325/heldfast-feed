{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get MCP server details"
 },
 "description": "Everything about one listing: what it does, its tools, how it signs in, the server's own endpoint URL or install command, and setup steps for Claude Code, Claude Desktop, claude.ai, ChatGPT, Cursor, VS Code, Devin Desktop, Codex, Gemini CLI and a generic JSON config. Setup always uses the vendor's own URL or package. It also returns the listing's recent changes: tools added, removed or changed and new versions that mcp.tc's periodic checks found, and edits by the server's owner.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client": {
    "description": "Optional: only the setup steps for this client, written out in full.",
    "enum": [
     "claude-code",
     "claude-desktop",
     "claude-ai",
     "chatgpt",
     "cursor",
     "vscode",
     "devin",
     "codex",
     "gemini",
     "json"
    ],
    "type": "string"
   },
   "slug": {
    "description": "The listing's slug from search_servers, e.g. \"notion\", or its link https://mcp.tc/i/notion.",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_server",
 "outputSchema": {
  "properties": {
   "auth": {
    "enum": [
     "none",
     "oauth",
     "api_key",
     "optional",
     "unknown"
    ],
    "type": "string"
   },
   "auth_note": {
    "type": "string"
   },
   "capabilities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
