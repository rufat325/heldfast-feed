    "type": [
     "string",
     "null"
    ]
   },
   "docs": {
    "type": [
     "string",
     "null"
    ]
   },
   "endpoint": {
    "description": "The server's own URL (remote servers): what clients connect to",
    "type": [
     "string",
     "null"
    ]
   },
   "env_vars": {
    "items": {
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "secret": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "required",
      "secret"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "example_prompts": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "headers": {
    "items": {
     "properties": {
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "secret": {
       "type": "boolean"
      }
     },
     "required": [
      "name",
      "required",
      "secret"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "health": {
    "type": "string"
   },
   "history_feed": {
    "description": "Atom feed of the listing's History",
    "type": "string"
   },
   "history_url": {
    "description": "The listing's History tab: what mcp.tc's own checks saw change and the server owner's edits, newest first",
    "type": "string"
   },
   "homepage": {
    "type": [
     "string",
     "null"
    ]
   },
   "install_command": {
    "description": "Command that starts it (local servers)",
    "type": [
     "string",
     "null"
    ]
   },
   "kind": {
    "enum": [
     "remote",
     "local"
    ],
    "type": "string"
   },
   "last_changed": {
    "description": "When the History last recorded a change (ISO 8601, UTC)",
    "type": [
     "string",
     "null"
    ]
   },
   "last_checked": {
    "type": [
     "string",
     "null"
    ]
   },
   "link": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "package": {
    "properties": {
     "identifier": {
      "type": "string"
     },
     "registry": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "recent_changes": {
    "description": "The newest History entries, newest first. Summaries name tools but never quote their descriptions. kind baseline marks where tracking started",
    "items": {
     "properties": {
      "at": {
       "description": "ISO 8601, UTC",
       "type": "string"
      },
      "kind": {
       "description": "baseline (tracking started), tools or version from the checks; listing: an edit by the server's owner. status is no longer recorded",
       "enum": [
        "baseline",
        "tools",
        "version",
        "listing",
        "status"
       ],
       "type": "string"
      },
      "source": {
       "description": "check: mcp.tc's automatic checks. owner: the server's owner. mcptc and pipeline are no longer used",
       "enum": [
        "check",
        "owner",
        "mcptc",
        "pipeline"
       ],
       "type": "string"
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "at",
      "kind",
      "source",
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   },
   "repository": {
    "type": [
     "string",
     "null"
    ]
   },
   "server_version": {
    "type": [
     "string",
     "null"
    ]
   },
   "setup": {
    "items": {
     "properties": {
      "client": {
       "type": "string"
      },
      "code": {
       "type": [
        "string",
        "null"
       ]
      },
      "label": {
       "type": "string"
      },
      "link": {
       "type": [
        "string",
        "null"
       ]
      },
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "quick": {
       "description": "One line: the command, install link or URL to use",
       "type": [
        "string",
        "null"
       ]
      },
      "steps": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "client",
      "label",
      "steps"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "tagline": {
    "type": [
     "string",
     "null"
    ]
   },
   "tools": {
    "items": {
     "properties": {
      "destructive": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "read_only": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "summary": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "summary"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "tools_checked": {
    "description": "When mcp.tc last read the tool list (ISO 8601, UTC); null unless tracking is tools",
    "type": [
     "string",
     "null"
    ]
   },
   "tools_count": {
    "type": "integer"
   },
   "tracking": {
    "description": "What the History can see. tools: mcp.tc reads the tool list every 3 hours. version: no tool list, only new versions (a local npm or PyPI package, or the version a server reports). listing: mcp.tc reads neither its tools nor its version, so only edits by the server's owner are recorded",
    "enum": [
     "tools",
     "version",
     "listing"
    ],
    "type": "string"
   },
   "transport": {
    "type": [
     "string",
     "null"
    ]
   },
   "vendor": {
    "type": [
     "string",
     "null"
    ]
   },
   "verified": {
    "type": "boolean"
   },
   "verified_by": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "name",
   "slug",
   "link",
   "kind",
   "auth",
   "auth_note",
   "endpoint",
   "install_command",
   "tools",
   "verified",
   "history_url",
   "history_feed",
   "tracking",
   "tools_checked",
   "last_changed",
   "recent_changes",
   "setup"
  ],
  "type": "object"
 },
 "title": "Get MCP server details"
}
