{
 "description": "Update an existing content template. All fields are optional \u2014 only supplied fields are changed. Use isFavorite=true/false to toggle favorite status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "New template body.",
    "minLength": 1,
    "type": "string"
   },
   "brandId": {
    "description": "Brand ID (defaults to active brand)",
    "type": "string"
   },
   "category": {
    "description": "New category label.",
    "type": [
     "string",
     "null"
    ]
   },
   "example": {
    "description": "New example post.",
    "type": [
     "string",
     "null"
    ]
   },
   "isFavorite": {
    "description": "Set true to favorite, false to un-favorite.",
    "type": "boolean"
   },
   "pattern": {
    "description": "New pattern description.",
    "type": [
     "string",
     "null"
    ]
   },
   "platforms": {
    "description": "Updated platform list.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "templateId": {
    "description": "ID of the content template to update.",
    "type": "string"
   },
   "title": {
    "description": "New title.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "templateId"
  ],
  "type": "object"
 },
 "name": "template_update"
}
