{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search catalog"
 },
 "description": "Search the block catalog. Returns each block's parameter schema, port patterns and documentation, which is what you need before adding a block with tensorcad_apply_ops.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "attention, mlp, norm, embedding, container, io, ...",
    "type": "string"
   },
   "kind": {
    "enum": [
     "primitive",
     "composite",
     "container"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Default 20.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "query": {
    "description": "Substring matched against type, category, summary and formula.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tensorcad_search_catalog",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "blocks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "dynamic_ports": {
       "type": "boolean"
      },
      "formula": {
       "type": "string"
      },
      "inputs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "kind": {
       "type": "string"
      },
      "name": {
       "description": "What a drawing calls this block.",
       "type": "string"
      },
      "outputs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "params": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "default": {
          "type": "string"
         },
         "doc": {
          "type": "string"
         },
         "name": {
          "type": "string"
         },
         "type": {
          "type": "string"
         },
         "values": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "name",
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "refs": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "summary": {
       "type": "string"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "type",
      "kind",
      "category",
      "name",
      "summary",
      "refs",
      "params",
      "inputs",
      "outputs",
      "dynamic_ports"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "categories": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "total": {
    "description": "Matches before the limit was applied.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "categories",
   "blocks"
  ],
  "type": "object"
 },
 "title": "Search catalog"
}
