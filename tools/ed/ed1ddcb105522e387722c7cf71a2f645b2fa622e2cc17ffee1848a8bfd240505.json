{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "manage:ads"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Link or unlink asset group assets"
 },
 "description": "Link or unlink asset group assets. Spending/deletion: preview, then owner-approved confirm:true with the same requestId. Other edits: one call. Creates request active; report returned status and claim live only when active. Full field guide: soclo://tools/soclo_ads_edit_google_asset_group_assets.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "The connected ad account in Soclo.",
    "minLength": 1,
    "type": "string"
   },
   "adAccountId": {
    "description": "Advertiser/ad account selected from your Soclo connection.",
    "type": "string"
   },
   "confirm": {
    "description": "True only after owner approval of spending/deletion preview.",
    "type": "boolean"
   },
   "expectedBudgetAmount": {
    "description": "Approved preview amount; changes require a new preview.",
    "type": "number"
   },
   "expectedBudgetType": {
    "description": "Approved preview budget type: daily or lifetime.",
    "type": "string"
   },
   "expectedCurrency": {
    "description": "Approved preview currency, e.g. GBP.",
    "type": "string"
   },
   "parameters": {
    "properties": {
     "assetGroupId": {
      "pattern": "^\\d+$",
      "type": "string"
     },
     "campaignId": {
      "pattern": "^\\d+$",
      "type": "string"
     }
    },
    "required": [
     "campaignId",
     "assetGroupId"
    ],
    "type": "object"
   },
   "payload": {
    "properties": {
     "link": {
      "items": {
       "properties": {
        "asset": {
         "type": "string"
        },
        "fieldType": {
         "type": "string"
        },
        "imageUrl": {
         "type": "string"
        },
        "text": {
         "maxLength": 90,
         "type": "string"
        },
        "youtubeVideoId": {
         "description": "Links as YOUTUBE_VIDEO.",
         "pattern": "^[A-Za-z0-9_-]{11}$",
         "type": "string"
        }
       },
       "required": [
        "fieldType"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "unlink": {
      "items": {
       "properties": {
        "asset": {
         "type": "string"
        },
        "fieldType": {
         "type": "string"
        }
       },
       "required": [
        "fieldType",
        "asset"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "validateOnly": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "platform": {
    "description": "The campaign platform.",
    "type": "string"
   },
   "requestId": {
    "description": "Reuse this request ID for confirmation and outcome recovery.",
    "type": "string"
   }
  },
  "required": [
   "accountId",
   "parameters",
   "payload"
  ],
  "type": "object"
 },
 "name": "soclo_ads_edit_google_asset_group_assets",
 "title": "Link or unlink asset group assets"
}
