{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Full-text search over every scientific claim Pith has extracted,\n    across all reviewed papers. Call this when the user asks who claims\n    something, whether a claim appears in the recent literature, or what\n    evidence bears on a statement. Returns each matching claim with its\n    paper, verdict, and review link.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 10,
    "title": "Limit",
    "type": "integer"
   },
   "query": {
    "description": "The claim or statement to look for, in plain words.",
    "title": "Query",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "title": "search_claimsArguments",
  "type": "object"
 },
 "name": "search_claims",
 "outputSchema": {
  "$defs": {
   "ClaimHit": {
    "properties": {
     "arxiv_id": {
      "title": "Arxiv Id",
      "type": "string"
     },
     "citation_url": {
      "title": "Citation Url",
      "type": "string"
     },
     "claim_role": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Claim Role"
     },
     "claim_text": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Claim Text"
     },
     "source_name": {
      "title": "Source Name",
      "type": "string"
     },
     "title": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Title"
     },
     "url": {
      "title": "Url",
      "type": "string"
     },
     "verdict": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Verdict"
     }
    },
    "required": [
     "arxiv_id",
     "claim_role",
     "claim_text",
     "title",
     "verdict",
     "url",
     "source_name",
     "citation_url"
    ],
    "title": "ClaimHit",
    "type": "object"
   }
  },
  "properties": {
   "count": {
    "title": "Count",
    "type": "integer"
   },
   "note": {
    "title": "Note",
    "type": "string"
   },
   "query": {
    "title": "Query",
    "type": "string"
   },
   "results": {
    "items": {
     "$ref": "#/$defs/ClaimHit"
    },
    "title": "Results",
    "type": "array"
   }
  },
  "required": [
   "query",
   "count",
   "results"
  ],
  "title": "ClaimSearchResults",
  "type": "object"
 },
 "title": "Search extracted claims"
}
