{
 "_meta": {
  "toolset": "entity"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add Marker"
 },
 "description": "Add a point marker at geographic coordinates. Returns { success, data: { entityId }, message? }; keep entityId for removeEntity.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "color": {
    "default": "#3B82F6",
    "description": "Marker color (CSS format)",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "id": {
    "description": "Custom layer ID (auto-generated if omitted)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "label": {
    "description": "Label text",
    "maxLength": 200,
    "type": "string"
   },
   "latitude": {
    "description": "Latitude (-90 to 90)",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "description": "Longitude (-180 to 180)",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "sessionId": {
    "description": "Target browser session ID for multi-browser routing (optional)",
    "type": "string"
   },
   "size": {
    "default": 12,
    "description": "Point size (pixels)",
    "maximum": 128,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "longitude",
   "latitude"
  ],
  "type": "object"
 },
 "name": "addMarker",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "entityId": {
      "type": "string"
     }
    },
    "required": [
     "entityId"
    ],
    "type": "object"
   },
   "error": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 }
}
