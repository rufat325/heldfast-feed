{
 "_meta": {
  "lovie/risk": "write",
  "openai/toolInvocation/invoked": "Done",
  "openai/toolInvocation/invoking": "Working\u2026",
  "openai/visibility": "public",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "AttachDocument records an uploaded file against the application.",
 "inputSchema": {
  "properties": {
   "applicationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "contentType": {
    "maxLength": 255,
    "pattern": "^([a-z]+/[a-z0-9.+-]+)?$",
    "type": "string"
   },
   "kind": {
    "enum": [
     "DOCUMENT_KIND_SPECIMEN",
     "DOCUMENT_KIND_LOGO",
     "DOCUMENT_KIND_POWER_OF_ATTORNEY",
     "DOCUMENT_KIND_OTHER"
    ],
    "type": "string"
   },
   "niceClass": {
    "maximum": 45,
    "minimum": 0,
    "type": "integer"
   },
   "s3Uri": {
    "maxLength": 1024,
    "minLength": 1,
    "pattern": "^s3://[A-Za-z0-9._/-]+$",
    "type": "string"
   }
  },
  "required": [
   "applicationId"
  ],
  "type": "object"
 },
 "name": "trademark_attach_document",
 "outputSchema": {
  "properties": {
   "documentId": {
    "anyOf": [
     {
      "description": "UUID value wrapper.",
      "properties": {
       "value": {
        "format": "uuid",
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Attach Document"
}
