{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a video. Use this tool to update a video.",
 "inputSchema": {
  "properties": {
   "category_id": {
    "description": "Category of the video",
    "type": "string"
   },
   "contains_synthetic_media": {
    "description": "Whether the video contains altered or synthetic media",
    "type": "boolean"
   },
   "description": {
    "description": "Description of the video",
    "type": "string"
   },
   "embeddable": {
    "description": "Whether the video is embeddable",
    "type": "boolean"
   },
   "ids": {
    "description": "ID of the video to update",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "language": {
    "description": "Language of the video",
    "type": "string"
   },
   "license": {
    "description": "youtube|creativeCommon",
    "enum": [
     "youtube",
     "creativeCommon"
    ],
    "type": "string"
   },
   "output": {
    "default": "json",
    "description": "json|yaml|silent",
    "enum": [
     "json",
     "yaml",
     "silent"
    ],
    "type": "string"
   },
   "playlist_id": {
    "description": "Playlist id of the video",
    "type": "string"
   },
   "privacy": {
    "description": "public|private|unlisted",
    "enum": [
     "public",
     "private",
     "unlisted"
    ],
    "type": "string"
   },
   "publish_at": {
    "description": "Datetime when the video is scheduled to publish",
    "type": "string"
   },
   "recording_date": {
    "description": "Date and time when the video was recorded",
    "type": "string"
   },
   "tags": {
    "description": "Comma separated tags",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "thumbnail": {
    "description": "Path to the thumbnail file",
    "type": "string"
   },
   "title": {
    "description": "Title of the video",
    "type": "string"
   }
  },
  "required": [
   "ids"
  ],
  "type": "object"
 },
 "name": "video-update",
 "title": "Update a video"
}
