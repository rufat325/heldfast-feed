{
 "description": "Create a product the merchant can sell through a hosted checkout page. Price is a fiat amount; the customer pays the crypto equivalent.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "askForAddress": {
    "type": "boolean"
   },
   "askForName": {
    "type": "boolean"
   },
   "askForPhoneNumber": {
    "type": "boolean"
   },
   "currency": {
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "CAD",
     "AUD",
     "JPY"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "image": {
    "description": "Storage key of a previously uploaded image.",
    "type": "string"
   },
   "isActive": {
    "type": "boolean"
   },
   "name": {
    "description": "Product display name.",
    "type": "string"
   },
   "price": {
    "description": "Fiat price (e.g. 19.99). Returned as a string.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "name",
   "price"
  ],
  "type": "object"
 },
 "name": "create_product",
 "title": "Create product"
}
