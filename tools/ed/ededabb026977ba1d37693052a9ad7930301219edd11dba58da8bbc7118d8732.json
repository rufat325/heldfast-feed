{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Day by day, whether a product is open between two dates, and how many are left where it is counted (boats, parking, charters; for moorage, feet free and the longest boat that fits). For a yes or no on exact dates and a number of units, quote_trip is the shorter road.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "boatLengthFt": {
    "description": "Moorage only: the boat's length in feet.",
    "maximum": 200,
    "minimum": 8,
    "type": "integer"
   },
   "endDate": {
    "description": "YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "productId": {
    "description": "A product id from list_products.",
    "maxLength": 80,
    "minLength": 2,
    "pattern": "^[a-z0-9][a-z0-9:_-]{1,79}$",
    "type": "string"
   },
   "startDate": {
    "description": "YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "productId",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "check_availability",
 "outputSchema": {
  "properties": {
   "counted": {
    "type": "boolean"
   },
   "days": {
    "items": {
     "properties": {
      "date": {
       "type": "string"
      },
      "feetFree": {
       "type": "integer"
      },
      "longestBoatThatFitsFt": {
       "type": "integer"
      },
      "soldOut": {
       "type": "boolean"
      },
      "unitsLeft": {
       "type": "integer"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "openEveryDay": {
    "type": "boolean"
   },
   "productId": {
    "type": "string"
   }
  },
  "required": [
   "productId",
   "days",
   "openEveryDay"
  ],
  "type": "object"
 },
 "title": "Which days are open"
}
