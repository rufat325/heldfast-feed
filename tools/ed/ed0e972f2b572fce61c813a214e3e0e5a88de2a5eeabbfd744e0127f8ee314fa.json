{
 "description": "Update an existing one-time product. Pass the full desired listings/purchaseOptions state plus an updateMask (e.g. \"listings,purchaseOptions\").",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "listings": {
    "description": "At least one localization is required",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "Localized description (max 200 chars)",
       "type": "string"
      },
      "languageCode": {
       "description": "BCP-47 locale code, e.g. en-US",
       "type": "string"
      },
      "title": {
       "description": "Localized title (max 55 chars)",
       "type": "string"
      }
     },
     "required": [
      "languageCode",
      "title",
      "description"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "packageName": {
    "description": "Android package name (e.g. com.example.app)",
    "type": "string"
   },
   "productId": {
    "description": "One-time product ID, e.g. com.example.app.remove_ads",
    "type": "string"
   },
   "purchaseOptions": {
    "description": "At least one purchase option (buy or rent) is required",
    "items": {
     "additionalProperties": false,
     "properties": {
      "buy": {
       "additionalProperties": false,
       "description": "Configures this as a one-time buy option. Mutually exclusive with rent.",
       "properties": {
        "legacyCompatible": {
         "description": "Marks this as the single \"buy\" option usable by legacy PBL flows",
         "type": "boolean"
        },
        "multiQuantityEnabled": {
         "type": "boolean"
        }
       },
       "type": "object"
      },
      "offerTags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "purchaseOptionId": {
       "description": "Stable purchase option id, e.g. buy-standard",
       "type": "string"
      },
      "regionalConfigs": {
       "description": "At least one region price is required",
       "items": {
        "additionalProperties": false,
        "properties": {
         "availability": {
          "default": "AVAILABLE",
          "enum": [
           "AVAILABLE",
           "NOT_AVAILABLE"
          ],
          "type": "string"
         },
         "currency": {
          "description": "ISO 4217 currency code, e.g. USD",
          "type": "string"
         },
         "priceMicros": {
          "description": "Price in micros, e.g. 3990000 for $3.99",
          "type": "string"
         },
         "regionCode": {
          "description": "ISO 3166-1 alpha-2 region, e.g. US",
          "type": "string"
         }
        },
        "required": [
         "regionCode",
         "priceMicros",
         "currency"
        ],
        "type": "object"
       },
       "minItems": 1,
       "type": "array"
      },
      "rent": {
       "additionalProperties": false,
       "description": "Configures this as a rental option. Mutually exclusive with buy.",
       "properties": {
        "expirationPeriod": {
         "description": "ISO 8601 duration after consumption starts before the entitlement is revoked, e.g. P2D",
         "type": "string"
        },
        "rentalPeriod": {
         "description": "ISO 8601 duration the entitlement lasts, e.g. P30D",
         "type": "string"
        }
       },
       "required": [
        "rentalPeriod"
       ],
       "type": "object"
      }
     },
     "required": [
      "purchaseOptionId",
      "regionalConfigs"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "regionsVersion": {
    "default": "2022/02",
    "description": "Google Play regions version. Default 2022/02 matches Google API expectations.",
    "type": "string"
   },
   "updateMask": {
    "description": "Comma-separated field mask of top-level fields to update, e.g. \"listings,purchaseOptions\"",
    "type": "string"
   }
  },
  "required": [
   "packageName",
   "productId",
   "listings",
   "purchaseOptions",
   "updateMask"
  ],
  "type": "object"
 },
 "name": "google_update_one_time_product"
}
