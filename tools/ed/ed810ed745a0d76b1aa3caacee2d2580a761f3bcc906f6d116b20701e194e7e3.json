{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List elections by date range and/or country, soonest first, with each race's expected count stage right now. Answers \"Which elections are in Europe this autumn?\", \"Which elections are this month?\" or \"What elections does Germany have coming up?\". Without dates it starts today; with a country and no end date it covers every future election of that country, otherwise the next 365 days. Covers 153 elections in 61 countries, 2026\u20132030, including 22 of the 27 EU member states and the 2026 US midterms in all 50 states.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "Country name or ISO 3166-1 alpha-2 code, e.g. \"Austria\" or \"AT\", \"United States\" or \"US\"",
    "type": "string"
   },
   "from": {
    "description": "Start date YYYY-MM-DD; default today",
    "type": "string"
   },
   "include_discovered": {
    "description": "Also list elections found on Wikidata but not yet verified by Election Index",
    "type": "boolean"
   },
   "limit": {
    "description": "Most elections to return, soonest first; default 25, max 200. Narrow with from/to or country for more.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "to": {
    "description": "End date YYYY-MM-DD; default +365 days, or no end when a country is given",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "upcoming_elections",
 "outputSchema": {
  "properties": {
   "meta": {
    "description": "What this answer was built from; cite dataset_version",
    "properties": {
     "built_at": {
      "description": "When the dataset was built",
      "type": "string"
     },
     "dataset_version": {
      "description": "Dataset version",
      "type": "string"
     },
     "docs": {
      "description": "Documentation URL",
      "type": "string"
     },
     "generated_at": {
      "description": "When this answer was generated",
      "type": "string"
     },
     "licence": {
      "description": "Licence and required credit",
      "type": "string"
     }
    },
    "required": [
     "dataset_version",
     "licence"
    ],
    "type": "object"
   },
   "result": {
    "properties": {
     "discovered_unverified": {
      "description": "Found on Wikidata, not verified",
      "items": {
       "type": "object"
      },
      "type": "array"
     },
     "elections": {
      "items": {
       "properties": {
        "country": {
         "description": "ISO 3166-1 alpha-2",
         "type": "string"
        },
        "country_name": {
         "description": "Country name",
         "type": "string"
        },
        "date": {
         "description": "Polling day (YYYY-MM-DD)",
         "type": "string"
        },
        "date_status": {
         "description": "declared, scheduled or tentative",
         "type": "string"
        },
        "id": {
         "description": "Election id",
         "type": "string"
        },
        "kind": {
         "description": "Kind of election",
         "type": "string"
        },
        "last_verified_at": {
         "description": "When the record was last checked against its sources",
         "type": "string"
        },
        "races": {
         "items": {
          "properties": {
           "expected_stage_now": {
            "description": "Count stage expected on the authority page now",
            "type": [
             "string",
             "null"
            ]
           },
           "id": {
            "description": "Race id",
            "type": "string"
           },
           "name": {
            "description": "Race name",
            "type": "string"
           },
           "sources": {
            "items": {
             "properties": {
              "check": {
               "description": "Latest link check",
               "type": [
                "object",
                "null"
               ]
              },
              "kind": {
               "description": "race_results, feed, results_index, emb_home, directory or media",
               "type": "string"
              },
              "kindReason": {
               "description": "Why it was classified that way",
               "type": "string"
              },
              "origin": {
               "description": "race, stage or authority",
               "type": "string"
              },
              "resolvable": {
               "description": "Can this page answer a results question?",
               "type": "boolean"
              },
              "role": {
               "description": "What the page is for",
               "type": "string"
              },
              "url": {
               "description": "Source URL",
               "type": "string"
              }
             },
             "type": "object"
            },
            "type": "array"
           },
           "stages": {
            "items": {
             "description": "Expected window for one count stage",
             "properties": {
              "by": {
               "description": "Latest expected time (ISO)",
               "type": [
                "string",
                "null"
               ]
              },
              "citation": {
               "description": "Basis for the window",
               "type": "string"
              },
              "confidence": {
               "description": "announced (law or authority), precedent (last election) or estimate",
               "type": "string"
              },
              "from": {
               "description": "Earliest expected time (ISO)",
               "type": [
                "string",
                "null"
               ]
              },
              "observedAt": {
               "description": "When the authority actually published it; null until observed",
               "type": [
                "string",
                "null"
               ]
              },
              "observedSource": {
               "description": "URL that proves the observation",
               "type": [
                "string",
                "null"
               ]
              },
              "replacedAt": {
               "description": "When a later stage replaces it on the authority page",
               "type": [
                "string",
                "null"
               ]
              },
              "source": {
               "description": "Source of a stage published outside the authority page",
               "type": [
                "string",
                "null"
               ]
              },
              "stage": {
               "description": "Count stage id",
               "type": "string"
              }
             },
             "type": [
              "object",
              "null"
             ]
            },
            "type": "array"
           },
           "status": {
            "description": "Race status",
            "type": "string"
           }
          },
          "type": "object"
         },
         "type": "array"
        },
        "stale": {
         "description": "Not re-verified recently, or a stage is overdue",
         "type": "boolean"
        },
        "stale_reason": {
         "description": "Why it is stale",
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "description": "Where the election is now: scheduled, counting, finalising, final-expected, ...",
         "type": "string"
        },
        "timezone": {
         "description": "IANA time zone",
         "type": "string"
        },
        "url": {
         "description": "Page on electionindex.org",
         "type": "string"
        }
       },
       "required": [
        "id",
        "country",
        "date",
        "status",
        "url"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "returned": {
      "description": "Elections in this answer (see limit)",
      "type": "integer"
     },
     "total": {
      "description": "Elections matching the filters",
      "type": "integer"
     }
    },
    "required": [
     "elections"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "meta"
  ],
  "type": "object"
 },
 "title": "Upcoming elections"
}
