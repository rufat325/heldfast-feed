{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new estimate (quote) in QuickBooks Online.\n\nExample: { \"customerId\": \"123\", \"lines\": [{ \"description\": \"Consulting services\", \"amount\": 1500 }] }\n\nWORKFLOW:\n1. Use list_quickbooks_customers to find the customer ID\n2. Create with line items (description + amount required)\n3. Optionally set expirationDate and memo\n\nCOMMON MISTAKES:\n- customerId is required (use list_quickbooks_customers to find it)\n- Each line needs at least description and amount\n- Dates use YYYY-MM-DD format",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "customerId": {
    "description": "Customer ID (required)",
    "type": "string"
   },
   "expirationDate": {
    "description": "Expiration date (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "lines": {
    "description": "Estimate line items (at least one required)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Line amount (must be > 0)",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "description": {
       "description": "Line description",
       "minLength": 1,
       "type": "string"
      },
      "itemId": {
       "description": "Item/service ID (optional)",
       "type": "string"
      },
      "qty": {
       "description": "Quantity (default: 1, must be > 0)",
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "amount"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "memo": {
    "description": "Customer memo / notes",
    "type": "string"
   }
  },
  "required": [
   "customerId",
   "lines"
  ],
  "type": "object"
 },
 "name": "create_quickbooks_estimate"
}
