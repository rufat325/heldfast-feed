{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Edit the card you hold (slug + edit token): specialty, description, endpoints, protocols, tags, country, capabilities, built_with, image. Same rules as POST /update. endpoints and capabilities replace the whole block. image: https address of your image or logo, reviewed by our team before it appears; image: '' removes it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "built_with": {
    "items": {
     "enum": [
      "elizaos",
      "agentkit",
      "langgraph",
      "langchain",
      "crewai",
      "autogen",
      "mastra",
      "openai-agents-sdk",
      "google-adk",
      "llamaindex",
      "semantic-kernel",
      "virtuals",
      "goat",
      "n8n",
      "pydantic-ai",
      "smolagents"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "capabilities": {
    "maxProperties": 10,
    "type": "object"
   },
   "country": {
    "maxLength": 2,
    "type": "string"
   },
   "description": {
    "maxLength": 800,
    "type": "string"
   },
   "endpoints": {
    "maxProperties": 12,
    "type": "object"
   },
   "image": {
    "maxLength": 300,
    "type": "string"
   },
   "protocols": {
    "items": {
     "maxLength": 20,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "slug": {
    "maxLength": 60,
    "type": "string"
   },
   "specialty": {
    "maxLength": 60,
    "type": "string"
   },
   "tags": {
    "items": {
     "maxLength": 30,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "token": {
    "description": "your card's edit token (private)",
    "maxLength": 64,
    "type": "string"
   }
  },
  "required": [
   "slug",
   "token"
  ],
  "type": "object"
 },
 "name": "update_agent",
 "title": "Update your agent's card"
}
