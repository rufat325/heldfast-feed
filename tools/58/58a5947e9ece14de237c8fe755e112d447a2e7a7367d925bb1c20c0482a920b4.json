{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare 2 to 5 UK pay scenarios (pay rises, pension changes, moving to Scotland, student loans) side by side, with the difference in net pay from the first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "scenarios": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "childBenefitAnnual": {
       "maximum": 100000,
       "minimum": 0,
       "type": "number"
      },
      "grossSalary": {
       "maximum": 100000000,
       "minimum": 0,
       "type": "number"
      },
      "pension": {
       "additionalProperties": false,
       "properties": {
        "method": {
         "enum": [
          "salary_sacrifice",
          "net_pay",
          "relief_at_source"
         ],
         "type": "string"
        },
        "percent": {
         "maximum": 100,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "percent",
        "method"
       ],
       "type": "object"
      },
      "region": {
       "enum": [
        "rUK",
        "scotland",
        "england",
        "wales",
        "northern-ireland",
        "ni"
       ],
       "type": "string"
      },
      "studentLoans": {
       "items": {
        "enum": [
         "plan1",
         "plan2",
         "plan4",
         "plan5",
         "postgrad"
        ],
        "type": "string"
       },
       "maxItems": 2,
       "type": "array"
      },
      "taxYear": {
       "enum": [
        "2025-26",
        "2026-27"
       ],
       "type": "string"
      }
     },
     "required": [
      "grossSalary"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "scenarios"
  ],
  "type": "object"
 },
 "name": "compare_take_home",
 "title": "Compare UK take-home pay scenarios"
}
