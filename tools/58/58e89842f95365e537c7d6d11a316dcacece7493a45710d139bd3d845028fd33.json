{"annotations":{"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Resume / CV PDF"},"description":"Turn structured CV fields into a clean A4 resume PDF: contact header, summary, experience, education, skills, projects and languages, in any section order, with three templates like the website: \"classic\" (centred header and accent rule), \"modern\" (coloured sidebar with contact, skills and languages) and \"compact\" (denser, headings in a left column). Description lines starting with \"-\", \"\u2022\", \"*\" or \"\u2013\" become bullet points; skills are comma-separated. Aims for one page; longer CVs continue on a second page. English headings, Latin text only for now. Web version: https://s3eidat.github.io/resume-builder/","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"accent":{"default":"#0e7c86","description":"Accent colour (hex).","pattern":"^#[0-9a-fA-F]{6}$","type":"string"},"contact":{"default":{"email":"","location":"","name":"","phone":"","title":"","website":""},"properties":{"email":{"default":"","description":"Email.","maxLength":120,"type":"string"},"location":{"default":"","description":"City, country.","maxLength":100,"type":"string"},"name":{"default":"","description":"Full name.","maxLength":100,"type":"string"},"phone":{"default":"","description":"Phone.","maxLength":60,"type":"string"},"title":{"default":"","description":"Headline / job title.","maxLength":120,"type":"string"},"website":{"default":"","description":"Website or LinkedIn.","maxLength":160,"type":"string"}},"type":"object"},"education":{"default":[],"items":{"properties":{"degree":{"default":"","description":"Degree","maxLength":160,"type":"string"},"desc":{"default":"","description":"Details","maxLength":3000,"type":"string"},"end":{"default":"","description":"End","maxLength":160,"type":"string"},"place":{"default":"","description":"Location","maxLength":160,"type":"string"},"school":{"default":"","description":"School"