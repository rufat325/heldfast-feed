ng"},{"items":{"type":"string"},"type":"array"}],"default":"","description":"Skills: comma-separated text or a list."},"summary":{"default":"","description":"Two or three lines about you.","maxLength":2000,"type":"string"},"template":{"default":"classic","enum":["classic","modern","compact"],"type":"string"}},"type":"object"},"name":"doc_resume","title":"Resume / CV PDF"}
