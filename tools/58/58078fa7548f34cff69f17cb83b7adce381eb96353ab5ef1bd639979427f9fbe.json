{
 "description": "List active and historical enrollments for an automation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "automationId": {
    "description": "Automation ID",
    "type": "string"
   },
   "page": {
    "description": "Page number",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Results per page (max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "state": {
    "enum": [
     "active",
     "completed",
     "exited",
     "paused"
    ],
    "type": "string"
   }
  },
  "required": [
   "automationId"
  ],
  "type": "object"
 },
 "name": "list_automation_enrollments"
}
