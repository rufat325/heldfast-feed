{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find listings of Yoga-Ausbildungen with the filters of the site, 20 per page, most checked facts first. list_categories names the filters and values of each category.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category, default: yogalehrer-ausbildung",
    "enum": [
     "yogalehrer-ausbildung"
    ],
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "azav": {
      "description": "AZAV-zertifiziert (Bildungsgutschein)",
      "type": "boolean"
     },
     "bildungsurlaub": {
      "description": "Bildungsurlaub m\u00f6glich",
      "type": "boolean"
     },
     "certification": {
      "description": "Zertifizierung: any of these values",
      "items": {
       "enum": [
        "yoga_alliance",
        "bdy",
        "aya",
        "bdyoga_other",
        "zpp",
        "none_stated"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "format": {
      "description": "Format: any of these values",
      "items": {
       "enum": [
        "part_time",
        "weekend",
        "intensive",
        "online",
        "hybrid",
        "retreat_abroad"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "instalments": {
      "description": "Ratenzahlung",
      "type": "boolean"
     },
     "styles": {
      "description": "Yogastile: any of these values",
      "items": {
       "enum": [
        "hatha",
        "vinyasa",
        "yin",
        "kundalini",
        "ashtanga",
        "iyengar",
        "sivananda",
        "power",
        "restorative",
        "prenatal",
        "kids",
        "other"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "training_hours": {
      "description": "Ausbildungsstunden: any of these values",
      "items": {
       "enum": [
        "200",
        "300",
        "500",
        "other"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "zpp_recognised": {
      "description": "ZPP-anerkannt",
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "page": {
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free text: a name or a word",
    "type": "string"
   },
   "sort": {
    "enum": [
     "relevance",
     "name",
     "checked"
    ],
    "type": "string"
   },
   "where": {
    "description": "A place: town, region, or state (a part of the name is enough)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_listings",
 "title": "Search listings"
}
