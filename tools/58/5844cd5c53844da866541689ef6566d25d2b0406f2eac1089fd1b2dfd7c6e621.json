{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate each ticket's relative share of total value and cost as fractions between 0 and 1 (0.25 = 25%). Shows how one ticket compares to the whole backlog, or to a tagged subset when tag is given.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max number of entries to return (default: all)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Number of entries to skip, to page through a list too large for one result",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "tag": {
    "description": "Only compare tickets with this tag (prefix:value)",
    "type": "string"
   },
   "tags": {
    "description": "Only compare tickets with all of these tags (intersection, also with tag). Each as prefix:value",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "calc_weights",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "relativeBenefit": {
       "type": "number"
      },
      "relativeEstimate": {
       "type": "number"
      },
      "relativePenalty": {
       "type": "number"
      },
      "relativeRisk": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "relativeBenefit",
      "relativePenalty",
      "relativeEstimate",
      "relativeRisk"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
