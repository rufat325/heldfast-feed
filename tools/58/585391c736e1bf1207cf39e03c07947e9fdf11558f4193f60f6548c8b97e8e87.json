{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Validate a context-grounded direction record. Use preserve for bounded fixes; audits need no direction ceremony. Does not persist approval or enforce writes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aesthetic": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "antiSlopRisks": {
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "contextSources": {
    "items": {
     "maxLength": 2000,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "minItems": 1,
    "type": "array"
   },
   "designRead": {
    "maxLength": 2000,
    "minLength": 20,
    "type": "string"
   },
   "designVariance": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "inverseTestDescription": {
    "maxLength": 2000,
    "type": "string"
   },
   "inverseTestPass": {
    "type": "boolean"
   },
   "layoutFamilies": {
    "items": {
     "maxLength": 200,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "mode": {
    "default": "change",
    "enum": [
     "preserve",
     "change"
    ],
    "type": "string"
   },
   "motionIntensity": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "namedReferences": {
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 16,
    "type": "array"
   },
   "physicalScene": {
    "maxLength": 2000,
    "type": "string"
   },
   "register": {
    "enum": [
     "brand",
     "product"
    ],
    "type": "string"
   },
   "typographyDirection": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "visualDensity": {
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "register",
   "designRead",
   "contextSources"
  ],
  "type": "object"
 },
 "name": "commit_design_direction",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "directionId": {
    "type": "string"
   },
   "fixes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "scope": {
    "const": "input-validation",
    "type": "string"
   },
   "status": {
    "enum": [
     "PASS",
     "FAIL"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "scope",
   "message"
  ],
  "type": "object"
 }
}
