         },
         "media_type": {
          "type": "string"
         },
         "png_base64": {
          "description": "A complete PNG file, base64 encoded. Save it with the filename.",
          "type": "string"
         },
         "png_bytes": {
          "type": "integer"
         },
         "role": {
          "enum": [
           "hook",
