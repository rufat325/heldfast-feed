{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Cr\u00e9e un backup (timeshift, borg, vm-snapshot, ou manual)",
 "inputSchema": {
  "properties": {
   "comment": {
    "maxLength": 256,
    "type": "string"
   },
   "dest": {
    "maxLength": 4096,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9/_.-]+$",
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "type": "boolean"
   },
   "live": {
    "type": "boolean"
   },
   "notify": {
    "default": false,
    "type": "boolean"
   },
   "source": {
    "maxLength": 4096,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9/_.-]+$",
    "type": "string"
   },
   "timeout_ms": {
    "maximum": 3600000,
    "minimum": 60000,
    "type": "number"
   },
   "type": {
    "enum": [
     "timeshift",
     "borg",
     "vm-snapshot",
     "manual"
    ],
    "type": "string"
   },
   "verify": {
    "default": false,
    "type": "boolean"
   },
   "vm": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]*$",
    "type": "string"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "backup_create"
}
