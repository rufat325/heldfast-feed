{
 "description": "Recurring treasury/accounting snapshot with balances, gas and recent token activity; repeat about every five minutes while active. Costs $0.01 USDC on Base via x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activity_contract": {
    "description": "ERC-20 activity contract; defaults to USDC.",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "activity_cursor": {
    "minimum": 0,
    "type": "integer"
   },
   "address": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "lookback_blocks": {
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "network": {
    "enum": [
     "base",
     "ethereum"
    ],
    "type": "string"
   },
   "previous_state_hash": {
    "pattern": "^[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "tokens": {
    "items": {
     "pattern": "^0x[a-fA-F0-9]{40}$",
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "treasury_snapshot"
}
