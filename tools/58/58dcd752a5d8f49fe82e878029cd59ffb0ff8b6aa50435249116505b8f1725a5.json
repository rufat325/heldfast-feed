{
 "_meta": {
  "agent-utilities/exampleUrl": "https://agent-utilities.agent-utilities.workers.dev/v1/content/examples/agents.config-audit",
  "agent-utilities/priceMicroUsd": 800
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Review agent configuration text with five fixed risk heuristics. PAID: 800 micro-dollar service credits per successful call. First use agent_utilities_prepare for this tool. Requires existing credits and a private Authorization header. Reuse prepared arguments for recovery; a new requestId is a new billable operation.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "input": {
    "additionalProperties": false,
    "properties": {
     "text": {
      "maxLength": 100000,
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Explicit maximum new debit; 0 means recovery only.",
    "maximum": 999999999999,
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Persist the ID returned by agent_utilities_prepare. Reuse after uncertainty.",
    "pattern": "^\\d{13}_[A-Za-z0-9_-]{16,80}$",
    "type": "string"
   }
  },
  "required": [
   "input",
   "requestId",
   "maxPriceMicroUsd"
  ],
  "type": "object"
 },
 "name": "agents_config_audit",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "caveat": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "rule": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      }
     },
     "required": [
      "rule",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rulesVersion": {
    "type": "string"
   }
  },
  "required": [
   "findings",
   "rulesVersion",
   "caveat"
  ],
  "type": "object"
 }
}
