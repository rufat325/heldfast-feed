  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Domain DNS, email security and TLS certificate"
 },
 "description": "A domain's public setup, asked of the source: A, AAAA, CNAME, MX, NS, TXT, CAA and SOA records; its SPF and DMARC email policy, parsed; and its HTTPS certificate, verified like a browser (issuer, names, expiry, days left, TLS version). Flags missing SPF or DMARC, duplicate SPF and a certificate near expiry. No WHOIS or third-party data. Input: domain (a URL is accepted). $0.05 per call. Returns: domain, domain_ascii, exists, records{a[], aaaa[], cname[], mx[], ns[], txt[], caa[], soa[]}, email_security{spf{record, all, multiple}, dmarc{record, policy, subdomain_policy, percent, reports_to}}, tls{reachable, valid, error, ip, protocol, subject, issuer, names[], not_before, not_after, days_remaining}, notes[], checked_at.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "A domain (github.com) or a URL on it.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "language": {
    "description": "Optional BCP-47 language tag (en, ja, ko, pt-BR): the human-readable strings of the result (notes, details, reasons) are translated into this language; data, codes, numbers and URLs are untouched. Default: as produced.",
    "maxLength": 35,
    "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
    "type": "string"
   },
   "tls": {
    "description": "Also check the HTTPS certificate. Default true.",
    "type": "boolean"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
