{
 "description": "Up to 100 hovers in one call, across files. Items: {name, line?}, {line, text, occurrence?}, or {line, column}; failures are per item.",
 "inputSchema": {
  "properties": {
   "backend": {
    "description": "Default typescript7; retry with typescript6 if it fails or looks wrong",
    "enum": [
     "typescript6",
     "typescript7"
    ]
   },
   "file": {
    "description": "Shared file for items without one",
    "type": "string"
   },
   "full": {
    "description": "Untruncated types (no \"... 12 more ...\"), all overloads",
    "type": "boolean"
   },
   "include_cost": {
    "description": "Count type instantiations; typescript6 only",
    "type": "boolean"
   },
   "include_docs": {
    "description": "Also return JSDoc/TSDoc",
    "type": "boolean"
   },
   "max_chars": {
    "description": "Text cap per type (default 4000 chars; 0: none)",
    "minimum": 0,
    "type": "integer"
   },
   "positions": {
    "description": "1-100 lookups",
    "items": {
     "properties": {
      "column": {
       "description": "1-based column; alternative to text",
       "minimum": 1,
       "type": "integer"
      },
      "file": {
       "description": "Overrides the shared file",
       "type": "string"
      },
      "line": {
       "description": "1-based line; required without name",
       "minimum": 1,
       "type": "integer"
      },
      "name": {
       "description": "Symbol name, e.g. \"createHandler\"",
       "minLength": 1,
       "type": "string"
      },
      "occurrence": {
       "description": "Which match of text on the line (default 1)",
       "minimum": 1,
       "type": "integer"
      },
      "text": {
       "description": "Token copied from the line, e.g. \"useState\"; whole identifiers match first. Instead of column",
       "minLength": 1,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "project": {
    "description": "tsconfig.json; default: the nearest one above file",
    "type": "string"
   }
  },
  "required": [
   "positions"
  ],
  "type": "object"
 },
 "name": "batch_hover",
 "outputSchema": {
  "properties": {
   "error": {
    "properties": {
     "candidates": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "FILE_NOT_FOUND",
       "SYMBOL_NOT_FOUND",
       "TYPESCRIPT_ERROR",
       "INTERNAL_ERROR"
      ]
     },
     "message": {
      "type": "string"
     },
     "suggestion": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "result": {
    "properties": {
     "errorCount": {
      "type": "number"
     },
     "items": {
      "items": {
       "properties": {
        "error": {
         "properties": {
          "candidates": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "code": {
           "enum": [
            "INVALID_ARGUMENT",
            "FILE_NOT_FOUND",
            "SYMBOL_NOT_FOUND",
            "TYPESCRIPT_ERROR",
            "INTERNAL_ERROR"
           ]
          },
          "message": {
           "type": "string"
          },
          "suggestion": {
           "type": "string"
          }
         },
         "required": [
          "code",
          "message"
         ],
         "type": "object"
        },
        "file": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "occurrence": {
         "type": "number"
        },
        "position": {
         "properties": {
          "column": {
           "type": "number"
          },
          "line": {
           "type": "number"
          }
         },
         "required": [
          "line",
          "column"
         ],
         "type": "object"
        },
        "result": {
         "properties": {
          "alternatives": {
           "items": {
            "properties": {
             "column": {
              "type": "number"
             },
             "kind": {
              "type": "string"
             },
             "line": {
              "type": "number"
             }
            },
            "required": [
             "line",
             "column"
            ],
            "type": "object"
           },
           "type": "array"
          },
          "column": {
           "type": "number"
          },
          "cost": {
           "properties": {
            "instantiations": {
             "type": "number"
            },
            "types": {
             "type": "number"
            }
           },
           "required": [
            "instantiations",
            "types"
           ],
           "type": "object"
          },
          "display": {
           "type": "string"
          },
          "documentation": {
           "type": "string"
          },
          "kind": {
           "type": "string"
          },
          "line": {
           "type": "number"
          },
          "name": {
           "type": "string"
          },
          "overloads": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "position": {
           "properties": {
            "column": {
             "type": "number"
            },
            "line": {
             "type": "number"
            }
           },
           "required": [
            "line",
            "column"
           ],
           "type": "object"
          },
          "returnType": {
           "type": "string"
          },
          "signature": {
           "type": "string"
          },
          "unionMembers": {
           "type": "number"
          }
         },
         "required": [
          "signature",
          "line",
          "column",
          "kind"
         ],
         "type": "object"
        },
        "text": {
         "type": "string"
        }
       },
       "required": [
        "position"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "successCount": {
      "type": "number"
     }
    },
    "required": [
     "items",
     "successCount",
     "errorCount"
    ],
    "type": "object"
   },
   "version": {
    "const": 1
   }
  },
  "required": [
   "version",
   "ok"
  ],
  "type": "object"
 }
}
