{
 "_meta": {
  "openai/toolInvocation/invoked": "Files read",
  "openai/toolInvocation/invoking": "Reading files from your site"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read up to 50 served files in one call, with the same per-file rules as read_file and 8388608 bytes in total; paths past the budget fail with BATCH_BUDGET_EXCEEDED, so request them again in another call. Use read_source_files instead for the editable source tree.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "maxBytesPerFile": {
    "description": "Per-file size cap in bytes. Default 1048576, max 5242880.",
    "exclusiveMinimum": 0,
    "maximum": 5242880,
    "type": "integer"
   },
   "name": {
    "description": "Site name as shown by list_sites, e.g. my-portfolio. Provide name or siteId.",
    "type": "string"
   },
   "paths": {
    "description": "Site-relative paths to read (1..50). Order is preserved in the response.",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "siteId": {
    "description": "Site id from list_sites or get_site. Use instead of name.",
    "type": "string"
   }
  },
  "required": [
   "paths"
  ],
  "type": "object"
 },
 "name": "read_files",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "budgetExceededAt": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Index of the first path that was skipped due to the cumulative byte budget, or null if everything fit."
   },
   "files": {
    "description": "One entry per requested path, in order. A missing or oversized file fails only its own entry; entries past the byte budget fail with BATCH_BUDGET_EXCEEDED.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "content": {
         "type": "string"
        },
        "encoding": {
         "enum": [
          "utf8",
          "base64"
         ],
         "type": "string"
        },
        "ok": {
         "const": true,
         "type": "boolean"
        },
        "path": {
         "type": "string"
        },
        "size": {
         "type": "number"
        }
       },
       "required": [
        "ok",
        "path",
        "size",
        "encoding",
        "content"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "error": {
         "additionalProperties": false,
         "properties": {
          "code": {
           "type": "string"
          },
          "details": {
           "additionalProperties": {},
           "propertyNames": {
            "type": "string"
           },
           "type": "object"
          },
          "message": {
           "type": "string"
          }
         },
         "required": [
          "code",
          "message"
         ],
         "type": "object"
        },
        "ok": {
         "const": false,
         "type": "boolean"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "ok",
        "path",
        "error"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "siteId": {
    "type": "string"
   },
   "totalBytes": {
    "description": "Sum of bytes returned across successful entries.",
    "type": "number"
   }
  },
  "required": [
   "siteId",
   "name",
   "files",
   "totalBytes",
   "budgetExceededAt"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Read multiple files from a deployed site in one call"
}
