{
 "description": "Get account-level insights and analytics for Instagram business account",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "Instagram business account ID (optional)",
    "type": "string"
   },
   "metrics": {
    "description": "Specific metrics to retrieve",
    "items": {
     "enum": [
      "reach",
      "profile_views",
      "website_clicks",
      "accounts_engaged"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "period": {
    "default": "day",
    "description": "Time period for insights",
    "enum": [
     "day",
     "lifetime"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_account_insights"
}
