{
 "description": "Search HDB resale flat transactions (Jan 2017+). Filters: town, flat_type (e.g. '4 ROOM'), month range (YYYY-MM), price range. Returns paginated transaction rows.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "flat_type": {
    "type": "string"
   },
   "limit": {
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "max_price": {
    "type": "number"
   },
   "min_price": {
    "type": "number"
   },
   "month_from": {
    "type": "string"
   },
   "month_to": {
    "type": "string"
   },
   "offset": {
    "minimum": 0,
    "type": "integer"
   },
   "town": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "sg_hdb_resale_search"
}
