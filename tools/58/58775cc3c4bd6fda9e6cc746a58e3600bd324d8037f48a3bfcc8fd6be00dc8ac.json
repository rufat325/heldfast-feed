{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Log evaluation feedback (score or judgment) on a trace",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Feedback name (e.g. 'helpfulness')",
    "type": "string"
   },
   "rationale": {
    "description": "Free-form explanation",
    "type": "string"
   },
   "source": {
    "properties": {
     "source_id": {
      "description": "Source identifier (e.g. user email)",
      "type": "string"
     },
     "source_type": {
      "description": "Source type",
      "enum": [
       "HUMAN",
       "LLM_JUDGE",
       "CODE",
       "AI_JUDGE"
      ],
      "type": "string"
     }
    },
    "required": [
     "source_type"
    ],
    "type": "object"
   },
   "traceId": {
    "description": "Trace ID this feedback is for",
    "type": "string"
   },
   "value": {
    "description": "Feedback value (score, label, etc.)",
    "type": [
     "string",
     "number",
     "boolean"
    ]
   }
  },
  "required": [
   "traceId",
   "name",
   "value"
  ],
  "type": "object"
 },
 "name": "log-feedback"
}
