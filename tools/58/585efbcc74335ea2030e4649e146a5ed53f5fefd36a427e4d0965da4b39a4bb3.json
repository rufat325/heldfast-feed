{
 "description": "Submit a sitemap to Google Search Console and return its current state",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "dryRun": {
    "default": false,
    "description": "If true, report what would be submitted without writing to Search Console",
    "type": "boolean"
   },
   "feedpath": {
    "description": "Absolute URL of the sitemap to submit",
    "format": "uri",
    "type": "string"
   },
   "siteUrl": {
    "description": "Search Console property",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "siteUrl",
   "feedpath"
  ],
  "type": "object"
 },
 "name": "submit_sitemap",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "type": "boolean"
   },
   "feedpath": {
    "type": "string"
   },
   "siteUrl": {
    "type": "string"
   },
   "sitemap": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "contents": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "indexed": {
           "type": "number"
          },
          "submitted": {
           "type": "number"
          },
          "type": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "type",
          "submitted",
          "indexed"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "errors": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "isPending": {
        "anyOf": [
         {
          "type": "boolean"
         },
         {
          "type": "null"
         }
        ],
        "description": "Null when Google did not report it, which is not the same as known to be processed"
       },
       "isSitemapsIndex": {
        "type": "boolean"
       },
       "lastDownloaded": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastSubmitted": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "path": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "warnings": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "description": "Null while the sitemap is pending. Zero warnings beside zero errors reads as parsed and clean, which an unprocessed sitemap is not"
       }
      },
      "required": [
       "path",
       "lastSubmitted",
       "lastDownloaded",
       "isPending",
       "isSitemapsIndex",
       "warnings",
       "errors",
       "contents"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "stateRefreshError": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "success": {
    "type": "boolean"
   }
  },
  "required": [
   "success",
   "siteUrl",
   "feedpath",
   "sitemap",
   "stateRefreshError"
  ],
  "type": "object"
 }
}
