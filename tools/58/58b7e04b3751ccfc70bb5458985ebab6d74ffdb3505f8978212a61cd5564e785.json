{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"\ud1f4\uc0ac\ud55c \ud574\uc5d0 \ubc1b\uc740 \uae09\uc5ec\u00b7\ube44\uacfc\uc138\u00b74\ub300\ubcf4\ud5d8\ub8cc(\uadfc\ub85c\uc790 \ubd80\ub2f4)\u00b7\uc774\ubbf8 \ub0b8 \uc18c\ub4dd\uc138\ub85c \ud1f4\uc9c1\ud558\ub294 \ub2ec \uc5f0\ub9d0\uc815\uc0b0(\uc18c\ub4dd\uc138\ubc95 \uc81c137\uc870 \uc81c1\ud56d)\uc5d0\uc11c \ub354 \ub0b4\uac70\ub098 \ub3cc\ub824\ubc1b\uc744 \uc18c\ub4dd\uc138\u00b7\uc9c0\ubc29\uc18c\ub4dd\uc138 \uc608\uc0c1\uc561\uc744 \uacc4\uc0b0\ud55c\ub2e4(\uc0ac\uc774\ud2b8 /tools/midyear-settlement \uc640 \uac19\uc740 \uc5d4\uc9c4). \uace0\uc815\ud615 \u2014 \ubcf8\uc778 \uae30\ubcf8\uacf5\uc81c 150\ub9cc\uc6d0\u00b7\uad6d\ubbfc\uc5f0\uae08 \uc5f0\uae08\ubcf4\ud5d8\ub8cc\uacf5\uc81c\uc5d0 \ub354\ud574 \ub450 \ubc29\uc2dd\uc744 \ub2e4 \uacc4\uc0b0\ud574 \ub098\ub780\ud788 \ub0b8\ub2e4: A = \uac74\uac15\u00b7\uc7a5\uae30\uc694\uc591\u00b7\uace0\uc6a9\ubcf4\ud5d8\ub8cc \uc18c\ub4dd\uacf5\uc81c, B = \ud45c\uc900\uc138\uc561\uacf5\uc81c 13\ub9cc\uc6d0(\ub458\uc740 \ud568\uaed8 \ubc1b\uc744 \uc218 \uc5c6\uace0, \uc5b4\ub290 \ucabd\uc778\uc9c0\ub294 \uadfc\ub85c\uc790\uac00 \ubcf4\ud5d8\ub8cc \uc18c\ub4dd\uacf5\uc81c\ub97c \uc2e0\uccad\ud588\ub294\uc9c0\ub85c \uc815\ud574\uc9c4\ub2e4). \ucd1d\uae09\uc5ec = \ubc1b\uc740 \uae09\uc5ec \u2212 \ube44\uacfc\uc138 \u2192 \uadfc\ub85c\uc18c\ub4dd\uacf5\uc81c(5\uad6c\uac04, \ud55c\ub3c4 2\ucc9c\ub9cc\uc6d0) \u2192 \uacfc\uc138\ud45c\uc900 \u2192 \uae30\ubcf8\uc138\uc728 = \uc0b0\ucd9c\uc138\uc561 \u2212 \uadfc\ub85c\uc18c\ub4dd\uc138\uc561\uacf5\uc81c(\ucd1d\uae09\uc5ec \uad6c\uac04\ubcc4 \ud55c\ub3c4) [\u2212 \ud45c\uc900\uc138\uc561\uacf5\uc81c] = \uacb0\uc815\uc138\uc561(0 \uc544\ub798\ub85c \ub0b4\ub824\uac00\uc9c0 \uc54a\uc74c). \ucc28\uac10 \uc18c\ub4dd\uc138 = \uacb0\uc815\uc138\uc561 \u2212 \ud1f4\uc9c1\uc6d4 \uc804 \ub2ec\uae4c\uc9c0 \ub0b8 \uc18c\ub4dd\uc138, 10\uc6d0 \ubbf8\ub9cc\uc740 0 \ucabd\uc73c\ub85c \ubc84\ub9bc. \uc9c0\ubc29\uc18c\ub4dd\uc138 = \uacb0\uc815\uc138\uc561\uc758 10%(\uc6d0 \ubbf8\ub9cc \ubc84\ub9bc) \u2212 \uc774\ubbf8 \ub0b8 \uc9c0\ubc29\uc18c\ub4dd\uc138, 10\uc6d0 \ubbf8\ub9cc\uc740 0 \ucabd\uc73c\ub85c \ubc84\ub9bc. \ud1f4\uc9c1\uc6d4 \uac04\uc774\uc138\uc561\uc740 \uc815\uc0b0\uc561\uc5d0 \uc4f0\uc9c0 \uc54a\uace0, \ud68c\uc0ac\uac00 \uadf8\uac83\uc744 \uba3c\uc800 \ub5c0 \uacbd\uc6b0\uc758 \uc601\uc218\uc99d \ub300\uc870\uac12\ub9cc \ub530\ub85c \ub0b8\ub2e4. \ubd80\uc591\uac00\uc871\u00b7\ucd94\uac00\uacf5\uc81c\u00b7\uc885\uc804 \uadfc\ubb34\uc9c0\u00b7\uc911\uc18c\uae30\uc5c5 \ucde8\uc5c5\uc790 \uac10\uba74\u00b7\uc8fc\ud0dd\uc790\uae08\u00b7\uc2e0\uc6a9\uce74\ub4dc \ub4f1 \uc18c\ub4dd\uacf5\uc81c\u00b7\ud2b9\ubcc4\uc138\uc561\uacf5\uc81c\u00b7\ud63c\uc778\uc138\uc561\uacf5\uc81c\u00b7\uc138\ud6c4 \uae08\uc561 \uacc4\uc57d\uc740 \ub2e4\ub8e8\uc9c0 \uc54a\uace0(\ud574\ub2f9\ud558\uba74 \uacc4\uc0b0\ud558\uc9c0 \uc54a\ub294\ub2e4), \ucd1d\uae09\uc5ec 1\uc5b5 2\ucc9c\ub9cc\uc6d0 \uc774\uc0c1\uacfc \uae30\uc900\uc744 \ub123\uc9c0 \uc54a\uc740 \ud574(\uc9c0\uae08\uc740 2026\ub144\ub9cc)\ub3c4 \uacc4\uc0b0\ud558\uc9c0 \uc54a\ub294\ub2e4. \uacb0\uacfc\ub294 \uc608\uc0c1 \uae08\uc561\uc774\uba70 \uc6d0\ucc9c\uc9d5\uc218\uc601\uc218\uc99d\u00b7\uc2e0\uace0\uc11c\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"employment":{"description":"\uace0\uc6a9\ubcf4\ud5d8\ub8cc \uadfc\ub85c\uc790 \ubd80\ub2f4 \u2014 \ud1f4\uc9c1\uc6d4\uae4c\uc9c0 \ud569\uacc4(\uc6d0)","type":"number"},"hasExcludedItem":{"description":"\uc62c\ud574 \uc544\ub798 \uac00\uc6b4\ub370 \ud558\ub098\ub77c\ub3c4 \ud574\ub2f9\ud558\uba74 true \u2014 \ubd80\uc591\uac00\uc871 \uacf5\uc81c \uc2e0\uccad \u00b7 \ubcf8\uc778 \ucd94\uac00\uacf5\uc81c(70\uc138 \uc774\uc0c1\u00b7\uc7a5\uc560\uc778\u00b7\ubd80\ub140\uc790\u00b7\ud55c\ubd80\ubaa8) \u00b7 \uc8fc\ud0dd\uc790\uae08\u00b7\uc8fc\ud0dd\uccad\uc57d\u00b7\uc2e0\uc6a9\uce74\ub4dc \ub4f1 \uc18c\ub4dd\uacf5\uc81c \u00b7 \uc62c\ud574 \ub2e4\ub978 \ud68c\uc0ac \uae09\uc5ec \u00b7 \uc911\uc18c\uae30\uc5c5 \ucde8\uc5c5\uc790 \uc18c\ub4dd\uc138 \uac10\uba74 \u00b7 \ubcf4\uc7a5\uc131\ubcf4\ud5d8\ub8cc\u00b7\uc758\ub8cc\ube44\u00b7\uad50\uc721\ube44\u00b7\uae30\ubd80\uae08\u00b7\uc6d4\uc138\u00b7\uc5f0\uae08\uacc4\uc88c \uc138\uc561\uacf5\uc81c \u00b7 \ud63c\uc778\uc138\uc561\uacf5\uc81c \u00b7 \uc77c\uc6a9\uadfc\ub85c\uc790\u00b7\ube44\uac70\uc8fc\uc790\u00b7\uc678\uad6d\uc778 \ub2e8\uc77c\uc138\uc728 \u00b7 \ud68c\uc0ac\uac00 \uc138\uae08\uc744 \ubd80\ub2f4\ud558\ub294 \uc138\ud6c4 \uae08\uc561 \uacc4\uc57d. true \uc774\uba74 \uacc4\uc0b0\ud558\uc9c0 \uc54a\ub294\ub2e4","type":"boolean"},"health":{"description":"\uac74\uac15\ubcf4\ud5d8\ub8cc \uadfc\ub85c\uc790 \ubd80\ub2f4 \u2014 \ud1f4\uc9c1\uc6d4\uae4c\uc9c0 \ud569\uacc4(\ud1f4\uc9c1\uc815\uc0b0\uc73c\ub85c \ub354 \ub5c0 \uac83\uc740 \ub354\ud558\uace0 \ub3cc\ub824\ubc1b\uc740 \uac83\uc740 \ube80\ub2e4)(\uc6d0)","type":"number"},"lastMonthSimpleTax":{"description":"\ud1f4\uc9c1\uc6d4 \uac04\uc774\uc138\uc561(\uc6d0, \ub300\uc870\uc6a9) \u2014 \ub123\uc73c\uba74 \ud68c\uc0ac\uac00 \uadf8\uac83\uc744 \uba3c\uc800 \ub5bc\uace0 \uc815\uc0b0\ud55c \uacbd\uc6b0\uc758 \uc601\uc218\uc99d \uac12\ub3c4 \ub0b8\ub2e4. \uc815\uc0b0\uc561 \uacc4\uc0b0\uc5d0\ub294 \uc4f0\uc9c0 \uc54a\ub294\ub2e4","type":"number"},"longTermCare":{"description":"\uc7a5\uae30\uc694\uc591\ubcf4\ud5d8\ub8cc \uadfc\ub85c\uc790 \ubd80\ub2f4 \u2014 \ud1f4\uc9c1\uc6d4\uae4c\uc9c0 \ud569\uacc4(\ud1f4\uc9c1\uc815\uc0b0\ubd84 \ubc18\uc601)(\uc6d0)","type":"number"},"nonTaxable":{"description":"\ube44\uacfc\uc138 \uae09\uc5ec \ud569\uacc4 \u2014 \ud1f4\uc9c1\uc6d4\uae4c\uc9c0(\uae09\uc5ec\uba85\uc138\uc11c\uc5d0 \ube44\uacfc\uc138\ub85c \uc801\ud78c \uae08\uc561)(\uc6d0)","type":"number"},"paidIncomeTax":{"description":"\uc774\ubbf8 \ub0b8 \uc18c\ub4dd\uc138 \u2014 \ud1f4\uc9c1\uc6d4 \uc804 \ub2ec\uae4c\uc9c0 \ud569\uacc4(\uc6d0)","type":"number"},"paidLocalTax":{"description":"\uc774\ubbf8 \ub0b8 \uc9c0\ubc29\uc18c\ub4dd\uc138 \u2014 \ud1f4\uc9c1\uc6d4 \uc804 \ub2ec\uae4c\uc9c0 \ud569\uacc4(\uc6d0)","type":"number"},"pension":{"description":"\uad6d\ubbfc\uc5f0\uae08 \uadfc\ub85c\uc790 \ubd80\ub2f4 \u2014 \ud1f4\uc9c1\uc6d4\uae4c\uc9c0 \ud569\uacc4(\uc6d0)","type":"number"},"totalPay":{"description":"\ubc1b\uc740 \uae09\uc5ec \ud569\uacc4 \u2014 \uadf8\ud574 1\uc6d4\ubd80\ud130 \ud1f4\uc9c1\uc6d4\uae4c\uc9c0, \ube44\uacfc\uc138 \ud3ec\ud568(\uc6d0)","type":"number"},"year":{"description":"\ud1f4\uc0ac\ud55c \ud574(\uadc0\uc18d\uc5f0\ub3c4). \ube44\uc6b0\uba74 \uc62c\ud574(KST) \u2014 \uc62c\ud574 \uae30\uc900\uc774 \uc5c6\uc73c\uba74 \uc9c1\uc811 \ub123\uc5b4\uc57c \ud55c\ub2e4","type":"integer"}},"required":["hasExcludedItem","totalPay","nonTaxable","pension","health","longTermCare","employment","paidIncomeTax","paidLocalTax"],"type":"object"},"name":"calc_midyear_settlement","title":"\uc911\ub3c4\ud1f4\uc0ac\uc790 \uc5f0\ub9d0\uc815\uc0b0"}
