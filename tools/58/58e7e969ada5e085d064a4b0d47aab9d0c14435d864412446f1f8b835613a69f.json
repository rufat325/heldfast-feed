{
 "description": "Owner-only. Restore project access on the same contract identity without creating a replacement contract. Requires explicit confirm: true to acknowledge this live mutation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "description": "Required explicit confirmation that this live contract mutation is intentional.",
    "type": "boolean"
   },
   "contractId": {
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "contractId",
   "idempotencyKey",
   "reason",
   "confirm"
  ],
  "type": "object"
 },
 "name": "opentrain_reactivate_contract",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
