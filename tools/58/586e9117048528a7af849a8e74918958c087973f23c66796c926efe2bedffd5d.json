{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Inbox Message"
 },
 "description": "Set read and/or starred state on one inbox message.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Mailbox ID.",
    "pattern": "^[A-Za-z0-9_-]{1,100}$",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "message_id": {
    "description": "JMAP inbox message ID.",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   },
   "read": {
    "description": "Set the message read state.",
    "type": "boolean"
   },
   "starred": {
    "description": "Set the message starred state.",
    "type": "boolean"
   }
  },
  "required": [
   "id",
   "message_id"
  ],
  "type": "object"
 },
 "name": "shipmail_update_inbox_message",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "inbox_message_action": {
    "properties": {
     "address": {
      "type": "string"
     },
     "mailbox_id": {
      "type": "string"
     },
     "message_id": {
      "type": "string"
     },
     "object": {
      "type": "string"
     },
     "ok": {
      "const": true,
      "type": "boolean"
     }
    },
    "required": [
     "object",
     "mailbox_id",
     "address",
     "message_id",
     "ok"
    ],
    "type": "object"
   }
  },
  "required": [
   "inbox_message_action"
  ],
  "type": "object",
  "~standard": {
   "jsonSchema": {},
   "vendor": "zod",
   "version": 1
  }
 },
 "title": "Update Inbox Message"
}
