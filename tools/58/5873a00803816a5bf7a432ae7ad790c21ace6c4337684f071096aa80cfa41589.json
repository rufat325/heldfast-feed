     "null"
    ]
   },
   "cache_write": {
    "description": "Cache-write / cache-creation tokens, or null when unavailable.",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "input": {
    "description": "Fresh input tokens.",
    "minimum": 0,
    "type": "integer"
   },
   "model": {
    "description": "Optional model identifier.",
    "type": "string"
   },
   "output": {
    "description": "Output tokens.",
    "minimum": 0,
    "type": "integer"
   },
   "provider": {
    "description": "Optional provider identifier.",
    "type": "string"
   },
   "timestamp": {
    "description": "Optional ISO-8601 timestamp. Defaults to the current time.",
    "format": "date-time",
    "type": "string"
   },
   "tool": {
    "description": "Optional tool/client identifier.",
    "type": "string"
   }
  },
  "required": [
   "input",
   "output"
  ],
  "type": "object"
 },
