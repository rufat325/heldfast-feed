{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Hybrid (keyword + semantic) search over servers and their tools. Filter by connection class to keep only what you can reach autonomously (R0, R1).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "enum": [
     "developer-tools",
     "databases",
     "web-search",
     "files-storage",
     "communication",
     "productivity",
     "ai-ml",
     "cloud-devops",
     "finance",
     "commerce",
     "maps-travel",
     "media",
     "science-health",
     "security",
     "iot-automation",
     "legal-government"
    ],
    "type": "string"
   },
   "class": {
    "description": "Connection classes to keep, e.g. ['R0','R1']",
    "items": {
     "enum": [
      "R0",
      "R1",
      "R2",
      "L0",
      "unknown"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "exclude_flags": {
    "description": "Trust flags, any of which excludes a server, e.g. ['multi-version-spam','duplicate-repo']",
    "items": {
     "enum": [
      "multi-version-spam",
      "duplicate-repo",
      "no-repository",
      "no-connection",
      "deprecated",
      "unreachable",
      "blocked",
      "deleted"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "flags": {
    "description": "Trust flags that must all be present",
    "items": {
     "enum": [
      "multi-version-spam",
      "duplicate-repo",
      "no-repository",
      "no-connection",
      "deprecated",
      "unreachable",
      "blocked",
      "deleted"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Results to return (default 10)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_trust": {
    "description": "Minimum trust score 0-100",
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "q": {
    "description": "What you want to do, in plain words, e.g. 'send an email' or 'query postgres'",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "transport": {
    "enum": [
     "streamable-http",
     "sse"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search",
 "title": "Search MCP servers by intent"
}
