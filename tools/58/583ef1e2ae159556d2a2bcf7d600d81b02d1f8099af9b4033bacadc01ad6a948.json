{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Report one phase of an onboarding attempt, success or failure (attempt reporting contract v1). Send one report when each runbook phase ends, and a final report with phase \"session\" (with the `phases` roll-up), also when you stop early (outcome abandoned or budget_stop). Generate `sessionId` (UUID v4) once per attempt and increment `seq` with every report; a retried report with the same sessionId and seq is collapsed. Never guess: send null for what you do not know (tokens: source \"unknown\"). Redact keys, tokens, emails and wallet secrets before sending. Always include `summary`: contract v1 makes it optional, but until the gateway's attempt support lands it is the only field kept, and today's server refuses a report without it. The schema is contract v1: an unknown phase, outcome or harness name is accepted (the server stores it as other or unknown, with the raw value as a label), and budget-stop is a spelling of budget_stop. Never send a transcript; consent.transcript stays false until the operator decides. Unauthenticated.",
 "inputSchema": {
  "additionalProperties": false,
  "if": {
   "properties": {
    "phase": {
     "not": {
      "const": "session"
     }
    }
   }
  },
  "properties": {
   "consent": {
    "additionalProperties": false,
    "properties": {
     "transcript": {
      "enum": [
       false
      ],
      "type": "boolean"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "contract": {
    "enum": [
     1
    ],
    "type": "integer"
   },
   "detail": {
    "maxLength": 20000,
    "type": [
     "string",
     "null"
    ]
   },
   "device": {
    "additionalProperties": false,
    "properties": {
     "class": {
      "enum": [
       "lab_instrument",
       "robot",
       "printer",
       "process_agent",
       "other",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "make": {
      "maxLength": 128,
      "type": [
       "string",
       "null"
      ]
     },
     "model": {
      "maxLength": 128,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "durationMs": {
    "description": "The phase's wall time; on session, the whole attempt",
    "maximum": 86400000,
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "env": {
    "additionalProperties": false,
    "properties": {
     "os": {
      "maxLength": 64,
      "type": [
       "string",
       "null"
      ]
     },
     "pccNode": {
      "maxLength": 64,
      "type": [
       "string",
       "null"
      ]
     },
     "python": {
      "maxLength": 64,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "harness": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "maxLength": 128,
      "type": [
       "string",
       "null"
      ]
     },
     "model": {
      "maxLength": 128,
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "anyOf": [
       {
        "enum": [
         "claude-code",
         "codex",
         "pcc-hosted",
         "other"
        ],
        "type": "string"
       },
       {
        "description": "Any other name: the server stores \"other\", with the raw name as label.",
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "version": {
      "maxLength": 128,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "ids": {
    "additionalProperties": false,
    "description": "Only the ids known so far: each at most 200 characters of [A-Za-z0-9:._/-], or null",
    "properties": {
     "capabilityId": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9:._/-]+$",
      "type": [
       "string",
       "null"
      ]
     },
     "jobId": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9:._/-]+$",
      "type": [
       "string",
       "null"
      ]
     },
     "kernelId": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9:._/-]+$",
      "type": [
       "string",
       "null"
      ]
     },
     "kitId": {
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9:._/-]+$",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "kind": {
    "enum": [
     "attempt"
    ],
    "type": "string"
   },
   "logs": {
    "description": "The phase's step timeline, summaries only",
    "items": {
     "additionalProperties": false,
     "properties": {
      "method": {
       "type": [
        "string",
        "null"
       ]
      },
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "path": {
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "type": [
        "integer",
        "null"
       ]
      },
      "step": {
       "minimum": 0,
       "type": [
        "integer",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "maxItems": 20,
    "type": [
     "array",
     "null"
    ]
   },
   "outcome": {
    "anyOf": [
     {
      "enum": [
       "ok",
       "failed",
       "blocked",
       "skipped",
       "budget_stop",
       "abandoned",
       "in_progress",
       "budget-stop"
      ],
      "type": "string"
     },
     {
      "description": "Any other value: the server stores \"unknown\", with the raw value as outcomeLabel.",
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "pack": {
    "additionalProperties": false,
    "properties": {
     "digest": {
      "description": "sha256:<64 hex> of this package's bytes",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": [
       "string",
       "null"
      ]
     },
     "version": {
      "maxLength": 64,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "phase": {
    "anyOf": [
     {
      "enum": [
       "prerequisites",
       "identify",
       "intake",
       "research",
       "build",
       "register",
       "verify",
       "operate",
       "publish",
       "session"
      ],
      "type": "string"
     },
     {
      "description": "Any other value: the server stores \"other\", with the raw value (clamped to 64 characters) as phaseLabel.",
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "phases": {
    "description": "Only on phase \"session\": the roll-up",
    "items": {
     "additionalProperties": false,
     "properties": {
      "durationMs": {
       "maximum": 86400000,
       "minimum": 0,
       "type": [
        "integer",
        "null"
       ]
      },
      "outcome": {
       "anyOf": [
        {
         "enum": [
          "ok",
          "failed",
          "blocked",
          "skipped",
          "budget_stop",
          "abandoned",
          "in_progress",
          "budget-stop"
         ],
         "type": "string"
        },
        {
         "description": "Any other value: the server stores \"unknown\", with the raw value as outcomeLabel.",
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "phase": {
       "anyOf": [
        {
         "enum": [
          "prerequisites",
          "identify",
          "intake",
          "research",
          "build",
          "register",
          "verify",
          "operate",
          "publish",
          "session"
         ],
         "type": "string"
        },
        {
         "description": "Any other value: the server stores \"other\", with the raw value (clamped to 64 characters) as phaseLabel.",
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "phase",
      "outcome"
     ],
     "type": "object"
    },
    "maxItems": 16,
    "type": [
     "array",
     "null"
    ]
   },
   "proposal": {
    "additionalProperties": false,
    "description": "One improvement idea",
    "properties": {
     "path": {
      "description": "No query string",
      "maxLength": 2000,
      "pattern": "^[^?]*$",
      "type": [
       "string",
       "null"
      ]
     },
     "target": {
      "enum": [
       "runbook",
       "agent-package",
       "docs",
       "code",
       "process",
       "other",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     },
     "text": {
      "maxLength": 5000,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "seq": {
    "description": "Per-session report counter",
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "sessionId": {
    "description": "UUID v4, generated once at the start of the attempt",
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-4[0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
    "type": "string"
   },
   "summary": {
    "description": "One line, e.g. \"register: failed, POST /api/kernels 400\"",
    "maxLength": 5000,
    "type": [
     "string",
     "null"
    ]
   },
   "tokens": {
    "additionalProperties": false,
    "description": "Never guess: send null with source \"unknown\"",
    "properties": {
     "in": {
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "out": {
      "minimum": 0,
      "type": [
       "integer",
       "null"
      ]
     },
     "source": {
      "enum": [
       "self_reported",
       "harness",
       "metered",
       "unknown",
       null
      ],
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "traceId": {
    "description": "x-pcc-trace-id of the last PCC call",
    "maxLength": 200,
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "kind",
   "sessionId",
   "seq",
   "phase",
   "outcome"
  ],
  "then": {
   "not": {
    "required": [
     "phases"
    ]
   }
  },
  "type": "object"
 },
 "name": "pcc_report_attempt"
}
