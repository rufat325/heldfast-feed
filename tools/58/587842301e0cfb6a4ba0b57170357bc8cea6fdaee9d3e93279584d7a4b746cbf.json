           "canonical_url",
           "cite_as"
          ],
          "title": "ResponseMetaResource",
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "categories": {
        "default": [],
        "items": {
         "type": "string"
        },
        "title": "Categories",
        "type": "array"
       },
       "closed_time": {
        "anyOf": [
         {
          "format": "date-time",
          "type": "string"
         },
         {
