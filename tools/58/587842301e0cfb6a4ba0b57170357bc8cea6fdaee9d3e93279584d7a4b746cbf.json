       "_meta": {
        "anyOf": [
         {
          "description": "Agent metadata for single-resource responses (with cite_as).",
          "properties": {
           "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
           },
           "attribution": {
            "default": "pdata.world \u2014 aggregated prediction-market data across 8 platforms",
            "title": "Attribution",
            "type": "string"
           },
           "canonical_url": {
            "title": "Canonical Url",
            "type": "string"
           },
           "cite_as": {
            "title": "Cite As",
            "type": "string"
           },
           "docs": {
