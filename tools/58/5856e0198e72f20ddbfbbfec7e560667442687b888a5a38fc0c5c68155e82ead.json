{
 "_meta": {
  "openai/outputTemplate": "ui://widget/powder-list.html",
  "openai/toolInvocation/invoked": "Snow report ready",
  "openai/toolInvocation/invoking": "Checking snow conditions\u2026",
  "openai/widgetAccessible": true,
  "openai/widgetCSP": {
   "connect_domains": [
    "https://www.snowsure.ai"
   ],
   "redirect_domains": [
    "https://www.snowsure.ai"
   ],
   "resource_domains": [
    "https://www.snowsure.ai",
    "https://cdn.sanity.io",
    "https://fonts.googleapis.com",
    "https://fonts.gstatic.com"
   ]
  },
  "openai/widgetDescription": "Ranked list of resorts by fresh snow, depth, and SnowSure score",
  "openai/widgetPrefersBorder": true,
  "ui": {
   "csp": {
    "connectDomains": [
     "https://www.snowsure.ai"
    ],
    "redirectDomains": [
     "https://www.snowsure.ai"
    ],
    "resourceDomains": [
     "https://www.snowsure.ai",
     "https://cdn.sanity.io",
     "https://fonts.googleapis.com",
     "https://fonts.gstatic.com"
    ]
   },
   "prefersBorder": true,
   "resourceUri": "ui://widget/powder-list.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Global snow report"
 },
 "description": "Get the global snow report with top-ranked resorts by snow conditions. Returns resorts sorted by SnowSure score, forecast, or recent snowfall. Use this for \"where has the best snow?\" or \"top ski resorts right now\" queries.",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of resorts to return (default: 10, max: 50)",
    "type": "number"
   },
   "region": {
    "description": "Filter by region",
    "enum": [
     "europe",
     "north-america",
     "asia",
     "oceania",
     "south-america",
     "africa"
    ],
    "type": "string"
   },
   "sort": {
    "description": "Sort order: snowsure (AI rating), forecast (14-day snow), recent (24h snowfall), depth (current base)",
    "enum": [
     "snowsure",
     "forecast",
     "recent",
     "depth"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_snow_report",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "markdown": {
    "description": "Human-readable markdown summary (required for ChatGPT Instant mode).",
    "type": "string"
   },
   "resorts": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "baseDepthCm": {
       "type": "number"
      },
      "country": {
       "type": "string"
      },
      "forecast14dCm": {
       "type": "number"
      },
      "forecast7dCm": {
       "type": "number"
      },
      "forecastHorizonDays": {
       "type": "number"
      },
      "imageUrl": {
       "type": "string"
      },
      "isOpen": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "newSnow24hCm": {
       "type": "number"
      },
      "rank": {
       "type": "number"
      },
      "region": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "snowSureRating": {
       "type": "string"
      },
      "snowSureScore": {
       "type": "number"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "rank",
      "name",
      "slug",
      "country",
      "isOpen",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "subtitle": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "updatedAt": {
    "description": "Oldest data time among the listed resorts (ISO-8601); null when none carries one. Never request time.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "markdown",
   "title",
   "updatedAt",
   "resorts"
  ],
  "type": "object"
 },
 "title": "Global snow report"
}
