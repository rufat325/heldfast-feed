{
 "description": "Read or update a website's colour scheme and typography. Use generate_content with mode=\"suggest-theme\" first to get good suggestions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accentColor": {
    "type": "string"
   },
   "action": {
    "description": "get = read the current theme; apply = update it",
    "enum": [
     "get",
     "apply"
    ],
    "type": "string"
   },
   "backgroundColor": {
    "type": "string"
   },
   "darkMode": {
    "type": "boolean"
   },
   "fontBody": {
    "description": "apply: Google Font name for body text",
    "type": "string"
   },
   "fontHeading": {
    "description": "apply: Google Font name for headings",
    "type": "string"
   },
   "primaryColor": {
    "description": "apply: hex colour, e.g. \"#6366f1\"",
    "type": "string"
   },
   "projectId": {
    "description": "Website project ID",
    "type": "string"
   },
   "secondaryColor": {
    "type": "string"
   },
   "textColor": {
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "action"
  ],
  "type": "object"
 },
 "name": "manage_theme"
}
