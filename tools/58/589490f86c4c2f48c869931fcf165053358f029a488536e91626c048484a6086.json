{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save a niche, a product or a Jev project to the signed-in user's Risetive Saved list (risetive.com/saved). Pass kind and key: kind \"market\" with a niche slug as key, kind \"product\" with a product id (from risetive_get_product_profile, risetive_list_niche_players or risetive_list_new_entrants) as key, or kind \"jev-project\" with a Jev resourceId as key. Returns the saved item's id; saving an item twice keeps one copy. Requires signing in with a free Risetive account.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "key": {
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
     },
     "kind": {
      "const": "market",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "key"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "key": {
      "pattern": "^[1-9][0-9]{0,18}$",
      "type": "string"
     },
     "kind": {
      "const": "product",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "key"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "key": {
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "kind": {
      "const": "jev-project",
      "type": "string"
     }
    },
    "required": [
     "kind",
     "key"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "risetive_save_item",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "id": {
        "pattern": "^[1-9][0-9]{0,18}$",
        "type": "string"
       }
      },
      "required": [
       "id"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "message": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "status": {
    "enum": [
     "ok",
     "not-found",
     "timeout",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "message",
   "data"
  ],
  "type": "object"
 },
 "title": "Save a Risetive item"
}
