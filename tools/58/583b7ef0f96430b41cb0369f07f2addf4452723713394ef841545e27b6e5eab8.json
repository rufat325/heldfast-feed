{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read up to 100 crypto symbols in one /api/index/v1/batch request. Returns observations with individually signed successful rows and per-symbol errors for unavailable rows. Your API tier may allow fewer symbols. Verify each successful row with verify_print and require recordValid=true before trusting its quality fields. Surrounding batch metadata is unsigned. No automatic retries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "symbols": {
    "items": {
     "description": "Crypto ticker symbol, e.g. BTC, ETH, SOL",
     "maxLength": 20,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9]+$",
     "type": "string"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "get_index_batch",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "accountUrl": {
      "const": "https://thepulse.markets/developers/access",
      "type": "string"
     },
     "code": {
      "pattern": "^[A-Z][A-Z0-9_]{0,79}$",
      "type": "string"
     },
     "nextAction": {
      "enum": [
       "wait",
       "review_access",
       "check_limits",
       "reconnect",
       "check_input",
       "choose_another_symbol",
       "report_issue"
      ],
      "type": "string"
     },
     "retryAfterSeconds": {
      "maximum": 86400,
      "minimum": 1,
      "type": "integer"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "nextAction"
    ],
    "type": "object"
   },
   "observations": {
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "at": {
         "maxLength": 40,
         "type": "string"
        },
        "cadence": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "band": {
             "enum": [
              "real-time",
              "five-second",
              "ten-second",
              "slow",
              "unavailable"
             ],
             "type": "string"
            },
            "calculatedAgeMs": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            },
            "newestSourceAgeMs": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            },
            "oldestSourceAgeMs": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            },
            "p50UpdateMs": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            },
            "p95UpdateMs": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            },
            "updatesLast120s": {
             "$ref": "#/properties/observations/items/anyOf/0/properties/sources/anyOf/0"
            }
           },
           "required": [
            "band",
            "calculatedAgeMs",
            "newestSourceAgeMs",
            "oldestSourceAgeMs",
            "p50UpdateMs",
            "p95UpdateMs"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "confidence": {
         "anyOf": [
          {
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "dispersionBps": {
         "anyOf": [
          {
           "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
          },
          {
           "type": "null"
          }
         ]
        },
        "engine": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "getKey": {
         "maxLength": 256,
         "type": "string"
        },
        "grade": {
         "enum": [
          "consensus",
          "blended",
          "indicative",
          "composite",
          "single-source"
         ],
         "type": "string"
        },
        "interval": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "lower": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            },
            "upper": {
             "anyOf": [
              {
               "$ref": "#/properties/observations/items/anyOf/0/properties/confidence/anyOf/0"
              },
              {
               "type": "null"
              }
             ]
            }
           },
           "required": [
            "lower",
            "upper"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "kid": {
         "pattern": "^[A-Za-z0-9._:-]{1,64}$",
         "type": "string"
        },
        "note": {
         "maxLength": 2048,
         "type": "string"
        },
        "price": {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        "priceText": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "sample": {
         "const": true,
         "type": "boolean"
        },
        "sig": {
         "const": "pulse-index-v1",
         "type": "string"
        },
        "signature": {
         "maxLength": 88,
         "minLength": 88,
         "pattern": "^[A-Za-z0-9+/]{86}==$",
         "type": "string"
        },
        "sources": {
         "anyOf": [
          {
           "minimum": 0,
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        },
        "success": {
         "const": true,
         "type": "boolean"
        },
        "symbol": {
         "pattern": "^[A-Za-z0-9]{1,20}$",
         "type": "string"
        },
        "tier": {
         "anyOf": [
          {
           "maxLength": 20,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "v2": {
         "additionalProperties": false,
         "properties": {
          "canonical": {
           "maxLength": 8192,
           "minLength": 1,
           "type": "string"
          },
          "kid": {
           "$ref": "#/properties/observations/items/anyOf/0/properties/kid"
          },
          "sig": {
           "const": "pulse-index-v2",
           "type": "string"
          },
          "signature": {
           "$ref": "#/properties/observations/items/anyOf/0/properties/signature"
          }
         },
         "required": [
          "sig",
          "canonical",
          "signature",
          "kid"
         ],
         "type": "object"
        }
       },
       "required": [
        "symbol",
        "price",
        "at",
        "grade",
        "signature",
        "success"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "code": {
         "maxLength": 80,
         "type": "string"
        },
        "message": {
         "maxLength": 512,
         "type": "string"
        },
        "success": {
         "const": false,
         "type": "boolean"
        },
        "symbol": {
         "maxLength": 20,
         "type": "string"
        }
       },
       "required": [
        "success",
        "symbol",
        "code",
        "message"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 100,
    "type": "array"
   },
   "requestId": {
    "description": "Identifier for this MCP call; not a signed price field.",
    "format": "uuid",
    "type": "string"
   },
   "requested": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "returned": {
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "success": {
    "const": true,
    "type": "boolean"
   }
  },
  "required": [
   "requestId"
  ],
  "type": "object"
 },
 "title": "Get Pulse Verity Index Batch"
}
