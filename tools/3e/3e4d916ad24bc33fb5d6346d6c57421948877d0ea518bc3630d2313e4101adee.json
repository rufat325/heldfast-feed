{
 "description": "Step 2 \u2014 On PASS from check, route to best verified x402 payTo. 100 free routes/mo. Returns payTo + totalCost. Call before pay.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Optional capability hint",
    "type": "string"
   },
   "category": {
    "description": "Capability category to route",
    "enum": [
     "identity",
     "enrichment",
     "compliance",
     "regime",
     "judgment",
     "workflow",
     "inference",
     "data",
     "search",
     "media",
     "infrastructure",
     "tools",
     "finance",
     "social",
     "security",
     "other"
    ],
    "type": "string"
   },
   "maxPrice": {
    "description": "Max endpoint price in USD",
    "type": "number"
   },
   "minScore": {
    "description": "Minimum trust score (default 55; 70 recommended)",
    "type": "number"
   },
   "requireReceiptSettled": {
    "description": "Only route to endpoints with on-chain settlement proof",
    "type": "boolean"
   },
   "strategy": {
    "description": "Routing strategy (default: auto)",
    "enum": [
     "best_score",
     "cheapest",
     "fastest",
     "best_value",
     "random_weighted",
     "failover",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "route"
}
