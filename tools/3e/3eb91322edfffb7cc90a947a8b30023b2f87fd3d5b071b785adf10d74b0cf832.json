{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only time conversion via GET /v3/timezone/convert. Works on free and paid plans. Cost: 1 credit. The conversion requires one source selector and one destination selector; get_timezone provides a single place's current time and metadata.\n\nSource/destination selectors are tz_from/tz_to, location_from/location_to, iata_from/iata_to, icao_from/icao_to, locode_from/locode_to, or lat_from+long_from and lat_to+long_to. time is optional and must be yyyy-MM-dd HH:mm or yyyy-MM-dd HH:mm:ss. Returns original time, converted time, diff_hour, and diff_min.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "iata_from": {
    "description": "Source 3-letter IATA airport code.",
    "type": "string"
   },
   "iata_to": {
    "description": "Destination 3-letter IATA airport code.",
    "type": "string"
   },
   "icao_from": {
    "description": "Source 4-letter ICAO airport code.",
    "type": "string"
   },
   "icao_to": {
    "description": "Destination 4-letter ICAO airport code.",
    "type": "string"
   },
   "lat_from": {
    "description": "Source latitude. Use with long_from.",
    "type": "string"
   },
   "lat_to": {
    "description": "Destination latitude. Use with long_to.",
    "type": "string"
   },
   "location_from": {
    "description": "Source city or address string.",
    "type": "string"
   },
   "location_to": {
    "description": "Destination city or address string.",
    "type": "string"
   },
   "locode_from": {
    "description": "Source 5-character UN/LOCODE.",
    "type": "string"
   },
   "locode_to": {
    "description": "Destination 5-character UN/LOCODE.",
    "type": "string"
   },
   "long_from": {
    "description": "Source longitude. Use with lat_from.",
    "type": "string"
   },
   "long_to": {
    "description": "Destination longitude. Use with lat_to.",
    "type": "string"
   },
   "time": {
    "description": "Time to convert in yyyy-MM-dd HH:mm or yyyy-MM-dd HH:mm:ss format. Defaults to current time.",
    "type": "string"
   },
   "tz_from": {
    "description": "Source IANA timezone name (e.g. America/New_York).",
    "type": "string"
   },
   "tz_to": {
    "description": "Destination IANA timezone name (e.g. Asia/Tokyo).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "convert_timezone",
 "title": "Timezone Conversion"
}
