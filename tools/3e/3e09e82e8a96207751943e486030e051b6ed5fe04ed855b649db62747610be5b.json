 "description": "Use this when the user pays, or plans to pay, an employee in local currency and asks about exchange-rate risk or a USD budget (e.g. \"what if the real moves 10%\", \"risque de change sur un salaire en pesos\"). Returns the USD cost (gross salary plus statutory employer charges, before any Employer of Record fee) at the official exchange rate of the data snapshot, with its date and source, and if the local currency moves by 5, 10 or 20 percent either way; with a USD budget, the headroom in each case and the move at which the budget is reached. Do not use for currency conversion alone. Data snapshot 2026-10-13. Cost comparison, not legal or tax advice.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assumptions": {
    "additionalProperties": {
     "type": "number"
    },
    "description": "Override an adjustable assumption the country declares, e.g. {\"basic_share_of_gross\": 0.6}. See `assumptions` in an employer_cost answer.",
    "type": "object"
   },
   "budget_usd": {
    "description": "Annual budget in USD for salary plus employer charges, if the user has one",
    "exclusiveMinimum": 0,
    "maximum": 1000000000000,
    "type": "number"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 code (\"DE\") or country name (\"Germany\")",
    "maxLength": 60,
    "minLength": 2,
    "type": "string"
   },
   "payments_per_year": {
    "description": "With salary_period \"month\" only: the total number of monthly salaries the contract pays in a year, statutory ones included (e.g. 14). Omit to use the statutory number of the country.",
    "maximum": 16,
    "minimum": 12,
    "type": "number"
   },
   "salary_local": {
    "description": "Gross salary in the local currency of the country, a year unless salary_period is \"month\"",
    "exclusiveMinimum": 0,
    "maximum": 10000000000000,
    "type": "number"
   },
   "salary_period": {
    "default": "year",
    "description": "Whether the salary is a year (default) or a month. Pass a monthly salary as the user gives it, with \"month\": the statutory number of monthly payments of the country (13th, 14th month) is applied, see salary_basis in the answer.",
    "enum": [
     "year",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "country",
   "salary_local"
  ],
  "type": "object"
 },
