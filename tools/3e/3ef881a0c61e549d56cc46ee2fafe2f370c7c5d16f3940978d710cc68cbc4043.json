{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Fetch the current text of an official Swiss page (live, respecting robots.txt) and return the\npassages around `focus`. Only official Swiss domains are allowed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "focus": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Words to focus on, e.g. 'd\u00e9lai 12 mois'."
   },
   "max_chars": {
    "default": 3000,
    "maximum": 8000,
    "minimum": 500,
    "type": "integer"
   },
   "url": {
    "description": "URL on an official Swiss domain (admin.ch, ch.ch, a cantonal or municipal site), typically from search_official_info.",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "read_official_page",
 "outputSchema": {
  "properties": {
   "citations": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "data": {
    "type": "object"
   },
   "guidance": {
    "type": "string"
   },
   "missing_context": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
     "ok",
     "needs_context",
     "not_covered",
     "not_found",
     "source_error"
    ]
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "status",
   "summary"
  ],
  "type": "object"
 },
 "title": "Read an official page"
}
