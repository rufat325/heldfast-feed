      },
      "httpOnly": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "sameSite": {
       "type": "string"
      },
      "secure": {
       "type": "boolean"
      },
      "value": {
       "const": "[REDACTED]"
      }
     },
     "required": [
      "name",
      "value",
      "secure",
      "httpOnly",
      "sameSite",
      "hasDomain",
      "findings"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "type": "string"
   }
  },
  "required": [
