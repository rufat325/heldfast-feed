{
 "description": "Segments a clip on a track using cached analysis results (run analyze first). Splits the clip into musically-aligned regions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clip": {
    "description": "Playlist item id (default: the track's clip)",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "crossfades": {
    "description": "Apply crossfades at joints (default true)",
    "type": "boolean"
   },
   "duration_seconds": {
    "description": "Target duration",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "measures": {
    "description": "Segment length in measures",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "project": {
    "description": "Path to the .audium project package (absolute paths recommended)",
    "type": "string"
   },
   "segments": {
    "description": "Number of segments",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "track": {
    "description": "Track id (default 0; imported audio lands on a new track)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "project"
  ],
  "type": "object"
 },
 "name": "auto_edit",
 "title": "Auto-edit clip"
}
