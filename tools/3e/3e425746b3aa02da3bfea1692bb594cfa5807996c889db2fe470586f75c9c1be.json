{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "owner",
     "offline_access"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Set up a business (guided)"
 },
 "description": "Only for business owners signed in to Awning. Guided onboarding run by Awning. Convert the owner's natural-language description, prices and hours into structured answers, including separate hour ranges for breaks. Do not invent missing details; ask to clarify ambiguous days, times or timezone. Keep draft_id; an owner can set up several businesses, each with its own draft_id. For another business pass new_business: true; for another location of an existing business pass copy_from_business_id and ask only what differs. The response contains what was accepted, what is missing, and open_questions: ask them together in one message rather than one at a time, and send the whole reply back in a single call. Repeat until ready_to_submit, then owner_preview and explicit approval before owner_submit. Use owner_photos to save images; the page layout and image sizing are handled by Awning.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "answers": {
    "properties": {
     "category": {
      "description": "Category code from needs_confirmation options, or a few words like 'hair salon'",
      "maxLength": 120,
      "type": "string"
     },
     "city": {
      "maxLength": 80,
      "type": "string"
     },
     "contact": {
      "properties": {
       "channel": {
        "enum": [
         "email",
         "telegram"
        ],
        "type": "string"
       },
       "instagram": {
        "maxLength": 200,
        "type": "string"
       },
       "phone": {
        "maxLength": 200,
        "type": "string"
       },
       "public_email": {
        "maxLength": 200,
        "type": "string"
       },
       "website": {
        "maxLength": 200,
        "type": "string"
       },
       "whatsapp": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "type": "object"
     },
     "country": {
      "description": "ISO 3166-1 alpha-2",
      "maxLength": 60,
      "type": "string"
     },
     "currency": {
      "description": "ISO 4217; derived from country when omitted",
      "maxLength": 10,
      "type": "string"
     },
     "description": {
      "maxLength": 1000,
      "type": "string"
     },
     "hours": {
      "items": {
       "properties": {
        "close": {
         "description": "HH:MM",
         "maxLength": 20,
         "type": "string"
        },
        "days": {
         "anyOf": [
          {
           "maxLength": 100,
           "type": "string"
          },
          {
           "items": {
            "maxLength": 20,
            "type": "string"
           },
           "maxItems": 14,
           "type": "array"
          }
         ],
         "description": "e.g. \"mon-sat\", \"daily\", [\"tue\",\"thu\"]"
        },
        "open": {
         "description": "HH:MM",
         "maxLength": 20,
         "type": "string"
        }
       },
       "required": [
        "days",
        "open",
        "close"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "languages": {
      "items": {
       "maxLength": 35,
       "type": "string"
      },
      "maxItems": 20,
      "type": "array"
     },
     "location": {
      "properties": {
       "address": {
        "maxLength": 200,
        "type": "string"
       },
       "lat": {
        "type": "number"
       },
       "lng": {
        "type": "number"
       },
       "mode": {
        "enum": [
         "fixed",
         "mobile",
         "online"
        ],
        "type": "string"
       },
       "radius_km": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "name": {
      "maxLength": 120,
      "type": "string"
     },
     "offerings": {
      "items": {
       "properties": {
        "capacity": {
         "description": "Classes: people per class",
         "type": "number"
        },
        "deposit": {
         "type": "number"
        },
        "description": {
         "maxLength": 600,
         "type": "string"
        },
        "duration_min": {
         "type": "number"
        },
        "name": {
         "maxLength": 120,
         "type": "string"
        },
        "options": {
         "items": {
          "properties": {
           "extra_min": {
            "type": "number"
           },
           "name": {
            "maxLength": 200,
            "type": "string"
           },
           "per_day": {
            "type": "boolean"
           },
           "price": {
            "type": "number"
           }
          },
          "required": [
           "name"
          ],
          "type": "object"
         },
         "maxItems": 50,
         "type": "array"
        },
        "price": {
         "description": "In major units of the business currency, e.g. 2500",
         "type": "number"
        },
        "price_from": {
         "description": "Price is 'from'",
         "type": "boolean"
        },
        "price_unit": {
         "enum": [
          "booking",
          "person",
          "hour",
          "day",
          "night",
          "week",
          "month"
         ],
         "type": "string"
        },
        "quote_only": {
         "type": "boolean"
        },
        "schedule": {
         "description": "Classes: when they run",
         "items": {
          "properties": {
           "days": {
            "anyOf": [
             {
              "maxLength": 100,
              "type": "string"
             },
             {
              "items": {
               "maxLength": 20,
               "type": "string"
              },
              "maxItems": 14,
              "type": "array"
             }
            ],
            "description": "e.g. \"mon-sat\", \"daily\", [\"tue\",\"thu\"]"
           },
           "time": {
            "maxLength": 20,
            "type": "string"
           }
          },
          "required": [
           "days",
           "time"
          ],
          "type": "object"
         },
         "maxItems": 50,
         "type": "array"
        },
        "units": {
         "description": "Rentals: how many identical items",
         "type": "number"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "photos_done": {
      "type": "boolean"
     },
     "policies": {
      "properties": {
       "auto_confirm": {
        "type": "boolean"
       },
       "free_cancel_hours": {
        "type": "number"
       },
       "late_fee_pct": {
        "type": "number"
       },
       "min_advance_hours": {
        "type": "number"
       }
      },
      "type": "object"
     },
     "skip": {
      "items": {
       "enum": [
        "staff",
        "policies",
        "photos"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "staff": {
      "items": {
       "properties": {
        "hours": {
         "items": {
          "properties": {
           "close": {
            "description": "HH:MM",
            "maxLength": 20,
            "type": "string"
           },
           "days": {
            "anyOf": [
             {
              "maxLength": 100,
              "type": "string"
             },
             {
              "items": {
               "maxLength": 20,
               "type": "string"
              },
              "maxItems": 14,
              "type": "array"
             }
            ],
            "description": "e.g. \"mon-sat\", \"daily\", [\"tue\",\"thu\"]"
           },
           "open": {
            "description": "HH:MM",
            "maxLength": 20,
            "type": "string"
           }
          },
          "required": [
           "days",
           "open",
           "close"
          ],
          "type": "object"
         },
         "maxItems": 100,
         "type": "array"
        },
        "name": {
         "maxLength": 200,
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "timezone": {
      "description": "IANA, required in countries with several time zones",
      "maxLength": 64,
      "type": "string"
     }
    },
    "type": "object"
   },
   "copy_from_business_id": {
    "description": "Start a branch: copy services, prices, hours, staff and rules from a business this owner runs",
    "type": "string"
   },
   "draft_id": {
    "type": "string"
   },
   "new_business": {
    "description": "Start another business even if one is still being set up",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "owner_setup",
 "title": "Set up a business (guided)"
}
