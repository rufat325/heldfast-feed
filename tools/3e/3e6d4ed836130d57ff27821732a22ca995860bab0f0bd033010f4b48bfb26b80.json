{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get papers similar to a given paper using Semantic Scholar's recommendation engine. Pass a paperId from a semanticscholar search result. Returns up to 500 similar papers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Semantic Scholar paperId",
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 500,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "library_recommend",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "authors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "cluster": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "downloadUrl": {
       "type": "string"
      },
      "hasFullText": {
       "type": "boolean"
      },
      "id": {
       "type": "string"
      },
      "language": {
       "type": "string"
      },
      "previewUrl": {
       "type": "string"
      },
      "published": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "subjects": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      },
      "year": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "source",
      "title",
      "hasFullText"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Get Similar Papers (Semantic Scholar)"
}
