{
 "description": "Update the result of an existing Open Label annotation. Pass expectedVersion (from a prior read) for optimistic concurrency \u2014 a stale version returns a 409 conflict with the live version. Requires open-label:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "annotationId": {
    "description": "The annotation id.",
    "type": "string"
   },
   "expectedVersion": {
    "description": "Optimistic-concurrency guard (annotation.version from a prior read).",
    "type": "integer"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "result": {
    "description": "Replacement editor result entries.",
    "items": {
     "additionalProperties": {},
     "type": "object"
    },
    "type": "array"
   },
   "taskId": {
    "description": "The task id.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "taskId",
   "annotationId",
   "result"
  ],
  "type": "object"
 },
 "name": "open_label_update_annotation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
