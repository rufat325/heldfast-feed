{
 "description": "Forward ENS resolution \u2014 resolve a .eth name to its address (who do I pay?).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "chain": {
    "description": "Chain: base, ethereum, polygon, arbitrum, optimism, bsc",
    "maxLength": 16,
    "minLength": 1,
    "type": "string"
   },
   "ens_name": {
    "description": "ENS name, e.g. vitalik.eth",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "chain",
   "ens_name"
  ],
  "type": "object"
 },
 "name": "ens_resolve"
}
