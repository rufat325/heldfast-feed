{
 "description": "Prep a game texture (terrain / props): optional 50% wrap + seam blend, then a faithful lanczos upscale (1\u00d7 / 2\u00d7 / 4\u00d7, capped at 1024 or 2048). The pattern is PRESERVED \u2014 nothing is generated. Pass a local path or a Library texture_id. Writes the PNG into out_dir and returns the Library albedo URL. No credit consumed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "name": {
    "description": "Library / file name stem",
    "type": "string"
   },
   "out_dir": {
    "description": "Write the prepped PNG here (default: ./gripforge-library)",
    "type": "string"
   },
   "path": {
    "description": "Absolute path to a PNG/JPG/WebP",
    "type": "string"
   },
   "save": {
    "description": "Save to Library (default true)",
    "type": "boolean"
   },
   "scale": {
    "description": "Upscale factor (default 1)",
    "enum": [
     1,
     2,
     4
    ],
    "type": "number"
   },
   "seamless": {
    "description": "50% offset + seam blend (default true)",
    "type": "boolean"
   },
   "size": {
    "description": "Max output side (default 1024)",
    "enum": [
     1024,
     2048
    ],
    "type": "number"
   },
   "texture_id": {
    "description": "Library id of a texture (lib_\u2026)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "gripforge_texture_prep"
}
