 },
 "description": "Use when an agent needs the full detail of a single market by its composite key (source + market_id). Returns the market with its parent event reference, current probability, volume, 24h delta, and historical chart points. Includes a `_meta.cite_as` field that the agent can drop directly into its reply.",
 "inputSchema": {
  "properties": {
   "market_id": {
    "description": "Market ID native to the source. Composite key with `source`.",
    "title": "Market Id",
    "type": "string"
   },
   "source": {
    "description": "Platform ID: polymarket / kalshi / manifold / myriad / limitless / predict / opinion / gemini.",
    "title": "Source",
    "type": "string"
   }
  },
  "required": [
   "source",
   "market_id"
  ],
  "type": "object"
 },
 "name": "get_market",
 "outputSchema": {
  "description": "Single-market response: extends MarketOut with `_meta` (agent\nmetadata + cite_as).\n\nKept as a separate wrapper rather than putting `_meta` on MarketOut\nitself so list responses (Page[MarketOut]) don't carry `_meta` on\nevery item \u2014 that would inflate response size O(N) for no agent\nbenefit. The list envelope already carries `_meta` once. Parallels\nEventDetailOut(EventOut).",
  "properties": {
   "_meta": {
    "anyOf": [
     {
      "description": "Agent metadata for single-resource responses (with cite_as).",
