       "as_of": {
        "format": "date-time",
        "title": "As Of",
        "type": "string"
       },
       "attribution": {
        "default": "pdata.world \u2014 aggregated prediction-market data across 8 platforms",
        "title": "Attribution",
        "type": "string"
       },
       "canonical_url": {
        "title": "Canonical Url",
        "type": "string"
       },
       "cite_as": {
        "title": "Cite As",
        "type": "string"
       },
       "docs": {
        "default": "https://api.pdata.world/docs",
        "title": "Docs",
        "type": "string"
       },
       "source_url": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ],
        "title": "Source Url"
       }
      },
      "required": [
       "canonical_url",
       "cite_as"
      ],
      "title": "ResponseMetaResource",
      "type": "object"
     },
     {
      "type": "null"
