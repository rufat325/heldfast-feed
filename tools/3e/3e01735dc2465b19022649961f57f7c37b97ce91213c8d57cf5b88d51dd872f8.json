{
 "description": "Search structured products using exact SKU or GTIN, supplier, material, dimensions, MOQ, price, inventory, lead time and qualification filters. Defaults to sandbox; use environment=production for approved supplier storefront listings.",
 "inputSchema": {
  "properties": {
   "category": {
    "type": "string"
   },
   "currency": {
    "type": "string"
   },
   "cursor": {
    "type": "string"
   },
   "environment": {
    "enum": [
     "sandbox",
     "production"
    ],
    "type": "string"
   },
   "gtin": {
    "type": "string"
   },
   "inventoryStatus": {
    "enum": [
     "confirmed",
     "unknown"
    ],
    "type": "string"
   },
   "limit": {
    "type": "integer"
   },
   "material": {
    "type": "string"
   },
   "maxLeadTimeDays": {
    "type": "integer"
   },
   "maxMoq": {
    "type": "integer"
   },
   "maxPrice": {
    "type": "number"
   },
   "minInventory": {
    "type": "integer"
   },
   "minMoq": {
    "type": "integer"
   },
   "minPrice": {
    "type": "number"
   },
   "q": {
    "type": "string"
   },
   "qualificationStatus": {
    "type": "string"
   },
   "size": {
    "type": "string"
   },
   "sku": {
    "type": "string"
   },
   "supplierId": {
    "type": "string"
   },
   "supplierSlug": {
    "type": "string"
   },
   "verifiedOnly": {
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "search_products"
}
