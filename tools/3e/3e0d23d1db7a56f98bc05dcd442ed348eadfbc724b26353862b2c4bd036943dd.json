{
 "_meta": {
  "openai/toolInvocation/invoked": "Ranked listings",
  "openai/toolInvocation/invoking": "Ranking listings\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "The most-starred listings of a kind (public GitHub stars), or the fastest-growing since launch (stars per day since the repository was created). Optional category. Stars measure attention, not quality.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "by": {
    "default": "stars",
    "enum": [
     "stars",
     "pace"
    ],
    "type": "string"
   },
   "category": {
    "maxLength": 80,
    "type": "string"
   },
   "kind": {
    "enum": [
     "server",
     "client",
     "product",
     "skill",
     "plugin",
     "rules",
     "eval"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "kind"
  ],
  "type": "object"
 },
 "name": "top_listings",
 "title": "Leaderboard"
}
