{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Drafts an llms.txt from the site's own public pages. Use this when the owner wants a draft AI instructions file to review. Pass the domain. Returns markdown for the owner to edit and publish themselves. Nothing is written to the site. A public post is cited as the reason the draft exists. It does not promise an effect on AI Overviews and does not query AI engines. Do not use it for private addresses or to collect contact details.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "domain": {
    "description": "A public website, for example example.com or https://example.com. Only that site's public pages are read.",
    "maxLength": 2048,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "generate_ai_instructions",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "description": "UTC date the pages were read, YYYY-MM-DD.",
    "type": "string"
   },
   "domain": {
    "type": "string"
   },
   "draft": {
    "description": "Markdown llms.txt for the owner to review. Not published.",
    "type": "string"
   },
   "effect": {
    "additionalProperties": false,
    "properties": {
     "note": {
      "type": "string"
     },
     "promised": {
      "type": "boolean"
     }
    },
    "required": [
     "promised",
     "note"
    ],
    "type": "object"
   },
   "existingFile": {
    "type": "boolean"
   },
   "finalUrl": {
    "type": "string"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "products": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "reachable": {
    "type": "boolean"
   },
   "reason": {
    "additionalProperties": false,
    "properties": {
     "asOf": {
      "description": "Date of the cited post, YYYY-MM-DD.",
      "type": "string"
     },
     "note": {
      "type": "string"
     },
     "post": {
      "type": "string"
     }
    },
    "required": [
     "post",
     "asOf",
     "note"
    ],
    "type": "object"
   },
   "refused": {
    "type": "string"
   },
   "review": {
    "additionalProperties": false,
    "properties": {
     "note": {
      "type": "string"
     },
     "published": {
      "type": "boolean"
     }
    },
    "required": [
     "published",
     "note"
    ],
    "type": "object"
   },
   "source": {
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "pagesRead": {
      "type": "integer"
     },
     "requests": {
      "type": "integer"
     }
    },
    "required": [
     "pagesRead",
     "requests"
    ],
    "type": "object"
   }
  },
  "required": [
   "domain",
   "reachable",
   "draft",
   "review",
   "pages",
   "products",
   "existingFile",
   "summary",
   "source",
   "asOf",
   "reason",
   "effect",
   "notes",
   "notice"
  ],
  "type": "object"
 },
 "title": "Draft an llms.txt"
}
