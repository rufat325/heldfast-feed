{
 "annotations": {
  "title": "Equip item"
 },
 "description": "Equip an item from inventory to a destination slot. `hand`/`off-hand` hold it; `head`/`torso`/`legs`/`feet` wear armor.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "destination": {
    "description": "Equipment slot",
    "enum": [
     "hand",
     "head",
     "torso",
     "legs",
     "feet",
     "off-hand"
    ],
    "type": "string"
   },
   "item": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    ],
    "description": "Item name (e.g. \"diamond_pickaxe\") or numeric item id"
   }
  },
  "required": [
   "item",
   "destination"
  ],
  "type": "object"
 },
 "name": "equip_item"
}
