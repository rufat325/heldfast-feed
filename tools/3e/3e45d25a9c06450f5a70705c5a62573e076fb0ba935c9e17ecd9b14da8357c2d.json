{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List tasks, optionally filtered by status, priority, project, or top3 flag.",
 "inputSchema": {
  "properties": {
   "include_archived": {
    "description": "Include archived tasks (default: false)",
    "type": "boolean"
   },
   "is_top3": {
    "description": "Only show Top 3 focus tasks",
    "type": "boolean"
   },
   "priority": {
    "description": "Filter by priority: 1=high, 2=medium, 3=low",
    "enum": [
     1,
     2,
     3
    ],
    "type": "integer"
   },
   "project_id": {
    "description": "Filter by project ID",
    "type": "integer"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "pending",
     "in_progress",
     "completed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_tasks",
 "title": "List tasks"
}
