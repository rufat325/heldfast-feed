        "backorder",
        "preorder",
        "out_of_stock",
        "unavailable",
        "unknown"
       ]
      },
      "brand": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "id": {
           "maximum": 2147483647,
           "minimum": 1,
           "type": "integer"
          },
          "name": {
           "maxLength": 300,
           "type": "string"
          },
          "url": {
           "anyOf": [
            {
             "format": "uri",
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "id",
          "name",
          "url"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "characteristics": {
       "items": {
        "additionalProperties": false,
