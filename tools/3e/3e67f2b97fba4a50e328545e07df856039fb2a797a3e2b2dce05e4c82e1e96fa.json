{
 "_meta": {
  "ui": {
   "resourceUri": "ui://vesremont/catalog"
  },
  "vesremont.com/auth": {
   "resource": "https://vesremont.com/mcp",
   "scope": "",
   "scopes": []
  },
  "vesremont.com/user-confirmation": false
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find or browse current catalog products by name, model or SKU; returns a bounded page with an exact total. Get contextual filter IDs from get_catalog_filters and brand IDs from search_brands; do not guess IDs. Read a selected result with get_product; narrow overly broad queries. Public; no OAuth required. Read-only.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "brand_id": {
    "description": "Restrict to this brand ID returned by search_brands or product data, not its display name.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "cursor": {
    "description": "Opaque next_cursor from the previous response. Keep the same filters/sort; do not combine with page. Expires after 15 minutes. Existing backend windows apply; not a frozen snapshot.",
    "maxLength": 765,
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "description": "Storefront catalog filters. Combine with the current section/brand context; REST encodes this object as one JSON query value.",
    "properties": {
     "charats_id": {
      "description": "Selected characteristic value IDs from contextual catalog filters. Do not invent IDs.",
      "items": {
       "description": "Selected characteristic value ID from get_catalog_filters, not the characteristic group ID.",
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 20,
      "type": "array",
      "uniqueItems": true
     },
     "price": {
      "additionalProperties": false,
      "description": "Catalog unit-price bounds in RUB, not basket totals or delivery charges. Supply at least one bound.",
      "minProperties": 1,
      "properties": {
       "max": {
        "description": "Maximum catalog unit price in RUB. If supplied, it must be greater than zero and not below min.",
        "maximum": 9999999999.99,
        "minimum": 0,
        "multipleOf": 0.01,
        "type": "number"
       },
       "min": {
        "description": "Minimum catalog unit price in RUB. Omit for no lower price restriction.",
        "maximum": 9999999999.99,
        "minimum": 0,
        "multipleOf": 0.01,
        "type": "number"
       }
      },
      "required": [],
      "type": "object"
     },
     "range_id": {
      "additionalProperties": {
       "additionalProperties": false,
       "description": "Both bounds for one real numeric characteristic; use its returned range ID as the map key.",
       "properties": {
        "max": {
         "description": "Upper bound in the same characteristic units as min. Must not be below min.",
         "maximum": 9999999999.99,
         "minimum": 0,
         "multipleOf": 0.01,
         "type": "number"
        },
        "min": {
         "description": "Lower bound in the characteristic units returned by get_catalog_filters. Must not exceed max.",
         "maximum": 9999999999.99,
         "minimum": 0,
         "multipleOf": 0.01,
         "type": "number"
        }
       },
       "required": [
        "min",
        "max"
       ],
       "type": "object"
      },
      "description": "Map of numeric characteristic range IDs to min/max bounds. Use the numeric part of returned range:<id>; price uses price, not range ID 1.",
      "maxProperties": 20,
      "propertyNames": {
       "pattern": "^(?:[2-9]|[1-9][0-9]{1,9})$"
      },
      "type": "object"
     },
     "section_ids": {
      "description": "Match any of these catalog sections (OR). Use real section IDs; do not combine with section_id.",
      "items": {
       "description": "One real catalog section ID, not a product or characteristic ID.",
       "maximum": 2147483647,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 20,
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
     }
    },
    "required": [],
    "type": "object"
   },
   "page": {
    "description": "One-based result page, default 1. Do not combine with cursor; the existing offset window still applies.",
    "maximum": 100001,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "description": "Maximum results per page, default 20. Keep the same value when following next_cursor.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "Storefront text search query. Omit to browse the catalog with the supplied section, brand and filters.",
    "maxLength": 200,
    "type": "string"
   },
   "section_id": {
    "description": "Restrict to this real catalog section. Do not combine with filters.section_ids.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "description": "Catalog order: id_sort is the default ID order; price_min sorts cheapest first, price_max most expensive first.",
    "enum": [
     "id_sort",
     "price_min",
     "price_max"
    ]
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "items": {
