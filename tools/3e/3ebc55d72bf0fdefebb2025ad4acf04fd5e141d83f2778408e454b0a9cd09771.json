 "description": "Audit a published rate limit ladder for internal sense. Divides every tier down to requests per second so tiers with different windows can be compared, then reports a ladder that is not monotonic \u2014 a buyer paying more and getting less throughput \u2014 a burst larger than the window limit that can never be spent, a burst that shrinks as the tier rises, and an endpoint whose declared cost exceeds what the lowest tier permits in a whole window, so that subscriber cannot call it once. Pay 200000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "endpoints": {
    "description": "Endpoints with a declared cost in the same units as the tier limits, compared against the lowest tier.",
    "example": [
     {
      "cost": 1,
      "path": "/v1/search"
     },
     {
      "cost": 2500,
      "path": "/v1/bulk-export"
     }
    ],
    "items": {
     "properties": {
      "cost": {
       "minimum": 0,
       "type": "integer"
      },
      "path": {
       "maxLength": 300,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 200,
    "minItems": 0,
    "type": "array"
   },
   "tiers": {
    "description": "The tiers, cheapest first, as a published table lists them. Nothing is fetched and nothing is executed, so an arbitrary configuration can be audited without access to the system it governs.",
    "example": [
     {
      "burst": 2000,
      "limit": 1000,
      "name": "free",
      "window_seconds": 3600
     },
     {
      "limit": 10000,
      "name": "starter",
      "window_seconds": 86400
     },
     {
      "burst": 500,
      "limit": 100000,
      "name": "growth",
      "window_seconds": 86400
     }
    ],
    "items": {
     "properties": {
      "burst": {
       "minimum": 0,
       "type": "integer"
      },
      "limit": {
       "minimum": 0,
       "type": "integer"
      },
      "name": {
       "maxLength": 120,
       "type": "string"
      },
      "window_seconds": {
       "minimum": 1,
       "type": "integer"
      }
     },
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "tiers"
  ],
  "type": "object"
 },
