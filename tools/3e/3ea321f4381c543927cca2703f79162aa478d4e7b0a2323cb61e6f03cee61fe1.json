{
 "annotations": {},
 "description": "Copy an object within the same bucket or between different buckets in Object Storage",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketName": {
    "description": "Destination bucket name",
    "type": "string"
   },
   "copySource": {
    "description": "Source object in the format /{sourceBucket}/{sourceKey}",
    "type": "string"
   },
   "objectName": {
    "description": "Destination object key (path)",
    "type": "string"
   }
  },
  "required": [
   "bucketName",
   "objectName",
   "copySource"
  ],
  "type": "object"
 },
 "name": "ncloud_copy_object"
}
