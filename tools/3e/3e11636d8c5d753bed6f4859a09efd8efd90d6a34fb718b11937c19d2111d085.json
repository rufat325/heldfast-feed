{
 "description": "Search the WordPress.org plugin repository. Returns { total, plugins: [{ name, slug, version, author, rating, active_installs, description }] }.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "per_page": {
    "default": 10,
    "description": "Results per page (default 10)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "search": {
    "description": "Search query",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "search"
  ],
  "type": "object"
 },
 "name": "mcp_search_plugins"
}
