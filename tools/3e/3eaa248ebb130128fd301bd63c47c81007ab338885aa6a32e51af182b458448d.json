{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create Custom Field"
 },
 "description": "Create a custom field definition for CRM entities. Use options for select or multiselect fields.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "entityType": {
    "description": "Entity type, e.g. account, contact, deal, booking",
    "enum": [
     "account",
     "contact",
     "deal",
     "booking",
     "ticket",
     "product",
     "post"
    ],
    "type": "string"
   },
   "fieldLabel": {
    "description": "Human-readable label, e.g. Preferred branch",
    "minLength": 1,
    "type": "string"
   },
   "fieldName": {
    "description": "Stable machine name, e.g. preferred_branch",
    "minLength": 1,
    "type": "string"
   },
   "fieldType": {
    "description": "Field type",
    "enum": [
     "text",
     "number",
     "date",
     "select",
     "multiselect",
     "boolean",
     "url",
     "email",
     "phone"
    ],
    "type": "string"
   },
   "isRequired": {
    "description": "Whether this field is required",
    "type": "boolean"
   },
   "options": {
    "description": "Allowed values for select/multiselect fields",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sortOrder": {
    "description": "Display order",
    "type": "number"
   }
  },
  "required": [
   "entityType",
   "fieldName",
   "fieldLabel",
   "fieldType"
  ],
  "type": "object"
 },
 "name": "create_custom_field",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
