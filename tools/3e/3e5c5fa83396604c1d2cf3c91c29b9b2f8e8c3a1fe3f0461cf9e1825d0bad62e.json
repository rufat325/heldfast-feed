{
 "description": "Generate components from shadcn, radix, headlessui, or material UI libraries. Supports themes, custom props, test/story generation, and framework-specific output.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "componentType": {
    "description": "Type of component to generate (e.g., button, card, input)",
    "type": "string"
   },
   "customizations": {
    "additionalProperties": {},
    "description": "Custom component properties and styling",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "framework": {
    "description": "Target framework",
    "enum": [
     "react",
     "nextjs",
     "vue",
     "svelte",
     "angular",
     "html"
    ],
    "type": "string"
   },
   "includeStories": {
    "default": true,
    "description": "Generate Storybook stories",
    "type": "boolean"
   },
   "includeTests": {
    "default": true,
    "description": "Generate test files",
    "type": "boolean"
   },
   "library": {
    "description": "Component library to use",
    "enum": [
     "shadcn",
     "radix",
     "headlessui",
     "material",
     "primevue",
     "none"
    ],
    "type": "string"
   },
   "outputPath": {
    "description": "Output directory for generated files",
    "type": "string"
   },
   "theme": {
    "description": "Theme configuration",
    "type": "string"
   }
  },
  "required": [
   "componentType",
   "library",
   "framework"
  ],
  "type": "object"
 },
 "name": "generate_component_library"
}
