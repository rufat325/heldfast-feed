{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search and paginate across the account's saved items, standalone notes, and highlights through one corpus. Uses the same Postgres matching as the app and REST API; approximate=true identifies spelling recovery. Returns stable refs for get_library_object. Use list_library when you specifically need item lifecycle filters or reading history.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque page token: pass the previous response's nextCursor verbatim and never construct one.",
    "maxLength": 1000,
    "type": "string"
   },
   "limit": {
    "description": "Maximum objects to return in this page, from 1 to 100. Defaults to 50.",
    "maximum": 100,
    "minimum": 1,
    "multipleOf": 1,
    "type": "number"
   },
   "query": {
    "description": "Full-text search across saved items, notes, and highlights; omit to list the whole corpus.",
    "maxLength": 500,
    "type": "string"
   },
   "types": {
    "items": {
     "anyOf": [
      {
       "const": "item",
       "type": "string"
      },
      {
       "const": "note",
       "type": "string"
      },
      {
       "const": "highlight",
       "type": "string"
      }
     ]
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "list_library_objects",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "approximate": {
    "type": "boolean"
   },
   "matchedTerms": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "nextCursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "objects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "hasAsset": {
       "type": "boolean"
      },
      "mimeType": {
       "type": [
        "string",
        "null"
       ]
      },
      "ref": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      },
      "sourceUrl": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": "string"
      },
      "type": {
       "enum": [
        "item",
        "note",
        "highlight"
       ],
       "type": "string"
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "ref",
      "type",
      "title",
      "snippet",
      "sourceUrl",
      "updatedAt",
      "mimeType",
      "hasAsset",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "partial": {
    "type": "boolean"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "objects",
   "nextCursor",
   "total",
   "partial"
  ],
  "type": "object"
 },
 "title": "Search every saved library object"
}
