{
 "description": "The cheapest weekends from one origin across every destination that has a calendar under these filters, sorted by price. Optional month filter (yyyy-mm). Takes the same filters as weekend_prices. This tool reads what is already priced; it does not search every destination. A destination that is absent can be priced with one weekend_prices call for that pair. Pro only: this tool is Anywhere (every destination from one origin). Without Pro it answers pro_required with the Anywhere page url. One route at a time is free with weekend_prices.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "description": "Default 1.",
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "cabin": {
    "description": "Default \"economy\".",
    "enum": [
     "economy",
     "premium-economy",
     "business",
     "first"
    ],
    "type": "string"
   },
   "children": {
    "description": "Default 0.",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "combo": {
    "description": "Weekend shape. Default \"fri-sun\".",
    "enum": [
     "thu-sun",
     "thu-mon",
     "thu-sat",
     "fri-sun",
     "fri-mon",
     "fri-sat",
     "sat-mon",
     "sat-sun",
     "sat-sat"
    ],
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code. Default: the native currency of the origin.",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "infants": {
    "description": "Default 0.",
    "maximum": 9,
    "minimum": 0,
    "type": "integer"
   },
   "limit": {
    "description": "How many weekends to return. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "month": {
    "description": "Limit to one month, format yyyy-mm.",
    "pattern": "^\\d{4}-\\d{2}$",
    "type": "string"
   },
   "origin": {
    "description": "Departure airport IATA code, e.g. \"ZRH\".",
    "maxLength": 3,
    "minLength": 3,
    "type": "string"
   },
   "out_from": {
    "description": "Earliest outbound departure, \"HH:MM\".",
    "pattern": "^\\d{1,2}:\\d{2}$",
    "type": "string"
   },
   "out_to": {
    "description": "Latest outbound departure, \"HH:MM\".",
    "pattern": "^\\d{1,2}:\\d{2}$",
    "type": "string"
   },
   "ret_from": {
    "description": "Earliest return departure, \"HH:MM\".",
    "pattern": "^\\d{1,2}:\\d{2}$",
    "type": "string"
   },
   "ret_to": {
    "description": "Latest return departure, \"HH:MM\".",
    "pattern": "^\\d{1,2}:\\d{2}$",
    "type": "string"
   },
   "stops": {
    "description": "\"any\" (default) or \"nonstop\".",
    "enum": [
     "any",
     "nonstop"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin"
  ],
  "type": "object"
 },
 "name": "cheapest_weekends",
 "title": "Cheapest cached weekends from one origin"
}
