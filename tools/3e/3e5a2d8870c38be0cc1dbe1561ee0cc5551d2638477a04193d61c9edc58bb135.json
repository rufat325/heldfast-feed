{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Add tasks to an epic, in order, at the bottom of the backlog (or icebox). Use when scope grows mid-run or to finish a partial record_plan.",
 "inputSchema": {
  "properties": {
   "destination": {
    "enum": [
     "backlog",
     "icebox"
    ],
    "type": "string"
   },
   "epicId": {
    "type": "string"
   },
   "tasks": {
    "items": {
     "properties": {
      "acceptanceCriteria": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": {
       "description": "Markdown",
       "type": "string"
      },
      "points": {
       "type": "number"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "type": {
       "enum": [
        "feature",
        "bug",
        "chore"
       ],
       "type": "string"
      }
     },
     "required": [
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "epicId",
   "tasks"
  ],
  "type": "object"
 },
 "name": "create_tasks"
}
