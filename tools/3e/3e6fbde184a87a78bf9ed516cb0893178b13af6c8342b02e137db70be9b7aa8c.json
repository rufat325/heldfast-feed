{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Folds accepted mapping decisions (or manual values) into a PassportDraft. Idempotent: the same decision twice is a no-op; a different value for an attribute that already has one is reported as a conflict and not applied unless override is true. Pass meta instead of draft to start a new draft.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "draft": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "draftId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "draftId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": {},
      "properties": {
       "meta": {}
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ],
    "description": "The draft to extend. Omit and pass meta to start a new one"
   },
   "lang": {
    "description": "Language of the text summary (default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "mappings": {
    "description": "Accepted proposals from suggest_mappings, or manual values",
    "items": {
     "additionalProperties": {},
     "properties": {
      "attributeId": {
       "minLength": 1,
       "type": "string"
      },
      "confidence": {
       "type": "number"
      },
      "override": {
       "description": "Replace an existing different value instead of flagging a conflict",
       "type": "boolean"
      },
      "path": {
       "description": "Composite leaf path, e.g. \"name.de\"",
       "type": "string"
      },
      "source": {
       "items": {
        "additionalProperties": {},
        "properties": {
         "file": {
          "type": "string"
         }
        },
        "required": [
         "file"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "unit": {
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "attributeId",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "meta": {
    "description": "Starts a new draft. Exactly one of draft or meta",
    "properties": {
     "category": {
      "enum": [
       "EV",
       "LMT",
       "INDUSTRIAL_GT_2KWH"
      ],
      "type": "string"
     },
     "createdAt": {
      "description": "ISO date-time; default: the server clock",
      "type": "string"
     },
     "passportId": {
      "description": "The battery passport identifier, a URI (URL or URN)",
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "category",
     "passportId"
    ],
    "type": "object"
   }
  },
  "required": [
   "mappings"
  ],
  "type": "object"
 },
 "name": "apply_mappings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "applied": {
    "type": "number"
   },
   "conflicts": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "attributeId": {
       "type": "string"
      }
     },
     "required": [
      "attributeId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "draft": {
    "additionalProperties": {},
    "properties": {
     "meta": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     }
    },
    "required": [
     "meta"
    ],
    "type": "object"
   },
   "draftId": {
    "type": "string"
   },
   "error": {
    "description": "Set when the call failed",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Apply mapping decisions"
}
