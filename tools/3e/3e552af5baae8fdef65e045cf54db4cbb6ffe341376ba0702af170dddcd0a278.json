{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "The signed-in student's submission for one ELMS (Canvas) assignment: status, score, grade and any instructor comments. Requires login.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assignment_id": {
    "description": "Canvas assignment id, from elms_list_assignments",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "course_id": {
    "description": "Canvas course id, from elms_list_courses",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "course_id",
   "assignment_id"
  ],
  "type": "object"
 },
 "name": "elms_get_submission",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "attempt": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "comments": {
    "description": "Instructor and student comments, when requested",
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "comment": {
       "type": "string"
      },
      "created_at": {
       "description": "ISO 8601 timestamp (UTC); null when unset",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "author",
      "comment",
      "created_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "excused": {
    "type": "boolean"
   },
   "grade": {
    "type": [
     "string",
     "null"
    ]
   },
   "graded_at": {
    "description": "ISO 8601 timestamp (UTC); null when unset",
    "type": [
     "string",
     "null"
    ]
   },
   "late": {
    "type": "boolean"
   },
   "missing": {
    "type": "boolean"
   },
   "score": {
    "type": [
     "number",
     "null"
    ]
   },
   "state": {
    "enum": [
     "submitted",
     "unsubmitted",
     "graded",
     "pending_review"
    ],
    "type": "string"
   },
   "submitted_at": {
    "description": "ISO 8601 timestamp (UTC); null when unset",
    "type": [
     "string",
     "null"
    ]
   },
   "url": {
    "description": "Preview link for the submission",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "state",
   "score",
   "grade",
   "submitted_at",
   "graded_at",
   "late",
   "missing",
   "excused",
   "attempt",
   "url",
   "comments"
  ],
  "type": "object"
 },
 "title": "Get an ELMS submission"
}
