{
 "description": "Add new rows to the bottom of an existing sheet with smart header handling and optional deduplication. BEST FOR: Structured database operations where spreadsheet has headers defining schema and rows represent records.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "deduplicateBy": {
    "description": "Column names to use as composite key for deduplication",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "gid": {
    "description": "Sheet ID (from URL gid={gid})",
    "minLength": 1,
    "type": "string"
   },
   "headers": {
    "description": "Column order/names - used for blank sheets or column mapping",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "Spreadsheet ID (from URL d/{id})",
    "minLength": 1,
    "type": "string"
   },
   "rows": {
    "description": "Array of rows, where each row is an array of cell values. Use null to skip a cell (preserve existing value), empty string \"\" to clear it.",
    "items": {
     "items": {
      "type": [
       "string",
       "number",
       "boolean",
       "null"
      ]
     },
     "minItems": 1,
     "type": "array"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "id",
   "gid",
   "rows"
  ],
  "type": "object"
 },
 "name": "rows-append",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "gid": {
        "description": "Sheet ID (from URL gid={gid})",
        "type": "string"
       },
       "id": {
        "description": "Spreadsheet ID (from URL d/{id})",
        "type": "string"
       },
       "rowsSkipped": {
        "description": "Number of duplicate rows skipped",
        "type": "number"
       },
       "sheetTitle": {
        "description": "Sheet tab name",
        "type": "string"
       },
       "sheetUrl": {
        "description": "URL to view the sheet",
        "type": "string"
       },
       "type": {
        "const": "success",
        "type": "string"
       },
       "updatedRows": {
        "description": "Number of rows appended",
        "type": "number"
       }
      },
      "required": [
       "type",
       "id",
       "gid",
       "sheetTitle",
       "updatedRows"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
