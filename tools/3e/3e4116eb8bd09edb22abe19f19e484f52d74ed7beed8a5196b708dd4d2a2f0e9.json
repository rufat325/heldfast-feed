{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Delete conversation"
 },
 "description": "Permanently delete all messages currently in a conversation, including received mail, sent copies and their attachments. Confirm the exact conversation and full scope with the human; no undo.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "thread_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "thread_id"
  ],
  "type": "object"
 },
 "name": "delete_thread",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Canonical thread ID at selection.",
    "type": "string"
   },
   "inbox_id": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "message_count": {
    "description": "Number of messages selected for deletion.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "received_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "sent_count": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "status": {
    "const": "deletion_pending",
    "type": "string"
   }
  },
  "required": [
   "id",
   "inbox_id",
   "message_count",
   "received_count",
   "sent_count",
   "status",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Delete conversation"
}
