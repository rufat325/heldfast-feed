{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Send gcode"
 },
 "description": "Send G-code commands to a printer",
 "inputSchema": {
  "properties": {
   "gcode": {
    "description": "Array of G-code commands to send. Either gcode, macro, or snippet_id is required.",
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 200,
    "minItems": 1,
    "type": "array"
   },
   "macro": {
    "description": "Predefined macro name to execute. Either gcode, macro, or snippet_id is required.",
    "enum": [
     "is_start",
     "is_end",
     "is_cancel",
     "is_pause",
     "is_resume",
     "move_axis",
     "change_print_speed",
     "change_flow_rate",
     "is_home",
     "set_tool_temperature",
     "set_bed_temperature",
     "set_chamber_temperature",
     "motors_onoff",
     "fans_onoff",
     "baby_stepping",
     "z_offset_cal_start",
     "z_offset_cal_nudge",
     "z_offset_cal_save",
     "is_autoprint_clear",
     "is_autoprint_on_end"
    ],
    "type": "string"
   },
   "macro_context": {
    "description": "Optional context data for macro execution.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "printer_id": {
    "description": "The printer IDs (comma-separated for multiple)",
    "minimum": 1,
    "type": "integer"
   },
   "snippet_id": {
    "description": "ID of a gcode snippet to send. Either gcode, macro, or snippet_id is required.",
    "type": "integer"
   }
  },
  "required": [
   "printer_id"
  ],
  "type": "object"
 },
 "name": "send_gcode"
}
