    "city": "beverly hills",
    "country": "us",
    "state": "ca"
   },
   {
    "city": "london",
    "country": "gb",
    "state": "england"
   }
  ],
  "properties": {
   "city": {
    "description": "City name, e.g. \"beverly hills\". Spaces are fine \u2014 pass the name as written.",
    "type": "string"
   },
   "country": {
    "description": "Country name or ISO 3166-1 alpha-2 code \u2014 \"United States\", \"US\", \"Germany\", \"DE\" all work.",
    "type": "string"
   },
   "state": {
    "description": "State, province or UK region, by name or abbreviation \u2014 \"California\" or \"CA\", \"Ontario\" or \"ON\", \"England\" or \"eng\".",
    "type": "string"
   }
  },
  "required": [
   "country",
   "state",
   "city"
  ],
  "type": "object"
 },
