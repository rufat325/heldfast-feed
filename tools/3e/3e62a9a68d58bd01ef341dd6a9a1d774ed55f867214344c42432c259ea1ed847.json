{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Aggregate search-traffic time series (total shows/clicks/position over a date range) \u2014 NOT per-query.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date_from": {
    "description": "Start date YYYY-MM-DD (default: 7 days ago)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "date_to": {
    "$ref": "#/properties/date_from",
    "description": "End date YYYY-MM-DD (default: today)"
   },
   "device_type_indicator": {
    "description": "Device type (default ALL)",
    "enum": [
     "ALL",
     "DESKTOP",
     "MOBILE",
     "TABLET",
     "MOBILE_AND_TABLET"
    ],
    "type": "string"
   },
   "format": {
    "default": "markdown",
    "description": "Output format: 'markdown' (compact, default) or 'json' (raw API response)",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "host_id": {
    "description": "Host ID from get_hosts",
    "type": "string"
   },
   "query_indicator": {
    "description": "Indicators to return (default: all)",
    "items": {
     "enum": [
      "TOTAL_SHOWS",
      "TOTAL_CLICKS",
      "AVG_SHOW_POSITION",
      "AVG_CLICK_POSITION"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "host_id"
  ],
  "type": "object"
 },
 "name": "get_query_analytics"
}
