{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a TouchEngine/Notch bridge scaffold with stable output TOP, control channels, NDI/Syphon fallback modes, and explicit licensing/runtime warnings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "description": "Start engine/fallback active where supported.",
    "type": "boolean"
   },
   "control_channels": {
    "default": [],
    "description": "Named control channels to scaffold.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "input_top_path": {
    "description": "Optional TOP to feed into the engine/fallback.",
    "type": "string"
   },
   "mode": {
    "default": "touchengine",
    "enum": [
     "touchengine",
     "notch_top",
     "ndi_fallback",
     "syphon_spout_fallback"
    ],
    "type": "string"
   },
   "name": {
    "default": "touchengine_notch",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "output_name": {
    "default": "notch_out",
    "description": "Stable output Null TOP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the bridge scaffold.",
    "type": "string"
   },
   "tox_or_block_path": {
    "description": "TouchEngine tox/block path or Notch block path.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_touchengine_notch",
 "title": "Connect TouchEngine Notch"
}
