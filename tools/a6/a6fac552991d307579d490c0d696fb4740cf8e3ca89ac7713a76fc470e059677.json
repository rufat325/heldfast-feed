{
 "_meta": {
  "openai/outputTemplate": "ui://rapier/editor-1.1.81.html",
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Opening Rapier.",
  "openai/ui": {
   "entrypoints": [
    {
     "type": "global"
    },
    {
     "type": "thread"
    },
    {
     "extensions": [
      ".md",
      ".markdown",
      ".txt"
     ],
     "type": "file"
    }
   ]
  },
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "ui": {
   "resourceUri": "ui://rapier/editor-1.1.81.html",
   "visibility": [
    "model",
    "app"
   ]
  },
  "website.rapier/tool-class": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Rapier editor"
 },
 "description": "Creates an editable workspace from text or a host file, or resumes one by its document value. Returns editor_url, the live workspace in a browser. It makes two kinds of diagram: native SVG drawings (document.draw) and Mermaid flowcharts as fences in the source (document.apply_edits). Workspaces expire after 30 idle days.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "createToken": {
    "description": "An optional retry name for this creation: an unchanged retry reopens the same workspace. With a connected host it is scoped to the connection; without one it is a secret of 22 or more random URL-safe characters.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "docKind": {
    "description": "markdown, text or code; the filename decides when absent.",
    "enum": [
     "markdown",
     "text",
     "code"
    ],
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "file": {
    "additionalProperties": true,
    "properties": {
     "name": {
      "description": "The opened filename, without a path.",
      "maxLength": 256,
      "minLength": 1,
      "type": "string"
     },
     "resourceUri": {
      "description": "Opaque host resource URI. Only the editor reads it through the host bridge.",
      "maxLength": 8192,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "name",
     "resourceUri"
    ],
    "type": "object"
   },
   "filename": {
    "description": "Its name; the extension sets the kind.",
    "maxLength": 256,
    "type": "string"
   },
   "text": {
    "description": "Create: the document's text.",
    "maxLength": 26214400,
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "rapier.open",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "created": {
    "type": "boolean"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "editor_url": {
    "maxLength": 256,
    "type": "string"
   },
   "message": {
    "maxLength": 256,
    "type": "string"
   },
   "outcome": {
    "enum": [
     "created",
     "current",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "replayed": {
    "type": "boolean"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Rapier editor"
}
