{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a maintenance window's status, schedule, or affected components",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "completedDescription": {
    "description": "Updated completed description",
    "type": "string"
   },
   "componentsAffected": {
    "description": "Updated affected components",
    "items": {
     "properties": {
      "id": {
       "description": "Component ID",
       "type": "string"
      },
      "status": {
       "description": "Component status",
       "enum": [
        "operational",
        "degraded_performance",
        "partial_outage",
        "major_outage",
        "under_maintenance"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "inProgressDescription": {
    "description": "Updated in-progress description",
    "type": "string"
   },
   "maintenanceId": {
    "description": "The maintenance ID to update",
    "type": "string"
   },
   "notifySubscribers": {
    "description": "Whether to notify page subscribers",
    "type": "boolean"
   },
   "pageId": {
    "description": "The status page ID",
    "type": "string"
   },
   "scheduledDescription": {
    "description": "Updated scheduled description",
    "type": "string"
   },
   "startDate": {
    "description": "Updated start date (ISO 8601)",
    "type": "string"
   },
   "status": {
    "description": "Updated status",
    "enum": [
     "scheduled",
     "in_progress",
     "completed"
    ],
    "type": "string"
   },
   "title": {
    "description": "Updated title",
    "type": "string"
   }
  },
  "required": [
   "pageId",
   "maintenanceId"
  ],
  "type": "object"
 },
 "name": "update-status-page-maintenance"
}
