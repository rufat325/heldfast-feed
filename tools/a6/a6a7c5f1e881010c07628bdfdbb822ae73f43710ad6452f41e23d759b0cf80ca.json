{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": false,
  "title": "Metrics Update"
 },
 "description": "Update a metric. Update a metric's definition \u2014 folder, source event, query (`query` DSL or typed `query_ir`), winsorisation, minimum detectable effect, or direction. `name` is immutable. Provide at most one of `query` / `query_ir`.",
 "inputSchema": {
  "properties": {
   "default_min_effect_of_interest": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Default minimum effect of interest (relative, 0\u20131) \u2014 the smallest change in this metric worth acting on, used as the power-planning baseline. Intrinsic to the metric; an experiment overrides it per-attachment with `min_effect_of_interest` when a specific decision has a different cost/risk bar. `null` to omit."
   },
   "direction": {
    "default": "higher_better",
    "description": "Desired direction of movement. `higher_better` (default), `lower_better`, or `neutral` (guardrail).",
    "enum": [
     "higher_better",
     "lower_better",
     "neutral"
    ],
    "type": "string"
   },
   "event_name": {
    "description": "Source event the query reads from.",
    "minLength": 1,
    "type": "string"
   },
   "folder": {
    "anyOf": [
     {
      "maxLength": 256,
      "pattern": "^[a-zA-Z0-9_-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Optional folder name grouping items in the dashboard. Alphanumeric, `_` or `-` (no `/`). Part of the SDK lookup key (`<folder>/<name>`)."
   },
   "id": {
    "description": "A resource path identifier \u2014 an opaque `xxx_<ULID>` id (~30 chars) or the resource's `name`/`key`. 1\u2013128 characters; the upper bound matches the longest name/key any resource accepts, so an over-long value can never name a real row.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Metric query DSL string, e.g. `sum(purchase, amount)`. The alternative to `query_ir`. Every label the query references \u2014 in filters, the value position, `by (\u2026)`, or `without (\u2026)` \u2014 must exist as a property on the tracked event's payload; a query over a label the event never carries validates fine but returns empty results.",
    "maxLength": 4096,
    "minLength": 1,
    "type": "string"
   },
   "query_ir": {
    "additionalProperties": false,
    "description": "Typed query IR \u2014 the structured alternative to the `query` DSL string. Exactly one of `query` / `query_ir` is supplied per metric body.",
    "properties": {
     "agg": {
      "description": "Aggregation function applied to the source event.",
      "oneOf": [
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "count_users",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "count_events",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "sum",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "avg",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "min",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "max",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "unique",
          "type": "string"
         }
        },
        "required": [
         "kind"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "quantile",
          "type": "string"
         },
         "p": {
          "anyOf": [
           {
            "const": 0.5,
            "type": "number"
           },
           {
            "const": 0.75,
            "type": "number"
           },
           {
            "const": 0.9,
            "type": "number"
           },
           {
            "const": 0.95,
            "type": "number"
           },
           {
            "const": 0.99,
            "type": "number"
           },
           {
            "const": 0.999,
            "type": "number"
           }
          ],
          "description": "Quantile fraction (0.5 = p50 \u2026 0.999 = p999)."
         }
        },
        "required": [
         "kind",
         "p"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "kind": {
          "const": "retention_Nd",
          "type": "string"
         },
         "n": {
          "description": "Retention window in days (1\u201390).",
          "maximum": 90,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "kind",
         "n"
        ],
        "type": "object"
       },
       {
        "additionalProperties": false,
        "properties": {
         "denominator": {
          "additionalProperties": false,
          "description": "Numerator or denominator arm of a `ratio` aggregation.",
          "properties": {
           "agg": {
            "description": "Counting mode for this ratio arm.",
            "enum": [
             "count_users",
             "count_events"
            ],
            "type": "string"
           },
           "filters": {
            "description": "Optional label filters.",
            "items": {
             "additionalProperties": false,
             "description": "One label filter on the source event.",
             "properties": {
              "label": {
               "description": "Event property / label identifier.",
               "pattern": "^[a-z_][a-z0-9_]{0,63}$",
               "type": "string"
              },
              "op": {
               "description": "Match operator (`=~`/`!~` are regex).",
               "enum": [
                "=",
                "!=",
                "=~",
                "!~"
               ],
               "type": "string"
              },
              "value": {
               "description": "Quoted filter value (coerced for numeric labels).",
               "maxLength": 512,
               "type": "string"
              }
             },
             "required": [
              "label",
              "op",
              "value"
             ],
             "type": "object"
            },
            "maxItems": 16,
            "type": "array"
           },
           "metric": {
            "description": "Source event name for this ratio arm.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "agg",
           "metric"
          ],
          "type": "object"
         },
         "kind": {
          "const": "ratio",
          "type": "string"
         },
         "numerator": {
          "additionalProperties": false,
          "description": "Numerator or denominator arm of a `ratio` aggregation.",
          "properties": {
           "agg": {
            "description": "Counting mode for this ratio arm.",
            "enum": [
             "count_users",
             "count_events"
            ],
            "type": "string"
           },
           "filters": {
            "description": "Optional label filters.",
            "items": {
             "additionalProperties": false,
             "description": "One label filter on the source event.",
             "properties": {
              "label": {
               "description": "Event property / label identifier.",
               "pattern": "^[a-z_][a-z0-9_]{0,63}$",
               "type": "string"
              },
              "op": {
               "description": "Match operator (`=~`/`!~` are regex).",
               "enum": [
                "=",
                "!=",
                "=~",
                "!~"
               ],
               "type": "string"
              },
              "value": {
               "description": "Quoted filter value (coerced for numeric labels).",
               "maxLength": 512,
               "type": "string"
              }
             },
             "required": [
              "label",
              "op",
              "value"
             ],
             "type": "object"
            },
            "maxItems": 16,
            "type": "array"
           },
           "metric": {
            "description": "Source event name for this ratio arm.",
            "maxLength": 128,
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "agg",
           "metric"
          ],
          "type": "object"
         }
        },
        "required": [
         "kind",
         "numerator",
         "denominator"
        ],
        "type": "object"
       }
      ]
     },
     "filters": {
      "default": [],
      "description": "Label filters on the event.",
      "items": {
       "additionalProperties": false,
       "description": "One label filter on the source event.",
       "properties": {
        "label": {
         "description": "Event property / label identifier.",
         "pattern": "^[a-z_][a-z0-9_]{0,63}$",
         "type": "string"
        },
        "op": {
         "description": "Match operator (`=~`/`!~` are regex).",
         "enum": [
          "=",
          "!=",
          "=~",
          "!~"
         ],
         "type": "string"
        },
        "value": {
         "description": "Quoted filter value (coerced for numeric labels).",
         "maxLength": 512,
         "type": "string"
        }
       },
       "required": [
        "label",
        "op",
        "value"
       ],
       "type": "object"
      },
      "maxItems": 16,
      "type": "array"
     },
     "groupBy": {
      "additionalProperties": false,
      "description": "Optional group-by clause (ignored for experiment analysis).",
      "properties": {
       "labels": {
        "description": "Labels to group by (max 5).",
        "items": {
         "description": "Event property / label identifier.",
         "pattern": "^[a-z_][a-z0-9_]{0,63}$",
         "type": "string"
        },
        "maxItems": 5,
        "type": "array"
       },
       "op": {
        "description": "`by` keeps the listed labels; `without` drops them.",
        "enum": [
         "by",
         "without"
        ],
        "type": "string"
       }
      },
      "required": [
       "op",
       "labels"
      ],
      "type": "object"
     },
     "metric": {
      "description": "Source event name (must equal `event_name`).",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     },
     "valueLabel": {
      "description": "Numeric property summed/averaged for `sum`/`avg`/quantile aggregations.",
      "maxLength": 128,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "agg",
     "metric"
    ],
    "type": "object"
   },
   "unit": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Display unit (e.g. `ms`, `%`, `$`), or `null` when unitless."
   },
   "winsorize_pct": {
    "default": 99,
    "description": "Winsorise percentile (1\u201399) to clamp outliers. Defaults to 99.",
    "maximum": 99,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "metrics_update"
}
