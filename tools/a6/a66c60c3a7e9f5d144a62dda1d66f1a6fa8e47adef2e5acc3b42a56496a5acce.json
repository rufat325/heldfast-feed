{
 "description": "Append UTM campaign parameters to a URL. Returns the tagged URL (does not create a link).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "The base URL to tag",
    "format": "uri",
    "type": "string"
   },
   "utm_campaign": {
    "description": "utm_campaign, e.g. launch-2026",
    "type": "string"
   },
   "utm_content": {
    "description": "utm_content (A/B variant)",
    "type": "string"
   },
   "utm_medium": {
    "description": "utm_medium, e.g. email",
    "type": "string"
   },
   "utm_source": {
    "description": "utm_source, e.g. newsletter",
    "type": "string"
   },
   "utm_term": {
    "description": "utm_term (paid-search keyword)",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "build_utm_url"
}
