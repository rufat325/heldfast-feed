{
 "description": "Add a label to a Gmail message",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "description": "Gmail message ID to add label to",
    "minLength": 1,
    "type": "string"
   },
   "label": {
    "description": "Label name or ID (use gmail-labels-list to discover available labels)",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "id",
   "label"
  ],
  "type": "object"
 },
 "name": "label-add",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "result": {
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "item": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "description": "Message ID the label was added to",
          "type": "string"
         },
         "label": {
          "description": "Label that was added",
          "type": "string"
         }
        },
        "required": [
         "id",
         "label"
        ],
        "type": "object"
       },
       "type": {
        "const": "success",
        "type": "string"
       }
      },
      "required": [
       "type",
       "item"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "message": {
        "type": "string"
       },
       "provider": {
        "type": "string"
       },
       "type": {
        "const": "auth_required",
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "type",
       "provider",
       "message"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
