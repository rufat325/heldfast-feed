{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Has a sheet changed?"
 },
 "description": "Check whether a source sheet has been modified since a timestamp (ISO date/time).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "id": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "string"
     }
    ]
   },
   "since": {
    "description": "ISO timestamp, e.g. 2026-01-01T00:00:00",
    "type": "string"
   }
  },
  "required": [
   "id",
   "since"
  ],
  "type": "object"
 },
 "name": "check_sheet_modified",
 "title": "Has a sheet changed?"
}
