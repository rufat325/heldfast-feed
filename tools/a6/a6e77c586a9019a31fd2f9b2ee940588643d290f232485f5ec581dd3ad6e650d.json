{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Assign tags to tickets, creating tags that don't exist yet (marked tagCreated), as rw tag assign does. Supports batch: single or multiple tags \u00d7 single or multiple tickets in one call. A ticket holds one value per prefix: assigning state:done replaces state:wip (reported as 'replaced'), and requesting two values of one prefix is an error.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "prefix": {
    "description": "Tag prefix (single tag)",
    "type": "string"
   },
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "tags": {
    "description": "Multiple tags to assign",
    "items": {
     "properties": {
      "prefix": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "prefix",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "ticket": {
    "description": "Ticket title (single)",
    "type": "string"
   },
   "tickets": {
    "description": "Ticket titles (multiple)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "value": {
    "description": "Tag value (single tag)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tag_assign",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "result": {
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "items": {
     "additionalProperties": false,
     "properties": {
      "replaced": {
       "description": "Values of the same prefix this tag replaced",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "status": {
       "enum": [
        "assigned",
        "already_assigned"
       ],
       "type": "string"
      },
      "tag": {
       "description": "prefix:value",
       "type": "string"
      },
      "tagCreated": {
       "const": true,
       "type": "boolean"
      },
      "ticket": {
       "type": "string"
      }
     },
     "required": [
      "ticket",
      "tag",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 }
}
