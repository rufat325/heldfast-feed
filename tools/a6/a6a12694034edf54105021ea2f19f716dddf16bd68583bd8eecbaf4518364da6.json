{
 "description": "Deploy a full snapshot \u2014 pipeline, tags, custom values, and workflow definitions \u2014 in a single operation.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "snapshot": {
    "description": "Full snapshot definition",
    "properties": {
     "custom_values": {
      "additionalProperties": {
       "type": "string"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "pipeline": {
      "properties": {
       "name": {
        "type": "string"
       },
       "stages": {
        "items": {
         "type": "string"
        },
        "type": "array"
       }
      },
      "required": [
       "name",
       "stages"
      ],
      "type": "object"
     },
     "tags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "workflows": {
      "items": {},
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "access_token",
   "location_id",
   "snapshot"
  ],
  "type": "object"
 },
 "name": "crm_deploy_snapshot"
}
