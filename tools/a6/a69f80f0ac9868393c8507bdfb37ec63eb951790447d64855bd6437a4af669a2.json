   "visibility": [
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Receives one bounded browser-produced DEEPBOM result, validates its structure, and returns it to the conversation. This tool accepts analysis results, never model bytes.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "result": {
    "additionalProperties": false,
    "properties": {
     "analysis_location": {
      "const": "chatgpt_browser_sandbox",
      "type": "string"
     },
     "analyzer_version": {
      "type": "string"
     },
     "artifact": {
      "additionalProperties": false,
      "properties": {
       "artifact_ir_sha256": {
        "type": [
         "string",
         "null"
        ]
       },
       "byte_length": {
        "minimum": 0,
        "type": "integer"
       },
       "filename": {
        "type": "string"
       },
       "format": {
        "type": "string"
       },
       "sha256": {
        "type": "string"
       }
      },
      "required": [
       "filename",
       "format",
       "sha256",
       "byte_length"
      ],
      "type": "object"
     },
     "evidence_boundary": {
      "type": "string"
     },
     "findings": {
      "type": "object"
     },
     "graph": {
      "additionalProperties": false,
      "properties": {
       "mac_confidence": {
        "type": "string"
       },
       "operator_count": {
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "tensor_count": {
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "total_macs": {
        "minimum": 0,
        "type": [
         "number",
         "null"
        ]
       }
      },
      "required": [
       "operator_count",
       "tensor_count",
       "total_macs",
       "mac_confidence"
      ],
      "type": "object"
     },
     "model_summary": {
      "type": "object"
     },
     "provenance_summary": {
      "additionalProperties": false,
      "properties": {
       "artifact_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "attested_relationship_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "check_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "check_counts": {
        "additionalProperties": false,
        "properties": {
         "match": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
         },
         "mismatch": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
         },
         "not_assessed": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
         },
         "unresolved": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
         },
         "unsupported": {
          "maximum": 1000000,
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "match",
         "mismatch",
         "not_assessed",
         "unresolved",
         "unsupported"
        ],
        "type": "object"
       },
       "field_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "mapped_declared_field_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "metadata_truth_verified": {
        "const": false,
        "type": "boolean"
       },
       "model_ir_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "node_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "observed_file_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "provenance_ir_sha256": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "publisher_authenticity": {
        "const": "not_verified",
        "type": "string"
       },
       "relationship_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       },
       "schema": {
        "const": "deepbom.provenance_summary.v1",
        "type": "string"
       },
       "status": {
        "enum": [
         "contradiction_observed",
         "incomplete",
         "no_contradiction_observed"
        ],
        "type": "string"
       },
       "unsupported_field_count": {
        "maximum": 1000000,
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "schema",
       "artifact_sha256",
       "model_ir_sha256",
       "provenance_ir_sha256",
       "status",
       "node_count",
       "relationship_count",
       "observed_file_count",
       "check_count",
       "field_count",
       "mapped_declared_field_count",
       "unsupported_field_count",
       "attested_relationship_count",
       "check_counts",
       "metadata_truth_verified",
       "publisher_authenticity"
      ],
      "type": "object"
     },
     "quantization": {
      "type": "object"
     },
     "reproduction": {
      "type": [
       "object",
       "null"
      ]
     },
     "schema": {
      "const": "deepbom.chatgpt_analysis_result.v2",
      "type": "string"
     },
     "storage": {
      "type": [
       "object",
       "null"
      ]
     },
     "transfer_boundary": {
      "type": "string"
     },
     "verdict": {
      "additionalProperties": false,
      "properties": {
       "artifact_defect_count": {
        "minimum": 0,
        "type": "integer"
       },
       "caution_count": {
        "minimum": 0,
        "type": "integer"
       },
       "evidence_needed_count": {
        "minimum": 0,
        "type": "integer"
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "status",
       "artifact_defect_count",
       "caution_count",
       "evidence_needed_count"
      ],
      "type": "object"
     }
    },
    "required": [
     "schema",
     "analyzer_version",
     "analysis_location",
     "artifact",
     "verdict",
     "graph",
     "storage",
     "quantization",
     "model_summary",
     "findings",
     "evidence_boundary",
     "transfer_boundary",
     "reproduction"
    ],
    "type": "object"
   }
  },
  "required": [
   "result"
  ],
  "type": "object"
 },
