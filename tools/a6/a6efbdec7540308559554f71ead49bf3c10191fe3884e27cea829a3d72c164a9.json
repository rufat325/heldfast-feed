{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Find prediction markets on Polymarket, Kalshi and Limitless by text in the market question. The query (at least 3 characters) is matched as one phrase, so use one or two distinctive words (\"bitcoin\", \"rate cut\"), not a sentence. Results are sorted by 24-hour volume. Each market has its id (pass it to get_market_prices or get_market_history), its last price as a 0-1 probability, best bid and ask, 24-hour volume in USD and end date. Defaults to active markets.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"category":{"description":"Category, e.g. crypto or politics","maxLength":100,"minLength":1,"type":"string"},"limit":{"default":10,"description":"Markets per page (default 10, max 25)","maximum":25,"minimum":1,"type":"integer"},"page":{"default":1,"description":"Page number (default 1)","maximum":100,"minimum":1,"type":"integer"},"platform":{"description":"Only this venue","enum":["polymarket","kalshi","limitless"],"type":"string"},"query":{"description":"Text to find in the market question, at least 3 characters, matched as one phrase (case-insensitive). Use one or two distinctive words, e.g. \"bitcoin\" or \"rate cut\".","maxLength":200,"minLength":3,"type":"string"},"status":{"default":"active","description":"Market status (default active)","enum":["pending","active","halted","closed","resolved","disputed","cancelled","archived"],"type":"string"}},"required":["query"],"type":"object"},"name":"search_markets","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"hasNextPage":{"type":"boolean"},"markets":{"items":{"additionalProperties":false,"properties":{"bestAsk":{"type":["number","null"]},"bestBid":{"type":["number","null"]},"category":{"type":["string","null"]},"endDate":{"type":["string","null"]},"id":{"type":"string"},"lastPrice":{"type