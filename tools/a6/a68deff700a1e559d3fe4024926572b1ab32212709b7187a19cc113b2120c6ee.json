{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "title": "Memory Import"
 },
 "description": "Import memories from JSON. Each item is embedded and stored. Use overwrite=true to update existing memories by ID.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Array of memory objects to import (max 500 per batch)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "access_level": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
           ],
           "type": "string"
          }
         ],
         "description": "Access classification level"
        },
        {
         "type": "null"
        }
       ],
       "description": "Access classification level"
      },
      "agent_id": {
       "description": "Originating actor/agent id (preserved on restore for attribution)",
       "type": [
        "string",
        "null"
       ]
      },
      "author": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ],
         "description": "Who created this content"
        },
        {
         "type": "null"
        }
       ],
       "description": "Who created this content"
      },
      "confidence_score": {
       "anyOf": [
        {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Explicit confidence/trust 0-1 \u2014 preserved on restore so a backup keeps groundedness"
      },
      "content": {
       "description": "The text content of the memory",
       "maxLength": 100000,
       "minLength": 1,
       "type": "string"
      },
      "created_at": {
       "description": "Original creation timestamp (ISO 8601) \u2014 preserved on restore",
       "type": [
        "string",
        "null"
       ]
      },
      "department": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ],
         "description": "Department (e.g., legal, engineering, hr, sales, finance)"
        },
        {
         "type": "null"
        }
       ],
       "description": "Department (e.g., legal, engineering, hr, sales, finance)"
      },
      "document_type": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ],
         "description": "Type of document (e.g., contract, policy, code, incident, decision)"
        },
        {
         "type": "null"
        }
       ],
       "description": "Type of document (e.g., contract, policy, code, incident, decision)"
      },
      "expires_at": {
       "description": "ISO 8601 expiration date",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Optional ID \u2014 if omitted, a new ID is generated",
       "type": "string"
      },
      "importance_score": {
       "anyOf": [
        {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Explicit importance 0-1 \u2014 preserved on restore (falls back to the content-derived heuristic only when absent), so a backup keeps criticality"
      },
      "language": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ],
         "description": "Content language (ISO 639-1 code)"
        },
        {
         "type": "null"
        }
       ],
       "description": "Content language (ISO 639-1 code)"
      },
      "metadata": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "additionalProperties": {},
           "type": "object"
          }
         ],
         "description": "Domain-specific metadata (e.g., {contract_type: 'NDA', parties: ['A','B']})"
        },
        {
         "type": "null"
        }
       ],
       "description": "Domain-specific metadata (e.g., {contract_type: 'NDA', parties: ['A','B']})"
      },
      "namespace": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ],
         "description": "Namespace within scope (e.g., project name, team name)"
        },
        {
         "type": "null"
        }
       ],
       "description": "Namespace within scope (e.g., project name, team name)"
      },
      "scope": {
       "description": "Memory scope for isolation",
       "enum": [
        "global",
        "project",
        "user",
        "team",
        "department"
       ],
       "type": "string"
      },
      "source": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "type": "string"
          }
         ],
         "description": "Origin of the content (e.g., file path, URL, system name)"
        },
        {
         "type": "null"
        }
       ],
       "description": "Origin of the content (e.g., file path, URL, system name)"
      },
      "tags": {
       "anyOf": [
        {
         "anyOf": [
          {
           "not": {}
          },
          {
           "items": {
            "type": "string"
           },
           "type": "array"
          }
         ],
         "description": "Tags for categorization"
        },
        {
         "type": "null"
        }
       ],
       "description": "Tags for categorization"
      },
      "title": {
       "description": "Short title for the memory",
       "type": [
        "string",
        "null"
       ]
      },
      "updated_at": {
       "description": "Original update timestamp (ISO 8601) \u2014 preserved on restore",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "content"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "overwrite": {
    "default": false,
    "description": "If true, overwrite existing memories with same ID",
    "type": "boolean"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "memory_import"
}
