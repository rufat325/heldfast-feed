{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create an expiring quote for a customer-owned project and explicit target/questions/repeats. Requires geo:write. Does not start sampling or debit the wallet. Show the quoted amount, scope and expiry before acceptance.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "max_unit_cents": {
    "maximum": 10000,
    "minimum": 0,
    "type": "integer"
   },
   "product": {
    "const": "geo.measurement.standard",
    "type": "string"
   },
   "project_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "questions": {
    "items": {
     "maxLength": 500,
     "minLength": 4,
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "repeats": {
    "default": 1,
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "revision": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "source_check_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "target_id": {
    "enum": [
     "doubao-web-search-api",
     "deepseek-model-api"
    ],
    "type": "string"
   }
  },
  "required": [
   "project_id",
   "revision",
   "product",
   "target_id",
   "questions",
   "max_unit_cents"
  ],
  "type": "object"
 },
 "name": "geo_quote_observation",
 "title": "\u83b7\u53d6\u89c2\u5bdf\u62a5\u4ef7"
}
