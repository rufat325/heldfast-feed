{
 "description": "Gestiona mensajer\u00eda interna. Acciones: list (inbox, page, limit), sent (enviados), get (id del hilo), send, unread (contador no le\u00eddos).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "list",
     "sent",
     "get",
     "send",
     "unread"
    ],
    "type": "string"
   },
   "bcc": {
    "type": "string"
   },
   "cc": {
    "type": "string"
   },
   "files": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "id": {
    "description": "ID del mensaje/hilo",
    "type": "number"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "message": {
    "type": "string"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "subject": {
    "type": "string"
   },
   "to": {
    "description": "ID del destinatario",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "messages"
}
