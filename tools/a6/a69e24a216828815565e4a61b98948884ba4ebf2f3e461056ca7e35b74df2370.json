 "description": "Default visual presentation after the final useful availability comparison when UI is supported and text-only was not requested. Render once without waiting for a photo request; narrate ordinary follow-ups without repeating searches or widgets. Read-only room comparison presentation. First search availability, then select returned property/room/rate/count IDs and preserve the exact dates, guests, budget and display currency. Rechecks the existing property availability tool for current authoritative stay totals; never accepts prices or quote data. Up to3 properties,4 cards/page,60 offers maximum. show_available_rooms renders once; get_available_room_cards is data-only for mounted-card pagination. Photo selection opens only the selected room gallery. No bookings, holds, quotes, emails or payments.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "adults": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "budget": {
    "additionalProperties": false,
    "description": "Optional additional budget constraint. Clarify missing currency or basis before calling. Do not combine with legacy maxPrice/maxPriceCurrency.",
    "properties": {
     "amount": {
      "description": "Maximum amount in the explicitly supplied currency and basis.",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "basis": {
      "description": "Required explicit basis. Per-night means a stay-average allowance, not a ceiling on each night. Per-person means every adult and child equally; clarify other interpretations.",
      "enum": [
       "TOTAL_STAY",
       "PER_NIGHT",
       "PER_PERSON_STAY",
       "PER_PERSON_PER_NIGHT"
      ],
      "type": "string"
     },
     "currency": {
      "description": "Required 3-letter budget currency. Never infer from location or displayCurrency.",
      "pattern": "^[A-Za-z]{3}$",
      "type": "string"
     },
     "scope": {
      "default": "PRICED_STAY",
      "description": "PRICED_STAY compares the accommodation total including configured taxes/fees. ALL_IN requires complete mandatory charges; currently ATA cannot verify completeness and will return labeled alternatives only.",
      "enum": [
       "PRICED_STAY",
       "ALL_IN"
      ],
      "type": "string"
     }
    },
    "required": [
     "amount",
     "currency",
     "basis"
    ],
    "type": "object"
   },
   "checkIn": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "checkOut": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "children": {
    "default": 0,
    "maximum": 100,
    "minimum": 0,
    "type": "integer"
   },
   "displayCurrency": {
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "offset": {
    "default": 0,
    "maximum": 60,
    "minimum": 0,
    "type": "integer"
   },
   "selections": {
    "description": "Properties and exact room/rate/count selections from prior availability. Omit offers to compare currently available offers at that property.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "offers": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "ratePlanId": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
         },
         "roomId": {
          "maxLength": 160,
          "minLength": 1,
          "type": "string"
         },
         "selectedRoomCount": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "type": "integer"
         }
        },
        "required": [
         "roomId",
         "ratePlanId"
        ],
        "type": "object"
       },
       "maxItems": 12,
       "minItems": 1,
       "type": "array"
      },
      "propertyToken": {
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "propertyToken"
     ],
     "type": "object"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "selections",
   "checkIn",
   "checkOut",
   "adults"
  ],
  "type": "object"
 },
