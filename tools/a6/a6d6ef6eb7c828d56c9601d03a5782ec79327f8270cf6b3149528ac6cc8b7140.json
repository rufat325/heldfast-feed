{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List matches"
 },
 "description": "Returns the account's ranked live match pool with job id, its Dreamwork page url, title, company, location, remote terms, salary, dates, match percent and saved/applied state. Filters narrow that pool; nextCursor continues a page with identical filters, and null ends the walk. addedAfter supports overlapping discovery windows because listings can become servable after first discovery. notes describe applied filters and coverage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addedAfter": {
    "description": "Only jobs Dreamwork first saw after this ISO date-time.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "aiRole": {
    "description": "AI roles only.",
    "type": "boolean"
   },
   "bonus": {
    "type": "boolean"
   },
   "cursor": {
    "description": "`nextCursor` from the previous page. Send the same filters and sort, or it is refused.",
    "maxLength": 512,
    "type": "string"
   },
   "equity": {
    "type": "boolean"
   },
   "function": {
    "description": "Job-function labels, comma-separated for a union, e.g. \"Engineering,Product\". An unknown label is refused with the list.",
    "maxLength": 200,
    "type": "string"
   },
   "healthcare": {
    "type": "boolean"
   },
   "industry": {
    "description": "Employer industry, e.g. \"Pharma & Biotech\". An unknown name is refused with the list.",
    "maxLength": 60,
    "type": "string"
   },
   "internship": {
    "description": "Internships, co-ops, and apprenticeships only.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size, 10 when omitted. A cursor keeps the size it was issued with.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "City, region, or country; a place the gazetteer cannot resolve is refused.",
    "maxLength": 120,
    "type": "string"
   },
   "maxSalary": {
    "description": "Pay ceiling in whole annual USD.",
    "maximum": 9007199254740991,
    "minimum": 1000,
    "type": "integer"
   },
   "minMatchPercent": {
    "description": "Lowest match percent to keep, on the 40-97 scale shown.",
    "maximum": 97,
    "minimum": 40,
    "type": "integer"
   },
   "minSalary": {
    "description": "Pay floor in whole annual USD, e.g. 200000. Jobs with no posted pay drop out.",
    "maximum": 9007199254740991,
    "minimum": 1000,
    "type": "integer"
   },
   "postedWithinDays": {
    "description": "Employer posting date within this many days.",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Free-text search across the person's match pool.",
    "maxLength": 200,
    "type": "string"
   },
   "remoteOnly": {
    "description": "Shorthand for workSettings [\"remote\"].",
    "type": "boolean"
   },
   "seniority": {
    "description": "Seniority labels, comma-separated for a union: Junior, Mid-Level, Senior, Staff+, Director+.",
    "maxLength": 80,
    "type": "string"
   },
   "sort": {
    "description": "Order; relevance when omitted.",
    "enum": [
     "relevance",
     "newest",
     "pay_high",
     "pay_low"
    ],
    "type": "string"
   },
   "workSettings": {
    "description": "Work settings to keep, as a union; an unstated setting counts as onsite.",
    "items": {
     "enum": [
      "remote",
      "hybrid",
      "onsite"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
