{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an Airtable content scaffold with record maps, field maps, sync policy, adapter source, and token/rate-limit safety notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "rest_json",
    "enum": [
     "rest_json",
     "webhook_json",
     "manual"
    ],
    "type": "string"
   },
   "adapter_url": {
    "default": "http://127.0.0.1:9061/airtable",
    "type": "string"
   },
   "base_id": {
    "default": "app_show_base",
    "type": "string"
   },
   "field_count": {
    "default": 8,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "airtable_content_bus",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Airtable content-bus scaffold.",
    "type": "string"
   },
   "record_count": {
    "default": 24,
    "maximum": 512,
    "minimum": 1,
    "type": "integer"
   },
   "sync_direction": {
    "default": "read_only",
    "enum": [
     "read_only",
     "approved_updates"
    ],
    "type": "string"
   },
   "table_name": {
    "default": "Show Content",
    "type": "string"
   },
   "view_name": {
    "default": "Approved",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_airtable_content_bus",
 "title": "Connect Airtable content bus"
}
