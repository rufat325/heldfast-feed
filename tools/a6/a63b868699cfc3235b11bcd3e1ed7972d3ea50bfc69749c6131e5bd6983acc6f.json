{
 "description": "Row-key diff between two immutable Open Label dataset version snapshots (added/removed/changed rows plus both version labels). Pass the snapshot ids from open_label_list_dataset_versions. Requires open-label:read scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "datasetId": {
    "description": "The dataset the snapshots belong to.",
    "type": "string"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "snapshotIdA": {
    "description": "Base snapshot id (from open_label_list_dataset_versions).",
    "type": "string"
   },
   "snapshotIdB": {
    "description": "Comparison snapshot id.",
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "datasetId",
   "snapshotIdA",
   "snapshotIdB"
  ],
  "type": "object"
 },
 "name": "open_label_diff_dataset_versions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
