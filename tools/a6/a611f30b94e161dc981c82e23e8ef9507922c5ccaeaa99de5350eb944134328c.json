{
 "description": "Revoke one observe link immediately (idempotent; expiring the session revokes every link atomically). Requires lms:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idempotencyKey": {
    "description": "Stable idempotency key. Reuse only for the identical operation.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "linkId": {
    "$ref": "#/properties/sessionId"
   },
   "sessionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "linkId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_lms_revoke_preview_link",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
