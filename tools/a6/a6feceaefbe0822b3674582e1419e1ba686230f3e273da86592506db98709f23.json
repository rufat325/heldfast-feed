{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a VDMX OSC/Syphon workspace scaffold with layer, clip, preview, and setup maps.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "clip_count": {
    "default": 16,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "layer_count": {
    "default": 4,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "vdmx_workspace",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the VDMX scaffold.",
    "type": "string"
   },
   "preview_mode": {
    "default": "syphon_spout",
    "enum": [
     "none",
     "syphon_spout",
     "ndi"
    ],
    "type": "string"
   },
   "receive_port": {
    "default": 12346,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "send_port": {
    "default": 12345,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "vdmx_host": {
    "default": "127.0.0.1",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "connect_vdmx_workspace",
 "title": "Connect VDMX workspace"
}
