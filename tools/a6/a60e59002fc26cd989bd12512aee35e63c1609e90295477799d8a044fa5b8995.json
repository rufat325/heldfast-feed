     },
     "input_type": {
      "type": "string"
     },
     "key": {
      "type": "string"
     },
     "mapping_name": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "scale": {
      "type": "number"
     }
    },
    "required": [
     "key"
    ],
    "type": "object"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_input"
}
