{
 "description": "Input tool namespace for creating classic UE4 input mappings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "const": "create_input_mapping",
    "description": "Action to execute inside tool namespace manage_input",
    "type": "string"
   },
   "params": {
    "additionalProperties": false,
    "description": "Parameters for the selected manage_input action. Supported actions: manage_input.create_input_mapping.",
    "properties": {
     "action_name": {
