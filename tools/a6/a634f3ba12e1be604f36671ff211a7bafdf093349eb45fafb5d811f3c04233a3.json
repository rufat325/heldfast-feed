{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Open positions and unrealized PnL for a Hyperliquid wallet right now, across native and HIP-3 perps. Use it for questions like 'is this wallet long or short?'",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_user_state",
 "outputSchema": {
  "description": "Open positions right now",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "as_of_ts": {
    "description": "Snapshot time, Unix milliseconds"
   },
   "asset_positions": {
    "description": "Open positions",
    "items": {
     "description": "Open position",
     "properties": {
      "entry_price": {
       "description": "Average entry price"
      },
      "leverage": {
       "description": "Leverage"
      },
      "leverage_type": {
       "description": "cross or isolated"
      },
      "mark_price": {
       "description": "Current mark price"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "market_class": {
       "description": "perp, spot, prediction or option"
      },
      "position_value": {
       "description": "Position value in USD"
      },
      "realized_pnl": {
       "description": "Realized PnL in USD"
      },
      "return_on_equity": {
       "description": "Unrealized PnL divided by margin"
      },
      "size": {
       "description": "Signed size: positive long, negative short"
      },
      "unrealized_pnl": {
       "description": "Unrealized PnL in USD"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "margin_summary": {
    "description": "Account totals",
    "properties": {
     "open_markets_count": {
      "description": "Markets with an open position"
     },
     "total_position_value": {
      "description": "Sum of position values in USD"
     },
     "total_realized_pnl": {
      "description": "Sum of realized PnL in USD"
     },
     "total_unrealized_pnl": {
      "description": "Sum of unrealized PnL in USD"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
