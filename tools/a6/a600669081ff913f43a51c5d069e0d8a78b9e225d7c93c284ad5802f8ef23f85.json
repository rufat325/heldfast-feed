{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "billing"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a checkout link"
 },
 "description": "Turn a quote the user explicitly confirmed into a Stripe payment page. Charges nothing: the user pays on the page. Requires confirm=true and the quote's due_now_cents.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "description": "Must be true, after the user said yes to the quote's human_summary in this chat.",
    "type": "boolean"
   },
   "expected_due_now_cents": {
    "description": "due_now_cents of the quote the user confirmed.",
    "minimum": 0,
    "type": "integer"
   },
   "idempotency_key": {
    "description": "Optional. Reuse the same value when retrying; one is generated when omitted.",
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "quote_id": {
    "description": "quote_id from quote_order.",
    "pattern": "^ord_[a-z0-9]{8,40}$",
    "type": "string"
   },
   "workspace_id": {
    "description": "Workspace id. Optional: defaults to the workspace picked at sign-in or bound to the API key.",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "quote_id",
   "expected_due_now_cents",
   "confirm"
  ],
  "type": "object"
 },
 "name": "create_checkout",
 "outputSchema": {
  "properties": {
   "checkout_kind": {
    "type": [
     "string",
     "null"
    ]
   },
   "checkout_url": {
    "description": "Stripe-hosted payment page for the user.",
    "type": "string"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "due_now_cents": {
    "type": [
     "integer",
     "null"
    ]
   },
   "expires_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "idempotency_key": {
    "type": "string"
   },
   "links": {
    "items": {
     "properties": {
      "label": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "label",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_check_after_seconds": {
    "type": "integer"
   },
   "next_step": {
    "description": "What to do next, in one sentence.",
    "type": "string"
   },
   "order_id": {
    "type": "string"
   },
   "status": {
    "type": [
     "string",
     "null"
    ]
   },
   "test_mode": {
    "type": "boolean"
   }
  },
  "required": [
   "next_step",
   "links"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "billing"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create a checkout link"
}
