{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "multilocale:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search strings by text"
 },
 "description": "Use this when someone asks to find translation strings that contain a word or phrase, in their keys or text. Returns up to 100 matches with id, key, language and value from a case-insensitive match within one project. Not for one exact key.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "language": {
    "description": "Only search this locale code; every language when absent",
    "maxLength": 35,
    "type": "string"
   },
   "project": {
    "description": "Project name; an id matches nothing",
    "maxLength": 128,
    "type": "string"
   },
   "query": {
    "description": "Text to find in keys or values, case-insensitive, 1 to 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "project",
   "query"
  ],
  "type": "object"
 },
 "name": "search_phrases",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "phraseCount": {
    "minimum": 0,
    "type": "integer"
   },
   "phrases": {
    "description": "Up to 100 matching phrases, values cut to 2,000 characters; phraseCount has the total",
    "items": {
     "additionalProperties": false,
     "properties": {
      "creationTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "anyOf": [
        {
         "pattern": "^[0-9a-f]{24}$",
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "key": {
       "maxLength": 256,
       "type": "string"
      },
      "language": {
       "maxLength": 35,
       "type": "string"
      },
      "lastEditTime": {
       "$ref": "#/properties/phrases/items/properties/creationTime"
      },
      "machineTranslated": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "projects": {
       "items": {
        "maxLength": 128,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "value": {
       "maxLength": 2000,
       "type": "string"
      },
      "valueTruncated": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "key",
      "language",
      "value",
      "valueTruncated",
      "machineTranslated",
      "projects",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "phrasesTruncated": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "found",
     "empty",
     "no-matches"
    ],
    "type": "string"
   }
  },
  "required": [
   "status",
   "phraseCount",
   "phrasesTruncated",
   "phrases"
  ],
  "type": "object"
 },
 "title": "Search strings by text"
}
