{
 "description": "Document and media evidence when Markdown is not enough. video_timeline (bounded scene/cue timeline) and render_frame (actual decoded frames), and cite_check (quote/location support, not semantic truth), are anymd Pro; PDF operations: inspect (page facts, metadata), render_page (PNG images), extract_regions (crop bounding boxes), ocr_pages / analyze_regions (configured OCR or vision provider), structure (JSON with document map, elements, geometry; profile quality|research adds trust and accessibility reports), compare (page-level diff of sources[0] vs sources[1]).",
 "inputSchema": {
  "$defs": {
   "Citation": {
    "additionalProperties": false,
    "properties": {
     "bounding_box": {
      "$ref": "#/$defs/CiteBoundingBox",
      "description": "Bottom-left PDF coordinates, finite and with positive area. No padding."
     },
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "page": {
      "description": "One-based physical PDF page, not a printed page label. At most 20 distinct pages per request.",
      "minimum": 1,
      "type": "integer"
     },
     "quote": {
      "description": "Nonempty quote, at most 4096 UTF-16 units; request total at most 64000 units.",
      "maxLength": 4096,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "quote",
     "page",
     "bounding_box"
    ],
    "type": "object"
   },
   "CiteBoundingBox": {
    "additionalProperties": false,
    "properties": {
     "bottom": {
      "type": "number"
     },
     "left": {
      "type": "number"
     },
     "right": {
      "type": "number"
     },
     "top": {
      "type": "number"
     }
    },
    "required": [
     "left",
     "bottom",
     "right",
     "top"
    ],
    "type": "object"
   },
   "CiteNormalization": {
    "enum": [
     "none",
     "whitespace_v1"
    ],
    "type": "string"
   },
   "InspectOperation": {
    "oneOf": [
     {
      "const": "video_timeline",
      "description": "Bounded local video timeline.",
      "type": "string"
     },
     {
      "const": "render_frame",
      "description": "Decode actual video frames at requested playback timestamps.",
      "type": "string"
     },
     {
      "const": "cite_check",
      "description": "Deterministic quote and location support, not semantic truth.",
      "type": "string"
     },
     {
      "const": "inspect",
      "description": "Page count, metadata, and per-page facts.",
      "type": "string"
     },
     {
      "const": "render_page",
      "description": "Render pages to PNG images.",
      "type": "string"
     },
     {
      "const": "extract_regions",
      "description": "Crop regions (bounding boxes) out of rendered pages.",
      "type": "string"
     },
     {
      "const": "ocr_pages",
      "description": "OCR pages with the configured provider.",
      "type": "string"
     },
     {
      "const": "analyze_regions",
      "description": "Send regions to a configured vision/region provider.",
      "type": "string"
     },
     {
      "const": "structure",
      "description": "Structured JSON read: document map, elements, geometry, trust and accessibility reports.",
      "type": "string"
     },
     {
      "const": "compare",
      "description": "Page-level text diff between two PDFs (sources[0] = before, sources[1] = after).",
      "type": "string"
     }
    ]
   },
   "OcrEngine": {
    "enum": [
     "auto",
     "vlm",
     "tesseract"
    ],
    "type": "string"
   },
   "PageNumber": {
    "minimum": 1,
    "type": "integer"
   },
   "PageSpecifier": {
    "anyOf": [
     {
      "items": {
       "$ref": "#/$defs/PageNumber"
      },
      "type": "array"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ]
   },
   "PdfEvidenceRegion": {
    "properties": {
     "bounding_box": {
      "$ref": "#/$defs/RegionBoundingBox"
     },
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "padding": {
      "maximum": 200.0,
      "minimum": 0.0,
      "type": [
       "number",
       "null"
      ]
     },
     "page": {
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "bounding_box"
    ],
    "type": "object"
   },
   "PdfEvidenceSource": {
    "properties": {
     "pages": {
      "anyOf": [
       {
        "$ref": "#/$defs/PageSpecifier"
       },
       {
        "type": "null"
       }
      ]
     },
     "path": {
      "description": "Path to a local source (PDF for PDF operations; media for video operations). Provide exactly one of path or url (not both).",
      "minLength": 1,
      "type": [
       "string",
       "null"
      ]
     },
     "regions": {
      "items": {
       "$ref": "#/$defs/PdfEvidenceRegion"
      },
      "type": [
       "array",
       "null"
      ]
     },
     "url": {
      "description": "Explicit source URL. Provide exactly one of path or url (not both).",
      "minLength": 1,
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "RegionBoundingBox": {
    "properties": {
     "bottom": {
      "minimum": 0.0,
      "type": "number"
     },
     "left": {
      "minimum": 0.0,
      "type": "number"
     },
     "right": {
      "minimum": 0.0,
      "type": "number"
     },
     "top": {
      "minimum": 0.0,
      "type": "number"
     }
    },
    "required": [
     "left",
     "bottom",
     "right",
     "top"
    ],
    "type": "object"
   },
   "TimelineSelection": {
    "additionalProperties": false,
    "properties": {
     "caption": {
      "default": false,
      "type": "boolean"
     },
     "end_ms": {
      "minimum": 0,
      "type": "integer"
     },
     "max_scenes": {
      "default": 20,
      "minimum": 0,
      "type": "integer"
     },
     "start_ms": {
      "default": 0,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "end_ms"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "citations": {
    "description": "cite_check only: 1\u2013100 quotes with required page and bounding_box; exactly one PDF source.",
    "items": {
     "$ref": "#/$defs/Citation"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": [
     "array",
     "null"
    ]
   },
   "expected_source_sha256": {
    "description": "cite_check and video operations: fail if the admitted source's SHA-256 differs from this hexadecimal value.",
    "maxLength": 64,
    "minLength": 64,
    "type": [
     "string",
     "null"
    ]
   },
   "include_image": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "include_metadata": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "max_output_chars": {
    "maximum": 1000000,
    "minimum": 1000,
    "type": [
     "integer",
     "null"
    ]
   },
   "max_pages": {
    "maximum": 20,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "max_pixels_per_page": {
    "maximum": 64000000,
    "minimum": 10000,
    "type": [
     "integer",
     "null"
    ]
   },
   "max_regions": {
    "maximum": 100,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "normalization": {
    "anyOf": [
     {
      "$ref": "#/$defs/CiteNormalization"
     },
     {
      "type": "null"
     }
    ]
   },
   "ocr": {
    "anyOf": [
     {
      "$ref": "#/$defs/OcrEngine"
     },
     {
      "type": "null"
     }
    ],
    "description": "Local OCR engine for ocr_pages: auto, vlm, or tesseract. Omit to use the configured command provider."
   },
   "operation": {
    "$ref": "#/$defs/InspectOperation"
   },
   "profile": {
    "description": "structure only: fast (default), quality, or research (adds safety, trust, accessibility).",
    "type": [
     "string",
     "null"
    ]
   },
   "sample_pages": {
    "maximum": 20,
    "minimum": 1,
    "type": [
     "integer",
     "null"
    ]
   },
   "scale": {
    "maximum": 4.0,
    "minimum": 0.25,
    "type": [
     "number",
     "null"
    ]
   },
   "sources": {
    "items": {
     "$ref": "#/$defs/PdfEvidenceSource"
    },
    "type": "array"
   },
   "timeline": {
    "anyOf": [
     {
      "$ref": "#/$defs/TimelineSelection"
     },
     {
      "type": "null"
     }
    ],
    "description": "video_timeline only (required there): half-open playback window with required end_ms, at most ten minutes and twenty detected-cut scenes. caption only samples one frame per scene through a user-configured local-command adapter."
   },
   "timeout_ms": {
    "maximum": 300000,
    "minimum": 1000,
    "type": [
     "integer",
     "null"
    ]
   },
   "timestamps_ms": {
    "description": "render_frame only: playback timestamps in integer milliseconds (at most twenty). Returns decoded frame metadata with the actual decoded timestamp.",
    "items": {
     "minimum": 0,
     "type": "integer"
    },
    "type": [
     "array",
     "null"
    ]
   },
   "transcript": {
    "description": "video_timeline only: also attach timed ASR cues from preinstalled local Qwen3-ASR weights. Never downloads models. Default false.",
    "type": [
     "boolean",
     "null"
    ]
   }
  },
  "required": [
   "operation",
   "sources"
  ],
  "type": "object"
 },
 "name": "inspect"
}
