{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Meta tag generator"
 },
 "description": "Build a complete HTML head snippet from page details: title, meta description, canonical link, Open Graph and Twitter card tags. Returns the ready-to-paste snippet plus character counts. Source: https://hopi.co.uk/meta-tag-generator/",
 "inputSchema": {
  "properties": {
   "canonical": {
    "description": "Canonical URL for the page",
    "format": "uri",
    "type": "string"
   },
   "description": {
    "description": "Meta description (guideline is around 155 characters)",
    "type": "string"
   },
   "ogDescription": {
    "description": "Open Graph description (defaults to description if omitted)",
    "type": "string"
   },
   "ogImage": {
    "description": "Open Graph image URL",
    "format": "uri",
    "type": "string"
   },
   "ogTitle": {
    "description": "Open Graph title (defaults to title if omitted)",
    "type": "string"
   },
   "ogType": {
    "default": "website",
    "description": "Open Graph type (default 'website')",
    "enum": [
     "website",
     "article",
     "product",
     "profile"
    ],
    "type": "string"
   },
   "title": {
    "description": "Page title (guideline is around 60 characters)",
    "type": "string"
   },
   "twitterCard": {
    "default": "summary_large_image",
    "description": "Twitter card type (default 'summary_large_image')",
    "enum": [
     "summary",
     "summary_large_image",
     "app",
     "player"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "hopi_meta_tag_generator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "descriptionLength": {
    "type": "number"
   },
   "descriptionOverGuideline": {
    "type": "boolean"
   },
   "html": {
    "type": "string"
   },
   "lines": {
    "type": "array"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "titleLength": {
    "type": "number"
   },
   "titleOverGuideline": {
    "type": "boolean"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Meta tag generator"
}
