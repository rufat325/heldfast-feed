{
 "annotations": {},
 "description": "Rename nodes: set `name`, or find/replace (regex allowed), or prefix/suffix. `name` cannot mix with the others.",
 "inputSchema": {
  "properties": {
   "find": {
    "description": "Text or regex to find in names",
    "type": "string"
   },
   "name": {
    "description": "New name for all nodes; slashes group e.g. 'Icons/Arrow'",
    "type": "string"
   },
   "nodeIds": {
    "description": "Node IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prefix": {
    "description": "Add to start of name",
    "type": "string"
   },
   "regexFlags": {
    "description": "Regex flags (default 'g')",
    "type": "string"
   },
   "replace": {
    "description": "Replacement; required with find",
    "type": "string"
   },
   "suffix": {
    "description": "Add to end of name",
    "type": "string"
   },
   "useRegex": {
    "description": "find is a regex (default false)",
    "type": "boolean"
   }
  },
  "required": [
   "nodeIds"
  ],
  "type": "object"
 },
 "name": "batch_rename_nodes"
}
