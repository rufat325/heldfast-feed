{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Restaurants & Dining"
 },
 "description": "Searches restaurants in a city for a date, with optional time, party size, cuisine, price range and neighbourhood. For planning only: it returns restaurant details and indicative availability. Autonomad does not place restaurant reservations; any booking is made with the restaurant directly.",
 "inputSchema": {
  "properties": {
   "city": {
    "type": "string"
   },
   "cuisine": {
    "type": "string"
   },
   "date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "neighborhood": {
    "type": "string"
   },
   "party_size": {
    "type": "number"
   },
   "price_range": {
    "enum": [
     "$",
     "$$",
     "$$$",
     "$$$$"
    ],
    "type": "string"
   },
   "time": {
    "description": "HH:MM in 24h",
    "type": "string"
   }
  },
  "required": [
   "city",
   "date"
  ],
  "type": "object"
 },
 "name": "search_dining",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [],
   "type": "oauth2"
  }
 ]
}
