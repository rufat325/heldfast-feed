  "readOnlyHint": true,
  "title": "List scenes"
 },
 "description": "Lists the workspace's scenes, newest first: id, name, the version last published (0: never) and when. Read one's draft with scene_get (path \"\" lists what it holds). Answers items (id, name, version, publishedAt, createdAt, updatedAt), nextCursor and hasMore.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "after": {
    "description": "The `nextCursor` from a previous page of this same tool.",
    "type": "string"
   },
   "first": {
    "description": "How many rows to return on this page; 20 when omitted.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_scenes",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "hasMore": {
      "type": "boolean"
     },
     "items": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "id": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "publishedAt": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "version": {
         "description": "Last published; 0: never",
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        }
       },
       "required": [
        "id",
        "name",
        "version",
        "publishedAt"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "nextCursor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "Pass back as `after` for the next page; null on the last"
     }
    },
    "required": [
     "items",
     "nextCursor",
     "hasMore"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "code": {
