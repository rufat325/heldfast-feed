{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update an existing habit. Only provided fields are changed.",
 "inputSchema": {
  "properties": {
   "active": {
    "description": "Enable or disable the habit",
    "type": "boolean"
   },
   "color": {
    "description": "Color as #rrggbb, e.g. #10AC84",
    "type": "string"
   },
   "habit_id": {
    "description": "ID of the habit to update",
    "type": "integer"
   },
   "icon": {
    "description": "Lucide icon name (lowercase, dashes), e.g. book-open",
    "type": "string"
   },
   "name": {
    "description": "New habit name",
    "type": "string"
   },
   "target_duration": {
    "description": "New target duration in minutes (5-480)",
    "type": "integer"
   },
   "target_value": {
    "description": "New target count value",
    "type": "integer"
   },
   "time_of_day": {
    "description": "When during the day",
    "enum": [
     "morning",
     "afternoon",
     "evening"
    ],
    "type": "string"
   },
   "times_per_week": {
    "description": "New times per week target (1-7)",
    "type": "integer"
   },
   "tracking_type": {
    "description": "New tracking type",
    "enum": [
     "check",
     "count",
     "duration",
     "times_per_week"
    ],
    "type": "string"
   },
   "unit": {
    "description": "New unit label",
    "type": "string"
   }
  },
  "required": [
   "habit_id"
  ],
  "type": "object"
 },
 "name": "update_habit",
 "title": "Update habit"
}
