  "readOnlyHint": false,
  "title": "Reply to email"
 },
 "description": "Reply to a message, with recipients and subject derived from it. Derived recipients come from sender-written headers: check them against the assignment. To choose recipients yourself, use send_message with in_reply_to.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "attachments": {
    "description": "New files for this reply; original attachments are not copied.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "content": {
       "description": "Padded base64 file content, not a URL.",
       "type": "string"
      },
      "filename": {
       "type": "string"
      },
      "type": {
       "description": "MIME type.",
       "type": "string"
      }
     },
     "required": [
      "filename",
      "type",
      "content"
     ],
     "type": "object"
    },
    "maxItems": 32,
    "type": "array"
   },
   "html": {
    "description": "Optional HTML alternative to your response.",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Makes a retry safe: repeating the call with the same key and identical arguments within 24 hours of the first request returns the original attempt instead of sending again. Use a new key for each intended email.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   },
   "inbox_id": {
    "description": "Inbox to send from; it must hold the source message.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "labels": {
    "items": {
     "description": "Case-sensitive label, trimmed; at most 128 UTF-8 bytes, without control characters.",
     "type": "string"
    },
    "maxItems": 32,
    "type": "array"
   },
   "message_id": {
    "description": "Ready received or accepted sent message in this inbox. A reply to received mail goes to its Reply-To, or From when there is none; a reply to sent mail goes to its original To.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "text": {
    "description": "Your response; original history is not automatically quoted.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "inbox_id",
   "message_id",
   "text"
  ],
  "type": "object"
 },
