002","type":"number"},"covariates":{"description":"\u534f\u53d8\u91cf\u5217\u540d\u6570\u7ec4\uff0c\u5982 [\"age\",\"sex\"]\uff08\u4f20 data \u65f6\uff09\u6216\u4e8c\u7ef4\u6570\u503c\u77e9\u9635","items":{"type":"string"},"type":"array"},"data":{"description":"\u6837\u672c\u8868\uff1a\u6bcf\u884c\u4e00\u4e2a\u53d7\u8bd5\u8005\u7684\u5b57\u5178\uff0c\u5982 [{\"treat\":1,\"age\":62,\"sex\":0}, \u2026]\uff08\u4e5f\u53ef\u6539\u7528 treatment/covariates \u76f4\u63a5\u4f20\u6570\u7ec4\uff09","items":{"type":"object"},"type":"array"},"ratio":{"description":"\u5339\u914d\u6bd4\u4f8b 1:k \u4e2d\u7684 k\uff0c\u9ed8\u8ba4 1\u3002","type":"integer"},"records":{"description":"\u9010\u4f8b\u539f\u59cb\u8bb0\u5f55\uff08\u5bf9\u8c61\u6570\u7ec4\uff0c\u6bcf\u884c\u542b\u534f\u53d8\u91cf\u4e0e\u5206\u7ec4\u5217\uff09\u3002\u4f20\u4e86\u624d\u80fd\u56de\u6eaf\u5339\u914d\u524d\u540e\u7a76\u7adf\u662f\u54ea\u51e0\u4f8b\uff0c\u5426\u5219\u53ea\u5f97\u5230\u5339\u914d\u540e\u7684\u7edf\u8ba1\u91cf\u3001\u65e0\u6cd5\u6838\u5bf9\u4e2a\u4f53\u3002","items":{"type":"string"},"type":"array"},"rows":{"description":"records \u7684\u5386\u53f2\u522b\u540d\uff08\u7b49\u4ef7\uff0c\u4e24\u8005\u90fd\u8ba4\uff09\u3002\u65b0\u4ee3\u7801\u5efa\u8bae\u7edf\u4e00\u7528 records\u3002","items":{"type":"string"},"type":"array"},"treatment":{"description":"\u5904\u7406\u53d8\u91cf\uff081=\u5904\u7406\u7ec4\uff0c0=\u5bf9\u7167\u7ec4\uff09\u3002\u4f20 data \u65f6\u586b\u5217\u540d \"treat\"\uff1b\u4e5f\u53ef\u76f4\u63a5\u4f20 0/1 \u6570\u7ec4","type":"string"}},"required":["treatment","covariates"],"type":"object"},"name":"propensity_score_matching","title":"Propensity score matching (PSM) / \u503e\u5411\u6027\u8bc4\u5206\u5339\u914d PSM"}
