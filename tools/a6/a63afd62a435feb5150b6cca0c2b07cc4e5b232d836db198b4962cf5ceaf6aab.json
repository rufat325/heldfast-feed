{
 "description": "Record high-intent demand for a capability an agent wants fulfilled. Supplier contact and spending are not enabled yet.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "authority": {
    "default": "get_quotes",
    "enum": [
     "research_only",
     "get_quotes",
     "may_commit_under_budget"
    ],
    "type": "string"
   },
   "categoryHint": {
    "maxLength": 200,
    "type": "string"
   },
   "currency": {
    "maxLength": 8,
    "type": "string"
   },
   "deadline": {
    "maxLength": 200,
    "type": "string"
   },
   "location": {
    "maxLength": 200,
    "type": "string"
   },
   "maxBudget": {
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "task": {
    "maxLength": 2000,
    "minLength": 3,
    "type": "string"
   },
   "telemetry": {
    "default": "aggregate_only",
    "enum": [
     "aggregate_only",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "submit_mandate"
}
