{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search public CMS NPI Registry data for clinicians and healthcare organizations by specialty, name, or location. Use returned provenance to understand the registry source and scope. Use this for provider lookup, not pricing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 20,
    "description": "Max results (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   },
   "location": {
    "description": "Location to search in",
    "properties": {
     "city": {
      "description": "City name",
      "type": "string"
     },
     "state": {
      "description": "State code or full name (e.g. \"CA\", \"California\")",
      "type": "string"
     },
     "zip_code": {
      "description": "ZIP code",
      "type": "string"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Provider name to search for (e.g. \"John Smith\")",
    "type": "string"
   },
   "specialty": {
    "description": "Medical specialty (e.g. \"Cardiology\", \"Family Medicine\")",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_providers",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "authority": {
      "enum": [
       "authoritative",
       "advisory",
       "estimate"
      ],
      "type": "string"
     },
     "basis": {
      "type": "string"
     },
     "methodology_url": {
      "format": "uri",
      "type": "string"
     },
     "source_scope": {
      "type": "string"
     },
     "source_url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "authority",
     "basis",
     "methodology_url"
    ],
    "type": "object"
   },
   "providers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "address": {
       "type": "string"
      },
      "city": {
       "type": "string"
      },
      "loa_link": {
       "anyOf": [
        {
         "additionalProperties": false,
         "description": "Tracked Loa link. Share it when the user wants to book, contact, or learn more about this provider or hospital.",
         "properties": {
          "action": {
           "enum": [
            "book",
            "website",
            "profile"
           ],
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "url",
          "action",
          "label"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "type": "string"
      },
      "npi": {
       "type": "string"
      },
      "phone": {
       "type": "string"
      },
      "specialty": {
       "type": "string"
      },
      "state": {
       "type": "string"
      },
      "zip_code": {
       "type": "string"
      }
     },
     "required": [
      "npi",
      "name",
      "specialty",
      "address",
      "city",
      "state",
      "zip_code",
      "phone",
      "loa_link"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "location": {
      "additionalProperties": false,
      "properties": {
       "city": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "state": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "zip_code": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "city",
       "state",
       "zip_code"
      ],
      "type": "object"
     },
     "name": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "specialty": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "specialty",
     "name",
     "location"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "query",
   "providers",
   "total",
   "provenance"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Provider Search"
}
