{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "destructiveHint": false,
  "priority": 1,
  "readOnlyHint": true
 },
 "description": "Search PoloPan products using image_url and optional filters. Returns products with available in-stock sizes, pricing, and verified purchase URLs (https://s.polopan.com/p/{handle}).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "gender": {
    "description": "Target gender filter: 'men', 'women', or 'unisex'",
    "type": "string"
   },
   "image_url": {
    "description": "Publicly accessible URL of the fashion image to search for visual matches",
    "format": "uri",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 20,
    "description": "Number of items to return per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "personalize": {
    "default": false,
    "description": "Whether to apply personalized ranking",
    "type": "boolean"
   },
   "price_max": {
    "description": "Maximum price in local currency",
    "type": "number"
   },
   "price_min": {
    "description": "Minimum price in local currency",
    "type": "number"
   },
   "size": {
    "description": "Array of sizes to filter by",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sort_by": {
    "default": "relevance",
    "description": "Sorting criteria for search results",
    "enum": [
     "relevance",
     "price",
     "title"
    ],
    "type": "string"
   },
   "sort_order": {
    "default": "desc",
    "description": "Sort order: 'asc' or 'desc'",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "vendor": {
    "description": "List of brand names to filter by",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "image_url"
  ],
  "type": "object"
 },
 "name": "products.search.image_url",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "products": {
    "description": "List of matching fashion products",
    "items": {
     "additionalProperties": false,
     "properties": {
      "handle": {
       "description": "Unique product handle identifier",
       "type": "string"
      },
      "price": {
       "description": "Current selling price",
       "type": "number"
      },
      "title": {
       "description": "Product name and title",
       "type": "string"
      },
      "url": {
       "description": "Verified purchase link",
       "type": "string"
      }
     },
     "required": [
      "handle",
      "title",
      "price",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "products"
  ],
  "type": "object"
 },
 "title": "Search Products By Image URL"
}
