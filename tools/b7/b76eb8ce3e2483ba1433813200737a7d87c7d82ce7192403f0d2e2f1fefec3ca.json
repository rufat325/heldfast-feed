{
 "description": "Search for beers by name",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "q": {
    "description": "Beer name search query",
    "type": "string"
   },
   "sort": {
    "description": "Sort order: checkin (default), name, count",
    "enum": [
     "checkin",
     "name",
     "count"
    ],
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search_beer"
}
