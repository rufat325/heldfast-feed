     "hostname": {
      "type": "string"
     },
     "status": {
      "enum": [
       "ok",
       "missing",
       "mismatch",
       "generic",
       "unavailable"
      ],
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "rule_sources": {
