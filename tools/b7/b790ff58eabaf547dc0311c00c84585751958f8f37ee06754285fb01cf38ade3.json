{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether mail from a domain will reach Gmail or Outlook, or why it is rejected or goes to spam, such as \"will Gmail accept mail from example.com sent from 203.0.113.7?\". Pass the domain, the sending IPv4 address if known and, optionally, up to 5 DKIM selectors. Returns one verdict (likely_accepted, at_risk, likely_rejected or incomplete) with a verdict per provider, the top 3 causes each with one fix, every rule checked with its official source link (SPF for the IP, DKIM, DMARC, reverse DNS, blocklists), the 6 blocklists with their terms links, what was not checked, and the source and as_of date. Gmail and Outlook are always both reported, so there is no provider argument. It reads public DNS and free blocklists only: it sends no test message and cannot see sender reputation, so it does not promise inbox placement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dkim_selectors": {
    "description": "DKIM selector names, the s= value in a DKIM-Signature header, such as [\"google\"]. Optional: when omitted, 10 usual selector names are tried. At most 5.",
    "items": {
     "maxLength": 63,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9._-]+$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "domain": {
    "description": "The domain in the From address, such as \"example.com\". A web address or an email address is reduced to its domain.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "sending_ip": {
    "description": "The public IPv4 address your mail is sent from, such as 203.0.113.7. Optional: without it the IP checks (SPF for the address, reverse DNS, IP blocklists) are skipped. IPv6 is not supported.",
    "maxLength": 15,
    "minLength": 7,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "delivery_check",
 "outputSchema": {
  "properties": {
   "as_of": {
    "type": "string"
   },
   "blocklists": {
    "items": {
     "properties": {
      "checked": {
       "enum": [
        "ip",
        "domain"
       ],
       "type": "string"
      },
      "list": {
       "type": "string"
      },
      "reply": {
       "type": "string"
      },
      "status": {
       "enum": [
        "listed",
        "clear",
        "unknown"
       ],
       "type": "string"
      },
      "terms": {
       "type": "string"
      },
      "zone": {
       "type": "string"
      }
     },
     "required": [
      "list",
      "zone",
      "checked",
      "status",
      "terms"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "by_provider": {
    "properties": {
     "gmail": {
      "enum": [
       "likely_accepted",
       "at_risk",
       "likely_rejected",
       "incomplete"
      ],
      "type": "string"
     },
     "outlook": {
      "enum": [
       "likely_accepted",
       "at_risk",
       "likely_rejected",
       "incomplete"
      ],
      "type": "string"
     }
    },
    "required": [
     "gmail",
     "outlook"
    ],
    "type": [
     "object",
     "null"
    ]
   },
   "dkim": {
    "properties": {
     "named": {
      "type": "boolean"
     },
     "probes": {
      "items": {
       "properties": {
        "found": {
         "type": [
          "boolean",
          "null"
         ]
        },
        "key_bits": {
         "type": "number"
        },
        "selector": {
         "type": "string"
        }
       },
       "required": [
        "selector",
        "found"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "named",
     "probes"
    ],
    "type": "object"
   },
   "domain": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "not_checked": {
    "items": {
     "properties": {
      "note": {
       "type": "string"
      },
      "source": {
       "type": "string"
      },
      "topic": {
       "type": "string"
      }
     },
     "required": [
      "topic",
      "note",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notice": {
    "type": "string"
   },
   "reverse_dns": {
