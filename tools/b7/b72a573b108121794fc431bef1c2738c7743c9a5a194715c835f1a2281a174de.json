{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Prepare deletion of an existing preview. Does not delete until its owner confirms in the browser holding the management key.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm_delete": {
    "const": true,
    "type": "boolean"
   },
   "preview_id": {
    "pattern": "^pv_[A-Za-z0-9_-]{24}$",
    "type": "string"
   }
  },
  "required": [
   "preview_id",
   "confirm_delete"
  ],
  "type": "object"
 },
 "name": "delete_preview"
}
