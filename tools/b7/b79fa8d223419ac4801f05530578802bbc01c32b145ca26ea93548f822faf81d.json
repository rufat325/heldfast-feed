{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search a selected library's public official registry when available, with a verified metadata-only fallback.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "library_id": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "live": {
    "default": true,
    "type": "boolean"
   },
   "query": {
    "default": "",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "library_id"
  ],
  "type": "object"
 },
 "name": "search_components",
 "title": "Search official component metadata"
}
