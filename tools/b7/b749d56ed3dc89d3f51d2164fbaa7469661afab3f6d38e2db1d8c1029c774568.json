{
 "description": "Execute an AMM swap. Swaps tokens through a liquidity pool with 0.3% fee. Returns the executed swap details.",
 "inputSchema": {
  "properties": {
   "amount_in": {
    "description": "Amount of input token",
    "type": "number"
   },
   "min_amount_out": {
    "description": "Minimum acceptable output (slippage protection)",
    "type": "number"
   },
   "token_in": {
    "description": "Input token",
    "enum": [
     "ECO",
     "BTC",
     "ETH"
    ],
    "type": "string"
   },
   "token_out": {
    "description": "Output token",
    "enum": [
     "ECO",
     "BTC",
     "ETH"
    ],
    "type": "string"
   }
  },
  "required": [
   "token_in",
   "token_out",
   "amount_in"
  ],
  "type": "object"
 },
 "name": "execute_swap"
}
