{
 "_meta": {
  "openai/fileParams": [
   "files"
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this only after the user explicitly confirms that the prepared production brief, one reply channel (email or Telegram), and selected files should be sent to objekts for human production review. A contactless human-review submission is not allowed because the producer must be able to answer the user. When the host already has the files, pass them through the files field instead of making the user upload them again. Do not use it for local analysis, estimation, or when the user has said not to send anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brief": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "contact": {
    "properties": {
     "company": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "email": {
      "anyOf": [
       {
        "format": "email",
        "maxLength": 320,
        "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "name": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "telegram": {
      "anyOf": [
       {
        "maxLength": 200,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "type": "object"
   },
   "files": {
    "items": {
     "properties": {
      "download_url": {
       "maxLength": 4096,
       "type": "string"
      },
      "file_id": {
       "maxLength": 512,
       "type": "string"
      },
      "file_name": {
       "maxLength": 255,
       "type": "string"
      },
      "mime_type": {
       "maxLength": 200,
       "type": "string"
      }
     },
     "required": [
      "download_url",
      "file_id"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "selectedAssetIds": {
    "items": {
     "maxLength": 128,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "required": [
   "confirmed",
   "contact",
   "brief"
  ],
  "type": "object"
 },
 "name": "submit_production_brief",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "type": "string"
   },
   "status": {
    "const": "RECEIVED",
    "type": "string"
   },
   "submissionId": {
    "type": "string"
   }
  },
  "required": [
   "submissionId",
   "status",
   "message"
  ],
  "type": "object"
 },
 "title": "Send production brief to objekts"
}
