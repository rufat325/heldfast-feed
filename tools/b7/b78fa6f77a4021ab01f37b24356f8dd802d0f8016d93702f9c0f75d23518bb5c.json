{
 "description": "List orders with optional filters",
 "inputSchema": {
  "properties": {
   "limit": {
    "description": "Number of results",
    "type": "number"
   },
   "side": {
    "description": "Filter by side",
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by status",
    "enum": [
     "open",
     "filled",
     "cancelled",
     "partially_filled"
    ],
    "type": "string"
   },
   "symbol": {
    "description": "Trading pair symbol",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "list_orders"
}
