{
 "description": "Inspect a local media file (absolute path under the configured media dir) and return its duration, video/audio codecs, audio sample rate, and byte size. Probes via ffprobe directly so it never writes to stdout.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "path": {
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "probe_media",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audioCodec": {
    "type": [
     "string",
     "null"
    ]
   },
   "durationSeconds": {
    "type": [
     "number",
     "null"
    ]
   },
   "sampleRate": {
    "type": [
     "number",
     "null"
    ]
   },
   "sizeBytes": {
    "type": "number"
   },
   "videoCodec": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "durationSeconds",
   "videoCodec",
   "audioCodec",
   "sampleRate",
   "sizeBytes"
  ],
  "type": "object"
 },
 "title": "Probe Media"
}
