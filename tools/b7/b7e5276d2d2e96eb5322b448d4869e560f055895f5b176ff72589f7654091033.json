{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read what changed since a moment"
 },
 "description": "Returns new matches, board-status changes, employer-mail threads and Autopilot state since the supplied timestamp. asOf is the next watermark. Match discovery includes overlapHours, defaulting to 72, before since because listings may become servable after first discovery; repeated ids can appear. Truncation counts identify older changes excluded by caps. Reading marks no mail read and creates no schedule.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "overlapHours": {
    "description": "How far before `since` to look for new matches; 72 when omitted.",
    "maximum": 168,
    "minimum": 0,
    "type": "integer"
   },
   "since": {
    "description": "The previous result's `asOf`, or when the person last checked.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
 "name": "get_updates_since",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applicationChanges": {
    "description": "Board cards that moved since `since`, newest first, at most twenty.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "applicationId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "company": {
       "type": "string"
      },
      "matchId": {
       "type": "string"
      },
      "status": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "updatedAt": {
       "type": "string"
      }
     },
     "required": [
      "matchId",
      "applicationId",
      "title",
      "company",
      "status",
      "updatedAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "applicationChangesTruncated": {
    "description": "How many older board moves were cut off by that cap. They fall before the next call's watermark, so a nonzero value means: do not advance past these changes - call get_pipeline (or repeat with an earlier `since`) before moving the watermark, or they are lost.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "asOf": {
    "type": "string"
   },
   "autopilot": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "nextRunAt": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "sentThisMonth": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "sentToday": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "state": {
        "enum": [
         "off",
         "on",
         "paused",
         "unavailable"
        ],
        "type": "string"
       }
      },
      "required": [
       "state",
       "sentToday",
       "sentThisMonth",
       "nextRunAt"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "matchPoolStatus": {
    "anyOf": [
     {
      "enum": [
       "ready",
       "building"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "matchesAddedAfter": {
    "type": "string"
   },
   "moreMatches": {
    "type": "boolean"
   },
   "newMail": {
    "description": "Threads where the employer wrote since `since`, newest first, at most ten.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "type": "string"
      },
      "jobTitle": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "anyOf": [
        {
         "enum": [
          "rejection",
          "interview",
          "recruiter_reply",
          "ats_confirmation",
          "other"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastMessageAt": {
       "type": "string"
      },
      "needsReply": {
       "type": "boolean"
      },
      "preview": {
       "type": "string"
      },
      "threadId": {
       "type": "string"
      },
      "unread": {
       "type": "boolean"
      }
     },
     "required": [
      "threadId",
      "company",
      "jobTitle",
      "kind",
      "needsReply",
      "unread",
      "lastMessageAt",
      "preview"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "newMatches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "applied": {
       "type": "boolean"
      },
      "company": {
       "type": "string"
      },
      "firstSeenAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "id": {
       "type": "string"
      },
      "location": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "matchPercent": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "postedAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "remote": {
       "anyOf": [
        {
         "type": "boolean"
        },
        {
         "type": "null"
        }
       ]
      },
      "salary": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "saved": {
       "type": "boolean"
      },
      "score": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "type": "string"
      },
      "url": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "default": null,
       "description": "The job's page on Dreamwork. sourceUrl, where present, is the employer's direct posting."
      },
      "whyItMatches": {
       "description": "The matcher's own reasons for this person, when it recorded any.",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "id",
      "title",
      "company",
      "location",
      "url",
      "remote",
      "salary",
      "postedAt",
      "score",
      "saved",
      "applied",
      "whyItMatches",
      "matchPercent",
      "firstSeenAt"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "asOf",
   "matchesAddedAfter",
   "newMatches",
   "moreMatches",
   "matchPoolStatus",
   "applicationChanges",
   "applicationChangesTruncated",
   "newMail",
   "autopilot",
   "notes"
  ],
  "type": "object"
 },
 "title": "Read what changed since a moment"
}
