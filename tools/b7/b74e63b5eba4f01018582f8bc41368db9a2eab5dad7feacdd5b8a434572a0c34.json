     "id": "r",
     "items": [
      {
       "qty": 1,
       "sku": "s"
      }
     ],
     "meta": {
      "source": "api"
     }
    }
   }
  },
  "required": [
   "reference",
   "documents"
  ],
  "type": "object"
 },
 "name": "json_structural_drift",
