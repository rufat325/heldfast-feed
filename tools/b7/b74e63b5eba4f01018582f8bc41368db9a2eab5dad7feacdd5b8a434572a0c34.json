 "description": "Compare a batch of documents against one reference document and report where the shape drifted: locations the reference has that the batch lacks, locations that changed type, and locations the batch added. Array indices are generalised, so a two-item list and a three-item list are the same shape. Useful when you have an example payload and no schema. Pay 100000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allow_additional": {
    "description": "Treat locations absent from the reference as acceptable. Defaults to false; when set, they are still counted and listed.",
    "type": "boolean"
   },
   "documents": {
    "example": [
     {
      "amount": 2,
      "id": "a",
      "items": [
       {
        "qty": 1,
        "sku": "s1"
       },
       {
        "qty": 2,
        "sku": "s2"
       }
      ],
      "meta": {
       "source": "api"
      }
     },
     {
      "amount": "3",
      "id": "b",
      "items": [
       {
        "sku": "s3"
       }
      ],
      "meta": {
       "source": "api",
       "trace_id": "x"
      }
     }
    ],
    "items": {
     "description": "Any JSON value you supply. Nothing is fetched, so this works on payloads nothing could reach.",
     "example": {
      "amount": 1,
      "id": "r",
      "items": [
       {
        "qty": 1,
        "sku": "s"
       }
      ],
      "meta": {
       "source": "api"
      }
     }
    },
    "maxItems": 500,
