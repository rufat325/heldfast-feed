{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Share price history"
 },
 "description": "Use this when someone asks how a listed company's share price moved over a period, its closing price on a past day, or its high and low over weeks or months. Give it the ticker or name, and optionally from and to dates (YYYY-MM-DD; default the last 90 days, at most 366 days). Returns daily open, high, low, close and volume in the listing's currency, the change over the period, the first and latest day 6ix holds for the listing (also when the period asked for falls outside them), and the company's 6ix.com page.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "company": {
    "description": "Ticker (AAPL, NYSE:BAC, SHOP.TO), company name, or the 6ix company link returned by find_company",
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "First day, YYYY-MM-DD",
    "maxLength": 10,
    "type": "string"
   },
   "to": {
    "description": "Last day, YYYY-MM-DD; default today",
    "maxLength": 10,
    "type": "string"
   }
  },
  "required": [
   "company"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "outputSchema": {
  "properties": {
   "asOf": {
    "description": "When 6ix answered (ISO 8601, UTC)",
    "type": "string"
   },
   "attribution": {
    "type": [
     "string",
     "null"
    ]
   },
   "bars": {
    "items": {
     "properties": {
      "close": {
       "type": "number"
      },
      "day": {
       "type": "string"
      },
      "high": {
       "type": [
        "number",
        "null"
       ]
      },
      "low": {
       "type": [
        "number",
        "null"
       ]
      },
      "open": {
       "type": [
        "number",
        "null"
       ]
      },
      "volume": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "day",
      "close"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "company": {
    "properties": {
     "exchange": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "ticker": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "name",
     "url"
    ],
    "type": "object"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "from": {
    "type": "string"
   },
   "listing": {
    "properties": {
     "exchange": {
      "type": [
       "string",
       "null"
      ]
     },
     "ticker": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "record": {
    "description": "The first and latest day 6ix holds daily prices for this listing (YYYY-MM-DD); null when it holds none",
    "properties": {
     "from": {
      "type": [
       "string",
       "null"
      ]
     },
     "to": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "status": {
    "description": "no_licence: 6ix may not give out prices for this exchange; not_covered: no price on 6ix for this listing yet",
    "enum": [
     "priced",
     "no_licence",
     "not_covered"
    ],
    "type": "string"
   },
   "summary": {
    "type": [
     "object",
     "null"
    ]
   },
   "to": {
    "type": "string"
   }
  },
  "required": [
