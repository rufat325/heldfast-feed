{
 "description": "POST /v1/blobs/{blob_id}/parse \u2014 extract text/tables; set async=true for QStash. Optional callback_url in JSON body. Requires LITHTRIX_API_KEY.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "async": {
    "description": "When true, calls ?async=true (async parse + poll)",
    "type": "boolean"
   },
   "blob_id": {
    "description": "Content-addressed blob id (b_ + 16 hex chars)",
    "maxLength": 19,
    "minLength": 19,
    "pattern": "^b_[0-9a-f]{16}$",
    "type": "string"
   },
   "callback_url": {
    "description": "HTTPS callback for async completion (public host)",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "blob_id"
  ],
  "type": "object"
 },
 "name": "lithtrix_blob_parse"
}
