{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Add an item (Assignment, Page, Quiz, File, Discussion, ExternalUrl, ExternalTool, SubHeader) to a module.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "content_id": {
    "description": "Canvas ID of the content (required for File, Page, Discussion, Assignment, Quiz)",
    "type": "number"
   },
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "external_url": {
    "description": "URL for ExternalUrl or ExternalTool items",
    "type": "string"
   },
   "module_id": {
    "description": "The Canvas module ID",
    "type": "number"
   },
   "position": {
    "description": "Position within the module",
    "type": "number"
   },
   "title": {
    "description": "Title of the module item",
    "type": "string"
   },
   "type": {
    "description": "Type of content to add",
    "enum": [
     "File",
     "Page",
     "Discussion",
     "Assignment",
     "Quiz",
     "ExternalUrl",
     "ExternalTool",
     "SubHeader"
    ],
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "module_id",
   "title",
   "type"
  ],
  "type": "object"
 },
 "name": "create_module_item",
 "title": "Create Module Item"
}
