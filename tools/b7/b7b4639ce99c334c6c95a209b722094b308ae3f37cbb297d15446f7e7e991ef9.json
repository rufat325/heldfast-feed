{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "openid",
     "email",
     "profile"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Save the user's 1-5 rating and optional quality category/comment against one completed playable video export. Replaces that user's previous feedback for this export; does not change accepted clips or defaults. Requires the feedback storage migration to be installed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "category": {
    "anyOf": [
     {
      "enum": [
       "moments",
       "captions",
       "pacing",
       "framing",
       "editing",
       "export",
       "other"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "comment": {
    "maxLength": 2000,
    "type": "string"
   },
   "exportId": {
    "description": "UUID string.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "rating": {
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "workspaceId": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "workspaceId",
   "idempotencyKey",
   "exportId",
   "rating",
   "category",
   "comment"
  ],
  "type": "object"
 },
 "name": "video_feedback_save",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Save Video Quality Feedback"
}
