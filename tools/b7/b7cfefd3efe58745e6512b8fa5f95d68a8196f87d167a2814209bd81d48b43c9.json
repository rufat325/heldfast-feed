      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode. Declared by this tool: `incompatible_game_source`: An MLB game ID is used with another league. `game_not_found`: The provider explicitly reports that the game does not exist in this league. Other values are possible when a failure originates below the handler.",
        "examples": [
         "incompatible_game_source",
         "game_not_found"
        ],
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
