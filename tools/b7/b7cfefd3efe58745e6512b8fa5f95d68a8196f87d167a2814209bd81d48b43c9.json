      "category",
      "label",
      "player",
      "displayValue"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "league": {
    "description": "The league queried.",
    "type": "string"
   },
   "nextOffset": {
    "description": "Next scoring-play offset; null at the end.",
    "type": [
