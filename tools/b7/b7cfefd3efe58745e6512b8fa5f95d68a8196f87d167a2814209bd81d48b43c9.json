{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Game metadata, period scores, team totals, provider top performers, and scoring plays. Pass a game ID returned by sports_get_scores, sports_get_schedule, or sports_get_team with its league; ESPN IDs do not identify a league. Scheduled games return metadata with empty played-stat sections. Scoring plays default to 20 per page, capped at 50; continue with nextOffset and the same league and game_id. Other sections remain on every page. No full player boxscores or season statistics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "game_id": {
    "description": "Source-prefixed numeric game ID, e.g. espn:401872981. mlb: IDs require league mlb.",
    "maxLength": 32,
    "pattern": "^(espn|mlb):[0-9]+$",
    "type": "string"
   },
   "league": {
    "description": "Supported league of the game; required to route ESPN IDs.",
    "enum": [
     "nfl",
     "nba",
     "mlb",
     "nhl",
     "epl",
     "mls",
     "laliga",
     "bundesliga",
     "seriea",
     "ligue1",
     "ucl",
     "ncaaf",
     "ncaab"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Scoring plays requested per page. Defaults to 20; values above 50 are clipped and disclosed.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Zero-based scoring-play offset. Defaults to 0; use nextOffset to continue.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "league",
   "game_id"
  ],
  "type": "object"
 },
 "name": "sports_get_game",
