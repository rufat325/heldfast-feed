{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Raise an invoice in FreeAgent. Created as a DRAFT \u2014 it is not sent to the client. Use freeagent_update_invoice_status with 'mark_as_sent' once you have issued it.\n\nFind the contact with freeagent_list_contacts and the income category with freeagent_list_categories (income categories, e.g. 001 Sales).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comments": {
    "description": "Notes shown on the invoice",
    "maxLength": 2000,
    "type": "string"
   },
   "contact": {
    "description": "Contact to invoice",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/contacts\\/\\d+$",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 currency (default: company currency)",
    "pattern": "^[A-Z]{3}$",
    "type": "string"
   },
   "datedOn": {
    "description": "Invoice date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "discountPercent": {
    "description": "Discount percentage (e.g. '10.0')",
    "pattern": "^\\d+(\\.\\d+)?$",
    "type": "string"
   },
   "ecStatus": {
    "description": "VAT treatment for the sale. Defaults to 'UK/Non-EC' \u2014 set it for an overseas client or a reverse-charge sale, or the VAT return reports it in the wrong box.",
    "enum": [
     "UK/Non-EC",
     "EC Goods",
     "EC Services",
     "Reverse Charge",
     "EC VAT MOSS"
    ],
    "type": "string"
   },
   "items": {
    "description": "Invoice line items \u2014 at least one",
    "items": {
     "additionalProperties": false,
     "properties": {
      "categoryUrl": {
       "description": "Income category (e.g. '/v2/categories/001' for Sales)",
       "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/categories\\/\\d+$",
       "type": "string"
      },
      "description": {
       "description": "Line description",
       "maxLength": 2000,
       "minLength": 1,
       "type": "string"
      },
      "itemType": {
       "default": "Services",
       "description": "Line type (default Services)",
       "enum": [
        "Hours",
        "Days",
        "Weeks",
        "Months",
        "Years",
        "Products",
        "Services",
        "Training",
        "Expenses",
        "Comment",
        "Bills",
        "Discount",
        "Credit",
        "VAT",
        "Stock"
       ],
       "type": "string"
      },
      "price": {
       "description": "Unit price as a string (e.g. '750.00')",
       "pattern": "^-?\\d+(\\.\\d{1,2})?$",
       "type": "string"
      },
      "quantity": {
       "default": "1.0",
       "description": "Quantity (e.g. '1.0', or hours/days for time-based types)",
       "pattern": "^-?\\d+(\\.\\d+)?$",
       "type": "string"
      },
      "salesTaxRate": {
       "description": "VAT rate as a string (e.g. '20.0')",
       "pattern": "^\\d+(\\.\\d+)?$",
       "type": "string"
      },
      "salesTaxStatus": {
       "description": "Whether this line is taxable or exempt (default: TAXABLE)",
       "enum": [
        "TAXABLE",
        "EXEMPT"
       ],
       "type": "string"
      }
     },
     "required": [
      "description",
      "price"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "minItems": 1,
    "type": "array"
   },
   "paymentTermsInDays": {
    "default": 30,
    "description": "Payment terms in days (default 30) \u2014 sets the due date",
    "maximum": 365,
    "minimum": 0,
    "type": "integer"
   },
   "placeOfSupply": {
    "description": "Country whose VAT rate applies \u2014 required when ecStatus is 'EC VAT MOSS'",
    "maxLength": 100,
    "type": "string"
   },
   "poReference": {
    "description": "Client purchase order reference",
    "maxLength": 100,
    "type": "string"
   },
   "project": {
    "description": "Project this invoice belongs to",
    "pattern": "^(?:https:\\/\\/api\\.freeagent\\.com)?\\/v2\\/projects\\/\\d+$",
    "type": "string"
   },
   "reference": {
    "description": "Invoice reference/number. FreeAgent auto-numbers if omitted.",
    "maxLength": 100,
    "type": "string"
   }
  },
  "required": [
   "contact",
   "datedOn",
   "items"
  ],
  "type": "object"
 },
 "name": "freeagent_create_invoice"
}
