{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Log a ground-truth expectation on a trace",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "metadata": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "name": {
    "description": "Expectation name (e.g. 'expected_answer')",
    "type": "string"
   },
   "rationale": {
    "type": "string"
   },
   "source": {
    "properties": {
     "source_id": {
      "description": "Source identifier (e.g. user email)",
      "type": "string"
     },
     "source_type": {
      "description": "Source type",
      "enum": [
       "HUMAN",
       "LLM_JUDGE",
       "CODE",
       "AI_JUDGE"
      ],
      "type": "string"
     }
    },
    "required": [
     "source_type"
    ],
    "type": "object"
   },
   "traceId": {
    "description": "Trace ID",
    "type": "string"
   },
   "value": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Ground-truth value"
   }
  },
  "required": [
   "traceId",
   "name",
   "value"
  ],
  "type": "object"
 },
 "name": "log-expectation"
}
