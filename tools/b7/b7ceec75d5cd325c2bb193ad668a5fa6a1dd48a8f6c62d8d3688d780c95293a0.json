{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Workflow execution status"
 },
 "description": "Get the current state and result of a workflow execution.\n\nStatuses: RUNNING | COMPLETED | FAILED | CANCELED | TERMINATED |\n          CONTINUED_AS_NEW | TIMED_OUT | RETRYING_AFTER_ERROR\n\nPoll until status is COMPLETED (or terminal) when waitForResult was false.\n`result` is populated once the workflow reaches a terminal state.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "executionId": {
    "description": "Execution ID from workflow_execute.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "executionId"
  ],
  "type": "object"
 },
 "name": "workflow_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "end_time": {
    "type": [
     "string",
     "null"
    ]
   },
   "execution_id": {
    "type": "string"
   },
   "result": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   },
   "root_execution_id": {
    "type": "string"
   },
   "start_time": {
    "type": "string"
   },
   "status": {
    "type": [
     "string",
     "null"
    ]
   },
   "total_duration_ms": {
    "type": [
     "number",
     "null"
    ]
   },
   "workflow_name": {
    "type": "string"
   }
  },
  "required": [
   "workflow_name",
   "execution_id",
   "root_execution_id",
   "status",
   "start_time",
   "end_time"
  ],
  "type": "object"
 },
 "title": "Get workflow execution status"
}
