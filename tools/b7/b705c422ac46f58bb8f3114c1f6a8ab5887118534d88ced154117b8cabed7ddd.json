{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "readOnlyHint": false
 },
 "description": "Update any fields of an existing product by productId (partial update). Prices in integer cents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "categoryId": {
    "type": "string"
   },
   "compare_at_price_cents": {
    "minimum": 0,
    "type": "integer"
   },
   "description": {
    "type": "string"
   },
   "featured": {
    "type": "boolean"
   },
   "fulfillment_vendor_id": {
    "description": "Route orders to a fulfillment vendor; empty string un-routes",
    "type": "string"
   },
   "images": {
    "items": {
     "format": "uri",
     "type": "string"
    },
    "type": "array"
   },
   "inventory": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "name": {
    "type": "string"
   },
   "options": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "values": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "values"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "price_cents": {
    "description": "Price in integer CENTS (e.g. 1999 = $19.99). Never send dollars.",
    "minimum": 0,
    "type": "integer"
   },
   "productId": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "active"
    ],
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "variants": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "inventory": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "null = untracked/unlimited"
      },
      "name": {
       "type": "string"
      },
      "optionValues": {
       "additionalProperties": {
        "type": "string"
       },
       "description": "Axis map, e.g. {\"Size\":\"M\",\"Color\":\"Navy\"}",
       "type": "object"
      },
      "price_cents": {
       "$ref": "#/properties/price_cents"
      },
      "sku": {
       "type": "string"
      },
      "vendor_sku": {
       "description": "Fulfillment vendor's item number for THIS variant (overrides the product-level vendor_sku on vendor order sheets)",
       "type": "string"
      }
     },
     "required": [
      "name",
      "price_cents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "vendor_notes": {
    "description": "Standing per-product instruction for the vendor",
    "type": "string"
   },
   "vendor_sku": {
    "description": "The vendor's item number for this product",
    "type": "string"
   }
  },
  "required": [
   "productId"
  ],
  "type": "object"
 },
 "name": "update_product"
}
