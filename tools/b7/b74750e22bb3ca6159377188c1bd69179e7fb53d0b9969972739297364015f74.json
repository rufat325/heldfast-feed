{
 "annotations": {
  "readOnlyHint": true,
  "title": "Query a saved funnel"
 },
 "description": "Get conversion data for a saved funnel (use mixpanel_list_funnels to find funnel_id). Query API: GET /funnels.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from_date": {
    "description": "Start date yyyy-mm-dd (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "funnel_id": {
    "description": "Saved funnel id (from mixpanel_list_funnels).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "interval": {
    "description": "Number of days per bucket.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "length": {
    "description": "Conversion window length.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "length_unit": {
    "description": "Unit for `length`.",
    "enum": [
     "day",
     "hour",
     "minute",
     "second",
     "week",
     "month"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Limit on segmentation breakdown.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "to_date": {
    "description": "End date yyyy-mm-dd (inclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "unit": {
    "description": "Bucketing unit.",
    "enum": [
     "day",
     "week",
     "month"
    ],
    "type": "string"
   }
  },
  "required": [
   "funnel_id",
   "from_date",
   "to_date"
  ],
  "type": "object"
 },
 "name": "mixpanel_query_funnel",
 "title": "Query a saved funnel"
}
