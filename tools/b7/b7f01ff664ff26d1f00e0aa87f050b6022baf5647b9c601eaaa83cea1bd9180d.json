{
 "_meta": {
  "lovie/risk": "read",
  "openai/toolInvocation/invoked": "Loaded",
  "openai/toolInvocation/invoking": "Loading\u2026",
  "openai/visibility": "private",
  "securitySchemes": [
   {
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read an agent's settled spend broken down by counterparty and rail over an optional time window.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "maxLength": 255,
    "pattern": "^[A-Za-z0-9_-]*$",
    "type": "string"
   },
   "signerId": {
    "maxLength": 255,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "since": {
    "format": "date-time",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "read_agent_spend",
 "outputSchema": {
  "properties": {
   "spend": {
    "anyOf": [
     {
      "properties": {
       "byCounterparty": {
        "additionalProperties": {
         "type": "string"
        },
        "type": "object"
       },
       "byRail": {
        "additionalProperties": {
         "type": "string"
        },
        "type": "object"
       },
       "totalCents": {
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "type": "object"
 },
 "title": "Get Agent Spend"
}
