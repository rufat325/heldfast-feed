{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Propose correlation keys from real traffic: fields that are near-unique per message and appear on more than one subject.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "contextId": {
    "type": "string"
   },
   "limit": {
    "description": "Required maximum number of results.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "maxScan": {
    "description": "Maximum messages scanned before returning a cursor (default 10000).",
    "maximum": 100000,
    "minimum": 1,
    "type": "integer"
   },
   "sample": {
    "description": "Messages to sample per subject (default 20).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "stream": {
    "type": "string"
   }
  },
  "required": [
   "contextId",
   "limit"
  ],
  "type": "object"
 },
 "name": "natstrail.suggest_correlation_keys"
}
