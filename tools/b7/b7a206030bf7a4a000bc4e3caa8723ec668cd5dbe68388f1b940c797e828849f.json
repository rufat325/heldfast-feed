{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Annotate"},"description":"Draw marks on a picture: arrows, boxes, freehand lines, text, numbers, a magnifier, pictures. Takes image files.","inputSchema":{"$defs":{"Mark":{"description":"A mark, its colour and its line width in pixels. (Unknown fields are refused by the shape,\nwhich gets every field but these two.)","oneOf":[{"properties":{"from":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"shape":{"const":"arrow","type":"string"},"to":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"}},"required":["shape","from","to"],"type":"object"},{"properties":{"a":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"b":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"shape":{"const":"rectangle","type":"string"}},"required":["shape","a","b"],"type":"object"},{"properties":{"a":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"b":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"shape":{"const":"ellipse","type":"string"}},"required":["shape","a","b"],"type":"object"},{"description":"A freehand line through the points.","properties":{"points":{"items":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"type":"array"},"shape":{"const":"pen","type":"string"}},"required":["shape","points"],"type":"object"},{"description":"A broad translucent stroke through the points.","properties":{"points":{"items":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"type":"array"},"shape":{"const":"highlight","type":"string"}},"required":["shape","points"],"type":"object"},{"description":"Text whose top-left corner is `at`; `size` is the font size in pixels.","properties":{"at":{"items":{"type":"number"},"maxItems":2,"minItems":2,"type":"array"},"shape":{"const":"text","type":"string"},"size":{"type":"number"},"text":{"type":"st