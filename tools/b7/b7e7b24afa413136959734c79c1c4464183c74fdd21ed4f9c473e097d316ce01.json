{
 "_meta": {
  "anthropic/requiresUserInteraction": true,
  "sato/effects": [
   "sign",
   "broadcast"
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Execute a prepared intent"
 },
 "description": "Signs and broadcasts one intent that a prepare tool returned, identified by its intent_id and nothing else. Use it after a person has read the intent summary, the simulation and the fee disclosure and approved that exact intent. Do not use it to change an amount, a recipient or a venue: prepare a new intent instead. It fails when the intent expired, was refused by the policy pre-flight, was already executed, or no signer is configured. Effect: moves funds on the chain named in the intent and appends a receipt to the local receipt log.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "intent_id": {
    "description": "The intent_id a prepare tool returned.",
    "pattern": "^si_[A-Za-z0-9_-]{43}$",
    "type": "string"
   }
  },
  "required": [
   "intent_id"
  ],
  "type": "object"
 },
 "name": "execute",
 "outputSchema": {
  "properties": {
   "action": {
    "type": "string"
   },
   "chain": {
    "enum": [
     "ethereum",
     "sepolia",
     "base",
     "base-sepolia",
     "arbitrum",
     "arbitrum-sepolia",
     "optimism",
     "optimism-sepolia",
     "polygon",
     "solana",
     "solana-devnet"
    ],
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "fee_disclosure": {
    "description": "The fee disclosure for the venue, quoted verbatim (object), or null when the action has none."
   },
   "hash": {
    "type": "string"
   },
   "intent_id": {
    "pattern": "^si_[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "mandate": {
    "type": "object"
   },
   "params_digest": {
    "type": "string"
   },
   "policy": {
    "properties": {
     "ok": {
      "type": "boolean"
     },
     "refusals": {
      "items": {
       "properties": {
        "limit": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "observed": {
         "type": "string"
        },
        "rule": {
         "type": "string"
        }
       },
       "required": [
        "rule",
        "limit",
        "observed",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "prev_hash": {
    "type": "string"
   },
   "schema": {
    "enum": [
     "sato.receipt/v1"
    ],
    "type": "string"
   },
   "seq": {
    "type": "integer"
   },
   "simulation": {
    "description": "The simulation the intent was prepared with (object)."
   },
   "status": {
    "enum": [
     "prepared",
     "refused",
     "executed",
     "failed",
     "expired"
    ],
    "type": "string"
   },
   "tx_hash": {
    "pattern": "^0x[0-9a-fA-F]{64}$",
    "type": "string"
   }
  },
  "required": [
   "schema",
   "seq",
   "hash",
   "intent_id",
   "action",
   "status",
   "created_at"
  ],
  "type": "object"
 },
 "title": "Execute a prepared intent"
}
