{
 "description": "Cut an immutable content snapshot of an Open Label dataset, persisting the cut-time recipe: split ratios assign every row's permanent train/val/test membership, and an optional augmentation config lets the version id alone reproduce an augmented export (replay with open_label_start_export + datasetVersionId + useVersionRecipe). Requires open-label:write scope.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "datasetId": {
    "description": "The dataset to snapshot.",
    "type": "string"
   },
   "label": {
    "description": "Human label for the version.",
    "type": "string"
   },
   "projectId": {
    "description": "The Open Label project id.",
    "type": "string"
   },
   "recipe": {
    "additionalProperties": false,
    "description": "Cut-time recipe: {split?, augmentation?}.",
    "properties": {
     "augmentation": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "multiplier": {
          "maximum": 10,
          "minimum": 2,
          "type": "number"
         },
         "ops": {
          "additionalProperties": false,
          "properties": {
           "blur": {
            "anyOf": [
             {
              "additionalProperties": false,
              "properties": {
               "maxSigma": {
                "type": "number"
               }
              },
              "required": [
               "maxSigma"
              ],
              "type": "object"
             },
             {
              "type": "null"
             }
            ]
           },
           "brightness": {
            "anyOf": [
             {
              "additionalProperties": false,
              "properties": {
               "amount": {
                "type": "number"
               }
              },
              "required": [
               "amount"
              ],
              "type": "object"
             },
             {
              "type": "null"
             }
            ]
           },
           "crop": {
            "anyOf": [
             {
              "additionalProperties": false,
              "properties": {
               "maxPercent": {
                "type": "number"
               }
              },
              "required": [
               "maxPercent"
              ],
              "type": "object"
             },
             {
              "type": "null"
             }
            ]
           },
           "flipHorizontal": {
            "type": "boolean"
           },
           "flipVertical": {
            "type": "boolean"
           },
           "grayscale": {
            "type": "boolean"
           },
           "hue": {
            "anyOf": [
             {
              "additionalProperties": false,
              "properties": {
               "maxDegrees": {
                "type": "number"
               }
              },
              "required": [
               "maxDegrees"
              ],
              "type": "object"
             },
             {
              "type": "null"
             }
            ]
           },
           "rotate": {
            "anyOf": [
             {
              "additionalProperties": false,
              "properties": {
               "maxDegrees": {
                "type": "number"
               }
              },
              "required": [
               "maxDegrees"
              ],
              "type": "object"
             },
             {
              "type": "null"
             }
            ]
           },
           "rotate90": {
            "type": "boolean"
           },
           "saturation": {
            "anyOf": [
             {
              "additionalProperties": false,
              "properties": {
               "amount": {
                "type": "number"
               }
              },
              "required": [
               "amount"
              ],
              "type": "object"
             },
             {
              "type": "null"
             }
            ]
           }
          },
          "type": "object"
         },
         "seed": {
          "type": "number"
         }
        },
        "required": [
         "multiplier"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "Augmentation recipe to persist for replay (null = none)."
     },
     "split": {
      "additionalProperties": false,
      "description": "Split ratios persisted as permanent membership (default 80/10/10).",
      "properties": {
       "test": {
        "type": "number"
       },
       "train": {
        "type": "number"
       },
       "val": {
        "type": "number"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "projectId",
   "datasetId"
  ],
  "type": "object"
 },
 "name": "open_label_cut_dataset_version",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
