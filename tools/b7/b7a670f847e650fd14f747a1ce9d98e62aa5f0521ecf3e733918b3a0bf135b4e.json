{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new queue. Requires key, name, lead, default type/priority and an issueTypesConfig array binding issue types to workflow templates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "defaultPriority": {
    "description": "Default issue priority key, e.g. \"normal\"",
    "type": "string"
   },
   "defaultType": {
    "description": "Default issue type key, e.g. \"task\"",
    "type": "string"
   },
   "issueTypesConfig": {
    "description": "Issue type configs of the queue",
    "items": {
     "properties": {
      "issueType": {
       "description": "Issue type key, e.g. \"task\", \"bug\"",
       "type": "string"
      },
      "resolutions": {
       "description": "Allowed resolution keys, e.g. [\"fixed\", \"wontFix\"]",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "workflow": {
       "description": "Workflow template id, e.g. \"developmentPresetWorkflow\", \"scrumDevelopmentPresetWorkflow\", \"basicSupportPresetWorkflow\", \"kanbanDevelopmentPresetWorkflow\"",
       "type": "string"
      }
     },
     "required": [
      "issueType",
      "workflow"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "key": {
    "description": "Unique queue key in latin letters, e.g. \"DESIGN\"",
    "type": "string"
   },
   "lead": {
    "description": "Queue owner login or user id",
    "type": "string"
   },
   "name": {
    "description": "Queue name",
    "type": "string"
   }
  },
  "required": [
   "key",
   "name",
   "lead",
   "defaultType",
   "defaultPriority",
   "issueTypesConfig"
  ],
  "type": "object"
 },
 "name": "create_queue"
}
