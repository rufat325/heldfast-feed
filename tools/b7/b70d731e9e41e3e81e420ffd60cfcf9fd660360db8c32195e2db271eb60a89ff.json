{
 "description": "Edit one exact employer milestone without moving money. Supply the updatedAt revision from opentrain_get_contract and reuse the same idempotencyKey for retries. Amount and volume are allowed only before funding; stale revisions fail closed. Requires payments:write and a claimed account.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "amountUsd": {
    "description": "Replacement amount; only before funding.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "contractId": {
    "description": "Exact contract that owns the milestone.",
    "minLength": 1,
    "type": "string"
   },
   "description": {
    "description": "Replacement milestone description.",
    "minLength": 1,
    "type": "string"
   },
   "dueDate": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replacement ISO-8601 due date; pass null to clear it."
   },
   "expectedUpdatedAt": {
    "description": "updatedAt revision from opentrain_get_contract; stale revisions are rejected.",
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Stable key for safe retries; reuse it only with the same edit payload.",
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "milestoneId": {
    "description": "Exact existing milestone to edit.",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Replacement milestone name.",
    "minLength": 1,
    "type": "string"
   },
   "volume": {
    "description": "Replacement hours/labels; only before funding.",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "contractId",
   "milestoneId",
   "expectedUpdatedAt",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_update_milestone",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
