  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "block": {
    "description": "block number or latest|safe|finalized|earliest|pending (default \"latest\")",
    "type": "string"
   },
   "chain": {
    "description": "chain key: base, ethereum, arbitrum, bsc, polygon, optimism, avalanche [required]",
    "type": "string"
   },
   "token": {
    "description": "token / NFT contract address [required]",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "token"
  ],
  "type": "object"
 },
