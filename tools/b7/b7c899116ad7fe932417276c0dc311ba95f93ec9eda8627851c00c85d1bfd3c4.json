{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "title": "Snooze task"
 },
 "description": "Reschedule a task to a new date.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "date": {
    "description": "New date (YYYY-MM-DD)",
    "type": "string"
   },
   "date_type": {
    "description": "New date type: specific (has a due date, default), asap (do as soon as possible), one_day (someday/no rush)",
    "enum": [
     "specific",
     "asap",
     "one_day"
    ],
    "type": "string"
   },
   "id": {
    "description": "Task UUID",
    "format": "uuid",
    "type": "string"
   }
  },
  "required": [
   "id",
   "date"
  ],
  "type": "object"
 },
 "name": "snooze_task"
}
