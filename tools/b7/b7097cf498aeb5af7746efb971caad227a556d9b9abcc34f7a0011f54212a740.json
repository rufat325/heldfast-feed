{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "imagelato:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List your image projects"
 },
 "description": "Use this when someone asks which Imagelato projects they have, or a project's id is needed. Returns each project's id and name, 25 per page by default. Not for a project's processed images.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "The nextCursor of the previous page with the same filters; absent for the first page",
    "maxLength": 1024,
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   },
   "limit": {
    "description": "Results per page, from 1 to 100; defaults to 25",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "list_projects",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hasMore": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "name": {
       "anyOf": [
        {
         "maxLength": 120,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 1024,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cursor for the next page; null on the last page"
   },
   "total": {
    "description": "Matching records across all pages",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "items",
   "total",
   "hasMore",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "List your image projects"
}
