{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Browse Glossary by Category"
 },
 "description": "Browse all 351 glossary terms by category. Categories: Alternative Assets, Art, DeFi & Crypto, ESG & Climate, Behavioral Economics, Gender Lens Investing. Omit category to browse all terms.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "Category to browse \u2014 e.g. 'Art', 'DeFi & Crypto', 'ESG & Climate', 'Behavioral Economics', 'Alternative Assets', 'Gender Lens Investing'. Omit for all categories.",
    "type": "string"
   },
   "limit": {
    "description": "Max terms to return (default 25, max 100)",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "glossary.browse",
 "outputSchema": {
  "properties": {
   "categories_available": {
    "description": "All available glossary categories",
    "items": {
     "properties": {
      "count": {
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "category_requested": {
    "description": "The category filter applied",
    "type": "string"
   },
   "glossary_url": {
    "description": "URL to full glossary",
    "type": "string"
   },
   "terms": {
    "description": "Terms in the requested category",
    "items": {
     "properties": {
      "category": {
       "type": "string"
      },
      "definition": {
       "type": "string"
      },
      "term": {
       "type": "string"
      }
     },
     "required": [
      "term",
      "definition",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "terms_in_category": {
    "description": "Number of terms matching the category",
    "type": "integer"
   },
   "total_terms": {
    "description": "Total terms in the glossary",
    "type": "integer"
   }
  },
  "required": [
   "total_terms",
   "terms"
  ],
  "type": "object"
 },
 "title": "Browse Glossary by Category"
}
