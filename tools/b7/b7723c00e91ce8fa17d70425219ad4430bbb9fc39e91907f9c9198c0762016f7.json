{
 "description": "Read a text file from the device",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "device": {
    "description": "Device serial",
    "type": "string"
   },
   "maxLines": {
    "description": "Maximum lines to return (1-10000)",
    "maximum": 10000,
    "minimum": 1,
    "type": "number"
   },
   "path": {
    "description": "File path on device",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "adb_cat"
}
