{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Edit the linked account's SmartSite: display name, bio, and appearance (background color, a gradient of hex stops, a background image URL, theme/font color, font family, or header layout). Pass only what you want to change. For adding links/buttons/info bars use swop_add_link; for products use swop_create_product / swop_feature_product.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "backgroundColor": {
    "description": "Solid background hex, e.g. \"#0b0b0f\"",
    "type": "string"
   },
   "backgroundGradient": {
    "description": "Gradient hex stops, e.g. [\"#5b3df5\",\"#0b0b0f\"] (clears the solid color)",
    "items": {
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   },
   "backgroundImg": {
    "description": "Background/wallpaper image URL",
    "format": "uri",
    "type": "string"
   },
   "bio": {
    "description": "New bio text",
    "maxLength": 500,
    "type": "string"
   },
   "fontColor": {
    "description": "Primary font hex color",
    "type": "string"
   },
   "fontFamily": {
    "description": "Font family name",
    "type": "string"
   },
   "headerFormat": {
    "description": "Header layout style",
    "enum": [
     "centered",
     "left",
     "cover",
     "hero",
     "orbit",
     "card",
     "bar"
    ],
    "type": "string"
   },
   "name": {
    "description": "New display name",
    "maxLength": 80,
    "type": "string"
   },
   "smartsiteId": {
    "description": "Specific SmartSite id (default: primary)",
    "type": "string"
   },
   "themeColor": {
    "description": "Accent/theme hex color",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "swop_update_my_smartsite",
 "title": "Edit my SmartSite (name, bio, background)"
}
