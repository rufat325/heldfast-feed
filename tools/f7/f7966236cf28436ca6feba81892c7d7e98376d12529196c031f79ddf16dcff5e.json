{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Hotels Near Event"
 },
 "description": "Find hotels within walking or short-transit distance of an event venue. If no check_in/check_out provided, defaults to one night before through one night after the event (2-night stay). Returns nightly price, total cost, distance, transport mode (walk vs rideshare), and travel time to venue.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "event_id"
    ]
   },
   {
    "required": [
     "slug"
    ]
   }
  ],
  "properties": {
   "check_in": {
    "format": "date",
    "type": "string"
   },
   "check_out": {
    "format": "date",
    "type": "string"
   },
   "currency": {
    "enum": [
     "AUD",
     "USD",
     "NZD",
     "GBP",
     "EUR",
     "SGD",
     "CAD",
     "MYR"
    ],
    "type": "string"
   },
   "event_id": {
    "format": "uuid",
    "type": "string"
   },
   "guests": {
    "default": 2,
    "maximum": 6,
    "minimum": 1,
    "type": "integer"
   },
   "limit": {
    "default": 10,
    "maximum": 15,
    "minimum": 1,
    "type": "integer"
   },
   "radius_km": {
    "default": 3,
    "maximum": 10,
    "minimum": 0.5,
    "type": "number"
   },
   "slug": {
    "maxLength": 200,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_hotels_near_event"
}
