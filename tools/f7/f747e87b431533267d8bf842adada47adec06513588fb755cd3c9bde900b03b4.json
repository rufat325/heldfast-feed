{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search the @dt design-system docs registry by name, keyword, or UI intent. Returns budgeted briefs (import line, key props, related components) with a hint for the follow-up get call.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Max results, default 8",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Component name, keyword, or UI intent (e.g. \"toggle\")",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "hint": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "description": {
       "type": "string"
      },
      "group": {
       "type": [
        "string",
        "null"
       ]
      },
      "hint": {
       "type": "string"
      },
      "import": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "score",
      "name",
      "group",
      "status",
      "description",
      "import",
      "hint"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "results"
  ],
  "type": "object"
 },
 "title": "Search design-system docs"
}
