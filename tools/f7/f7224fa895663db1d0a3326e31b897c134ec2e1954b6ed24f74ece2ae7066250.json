{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Resources related to one resource, each with the reason (e.g. \"shares Command Menu\", \"same maker\"). Use it to follow tangents from a site you like. Example: {\"slug\": \"stripe\"}",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "slug": {
    "description": "Resource slug, e.g. \"stripe\".",
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(?:[-_][a-z0-9]+)*$",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "related_resources",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": [
        "string",
        "null"
       ]
      },
      "description": {
       "type": [
        "string",
        "null"
       ]
      },
      "domain": {
       "type": "string"
      },
      "image_url": {
       "description": "Full-size preview (screenshot, else the site's OG image): the stored image file, served directly.",
       "type": [
        "string",
        "null"
       ]
      },
      "license": {
       "description": "SPDX licence id, e.g. \"MIT\".",
       "type": [
        "string",
        "null"
       ]
      },
      "match_reasons": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "type": "string"
      },
      "notable_for": {
       "type": [
        "string",
        "null"
       ]
      },
      "open_source": {
       "description": "true: OSI-licensed; false: source-available or closed; null when unknown.",
       "type": [
        "boolean",
        "null"
       ]
      },
      "patterns": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "pricing": {
       "description": "free, freemium, paid or open_source; null when unknown.",
       "type": [
        "string",
        "null"
       ]
      },
      "sections": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "site_url": {
       "description": "The site's own address, untagged. Use it to compare, dedupe or cite.",
       "type": "string"
      },
      "slug": {
       "type": "string"
      },
      "tangent_url": {
       "description": "This resource's page on Tangent.",
       "type": "string"
      },
      "thumbnail_url": {
       "description": "A smaller stored copy of image_url (a screenshot's 720px-wide WebP) when one exists; otherwise the same URL as image_url.",
       "type": [
        "string",
        "null"
       ]
      },
      "type": {
       "type": "string"
      },
      "url": {
       "description": "Visit link for the site (tagged utm_source=tangent-mcp). Use this one when linking people to the site.",
       "type": "string"
      },
      "why": {
       "description": "Why it is related, e.g. \"shares Command Menu\".",
       "type": "string"
      }
     },
     "required": [
      "slug",
      "name",
      "url",
      "site_url",
      "tangent_url",
      "domain",
      "type",
      "description",
      "category",
      "sections",
      "patterns",
      "pricing",
      "open_source",
      "license",
      "notable_for",
      "image_url",
      "thumbnail_url",
      "why"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   }
  },
  "required": [
   "slug",
   "results"
  ],
  "type": "object"
 },
 "title": "Related resources"
}
