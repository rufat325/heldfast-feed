{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search tokens"
 },
 "description": "Search tokens across all chains\n\nFinds tokens by ticker, name or contract address on every supported chain, ranked by relevance, with live market data. A result whose `type` is `crown` has a registration: its creator proved control of it on Chain Daddy, and `crown.owner` is the wallet holding it. A ticker is not unique: one symbol usually matches several unrelated tokens on different chains, which `chainKey` and `token.address` tell apart, and a `token.copycat` block marks a token that imitates a better-known one. Without `q` it lists the newest tokens, on one chain with `chain`.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "chain": {
    "description": "Only results on this chain.",
    "enum": [
     "eth",
     "base",
     "arbitrum",
     "polygon",
     "bnb",
     "avax",
     "robinhood",
     "solana"
    ],
    "type": "string"
   },
   "claimedAfter": {
    "description": "Registered (`crown.mintTimestamp`) on or after this time (ISO 8601, or `YYYY-MM-DD`).",
    "type": "string"
   },
   "claimedBefore": {
    "description": "Registered on or before this time.",
    "type": "string"
   },
   "createdAfter": {
    "description": "`token.createdAt` on or after this time (ISO 8601, or `YYYY-MM-DD`).",
    "type": "string"
   },
   "createdBefore": {
    "description": "`token.createdAt` on or before this time.",
    "type": "string"
   },
   "crownsOnly": {
    "default": false,
    "description": "Only tokens that have a registration.",
    "type": "boolean"
   },
   "deployedAfter": {
    "description": "`token.deployedAt` on or after this time (ISO 8601, or `YYYY-MM-DD`).",
    "type": "string"
   },
   "deployedBefore": {
    "description": "`token.deployedAt` on or before this time.",
    "type": "string"
   },
   "exact": {
    "default": false,
    "description": "Only exact ticker matches, without fuzzy expansion (PEPE but not PEPE2). Ignored for an address.",
    "type": "boolean"
   },
   "include": {
    "description": "`apps` attaches the apps installed on each result's token page.",
    "enum": [
     "apps"
    ],
    "type": "string"
   },
   "includeInactive": {
    "default": false,
    "description": "Also return results normally hidden for low quality or inactivity.",
    "type": "boolean"
   },
   "maxHolders": {
    "description": "At most this many holders.",
    "minimum": 0,
    "type": "integer"
   },
   "maxLiquidity": {
    "description": "Liquidity at most this, in USD.",
    "minimum": 0,
    "type": "number"
   },
   "maxMarketCap": {
    "description": "Market cap at most this, in USD.",
    "minimum": 0,
    "type": "number"
   },
   "maxVolume": {
    "description": "24-hour volume at most this, in USD.",
    "minimum": 0,
    "type": "number"
   },
   "minHolders": {
    "description": "At least this many holders.",
    "minimum": 0,
    "type": "integer"
   },
   "minLiquidity": {
    "description": "Liquidity at least this, in USD.",
    "minimum": 0,
    "type": "number"
   },
   "minMarketCap": {
    "description": "Market cap at least this, in USD.",
    "minimum": 0,
    "type": "number"
   },
   "minVolume": {
    "description": "24-hour volume at least this, in USD.",
    "minimum": 0,
    "type": "number"
   },
   "order": {
    "default": "desc",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number, from 1.",
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "default": 25,
    "description": "Results per page.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "description": "A ticker (PEPE), a token name, or a contract address (an EVM 0x address or a Solana mint). Up to 64 characters.",
    "examples": [
     "PEPE"
    ],
    "maxLength": 64,
    "type": "string"
   },
   "refresh": {
    "default": false,
    "description": "Skip cached results, so a token created or registered a moment ago is found.",
    "type": "boolean"
   },
   "sort": {
    "description": "Sort key, case-insensitive. Defaults to `relevance` with a query and `createdat` (newest first) when browsing. An unknown key falls back to the default.",
    "enum": [
     "relevance",
     "market_cap",
     "volume",
     "liquidity",
     "holders",
     "price",
     "pricechange1h",
     "pricechange6h",
     "pricechange24h",
     "txns24h",
     "age",
     "createdat",
     "deployedat",
     "claimedat",
     "heartbeatscore",
     "tokenrank",
     "name"
    ],
    "type": "string"
   },
   "status": {
    "description": "Only results with this registration status: `registered` (any registration), `unregistered`, or one status value (`claimed`, `grace_period`, `inactive`, `unclaimed`, `available`).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_tokens",
 "outputSchema": {
  "properties": {
   "facets": {
    "description": "Counts across the whole result set, by chain (`chains`), status and type",
    "type": [
     "object",
     "null"
    ]
   },
   "filters": {
    "description": "The filters applied, echoed back. Present when any filter was sent.",
    "type": [
     "object",
     "null"
    ]
   },
   "page": {
    "type": [
     "integer",
     "null"
    ]
   },
   "pageSize": {
    "type": [
     "integer",
     "null"
    ]
   },
   "query": {
    "description": "The query as searched (a ticker or name upper-cased, an address as given)",
    "type": [
     "string",
     "null"
    ]
   },
   "results": {
    "items": {
     "properties": {
      "chainId": {
       "anyOf": [
        {
         "type": [
          "integer",
          "null"
         ]
        },
        {
         "type": [
          "string",
          "null"
         ]
        }
       ],
       "description": "The EVM chain ID, or `solana:mainnet`"
      },
      "chainKey": {
       "description": "Short chain identifier (eth, base, solana, \u2026)",
       "type": [
        "string",
        "null"
       ]
      },
      "chainName": {
       "description": "Human-readable chain name",
       "type": [
        "string",
        "null"
       ]
      },
      "crown": {
       "description": "The token's registration",
       "properties": {
        "crownContractAddress": {
         "description": "The registry contract the registration lives in",
         "type": [
          "string",
          "null"
         ]
        },
        "manager": {
         "description": "A wallet the owner delegated page management to, if any",
         "type": [
          "string",
          "null"
         ]
        },
        "mintTimestamp": {
         "description": "When the registration was written (unix seconds)",
         "type": [
          "integer",
          "null"
         ]
        },
        "owner": {
         "description": "The wallet holding the registration",
         "type": [
          "string",
          "null"
         ]
        },
        "status": {
         "description": "Registration status:\n- `available`: No token exists on this chain\n- `unclaimed`: Token exists but no registration minted\n- `grace_period`: New registration in 30-day grace period\n- `claimed`: Registration exists (owned by someone else)\n- `owned`: Factory-created token (you own it)\n- `inactive`: Registration exists but heartbeat below 60%\n",
         "type": [
          "string",
          "null"
         ]
        },
        "tokenAddress": {
         "description": "The token contract (or Solana mint) the registration points at",
         "type": [
          "string",
          "null"
         ]
        },
        "tokenId": {
         "description": "Registration token ID (null if unclaimed)",
         "type": [
          "integer",
          "null"
         ]
        },
        "verificationMethod": {
         "description": "Method used to verify ownership",
         "type": [
          "string",
          "null"
         ]
        },
        "verifiedAt": {
         "description": "When ownership was proven",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "hasCrown": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "listed": {
       "description": "Whether the result clears the site's quality bar; listed results come first",
       "type": [
        "boolean",
        "null"
       ]
      },
      "shareUrl": {
       "description": "A link to the token's page on chaindaddy.io",
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "description": "Where the market data came from",
       "type": [
        "string",
        "null"
       ]
      },
      "token": {
       "properties": {
        "address": {
         "description": "Token contract address (or Solana mint)",
         "type": [
          "string",
          "null"
         ]
        },
        "bannerUrl": {
         "description": "Header/banner image URL",
         "type": [
          "string",
          "null"
         ]
        },
        "buyTax": {
         "type": [
          "string",
          "null"
         ]
        },
        "contract": {
         "description": "The contract or launchpad the token was created with",
         "type": [
          "string",
          "null"
         ]
        },
        "copycat": {
         "description": "Present when the token imitates a better-known one",
         "properties": {
          "imitatesAddress": {
           "type": [
            "string",
            "null"
           ]
          },
          "imitatesChain": {
           "type": [
            "string",
            "null"
           ]
          },
          "imitatesName": {
           "type": [
            "string",
            "null"
           ]
          },
          "signals": {
           "items": {
            "type": [
             "string",
             "null"
            ]
           },
           "type": [
            "array",
            "null"
           ]
          }
         },
         "type": [
          "object",
          "null"
         ]
        },
        "createdAt": {
         "type": [
          "string",
          "null"
         ]
        },
        "decimals": {
         "type": [
          "integer",
          "null"
         ]
        },
        "description": {
         "type": [
          "string",
          "null"
         ]
        },
        "discord": {
         "type": [
          "string",
          "null"
         ]
        },
        "fdv": {
         "description": "Fully diluted valuation",
         "type": [
          "number",
          "null"
         ]
        },
        "holders": {
         "type": [
          "integer",
          "null"
         ]
        },
        "isHoneypot": {
         "description": "Set when a scanner flagged that the token cannot be sold",
         "type": [
          "boolean",
          "null"
         ]
        },
        "liquidity": {
         "type": [
          "number",
          "null"
         ]
        },
        "logoUrl": {
         "type": [
          "string",
          "null"
         ]
        },
        "marketCap": {
         "type": [
          "number",
          "null"
         ]
        },
        "name": {
         "type": [
          "string",
          "null"
         ]
        },
        "operator": {
         "description": "Who created it (a launchpad or deployer platform)",
         "type": [
          "string",
          "null"
         ]
        },
        "priceChange1h": {
         "description": "1-hour price change, in percent",
         "type": [
          "number",
          "null"
         ]
        },
        "priceChange24h": {
         "description": "24-hour price change, in percent",
         "type": [
          "number",
          "null"
         ]
        },
        "priceChange6h": {
         "description": "6-hour price change, in percent",
         "type": [
          "number",
          "null"
         ]
        },
        "priceUsd": {
         "type": [
          "number",
          "null"
         ]
        },
        "sellTax": {
         "type": [
          "string",
          "null"
         ]
        },
        "symbol": {
         "type": [
          "string",
          "null"
         ]
        },
        "telegram": {
         "type": [
          "string",
          "null"
         ]
        },
        "twitter": {
         "type": [
          "string",
          "null"
         ]
        },
        "venue": {
         "description": "Where it trades",
         "type": [
          "string",
          "null"
         ]
        },
        "volume24h": {
         "type": [
          "number",
          "null"
         ]
        },
        "website": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "type": [
        "object",
        "null"
       ]
      },
      "type": {
       "description": "`crown`: the token has a registration. `token`: a token with no registration.\n`available`: no token with this ticker on this chain.\n",
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": [
      "object",
      "null"
     ]
    },
    "type": [
     "array",
     "null"
    ]
   },
   "searchMode": {
    "description": "How the query was read",
    "type": [
     "string",
     "null"
    ]
   },
   "sort": {
    "type": [
     "string",
     "null"
    ]
   },
   "success": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "totalPages": {
    "type": [
     "integer",
     "null"
    ]
   },
   "totalResults": {
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "type": "object"
 },
