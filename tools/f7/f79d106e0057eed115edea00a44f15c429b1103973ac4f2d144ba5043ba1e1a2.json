{
 "description": "Paid Token Security Audit ($0.01 USDC). Normalizes GoPlus token-security flags and public EVM RPC metadata for supported EVM tokens. Configure GOPLUS_ACCESS_TOKEN or explicitly enable the bounded public API with GOPLUS_PUBLIC_TOKEN_API_ENABLED=1; if neither is available, no payment is requested. Missing provider fields remain unknown and incomplete coverage returns caution. Reports provider findings separately from deterministic internal scoring. Does not trade or guarantee token safety.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "chain": {
    "enum": [
     "ethereum",
     "base",
     "arbitrum",
     "optimism",
     "polygon",
     "bsc"
    ],
    "type": "string"
   },
   "token_address": {
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   }
  },
  "required": [
   "chain",
   "token_address"
  ],
  "type": "object"
 },
 "name": "token_security_audit",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "cache": {
      "additionalProperties": false,
      "properties": {
       "age_ms": {
        "minimum": 0,
        "type": "number"
       },
       "hit": {
        "type": "boolean"
       }
      },
      "required": [
       "hit",
       "age_ms"
      ],
      "type": "object"
     },
     "failed_sources": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "reason": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "latency_ms": {
      "minimum": 0,
      "type": "number"
     },
     "partial": {
      "type": "boolean"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "latency_ms",
     "partial",
     "failed_sources",
     "cache"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "timestamp": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "tool",
   "timestamp",
   "data",
   "meta"
  ],
  "type": "object"
 }
}
