{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Margin & markup calculator"
 },
 "description": "Work out profit, gross margin and markup from a cost price and a selling price. Margin is profit as a percentage of the selling price; markup is profit as a percentage of the cost. Amounts in GBP. Source: https://hopi.co.uk/margin-calculator/",
 "inputSchema": {
  "properties": {
   "cost": {
    "description": "Cost price in GBP",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   },
   "price": {
    "description": "Selling price in GBP",
    "maximum": 1000000000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "cost",
   "price"
  ],
  "type": "object"
 },
 "name": "hopi_margin_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "cost": {
    "type": "number"
   },
   "marginPercent": {
    "type": "number"
   },
   "markupPercent": {
    "type": "number"
   },
   "price": {
    "type": "number"
   },
   "profit": {
    "type": "number"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "summary": {
    "type": "string"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Margin & markup calculator"
}
