{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Add, remove, resize, rename, fit, or rearrange artboards. Note: Illustrator will be activated (brought to foreground) during execution.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Action to perform",
    "enum": [
     "add",
     "remove",
     "resize",
     "rename",
     "fit_to_art",
     "rearrange"
    ],
    "type": "string"
   },
   "index": {
    "description": "Target artboard index (0-based). Required for remove/resize/rename/fit_to_art. Note: the last remaining artboard cannot be removed.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "layout": {
    "description": "Artboard layout for rearrange",
    "enum": [
     "grid_by_row",
     "grid_by_col",
     "row",
     "column"
    ],
    "type": "string"
   },
   "name": {
    "description": "New name for rename action",
    "type": "string"
   },
   "rect": {
    "description": "Position and size for add/resize (document coordinates)",
    "properties": {
     "height": {
      "type": "number"
     },
     "width": {
      "type": "number"
     },
     "x": {
      "type": "number"
     },
     "y": {
      "type": "number"
     }
    },
    "required": [
     "x",
     "y",
     "width",
     "height"
    ],
    "type": "object"
   },
   "rows_or_cols": {
    "description": "Number of rows or columns for rearrange",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "spacing": {
    "default": 20,
    "description": "Spacing in points for rearrange",
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "manage_artboards",
 "title": "Manage Artboards"
}
