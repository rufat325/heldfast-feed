         "city": {
          "maxLength": 100,
          "type": "string"
         },
         "countryCode": {
          "maxLength": 2,
          "minLength": 2,
          "type": "string"
         },
         "line1": {
          "maxLength": 150,
          "type": "string"
         },
         "line2": {
          "maxLength": 150,
          "type": "string"
         },
         "postalCode": {
          "maxLength": 20,
          "type": "string"
         }
        },
        "type": "object"
       },
       "name": {
        "maxLength": 200,
        "type": "string"
       }
      },
      "type": "object"
     },
     "deliveryCountryCode": {
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "deliveryDate": {
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
      "type": "string"
     },
     "despatchAdviceRef": {
      "maxLength": 200,
      "type": "string"
     },
     "documentTypeCode": {
      "default": "380",
