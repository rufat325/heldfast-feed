{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Rechnungsdaten aus PDF auslesen"
 },
 "description": "Extrahiert EN-16931-Rechnungsdaten aus einer hochgeladenen PDF (Formularfelder) plus Validierungs-Issues, als Korrekturschritt vor create_zugferd: Felder und Issues dem Nutzer zeigen, korrigieren lassen, danach create_zugferd mit dem korrigierten invoice und derselben upload_id aufrufen. Unsichere Felder stehen als Platzhalter 'KORRIGIEREN' (Text) bzw. '1900-01-01' (Datum) drin und werden als Issue mit Code EXTRACTION_UNCERTAIN gemeldet \u2014 diese Felder m\u00fcssen vor create_zugferd korrigiert werden. Enth\u00e4lt die PDF bereits eine eingebettete E-Rechnung (ZUGFeRD/Factur-X), kommen die Felder deterministisch aus der XML (source='xml') statt aus einer Sprachmodell-Lesung des Druckbilds. Erfordert ein Konto mit aktivem Abo oder Guthaben.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pdf_base64": {
    "contentEncoding": "base64",
    "contentMediaType": "application/pdf",
    "description": "Die zu extrahierende PDF-Rechnung, Base64-kodiert (max. 25 MB). Alternativ 'upload_id' angeben. Chat-Clients, die eine angeh\u00e4ngte Datei nicht zuverl\u00e4ssig als Base64 \u00fcbergeben k\u00f6nnen, rufen zuerst request_upload_link auf.",
    "type": "string"
   },
   "upload_id": {
    "description": "Referenz auf eine zuvor \u00fcber request_upload_link hochgeladene Datei, anstelle von pdf_base64. Genau eines von beiden angeben. Wird im Ergebnis erneut zur\u00fcckgegeben und kann anschlie\u00dfend bei create_zugferd als 'upload_id' verwendet werden, damit dieselbe Quell-PDF eingebettet wird.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "extract_invoice",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "expires_at": {
    "description": "ISO-8601-Zeitpunkt, ab dem upload_id verf\u00e4llt. Danach erneut request_upload_link und extract_invoice aufrufen.",
    "type": "string"
   },
   "invoice": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "description": "Extrahierte EN-16931-Rechnungsdaten (Formularfelder). Vor create_zugferd pr\u00fcfen und korrigieren, insbesondere Felder mit dem Wert 'KORRIGIEREN' bzw. '1900-01-01'.",
    "properties": {
     "allowanceCharges": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "amount": {
         "description": "BT-92/BT-99: Betrag ohne Vorzeichen. Darf fehlen, wenn percent gesetzt ist: dann gilt round2(basisAmount \u00d7 percent / 100).",
         "minimum": 0,
         "type": "number"
        },
        "basisAmount": {
         "description": "BT-93/BT-100: Grundbetrag des Prozentsatzes. Ohne Angabe die Summe der lineNetAmount aller Positionen mit ratePercent (bei gemischten Kategorien desselben Satzes nur die mit categoryCode).",
         "type": "number"
        },
        "categoryCode": {
         "default": "S",
         "maxLength": 12,
         "type": "string"
        },
        "charge": {
         "description": "true = Zuschlag (BG-21), false = Abzug/Nachlass (BG-20).",
         "type": "boolean"
        },
        "percent": {
         "description": "BT-94/BT-101: Prozentsatz, z. B. 2 f\u00fcr 2 % Nachlass.",
         "maximum": 100,
         "minimum": 0,
         "type": "number"
        },
        "ratePercent": {
         "description": "BT-96/BT-103: Steuersatz in Prozent. Darf beim Prozent-Eintrag ohne basisAmount fehlen, wenn alle Positionen denselben Satz haben.",
         "type": "number"
        },
        "reason": {
         "maxLength": 200,
         "type": "string"
        },
        "reasonCode": {
         "maxLength": 10,
         "type": "string"
        }
       },
       "required": [
        "charge"
       ],
       "type": "object"
      },
      "maxItems": 50,
      "type": "array"
     },
     "buyer": {
      "additionalProperties": false,
