          "maxLength": 150,
          "type": "string"
         },
         "name": {
          "maxLength": 150,
          "type": "string"
         },
         "phone": {
          "maxLength": 40,
          "type": "string"
         }
        },
        "type": "object"
       },
       "electronicAddress": {
        "additionalProperties": false,
        "properties": {
         "id": {
          "maxLength": 200,
          "minLength": 1,
          "type": "string"
         },
         "scheme": {
          "default": "EM",
          "maxLength": 10,
          "type": "string"
         }
        },
        "required": [
         "id"
        ],
        "type": "object"
       },
       "gln": {
        "maxLength": 20,
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "registrationId": {
        "description": "BT-30 (Verk\u00e4ufer) / BT-47 (K\u00e4ufer): Handelsregisternummer bzw. Registerkennung der Partei, z. B. \"HRB 12345, Amtsgericht M\u00fcnchen\". Nur angeben, wenn sie auf der Rechnung steht. Beim K\u00e4ufer reicht sie bei Reverse Charge (Kategorie AE) statt der USt-IdNr., bei innergemeinschaftlicher Lieferung (K) nicht.",
        "maxLength": 60,
        "type": "string"
       },
       "vatId": {
        "maxLength": 20,
        "type": "string"
       }
      },
      "required": [
       "name"
      ],
      "type": "object"
     },
     "buyerReference": {
      "maxLength": 80,
      "type": "string"
     },
     "contractReference": {
      "maxLength": 200,
      "type": "string"
     },
     "costCenter": {
      "maxLength": 60,
      "type": "string"
     },
     "currency": {
      "default": "EUR",
      "maxLength": 3,
      "minLength": 3,
      "type": "string"
     },
     "delivery": {
      "additionalProperties": false,
      "properties": {
       "address": {
        "additionalProperties": false,
