{
 "description": "Trace the network path to a target from one or more global regions. Shows each hop with latency. Supports TCP, UDP, and ICMP protocols.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "protocol": {
    "description": "Protocol to use (default: tcp)",
    "enum": [
     "tcp",
     "udp",
     "icmp"
    ],
    "type": "string"
   },
   "target": {
    "description": "Hostname or IP to trace (e.g., \"example.com\")",
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "traceroute"
}
