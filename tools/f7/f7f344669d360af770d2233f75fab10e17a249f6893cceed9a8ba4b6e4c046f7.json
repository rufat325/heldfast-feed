{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Recent trades"
 },
 "description": "The latest opens, closes and liquidations across all of Papertrade, optionally filtered by market or wallet.",
 "inputSchema": {
