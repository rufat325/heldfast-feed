    "enum": [
     "BTC",
     "ETH"
    ],
    "type": "string"
   },
   "wallet": {
    "pattern": "^0x[0-9a-fA-F]{40}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_recent_trades",
 "title": "Recent trades"
}
