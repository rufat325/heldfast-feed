{
 "_meta": {
  "ui": {
   "resourceUri": "ui://warp/quote-card.mcp",
   "visibility": [
    "model",
    "app"
   ]
  },
  "ui/resourceUri": "ui://warp/quote-card.mcp"
 },
 "annotations": {
  "readOnlyHint": true,
  "title": "Get Full Truckload Quote"
 },
 "description": "Quote a full truckload (53' dry van). Only origin, destination, and date required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commodity": {
    "description": "Commodity description",
    "type": "string"
   },
   "destination_zip": {
    "description": "5-digit US ZIP code",
    "pattern": "^\\d{5}$",
    "type": "string"
   },
   "origin_zip": {
    "description": "5-digit US ZIP code",
    "pattern": "^\\d{5}$",
    "type": "string"
   },
   "pallets": {
    "description": "Pallets (optional, display only)",
    "maximum": 26,
    "minimum": 1,
    "type": "integer"
   },
   "pickup_date": {
    "description": "Pickup date YYYY-MM-DD",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "weight_lbs_per_pallet": {
    "description": "Weight per pallet (optional)",
    "maximum": 5000,
    "minimum": 50,
    "type": "number"
   }
  },
  "required": [
   "origin_zip",
   "destination_zip",
   "pickup_date"
  ],
  "type": "object"
 },
 "name": "ftl_quote",
 "title": "Get Full Truckload Quote"
}
