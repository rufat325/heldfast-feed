{
 "description": "List open/stale/submitted builder work items for a business agent by sourceAgentEntityId.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "sourceAgentEntityId": {
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "items": {
     "enum": [
      "queued",
      "claimed",
      "in_progress",
      "submitted",
      "accepted",
      "needs_changes",
      "closed"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "type": {
    "enum": [
     "build_workflow",
     "fix_workflow",
     "review",
     "summarize",
     "configure",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "sourceAgentEntityId"
  ],
  "type": "object"
 },
 "name": "list_builder_work_items_for_agent"
}
