{
 "_meta": {
  "com.daedalmap/access": {
   "capability_id": "pack_detail_discovery",
   "contract_version": "1.0.0",
   "family": "discovery",
   "help": {
    "arguments": {
     "tool_name": "get_pack"
    },
    "tool": "get_tool_help"
   },
   "limits": {},
   "meter": {
    "items_per_charge_unit": 1,
    "unit": "item"
   },
   "price_micro_usd": {
    "base_micro_usd": 0,
    "per_unit_micro_usd": 0,
    "source": "registry"
   },
   "pricing": "free",
   "pricing_version": "unpriced-v0"
  },
  "com.daedalmap/data-contract": {
   "canonical_help_tool": "get_tool_help",
   "contract_version": "1.0.0",
   "input_family": "pack_selector",
   "result_family": "catalog"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Inspect one selected data pack or geometry family progressively: lite starter contract, full MCP query metadata, or a raw metadata download URL. Use its next_step to retrieve data or call the preferred geometry tool.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "catalog": {
    "description": "Metadata family. When omitted, geometry facades default to geometry and known geometry-family ids are inferred; all other calls default to data.",
    "enum": [
     "data",
     "geometry"
    ],
    "type": "string"
   },
   "country_scope": {
    "description": "Optional ISO3 country for a geometry family. Omit it to learn which countries publish the family; provide it for country-specific versions, vintages, levels, and artifacts.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "detail": {
    "default": "lite",
    "description": "Use lite to decide and start, full for detailed MCP query metadata, or download for the complete raw metadata file.",
    "enum": [
     "lite",
     "full",
     "download"
    ],
    "type": "string"
   },
   "pack_id": {
    "description": "Pack identifier from get_catalog. Newly catalog-admitted packs require no MCP schema change.",
    "type": "string"
   },
   "release_unit": {
    "description": "Optional non-country geometry release unit such as GLOBAL or MARINE. Do not combine with country_scope.",
    "pattern": "^[A-Za-z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "pack_id"
  ],
  "type": "object"
 },
 "name": "get_pack",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "anyOf": [
   {
    "required": [
     "catalog",
     "pack_id",
     "detail"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "catalog": {
    "enum": [
     "data",
     "geometry"
    ],
    "type": "string"
   },
   "clarification": {
    "type": "object"
   },
   "detail": {
    "enum": [
     "lite",
     "full",
     "download"
    ],
    "type": "string"
   },
   "download_call": {
    "type": "object"
   },
   "download_url": {
    "type": "string"
   },
   "error": {
    "additionalProperties": true,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {
      "type": "object"
     },
     "message": {
      "type": "string"
     },
     "retry_hint": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "full_call": {
    "type": "object"
   },
   "guidance": {
    "type": "object"
   },
   "material_policy": {
    "type": "object"
   },
   "next_step": {
    "additionalProperties": true,
    "anyOf": [
     {
      "required": [
       "action"
      ]
     },
     {
      "required": [
       "tool"
      ]
     }
    ],
    "properties": {
     "action": {
      "type": "string"
     },
     "arguments": {
      "type": "object"
     },
     "tool": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "pack_id": {
    "type": "string"
   },
   "provenance": {
    "type": "object"
   },
   "reason": {
    "type": "string"
   },
   "request_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "sources": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Inspect One Selected Pack or Geometry Family"
}
