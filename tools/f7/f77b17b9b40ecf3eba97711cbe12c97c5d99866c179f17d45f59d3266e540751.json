        },
        "reason": {
         "type": "string"
        },
        "slug": {
         "type": "string"
        }
       },
       "required": [
        "slug",
        "label",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "recommendedVerification": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "redFlags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
