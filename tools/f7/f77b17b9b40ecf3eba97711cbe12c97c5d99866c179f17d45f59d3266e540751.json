      "type": "string"
     },
     "license": {
      "type": "string"
     },
     "licenseUrl": {
      "type": "string"
     },
     "publisher": {
      "type": "string"
     },
     "text": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "text",
     "title",
     "publisher",
     "url",
     "license",
     "licenseUrl",
