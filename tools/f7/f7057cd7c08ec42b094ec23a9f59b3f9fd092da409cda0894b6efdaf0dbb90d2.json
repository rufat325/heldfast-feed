{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search people"
 },
 "description": "Search/list people (contacts). All filters optional; returns a page of people. Copper REST: POST /people/search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_ids": {
    "description": "Filter to people owned by these user ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "city": {
    "description": "City filter.",
    "type": "string"
   },
   "company_ids": {
    "description": "Filter to people at these company ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "country": {
    "description": "Country filter.",
    "type": "string"
   },
   "emails": {
    "description": "Filter to people with any of these email addresses.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Full-name filter (substring match).",
    "type": "string"
   },
   "page_number": {
    "description": "1-based page number to fetch (default 1).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (default 20, max 200).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "phone_number": {
    "description": "Phone-number filter.",
    "type": "string"
   },
   "sort_by": {
    "description": "Field to sort by, e.g. 'name', 'date_created', 'date_modified' (default 'first_name').",
    "type": "string"
   },
   "sort_direction": {
    "description": "Sort direction \u2014 'asc' or 'desc' (default asc).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "state": {
    "description": "State/region filter.",
    "type": "string"
   },
   "tags": {
    "description": "Filter to people carrying any of these tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "copper_search_people",
 "title": "Search people"
}
