{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Estimate Fees"
 },
 "description": "Estimate annual cost at every brokerage or crypto exchange VaultRubric tracks from sourced fees (commissions, options per-contract, transfer-out; exchange taker fees). Unknown fees are flagged, never assumed.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "512x512"
   ],
   "src": "https://vaultrubric.com/icon.png"
  }
 ],
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "avg_trade_size": {
    "description": "Average trade size in USD (used for exchange percentage fees); default 1000",
    "minimum": 0,
    "type": "number"
   },
   "category": {
    "description": "'brokerage' or 'exchange'",
    "enum": [
     "brokerage",
     "exchange"
    ],
    "type": "string"
   },
   "options_contracts_per_month": {
    "description": "Options contracts per month (brokerages); default 0",
    "minimum": 0,
    "type": "number"
   },
   "trades_per_month": {
    "description": "Number of trades per month; default 4",
    "minimum": 0,
    "type": "number"
   },
   "transfers_per_year": {
    "description": "Full account transfers out per year; default 0",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "category"
  ],
  "type": "object"
 },
 "name": "estimate_fees",
 "outputSchema": {
  "properties": {
   "attribution": {
    "description": "Always 'Source: VaultRubric (vaultrubric.com)'; include when citing.",
    "type": "string"
   },
   "category": {
    "type": "string"
   },
   "disclaimer": {
    "type": "string"
   },
   "inputs": {
    "type": "object"
   },
   "license": {
    "description": "Data license / reuse terms",
    "type": "string"
   },
   "method": {
    "type": "string"
   },
   "methodology": {
    "description": "URL of the scoring methodology",
    "type": "string"
   },
   "page": {
    "description": "Shareable calculator URL for this result",
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "annual_estimate": {
       "type": "number"
      },
      "as_of": {
       "type": "string"
      },
      "breakdown": {
       "type": "object"
      },
      "complete": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "unknown_fees": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results",
   "page",
   "attribution"
  ],
  "type": "object"
 },
 "title": "Estimate Fees"
}
