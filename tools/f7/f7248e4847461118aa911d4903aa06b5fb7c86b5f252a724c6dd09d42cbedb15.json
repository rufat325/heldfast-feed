{
 "description": "Send a poll message via WhatsApp",
 "inputSchema": {
  "properties": {
   "instance": {
    "description": "Instance name",
    "type": "string"
   },
   "name": {
    "description": "Poll question",
    "type": "string"
   },
   "number": {
    "description": "Phone number with country code",
    "type": "string"
   },
   "options": {
    "description": "Poll options (max 12)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "selectableCount": {
    "description": "Max selectable options (0 = unlimited)",
    "type": "number"
   }
  },
  "required": [
   "instance",
   "number",
   "name",
   "options"
  ],
  "type": "object"
 },
 "name": "send_poll"
}
