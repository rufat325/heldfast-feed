  "title": "Create Booking Page"
 },
 "description": "Create a booking page exposing one mailbox's availability. availability_days is 0=Sunday..6=Saturday. conferencing_provider is opt-in and must already be connected to the mailbox.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "active": {
    "type": "boolean"
   },
   "availability_days": {
    "items": {
     "maximum": 6,
     "minimum": 0,
     "type": "integer"
    },
    "maxItems": 7,
    "minItems": 1,
    "type": "array"
   },
   "buffer_minutes": {
    "maximum": 240,
    "minimum": 0,
    "type": "integer"
   },
   "conferencing_provider": {
    "anyOf": [
     {
      "enum": [
       "zoom",
       "google_meet"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Opt-in meeting provider. It must already be connected to the page's mailbox. Null means no meeting link."
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "duration_minutes": {
    "maximum": 480,
    "minimum": 5,
    "type": "integer"
   },
   "idempotency_key": {
    "description": "Optional idempotency key. If omitted, the MCP server generates one for POST tools.",
    "pattern": "^[\\x20-\\x7E]{1,255}$",
    "type": "string"
   },
   "mailbox": {
    "description": "The mailbox (calendar owner) address.",
    "maxLength": 508,
    "type": "string"
   },
   "max_advance_days": {
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   },
   "minimum_notice_minutes": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "name": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "maxLength": 48,
    "minLength": 1,
    "pattern": "^[a-z0-9](?:[a-z0-9-]*[a-z0-9])?$",
    "type": "string"
   },
   "timezone": {
    "description": "IANA time zone.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "window_end_minutes": {
    "maximum": 1440,
    "minimum": 0,
    "type": "integer"
   },
   "window_start_minutes": {
    "maximum": 1440,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "name",
   "mailbox",
   "slug",
   "duration_minutes",
   "availability_days",
   "window_start_minutes",
   "window_end_minutes",
   "timezone"
  ],
  "type": "object"
 },
