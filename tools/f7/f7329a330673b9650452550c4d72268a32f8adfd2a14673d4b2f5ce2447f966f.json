{
 "_meta": {
  "openai/toolInvocation/invoked": "Zoned school lookup done",
  "openai/toolInvocation/invoking": "Finding the zoned school\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find the zoned school for an address"
 },
 "description": "Use this when a family asks which elementary school is zoned for a specific NYC address, such as an apartment or building they name. NYC draws school zones building by building, so pass the street address exactly as they typed it \u2014 building number and street, ideally with the borough \u2014 never the device's location. Returns the zoned K-5 school, the neighborhood, and how zoned admission works; some areas, like all of District 1, have no zoned school.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "The NYC street address to look up, as the family typed it, with the building number and ideally the borough \u2014 e.g. \"123 7th Ave, Brooklyn\". A zone line can run between two buildings on one block, so a city or neighborhood can't answer this; never the device's location.",
    "maxLength": 200,
    "minLength": 5,
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get-zoned-school",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "candidates": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "found": {
    "type": "boolean"
   },
   "matched_address": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "neighborhood": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "borough": {
        "type": [
         "string",
         "null"
        ]
       },
       "nta_code": {
        "type": "string"
       },
       "nta_name": {
        "type": [
         "string",
         "null"
        ]
       },
       "url": {
        "type": [
         "string",
         "null"
        ]
       }
      },
      "required": [
       "nta_code",
       "nta_name",
       "borough",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "note": {
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "reason": {
    "enum": [
     "not_found",
     "outside_nyc",
     "ambiguous",
     "no_zone"
    ],
    "type": "string"
   },
   "zoned_school": {
    "additionalProperties": false,
    "properties": {
     "address": {
      "type": [
       "string",
       "null"
      ]
     },
     "dbn": {
      "type": "string"
     },
     "district": {
      "type": [
       "number",
       "null"
      ]
     },
     "grade_levels": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": "string"
     },
     "url": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "dbn",
     "name",
     "address",
     "district",
     "grade_levels",
     "url"
    ],
    "type": "object"
   }
  },
  "required": [
   "query",
   "found",
   "matched_address"
  ],
  "type": "object"
 }
}
