{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get GHS/CLP hazard classification, label elements and UN number"
 },
 "description": "Looks up a substance's hazard classification, GHS pictograms, H-statements, signal word or label elements (for example for SDS sections 2 and 3 or a CLP label), and its UN number and transport hazard class (SDS section 14). It returns the EU CLP Annex VI harmonised entry (hazard classes and categories, H-statements, pictograms, signal word, specific concentration limits, M-factors and the ATP that set it) from ECHA's harmonised classification list and Regulation (EC) No 1272/2008. Optionally it adds the self-classifications notified to the ECHA C&L Inventory, the GB mandatory classification list and GB CLP (HSE), pending CLH intentions and RAC opinions, the Korean GHS classification list, and the US DOT Hazardous Materials Table (49 CFR 172.101: UN number, proper shipping name, hazard class, packing group). Not intended for mixtures, which need the user's own calculation, for ADR, IMDG or IATA transport rules, or for whether a substance is restricted (`regaffairs_check_chemical_substance` covers that).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "include_notified": {
    "default": false,
    "description": "Add the C&L Inventory notified classifications.",
    "type": "boolean"
   },
   "include_pending": {
    "default": true,
    "description": "Add open CLH intentions and RAC opinions.",
    "type": "boolean"
   },
   "include_transport": {
    "default": false,
    "description": "Add the US DOT 49 CFR 172.101 entry (UN number, class, packing group).",
    "type": "boolean"
   },
   "jurisdictions": {
    "default": [
     "EU"
    ],
    "items": {
     "enum": [
      "EU",
      "GB",
      "KR"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "substance": {
    "description": "Name, CAS, EC, CLP index number or UN number (e.g. UN1090).",
    "type": "string"
   }
  },
  "required": [
   "substance"
  ],
  "type": "object"
 },
