{
 "description": "Submit a review after completing a concert. Requires a completed ticket. One review per concert. Rating 1-10, review text 10-2000 chars.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "concert_slug": {
    "description": "Concert slug",
    "type": "string"
   },
   "rating": {
    "description": "Rating from 1 (worst) to 10 (best)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "review": {
    "description": "Review text",
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "concert_slug",
   "rating",
   "review"
  ],
  "type": "object"
 },
 "name": "submit_review"
}
