{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read bounded official record text by known identifier. Does not fetch arbitrary URLs or paths.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "collection": {
    "description": "Public record collection returned by search.",
    "type": "string"
   },
   "generation": {
    "description": "Retained snapshot UUID; omit for the current snapshot.",
    "type": [
     "string",
     "null"
    ]
   },
   "id": {
    "description": "Stable ID of a known public record.",
    "type": "string"
   },
   "length": {
    "description": "Characters to return, up to 16,000.",
    "format": "uint64",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "offset": {
    "description": "Character offset for the next bounded text chunk.",
    "format": "uint64",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   }
  },
  "required": [
   "collection",
   "id"
  ],
  "type": "object"
 },
 "name": "document",
 "outputSchema": {
  "$defs": {
   "JsonObject": {
    "description": "Source-specific JSON map. The envelope is stable; map keys vary by official source.",
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "document_kind": {
    "type": "string"
   },
   "generation": {
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "next_offset": {
    "format": "uint",
    "minimum": 0,
    "type": [
     "integer",
     "null"
    ]
   },
   "offset": {
    "format": "uint64",
    "minimum": 0,
    "type": "integer"
   },
   "provenance": {
    "anyOf": [
     {
      "$ref": "#/$defs/JsonObject"
     },
     {
      "type": "null"
     }
    ],
    "description": "Source metadata attached to the retained record."
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "generation",
   "id",
   "text",
   "offset",
   "document_kind"
  ],
  "type": "object"
 },
 "title": "Read source text"
}
