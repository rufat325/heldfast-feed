{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Current prices for one or more assets: the Ripio app buy/sell rates (with spread) and, when the pair exists, the Ripio Trade book (bid, ask, last, 24h change and volume), so app and exchange prices can be compared.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assets": {
    "description": "Tickers, e.g. [\"USDT\", \"BTC\"].",
    "items": {
     "pattern": "^[A-Za-z0-9]{2,12}$",
     "type": "string"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "quote": {
    "description": "Default \"ARS\".",
    "enum": [
     "ARS",
     "USD"
    ],
    "type": "string"
   }
  },
  "required": [
   "assets"
  ],
  "type": "object"
 },
 "name": "ripio_get_prices",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "as_of": {
    "type": "string"
   },
   "not_found": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prices": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "app": {
       "additionalProperties": false,
       "properties": {
        "buy": {
         "type": "string"
        },
        "sell": {
         "type": "string"
        },
        "spread_pct": {
         "type": "string"
        },
        "ticker": {
         "type": "string"
        }
       },
       "required": [
        "ticker",
        "buy",
        "sell"
       ],
       "type": "object"
      },
      "asset": {
       "type": "string"
      },
      "exchange": {
       "additionalProperties": false,
       "properties": {
        "ask": {
         "type": "string"
        },
        "bid": {
         "type": "string"
        },
        "change_24h_pct": {
         "type": "string"
        },
        "last": {
         "type": "string"
        },
        "pair": {
         "type": "string"
        },
        "volume_24h": {
         "type": "string"
        }
       },
       "required": [
        "pair"
       ],
       "type": "object"
      }
     },
     "required": [
      "asset"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "quote": {
    "enum": [
     "ARS",
     "USD"
    ],
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "as_of",
   "quote",
   "prices",
   "not_found",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Ripio prices"
}
