{
 "description": "Inspect a mismatch region from the latest comparison and retrieve its ranked DOM candidates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "projectId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "referenceId": {
    "type": "string"
   },
   "regionId": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "projectId",
   "regionId"
  ],
  "type": "object"
 },
 "name": "visual.inspect"
}
