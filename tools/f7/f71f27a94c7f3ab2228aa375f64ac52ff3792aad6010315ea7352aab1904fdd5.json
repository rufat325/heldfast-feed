{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List a post's translations"
 },
 "description": "Use this when someone asks which languages a blog post exists in, or which translations are still missing. Returns each language version sharing the original article id, up to 100, with title, slug, published state and how it was translated; with blogId it also lists the blog's missing languages. Not for a whole blog's coverage.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "blogId": {
    "description": "Blog id; when given, the result also lists the blog languages that still lack this post",
    "maxLength": 200,
    "type": "string"
   },
   "originalArticleId": {
    "description": "Id of the original article that every translation shares, as reported on each of its versions",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "originalArticleId"
  ],
  "type": "object"
 },
 "name": "list_article_translations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "anyOf": [
        {
         "maxLength": 200,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "locale": {
       "anyOf": [
        {
         "maxLength": 50,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "published": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "slug": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "title": {
       "anyOf": [
        {
         "maxLength": 300,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "translatedBy": {
       "enum": [
        "google",
        "human",
        "unknown"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "locale",
      "slug",
      "published",
      "translatedBy"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "missingLocales": {
    "items": {
     "maxLength": 50,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "missingLocalesKnown": {
    "type": "boolean"
   },
   "missingLocalesTruncated": {
    "type": "boolean"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "items",
   "truncated",
   "missingLocales",
   "missingLocalesKnown",
   "missingLocalesTruncated"
  ],
  "type": "object"
 },
 "title": "List a post's translations"
}
