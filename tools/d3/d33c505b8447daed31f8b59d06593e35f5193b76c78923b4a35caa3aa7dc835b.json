{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Propose Ledger entries for review"
 },
 "description": "Writes up to 50 entries as DRAFTS: proposals that stay out of the record until a person confirms each one in Ledger's Drafts view. Use it for entries you found rather than were told \u2014 decisions in meeting notes, or a team's past changes read from its tracker, pull requests or launch posts (set `fromHistory: true`). For history: take each claim from what the source said AT THE TIME, set `landedAt` to when it shipped, attach the source URL, and leave `rollout` as full unless the source says otherwise. These read as low confidence because they were written down after the fact; say so plainly rather than overstating them. Tell the person how many drafts are waiting and that they review them under Decisions \u2192 Drafts. May return `needs_confirmation`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "type": "string"
   },
   "drafts": {
    "items": {
     "properties": {
      "kind": {
       "default": "decision",
       "enum": [
        "decision",
        "lesson",
        "observation",
        "belief"
       ],
       "type": "string"
      },
      "landedAt": {
       "description": "When the change took effect: the merge, ship or launch date. Set once.",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "lesson": {
       "maxLength": 4000,
       "type": "string"
      },
      "prediction": {
       "description": "Decisions only. For history, the claim the source made at the time, not one fitted to what happened since.",
       "properties": {
        "claims": {
         "default": [],
         "items": {
          "properties": {
           "comparator": {
            "enum": [
             ">=",
             "<=",
             ">",
             "<",
             "="
            ],
            "type": "string"
           },
           "evalId": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
           },
           "hold": {
            "properties": {
             "days": {
              "default": 28,
              "maximum": 365,
              "minimum": 1,
              "type": "integer"
             },
             "kind": {
              "const": "pre_landing",
              "type": "string"
             },
             "maxDrop": {
              "default": 0,
              "maximum": 1,
              "minimum": 0,
              "type": "number"
             },
             "maxRise": {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
             }
            },
            "required": [
             "kind"
            ],
            "type": "object"
           },
           "metricId": {
            "maxLength": 100,
            "minLength": 1,
            "type": "string"
           },
           "slice": {
            "additionalProperties": {
             "items": {
              "maxLength": 100,
              "minLength": 1,
              "type": "string"
             },
             "maxItems": 50,
             "minItems": 1,
             "type": "array"
            },
            "propertyNames": {
             "pattern": "^[a-z][a-z0-9_]{0,39}$",
             "type": "string"
            },
            "type": "object"
           },
           "source": {
            "enum": [
             "caliper_eval",
             "metric",
             "manual"
            ],
            "type": "string"
           },
           "target": {
            "type": "number"
           },
           "unit": {
            "maxLength": 50,
            "type": "string"
           },
           "watch": {
            "type": "boolean"
           }
          },
          "required": [
           "source"
          ],
          "type": "object"
         },
         "maxItems": 10,
         "type": "array"
        },
        "deadline": {
         "maxLength": 40,
         "type": "string"
        },
        "freeform": {
         "maxLength": 2000,
         "type": "string"
        }
       },
       "type": "object"
      },
      "rationale": {
       "description": "The BODY. For history, quote what the source said the change was for.",
       "maxLength": 4000,
       "type": "string"
      },
      "rollout": {
       "description": "full unless the source says it was staged (partial) or had a held-out group (controlled).",
       "enum": [
        "full",
        "partial",
        "controlled"
       ],
       "type": "string"
      },
      "source": {
       "description": "Where the claim came from \u2014 the ticket, pull request or post.",
       "properties": {
        "title": {
         "maxLength": 300,
         "type": "string"
        },
        "url": {
         "format": "uri",
         "maxLength": 2000,
         "type": "string"
        }
       },
       "required": [
        "url"
       ],
       "type": "object"
      },
      "summary": {
       "description": "The TITLE: one short plain sentence naming the change or fact.",
       "maxLength": 280,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "summary"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "fromHistory": {
    "description": "True when the drafts come from a team's past work, not the conversation.",
    "type": "boolean"
   },
   "workspace": {
    "description": "Workspace slug. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "drafts"
  ],
  "type": "object"
 },
 "name": "ledger_entries_draft",
 "title": "Propose Ledger entries for review"
}
