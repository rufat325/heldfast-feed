           "value": {
            "minLength": 1,
            "type": "string"
           }
          },
          "required": [
           "strategy",
           "value"
          ],
          "type": "object"
         }
        ]
       }
      },
      "required": [
       "kind",
       "locator"
      ],
      "type": "object"
     }
    ]
   },
   "pageId": {
    "minLength": 1,
    "type": "string"
   },
   "sessionId": {
    "minLength": 1,
    "type": "string"
