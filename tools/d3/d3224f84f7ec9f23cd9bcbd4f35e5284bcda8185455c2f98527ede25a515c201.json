             "type": "string"
            }
           },
           "required": [
            "strategy",
            "value"
           ],
           "type": "object"
          }
         ]
        },
        "maxItems": 5,
        "minItems": 1,
        "type": "array"
       },
       "kind": {
        "const": "iframe",
        "type": "string"
       }
      },
      "required": [
       "kind",
       "chain"
      ],
      "type": "object"
     }
    ]
   },
   "shared1": {
    "enum": [
     "button",
     "link",
     "textbox",
     "checkbox",
     "radio",
     "combobox",
     "heading",
     "listitem",
     "option",
     "tab"
    ],
    "type": "string"
   },
   "shared2": {
    "enum": [
     "text",
     "label",
     "placeholder",
     "testId",
     "css"
    ],
    "type": "string"
   }
  },
