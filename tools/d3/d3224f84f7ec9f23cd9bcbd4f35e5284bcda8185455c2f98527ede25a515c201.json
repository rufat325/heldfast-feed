       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "properties": {
       "kind": {
        "const": "element",
        "type": "string"
       },
       "locator": {
        "oneOf": [
         {
          "properties": {
           "exact": {
            "default": true,
            "type": "boolean"
           },
           "frame": {
            "$ref": "#/$defs/shared0"
           },
           "name": {
            "type": "string"
           },
           "strategy": {
            "const": "role",
            "type": "string"
           },
           "value": {
            "$ref": "#/$defs/shared1"
