     {
      "properties": {
       "kind": {
        "const": "main",
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     {
      "properties": {
       "chain": {
        "items": {
         "oneOf": [
          {
           "properties": {
            "exact": {
             "default": true,
             "type": "boolean"
            },
            "name": {
             "type": "string"
            },
            "strategy": {
             "const": "role",
             "type": "string"
            },
            "value": {
             "$ref": "#/$defs/shared1"
            }
           },
           "required": [
            "strategy",
            "value"
           ],
           "type": "object"
          },
          {
