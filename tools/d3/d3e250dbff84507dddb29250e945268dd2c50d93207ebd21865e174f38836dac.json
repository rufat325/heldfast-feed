{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Cellar Statistics"
 },
 "description": "Get cellar statistics: total bottles, value, unique wines, and optional breakdowns. Valid group_by options: color, country, region, varietal, location, bin, category.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "group_by": {
    "description": "Breakdown dimension",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cellar-stats",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "avgPerWine": {
    "type": "number"
   },
   "breakdown": {
    "additionalProperties": false,
    "properties": {
     "dimension": {
      "type": "string"
     },
     "rows": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "bottles": {
         "type": "number"
        },
        "key": {
         "type": "string"
        }
       },
       "required": [
        "key",
        "bottles"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "dimension",
     "rows"
    ],
    "type": "object"
   },
   "totalBottles": {
    "type": "number"
   },
   "totalValue": {
    "type": "number"
   },
   "uniqueWines": {
    "type": "number"
   }
  },
  "required": [
   "totalBottles",
   "totalValue",
   "uniqueWines",
   "avgPerWine"
  ],
  "type": "object"
 }
}
