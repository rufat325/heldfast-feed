{
 "description": "List reservations with optional filters for listing, dates, status, and channel.",
 "inputSchema": {
  "properties": {
   "channelId": {
    "description": "Filter by OTA channel ID (2000=Airbnb, 2003=Booking.com, 2009=VRBO, 2014=Direct)",
    "type": "number"
   },
   "dateFrom": {
    "description": "Check-in date from (YYYY-MM-DD)",
    "type": "string"
   },
   "dateTo": {
    "description": "Check-in date to (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 50, max 100)",
    "type": "number"
   },
   "listingMapId": {
    "description": "Filter by specific listing ID",
    "type": "number"
   },
   "offset": {
    "description": "Pagination offset",
    "type": "number"
   },
   "status": {
    "description": "Reservation status filter",
    "enum": [
     "new",
     "modified",
     "cancelled",
     "inquiry",
     "declined"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_reservations"
}
