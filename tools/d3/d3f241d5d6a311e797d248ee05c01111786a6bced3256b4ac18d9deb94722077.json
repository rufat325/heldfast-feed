{
 "_meta": {
  "com.oxinsider/docs-group": "traders",
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Current Positions"
 },
 "description": "List current prediction-market positions from the public positions-board feed. Returns trader, market, value, side, share, P&L, and freshness context. Cursor-paginated by current value descending.\n\nArgs:\n  - limit (number, 1-100, default 20): Max results per page\n  - cursor (string, optional): Pagination cursor from previous response\n  - min_size (number, optional): Minimum current value in USD; defaults to 100, or to 0 when wallet is present; send 0 for every reconciled position\n  - category (string, optional): Filter by provider-backed market category\n  - condition_id (string, optional): Scope to one market: raw provider condition_id or mkt_-prefixed market id\n  - wallet (string[], optional): Scope to one wallet or a book of wallets (up to 25); each value is a wallet address, known username, or trd_-prefixed trader id\n  - min_grade (string, optional): Minimum trader grade (S, A, B, C, D, F)\n  - side (string, optional): Filter by binary side: \"yes\" or \"no\"\n  - consistency (string, optional): live (default) or snapshot. snapshot requires wallet and freezes up to 500 positions and 2 MB for up to five minutes; repeat the same filters and consistency on every page. A new first page replaces the API key's prior snapshot; a changed filter errors, and an expired or replaced cursor returns cursor_expired\n\nReturns: List of current positions with pagination metadata. The page carries data_quality beside data: status, as_of (the oldest clock the page rests on) and field_groups. fresh means tracked and clocked, not current: compare as_of with your own tolerance. unknown means this read cannot date that group, never that it is recent. With consistency=snapshot, the page also carries snapshot: as_of, expires_at, row_count.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by provider-backed market category",
    "type": "string"
   },
   "condition_id": {
    "description": "Scope to one market: raw provider condition_id or mkt_-prefixed market id",
    "type": "string"
   },
   "consistency": {
    "default": "live",
    "description": "live (default) reads the current value-ordered board. snapshot requires wallet and freezes up to 500 matching rows and 2 MB for up to five minutes; repeat the same filters and consistency on every page. A new first page from the same API key replaces its prior snapshot; a changed filter returns an error, and an expired or replaced cursor returns cursor_expired",
    "enum": [
     "live",
     "snapshot"
    ],
    "type": "string"
   },
   "cursor": {
    "description": "Pagination cursor from previous response",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results (1-100, default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "min_grade": {
    "description": "Minimum trader grade",
    "enum": [
     "S",
     "A",
     "B",
     "C",
     "D",
     "F"
    ],
    "type": "string"
   },
   "min_size": {
    "description": "Minimum current position value in USD; defaults to 100, or to 0 when wallet is present",
    "minimum": 0,
    "type": "number"
   },
   "side": {
    "description": "Filter by binary outcome side",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "wallet": {
    "description": "Scope to one wallet or a book of wallets (up to 25). Each value is a wallet address, a known username, or a trd_-prefixed trader id, resolved like get_trader",
    "items": {
     "type": "string"
    },
    "maxItems": 25,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "get_positions",
