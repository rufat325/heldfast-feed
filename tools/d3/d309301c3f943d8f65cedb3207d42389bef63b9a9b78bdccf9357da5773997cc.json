   "artistId": {
    "description": "Artist ID returned by studio_artists_list or studio_artist_read. Also identifies this artist when casting a Film.",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expectedRevision": {
    "description": "Current revision from the latest read. Stale revisions are refused.",
    "minimum": 1,
    "type": "integer"
   },
   "patch": {
    "additionalProperties": false,
    "minProperties": 1,
    "properties": {
     "bio": {
      "description": "Artist biography; an empty string clears it.",
      "maxLength": 4000,
      "type": "string"
     },
     "faceCovered": {
      "description": "Whether the artist intentionally covers their face. This does not declare a fictional identity.",
      "type": "boolean"
     },
     "genres": {
      "description": "Artist genres. An empty array clears the list.",
      "items": {
       "description": "One value.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 24,
      "type": "array"
     },
     "influences": {
      "description": "Artist influences. An empty array clears the list.",
      "items": {
       "description": "One value.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 24,
      "type": "array"
     },
     "location": {
      "description": "Artist location; an empty string clears it.",
      "maxLength": 120,
      "type": "string"
     },
     "name": {
      "description": "Artist display name.",
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "preferredPalette": {
      "description": "Artist palette tokens. An empty array clears the list.",
      "items": {
       "description": "One value.",
       "maxLength": 32,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 12,
      "type": "array"
     },
     "primaryLanguage": {
      "description": "Artist primary language; an empty string clears it.",
      "maxLength": 60,
      "type": "string"
     },
     "recurringThemes": {
      "description": "Artist recurring themes. An empty array clears the list.",
      "items": {
       "description": "One value.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 24,
      "type": "array"
     },
     "visualKeywords": {
      "description": "Artist visual keywords. An empty array clears the list.",
      "items": {
       "description": "One value.",
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 24,
      "type": "array"
     }
    },
    "required": [],
    "type": "object"
   }
  },
  "required": [
   "artistId",
   "expectedRevision",
   "patch"
  ],
  "type": "object"
 },
