{
 "_meta": {
  "fastmcp": {
   "tags": []
  }
 },
 "description": "Server-side sorted, grouped, paginated list of the caller's journal.\n\nSorting and grouping are done in SQL, so each page is a slice of the\nfully-ordered dataset. Returns ``{total, page, page_size, groups,\nentries}``; ``groups`` carries per-group counts over the whole set.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dpop_token": {
    "default": "",
    "type": "string"
   },
   "group_by": {
    "default": "none",
    "description": "``none`` | ``historicity`` | ``difficulty`` | ``symbol``.",
    "type": "string"
   },
   "group_sort": {
    "default": "asc",
    "description": "Group order, ``asc`` | ``desc``.",
    "type": "string"
   },
   "npub": {
    "default": "",
    "description": "Required. Your Nostr public key (npub1...) for credit billing.",
    "type": "string"
   },
   "page": {
    "default": 0,
    "description": "0-indexed page number.",
    "type": "integer"
   },
   "page_size": {
    "default": 25,
    "description": "Rows per page (1..200, default 25).",
    "type": "integer"
   },
   "sort_col": {
    "default": "created",
    "description": "``created`` | ``updated`` | ``symbol`` | ``historicity`` |\n        ``difficulty`` | ``grade`` | ``score`` | ``status``.",
    "type": "string"
   },
   "sort_dir": {
    "default": "desc",
    "description": "Row order, ``asc`` | ``desc``.",
    "type": "string"
   },
   "status": {
    "default": "",
    "description": "Optional. ``open`` | ``submitted`` | ``evaluated`` | ``abandoned``.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "optionality_list_journal",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 }
}
