{
 "_meta": {
  "openai/toolInvocation/invoked": "Rapier has replied.",
  "openai/toolInvocation/invoking": "Working in Rapier.",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ],
  "website.rapier/tool-class": "read"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Read a note"
 },
 "description": "Reads one note's exact text by file, including a note in Trash. version selects a retained event from notes.history; omit it for the current text. A changed note refuses a continuation with notes_changed. Reading a past version does not authorize replacing the current note.",
 "inputSchema": {
  "additionalProperties": true,
  "properties": {
   "agent": {
    "description": "This assistant's display name.",
    "type": "string"
   },
   "cursor": {
    "description": "Continues the previous page.",
    "maxLength": 128,
    "type": "string"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "file": {
    "description": "The note's file from notes.list.",
    "maxLength": 256,
    "type": "string"
   },
   "limit": {
    "description": "Units per page. Clamped to 12288.",
    "maximum": 9007199254740991,
    "minimum": 256,
    "type": "integer"
   },
   "operation_id": {
    "description": "Optional retry identity scoped to this principal, connection and document. An unchanged mutation replays its original result for 24 hours, even after later edits; its expired identity never executes again. A read replays while its receipt is retained; after 256 later reads it executes afresh. Reusing an identity with changed arguments refuses. Visual observations are fresh. Inspect before starting another operation. Calls without it never replay.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "start": {
    "description": "The first UTF-16 unit.",
    "maximum": 26214400,
    "minimum": 0,
    "type": "integer"
   },
   "version": {
    "description": "A version from notes.history.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "document",
   "file"
  ],
  "type": "object"
 },
 "name": "notes.read",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "availability": {
    "enum": [
     "available",
     "locked",
     "unavailable"
    ]
   },
   "cause": {
    "enum": [
     "will",
     "ask",
     "check",
     "proposal"
    ]
   },
   "complete": {
    "type": "boolean"
   },
   "document": {
    "description": "The document value rapier.open returned. With a connected host it names the workspace and the connection is the authority; without one it is the workspace's whole authority, so keep it private.",
    "maxLength": 64,
    "type": "string"
   },
   "documentId": {
    "type": "string"
   },
   "documentRevision": {
    "type": "integer"
   },
   "end": {
    "minimum": 0,
    "type": "integer"
   },
   "file": {
    "maxLength": 256,
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "next_cursor": {
    "maxLength": 128,
    "type": [
     "string",
     "null"
    ]
   },
   "omitted": {
    "minimum": 0,
    "type": "integer"
   },
   "outcome": {
    "enum": [
     "ok",
     "target_gone",
     "conflict",
     "invalid",
     "refused",
     "uncertain"
    ],
    "type": "string"
   },
   "reason": {
    "type": "string"
   },
   "remaining": {
    "minimum": 0,
    "type": "integer"
   },
   "representation": {
    "const": "source"
   },
   "reviewId": {
    "maxLength": 128,
    "type": "string"
   },
   "start": {
    "minimum": 0,
    "type": "integer"
   },
   "text": {
    "maxLength": 12288,
    "type": [
     "string",
     "null"
    ]
   },
   "version": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "outcome"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Read a note"
}
