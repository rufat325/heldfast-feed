{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Research your niche"
 },
 "description": "Ask a question about your niche and get back the posts that answer it. Give question and product_id and it starts searching for that question, which takes a few minutes, and returns at once with a thread_id and status working. Call it again with just the thread_id, about every 15 seconds, until status is ready; then posts are the answer, best first. Each has its URL, caption, hashtags, views, likes, comments, shares and saves, the creator\u2019s follower count, and outperformance: views as a multiple of that creator\u2019s median over the posts we hold of theirs, null when we hold too few. fit says how well a post suits your product (in_niche, adjacent, off_topic) and posts judged off-topic are left out unless you ask for all. A thread takes one question at a time: asking again while it is working does not start a new one. With a failed status, ask the question again. Starting a question uses search credit, so do not repeat one that is working. With neither question nor thread_id it reads what is already indexed, instantly. A post we have watched also carries hook, genre, format and repeatableStructure (null until watched), and a question\u2019s answer gives each post a why: one line on what the video is and how it was judged. The top-level formats and ideas are empty for now.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fit": {
    "description": "How closely a post must fit your product. relevant (default) drops posts judged off-topic and keeps ones not judged yet; in_niche keeps only judged in-niche posts; all keeps everything.",
    "enum": [
     "relevant",
     "in_niche",
     "all"
    ],
    "type": "string"
   },
   "include_ads": {
    "description": "Include posts TikTok marks as paid promotion. Default false.",
    "type": "boolean"
   },
   "language": {
    "description": "Only this language, as a two-letter code such as en. Posts whose language TikTok could not tell are kept.",
    "maxLength": 5,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "description": "How many posts. Default 10.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "medium": {
    "description": "Only videos, or only slideshows.",
    "enum": [
     "video",
     "slideshow"
    ],
    "type": "string"
   },
   "product_id": {
    "description": "The product this is for, from products_list. Required with a question. Without one, narrows the index read to this product.",
    "type": "string"
   },
   "question": {
    "description": "What you want to know, in plain words, as you would ask a researcher. Starts a new search for it. Needs product_id.",
    "maxLength": 2000,
    "type": "string"
   },
   "since": {
    "description": "Posted on or after this ISO 8601 time. Default: 7 days ago for an index read, 30 days for a question\u2019s answer.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$",
    "type": "string"
   },
   "thread_id": {
    "description": "A thread from an earlier call. Alone, it returns where that question is, or its answer once ready. With a question, it asks a follow-up on the same thread once the last one is done.",
    "type": "string"
   }
  },
  "type": "object"
 },
