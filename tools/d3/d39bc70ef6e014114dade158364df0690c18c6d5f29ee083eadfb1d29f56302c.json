        "auth-required",
        "dead",
        "unsafe",
        "unsupported",
        "rate-limited",
        "transient",
        "timeout",
        "content-mismatch",
        "wrong-chain",
        "unknown"
       ],
       "type": "string"
      },
      "error_class": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "kind": {
       "enum": [
        "archive",
