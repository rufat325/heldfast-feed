        "source-repo",
        "sse",
        "subnet-api",
        "subtensor-rpc",
        "subtensor-wss",
        "website"
       ],
       "type": "string"
      },
      "last_checked": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "last_ok": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "latency_ms": {
       "anyOf": [
        {
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "netuid": {
       "minimum": 0,
       "type": "integer"
      },
      "provider": {
       "type": "string"
      },
      "status": {
       "enum": [
        "ok",
