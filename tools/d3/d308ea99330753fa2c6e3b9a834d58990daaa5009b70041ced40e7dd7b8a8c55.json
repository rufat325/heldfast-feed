{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Calculate a non-binding, non-persisted rental quote. Availability and payment remain with the representative rental company.",
 "inputSchema": {
  "properties": {
   "agent_session_id": {
    "anyOf": [
     {
      "maxLength": 120,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._:-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Agent Session Id"
   },
   "agent_source": {
    "anyOf": [
     {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[a-zA-Z0-9._:-]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Agent Source"
   },
   "driver_age": {
    "maximum": 85,
    "minimum": 21,
    "title": "Driver Age",
    "type": "integer"
   },
   "market": {
    "default": "FJ",
    "maxLength": 2,
    "minLength": 2,
    "title": "Market",
    "type": "string"
   },
   "pickup_at": {
    "format": "date-time",
    "title": "Pickup At",
    "type": "string"
   },
   "pickup_location": {
    "default": "Nadi International Airport",
    "maxLength": 200,
    "minLength": 2,
    "title": "Pickup Location",
    "type": "string"
   },
   "quote_currency": {
    "default": "FJD",
    "maxLength": 3,
    "minLength": 3,
    "title": "Quote Currency",
    "type": "string"
   },
   "return_at": {
    "format": "date-time",
    "title": "Return At",
    "type": "string"
   },
   "return_location": {
    "default": "Nadi International Airport",
    "maxLength": 200,
    "minLength": 2,
    "title": "Return Location",
    "type": "string"
   },
   "vehicle_slug": {
    "maxLength": 100,
    "minLength": 1,
    "title": "Vehicle Slug",
    "type": "string"
   }
  },
  "required": [
   "vehicle_slug",
   "pickup_at",
   "return_at",
   "driver_age"
  ],
  "title": "RentalQuoteRequest",
  "type": "object"
 },
 "name": "preview_rental_quote",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "booking_eligible_from_preview": {
    "const": false,
    "type": "boolean"
   },
   "market": {
    "type": "string"
   },
   "next_action": {
    "type": "string"
   },
   "persisted": {
    "const": false,
    "type": "boolean"
   },
   "preview": {
    "const": true,
    "type": "boolean"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "market",
   "status",
   "preview",
   "persisted",
   "booking_eligible_from_preview",
   "next_action"
  ],
  "type": "object"
 },
 "title": "Preview a Fiji vehicle-rental quote"
}
