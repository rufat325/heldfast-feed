{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit a hiring pipeline stage"
 },
 "description": "Edit a pipeline stage. Canonical default stages allow display-name change only; slug/stage_kind/approval_scope/is_terminal are locked.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "approval_scope": {
    "anyOf": [
     {
      "enum": [
       "applications:offer",
       "applications:hire",
       "applications:reject",
       "applications:withdraw"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "is_active": {
    "type": "boolean"
   },
   "is_terminal": {
    "type": "boolean"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "pipeline_id": {
    "minLength": 1,
    "type": "string"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9_]{0,62}$",
    "type": "string"
   },
   "stage_id": {
    "minLength": 1,
    "type": "string"
   },
   "stage_kind": {
    "enum": [
     "normal",
     "offer",
     "hired",
     "rejected",
     "terminal"
    ],
    "type": "string"
   }
  },
  "required": [
   "pipeline_id",
   "stage_id"
  ],
  "type": "object"
 },
 "name": "yardstick_pipelines_stages_update",
 "title": "Edit a hiring pipeline stage"
}
