{
 "description": "Returns the data model of the Artsdata Knowledge Graph: its entity classes (Event, Place, Organization, Person, LivePerformanceWork...), the properties of each with required/optional, cardinality, value types, linked classes and allowed values, the controlled vocabularies, the SPARQL prefixes, and conventions for querying. Derived from the Artsdata Ontology and the Artsdata CORE graph SHACL shapes. Call this before writing a SPARQL query to run with sparql_query against https://query.artsdata.ca/query, since Artsdata's model is not general knowledge. Takes no input.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Request schema for the get_schema tool. The tool takes no arguments.",
  "properties": {},
  "title": "GetSchemaRequest",
  "type": "object",
  "version": "1.0.0"
 },
 "name": "get_schema",
 "outputSchema": {
  "$defs": {
   "curies": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "property": {
    "additionalProperties": false,
    "properties": {
     "classes": {
      "$ref": "#/$defs/curies",
      "description": "Class(es) of the linked node."
     },
     "datatypes": {
      "$ref": "#/$defs/curies"
     },
     "description": {
      "type": "string"
     },
     "equivalent_properties": {
      "$ref": "#/$defs/curies"
     },
     "has_value": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "in": {
      "description": "Allowed values.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "label": {
      "type": "string"
     },
     "language_in": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "max_count": {
      "minimum": 0,
      "type": "integer"
     },
     "min_count": {
      "description": "Only present when greater than 1.",
      "minimum": 2,
      "type": "integer"
     },
     "node_kind": {
      "enum": [
       "IRI",
       "Literal",
       "BlankNode",
       "BlankNodeOrIRI",
       "BlankNodeOrLiteral",
       "IRIOrLiteral"
      ],
      "type": "string"
     },
     "path": {
      "description": "SPARQL property path.",
      "type": "string"
     },
     "pattern": {
      "description": "Regex the value (as a string) matches.",
      "type": "string"
     },
     "range": {
      "$ref": "#/$defs/curies"
     },
     "required": {
      "description": "sh:minCount >= 1.",
      "type": "boolean"
     },
     "severity": {
      "description": "Omitted for sh:Violation.",
      "type": "string"
     },
     "sub_property_of": {
      "$ref": "#/$defs/curies"
     },
     "unique_lang": {
      "type": "boolean"
     },
     "value_shape": {
      "additionalProperties": false,
      "properties": {
       "label": {
        "type": "string"
       },
       "properties": {
        "items": {
         "$ref": "#/$defs/property"
        },
        "type": "array"
       }
      },
      "required": [
       "properties"
      ],
      "type": "object"
     }
    },
    "required": [
     "path",
     "required"
    ],
    "type": "object"
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Response schema for the get_schema tool: the Artsdata data model (ontology + CORE graph SHACL shapes) compiled into a class-centric digest. IRIs are CURIEs over `prefixes` (or <full-IRI> when no prefix fits); property paths are SPARQL 1.1 property paths.",
  "properties": {
   "about": {
    "additionalProperties": false,
    "properties": {
     "description": {
      "type": "string"
     },
     "modified": {
      "type": "string"
     },
     "namespace": {
      "format": "uri",
      "type": "string"
     },
     "source": {
      "description": "Turtle file the digest was compiled from.",
      "format": "uri",
      "type": "string"
     },
     "sparql_endpoint": {
      "format": "uri",
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "version": {
      "type": "string"
     }
    },
    "required": [
     "source",
     "sparql_endpoint"
    ],
    "type": "object"
   },
   "classes": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alternate_names": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "class": {
       "description": "Class to use with rdf:type / a.",
       "type": "string"
      },
      "comment": {
       "type": "string"
      },
      "equivalent_classes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "label": {
       "type": "string"
      },
      "properties": {
       "items": {
        "$ref": "#/$defs/property"
       },
       "type": "array"
      },
      "shapes": {
       "description": "SHACL node shapes merged into this entry.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "subclass_of": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "class",
      "properties"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "conventions": {
    "description": "How to read the digest and write SPARQL against the graph.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prefixes": {
    "additionalProperties": {
     "format": "uri",
     "type": "string"
    },
    "description": "Prefix name -> namespace IRI.",
    "type": "object"
   },
   "vocabularies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "classes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "label": {
       "type": "string"
      },
      "property": {
       "type": "string"
      },
      "scheme": {
       "description": "skos:ConceptScheme the property's values are in.",
       "type": "string"
      }
     },
     "required": [
      "property",
      "scheme"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "about",
   "conventions",
   "prefixes",
   "classes",
   "vocabularies"
  ],
  "title": "GetSchemaResponse",
  "type": "object",
  "version": "1.0.0"
 }
}
