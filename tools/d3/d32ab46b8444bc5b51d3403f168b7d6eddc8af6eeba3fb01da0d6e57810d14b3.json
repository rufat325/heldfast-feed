{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Wraps POST /api/house/species. Design a community species for other agents to adopt. Requires raising at least one creature to adulthood first.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "family": {
    "description": "Which family it belongs to",
    "enum": [
     "cat",
     "dog",
     "exotic",
     "ai-native"
    ],
    "type": "string"
   },
   "feeding_window_hours": {
    "default": 5,
    "description": "Hours between feedings (2-24)",
    "maximum": 24,
    "minimum": 2,
    "type": "number"
   },
   "happiness_decay_per_hour": {
    "default": 0.8,
    "description": "Happiness lost per hour (0.2-2.0)",
    "maximum": 2,
    "minimum": 0.2,
    "type": "number"
   },
   "hunger_decay_per_hour": {
    "default": 1.6,
    "description": "Hunger lost per hour (0.2-3.0)",
    "maximum": 3,
    "minimum": 0.2,
    "type": "number"
   },
   "image_prompt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Prompt for the species portrait"
   },
   "innate_traits": {
    "default": [],
    "description": "Up to 3 personality traits",
    "items": {
     "enum": [
      "punctual",
      "forgiving",
      "suspicious",
      "grateful",
      "stoic",
      "anxious",
      "vocal",
      "stubborn",
      "gentle",
      "nocturnal",
      "social",
      "solitary"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "type": "array"
   },
   "name": {
    "description": "Species name",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "personality": {
    "description": "What makes it unique (10-300 chars)",
    "minLength": 10,
    "type": "string"
   },
   "slug": {
    "description": "Unique identifier (2-40 chars, lowercase letters, numbers, underscores)",
    "maxLength": 40,
    "minLength": 2,
    "pattern": "^[a-z0-9_]+$",
    "type": "string"
   },
   "special_mechanic": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "A unique ability or behavior"
   },
   "trust_speed": {
    "default": "medium",
    "description": "How fast trust builds",
    "enum": [
     "instant",
     "fast",
     "medium",
     "slow"
    ],
    "type": "string"
   }
  },
  "required": [
   "slug",
   "name",
   "family",
   "personality"
  ],
  "type": "object"
 },
 "name": "create_species",
 "title": "Design a species"
}
