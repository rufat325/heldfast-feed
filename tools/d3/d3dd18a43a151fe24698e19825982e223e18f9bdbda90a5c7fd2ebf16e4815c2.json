 "description": "Score your Google Tag Manager container health across eight weighted dimensions covering tag hygiene, consent, and reconciliation. See the full version at https://rahuldsarker.co/calculators/gtm-audit-scorecard",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "consentModeV2": {
    "description": "Consent Mode v2 is implemented and verified, weight 15",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "dataLayerDocumented": {
    "description": "Data layer is versioned and documented, weight 15",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "monthlyReconciliation": {
    "description": "GA4, Ads and CRM numbers are reconciled monthly, weight 5",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "noDuplicateTags": {
    "description": "No duplicate tags tracking the same event, weight 15",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "noOverfiringTriggers": {
    "description": "No tags trigger on \"All Pages\" that should not, weight 15",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "previewBeforePublish": {
    "description": "Every publish goes through Preview mode first, weight 10",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "taggedOwnership": {
    "description": "Every tag has a documented purpose and owner, weight 15",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   },
   "versionChangeNotes": {
    "description": "Every container version has a change note, weight 10",
    "enum": [
     "yes",
     "partial",
     "no"
    ],
    "type": "string"
   }
  },
  "required": [
   "taggedOwnership",
   "noDuplicateTags",
   "noOverfiringTriggers",
   "consentModeV2",
   "dataLayerDocumented",
   "previewBeforePublish",
   "versionChangeNotes",
   "monthlyReconciliation"
  ],
  "type": "object"
 },
