{
 "description": "Manage structured memory items. Use this to list, add, update, resolve, archive, or delete blockers, assumptions, questions, and resolutions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "Operation to perform on memory",
    "enum": [
     "list",
     "get",
     "add",
     "update",
     "resolve",
     "archive",
     "delete"
    ],
    "type": "string"
   },
   "after": {
    "description": "Only include items created after this timestamp",
    "type": "string"
   },
   "author": {
    "description": "Author for add/update or filtering",
    "type": "string"
   },
   "before": {
    "description": "Only include items created before this timestamp",
    "type": "string"
   },
   "global": {
    "default": false,
    "description": "Use global personal memory scope",
    "type": "boolean"
   },
   "hard": {
    "default": false,
    "description": "Hard delete instead of archiving",
    "type": "boolean"
   },
   "id": {
    "description": "Memory item id for get/update/resolve/archive/delete",
    "type": "string"
   },
   "json": {
    "default": false,
    "description": "Return JSON instead of formatted text",
    "type": "boolean"
   },
   "limit": {
    "description": "Max number of items to return when listing",
    "exclusiveMinimum": 0,
    "maximum": 200,
    "type": "integer"
   },
   "message": {
    "description": "Message for add/update",
    "type": "string"
   },
   "scope": {
    "description": "Memory scope: repo, global, or all. Writes require repo or global.",
    "enum": [
     "repo",
     "global",
     "all"
    ],
    "type": "string"
   },
   "source": {
    "description": "Source for add/update or filtering",
    "type": "string"
   },
   "status": {
    "description": "Status for add/update or filtering",
    "enum": [
     "open",
     "resolved",
     "archived"
    ],
    "type": "string"
   },
   "tag": {
    "description": "Tag for add/update or filtering",
    "type": "string"
   },
   "type": {
    "description": "Memory type for add or filtering",
    "enum": [
     "decision",
     "blocker",
     "assumption",
     "question",
     "resolution"
    ],
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "mindswap_memory"
}
