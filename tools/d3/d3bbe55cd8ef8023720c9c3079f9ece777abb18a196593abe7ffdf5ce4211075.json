{
 "description": "Git integration for vibe coding sessions. Get repository status, commit history, diffs, branch info. Capture git snapshots for sessions and extract design decisions from commit messages.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "status",
     "log",
     "diff",
     "branch",
     "snapshot",
     "extractDecisions",
     "linkToSession"
    ],
    "type": "string"
   },
   "author": {
    "type": "string"
   },
   "contextLines": {
    "default": 3,
    "maximum": 20,
    "minimum": 0,
    "type": "number"
   },
   "diffType": {
    "default": "all",
    "enum": [
     "staged",
     "unstaged",
     "all"
    ],
    "type": "string"
   },
   "fromRef": {
    "type": "string"
   },
   "grep": {
    "type": "string"
   },
   "includeDiff": {
    "default": true,
    "type": "boolean"
   },
   "includeLog": {
    "default": true,
    "type": "boolean"
   },
   "includeRemote": {
    "default": true,
    "type": "boolean"
   },
   "includeStash": {
    "default": false,
    "type": "boolean"
   },
   "includeUntracked": {
    "default": true,
    "type": "boolean"
   },
   "language": {
    "default": "auto",
    "enum": [
     "en",
     "ko",
     "auto"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 500,
    "minimum": 1,
    "type": "number"
   },
   "logLimit": {
    "default": 10,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "oneline": {
    "default": false,
    "type": "boolean"
   },
   "path": {
    "type": "string"
   },
   "patterns": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "repoPath": {
    "type": "string"
   },
   "sessionId": {
    "type": "string"
   },
   "since": {
    "type": "string"
   },
   "snapshotType": {
    "default": "minimal",
    "enum": [
     "minimal",
     "full"
    ],
    "type": "string"
   },
   "stat": {
    "default": true,
    "type": "boolean"
   },
   "toRef": {
    "type": "string"
   },
   "until": {
    "type": "string"
   },
   "verbose": {
    "default": false,
    "type": "boolean"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_git"
}
