{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List all tags in the knowledge base, optionally filtered by name pattern",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filter": {
    "type": "string"
   },
   "limit": {
    "default": 100,
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "orderBy": {
    "default": "usage",
    "enum": [
     "usage",
     "name",
     "recent"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_tags",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tags": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "id": {
       "type": "number"
      },
      "name": {
       "type": "string"
      },
      "usageCount": {
       "type": "number"
      }
     },
     "required": [
      "id",
      "name",
      "description",
      "usageCount"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tags"
  ],
  "type": "object"
 },
 "title": "List Tags"
}
