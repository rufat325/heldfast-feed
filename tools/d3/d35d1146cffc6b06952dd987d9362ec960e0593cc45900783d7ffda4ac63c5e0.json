{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Domain, DNS, Email and SSL Lookup"
 },
 "description": "Look up everything about a domain: WHOIS-style registration data (registrar, creation and expiry dates via RDAP), DNS records (A, AAAA, MX, NS, TXT), email security (parsed SPF and DMARC), and the website's SSL/TLS certificate issuer and expiry date. Use it to research a company's domain, check when a domain or certificate expires, debug DNS or email deliverability, or verify who hosts a site. Price: $0.01 per successful call; failed calls are free. Free to try: a few calls a day without a key.",
 "execution": {
  "taskSupport": "forbidden"
 },
