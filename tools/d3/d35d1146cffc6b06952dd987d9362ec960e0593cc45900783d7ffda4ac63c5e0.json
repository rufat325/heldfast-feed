  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "domain": {
    "description": "The domain or hostname to inspect, e.g. \"example.com\".",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
