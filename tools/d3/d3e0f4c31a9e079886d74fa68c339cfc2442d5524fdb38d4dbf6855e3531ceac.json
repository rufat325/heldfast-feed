{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Container detail"
 },
 "description": "Full status for a single container: current status, route, ETA with confidence, carrier, vessel, all events, and AI-generated shipment narrative. Use this when asked about a specific container.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "container_id": {
    "description": "Container number (e.g. MRKU5004867) or B/L number (e.g. SEGU3103001)",
    "type": "string"
   }
  },
  "required": [
   "container_id"
  ],
  "type": "object"
 },
 "name": "get_container_detail",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "description": "On an empty result: NOT_FOUND (no record after asking) or NO_EVENTS (record, nothing filed).",
    "type": "string"
   },
   "data": {
    "additionalProperties": true,
    "properties": {
     "ai_narrative": {
      "description": "Plain-language summary of where the box is",
      "type": [
       "string",
       "null"
      ]
     },
     "bl_number": {
      "type": [
       "string",
       "null"
      ]
     },
     "carrier": {
      "description": "SCAC of the operating line",
      "type": [
       "string",
       "null"
      ]
     },
     "container_number": {
      "type": [
       "string",
       "null"
      ]
     },
     "demurrage_free_days_left": {
      "type": [
       "number",
       "null"
      ]
     },
     "destination_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "eta": {
      "description": "ISO 8601",
      "type": [
       "string",
       "null"
      ]
     },
     "eta_confidence_pct": {
      "type": [
       "number",
       "null"
      ]
     },
     "events": {
      "anyOf": [
       {
        "items": {
         "additionalProperties": true,
         "properties": {
          "location": {
           "type": [
            "string",
            "null"
           ]
          },
          "timestamp": {
           "description": "ISO 8601",
           "type": [
            "string",
            "null"
           ]
          },
          "type": {
           "type": [
            "string",
            "null"
           ]
          }
         },
         "type": "object"
        },
        "type": "array"
       },
       {
        "type": "null"
       }
      ],
      "description": "Filed milestones, newest first"
     },
     "id": {
      "type": [
       "string",
       "null"
      ]
     },
     "identifier": {
      "description": "Container number or B/L as tracked",
      "type": [
       "string",
       "null"
      ]
     },
     "origin_name": {
      "type": [
       "string",
       "null"
      ]
     },
     "reference": {
      "description": "On an empty result: the reference that was asked for",
      "type": [
       "string",
       "null"
      ]
     },
     "status": {
      "type": [
       "string",
       "null"
      ]
     },
     "vessel_imo": {
      "type": [
       "string",
       "null"
      ]
     },
     "vessel_name": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "message": {
    "description": "On an empty result: what the emptiness means.",
    "type": "string"
   },
   "ok": {
    "description": "False never appears here \u2014 failures arrive as tool errors.",
    "type": "boolean"
   },
   "result": {
    "description": "\"empty\" means the query succeeded and there is nothing to report.",
    "enum": [
     "data",
     "empty"
    ],
    "type": "string"
   }
  },
  "required": [
   "ok",
   "result"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "openid",
    "email",
    "profile"
   ],
   "type": "oauth2"
  }
 ]
}
