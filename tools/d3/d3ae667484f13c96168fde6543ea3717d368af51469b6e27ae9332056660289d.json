{
 "description": "Update store listing for a specific locale (title, description, short description, video URL).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "fullDescription": {
    "description": "Full description (max 4000 chars)",
    "type": "string"
   },
   "language": {
    "description": "Locale code (en-US, tr-TR, de-DE, es-419, fr-FR, ru-RU, ar)",
    "enum": [
     "en-US",
     "tr-TR",
     "de-DE",
     "es-419",
     "fr-FR",
     "ru-RU",
     "ar"
    ],
    "type": "string"
   },
   "shortDescription": {
    "description": "Short description (max 80 chars)",
    "type": "string"
   },
   "title": {
    "description": "App title (max 30 chars)",
    "type": "string"
   },
   "video": {
    "description": "YouTube video URL",
    "type": "string"
   }
  },
  "required": [
   "language"
  ],
  "type": "object"
 },
 "name": "gpc_update_listing"
}
