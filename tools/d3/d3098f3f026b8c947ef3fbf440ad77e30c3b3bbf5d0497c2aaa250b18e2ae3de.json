{
 "description": "Stage 1 \u2014 polishes raw text for grammar, tone, and clarity without changing meaning or translating it. Use before translate_text when the input is rough.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "description": "Target audience (tone calibration only)",
    "enum": [
     "Junior Dev",
     "Senior Dev",
     "Tech Lead",
     "SRE",
     "Data Engineer"
    ],
    "type": "string"
   },
   "context": {
    "description": "Tech context (tone calibration only)",
    "enum": [
     "Backend",
     "Frontend",
     "Mobile",
     "Data/ML",
     "DevOps"
    ],
    "type": "string"
   },
   "input": {
    "description": "Raw text to polish",
    "maxLength": 10000,
    "minLength": 10,
    "type": "string"
   },
   "managedModel": {
    "description": "Pin a specific managed model (server-side allowlist)",
    "type": "string"
   }
  },
  "required": [
   "input",
   "audience",
   "context"
  ],
  "type": "object"
 },
 "name": "optimize_text"
}
