{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Update webhook"
 },
 "description": "Update an existing webhook's endpoint URL and/or subscriptions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endpointUrl": {
    "description": "New HTTPS URL to send webhook events to",
    "format": "uri",
    "type": "string"
   },
   "subscriptions": {
    "description": "Updated list of event types to subscribe to (at least one). 'categoryTailnetManagement' and 'categoryDeviceMisconfigurations' subscribe to a whole category, including events Tailscale adds to it later.",
    "items": {
     "enum": [
      "categoryDeviceMisconfigurations",
      "categoryTailnetManagement",
      "exitNodeIPForwardingNotEnabled",
      "nodeApproved",
      "nodeCreated",
      "nodeDeleted",
      "nodeKeyExpired",
      "nodeKeyExpiringInOneDay",
      "nodeNeedsApproval",
      "nodeNeedsSignature",
      "nodeSigned",
      "policyUpdate",
      "subnetIPForwardingNotEnabled",
      "userApproved",
      "userCreated",
      "userDeleted",
      "userNeedsApproval",
      "userRestored",
      "userRoleUpdated",
      "userSuspended"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "webhookId": {
    "description": "The webhook ID to update",
    "type": "string"
   }
  },
  "required": [
   "webhookId"
  ],
  "type": "object"
 },
 "name": "tailscale_update_webhook",
 "title": "Update webhook"
}
