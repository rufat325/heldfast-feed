{
 "description": "Sort a data file by one or more fields. Modifies the file in place",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "file": {
    "description": "Data file to sort",
    "type": "string"
   },
   "project": {
    "description": "Project name",
    "type": "string"
   },
   "sort_by": {
    "description": "Sort specification: [{field, dir?, type?}]",
    "items": {
     "additionalProperties": false,
     "properties": {
      "dir": {
       "enum": [
        "asc",
        "desc"
       ],
       "type": "string"
      },
      "field": {
       "type": "string"
      },
      "type": {
       "enum": [
        "text",
        "numeric"
       ],
       "type": "string"
      }
     },
     "required": [
      "field"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "userid": {
    "description": "Project owner's username. Required when accessing a shared project where you are a writer. Defaults to the authenticated user.",
    "type": "string"
   }
  },
  "required": [
   "project",
   "file",
   "sort_by"
  ],
  "type": "object"
 },
 "name": "chaprola_sort"
}
