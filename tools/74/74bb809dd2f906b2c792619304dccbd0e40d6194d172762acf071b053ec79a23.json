{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a Prometheus metrics scaffold with PromQL/client adapter notes, metric maps, alert routes, and operator-dashboard safety guidance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "webclient_promql",
    "enum": [
     "webclient_promql",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "alert_count": {
    "default": 4,
    "maximum": 128,
    "minimum": 0,
    "type": "integer"
   },
   "endpoint_url": {
    "default": "http://127.0.0.1:9090",
    "type": "string"
   },
   "job_name": {
    "default": "tdmcp-show",
    "type": "string"
   },
   "metric_count": {
    "default": 12,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "prometheus_metrics_panel",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the Prometheus scaffold.",
    "type": "string"
   },
   "scrape_interval_seconds": {
    "default": 15,
    "maximum": 3600,
    "minimum": 1,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "connect_prometheus_metrics_panel",
 "title": "Connect Prometheus metrics panel"
}
