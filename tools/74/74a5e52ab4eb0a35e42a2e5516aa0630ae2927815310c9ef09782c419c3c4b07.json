{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/freelance-rate-calculator"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Freelance hourly and day rates"
 },
 "description": "Calculate sustainable rates. margin is a percentage buffer added to annual income plus overhead, matching the website. All money must use the same currency. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "annualIncome": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "billableHours": {
    "exclusiveMinimum": 0,
    "maximum": 168,
    "type": "number"
   },
   "billableWeeks": {
    "exclusiveMinimum": 0,
    "maximum": 53,
    "type": "number"
   },
   "hoursPerDay": {
    "exclusiveMinimum": 0,
    "maximum": 24,
    "type": "number"
   },
   "margin": {
    "maximum": 95,
    "minimum": 0,
    "type": "number"
   },
   "overhead": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "annualIncome",
   "overhead",
   "billableWeeks",
   "billableHours",
   "hoursPerDay",
   "margin"
  ],
  "type": "object"
 },
 "name": "freelance_rate",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "annualBillableHours": {
    "type": "number"
   },
   "dayRate": {
    "type": "number"
   },
   "hourlyRate": {
    "type": "number"
   },
   "incomePortion": {
    "type": "number"
   },
   "marginPortion": {
    "type": "number"
   },
   "overheadPortion": {
    "type": "number"
   },
   "totalNeeded": {
    "type": "number"
   }
  },
  "required": [
   "totalNeeded",
   "annualBillableHours",
   "hourlyRate",
   "dayRate",
   "incomePortion",
   "overheadPortion",
   "marginPortion"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Freelance hourly and day rates"
}
