{
 "description": "Create a reminder. Prefer oden_create_todo with remind_at instead.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "message": {
    "description": "Reminder message",
    "type": "string"
   },
   "remind_at": {
    "description": "ISO datetime with timezone offset (e.g. 2026-03-29T14:00:00+02:00)",
    "type": "string"
   }
  },
  "required": [
   "message",
   "remind_at"
  ],
  "type": "object"
 },
 "name": "oden_create_reminder"
}
