{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a new Search Engine Service cluster (G3/KVM). Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clusterName": {
    "description": "Cluster name (3-15 chars, lowercase+numbers+'-')",
    "type": "string"
   },
   "dataNodeCount": {
    "description": "Number of data nodes (3-10)",
    "type": "number"
   },
   "dataNodeServerSpecCode": {
    "description": "Data node server spec code",
    "type": "string"
   },
   "dataNodeStorageSize": {
    "description": "Data node storage size in GB (100-2000)",
    "type": "number"
   },
   "dataNodeSubnetNo": {
    "description": "Data node subnet number",
    "type": "number"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview only without creating",
    "type": "boolean"
   },
   "isDualManager": {
    "description": "Manager node redundancy (default: true)",
    "type": "boolean"
   },
   "isMasterOnlyNodeActivated": {
    "description": "Enable dedicated master nodes",
    "type": "boolean"
   },
   "loginKeyName": {
    "description": "Authentication key name",
    "type": "string"
   },
   "managerNodeServerSpecCode": {
    "description": "Manager node server spec code (from getServerSpecList)",
    "type": "string"
   },
   "managerNodeSubnetNo": {
    "description": "Manager node subnet number",
    "type": "number"
   },
   "masterNodeCount": {
    "description": "Number of master nodes (3 or 5)",
    "type": "number"
   },
   "masterNodeServerSpecCode": {
    "description": "Master node server spec code",
    "type": "string"
   },
   "masterNodeSubnetNo": {
    "description": "Master node subnet",
    "type": "number"
   },
   "searchEngineDashboardPort": {
    "description": "Dashboard port (1025-65534, not 9090/9200/9300)",
    "type": "string"
   },
   "searchEngineUserName": {
    "description": "Admin account ID (3-15 chars)",
    "type": "string"
   },
   "searchEngineUserPassword": {
    "description": "Admin password (8-20 chars)",
    "type": "string"
   },
   "searchEngineVersionCode": {
    "description": "Search engine version code",
    "type": "string"
   },
   "softwareProductCode": {
    "description": "OS type code (from getClusterServerImageList)",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number",
    "type": "number"
   }
  },
  "required": [
   "clusterName",
   "searchEngineVersionCode",
   "searchEngineDashboardPort",
   "searchEngineUserName",
   "searchEngineUserPassword",
   "softwareProductCode",
   "vpcNo",
   "managerNodeSubnetNo",
   "managerNodeServerSpecCode",
   "dataNodeSubnetNo",
   "dataNodeCount",
   "dataNodeServerSpecCode",
   "dataNodeStorageSize",
   "loginKeyName"
  ],
  "type": "object"
 },
 "name": "ncloud_ses_create_cluster_g3"
}
