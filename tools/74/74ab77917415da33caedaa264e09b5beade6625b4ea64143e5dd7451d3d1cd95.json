{
 "description": "Compress an image: png/jpeg/webp base64 in (\u22648MiB, \u226440MP), re-encoded with metadata stripped; returns content_base64/original_bytes/compressed_bytes",
 "inputSchema": {
  "properties": {
   "format": {
    "default": "jpeg",
    "enum": [
     "jpeg",
     "png"
    ],
    "type": "string"
   },
   "image_base64": {
    "description": "Image content, base64",
    "type": "string"
   },
   "quality": {
    "default": 75,
    "description": "1\u2013100, jpeg only",
    "type": "integer"
   }
  },
  "required": [
   "image_base64"
  ],
  "type": "object"
 },
 "name": "compress_image"
}
