{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get GitHub Actions analytics"
 },
 "description": "Get time-bucketed GitHub Actions analytics for Depot runners: job counts (successful/failed/cancelled), failure rate, elapsed and billable seconds, average duration \u2014 as totals plus hourly or daily buckets. Defaults to the last 30 days (max 90). Depot: GithubActionsService/GetGithubActionsAnalytics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "aggregation_unit": {
    "description": "Bucket size. Default: day.",
    "enum": [
     "hour",
     "day"
    ],
    "type": "string"
   },
   "end_at": {
    "description": "Window end, RFC 3339 (e.g. 2026-09-18T00:00:00Z).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "jobs": {
    "description": "Job display names to include.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "repositories": {
    "description": "Connected repositories in owner/name format, e.g. [\"acme/widgets\"]. Empty = all.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "runner_labels": {
    "description": "Runner labels to include, e.g. depot-ubuntu-24.04-8.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "start_at": {
    "description": "Window start, RFC 3339 (e.g. 2026-09-17T00:00:00Z).",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "workflow_paths": {
    "description": "Workflow file paths to include, e.g. .github/workflows/ci.yml.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workflows": {
    "description": "Workflow names to include.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "depot_gha_get_analytics",
 "title": "Get GitHub Actions analytics"
}
