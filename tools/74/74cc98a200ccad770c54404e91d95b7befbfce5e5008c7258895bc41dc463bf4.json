{
 "annotations": {
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Check a previously created public-source watch immediately. The result reports whether the response-body hash changed; it is not a semantic diff.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "token": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "watch_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "watch_id",
   "token"
  ],
  "type": "object"
 },
 "name": "source_watch_check",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "deleted": {
    "type": "boolean"
   },
   "operation": {
    "type": "string"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "token": {
    "type": "string"
   },
   "watch": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "success",
   "operation"
  ],
  "type": "object"
 }
}
