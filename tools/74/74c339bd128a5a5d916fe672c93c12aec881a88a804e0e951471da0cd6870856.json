{
 "description": "Install a plugin from WordPress.org by slug. If activation fails the plugin stays installed and activation_error says why.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activate": {
    "default": false,
    "description": "Activate after install (default false)",
    "type": "boolean"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "slug": {
    "description": "Plugin slug from WordPress.org",
    "type": "string"
   }
  },
  "required": [
   "site",
   "slug"
  ],
  "type": "object"
 },
 "name": "mcp_install_plugin"
}
