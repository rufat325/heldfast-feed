{
 "description": "Provides analytics and insights about coding sessions. Actions: overview (summary stats), languages (language breakdown), timeline (activity over time), tags (tag analysis), productivity (work patterns), trends (compare periods).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "overview",
     "languages",
     "timeline",
     "tags",
     "productivity",
     "trends"
    ],
    "type": "string"
   },
   "compareWith": {
    "enum": [
     "previous",
     "average"
    ],
    "type": "string"
   },
   "format": {
    "default": "summary",
    "enum": [
     "summary",
     "detailed",
     "chart"
    ],
    "type": "string"
   },
   "includeInsights": {
    "default": true,
    "type": "boolean"
   },
   "languages": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "period": {
    "default": "all",
    "enum": [
     "day",
     "week",
     "month",
     "year",
     "all"
    ],
    "type": "string"
   },
   "since": {
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "until": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_session_stats"
}
