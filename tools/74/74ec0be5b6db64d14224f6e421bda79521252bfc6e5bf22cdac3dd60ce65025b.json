    "description": "Budget sensitivity",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "context": {
    "description": "Optional context",
    "maxLength": 102400,
    "type": "string"
   },
   "latencySensitivity": {
    "description": "Latency sensitivity",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "profile": {
