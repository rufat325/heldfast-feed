{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Stop a running job; the job reports cancelled within a minute, with the pages compared so far in its report. Free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "jobId": {
    "pattern": "^web-[a-z0-9-]+$",
    "type": "string"
   },
   "jobToken": {
    "description": "The jobToken returned when the job was created. Optional when the request carries the prepaid key that paid the job (Authorization: Bearer dck_\u2026).",
    "maxLength": 200,
    "minLength": 20,
    "type": "string"
   }
  },
  "required": [
   "jobId"
  ],
  "type": "object"
 },
 "name": "cancel_comparison",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "code": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "status": {
    "const": "cancelling",
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Cancel comparison"
}
