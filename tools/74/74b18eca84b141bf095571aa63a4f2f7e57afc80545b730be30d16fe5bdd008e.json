  "title": "Create Self Service Tenant"
 },
 "description": "Create a 7-day trial tenant for the caller's business email domain (UC-052).\nNeeds a verified email on a business domain and `attestation: true`; answers\n`auth.email_not_verified`, `tenant.attestation_required`,\n`tenant.free_mail_domain` (free-mail address), `tenant.domain_exists`\n(a live trial tenant on the domain) or `trial.exists_for_domain` (the\ndomain already had its one trial; call `start_inquiry`). The trial lasts\nexactly 7 days; `ttl` / `expires_at` in the body are ignored.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "authorization": {
    "type": "string"
   },
   "body": {
    "default": "",
    "description": "Request body for POST /v1/onboarding/tenants (UC-052).\n\nThe domain is derived from the caller's verified token email claim\n(NFR-006 pt 4) \u2014 it is not a request parameter.\nattestation must be true; the endpoint raises 422 if false (NFR-006 \u00a78a).",
    "properties": {
     "attestation": {
      "type": "boolean"
     },
     "bot_signals": {
      "anyOf": [
       {
        "description": "Advisory bot-detection signals from the onboarding wizard (UC-052).\n\nRecorded and fed to scoring; never used as a hard gate.",
        "properties": {
         "honeypot": {
          "anyOf": [
           {
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "submit_timing_ms": {
          "anyOf": [
           {
            "type": "integer"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "type": "object"
       },
       {
        "type": "null"
       }
      ]
     },
     "legal_entity": {
      "description": "Composite legal-entity input validated against the country catalog.\n\nRules:\n- *country* must be a supported market (validated at field level via SupportedCountry,\n  caught in the model validator against the loaded catalog).\n- *legal_entity_type* must appear in that country's catalog file.\n- When *legal_entity_type* is ``<CC>_OTHER``, *other_label* is required (2-80 chars).\n- For any other type, *other_label* must be absent.",
      "properties": {
       "country": {
        "pattern": "^[A-Z]{2}$",
        "type": "string"
       },
       "legal_entity_type": {
        "pattern": "^[A-Z]{2,3}_[A-Z0-9][A-Z0-9_]*$",
        "type": "string"
       },
       "name": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "other_label": {
        "anyOf": [
         {
          "maxLength": 80,
          "minLength": 2,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "country",
       "legal_entity_type",
       "name"
      ],
      "type": "object"
     }
    },
    "required": [
     "legal_entity",
     "attestation"
    ],
    "type": "object"
   }
  },
  "required": [
   "authorization"
  ],
  "type": "object"
 },
