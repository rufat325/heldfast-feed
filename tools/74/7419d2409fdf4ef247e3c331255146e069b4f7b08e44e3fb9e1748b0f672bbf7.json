{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Rolling fine-metal-weighted median asking premiums for silver, gold, platinum, palladium, copper, nickel and Goldback, observed from marketplace listings. Goldbacks use the Goldback reference rate instead of contained-gold spot and are excluded from ordinary gold statistics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "description": "Opaque continuation token returned by the same tool with exactly the same filters.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Product page size. Without a query, pages browse the most-listed products.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "metal": {
    "description": "Which metal's observed premiums to return.",
    "enum": [
     "silver",
     "gold",
     "platinum",
     "palladium",
     "copper",
     "nickel",
     "goldback"
    ],
    "type": "string"
   },
   "query": {
    "description": "Case-insensitive product label/canonical-key search.",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "metal"
  ],
  "type": "object"
 },
 "name": "get_observed_premiums",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "asOf": {
    "description": "UTC latest observation instant.",
    "format": "date-time",
    "type": "string"
   },
   "categories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "listingCount": {
       "minimum": 0,
       "type": "integer"
      },
      "medianPercent": {
       "type": "number"
      }
     },
     "required": [
      "medianPercent",
      "listingCount",
      "key",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "metal": {
    "enum": [
     "silver",
     "gold",
     "platinum",
     "palladium",
     "copper",
     "nickel",
     "goldback"
    ],
    "type": "string"
   },
   "minimumListings": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "nextCursor": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "overall": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "listingCount": {
        "minimum": 0,
        "type": "integer"
       },
       "medianPercent": {
        "type": "number"
       }
      },
      "required": [
       "medianPercent",
       "listingCount"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "productOrder": {
    "description": "How product rows were selected: search (query match, catalog order) or listing_count (browse, most-listed first). Empty products means no data.",
    "enum": [
     "search",
     "listing_count"
    ],
    "type": "string"
   },
   "productQuery": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "fineTroyOz": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "key": {
       "maxLength": 160,
       "type": "string"
      },
      "label": {
       "maxLength": 200,
       "type": "string"
      },
      "listingCount": {
       "minimum": 0,
       "type": "integer"
      },
      "listingsUrl": {
       "format": "uri",
       "maxLength": 2048,
       "type": "string"
      },
      "medianPercent": {
       "type": "number"
      },
      "numistaUrl": {
       "anyOf": [
        {
         "format": "uri",
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "medianPercent",
      "listingCount",
      "key",
      "label",
      "fineTroyOz",
      "numistaUrl",
      "listingsUrl"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "type": "array"
   },
   "sourceUrl": {
    "format": "uri",
    "type": "string"
   },
   "windowDays": {
    "exclusiveMinimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "metal",
   "asOf",
   "windowDays",
   "minimumListings",
   "productQuery",
   "productOrder",
   "sourceUrl",
   "overall",
   "categories",
   "products",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Observed premiums over spot"
}
