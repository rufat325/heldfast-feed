      "description": "The numeric hedge opportunity ID",
      "maximum": 9007199254740991,
      "minimum": 1,
      "type": "integer"
     }
    },
    "required": [
     "id"
    ],
    "type": "object"
   },
   "query": {
    "additionalProperties": false,
    "default": {},
    "properties": {
     "type": {
      "allOf": [
       {
        "enum": [
         "mainlines",
         "props",
         "3ways",
         "middles",
         "posev",
         "openev"
        ],
        "type": "string"
       },
       {
        "maxLength": 256,
        "type": "string"
       }
      ],
      "default": "mainlines",
      "description": "The concrete opportunity type containing this ID; defaults to mainlines"
     }
    },
    "type": "object"
   }
  },
  "required": [
