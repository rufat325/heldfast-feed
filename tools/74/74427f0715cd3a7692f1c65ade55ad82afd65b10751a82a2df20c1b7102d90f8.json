{
 "_meta": {
  "veriko/cost": "quota",
  "veriko/family": "validations",
  "veriko/operationId": "validateDirect",
  "veriko/risk": "write"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Valida datos de una transferencia contra el CEP de Banxico. Cada validaci\u00f3n consume cuota del plan del usuario y se descuenta al aceptar la petici\u00f3n.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "async": {
    "default": false,
    "type": "boolean"
   },
   "claveRastreo": {
    "maxLength": 30,
    "minLength": 1,
    "type": "string"
   },
   "clientRef": {
    "maxLength": 64,
    "minLength": 1,
    "pattern": "^[^\\x00-\\x1f\\x7f]+$",
    "type": "string"
   },
   "cuentaBeneficiaria": {
    "pattern": "^(?:\\d{10}|\\d{16}|\\d{18})$",
    "type": "string"
   },
   "cuentasCandidatas": {
    "items": {
     "pattern": "^(?:\\d{10}|\\d{16}|\\d{18})$",
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 2,
    "type": "array"
   },
   "emisor": {
    "maxLength": 255,
    "type": "string"
   },
   "fecha": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "idempotencyKey": {
    "pattern": "^[A-Za-z0-9_-]{1,255}$",
    "type": "string"
   },
   "monto": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "type": "number"
     },
     {
      "pattern": "^\\d+(?:\\.\\d{1,2})?$",
      "type": "string"
     }
    ]
   },
   "receptor": {
    "maxLength": 255,
    "type": "string"
   },
   "receptorParticipante": {
    "anyOf": [
     {
      "const": 0,
      "type": "number"
     },
     {
      "const": 1,
      "type": "number"
     }
    ]
   },
   "referenciaNumerica": {
    "pattern": "^\\d{1,7}$",
    "type": "string"
   },
   "retryPolicy": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "interval_seconds": {
      "maximum": 86400,
      "minimum": 300,
      "type": "integer"
     },
     "max_retries": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "outcomes": {
      "items": {
       "enum": [
        "not_found",
        "cep_unavailable",
        "error"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "fecha",
   "monto"
  ],
  "type": "object"
 },
 "name": "veriko_validate_direct",
 "title": "Validar una transferencia SPEI"
}
