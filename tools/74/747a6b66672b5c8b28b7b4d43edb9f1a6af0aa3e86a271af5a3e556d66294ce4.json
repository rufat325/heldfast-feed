{
 "description": "Move a scheduled post to a new time. Pass a future ISO 8601 UTC datetime.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "postId": {
    "description": "Post ID to reschedule",
    "type": "string"
   },
   "scheduledAt": {
    "description": "New future ISO 8601 UTC datetime",
    "format": "date-time",
    "type": "string"
   }
  },
  "required": [
   "postId",
   "scheduledAt"
  ],
  "type": "object"
 },
 "name": "reschedule_post"
}
