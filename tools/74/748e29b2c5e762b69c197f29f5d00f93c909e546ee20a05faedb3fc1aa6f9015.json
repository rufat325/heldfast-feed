{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get Trend"
 },
 "description": "Analyze a health metric trend over time \u2014 detects direction (improving/declining/stable), variability, and anomalies using linear regression.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "days": {
    "description": "Number of days to analyze (7\u201390). Default: 30.",
    "maximum": 90,
    "minimum": 7,
    "type": "integer"
   },
   "metric": {
    "description": "The health metric to analyze.",
    "enum": [
     "recovery",
     "hrv",
     "rhr",
     "sleep_duration",
     "sleep_performance",
     "strain"
    ],
    "type": "string"
   }
  },
  "required": [
   "metric"
  ],
  "type": "object"
 },
 "name": "get_trend",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "anomalies": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "type": "string"
      },
      "deviation_from_mean": {
       "type": "number"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "date",
      "value",
      "deviation_from_mean"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "metric": {
    "type": "string"
   },
   "period": {
    "additionalProperties": false,
    "properties": {
     "days": {
      "type": "number"
     },
     "end": {
      "type": "string"
     },
     "start": {
      "type": "string"
     }
    },
    "required": [
     "start",
     "end",
     "days"
    ],
    "type": "object"
   },
   "statistics": {
    "additionalProperties": false,
    "properties": {
     "max": {
      "type": "number"
     },
     "mean": {
      "type": "number"
     },
     "median": {
      "type": "number"
     },
     "min": {
      "type": "number"
     },
     "std_dev": {
      "type": "number"
     }
    },
    "required": [
     "mean",
     "median",
     "std_dev",
     "min",
     "max"
    ],
    "type": "object"
   },
   "trend": {
    "additionalProperties": false,
    "properties": {
     "confidence": {
      "enum": [
       "high",
       "medium",
       "low"
      ],
      "type": "string"
     },
     "direction": {
      "enum": [
       "improving",
       "declining",
       "stable"
      ],
      "type": "string"
     },
     "slope": {
      "type": "number"
     }
    },
    "required": [
     "direction",
     "slope",
     "confidence"
    ],
    "type": "object"
   },
   "values": {
    "items": {
     "type": "number"
    },
    "type": "array"
   }
  },
  "required": [
   "metric",
   "period",
   "values",
   "statistics",
   "trend",
   "anomalies"
  ],
  "type": "object"
 }
}
