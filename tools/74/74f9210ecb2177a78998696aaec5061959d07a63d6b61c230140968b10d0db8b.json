{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Edit a Ledger entry"
 },
 "description": "Corrects an entry in place \u2014 its title (summary), body (rationale), the pre-registered prediction of an OPEN decision (null clears it), or its facet (filing category; editable even after settlement). Works on open decisions, and on lessons, observations, and beliefs (they carry no expectation, so fixing their wording is fine any time). Use to fix a typo, swapped fields, or a misrecorded detail. Never edits kind or lesson. Fails with conflict on a settled decision \u2014 its claim is corrected by a human superseding it in Ledger \u2014 and on superseded or retracted entries. Entry ids come from ledger_entries_list. May return `needs_confirmation`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation envelope.",
    "type": "string"
   },
   "entryId": {
    "description": "The entry to edit: an open decision, or a lesson / observation / belief.",
    "type": "string"
   },
   "facet": {
    "anyOf": [
     {
      "enum": [
       "product",
       "pricing",
       "gtm",
       "sales",
       "people",
       "ops",
       "tooling",
       "finance",
       "positioning",
       "risk"
      ],
      "type": "string"
     },
     {
      "const": "",
      "type": "string"
     }
    ],
    "description": "Filing facet; empty string = unassigned."
   },
   "prediction": {
    "anyOf": [
     {
      "properties": {
       "claims": {
        "default": [],
        "items": {
         "properties": {
          "comparator": {
           "enum": [
            ">=",
            "<=",
            ">",
            "<",
            "="
           ],
           "type": "string"
          },
          "evalId": {
           "maxLength": 100,
           "minLength": 1,
           "type": "string"
          },
          "hold": {
           "properties": {
            "days": {
             "default": 28,
             "maximum": 365,
             "minimum": 1,
             "type": "integer"
            },
            "kind": {
             "const": "pre_landing",
             "type": "string"
            },
            "maxDrop": {
             "default": 0,
             "maximum": 1,
             "minimum": 0,
             "type": "number"
            },
            "maxRise": {
             "maximum": 1,
             "minimum": 0,
             "type": "number"
            }
           },
           "required": [
            "kind"
           ],
           "type": "object"
          },
          "metricId": {
           "maxLength": 100,
           "minLength": 1,
           "type": "string"
          },
          "slice": {
           "additionalProperties": {
            "items": {
             "maxLength": 100,
             "minLength": 1,
             "type": "string"
            },
            "maxItems": 50,
            "minItems": 1,
            "type": "array"
           },
           "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,39}$",
            "type": "string"
           },
           "type": "object"
          },
          "source": {
           "enum": [
            "caliper_eval",
            "metric",
            "manual"
           ],
           "type": "string"
          },
          "target": {
           "type": "number"
          },
          "unit": {
           "maxLength": 50,
           "type": "string"
          },
          "watch": {
           "type": "boolean"
          }
         },
         "required": [
          "source"
         ],
         "type": "object"
        },
        "maxItems": 10,
        "type": "array"
       },
       "deadline": {
        "maxLength": 40,
        "type": "string"
       },
       "freeform": {
        "maxLength": 2000,
        "type": "string"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replacement expectation (claims + deadline, or freeform), or null to clear it. Correcting a misrecorded expectation is fine; rewriting one to match what happened is not."
   },
   "rationale": {
    "description": "New body: the detail under the title; markdown is fine.",
    "maxLength": 4000,
    "type": "string"
   },
   "summary": {
    "description": "New title: one short plain sentence, no markdown, at most 280 characters.",
    "maxLength": 280,
    "minLength": 1,
    "type": "string"
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this; tokens with a default can override per call. Ignored for workspace API keys.",
    "type": "string"
   }
  },
  "required": [
   "entryId"
  ],
  "type": "object"
 },
 "name": "ledger_entries_update",
 "title": "Edit a Ledger entry"
}
