{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Track rankings"
 },
 "description": "Use for ongoing rank tracking without picking keywords by hand. Each run, fetch Search Console rows by query and page (last 7 or 28 days) and, if connected, the rows of Ahrefs Rank Tracker (rank-tracker-overview) or Semrush Position Tracking, plus GA4 conversions or revenue per landing page if available, and pass them with the tracker_id (leave it out on the first run to create a tracker).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "run (default), status or stop.",
    "enum": [
     "run",
     "status",
     "stop"
    ],
    "type": "string"
   },
   "conversions": {
    "description": "Optional GA4 key events or revenue per landing page.",
    "items": {
     "properties": {
      "conversions": {
       "type": "number"
      },
      "page": {
       "maxLength": 2048,
       "type": "string"
      },
      "revenue": {
       "type": "number"
      }
     },
     "required": [
      "page"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "fix_log_id": {
    "description": "Optional fix log (log_fix) whose pages count as work done.",
    "maxLength": 2000,
    "type": "string"
   },
   "gsc_rows": {
    "description": "Search Console rows by query and page for the period.",
    "items": {
     "properties": {
      "clicks": {
       "type": "number"
      },
      "impressions": {
       "type": "number"
      },
      "page": {
       "maxLength": 2048,
       "type": "string"
      },
      "position": {
       "type": "number"
      },
      "query": {
       "maxLength": 2000,
       "type": "string"
      }
     },
     "type": "object"
    },
    "maxItems": 2000,
    "type": "array"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "money_keywords": {
    "description": "Optional keywords you always want followed.",
    "items": {
     "maxLength": 2000,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "site": {
    "description": "Your site. Needed on the first run.",
    "maxLength": 2000,
    "type": "string"
   },
   "tracker_id": {
    "description": "From the first run. Leave out to create a tracker.",
    "maxLength": 2000,
    "type": "string"
   },
   "tracker_rows": {
    "description": "Ahrefs Rank Tracker or Semrush Position Tracking rows.",
    "items": {
     "description": "Ahrefs Rank Tracker (rank-tracker-overview) or Semrush Position Tracking rows.",
     "properties": {
      "cpc": {
       "type": "number"
      },
      "device": {
       "maxLength": 2000,
       "type": "string"
      },
      "is_branded": {
       "type": "boolean"
      },
      "is_commercial": {
       "type": "boolean"
      },
      "is_transactional": {
       "type": "boolean"
      },
      "keyword": {
       "maxLength": 2000,
       "type": "string"
      },
      "landing_page": {
       "maxLength": 2000,
       "type": "string"
      },
      "location": {
       "maxLength": 2000,
       "type": "string"
      },
      "position": {
       "type": "number"
      },
      "serp_features": {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "type": "array"
      },
      "tags": {
       "items": {
        "maxLength": 2000,
        "type": "string"
       },
       "type": "array"
      },
      "traffic": {
       "type": "number"
      },
      "url": {
       "description": "Ranking URL (Semrush: landing_page).",
       "maxLength": 2048,
       "type": "string"
      },
      "volume": {
       "type": "number"
      }
     },
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "webhook_url": {
    "description": "Optional https webhook for the changes (Slack and Discord work).",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "track_rankings",
 "outputSchema": {
  "properties": {
   "events": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "groups": {
    "type": "object"
   },
   "runs": {
    "type": "number"
   },
   "trackerId": {
    "type": "string"
   }
  },
  "required": [
   "trackerId"
  ],
  "type": "object"
 },
 "title": "Smart rank tracker that knows what matters"
}
