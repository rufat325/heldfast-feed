{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Normalize public HTTPS or base64 audio to a bounded MP3 with loudness evidence and content digests. Costs $0.01.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audioBase64": {
    "maxLength": 11200000,
    "type": "string"
   },
   "maxSeconds": {
    "default": 180,
    "maximum": 180,
    "minimum": 1,
    "type": "integer"
   },
   "targetLufs": {
    "default": -16,
    "maximum": -12,
    "minimum": -24,
    "type": "number"
   },
   "url": {
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "normalize_audio",
 "title": "Normalize Audio Loudness"
}
