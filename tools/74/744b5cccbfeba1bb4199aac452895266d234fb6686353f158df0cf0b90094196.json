{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Enable or disable capabilities on an MCP server. Changes take effect immediately and override the integration-level settings for this server; use list_mcp_server_capabilities first to inspect the current surface.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capabilities": {
    "description": "Array of capability updates",
    "items": {
     "properties": {
      "enabled": {
       "description": "Whether to enable the capability",
       "type": "boolean"
      },
      "name": {
       "description": "Capability name",
       "type": "string"
      },
      "type": {
       "description": "Capability type",
       "enum": [
        "tool",
        "prompt",
        "resource"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "enabled"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "id": {
    "description": "The MCP server ID or slug",
    "type": "string"
   }
  },
  "required": [
   "id",
   "capabilities"
  ],
  "type": "object"
 },
 "name": "update_mcp_server_capabilities",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
