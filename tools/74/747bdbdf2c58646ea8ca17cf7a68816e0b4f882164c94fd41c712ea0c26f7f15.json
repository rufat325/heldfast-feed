{
 "description": "Combine multiple text blocks side-by-side or stacked.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "align": {
    "default": "top",
    "description": "Vertical alignment for horizontal mode",
    "enum": [
     "top",
     "middle",
     "bottom"
    ],
    "type": "string"
   },
   "blocks": {
    "description": "Text blocks to combine",
    "items": {
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "gap": {
    "default": 1,
    "description": "Gap between blocks (spaces for horizontal, blank lines for vertical)",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "mode": {
    "default": "horizontal",
    "description": "Layout mode",
    "enum": [
     "horizontal",
     "vertical"
    ],
    "type": "string"
   },
   "separator": {
    "description": "Separator string for vertical mode",
    "maxLength": 80,
    "type": "string"
   }
  },
  "required": [
   "blocks"
  ],
  "type": "object"
 },
 "name": "compose"
}
