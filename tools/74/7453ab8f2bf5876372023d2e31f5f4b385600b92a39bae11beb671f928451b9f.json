{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Report a protocol failure \u2014 when a step in the evidence/escrow/verification pipeline breaks. System may auto-recover.",
 "inputSchema": {
  "properties": {
   "errorCode": {
    "description": "Error code",
    "type": "string"
   },
   "errorMessage": {
    "description": "Error description",
    "type": "string"
   },
   "involvedAgents": {
    "description": "Agent IDs involved",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "jobId": {
    "description": "Related job ID",
    "type": "string"
   },
   "protocol": {
    "description": "Which protocol failed: evidence_submission, escrow_release, verification_consensus, settlement",
    "type": "string"
   },
   "recoveryAction": {
    "description": "Suggested recovery",
    "enum": [
     "retry",
     "escalate",
     "rollback",
     "ignore"
    ],
    "type": "string"
   }
  },
  "required": [
   "protocol",
   "errorCode",
   "errorMessage",
   "involvedAgents"
  ],
  "type": "object"
 },
 "name": "report_protocol_failure"
}
