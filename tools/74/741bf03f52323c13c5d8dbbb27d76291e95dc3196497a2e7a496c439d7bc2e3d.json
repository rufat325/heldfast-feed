{
 "description": "Update packages in a project to their latest semver-compatible version",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "description": "Preview updates without making changes",
    "type": "boolean"
   },
   "global": {
    "description": "Update global packages",
    "type": "boolean"
   },
   "packages": {
    "description": "Specific packages to update (empty = update all)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "update"
}
