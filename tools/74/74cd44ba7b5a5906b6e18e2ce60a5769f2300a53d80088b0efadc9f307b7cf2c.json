{
 "_meta": {
  "openai/toolInvocation/invoked": "Check complete",
  "openai/toolInvocation/invoking": "Checking llms.txt\u2026",
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Validate llms.txt content"
 },
 "description": "Use this when the user pastes the text of an llms.txt file and wants it checked or improved. Checks the text against the llmstxt.org format proposal: H1 title, summary blockquote, H2 sections, absolute Markdown links, duplicates, links to other domains, file size and update date. Returns a 0-100 score, findings with severity and line number, and the Lighthouse \"Agentic Browsing\" result. Works only on the text provided; it does not fetch anything from the internet. Finding messages are in German.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "The full text of the llms.txt file.",
    "maxLength": 200000,
    "minLength": 1,
    "type": "string"
   },
   "expectedHostname": {
    "description": "Optional hostname of the website, e.g. \"www.example.com\". Enables the warning for links to other domains.",
    "maxLength": 253,
    "type": "string"
   }
  },
  "required": [
   "content"
  ],
  "type": "object"
 },
 "name": "validate_llms_txt",
 "outputSchema": {
  "properties": {
   "lighthouse": {
    "description": "Result of the three Lighthouse 13.3 \"llms-txt\" audit rules.",
    "properties": {
     "checks": {
      "items": {
       "properties": {
        "failureMessage": {
         "type": "string"
        },
        "id": {
         "enum": [
          "h1",
          "links",
          "length"
         ],
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "passed": {
         "type": "boolean"
        }
       },
       "required": [
        "id",
        "passed"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "passed": {
      "type": "boolean"
     }
    },
    "required": [
     "passed",
     "checks"
    ],
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "validation": {
    "description": "Format check against the llmstxt.org proposal.",
    "properties": {
     "byteSize": {
      "type": "number"
     },
     "issues": {
      "items": {
       "properties": {
        "code": {
         "type": "string"
        },
        "line": {
         "type": "number"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "code",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "links": {
      "type": "number"
     },
     "score": {
      "maximum": 100,
      "minimum": 0,
      "type": "number"
     },
     "valid": {
      "description": "true when no error-level finding exists.",
      "type": "boolean"
     }
    },
    "required": [
     "valid",
     "score",
     "issues"
    ],
    "type": "object"
   }
  },
  "required": [
   "validation",
   "lighthouse"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "Validate llms.txt content"
}
