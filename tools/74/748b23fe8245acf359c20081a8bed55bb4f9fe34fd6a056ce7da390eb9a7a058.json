  "readOnlyHint": true,
  "title": "Everything connected"
 },
 "description": "The research tool: give a free question (person, place, event, topic) and get EVERYTHING connected in one call: matching articles, followed stories (multi-day timelines with stages), map locations, the daily summaries that covered it, and a single chronological timeline. Best first call for \"what happened with X\" or \"explain the story of X\".",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "How many days back (default 30, at most the plan's archive).",
    "type": "integer"
   },
   "include_filler": {
    "description": "Filler (horoscopes, quizzes, reality shows, celebrity gossip, promos) is left out of every list; true brings it back.",
    "type": "boolean"
   },
   "limit": {
    "description": "How many results (default 15, at most what the plan allows).",
    "type": "integer"
   },
   "q": {
    "description": "What you want to know: a person, a place, an event, a topic.",
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
