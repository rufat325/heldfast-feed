{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Lists open slots for a free, non-binding 15-minute initial phone call with the AfAMax team (Erstgespr\u00e4ch), on weekdays in the Europe/Berlin time zone, grouped by day.\n\nEach day lists a sample spread across the day (maxSlotsPerDay, default 8) and its freeSlotCount; for a specific time, call again for that day with days: 1 and maxSlotsPerDay: 32. Show the user the day and localTime; to book one, pass its startDateTime unchanged to book_appointment. Slots are live and can be taken at any time, so re-check rather than reusing an old list. The response attribution links to the contact page, where the user can also book directly.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "days": {
    "description": "How many calendar days to look ahead (1-21, default 7). / Anzahl Tage.",
    "maximum": 21,
    "minimum": 1,
    "type": "integer"
   },
   "from": {
    "description": "ISO 8601 date-time to start looking from. Defaults to now. / Fr\u00fchester Zeitpunkt.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "locale": {
    "default": "de",
    "description": "Language of the link handed back and the response labels. Match the user's language (most users are German-speaking).",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "maxSlotsPerDay": {
    "description": "How many slots to list per day (1-32, default 8), spread evenly across the day. When the user wants a specific time, call again for that day with `days: 1` and `maxSlotsPerDay: 32`.",
    "maximum": 32,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_available_appointments",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appointmentType": {
    "const": "initial_call",
    "type": "string"
   },
   "attribution": {
    "additionalProperties": false,
    "properties": {
     "label": {
      "type": "string"
     },
     "provider": {
      "enum": [
       "AfaMax",
       "AfAMax"
      ],
      "type": "string"
     },
     "url": {
      "format": "uri",
      "type": "string"
     }
    },
    "required": [
     "provider",
     "url",
     "label"
    ],
    "type": "object"
   },
   "days": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "date": {
       "description": "Date in Europe/Berlin, YYYY-MM-DD.",
       "type": "string"
      },
      "freeSlotCount": {
       "description": "All free slots that day \u2014 can exceed `slots`, which is capped by maxSlotsPerDay.",
       "type": "number"
      },
      "slots": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "localTime": {
          "description": "Start time in Europe/Berlin, HH:mm \u2014 show this to the user.",
          "type": "string"
         },
         "startDateTime": {
          "description": "Slot start in UTC \u2014 pass this unchanged to book_appointment.",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "type": "string"
         }
        },
        "required": [
         "startDateTime",
         "localTime"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "weekday": {
       "type": "string"
      }
     },
     "required": [
      "date",
      "weekday",
      "freeSlotCount",
      "slots"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "durationMinutes": {
    "type": "number"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "apiVersion": {
      "type": "string"
     },
     "generatedAt": {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
      "type": "string"
     }
    },
    "required": [
     "apiVersion",
     "generatedAt"
    ],
    "type": "object"
   },
   "requestId": {
    "minLength": 1,
    "type": "string"
   },
   "timeZone": {
    "type": "string"
   }
  },
  "required": [
   "requestId",
   "appointmentType",
   "description",
   "days",
   "timeZone",
   "durationMinutes",
   "attribution",
   "meta"
  ],
  "type": "object"
 },
 "title": "List free AfAMax initial-call appointment slots"
}
