{
 "description": "Create an invoice. CustomerRef and at least one Line item (SalesItemLineDetail with ItemRef) are required.",
 "inputSchema": {
  "properties": {
   "BillEmail": {
    "properties": {
     "Address": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "CurrencyRef": {
    "properties": {
     "value": {
      "description": "ISO-4217 (e.g. USD, BRL)",
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerMemo": {
    "properties": {
     "value": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "CustomerRef": {
    "properties": {
     "value": {
      "description": "Customer.Id",
      "type": "string"
     }
    },
    "required": [
     "value"
    ],
    "type": "object"
   },
   "DueDate": {
    "description": "Due date (YYYY-MM-DD)",
    "type": "string"
   },
   "Line": {
    "description": "Invoice line items",
    "items": {
     "properties": {
      "Amount": {
       "type": "number"
      },
      "Description": {
       "type": "string"
      },
      "DetailType": {
       "description": "Typically 'SalesItemLineDetail'",
       "type": "string"
      },
      "SalesItemLineDetail": {
       "properties": {
        "ItemRef": {
         "properties": {
          "value": {
           "description": "Item.Id",
           "type": "string"
          }
         },
         "type": "object"
        },
        "Qty": {
         "type": "number"
        },
        "UnitPrice": {
         "type": "number"
        }
       },
       "type": "object"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "PrivateNote": {
    "type": "string"
   },
   "TxnDate": {
    "description": "Transaction date (YYYY-MM-DD)",
    "type": "string"
   }
  },
  "required": [
   "CustomerRef",
   "Line"
  ],
  "type": "object"
 },
 "name": "create_invoice"
}
