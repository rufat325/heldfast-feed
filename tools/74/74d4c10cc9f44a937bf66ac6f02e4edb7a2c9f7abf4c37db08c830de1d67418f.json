{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List the objects (countries, programmes, regimes, banks, legal forms\u2026) that have reviewed structured answers, with their codes and the number of answered questions.",
 "inputSchema": {
  "properties": {
   "locale": {
    "description": "Answer language; Russian when omitted.",
    "enum": [
     "ru",
     "en"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by object type, e.g. state, program, regime, bank, legal_form.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "answer_objects",
 "outputSchema": {
  "properties": {
   "objects": {
    "items": {
     "properties": {
      "code": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "provenance": {
       "description": "Origin of one record: stable id, clean canonical URL, publisher, the exact published revision served, a ready citation, primary sources and review status.",
       "properties": {
        "canonical_url": {
         "description": "Published location without tracking parameters.",
         "format": "uri",
         "type": "string"
        },
        "cite_as": {
         "type": "string"
        },
        "contract": {
         "const": "wiki-provenance/1",
         "type": "string"
        },
        "id": {
         "description": "<locale>:<slug> for an article, <dataset>:<record id> for a dataset row.",
         "type": "string"
        },
        "primary_sources": {
         "items": {
          "properties": {
           "name": {
            "type": "string"
           },
           "url": {
            "type": [
             "string",
             "null"
            ]
           }
          },
          "required": [
           "name",
           "url"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "publisher": {
         "properties": {
          "name": {
           "type": "string"
          },
          "url": {
           "format": "uri",
           "type": "string"
          }
         },
         "required": [
          "name",
          "url"
         ],
         "type": "object"
        },
        "verification_status": {
         "enum": [
          "verified",
          "pending",
          "unknown"
         ],
         "type": "string"
        },
        "version": {
         "description": "Revision of exactly the material served: for an article the snapshot content hash (the HTML ETag value); for a dataset record the dataset revision it was published in, not the published filename. Null when unknown.",
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "contract",
        "id",
        "canonical_url",
        "publisher",
        "version",
        "cite_as",
        "primary_sources",
        "verification_status"
       ],
       "type": "object"
      },
      "questions": {
       "type": "integer"
      },
      "type": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "name",
      "type",
      "questions",
      "url",
      "provenance"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "revision": {
    "type": "string"
   }
  },
  "required": [
   "objects",
   "revision"
  ],
  "type": "object"
 },
 "title": "List places with reviewed answers"
}
