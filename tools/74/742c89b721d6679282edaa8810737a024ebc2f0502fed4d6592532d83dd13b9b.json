{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use after get_service_options and before prepare_offer to retrieve current account, guest-booking and minimum-lead-time rules. Returns observedAt and revalidationRequired: refresh the rules before preparing an offer; no terms-validity window is promised. Review bound waiting and cancellation terms on the current offer before confirmation. On unavailable, report that the rules could not be read; do not invent them. For a price use quote_ride.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "locale": {
    "default": "en",
    "description": "Use the customer's requested language for text and booking links: en by default, de for German. Preserve it on retries; pickup times stay in the provider time zone.",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "offerKey": {
    "description": "Optional existing published provider offer key. Selects its configured service location; not booking authority.",
    "pattern": "^[a-z0-9][a-z0-9_-]{0,79}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_customer_policy",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "status": {
      "const": "invalid_request",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "status": {
      "const": "unavailable",
      "type": "string"
     }
    },
    "required": [
     "status"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "bookingConfirmed": {
      "const": false,
      "type": "boolean"
     },
     "bookingUrl": {
      "format": "uri",
      "type": "string"
     },
     "observedAt": {
      "type": "string"
     },
     "revalidationRequired": {
      "const": true,
      "type": "boolean"
     },
     "scope": {
      "const": "booking_preparation",
      "type": "string"
     },
     "status": {
      "const": "available",
      "type": "string"
     },
     "terms": {
      "additionalProperties": false,
      "properties": {
       "accountRequired": {
        "type": "boolean"
       },
       "bookerForGuestAllowed": {
        "type": "boolean"
       },
       "bookingConfirmation": {
        "const": "after_confirmed_full_payment",
        "type": "string"
       },
       "minimumLeadTimeMinutes": {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       "serviceSpecificTerms": {
        "const": "review_the_current_offer_before_confirmation",
        "type": "string"
       }
      },
      "required": [
       "minimumLeadTimeMinutes",
       "accountRequired",
       "bookerForGuestAllowed",
       "bookingConfirmation",
       "serviceSpecificTerms"
      ],
      "type": "object"
     },
     "timeZone": {
      "type": "string"
     }
    },
    "required": [
     "status",
     "bookingUrl",
     "timeZone",
     "observedAt",
     "scope",
     "revalidationRequired",
     "terms",
     "bookingConfirmed"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Published customer terms"
}
