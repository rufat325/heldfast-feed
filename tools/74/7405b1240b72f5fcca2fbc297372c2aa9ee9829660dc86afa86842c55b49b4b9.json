{
 "description": "Update (adjust) product stock balance \u2014 credit or debit a quantity for a deposit",
 "inputSchema": {
  "properties": {
   "deposito": {
    "description": "Warehouse name (optional, default 'geral')",
    "type": "string"
   },
   "idProduto": {
    "description": "Product ID",
    "type": "number"
   },
   "observacoes": {
    "description": "Notes (optional)",
    "type": "string"
   },
   "precoUnitario": {
    "description": "Unit price (optional)",
    "type": "number"
   },
   "quantidade": {
    "description": "Quantity",
    "type": "number"
   },
   "tipo": {
    "description": "E=entry, S=exit, B=balance",
    "enum": [
     "E",
     "S",
     "B"
    ],
    "type": "string"
   }
  },
  "required": [
   "idProduto",
   "tipo",
   "quantidade"
  ],
  "type": "object"
 },
 "name": "update_stock"
}
