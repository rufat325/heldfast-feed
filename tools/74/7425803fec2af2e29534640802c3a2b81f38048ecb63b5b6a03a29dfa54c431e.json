{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "supovia:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get support website details"
 },
 "description": "Use this when someone asks about one of their Supovia websites by name or id, such as whether its AI customer agent is on. Returns the website's id, name, domain, AI-agent status and created and edited times, or not-found. Not for the help articles published on it.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "idOrName": {
    "description": "Website id, exact vanity id (its lowercase public address) or exact display name",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "idOrName"
  ],
  "type": "object"
 },
 "name": "get_website",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "found",
     "not-found"
    ],
    "type": "string"
   },
   "website": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "agentEnabled": {
        "type": "boolean"
       },
       "creationTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "domain": {
        "anyOf": [
         {
          "maxLength": 253,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "pattern": "^[0-9a-f]{24}$",
        "type": "string"
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 32,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "name": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "id",
       "name",
       "domain",
       "agentEnabled",
       "creationTime",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Safe website metadata; null when not found. Organization ids, agent prompts, credentials, integration configuration and arbitrary metadata are never returned."
   }
  },
  "required": [
   "status",
   "website"
  ],
  "type": "object"
 },
 "title": "Get support website details"
}
