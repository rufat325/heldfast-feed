{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List a scene's inputs"
 },
 "description": "Lists a scene's ingest keys (id ingkey_\u2026, which source, live or not, never the key itself), its secrets (names only) and its IP cameras: what create_scene_ingest_key and set_scene_secret made. Answers ingestKeys (id, sourceId, keyPrefix, status, live, rtmpUrl, rtmpsUrl), secrets (name, updatedAt) and cameras (id, sourceId, url without credentials, transport, the last connection test).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "scene": {
    "description": "The scene (scn_\u2026), from list_scenes or create_scene.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "scene"
  ],
  "type": "object"
 },
 "name": "list_scene_inputs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "anyOf": [
   {
    "additionalProperties": {},
    "properties": {
     "cameras": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "id": {
         "type": "string"
        },
        "sourceId": {
         "type": "string"
        },
        "url": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "sourceId",
        "url"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "ingestKeys": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "id": {
         "type": "string"
        },
        "live": {
         "type": "boolean"
        },
        "sourceId": {
         "type": "string"
        },
        "status": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "sourceId",
        "status",
        "live"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "secrets": {
      "items": {
       "additionalProperties": {},
       "properties": {
        "name": {
         "type": "string"
        },
        "updatedAt": {
         "type": "string"
        }
       },
       "required": [
        "name",
        "updatedAt"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "ingestKeys",
     "secrets",
     "cameras"
    ],
    "type": "object"
   },
   {
    "additionalProperties": {},
    "properties": {
     "code": {
      "description": "Stable \u2014 branch on it: INVALID_INPUT, REVISION_REQUIRED, STALE_PUBLISH, CONFIRM_REQUIRED, UNAVAILABLE, \u2026",
      "type": "string"
     },
     "currentRevision": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "CONFLICT: the revision it has now"
     },
     "detail": {
      "description": "What is wrong, in a sentence",
      "type": "string"
     },
     "errors": {
      "description": "Each problem, when a check refused it"
     }
    },
    "required": [
     "code",
     "detail"
    ],
    "type": "object"
   }
  ],
  "properties": {},
  "type": "object"
 },
 "title": "List a scene's inputs"
}
