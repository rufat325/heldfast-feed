{
 "description": "Get oracle incidents and deviation events within a date range. Filter by provider and minimum severity.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum results",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "minSeverity": {
    "description": "Minimum severity",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "provider": {
    "description": "Filter by oracle provider",
    "enum": [
     "chainlink",
     "api3",
     "redstone",
     "dia",
     "winklink",
     "supra",
     "twap",
     "reflector",
     "flare",
     "band"
    ],
    "type": "string"
   },
   "to": {
    "description": "End date in YYYY-MM-DD format",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_incidents"
}
