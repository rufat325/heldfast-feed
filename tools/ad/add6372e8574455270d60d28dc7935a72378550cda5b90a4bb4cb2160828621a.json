{
 "description": "Create a revelation that can be discovered through multiple sources. The ultimate flexible clue.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "gmNotes": {
    "description": "GM-only notes",
    "type": "string"
   },
   "information": {
    "description": "What the clue reveals",
    "type": "string"
   },
   "prerequisites": {
    "additionalProperties": false,
    "properties": {
     "notBefore": {
      "additionalProperties": false,
      "properties": {
       "day": {
        "type": "number"
       },
       "hour": {
        "type": "number"
       }
      },
      "required": [
       "day",
       "hour"
      ],
      "type": "object"
     },
     "requiredEvidence": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "requiredFlags": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "revealsLeadTo": {
    "description": "Situation ID this clue points to",
    "type": "string"
   },
   "sessionId": {
    "description": "Session ID",
    "type": "string"
   },
   "setsFlags": {
    "description": "Flags to set when revealed",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "significance": {
    "description": "How important this clue is",
    "enum": [
     "minor",
     "moderate",
     "major",
     "critical"
    ],
    "type": "string"
   },
   "suggestedSources": {
    "description": "Ways this clue can be discovered",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "How to deliver via this source",
       "type": "string"
      },
      "id": {
       "description": "NPC/location/item ID",
       "type": "string"
      },
      "type": {
       "enum": [
        "npc",
        "location",
        "document",
        "observation",
        "item"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "sessionId",
   "information",
   "significance",
   "suggestedSources"
  ],
  "type": "object"
 },
 "name": "create_portable_clue"
}
