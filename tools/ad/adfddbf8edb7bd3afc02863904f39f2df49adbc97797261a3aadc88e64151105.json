  "readOnlyHint": true,
  "title": "Distinct values"
 },
 "description": "Distinct values of a field (dot paths allowed) across up to scanLimit documents or rows, optionally filtered \u2014 useful for discovering categories before filtering.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "database": {
    "description": "Database to use: name, id, or Data API endpoint URL. Omit for the configured default.",
    "minLength": 1,
    "type": "string"
   },
   "field": {
    "description": "Field path, e.g. \"genre\" or \"author.country\".",
    "minLength": 1,
    "type": "string"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Data API filter, e.g. {\"status\": \"active\", \"year\": {\"$gte\": 2020}}. Typed ids as {\"$uuid\": \"\u2026\"} / {\"$objectId\": \"\u2026\"}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "keyspace": {
    "description": "Keyspace. Omit for the configured/default keyspace.",
    "minLength": 1,
    "type": "string"
   },
   "kind": {
    "description": "Only needed when a collection and a table share the name; otherwise detected.",
    "enum": [
     "collection",
     "table"
    ],
    "type": "string"
   },
   "maxValues": {
    "default": 100,
    "description": "Max distinct values returned.",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "description": "Collection or table name.",
    "minLength": 1,
    "type": "string"
   },
   "scanLimit": {
    "default": 1000,
    "description": "Max documents scanned.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "name",
   "field"
  ],
  "type": "object"
 },
 "name": "distinct_values",
