{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Search indexed snapshots using literal FTS5/BM25 and exact generation-bound cache. Pass known_packet_hash ONLY if that packet is already available in this task context; never after compaction or in a fresh task. Cache hits do not prove live freshness, token savings or truth. Writes bounded cache metadata only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bypass_cache": {
    "default": false,
    "type": "boolean"
   },
   "context_id": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "known_packet_hash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "preview_chars": {
    "default": 350,
    "maximum": 1200,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "maxLength": 300,
    "minLength": 2,
    "type": "string"
   },
   "source_id": {
    "pattern": "^[a-z0-9][a-z0-9-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "query",
   "context_id"
  ],
  "type": "object"
 },
 "name": "evidence_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "authority": {
    "const": "candidate-only",
    "type": "string"
   },
   "cache_status": {
    "enum": [
     "hit",
     "miss",
     "bypass"
    ],
    "type": "string"
   },
   "context_id": {
    "type": "string"
   },
   "generation": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "instruction_authority": {
    "const": "none",
    "type": "string"
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "packet": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "authority": {
        "const": "candidate-only",
        "type": "string"
       },
       "context_id": {
        "type": "string"
       },
       "freshness": {
        "const": "indexed-snapshot-not-live",
        "type": "string"
       },
       "generation": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "instruction_authority": {
        "const": "none",
        "type": "string"
       },
       "policy_hash": {
        "pattern": "^[a-f0-9]{64}$",
        "type": "string"
       },
       "privacy": {
        "const": "local-private-no-export",
        "type": "string"
       },
       "query": {
        "type": "string"
       },
       "results": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "byte_length": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "byte_start": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "char_length": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "char_start": {
           "maximum": 9007199254740991,
           "minimum": 0,
           "type": "integer"
          },
          "content_hash": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "document_id": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "heading": {
           "type": "string"
          },
          "id": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "lexical_rank": {
           "type": "number"
          },
          "line_end": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "line_start": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "locator": {
           "type": "string"
          },
          "preview": {
           "type": "string"
          },
          "preview_truncated": {
           "type": "boolean"
          },
          "source_hash": {
           "pattern": "^[a-f0-9]{64}$",
           "type": "string"
          },
          "source_id": {
           "type": "string"
          }
         },
         "required": [
          "id",
          "document_id",
          "source_id",
          "locator",
          "heading",
          "source_hash",
          "content_hash",
          "char_start",
          "char_length",
          "byte_start",
          "byte_length",
          "line_start",
          "line_end",
          "preview",
          "preview_truncated",
          "lexical_rank"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "retrieval_method": {
        "const": "fts5-bm25-literal-or/v1",
        "type": "string"
       },
       "schema_version": {
        "const": "dwin.evidence-packet/v1",
        "type": "string"
       },
       "truncated": {
        "type": "boolean"
       },
       "vector_status": {
        "const": "NOT_USED_BY_LEXICAL_SEARCH",
        "type": "string"
       }
      },
      "required": [
       "schema_version",
       "generation",
       "policy_hash",
       "context_id",
       "query",
       "retrieval_method",
       "vector_status",
       "instruction_authority",
       "authority",
       "privacy",
       "freshness",
       "truncated",
       "results"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "packet_hash": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "retrieval_executed": {
    "type": "boolean"
   },
   "schema_version": {
    "const": "dwin.evidence-search/v1",
    "type": "string"
   },
   "status": {
    "enum": [
     "OK",
     "NO_HITS",
     "NOT_MODIFIED"
    ],
    "type": "string"
   }
  },
  "required": [
   "schema_version",
   "status",
   "cache_status",
   "packet_hash",
   "generation",
   "context_id",
   "retrieval_executed",
   "packet",
   "instruction_authority",
   "authority",
   "note"
  ],
  "type": "object"
 }
}
