{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Prepare one immutable proposal under a review:prepare token. With target.offering_id, omit merchant_name, merchant_website and offering to reuse the public target. Otherwise provide seller identity and display name. Ratings are optional; never guess scores. This does not confirm or publish it. Return the confirmation URL to the consumer to check the full text, scores and evidence.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "context": {
    "additionalProperties": false,
    "properties": {
     "expectation": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "limitations": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "outcome": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "price": {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "enum": [
         "USD",
         "EUR",
         "GBP",
         "CAD",
         "AUD",
         "SGD",
         "HKD",
         "CNY",
         "JPY",
         "INR"
        ],
        "type": "string"
       },
       "maximum": {
        "maximum": 1000000000,
        "minimum": 0,
        "type": "number"
       },
       "minimum": {
        "maximum": 1000000000,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "currency",
       "minimum",
       "maximum"
      ],
      "type": "object"
     },
     "purpose": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "strengths": {
      "maxLength": 600,
      "minLength": 1,
      "type": "string"
     },
     "usage_duration": {
      "enum": [
       "one_use",
       "under_week",
       "one_to_four_weeks",
       "one_to_six_months",
       "over_six_months"
      ],
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   },
   "evidence_id": {
    "type": "string"
   },
   "feedback": {
    "type": "string"
   },
   "incentivized": {
    "type": "boolean"
   },
   "merchant_name": {
    "type": "string"
   },
   "merchant_website": {
    "type": "string"
   },
   "offering": {
    "additionalProperties": false,
    "properties": {
     "kind": {
      "enum": [
       "product",
       "service"
      ],
      "type": "string"
     },
     "name": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "variant": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "kind",
     "name"
    ],
    "type": "object"
   },
   "ratings": {
    "additionalProperties": false,
    "properties": {
     "quality": {
      "maximum": 5,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "service": {
      "maximum": 5,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     },
     "value": {
      "maximum": 5,
      "minimum": 1,
      "type": [
       "integer",
       "null"
      ]
     }
    },
    "required": [],
    "type": "object"
   },
   "target": {
    "additionalProperties": false,
    "properties": {
     "gtin": {
      "maxLength": 160,
      "type": "string"
     },
     "listing_id": {
      "maxLength": 160,
      "type": "string"
     },
     "marketplace": {
      "maxLength": 160,
      "type": "string"
     },
     "merchant_name": {
      "maxLength": 160,
      "type": "string"
     },
     "offering_id": {
      "maxLength": 160,
      "type": "string"
     },
     "product_name": {
      "maxLength": 160,
      "type": "string"
     },
     "product_url": {
      "maxLength": 2048,
      "type": "string"
     },
     "seller_id": {
      "maxLength": 160,
      "type": "string"
     },
     "store_url": {
      "maxLength": 2048,
      "type": "string"
     },
     "variant": {
      "maxLength": 160,
      "type": "string"
     }
    },
    "required": [],
    "type": "object"
   }
  },
  "required": [
   "evidence_id",
   "feedback",
   "incentivized"
  ],
  "type": "object"
 },
 "name": "prepare_review"
}
