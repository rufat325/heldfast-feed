  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Edge Hunter"
 },
 "description": "Read the full experimental Edge Hunter board at https://0xinsider.com/sports/edge. Requires a Max credential; a Pro credential receives 403 forbidden with reason max_plan_required. Across all sports and esports, returns at most 30 ranked rows and total before that cap. Rows contain provider participants, both outcome quotes, and backed-side analytics. horizon_hours defaults to 48 and integer values are clamped to 1..48. There is no category, cohort, cursor, limit, or min_grade option. Current prices are decimal strings with basis, ts, and optional validated_at; their clocks are independent from as_of. Null means unavailable. ranking_source db_only and directional_source degraded identify weaker evidence. This board is analytics, not an order instruction. Returns the board fields plus the REST meta verbatim.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "horizon_hours": {
    "default": 48,
    "description": "Kickoff window in hours; default 48, clamped to 1..48",
    "type": "integer"
   }
  },
  "type": "object"
 },
