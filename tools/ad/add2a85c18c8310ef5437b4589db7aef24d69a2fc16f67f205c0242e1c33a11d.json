        },
        "description": {
         "anyOf": [
          {
           "maxLength": 2000,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "endTime": {
         "anyOf": [
          {
           "$ref": "#/properties/actions/items/anyOf/1/properties/time/anyOf/0"
          },
          {
           "type": "null"
          }
