        },
        "currency": {
         "maxLength": 3,
         "minLength": 3,
         "type": "string"
        },
        "description": {
         "maxLength": 2000,
         "type": "string"
        },
        "destinationCountryCode": {
         "maxLength": 2,
         "minLength": 2,
         "type": "string"
        },
        "destinationName": {
         "maxLength": 120,
         "type": "string"
        },
        "endDate": {
         "$ref": "#/properties/actions/items/anyOf/0/properties/startDate"
        },
        "notes": {
         "anyOf": [
          {
           "maxLength": 20000,
           "type": "string"
          },
          {
           "type": "null"
          }
         ],
         "description": "The trip notebook; null clears"
        },
        "partySize": {
         "maximum": 20,
         "minimum": 1,
         "type": "integer"
        },
