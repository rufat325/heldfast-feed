{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Builds the data carrier for a passport: the unique identifier (the draft\u2019s passportId, an absolute https URI), an optional GS1 Digital Link (/01/{gtin}/21/{serial} or /8004/{giai}) and the QR code as SVG or PNG. The QR encodes the Digital Link when GS1 data is given, else the identifier. Says nothing about validity; validate_passport does.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "draft": {
    "anyOf": [
     {
      "additionalProperties": {},
      "properties": {
       "draftId": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "draftId"
      ],
      "type": "object"
     },
     {
      "additionalProperties": {},
      "properties": {
       "meta": {}
      },
      "required": [
       "meta"
      ],
      "type": "object"
     }
    ],
    "description": "The draft whose meta.passportId is the identifier"
   },
   "format": {
    "description": "Image format (default svg)",
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "gs1": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "gtin": {
        "type": "string"
       },
       "serial": {
        "type": "string"
       }
      },
      "required": [
       "gtin",
       "serial"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "giai": {
        "type": "string"
       }
      },
      "required": [
       "giai"
      ],
      "type": "object"
     }
    ],
    "description": "GS1 key: GTIN (8, 12, 13 or 14 digits) plus serial, or a GIAI"
   },
   "lang": {
    "description": "Language of the text summary (default en)",
    "enum": [
     "de",
     "en"
    ],
    "type": "string"
   },
   "outDir": {
    "description": "Directory to write the image into (needs a file system). Omit to receive base64 bytes inline",
    "type": "string"
   },
   "resolverBase": {
    "description": "https base of the GS1 Digital Link resolver; required with gs1",
    "type": "string"
   },
   "uid": {
    "description": "The passport identifier (absolute https URI) when no draft is given",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "generate_carrier",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "digitalLink": {
    "type": "string"
   },
   "draftId": {
    "type": "string"
   },
   "error": {
    "description": "Set when the call failed",
    "type": "string"
   },
   "format": {
    "enum": [
     "svg",
     "png"
    ],
    "type": "string"
   },
   "image": {
    "additionalProperties": false,
    "properties": {
     "bytes": {
      "description": "base64",
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "path": {
      "type": "string"
     },
     "size": {
      "type": "number"
     }
    },
    "required": [
     "name",
     "size"
    ],
    "type": "object"
   },
   "isNotLegalAdvice": {
    "const": true,
    "type": "boolean"
   },
   "mediaType": {
    "type": "string"
   },
   "payload": {
    "type": "string"
   },
   "sources": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "uid": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Generate the data carrier (QR code)"
}
