{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List SWSD problems (ITIL problem records) with structured filters and pagination. Returns compact summaries (id, name, state, priority, category, requester, assignee, updated_at) \u2014 call swsd_get_problem for the full detail of any one row. Filters use SWSD repeated-key array semantics (multiple values within a filter are OR-ed). Use this when investigating recurring incidents or identifying root causes that span multiple tickets.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "assignee_email": {
    "description": "Filter to problems assigned to this email.",
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 25,
    "description": "Results per page (1-100). SWSD caps at 100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "priority": {
    "description": "Filter to problems matching ANY of these priorities (e.g. [\"High\", \"Medium\"]).",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "query": {
    "description": "Free-text search on name + description.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   },
   "requester_email": {
    "description": "Filter to problems requested by this email.",
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "state": {
    "description": "Filter to problems matching ANY of these states (e.g. [\"New\", \"In Progress\"]).",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   },
   "state_is_not": {
    "description": "Negative state filter: exclude problems in any of these states (e.g. [\"Resolved\", \"Closed\"]).",
    "items": {
     "maxLength": 500,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "swsd_list_problems",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "applied_filters": {
    "additionalProperties": {},
    "description": "Echo of the filters applied to this query \u2014 empty object if none. Use this to reason about whether the result count reflects your filters or the tenant total.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "True when more pages exist beyond this one.",
      "type": "boolean"
     },
     "next_page": {
      "description": "The next page number to request, when has_more is true.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "description": "Current page (1-indexed).",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "per_page": {
      "description": "Items per page used in the request.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "description": "Total record count when SWSD returns X-Total-Count.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total_scope": {
      "description": "Whether `total` reflects the filtered-set size, the tenant-wide size, or is unknown. 'filtered' = filter was applied AND total is present; 'tenant' = no filter AND total is present; 'unknown' = total absent.",
      "enum": [
       "filtered",
       "tenant",
       "unknown"
      ],
      "type": "string"
     }
    },
    "required": [
     "page",
     "per_page",
     "has_more",
     "total_scope"
    ],
    "type": "object"
   },
   "problems": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "assignee": {
       "additionalProperties": false,
       "properties": {
        "email": {
         "type": "string"
        },
        "id": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "category": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "description": {
       "type": "string"
      },
      "description_no_html": {
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "number": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "priority": {
       "type": "string"
      },
      "requester": {
       "additionalProperties": false,
       "properties": {
        "email": {
         "type": "string"
        },
        "id": {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        "name": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "state": {
       "type": "string"
      },
      "subcategory": {
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      },
      "url": {
       "description": "SWSD UI URL for this problem (from href_account_domain).",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "problems",
   "pagination",
   "applied_filters"
  ],
  "type": "object"
 }
}
