{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Show eligible retrieval providers, estimated cost, component scores, and reason codes without calling a provider.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "country": {
    "pattern": "^[a-zA-Z]{2}$",
    "type": "string"
   },
   "excludeDomains": {
    "items": {
     "pattern": "^(?:\\*\\.)?(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "fetchContent": {
    "default": false,
    "type": "boolean"
   },
   "freshness": {
    "enum": [
     "24h",
     "7d",
     "30d",
     "1y"
    ],
    "type": "string"
   },
   "includeDomains": {
    "items": {
     "pattern": "^(?:\\*\\.)?(?=.{1,253}$)(?:[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?\\.)+[a-zA-Z]{2,63}$",
     "type": "string"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   },
   "language": {
    "pattern": "^[a-z]{2,3}(?:-[a-z0-9]{2,8})?$",
    "type": "string"
   },
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "maxCostUsd": {
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "number"
   },
   "maxLatencyMs": {
    "default": 10000,
    "maximum": 120000,
    "minimum": 250,
    "type": "integer"
   },
   "priority": {
    "default": "balanced",
    "enum": [
     "balanced",
     "quality",
     "cost",
     "latency"
    ],
    "type": "string"
   },
   "providerAllowlist": {
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "query": {
    "maxLength": 400,
    "minLength": 1,
    "type": "string"
   },
   "task": {
    "default": "balanced",
    "enum": [
     "balanced",
     "fresh_facts",
     "deep_research",
     "page_content",
     "scholarly"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "preview_search_route",
 "title": "Preview a FetchMux search route"
}
