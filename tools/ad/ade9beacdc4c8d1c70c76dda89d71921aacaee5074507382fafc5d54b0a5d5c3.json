{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Create a saved issue-list report (used by dashboard \"issue list\" widgets). Pick exactly one issue source inside parameters.filter: query | filter | filterId.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "fields": {
    "description": "Issue fields to include in export",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Field-value source",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "filterId": {
    "description": "Saved filter id as source",
    "type": "number"
   },
   "format": {
    "description": "Export format, default xlsx",
    "enum": [
     "xlsx",
     "xml",
     "csv"
    ],
    "type": "string"
   },
   "query": {
    "description": "Query language source",
    "type": "string"
   },
   "sorts": {
    "items": {
     "properties": {
      "orderAsc": {
       "type": "boolean"
      },
      "orderBy": {
       "type": "string"
      }
     },
     "required": [
      "orderBy"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "summary": {
    "description": "Report name",
    "type": "string"
   }
  },
  "required": [
   "summary"
  ],
  "type": "object"
 },
 "name": "create_issue_report"
}
