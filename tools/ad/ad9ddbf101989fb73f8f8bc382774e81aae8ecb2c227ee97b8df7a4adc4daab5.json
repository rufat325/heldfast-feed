{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Set your status + description (write). Requires status or color (blue/green/orange/red); if both are provided they must agree. Defaults to current user.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "enum": [
     "blue",
     "green",
     "orange",
     "red"
    ],
    "type": "string"
   },
   "description": {
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "ask me",
     "busy",
     "join me",
     "offline"
    ],
    "type": "string"
   },
   "userId": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "vrchat_status_set",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "status": {
    "enum": [
     "active",
     "ask me",
     "busy",
     "join me",
     "offline"
    ],
    "type": "string"
   },
   "statusDescription": {
    "type": "string"
   },
   "userId": {
    "type": "string"
   }
  },
  "required": [
   "userId",
   "status"
  ],
  "type": "object"
 }
}
