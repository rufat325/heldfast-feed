{
 "description": "Submit a music production request to AImeistrO. Runs the autonomous Value Loop (bidding, MIDI generation, QC) and returns job status, selected providers, economics, provenance, and artifact reference.",
 "inputSchema": {
  "properties": {
   "bars": {
    "description": "Number of bars",
    "maximum": 32,
    "minimum": 1,
    "type": "integer"
   },
   "bpm": {
    "description": "Tempo in beats per minute",
    "maximum": 200,
    "minimum": 60,
    "type": "number"
   },
   "budget": {
    "description": "Budget in AMC",
    "maximum": 1000,
    "minimum": 1,
    "type": "number"
   },
   "key": {
    "description": "Musical key (e.g. 'A minor', 'C major')",
    "type": "string"
   },
   "style": {
    "description": "Musical style (e.g. 'House')",
    "type": "string"
   },
   "type": {
    "description": "Request type (currently only MUSIC_LOOP supported)",
    "enum": [
     "MUSIC_LOOP"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "bpm",
   "bars",
   "key",
   "style",
   "budget"
  ],
  "type": "object"
 },
 "name": "create_music",
 "title": "Create Music"
}
