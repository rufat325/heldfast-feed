{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Extract and validate JSON-LD, microdata and RDFa. Reports every @type found, flags JSON-LD blocks that fail to parse (those are invisible to search engines), and checks recognised types against Google's rich-result requirements \u2014 required properties that are missing, plus recommended ones worth adding.\n\nCovers Article/BlogPosting/NewsArticle, Product, FAQPage, HowTo, Recipe, Event, Organization, LocalBusiness, Person, WebSite, BreadcrumbList, VideoObject, JobPosting, Course, Review and AggregateRating.\n\nArgs:\n  - url (string): the page to check.\n  - response_format ('markdown' | 'json'): output format (default 'markdown').\n\nReturns: { json_ld_blocks, microdata_items, parse_errors[], items[{type, properties[], missing_required[], missing_recommended[], valid}], types_found[], has_organization, has_breadcrumb, score, grade, findings[] }.\n\nExample: \"Does https://example.com/product have valid Product schema?\" -> structured_data_check(url=\"https://example.com/product\").",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "response_format": {
    "default": "markdown",
    "description": "Output format: 'markdown' for a human-readable summary (default) or 'json' for the full structured payload.",
    "enum": [
     "markdown",
     "json"
    ],
    "type": "string"
   },
   "url": {
    "description": "Page URL to analyse, e.g. 'https://example.com/blog/post'. The scheme defaults to https://.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "structured_data_check",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "final_url": {
    "type": "string"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "severity": {
       "type": "string"
      }
     },
     "required": [
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "grade": {
    "type": "string"
   },
   "has_article": {
    "type": "boolean"
   },
   "has_breadcrumb": {
    "type": "boolean"
   },
   "has_faq": {
    "type": "boolean"
   },
   "has_organization": {
    "type": "boolean"
   },
   "has_person": {
    "type": "boolean"
   },
   "has_website": {
    "type": "boolean"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "all_types": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "format": {
       "type": "string"
      },
      "missing_recommended": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "missing_required": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "note": {
       "type": [
        "string",
        "null"
       ]
      },
      "properties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "type": {
       "type": "string"
      },
      "valid": {
       "type": "boolean"
      }
     },
     "required": [
      "format",
      "type",
      "all_types",
      "properties",
      "missing_required",
      "missing_recommended",
      "valid",
      "note"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "json_ld_blocks": {
    "type": "number"
   },
   "microdata_items": {
    "type": "number"
   },
   "parse_errors": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "rdfa_items": {
    "type": "number"
   },
   "score": {
    "type": "number"
   },
   "types_found": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "url",
   "final_url",
   "json_ld_blocks",
   "microdata_items",
   "rdfa_items",
   "parse_errors",
   "items",
   "types_found",
   "has_organization",
   "has_person",
   "has_website",
   "has_breadcrumb",
   "has_article",
   "has_faq",
   "score",
   "grade",
   "findings"
  ],
  "type": "object"
 },
 "title": "Structured Data (Schema.org) Check"
}
