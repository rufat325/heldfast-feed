{
 "description": "List assets with optional filtering by collection, search, and pagination",
 "inputSchema": {
  "properties": {
   "contractId": {
    "description": "Filter assets by collection ID",
    "type": "string"
   },
   "order": {
    "default": "asc",
    "description": "Sort order (default: asc)",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (default: 1)",
    "minimum": 1,
    "type": "number"
   },
   "pageSize": {
    "default": 20,
    "description": "Number of assets per page (default: 20, max: 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "quickFilter": {
    "description": "Search text to filter assets by title",
    "type": "string"
   },
   "sortBy": {
    "default": "createdAt",
    "description": "Sort field (default: createdAt)",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_assets"
}
