{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Maker vs taker breakdown of a Hyperliquid wallet's fills per market: volume, fees and rebates. A high maker share with negative maker fees marks a market maker.",
 "inputSchema": {
  "properties": {
   "address": {
    "description": "0x-prefixed 20-byte hex address",
    "type": "string"
   },
   "from": {
    "description": "Unix ms window start",
    "type": "number"
   },
   "market": {
    "description": "Optional market filter",
    "type": "string"
   },
   "to": {
    "description": "Unix ms window end",
    "type": "number"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_user_maker_taker",
 "outputSchema": {
  "description": "Maker vs taker breakdown",
  "properties": {
   "address": {
    "description": "Wallet address (0x\u2026)"
   },
   "data": {
    "description": "Per market",
    "items": {
     "description": "One market",
     "properties": {
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "from": {
    "description": "Window start, Unix milliseconds"
   },
   "to": {
    "description": "Window end, Unix milliseconds"
   },
   "total": {
    "description": "All markets",
    "properties": {
     "maker_fee": {
      "description": "Maker fees in USD; negative means rebates"
     },
     "maker_fills": {
      "description": "Fills as maker"
     },
     "maker_notional": {
      "description": "Maker notional in USD"
     },
     "pct_maker": {
      "description": "Share of fills as maker, 0 to 1"
     },
     "taker_fee": {
      "description": "Taker fees in USD"
     },
     "taker_fills": {
      "description": "Fills as taker"
     },
     "taker_notional": {
      "description": "Taker notional in USD"
     },
     "total_fills": {
      "description": "All fills"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
