{
 "description": "PDF upload step 3 of 3: the server re-reads the stored bytes, verifies a PDF, hashes it and counts pages, then makes it the draft source (the draft revision advances). expectedSha256 is an optional cross-check (CHECKSUM_MISMATCH); finalizing before the PUT completes fails UPLOAD_INCOMPLETE. Receipt-backed: a replay returns the verified result. Requires agreements:write. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "expectedSha256": {
    "pattern": "^[0-9a-f]{64}$",
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Durable-receipt idempotency key sent as the Idempotency-Key header. Same key + same payload replays the stored outcome (replayed: true); same key + a changed payload is a 409.",
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "uploadId": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "documentId",
   "uploadId",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_documents_upload_finalize",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "byteSize": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "document": {
      "additionalProperties": false,
      "properties": {
       "createdAt": {
        "$ref": "#/properties/result/properties/document/properties/currentVersion/anyOf/0/properties/publishedAt"
       },
       "currentVersion": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "publishedAt": {
            "format": "date-time",
            "type": "string"
           },
           "versionId": {
            "$ref": "#/properties/result/properties/document/properties/documentId"
           },
           "versionNumber": {
            "minimum": 1,
            "type": "integer"
           }
          },
          "required": [
           "versionId",
           "versionNumber",
           "publishedAt"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "description": {
        "anyOf": [
         {
          "maxLength": 2000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "documentId": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "draftRevision": {
        "minimum": 0,
        "type": "integer"
       },
       "fields": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "minimum": 0,
          "type": "integer"
         },
         "fieldsHash": {
          "anyOf": [
           {
            "$ref": "#/properties/result/properties/document/properties/source/properties/sha256/anyOf/0"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "count",
         "fieldsHash"
        ],
        "type": "object"
       },
       "key": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "source": {
        "additionalProperties": false,
        "properties": {
         "fileName": {
          "anyOf": [
           {
            "maxLength": 255,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "sha256": {
          "anyOf": [
           {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "status": {
          "enum": [
           "NONE",
           "PENDING",
           "READY"
          ],
          "type": "string"
         }
        },
        "required": [
         "status",
         "fileName",
         "sha256"
        ],
        "type": "object"
       },
       "sourceKind": {
        "enum": [
         "EDITOR",
         "PDF_UPLOAD",
         "MARKDOWN",
         "HTML",
         "DOCX_EDITABLE",
         "DOCX_LAYOUT"
        ],
        "type": "string"
       },
       "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "updatedAt": {
        "$ref": "#/properties/result/properties/document/properties/currentVersion/anyOf/0/properties/publishedAt"
       }
      },
      "required": [
       "documentId",
       "key",
       "title",
       "description",
       "sourceKind",
       "draftRevision",
       "source",
       "fields",
       "currentVersion",
       "createdAt",
       "updatedAt"
      ],
      "type": "object"
     },
     "pageCount": {
      "minimum": 1,
      "type": "integer"
     },
     "replayed": {
      "type": "boolean"
     }
    },
    "required": [
     "document",
     "pageCount",
     "byteSize",
     "replayed"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
