 },
 "description": "Calculate the hypothetical dollar impact of user-selected outcome prices for a fixed number of contracts, including explicit entry and exit dollar costs. Pure arithmetic: not a forecast, live quote, strategy backtest, order or paper position.",
 "execution": {
  "taskSupport": "forbidden"
 },
