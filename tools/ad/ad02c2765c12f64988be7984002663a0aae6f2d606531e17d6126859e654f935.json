  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contracts": {
    "exclusiveMinimum": 0,
    "maximum": 1000000,
    "type": "number"
   },
   "entryCostUsd": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "entryPrice": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "exitCostUsd": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "number"
   },
   "scenarioPrices": {
    "items": {
     "maximum": 1,
     "minimum": 0,
     "type": "number"
    },
    "maxItems": 12,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "contracts",
   "entryPrice",
   "scenarioPrices"
  ],
  "type": "object"
 },
 "name": "calculate_probability_scenario",
 "title": "Vi probability scenario"
}
