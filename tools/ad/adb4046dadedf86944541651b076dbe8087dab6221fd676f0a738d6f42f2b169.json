{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get object"
 },
 "description": "Get a single object by ID or by slug+type. Returns the full object with all metadata.",
 "inputSchema": {
  "properties": {
   "id": {
    "description": "Object ID",
    "type": "string"
   },
   "props": {
    "description": "Specific properties to return",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "slug": {
    "description": "Object slug (requires type parameter)",
    "type": "string"
   },
   "status": {
    "default": "any",
    "description": "Filter by publication status",
    "enum": [
     "published",
     "draft",
     "any"
    ],
    "type": "string"
   },
   "type": {
    "description": "Object type slug (required when using slug)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cosmic_objects_get",
 "title": "Get object"
}
