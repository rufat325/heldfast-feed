{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List available music and video files. Optionally filter by search term or directory.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "directory": {
    "default": "all",
    "description": "Which directory to browse",
    "enum": [
     "music",
     "videos",
     "all"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "description": "Maximum number of results (default 25)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Filter files by search term",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mpv_browse",
 "title": "Browse Music Library"
}
