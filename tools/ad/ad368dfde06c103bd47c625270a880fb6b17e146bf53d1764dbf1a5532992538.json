{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read a single datapoint value from a device channel. Only address and valueKey are required \u2014 interface is auto-resolved. Use list_devices to find addresses, describe_device_type to find valid valueKeys.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "address": {
    "description": "Channel address (e.g. '000A1BE9A71F15:1')",
    "type": "string"
   },
   "interface": {
    "description": "Interface name override (auto-resolved if omitted)",
    "type": "string"
   },
   "target": {
    "description": "CCU target to read from (default: active). See list_ccu_targets.",
    "type": "string"
   },
   "valueKey": {
    "description": "Datapoint name (e.g. 'STATE', 'LEVEL', 'ACTUAL_TEMPERATURE')",
    "type": "string"
   }
  },
  "required": [
   "address",
   "valueKey"
  ],
  "type": "object"
 },
 "name": "get_value",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "value": {
    "description": "Parsed datapoint value (bool/number/string/null)"
   },
   "valueKey": {
    "type": "string"
   }
  },
  "required": [
   "address",
   "valueKey",
   "value"
  ],
  "type": "object"
 },
 "title": "Get Value"
}
