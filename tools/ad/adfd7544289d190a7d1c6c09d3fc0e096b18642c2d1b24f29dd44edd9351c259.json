{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"TALKING HEAD: zoom changes on emphasis \u2014 style \"punch\" splits at sentence starts, ! and ? (from the transcript) or loud peaks and alternates a tighter crop; \"push\" gives each shot a slow push-in/pull-out. amount 1.03\u20131.4, focusY (0.4 = faces).","inputSchema":{"additionalProperties":false,"properties":{"amount":{"maximum":1.4,"minimum":1.03,"type":"number"},"author":{"maxLength":40,"type":"string"},"clips":{"anyOf":[{"enum":["all"],"type":"string"},{"items":{"pattern":"^[a-z0-9]{1,24}$","type":"string"},"maxItems":200,"type":"array"}]},"dryRun":{"type":"boolean"},"focusY":{"maximum":1,"minimum":0,"type":"number"},"minGap":{"maximum":30,"minimum":1.2,"type":"number"},"projectId":{"pattern":"^[0-9a-f-]{36}$","type":"string"},"revision":{"minimum":1,"type":"integer"},"style":{"enum":["punch","push"],"type":"string"}},"required":["projectId","revision"],"type":"object"},"name":"studio_auto_zoom"}
