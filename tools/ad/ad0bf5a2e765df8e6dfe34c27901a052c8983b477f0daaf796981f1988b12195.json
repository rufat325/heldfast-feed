 },
 "description": "Tablo servisi a\u00e7\u0131k bir kayna\u011f\u0131n (acikveri_veriseti \u2192 kaynaklar \u2192 tabloServisi=true) s\u00fctunlar\u0131n\u0131 ve sat\u0131rlar\u0131n\u0131 verir; iste\u011fe ba\u011fl\u0131 tam metin filtresi. Rows from a CKAN DataStore resource. B\u00fcy\u00fck tablolar i\u00e7in limit ve sayfa (offset) kullan\u0131n; toplam sat\u0131r say\u0131s\u0131 yan\u0131ttad\u0131r.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filtre": {
    "description": "Tam metin arama, iste\u011fe ba\u011fl\u0131",
    "type": "string"
   },
   "kaynakId": {
    "description": "Kayna\u011f\u0131n `id` de\u011feri",
    "minLength": 8,
    "type": "string"
   },
   "limit": {
    "description": "En fazla sat\u0131r, varsay\u0131lan 50",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "description": "Atlanacak sat\u0131r say\u0131s\u0131 (sayfalama)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "portal": {
    "description": "ibb (\u0130stanbul) | izmir | konya | gaziantep",
    "enum": [
     "ibb",
     "izmir",
     "konya",
     "gaziantep"
    ],
    "type": "string"
   }
  },
  "required": [
   "portal",
   "kaynakId"
  ],
  "type": "object"
 },
 "name": "acikveri_kayitlar",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "alindi": {
    "type": "string"
   },
   "kaynak": {
    "additionalProperties": false,
    "properties": {
     "ad": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "ad",
     "url"
    ],
    "type": "object"
   },
   "veri": {
    "additionalProperties": false,
    "properties": {
     "portal": {
      "type": "string"
     },
     "satirlar": {
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "sutunlar": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "ad": {
         "type": "string"
        },
        "tur": {
         "type": "string"
        }
       },
       "required": [
        "ad",
        "tur"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "toplam": {
      "type": [
       "number",
       "null"
      ]
     }
    },
    "required": [
     "portal",
     "toplam",
     "sutunlar",
     "satirlar"
    ],
    "type": "object"
   }
  },
  "required": [
   "kaynak",
   "alindi",
   "veri"
  ],
  "type": "object"
 },
 "title": "A\u00e7\u0131k veri kayna\u011f\u0131ndan sat\u0131rlar\u0131 oku (DataStore)"
}
