{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "openWorldHint": true,
  "priority": 0.5,
  "title": "Create Bulk Tasks"
 },
 "description": "Create multiple tasks in one list. Supports recursive subtasks via nested 'subtasks' array. Requires: tasks array + (listId or listName). Each task needs name.",
 "inputSchema": {
  "properties": {
   "listId": {
    "description": "List ID",
    "type": "string"
   },
   "listName": {
    "description": "List name",
    "type": "string"
   },
   "options": {
    "description": "Processing options. JSON strings are auto-parsed.",
    "properties": {
     "batchSize": {
      "description": "Tasks per batch (default: 10)",
      "type": "number"
     },
     "concurrency": {
      "description": "Parallel operations (default: 3)",
      "type": "number"
     },
     "continueOnError": {
      "description": "Continue if some tasks fail",
      "type": "boolean"
     },
     "retryCount": {
      "description": "Retry attempts for failures",
      "type": "number"
     }
    },
    "type": "object"
   },
   "tasks": {
    "description": "Tasks to create. Each needs name.",
    "items": {
     "description": "Task object",
     "properties": {
      "assignees": {
       "description": "User IDs/emails/names (comma-separated or JSON string)",
       "type": "string"
      },
      "custom_fields": {
       "description": "Custom fields as JSON string: [{id, value}]",
       "type": "string"
      },
      "custom_task_type": {
       "description": "Task type name (e.g. 'Bug', 'Milestone')",
       "type": "string"
      },
      "description": {
       "description": "Plain text description",
       "type": "string"
      },
      "dueDate": {
       "description": "Due date",
       "type": "string"
      },
      "markdown_description": {
       "description": "Markdown description",
       "type": "string"
      },
      "name": {
       "description": "Task name prefixed with emoji",
       "type": "string"
      },
      "parent": {
       "description": "Parent task ID (convert this task to a subtask).",
       "type": "string"
      },
      "parentListName": {
       "description": "List name of parent task. Helps disambiguate parentName.",
       "type": "string"
      },
      "parentName": {
       "description": "Parent task name. Resolved to ID if parent is missing.",
       "type": "string"
      },
      "priority": {
       "description": "Priority 1-4, as string or number",
       "type": "string"
      },
      "status": {
       "description": "Status",
       "type": "string"
      },
      "subtasks": {
       "description": "Subtasks as JSON string",
       "type": "string"
      },
      "tags": {
       "description": "Tags (comma-separated or JSON string)",
       "type": "string"
      },
      "time_estimate": {
       "description": "Time estimate: natural language ('2h 30m', '45m', '1.5h'), or plain number (minutes).",
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "team_id": {
    "description": "The ClickUp Team ID or Workspace Name to use. If provided, the server will switch to this workspace for this and subsequent requests in the current session.",
    "type": "string"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "name": "create_bulk_tasks"
}
