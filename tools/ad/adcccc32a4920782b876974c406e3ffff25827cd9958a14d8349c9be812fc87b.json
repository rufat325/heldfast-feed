{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List registered domains and their DCV validation state (Certificate Manager 2.0). Public zone only. Requires a main-account API key \u2014 Certificate Manager 2.0 rejects Sub Account keys with HTTP 403 (confirmed by Ncloud support; verified 2026-10-02 with NCP_ADMINISTRATOR).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dcvType": {
    "description": "Filter by DCV type",
    "enum": [
     "PTXT",
     "TXT"
    ],
    "type": "string"
   },
   "domainAddress": {
    "description": "Filter by domain address",
    "type": "string"
   },
   "orgNo": {
    "description": "Filter by organization number",
    "type": "integer"
   },
   "page": {
    "description": "Page number (default 1)",
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Page size (default 10)",
    "minimum": 1,
    "type": "integer"
   },
   "validState": {
    "description": "Filter by validation state",
    "enum": [
     "PENDING",
     "VALID",
     "INVALID"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "ncloud_cm2_list_domains"
}
