{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Inspect n8n workflow"
 },
 "description": "Inspect one workflow and saved executions with 23 deterministic local rules. profile sets paired defaults: quick uses 24h/20 and caps maxExecutions at 25; deep uses 168h/50 and reads at most four redacted details. includeSanitizedLabels=false keeps labels opaque; true opts into bounded sanitized labels. Use n8n_audit_generate for instance security or n8n_workflows_get for raw structure. Requires workflow/execution read permission; never executes or calls AI; returns findings and coverage.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "includeSanitizedLabels": {
    "default": false,
    "description": "Include bounded pattern-sanitized workflow/node labels instead of opaque identifiers only (default false).",
    "type": "boolean"
   },
   "lookbackHours": {
    "description": "History window in hours; defaults to 24 for quick and 168 for deep.",
    "maximum": 720,
    "minimum": 1,
    "type": "integer"
   },
   "maxExecutions": {
    "description": "Maximum saved executions to inspect; defaults to 20 for quick and 50 for deep, with quick capped at 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "profile": {
    "default": "quick",
    "description": "Use quick for metadata triage or deep for up to four redacted execution details.",
    "enum": [
     "quick",
     "deep"
    ],
    "type": "string"
   },
   "workflowId": {
    "description": "Stable ID of the workflow to inspect without executing it.",
    "pattern": "^[A-Za-z0-9_-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "workflowId"
  ],
  "type": "object"
 },
 "name": "n8n_introspect",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "engineVersion": {
    "const": "2.0.0",
    "description": "Version of the deterministic local analysis engine that produced this result.",
    "type": "string"
   },
   "findings": {
    "description": "Ordered deterministic findings retained within the configured output limit.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "affectedEntity": {
       "additionalProperties": false,
       "properties": {
        "key": {
         "maxLength": 128,
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "label": {
         "type": "string"
        }
       },
       "required": [
        "kind",
        "key"
       ],
       "type": "object"
      },
      "category": {
       "enum": [
        "structure",
        "contract",
        "reliability",
        "performance",
        "privacy",
        "maintainability",
        "observability"
       ],
       "type": "string"
      },
      "confidence": {
       "enum": [
        "high",
        "medium",
        "low"
       ],
       "type": "string"
      },
      "documentationUrl": {
       "maxLength": 2048,
       "type": "string"
      },
      "evidence": {
       "additionalProperties": false,
       "properties": {
        "facts": {
         "additionalProperties": {
          "type": [
           "string",
           "number",
           "boolean",
           "null"
          ]
         },
         "type": "object"
        },
        "summary": {
         "type": "string"
        }
       },
       "required": [
        "summary"
       ],
       "type": "object"
      },
      "id": {
       "maxLength": 164,
       "type": "string"
      },
      "remediation": {
       "type": "string"
      },
      "ruleId": {
       "enum": [
        "CONTRACT_EXPRESSION_MISSING_NODE",
        "CONTRACT_SUBWORKFLOW_SELF_REFERENCE",
        "CONTRACT_WEBHOOK_RESPONSE_MISSING",
        "CONTRACT_WEBHOOK_RESPONSE_ORPHAN",
        "EXECUTION_CRASH_OBSERVED",
        "EXECUTION_DURATION_SHIFT",
        "EXECUTION_FAILURE_STREAK",
        "EXECUTION_REPEATED_ERROR",
        "GRAPH_CYCLE_WITHOUT_KNOWN_CONTROL",
        "GRAPH_DANGLING_SOURCE",
        "GRAPH_DANGLING_TARGET",
        "GRAPH_DISABLED_CONNECTED_NODE",
        "GRAPH_INVALID_EDGE",
        "GRAPH_UNREACHABLE_NODE",
        "NODE_INVALID_RETRY_CONFIGURATION",
        "NODE_INVALID_TYPE_VERSION",
        "NODE_LEGACY_CONTINUE_ON_FAIL",
        "NODE_RETRY_SIDE_EFFECT",
        "PRIVACY_LITERAL_SECRET",
        "WORKFLOW_ACTIVE_WITHOUT_TRIGGER",
        "WORKFLOW_ERROR_DATA_DISABLED",
        "WORKFLOW_ERROR_SELF_REFERENCE",
        "WORKFLOW_INVALID_TIMEZONE"
       ],
       "type": "string"
      },
      "severity": {
       "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
       ],
       "type": "string"
      },
      "summary": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "ruleId",
      "category",
      "severity",
      "confidence",
      "title",
      "summary",
      "affectedEntity",
      "evidence",
      "remediation"
     ],
     "type": "object"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "guidance": {
    "additionalProperties": false,
    "description": "Boundary guidance pointing to the separate instance-level n8n security audit tool.",
    "properties": {
     "instanceSecurityTool": {
      "const": "n8n_audit_generate",
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "instanceSecurityTool",
     "message"
    ],
    "type": "object"
   },
   "limitations": {
    "description": "Collection or analysis limitations that constrain interpretation of this result.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "enum": [
        "deadline_exceeded",
        "response_too_large",
        "upstream_http_error",
        "invalid_json",
        "invalid_schema",
        "repeated_cursor",
        "invalid_timestamp",
        "invalid_execution_id",
        "page_failed",
        "detail_failed",
        "ordering_unreliable",
        "finding_limit",
        "output_limit",
        "label_redaction_limit"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "metrics": {
    "additionalProperties": false,
    "description": "Factual status, duration, node-timing, and value-free error-cluster measurements.",
    "properties": {
     "consecutiveErrors": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "duration": {
      "additionalProperties": false,
      "properties": {
       "maxMs": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "meanMs": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "minMs": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "p50Ms": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "p95Ms": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "p99Ms": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ]
       },
       "sampleCount": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "sampleCount",
       "meanMs",
       "minMs",
       "maxMs",
       "p50Ms",
       "p95Ms",
       "p99Ms"
      ],
      "type": "object"
     },
     "errorClusters": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "fingerprint": {
         "pattern": "^[a-f0-9]{16}$",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "nodeRef": {
         "type": "string"
        },
        "sampleCount": {
         "exclusiveMinimum": 0,
         "type": "integer"
        },
        "sampledErrorDetails": {
         "minimum": 0,
         "type": "integer"
        },
        "sampledErrors": {
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "fingerprint",
        "sampleCount",
        "sampledErrorDetails",
        "sampledErrors"
       ],
       "type": "object"
      },
      "maxItems": 100,
      "type": "array"
     },
     "perNodeTimings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "label": {
         "type": "string"
        },
        "maxMs": {
         "minimum": 0,
         "type": "number"
        },
        "medianMs": {
         "minimum": 0,
         "type": "number"
        },
        "nodeRef": {
         "type": "string"
        },
        "sampleCount": {
         "exclusiveMinimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "nodeRef",
        "sampleCount",
        "medianMs",
        "maxMs"
       ],
       "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
     },
     "statusCounts": {
      "additionalProperties": false,
      "properties": {
       "canceled": {
        "minimum": 0,
        "type": "integer"
       },
       "crashed": {
        "minimum": 0,
        "type": "integer"
       },
       "error": {
        "minimum": 0,
        "type": "integer"
       },
       "new": {
        "minimum": 0,
        "type": "integer"
       },
       "running": {
        "minimum": 0,
        "type": "integer"
       },
       "success": {
        "minimum": 0,
        "type": "integer"
       },
       "unknown": {
        "minimum": 0,
        "type": "integer"
       },
       "waiting": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "success",
       "error",
       "crashed",
       "canceled",
       "running",
       "waiting",
       "new",
       "unknown"
      ],
      "type": "object"
     },
     "successRate": {
      "anyOf": [
       {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "statusCounts",
     "successRate",
     "duration",
     "consecutiveErrors",
     "perNodeTimings",
     "errorClusters"
    ],
    "type": "object"
   },
   "profile": {
    "description": "Effective quick or deep analysis profile used for this result.",
    "enum": [
     "quick",
     "deep"
    ],
    "type": "string"
   },
   "ruleCoverage": {
    "description": "Per-rule outcome and completeness evidence, including omitted finding counts.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "detectedCycleCount": {
       "minimum": 0,
       "type": "integer"
      },
      "findingCount": {
       "minimum": 0,
       "type": "integer"
      },
      "inconclusiveCycleCount": {
       "minimum": 0,
       "type": "integer"
      },
      "omittedFindingCount": {
       "minimum": 0,
       "type": "integer"
      },
      "outcome": {
       "enum": [
        "triggered",
        "passed",
        "not_applicable",
        "inconclusive"
       ],
       "type": "string"
      },
      "partiallyInconclusive": {
       "type": "boolean"
      },
      "reason": {
       "type": "string"
      },
      "ruleId": {
       "enum": [
        "CONTRACT_EXPRESSION_MISSING_NODE",
        "CONTRACT_SUBWORKFLOW_SELF_REFERENCE",
        "CONTRACT_WEBHOOK_RESPONSE_MISSING",
        "CONTRACT_WEBHOOK_RESPONSE_ORPHAN",
        "EXECUTION_CRASH_OBSERVED",
        "EXECUTION_DURATION_SHIFT",
        "EXECUTION_FAILURE_STREAK",
        "EXECUTION_REPEATED_ERROR",
        "GRAPH_CYCLE_WITHOUT_KNOWN_CONTROL",
        "GRAPH_DANGLING_SOURCE",
        "GRAPH_DANGLING_TARGET",
        "GRAPH_DISABLED_CONNECTED_NODE",
        "GRAPH_INVALID_EDGE",
        "GRAPH_UNREACHABLE_NODE",
        "NODE_INVALID_RETRY_CONFIGURATION",
        "NODE_INVALID_TYPE_VERSION",
        "NODE_LEGACY_CONTINUE_ON_FAIL",
        "NODE_RETRY_SIDE_EFFECT",
        "PRIVACY_LITERAL_SECRET",
        "WORKFLOW_ACTIVE_WITHOUT_TRIGGER",
        "WORKFLOW_ERROR_DATA_DISABLED",
        "WORKFLOW_ERROR_SELF_REFERENCE",
        "WORKFLOW_INVALID_TIMEZONE"
       ],
       "type": "string"
      },
      "totalFindingCount": {
       "minimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "ruleId",
      "outcome",
      "partiallyInconclusive",
      "reason",
      "findingCount",
      "totalFindingCount",
      "omittedFindingCount",
      "detectedCycleCount",
      "inconclusiveCycleCount"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   },
   "sample": {
    "additionalProperties": false,
    "description": "Exact execution-history scope, ordering confidence, requests, and byte budget used.",
    "properties": {
