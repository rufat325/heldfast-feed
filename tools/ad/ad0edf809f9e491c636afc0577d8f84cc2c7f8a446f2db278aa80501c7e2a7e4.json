       "null"
      ]
     },
     "oldestStartedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "ordering": {
      "enum": [
       "verified_newest_first",
       "unreliable",
       "unknown"
      ],
      "type": "string"
     },
     "pages": {
      "minimum": 0,
      "type": "integer"
     },
     "sampledErrors": {
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
     "lookbackHours",
     "maxExecutions",
     "metadataExecutions",
     "eligibleExecutions",
     "pages",
     "detailRequests",
     "sampledErrors",
     "acceptedBytes",
     "ordering",
     "historyBoundary",
     "oldestStartedAt",
     "newestStartedAt"
    ],
    "type": "object"
   },
   "schemaVersion": {
    "const": "1.0.0",
    "description": "Version of the stable structured introspect result contract.",
    "type": "string"
   },
   "status": {
