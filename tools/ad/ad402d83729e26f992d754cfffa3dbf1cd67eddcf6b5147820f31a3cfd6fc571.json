{
 "description": "Update a scheduled post (content, custom content, or scheduled time)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "New text content",
    "type": "string"
   },
   "custom_content": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "New platform-specific content overrides",
    "propertyNames": {
     "enum": [
      "twitter",
      "linkedin",
      "facebook",
      "instagram",
      "threads",
      "tiktok",
      "pinterest",
      "bluesky",
      "telegram",
      "youtube",
      "reddit",
      "google_business",
      "snapchat"
     ]
    },
    "type": "object"
   },
   "post_id": {
    "description": "The post ID to update",
    "type": "number"
   },
   "scheduled_for": {
    "description": "New ISO 8601 datetime",
    "type": "string"
   }
  },
  "required": [
   "post_id"
  ],
  "type": "object"
 },
 "name": "update_post"
}
