 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks whether mail from a domain will reach Gmail or Outlook, or why it is rejected or goes to spam, such as \"will Gmail accept mail from example.com sent from 203.0.113.7?\". Pass the domain, the sending IPv4 address if known, the return-path domain (mail_from) if known and, optionally, up to 5 DKIM selectors. Returns one verdict (likely_accepted, at_risk, likely_rejected or incomplete) with a verdict per provider, the top 3 causes each with one fix, the exact SPF and DMARC records to paste (records_to_paste) and the DKIM steps for the detected mail provider (fix_steps), every rule checked with its official source link (SPF for the IP, DKIM, DMARC, reverse DNS, blocklists), the 6 blocklists with their terms links, what was not checked, and the source and as_of date. Gmail and Outlook are always both reported, so there is no provider argument. It reads public DNS and free blocklists only: it sends no test message and cannot see sender reputation, so it does not promise inbox placement.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "dkim_selectors": {
    "description": "DKIM selector names, the s= value in a DKIM-Signature header, such as [\"google\"]. Optional: when omitted, 10 usual selector names are tried. At most 5.",
    "items": {
     "maxLength": 63,
     "minLength": 1,
     "pattern": "^[A-Za-z0-9._-]+$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   },
   "domain": {
    "description": "The domain in the From address, such as \"example.com\". A web address or an email address is reduced to its domain.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "mail_from": {
    "description": "The return-path domain, which receivers test SPF on: the domain after @ in the Return-Path header of a sent message, or smtp.mailfrom in its Authentication-Results, such as \"send.example.com\". Optional: when omitted, SPF for sending_ip is tested on the From domain, then on the usual return-path names under it (send, bounce, bounces, mail, mg, pm-bounces). Mail providers such as Resend, Amazon SES and Postmark send with their own return-path domain.",
    "maxLength": 253,
    "minLength": 3,
    "type": "string"
   },
   "sending_ip": {
    "description": "The public IPv4 address your mail is sent from, such as 203.0.113.7. Optional: without it the IP checks (SPF for the address, reverse DNS, IP blocklists) are skipped. IPv6 is not supported.",
    "maxLength": 15,
    "minLength": 7,
    "type": "string"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
