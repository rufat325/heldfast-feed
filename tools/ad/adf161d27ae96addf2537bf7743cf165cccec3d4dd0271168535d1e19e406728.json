{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Explain how TheAIMeters indicators are produced. Omit slug for the general methodology and meter-to-methodology mappings. Supply an exact meter slug for its calculation, formula, assumptions, limitations, refresh policy and structured sources. Returns backend-authored content as-is; an unknown meter methodology is a tool error.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "slug": {
    "description": "Exact meter slug from list_meters or search_meters, for example electricity-ai-today.",
    "pattern": "^[a-z0-9-]+$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_methodology",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
   "meter": {
    "additionalProperties": true,
    "properties": {
     "calculationMode": {
      "enum": [
       "snapshot",
       "live_today",
       "live_ytd",
       "rolling_window",
       "manual_estimate"
      ],
      "type": "string"
     },
     "confidenceLevel": {
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     },
     "label": {
      "type": "string"
     },
     "slug": {
      "type": "string"
     },
     "sourceNote": {
      "anyOf": [
       {
        "description": "Source note supplied by the backend.",
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "slug",
     "label",
     "calculationMode",
     "confidenceLevel",
     "sourceNote"
    ],
    "type": "object"
   },
   "meters": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "methodologyId": {
       "type": "string"
      },
      "slug": {
       "type": "string"
      }
     },
     "required": [
      "slug",
      "methodologyId"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "methodology": {
    "anyOf": [
     {
      "additionalProperties": true,
      "properties": {
       "approach": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "dataSources": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "ethics": {
        "type": "string"
       },
       "id": {
        "const": "theaimeters",
        "type": "string"
       },
       "limitations": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "reviewedOn": {
        "anyOf": [
         {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "scope": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "updatePolicy": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "scope",
       "dataSources",
       "approach",
       "updatePolicy",
       "limitations",
       "ethics",
       "reviewedOn"
      ],
      "type": "object"
     },
     {
      "additionalProperties": true,
      "properties": {
       "calculation": {
        "type": "string"
       },
       "description": {
        "type": "string"
       },
       "formula": {
        "type": "string"
       },
       "id": {
        "type": "string"
       },
       "inputs": {
        "items": {
         "additionalProperties": true,
         "properties": {
          "kind": {
           "enum": [
            "assumption",
            "public_proxy"
           ],
           "type": "string"
          },
          "label": {
           "type": "string"
          },
          "value": {
           "type": "string"
          }
         },
         "required": [
          "label",
          "value",
          "kind"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "limitations": {
        "type": "string"
       },
       "refreshPolicy": {
        "type": "string"
       },
       "reviewedOn": {
        "anyOf": [
         {
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "sourceIds": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "title": {
        "type": "string"
       },
       "whatItMeasures": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "description",
       "whatItMeasures",
       "calculation",
       "formula",
       "limitations",
       "refreshPolicy",
       "inputs",
       "sourceIds",
       "reviewedOn"
      ],
      "type": "object"
     }
    ]
   },
   "sources": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "category": {
       "enum": [
        "research",
        "public_data",
        "api",
        "status"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "url",
      "category"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "methodology"
  ],
  "type": "object"
 }
}
