{
 "description": "Update one or more existing tasks. Supports batch updates.\n\nWHEN TO USE:\n- Modify task title, description, dates, or priority\n- Change due date or add reminders\n- Add/update sub-tasks (items)\n- Reschedule or reprioritize tasks\n\nREQUIRED (per task):\n- taskId: Task to update\n- projectId: Project containing the task\n\nOPTIONAL (only provided fields are updated):\n- title: New task title\n- description: New notes (auto-maps to correct field)\n- dueDate: ISO 8601 format (e.g., \"2025-11-25T17:00:00+0800\")\n- startDate: ISO 8601 format\n- priority: 0=none, 1=low, 3=medium, 5=high\n- isAllDay: true for all-day tasks\n- reminders: [\"TRIGGER:PT0S\"]\n- repeatFlag: Recurrence rule\n- items: Sub-task array [{title, status: 0|1}]\n\nINPUT FORMAT: { \"tasks\": [{ \"taskId\": \"...\", \"projectId\": \"...\", ...updates }, ...] }\n\nBATCH BEHAVIOR: Non-atomic - some may succeed while others fail. Check summary.failed > 0.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "tasks": {
    "description": "Array of tasks to update",
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "description": "Task description/notes. Auto-mapped: to 'content' for TEXT tasks, to 'desc' for CHECKLIST tasks (with items)",
       "type": "string"
      },
      "dueDate": {
       "description": "Due time, format yyyy-MM-dd'T'HH:mm:ssZ (optional)",
       "type": "string"
      },
      "isAllDay": {
       "description": "Is all-day task (optional)",
       "type": "boolean"
      },
      "items": {
       "description": "Sub-task list. When provided, task becomes CHECKLIST type",
       "items": {
        "additionalProperties": false,
        "properties": {
         "completedTime": {
          "description": "Completed time, format yyyy-MM-dd'T'HH:mm:ssZ",
          "type": "string"
         },
         "isAllDay": {
          "description": "Is all-day, default false",
          "type": "boolean"
         },
         "sortOrder": {
          "description": "Sort order number",
          "type": "number"
         },
         "startDate": {
          "description": "Start time, format yyyy-MM-dd'T'HH:mm:ssZ",
          "type": "string"
         },
         "status": {
          "description": "Status: 0=normal, 1=completed",
          "type": "number"
         },
         "timeZone": {
          "description": "Time zone",
          "type": "string"
         },
         "title": {
          "description": "Sub-task title",
          "type": "string"
         }
        },
        "required": [
         "title",
         "status"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "priority": {
       "description": "Priority: 0=none, 1=low, 3=medium, 5=high (optional)",
       "type": "number"
      },
      "projectId": {
       "description": "Project ID (required)",
       "type": "string"
      },
      "reminders": {
       "description": "Reminder list (optional)",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "repeatFlag": {
       "description": "Repeat rule (optional)",
       "type": "string"
      },
      "sortOrder": {
       "description": "Sort order number (optional)",
       "type": "number"
      },
      "startDate": {
       "description": "Start time, format yyyy-MM-dd'T'HH:mm:ssZ (optional)",
       "type": "string"
      },
      "taskId": {
       "description": "Task ID (required)",
       "type": "string"
      },
      "timeZone": {
       "description": "Time zone (optional)",
       "type": "string"
      },
      "title": {
       "description": "Task title (optional)",
       "type": "string"
      }
     },
     "required": [
      "taskId",
      "projectId"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "tasks"
  ],
  "type": "object"
 },
 "name": "update_task",
 "title": "Update Task(s)"
}
