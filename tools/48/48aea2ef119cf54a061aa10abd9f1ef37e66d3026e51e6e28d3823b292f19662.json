{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Open a dispute on an order you paid (PAID..DELIVERED). reason_code: not_received, not_as_described, duplicate, canceled_recurring, agent_error, other; note up to 1000 characters. The order becomes DISPUTED and the merchant has 7 days to answer (by refunding it); an unanswered dispute expires and counts in the merchant's reputation, which can suspend its quotes. A verified refund resolves the dispute. One open dispute per order; another identity's order is 404.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "note": {
    "maxLength": 1000,
    "type": "string"
   },
   "order_id": {
    "type": "string"
   },
   "reason_code": {
    "enum": [
     "not_received",
     "not_as_described",
     "duplicate",
     "canceled_recurring",
     "agent_error",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "order_id",
   "reason_code"
  ],
  "type": "object"
 },
 "name": "shop.order.dispute",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dispute_id": {
    "type": "string"
   },
   "due_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "order_id": {
    "type": "string"
   },
   "reason_code": {
    "type": "string"
   },
   "state": {
    "type": "string"
   },
   "status": {
    "type": "string"
   }
  },
  "required": [
   "dispute_id",
   "order_id",
   "status",
   "reason_code",
   "due_at",
   "state"
  ],
  "type": "object"
 },
 "title": "Dispute an order"
}
