{"annotations":{"destructiveHint":false,"readOnlyHint":true},"description":"Price a revision of a run WITHOUT spending credits: what it would change (summary) and what it costs (billing.total_credits). Pass run_id and exactly one of changes or document, the same as revise_run. Always call this first and show the user the price before revise_run. A revision that delivers is charged its quoted total; one that fails is charged nothing. While paid edits are closed it answers editing_disabled and charges nothing.","inputSchema":{"$defs":{"d0":{"oneOf":[{"properties":{"mode":{"const":"retake","type":"string"}},"required":["mode"],"type":"object"},{"properties":{"description":{"maxLength":600,"minLength":1,"type":"string"},"mode":{"const":"new_picture","type":"string"}},"required":["mode","description"],"type":"object"},{"properties":{"instruction":{"maxLength":600,"minLength":1,"type":"string"},"mode":{"const":"edit_picture","type":"string"}},"required":["mode","instruction"],"type":"object"},{"properties":{"mode":{"const":"animate","type":"string"},"motion":{"maxLength":300,"minLength":1,"type":"string"}},"required":["mode"],"type":"object"}]},"d1":{"pattern":"^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$","type":"string"},"d2":{"pattern":"^run_[a-zA-Z0-9]+$","type":"string"},"d3":{"exclusiveMinimum":0,"type":"integer"}},"properties":{"changes":{"description":"Shots to generate anew over the run as it is: each a shot_id and the operation to generate for it.","items":{"properties":{"operation":{"$ref":"#/$defs/d0"},"shot_id":{"$ref":"#/$defs/d1"}},"required":["shot_id","operation"],"type":"object"},"maxItems":500,"minItems":1,"type":"array"},"document":{"description":"The whole edited document, as the run's draft holds it; retimes, deletions and uploads go this way.","properties":{"discarded":{"default":[],"items":{"$ref":"#/$defs/d2"},"maxItems":500,"type":"array"},"duration_frames":{"$ref":"#/$defs/d3"},"shots":{"items":{"properties":{"asset":{"oneOf":[{"properties":{"from":{"const":"source","type":"string"},"shot_id":{"$ref":"#/$defs/d1"}},"required":["from","shot_id"],"type":"object"},{"properties":{"from":{"const":"candidate","type":"string"},"run_id":{"$ref":"#/$defs/d2"}},"required":["from","run_id"],"type":"object"},{"properties":{"from":{"const":"upload","type":"string"},"upload_id":{"pattern":"^upl_[a-f0-9]{32}$","type":"string"}},"required":["from","upload_id"],"type":"object"},{"properties":{"from":{"const":"generate","type":"string"},"operation":{"$ref":"#/$defs/d0"}},"required":["from","operation"],"type":"object"}]},"end_frame":{"$ref":"#/$defs/d3"},"id":{"$ref":"#/$defs/d1"},"kind":{"enum":["picture","clip","presenter"],"type":"string"},"media_offset_frames":{"minimum":0,"type":"integer"},"start_frame":{"minimum":0,"type":"integer"},"track":{"enum":["visual","presenter"],"type":"string"}},"required":["id","track","kind","start_frame","end_frame","asset"],"type":"object"},"maxItems":500,"minItems":1,"type":"array"},"source_run_id":{"$ref":"#/$defs/d2"},"timebase":{"properties":{"fps":{"$ref":"#/$defs/d3"}},"required":["fps"],"type":"object"},"transitions":{"anyOf":[{"properties":{"at":{"anyOf":[{"const":"scene_changes","type":"string"},{"items":{"$ref":"#/$defs/d1"},"maxItems":500,"minItems":1,"type":"array"}],"default":"scene_changes"},"look":{"enum":["flash","light_leak"],"type":"string"}},"required":["look"],"type":"object"},{"type":"null"}]},"v":{"const":1,"type":"number"}},"required":["v","source_run_id","timebase","duration_frames","shots"],"type":"object"},"run_id":{"description":"The run to revise: a succeeded make_faceless run, an original or a revision.","pattern":"^run_[a-zA-Z0-9]+$","type":"string"}},"required":["run_id"],"type":"object"},"name":"quote_revision","title":"Quote a revision of a run"}
