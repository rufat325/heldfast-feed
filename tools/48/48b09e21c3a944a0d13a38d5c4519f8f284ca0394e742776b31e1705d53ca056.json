{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "generate:video"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Remove an actor"
 },
 "description": "Preview the exact actor for approval, then with confirm: true revoke future use. Pass the original actorVersion, the concrete expectedSelectionVersion from soclo_actors_current and a stable clientRequestId. Free. Delayed private cleanup preserves in-flight jobs.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "actorId": {
    "description": "The owned actor id, from soclo_actors_list.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "actorVersion": {
    "description": "The owned actor\u2019s current actorVersion, from soclo_actors_list.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "description": "Approve the free preview before true. Stops future use; private cleanup preserves in-flight work.",
    "type": "boolean"
   },
   "expectedSelectionVersion": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "The concrete current selectionVersion, from soclo_actors_current; preserve it with the original request on retries."
   }
  },
  "required": [
   "actorId",
   "actorVersion",
   "clientRequestId",
   "expectedSelectionVersion"
  ],
  "type": "object"
 },
 "name": "soclo_actors_remove",
 "title": "Remove an actor"
}
