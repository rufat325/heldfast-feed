{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Add items to an intake"
 },
 "description": "Add new items to an already-sent intake \u2014 for example, when you realise mid-project that you also need a favicon, social media assets, or additional credentials.\n\nThe client is notified about the new items. Existing items and their submitted values are not affected. Returns the updated intake object.\n\nItems must follow the same key/type/label rules as define_intake (snake_case keys, type-specific constraints).",
 "inputSchema": {
  "properties": {
   "intake_id": {
    "description": "Intake ID returned by define_intake.",
    "type": "string"
   },
   "items": {
    "description": "New items to add. Same schema as define_intake items.",
    "items": {
     "properties": {
      "constraints": {
       "type": "object"
      },
      "help": {
       "type": "string"
      },
      "key": {
       "description": "snake_case key, unique within the intake.",
       "type": "string"
      },
      "label": {
       "description": "Human-readable label shown to the client.",
       "type": "string"
      },
      "options": {
       "items": {
        "type": "object"
       },
       "type": "array"
      },
      "pattern": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      },
      "schema": {
       "type": "object"
      },
      "type": {
       "enum": [
        "text",
        "longtext",
        "file",
        "file_list",
        "image",
        "color_list",
        "select",
        "multiselect",
        "boolean",
        "url",
        "secret",
        "structured"
       ],
       "type": "string"
      }
     },
     "required": [
      "key",
      "type",
      "label"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "intake_id",
   "items"
  ],
  "type": "object"
 },
 "name": "add_items",
 "outputSchema": {
  "properties": {
   "folder_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "follow_up": {
    "description": "How to learn this intake is done \u2014 present unless a webhook already covers it. Mirrors FollowUpAdvice in client.ts.",
    "properties": {
     "reason": {
      "type": "string"
     },
     "recommended": {
      "enum": [
       "webhook",
       "schedule"
      ],
      "type": "string"
     },
     "schedule": {
      "properties": {
       "check_with": {
        "type": "string"
       },
       "every_hours": {
        "type": "number"
       },
       "until": {
        "type": "string"
       }
      },
      "type": "object"
     },
     "webhook": {
      "properties": {
       "active_endpoints": {
        "type": "number"
       },
       "events": {
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "register_with": {
        "type": "string"
       }
      },
      "type": "object"
     }
    },
    "type": "object"
   },
   "intake_id": {
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "key": {
       "type": "string"
      },
      "status": {
       "enum": [
        "pending",
        "submitted",
        "needs_revision",
        "approved"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "portal_url": {
    "type": "string"
   },
   "status": {
    "enum": [
     "draft",
     "sent",
     "in_progress",
     "completed",
     "archived"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Add items to an intake"
}
