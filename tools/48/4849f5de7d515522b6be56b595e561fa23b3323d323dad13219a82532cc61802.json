{
 "description": "Update a Rolli Agent run's metadata (rename or pin). At least one of pinned or label is required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Run UUID",
    "format": "uuid",
    "type": "string"
   },
   "label": {
    "description": "Custom label (e.g., \"Weekly trend report\")",
    "type": "string"
   },
   "pinned": {
    "description": "Pin or unpin the run",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_agent_run"
}
