{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Troubleshoot a PayRam problem"
 },
 "description": "Something is not working? Describe the problem in plain words and/or paste the error or log text. Returns the known PayRam problems it matches, what each usually means, how to confirm it and the fix, plus which tool to use next. Needs no credentials and no access to the server; what you paste is not stored. Call with nothing to list known problems. For a live check of a running server use payram_doctor.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "area": {
    "description": "Narrow the search to one area.",
    "enum": [
     "install",
     "network",
     "ssl",
     "config",
     "payments",
     "deposits",
     "sweeps",
     "webhooks",
     "api",
     "operations",
     "apps"
    ],
    "type": "string"
   },
   "id": {
    "description": "Show one known problem by its id (from an earlier answer).",
    "maxLength": 80,
    "type": "string"
   },
   "output": {
    "description": "Error text or log lines to match. Remove API keys, tokens, passwords and seed phrases first.",
    "maxLength": 20000,
    "type": "string"
   },
   "symptom": {
    "description": "The problem in plain words, e.g. \"payment link opens localhost\" or \"502 after upgrade\".",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "payram_troubleshoot",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "gather": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "index": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "area": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "area",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matches": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "area": {
       "type": "string"
      },
      "confidence": {
       "enum": [
        "likely",
        "possible",
        "listed"
       ],
       "type": "string"
      },
      "confirm": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "fix": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "type": "string"
      },
      "meaning": {
       "type": "string"
      },
      "needsHuman": {
       "type": "string"
      },
      "nextTools": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "paste": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "area",
      "title",
      "confidence",
      "meaning",
      "confirm",
      "fix",
      "nextTools"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "warning": {
    "type": "string"
   }
  },
  "required": [
   "matches"
  ],
  "type": "object"
 },
 "title": "Troubleshoot a PayRam problem"
}
