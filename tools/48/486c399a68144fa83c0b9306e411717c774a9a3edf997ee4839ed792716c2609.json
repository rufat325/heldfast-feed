{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read one answer's full text and citations using the id and executedAt returned by Answers.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "brandSlug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "executedAt": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d\\.\\d{6}(?:Z))$",
    "type": "string"
   },
   "id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "marketId": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "brandSlug",
   "marketId",
   "id",
   "executedAt"
  ],
  "type": "object"
 },
 "name": "parse_dashboard_answer",
 "securitySchemes": [
  {
   "scopes": [
    "parse:dashboard:read",
    "user:org:read"
   ],
   "type": "oauth2"
  }
 ]
}
