{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Deterministically resolve a folder and create a review link for every CONVERTED video (POST /video-review/{id}?action=link). dry_run=true (default) previews the links that would be created.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "allow_comment": {
    "default": true,
    "description": "Allow reviewers to comment",
    "type": "boolean"
   },
   "allow_status_edit": {
    "default": false,
    "description": "Allow reviewers to change status",
    "type": "boolean"
   },
   "dry_run": {
    "default": true,
    "description": "true = preview only; false = create",
    "type": "boolean"
   },
   "expires_at": {
    "default": 0,
    "description": "Expiry as a Unix timestamp (0 = never)",
    "type": "integer"
   },
   "folder_ref": {
    "description": "Folder name, ID, or dashboard URL",
    "type": "string"
   },
   "idempotency_key": {
    "description": "Reserved client-supplied retry key",
    "type": "string"
   },
   "link_name": {
    "description": "Name applied to each review link",
    "minLength": 1,
    "type": "string"
   },
   "show_resolved": {
    "default": true,
    "description": "Show resolved comments",
    "type": "boolean"
   }
  },
  "required": [
   "folder_ref",
   "link_name"
  ],
  "type": "object"
 },
 "name": "panda_action_create_review_link_for_folder",
 "title": "Create Review Links for Folder"
}
