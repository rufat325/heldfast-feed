{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false},"description":"The record's documents and lists: view the context digest; update, condense, snapshot or history the context documents; next_steps (by nextStepAction) and constraints (by constraintAction); search decisions, learnings and missions. search needs query; snapshot requires source; condense applies unless dryRun=true. New next steps and constraints come from rbook_session capture.","inputSchema":{"additionalProperties":false,"properties":{"action":{"enum":["view","update","condense","snapshot","history","next_steps","constraints","search"],"type":"string"},"arrayUpdates":{"description":"Append to arrays","properties":{"constraints":{"items":{"type":"string"},"type":"array"},"context_notes":{"items":{"type":"string"},"type":"array"}},"type":"object"},"carryToSprint":{"description":"An existing sprint; omit to park","type":"string"},"compact":{"description":"view: default true; false adds both documents and every row","type":"boolean"},"constraintAction":{"enum":["list","review","archive","reaffirm"],"type":"string"},"constraintId":{"description":"reaffirm: id; resets its age","minimum":1,"type":"integer"},"constraintIds":{"description":"archive: ids","items":{"minimum":1,"type":"integer"},"type":"array"},"constraintStatus":{"description":"list: default active","enum":["active","archived","expired"],"type":"string"},"contextType":{"description":"Default master_context, except view/history","enum":["master_context","project_context","project_identity"],"type":"string"},"dryRun":{"description":"condense: preview only","type":"boolean"},"evergreen":{"description":"Never shown as past the review age","type":"boolean"},"fieldUpdates":{"description":"[{path, value}]","items":{"properties":{"path":{"type":"string"},"value":{"type":["string","number","boolean","object","array","null"]}},"required":["path","value"],"type":"object"},"type":"array"},"missionId":{"d