     },
     "type": "object"
    },
    "type": "array"
   },
   "locale": {
    "enum": [
     "tr",
     "en",
     "ru",
     "de",
     "ar"
    ],
    "type": "string"
   },
   "localeFallback": {
    "description": "True when at least one link opens a page in another language than requested.",
    "type": "boolean"
   },
   "metricType": {
    "type": "string"
   },
   "missing": {
    "type": "number"
   },
   "missingIds": {
    "description": "One NOT_FOUND entry per requested reference that names no public listing.",
    "items": {
     "properties": {
      "code": {
       "enum": [
        "NOT_FOUND"
       ],
       "type": "string"
      },
      "found": {
       "enum": [
        false
       ],
       "type": "boolean"
      },
      "requested": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "retryable": {
