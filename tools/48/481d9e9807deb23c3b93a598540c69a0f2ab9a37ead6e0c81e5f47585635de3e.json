{
 "description": "Edit a single carousel card on a post by its 1-based index. Provide title and/or body to update. Set rerender=true to regenerate the visual asset.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Card body text",
    "type": "string"
   },
   "cardIndex": {
    "description": "1-based card index (1 = first card)",
    "minimum": 1,
    "type": "integer"
   },
   "number": {
    "description": "Card number label",
    "type": "string"
   },
   "postId": {
    "description": "Post ID",
    "type": "string"
   },
   "rerender": {
    "default": false,
    "description": "Regenerate visual assets after edit",
    "type": "boolean"
   },
   "title": {
    "description": "Card title",
    "type": "string"
   }
  },
  "required": [
   "postId",
   "cardIndex"
  ],
  "type": "object"
 },
 "name": "edit_post_card"
}
