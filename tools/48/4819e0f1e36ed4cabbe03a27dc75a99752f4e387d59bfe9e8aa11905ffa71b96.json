{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Event history of a project, portfolio or goal (relative pagination: pass the last event id as \"from\" or focus with \"selected\").",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "direction": {
    "enum": [
     "forward",
     "backward"
    ],
    "type": "string"
   },
   "entityId": {
    "type": "string"
   },
   "entityType": {
    "description": "Entity type: \"project\", \"portfolio\" or \"goal\"",
    "enum": [
     "project",
     "portfolio",
     "goal"
    ],
    "type": "string"
   },
   "from": {
    "description": "Show events after this event id (exclusive)",
    "type": "string"
   },
   "newEventsOnTop": {
    "type": "boolean"
   },
   "perPage": {
    "type": "number"
   },
   "selected": {
    "description": "Show a window around this event id (not combinable with \"from\")",
    "type": "string"
   }
  },
  "required": [
   "entityType",
   "entityId"
  ],
  "type": "object"
 },
 "name": "get_entity_events"
}
