{
 "description": "Analyze whether a support ticket is ready to escalate to L2. Returns a readiness score (0-100), dimensional breakdown, predicted L2 questions, and missing items.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ticket_content": {
    "description": "The support ticket notes to evaluate for L2 escalation readiness",
    "maxLength": 20000,
    "minLength": 10,
    "type": "string"
   }
  },
  "required": [
   "ticket_content"
  ],
  "type": "object"
 },
 "name": "check_escalation_readiness",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dimensions": {
    "additionalProperties": false,
    "properties": {
     "billing_defensibility": {
      "additionalProperties": false,
      "properties": {
       "note": {
        "type": "string"
       },
       "score": {
        "type": "number"
       }
      },
      "required": [
       "score",
       "note"
      ],
      "type": "object"
     },
     "business_impact": {
      "additionalProperties": false,
      "properties": {
       "note": {
        "type": "string"
       },
       "score": {
        "type": "number"
       }
      },
      "required": [
       "score",
       "note"
      ],
      "type": "object"
     },
     "next_action": {
      "additionalProperties": false,
      "properties": {
       "note": {
        "type": "string"
       },
       "score": {
        "type": "number"
       }
      },
      "required": [
       "score",
       "note"
      ],
      "type": "object"
     },
     "problem_clarity": {
      "additionalProperties": false,
      "properties": {
       "note": {
        "type": "string"
       },
       "score": {
        "type": "number"
       }
      },
      "required": [
       "score",
       "note"
      ],
      "type": "object"
     },
     "troubleshooting_evidence": {
      "additionalProperties": false,
      "properties": {
       "note": {
        "type": "string"
       },
       "score": {
        "type": "number"
       }
      },
      "required": [
       "score",
       "note"
      ],
      "type": "object"
     }
    },
    "required": [
     "problem_clarity",
     "troubleshooting_evidence",
     "business_impact",
     "next_action",
     "billing_defensibility"
    ],
    "type": "object"
   },
   "missing_items": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "overall_score": {
    "type": "number"
   },
   "predicted_l2_questions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "readiness": {
    "enum": [
     "not_ready",
     "borderline",
     "ready"
    ],
    "type": "string"
   }
  },
  "required": [
   "overall_score",
   "readiness",
   "dimensions",
   "predicted_l2_questions",
   "missing_items"
  ],
  "type": "object"
 },
 "title": "Check escalation readiness"
}
