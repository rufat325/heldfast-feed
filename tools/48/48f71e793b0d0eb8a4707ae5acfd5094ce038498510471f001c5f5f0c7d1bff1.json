{
 "description": "Query logged events with filters. Returns recent logs matching criteria.",
 "inputSchema": {
  "properties": {
   "agent_id": {
    "description": "Filter by agent ID",
    "type": "string"
   },
   "event_type": {
    "description": "Filter by event type",
    "type": "string"
   },
   "from_date": {
    "description": "Start date (ISO 8601 format)",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results (default: 10, max: 100)",
    "type": "number"
   },
   "severity": {
    "description": "Filter by severity level",
    "type": "string"
   },
   "to_date": {
    "description": "End date (ISO 8601 format)",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "query_logs"
}
