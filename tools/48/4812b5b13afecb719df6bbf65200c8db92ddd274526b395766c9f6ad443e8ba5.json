{
 "description": "Compare two already-recorded outcomes for the same tenant task using durable proof. This does not run a model or replay customer content; it returns complete or insufficient_evidence.",
 "inputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "anyOf": [
      {
       "required": [
        "source_decision_id"
       ]
      },
      {
       "required": [
        "workspace_binding_id"
       ]
      },
      {
       "required": [
        "constraints"
       ]
      },
      {
       "required": [
        "baseline"
       ]
      },
      {
       "required": [
        "candidate"
       ]
      }
     ]
    },
    "required": [
     "comparison_id"
    ]
   },
   {
    "not": {
     "required": [
      "comparison_id"
     ]
    },
    "required": [
     "source_decision_id",
     "baseline",
     "candidate"
    ]
   }
  ],
  "properties": {
   "baseline": {
    "additionalProperties": false,
    "maxProperties": 2,
    "properties": {
     "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "label": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,80}$",
      "type": "string"
     }
    },
    "required": [
     "decision_id"
    ],
    "type": "object"
   },
   "candidate": {
    "additionalProperties": false,
    "maxProperties": 2,
    "properties": {
     "decision_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "label": {
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._:-]{1,80}$",
      "type": "string"
     }
    },
    "required": [
     "decision_id"
    ],
    "type": "object"
   },
   "comparison_id": {
    "description": "Fetch a prior replay comparison by id.",
    "minLength": 1,
    "type": "string"
   },
   "constraints": {
    "additionalProperties": false,
    "description": "Allowlisted comparison labels only; prompts, code, transcripts, credentials, and nested content are rejected.",
    "maxProperties": 7,
    "properties": {
     "environment": {
      "maxLength": 80,
      "type": "string"
     },
     "policy_profile_id": {
      "maxLength": 80,
      "type": "string"
     },
     "required_proof": {
      "type": "boolean"
     },
     "same_workspace": {
      "type": "boolean"
     },
     "task_type": {
      "maxLength": 80,
      "type": "string"
     },
     "tests": {
      "maxLength": 80,
      "type": "string"
     },
     "workflow_type": {
      "maxLength": 80,
      "type": "string"
     }
    },
    "type": "object"
   },
   "source_decision_id": {
    "description": "Original task decision used to bind the comparison.",
    "maxLength": 128,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "workspace_binding_id": {
    "description": "Optional privacy-safe workspace binding from runtime.",
    "maxLength": 34,
    "minLength": 34,
    "pattern": "^workspace_[a-f0-9]{24}$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "marrow_replay_compare"
}
