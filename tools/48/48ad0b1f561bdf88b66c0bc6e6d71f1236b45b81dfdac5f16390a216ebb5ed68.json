{
 "description": "Get EU legal basis for a specific provision. For statute-level EU references, use get_eu_basis instead.",
 "inputSchema": {
  "properties": {
   "provision_ref": {
    "description": "Provision reference (e.g., \"1:1\" or \"3:5\")",
    "minLength": 1,
    "type": "string"
   },
   "sfs_number": {
    "description": "SFS number (e.g., \"2018:218\")",
    "pattern": "^\\d{4}:\\d+$",
    "type": "string"
   }
  },
  "required": [
   "sfs_number",
   "provision_ref"
  ],
  "type": "object"
 },
 "name": "get_provision_eu_basis"
}
