{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false,
  "title": "Create Customer"
 },
 "description": "Create a customer with name, contacts, address, optional externalId. Returns {success, id}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address_city": {
    "description": "City",
    "type": "string"
   },
   "address_region": {
    "description": "Region/state",
    "type": "string"
   },
   "address_text": {
    "description": "Full address as free text",
    "type": "string"
   },
   "email": {
    "description": "Customer email",
    "type": "string"
   },
   "external_id": {
    "description": "External system ID for linking",
    "type": "string"
   },
   "first_name": {
    "description": "Customer first name",
    "type": "string"
   },
   "last_name": {
    "description": "Customer last name",
    "type": "string"
   },
   "patronymic": {
    "description": "Customer patronymic (middle name)",
    "type": "string"
   },
   "phones": {
    "description": "Array of phone numbers",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "site": {
    "description": "Site (store) symbolic code. Required on create/edit when the API key is scoped to multiple sites (see list_sites).",
    "type": "string"
   }
  },
  "required": [
   "first_name"
  ],
  "type": "object"
 },
 "name": "create_customer"
}
