      },
      "slug": {
       "type": "string"
      },
      "snippet": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "kind",
      "title",
      "url",
      "snippet"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
