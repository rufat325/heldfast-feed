{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Additively merge an edit fragment into an existing diagram. Existing elements are never moved, resized, or deleted. addNodes/addEdges append; updateNodes patches only the non-reflow allowlist (strokeColor, backgroundColor, fillStyle, label). This is the APPEND-ONLY / safe path; to MOVE, resize, restyle-by-id, or DELETE existing elements, use patch_elements instead (edit_diagram will 422 on those). Returns the added/updated ids and merged count. A subsequent read_diagram reflects the change immediately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addEdges": {
    "description": "edges to append between existing or newly added node ids",
    "items": {
     "properties": {
      "arrowhead": {
       "anyOf": [
        {
         "enum": [
          "arrow",
          "triangle"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "from": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "to": {
       "type": "string"
      }
     },
     "required": [
      "from",
      "to"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "addNodes": {
    "description": "nodes to append without moving or replacing existing elements",
    "items": {
     "properties": {
      "backgroundColor": {
       "type": "string"
      },
      "fillStyle": {
       "enum": [
        "hachure",
        "cross-hatch",
        "solid",
        "zigzag"
       ],
       "type": "string"
      },
      "group": {
       "type": "string"
      },
      "height": {
       "type": "number"
      },
      "icon": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "shape": {
       "enum": [
        "rectangle",
        "ellipse",
        "diamond",
        "text"
       ],
       "type": "string"
      },
      "strokeColor": {
       "type": "string"
      },
      "width": {
       "type": "number"
      },
      "x": {
       "type": "number"
      },
      "y": {
       "type": "number"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "id": {
    "description": "diagram id returned by a create/list/read operation or copied from its editor URL",
    "type": "string"
   },
   "updateNodes": {
    "description": "non-layout node field updates keyed by existing node id",
    "items": {
     "additionalProperties": false,
     "properties": {
      "backgroundColor": {
       "type": "string"
      },
      "fillStyle": {
       "enum": [
        "hachure",
        "cross-hatch",
        "solid",
        "zigzag"
       ],
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "strokeColor": {
       "type": "string"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "edit_diagram",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "added": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "merged": {
    "type": "number"
   },
   "updated": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "added",
   "updated",
   "merged"
  ],
  "type": "object"
 },
 "title": "Edit a diagram (additive merge)"
}
