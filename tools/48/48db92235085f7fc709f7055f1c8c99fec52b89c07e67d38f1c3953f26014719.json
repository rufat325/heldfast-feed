{
 "description": "Structured multi-filter company search across registry, geography, sector, size, financials, credit/distress, sanctions, NIS2 and cyber exposure, digital footprint (including `tech=` for a named technology such as PrestaShop or CookieYes) and public money. Returns a paginated list with a per-country breakdown. Totals are capped at 5000 \u2014 `pagination.isCapped` says when the real number is higher. Check `data.unknownFilters` in the response: any key listed there was DROPPED, so the result is wider than you asked for. Use for analyst-style queries like 'active SK e-shops on PrestaShop with turnover over \u20ac1M and no consent platform detected'.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "active": {
    "description": "Registry active flag (NOT is_active)",
    "type": "boolean"
   },
   "contracts_min": {
    "description": "Minimum contract count",
    "type": "integer"
   },
   "country": {
    "description": "Alias for country_code. ISO 3166-1 alpha-2, e.g. 'SK'.",
    "type": "string"
   },
   "country_code": {
    "description": "ISO 3166-1 alpha-2, comma-separated for several markets, e.g. 'SK,CZ'",
    "type": "string"
   },
   "credit_grade": {
    "description": "Comma-separated grade letters, e.g. 'A,B'",
    "type": "string"
   },
   "credit_score_max": {
    "type": "integer"
   },
   "credit_score_min": {
    "type": "integer"
   },
   "cyber_score_min": {
    "type": "integer"
   },
   "district": {
    "type": "string"
   },
   "employee_max": {
    "description": "Maximum headcount (NOT employees_max)",
    "type": "integer"
   },
   "employee_min": {
    "description": "Minimum headcount (NOT employees_min)",
    "type": "integer"
   },
   "employee_size": {
    "description": "Employee size-band code",
    "type": "string"
   },
   "entity_type": {
    "description": "Comma-separated also accepted. Natural persons are gated out of results anyway.",
    "enum": [
     "legal_entity",
     "self_employed",
     "npo",
     "public_body",
     "other"
    ],
    "type": "string"
   },
   "established_from": {
    "description": "Founded on or after, ISO date YYYY-MM-DD",
    "type": "string"
   },
   "established_to": {
    "description": "Founded on or before, ISO date YYYY-MM-DD",
    "type": "string"
   },
   "eu_funds_min": {
    "description": "Minimum EU funds received, EUR",
    "type": "number"
   },
   "has_contracts": {
    "description": "Has public procurement contracts",
    "type": "boolean"
   },
   "has_critical_cves": {
    "type": "boolean"
   },
   "has_cves": {
    "type": "boolean"
   },
   "has_email": {
    "type": "boolean"
   },
   "has_financials": {
    "type": "boolean"
   },
   "has_offshore_link": {
    "type": "boolean"
   },
   "has_phone": {
    "type": "boolean"
   },
   "has_rpvs": {
    "description": "SK register of public-sector partners",
    "type": "boolean"
   },
   "has_tax_debt": {
    "type": "boolean"
   },
   "has_tech": {
    "description": "Any detected technology at all",
    "type": "boolean"
   },
   "has_website": {
    "type": "boolean"
   },
   "healthy": {
    "description": "Shorthand: no bankruptcy, liquidation, restructuring or tax debt",
    "type": "boolean"
   },
   "in_bankruptcy": {
    "type": "boolean"
   },
   "in_liquidation": {
    "type": "boolean"
   },
   "in_restructuring": {
    "type": "boolean"
   },
   "is_debarred": {
    "description": "Excluded from public procurement",
    "type": "boolean"
   },
   "is_sanctioned": {
    "description": "NOT 'sanctioned'",
    "type": "boolean"
   },
   "is_vat_payer": {
    "type": "boolean"
   },
   "legal_form": {
    "description": "Legal form code, e.g. '112' = s.r.o. (SK)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 50, cap 200)",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "municipality": {
    "description": "Town/city name, e.g. 'Ko\u0161ice'",
    "type": "string"
   },
   "nace": {
    "description": "Single NACE prefix match, e.g. '46'",
    "type": "string"
   },
   "nace_prefix": {
    "description": "Comma-separated NACE prefixes, e.g. '46,47'",
    "type": "string"
   },
   "nis2_in_scope": {
    "description": "NOT 'nis2_scope'",
    "type": "boolean"
   },
   "nis2_sector": {
    "type": "string"
   },
   "nis2_tier": {
    "description": "essential | important",
    "type": "string"
   },
   "nuts2": {
    "description": "NUTS-2 code",
    "type": "string"
   },
   "nuts3": {
    "description": "NUTS-3 code, e.g. 'SK042'",
    "type": "string"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "order": {
    "description": "NOT 'sort'. An unrecognised value falls back to turnover_desc silently.",
    "enum": [
     "turnover_desc",
     "turnover_asc",
     "profit_desc",
     "name_asc",
     "contracts_desc",
     "nis2_priority_desc",
     "credit_score_desc"
    ],
    "type": "string"
   },
   "profit_max": {
    "description": "Maximum annual profit in EUR",
    "type": "number"
   },
   "profit_min": {
    "description": "Minimum annual profit in EUR",
    "type": "number"
   },
   "region": {
    "description": "Region NAME only, e.g. 'Ko\u0161ick\u00fd kraj'. A NUTS code here returns zero \u2014 use nuts3.",
    "type": "string"
   },
   "ssl_invalid": {
    "type": "boolean"
   },
   "status": {
    "enum": [
     "active",
     "restructuring",
     "liquidation",
     "bankruptcy",
     "terminated"
    ],
    "type": "string"
   },
   "tech": {
    "description": "Named technology, exact match, e.g. 'PrestaShop', 'Shoptet', 'CookieYes'. An unknown name returns 400 with the full list in meta.available \u2014 ask for a wrong one once to discover what is detectable.",
    "type": "string"
   },
   "terminated_from": {
    "description": "Terminated on or after, ISO date",
    "type": "string"
   },
   "terminated_to": {
    "description": "Terminated on or before, ISO date",
    "type": "string"
   },
   "turnover_max": {
    "description": "Maximum annual turnover in EUR",
    "type": "number"
   },
   "turnover_min": {
    "description": "Minimum annual turnover in EUR",
    "type": "number"
   },
   "updated_since": {
    "description": "Only rows changed since this ISO date",
    "type": "string"
   },
   "year": {
    "description": "Financial year for period-specific figures",
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "advanced_search",
 "title": "Advanced company search"
}
