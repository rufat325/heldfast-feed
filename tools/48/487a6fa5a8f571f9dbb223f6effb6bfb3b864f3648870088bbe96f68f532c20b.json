{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Synthesize supplied findings into an offline defensive review plan and executable local follow-up calls. triage orders all findings by urgency; posture selects TLS/header hardening; coverage selects inspection/version gaps and observed-service review. Versioned products retain host/product/version advisory-check instructions without external executable calls. Stateless pages target 24,000 serialized bytes across both response surfaces, except one complete oversized record. Makes no external calls or active scans. For assets you own or are authorized to assess.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "findings": {
    "description": "Original findings; resubmit unchanged for stateless continuation.",
    "properties": {
     "domain": {
      "description": "Apex domain under review.",
      "type": "string"
     },
     "hosts": {
      "description": "Findings gathered from prior calls.",
      "items": {
       "description": "Per-host findings from prior tool calls.",
       "properties": {
        "addresses": {
         "description": "Resolved IPs, when known.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "certDaysUntilExpiry": {
         "description": "Days until certificate expiry, when known.",
         "type": "number"
        },
        "certValidationAuthorized": {
         "description": "Whether the certificate chain validated.",
         "type": "boolean"
        },
        "host": {
         "description": "Hostname this finding pertains to.",
         "type": "string"
        },
        "missingSecurityHeaders": {
         "description": "Audited missing security headers.",
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "openPorts": {
         "description": "Previously observed ports; never proof of vulnerability.",
         "items": {
          "type": "number"
         },
         "type": "array"
        },
        "technologies": {
         "description": "Detected products and versions for advisory review.",
         "items": {
          "description": "Detected technology and optional version.",
          "properties": {
           "name": {
            "description": "Technology name.",
            "type": "string"
           },
           "version": {
            "description": "Version when known.",
            "type": "string"
           }
          },
          "required": [
           "name"
          ],
          "type": "object"
         },
         "type": "array"
        },
        "tlsProtocol": {
         "description": "Negotiated TLS protocol, when known.",
         "type": "string"
        }
       },
       "required": [
        "host"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "registrationExpiryDays": {
      "description": "Days until domain registration expiry, when known.",
      "type": "number"
     }
    },
    "required": [
     "hosts"
    ],
    "type": "object"
   },
   "limit": {
    "default": 50,
    "description": "Requested records per collection; clamped to 50.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "priorityOffset": {
    "default": 0,
    "description": "Priority offset; use its total to keep an exhausted collection exhausted.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "suggestionOffset": {
    "default": 0,
    "description": "Suggestion offset; use its total to keep an exhausted collection exhausted.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "topic": {
    "default": "triage",
    "description": "triage: all findings; posture: TLS/headers; coverage: inspection/version evidence and observed ports.",
    "enum": [
     "triage",
     "posture",
     "coverage"
    ],
    "type": "string"
   }
  },
  "required": [
   "findings"
  ],
  "type": "object"
 },
 "name": "attacksurface_recon_guidance",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "anyOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "required": [
     "plan",
     "priorities",
     "nextToolSuggestions",
     "topic",
     "limit",
     "priorityOffset",
     "suggestionOffset",
     "nextPriorityOffset",
     "nextSuggestionOffset",
     "priorityTotal",
     "suggestionTotal",
     "priorityReturnedCount",
     "suggestionReturnedCount",
     "oversize",
     "pageInstructions",
     "truncated"
    ]
   },
   {
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "error": {
    "additionalProperties": {},
    "description": "Present when the call failed. Absent on success.",
    "properties": {
     "code": {
      "description": "JSON-RPC error code for this failure.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "data": {
      "additionalProperties": {},
      "properties": {
       "reason": {
        "description": "Machine-readable failure mode.",
        "type": "string"
       },
       "recovery": {
        "additionalProperties": {},
        "description": "Actionable next step for the caller.",
        "properties": {
         "hint": {
          "type": "string"
         }
        },
        "required": [
         "hint"
        ],
        "type": "object"
       },
       "retryable": {
        "description": "Whether retrying may succeed.",
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "message": {
      "description": "Human-readable description of what went wrong.",
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "limit": {
    "description": "Effective per-collection limit, at most 50.",
    "type": "number"
   },
   "nextPriorityOffset": {
    "description": "Next priority offset, null when exhausted.",
    "type": [
     "number",
     "null"
    ]
   },
   "nextSuggestionOffset": {
    "description": "Next suggestion offset, null when exhausted.",
    "type": [
     "number",
     "null"
    ]
   },
   "nextToolSuggestions": {
    "description": "Returned local follow-up call page.",
    "items": {
     "additionalProperties": false,
     "description": "A local follow-up tool call.",
     "properties": {
      "args": {
       "additionalProperties": {},
       "description": "Pre-filled executable tool arguments.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "reason": {
       "description": "Why this follow-up advances the defensive review.",
       "type": "string"
      },
      "toolName": {
       "description": "Registered local tool to call next.",
       "type": "string"
      }
     },
     "required": [
      "toolName",
      "reason",
      "args"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "oversize": {
    "description": "A complete single record or required metadata exceeds the byte target.",
    "type": "boolean"
   },
   "pageInstructions": {
    "description": "Continuation instructions and byte-target exceptions.",
    "type": "string"
   },
   "plan": {
    "description": "Concise topic and coverage summary; detailed findings and actions are in priorities.",
    "type": "string"
   },
   "priorities": {
    "description": "Returned priority page.",
    "items": {
     "additionalProperties": false,
     "description": "A prioritized finding.",
     "properties": {
      "action": {
       "description": "Recommended defensive action.",
       "type": "string"
      },
      "finding": {
       "description": "Observed evidence or unknown coverage.",
       "type": "string"
      },
      "severity": {
       "description": "Relative defensive review priority.",
       "enum": [
        "high",
        "medium",
        "low",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "severity",
      "finding",
      "action"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "priorityOffset": {
    "description": "Requested priority offset.",
    "type": "number"
   },
   "priorityReturnedCount": {
    "description": "Priorities returned on this page.",
    "type": "number"
   },
   "priorityTotal": {
    "description": "Selected priorities before paging.",
    "type": "number"
   },
   "suggestionOffset": {
    "description": "Requested suggestion offset.",
    "type": "number"
   },
   "suggestionReturnedCount": {
    "description": "Suggestions returned on this page.",
    "type": "number"
   },
   "suggestionTotal": {
    "description": "Selected suggestions before paging.",
    "type": "number"
   },
   "topic": {
    "description": "Selected topic; retain on continuation.",
    "enum": [
     "triage",
     "posture",
     "coverage"
    ],
    "type": "string"
   },
   "truncated": {
    "description": "Selected priorities or suggestions remain for another page.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "title": "attacksurface_recon_guidance"
}
