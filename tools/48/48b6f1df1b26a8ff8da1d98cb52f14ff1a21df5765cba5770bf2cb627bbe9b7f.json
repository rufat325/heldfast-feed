{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Spec diff between two products from a comparison table. Returns case_sizes_mm and size_variants per product. Select a_size_mm and b_size_mm for size-specific specs; unresolved values are null, never substituted with generation ranges. With no size selections, specs are generation summaries. Supports two sizes of the same model. Products also include verified buy_links.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "a": {
    "description": "First product, e.g. 'fenix 8'",
    "type": "string"
   },
   "a_size_mm": {
    "description": "First product's case size in mm, e.g. 47. Must match a recorded case size.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "b": {
    "description": "Second product, e.g. 'fenix 9'",
    "type": "string"
   },
   "b_size_mm": {
    "description": "Second product's case size in mm, e.g. 51. Must match a recorded case size.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "family": {
    "description": "Table id: flagships, running-flagships, bike-computers, hr-straps, recovery-wearables, polar-street, polar-loop, tactix, fenix, forerunner, forerunner-2xx, forerunner-entry, edge, edge-mid, varia, rally, instinct, venu, epix, enduro, vivoactive, descent, imini, quatix, marq, approach, coros-pace, coros-apex, coros-vertix, suunto-9, suunto-race, suunto-vertical, suunto-run, apple-ultra, wahoo-elemnt, wahoo-kickr, wahoo-tickr, wahoo-speedplay, wahoo-kickr-bike, polar-vantage, polar-vantage-m, polar-grit, polar-pacer, polar-ignite, polar-sensor, whoop, oura, hrm, amazfit-trex, amazfit-cheetah, amazfit-gtr, amazfit-gts, amazfit-active, amazfit-pace, amazfit-balance, amazfit-bip, forerunner-570-970, forerunner-70-170",
    "type": "string"
   }
  },
  "required": [
   "family",
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "compare_generations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "_via": {
    "description": "Source attribution for Endurance Wire",
    "type": "string"
   },
   "changed_count": {
    "type": "integer"
   },
   "comparison_scope": {
    "enum": [
     "case_sizes",
     "mixed",
     "generation_summary"
    ],
    "type": "string"
   },
   "family": {
    "type": "string"
   },
   "products": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "buy_links": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "merchant": {
          "type": "string"
         },
         "region": {
          "type": "string"
         },
         "url": {
          "format": "uri",
          "type": "string"
         }
        },
        "required": [
         "merchant",
         "region",
         "url"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "case_sizes_mm": {
       "description": "Recorded case sizes in mm; an empty list means unknown",
       "items": {
        "type": "number"
       },
       "type": "array"
      },
      "comparison_label": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "selected_case_size_mm": {
       "type": [
        "number",
        "null"
       ]
      },
      "size_data_status": {
       "enum": [
        "recorded",
        "unknown"
       ],
       "type": "string"
      },
      "size_scope_note": {
       "description": "Limits on size-specific claims",
       "type": "string"
      },
      "size_variants": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "case_size_mm": {
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "notes": {
          "additionalProperties": {
           "type": "string"
          },
          "description": "Edition, material and other qualifications",
          "type": "object"
         },
         "specs": {
          "additionalProperties": {
           "type": "string"
          },
          "description": "Verified size-specific specifications, keyed by label",
          "type": "object"
         },
         "unresolved_specs": {
          "description": "Labels with no verified size-specific value",
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "name",
         "case_size_mm",
         "specs",
         "notes",
         "unresolved_specs"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "comparison_label",
      "selected_case_size_mm",
      "case_sizes_mm",
      "size_data_status",
      "size_scope_note",
      "size_variants",
      "buy_links"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "specs": {
    "description": "Each row has values keyed by the products' comparison_label; null means unknown",
    "items": {
     "additionalProperties": {
      "type": [
       "string",
       "null"
      ]
     },
     "properties": {
      "changed": {
       "description": "Null when either value is unresolved",
       "type": [
        "boolean",
        "null"
       ]
      },
      "notes": {
       "additionalProperties": {
        "type": "string"
       },
       "type": "object"
      },
      "spec": {
       "type": "string"
      }
     },
     "required": [
      "spec",
      "changed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "unresolved_count": {
    "type": "integer"
   }
  },
  "required": [
   "_via",
   "family",
   "comparison_scope",
   "products",
   "changed_count",
   "unresolved_count",
   "specs"
  ],
  "type": "object"
 },
 "title": "Compare products and case sizes"
}
