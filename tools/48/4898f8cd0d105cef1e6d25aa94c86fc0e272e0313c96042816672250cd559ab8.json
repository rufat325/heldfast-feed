{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Create a connector (Object Storage sink) for a Data Stream topic. Only one connector per topic. Use dryRun=true to preview.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "consumerSpec": {
    "description": "Consumer spec: SMALL (1 container, 250KB/s per partition) or MEDIUM (2 containers, 500KB/s per partition)",
    "enum": [
     "SMALL",
     "MEDIUM"
    ],
    "type": "string"
   },
   "dateFormat": {
    "description": "Date format for sub-path: NONE, YEAR, MONTH, DAY, HOUR",
    "enum": [
     "NONE",
     "YEAR",
     "MONTH",
     "DAY",
     "HOUR"
    ],
    "type": "string"
   },
   "description": {
    "description": "Connector description (max 200 chars)",
    "type": "string"
   },
   "dryRun": {
    "default": false,
    "description": "If true, preview without creating",
    "type": "boolean"
   },
   "exportType": {
    "const": "OBJECT_STORAGE",
    "default": "OBJECT_STORAGE",
    "description": "Connector type (currently only OBJECT_STORAGE)",
    "type": "string"
   },
   "flushCount": {
    "description": "Messages per file (default: 5000)",
    "maximum": 50000,
    "minimum": 5000,
    "type": "number"
   },
   "flushInterval": {
    "description": "File creation interval in minutes (default: 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "includeTopicInPath": {
    "description": "Whether to create topic name directory in storage path",
    "type": "boolean"
   },
   "location": {
    "description": "Storage path in s3a://{bucket}/{path} format",
    "type": "string"
   },
   "roleNrn": {
    "description": "NRN of the Data Stream service role for connector access",
    "type": "string"
   },
   "schemaType": {
    "description": "Message value serialization (default: STRING)",
    "enum": [
     "STRING",
     "JSON",
     "AVRO",
     "PROTOBUF"
    ],
    "type": "string"
   },
   "topicId": {
    "description": "Topic ID to create connector for",
    "type": "string"
   }
  },
  "required": [
   "topicId",
   "consumerSpec",
   "location",
   "includeTopicInPath",
   "dateFormat",
   "roleNrn"
  ],
  "type": "object"
 },
 "name": "ncloud_datastream_create_connector"
}
