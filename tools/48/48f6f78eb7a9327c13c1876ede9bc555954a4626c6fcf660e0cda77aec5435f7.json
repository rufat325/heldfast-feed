 "description": "Book a transaction to a chart-of-accounts account by its full path (e.g. \"expenses/software-and-subscriptions\", \"revenue/sales-revenue\"). This is the account the amount posts to, so prefer it over transaction_categorize_transaction. The booking is recorded as Lovie Agent's proposal and changes nothing until the person accepts it, so tell them it is waiting for their review. Returns proposal_id, the proposal waiting for them. List valid paths with accounting_get_chart_of_accounts.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "glAccountPath": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*(/[a-z0-9]+(-[a-z0-9]+)*)*$",
    "type": "string"
   },
   "transactionId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "transactionId",
   "companyId"
  ],
  "type": "object"
 },
 "name": "transaction_categorize_transaction_by_account",
 "outputSchema": {
  "properties": {
   "glAccountPath": {
    "type": "string"
   },
   "proposalId": {
