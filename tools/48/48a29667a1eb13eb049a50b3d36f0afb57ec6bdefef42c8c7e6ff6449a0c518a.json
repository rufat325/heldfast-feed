{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Close a task with its reported outcome and compact summary.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "outcome": {
    "enum": [
     "completed",
     "abandoned",
     "failed"
    ],
    "type": "string"
   },
   "request_id": {
    "maxLength": 120,
    "minLength": 8,
    "type": "string"
   },
   "session_id": {
    "maxLength": 80,
    "type": "string"
   },
   "summary": {
    "default": "",
    "maxLength": 500,
    "type": "string"
   }
  },
  "required": [
   "session_id",
   "request_id",
   "outcome"
  ],
  "type": "object"
 },
 "name": "close_task_session"
}
