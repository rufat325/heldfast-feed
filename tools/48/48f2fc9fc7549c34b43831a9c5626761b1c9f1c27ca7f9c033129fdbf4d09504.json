{
 "description": "Create an invoice in iugu (Pix, boleto, or credit card)",
 "inputSchema": {
  "properties": {
   "customer_id": {
    "description": "Customer ID (optional)",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (YYYY-MM-DD)",
    "type": "string"
   },
   "email": {
    "description": "Payer email address",
    "type": "string"
   },
   "items": {
    "description": "Invoice items",
    "items": {
     "properties": {
      "description": {
       "description": "Item description",
       "type": "string"
      },
      "price_cents": {
       "description": "Unit price in cents (BRL)",
       "type": "number"
      },
      "quantity": {
       "description": "Quantity",
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity",
      "price_cents"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notification_url": {
    "description": "Webhook URL for status updates",
    "type": "string"
   },
   "payable_with": {
    "description": "Payment method (default: all)",
    "enum": [
     "pix",
     "bank_slip",
     "credit_card",
     "all"
    ],
    "type": "string"
   },
   "return_url": {
    "description": "URL to redirect after payment",
    "type": "string"
   }
  },
  "required": [
   "email",
   "due_date",
   "items"
  ],
  "type": "object"
 },
 "name": "create_invoice"
}
