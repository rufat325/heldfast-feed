{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create an InfluxDB telemetry scaffold with measurement maps, field maps, query/write adapter notes, and token-safety warnings.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "adapter_mode": {
    "default": "webclient_json",
    "enum": [
     "webclient_json",
     "websocket_json",
     "manual"
    ],
    "type": "string"
   },
   "bucket": {
    "default": "show",
    "type": "string"
   },
   "endpoint_url": {
    "default": "http://127.0.0.1:8086",
    "type": "string"
   },
   "field_count": {
    "default": 8,
    "maximum": 256,
    "minimum": 1,
    "type": "integer"
   },
   "measurement_count": {
    "default": 6,
    "maximum": 128,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "influxdb_timeseries_bridge",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "org": {
    "default": "tdmcp",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the InfluxDB scaffold.",
    "type": "string"
   },
   "poll_seconds": {
    "default": 5,
    "maximum": 3600,
    "minimum": 0.25,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "connect_influxdb_timeseries_bridge",
 "title": "Connect InfluxDB time-series bridge"
}
