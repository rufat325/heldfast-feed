{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read bounded player history for public games, dedicated servers, or one game. Older aggregate points marked partialCoverage total recorded games and may omit unrecorded games.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "game": {
    "pattern": "^[a-z0-9_-]+\\.[a-z0-9_-]+$",
    "type": "string"
   },
   "kind": {
    "default": "game",
    "enum": [
     "game",
     "server"
    ],
    "type": "string"
   },
   "maxPoints": {
    "default": 100,
    "maximum": 200,
    "minimum": 10,
    "type": "integer"
   },
   "range": {
    "default": "24h",
    "enum": [
     "24h",
     "7d",
     "30d",
     "1y",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_activity_history",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "apiUrl": {
    "format": "uri",
    "type": "string"
   },
   "available": {
    "type": "boolean"
   },
   "bucketed": {
    "type": "boolean"
   },
   "canonicalUrl": {
    "format": "uri",
    "type": "string"
   },
   "durationMs": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "game": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "generation": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     }
    ]
   },
   "kind": {
    "enum": [
     "game",
     "server"
    ],
    "type": "string"
   },
   "partialCoverage": {
    "items": {
     "type": "number"
    },
    "maxItems": 200,
    "type": "array"
   },
   "points": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "aggregation": {
       "enum": [
        "average",
        "snapshot"
       ],
       "type": "string"
      },
      "capturedAt": {
       "type": "string"
      },
      "current": {
       "type": "boolean"
      },
      "partial": {
       "type": "boolean"
      },
      "partialCoverage": {
       "type": "boolean"
      },
      "players": {
       "type": "number"
      },
      "rangeEnd": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "rangeStart": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      }
     },
     "required": [
      "capturedAt",
      "players",
      "current",
      "aggregation",
      "partial"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "range": {
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "average": {
      "type": "number"
     },
     "current": {
      "type": "number"
     },
     "maximum": {
      "type": "number"
     },
     "minimum": {
      "type": "number"
     },
     "samples": {
      "type": "number"
     }
    },
    "required": [
     "samples",
     "current",
     "minimum",
     "maximum",
     "average"
    ],
    "type": "object"
   },
   "version": {
    "type": "number"
   }
  },
  "required": [
   "version",
   "generation",
   "kind",
   "range",
   "durationMs",
   "bucketed",
   "available",
   "canonicalUrl",
   "apiUrl",
   "summary",
   "points"
  ],
  "type": "object"
 },
 "title": "Get s&box player activity history"
}
