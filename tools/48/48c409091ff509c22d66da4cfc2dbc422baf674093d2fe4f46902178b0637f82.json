 "description": "Statistical observations from one ILOSTAT dataflow, filtered by dimension codes (filters, e.g. {\"REF_AREA\": [\"BRA\",\"ARG\"], \"SEX\": \"SEX_T\"}) and period (start_period/end_period, e.g. \"2015\"/\"2024\"). REF_AREA is required, maximum 30 areas per call \u2014 for broad panels, split areas into batches and/or paginate by period. Unfiltered dimensions return all their categories. Does not aggregate, convert or otherwise transform values (raw ILOSTAT data only): read each value with the unit and multiplier the ILO states in its row attributes (UNIT_MEASURE, UNIT_MULT \u2014 e.g. UNIT_MULT 3 = thousands). Does not search indicators (use ilo_search_indicators).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "dataflow": {
    "description": "Dataflow id from ilo_search_indicators (e.g. \"DF_UNE_DEAP_SEX_AGE_RT\")",
    "minLength": 1,
    "type": "string"
   },
   "end_period": {
    "description": "Last period, e.g. \"2024\"",
    "minLength": 1,
    "type": "string"
   },
   "filters": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     ]
    },
    "description": "Dimension id \u2192 code or list of codes (from ilo_list_dimension_values). REF_AREA is required (up to 30 area codes); any other dimension is optional and, left out, returns all of its categories.",
    "properties": {
     "REF_AREA": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "items": {
         "type": "string"
        },
        "minItems": 1,
        "type": "array"
       }
      ],
      "description": "Area codes \u2014 REQUIRED, at most 30 per call (e.g. [\"BRA\",\"ARG\"]). Without them the ILO gateway times out (HTTP 504). Discover codes with ilo_list_dimension_values (dimension REF_AREA)."
     }
    },
    "required": [
     "REF_AREA"
    ],
    "type": "object"
   },
   "last_n_observations": {
    "description": "Alternative to periods: only the latest N observations per series",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "provenance_mode": {
    "description": "Provenance verbosity: 'concise' (default \u2014 source, url, vintage, retrieval date, citation, license) or 'detailed' (full canonical block with dataset, dimension key and notices)",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "start_period": {
    "description": "First period, e.g. \"2015\"",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "dataflow",
   "filters"
  ],
  "type": "object"
 },
