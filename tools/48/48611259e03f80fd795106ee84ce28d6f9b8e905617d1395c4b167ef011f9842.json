{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Check up to 100 software packages or infrastructure products in a single request. Each item is billed as one API call. Use this instead of multiple check_package_vulnerability calls when you need to audit a lockfile, manifest, or dependency list. Items outside Attestd coverage return outsideCoverage=true and should be treated as unknown risk, not safe. A 429 is returned before any results are delivered if the batch would exceed your monthly quota; no calls are billed in that case.",
 "inputSchema": {
  "properties": {
   "items": {
    "description": "Products to check. Maximum 100 per call. Each item costs one API call.",
    "items": {
     "properties": {
      "product": {
       "description": "Package or product slug, e.g. \"nginx\", \"litellm\"",
       "type": "string"
      },
      "version": {
       "description": "Exact version string, e.g. \"1.20.0\"",
       "type": "string"
      }
     },
     "required": [
      "product",
      "version"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "name": "check_batch_vulnerabilities",
 "outputSchema": {
  "properties": {
   "count": {
    "description": "Number of items returned.",
    "type": "integer"
   },
   "results": {
    "items": {
     "properties": {
      "activelyExploited": {
       "type": "boolean"
      },
      "authenticationRequired": {
       "type": "boolean"
      },
      "confidence": {
       "type": "number"
      },
      "cveIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "fixedVersion": {
       "type": "string"
      },
      "maxEpss": {
       "type": "number"
      },
      "outsideCoverage": {
       "description": "True when Attestd has no CVE data for this product. Unknown risk, not safe.",
       "type": "boolean"
      },
      "patchAvailable": {
       "type": "boolean"
      },
      "product": {
       "type": "string"
      },
      "remoteExploitable": {
       "type": "boolean"
      },
      "riskFactors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "riskState": {
       "description": "Risk band: \"critical\", \"high\", \"elevated\", \"low\", \"none\", or null when outside coverage.",
       "type": "string"
      },
      "supplyChainCompromised": {
       "type": "boolean"
      },
      "supplyChainDescription": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "count",
   "results"
  ],
  "type": "object"
 }
}
