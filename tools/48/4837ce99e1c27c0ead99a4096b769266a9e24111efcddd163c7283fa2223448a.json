{
 "_meta": {
  "com.oxinsider/docs-group": "traders",
  "securitySchemes": [
   {
    "scopes": [
     "read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get Trader Leaderboard"
 },
 "description": "Get the top-ranked prediction market traders (grades S, A, B only). Sorted by composite score descending. Supports cursor pagination and optional filters.\n\nArgs:\n  - limit (number, 1-100, default 20): Max results per page\n  - cursor (string, optional): Pagination cursor from previous response\n  - category (string, optional): Filter by category slug\n  - strategy (string, optional): One of accumulator, algo_trader, arbitrageur, directional, event_driven, market_maker, momentum, scalper, speculator, swing_trader\n\nReturns: Ranked list of traders with grade, score, P&L, volume, win rate, and strategy.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Filter by category slug",
    "type": "string"
   },
   "cursor": {
    "description": "Pagination cursor from previous response",
    "type": "string"
   },
   "limit": {
    "default": 20,
    "description": "Max results (1-100, default 20)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "strategy": {
    "description": "Filter by strategy type",
    "enum": [
     "accumulator",
     "algo_trader",
     "arbitrageur",
     "directional",
     "event_driven",
     "market_maker",
     "momentum",
     "scalper",
     "speculator",
     "swing_trader"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_leaderboard",
 "outputSchema": {
  "$defs": {
   "LeaderboardEntry": {
    "properties": {
     "address": {
      "type": "string"
     },
     "grade": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "last_active": {
      "format": "date-time",
      "type": "string"
     },
     "markets_traded": {
      "type": "integer"
     },
     "platform": {
      "enum": [
       "polymarket"
      ],
      "type": "string"
     },
     "pnl": {
      "type": "number"
     },
     "realized_pnl": {
      "type": "number"
     },
     "score": {
      "type": "number"
     },
     "strategy_type": {
      "type": "string"
     },
     "streak_tier": {
      "enum": [
       "hot",
       "rising",
       "neutral",
       "cooling",
       "cold"
      ],
      "type": "string"
     },
     "username": {
      "type": "string"
     },
     "volume": {
      "type": "number"
     },
     "win_rate": {
      "type": "number"
     }
    },
    "required": [
     "id",
     "address",
     "platform"
    ],
    "type": "object"
   },
   "ResponseMeta": {
    "properties": {
     "cache_age_s": {
      "type": "integer"
     },
     "cached": {
      "type": "boolean"
     },
     "category_skill_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_enriched_base_payload_hash": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
     },
     "category_skill_model_operationally_degraded": {
      "type": "boolean"
     },
     "category_skill_model_version": {
      "type": "string"
     },
     "category_skill_observation_started_at": {
      "format": "date-time",
      "type": "string"
     },
     "category_skill_platform": {
      "const": "polymarket",
      "type": "string"
     },
     "category_skill_scope": {
      "const": "observed_goldsky_primary_taker_fill",
      "type": "string"
     },
     "category_skill_source": {
      "enum": [
       "live",
       "partial",
       "degraded",
       "unavailable"
      ],
      "type": "string"
     },
     "category_skill_source_coverage": {
      "enum": [
       "partial_whale_threshold_fills",
       "graded_wallet_fills"
      ],
      "type": "string"
     },
     "category_skill_status_counts": {
      "properties": {
       "degraded": {
        "minimum": 0,
        "type": "integer"
       },
       "insufficient": {
        "minimum": 0,
        "type": "integer"
       },
       "live": {
        "minimum": 0,
        "type": "integer"
       },
       "stale": {
        "minimum": 0,
        "type": "integer"
       },
       "unknown": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "live",
       "insufficient",
       "stale",
       "unknown",
       "degraded"
      ],
      "type": "object"
     },
     "category_skill_taxonomy_version": {
      "type": "string"
     },
     "cost": {
      "type": "integer"
     },
     "directional_source": {
      "enum": [
       "live",
       "degraded"
      ],
      "type": "string"
     },
     "ranking_as_of": {
      "format": "date-time",
      "type": "string"
     },
     "ranking_generation": {
      "type": "integer"
     },
     "ranking_source": {
      "enum": [
       "live",
       "db_only"
      ],
      "type": "string"
     },
     "request_id": {
      "type": "string"
     }
    },
    "required": [
     "request_id",
     "cached",
     "cost"
    ],
    "type": "object"
   }
  },
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "items": {
       "$ref": "#/$defs/LeaderboardEntry"
      },
      "type": "array"
     },
     "has_more": {
      "type": "boolean"
     },
     "meta": {
      "$ref": "#/$defs/ResponseMeta"
     },
     "next_cursor": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "total": {
      "type": "integer"
     }
    },
    "required": [
     "data",
     "has_more",
     "next_cursor",
     "meta"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "type": "string"
       },
       "doc_url": {
        "type": "string"
       },
       "param": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       },
       "request_id": {
        "type": "string"
       },
       "retry_after_seconds": {
        "minimum": 0,
        "type": "integer"
       },
       "retry_at": {
        "type": "string"
       },
       "status": {
        "minimum": 0,
        "type": "integer"
       }
      },
      "required": [
       "code"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get Trader Leaderboard"
}
