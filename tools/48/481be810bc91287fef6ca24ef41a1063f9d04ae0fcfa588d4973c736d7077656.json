{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Finds current empty-leg flights by origin and/or destination (city name or IATA/ICAO code), dates, passengers and budget. Returns up to 20 offers with route, date, aircraft, seats, indicative price, a voidjet link and a pre-filled inquiry link; provider names are not included. When more offers match, refine summarises all matches (frequent destinations, date span, prices). With no match, charter_alternative may contain a regular charter via partner Villiers: NOT an empty leg, and a paid partner offer.",
 "inputSchema": {
  "properties": {
   "date_from": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Earliest departure date (YYYY-MM-DD), default today.",
    "title": "Date From"
   },
   "date_to": {
    "anyOf": [
     {
      "format": "date",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Latest departure date, at most 120 days after date_from.",
    "title": "Date To"
   },
   "destination": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Arrival city or IATA/ICAO code.",
    "title": "Destination"
   },
   "limit": {
    "default": 10,
    "maximum": 20,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "de"
    ],
    "title": "Locale",
    "type": "string"
   },
   "max_price_eur": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 1000000,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Maximum price in EUR for the whole aircraft.",
    "title": "Max Price Eur"
   },
   "offset": {
    "default": 0,
    "maximum": 40,
    "minimum": 0,
    "title": "Offset",
    "type": "integer"
   },
   "origin": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Departure city or IATA/ICAO code, e.g. Nice or NCE.",
    "title": "Origin"
   },
   "passengers": {
    "anyOf": [
     {
      "maximum": 19,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Passengers"
   },
   "sort": {
    "default": "date",
    "enum": [
     "date",
     "price"
    ],
    "title": "Sort",
    "type": "string"
   }
  },
  "title": "search_empty_legsArguments",
  "type": "object"
 },
