{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search the help center"
 },
 "description": "Search the help center's articles and/or public conversations. Returns references (e.g. {id, resource_type: 'article'}); read an article with kayako_get_article. Kayako: GET /api/v1/helpcenter/search.json.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "in": {
    "description": "What to search. Default ALL.",
    "enum": [
     "ARTICLES",
     "CONVERSATIONS",
     "ALL"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Items per page, 1-100. Kayako's default is 10.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Locale, e.g. en-us.",
    "maxLength": 20,
    "type": "string"
   },
   "offset": {
    "description": "Offset into the collection (0-based). Default 0.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Search text, at least 3 characters.",
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "kayako_search_help_center",
 "title": "Search the help center"
}
