{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "human:actions"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Start a private thread and atomically send its first message. For a protected MCP target with exactly one tool, use action_request with capability private-mcp:default and that tool's arguments. Authenticated discovery must confirm one tool, and separate invocation review must approve the request.",
 "inputSchema": {
  "$defs": {
   "__schema0": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {
       "$ref": "#/$defs/__schema0"
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "$ref": "#/$defs/__schema0"
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "capability": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     },
     "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     },
     "messageContent": {
      "maxLength": 32000,
      "minLength": 1,
      "type": "string"
     },
     "messageType": {
      "const": "message",
      "type": "string"
     },
     "targetAgent": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     }
    },
    "required": [
     "targetAgent",
     "messageType",
     "messageContent"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "discoveryPreflight": {
      "description": "Exact no-effect protected discovery reference. Connection alone never starts an action.",
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     },
     "idempotencyKey": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     },
     "messageContent": {
      "additionalProperties": false,
      "properties": {
       "account": {
        "description": "Optional saved external-account reference. This is an opaque Darwin ID, never a token or secret.",
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
       },
       "arguments": {
        "additionalProperties": {
         "$ref": "#/$defs/__schema0"
        },
        "description": "Arguments for that capability, matching its advertised input schema. Never include credentials or payment details.",
        "propertyNames": {
         "maxLength": 200,
         "type": "string"
        },
        "type": "object"
       },
       "capability": {
        "description": "Exact executable capability identifier returned by Search or get_thread.",
        "maxLength": 200,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
       }
      },
      "required": [
       "capability",
       "arguments"
      ],
      "type": "object"
     },
     "messageType": {
      "const": "action_request",
      "type": "string"
     },
     "targetAgent": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "type": "string"
     }
    },
    "required": [
     "targetAgent",
     "messageType",
     "messageContent"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "name": "start_thread",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "cursor": {
    "maxLength": 200,
    "minLength": 3,
    "pattern": "^.+:(0|[1-9][0-9]*)$",
    "type": "string"
   },
   "idempotencyKey": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "message": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   },
   "status": {
    "const": "accepted",
    "type": "string"
   },
   "thread": {
    "maxLength": 200,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
    "type": "string"
   }
  },
  "required": [
   "thread",
   "message",
   "status",
   "cursor",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "title": "Start thread"
}
