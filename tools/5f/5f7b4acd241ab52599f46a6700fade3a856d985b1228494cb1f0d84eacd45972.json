{
 "description": "Get one agreement document: draft revision (pass it as expectedRevision to the next write), source upload status and sha256, field count and fieldsHash, and the current published version. Requires agreements:read. Requires the agreements family flag and the agreements_native rollout; denials carry details.reason (AGENT_SURFACE_DISABLED, AGREEMENTS_DISABLED, TENANT_ACCESS_DENIED).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "documentId": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "documentId"
  ],
  "type": "object"
 },
 "name": "opentrain_agreements_documents_get",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "document": {
      "additionalProperties": false,
      "properties": {
       "createdAt": {
        "$ref": "#/properties/result/properties/document/properties/currentVersion/anyOf/0/properties/publishedAt"
       },
       "currentVersion": {
        "anyOf": [
         {
          "additionalProperties": false,
          "properties": {
           "publishedAt": {
            "format": "date-time",
            "type": "string"
           },
           "versionId": {
            "$ref": "#/properties/result/properties/document/properties/documentId"
           },
           "versionNumber": {
            "minimum": 1,
            "type": "integer"
           }
          },
          "required": [
           "versionId",
           "versionNumber",
           "publishedAt"
          ],
          "type": "object"
         },
         {
          "type": "null"
         }
        ]
       },
       "description": {
        "anyOf": [
         {
          "maxLength": 2000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "documentId": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "draftRevision": {
        "minimum": 0,
        "type": "integer"
       },
       "fields": {
        "additionalProperties": false,
        "properties": {
         "count": {
          "minimum": 0,
          "type": "integer"
         },
         "fieldsHash": {
          "anyOf": [
           {
            "$ref": "#/properties/result/properties/document/properties/source/properties/sha256/anyOf/0"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "count",
         "fieldsHash"
        ],
        "type": "object"
       },
       "key": {
        "maxLength": 64,
        "minLength": 1,
        "type": "string"
       },
       "source": {
        "additionalProperties": false,
        "properties": {
         "fileName": {
          "anyOf": [
           {
            "maxLength": 255,
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "sha256": {
          "anyOf": [
           {
            "pattern": "^[0-9a-f]{64}$",
            "type": "string"
           },
           {
            "type": "null"
           }
          ]
         },
         "status": {
          "enum": [
           "NONE",
           "PENDING",
           "READY"
          ],
          "type": "string"
         }
        },
        "required": [
         "status",
         "fileName",
         "sha256"
        ],
        "type": "object"
       },
       "sourceKind": {
        "enum": [
         "EDITOR",
         "PDF_UPLOAD",
         "MARKDOWN",
         "HTML",
         "DOCX_EDITABLE",
         "DOCX_LAYOUT"
        ],
        "type": "string"
       },
       "title": {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       "updatedAt": {
        "$ref": "#/properties/result/properties/document/properties/currentVersion/anyOf/0/properties/publishedAt"
       }
      },
      "required": [
       "documentId",
       "key",
       "title",
       "description",
       "sourceKind",
       "draftRevision",
       "source",
       "fields",
       "currentVersion",
       "createdAt",
       "updatedAt"
      ],
      "type": "object"
     }
    },
    "required": [
     "document"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
