{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search Serato tracks"
 },
 "description": "Search the Serato library. Free text `q` matches every whitespace-separated token against title, artist, album, genre and comments. Tonality is Camelot (`8A`); tracks whose key Serato itself could not parse are included, and `key_source` says where each key came from. `bpm.around` cannot be combined with `bpm.min`/`bpm.max`. `key.compatible_with` expands to the four mixable cells of the wheel. `rating` is a 0 to 1 scale, not 0 to 5 stars. Sort is one of bpm, added, artist, title, rating, relevance with an optional :asc/:desc; relevance needs a q. Default fields: id, artist, title, bpm, key, key_source, genre, rating, length. Paths are redacted to ~.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "added": {
    "properties": {
     "after": {
      "type": "string"
     },
     "before": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "bpm": {
    "properties": {
     "around": {
      "type": "number"
     },
     "max": {
      "type": "number"
     },
     "min": {
      "type": "number"
     },
     "tolerance_pct": {
      "maximum": 50,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "crate": {
    "properties": {
     "id": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "name": {
      "maxLength": 256,
      "type": "string"
     }
    },
    "type": "object"
   },
   "cursor": {
    "maxLength": 4096,
    "type": "string"
   },
   "fields": {
    "items": {
     "type": "string"
    },
    "maxItems": 17,
    "minItems": 1,
    "type": "array"
   },
   "flags": {
    "properties": {
     "analyzed": {
      "type": "boolean"
     },
     "missing": {
      "type": "boolean"
     },
     "streaming": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "genre": {
    "maxLength": 256,
    "type": "string"
   },
   "key": {
    "properties": {
     "camelot": {
      "items": {
       "type": "string"
      },
      "maxItems": 24,
      "minItems": 1,
      "type": "array"
     },
     "compatible_with": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "q": {
    "maxLength": 512,
    "type": "string"
   },
   "rating": {
    "properties": {
     "max": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "min": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "sort": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_tracks",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "generation": {
    "type": "string"
   },
   "next_cursor": {
    "type": "string"
   },
   "tracks": {
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "warnings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "details": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "message": {
       "type": "string"
      }
     },
     "required": [
      "code",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "tracks",
   "generation"
  ],
  "type": "object"
 },
 "title": "Search Serato tracks"
}
