{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a task"
 },
 "description": "Update a task \u2014 change its status (e.g. completed), reassign it, move its window, or add a resolution note. Send only the fields to change. Hostaway: PUT /v1/tasks/{taskId}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assigneeUserId": {
    "description": "User id to assign the task to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "canStartFrom": {
    "description": "Earliest start time (\"YYYY-MM-DD HH:MM:SS\", UTC).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}(:\\d{2})?)?$",
    "type": "string"
   },
   "categoriesMap": {
    "description": "Categories: 1 cleaning, 2 maintenance, 3 check-in, 4 check-out, 5 back office, 6 other.",
    "items": {
     "maximum": 6,
     "minimum": 1,
     "type": "integer"
    },
    "type": "array"
   },
   "color": {
    "description": "Colour in hex, e.g. #FF8800.",
    "pattern": "^#[0-9a-fA-F]{6}$",
    "type": "string"
   },
   "cost": {
    "description": "Task cost.",
    "type": "number"
   },
   "costCurrency": {
    "description": "Cost currency, e.g. USD.",
    "type": "string"
   },
   "costDescription": {
    "description": "Cost description.",
    "type": "string"
   },
   "description": {
    "description": "Task description.",
    "type": "string"
   },
   "listingMapId": {
    "description": "Listing id the task belongs to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "priority": {
    "description": "Priority.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "reservationId": {
    "description": "Reservation id the task relates to.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "resolutionNote": {
    "description": "Resolution note.",
    "type": "string"
   },
   "shouldEndBy": {
    "description": "Deadline (\"YYYY-MM-DD HH:MM:SS\", UTC).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}( \\d{2}:\\d{2}(:\\d{2})?)?$",
    "type": "string"
   },
   "status": {
    "description": "pending, confirmed, inProgress, completed or cancelled.",
    "enum": [
     "pending",
     "confirmed",
     "inProgress",
     "completed",
     "cancelled"
    ],
    "type": "string"
   },
   "supervisorUserId": {
    "description": "Supervisor user id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "taskId": {
    "description": "Task id.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "title": {
    "description": "Task title.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "taskId"
  ],
  "type": "object"
 },
 "name": "hostaway_update_task",
 "title": "Update a task"
}
