{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search and filter traces in experiments",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "experimentIds": {
    "description": "Experiment IDs (defaults to MLFLOW_EXPERIMENT_ID)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "extractFields": {
    "description": "Comma-separated dotted paths with `*` wildcard, e.g. \"traces.*.trace_id\".",
    "type": "string"
   },
   "filter": {
    "description": "Filter expression, e.g. \"tags.user = 'alice'\"",
    "type": "string"
   },
   "maxResults": {
    "default": 100,
    "description": "Max results per page (default 100). MLflow 3.12+ server-side cap = 500; use pageToken to paginate beyond.",
    "type": "number"
   },
   "orderBy": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageToken": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search-traces"
}
