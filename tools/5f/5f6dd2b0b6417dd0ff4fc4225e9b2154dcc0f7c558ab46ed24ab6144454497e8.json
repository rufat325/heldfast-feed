{
 "_meta": {
  "openai/outputTemplate": "ui://polyblog/article-preview-v1.html",
  "openai/toolInvocation/invoked": "Polyblog article preview ready.",
  "openai/toolInvocation/invoking": "Loading Polyblog article\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "polyblog:read"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://polyblog/article-preview-v1.html"
  },
  "ui/resourceUri": "ui://polyblog/article-preview-v1.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Preview a blog post"
 },
 "description": "Use this when someone wants to see how one blog post looks, with its status and details. Returns a preview card with the post's title, language, published state, metadata and up to 6,000 characters of content. Not for finding posts.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "articleId": {
    "description": "Polyblog article id to preview, at most 200 characters",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "articleId"
  ],
  "type": "object"
 },
 "name": "show_article_preview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "article": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "blogId": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "contentPreview": {
        "maxLength": 6000,
        "type": "string"
       },
       "contentTruncated": {
        "type": "boolean"
       },
       "coverUrl": {
        "anyOf": [
         {
          "maxLength": 2048,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "description": {
        "anyOf": [
         {
          "maxLength": 1000,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "format": {
        "anyOf": [
         {
          "maxLength": 20,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "anyOf": [
         {
          "maxLength": 200,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "lastEditTime": {
        "anyOf": [
         {
          "maxLength": 100,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "locale": {
        "anyOf": [
         {
          "maxLength": 50,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "published": {
        "type": "boolean"
       },
       "slug": {
        "anyOf": [
         {
          "maxLength": 300,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "title": {
        "maxLength": 300,
        "type": "string"
       }
      },
      "required": [
       "id",
       "blogId",
       "title",
       "description",
       "contentPreview",
       "contentTruncated",
       "format",
       "locale",
       "slug",
       "published",
       "coverUrl",
       "lastEditTime"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "article"
  ],
  "type": "object"
 },
 "title": "Preview a blog post"
}
