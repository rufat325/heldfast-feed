{
 "annotations": {},
 "description": "Create a LayerObject at the document's layer root. With `update_if_exists:true` the existing layer with the same name is updated in place (idempotent). Pass `color:[r,g,b]` (0..1) and/or `flags:{solo,view,render,manager,locked,...}` to configure it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "color": {
    "additionalItems": false,
    "description": "[r,g,b] in 0..1.",
    "items": [
     {
      "type": "number"
     },
     {
      "type": "number"
     },
     {
      "type": "number"
     }
    ],
    "maxItems": 3,
    "minItems": 3,
    "type": "array"
   },
   "flags": {
    "description": "Initial flag values.",
    "properties": {
     "animation": {
      "type": "boolean"
     },
     "deformers": {
      "type": "boolean"
     },
     "expressions": {
      "type": "boolean"
     },
     "generators": {
      "type": "boolean"
     },
     "locked": {
      "type": "boolean"
     },
     "manager": {
      "type": "boolean"
     },
     "render": {
      "type": "boolean"
     },
     "solo": {
      "type": "boolean"
     },
     "view": {
      "type": "boolean"
     },
     "xref": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Layer display name (also used for lookup).",
    "type": "string"
   },
   "update_if_exists": {
    "description": "Idempotent update. Default false.",
    "type": "boolean"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "create_layer",
 "title": "Create Layer"
}
