  "title": "List filters"
 },
 "description": "List all Gmail filters \u2014 the server-side rules that auto-apply label actions to incoming mail. Shows each filter's criteria and label actions, and (for auditing) any `forward` address an existing filter carries. USE WHEN: reviewing existing automation, or to get a filter's id before delete_filter. SIDE EFFECTS: none. Requires the gmail.settings.basic scope \u2014 re-run `mailwarden --auth` if you authorized an earlier version.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "properties": {},
  "type": "object"
 },
 "name": "list_filters",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "filters": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "addLabelIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "criteria": {
       "additionalProperties": false,
       "properties": {
        "excludeChats": {
         "type": "boolean"
        },
        "from": {
         "type": "string"
        },
        "hasAttachment": {
         "type": "boolean"
        },
