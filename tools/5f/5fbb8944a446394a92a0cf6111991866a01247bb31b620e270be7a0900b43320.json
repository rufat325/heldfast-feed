{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Get USDC top-up requirements"},"description":"Returns a USDC quote and the request needed to top up your EUR balance. Use it before paying over x402. The amount is in USDC atomic units. Requires `manage`. Fetch the quote with plain POST. Your client must allow at least the quoted amount (@x402/core defaults spendControls.maxAmountPerPayment to $1). Sign explicitly with your own wallet (e.g. @x402/core and @x402/evm), keeping the full requirement unchanged. Submit via plain HTTP with PAYMENT-SIGNATURE, reusing the URL, body and API authorization. Retry only with the same saved PAYMENT-SIGNATURE.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"amountEur":{"description":"Amount to credit to your EUR balance, with at most two decimal places.","maximum":500,"minimum":5,"multipleOf":0.01,"type":"number"}},"required":["amountEur"],"type":"object"},"name":"get_topup_requirements","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"amount":{"type":"string"},"asset":{"type":"string"},"body":{"properties":{"amountEur":{"maximum":500,"minimum":5,"type":"number"}},"required":["amountEur"],"type":"object"},"expiresAt":{"type":"string"},"method":{"const":"POST"},"network":{"type":"string"},"note":{"type":"string"},"payTo":{"type":"string"},"paymentRequired":{"properties":{"accepts":{"items":{"properties":{"amount":{"type":"string"},"asset":{"type":"string"},"extra":{"properties":{"name":{"type":"string"},"quoteId":{"type":"string"},"version":{"type":"string"}},"required":["name","version","quoteId"],"type":"object"},"maxTimeoutSeconds":{"minimum":1,"type":"integer"},"network":{"type":"string"},"payTo":{"type":"string"},"scheme":{"const":"exact"}},"required":["scheme","network","asset","amount","payTo","maxTimeoutSeconds","extra"],"type":"object"},"minItems":1,"type":