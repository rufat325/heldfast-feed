{
 "description": "Update an existing saved search with new criteria, filters, or webhook configuration.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bedroomMax": {
    "description": "Maximum bedrooms",
    "type": "number"
   },
   "bedroomMin": {
    "description": "Minimum bedrooms",
    "type": "number"
   },
   "budgetMax": {
    "description": "Maximum budget",
    "type": "number"
   },
   "budgetMin": {
    "description": "Minimum budget",
    "type": "number"
   },
   "endpointRecipient": {
    "description": "HTTPS webhook URL for match payloads",
    "type": "string"
   },
   "eventEndpoint": {
    "description": "HTTPS webhook URL for event payloads",
    "type": "string"
   },
   "excludedCities": {
    "description": "City IRIs to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "excludedSiteCategories": {
    "description": "Site categories to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "excludedSources": {
    "description": "Source sites to exclude",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "expressions": {
    "description": "Full-text search expressions",
    "items": {
     "properties": {
      "includes": {
       "description": "Include or exclude (default: true)",
       "type": "boolean"
      },
      "strict": {
       "description": "Exact phrase match (default: false)",
       "type": "boolean"
      },
      "word": {
       "description": "Search term",
       "type": "string"
      }
     },
     "required": [
      "word"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "furnished": {
    "description": "Filter furnished properties",
    "type": "boolean"
   },
   "geoAccuracy": {
    "description": "1=house-number, 2=neighborhood",
    "type": "number"
   },
   "geoShapes": {
    "description": "Geographic polygon coordinates",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "hidePropertyContact": {
    "description": "Hide contact info in payloads",
    "type": "boolean"
   },
   "id": {
    "description": "Search ID",
    "type": "string"
   },
   "includedCities": {
    "description": "City IRIs, e.g. [\"/cities/30953\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includedDepartments": {
    "description": "Department IRIs, e.g. [\"/departments/77\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includedInseeCodes": {
    "description": "INSEE codes to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includedSiteCategories": {
    "description": "Site categories to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includedSources": {
    "description": "Source sites to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "includedZipcodes": {
    "description": "Zipcodes to include",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "landSurfaceMax": {
    "description": "Maximum land surface in m\u00b2",
    "type": "number"
   },
   "landSurfaceMin": {
    "description": "Minimum land surface in m\u00b2",
    "type": "number"
   },
   "lat": {
    "description": "Latitude for radius search",
    "type": "number"
   },
   "lon": {
    "description": "Longitude for radius search",
    "type": "number"
   },
   "notificationEnabled": {
    "description": "Enable webhook/email notifications",
    "type": "boolean"
   },
   "notificationRecipient": {
    "description": "Email address for alerts",
    "type": "string"
   },
   "pricePerMeterMax": {
    "description": "Maximum price per m\u00b2",
    "type": "number"
   },
   "pricePerMeterMin": {
    "description": "Minimum price per m\u00b2",
    "type": "number"
   },
   "propertyTypes": {
    "description": "0=Flat, 1=House, 2=Building, 3=Parking, 4=Office, 5=Land, 6=Shop",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "publisherTypes": {
    "description": "0=Individual, 1=Professional",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "radius": {
    "description": "Search radius in km",
    "type": "number"
   },
   "roomMax": {
    "description": "Maximum rooms",
    "type": "number"
   },
   "roomMin": {
    "description": "Minimum rooms",
    "type": "number"
   },
   "subscribedEvents": {
    "description": "Event types: property.ad.create, ad.update.price, ad.update.surface, ad.update.pictures, ad.update.expired, property.ad.update",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "surfaceMax": {
    "description": "Maximum surface in m\u00b2",
    "type": "number"
   },
   "surfaceMin": {
    "description": "Minimum surface in m\u00b2",
    "type": "number"
   },
   "title": {
    "description": "Search title/name",
    "type": "string"
   },
   "transactionType": {
    "description": "0=Sell, 1=Rent",
    "type": "number"
   },
   "withCoherentPrice": {
    "description": "Filter for coherent prices",
    "type": "boolean"
   },
   "withVirtualTour": {
    "description": "Only with virtual tour",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update-search"
}
