{
 "description": "Create a new email campaign as a draft: optionally with full HTML content and recipients (exactly ONE of audienceIds / segmentId / contactIds / tagIds / sendToAll) so it's ready to test and send. Nothing is sent until schedule_campaign.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "apiKey": {
    "description": "Send16 API key (overrides SEND16_API_KEY env var)",
    "type": "string"
   },
   "audienceIds": {
    "description": "Target these audience IDs (see list_audiences)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "contactIds": {
    "description": "Target these specific contact IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "fromEmail": {
    "description": "Sender email (must be from a verified domain)",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "fromName": {
    "description": "Sender display name",
    "maxLength": 100,
    "type": "string"
   },
   "html": {
    "description": "Full HTML body for the email (skip to design later)",
    "type": "string"
   },
   "name": {
    "description": "Campaign name (internal label)",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "previewText": {
    "description": "Preview text shown in inbox alongside subject",
    "maxLength": 200,
    "type": "string"
   },
   "replyTo": {
    "description": "Reply-to email address",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "segmentId": {
    "description": "Target this segment (see list_segments)",
    "type": "string"
   },
   "sendToAll": {
    "description": "Target all subscribed contacts in the workspace",
    "type": "boolean"
   },
   "subject": {
    "description": "Email subject line",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "tagIds": {
    "description": "Target contacts with these tag IDs",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "subject",
   "fromName",
   "fromEmail"
  ],
  "type": "object"
 },
 "name": "create_campaign"
}
