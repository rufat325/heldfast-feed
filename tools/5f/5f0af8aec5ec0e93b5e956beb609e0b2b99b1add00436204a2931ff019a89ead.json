       "type": "string"
      },
      {
       "const": "rule-safety",
       "type": "string"
      },
      {
       "const": "rule-verifiability",
       "type": "string"
      },
      {
       "const": "query-plan-safety",
       "type": "string"
      },
      {
       "const": "req-status-vocabulary",
       "type": "string"
      },
      {
       "const": "strict-fact-shape",
       "type": "string"
      },
      {
       "const": "strict-req-fact-pairing",
       "type": "string"
      },
      {
       "const": "predicate-verifiability",
       "type": "string"
      },
      {
       "const": "strict-readiness",
       "type": "string"
      },
      {
       "const": "semantic-completeness",
       "type": "string"
      },
      {
       "const": "proof-contract-symbols",
       "type": "string"
      },
      {
       "const": "entity-id-style",
       "type": "string"
      },
      {
       "const": "domain-redundancy",
       "type": "string"
      },
      {
       "const": "domain-implication",
       "type": "string"
      },
      {
       "const": "subject-key-identity",
       "type": "string"
      },
      {
       "const": "subject-key-shape",
       "type": "string"
      },
      {
       "const": "ontology-quality",
       "type": "string"
      },
      {
       "const": "exception-unapproved",
       "type": "string"
      },
      {
       "const": "exception-approval-self-attested",
       "type": "string"
      },
      {
       "const": "agent-requirement-unapproved",
       "type": "string"
      },
      {
       "const": "requirement-rationale-missing",
       "type": "string"
      },
      {
       "const": "symbol-owner-superseded",
       "type": "string"
      },
      {
       "const": "adr-unlinked",
       "type": "string"
      },
      {
       "const": "adr-proposed",
       "type": "string"
      },
      {
       "const": "predicate-schema-conformance",
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "sourceFiles": {
    "description": "Optional repo-relative source files to inspect for early impact diagnostics. Use with includeImpactDiagnostics after meaningful source edits.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "staged": {
    "description": "When true, inspect staged source changes for impact diagnostics using the shared CLI impact analyzer without shelling out to kibi check.",
    "type": "boolean"
   },
   "workspaceRoot": {
    "description": "Optional absolute path of the workspace this call is about when it differs from the one the server started in, for example the git worktree you are working in. The server answers from that workspace's knowledge base when it is a worktree of the same repository or lies under the client's MCP roots; otherwise it answers from its own workspace and adds a workspace_mismatch diagnostic. Host hooks fill this in automatically where available.",
    "type": "string"
   }
  },
  "type": "object"
 },
