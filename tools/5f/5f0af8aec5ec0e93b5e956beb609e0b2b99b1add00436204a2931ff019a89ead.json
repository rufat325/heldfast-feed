       "type": "string"
      },
      {
       "const": "deprecated-adr-no-successor",
       "type": "string"
      },
      {
       "const": "superseded-requirement-open",
       "type": "string"
      },
      {
       "const": "scenario-feasibility",
       "type": "string"
      },
      {
       "const": "scenario-feasibility-unknown",
       "type": "string"
      },
      {
       "const": "exception-claim-keys",
       "type": "string"
      },
      {
       "const": "numeric-string-value",
       "type": "string"
      },
      {
       "const": "rule-key-arguments-missing",
       "type": "string"
      },
      {
       "const": "domain-contradictions",
       "type": "string"
      },
      {
