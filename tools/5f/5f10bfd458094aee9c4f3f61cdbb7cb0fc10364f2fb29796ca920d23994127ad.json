{
 "description": "Compile Markdown text into a styled, publication-ready PDF document with automatic pagination and headers.",
 "inputSchema": {
  "properties": {
   "markdown": {
    "description": "Markdown text to compile",
    "type": "string"
   },
   "pageSize": {
    "description": "Page size specification (default: 'A4')",
    "enum": [
     "A4",
     "Letter"
    ],
    "type": "string"
   },
   "theme": {
    "description": "PDF layout and typography theme (default: 'academic')",
    "enum": [
     "default",
     "neutral",
     "dark",
     "forest",
     "corporate",
     "academic",
     "modern",
     "minimal"
    ],
    "type": "string"
   },
   "title": {
    "description": "Document title for the PDF header",
    "type": "string"
   }
  },
  "required": [
   "markdown"
  ],
  "type": "object"
 },
 "name": "convert_markdown_to_pdf"
}
