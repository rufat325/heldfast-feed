{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Seasonal checklist"
 },
 "description": "Generate a preventive car checklist for spring, summer, fall or winter, grouped by area (tires, battery, fluids, wipers and more) and tuned for a hot, cold or mixed climate. Use when getting a car ready for the season ahead. Do NOT use for mileage-based maintenance status (use due_services).",
 "inputSchema": {
  "properties": {
   "climate": {
    "description": "Local climate: 'hot', 'cold' or 'mixed' (default)",
    "enum": [
     "hot",
     "cold",
     "mixed"
    ],
    "type": "string"
   },
   "season": {
    "description": "Season to prepare for",
    "enum": [
     "spring",
     "summer",
     "fall",
     "winter"
    ],
    "type": "string"
   }
  },
  "required": [
   "season"
  ],
  "type": "object"
 },
 "name": "seasonal_checklist",
 "outputSchema": {
  "properties": {
   "checklist": {
    "description": "Checks grouped by area",
    "items": {
     "properties": {
      "area": {
       "description": "Area name, e.g. 'Tires'",
       "type": "string"
      },
      "items": {
       "description": "Checks for this area",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "area",
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "climate": {
    "description": "Climate the checklist is tuned for",
    "enum": [
     "hot",
     "cold",
     "mixed"
    ],
    "type": "string"
   },
   "note": {
    "description": "Item count and preventive-only caveat",
    "type": "string"
   },
   "season": {
    "description": "Season the checklist covers",
    "enum": [
     "spring",
     "summer",
     "fall",
     "winter"
    ],
    "type": "string"
   }
  },
  "required": [
   "season",
   "climate",
   "checklist",
   "note"
  ],
  "type": "object"
 },
 "title": "Seasonal checklist"
}
