     },
     "health_requirement": {
      "type": "string"
     },
     "may_interrupt_traffic": {
      "type": "boolean"
     },
     "operation": {
      "type": "string"
     },
     "receipt": {
      "type": [
       "object",
       "null"
      ]
     },
     "review_digest": {
      "type": "string"
     },
     "rollback": {
      "type": "string"
     },
     "source_deployment_id": {
      "type": "string"
     },
     "source_hostname": {
      "type": "string"
     },
     "source_hostname_removed": {
      "type": "boolean"
     },
     "source_name": {
      "type": "string"
     },
     "status": {
      "type": "string"
     },
     "switch_id": {
      "type": "string"
     },
     "target_deployment_id": {
      "type": "string"
     },
     "target_name": {
      "type": "string"
     },
     "target_state": {
      "type": "string"
     },
     "target_upstream": {
      "type": "string"
     }
    },
    "required": [
     "switch_id",
     "review_digest",
     "expires_at",
     "status",
     "receipt",
     "operation",
     "source_deployment_id",
     "source_name",
     "source_hostname",
     "target_deployment_id",
     "target_name",
     "target_state",
     "target_upstream",
     "may_interrupt_traffic",
     "health_requirement",
     "rollback",
     "source_hostname_removed"
