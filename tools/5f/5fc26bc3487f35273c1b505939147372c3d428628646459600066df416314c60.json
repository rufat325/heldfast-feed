{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Retrieves Docker Compose service logs as structured entries.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "compact": {
    "default": true,
    "description": "Prefer compact output",
    "type": "boolean"
   },
   "file": {
    "description": "Compose file path for consistency with other compose tools (maps to -f)",
    "maxLength": 4096,
    "type": "string"
   },
   "follow": {
    "default": false,
    "description": "Follow log output (-f). Must be used with 'tail' to provide bounded streaming. WARNING: Without tail, this may produce unbounded output (default: false)",
    "type": "boolean"
   },
   "index": {
    "description": "Target a specific replica index of a scaled service",
    "type": "number"
   },
   "limit": {
    "default": 1000,
    "description": "Maximum number of parsed log entries returned in structured output",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "noLogPrefix": {
    "default": false,
    "description": "Do not prefix log lines with service name (default: false)",
    "type": "boolean"
   },
   "path": {
    "description": "Directory containing docker-compose.yml",
    "maxLength": 4096,
    "type": "string"
   },
   "services": {
    "default": [],
    "description": "Specific services to get logs for (default: all)",
    "items": {
     "maxLength": 255,
     "type": "string"
    },
    "maxItems": 1000,
    "type": "array"
   },
   "since": {
    "description": "Show logs since timestamp (e.g., '10m', '2024-01-01')",
    "maxLength": 255,
    "type": "string"
   },
   "tail": {
    "description": "Number of lines to return per service (passed to --tail)",
    "type": "number"
   },
   "timestamps": {
    "default": true,
    "description": "Include timestamps in output (default: true)",
    "type": "boolean"
   },
   "until": {
    "description": "Show logs until timestamp (e.g., '5m', '2024-01-02') for time-windowed queries",
    "maxLength": 255,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "compose-logs",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "entries": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "level": {
       "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "service": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "service",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "head": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "level": {
       "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "service": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "service",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "isTruncated": {
    "type": "boolean"
   },
   "tail": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "level": {
       "enum": [
        "debug",
        "info",
        "warn",
        "error",
        "fatal"
       ],
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "service": {
       "type": "string"
      },
      "timestamp": {
       "type": "string"
      }
     },
     "required": [
      "service",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Docker Compose Logs"
}
