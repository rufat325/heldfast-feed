{
 "_meta": {
  "openai/toolInvocation/invoked": "Ranked neighborhoods",
  "openai/toolInvocation/invoking": "Ranking neighborhoods\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Rank neighborhoods by priorities"
 },
 "description": "Rank NYC neighborhoods by what a family cares about. Pass per-metric weights (family density, schools, affordability, neighborhood character, transit, safety, air quality & child health) and/or ranked priority keywords; optionally scope to one borough. Keywords that map to a metric: safety, schools, academics, affordability, budget, transit, commute, walkability, proximity, community. Any other keyword, including diversity and parks, adds no weight, because no neighborhood score measures it. Returns the top neighborhoods with a fit score and the metric breakdown \u2014 a deterministic weighted sort over neighborhood-level data, not a per-child school match.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "borough": {
    "description": "Restrict the ranking to one borough",
    "enum": [
     "Manhattan",
     "Brooklyn",
     "Queens",
     "Bronx",
     "Staten Island"
    ],
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "How many top neighborhoods to return",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "min_population": {
    "default": 1000,
    "description": "Residential floor \u2014 drops parks/cemeteries/airports that score ~100 by having almost no residents (default 1000).",
    "minimum": 0,
    "type": "integer"
   },
   "priorities": {
    "description": "Ranked priority keywords, most important first \u2014 e.g. [\"safety\",\"schools\",\"affordability\"]. Mapped to metric weights with rank decay (used only when `weights` is absent).",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "weights": {
    "additionalProperties": false,
    "description": "Per-metric importance (0+; higher = matters more). Any subset; normalized internally. Overrides priorities when both are given.",
    "properties": {
     "education_orientation": {
      "minimum": 0,
      "type": "number"
     },
     "family_density": {
      "minimum": 0,
      "type": "number"
     },
     "health_environment": {
      "minimum": 0,
      "type": "number"
     },
     "neighborhood_stability": {
      "minimum": 0,
      "type": "number"
     },
     "safety_score": {
      "minimum": 0,
      "type": "number"
     },
     "transit_accessibility": {
      "minimum": 0,
      "type": "number"
     },
     "wealth_index": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 },
 "name": "rank-neighborhoods",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "methodology_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "neighborhoods": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "borough_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "fit_score": {
       "type": "number"
      },
      "nta_code": {
       "type": "string"
      },
      "nta_name": {
       "type": [
        "string",
        "null"
       ]
      },
      "rank": {
       "type": "number"
      },
      "scores": {
       "additionalProperties": false,
       "properties": {
        "education_orientation": {
         "$ref": "#/properties/weights_used/properties/education_orientation"
        },
        "family_density": {
         "$ref": "#/properties/weights_used/properties/family_density"
        },
        "health_environment": {
         "$ref": "#/properties/weights_used/properties/health_environment"
        },
        "neighborhood_stability": {
         "$ref": "#/properties/weights_used/properties/neighborhood_stability"
        },
        "safety_score": {
         "$ref": "#/properties/weights_used/properties/safety_score"
        },
        "transit_accessibility": {
         "$ref": "#/properties/weights_used/properties/transit_accessibility"
        },
        "wealth_index": {
         "$ref": "#/properties/weights_used/properties/wealth_index"
        }
       },
       "required": [
        "family_density",
        "education_orientation",
        "wealth_index",
        "neighborhood_stability",
        "transit_accessibility",
        "safety_score",
        "health_environment"
       ],
       "type": "object"
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "rank",
      "nta_code",
      "nta_name",
      "borough_name",
      "slug",
      "fit_score",
      "scores"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "scope": {
    "additionalProperties": false,
    "properties": {
     "borough": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "borough"
    ],
    "type": "object"
   },
   "scores_as_of": {
    "type": [
     "string",
     "null"
    ]
   },
   "scores_version": {
    "type": [
     "string",
     "null"
    ]
   },
   "weights_used": {
    "additionalProperties": false,
    "properties": {
     "education_orientation": {
      "minimum": 0,
      "type": "number"
     },
     "family_density": {
      "minimum": 0,
      "type": "number"
     },
     "health_environment": {
      "minimum": 0,
      "type": "number"
     },
     "neighborhood_stability": {
      "minimum": 0,
      "type": "number"
     },
     "safety_score": {
      "minimum": 0,
      "type": "number"
     },
     "transit_accessibility": {
      "minimum": 0,
      "type": "number"
     },
     "wealth_index": {
      "minimum": 0,
      "type": "number"
     }
    },
    "required": [
     "family_density",
     "education_orientation",
     "wealth_index",
     "neighborhood_stability",
     "transit_accessibility",
     "safety_score",
     "health_environment"
    ],
    "type": "object"
   }
  },
  "required": [
   "weights_used",
   "scope",
   "count",
   "scores_as_of",
   "scores_version",
   "methodology_url",
   "neighborhoods"
  ],
  "type": "object"
 }
}
