{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "research:read",
     "backtest:run"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Start a historical backtest"
 },
 "description": "Queue a backtest of any saved strategy in the connected workspace and a matched buy-and-hold baseline. Accepts custom code and existing app strategies. Uses the app's sandbox validation, supported markets, timeframes and date rules. Requires the exact saved revision. Uses 10,000 simulated capital, 10 bps fees, 1 bp slippage and next-bar-open fills. No plugin-only daily test or history caps. Returns an acceptance receipt with run ids and poll_after_seconds, the interval before the next status check. Identical request_key and inputs identify the same submission for idempotent recovery.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "end_date": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "request_key": {
    "description": "Idempotency UUID identifying one requested write and its unchanged arguments.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "start_date": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "strategy_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "request_key",
   "strategy_id",
   "revision",
   "start_date"
  ],
  "type": "object"
 },
 "name": "start_backtest",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "app_url": {
    "format": "uri",
    "type": "string"
   },
   "baseline_run_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "end_ts": {
    "type": "number"
   },
   "poll_after_seconds": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "request_key": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "revision": {
    "type": "string"
   },
   "run_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "start_ts": {
    "type": "number"
   },
   "status": {
    "const": "accepted",
    "type": "string"
   },
   "strategy_id": {
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "tested_rules": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "buys": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "safety": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "sells": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       },
       "watches": {
        "maxLength": 1000,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "watches",
       "buys",
       "sells",
       "safety"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "total_bars": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "run_id",
   "baseline_run_id",
   "strategy_id",
   "revision",
   "start_ts",
   "end_ts",
   "total_bars",
   "status",
   "app_url",
   "poll_after_seconds",
   "request_key"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "research:read",
    "backtest:run"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Start a historical backtest"
}
