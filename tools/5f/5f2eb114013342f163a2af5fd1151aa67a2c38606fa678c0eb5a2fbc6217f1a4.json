{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Import local Nuzo memories from a versioned JSON document.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "document": {
    "properties": {
     "exported_at": {
      "maxLength": 64,
      "type": "string"
     },
     "format": {
      "const": "nuzo-memory-export",
      "type": "string"
     },
     "memories": {
      "items": {
       "properties": {
        "archived_at": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "confidence": {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        "confidence_state": {
         "anyOf": [
          {
           "enum": [
            "observed",
            "inferred",
            "user_confirmed",
            "needs_review",
            "deprecated"
           ],
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "content": {
         "maxLength": 8000,
         "type": "string"
        },
        "created_at": {
         "maxLength": 64,
         "type": "string"
        },
        "expires_at": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "kind": {
         "enum": [
          "preference",
          "project_decision",
          "fact",
          "instruction",
          "note"
         ],
         "type": "string"
        },
        "last_used_at": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "provenance": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "action": {
             "maxLength": 256,
             "minLength": 1,
             "type": "string"
            },
            "host": {
             "maxLength": 256,
             "minLength": 1,
             "type": "string"
            },
            "kind": {
             "enum": [
              "conversation",
              "file",
              "import",
              "cli",
              "mcp"
             ],
             "type": "string"
            },
            "line": {
             "maximum": 9007199254740991,
             "minimum": 1,
             "type": "integer"
            },
            "path": {
             "maxLength": 512,
             "minLength": 1,
             "type": "string"
            },
            "reason": {
             "maxLength": 1000,
             "minLength": 1,
             "type": "string"
            },
            "surface": {
             "maxLength": 256,
             "minLength": 1,
             "type": "string"
            },
            "thread_id": {
             "maxLength": 256,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "kind"
           ],
           "type": "object"
          },
          {
           "type": "null"
          }
         ]
        },
        "review_after": {
         "anyOf": [
          {
           "maxLength": 64,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "scope": {
         "maxLength": 256,
         "pattern": "^(user|project|agent|team):[A-Za-z0-9._~:/-]+$",
         "type": "string"
        },
        "source": {
         "maxLength": 256,
         "minLength": 1,
         "type": "string"
        },
        "tags": {
         "items": {
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
          "type": "string"
         },
         "maxItems": 32,
         "type": "array"
        },
        "updated_at": {
         "maxLength": 64,
         "type": "string"
        }
       },
       "required": [
        "scope",
        "kind",
        "content",
        "tags",
        "source",
        "confidence",
        "created_at",
        "updated_at",
        "last_used_at",
        "archived_at"
       ],
       "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
     },
     "relations": {
      "items": {
       "properties": {
        "created_at": {
         "maxLength": 64,
         "type": "string"
        },
        "reason": {
         "anyOf": [
          {
           "maxLength": 1000,
           "minLength": 1,
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "relation": {
         "enum": [
          "supersedes",
          "conflicts_with",
          "duplicate_of",
          "related_to"
         ],
         "type": "string"
        },
        "source_index": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "target_index": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "source_index",
        "target_index",
        "relation",
        "created_at"
       ],
       "type": "object"
      },
      "maxItems": 1000,
      "type": "array"
     },
     "version": {
      "const": 1,
      "type": "number"
     }
    },
    "required": [
     "format",
     "version",
     "exported_at",
     "memories"
    ],
    "type": "object"
   },
   "dry_run": {
    "default": false,
    "type": "boolean"
   },
   "scope": {
    "maxLength": 256,
    "pattern": "^(user|project|agent|team):[A-Za-z0-9._~:/-]+$",
    "type": "string"
   }
  },
  "required": [
   "document"
  ],
  "type": "object"
 },
 "name": "memory.import"
}
