{"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false},"description":"\ub9e4\ub2c8\ud398\uc2a4\ud2b8\uc5d0 \uae30\ub85d\ub41c \uc124\uce58 \uacf5\ud1b5\ucef4\ud3ec\ub10c\ud2b8\ub97c \uce74\ud0c8\ub85c\uadf8 \uace0\uc815 \ud0dc\uadf8(\uc774 \ub3c4\uad6c \ubc84\uc804\uc774 \uc544\ub294 \ucd5c\uc2e0)\ub85c 3-way \uac31\uc2e0\ud569\ub2c8\ub2e4 \u2014 \uae30\uc900\uc740 \ub9e4\ub2c8\ud398\uc2a4\ud2b8\uc5d0 \uc801\ud78c \uc124\uce58 \ud0dc\uadf8, \ud30c\uc77c\ub9c8\ub2e4 \ubd88\ubcc0/\uac31\uc2e0/\ucd94\uac00/\uc0ac\uc6a9\uc790\uc218\uc815(\ubcf4\uc874)/\ucda9\ub3cc/upstream\uc0ad\uc81c \ub85c \ubd84\ub958. \uc0ac\uc6a9\uc790\uac00 \uc218\uc815\ud55c \ud30c\uc77c\uc740 force \uc5c6\uc774\ub294 \ubcf4\uc874\ud558\uba70, dryRun(\uae30\ubcf8)\uc73c\ub85c \ubcc0\uacbd \uacc4\ud68d\uc744 \uba3c\uc800 \ud655\uc778\ud569\ub2c8\ub2e4. \ub36e\uc5b4\uc4f0\uae30 \uc804 upgrade-backup/\uc5d0 \ubc31\uc5c5\ud558\uace0, \ud558\ub4dc \ucda9\ub3cc \uc2dc \uc544\ubb34\uac83\ub3c4 \uc4f0\uc9c0 \uc54a\uace0 \uac70\ubd80\ud569\ub2c8\ub2e4. v1.12: reapply=true \uba74 \ucda9\ub3cc \ud30c\uc77c(\uc0ac\uc6a9\uc790 \uc218\uc815 + upstream \ubcc0\uacbd)\uc744 \uae30\uc900\u00b7\ud604\uc7ac\u00b7\ubaa9\ud45c 3-way(git merge-file)\ub85c \ud569\uccd0 \ucda9\ub3cc \uc5c6\ub294 \uac83\ub9cc \uc801\uc6a9\ud558\uace0, \ud569\uce58\uc9c0 \ubabb\ud55c \ud30c\uc77c\ub9cc \uac70\ubd80(force \ub85c \ub36e\uc5b4\uc4f0\uae30)\ud569\ub2c8\ub2e4 \u2014 \ud30c\uc77c\uc5d0 \ucda9\ub3cc \ud45c\uc2dd\uc744 \ub123\uc9c0 \uc54a\uc2b5\ub2c8\ub2e4. verify=true \uba74 \uc801\uc6a9 \ub4a4 compile \ud574 \ud569\uce5c \ud30c\uc77c\uc5d0\uc11c \uc624\ub958\uac00 \ub098\uba74 \uadf8 \ud30c\uc77c\uc744 upstream \ubcf8\uc73c\ub85c \ub418\ub3cc\ub9bd\ub2c8\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"components":{"description":"\ub300\uc0c1 \ucef4\ud3ec\ub10c\ud2b8 id (\ubbf8\uc9c0\uc815 \uc2dc \ub9e4\ub2c8\ud398\uc2a4\ud2b8 \uc804\uccb4)","items":{"type":"string"},"type":"array"},"dryRun":{"default":true,"description":"true(\uae30\ubcf8)\uba74 \uacc4\ud68d\ub9cc \ubbf8\ub9ac\ubcf4\uae30, \ub514\uc2a4\ud06c \ubcc0\uacbd \uc5c6\uc74c","type":"boolean"},"force":{"default":false,"description":"\uc0ac\uc6a9\uc790 \uc218\uc815 \ud30c\uc77c(\ucda9\ub3cc)\ub3c4 \ubc31\uc5c5 \ud6c4 \ub36e\uc5b4\uc4f8\uc9c0","type":"boolean"},"projectDir":{"description":"\uc5c5\uadf8\ub808\uc774\ub4dc\ud560 \ud504\ub85c\uc81d\ud2b8 \ub514\ub809\ud130\ub9ac(\uc808\ub300\uacbd\ub85c \uad8c\uc7a5)","type":"string"},"reapply":{"default":false,"description":"\ucda9\ub3cc \ud30c\uc77c\uc744 3-way \ub85c \ud569\uccd0 \ucda9\ub3cc \uc5c6\ub294 \uac83\ub9cc \uc790\ub3d9 \uc801\uc6a9","type":"boolean"},"timeoutMs":{"default":300000,"description":"verify \ucef4\ud30c\uc77c \ud0c0\uc784\uc544\uc6c3(ms)","maximum":1800000,"minimum":10000,"type":"integer"},"verify":{"default":false,"description":"\uc801\uc6a9 \ub4a4 compile \u2014 \ud569\uce5c \ud30c\uc77c\uc5d0 \uc624\ub958\uac00 \uc788\uc73c\uba74 upstream \ubcf8\uc73c\ub85c \ub418\ub3cc\ub9bc","type":"boolean"}},"required":["projectDir"],"type":"object"},"name":"upgrade_egovframe_project","title":"\uacf5\ud1b5\ucef4\ud3ec\ub10c\ud2b8 \uc5c5\uadf8\ub808\uc774\ub4dc"}
