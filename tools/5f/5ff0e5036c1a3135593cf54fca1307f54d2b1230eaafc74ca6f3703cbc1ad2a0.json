{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "quotes:read",
     "quotes:answer",
     "quotes:submit"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Authorize and request carrier quotes"
 },
 "description": "Accepts the customer's explicitly confirmed application review and displayed quote consent, records acceptance of Menlo's Terms and requests eligible carrier quotes through Menlo's existing workflow. Sends application information to carriers and may authorize consumer reports. Requires separate quotes:submit OAuth permission, a current reviewToken and the exact customerConfirmation from the displayed review; OAuth and saved answers do not constitute agreement. Identical reviewToken and payload retries return the original submission without duplicate requests. Does not purchase, bind coverage, choose coverage, sign a carrier application or enroll in SMS. Other MCP clients retain broker-review holds; the reviewer demo never dispatches.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "baseRevision": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "customerConfirmation": {
    "description": "Exact confirmationText from the review, only after the customer explicitly confirms the displayed application and consent; never infer consent from OAuth, an answer save or an earlier request",
    "enum": [
     "I reviewed my application, agree to Menlo\u2019s Terms of Service and authorize Menlo to request carrier quotes with the consumer-report consent shown above.",
     "Revis\u00e9 mi solicitud, acepto los T\u00e9rminos del servicio de Menlo y autorizo a Menlo a solicitar cotizaciones a las aseguradoras con el consentimiento para informes del consumidor mostrado arriba."
    ],
    "type": "string"
   },
   "locale": {
    "enum": [
     "en",
     "es"
    ],
    "type": "string"
   },
   "reviewToken": {
    "description": "Short-lived reviewToken returned by review_quote_application; never invent one",
    "pattern": "^[A-Za-z0-9_-]{43}$",
    "type": "string"
   },
   "termsVersion": {
    "const": "quote-terms-2026-09-27",
    "type": "string"
   }
  },
  "required": [
   "reviewToken",
   "baseRevision",
   "termsVersion",
   "locale",
   "customerConfirmation"
  ],
  "type": "object"
 },
 "name": "submit_quote_request",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "additionalQuestionCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "aggregate": {
    "additionalProperties": false,
    "properties": {
     "blocked": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "declined": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "quoted": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "referred": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "status": {
      "type": "string"
     },
     "terminal": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "status",
     "total",
     "terminal",
     "quoted",
     "referred",
     "declined",
     "blocked"
    ],
    "type": "object"
   },
   "carriers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "carrierId": {
       "type": "string"
      },
      "declineReason": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "informationSubmitted": {
       "type": "boolean"
      },
      "quote": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "carrier": {
           "maxLength": 120,
           "minLength": 1,
           "type": "string"
          },
          "coverages": {
           "items": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 20,
           "minItems": 1,
           "type": "array"
          },
          "dueToday": {
           "maxLength": 40,
           "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$",
           "type": "string"
          },
          "intro": {
           "maxLength": 500,
           "minLength": 1,
           "type": "string"
          },
          "limits": {
           "items": {
            "additionalProperties": false,
            "properties": {
             "label": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
             },
             "value": {
              "maxLength": 120,
              "minLength": 1,
              "type": "string"
             }
            },
            "required": [
             "label",
             "value"
            ],
            "type": "object"
           },
           "maxItems": 20,
           "minItems": 1,
           "type": "array"
          },
          "monthly": {
           "maxLength": 40,
           "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$",
           "type": "string"
          },
          "monthlyCount": {
           "exclusiveMinimum": 0,
           "maximum": 60,
           "type": "integer"
          },
          "startDate": {
           "format": "date",
           "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
           "type": "string"
          },
          "subjectTo": {
           "items": {
            "maxLength": 300,
            "minLength": 1,
            "type": "string"
           },
           "maxItems": 20,
           "minItems": 1,
           "type": "array"
          },
          "yearly": {
           "maxLength": 40,
           "pattern": "^(?:0\\.(?:0[1-9]|[1-9]\\d)|[1-9]\\d*\\.\\d{2})$",
           "type": "string"
          }
         },
         "required": [
          "carrier"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "carrierId",
      "status",
      "quote",
      "declineReason",
      "informationSubmitted"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "demo": {
    "type": "boolean"
   },
   "formId": {
    "type": "string"
   },
   "formRevisionId": {
    "type": "string"
   },
   "nextAction": {
    "enum": [
     "answer_page",
     "finish_on_website",
     "answer_questions",
     "broker_review",
     "wait",
     "review",
     "review_application",
     "cancelled"
    ],
    "type": "string"
   },
   "notificationExpiresAt": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "notificationStatus": {
    "enum": [
     "subscribed",
     "not_subscribed"
    ],
    "type": "string"
   },
   "ownerQuote": {
    "type": "boolean"
   },
   "pricingNotice": {
    "type": "string"
   },
   "progressMessage": {
    "type": "string"
   },
   "quoteNumber": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "stage": {
    "type": "string"
   },
   "websiteUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "demo",
   "quoteNumber",
   "formId",
   "formRevisionId",
   "revision",
   "stage",
   "ownerQuote",
   "aggregate",
   "carriers",
   "additionalQuestionCount",
   "nextAction",
   "websiteUrl",
   "pricingNotice",
   "notificationStatus",
   "notificationExpiresAt",
   "progressMessage"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "quotes:read",
    "quotes:answer",
    "quotes:submit"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Authorize and request carrier quotes"
}
