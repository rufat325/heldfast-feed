{
 "description": "Manages project profiles for vibe coding sessions. Save project-specific settings for documentation, code analysis, and publishing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "create",
     "get",
     "update",
     "delete",
     "list",
     "setActive",
     "getActive",
     "clone"
    ],
    "type": "string"
   },
   "codeAnalysis": {
    "additionalProperties": false,
    "properties": {
     "defaultDiagramTypes": {
      "items": {
       "enum": [
        "class",
        "flowchart",
        "dependency",
        "all"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "defaultLanguage": {
      "enum": [
       "typescript",
       "javascript",
       "python",
       "go"
      ],
      "type": "string"
     },
     "excludePatterns": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "useAI": {
      "type": "boolean"
     }
    },
    "type": "object"
   },
   "defaultTags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "description": {
    "type": "string"
   },
   "documentation": {
    "additionalProperties": false,
    "properties": {
     "author": {
      "type": "string"
     },
     "defaultDocType": {
      "enum": [
       "README",
       "DESIGN",
       "TUTORIAL",
       "CHANGELOG",
       "API",
       "ARCHITECTURE"
      ],
      "type": "string"
     },
     "includeTableOfContents": {
      "type": "boolean"
     },
     "language": {
      "enum": [
       "en",
       "ko"
      ],
      "type": "string"
     },
     "license": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "limit": {
    "type": "number"
   },
   "metadata": {
    "additionalProperties": {},
    "type": "object"
   },
   "name": {
    "type": "string"
   },
   "newName": {
    "type": "string"
   },
   "offset": {
    "type": "number"
   },
   "profileId": {
    "type": "string"
   },
   "projectPath": {
    "type": "string"
   },
   "publishing": {
    "additionalProperties": false,
    "properties": {
     "autoPublish": {
      "type": "boolean"
     },
     "defaultPlatform": {
      "enum": [
       "notion",
       "github-wiki",
       "obsidian",
       "confluence",
       "slack",
       "discord"
      ],
      "type": "string"
     },
     "platformSettings": {
      "additionalProperties": {},
      "type": "object"
     }
    },
    "type": "object"
   },
   "repository": {
    "type": "string"
   },
   "sortBy": {
    "enum": [
     "createdAt",
     "updatedAt",
     "name"
    ],
    "type": "string"
   },
   "sortOrder": {
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "tagCategories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "tags"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "team": {
    "additionalProperties": false,
    "properties": {
     "members": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "email": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     }
    },
    "required": [
     "name"
    ],
    "type": "object"
   },
   "version": {
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_project_profile"
}
