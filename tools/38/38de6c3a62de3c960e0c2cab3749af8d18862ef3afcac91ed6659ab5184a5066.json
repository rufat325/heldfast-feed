{
 "description": "Get step-by-step disk cleanup instructions for a device type, in any of 7 languages. Works on every platform (knowledge only, no execution).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "device": {
    "description": "Device type to clean",
    "enum": [
     "windows",
     "mac",
     "ios",
     "android"
    ],
    "type": "string"
   },
   "language": {
    "default": "en",
    "description": "Guide language",
    "enum": [
     "zh",
     "en",
     "fr",
     "de",
     "es",
     "ja",
     "ko"
    ],
    "type": "string"
   }
  },
  "required": [
   "device"
  ],
  "type": "object"
 },
 "name": "get_cleanup_guide"
}
