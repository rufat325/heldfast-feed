{
 "description": "Share a folder with another MEGA user",
 "inputSchema": {
  "properties": {
   "access_level": {
    "default": "r",
    "description": "Access level: 'r' (read), 'rw' (read-write), 'full' (full access)",
    "enum": [
     "r",
     "rw",
     "full"
    ],
    "type": "string"
   },
   "email": {
    "description": "Email of user to share with",
    "type": "string"
   },
   "path": {
    "description": "Remote folder path to share",
    "type": "string"
   }
  },
  "required": [
   "path",
   "email"
  ],
  "type": "object"
 },
 "name": "mega_share"
}
