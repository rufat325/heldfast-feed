{
 "description": "List objects in a bucket with optional prefix filter",
 "inputSchema": {
  "properties": {
   "bucket_name": {
    "description": "Bucket name",
    "type": "string"
   },
   "compartment_id": {
    "description": "Compartment OCID (defaults to tenancy)",
    "type": "string"
   },
   "limit": {
    "default": 100,
    "description": "Maximum objects to return",
    "type": "number"
   },
   "prefix": {
    "description": "Filter objects by prefix",
    "type": "string"
   }
  },
  "required": [
   "bucket_name"
  ],
  "type": "object"
 },
 "name": "oci_os_list_objects"
}
