{"annotations":{"destructiveHint":false,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Save a property watchlist"},"description":"Save the user's search criteria once as a named, persistent watchlist (same criteria as search_properties) with alert preferences (min_score, new listings, price drops with optional minimum percent or amount, back on market). Realty.Bingo then monitors the area on a schedule, independent of any conversation, and records new matching listings, price reductions and relistings as alerts. Saving again with the same name replaces it. Returns how the criteria were interpreted (hard vs soft vs excluded) and a preview from stored data. Preferences about the people in a neighbourhood are refused (fair housing).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"alert_prefs":{"additionalProperties":false,"properties":{"back_on_market":{"type":"boolean"},"min_drop_amount":{"exclusiveMinimum":0,"maximum":100000000,"type":"number"},"min_drop_pct":{"exclusiveMinimum":0,"maximum":90,"type":"number"},"min_score":{"maximum":100,"minimum":1,"type":"integer"},"new_listings":{"type":"boolean"},"price_drops":{"type":"boolean"},"status_changes":{"type":"boolean"}},"type":"object"},"criteria":{"additionalProperties":false,"properties":{"avoid":{"description":"Features that exclude a listing when the listing states them, e.g. fixer-upper, pool.","items":{"maxLength":60,"minLength":2,"type":"string"},"maxItems":15,"type":"array"},"bedrooms_exception":{"additionalProperties":false,"description":"e.g. 'three bedrooms, but two is fine with an office': min_bedrooms 3 plus {min_bedrooms: 2, requires: ['home office']}","properties":{"min_bedrooms":{"maximum":20,"minimum":0,"type":"integer"},"requires":{"items":{"maxLength":60,"minLength":2,"type":"string"},"maxItems":5,"minItems":1,"type":"array"}},"required":["min_bedrooms","requires"],"type":"object"},"exclude_property_types