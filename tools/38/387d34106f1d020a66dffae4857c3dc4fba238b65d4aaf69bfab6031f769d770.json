":"object"},"max_hoa_fee":{"maximum":100000,"minimum":0,"type":"number"},"max_price":{"description":"Hard ceiling: listings above it are excluded.","exclusiveMinimum":0,"maximum":1000000000,"type":"number"},"min_bathrooms":{"maximum":20,"minimum":0,"type":"number"},"min_bedrooms":{"maximum":20,"minimum":0,"type":"integer"},"min_living_area":{"exclusiveMinimum":0,"maximum":100000,"type":"integer"},"min_lot_area":{"exclusiveMinimum":0,"maximum":100000000,"type":"integer"},"min_price":{"exclusiveMinimum":0,"maximum":1000000000,"type":"number"},"min_year_built":{"maximum":2100,"minimum":1600,"type":"integer"},"must_have":{"description":"Mandatory features, e.g. garage, fireplace. Unmentioned = unverified, not excluded (unless strict_unknowns).","items":{"maxLength":60,"minLength":2,"type":"string"},"maxItems":15,"type":"array"},"nice_to_have":{"description":"Soft features that improve ranking.","items":{"maxLength":60,"minLength":2,"type":"string"},"maxItems":25,"type":"array"},"notes":{"description":"The user's own words, kept for reference; terms in it that match the feature list become soft preferences.","maxLength":500,"type":"string"},"preferred_bedrooms":{"maximum":20,"minimum":0,"type":"integer"},"property_types":{"items":{"enum":["single_family","condo","townhouse","multi_family","apartment","manufactured","land"],"type":"string"},"maxItems":7,"type":"array"},"strict_unknowns":{"description":"Exclude listings that do not state a must_have feature (default false: keep and flag).","type":"boolean"},"styles":{"description":"Architectural styles, e.g. Craftsman, Victorian, mid-century modern.","items":{"maxLength":60,"minLength":2,"type":"string"},"maxItems":10,"type":"array"}},"required":["listing_type","location"],"type":"object"},"monitoring":{"default":"active","enum":["active","paused"],"type":"string"},"name":{"maxLength":60,"minLength":1,"type":"string"},"priority":{"default":"normal","enum":["normal","high"],"type":"string"}},"required":["name","criteria"],"