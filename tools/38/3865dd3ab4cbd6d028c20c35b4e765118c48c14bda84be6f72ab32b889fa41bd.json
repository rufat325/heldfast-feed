{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Compute or verify SHA-256 checksums for tdmcp artifacts (.tox, .recipe.json, bundles). action=compute walks a path and writes a tdmcp-checksums.json manifest. action=verify re-hashes files and reports ok/mismatch/missing/extra. No TD bridge required.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "enum": [
     "compute",
     "verify"
    ],
    "type": "string"
   },
   "exclude_globs": {
    "default": [
     "**/tdmcp-checksums.json",
     "**/.DS_Store",
     "**/node_modules/**",
     "**/.git/**"
    ],
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "follow_symlinks": {
    "default": false,
    "type": "boolean"
   },
   "include_globs": {
    "default": [],
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "manifest": {
    "properties": {
     "created_at": {
      "type": "string"
     },
     "files": {
      "items": {
       "properties": {
        "path": {
         "type": "string"
        },
        "sha256": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "size": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        }
       },
       "required": [
        "path",
        "sha256",
        "size"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "root": {
      "type": "string"
     },
     "tdmcp_version": {
      "type": "string"
     }
    },
    "required": [
     "files",
     "created_at",
     "tdmcp_version"
    ],
    "type": "object"
   },
   "manifest_out": {
    "type": "string"
   },
   "max_file_bytes": {
    "default": 2147483648,
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "path": {
    "type": "string"
   },
   "strict": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "action",
   "path"
  ],
  "type": "object"
 },
 "name": "checksum_and_verify_pack",
 "title": "Checksum and Verify Pack"
}
