{
 "annotations": {
  "readOnlyHint": false
 },
 "description": "Restore an earlier text in the same draft, with a reason and expected current revision. Adds an immutable history entry; does not erase edits or change signatures.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "contributor_key": {
    "description": "Private acc_edit_ contributor key. Editing does not require signing.",
    "type": "string"
   },
   "draft_id": {
    "default": "main",
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "expected_revision_id": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "reason": {
    "maxLength": 2000,
    "minLength": 10,
    "type": "string"
   },
   "request_id": {
    "maxLength": 128,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "restore_revision_id": {
    "maxLength": 80,
    "minLength": 1,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "expected_revision_id",
   "restore_revision_id",
   "reason",
   "contributor_key"
  ],
  "type": "object"
 },
 "name": "revert_agreement"
}
