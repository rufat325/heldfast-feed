  "properties": {
   "cursor": {
    "anyOf": [
     {
      "maxLength": 1024,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Optional opaque watch cursor for these exact mints; no new watched events returns an unpaid result.",
    "title": "Cursor"
   },
   "mints": {
    "description": "One to five distinct pump.fun mints with full live coverage, each a mint or a pump.fun/gmgn/solscan/birdeye link",
    "items": {
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "title": "Mints",
    "type": "array"
   }
  },
  "required": [
   "mints"
  ],
  "title": "watchlist_updatesArguments",
  "type": "object"
 },
