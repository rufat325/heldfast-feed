{
 "description": "Run RetireCrunch's full year-by-year Wealth Plan projection for a household. Models earned income, pensions, expenses, portfolio growth, optional growth\u2192income phase switch, mortgage amortization, optional property sale, and region-aware tax (US uses 2026 federal+state brackets; other regions use a flat rate). Returns a compact summary with 5-year milestones by default, or the full annual array when yearly_detail=true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "currency": {
    "default": "USD",
    "enum": [
     "USD",
     "EUR",
     "GBP",
     "CHF",
     "JPY",
     "CAD",
     "AUD",
     "DKK"
    ],
    "type": "string"
   },
   "current_earned_income": {
    "default": 0,
    "description": "Annual gross earned income today.",
    "minimum": 0,
    "type": "number"
   },
   "current_housing_expenses": {
    "default": 0,
    "description": "Annual housing expenses today.",
    "minimum": 0,
    "type": "number"
   },
   "current_investment_portfolio": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "current_liquidity": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "current_living_costs": {
    "default": 0,
    "description": "Annual general living expenses today.",
    "minimum": 0,
    "type": "number"
   },
   "current_mortgage": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "current_other_expenses": {
    "default": 0,
    "description": "Annual other expenses today.",
    "minimum": 0,
    "type": "number"
   },
   "current_property": {
    "default": 0,
    "minimum": 0,
    "type": "number"
   },
   "estimated_tax_rate": {
    "default": 20,
    "description": "Pre-retirement effective tax rate (%).",
    "maximum": 60,
    "minimum": 0,
    "type": "number"
   },
   "household_type": {
    "default": "single",
    "enum": [
     "single",
     "couple"
    ],
    "type": "string"
   },
   "income_yield_rate": {
    "default": 3.5,
    "description": "Annual yield % during the income phase.",
    "maximum": 20,
    "minimum": 0,
    "type": "number"
   },
   "inflation_rate": {
    "default": 2,
    "description": "Annual inflation %.",
    "maximum": 20,
    "minimum": 0,
    "type": "number"
   },
   "partner_early_death_years_before_end": {
    "default": 5,
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "partner_survivor_expense_factor": {
    "default": 0.7,
    "maximum": 1,
    "minimum": 0.3,
    "type": "number"
   },
   "plan_horizon_years": {
    "default": 50,
    "description": "Total years to project from start_year.",
    "maximum": 80,
    "minimum": 1,
    "type": "integer"
   },
   "portfolio_return_rate": {
    "default": 5,
    "description": "Annual real portfolio return %.",
    "maximum": 30,
    "minimum": 0,
    "type": "number"
   },
   "portfolio_switch_enabled": {
    "default": true,
    "type": "boolean"
   },
   "portfolio_switch_year": {
    "description": "Year to switch from growth to income phase. Defaults to retirement_year if omitted.",
    "maximum": 2200,
    "minimum": 1900,
    "type": "integer"
   },
   "portfolio_volatility": {
    "default": 0,
    "description": "Return std dev %; 0 = deterministic.",
    "maximum": 50,
    "minimum": 0,
    "type": "number"
   },
   "post_retirement_tax_rate": {
    "default": 10,
    "description": "Post-retirement effective tax rate (%).",
    "maximum": 60,
    "minimum": 0,
    "type": "number"
   },
   "property_sale_destination": {
    "default": "liquidity",
    "enum": [
     "liquidity",
     "investmentPortfolio"
    ],
    "type": "string"
   },
   "property_sale_enabled": {
    "default": false,
    "type": "boolean"
   },
   "property_sale_year": {
    "maximum": 2200,
    "minimum": 1900,
    "type": "integer"
   },
   "region": {
    "default": "GENERIC",
    "description": "Country regime \u2014 drives tax model (US uses bracket-based federal/state; others a flat rate).",
    "enum": [
     "US",
     "CH",
     "GB",
     "EU",
     "JP",
     "GENERIC"
    ],
    "type": "string"
   },
   "retirement_year": {
    "description": "Year retirement begins.",
    "maximum": 2200,
    "minimum": 1900,
    "type": "integer"
   },
   "start_year": {
    "description": "First year of the projection (typically the current year).",
    "maximum": 2200,
    "minimum": 1900,
    "type": "integer"
   },
   "yearly_detail": {
    "default": false,
    "description": "When true, include the full year-by-year array in the response. When false (default), return a compact summary plus 5-year milestones.",
    "type": "boolean"
   }
  },
  "required": [
   "start_year",
   "retirement_year"
  ],
  "type": "object"
 },
 "name": "project_wealth_plan"
}
