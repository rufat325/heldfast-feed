{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Grade Calculator"
 },
 "description": "Computes a weighted category average and optionally the final-exam percentage needed to reach a target course grade. (API Tool Calls, by Cowerx)",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "target",
     "finalWeight"
    ]
   },
   {
    "not": {
     "anyOf": [
      {
       "required": [
        "target"
       ]
      },
      {
       "required": [
        "finalWeight"
       ]
      }
     ]
    }
   }
  ],
  "examples": [
   {
    "categories": [
     {
      "score": 80,
      "weight": 40
     },
     {
      "score": 90,
      "weight": 60
     }
    ],
    "finalWeight": 20,
    "target": 90
   }
  ],
  "properties": {
   "categories": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "score": {
       "description": "Category score percentage.",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      },
      "weight": {
       "description": "Relative category weight.",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "score",
      "weight"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "finalWeight": {
    "description": "Final exam percentage of the full course.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "number"
   },
   "target": {
    "description": "Target course percentage.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "categories"
  ],
  "type": "object"
 },
 "name": "grade_calculator",
 "outputSchema": {
  "description": "Computed values, units and formula where applicable; rational integers are decimal strings.",
  "type": "object"
 },
 "title": "Grade Calculator"
}
