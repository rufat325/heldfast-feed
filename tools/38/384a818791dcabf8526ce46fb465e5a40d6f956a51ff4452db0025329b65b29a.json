{
 "description": "Check token-holder discount eligibility in Google Universal Commerce Protocol (UCP) format. Returns title, extension field, and applied array compatible with UCP checkout flows. Same on-chain verification as insumer_verify, wrapped in UCP format. Consumes 1 merchant credit.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "items": {
    "description": "Optional line items for per-item cent-amount allocations",
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Item price in cents",
       "type": "integer"
      },
      "path": {
       "description": "JSONPath reference to the line item, e.g. '$.line_items[0]'",
       "type": "string"
      }
     },
     "required": [
      "path",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "merchantId": {
    "description": "Merchant ID",
    "type": "string"
   },
   "solanaWallet": {
    "description": "Solana wallet address (base58)",
    "type": "string"
   },
   "stellarWallet": {
    "description": "Stellar wallet address (G-prefixed)",
    "type": "string"
   },
   "suiWallet": {
    "description": "Sui wallet address (0x + 64 hex)",
    "type": "string"
   },
   "tronWallet": {
    "description": "Tron wallet address (T-prefixed)",
    "type": "string"
   },
   "wallet": {
    "description": "EVM wallet address (0x...)",
    "type": "string"
   },
   "xrplWallet": {
    "description": "XRPL wallet address (r-address)",
    "type": "string"
   }
  },
  "required": [
   "merchantId"
  ],
  "type": "object"
 },
 "name": "insumer_ucp_discount"
}
