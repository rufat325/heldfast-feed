{
 "description": "Put a design's alternatives side by side in one call: the parent's head and each open branch (or the `branchIds` named) rendered into ONE picture \u2014 a short-lived signed https link, numbered by caption \u2014 plus, per branch, what it changes against the parent at its fork (counts and a few lines, as ui_builder_diff_designs reports them). Show the person the picture and the numbered list, then ask with ui_builder_pick_branch; merge the choice with ui_builder_merge_branch. Writes nothing. Read access to the design.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "agentModel": {
    "description": "Optional current model name shown to design viewers; self-reported. Omit when unknown.",
    "maxLength": 80,
    "type": "string"
   },
   "agentName": {
    "description": "Optional agent/client name shown to design viewers; self-reported.",
    "maxLength": 80,
    "type": "string"
   },
   "branchIds": {
    "description": "Only these branches of the design, in this order. Defaults to every open branch, oldest first.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "designId": {
    "description": "The parent design.",
    "type": "string"
   },
   "device": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": false,
      "properties": {
       "heightDp": {
        "type": "integer"
       },
       "widthDp": {
        "type": "integer"
       }
      },
      "required": [
       "widthDp",
       "heightDp"
      ],
      "type": "object"
     }
    ],
    "description": "Render every picture at this device instead of each design's own size: a preset id (phone_small, phone, phone_landscape, foldable_folded, foldable_unfolded, tablet_portrait, tablet_landscape, wear_small_round, wear_large_round, wear_square, tv_1080p) or {\"widthDp\",\"heightDp\"}. Nothing is saved."
   },
   "inline": {
    "description": "Also return the picture as an image block. Defaults to false: the signed link.",
    "type": "boolean"
   },
   "token": {
    "description": "A grant token from poll_access, when you cannot set the X-Compose-Preview-Token header yourself \u2014 an MCP client fixes its headers at connect time, so this is how a token approved during this session is used in it. Prefer the header where you control it.",
    "type": "string"
   }
  },
  "required": [
   "designId"
  ],
  "type": "object"
 },
