{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the roughly 1,000 active student organizations on TerpLink by name or keyword, optionally within categories from terplink_list_organization_categories. Returns summaries; call terplink_get_organization for contact details. No login needed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "category_ids": {
    "description": "Only organizations with any of these ids",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of records to return, 1-50 (default 20)",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Number of records to skip, for pagination (default 0)",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Words to match in the name or description",
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "terplink_search_organizations",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "organizations": {
    "description": "Matches in name order",
    "items": {
     "additionalProperties": false,
     "properties": {
      "categories": {
       "description": "Category names, e.g. \"SGA Recognized\"",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "category_ids": {
       "description": "Ids of the categories the organization is in",
       "items": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "type": "array"
      },
      "description": {
       "description": "Full description as plain text",
       "type": [
        "string",
        "null"
       ]
      },
      "id": {
       "description": "Organization id",
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "image_url": {
       "description": "Profile picture",
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "description": "Organization name",
       "type": "string"
      },
      "short_name": {
       "description": "Abbreviation or nickname",
       "type": [
        "string",
        "null"
       ]
      },
      "status": {
       "description": "Registration status, e.g. \"Active\"",
       "type": "string"
      },
      "summary": {
       "description": "One-paragraph summary",
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "description": "Public TerpLink page",
       "type": "string"
      },
      "website_key": {
       "description": "Pass to terplink_get_organization; the last part of the public URL",
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "short_name",
      "website_key",
      "url",
      "summary",
      "description",
      "category_ids",
      "categories",
      "status",
      "image_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "Organizations matching the query",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "total",
   "organizations"
  ],
  "type": "object"
 },
 "title": "Search organizations"
}
