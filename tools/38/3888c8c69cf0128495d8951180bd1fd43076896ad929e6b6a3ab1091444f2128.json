{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find open times for a first call"
 },
 "description": "Returns open start times (ISO 8601, UTC offset included) for a 30-minute video call about one service. Dates are YYYY-MM-DD, from today onward, covering at most 14 calendar days (to is at most 13 days after from).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "service": {
    "enum": [
     "assessment",
     "automation",
     "agents",
     "training",
     "migration",
     "relaunch",
     "landing",
     "polish",
     "redesign",
     "template",
     "tool",
     "software",
     "cssfix",
     "foundation",
     "check",
     "audit",
     "seoanalysis",
     "linking",
     "content",
     "visibility",
     "fixes",
     "measurement",
     "booking",
     "assistant",
     "deterministic",
     "newsite",
     "care",
     "shopauto",
     "photos",
     "shopcheck",
     "tracking",
     "diagnosis"
    ],
    "type": "string"
   },
   "timeZone": {
    "default": "Europe/Zurich",
    "maxLength": 64,
    "type": "string"
   },
   "to": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "required": [
   "service",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "get_free_slots",
 "title": "Find open times for a first call"
}
