  "readOnlyHint": true,
  "title": "Estimate Audio Analysis Cost"
 },
 "description": "Estimate audio analysis cost anonymously and free before committing. Read analysis_options for eligible anonymous one-off Checkout, trial duration fit and key-based banked-token use; these do not verify balance or trial entitlement. Eligible quotes can include checkout.upfront_payment_estimate from the current charge builder; this is not a reserved price or a saved-link charge. Review the hosted amount before payment. Returns estimated dollars, job_estimate_id and expires_at. Review the estimate before spending; final cost depends on measured duration and completed analysis, and Checkout can collect a buffered amount with refund thresholds. If processing or payment returns estimate_pricing_changed, get a fresh free estimate, present the new price, and wait for explicit user approval before processing or payment. Never silently retry analysis or purchase.",
 "inputSchema": {
  "properties": {
   "audio_url": {
    "description": "Publicly accessible URL of the audio file (MP3, WAV, FLAC, OGG, Opus).",
    "type": "string"
   },
   "tools": {
    "description": "Analysis tools to price. Available in v1.0: bpm, key, waveform. Coming soon: structure, chords.",
