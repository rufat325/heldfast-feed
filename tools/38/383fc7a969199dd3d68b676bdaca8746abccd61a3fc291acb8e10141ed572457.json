    "default": "unknown",
    "enum": [
     "500_or_less",
     "over_500_to_5000",
     "over_5000",
     "unknown"
    ],
    "type": "string"
   },
   "reported_gross_proceeds_band": {
    "default": "not_applicable_or_unknown",
