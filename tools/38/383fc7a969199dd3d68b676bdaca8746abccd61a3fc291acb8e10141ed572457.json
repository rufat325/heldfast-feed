   },
   "irs_form_8283_url": {
    "format": "uri",
    "type": "string"
   },
   "irs_vehicle_donation_guide_url": {
    "format": "uri",
    "type": "string"
   },
   "limitation": {
    "type": "string"
   }
  },
  "required": [
   "general_federal_information_only",
   "checklist",
   "form_1098_c_url",
   "cars_helping_kids_tax_guide_url",
   "irs_vehicle_donation_guide_url",
