     "not_reported_yet",
     "500_or_less",
     "over_500",
     "not_applicable_or_unknown"
    ],
    "type": "string"
   },
   "stage": {
    "enum": [
     "before_donation",
     "request_submitted",
     "vehicle_transferred",
     "vehicle_sold",
     "charity_use_or_material_improvement",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "stage"
  ],
  "type": "object"
 },
 "name": "get_tax_document_requirements",
 "outputSchema": {
