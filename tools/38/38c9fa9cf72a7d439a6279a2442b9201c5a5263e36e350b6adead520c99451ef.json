{
 "description": "Move an order to a new fulfillment status. Optionally attach tracking when marking fulfilled. Only call after the user confirms.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "orderId": {
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "enum": [
     "unfulfilled",
     "partially_fulfilled",
     "fulfilled",
     "returned"
    ],
    "type": "string"
   },
   "trackingCarrier": {
    "type": "string"
   },
   "trackingNumber": {
    "type": "string"
   }
  },
  "required": [
   "orderId",
   "status"
  ],
  "type": "object"
 },
 "name": "transition_order_fulfillment"
}
