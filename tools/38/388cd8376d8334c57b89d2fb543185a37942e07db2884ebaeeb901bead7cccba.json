    "description": "Filter by assignee user id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Max rows (max 500, default 25).",
    "exclusiveMinimum": 0,
    "maximum": 500,
    "type": "integer"
   },
   "offset": {
    "description": "Rows to skip (default 0).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "projectId": {
    "description": "Numeric project id.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "status": {
    "description": "Filter by task status.",
    "enum": [
     "todo",
     "in_progress",
     "done",
     "closed"
    ],
    "type": "string"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "crowdin_list_tasks",
 "title": "List tasks"
}
