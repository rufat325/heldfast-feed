  "title": "Start a batch over Library pictures"
 },
 "description": "Run the same model, scene and options once for each of several pictures in the account\u2019s Library \u2014 for example image to 3D for twelve product photos. Take the scenes and models from list_models (`batches`), and each picture\u2019s asset_id from get_job or search_library on a finished image job. Nothing is charged now: each run is charged as it starts and refunded if it fails, but the balance must cover the whole quote, and for a key or connection with a monthly limit the whole quote is held against it until each picture runs (then its real cost counts) or is cancelled, refused or refunded (then nothing does). Returns a batch id at once; follow it with get_batch. Pass idempotency_key on retries so a repeat returns the same batch instead of queueing another.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "expected_credits": {
    "description": "The quote you showed the person; a different price queues nothing.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "idempotency_key": {
    "maxLength": 128,
    "minLength": 8,
    "type": "string"
   },
   "items": {
    "description": "One entry per picture: a Library image\u2019s asset_id.",
    "items": {
     "properties": {
      "asset_id": {
       "maxLength": 191,
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "maxLength": 400,
       "type": "string"
      }
     },
     "required": [
      "asset_id"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "model": {
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "notify_by_email": {
    "type": "boolean"
   },
   "options": {
    "additionalProperties": true,
    "description": "Options every run shares, as for generate; the picture field is filled per item.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "project_id": {
    "maxLength": 191,
    "minLength": 1,
    "type": "string"
   },
   "prompt": {
    "maxLength": 8000,
    "type": "string"
   },
   "scene": {
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "model",
   "scene",
   "items"
  ],
  "type": "object"
 },
