{
 "description": "Propose a decision topic for multi-agent federation consensus. Strategies: majority, supermajority, unanimity, weighted.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "default": "",
    "type": "string"
   },
   "options": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "proposal_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "quorum": {
    "default": 2,
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "strategy": {
    "default": "majority",
    "type": "string"
   },
   "topic": {
    "type": "string"
   }
  },
  "required": [
   "topic",
   "options"
  ],
  "type": "object"
 },
 "name": "propose_consensus"
}
