{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search catalog"
 },
 "description": "Search the AgentRoam travel-crypto catalog: gift cards (Airbnb, Uber, airlines, 500+ US brands), eSIM data plans (110+ destinations incl. Europe/Global region plans) and mobile top-ups (carriers in 100+ countries). Returns product handles (brandSlug + countryCode) used by the pricing and order tools. Creates no order.",
 "inputSchema": {
  "properties": {
   "country": {
    "description": "ISO country code filter (e.g. \"us\", \"mx\")",
    "type": "string"
   },
   "kind": {
    "description": "Product type filter",
    "type": "string"
   },
   "query": {
    "description": "Brand, carrier or destination to search for",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_products",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "hint": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "brandName": {
       "type": "string"
      },
      "brandSlug": {
       "type": "string"
      },
      "countryCode": {
       "type": "string"
      },
      "destination": {
       "description": "eSIM destination name",
       "type": "string"
      },
      "kind": {
       "description": "giftcard | esim | topup",
       "type": "string"
      },
      "outOfStock": {
       "type": "boolean"
      },
      "range": {
       "description": "Price range display, e.g. \"$50 \u2013 $500\"",
       "type": "string"
      },
      "url": {
       "description": "Product page on the AgentRoam site",
       "type": "string"
      }
     },
     "required": [],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [],
  "type": "object"
 },
 "title": "Search catalog"
}
