{
 "description": "Get or set CPU register values (all, specific, flags, avx512, set)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_all",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_flags",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_avx512",
        "type": "string"
       }
      },
      "required": [
       "action"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "get_specific",
        "type": "string"
       },
       "name": {
        "description": "Register name (e.g. 'rax', 'eip', 'dr0')",
        "type": "string"
       }
      },
      "required": [
       "action",
       "name"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action": {
        "const": "set",
        "type": "string"
       },
       "name": {
        "description": "Register name (e.g. 'rax', 'rcx')",
        "type": "string"
       },
       "value": {
        "description": "New value (hex string, e.g. '0x1234' or expression)",
        "type": "string"
       }
      },
      "required": [
       "action",
       "name",
       "value"
      ],
      "type": "object"
     }
    ]
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "x64dbg_registers"
}
