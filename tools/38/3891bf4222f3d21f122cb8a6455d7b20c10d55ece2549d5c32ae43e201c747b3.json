{
 "description": "Create a new Doc in the workspace.",
 "inputSchema": {
  "properties": {
   "create_page": {
    "type": "boolean"
   },
   "name": {
    "minLength": 1,
    "type": "string"
   },
   "parent": {
    "properties": {
     "id": {
      "type": "string"
     },
     "type": {
      "description": "Parent type: 4=space, 5=folder, 6=list, 12=workspace",
      "type": "integer"
     }
    },
    "required": [
     "id",
     "type"
    ],
    "type": "object"
   },
   "team_id": {
    "type": "string"
   },
   "visibility": {
    "enum": [
     "PRIVATE",
     "PUBLIC"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "clickup_create_doc"
}
