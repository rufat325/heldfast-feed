   },
   "domain": {
    "description": "The audited domain name",
    "type": "string"
   },
   "has_dmarc": {
    "description": "Presence of DMARC enforcement policies",
    "type": "boolean"
   },
   "has_spf": {
    "description": "Presence of SPF records",
    "type": "boolean"
   },
   "security_score": {
    "description": "Overall domain hygiene score from 0 to 100",
