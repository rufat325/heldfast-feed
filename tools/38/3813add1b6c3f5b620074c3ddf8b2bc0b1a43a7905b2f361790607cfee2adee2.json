{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Performs full DNS, SSL, security headers, and SPF/DMARC hygiene analysis on any target domain.",
 "inputSchema": {
  "properties": {
   "domain": {
