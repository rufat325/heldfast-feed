{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search aggregated vanlife news stories (7 languages, 400+ sources). Filter by search query, category, country, locale.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "category": {
    "description": "Category slug, e.g. camping, travel, gear, festival, industry.",
    "type": "string"
   },
   "country": {
    "description": "ISO 3166-1 alpha-2 country code.",
    "maxLength": 2,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "default": 10,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "enum": [
     "en",
     "ru",
     "de",
     "fr",
     "es",
     "pt",
     "tr"
    ],
    "type": "string"
   },
   "search": {
    "description": "Full-text search in story title.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_stories",
 "title": "Search Vanlife News"
}
