{
 "description": "Run the HGV drivers' hours calculator calculator: Driving you can still do today; Hours of driving before your 45-minute break is due; Driving left this week; Driving left this fortnight. Missing inputs fall back to their documented defaults.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "extended": {
    "default": "0",
    "description": "Driving a 10-hour extended day today?",
    "type": "string"
   },
   "lastWeek": {
    "default": 40,
    "description": "Hours driven last week",
    "maximum": 56,
    "minimum": 0,
    "type": "number"
   },
   "sinceBreak": {
    "default": 2,
    "description": "Driving since your last 45-minute break",
    "maximum": 4.5,
    "minimum": 0,
    "type": "number"
   },
   "today": {
    "default": 6,
    "description": "Hours driven so far today",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "week": {
    "default": 32,
    "description": "Hours driven this week (including today)",
    "maximum": 56,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calculate",
 "title": "HGV drivers' hours calculator"
}
