 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Inspect a video project"
 },
 "description": "Read an owned video\u2019s version, scenes, captions and editable canvas element IDs/capabilities. Optional output_id selects a clip/format; element_offset pages through the canvas inventory. Use the returned version/output and actual IDs with apply_edits for direct edits without a second Clypmint model round. Canvas image IDs name assets already in this version. Returns project data without a visual card.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "element_offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "output_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "video_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "video_id"
  ],
  "type": "object"
 },
 "name": "get_project_context",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Clypmint get_project_context result. Error results carry error; successful requests expose the identifiers and state available for the next step. Signed media stays in private metadata.",
  "properties": {
