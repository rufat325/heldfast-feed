{
 "description": "Create an Ed25519-signed receipt with pre-computed SHA-256 hashes. Use when you have already hashed the input/output data externally or need full control over receipt fields. For automatic hashing, use track_action instead. Returns the signed receipt object with receipt_id. The receipt is stored locally in SQLite and can be completed later with complete_receipt.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Action name being recorded (e.g., \"generate_code\", \"analyze_data\")",
    "type": "string"
   },
   "chain_id": {
    "description": "Chain ID (auto-generated if not provided)",
    "type": "string"
   },
   "confidence": {
    "anyOf": [
     {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Confidence score 0-1"
   },
   "constraints": {
    "description": "Array of constraint definitions to evaluate (types: max_latency_ms, max_cost_usd, min_confidence, required_fields, status_must_be, output_schema)",
    "items": {
     "additionalProperties": false,
     "properties": {
      "message": {
       "type": "string"
      },
      "type": {
       "minLength": 1,
       "type": "string"
      },
      "value": {}
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "cost_usd": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Cost in USD"
   },
   "expires_at": {
    "description": "ISO datetime when this receipt expires",
    "format": "date-time",
    "type": "string"
   },
   "input_hash": {
    "description": "Pre-computed SHA-256 hash of the input data in format \"sha256:hexstring\"",
    "type": "string"
   },
   "latency_ms": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Latency in milliseconds"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "Arbitrary metadata",
    "type": "object"
   },
   "model": {
    "description": "AI model used",
    "type": [
     "string",
     "null"
    ]
   },
   "output_hash": {
    "description": "Pre-computed SHA-256 hash of the output data in format \"sha256:hexstring\"",
    "type": [
     "string",
     "null"
    ]
   },
   "output_summary": {
    "description": "Human-readable summary of the output",
    "type": [
     "string",
     "null"
    ]
   },
   "parent_receipt_id": {
    "description": "Parent receipt ID for chains",
    "type": [
     "string",
     "null"
    ]
   },
   "receipt_type": {
    "description": "Receipt type: \"action\" (default), \"verification\", \"judgment\", or \"arbitration\"",
    "enum": [
     "action",
     "verification",
     "judgment",
     "arbitration"
    ],
    "type": "string"
   },
   "status": {
    "description": "Initial status: \"pending\" (default, complete later) or \"completed\"",
    "enum": [
     "pending",
     "completed",
     "failed",
     "timeout"
    ],
    "type": "string"
   },
   "tags": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Tags for categorization"
   },
   "tokens_in": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Input tokens"
   },
   "tokens_out": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Output tokens"
   },
   "tool_calls": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "description": "Tools called during the action"
   },
   "ttl_ms": {
    "description": "Time-to-live in milliseconds from now",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "action",
   "input_hash"
  ],
  "type": "object"
 },
 "name": "create_receipt"
}
