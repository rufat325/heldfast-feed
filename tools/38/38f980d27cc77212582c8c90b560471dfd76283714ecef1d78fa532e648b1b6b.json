{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Rank structures for a natural-language brief (\"dark aurora glow for an AI landing page\"). Returns why each matched, matching built-in palettes, and a ready-to-run example request for generate_background.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "brief": {
    "description": "What the background is for, in plain words: subject, mood, colours, where it goes.",
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "description": "How many suggestions to return (default 5).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "brief"
  ],
  "type": "object"
 },
 "name": "suggest_backgrounds",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "suggestions": {
    "description": "Best match first.",
    "items": {
     "additionalProperties": {},
     "properties": {
      "example": {
       "additionalProperties": {},
       "description": "A ready-to-run generate_background request for this brief.",
       "properties": {
        "structure": {
         "type": "string"
        }
       },
       "required": [
        "structure"
       ],
       "type": "object"
      },
      "matched": {
       "description": "Why it matched, for explaining.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "name": {
       "description": "Structure id.",
       "type": "string"
      },
      "palettes": {
       "description": "Built-in palette ids whose mood fits the brief, best first.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "score": {
       "description": "Relevance to the brief; higher is better.",
       "type": "number"
      },
      "summary": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "title",
      "summary",
      "score",
      "matched",
      "example",
      "palettes"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "suggestions"
  ],
  "type": "object"
 },
 "title": "Suggest backgrounds for a brief"
}
