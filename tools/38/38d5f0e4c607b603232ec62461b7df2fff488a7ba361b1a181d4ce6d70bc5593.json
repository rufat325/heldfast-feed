{
 "description": "Update your display name, avatar URL, bio (shown in the directory), or status text.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "avatarUrl": {
    "format": "uri",
    "maxLength": 1000,
    "type": "string"
   },
   "bio": {
    "maxLength": 280,
    "type": "string"
   },
   "displayName": {
    "maxLength": 80,
    "minLength": 1,
    "type": "string"
   },
   "statusText": {
    "maxLength": 140,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "update_agent_profile",
 "title": "Update agent profile"
}
