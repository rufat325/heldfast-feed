{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Five-field agent-native purchase path. Creates one bounded intent only when delegated authority covers the exact fee, then returns a Stripe MPP machine-payment route and a human fallback. It never claims payment before ledger verification.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "buyer": {
    "properties": {
     "acquisition_channel": {
      "description": "Optional allowlisted discovery source for privacy-minimized revenue attribution.",
      "enum": [
       "direct",
       "direct_agent",
       "mcp_registry",
       "a2a_registry",
       "ai_agents_directory",
       "toku",
       "gohirehumans",
       "toll_bench",
       "callboard",
       "recruiting_bot",
       "peerpush",
       "other"
      ],
      "type": "string"
     },
     "contact_email": {
      "format": "email",
      "maxLength": 320,
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "organization": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "organization",
     "contact_email"
    ],
    "type": "object"
   },
   "offer_id": {
    "enum": [
     "zinvyl.venture.evidence-brief.v1",
     "zinvyl.venture.prototype-scope.v1",
     "zinvyl.freight.workflow-audit.v1",
     "zinvyl.api.workflow-failure-rescue.v1",
     "zinvyl.api.failure-triage.v1",
     "zinvyl.freight.full-workflow-audit.v1"
    ],
    "type": "string"
   },
   "purchase_authority": {
    "properties": {
     "currency": {
      "const": "usd",
      "type": "string"
     },
     "delegated_authority_confirmed": {
      "const": true,
      "type": "boolean"
     },
     "maximum_amount": {
      "description": "Maximum authorized amount in minor currency units (cents); 4900 means $49.00.",
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     "terms_accepted": {
      "const": true,
      "type": "boolean"
     },
     "terms_version": {
      "const": "2026-10-05.1",
      "type": "string"
     }
    },
    "required": [
     "maximum_amount",
     "currency",
     "delegated_authority_confirmed",
     "terms_version",
     "terms_accepted"
    ],
    "type": "object"
   },
   "safe_scope_confirmed": {
    "const": true,
    "type": "boolean"
   },
   "task_summary": {
    "maxLength": 4000,
    "minLength": 20,
    "type": "string"
   }
  },
  "required": [
   "offer_id",
   "buyer",
   "task_summary",
   "purchase_authority",
   "safe_scope_confirmed"
  ],
  "type": "object"
 },
 "name": "buy_service",
 "title": "Buy one fixed-scope Zinvyl service"
}
