{
 "description": "[mode: simulated] Random / sequential user-behavior simulation to find issues.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "duration": {
    "type": "number"
   },
   "intensity": {
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "monitorMetrics": {
    "items": {
     "enum": [
      "memory",
      "cpu",
      "network",
      "render"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "projectPath": {
    "type": "string"
   },
   "userPatterns": {
    "items": {
     "enum": [
      "random",
      "sequential",
      "stress",
      "idle"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "projectPath",
   "duration"
  ],
  "type": "object"
 },
 "name": "run_simulation"
}
