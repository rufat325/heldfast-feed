{
 "_meta": {
  "heffl/page": "https://heffl.com/tools/ai-sow-generator"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Generate a scope-of-work draft using the existing Heffl DeepSeek service. Returns untrusted HTML, not legal advice. Drafts may infer details; verify before use. Provider configuration required server-side. Free, no authentication required. Rate limited.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "clientName": {
    "default": "",
    "maxLength": 200,
    "type": "string"
   },
   "deliverables": {
    "default": [],
    "items": {
     "maxLength": 300,
     "type": "string"
    },
    "maxItems": 30,
    "type": "array"
   },
   "projectGoals": {
    "maxLength": 4000,
    "minLength": 10,
    "type": "string"
   },
   "projectTitle": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "serviceCategory": {
    "default": "",
    "maxLength": 120,
    "type": "string"
   },
   "timeline": {
    "default": "",
    "maxLength": 200,
    "type": "string"
   }
  },
  "required": [
   "projectTitle",
   "projectGoals"
  ],
  "type": "object"
 },
 "name": "sow_generate",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "sow": {
    "type": "string"
   }
  },
  "required": [
   "sow"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "type": "noauth"
  }
 ],
 "title": "AI scope of work draft"
}
