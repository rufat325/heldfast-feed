{"_meta":{"fastmcp":{"tags":["client"]}},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Test webhook"},"description":"Test if a channel's (a.k.a. phone number's) webhook URL is functional.\n\nA total of 32 test cases will be run by sending sample POST requests to the user's webhook URL. During this test,\nthe user may see 32 requests being made to their webhook server.\n\nReturns the test's results, showing which cases failed, and which succeeded.","inputSchema":{"additionalProperties":false,"properties":{"channel_id":{"description":"Needs to end with 'CH'.","maxLength":8,"minLength":8,"pattern":"(?i)^.*ch$","type":"string"}},"required":["channel_id"],"type":"object"},"name":"test_webhook","outputSchema":{"properties":{"failed_count":{"default":0,"type":"integer"},"message":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"passed_count":{"default":0,"type":"integer"},"test":{"anyOf":[{"properties":{"results":{"items":{"properties":{"statusCode":{"type":"integer"},"string":{"anyOf":[{"type":"string"},{"type":"null"}],"default":null},"total_time":{"anyOf":[{"type":"number"},{"type":"null"}],"default":null},"type":{"type":"string"}},"required":["type","statusCode"],"type":"object"},"type":"array"}},"required":["results"],"type":"object"},{"type":"null"}],"default":null},"tested":{"type":"boolean"},"webhook":{"anyOf":[{"properties":{"headers":{"default":[],"items":{"additionalProperties":{"type":"string"},"type":"object"},"type":"array"},"url":{"type":"string"}},"required":["url"],"type":"object"},{"type":"null"}],"default":null}},"required":["tested"],"type":"object"},"title":"Test webhook"}
