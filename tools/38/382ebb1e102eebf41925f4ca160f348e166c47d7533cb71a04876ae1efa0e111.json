{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Previews replacing one whole tag on explicit Note IDs. Notes without the source tag are skipped. Does not recursively rename child tags, change unrelated tags, or apply to the whole collection. Requires AnkiConnect v1 and explicit confirmation of the reviewed preview to write.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"confirmReplacement":{"default":false,"type":"boolean"},"dryRun":{"default":true,"description":"Preview without modifying Anki","type":"boolean"},"expectedImpactHash":{"description":"Hash from the reviewed replacement preview","pattern":"^[a-f0-9]{64}$","type":"string"},"from":{"description":"Full existing tag name to replace. Not a prefix or search query.","maxLength":500,"minLength":1,"pattern":"^\\S+$","type":"string"},"noteIds":{"description":"Explicit selection of up to 100 Note IDs. No collection-wide option.","items":{"description":"Anki note ID","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"maxItems":100,"minItems":1,"type":"array"},"to":{"description":"One replacement tag name. Anki may reuse registered casing.","maxLength":500,"minLength":1,"pattern":"^\\S+$","type":"string"}},"required":["noteIds","from","to"],"type":"object"},"name":"replace-note-tag","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"applied":{"type":"boolean"},"blockers":{"items":{"type":"string"},"type":"array"},"changes":{"items":{"additionalProperties":false,"properties":{"noteId":{"description":"Anki note ID","exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},"removes":{"items":{"type":"string"},"type":"array"},"targetAlreadyPresent":{"type":"boolean"}},"required":["noteId","removes","targetAlreadyPresent"],"type":"object"},"maxItems":100,"type":"array"},"dryRun":{"type":"boole