{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update a VOD Station streaming channel's details (name, protocols, segment settings, encryption/DRM). This is a PUT that replaces the channel configuration, so provide the full desired state.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "channelId": {
    "description": "Channel ID to update (e.g., vs-20250821095732-xxxxxxx)",
    "type": "string"
   },
   "channelName": {
    "description": "Channel name (3-20 chars, alphanumeric + hyphen). Sent as the API 'name' field",
    "type": "string"
   },
   "drm": {
    "additionalProperties": false,
    "description": "Multi-DRM configuration",
    "properties": {
     "contentId": {
      "description": "DRM content ID (3-100 chars, alphanumeric + -/_)",
      "type": "string"
     },
     "siteId": {
      "description": "Multi-DRM site ID (from the Site List API)",
      "type": "string"
     }
    },
    "type": "object"
   },
   "encryptionList": {
    "description": "Content protection (encryption) settings per protocol",
    "items": {
     "additionalProperties": false,
     "properties": {
      "drmContentId": {
       "description": "DRM content identifier (1-200 alphanumeric)",
       "type": "string"
      },
      "drmKeyUrl": {
       "description": "DRM provider CPIX API URL",
       "type": "string"
      },
      "drmTypeCode": {
       "description": "DRM type: 21 (FairPlay), 22 (Widevine/PlayReady)",
       "type": "number"
      },
      "mediaEncryptTypeCode": {
       "description": "HLS encryption: 1 (AES-128), 2 (Sample-AES), 3 (CENC)",
       "type": "number"
      },
      "protocol": {
       "description": "Protocol this encryption applies to",
       "enum": [
        "HLS",
        "DASH"
       ],
       "type": "string"
      },
      "systemIdList": {
       "description": "DRM system identifiers (1-256 chars each)",
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "protocol"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "protocolList": {
    "description": "Streaming protocols (HLS, DASH)",
    "items": {
     "enum": [
      "HLS",
      "DASH"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "segmentDuration": {
    "description": "Playback seconds per segment (5-20)",
    "type": "number"
   },
   "segmentDurationOption": {
    "description": "Segmentation method: BASIC (default, regular intervals) or VARIABLE (keyframe-based)",
    "enum": [
     "BASIC",
     "VARIABLE"
    ],
    "type": "string"
   }
  },
  "required": [
   "channelId",
   "channelName",
   "protocolList",
   "segmentDuration"
  ],
  "type": "object"
 },
 "name": "ncloud_vodstation_update_channel"
}
