{
 "description": "Buy an outcome (YES or NO) on a prediction market via dFlow. Subject to your spending rules.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "amount": {
    "description": "Amount in USDC (e.g. \"50.00\")",
    "type": "string"
   },
   "market_ticker": {
    "description": "Market ticker (e.g. KXBTC-100K)",
    "type": "string"
   },
   "outcome": {
    "description": "Outcome to buy: YES or NO",
    "type": "string"
   },
   "reason": {
    "description": "Reason for prediction (optional)",
    "type": "string"
   }
  },
  "required": [
   "market_ticker",
   "outcome",
   "amount"
  ],
  "type": "object"
 },
 "name": "buy_prediction"
}
