{
 "_meta": {
  "ai.getemboss/agentic-access": {
   "action-class": "acting",
   "audience": "https://api.getemboss.ai",
   "audit": "required",
   "consequence": "write",
   "scope": [
    "forms:write"
   ],
   "subject": "required",
   "token": {
    "max-ttl": 3600,
    "x-api-key-lifetime": "until-revoked"
   },
   "x-billed": [
    "standard_fill"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Fill a form from values"
 },
 "description": "Fill a PDF form from structured data such as JSON or key-value answers. Fill a ready form with values keyed by field id or field label. Checkboxes take yes or no; choice fields need one of their options. flatten is reserved and not available yet. Returns a download link plus any labels that did not match (ask the user about those). Billed as one fill; the first 5 each month are free. retention (ephemeral or account_default) is accepted but changes nothing: the form keeps the setting it was created with.",
 "inputSchema": {
  "examples": [
   {
    "form_id": "11111111-2222-3333-4444-555555555555",
    "values": {
     "Email": "grace@example.com",
     "Full Name": "Grace Hopper"
    }
   }
  ],
  "properties": {
   "flatten": {
    "default": false,
    "title": "Flatten",
    "type": "boolean"
   },
   "form_id": {
    "title": "Form Id",
    "type": "string"
   },
   "retention": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Retention"
   },
   "values": {
    "additionalProperties": true,
    "title": "Values",
    "type": "object"
   }
  },
  "required": [
   "form_id",
   "values"
  ],
  "title": "fill_formArguments",
  "type": "object"
 },
 "name": "fill_form",
 "outputSchema": {
  "additionalProperties": true,
  "title": "fill_formDictOutput",
  "type": "object"
 },
 "title": "Fill a form from values"
}
