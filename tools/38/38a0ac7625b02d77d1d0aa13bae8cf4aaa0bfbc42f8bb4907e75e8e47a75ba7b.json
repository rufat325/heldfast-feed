{
 "description": "Consolidate multiple past visits (SOAP notes and/or free-text summaries) into a longitudinal summary with key findings and active diagnoses. Useful for care coordination and chart prep.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "focus": {
    "description": "Optional focus area to bias the summary (e.g. 'diabetes management').",
    "type": "string"
   },
   "patient": {
    "additionalProperties": false,
    "description": "Optional patient demographics & history to enrich the note.",
    "properties": {
     "age": {
      "exclusiveMinimum": 0,
      "type": "integer"
     },
     "allergies": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "gender": {
      "type": "string"
     },
     "medical_history": {
      "type": "string"
     },
     "medications": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "visits": {
    "description": "Chronological list of prior visits. Each needs a soap_note or a summary.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "provider": {
       "type": "string"
      },
      "soap_note": {
       "additionalProperties": false,
       "description": "Structured SOAP note for the visit (provide this OR summary).",
       "properties": {
        "assessment": {
         "type": "string"
        },
        "objective": {
         "type": "string"
        },
        "plan": {
         "type": "string"
        },
        "subjective": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "summary": {
       "description": "Free-text visit summary (provide this OR soap_note).",
       "type": "string"
      },
      "visit_date": {
       "description": "ISO 8601 date of the visit.",
       "type": "string"
      }
     },
     "required": [
      "visit_date"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "visits"
  ],
  "type": "object"
 },
 "name": "summarize_visits",
 "title": "Summarize visit history"
}
