{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Log Hive Inspection"
 },
 "description": "Log a detailed beekeeping hive inspection. ALWAYS ask for confirmation before writing.",
 "inputSchema": {
  "properties": {
   "actionsTaken": {
    "description": "Optional details of actions taken",
    "type": "string"
   },
   "cappedSeen": {
    "description": "Is capped brood present?",
    "type": "boolean"
   },
   "confirm": {
    "description": "Set to true to commit, false for dry-run preview",
    "type": "boolean"
   },
   "date": {
    "description": "Optional inspection date (YYYY-MM-DD)",
    "type": "string"
   },
   "eggsSeen": {
    "description": "Are eggs/fresh brood present?",
    "type": "boolean"
   },
   "farmId": {
    "description": "The unique farm ID",
    "type": "string"
   },
   "feedStatus": {
    "description": "Food stores status",
    "enum": [
     "Sufficient",
     "Feeding Required",
     "Starving"
    ],
    "type": "string"
   },
   "hiveId": {
    "description": "The unique hive ID",
    "type": "string"
   },
   "honeyHarvestedOz": {
    "description": "Optional honey harvested in ounces",
    "type": "number"
   },
   "idempotencyKey": {
    "description": "Unique request idempotency key",
    "type": "string"
   },
   "larvaeSeen": {
    "description": "Are larvae present?",
    "type": "boolean"
   },
   "queenSeen": {
    "description": "Was the queen seen?",
    "enum": [
     "yes",
     "no"
    ],
    "type": "string"
   },
   "varroaCount": {
    "description": "Optional mite count",
    "type": "number"
   }
  },
  "required": [
   "farmId",
   "hiveId"
  ],
  "type": "object"
 },
 "name": "log_hive_inspection"
}
