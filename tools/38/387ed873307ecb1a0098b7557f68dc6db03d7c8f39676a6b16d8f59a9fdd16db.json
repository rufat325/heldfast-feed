{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Browse job listings"
 },
 "description": "Returns indexed listings filtered by title or company keywords, function, seniority, work setting, location, pay, benefits, industry, AI role, internship and posting or discovery age. Anonymous browsing is supported; authentication raises the page-size limit. An unsorted cursor walk is stable and uncapped; sorted walks stop at 1,000. nextCursor requires identical filters and sort; null ends the walk. addedAfter supports overlapping discovery windows because listings can become servable after first discovery. Each listing's url is its Dreamwork page; sourceUrl is the employer's direct posting. Pay filters use whole annual US dollars and match posted bands reaching the bound, rather than guaranteed pay.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addedAfter": {
    "description": "Only listings Dreamwork first saw after this ISO date-time.",
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "aiRole": {
    "description": "AI-focused roles only.",
    "type": "boolean"
   },
   "bonus": {
    "description": "Only postings offering a bonus.",
    "type": "boolean"
   },
   "company": {
    "description": "Company name or domain.",
    "maxLength": 120,
    "type": "string"
   },
   "cursor": {
    "description": "`nextCursor` from the previous page. Send the same filters and sort, or it is refused.",
    "maxLength": 1024,
    "type": "string"
   },
   "equity": {
    "description": "Only postings offering equity.",
    "type": "boolean"
   },
   "function": {
    "description": "Job functions to keep, as a union.",
    "items": {
     "enum": [
      "Engineering",
      "Product",
      "Design",
      "Marketing",
      "Data Science",
      "Sales",
      "Operations",
      "Finance",
      "Legal",
      "HR",
      "Customer Success",
      "DevRel",
      "Security",
      "Research",
      "Executive"
     ],
     "type": "string"
    },
    "maxItems": 15,
    "minItems": 1,
    "type": "array"
   },
   "healthcare": {
    "description": "Only postings offering healthcare.",
    "type": "boolean"
   },
   "industry": {
    "description": "Employer industry. One of: Software & Technology, Financial Services, Insurance, Healthcare & Hospitals, Pharma & Biotech, Consulting & Professional Services, Retail & Consumer Goods, Manufacturing & Industrial, Media & Entertainment, Education, Government & Public Sector, Nonprofit & NGO, Energy & Utilities, Telecommunications, Transportation & Logistics, Real Estate & Construction, Aerospace & Defense, Hospitality & Travel, Agriculture & Food, Legal, Marketing & Advertising, Other.",
    "maxLength": 60,
    "type": "string"
   },
   "internship": {
    "description": "Internships, co-ops, and apprenticeships only.",
    "type": "boolean"
   },
   "limit": {
    "description": "Page size, 25 when omitted. Without a key the API caps it at 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "location": {
    "description": "City, region, or country. Remote roles open to that country match too. A place Dreamwork cannot resolve is refused.",
    "maxLength": 120,
    "type": "string"
   },
   "maxSalary": {
    "description": "Pay ceiling in whole annual US dollars.",
    "maximum": 9007199254740991,
    "minimum": 1000,
    "type": "integer"
   },
   "minSalary": {
    "description": "Pay floor in whole annual US dollars, e.g. 200000. A listing passes when its posted band reaches it; listings with no posted pay drop out.",
    "maximum": 9007199254740991,
    "minimum": 1000,
    "type": "integer"
   },
   "postedWithinDays": {
    "description": "Employer posting date within this many days.",
    "maximum": 90,
    "minimum": 1,
    "type": "integer"
   },
   "remote": {
    "description": "Shorthand for workSettings [\"remote\"].",
    "type": "boolean"
   },
   "search": {
    "description": "Words in the job title or company name.",
    "maxLength": 200,
    "type": "string"
   },
   "seniority": {
    "description": "Seniority levels to keep, as a union.",
    "items": {
     "enum": [
      "Junior",
      "Mid-Level",
      "Senior",
      "Staff+",
      "Director+"
     ],
     "type": "string"
    },
    "maxItems": 5,
    "minItems": 1,
    "type": "array"
   },
   "sort": {
    "description": "Order. Omit it to walk every match in a stable, unranked order; any sort stops the walk at 1,000.",
    "enum": [
     "newest",
     "pay_high",
     "pay_low",
     "featured"
    ],
    "type": "string"
   },
   "workSettings": {
    "description": "Work settings to keep, as a union. A posting that states none counts as onsite.",
    "items": {
     "enum": [
      "remote",
      "hybrid",
      "onsite"
     ],
     "type": "string"
    },
    "maxItems": 3,
    "minItems": 1,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "browse_listings",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appliedFilters": {
    "additionalProperties": false,
    "properties": {
     "addedAfter": {
      "type": "string"
     },
     "aiRole": {
      "const": true,
      "type": "boolean"
     },
     "bonus": {
      "const": true,
      "type": "boolean"
     },
     "company": {
      "type": "string"
     },
     "equity": {
      "const": true,
      "type": "boolean"
     },
     "functions": {
      "items": {
       "enum": [
        "Engineering",
        "Product",
        "Design",
        "Marketing",
        "Data Science",
        "Sales",
        "Operations",
        "Finance",
        "Legal",
        "HR",
        "Customer Success",
        "DevRel",
        "Security",
        "Research",
        "Executive"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "healthcare": {
      "const": true,
      "type": "boolean"
     },
     "industry": {
      "type": "string"
     },
     "internship": {
      "const": true,
      "type": "boolean"
     },
     "location": {
      "additionalProperties": false,
      "description": "Where the request's location label resolved: a city radius, an ISO region, an ISO country, or a named multi-country area (kind `countries`, whose ISO codes are in `countryCodes`). Remote roles open to that place also match. Null when the label named no place: the page is NOT location-filtered and the caller must not present it as filtered.",
      "properties": {
       "city": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "countryCode": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "countryCodes": {
        "anyOf": [
         {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         {
          "type": "null"
         }
        ]
       },
       "kind": {
        "enum": [
         "radius",
         "region",
         "country",
         "countries"
        ],
        "type": "string"
       },
       "radiusKm": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "description": "Distance around the city for a radius filter; null otherwise."
       },
       "regionCode": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "kind",
       "city",
       "regionCode",
       "countryCode",
       "countryCodes",
       "radiusKm"
      ],
      "type": "object"
     },
     "maxSalary": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "minSalary": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "postedWithinDays": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "search": {
      "type": "string"
     },
     "seniorities": {
      "items": {
       "enum": [
        "Junior",
        "Mid-Level",
        "Senior",
        "Staff+",
        "Director+"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "sort": {
      "enum": [
       "newest",
       "pay_high",
       "pay_low",
       "featured"
      ],
      "type": "string"
     },
     "workSettings": {
      "items": {
       "enum": [
        "remote",
        "hybrid",
        "onsite"
       ],
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "listings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "company": {
       "type": "string"
      },
      "firstSeenAt": {
       "description": "When Dreamwork first saw the listing; `addedAfter` compares this.",
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "location": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "postedAt": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "salary": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "salaryMax": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Top of the posted band, annual USD."
      },
      "salaryMin": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": -9007199254740991,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ],
       "description": "Bottom of the posted band, annual USD."
      },
      "sourceUrl": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "The employer's own posting URL. Give it only when the person asks for the direct link."
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "The listing's page on Dreamwork. Give the person this link; it carries the full description, pay, and apply flow.",
       "type": "string"
      },
      "workSetting": {
       "anyOf": [
        {
         "enum": [
          "remote",
          "hybrid",
          "onsite"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Null when the posting does not say; the onsite filter includes those."
      }
     },
     "required": [
      "id",
      "title",
      "company",
      "location",
      "workSetting",
      "salary",
      "salaryMin",
      "salaryMax",
      "postedAt",
      "firstSeenAt",
      "url",
      "sourceUrl"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "nextCursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Pass it back with the same filters for the next page; null means done."
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "pageSize": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Rows this page was allocated by the API after plan clamping; advance a sorted walk by this, never by the rows received."
   },
   "total": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Matching listings counted up to 1,000 for a sorted walk; null for an unsorted walk, which is not counted."
   },
   "totalCapped": {
    "anyOf": [
     {
      "type": "boolean"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "listings",
   "nextCursor",
   "total",
   "totalCapped",
   "pageSize",
   "appliedFilters",
   "notes"
  ],
  "type": "object"
 },
 "title": "Browse job listings"
}
