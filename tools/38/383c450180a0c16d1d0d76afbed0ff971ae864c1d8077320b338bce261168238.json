{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "cherami_mail:full"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update inbox names"
 },
 "description": "Change an inbox's internal name or outgoing sender name. The address cannot be changed.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "inbox_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "name": {
    "description": "Internal name, not shown to recipients. Omit to keep; null or blank clears it. At most 256 UTF-8 bytes, without control characters.",
    "type": [
     "string",
     "null"
    ]
   },
   "sender_name": {
    "description": "Display name recipients see on outgoing mail from now on. Omit to keep; null or blank sends with the bare address. At most 256 UTF-8 bytes, without control characters.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "inbox_id"
  ],
  "type": "object"
 },
 "name": "update_inbox",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "address": {
    "type": "string"
   },
   "created_at": {
    "description": "Absolute ISO 8601 service timestamp in UTC (Z), with millisecond precision.",
    "type": "string"
   },
   "id": {
    "type": "string"
   },
   "local_part": {
    "type": "string"
   },
   "name": {
    "type": [
     "string",
     "null"
    ]
   },
   "sender_name": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "id",
   "local_part",
   "address",
   "name",
   "sender_name",
   "created_at"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "cherami_mail:full"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Update inbox names"
}
