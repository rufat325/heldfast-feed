{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a parametric question with filters, variables, and dynamic queries - supports date ranges, dropdowns, and field filters",
 "inputSchema": {
  "properties": {
   "collection_id": {
    "description": "Collection ID to save question to (optional)",
    "type": "number"
   },
   "database_id": {
    "description": "Database ID",
    "type": "number"
   },
   "description": {
    "description": "Question description",
    "type": "string"
   },
   "name": {
    "description": "Question name",
    "type": "string"
   },
   "parameters": {
    "description": "Parameter definitions for the question",
    "items": {
     "properties": {
      "default_value": {
       "description": "Default parameter value (optional)",
       "type": "string"
      },
      "display_name": {
       "description": "Human-readable parameter name",
       "type": "string"
      },
      "name": {
       "description": "Parameter name (matches placeholder in SQL)",
       "type": "string"
      },
      "required": {
       "default": false,
       "description": "Whether parameter is required",
       "type": "boolean"
      },
      "type": {
       "description": "Parameter type and operator",
       "enum": [
        "date/single",
        "date/range",
        "string/=",
        "string/contains",
        "number/=",
        "number/between",
        "category"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type",
      "display_name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sql": {
    "description": "SQL query with parameter placeholders (e.g., {{date_range}}, {{category_filter}})",
    "type": "string"
   },
   "visualization": {
    "default": "table",
    "description": "Chart type",
    "enum": [
     "table",
     "bar",
     "line",
     "area",
     "pie",
     "number",
     "gauge",
     "funnel",
     "scatter"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "database_id",
   "sql"
  ],
  "type": "object"
 },
 "name": "mb_question_create_parametric",
 "title": "Create Parametric Question"
}
