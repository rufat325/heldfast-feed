{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Prioritize fixes"
 },
 "description": "Use when Search Console, GA4, Ahrefs or Semrush data is available, also to explain a traffic drop (pass clicks_previous): ranks the fixes by the traffic or revenue they can win. Rank SEO fixes by how much traffic they can win, using data from the user's other connected tools. With GA4, also pass each page's organic conversions (key events) or revenue, and fixes are ranked by the money they can bring instead of clicks.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "audit_id": {
    "description": "Optional id of a finished site audit, so pages are not scanned again.",
    "maxLength": 2000,
    "type": "string"
   },
   "currency": {
    "description": "Currency of revenue, for example EUR or USD.",
    "maxLength": 3,
    "type": "string"
   },
   "detail": {
    "description": "brief = short summary.",
    "enum": [
     "full",
     "brief"
    ],
    "type": "string"
   },
   "memory_key": {
    "description": "site_memory key, records this call.",
    "maxLength": 80,
    "type": "string"
   },
   "pages": {
    "items": {
     "properties": {
      "backlinks": {
       "minimum": 0,
       "type": "number"
      },
      "clicks": {
       "minimum": 0,
       "type": "number"
      },
      "clicks_previous": {
       "description": "Clicks in an earlier period of the same length, for example the same 3 months a year or 6 months ago. Pages that lost clicks get a refresh fix.",
       "minimum": 0,
       "type": "number"
      },
      "conversions": {
       "description": "Conversions (GA4 key events, sales, leads) from this page's organic visits in the same period.",
       "minimum": 0,
       "type": "number"
      },
      "ctr": {
       "description": "Click-through rate, 0-1 or a percentage.",
       "minimum": 0,
       "type": "number"
      },
      "impressions": {
       "minimum": 0,
       "type": "number"
      },
      "position": {
       "minimum": 0,
       "type": "number"
      },
      "queries": {
       "items": {
        "properties": {
         "clicks": {
          "minimum": 0,
          "type": "number"
         },
         "impressions": {
          "minimum": 0,
          "type": "number"
         },
         "position": {
          "minimum": 0,
          "type": "number"
         },
         "query": {
          "maxLength": 2000,
          "type": "string"
         },
         "volume": {
          "description": "Monthly search volume.",
          "minimum": 0,
          "type": "number"
         }
        },
        "required": [
         "query"
        ],
        "type": "object"
       },
       "maxItems": 20,
       "type": "array"
      },
      "referring_domains": {
       "minimum": 0,
       "type": "number"
      },
      "revenue": {
       "description": "Revenue from this page's organic visits in the same period.",
       "minimum": 0,
       "type": "number"
      },
      "traffic": {
       "description": "Estimated monthly organic visits (Ahrefs/Semrush) or sessions (GA4).",
       "minimum": 0,
       "type": "number"
      },
      "url": {
       "maxLength": 2048,
       "type": "string"
      }
     },
     "required": [
      "url"
     ],
     "type": "object"
    },
    "maxItems": 10,
    "minItems": 1,
    "type": "array"
   },
   "source": {
    "description": "Where the numbers come from.",
    "enum": [
     "gsc",
     "ga4",
     "ahrefs",
     "semrush",
     "other"
    ],
    "type": "string"
   }
  },
  "required": [
   "pages"
  ],
  "type": "object"
 },
 "name": "prioritize_fixes",
 "outputSchema": {
  "properties": {
   "actions": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "mode": {
    "enum": [
     "revenue",
     "conversions",
     "traffic",
     "severity"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "partial",
     "complete"
    ],
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "title": "Rank fixes by traffic impact"
}
