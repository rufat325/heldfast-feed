{
 "description": "Register an agent in the HCS directory. Requires a valid passport NFT (ownership verified via Mirror Node). Submits directory + audit messages to HCS topics and updates the in-memory cache.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "accountId": {
    "description": "Hedera account ID of the agent",
    "minLength": 1,
    "type": "string"
   },
   "capabilities": {
    "description": "Agent capabilities",
    "items": {
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "did": {
    "description": "Agent DID (did:hcs:{tokenId}:{serial})",
    "minLength": 1,
    "type": "string"
   },
   "endpoint": {
    "description": "Agent HTTP endpoint URL",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Agent display name",
    "minLength": 1,
    "type": "string"
   },
   "serial": {
    "description": "NFT serial number",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "tier": {
    "description": "Passport tier (bronze, silver, gold, platinum)",
    "minLength": 1,
    "type": "string"
   },
   "tokenId": {
    "description": "HTS passport token ID",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "did",
   "tokenId",
   "serial",
   "accountId",
   "name",
   "capabilities",
   "endpoint",
   "tier"
  ],
  "type": "object"
 },
 "name": "register_agent"
}
