{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"30\uc77c \uc804\uc5d0 \ud574\uace0\ub97c \uc608\uace0\ud558\uc9c0 \uc54a\uc558\uc744 \ub54c\uc758 \ud574\uace0\uc608\uace0\uc218\ub2f9(30\uc77c\ubd84 \ud1b5\uc0c1\uc784\uae08)\uc744 \uacc4\uc0b0\ud55c\ub2e4(\uc0ac\uc774\ud2b8 /tools/notice-pay \uc640 \uac19\uc740 \uc5d4\uc9c4). 1\uc77c \ud1b5\uc0c1\uc784\uae08 = \uc2dc\uac04\uae09 \u00d7 1\uc77c \uc18c\uc815\uadfc\ub85c\uc2dc\uac04, \uc6d4\uae09\uc740 (1\uc8fc \uc18c\uc815 + \uc8fc\ud734) \u00d7 365 \u00f7 7 \u00f7 12 \uc2dc\uac04\uc73c\ub85c \ub098\ub208\ub2e4. 30\uc77c\uc774 \uc548 \ub418\uac8c \uc608\uace0\ud588\uc5b4\ub3c4 30\uc77c\ubd84 \uc804\uc561\uc774\ub2e4. \uacc4\uc18d \uadfc\ub85c 3\uac1c\uc6d4 \ubbf8\ub9cc\uc774\uba74 \uc801\uc6a9\ud558\uc9c0 \uc54a\ub294\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"amount":{"description":"\ud1b5\uc0c1\uc784\uae08(\ub2e8\uc704 \uae30\uac04 \uae08\uc561, \uc6d0)","type":"number"},"dailyHours":{"description":"1\uc77c \uc18c\uc815\uadfc\ub85c\uc2dc\uac04","type":"number"},"dismissalDate":{"description":"\ud574\uace0\uc77c(\uadfc\ub85c\uad00\uacc4\uac00 \ub05d\ub098\ub294 \ub0a0) YYYY-MM-DD","type":"string"},"hireDate":{"description":"\uc785\uc0ac\uc77c YYYY-MM-DD","type":"string"},"noticeDate":{"description":"\ud574\uace0\ub97c \uc54c\ub9b0 \ub0a0 YYYY-MM-DD(\ube44\uc6b0\uba74 \uc608\uace0\ud558\uc9c0 \uc54a\uc740 \uac83)","type":"string"},"unit":{"description":"\uc784\uae08 \ub2e8\uc704 \u2014 hour(\uc2dc\uae09)\u00b7day(\uc77c\uae09)\u00b7week(\uc8fc\uae09)\u00b7month(\uc6d4\uae09)","enum":["hour","day","week","month"],"type":"string"},"weeklyHours":{"description":"1\uc8fc \uc18c\uc815\uadfc\ub85c\uc2dc\uac04(\uc8fc\uae09\u00b7\uc6d4\uae09\uc77c \ub54c \ud544\uc694)","type":"number"}},"required":["unit","amount","dailyHours","hireDate","dism