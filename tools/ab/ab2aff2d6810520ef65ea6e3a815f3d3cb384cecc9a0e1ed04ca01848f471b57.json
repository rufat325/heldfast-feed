{
 "annotations": {
  "destructiveHint": false
 },
 "description": "Add users to a Cloud DB for MongoDB instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudMongoDbInstanceNo": {
    "description": "Cloud MongoDB instance number",
    "type": "string"
   },
   "cloudMongoDbUserList": {
    "description": "List of users to add",
    "items": {
     "additionalProperties": false,
     "properties": {
      "authority": {
       "description": "User authority (e.g., READ, READ_WRITE, DB_ADMIN)",
       "type": "string"
      },
      "databaseName": {
       "description": "Database name the user belongs to",
       "type": "string"
      },
      "name": {
       "description": "User name",
       "type": "string"
      },
      "password": {
       "description": "User password",
       "type": "string"
      }
     },
     "required": [
      "name",
      "password",
      "databaseName",
      "authority"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "cloudMongoDbInstanceNo",
   "cloudMongoDbUserList"
  ],
  "type": "object"
 },
 "name": "ncloud_add_mongodb_users"
}
