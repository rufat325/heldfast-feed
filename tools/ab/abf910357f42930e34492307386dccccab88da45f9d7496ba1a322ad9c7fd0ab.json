{
 "description": "Gestiona asistencia. Acciones: list (page, limit, user_id, start_date, end_date), clock_in, clock_out, status (actual del usuario), summary, members.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_type": {
    "type": "string"
   },
   "action": {
    "enum": [
     "list",
     "clock_in",
     "clock_out",
     "status",
     "summary",
     "members"
    ],
    "type": "string"
   },
   "end_date": {
    "type": "string"
   },
   "in_time": {
    "type": "string"
   },
   "ip_address": {
    "type": "string"
   },
   "latitude": {
    "type": "string"
   },
   "limit": {
    "default": 20,
    "type": "number"
   },
   "longitude": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "out_time": {
    "type": "string"
   },
   "page": {
    "default": 1,
    "type": "number"
   },
   "start_date": {
    "type": "string"
   },
   "user_id": {
    "type": "number"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "attendance"
}
