{
 "_meta": {
  "openai/outputTemplate": "ui://soclo/chat-ads/v2.html",
  "openai/widgetAccessible": true,
  "securitySchemes": [
   {
    "scopes": [
     "plan:create"
    ],
    "type": "oauth2"
   }
  ],
  "ui": {
   "resourceUri": "ui://soclo/chat-ads/v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Prepare guides for planning an edit"
 },
 "description": "Return Jev-selected complete guides and media guidance for authoring an editor project, plus the authoring contracts. Pass the owner-selected input and a stable UUID clientRequestId. Free; saves nothing and spends no credits.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "catalogueVersion": {
    "type": "string"
   },
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "input": {
    "additionalProperties": false,
    "properties": {
     "actors": {
      "description": "Owner-selected saved actors in the requested order.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "actorVersion": {
         "description": "Exact current actorVersion from soclo_actors_current.",
         "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
         "type": "string"
        },
        "description": {
         "type": "string"
        },
        "id": {
         "description": "Owner actor id from soclo_actors_list/soclo_actors_current.",
         "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "referenceIds": {
         "description": "Empty; MAIN resolves actor images itself.",
         "items": {
          "type": "string"
         },
         "maxItems": 0,
         "type": "array"
        }
       },
       "required": [
        "id",
        "actorVersion",
        "name",
        "description",
        "referenceIds"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "brand": {
      "additionalProperties": false,
      "description": "Read the connected brand with soclo_brand_get and carry it here; do not invent brand facts.",
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "facts": {
        "description": "Brand facts the plan may rely on. Empty is allowed.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "name": {
        "type": "string"
       },
       "visualDirection": {
        "type": "string"
       }
      },
      "required": [
       "enabled",
       "name",
       "facts",
       "visualDirection"
      ],
      "type": "object"
     },
     "brief": {
      "description": "The advert brief in the owner\u2019s own words. Required and non-blank.",
      "type": "string"
     },
     "constraints": {
      "additionalProperties": false,
      "properties": {
       "aspectRatio": {
        "description": "For example \"9:16\" or \"1:1\".",
        "type": "string"
       },
       "durationMode": {
        "description": "\"target\" requires a positive durationSeconds. Omitted keeps historical exact semantics.",
        "enum": [
         "target",
         "exact"
        ],
        "type": "string"
       },
       "durationSeconds": {
        "description": "Positive seconds, or null for no fixed length.",
        "type": [
         "number",
         "null"
        ]
       },
       "exactLines": {
        "description": "Lines that must appear word-for-word in the spoken dialogue.",
        "items": {
         "type": "string"
        },
        "type": "array"
       },
       "language": {
        "type": "string"
       },
       "productionNotes": {
        "type": "string"
       },
       "resolution": {
        "description": "Leave unset to use the chosen model\u2019s default resolution.",
        "enum": [
         "480p",
         "720p",
         "768p",
         "1080p",
         "2k",
         "4k"
        ],
        "type": "string"
       }
      },
      "required": [
       "aspectRatio",
       "durationSeconds",
       "language",
       "exactLines",
       "productionNotes"
      ],
      "type": "object"
     },
     "mode": {
      "description": "\"advanced\" keeps an explicit modelId; when no model is named, either mode uses automatic selection.",
      "enum": [
       "easy",
       "advanced"
      ],
      "type": "string"
     },
     "modelId": {
      "anyOf": [
       {
        "enum": [
         "wan3prime",
         "seedance25",
         "minimaxh3max",
         "kling3",
         "kling3pro",
         "veo31fast",
         "veo31",
         "veo31lite",
         "veo31lite720"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "A supported video model to preserve, or null/omitted for automatic model selection."
     },
     "references": {
      "description": "Exact checked image selections, preserved in owner order. References are per-take inputs: one distinct photo per scene is fine. One scene may cite at most nine references (no current provider accepts more); the chosen model may accept fewer per take and names the affected references when it refuses.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "description": {
         "type": "string"
        },
        "id": {
         "description": "Owner Library or Brand Kit image asset id.",
         "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
         "type": "string"
        },
        "kind": {
         "const": "image",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "mediaVersion": {
         "description": "Exact current asset updated_at; MAIN checks version and reviewed evidence.",
         "minLength": 1,
         "type": "string"
        },
        "role": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "kind",
        "label",
        "role",
        "description",
        "mediaVersion"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "source": {
      "const": "manual",
      "description": "Always \"manual\" here. Autopilot is a server-owned source and is not importable by a host.",
      "type": "string"
     },
     "template": {
      "anyOf": [
       {
        "additionalProperties": false,
        "properties": {
         "tileId": {
          "description": "The chosen look\u2019s tile id, exactly as the catalogue spells it.",
          "maxLength": 120,
          "minLength": 1,
          "type": "string"
         },
         "tileVersion": {
          "description": "The tile version that id was chosen at.",
          "maximum": 9007199254740991,
          "minimum": -9007199254740991,
          "type": "integer"
         }
        },
        "required": [
         "tileId",
         "tileVersion"
        ],
        "type": "object"
       },
       {
        "type": "null"
       }
      ],
      "description": "The owner-facing look to plan against. Null or omitted means no template."
     },
     "voices": {
      "description": "Exact Soclo-hosted selection from soclo_hosted_voices_autoload after the owner hears its private audition and transcript. MAIN revalidates the original owner, actor and binding before new work.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "actorVoice": {
         "additionalProperties": false,
         "properties": {
          "actorId": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "actorVersion": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "bindingVersion": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "ownerId": {
           "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$",
           "type": "string"
          },
          "revision": {
           "exclusiveMinimum": 0,
           "maximum": 9007199254740991,
           "type": "integer"
          },
          "version": {
           "const": "actor-voice.1",
           "type": "string"
          },
          "voice": {
           "additionalProperties": false,
           "properties": {
            "accountScope": {
             "const": "soclo_hosted",
             "type": "string"
            },
            "description": {
             "maxLength": 1000,
             "minLength": 1,
             "type": "string"
            },
            "language": {
             "maxLength": 35,
             "minLength": 2,
             "type": "string"
            },
            "name": {
             "maxLength": 200,
             "minLength": 1,
             "type": "string"
            },
            "provider": {
             "const": "elevenlabs",
             "type": "string"
            },
            "voiceId": {
             "maxLength": 128,
             "minLength": 1,
             "type": "string"
            }
           },
           "required": [
            "provider",
            "accountScope",
            "voiceId",
            "name",
            "description",
            "language"
           ],
           "type": "object"
          }
         },
         "required": [
          "version",
          "ownerId",
          "actorId",
          "actorVersion",
          "bindingVersion",
          "revision",
          "voice"
         ],
         "type": "object"
        },
        "id": {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        "label": {
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        },
        "language": {
         "maxLength": 35,
         "minLength": 2,
         "type": "string"
        }
       },
       "required": [
        "id",
        "label",
        "language",
        "actorVoice"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "brief",
     "source",
     "mode",
     "brand",
     "actors",
     "references",
     "voices",
     "constraints"
    ],
    "type": "object"
   }
  },
  "required": [
   "input",
   "clientRequestId"
  ],
  "type": "object"
 },
 "name": "soclo_editor_prepare",
 "title": "Prepare guides for planning an edit"
}
