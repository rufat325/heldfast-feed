{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Execution timeline"
 },
 "description": "Render an n8n execution as a per-node timeline: start offset, duration, items in/out, error flag. Complements execution_explain \u2014 that one surfaces *why*, this surfaces *when*. Output is a markdown table sorted by start time. Deterministic.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "execution": {
    "anyOf": [
     {
      "additionalProperties": {},
      "type": "object"
     },
     {
      "type": "string"
     }
    ],
    "description": "n8n execution payload (must include `data.resultData.runData`)."
   }
  },
  "required": [
   "execution"
  ],
  "type": "object"
 },
 "name": "execution_timeline",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "row_count": {
    "type": "integer"
   },
   "rows": {
    "description": "Per-node-run timing and item counts, sorted by start_ms.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "duration_ms": {
       "type": "number"
      },
      "error_message": {
       "type": [
        "string",
        "null"
       ]
      },
      "had_error": {
       "type": "boolean"
      },
      "items_in": {
       "anyOf": [
        {
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "items_out": {
       "type": "integer"
      },
      "node": {
       "type": "string"
      },
      "run_index": {
       "type": "integer"
      },
      "start_ms": {
       "type": "number"
      }
     },
     "required": [
      "node",
      "run_index",
      "start_ms",
      "duration_ms",
      "items_in",
      "items_out",
      "had_error",
      "error_message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_ms": {
    "description": "Wall-clock duration of the whole execution in milliseconds.",
    "type": "number"
   }
  },
  "required": [
   "rows",
   "total_ms",
   "row_count"
  ],
  "type": "object"
 },
 "title": "Render an execution as a per-node timeline"
}
