  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/pre-action-check-request.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Caller-supplied action context and claim evidence for deterministic pre-action routing. The check can continue, request evidence, require human approval, or stop. It does not authenticate the actor, verify factual truth, enforce the decision, or authorize the action.",
  "properties": {
   "actor": {
    "$ref": "#/$defs/actor"
   },
   "approval": {
    "$ref": "#/$defs/approval"
   },
   "claims": {
    "items": {
     "$ref": "#/$defs/claim"
    },
    "minItems": 1,
    "type": "array"
   },
   "evidence": {
    "items": {
     "$ref": "#/$defs/evidence_item"
    },
    "type": "array"
   },
   "policy_context": {
    "$ref": "#/$defs/policy_context"
   },
   "requested_action": {
    "minLength": 1,
    "type": "string"
   },
   "risk_tier": {
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "run_id": {
    "description": "Caller-generated correlation identifier. Resubmit the same run_id after adding evidence or approval.",
    "minLength": 1,
    "type": "string"
   },
   "target": {
    "$ref": "#/$defs/target"
   },
   "unsupported_claims": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "run_id",
   "actor",
   "requested_action",
   "target",
   "risk_tier",
   "claims",
   "evidence"
  ],
  "title": "PreActionCheckRequest",
  "type": "object",
  "x-schema-version": "1"
 },
 "name": "pre_action_check",
 "outputSchema": {
  "$id": "https://github.com/vassiliylakhonin/agenda-intelligence-md/schemas/v1/pre-action-check-response.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Deterministic routing result for a caller-controlled action boundary. The response reports readiness; the caller remains responsible for enforcement, authentication, authorization, approval storage, and the action itself.",
  "properties": {
   "approval_required": {
    "type": "boolean"
   },
   "blocking_gaps": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "decision": {
    "enum": [
     "continue",
     "request_evidence",
     "require_approval",
     "stop"
    ],
    "type": "string"
   },
   "decision_id": {
    "minLength": 1,
    "type": "string"
   },
   "evidence_requests": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "human_review_required": {
    "type": "boolean"
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "not_authorization_notice": {
    "minLength": 1,
    "type": "string"
   },
   "policy_checks": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "check_id": {
       "minLength": 1,
       "type": "string"
      },
      "evidence_gap": {
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "enum": [
        "passed",
        "needs_evidence",
        "failed"
       ],
       "type": "string"
      }
     },
     "required": [
      "check_id",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "policy_version": {
    "const": "pre-action-check.v1",
    "type": "string"
   },
   "reason_code": {
    "enum": [
     "evidence_ready",
     "evidence_gaps",
     "unsafe_claims",
     "policy_check_failed",
     "approval_required_for_risk",
     "approval_rejected"
    ],
    "type": "string"
   },
   "receipt": {
    "description": "Short-lived readiness receipt attached by decision_check. The legacy pre_action_check response omits it.",
    "oneOf": [
     {
      "type": "null"
     },
     {
      "additionalProperties": false,
      "properties": {
       "action_hash": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "expires_at": {
        "format": "date-time",
        "type": "string"
       },
       "format": {
        "const": "agenda-readiness-receipt+jws",
        "type": "string"
       },
       "issued_at": {
        "format": "date-time",
        "type": "string"
       },
       "receipt_id": {
        "minLength": 1,
        "type": "string"
       },
       "request_hash": {
        "pattern": "^sha256:[a-f0-9]{64}$",
        "type": "string"
       },
       "token": {
        "pattern": "^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$",
        "type": "string"
       },
       "verification_tool": {
        "const": "decision_verify",
        "type": "string"
       }
      },
      "required": [
       "format",
       "token",
       "receipt_id",
       "issued_at",
       "expires_at",
       "request_hash",
       "action_hash",
       "verification_tool"
      ],
      "type": "object"
     }
    ]
   },
   "receipt_status": {
    "description": "Present on decision_check. unavailable fails the signed Gate path closed.",
    "enum": [
     "signed",
     "unavailable"
    ],
    "type": "string"
   },
   "run_id": {
    "minLength": 1,
    "type": "string"
   },
   "verification": {
    "additionalProperties": true,
    "required": [
     "verdict",
     "evidence_gaps",
     "owner_actions"
    ],
    "type": "object"
   }
  },
  "required": [
   "decision_id",
   "run_id",
   "policy_version",
   "decision",
   "reason_code",
   "blocking_gaps",
   "evidence_requests",
   "approval_required",
   "human_review_required",
   "verification",
   "not_authorization_notice",
   "limitations"
  ],
  "title": "PreActionCheckResponse",
  "type": "object",
  "x-schema-version": "1"
 }
}
