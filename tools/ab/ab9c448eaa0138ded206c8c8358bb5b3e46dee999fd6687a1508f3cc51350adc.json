 "description": "\u83b7\u53d6\u67d0\u4e2a WebSocket \u8fde\u63a5\u7684\u6d88\u606f\u3002\u91cd\u8981\uff1a\u5bf9\u4e8e\u4e8c\u8fdb\u5236/protobuf \u6d88\u606f\uff08\u5982\u76f4\u64ad\u6d41\uff09\uff0c\u8bf7\u5148\u4f7f\u7528 analyze_websocket_messages \u4e86\u89e3\u6d88\u606f\u7c7b\u578b\uff0c\u518d\u901a\u8fc7 groupId \u53c2\u6570\u7b5b\u9009\u7279\u5b9a\u7c7b\u578b\u3002\u9ed8\u8ba4\u6a21\u5f0f\u4ec5\u663e\u793a\u6458\u8981\u3002",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "direction": {
    "description": "Filter by direction: \"sent\" or \"received\".",
    "enum": [
     "sent",
     "received"
    ],
    "type": "string"
   },
   "groupId": {
    "description": "Filter by group ID (A, B, C, ...). Get group IDs from analyze_websocket_messages first.",
    "type": "string"
   },
   "pageIdx": {
    "description": "Page number (0-based).",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "default": 10,
    "description": "Messages per page. Defaults to 10.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "show_content": {
    "default": false,
    "description": "Set to true to show full message payload. Default false (summary only) to avoid large binary output.",
    "type": "boolean"
   },
   "wsid": {
    "description": "The wsid of the WebSocket connection.",
    "type": "number"
   }
  },
  "required": [
   "wsid"
  ],
  "type": "object"
 },
 "name": "get_websocket_messages"
}
