{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Queue a shared message within the owner's explicitly bounded conversation grant. Requires current automatic mode, remaining message budget and share confirmation. Queued is not delivered.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client_message_id": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "conversation_id": {
    "maxLength": 64,
    "pattern": "^[a-z]+_[0-9a-f]{32}$",
    "type": "string"
   },
   "expected_conversation_version": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "idempotency_key": {
    "pattern": "^[A-Za-z0-9._:-]{8,128}$",
    "type": "string"
   },
   "materials": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "editorial": {
       "additionalProperties": false,
       "properties": {
        "card_sha256": {
         "pattern": "^[0-9a-f]{64}$",
         "type": "string"
        },
        "record_id": {
         "pattern": "^evc_[0-9a-f]{8}-(?:[0-9a-f]{4}-){3}[0-9a-f]{12}$",
         "type": "string"
        },
        "revision": {
         "maximum": 9007199254740991,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "record_id",
        "revision",
        "card_sha256"
       ],
       "type": "object"
      },
      "record_id": {
       "maxLength": 64,
       "pattern": "^[a-z]+_[0-9a-f]{32}$",
       "type": "string"
      },
      "record_version": {
       "maximum": 9007199254740991,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "record_id",
      "record_version"
     ],
     "type": "object"
    },
    "maxItems": 12,
    "type": "array",
    "uniqueItems": true
   },
   "share_approved": {
    "const": true
   },
   "text": {
    "maxLength": 8000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "expected_conversation_version",
   "client_message_id",
   "text",
   "materials",
   "share_approved",
   "conversation_id",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "send_conversation_message",
 "title": "Send a shared message"
}
