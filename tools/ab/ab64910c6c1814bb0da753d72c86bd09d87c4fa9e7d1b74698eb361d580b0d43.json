{
 "description": "Create a new test scenario (multi-step test flow). Use list_test_scenarios first to find valid folderIds and determine ordering.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "default": "",
    "description": "Scenario description",
    "type": "string"
   },
   "folderId": {
    "description": "Folder ID to place the scenario in",
    "type": "number"
   },
   "name": {
    "description": "Scenario name",
    "type": "string"
   },
   "options": {
    "additionalProperties": false,
    "description": "Execution options",
    "properties": {
     "delayItem": {
      "default": 0,
      "type": "number"
     },
     "iterationCount": {
      "default": 1,
      "type": "number"
     },
     "onError": {
      "default": "ignore",
      "type": "string"
     },
     "readGlobalCookie": {
      "default": false,
      "type": "boolean"
     },
     "runnerId": {
      "default": 0,
      "type": "number"
     },
     "saveGlobalCookie": {
      "default": false,
      "type": "boolean"
     },
     "saveReportDetail": {
      "default": "all",
      "type": "string"
     },
     "saveVariables": {
      "default": true,
      "type": "boolean"
     },
     "threadCount": {
      "default": 1,
      "type": "number"
     },
     "useDataSetId": {
      "default": -1,
      "type": "number"
     }
    },
    "type": "object"
   },
   "ordering": {
    "default": 0,
    "description": "Sort order within folder",
    "type": "number"
   },
   "priority": {
    "default": 2,
    "description": "Priority (1=high, 2=medium, 3=low)",
    "type": "number"
   },
   "tags": {
    "default": [],
    "description": "Tag names to apply",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "folderId"
  ],
  "type": "object"
 },
 "name": "create_test_scenario"
}
