{"description":"Perform a structured pan, fling, swipe, pinch, rotate, transform, tap, or drag gesture. Select the gesture kind, then provide only the inputs that apply to that kind. A tap touches 2 to 5 points at once; repeat it with count and pauseMs. Times out after 90s.","inputSchema":{"additionalProperties":false,"properties":{"count":{"description":"Tap repetitions; the same contacts run this many times.","maximum":200,"minimum":1,"type":"integer"},"debug":{"description":"Enable debug diagnostics.","type":"boolean"},"degrees":{"description":"Rotation in degrees.","type":"number"},"delta":{"additionalProperties":false,"description":"Movement delta for pan or transform gestures.","properties":{"x":{"type":"number"},"y":{"type":"number"}},"required":["x","y"],"type":"object"},"destination":{"description":"Drag destination @ref or selector.","type":"string"},"destinationHoldMs":{"description":"Hold before releasing at the destination.","maximum":10000,"minimum":0,"type":"integer"},"device":{"description":"Device name; ids go in udid or serial.","type":"string"},"deviceTarget":{"description":"Device form factor.","enum":["mobile","tv","desktop"],"type":"string"},"direction":{"description":"Fling direction.","enum":["up","down","left","right"],"type":"string"},"distance":{"description":"Fling distance.","minimum":0,"type":"integer"},"durationMs":{"description":"Pan/transform duration.","maximum":10000,"minimum":16,"type":"integer"},"holdMs":{"description":"Tap contact hold duration.","maximum":10000,"minimum":16,"type":"integer"},"includeCost":{"description":"Add agent cost (cost.wallClockMs, \u2026) to the result, returned as JSON text.","type":"boolean"},"kind":{"description":"Gesture variant.","enum":["pan","fling","swipe","pinch","rotate","transform","tap","drag"],"type":"string"},"mcpOutputFormat":{"description":"Result text: compact optimized (default) or the full result as JSON (larger).","enum":["optimized","json"],"type":"string"},"moveMs":{"description":"D