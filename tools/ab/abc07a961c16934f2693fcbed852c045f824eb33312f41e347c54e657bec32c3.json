      "minLength": 1,
      "type": "string"
     },
     "event_id": {
      "description": "The unique event ID.",
      "maxLength": 80,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9-]+$",
      "type": "string"
     },
     "include_alternates": {
      "default": false,
      "description": "Include alternate and extended lines.",
      "type": "boolean"
     },
     "limit": {
      "default": 25,
      "description": "Maximum ranked prices to return.",
      "maximum": 100,
      "minimum": 1,
      "type": "integer"
     },
     "line": {
      "description": "Exact line to match. Omit to allow main-line ranking.",
      "maxLength": 32,
      "pattern": "^[+-]?(?:[0-9]+(?:\\.[0-9]*)?|\\.[0-9]+)$",
      "type": "string"
     },
     "market_id": {
      "description": "Market ID to price.",
      "maximum": 2147483647,
      "minimum": 1,
      "type": "integer"
     },
     "market_participant_id": {
      "description": "Exact market participant row to price.",
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "participant_id": {
      "description": "Participant to price.",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
     },
     "participant_type": {
      "description": "Participant type identifier.",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
     },
     "period_id": {
      "default": 0,
      "description": "Market period. Defaults to the full-game period.",
      "maximum": 2147483647,
      "minimum": 0,
      "type": "integer"
     },
     "side": {
      "allOf": [
       {
        "enum": [
         "over",
         "under"
        ],
        "type": "string"
       },
       {
        "maxLength": 256,
        "type": "string"
       }
      ],
      "description": "Use over or under to rank total-style markets by bettor-favorable line before price."
     }
    },
    "required": [
     "event_id",
     "market_id"
    ],
    "type": "object"
   }
  },
