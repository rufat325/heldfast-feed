{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "croncool:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check webhook delivery health"
 },
 "description": "Use this when someone asks whether their Croncool webhooks are delivering, failing or were disabled. Returns each subscription's endpoint origin, events, active state, consecutive failures, auto-disabled flag and last delivery time, 20 by default. Works only with a signed-in user session, not an API key. Not for changing or re-enabling a webhook.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "How many subscriptions to return, from 1 to 100; defaults to 20",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Only subscriptions of this project",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_webhook_subscriptions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "subscriptions": {
    "description": "Endpoint origins and delivery health; autoDisabled marks a subscription switched off after 20 consecutive failures. Full endpoint paths and queries, signing secrets, payloads and ownership fields are excluded.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "active": {
       "type": [
        "boolean",
        "null"
       ]
      },
      "autoDisabled": {
       "type": "boolean"
      },
      "consecutiveFailures": {
       "minimum": 0,
       "type": "integer"
      },
      "creationTime": {
       "$ref": "#/properties/subscriptions/items/properties/lastDeliveryTime"
      },
      "endpointOrigin": {
       "anyOf": [
        {
         "maxLength": 2048,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "events": {
       "items": {
        "maxLength": 60,
        "type": "string"
       },
       "maxItems": 10,
       "type": "array"
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 128,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastDeliveryTime": {
       "anyOf": [
        {
         "maxLength": 32,
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "lastEditTime": {
       "$ref": "#/properties/subscriptions/items/properties/lastDeliveryTime"
      },
      "projectId": {
       "$ref": "#/properties/subscriptions/items/properties/id"
      }
     },
     "required": [
      "id",
      "projectId",
      "endpointOrigin",
      "events",
      "active",
      "consecutiveFailures",
      "autoDisabled",
      "lastDeliveryTime",
      "creationTime",
      "lastEditTime"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "subscriptions"
  ],
  "type": "object"
 },
 "title": "Check webhook delivery health"
}
