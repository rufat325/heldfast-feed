{
 "description": "[skiplagged] Fetch room-level availability, pricing, and amenities for a specific hotel and stay dates.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkin": {
    "description": "Check-in date (YYYY-MM-DD format)",
    "type": "string"
   },
   "checkout": {
    "$ref": "#/properties/checkin",
    "description": "Check-out date (YYYY-MM-DD format)"
   },
   "hotelId": {
    "description": "Hotel ID (from search results) to fetch detailed availability for",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "live": {
    "default": true,
    "description": "Use live rates (includes booking links). Disable for faster, less accurate cached rates.",
    "type": "boolean"
   },
   "numAdults": {
    "default": 2,
    "description": "Number of adults (default: 2, max: 10)",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "numChildren": {
    "default": 0,
    "description": "Number of children (default: 0, max: 10)",
    "maximum": 10,
    "minimum": 0,
    "type": "integer"
   },
   "numRooms": {
    "default": 1,
    "description": "Number of rooms (default: 1, max: 5)",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "hotelId",
   "checkin",
   "checkout"
  ],
  "type": "object"
 },
 "name": "skiplagged_sk_hotel_details"
}
