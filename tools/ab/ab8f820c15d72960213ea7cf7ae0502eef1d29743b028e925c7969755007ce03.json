{
 "description": "Apply a payment method to the checkout session. Supports card, AP2 token, or x402.",
 "inputSchema": {
  "properties": {
   "checkoutId": {
    "description": "Checkout session ID",
    "type": "string"
   },
   "paymentMethod": {
    "description": "Payment method type",
    "enum": [
     "card",
     "ap2",
     "x402",
     "pix",
     "wallet"
    ],
    "type": "string"
   },
   "paymentToken": {
    "description": "Payment token or AP2 authorization ID",
    "type": "string"
   }
  },
  "required": [
   "checkoutId",
   "paymentMethod"
  ],
  "type": "object"
 },
 "name": "apply_payment"
}
