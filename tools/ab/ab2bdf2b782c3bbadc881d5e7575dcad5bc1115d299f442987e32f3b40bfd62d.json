    "type": "integer"
   },
   "search": {
    "description": "Search by service title, description, or provider name",
    "type": "string"
   },
   "sort": {
    "description": "Sort order (default: newest)",
    "enum": [
     "newest",
     "price-low",
     "price-high"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "browse_services"
}
