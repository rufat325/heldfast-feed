  "title": "College Search"
 },
 "description": "Search US colleges and universities by name, state, control type, size, or accreditor. Returns matching institutions with location, control, predominant degree, and enrollment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "accreditor": {
    "description": "Substring match against the school's institutional accreditor.",
    "type": "string"
   },
   "control": {
    "description": "Institutional control.",
    "enum": [
     "public",
     "private_nonprofit",
     "private_forprofit"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results, 1-100. Default 25.",
    "type": "number"
   },
   "name": {
    "description": "Substring of the institution name.",
    "type": "string"
   },
   "size": {
    "description": "Carnegie size bucket.",
    "enum": [
     "very_small",
     "small",
     "medium",
     "large",
     "very_large"
    ],
    "type": "string"
   },
   "state": {
    "description": "Two-letter state code (e.g. TX).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "college_search"
}
