{
 "description": "Create a new guest in the discover stage. Wraps POST /api/v1/guests. Fit scoring runs asynchronously after creation; call list_guests or the guest detail endpoint shortly after to see fitScore populate.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bio": {
    "description": "Short bio (max 2000 chars)",
    "maxLength": 2000,
    "type": "string"
   },
   "company": {
    "description": "Guest company",
    "type": "string"
   },
   "email": {
    "description": "Guest email",
    "type": "string"
   },
   "name": {
    "description": "Guest full name",
    "type": "string"
   },
   "priority": {
    "description": "Initial priority",
    "enum": [
     "low",
     "medium",
     "high"
    ],
    "type": "string"
   },
   "title": {
    "description": "Guest job title",
    "type": "string"
   },
   "topics": {
    "description": "Topics the guest speaks on, e.g. [\"AI\", \"startups\"]",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "name",
   "email",
   "title",
   "company"
  ],
  "type": "object"
 },
 "name": "add_guest",
 "title": "Add a guest"
}
