{
 "_meta": {
  "ui": {
   "resourceUri": "ui://pechincha/app.html"
  },
  "ui/resourceUri": "ui://pechincha/app.html"
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Check whether Pechincha.ai has an active deal for a product page URL from an online store. Returns the deal (price in BRL, discount, store, coupon, purchase link) and the lowest price across stores, or says there is none. Content in Brazilian Portuguese.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "Product page URL at the store",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_product_url",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deal": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "coupon_code": {
        "type": [
         "string",
         "null"
        ]
       },
       "discount_percent": {
        "anyOf": [
         {
          "type": "integer"
         },
         {
          "type": "null"
         }
        ]
       },
       "id": {
        "type": "string"
       },
       "image_url": {
        "description": "Product photo",
        "type": [
         "string",
         "null"
        ]
       },
       "old_price": {
        "description": "BRL, price before the discount",
        "type": [
         "number",
         "null"
        ]
       },
       "price": {
        "description": "BRL",
        "type": [
         "number",
         "null"
        ]
       },
       "published_at": {
        "description": "ISO 8601",
        "type": [
         "string",
         "null"
        ]
       },
       "purchase_url": {
        "type": [
         "string",
         "null"
        ]
       },
       "store": {
        "type": [
         "string",
         "null"
        ]
       },
       "title": {
        "type": "string"
       },
       "url": {
        "description": "Deal page on Pechincha.ai",
        "type": "string"
       }
      },
      "required": [
       "id",
       "title",
       "price",
       "old_price",
       "discount_percent",
       "store",
       "coupon_code",
       "published_at",
       "url",
       "image_url",
       "purchase_url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "null when Pechincha.ai has no active deal for the URL"
   },
   "lowest_price": {
    "description": "BRL, lowest price across stores",
    "type": [
     "number",
     "null"
    ]
   },
   "lowest_price_store": {
    "type": [
     "string",
     "null"
    ]
   },
   "product_id": {
    "type": [
     "string",
     "null"
    ]
   },
   "product_url": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "deal",
   "lowest_price",
   "lowest_price_store",
   "product_id",
   "product_url"
  ],
  "type": "object"
 },
 "title": "Check product URL"
}
