{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Start website privacy check (Hugo Check)"},"description":"Starts the free frag.hugo website check (Hugo Check) for a public URL: cookies and tracking before consent, consent banner, Google Fonts, privacy policy and imprint, TLS and security headers, e-mail records, accessibility and shop duties. Returns the result directly if it is ready within about 20 seconds, otherwise a scan_id for get_website_check_result. The same URL within one hour returns the same scan. Limited to 3 new checks per hour per connection. Not legal advice.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"sprache":{"description":"Output language. Default: German if the input is German, otherwise English.","enum":["de","en"],"type":"string"},"url":{"description":"Public website address, http or https, e.g. \"https://www.example.de\"","maxLength":2000,"minLength":4,"type":"string"}},"required":["url"],"type":"object"},"name":"start_website_check","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"ergebnis":{"anyOf":[{"additionalProperties":false,"properties":{"geprueft_am":{"type":"string"},"gepruefte_url":{"type":"string"},"hinweis":{"type":["string","null"]},"kategorien":{"items":{"additionalProperties":false,"properties":{"gelb":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"id":{"type":"string"},"name":{"type":"string"},"pruefungen":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"rot":{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},"status":{"type":"string"}},"required":["id","name","status","pruefungen","rot","gelb"],"type":"object"},"type":"array"},"note":{"type":"string"},"punkte":{"description":"Score 0\u2013100 of the free check","type":"number"},"wichtigste_befunde":{"items":{"additionalProperties":false,"properties":{"empfehlung":{"type":["string","null"]},"kategorie":{"type":"string"},"pruefung":{"type":"string"},"status":{"description":"rot | gelb","type":"string"},"titel":{"type":"string"},"zusammenfassung":{"type":"string"}},"required":["pruefung","kategorie","status","titel","zusammenfassung","empfehlung"],"type":"object"},"maxItems":8,"type":"array"}},"required":["gepruefte_url","geprueft_am","punkte","note","kategorien","wichtigste_befunde","hinweis"],"type":"object"},{"type":"null"}]},"link":{"description":"Full report in the browser on check.fraghugo.de (runs the check there again)","format":"uri","type":"string"},"scan_id":{"type":"string"},"status":{"enum":["fertig","laeuft","wartet","unbekannt"],"type":"string"},"url":{"type":["string","null"]},"wartezeit_s":{"anyOf":[{"maximum":9007199254740991,"minimum":-9007199254740991,"type":"integer"},{"type":"null"}]},"wiederverwendet":{"description":"true = same URL was checked within the last hour; that scan is returned","type":"boolean"}},"required":["status","scan_id","url","wartezeit_s","ergebnis","link","wiederverwendet"],"type":"object"},"securitySchemes":[{"type":"noauth"}],"title":"Start website privacy check (Hugo Check)"}
