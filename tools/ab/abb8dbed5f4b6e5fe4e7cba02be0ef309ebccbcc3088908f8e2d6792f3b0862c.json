{
 "description": "Remove extraneous packages not listed in package.json",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dryRun": {
    "description": "Preview changes without making them",
    "type": "boolean"
   },
   "path": {
    "description": "Absolute path to the package directory",
    "type": "string"
   },
   "production": {
    "description": "Remove devDependencies",
    "type": "boolean"
   }
  },
  "required": [
   "path"
  ],
  "type": "object"
 },
 "name": "prune"
}
