{
 "description": "Delete a media item and its files",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "force": {
    "description": "Permanently delete (default true); false moves it to trash only when MEDIA_TRASH is enabled",
    "type": "boolean"
   },
   "id": {
    "description": "Media (attachment) ID",
    "type": "integer"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   }
  },
  "required": [
   "site",
   "id"
  ],
  "type": "object"
 },
 "name": "mcp_delete_media"
}
