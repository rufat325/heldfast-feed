{
 "description": "List all available versions for a specific MCP server",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "serverName": {
    "description": "Server name (e.g., \"io.modelcontextprotocol/filesystem\")",
    "type": "string"
   }
  },
  "required": [
   "serverName"
  ],
  "type": "object"
 },
 "name": "list_server_versions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "servers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "isLatest": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "publishedAt": {
       "type": "string"
      },
      "version": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "version"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "servers"
  ],
  "type": "object"
 },
 "title": "List Server Versions"
}
