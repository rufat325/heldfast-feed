{
 "_meta": {
  "openai/toolInvocation/invoked": "Thread updated",
  "openai/toolInvocation/invoking": "Updating the thread\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Resolve or reopen an Artifact comment thread"
 },
 "description": "Mark a comment thread resolved (resolved: true) or reopen it (resolved: false), as the agent. Allowed only on activated threads. Resolve after you have addressed the comment, usually after republishing the Artifact; reply first so the person can see what changed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "artifact_id": {
    "description": "The Artifact id (art_\u2026).",
    "pattern": "^art_[a-zA-Z0-9]+$",
    "type": "string"
   },
   "resolved": {
    "type": "boolean"
   },
   "thread_id": {
    "description": "The thread id (thr_\u2026).",
    "pattern": "^thr_[a-zA-Z0-9]+$",
    "type": "string"
   }
  },
  "required": [
   "artifact_id",
   "thread_id",
   "resolved"
  ],
  "type": "object"
 },
 "name": "resolve_artifact_thread",
 "outputSchema": {
  "properties": {
   "agent_activated": {
    "description": "True once someone mentioned the agent; only then may the agent reply or resolve.",
    "type": "boolean"
   },
   "anchor": {
    "description": "Where the thread is pinned: kind element (selector, snapshot, slide), text (quote), or page.",
    "type": "object"
   },
   "artifact_id": {
    "type": "string"
   },
   "created_at": {
    "type": "string"
   },
   "created_by": {
    "description": "Who wrote it: { kind: \"user\", uid, name, handle, avatarUrl } or { kind: \"agent\", principal, name, via }.",
    "type": "object"
   },
   "last_message_at": {
    "type": "string"
   },
   "mentions": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "message_count": {
    "type": "integer"
   },
   "participants": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "preview": {
    "type": "string"
   },
   "resolved_at": {
    "type": [
     "string",
     "null"
    ]
   },
   "root_message_id": {
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "resolved"
    ],
    "type": "string"
   },
   "thread_id": {
    "type": "string"
   },
   "updated_at": {
    "type": "string"
   },
   "version_id": {
    "type": "string"
   },
   "version_number": {
    "type": "integer"
   }
  },
  "required": [
   "thread_id",
   "artifact_id",
   "status",
   "anchor",
   "version_number",
   "preview",
   "message_count",
   "agent_activated",
   "created_by",
   "created_at",
   "last_message_at"
  ],
  "type": "object"
 },
 "title": "Resolve or reopen an Artifact comment thread"
}
