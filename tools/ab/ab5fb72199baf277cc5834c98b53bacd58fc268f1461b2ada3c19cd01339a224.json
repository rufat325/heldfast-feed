{
 "annotations": {
  "audience": [
   "user",
   "assistant"
  ],
  "destructiveHint": false,
  "priority": 1,
  "readOnlyHint": true
 },
 "description": "Upload a local image file (or base64 string) and search PoloPan products using the uploaded image URL. Returns products with available in-stock sizes, pricing, and verified purchase URLs (https://s.polopan.com/p/{handle}).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content_type": {
    "default": "image/jpeg",
    "description": "MIME type of the image, e.g. 'image/jpeg', 'image/png'",
    "type": "string"
   },
   "expiry_hours": {
    "default": 24,
    "description": "Temporary upload URL lifetime in hours",
    "maximum": 168,
    "minimum": 1,
    "type": "integer"
   },
   "gender": {
    "description": "Target gender filter",
    "type": "string"
   },
   "image_base64": {
    "description": "Base64-encoded image data string",
    "minLength": 1,
    "type": "string"
   },
   "image_path": {
    "description": "Local file system path to the image file",
    "minLength": 1,
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number for pagination",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "default": 20,
    "description": "Number of items to return per page",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "personalize": {
    "default": false,
    "description": "Whether to personalize search ranking",
    "type": "boolean"
   },
   "price_max": {
    "description": "Maximum price",
    "type": "number"
   },
   "price_min": {
    "description": "Minimum price",
    "type": "number"
   },
   "size": {
    "description": "Array of sizes to filter by",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sort_by": {
    "default": "relevance",
    "description": "Sorting criteria",
    "enum": [
     "relevance",
     "price",
     "title"
    ],
    "type": "string"
   },
   "sort_order": {
    "default": "desc",
    "description": "Sort order: 'asc' or 'desc'",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "vendor": {
    "description": "List of brand names",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "products.search.image_upload",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "products": {
    "description": "Matching products",
    "items": {
     "additionalProperties": false,
     "properties": {
      "handle": {
       "description": "Product handle",
       "type": "string"
      },
      "price": {
       "description": "Price",
       "type": "number"
      },
      "title": {
       "description": "Product title",
       "type": "string"
      },
      "url": {
       "description": "Purchase link",
       "type": "string"
      }
     },
     "required": [
      "handle",
      "title",
      "price",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "uploaded_image_url": {
    "description": "Temporary URL of the uploaded image",
    "type": "string"
   }
  },
  "required": [
   "uploaded_image_url",
   "products"
  ],
  "type": "object"
 },
 "title": "Search Products By Uploaded Image"
}
