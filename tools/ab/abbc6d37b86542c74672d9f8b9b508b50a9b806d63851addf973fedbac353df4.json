{
 "description": "Owner-only. Execute the reviewed contract offboarding. Requires a reason, idempotency key, signed planToken, and explicit confirm: true. Access is revoked first by moving participation to OFFBOARDING; unsettled milestones remain payable and never delay access revocation. Provider, Project To-do, LMS, annotation, and messaging cleanup is durable and retryable. Successful cleanup moves the same contract identity to OFFBOARDED_PAYABLE; final CLOSED is a separate explicit operation after settlement. Manual annotation cleanup is reported truthfully without claiming provider-side completion. Never sends chat, never touches proposals, and moves no money.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "confirm": {
    "const": true,
    "description": "Required explicit confirmation that this live offboarding is intentional.",
    "type": "boolean"
   },
   "contractId": {
    "description": "OpenTrain contract id to offboard.",
    "minLength": 1,
    "type": "string"
   },
   "idempotencyKey": {
    "description": "Client idempotency key; reuse it to converge on the original result.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   },
   "planToken": {
    "description": "Signed expected-state token from a recent opentrain_preflight_contract_offboarding.",
    "minLength": 1,
    "type": "string"
   },
   "reason": {
    "description": "Required audited offboarding reason.",
    "maxLength": 2000,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "contractId",
   "idempotencyKey",
   "reason",
   "planToken",
   "confirm"
  ],
  "type": "object"
 },
