{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Calculate the net cost of breaking, subletting, or staying in a lease. Use when evaluating lease exit strategies. NOT for calculating break fees alone; use estimate_break_cost instead.",
 "inputSchema": {
  "properties": {
   "break_fee_months": {
    "description": "Early-termination fee in months' rent",
    "type": "number"
   },
   "currency": {
    "description": "Currency code in ISO 4217 format",
    "type": "string"
   },
   "deposit": {
    "description": "Initial deposit amount as a number",
    "type": "number"
   },
   "expected_relet_months": {
    "description": "Expected months to relett the property as a number",
    "type": "number"
   },
   "landlord_mitigates": {
    "description": "True if landlord mitigates damages, false otherwise",
    "type": "boolean"
   },
   "monthly_rent": {
    "description": "Monthly rent",
    "type": "number"
   },
   "months_remaining": {
    "description": "Months left on the lease (including the current one)",
    "type": "number"
   },
   "notice_months": {
    "description": "Number of months' notice required to terminate the lease",
    "type": "number"
   },
   "reletting_fee": {
    "description": "Fee for reletting the property as a number",
    "type": "number"
   },
   "sublet_discount_pct": {
    "type": "number"
   },
   "sublet_vacancy_months": {
    "type": "number"
   }
  },
  "required": [
   "monthly_rent",
   "months_remaining"
  ],
  "type": "object"
 },
 "name": "compare_options",
 "outputSchema": {
  "properties": {
   "break_lease": {
    "description": "Details about breaking the lease",
    "properties": {
     "break_fee": {
      "description": "Early-termination fee",
      "type": "number"
     },
     "notice_cost": {
      "description": "Cost associated with giving notice",
      "type": "number"
     },
     "reletting_fee": {
      "description": "Fee for finding a new tenant",
      "type": "number"
     },
     "remaining_rent": {
      "description": "Rent for the remaining months",
      "type": "number"
     },
     "risks": {
      "description": "Potential risks associated with breaking the lease",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "total_cost": {
      "description": "Total cost of breaking the lease",
      "type": "number"
     }
    },
    "required": [
     "total_cost",
     "break_fee",
     "notice_cost",
     "reletting_fee",
     "remaining_rent",
     "risks"
    ],
    "type": "object"
   },
   "stay_to_term": {
    "description": "Details about staying to the end of the lease term",
    "properties": {
     "remaining_rent": {
      "description": "Rent for the remaining months",
      "type": "number"
     },
     "risks": {
      "description": "Potential risks associated with staying to the end of the lease term",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "total_cost": {
      "description": "Total cost of staying to the end of the lease term",
      "type": "number"
     }
    },
    "required": [
     "total_cost",
     "remaining_rent",
     "risks"
    ],
    "type": "object"
   },
   "sublet": {
    "description": "Details about subletting the lease",
    "properties": {
     "risks": {
      "description": "Potential risks associated with subletting",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "sublet_discount": {
      "description": "Discount applied to the sublet rent",
      "type": "number"
     },
     "sublet_income": {
      "description": "Income from subletting",
      "type": "number"
     },
     "total_cost": {
      "description": "Total cost of subletting",
      "type": "number"
     },
     "vacancy_cost": {
      "description": "Cost associated with vacancy months",
      "type": "number"
     }
    },
    "required": [
     "total_cost",
     "sublet_income",
     "sublet_discount",
     "vacancy_cost",
     "risks"
    ],
    "type": "object"
   }
  },
  "required": [
   "break_lease",
   "sublet",
   "stay_to_term"
  ],
  "type": "object"
 },
 "title": "Compare options"
}
