{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Split a total cost among players when you need to divide expenses fairly. Not for tracking ongoing series; use `split_series` instead.",
 "inputSchema": {
  "properties": {
   "currency": {
    "description": "Currency code for display, default USD",
    "type": "string"
   },
   "participants": {
    "description": "Players in the split",
    "items": {
     "properties": {
      "name": {
       "type": "string"
      },
      "paid": {
       "type": "number"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "shares": {
    "description": "Optional relative weights, one per participant",
    "items": {
     "type": "number"
    },
    "type": "array"
   },
   "total_cost": {
    "description": "Total court/venue cost",
    "type": "number"
   }
  },
  "required": [
   "total_cost",
   "participants"
  ],
  "type": "object"
 },
 "name": "split_costs",
 "outputSchema": {
  "properties": {
   "currency": {
    "description": "The currency code used for display.",
    "type": "string"
   },
   "individual_costs": {
    "description": "The cost owed by each participant.",
    "items": {
     "properties": {
      "amount": {
       "description": "The amount each participant owes.",
       "type": "number"
      },
      "name": {
       "description": "The name of the participant.",
       "type": "string"
      }
     },
     "required": [
      "name",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "settlements": {
    "description": "The list of settle-up payments to balance the costs.",
    "items": {
     "properties": {
      "amount": {
       "description": "The amount to be paid.",
       "type": "number"
      },
      "payee": {
       "description": "The name of the person receiving the payment.",
       "type": "string"
      },
      "payer": {
       "description": "The name of the person making the payment.",
       "type": "string"
      }
     },
     "required": [
      "payer",
      "payee",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_cost": {
    "description": "The total cost that was split.",
    "type": "number"
   }
  },
  "required": [
   "total_cost",
   "currency",
   "settlements",
   "individual_costs"
  ],
  "type": "object"
 },
 "title": "Split costs"
}
