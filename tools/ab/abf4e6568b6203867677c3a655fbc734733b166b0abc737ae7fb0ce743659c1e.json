{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   },
   {
    "scopes": [
     "email"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Checks up to 50 pages from the sitemap: which have no image, share one image, or are broken. Works without an account. A call returns within about 25 seconds; a check that isn't finished by then returns a check_id, and a call with it picks the check up where it left off.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "check_id": {
    "description": "The check_id from a previous call, to get its progress or result",
    "type": "string"
   },
   "url": {
    "description": "The site, e.g. example.com",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "check_site_previews",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checkId": {
    "type": "string"
   },
   "checked": {
    "type": "number"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "label": {
       "type": [
        "string",
        "null"
       ]
      },
      "path": {
       "type": "string"
      },
      "verdict": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "path",
      "verdict",
      "label"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "reportUrl": {
    "type": "string"
   },
   "status": {
    "enum": [
     "discovering",
     "running",
     "done",
     "failed"
    ],
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "checked": {
      "type": "number"
     },
     "good": {
      "type": "number"
     },
     "noImage": {
      "type": "number"
     },
     "problems": {
      "type": "number"
     },
     "sharedImage": {
      "type": "number"
     }
    },
    "required": [
     "checked",
     "noImage",
     "sharedImage",
     "good",
     "problems"
    ],
    "type": "object"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "checkId",
   "status",
   "checked",
   "total",
   "summary",
   "pages",
   "reportUrl"
  ],
  "type": "object"
 },
 "title": "Check a whole site"
}
