{
 "_meta": {
  "ui": {
   "resourceUri": "ui://rds/widget.html"
  },
  "ui/resourceUri": "ui://rds/widget.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Count how many of 8 known dark patterns are present in a user experience and turn that into an integrity score. See the full version at https://rahuldsarker.co/calculators/ux-pattern-anti-pattern-checker",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirmshaming": {
    "description": "Confirmshaming, e.g. \"No thanks, I hate saving money\"",
    "type": "boolean"
   },
   "currency": {
    "description": "ISO 4217 code for money in the result, e.g. \"USD\", \"INR\", \"EUR\", \"GBP\". Omit to show plain numbers.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "disguisedAds": {
    "description": "Disguised ads or fake system messages",
    "type": "boolean"
   },
   "fakeUrgency": {
    "description": "Fake urgency or countdown timers",
    "type": "boolean"
   },
   "forcedContinuity": {
    "description": "Forced continuity (auto-renew, hard to spot)",
    "type": "boolean"
   },
   "hardCancellation": {
    "description": "Deliberately hard cancellation / downgrade",
    "type": "boolean"
   },
   "hiddenCostsLate": {
    "description": "Hidden costs revealed late in checkout",
    "type": "boolean"
   },
   "preselectedAddOns": {
    "description": "Pre-selected paid add-ons / opt-ins",
    "type": "boolean"
   },
   "trickWording": {
    "description": "Trick wording on buttons / consent",
    "type": "boolean"
   }
  },
  "required": [
   "forcedContinuity",
   "hiddenCostsLate",
   "confirmshaming",
   "disguisedAds",
   "hardCancellation",
   "fakeUrgency",
   "preselectedAddOns",
   "trickWording"
  ],
  "type": "object"
 },
 "name": "ux_pattern_anti_pattern_checker",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "benchmarks": {
    "description": "Rule-of-thumb verdicts for the headline numbers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "band": {
       "type": "string"
      },
      "display": {
       "type": "string"
      },
      "metric": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "read": {
       "type": "string"
      },
      "segment": {
       "type": [
        "string",
        "null"
       ]
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "tone": {
       "enum": [
        "good",
        "ok",
        "warn",
        "bad"
       ],
       "type": "string"
      },
      "value": {
       "type": "number"
      }
     },
     "required": [
      "metric",
      "name",
      "value",
      "display",
      "band",
      "tone",
      "read",
      "target",
      "segment",
      "source"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "bookingUrl": {
    "type": "string"
   },
   "calculator": {
    "description": "Slug of the interactive calculator on rahuldsarker.co",
    "type": "string"
   },
   "compact": {
    "type": "boolean"
   },
   "currency": {
    "type": [
     "string",
     "null"
    ]
   },
   "inputs": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "kind": {
    "const": "calculator",
    "type": "string"
   },
   "metrics": {
    "description": "Every \"Label: value\" line of the result; value is the first number on the line",
    "items": {
     "additionalProperties": false,
     "properties": {
      "display": {
       "type": "string"
      },
      "label": {
       "type": "string"
      },
      "unit": {
       "anyOf": [
        {
         "enum": [
          "currency",
          "x",
          "%",
          "months"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "value": {
       "type": [
        "number",
        "null"
       ]
      }
     },
     "required": [
      "label",
      "value",
      "unit",
      "display"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "title": {
    "type": "string"
   },
   "tool": {
    "description": "The calculator tool that produced this result",
    "type": "string"
   },
   "url": {
    "type": "string"
   }
  },
  "required": [
   "kind",
   "tool",
   "title",
   "calculator",
   "url",
   "bookingUrl",
   "currency",
   "compact",
   "inputs",
   "metrics",
   "notes",
   "benchmarks"
  ],
  "type": "object"
 },
 "title": "UX Pattern Anti-Pattern Checker"
}
