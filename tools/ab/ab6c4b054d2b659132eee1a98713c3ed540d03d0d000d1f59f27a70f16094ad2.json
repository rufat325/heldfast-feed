{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search podcast metadata and transcripts. Text-only hits include snippets; full transcripts require get_podcast with opt-in.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "keyword": {
    "description": "Every word must occur in the title, abstract or transcript; quote a phrase to match it exactly",
    "maxLength": 1000,
    "type": "string"
   },
   "language": {
    "description": "Name or ISO code \u2014 'French', 'fr', 'fra' all match",
    "maxLength": 1000,
    "type": "string"
   },
   "limit": {
    "description": "Default 20, max 100",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "maximum": 100000,
    "minimum": 0,
    "type": "integer"
   },
   "person": {
    "description": "A speaker/host name; either name order works",
    "maxLength": 1000,
    "type": "string"
   },
   "series": {
    "description": "Series title, partial (e.g. 'Cluster Conversations')",
    "maxLength": 1000,
    "type": "string"
   },
   "year_from": {
    "description": "Earliest year",
    "maximum": 2200,
    "minimum": 0,
    "type": "integer"
   },
   "year_to": {
    "description": "Latest year",
    "maximum": 2200,
    "minimum": 0,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "search_podcasts",
 "title": "Search podcasts"
}
