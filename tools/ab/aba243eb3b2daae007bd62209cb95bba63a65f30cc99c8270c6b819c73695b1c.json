{
 "description": "Manages custom document templates with variable substitution. Actions: create, get, update, delete, list, apply (render with data), preview (render preview), import, export.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "create",
     "get",
     "update",
     "delete",
     "list",
     "apply",
     "preview",
     "import",
     "export"
    ],
    "type": "string"
   },
   "content": {
    "type": "string"
   },
   "data": {
    "additionalProperties": {},
    "type": "object"
   },
   "description": {
    "type": "string"
   },
   "filePath": {
    "type": "string"
   },
   "filterType": {
    "enum": [
     "document",
     "session-log",
     "export",
     "report"
    ],
    "type": "string"
   },
   "format": {
    "default": "json",
    "enum": [
     "json",
     "yaml"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "offset": {
    "type": "number"
   },
   "templateId": {
    "type": "string"
   },
   "type": {
    "enum": [
     "document",
     "session-log",
     "export",
     "report"
    ],
    "type": "string"
   },
   "variables": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "default": {},
      "description": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "required": {
       "default": false,
       "type": "boolean"
      },
      "type": {
       "enum": [
        "string",
        "number",
        "boolean",
        "array",
        "date"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "muse_template"
}
