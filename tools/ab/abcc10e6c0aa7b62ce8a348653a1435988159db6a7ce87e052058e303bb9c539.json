{
 "annotations": {
  "destructiveHint": true,
  "readOnlyHint": false,
  "title": "Relay Meta-Transaction"
 },
 "description": "Relays a pre-signed meta-transaction via Biconomy so the user pays no gas. Requires sigR/sigS/sigV from a locally-signed EIP-712 payload. Use when the target operation requires metaTx relay. Optionally accepts transferAuthorizations (from the sign_receive_with_* tools, completed with your local signature) so the protocol can pull ERC-20 tokens without a prior approve_exchange_token tx. Returns: relay transaction data.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "configId": {
    "description": "Boson/Fermion Protocol deployment identifier. Format: '<env>-<chainId>-<index>' e.g. 'production-137-0' (Polygon mainnet), 'testing-80002-0' (Amoy testnet). Call get_config_ids to list all valid values for this server.",
    "type": "string"
   },
   "functionName": {
    "minLength": 1,
    "type": "string"
   },
   "functionSignature": {
    "pattern": "^0x[a-fA-F0-9]+$",
    "type": "string"
   },
   "nonce": {
    "type": [
     "string",
     "number"
    ]
   },
   "sigR": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "sigS": {
    "pattern": "^0x[a-fA-F0-9]{64}$",
    "type": "string"
   },
   "sigV": {
    "type": [
     "string",
     "number"
    ]
   },
   "signerAddress": {
    "description": "Ethereum address that will sign and send this transaction. Must match the wallet that will sign the returned transaction locally.",
    "type": "string"
   },
   "transferAuthorizations": {
    "description": "Optional ERC-20 transfer authorizations that let the protocol pull tokens without a prior approve_exchange_token tx (e.g. commit_to_offer or deposit_funds in metaTx mode). Build each entry with the matching sign_receive_with_* tool: sign its `typedData` locally and add the resulting `signature` to its `transferAuthorization` object.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "data": {
         "additionalProperties": false,
         "properties": {
          "nonce": {
           "pattern": "^0x[a-fA-F0-9]{64}$",
           "type": "string"
          },
          "validAfter": {
           "anyOf": [
            {
             "pattern": "^(\\d+|0x[a-fA-F0-9]+)$",
             "type": "string"
            },
            {
             "maximum": 9007199254740991,
             "minimum": 0,
             "type": "integer"
            }
           ]
          },
          "validBefore": {
           "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/validAfter"
          }
         },
         "required": [
          "validAfter",
          "validBefore",
          "nonce"
         ],
         "type": "object"
        },
        "r": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/nonce",
         "description": "Optional r component. Derived from `signature` if omitted."
        },
        "s": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/nonce",
         "description": "Optional s component. Derived from `signature` if omitted."
        },
        "signature": {
         "description": "Signature of the typed data returned by the matching sign_receive_with_* tool, signed locally with your wallet (EIP-712).",
         "pattern": "^0x[a-fA-F0-9]+$",
         "type": "string"
        },
        "strategy": {
         "const": "ERC3009",
         "type": "string"
        },
        "v": {
         "anyOf": [
          {
           "pattern": "^\\d+$",
           "type": "string"
          },
          {
           "type": "integer"
          }
         ],
         "description": "Optional v component (27/28, or 0/1). Derived from `signature` if omitted. Provide r, s and v together or not at all."
        }
       },
       "required": [
        "strategy",
        "data",
        "signature"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "data": {
         "additionalProperties": false,
         "properties": {
          "deadline": {
           "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/validAfter"
          }
         },
         "required": [
          "deadline"
         ],
         "type": "object"
        },
        "r": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/r"
        },
        "s": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/s"
        },
        "signature": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/signature"
        },
        "strategy": {
         "const": "EIP2612",
         "type": "string"
        },
        "v": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/v"
        }
       },
       "required": [
        "strategy",
        "data",
        "signature"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "data": {
         "additionalProperties": false,
         "properties": {
          "deadline": {
           "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/validAfter"
          },
          "nonce": {
           "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/validAfter"
          }
         },
         "required": [
          "nonce",
          "deadline"
         ],
         "type": "object"
        },
        "r": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/r"
        },
        "s": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/s"
        },
        "signature": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/signature"
        },
        "strategy": {
         "const": "Permit2",
         "type": "string"
        },
        "v": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/v"
        }
       },
       "required": [
        "strategy",
        "data",
        "signature"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "data": {
         "additionalProperties": false,
         "properties": {
          "expiry": {
           "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/validAfter"
          },
          "nonce": {
           "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/data/properties/validAfter"
          }
         },
         "required": [
          "nonce",
          "expiry"
         ],
         "type": "object"
        },
        "r": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/r"
        },
        "s": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/s"
        },
        "signature": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/signature"
        },
        "strategy": {
         "const": "DAIPermit",
         "type": "string"
        },
        "v": {
         "$ref": "#/properties/transferAuthorizations/items/anyOf/0/properties/v"
        }
       },
       "required": [
        "strategy",
        "data",
        "signature"
       ],
       "type": "object"
      }
     ]
    },
    "type": "array"
   }
  },
  "required": [
   "functionName",
   "functionSignature",
   "nonce",
   "sigR",
   "sigS",
   "sigV",
   "configId",
   "signerAddress"
  ],
  "type": "object"
 },
 "name": "send_meta_transaction"
}
