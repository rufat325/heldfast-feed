{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "KuCoin's own 24h statistics for a symbol: last, best bid/ask with size, 24h high/low, change, base and quote volume, average price and the taker/maker fee rates it applies. Costs $0.001 USDC per call. Byte-identical to GET /market/kucoin-ticker?symbol=BTC-USDT.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "symbol": {
    "description": "KuCoin symbol, BASE-QUOTE in upper case (BTC-USDT, SOL-USDT) [required]",
    "type": "string"
   }
  },
  "required": [
   "symbol"
  ],
  "type": "object"
 },
 "name": "market_kucoin_ticker",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "averagePrice": {
    "type": "string"
   },
   "buy": {
    "type": "string"
   },
   "caveat": {
    "type": [
     "string",
     "null"
    ]
   },
   "changePrice": {
    "type": "string"
   },
   "changeRate": {
    "type": "string"
   },
   "found": {
    "type": "boolean"
   },
   "high": {
    "type": "string"
   },
   "last": {
    "type": "string"
   },
   "low": {
    "type": "string"
   },
   "makerCoefficient": {
    "type": "string"
   },
   "makerFeeRate": {
    "type": "string"
   },
   "note": {
    "type": [
     "string",
     "null"
    ]
   },
   "reason": {
    "type": [
     "string",
     "null"
    ]
   },
   "sell": {
    "type": "string"
   },
   "source": {
    "type": "string"
   },
   "stale": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "symbol": {
    "type": "string"
   },
   "takerCoefficient": {
    "type": "string"
   },
   "takerFeeRate": {
    "type": "string"
   },
   "time": {
    "type": "integer"
   },
   "ts": {
    "type": "string"
   },
   "vol": {
    "type": "string"
   },
   "volValue": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "KuCoin 24h stats"
}
