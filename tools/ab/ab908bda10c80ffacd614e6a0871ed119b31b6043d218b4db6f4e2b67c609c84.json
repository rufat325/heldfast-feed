{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Search for a term and replace it across documents.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "collId": {
    "description": "Limit to a specific collection ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "docId": {
    "description": "Limit to a specific document ID",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "replaceTerm": {
    "description": "Replacement term",
    "type": "string"
   },
   "searchTerm": {
    "description": "Term to search for",
    "type": "string"
   }
  },
  "required": [
   "searchTerm",
   "replaceTerm"
  ],
  "type": "object"
 },
 "name": "transkribus_search_replace",
 "title": "Search and Replace"
}
