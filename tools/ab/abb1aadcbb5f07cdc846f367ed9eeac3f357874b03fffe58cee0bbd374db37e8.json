{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"\uc5c5\uccb4 \uce74\ub4dc \uac80\uc0c9(\uacf5\uacf5 \uc870\ub2ec \uc2e4\uc801\u00b7\uc9c1\uc811 \ub4f1\ub85d \uc5c5\uccb4)"},"description":"Find Korean vendors with public-procurement records or self-registered info by product, region, name or certification (Public Procurement Service open data; not a ranking). [\ubcf4\uc784 \u2014 \ud55c\uad6d \uc5c5\uccb4\u00b7\uc785\ucc30 \uacf5\uace0 \ucc3e\uae30] \uc870\ub2ec\uccad \uacf5\uacf5 \ub370\uc774\ud130(\uc885\ud569\uc1fc\ud551\ubab0 \uacc4\uc57d \ud488\ubaa9 + \ucd5c\uadfc 1\ub144 \uc870\ub2ec \uc2e4\uc801, \uc804 \ud488\ubaa9)\ub85c \uc815\ub9ac\ud55c \ud55c\uad6d \uc5c5\uccb4\ub97c \ucc3e\uc2b5\ub2c8\ub2e4. \ud488\uba85\uc740 \uc870\ub2ec\uccad \ubb3c\ud488\ubd84\ub958(\uc608: \uc548\ub0b4\ud310, \ubcf5\uc0ac\uc6a9\uc9c0, \uc0ac\ubb34\uc6a9 \uc758\uc790, \ub178\ud2b8\ubd81\ucef4\ud4e8\ud130, \uc18c\ud654\uae30, \ucca0\uadfc, \uae09\uc2dd \uc2dd\uc790\uc7ac), \ubd84\uc57c\ub294 \ubb3c\ud488\ubd84\ub958 \ub300\ubd84\ub958. \uc21c\uc11c\ub294 \uad00\ub828\ub3c4(\uc9c0\uc5ed \uadfc\uac70) \u2192 AI \uc900\ube44 \uad6c\uac04(\uc5c5\uccb4\uac00 \ud655\uc778\u00b7\ub4f1\ub85d\ud55c \uc815\ubcf4\uac00 \uc5bc\ub9c8\ub098 \uac16\ucdb0\uc84c\ub294\uc9c0) \u2192 \uac19\uc740 \uad6c\uac04\uc740 \ub0a0\ub9c8\ub2e4 \uc11e\uae30\uc774\uba70, \uc2e4\uc801 \ub9ce\uc740 \uc21c\uc11c\ub098 \uc720\ub8cc \uc21c\uc704\uac00 \uc544\ub2d9\ub2c8\ub2e4. \uacb0\uacfc\uc758 ai_ready\ub294 \uadf8 \uc5c5\uccb4 \uce74\ub4dc\uac00 AI\uac00 \ubc14\ub85c \uc4f8 \ub9cc\ud07c \uc815\ubcf4(\ud558\ub294 \uc77c\u00b7\uc9c0\uc5ed\u00b7\uc5f0\ub77d\ucc98\u00b7\uac00\uaca9 \uc548\ub0b4 \ub4f1)\ub97c \uac16\ucdc4\ub294\uc9c0\uc785\ub2c8\ub2e4. region\uc740 \ubcf8\uc0ac \uc18c\uc7ac\uc9c0, \ucd5c\uadfc 1\ub144 \ub0a9\ud488 \uc2e4\uc801 \uc9c0\uc5ed, \uc5c5\uccb4\uac00 \ub4f1\ub85d\ud55c \uc2dc\uacf5 \uc9c0\uc5ed(\uc2dc\u00b7\ub3c4\u00b7\uc2dc\uad70\uad6c, \uc608: \uc138\uc885, \ucda9\ub0a8, \uacbd\uae30\ub3c4 \uace0\uc591\uc2dc)\uacfc \ub9de\ucdb0 \ubcf4\uace0, \uacb0\uacfc\uc758 match\uc5d0 \uadfc\uac70(\ubcf8\uc0ac/\ub0a9\ud488 \uc2e4\uc801/\uc2dc\uacf5 \uac00\ub2a5 \uc9c0\uc5ed)\ub97c \uc801\uc2b5\ub2c8\ub2e4. \ud488\uba85 \ubaa9\ub85d\uc740 list_categories\ub85c \ubcfc \uc218 \uc788\uc2b5\ub2c8\ub2e4.","inputSchema":{"additionalProperties":false,"properties":{"category":{"description":"\ud488\uba85 \u2014 \ud654\uba74 \uc774\ub984(\uc608: \uc548\ub0b4\ud310, \ud604\uc218\ub9c9, \uac04\ud310(\uad11\uace0\ud310), \uae30\ud0c0 \uc778\uc1c4\ubb3c), \uc870\ub2ec \ud488\uba85(\uc608: \uad11\uace0\ud310) \ub610\ub294 8\uc790\ub9ac \ubb3c\ud488\ubd84\ub958\ubc88\ud638","type":"string"},"cert":{"description":"\uc778\uc99d\u00b7\uad6c\ubd84 \uc774\ub984 \uc77c\ubd80(\uc608: \uc5ec\uc131\uae30\uc5c5, \uc0ac\ud68c\uc801\uae30\uc5c5, \uc7a5\uc560\uc778\uae30\uc5c5, \uc911\uc18c\uae30\uc5c5\uc790\uac04 \uacbd\uc7c1\uc81c\ud488)","type":"string"},"group":{"description":"\ubd84\uc57c = \uc870\ub2ec\uccad \ubb3c\ud488\ubd84\ub958 \ub300\ubd84\ub958 \uc774\ub984 \uc77c\ubd80(\uc608: \ucd9c\ud310\ubb3c, \uac74\uc790\uc7ac, \uac00\uad6c, \uc0ac\ubb34\uc6a9\uae30\uae30, \uacf5\uacf5\uc548\uc804\ubc0f\uce58\uc548\uc7a5\ube44) \u2014 list_categories\ub85c \ud655\uc778","type":"string"},"limit":{"default":10,"description":"\ubcf4\uc5ec \uc904 \ucd5c\ub300 \uac74\uc218(1~20). \uacb0\uacfc\uac00 \uc774\ubcf4\ub2e4 \ub9ce\uac70\ub098 \uacf5\uac1c \ud55c\ub3c4(5\uac74)\ub97c \ub118\uc73c\uba74 \ub098\uba38\uc9c0\ub294 \uacb0\uacfc\uc758 not_shown \uc218\uc640 more \uc8fc\uc18c\ub85c \uc54c\ub824 \uc90d\ub2c8\ub2e4","maximum":20,"minimum":1,"type":"integer"},"query":{"description":"\uc5c5\uccb4 \uc774\ub984\uc774\ub098 \ud488\uba85\uc5d0 \ub4e4\uc5b4\uac04 \ub9d0","type":"string"},"region":{"description":"\uc9c0\uc5ed(\uc608: \uc138\uc885, \ucda9\uccad\ub0a8\ub3c4, \uacbd\uae30\ub3c4 \uace0\uc591\uc2dc)","type":"string"}},"type":"object"},"name":"search_vendors","outputSchema":{"properties":{"category":{"description":"\uc54c\uc544\ub4e4\uc740 \ud488\uba85"},"cite":{"description":"\ub2f5\uc5d0 \ubd99\uc77c \ucd9c\ucc98 \ud55c \uc904"},"error":{"description":"\uc2e4\ud328 \uc0ac\uc720(isError\uc77c \ub54c\ub9cc)"},"more":{"description":"\ub098\uba38\uc9c0\ub97c \ubcfc \ubcf4\uc784 \uc6f9 \ubaa9\ub85d \uc8fc\uc18c(\ub204\uad6c\ub098 \uc5f4\ub78c)"},"not_shown":{"description":"\ubcf4\uc774\uc9c0 \uc54a\uc740 \ub098\uba38\uc9c0 \uc218(\uc788\uc744 \ub54c)"},"note":{"description":"\uc870\uac74 \ud480\uc774\u00b7\uc548\ub0b4"},"order":{"description":"\uc21c\uc11c \uae30\uc900(\uad00\ub828\ub3c4\u00b7\uc774\ub984\uc21c \ub4f1 \u2014 \ud3c9\uac00\u00b7\uc21c\uc704 \uc544\ub2d8)"},"period":{"description":"\uc2e4\uc801 \uae30\uac04"},"results":{"description":"\uacb0\uacfc \uc904(\ud55c \ubc88\uc5d0 5\uac74\uae4c\uc9c0)","items":{"properties":{"ai_md":{"description":"\uc5c5\uccb4 \uce74\ub4dc \ub9c8\ud06c\ub2e4\uc6b4 \uc8fc\uc18c"},"ai_ready":{"description":"AI \uc900\ube44\ub3c4(\uc5c5\uccb4\uac00 \ud655\uc778\u00b7\ub4f1\ub85d\ud55c \uc815\ubcf4\uac00 \uc5bc\ub9c8\ub098 \uac16\ucdb0\uc84c\ub294\uc9c0)"},"business_status":{"description":"\uad6d\uc138\uccad \uc0ac\uc5c5\uc790 \uc0c1\ud0dc"},"categories":{"description":"\uc8fc\uc694 \ud488\uba85"},"checks":{"description":"\ud655\uc778 \uadfc\uac70(\ubb34\uc5c7\uc744\u00b7\uc5b4\ub514\uc11c\u00b7\uc5b8\uc81c)"},"cite":{"description":"\ucd9c\ucc98 \ud55c \uc904"},"id":{"description":"\uc5c5\uccb4 id(get_vendor\uc5d0 \ub118\uae40)"},"match":{"description":"\uc9c0\uc5ed \uadfc\uac70(\ubcf8\uc0ac\u00b7\ub0a9\ud488 \uc2e4\uc801\u00b7\uc2dc\uacf5 \uac00\ub2a5 \uc9c0\uc5ed)"},"name":{"description":"\uc0c1\ud638"},"procurement_1y":{"description":"\ucd5c\uadfc 1\ub144 \uc870\ub2ec \uc2e4\uc801 \uc694\uc57d"},"region":{"description":"\ubcf8\uc0ac \uc9c0\uc5ed"},"url":{"description":"\uc5c5\uccb4 \uce74\ub4dc \uc8fc\uc18c"}},"type":"object"},"type":"array"},"shown":{"d