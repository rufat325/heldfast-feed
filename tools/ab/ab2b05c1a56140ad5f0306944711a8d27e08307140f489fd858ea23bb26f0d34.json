 "description": "Search Tuki events and ticketed experiences (concerts, festivals, parties, conferences, sports, theater, workshops, raffles) by free text or type. Tuki is also a boutique ticketing platform. Returns title, type, start date, \"from\" price (cheapest public tier, CLP), location and canonical Tuki URL where the user buys tickets. Upcoming events only unless include_past=true.",
 "inputSchema": {
  "properties": {
   "include_past": {
    "default": false,
    "description": "Include past events (default false).",
    "type": "boolean"
   },
   "max_results": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "description": "Pagination offset. Use next_offset from a previous response.",
    "minimum": 0,
    "type": "integer"
   },
   "query": {
    "description": "Free text (e.g. \"fiesta\", \"concierto\", name of the event).",
    "type": "string"
   },
   "response_format": {
    "default": "concise",
    "description": "concise = high-signal fields + canonical URL (token-cheap, default). detailed = full record.",
    "enum": [
     "concise",
     "detailed"
    ],
    "type": "string"
   },
   "type": {
    "description": "Event type: concert, festival, party, conference, sports, theater, workshop, rifa, other.",
    "type": "string"
   }
  },
  "type": "object"
 },
