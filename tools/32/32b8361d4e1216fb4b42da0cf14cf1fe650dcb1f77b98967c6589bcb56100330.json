 "description": "Search Agent402 and the official MPP catalog for paid machine services that both match a capability intent and guarantee buyer-required JSON response paths. Use `agent_discoverability_audit` when you are measuring one known seller's catalog reach or rank, `seller_integrity_audit` when you already know the exact seller route to inspect, or `payment_offer_preflight` when you already have one exact callable GET URL. This search excludes SameDayDesk-owned supply and unresolved routes before audit, uses no credential or wallet, sends no seller POST or target payment, reads no paid response body, and returns only a query digest.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "default": 5,
    "description": "Maximum candidates audited and returned across Agent402 and MPP.",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "maxPriceDisplayUnits": {
    "default": 0.1,
    "description": "Maximum advertised per-call price in each source's display currency.",
    "exclusiveMinimum": 0,
    "maximum": 10,
    "type": "number"
   },
   "query": {
    "description": "Capability intent sent to Agent402 and used locally to rank MPP catalog metadata. Do not include credentials or private values.",
    "maxLength": 300,
    "minLength": 10,
    "type": "string"
   },
   "requiredPaths": {
    "description": "Buyer-required dotted success-response paths that every returned seller schema must guarantee recursively.",
    "items": {
     "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+){0,7}$",
     "type": "string"
    },
    "maxItems": 16,
