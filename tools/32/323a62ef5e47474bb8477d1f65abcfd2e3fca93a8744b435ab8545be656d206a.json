{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Get volume distribution across price levels for a single trading day. Returns price buckets with volume, Point of Control (highest volume level), and Value Area (price range containing 70% of volume). Use for identifying support/resistance and high-volume price nodes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bucketSize": {
    "default": 1,
    "description": "Price bucket width in dollars (default $1.00)",
    "maximum": 100,
    "minimum": 0.01,
    "type": "number"
   },
   "date": {
    "description": "Trading day (YYYY-MM-DD)",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "ticker": {
    "description": "Stock ticker symbol (e.g., \"AAPL\", \"TSLA\")",
    "type": "string"
   }
  },
  "required": [
   "ticker",
   "date"
  ],
  "type": "object"
 },
 "name": "get_volume_profile",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {}
  },
  "type": "object"
 },
 "title": "Get Volume Profile"
}
