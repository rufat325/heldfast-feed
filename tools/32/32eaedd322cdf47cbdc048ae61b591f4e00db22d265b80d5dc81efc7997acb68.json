{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Shows how many AI caricatures are left on an event vendor's Photobooth Caricatura license and how many were used. Needs the license key and the email it was registered with.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "email": {
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "license_key": {
    "description": "License key, e.g. PBP-1A11ABE7C50-45B5",
    "pattern": "^PBP-[A-Z0-9]{4,16}-[A-Z0-9]{3,6}$",
    "type": "string"
   }
  },
  "required": [
   "license_key",
   "email"
  ],
  "type": "object"
 },
 "name": "check_caricature_booth_credits",
 "title": "Saldo do Espelho Caricaturista"
}
