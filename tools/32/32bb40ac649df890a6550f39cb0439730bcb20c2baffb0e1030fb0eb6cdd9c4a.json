{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update project milestone"
 },
 "description": "Update an existing project milestone by ID. Requires project_milestones:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "completed_date": {
    "description": "Completed date (ISO 8601)",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "due_date": {
    "description": "Due date (ISO 8601)",
    "type": "string"
   },
   "id": {
    "description": "Project milestone ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "is_critical": {
    "description": "Whether the milestone is on the critical path",
    "type": "boolean"
   },
   "name": {
    "description": "Milestone name",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "phase_id": {
    "description": "Phase the milestone belongs to",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "project_id": {
    "description": "Project ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "status": {
    "description": "Milestone status",
    "enum": [
     "pending",
     "completed",
     "missed",
     "at_risk"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_project_milestone",
 "title": "Update project milestone"
}
