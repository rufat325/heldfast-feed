{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Apply edits"
 },
 "description": "Apply a batch of edits to a design. The batch is all-or-nothing: the first rejected operation aborts it and the design is left untouched. Pass expected_revision to be told about a concurrent edit instead of silently overwriting it. Returns the new revision, what changed, and a fresh validation summary.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "design_id": {
    "description": "Handle returned by tensorcad_new_design or tensorcad_open_design, e.g. \"dsn_1\".",
    "type": "string"
   },
   "expected_revision": {
    "description": "Revision you last read. The call is rejected if the design has moved on.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "ops": {
    "description": "Edits applied in order.",
    "items": {
     "oneOf": [
      {
       "properties": {
        "id": {
         "description": "New block id, unique within its graph.",
         "type": "string"
        },
        "label": {
         "type": "string"
        },
        "op": {
         "const": "add_node",
         "type": "string"
        },
        "params": {
         "additionalProperties": {
          "description": "A number, an expression string over the design symbols, a boolean, null, or an object."
         },
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        },
        "parent": {
         "description": "Container path to add into. Omit for the root graph.",
         "type": "string"
        },
        "type": {
         "description": "Catalog block type; see tensorcad_search_catalog.",
         "type": "string"
        }
       },
       "required": [
        "op",
        "id",
        "type"
       ],
       "type": "object"
      },
      {
       "properties": {
        "op": {
         "const": "remove_node",
         "type": "string"
        },
        "path": {
         "description": "Block path. Its edges go with it.",
         "type": "string"
        }
       },
       "required": [
        "op",
        "path"
       ],
       "type": "object"
      },
      {
       "properties": {
        "key": {
         "type": "string"
        },
        "op": {
         "const": "set_param",
         "type": "string"
        },
        "path": {
         "type": "string"
        },
        "value": {
         "description": "A number, an expression string over the design symbols, a boolean, null, or an object."
        }
       },
       "required": [
        "op",
        "path",
        "key",
        "value"
       ],
       "type": "object"
      },
      {
       "properties": {
        "from": {
         "description": "Producer endpoint, \"blockId:port\", local to that graph.",
         "type": "string"
        },
        "graph": {
         "description": "Container path holding the edge. Omit for the root graph.",
         "type": "string"
        },
        "op": {
         "const": "connect",
         "type": "string"
        },
        "to": {
         "description": "Consumer endpoint, \"blockId:port\", local to that graph.",
         "type": "string"
        }
       },
       "required": [
        "op",
        "from",
        "to"
       ],
       "type": "object"
      },
      {
       "properties": {
        "from": {
         "type": "string"
        },
        "graph": {
         "type": "string"
        },
        "op": {
         "const": "disconnect",
         "type": "string"
        },
        "to": {
         "type": "string"
        }
       },
       "required": [
        "op",
        "from",
        "to"
       ],
       "type": "object"
      },
      {
       "properties": {
        "doc": {
         "type": "string"
        },
        "name": {
         "type": "string"
        },
        "op": {
         "const": "set_symbol",
         "type": "string"
        },
        "runtime": {
         "description": "Keep the symbol indeterminate (B, T). Defaults to the current kind.",
         "type": "boolean"
        },
        "value": {
         "description": "Number, expression over earlier symbols, or null to delete the symbol.",
         "type": [
          "number",
          "string",
          "null"
         ]
        }
       },
       "required": [
        "op",
        "name",
        "value"
       ],
       "type": "object"
      },
      {
       "properties": {
        "id": {
         "description": "New id; edges are rewritten.",
         "type": "string"
        },
        "op": {
         "const": "rename",
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "op",
        "path",
        "id"
       ],
       "type": "object"
      },
      {
       "properties": {
        "label": {
         "description": "Null or empty clears the label.",
         "type": [
          "string",
          "null"
         ]
        },
        "op": {
         "const": "set_label",
         "type": "string"
        },
        "path": {
         "type": "string"
        }
       },
       "required": [
        "op",
        "path"
       ],
       "type": "object"
      }
     ]
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "design_id",
   "ops"
  ],
  "type": "object"
 },
 "name": "tensorcad_apply_ops",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "applied": {
    "description": "One line per operation, in order.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "design_id": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "params_active": {
    "type": "number"
   },
   "params_delta": {
    "description": "Change in total parameters caused by this batch.",
    "type": "number"
   },
   "params_total": {
    "type": "number"
   },
   "previous_revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "revision": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "validation": {
    "additionalProperties": false,
    "properties": {
     "counts": {
      "additionalProperties": false,
      "properties": {
       "error": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "info": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "warning": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       }
      },
      "required": [
       "error",
       "warning",
       "info"
      ],
      "type": "object"
     },
     "ok": {
      "description": "True when nothing blocks building this design.",
      "type": "boolean"
     },
     "top_findings": {
      "description": "The worst few findings. Call tensorcad_validate for all of them.",
      "items": {
       "additionalProperties": false,
       "properties": {
        "hint": {
         "description": "What to change to clear the finding.",
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "path": {
         "description": "Block path the finding is about.",
         "type": "string"
        },
        "port": {
         "type": "string"
        },
        "rule": {
         "description": "Stable rule id, e.g. \"flash-head-dim\".",
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warning",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "rule",
        "severity",
        "message"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "ok",
     "counts",
     "top_findings"
    ],
    "type": "object"
   }
  },
  "required": [
   "design_id",
   "revision",
   "previous_revision",
   "name",
   "applied",
   "params_total",
   "params_active",
   "params_delta",
   "validation"
  ],
  "type": "object"
 },
 "title": "Apply edits"
}
