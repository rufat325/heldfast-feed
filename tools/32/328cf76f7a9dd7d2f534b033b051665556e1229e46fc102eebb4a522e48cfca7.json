{
 "_meta": {
  "_fastmcp": {
   "tags": []
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search manual text/metadata; return ranked hits, snippets and exact identities.\n\nLatest indexed package versions are used unless package_version is supplied.\nOmitted scope filters include all indexed distributions and releases.\nSupply query for relevance-ranked text search, or manual_name without query\nfor name/alias lookup with Fedora-preferred recommendations and case-insensitive fallback.\nPass next_cursor with identical arguments for the next live page; results\ncan shift as indexing progresses. Filters are exact and case-sensitive.",
 "inputSchema": {
  "properties": {
   "architecture": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "cursor": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "distribution": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limit": {
    "default": 20,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "maxLength": 128,
    "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
    "type": "string"
   },
   "manual_name": {
    "anyOf": [
     {
      "maxLength": 256,
      "pattern": "^[^\\s/\\\\]+$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "package": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "package_version": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "query": {
    "anyOf": [
     {
      "maxLength": 1000,
      "minLength": 1,
      "pattern": "^[\\s\\S]*\\S[\\s\\S]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "release": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "repository": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "section": {
    "anyOf": [
     {
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "properties": {
      "manual": {
       "properties": {
        "aliases": {
         "items": {
          "maxLength": 256,
          "pattern": "^[^\\s/\\\\]+$",
          "type": "string"
         },
         "type": "array"
        },
        "locale": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        },
        "manual_id": {
         "format": "uuid",
         "type": "string"
        },
        "name": {
         "maxLength": 256,
         "pattern": "^[^\\s/\\\\]+$",
         "type": "string"
        },
        "section": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        }
       },
       "required": [
        "manual_id",
        "name",
        "section",
        "locale"
       ],
       "type": "object"
      },
      "membership_id": {
       "format": "uuid",
       "type": "string"
      },
      "package": {
       "properties": {
        "architecture": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        },
        "name": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        },
        "package_id": {
         "format": "uuid",
         "type": "string"
        },
        "sha256": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "version": {
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "package_id",
        "name",
        "version",
        "architecture",
        "sha256"
       ],
       "type": "object"
      },
      "revision_id": {
       "pattern": "^[a-f0-9]{64}$",
       "type": "string"
      },
      "scope": {
       "properties": {
        "architecture": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        },
        "distribution": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        },
        "release": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        },
        "repository": {
         "maxLength": 128,
         "pattern": "^[A-Za-z0-9][A-Za-z0-9._+~-]*$",
         "type": "string"
        }
       },
       "required": [
        "distribution",
        "release",
        "repository",
        "architecture"
       ],
       "type": "object"
      },
      "score": {
       "type": "number"
      },
      "snippet": {
       "type": "string"
      }
     },
     "required": [
      "scope",
      "membership_id",
      "package",
      "manual",
      "revision_id",
      "snippet",
      "score"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "items",
   "next_cursor"
  ],
  "type": "object"
 }
}
