   "resourceUri": "ui://widget/agent-task-submitted.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Submit Agent Task"
 },
 "description": "Submit declared output fields for a claimed Agent-stage task and resume the parked document.\n\nUSE WHEN: processing is complete and every required output in output_contract is ready.\nNOT FOR: undeclared fields or partial lease maintenance (use talonic_heartbeat_agent_task).\nARGS: task_id, execution_epoch, outputs keyed exactly by declared field key, and optional summary. The platform validates all fields and types transactionally before writing anything.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
   "__schema0": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "number"
     },
     {
      "type": "boolean"
     },
     {
      "type": "null"
     },
     {
      "items": {
       "allOf": [
        {
         "$ref": "#/definitions/__schema0"
        }
       ]
      },
      "type": "array"
     },
     {
      "additionalProperties": {
       "allOf": [
        {
         "$ref": "#/definitions/__schema0"
        }
       ]
      },
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     }
    ]
   }
  },
  "properties": {
   "execution_epoch": {
    "description": "Execution epoch returned by the successful claim. Stale epochs are rejected.",
    "maximum": 2147483647,
    "minimum": 1,
    "type": "integer"
   },
   "outputs": {
    "additionalProperties": {
     "properties": {
      "confidence": {
       "description": "Optional confidence from 0 to 1.",
       "maximum": 1,
       "minimum": 0,
       "type": "number"
      },
      "reasoning": {
       "description": "Optional concise reasoning for this field, up to 4,000 characters.",
       "maxLength": 4000,
       "type": "string"
      },
      "value": {
       "allOf": [
        {
         "$ref": "#/definitions/__schema0"
        }
       ],
       "description": "JSON value matching the field's declared data type."
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "description": "Output field key to { value, confidence?, reasoning? }. Use only declared fields.",
    "propertyNames": {
     "minLength": 1,
     "type": "string"
    },
    "type": "object"
   },
   "summary": {
    "description": "Optional result summary, up to 4,000 characters.",
    "maxLength": 4000,
    "type": "string"
   },
   "task_id": {
    "description": "Agent task UUID.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "required": [
   "task_id",
   "execution_epoch",
   "outputs"
  ],
  "type": "object"
 },
 "name": "talonic_submit_agent_task",
 "title": "Submit Agent Task"
}
