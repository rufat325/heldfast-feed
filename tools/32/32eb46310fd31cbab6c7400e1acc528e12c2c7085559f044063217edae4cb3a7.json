{
 "description": "Generate ZATCA-compliant e-invoice XML (UBL 2.1) with QR code data. Supports both simplified and standard invoices per ZATCA Phase 2 requirements.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "buyer_name": {
    "description": "Buyer name (required for standard invoices)",
    "type": "string"
   },
   "buyer_vat": {
    "description": "Buyer VAT number (required for standard invoices)",
    "type": "string"
   },
   "currency": {
    "default": "SAR",
    "enum": [
     "SAR",
     "USD",
     "AED",
     "KWD",
     "BHD",
     "OMR",
     "QAR"
    ],
    "type": "string"
   },
   "invoice_number": {
    "description": "Unique invoice reference number",
    "type": "string"
   },
   "invoice_type": {
    "description": "Simplified (B2C) or Standard (B2B) invoice",
    "enum": [
     "simplified",
     "standard"
    ],
    "type": "string"
   },
   "issue_date": {
    "description": "Invoice date in YYYY-MM-DD format",
    "type": "string"
   },
   "line_items": {
    "description": "Invoice line items",
    "items": {
     "properties": {
      "description": {
       "type": "string"
      },
      "discount": {
       "default": 0,
       "description": "Line item discount amount",
       "minimum": 0,
       "type": "number"
      },
      "quantity": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "unit_price": {
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "vat_rate": {
       "description": "VAT rate as percentage (e.g., 15 for 15%)",
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "description",
      "quantity",
      "unit_price",
      "vat_rate"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "note": {
    "description": "Optional invoice note",
    "type": "string"
   },
   "seller_name": {
    "description": "Seller business name in Arabic or English",
    "type": "string"
   },
   "seller_vat": {
    "description": "Seller VAT registration number (15 digits, starts and ends with 3)",
    "pattern": "^3\\d{13}3$",
    "type": "string"
   }
  },
  "required": [
   "invoice_type",
   "seller_name",
   "seller_vat",
   "invoice_number",
   "issue_date",
   "line_items"
  ],
  "type": "object"
 },
 "name": "zatca_generate_invoice_xml"
}
