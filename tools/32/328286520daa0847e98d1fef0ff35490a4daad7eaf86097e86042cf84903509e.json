 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Check Recalls"
 },
 "description": "Read available NHTSA model-year recall campaigns and complaint counts. These records do not establish a specific VIN's recall coverage or repair status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "make": {
    "description": "Vehicle make, such as Toyota",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "model": {
    "description": "Vehicle model, such as RAV4",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "year": {
    "description": "Model year",
    "maximum": 2027,
    "minimum": 1990,
    "type": "integer"
   }
  },
  "required": [
   "make",
   "model",
   "year"
  ],
  "type": "object"
 },
 "name": "check_recalls",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "complaintSummary": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "componentBreakdown": {
        "anyOf": [
         {
          "additionalProperties": {
           "minimum": 0,
           "type": "number"
          },
          "type": "object"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "crashCount": {
        "$ref": "#/properties/complaintSummary/anyOf/0/properties/totalComplaints"
       },
       "deathCount": {
        "$ref": "#/properties/complaintSummary/anyOf/0/properties/totalComplaints"
       },
       "fireCount": {
        "$ref": "#/properties/complaintSummary/anyOf/0/properties/totalComplaints"
       },
       "injuryCount": {
        "$ref": "#/properties/complaintSummary/anyOf/0/properties/totalComplaints"
       },
       "totalComplaints": {
        "anyOf": [
         {
          "minimum": 0,
          "type": "number"
         },
         {
          "type": "null"
         }
        ],
        "default": null
       },
       "yearsCovered": {
        "default": [],
        "items": {
         "type": "integer"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "limitations": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "recallScope": {
    "const": "model_year",
    "type": "string"
   },
   "recalls": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "campaignNumber": {
       "type": "string"
      },
      "component": {
       "type": [
        "string",
        "null"
       ]
      },
      "consequence": {
       "type": [
        "string",
        "null"
       ]
      },
      "remedy": {
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "campaignNumber",
      "component",
      "summary",
      "consequence",
      "remedy"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "retrievedAt": {
    "type": "string"
   },
   "source": {
    "const": "NHTSA",
    "type": "string"
   },
   "sourceUpdatedAt": {
    "type": "null"
   },
   "vehicle": {
    "additionalProperties": false,
    "properties": {
     "make": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "year": {
      "type": "number"
     }
    },
    "required": [
     "make",
     "model",
     "year"
    ],
    "type": "object"
   }
  },
  "required": [
   "vehicle",
   "recallScope",
   "source",
   "retrievedAt",
   "sourceUpdatedAt",
   "limitations"
  ],
  "type": "object"
 },
 "title": "Check Recalls"
}
