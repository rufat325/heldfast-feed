{
 "description": "Create an accessibility nutrition label declaration for an app on a specific device family (Accessibility Nutrition Labels)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "App ID",
    "type": "string"
   },
   "deviceFamily": {
    "description": "Device family this declaration applies to",
    "enum": [
     "IPHONE",
     "IPAD",
     "APPLE_TV",
     "APPLE_WATCH",
     "MAC",
     "VISION"
    ],
    "type": "string"
   },
   "supportsAudioDescriptions": {
    "type": "boolean"
   },
   "supportsCaptions": {
    "type": "boolean"
   },
   "supportsDarkInterface": {
    "type": "boolean"
   },
   "supportsDifferentiateWithoutColorAlone": {
    "type": "boolean"
   },
   "supportsLargerText": {
    "type": "boolean"
   },
   "supportsReducedMotion": {
    "type": "boolean"
   },
   "supportsSufficientContrast": {
    "type": "boolean"
   },
   "supportsVoiceControl": {
    "type": "boolean"
   },
   "supportsVoiceover": {
    "type": "boolean"
   }
  },
  "required": [
   "appId",
   "deviceFamily"
  ],
  "type": "object"
 },
 "name": "apple_create_accessibility_declaration"
}
