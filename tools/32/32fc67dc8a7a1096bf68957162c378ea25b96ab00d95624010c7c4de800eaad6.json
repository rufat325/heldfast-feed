{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update a cumulative usage-limit policy's name, description, complete condition set, credit limit, alert threshold, reset schedule, next reset time, or one grouped value's usage. periodic_reset and periodic_reset_days are mutually exclusive; conditions replace the existing set.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "alert_threshold": {
    "anyOf": [
     {
      "minimum": 0,
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replacement alert threshold"
   },
   "conditions": {
    "description": "Complete replacement condition set",
    "items": {
     "properties": {
      "excludes": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "Values to exclude"
      },
      "key": {
       "description": "Match key such as api_key, virtual_key, provider, config, prompt, model, endpoint_type, mcp_server, mcp_tool, workspace_id, or metadata.*",
       "minLength": 1,
       "type": "string"
      },
      "value": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "items": {
          "type": "string"
         },
         "minItems": 1,
         "type": "array"
        }
       ],
       "description": "One value or several OR-matched values; use * for wildcard matching"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "credit_limit": {
    "description": "Replacement cumulative maximum",
    "minimum": 0,
    "type": "number"
   },
   "description": {
    "anyOf": [
     {
      "maxLength": 500,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replacement description, or null to clear it"
   },
   "id": {
    "description": "Usage-limit policy UUID",
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "description": "Replacement display name",
    "maxLength": 255,
    "type": "string"
   },
   "next_usage_reset_at": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Next reset timestamp in ISO 8601 format, or null to clear it"
   },
   "periodic_reset": {
    "anyOf": [
     {
      "enum": [
       "monthly",
       "weekly"
      ],
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Replacement reset schedule"
   },
   "periodic_reset_days": {
    "anyOf": [
     {
      "maximum": 365,
      "minimum": 1,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "description": "Custom reset interval in days, or null to clear it"
   },
   "reset_usage_for_value": {
    "description": "Grouped value whose usage should reset",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_usage_limit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
