   "annualInsurance": {
    "default": 0,
    "description": "Annual insurance",
    "type": "number"
   },
   "annualPropertyTax": {
    "default": 0,
    "description": "Annual property tax",
    "type": "number"
   },
   "closingCostsPct": {
    "default": 3,
    "description": "Closing costs percentage",
    "type": "number"
   },
   "downPaymentPct": {
