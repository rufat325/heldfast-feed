{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Flagship workflow: map a domain's external attack surface end to end. Discovers subdomains from Certificate Transparency logs, resolves each to find live hosts, and (at standard+ depth) characterizes each live host's DNS records, TLS posture, and HTTP security headers and technology stack, plus optional RDAP/WHOIS registration. At thorough depth with a Shodan key it adds per-IP Shodan enrichment. Returns a structured surface map and a defensive assessment of observable facts (expiring certs, missing security headers, weak TLS) \u2014 never an exploitation plan. All work is passive (public records and the target's own published responses) and SSRF-guarded. Assess only assets you own or are explicitly authorized to test.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "depth": {
    "default": "standard",
    "description": "\"quick\" = subdomains + liveness only; \"standard\" = + DNS/TLS/HTTP posture; \"thorough\" = + Shodan enrichment (when keyed).",
    "enum": [
     "quick",
     "standard",
     "thorough"
    ],
    "type": "string"
   },
   "domain": {
    "description": "Apex domain to map (e.g. \"example.com\").",
    "type": "string"
   },
   "includeRegistration": {
    "default": true,
    "description": "When true (and depth is standard+), include RDAP/WHOIS registration for the apex.",
    "type": "boolean"
   }
  },
  "required": [
   "domain"
  ],
  "type": "object"
 },
 "name": "attacksurface_map_domain",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
