{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Summarize catalogue providers, distinct API model identities, tariff counts and current supported input/output rate ranges in USD per million tokens. Ranges are informational, not workload estimates or capability rankings.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "pricing_tier": {
    "default": "standard",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "provider_id": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "list_providers",
 "outputSchema": {
  "$defs": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "enum": [
       "INVALID_ARGUMENT",
       "MODEL_NOT_FOUND",
       "PRICE_UNREVIEWED",
       "PRICE_EXPIRED",
       "SCOPE_REQUIRED",
       "SCOPE_EXCEEDED",
       "UNSUPPORTED_TARIFF",
       "UNSUPPORTED_CACHE",
       "CATALOGUE_INCONSISTENT",
       "INVALID_CURSOR",
       "CURSOR_EXPIRED",
       "DATASET_CHANGED",
       "NO_COMPARABLE_MODELS",
       "DATASET_UNAVAILABLE",
       "INTERNAL_ERROR"
      ],
      "type": "string"
     },
     "field": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "message": {
      "type": "string"
     },
     "model_id": {
      "anyOf": [
       {
        "maxLength": 200,
        "minLength": 1,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "resolution": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message",
     "field",
     "model_id",
     "resolution"
    ],
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "contract_version": {
      "const": "1.0"
     },
     "dataset_revision": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "dataset_updated_at": {
      "type": "string"
     },
     "evaluated_at": {
      "format": "date-time",
      "type": "string"
     }
    },
    "required": [
     "contract_version",
     "dataset_revision",
     "dataset_updated_at",
     "evaluated_at"
    ],
    "type": "object"
   },
   "warning": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   }
  },
  "oneOf": [
   {
    "additionalProperties": false,
    "properties": {
     "data": {
      "additionalProperties": false,
      "properties": {
       "currency": {
        "const": "USD"
       },
       "providers": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "costing_supported_offers": {
           "minimum": 0,
           "type": "integer"
          },
          "current_offers": {
           "minimum": 0,
           "type": "integer"
          },
          "expired_offers": {
           "minimum": 0,
           "type": "integer"
          },
          "input_rate_range": {
           "anyOf": [
            {
             "additionalProperties": false,
             "properties": {
              "max": {
               "minimum": 0,
               "type": "number"
              },
              "min": {
               "minimum": 0,
               "type": "number"
              }
             },
             "required": [
              "min",
              "max"
             ],
             "type": "object"
            },
            {
             "type": "null"
            }
           ]
          },
          "model_count": {
           "minimum": 0,
           "type": "integer"
          },
          "offer_count": {
           "minimum": 0,
           "type": "integer"
          },
          "output_rate_range": {
           "anyOf": [
            {
             "additionalProperties": false,
             "properties": {
              "max": {
               "minimum": 0,
               "type": "number"
              },
              "min": {
               "minimum": 0,
               "type": "number"
              }
             },
             "required": [
              "min",
              "max"
             ],
             "type": "object"
            },
            {
             "type": "null"
            }
           ]
          },
          "provider_id": {
           "type": "string"
          },
          "provider_label": {
           "type": "string"
          },
          "unreviewed_offers": {
           "minimum": 0,
           "type": "integer"
          }
         },
         "required": [
          "provider_id",
          "provider_label",
          "model_count",
          "offer_count",
          "current_offers",
          "expired_offers",
          "unreviewed_offers",
          "costing_supported_offers",
          "input_rate_range",
          "output_rate_range"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "rate_unit": {
        "const": "per_1000000_tokens"
       },
       "warnings": {
        "items": {
         "$ref": "#/$defs/warning"
        },
        "type": "array"
       }
      },
      "required": [
       "providers",
       "currency",
       "rate_unit",
       "warnings"
      ],
      "type": "object"
     },
     "meta": {
      "$ref": "#/$defs/meta"
     },
     "ok": {
      "const": true
     }
    },
    "required": [
     "ok",
     "meta",
     "data"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "$ref": "#/$defs/error"
     },
     "errors": {
      "items": {
       "$ref": "#/$defs/error"
      },
      "maxItems": 20,
      "type": "array"
     },
     "meta": {
      "anyOf": [
       {
        "$ref": "#/$defs/meta"
       },
       {
        "type": "null"
       }
      ]
     },
     "ok": {
      "const": false
     }
    },
    "required": [
     "ok",
     "meta",
     "error",
     "errors"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 }
}
