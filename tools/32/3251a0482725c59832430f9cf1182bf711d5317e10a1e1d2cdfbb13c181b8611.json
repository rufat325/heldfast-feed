{
 "description": "List terms for any taxonomy (categories, tags, custom taxonomies): id, name, slug, description, parent, count",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "hide_empty": {
    "description": "Hide terms with no posts (default false)",
    "type": "boolean"
   },
   "parent": {
    "description": "Only direct children of this term ID (0 = top level)",
    "minimum": 0,
    "type": "integer"
   },
   "search": {
    "description": "Search term names",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "taxonomy": {
    "description": "Taxonomy name (e.g. category, post_tag, product_cat)",
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   }
  },
  "required": [
   "site",
   "taxonomy"
  ],
  "type": "object"
 },
 "name": "mcp_list_terms"
}
