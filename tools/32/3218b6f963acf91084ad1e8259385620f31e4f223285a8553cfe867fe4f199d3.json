{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": true
 },
 "description": "STRICTLY NO-WRITE activation preview for ordered/prerequisite-driven to-dos. For an item's current immutable activation rule (itemId) or a draft rule and an audience, returns each matched contract's predicted initial state (OPEN vs SCHEDULED \u2014 gated work is born SCHEDULED, invisible to the worker, and a gated provider item stays DORMANT and does not invite/provision until activation) plus exactly which predicates are unmet, including the 'prerequisite not assigned to this person' warning. Default satisfaction is COMPLETED_ONLY; COMPLETED_OR_WAIVED is explicit opt-in. Display order never implies a prerequisite. Requires project_todos:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "audience": {
    "enum": [
     "ACTIVE",
     "FUTURE",
     "ACTIVE_AND_FUTURE",
     "SELECTED"
    ],
    "type": "string"
   },
   "itemId": {
    "description": "Preview this item's CURRENT activation rule (omit rule).",
    "minLength": 1,
    "type": "string"
   },
   "jobId": {
    "minLength": 1,
    "type": "string"
   },
   "rule": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "mode": {
        "enum": [
         "ALL",
         "ANY"
        ],
        "type": "string"
       },
       "predicates": {
        "items": {
         "anyOf": [
          {
           "additionalProperties": false,
           "properties": {
            "itemId": {
             "description": "Same-job prerequisite item id (stable).",
             "minLength": 1,
             "type": "string"
            },
            "kind": {
             "const": "todo_completed",
             "type": "string"
            },
            "satisfaction": {
             "enum": [
              "COMPLETED_ONLY",
              "COMPLETED_OR_WAIVED"
             ],
             "type": "string"
            }
           },
           "required": [
            "kind",
            "itemId"
           ],
           "type": "object"
          },
          {
           "additionalProperties": false,
           "properties": {
            "anchor": {
             "enum": [
              "ASSIGNED",
              "CONTRACT_START"
             ],
             "type": "string"
            },
            "kind": {
             "const": "after_delay",
             "type": "string"
            },
            "offsetMinutes": {
             "exclusiveMinimum": 0,
             "maximum": 525600,
             "type": "integer"
            }
           },
           "required": [
            "kind",
            "anchor",
            "offsetMinutes"
           ],
           "type": "object"
          }
         ]
        },
        "maxItems": 10,
        "minItems": 1,
        "type": "array"
       },
       "schemaVersion": {
        "const": 1,
        "type": "number"
       }
      },
      "required": [
       "schemaVersion",
       "mode",
       "predicates"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Draft activation rule to preview before publishing."
   },
   "selectedContractIds": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "type": "array"
   }
  },
  "required": [
   "jobId",
   "audience"
  ],
  "type": "object"
 },
 "name": "opentrain_preview_project_todo_activation",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": {},
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
