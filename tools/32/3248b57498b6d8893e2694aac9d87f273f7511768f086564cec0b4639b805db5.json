{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create a letter"
 },
 "description": "Create a printed letter order (up to 3 pages, 8.5x11, mailed in a #10 envelope) and get a payment link. Mails only after the user pays. Set certified to \"certified\" ($14.99) for USPS Certified Mail with tracking and proof of delivery, or \"certified_return_receipt\" ($19.99) to add the recipient's signature; use these when the user needs proof (landlord notices, legal or tax replies, disputes). Regular letters are $4.99.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "certified": {
    "default": "none",
    "description": "USPS Certified Mail. \"certified\" ($14.99): tracking number and proof of mailing and delivery. \"certified_return_receipt\" ($19.99): adds the recipient's signature as proof of delivery, which landlords, courts and agencies often require. \"none\" ($4.99): regular First-Class.",
    "enum": [
     "none",
     "certified",
     "certified_return_receipt"
    ],
    "type": "string"
   },
   "content": {
    "description": "The letter text and font",
    "properties": {
     "body": {
      "description": "Full letter text. Plain text; blank lines separate paragraphs.",
      "maxLength": 9000,
      "minLength": 1,
      "type": "string"
     },
     "font": {
      "default": "serif",
      "description": "Typeface for the letter body",
      "enum": [
       "serif",
       "sans"
      ],
      "type": "string"
     },
     "image_url": {
      "description": "Optional photo printed at the top of the letter (https JPG or PNG). A letter with a photo prints in color, for a small surcharge (see get_pricing).",
      "maxLength": 2000,
      "type": "string"
     }
    },
    "required": [
     "body"
    ],
    "type": "object"
   },
   "customer_email": {
    "description": "Where to send the receipt and status updates",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "from": {
    "description": "Return address; printed on the mail piece",
    "properties": {
     "city": {
      "description": "City",
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "company": {
      "description": "Company name, printed under the person's name",
      "maxLength": 60,
      "type": "string"
     },
     "line1": {
      "description": "Street address",
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
     },
     "line2": {
      "description": "Apartment, suite, unit",
      "maxLength": 64,
      "type": "string"
     },
     "name": {
      "description": "Recipient or sender full name",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "description": "Two-letter US state code, e.g. NY",
      "type": "string"
     },
     "zip": {
      "description": "5-digit US ZIP code, or ZIP+4",
      "pattern": "^\\d{5}(-\\d{4})?$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "city",
     "state",
     "zip"
    ],
    "type": "object"
   },
   "idempotency_key": {
    "description": "Any unique string; retrying with the same key returns the original order instead of creating a duplicate",
    "maxLength": 120,
    "type": "string"
   },
   "to": {
    "description": "Recipient's US mailing address",
    "properties": {
     "city": {
      "description": "City",
      "maxLength": 40,
      "minLength": 2,
      "type": "string"
     },
     "company": {
      "description": "Company name, printed under the person's name",
      "maxLength": 60,
      "type": "string"
     },
     "line1": {
      "description": "Street address",
      "maxLength": 64,
      "minLength": 3,
      "type": "string"
     },
     "line2": {
      "description": "Apartment, suite, unit",
      "maxLength": 64,
      "type": "string"
     },
     "name": {
      "description": "Recipient or sender full name",
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "state": {
      "description": "Two-letter US state code, e.g. NY",
      "type": "string"
     },
     "zip": {
      "description": "5-digit US ZIP code, or ZIP+4",
      "pattern": "^\\d{5}(-\\d{4})?$",
      "type": "string"
     }
    },
    "required": [
     "name",
     "line1",
     "city",
     "state",
     "zip"
    ],
    "type": "object"
   }
  },
  "required": [
   "to",
   "from",
   "content"
  ],
  "type": "object"
 },
 "name": "create_letter",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "certified": {
    "description": "none, certified or certified_return_receipt",
    "type": "string"
   },
   "checkout_url": {
    "description": "Where the user pays; null once paid or cancelled",
    "type": [
     "string",
     "null"
    ]
   },
   "discount": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "amount_cents": {
        "type": "number"
       },
       "display": {
        "type": "string"
       },
       "reason": {
        "type": "string"
       }
      },
      "required": [
       "amount_cents",
       "display",
       "reason"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "First-order discount, already taken off price; null when none applies"
   },
   "id": {
    "description": "Order id, ord_\u2026",
    "type": "string"
   },
   "object": {
    "enum": [
     "postcard",
     "letter"
    ],
    "type": "string"
   },
   "order_url": {
    "description": "Order status page",
    "type": "string"
   },
   "preview_url": {
    "description": "Exact print preview",
    "type": "string"
   },
   "price": {
    "additionalProperties": false,
    "properties": {
     "amount_cents": {
      "type": "number"
     },
     "currency": {
      "type": "string"
     },
     "display": {
      "type": "string"
     }
    },
    "required": [
     "amount_cents",
     "currency",
     "display"
    ],
    "type": "object"
   },
   "product": {
    "description": "Product id, e.g. postcard_4x6 or letter_certified",
    "type": "string"
   },
   "product_name": {
    "type": "string"
   },
   "status": {
    "description": "awaiting_payment, paid, printing, mailed, cancelled or refunded",
    "type": "string"
   },
   "status_detail": {
    "description": "Plain-English status to show the user",
    "type": "string"
   },
   "tracking": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "number": {
        "type": "string"
       },
       "url": {
        "type": "string"
       }
      },
      "required": [
       "number",
       "url"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "USPS tracking, for Certified Mail once printed"
   }
  },
  "required": [
   "id",
   "object",
   "product",
   "product_name",
   "certified",
   "status",
   "status_detail",
   "price",
   "checkout_url",
   "order_url",
   "preview_url",
   "tracking",
   "discount"
  ],
  "type": "object"
 },
 "title": "Create a letter"
}
