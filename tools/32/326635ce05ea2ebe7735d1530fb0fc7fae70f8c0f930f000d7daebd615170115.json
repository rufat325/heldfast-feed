{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "For a donor-recipient pair, which genome carries each actionable HLA-drug association. Screens both typings as pgx_lookup does and marks every CPIC level-A, allele-positive association in_recipient, in_donor, discordant (present in exactly one) and whose_hla (both / recipient_only / donor_only). Guideline lookup over published CPIC and PharmGKB associations, keyed by two-field HLA allele. Decision support only; not a medical device. After an allogeneic transplant the recipient's blood carries the donor's genome, and which genome should drive an HLA-mediated drug alert is an open question (NCT06856226); this lookup reports both and decides nothing. Allele strings only, no patient identifiers.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "donor": {
    "additionalProperties": false,
    "description": "Donor typing: {\"typing\": {...}} or {\"alleles\": [...]}.",
    "properties": {
     "alleles": {
      "items": {
       "maxLength": 64,
       "type": "string"
      },
      "maxItems": 96,
      "type": "array"
     },
     "typing": {
      "additionalProperties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": "locus -> up to 4 reported allele names. Allele strings only: never patient names, medical record numbers, dates of birth, or accession or case identifiers.",
      "type": "object"
     }
    },
    "type": "object"
   },
   "recipient": {
    "additionalProperties": false,
    "description": "Recipient typing: {\"typing\": {...}} or {\"alleles\": [...]}.",
    "properties": {
     "alleles": {
      "items": {
       "maxLength": 64,
       "type": "string"
      },
      "maxItems": 96,
      "type": "array"
     },
     "typing": {
      "additionalProperties": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "description": "locus -> up to 4 reported allele names. Allele strings only: never patient names, medical record numbers, dates of birth, or accession or case identifiers.",
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "recipient",
   "donor"
  ],
  "type": "object"
 },
