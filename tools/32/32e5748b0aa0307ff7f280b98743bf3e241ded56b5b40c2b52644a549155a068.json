     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Two-letter country code, e.g. US or UZ.",
    "title": "Country"
   },
   "limit": {
    "default": 5,
    "description": "Number of results per collection.",
    "maximum": 20,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "page": {
    "default": 1,
    "description": "Pagination page number.",
    "maximum": 1000,
    "minimum": 1,
    "title": "Page",
    "type": "integer"
   },
   "query": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "Short product keywords. Use catalogue language.",
    "title": "Query"
   },
   "store": {
    "anyOf": [
     {
      "maxLength": 200,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
