{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Choose this only when the caller supplies explicit website assertions that need pass/fail results across three viewports. For broad exploratory browser QA use check_page instead. Assertion types: noHorizontalOverflow, noConsoleErrors, textVisible, titleIncludes, selectorExists, selectorVisible. Costs $0.10 USDC via x402. Requires an x402-aware client; standard AI assistants cannot automatically sign x402.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assertions": {
    "description": "One to twenty explicit pass/fail assertions to evaluate across all three viewports.",
    "items": {
     "anyOf": [
      {
       "additionalProperties": false,
       "properties": {
        "type": {
         "const": "noHorizontalOverflow",
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "type": {
         "const": "noConsoleErrors",
         "type": "string"
        }
       },
       "required": [
        "type"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "type": {
         "const": "textVisible",
         "type": "string"
        },
        "value": {
         "description": "Visible text to find on the rendered page.",
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "type",
        "value"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "type": {
         "const": "titleIncludes",
         "type": "string"
        },
        "value": {
         "description": "Text that the document title must include.",
         "maxLength": 200,
         "minLength": 1,
         "type": "string"
        }
       },
       "required": [
        "type",
        "value"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "selector": {
         "description": "CSS selector that must exist in the DOM.",
         "maxLength": 300,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "selectorExists",
         "type": "string"
        }
       },
       "required": [
        "type",
        "selector"
       ],
       "type": "object"
      },
      {
       "additionalProperties": false,
       "properties": {
        "selector": {
         "description": "CSS selector that must be visibly rendered.",
         "maxLength": 300,
         "minLength": 1,
         "type": "string"
        },
        "type": {
         "const": "selectorVisible",
         "type": "string"
        }
       },
       "required": [
        "type",
        "selector"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   },
   "url": {
    "description": "Public HTTPS page URL. Private, loopback, credentialed, and non-HTTPS URLs are rejected.",
    "format": "uri",
    "maxLength": 2048,
    "type": "string"
   }
  },
  "required": [
   "url",
   "assertions"
  ],
  "type": "object"
 },
 "name": "verify_page"
}
