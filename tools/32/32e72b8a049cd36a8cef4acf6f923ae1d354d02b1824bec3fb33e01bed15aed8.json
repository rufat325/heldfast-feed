{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Free pilot: convert dated decimal-string amounts to a target_currency chosen from 30 supported currencies, including EUR (default), USD, JPY, CNY, GBP, CHF, INR and KRW. Use exact-date ECB historical references; derived cross conversions use amount * target units per EUR / source units per EUR without intermediate rounding. Up to 500 rows, eight currency/year snapshots including target rates, 48,000 UTF-8 argument bytes; start small. Unique id per row. Half-even rounding by default, ISO 4217 minor-unit rounding per line: zero decimals for JPY/KRW/ISK, two for other supported targets; target_decimal_places reports precision; total_target sums rounded lines. amount_target is the result; legacy amount_eur/total_eur are null for non-EUR targets. Same-currency rows use identity without an external quote. Preserve originals and evidence for both currencies from the same source edition. Missing, stale or mismatched rates block complete export and total; never replace dates. JSON default; output_format=both includes CSV. ECB originals are free; indicative calculations are not executable prices or accounting/tax certification. No transfers, independent factual verification, customer-content retention or content logging.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "output_format": {
    "default": "json",
    "description": "json keeps the response smaller. both includes the CSV in the same free result; no separate export purchase.",
    "enum": [
     "json",
     "both"
    ],
    "type": "string"
   },
   "rounding": {
    "default": "half_even",
    "enum": [
     "half_even",
     "half_away_from_zero"
    ],
    "type": "string"
   },
   "rows": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "pattern": "^-?\\d{1,36}(?:\\.\\d{1,18})?$",
       "type": "string"
      },
      "currency": {
       "pattern": "^[A-Z]{3}$",
       "type": "string"
      },
      "date": {
       "type": "string"
      },
      "id": {
       "maxLength": 64,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "id",
      "date",
      "currency",
      "amount"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   },
   "target_currency": {
    "default": "EUR",
    "enum": [
     "EUR",
     "USD",
     "JPY",
     "CZK",
     "DKK",
     "GBP",
     "HUF",
     "PLN",
     "RON",
     "SEK",
     "CHF",
     "ISK",
     "NOK",
     "TRY",
     "AUD",
     "BRL",
     "CAD",
     "CNY",
     "HKD",
     "IDR",
     "ILS",
     "INR",
     "KRW",
     "MXN",
     "MYR",
     "NZD",
     "PHP",
     "SGD",
     "THB",
     "ZAR"
    ],
    "type": "string"
   }
  },
  "required": [
   "rows"
  ],
  "type": "object"
 },
 "name": "convert_currency_batch",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "billing": {
    "additionalProperties": false,
    "properties": {
     "charged": {
      "const": false,
      "type": "boolean"
     },
     "enabled": {
      "const": false,
      "type": "boolean"
     }
    },
    "required": [
     "enabled",
     "charged"
    ],
    "type": "object"
   },
   "blocked_rows": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "complete_artifact_available": {
    "type": "boolean"
   },
   "rows": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "row": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "status": {
       "enum": [
