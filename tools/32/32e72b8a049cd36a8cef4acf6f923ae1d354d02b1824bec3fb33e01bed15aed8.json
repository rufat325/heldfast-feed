     "IDR",
     "ILS",
     "INR",
     "KRW",
     "MXN",
     "MYR",
     "NZD",
     "PHP",
     "SGD",
     "THB",
     "ZAR"
    ],
    "type": "string"
   },
   "target_decimal_places": {
    "anyOf": [
