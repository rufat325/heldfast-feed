    ],
    "type": "string"
   },
   "target_currency": {
    "enum": [
     "EUR",
     "USD",
     "JPY",
     "CZK",
     "DKK",
     "GBP",
     "HUF",
     "PLN",
     "RON",
     "SEK",
     "CHF",
     "ISK",
     "NOK",
     "TRY",
     "AUD",
     "BRL",
     "CAD",
     "CNY",
