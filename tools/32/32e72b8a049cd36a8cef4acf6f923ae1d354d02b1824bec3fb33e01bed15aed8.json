       ],
       "type": "string"
      }
     },
     "required": [
      "row",
      "status"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "sources": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "evidence_sha256": {
       "type": "string"
      },
      "independently_verified": {
       "const": false,
       "type": "boolean"
      },
      "record_id": {
       "type": "string"
      },
      "source_url": {
       "type": "string"
      }
     },
     "required": [
      "record_id",
      "source_url",
      "evidence_sha256",
      "independently_verified"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "status": {
    "enum": [
