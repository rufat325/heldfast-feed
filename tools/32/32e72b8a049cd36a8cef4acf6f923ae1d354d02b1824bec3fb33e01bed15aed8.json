    ]
   },
   "total_target": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "target_currency",
   "target_decimal_places",
   "rows",
   "sources",
   "blocked_rows",
   "total_eur",
   "total_target",
   "complete_artifact_available",
   "billing"
  ],
  "type": "object"
 }
}
