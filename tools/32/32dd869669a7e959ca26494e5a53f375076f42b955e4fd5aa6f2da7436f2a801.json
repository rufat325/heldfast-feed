{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Get a current-authorized exact page link and optionally validate a stable-node anchor. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   },
   "pageId": {
    "$ref": "#/properties/folderId"
   },
   "query": {
    "additionalProperties": false,
    "properties": {
     "anchor": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "folderId",
   "pageId"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_page_link",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "anchorId": {
      "type": [
       "string",
       "null"
      ]
     },
     "anchorUrl": {
      "type": [
       "string",
       "null"
      ]
     },
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "folderId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "pageId": {
      "$ref": "#/properties/result/properties/folderId"
     },
     "shareUrl": {
      "$ref": "#/properties/result/properties/title"
     },
     "title": {
      "type": "string"
     }
    },
    "required": [
     "canonicalSource",
     "folderId",
     "pageId",
     "title",
     "shareUrl",
     "anchorId",
     "anchorUrl"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
