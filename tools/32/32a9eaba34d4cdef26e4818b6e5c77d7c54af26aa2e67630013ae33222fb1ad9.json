{
 "description": "Read the last N lines from stdout/stderr logs for a tracked background process.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "lines": {
    "default": 200,
    "description": "Number of lines to read from the end of each log.",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "pid": {
    "description": "PID to inspect.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "pid"
  ],
  "type": "object"
 },
 "name": "tail_background"
}
