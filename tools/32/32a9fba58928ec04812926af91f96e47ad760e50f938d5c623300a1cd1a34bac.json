{
 "description": "Check the status of a previously submitted physical-solution request. Returns a generated machine draft as soon as it exists, with a versioned delivery receipt that distinguishes pending_machine_draft, generation_failed, generation_expired, machine_draft, and operator_published. The receipt exposes privacy-minimized automatic-generation progress: observed attempt count, fixed maximum, current eligibility, and exact next automatic-attempt time, without model errors or request content. Professional engineering, supplier-quote, and physical-action claims remain false. generation_failed and generation_expired are terminal for that request id and permit only a caller-confirmed new request from caller-held input. For an immutable revision, it also returns its persisted deterministic readiness_progress comparison.",
 "inputSchema": {
  "properties": {
   "request_id": {
    "description": "The request_id returned by request_physical_solution, e.g. A2A2P-7K2M4X.",
    "type": "string"
   }
  },
  "required": [
   "request_id"
  ],
  "type": "object"
 },
 "name": "check_request_status",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "message": {
    "type": "string"
   },
   "quote": {
    "type": "object"
   },
   "readiness_progress": {
    "type": "object"
   },
   "report_delivery": {
    "$id": "https://a2a2p.com/schema/resolution-report-delivery",
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "additionalProperties": false,
    "allOf": [
     {
      "if": {
       "properties": {
        "state": {
         "const": "pending_machine_draft"
        }
       },
       "required": [
        "state"
       ]
      },
      "then": {
       "properties": {
        "available": {
         "const": false
        },
        "operator_published": {
         "const": false
        },
        "retry": {
         "properties": {
          "allowed": {
           "const": false
          },
          "caller_confirmation_required": {
           "const": false
          },
          "operation": {
           "const": null
          }
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "state": {
         "const": "generation_failed"
        }
       },
       "required": [
        "state"
       ]
      },
      "then": {
       "properties": {
        "available": {
         "const": false
        },
        "generation": {
         "properties": {
          "state": {
           "enum": [
            "attempts_exhausted",
            "invalid_state"
           ]
          }
         }
        },
        "operator_published": {
         "const": false
        },
        "retry": {
         "properties": {
          "allowed": {
           "const": true
          },
          "caller_confirmation_required": {
           "const": true
          },
          "operation": {
           "const": "request_physical_solution"
          }
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "state": {
         "const": "generation_expired"
        }
       },
       "required": [
        "state"
       ]
      },
      "then": {
       "properties": {
        "available": {
         "const": false
        },
        "operator_published": {
         "const": false
        },
        "retry": {
         "properties": {
          "allowed": {
           "const": true
          },
          "caller_confirmation_required": {
           "const": true
          },
          "operation": {
           "const": "request_physical_solution"
          }
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "state": {
         "const": "machine_draft"
        }
       },
       "required": [
        "state"
       ]
      },
      "then": {
       "properties": {
        "available": {
         "const": true
        },
        "operator_published": {
         "const": false
        },
        "retry": {
         "properties": {
          "allowed": {
           "const": false
          },
          "caller_confirmation_required": {
           "const": false
          },
          "operation": {
           "const": null
          }
         }
        }
       }
      }
     },
     {
      "if": {
       "properties": {
        "state": {
         "const": "operator_published"
        }
       },
       "required": [
        "state"
       ]
      },
      "then": {
       "properties": {
        "available": {
         "const": true
        },
        "operator_published": {
         "const": true
        },
        "retry": {
         "properties": {
          "allowed": {
           "const": false
          },
          "caller_confirmation_required": {
           "const": false
          },
          "operation": {
           "const": null
          }
         }
        }
       }
      }
     }
    ],
    "description": "Distinguishes report availability and publication provenance from request lifecycle, supplier quoting, and physical authority.",
    "properties": {
     "authority": {
      "additionalProperties": false,
      "properties": {
       "fabrication": {
        "const": false,
        "type": "boolean"
       },
       "payment": {
        "const": false,
        "type": "boolean"
       },
       "purchase": {
        "const": false,
        "type": "boolean"
       },
       "shipment": {
        "const": false,
        "type": "boolean"
       },
       "supplier_contact": {
        "const": false,
        "type": "boolean"
       }
      },
      "required": [
       "supplier_contact",
       "purchase",
       "payment",
       "fabrication",
       "shipment"
      ],
      "type": "object"
     },
     "available": {
      "type": "boolean"
     },
     "contract": {
      "const": "a2a2p.resolution-report-delivery"
     },
     "external_action": {
      "const": false,
      "type": "boolean"
     },
     "generation": {
      "additionalProperties": false,
      "allOf": [
       {
        "if": {
         "properties": {
          "state": {
           "enum": [
            "not_observed",
            "invalid_state"
           ]
          }
         },
         "required": [
          "state"
         ]
        },
        "then": {
         "properties": {
          "attempt_count_observed": {
           "const": null
          },
          "history_complete": {
           "const": false
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "state": {
           "enum": [
            "attempting",
            "retry_scheduled",
            "succeeded",
            "attempts_exhausted"
           ]
          }
         },
         "required": [
          "state"
         ]
        },
        "then": {
         "properties": {
          "attempt_count_observed": {
           "minimum": 1,
           "type": "integer"
          },
          "history_complete": {
           "const": true
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "state": {
           "enum": [
            "succeeded",
            "attempts_exhausted",
            "invalid_state"
           ]
          }
         },
         "required": [
          "state"
         ]
        },
        "then": {
         "properties": {
          "automatic_retry_eligible": {
           "const": false
          },
          "next_automatic_attempt_not_before": {
           "const": null
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "state": {
           "const": "attempts_exhausted"
          }
         },
         "required": [
          "state"
         ]
        },
        "then": {
         "properties": {
          "attempt_count_observed": {
           "const": 3
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "automatic_retry_eligible": {
           "const": false
          },
          "state": {
           "enum": [
            "attempting",
            "retry_scheduled"
           ]
          }
         },
         "required": [
          "state",
          "automatic_retry_eligible"
         ]
        },
        "then": {
         "properties": {
          "next_automatic_attempt_not_before": {
           "format": "date-time",
           "type": "string"
          }
         }
        }
       },
       {
        "if": {
         "properties": {
          "automatic_retry_eligible": {
           "const": true
          },
          "state": {
           "enum": [
            "attempting",
            "retry_scheduled"
           ]
          }
         },
         "required": [
          "state",
          "automatic_retry_eligible"
         ]
        },
        "then": {
         "properties": {
          "next_automatic_attempt_not_before": {
           "const": null
          }
         }
        }
       }
      ],
      "properties": {
       "attempt_count_observed": {
        "maximum": 3,
        "minimum": 0,
        "type": [
         "integer",
         "null"
        ]
       },
       "automatic_retry_eligible": {
        "type": "boolean"
       },
       "contract": {
        "const": "a2a2p.draft-generation-policy"
       },
       "history_complete": {
        "type": "boolean"
       },
       "max_attempts": {
        "const": 3,
        "type": "integer"
       },
       "next_automatic_attempt_not_before": {
        "format": "date-time",
        "type": [
         "string",
         "null"
        ]
       },
       "state": {
        "enum": [
         "not_observed",
         "attempting",
         "retry_scheduled",
         "succeeded",
         "attempts_exhausted",
         "invalid_state"
        ],
        "type": "string"
       },
       "version": {
        "const": "1.1.0"
       }
      },
      "required": [
       "contract",
       "version",
       "state",
       "attempt_count_observed",
       "max_attempts",
       "history_complete",
       "automatic_retry_eligible",
       "next_automatic_attempt_not_before"
      ],
      "type": "object"
     },
     "limitations": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "operator_published": {
      "type": "boolean"
     },
     "professional_engineering_review_claimed": {
      "const": false,
      "type": "boolean"
     },
     "retry": {
      "additionalProperties": false,
      "properties": {
       "allowed": {
        "type": "boolean"
       },
       "caller_confirmation_required": {
        "type": "boolean"
       },
       "operation": {
        "enum": [
         null,
         "request_physical_solution"
        ]
       },
       "same_request_id": {
        "const": false,
        "type": "boolean"
       }
      },
      "required": [
       "allowed",
       "same_request_id",
       "operation",
       "caller_confirmation_required"
      ],
      "type": "object"
     },
     "state": {
      "enum": [
       "pending_machine_draft",
       "generation_failed",
       "generation_expired",
       "machine_draft",
       "operator_published"
      ],
      "type": "string"
     },
     "supplier_quote": {
      "const": false,
      "type": "boolean"
     },
     "version": {
      "const": "1.4.0"
     }
    },
    "required": [
     "contract",
     "version",
     "state",
     "generation",
     "available",
     "operator_published",
     "professional_engineering_review_claimed",
     "supplier_quote",
     "external_action",
     "retry",
     "authority",
     "limitations"
    ],
    "title": "a2a2p resolution-report delivery receipt",
    "type": "object"
   },
   "request_id": {
    "type": "string"
   },
   "resolution_report": {
    "type": "object"
   },
   "status": {
    "type": "string"
   },
   "submitted": {
    "type": "string"
   }
  },
  "required": [
   "request_id",
   "status",
   "submitted",
   "report_delivery"
  ],
  "type": "object"
 }
}
