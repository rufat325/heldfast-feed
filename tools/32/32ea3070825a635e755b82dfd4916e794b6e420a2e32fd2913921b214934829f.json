{
 "description": "List Frappe documents with optional filters",
 "inputSchema": {
  "properties": {
   "doctype": {
    "description": "DocType to list",
    "type": "string"
   },
   "filters": {
    "description": "Filters as key-value pairs",
    "type": "object"
   },
   "limit": {
    "default": 20,
    "description": "Maximum number of results",
    "type": "number"
   },
   "site": {
    "description": "Site name",
    "type": "string"
   }
  },
  "required": [
   "doctype",
   "site"
  ],
  "type": "object"
 },
 "name": "frappe_list_documents"
}
