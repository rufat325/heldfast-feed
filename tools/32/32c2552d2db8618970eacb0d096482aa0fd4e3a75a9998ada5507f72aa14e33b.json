{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Recommend an MCP stack for a workflow"
 },
 "description": "For a multi-step workflow, recommend the set of MCPs needed, each one's role, the workflow order, and which are required vs optional. Does not pad the stack with unnecessary MCPs and reports any capabilities left uncovered.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deployment_preference": {
    "enum": [
     "remote",
     "local"
    ],
    "type": "string"
   },
   "open_source_preference": {
    "type": "boolean"
   },
   "platform": {
    "type": "string"
   },
   "pricing_preference": {
    "type": "string"
   },
   "task": {
    "description": "The workflow to accomplish",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "task"
  ],
  "type": "object"
 },
 "name": "recommend_stack",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "intent": {
    "additionalProperties": true,
    "properties": {},
    "type": "object"
   },
   "optional": {
    "items": {
     "$ref": "#/properties/intent"
    },
    "type": "array"
   },
   "reasoningSummary": {
    "type": "string"
   },
   "required": {
    "items": {
     "$ref": "#/properties/intent"
    },
    "type": "array"
   },
   "requiredCapabilities": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workflow": {
    "items": {
     "$ref": "#/properties/intent"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Recommend an MCP stack for a workflow"
}
