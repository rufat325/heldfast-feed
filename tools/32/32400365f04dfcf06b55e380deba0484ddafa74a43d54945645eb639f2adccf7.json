{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Org Analytics"
 },
 "description": "Read organization-wide analytics: view org (GET /analytics/org, the get_org_analytics rollup) or view resolutions (GET /analytics/resolutions, paginated AI issue-resolution history, filterable by severity, category, and pattern-detected). Read tier.",
 "inputSchema": {
  "properties": {
   "category": {
    "description": "resolutions only: filter by issue_category.",
    "type": "string"
   },
   "limit": {
    "description": "resolutions only: page size (default 50, max 200).",
    "type": "integer"
   },
   "offset": {
    "description": "resolutions only: page offset.",
    "type": "integer"
   },
   "pattern": {
    "description": "resolutions only: true to filter to pattern_detected rows only.",
    "type": "boolean"
   },
   "severity": {
    "description": "resolutions only: filter by classification_severity.",
    "type": "string"
   },
   "view": {
    "description": "Which analytics surface to read.",
    "enum": [
     "org",
     "resolutions"
    ],
    "type": "string"
   }
  },
  "required": [
   "view"
  ],
  "type": "object"
 },
 "name": "tascan_org_analytics"
}
