{
 "_meta": {
  "agents-x402/paymentRequired": true,
  "agents-x402/priceUSD": 0.005
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Observe and Verify URL"
 },
 "description": "Buy a FreshProof URL observation and immediately evaluate declarative trust policy rules against the resulting proof. This combines observe_url and verify_proof in one paid agent workflow.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "max_age": {
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "policy": {
    "additionalProperties": false,
    "description": "Declarative policy evaluated against the resulting proof",
    "properties": {
     "changed_since_content_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "content_hash_equals": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
     },
     "final_host_equals": {
      "minLength": 1,
      "type": "string"
     },
     "max_age_seconds": {
      "maximum": 9007199254740991,
      "minimum": 0,
      "type": "integer"
     },
     "original_host_equals": {
      "minLength": 1,
      "type": "string"
     },
     "require_same_origin_redirect": {
      "type": "boolean"
     },
     "status_in": {
      "items": {
       "maximum": 599,
       "minimum": 100,
       "type": "integer"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   },
   "url": {
    "description": "Public HTTP or HTTPS URL to observe and verify",
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "url",
   "policy"
  ],
  "type": "object"
 },
 "name": "verify_url"
}
