  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "$ref": "#/properties/folderId"
   },
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "folderId",
   "assetId"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_video_status",
