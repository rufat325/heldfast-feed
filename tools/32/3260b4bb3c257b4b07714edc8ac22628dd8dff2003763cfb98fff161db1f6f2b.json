{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Read provider readiness for a page-bound asset; may refresh readiness metadata. Does not claim playback in a browser. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:read.",
 "execution": {
  "taskSupport": "forbidden"
 },
