  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "assetId": {
      "$ref": "#/properties/result/properties/folderId"
     },
     "browserVerified": {
      "const": false,
      "type": "boolean"
     },
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "durationSeconds": {
      "type": [
       "number",
       "null"
      ]
     },
     "errorCode": {
      "type": [
       "string",
       "null"
      ]
     },
     "folderId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "heightPx": {
      "anyOf": [
       {
        "$ref": "#/properties/result/properties/widthPx/anyOf/0"
       },
       {
        "type": "null"
       }
      ]
     },
     "pageId": {
      "$ref": "#/properties/result/properties/folderId"
     },
     "playbackReady": {
      "type": "boolean"
     },
     "provider": {
