       "PENDING",
       "PROCESSING",
       "READY",
       "ERRORED"
      ],
      "type": "string"
     },
     "storageReady": {
      "type": "boolean"
     },
     "uploadExpiresAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "url": {
      "type": "string"
     },
     "widthPx": {
      "anyOf": [
       {
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "canonicalSource",
     "folderId",
     "pageId",
     "assetId",
     "provider",
     "status",
     "storageReady",
     "playbackReady",
     "browserVerified",
     "url",
     "durationSeconds",
     "widthPx",
     "heightPx",
     "errorCode",
     "uploadExpiresAt"
    ],
    "type": "object"
   }
  },
  "required": [
