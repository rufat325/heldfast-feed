{
 "annotations": {
  "destructiveHint": true,
  "title": "Create an estimate"
 },
 "description": "Create an estimate for a customer with one or more options (e.g. Good / Better / Best), each with line items priced in cents. Give an existing address_id or a new address. Housecall Pro: POST /estimates.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "A new address, if no address_id.",
    "properties": {
     "city": {
      "type": "string"
     },
     "country": {
      "type": "string"
     },
     "state": {
      "type": "string"
     },
     "street": {
      "type": "string"
     },
     "street_line_2": {
      "type": "string"
     },
     "zip": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "address_id": {
    "description": "An existing address of the customer.",
    "type": "string"
   },
   "assigned_employee_ids": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "business_unit_id": {
    "type": "string"
   },
   "customer_id": {
    "description": "The customer id.",
    "minLength": 1,
    "type": "string"
   },
   "estimate_number": {
    "description": "Must be unique across the company's estimates; auto-assigned if omitted.",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "job_type_id": {
    "description": "From housecall_list_job_types.",
    "type": "string"
   },
   "lead_source": {
    "type": "string"
   },
   "message": {
    "description": "Message to the customer.",
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "options": {
    "description": "The estimate's options.",
    "items": {
     "properties": {
      "line_items": {
       "items": {
        "properties": {
         "description": {
          "type": "string"
         },
         "name": {
          "description": "Line item name.",
          "minLength": 1,
          "type": "string"
         },
         "quantity": {
          "description": "Quantity; up to two decimal places.",
          "type": "number"
         },
         "unit_cost": {
          "description": "Direct cost of one unit to the company, in CENTS (job costing).",
          "type": "number"
         },
         "unit_price": {
          "description": "Selling price of one unit, in CENTS.",
          "type": "number"
         }
        },
        "required": [
         "name"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "name": {
       "description": "Option name, e.g. 'Standard repair'.",
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "schedule": {
    "description": "When the estimate visit is scheduled.",
    "properties": {
     "arrival_window_in_minutes": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "end_time": {
      "description": "ISO-8601 end.",
      "type": "string"
     },
     "notify_customer": {
      "type": "boolean"
     },
     "start_time": {
      "description": "ISO-8601 start.",
      "type": "string"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "customer_id"
  ],
  "type": "object"
 },
 "name": "housecall_create_estimate",
 "title": "Create an estimate"
}
