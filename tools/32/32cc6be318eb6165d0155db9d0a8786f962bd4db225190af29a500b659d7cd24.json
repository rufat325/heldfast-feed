{
 "description": "Grouped production errors, newest first. Each issue has an id usable with octri_get_issue.",
 "inputSchema": {
  "properties": {
   "level": {
    "enum": [
     "debug",
     "info",
     "warning",
     "error",
     "fatal"
    ],
    "type": "string"
   },
   "limit": {
    "type": "number"
   },
   "project_id": {
    "description": "Project id. Optional, falls back to the CLI's selected project.",
    "type": "string"
   },
   "range": {
    "enum": [
     "1h",
     "6h",
     "24h",
     "7d",
     "30d",
     "90d"
    ],
    "type": "string"
   },
   "status": {
    "enum": [
     "unresolved",
     "resolved",
     "ignored"
    ],
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "octri_list_issues"
}
