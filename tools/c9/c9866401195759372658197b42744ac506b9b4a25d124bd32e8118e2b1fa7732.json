       "type": "string"
      },
      "teamMemberId": {
       "type": "string"
      },
      "teamMemberName": {
       "type": "string"
      },
      "timezone": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "endDate": {
    "type": "string"
