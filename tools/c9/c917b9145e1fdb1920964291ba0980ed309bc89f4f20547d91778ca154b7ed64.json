{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update a service"
 },
 "description": "Update a service. Partial update. Any content change re-embeds; changing only active does not. The service image is never touched by the API.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "active": {
    "type": "boolean"
   },
   "category_id": {
    "type": [
     "integer",
     "null"
    ]
   },
   "currency": {
    "description": "ISO 4217 code such as USD or EUR. Null means the account default.",
    "type": [
     "string",
     "null"
    ]
   },
   "description": {
    "maxLength": 10000,
    "type": [
     "string",
     "null"
    ]
   },
   "display_order": {
    "type": "integer"
   },
   "duration_minutes": {
    "type": [
     "integer",
     "null"
    ]
   },
   "id": {
    "description": "Numeric id.",
    "type": "integer"
   },
   "is_virtual": {
    "description": "Bookings get a Google Meet link. Honoured only when Google Calendar is connected and Meet is on.",
    "type": "boolean"
   },
   "name": {
    "maxLength": 200,
    "type": "string"
   },
   "price": {
    "minimum": 0,
    "type": "number"
   },
   "price_unit": {
    "enum": [
     "fixed",
     "hourly",
     "per_unit",
     "quote"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_service"
}
