     "html": {
      "maxLength": 100000,
      "type": "string"
     },
     "maxChars": {
      "default": 12000,
      "maximum": 12000,
      "minimum": 256,
      "type": "integer"
     },
     "section": {
      "maxLength": 200,
      "minLength": 1,
      "type": "string"
     },
     "sourceUrl": {
      "maxLength": 2048,
      "type": "string"
     }
    },
    "required": [
     "html",
     "sourceUrl"
    ],
    "type": "object"
   },
   "maxPriceMicroUsd": {
    "description": "Optional legacy field; ignored in free mode.",
    "minimum": 0,
    "type": "integer"
   },
   "requestId": {
    "description": "Optional legacy field; ignored in free mode.",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
