{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search canonical residential sale registrations in one required market: Dubai or Abu Dhabi. Whole area, project and building names ignore ASCII letter case; provider IDs match exactly. Filters combine with AND; date bounds are inclusive. Returns newest-first pages of 25 rows by default, at most 100. Follow `nextCursor` with the same filters only when more rows are needed for the user's task. A page's row count is not the total number of matching sales.\n\nA bedroom count matches the canonical range; 0 means studio. `sourceProjectId` is a provider identifier, not a Projectory development ID. Partial-name discovery, totals and statistics are not provided. Results do not guarantee real-time freshness.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "areaName": {
    "description": "Whole canonical area name; ASCII letter case is ignored.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "bedrooms": {
    "description": "Bedroom count to match against each transaction's canonical bedroom range. Use 0 for a studio.",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "buildingName": {
    "description": "Whole canonical building name; ASCII letter case is ignored.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "cursor": {
    "description": "Opaque pagination cursor returned by the previous transaction search page. Reuse the same filters when continuing.",
    "maxLength": 2048,
    "minLength": 1,
    "type": "string"
   },
   "from": {
    "description": "Inclusive sale-registration date lower bound in YYYY-MM-DD format; year 1900 to 2200.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum rows to return. Defaults to 25.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "market": {
    "description": "Required transaction market.",
    "enum": [
     "dubai",
     "abu-dhabi"
    ],
    "type": "string"
   },
   "projectName": {
    "description": "Whole canonical project name; ASCII letter case is ignored.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "sourceProjectId": {
    "description": "Exact provider project identifier. This is not a Projectory development ID.",
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "to": {
    "description": "Inclusive sale-registration date upper bound in YYYY-MM-DD format; year 1900 to 2200.",
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "search_transactions",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "nextCursor": {
    "anyOf": [
     {
      "maxLength": 2048,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "transactions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "areaName": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "bedroomsMax": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "bedroomsMin": {
       "anyOf": [
        {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        {
         "type": "null"
        }
       ]
      },
      "buildingName": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "displayAreaSqft": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "localityName": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "market": {
       "enum": [
        "dubai",
        "abu-dhabi"
       ],
       "type": "string"
      },
      "offPlanSaleType": {
       "anyOf": [
        {
         "enum": [
          "initial",
          "resale"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "plotSizeSqft": {
       "anyOf": [
        {
         "type": "number"
        },
        {
         "type": "null"
        }
       ]
      },
      "priceAed": {
       "type": "number"
      },
      "projectName": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "propertyType": {
       "enum": [
        "apartment",
        "duplex",
        "penthouse",
        "villa",
        "townhouse",
        "land",
        "residential-complex"
       ],
       "type": "string"
      },
      "saleDate": {
       "format": "date",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
       "type": "string"
      },
      "sourceProjectId": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "status": {
       "enum": [
        "off-plan",
        "ready"
       ],
       "type": "string"
      },
      "transactionId": {
       "type": "string"
      }
     },
     "required": [
      "transactionId",
      "market",
      "saleDate",
      "sourceProjectId",
      "areaName",
      "localityName",
      "projectName",
      "buildingName",
      "propertyType",
      "status",
      "offPlanSaleType",
      "bedroomsMin",
      "bedroomsMax",
      "displayAreaSqft",
      "plotSizeSqft",
      "priceAed"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "transactions",
   "nextCursor"
  ],
  "type": "object"
 },
 "title": "Search Projectory Transactions"
}
