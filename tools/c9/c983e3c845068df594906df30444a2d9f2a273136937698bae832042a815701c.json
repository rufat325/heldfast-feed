{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create PM template"
 },
 "description": "Create a new PM template. Templates are reusable PM definitions (not linked to a site/asset) that can seed new PM schedules. Requires pm_templates:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "asset_ids": {
    "description": "Default asset IDs to seed on derived schedules",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "type": "string"
    },
    "type": "array"
   },
   "custom_interval_weeks": {
    "description": "Custom interval in weeks (when frequency is CUSTOM)",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "documents": {
    "description": "Document references",
    "items": {
     "additionalProperties": {},
     "propertyNames": {
      "type": "string"
     },
     "type": "object"
    },
    "type": "array"
   },
   "estimated_cost": {
    "description": "Estimated cost",
    "minimum": 0,
    "type": "number"
   },
   "estimated_hours": {
    "description": "Estimated hours",
    "minimum": 0,
    "type": "number"
   },
   "form_template_id": {
    "description": "Form template ID to attach to every work order this generates - resolve via list_form_templates. Use a PUBLISHED template: generation resolves the current published version of the form, so a draft attaches nothing until it is published.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "frequency": {
    "description": "Suggested maintenance frequency",
    "enum": [
     "DAILY",
     "WEEKLY",
     "MONTHLY",
     "QUARTERLY",
     "SEMI_ANNUAL",
     "ANNUAL",
     "FIVE_YEARLY",
     "CUSTOM"
    ],
    "type": "string"
   },
   "location_ids": {
    "description": "Default location IDs to seed on derived schedules",
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
     "type": "string"
    },
    "type": "array"
   },
   "resources": {
    "description": "Resource references (parts, tools, materials, equipment)",
    "items": {
     "properties": {
      "cost": {
       "description": "Unit cost",
       "type": "number"
      },
      "name": {
       "description": "Resource name",
       "type": "string"
      },
      "quantity": {
       "description": "Quantity required",
       "type": "number"
      },
      "type": {
       "description": "Resource type (TOOL, PART, MATERIAL, or EQUIPMENT)",
       "enum": [
        "TOOL",
        "PART",
        "MATERIAL",
        "EQUIPMENT"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "safety_requirements": {
    "description": "Safety requirements",
    "type": "string"
   },
   "tasks": {
    "description": "Checklist of tasks baked into this template",
    "items": {
     "properties": {
      "completed": {
       "description": "Whether the task is completed (defaults to false)",
       "type": "boolean"
      },
      "description": {
       "description": "Task description",
       "type": "string"
      },
      "id": {
       "description": "Unique task ID (auto-generated if omitted)",
       "type": "string"
      }
     },
     "required": [
      "description"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "title": {
    "description": "PM template title (required, unique per tenant)",
    "maxLength": 500,
    "minLength": 1,
    "type": "string"
   },
   "work_category": {
    "description": "Work category label (free text)",
    "maxLength": 200,
    "type": "string"
   },
   "work_category_id": {
    "description": "Work category ID - resolve via list_work_categories",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "title"
  ],
  "type": "object"
 },
 "name": "create_pm_template",
 "title": "Create PM template"
}
