{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Google Trends"
 },
 "description": "Google Trends interest data. Comma-separate up to 5 terms to compare on one 0-100 scale. 1 credit for one term, 3 credits for a comparison.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "cat": {
    "description": "Category id.",
    "type": "string"
   },
   "data_type": {
    "description": "Dataset to return. GEO_MAP_0, RELATED_QUERIES, RELATED_TOPICS accept a single term only.",
    "enum": [
     "TIMESERIES",
     "GEO_MAP",
     "GEO_MAP_0",
     "RELATED_QUERIES",
     "RELATED_TOPICS"
    ],
    "type": "string"
   },
   "date": {
    "description": "e.g. 'today 12-m', 'now 7-d'.",
    "type": "string"
   },
   "geo": {
    "description": "e.g. 'US', 'US-CA'.",
    "type": "string"
   },
   "gprop": {
    "description": "Property filter.",
    "enum": [
     "images",
     "news",
     "youtube",
     "froogle"
    ],
    "type": "string"
   },
   "hl": {
    "description": "Language, e.g. 'en'.",
    "type": "string"
   },
   "query": {
    "description": "Term(s), comma-separated to compare (max 5).",
    "type": "string"
   },
   "region": {
    "description": "GEO_MAP resolution.",
    "enum": [
     "COUNTRY",
     "REGION",
     "DMA",
     "CITY"
    ],
    "type": "string"
   },
   "tz": {
    "description": "Timezone offset in minutes.",
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "google_trends",
 "title": "Google Trends"
}
