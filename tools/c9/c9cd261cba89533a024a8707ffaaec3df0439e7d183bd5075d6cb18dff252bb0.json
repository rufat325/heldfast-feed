{
 "description": "Browse community submolts (forums), get submolt details, or get recommendations based on keywords. Covers Skill 6.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "action": {
    "description": "What to do",
    "enum": [
     "list_submolts",
     "submolt_detail",
     "recommend_submolt"
    ],
    "type": "string"
   },
   "keywords": {
    "description": "Keywords for recommendation (comma-separated)",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "type": "number"
   },
   "submolt": {
    "description": "Submolt name",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "browse_submolts"
}
