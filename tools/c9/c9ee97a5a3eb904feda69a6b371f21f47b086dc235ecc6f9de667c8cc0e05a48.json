{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get channel presence history"
 },
 "description": "Retrieve historical presence events (enter/leave/update) for a channel. REST: GET /channels/{channel}/presence/history.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "channel": {
    "description": "Channel name.",
    "type": "string"
   },
   "direction": {
    "description": "forwards or backwards (default backwards).",
    "enum": [
     "forwards",
     "backwards"
    ],
    "type": "string"
   },
   "end": {
    "description": "Latest event time, ms since epoch (inclusive).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "limit": {
    "description": "Max events (<=1000). Default 100.",
    "exclusiveMinimum": 0,
    "maximum": 1000,
    "type": "integer"
   },
   "start": {
    "description": "Earliest event time, ms since epoch (inclusive).",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "channel"
  ],
  "type": "object"
 },
 "name": "ably_get_presence_history",
 "title": "Get channel presence history"
}
