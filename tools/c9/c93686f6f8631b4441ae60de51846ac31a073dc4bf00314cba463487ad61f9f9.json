 "description": "SimulateCapTableDilution runs the SAME engine as CloseCapTableRound against the company's current stakeholders and its outstanding SAFEs, for a raise that does not exist yet \u2014 no round, nothing persisted.  CALL THIS for \"what happens if we raise X at Y\", \"model dilution\", \"how much do the founders keep\", or any post-money ownership question. Do NOT work the answer out yourself, even when the arithmetic looks simple: two implementations of SAFE conversion produce two different founder percentages and only one of them is right, and a hand-computed cap table presented as fact is the failure this tool exists to prevent.  It reads each outstanding SAFE's own valuation cap, discount and MFN from the record \u2014 do not ask the user for a cap, and do not offer hypothetical caps; they are already stored. Nor do you need share counts first.  Use this for a raise that has no round yet. PreviewCloseCapTableRound requires an existing round and cannot answer the same question.",
 "inputSchema": {
  "properties": {
   "companyId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "newMoneyRaise": {
    "maxLength": 50,
    "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
    "type": "string"
   },
   "optionPoolBasis": {
    "enum": [
     "CAP_TABLE_OPTION_POOL_BASIS_UNSPECIFIED",
     "CAP_TABLE_OPTION_POOL_BASIS_POST_ROUND",
     "CAP_TABLE_OPTION_POOL_BASIS_PRE_MONEY"
    ],
    "type": "string"
   },
   "preMoneyValuation": {
    "maxLength": 50,
    "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
    "type": "string"
   },
   "targetOptionPoolPct": {
    "maxLength": 50,
    "pattern": "^([0-9]+(\\.[0-9]{1,6})?)?$",
    "type": "string"
   }
  },
  "required": [
   "companyId"
  ],
  "type": "object"
 },
