{
 "description": "Run a backtest on a strategy. Async, may take 30-120 seconds. Returns full performance metrics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exchange": {
    "description": "Exchange account ID (use list_exchanges to find)",
    "type": "string"
   },
   "initialBalance": {
    "default": 10000,
    "type": "number"
   },
   "period": {
    "default": "3m",
    "enum": [
     "1m",
     "3m",
     "6m",
     "1y"
    ],
    "type": "string"
   },
   "strategyId": {
    "description": "Strategy ID to backtest",
    "type": "string"
   },
   "symbol": {
    "default": "BTC/USDT",
    "type": "string"
   },
   "timeframe": {
    "default": "1h",
    "description": "Candle timeframe (e.g. 1h, 4h, 1d)",
    "type": "string"
   }
  },
  "required": [
   "strategyId",
   "exchange"
  ],
  "type": "object"
 },
 "name": "what_if_backtest"
}
