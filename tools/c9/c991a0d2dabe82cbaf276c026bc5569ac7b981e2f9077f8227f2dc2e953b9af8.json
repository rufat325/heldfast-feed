{
 "_meta": {
  "openai/outputTemplate": "ui://widget/xenition-list.html",
  "openai/toolInvocation/invoked": "Invoice",
  "openai/toolInvocation/invoking": "Checking the invoice\u2026",
  "securitySchemes": [
   {
    "scopes": [
     "xenition.read",
     "xenition.write"
    ],
    "type": "oauth2"
   }
