 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Mark an invoice paid"
 },
 "description": "Mark a specific invoice in the user's own Xenition ledger as paid. This changes financial records, so it is a confirmed, two-step action: first call it WITHOUT `confirmed` to preview exactly which invoice would change, relay that to the user, and only call again with `confirmed:true` after they explicitly agree. When the user asks to mark ALL/EVERY/multiple unpaid invoices paid, list the affected invoices and get the user's confirmation before marking any. Returns the ledger's invoices.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "amount": {
    "description": "amount paid (default the invoice total)",
    "type": "number"
   },
   "confirmed": {
    "description": "set true ONLY after the user has explicitly confirmed this invoice should be marked paid; leave false/absent on the first attempt so they can review and confirm",
    "type": "boolean"
   },
   "invoiceNumber": {
    "description": "the invoice number, if you know it",
    "type": "string"
   },
   "on": {
    "description": "date paid YYYY-MM-DD (default today)",
    "type": "string"
   },
   "vendor": {
    "description": "the invoice's vendor (matched)",
    "type": "string"
   }
  },
  "required": [
   "vendor"
  ],
  "type": "object"
 },
 "name": "mark_paid",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "integer"
   },
   "empty": {
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "accent": {
       "type": "string"
      },
      "address": {
       "type": "string"
      },
      "detail": {
       "additionalProperties": true,
       "type": "object"
      },
      "id": {
       "type": "string"
      },
      "lat": {
       "type": [
        "null",
        "number"
       ]
      },
      "lng": {
       "type": [
        "null",
        "number"
       ]
      },
      "meta": {
