{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get income summary"
 },
 "description": "Use this when the user asks about income already recorded in their ExpenseBot Income tab. Read totals; group by source, category, month, payment method or tag; filter by dateRange/incomeTagPrefix. Query supports period comparisons (e.g. 'income YTD by source', 'income this year vs last'). Returns message and data with total and optional breakdown, comparison, sampleMeta. No scanning, imports, mutations, tax returns or liability determination.",
 "inputSchema": {
  "properties": {
   "dateRange": {
    "description": "Time period filter. Use exactly one variant \u2014 pick the shape that matches the user's phrasing.",
    "oneOf": [
     {
      "additionalProperties": false,
      "properties": {
       "month": {
        "description": "Month name or 1-12 (e.g., 'March' or '3')",
        "type": "string"
       },
       "type": {
        "const": "month",
        "type": "string"
       },
       "year": {
        "description": "4-digit year (e.g., 2026)",
        "type": "integer"
       }
      },
      "required": [
       "type",
       "month",
       "year"
      ],
      "title": "Specific month",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "quarter": {
        "maximum": 4,
        "minimum": 1,
        "type": "integer"
       },
       "type": {
        "const": "quarter",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "quarter",
       "year"
      ],
      "title": "Quarter of a year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "year",
        "type": "string"
       },
       "year": {
        "type": "integer"
       }
      },
      "required": [
       "type",
       "year"
      ],
      "title": "Full year",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "end": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "start": {
        "description": "ISO date YYYY-MM-DD (inclusive)",
        "format": "date",
        "type": "string"
       },
       "type": {
        "const": "specific",
        "type": "string"
       }
      },
      "required": [
       "type",
       "start",
       "end"
      ],
      "title": "Specific date range",
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "type": {
        "const": "relative",
        "type": "string"
       },
       "value": {
        "description": "Relative range phrase, e.g., 'last month', 'YTD', 'this quarter', 'last 7 days'",
        "type": "string"
       }
      },
      "required": [
       "type",
       "value"
      ],
      "title": "Relative natural-language range",
      "type": "object"
     }
    ]
   },
   "groupBy": {
    "description": "How to group the breakdown",
    "enum": [
     "source",
     "category",
     "month",
     "paymentMethod",
     "tag"
    ],
    "type": "string"
   },
   "incomeTagPrefix": {
    "description": "Optional tag-prefix shortcut (e.g., 'Prop \u2013' for rental income, 'Client \u2013' for client billings, 'Wedding \u2013' for events). When set, the tool filters to income rows tagged with this prefix.",
    "type": "string"
   },
   "query": {
    "description": "Natural language income question (e.g., 'income YTD by source', 'rental income last month')",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_income_summary",
 "outputSchema": {
  "additionalProperties": true,
  "description": "Two branches. Async: type='analytics_pending' with jobId \u2014 poll poll_analytics until complete. Inline: message + data with the computed analytics (data may be null when there is no spreadsheet or no data yet). success is present only on the async branch.",
  "properties": {
   "data": {
    "additionalProperties": true,
    "description": "Inline branch: computed analytics, or null when no spreadsheet / no data.",
    "type": [
     "object",
     "null"
    ]
   },
   "estimatedTime": {
    "description": "Async branch only: seconds.",
    "type": "number"
   },
   "jobId": {
    "description": "Async branch only.",
    "type": "string"
   },
   "message": {
    "description": "Human-readable narrative (both branches).",
    "type": "string"
   },
   "pollEndpoint": {
    "description": "Async branch only.",
    "type": "string"
   },
   "pollInterval": {
    "description": "Async branch only: milliseconds.",
    "type": "number"
   },
   "response": {
    "description": "Chat alias of message.",
    "type": "string"
   },
   "success": {
    "description": "Async branch only.",
    "type": "boolean"
   },
   "type": {
    "description": "Async branch only: \"analytics_pending\" \u2014 poll pollEndpoint or call poll_analytics with jobId.",
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "expenses.read"
   ],
   "type": "oauth2"
  }
 ]
}
