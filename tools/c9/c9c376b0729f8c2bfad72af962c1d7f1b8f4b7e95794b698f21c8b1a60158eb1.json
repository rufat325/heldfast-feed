{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"Use when a public website will not load or you need a fresh server-side availability observation. Returns HTTP status, DNS answers, redirect chain, HTTPS connection evidence, timestamps and bounded retry attempts. Blocked or inconclusive is not proof of a global outage. No API key. API/MCP share cached results for up to 30 seconds; inspect checkedAt and cached. For existing curated-service observations without a new probe, use get_service_status.","inputSchema":{"additionalProperties":false,"properties":{"url":{"description":"Public HTTP(S) URL or domain, e.g. example.com. No credentials, private addresses or nonstandard ports.","maxLength":2048,"type":"string"}},"required":["url"],"type":"object"},"name":"check_website","outputSchema":{"properties":{"attempts":{"items":{"properties":{"checkedAt":{"format":"date-time","type":"string"},"durationMs":{"type":"integer"},"evidence":{"type":"object"},"httpStatus":{"type":["integer","null"]},"reason":{"type":"string"},"status":{"enum":["reachable","blocked","error","unreachable","inconclusive"],"type":"string"}},"required":["status","reason","httpStatus","durationMs","checkedAt","evidence"],"type":"object"},"maxItems":2,"minItems":1,"type":"array"},"cached":{"type":"boolean"},"checkedAt":{"format":"date-time","type":"string"},"durationMs":{"type":"integer"},"evidence":{"properties":{"dns":{"items":{"properties":{"addresses":{"items":{"type":"string"},"type":"array"},"durationMs":{"type":"integer"},"hostname":{"type":"string"}},"required":["hostname","addresses","durationMs"],"type":"object"},"type":"array"},"location":{"type":"string"},"redirects":{"items":{"properties":{"from":{"type":"string"},"httpStatus":{"type":"integer"},"to":{"type":"string"}},"required":["from","to","httpStatus"],"type":"object"},"type":"array"},"transport":{"properties":{"httpsConnection":{"enum":["established","not_applicable","n