{
 "description": "Create a Flux Kontext task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "anyOf": [
     {
      "const": "21:9",
      "type": "string"
     },
     {
      "const": "16:9",
      "type": "string"
     },
     {
      "const": "4:3",
      "type": "string"
     },
     {
      "const": "1:1",
      "type": "string"
     },
     {
      "const": "3:4",
      "type": "string"
     },
     {
      "const": "9:16",
      "type": "string"
     }
    ],
    "description": "Output aspect ratio. Default: 16:9."
   },
   "callback_url": {
    "description": "Webhook URL for async notifications.",
    "type": "string"
   },
   "enable_prompt_expansion": {
    "description": "Expand the prompt with more detail. Default: false.",
    "type": "boolean"
   },
   "enable_translation": {
    "description": "Auto-translate non-English prompts. Default: true.",
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "flux-kontext-max",
     "flux-kontext-pro"
    ],
    "type": "string"
   },
   "output_format": {
    "anyOf": [
     {
      "const": "jpeg",
      "type": "string"
     },
     {
      "const": "png",
      "type": "string"
     }
    ],
    "description": "Output format. Default: jpeg."
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Image description (English only).",
    "type": "string"
   },
   "safety_tolerance": {
    "description": "Content safety threshold. 0-6 for generation, 0-2 for editing. Default: 2.",
    "type": "number"
   },
   "source_image_url": {
    "description": "Source image URL for editing mode.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   },
   "watermark": {
    "description": "Watermark identifier.",
    "type": "string"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "text_to_image"
}
