{
 "_meta": {
  "openai/outputTemplate": "ui://astra-db/app.html",
  "ui": {
   "resourceUri": "ui://astra-db/app.html"
  },
  "ui/resourceUri": "ui://astra-db/app.html"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Astra DB overview"
 },
 "description": "Map a database: keyspaces \u2192 collections (vector dimension/metric, vectorize model, lexical/rerank, estimated counts) and tables (column and vector-column counts). Start here to see what exists. Renders an interactive overview.",
 "icons": [
  {
   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "database": {
    "description": "Database to use: name, id, or Data API endpoint URL. Omit for the configured default.",
    "minLength": 1,
    "type": "string"
   },
   "emit": {
    "default": "structured",
    "description": "html_file also writes a self-contained HTML page and returns a link to it \u2014 only for terminal-only hosts, when the user asks for a visual.",
    "enum": [
     "structured",
     "html_file"
    ],
    "type": "string"
   },
   "includeCounts": {
    "default": true,
    "description": "Estimated document counts per collection (one request each).",
    "type": "boolean"
   },
   "keyspaces": {
    "description": "Only these keyspaces (default: all).",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "maxPerKeyspace": {
    "default": 50,
    "description": "Max collections/tables listed per keyspace.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "database_overview",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "database": {
    "additionalProperties": false,
    "properties": {
     "id": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "region": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "endpoint": {
    "description": "Data API endpoint of the database this came from; pass it as `database` in follow-up calls.",
    "type": "string"
   },
   "endpointHost": {
    "type": "string"
   },
   "keyspaces": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "collections": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "estimatedCount": {
          "type": [
           "number",
           "null"
          ]
         },
         "lexical": {
          "type": "boolean"
         },
         "name": {
          "type": "string"
         },
         "rerank": {
          "type": "boolean"
         },
         "vector": {
          "anyOf": [
           {
            "additionalProperties": false,
            "properties": {
             "dimension": {
              "type": [
               "number",
               "null"
              ]
             },
             "metric": {
              "type": [
               "string",
               "null"
              ]
             },
             "model": {
              "type": [
               "string",
               "null"
              ]
             },
             "provider": {
              "type": [
               "string",
               "null"
              ]
             }
            },
            "required": [
             "dimension",
             "metric",
             "provider",
             "model"
            ],
            "type": "object"
           },
           {
            "type": "null"
           }
          ]
         }
        },
        "required": [
         "name",
         "vector",
         "lexical",
         "rerank",
         "estimatedCount"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "error": {
       "type": "string"
      },
      "isDefault": {
       "type": "boolean"
      },
      "name": {
       "type": "string"
      },
      "tables": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "columns": {
          "type": "number"
         },
         "name": {
          "type": "string"
         },
         "vectorColumns": {
          "type": "number"
         }
        },
        "required": [
         "name",
         "columns",
         "vectorColumns"
        ],
        "type": "object"
       },
       "type": "array"
      }
     },
     "required": [
      "name",
      "isDefault",
      "collections",
      "tables"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "totals": {
    "additionalProperties": false,
    "properties": {
     "collections": {
      "type": "number"
     },
     "documents": {
      "type": [
       "number",
       "null"
      ]
     },
     "keyspaces": {
      "type": "number"
     },
     "tables": {
      "type": "number"
     }
    },
    "required": [
     "keyspaces",
     "collections",
     "tables",
     "documents"
    ],
    "type": "object"
   },
   "truncated": {
    "additionalProperties": false,
    "properties": {
     "items": {
      "type": "boolean"
     },
     "keyspaces": {
      "type": "boolean"
     }
    },
    "required": [
     "keyspaces",
     "items"
    ],
    "type": "object"
   },
   "view": {
    "const": "overview",
    "type": "string"
   }
  },
  "required": [
   "view",
   "endpointHost",
   "database",
   "keyspaces",
   "totals",
   "truncated"
  ],
  "type": "object"
 },
 "title": "Astra DB overview"
}
