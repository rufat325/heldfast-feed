{
 "description": "Create a carnet (payment booklet with multiple parcels)",
 "inputSchema": {
  "properties": {
   "customer": {
    "description": "Customer info",
    "properties": {
     "cpf": {
      "description": "Customer CPF",
      "type": "string"
     },
     "name": {
      "description": "Customer name",
      "type": "string"
     }
    },
    "required": [
     "name",
     "cpf"
    ],
    "type": "object"
   },
   "expire_at": {
    "description": "First parcel due date (YYYY-MM-DD)",
    "type": "string"
   },
   "items": {
    "description": "Carnet items",
    "items": {
     "properties": {
      "amount": {
       "description": "Quantity",
       "type": "number"
      },
      "name": {
       "description": "Item name",
       "type": "string"
      },
      "value": {
       "description": "Item value in cents",
       "type": "number"
      }
     },
     "required": [
      "name",
      "value",
      "amount"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "repeats": {
    "description": "Number of parcels",
    "type": "number"
   }
  },
  "required": [
   "items",
   "customer",
   "expire_at",
   "repeats"
  ],
  "type": "object"
 },
 "name": "create_carnet"
}
