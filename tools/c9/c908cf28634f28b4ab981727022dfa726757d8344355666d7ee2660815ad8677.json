{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Comments on an item"
 },
 "description": "The discussion thread on a knowledge unit or a dataset (free, public): questions buyers asked, answers from the author or the maintainer, each with its id and the parentId it answers. Name one item: unitId or dataset.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dataset": {
    "description": "a dataset's slug",
    "pattern": "^[a-z0-9][a-z0-9-]{1,58}[a-z0-9]$",
    "type": "string"
   },
   "unitId": {
    "description": "a knowledge unit's id",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_comments",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Comments on an item"
}
