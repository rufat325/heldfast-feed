    "type": "string"
   },
   "entryId": {
    "description": "The quest: entryId (hex) or exact title.",
    "minLength": 1,
    "type": "string"
   },
   "objectiveId": {
    "description": "The objective, as get_mnemon's quest.objectives[].id names it.",
    "minLength": 1,
    "type": "string"
   },
   "state": {
    "description": "open, done or failed.",
    "enum": [
     "open",
     "done",
     "failed"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaignId",
   "entryId",
   "objectiveId",
   "state"
  ],
  "type": "object"
 },
