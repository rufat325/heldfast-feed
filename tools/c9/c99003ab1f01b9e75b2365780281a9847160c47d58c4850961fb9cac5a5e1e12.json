{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "practice:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Score a free-response answer"
 },
 "description": "Submits the student's own response to a Fiveable practice FRQ for saved, asynchronous scoring. Supports text, subparts, drawings/photos, LEQ selection, CSP program code and Business project references. Excludes teacher assignments and exams. Returns a scoring job id for status retrieval, and requestId provides idempotent retries. One free score is available to signed-in students.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "businessProjectPracticeMode": {
    "enum": [
     "use_my_project",
     "use_a_sample_project"
    ],
    "type": "string"
   },
   "businessProjectReference": {
    "additionalProperties": false,
    "properties": {
     "customer_problem_or_need": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     "financing_assumptions": {
      "additionalProperties": false,
      "properties": {
       "access_constraints": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       },
       "external_financial_capital_needed": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "internal_financial_capital": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "operating_costs_until_break_even": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "startup_costs": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "startup_costs",
       "operating_costs_until_break_even",
       "internal_financial_capital",
       "external_financial_capital_needed",
       "access_constraints"
      ],
      "type": "object"
     },
     "pricing_decision": {
      "additionalProperties": false,
      "properties": {
       "decision": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       },
       "selected_price": {
        "maxLength": 300,
        "minLength": 1,
        "type": "string"
       },
       "strategy": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "strategy",
       "selected_price",
       "decision"
      ],
      "type": "object"
     },
     "product": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     "research_method_and_evidence": {
      "additionalProperties": false,
      "properties": {
       "evidence": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       },
       "method": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       },
       "sample": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "method",
       "sample",
       "evidence"
      ],
      "type": "object"
     },
     "target_customer": {
      "additionalProperties": false,
      "properties": {
       "profile": {
        "maxLength": 2000,
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "profile"
      ],
      "type": "object"
     },
     "tested_hypothesis": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     },
     "value_proposition": {
      "maxLength": 2000,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "product",
     "target_customer",
     "customer_problem_or_need",
     "value_proposition",
     "pricing_decision",
     "tested_hypothesis",
     "research_method_and_evidence",
     "financing_assumptions"
    ],
    "type": "object"
   },
   "frqId": {
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "intent": {
    "description": "Privacy-safe reason for the request. Use explain, quiz, notes, frq, or research; never send the student's raw prompt for analytics.",
    "enum": [
     "explain",
     "quiz",
     "notes",
     "frq",
     "research"
    ],
    "type": "string"
   },
   "partResponses": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "drawingData": {
       "additionalProperties": false,
       "properties": {
        "data": {
         "maxLength": 3000100,
         "minLength": 16,
         "type": "string"
        },
        "drawingLabel": {
         "maxLength": 200,
         "type": "string"
        },
        "height": {
         "maximum": 10000,
         "minimum": 1,
         "type": "integer"
        },
        "mimeType": {
         "enum": [
          "image/png",
          "image/jpeg",
          "image/webp"
         ],
         "type": "string"
        },
        "source": {
         "enum": [
          "drawing",
          "uploaded_photo"
         ],
         "type": "string"
        },
        "type": {
         "const": "canvas",
         "type": "string"
        },
        "width": {
         "maximum": 10000,
         "minimum": 1,
         "type": "integer"
        }
       },
       "required": [
        "type",
        "data",
        "width",
        "height"
       ],
       "type": "object"
      },
      "partLetter": {
       "maxLength": 20,
       "minLength": 1,
       "type": "string"
      },
      "response": {
       "default": "",
       "description": "Student's own response, verbatim. May be empty for a drawing/photo-only response.",
       "maxLength": 50000,
       "type": "string"
      },
      "subpartNumeral": {
       "maxLength": 20,
       "type": "string"
      }
     },
     "required": [
      "partLetter",
      "response"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "minItems": 1,
    "type": "array"
   },
   "programCode": {
    "maxLength": 100000,
    "type": "string"
   },
   "promptVariantId": {
    "const": "official_2026_v1",
    "type": "string"
   },
   "requestId": {
    "description": "Stable unique request ID. Reuse it only for retries of the same submission; a new response needs a new ID.",
    "pattern": "^[\\w-]{8,128}$",
    "type": "string"
   },
   "selectedLeqQuestion": {
    "maximum": 4,
    "minimum": 2,
    "type": "integer"
   }
  },
  "required": [
   "frqId",
   "partResponses"
  ],
  "type": "object"
 },
 "name": "score_frq_response",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "status": {
    "description": "Operation status: completed, pending, partial, failed, unavailable, or a domain-specific outcome.",
    "type": "string"
   },
   "text": {
    "description": "Readable tool result text for clients that consume structured output.",
    "type": "string"
   }
  },
  "required": [
   "status"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "practice:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Score a free-response answer"
}
