{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search available monitoring metrics for a specific product in Cloud Insight.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dimValues": {
    "description": "Dimension filters ([{name, value}])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "name",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dimensionsSelectedList": {
    "description": "Search by specific dimension values ([{name, values[]}])",
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      },
      "values": {
       "items": {
        "type": "string"
       },
       "minItems": 1,
       "type": "array"
      }
     },
     "required": [
      "name",
      "values"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "idDimensions": {
    "description": "idDimension names to query",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "prodKey": {
    "description": "Product key (cw_key) to search metrics for",
    "type": "string"
   },
   "query": {
    "description": "Keyword to search metric names",
    "type": "string"
   }
  },
  "required": [
   "prodKey"
  ],
  "type": "object"
 },
 "name": "ncloud_search_metric_list"
}
