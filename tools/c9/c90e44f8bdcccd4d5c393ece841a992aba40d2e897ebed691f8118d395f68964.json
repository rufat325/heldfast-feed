{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Find faces by type, area, radius, normal, quality, or body. Returns IDs, surface types, areas, radii, diameters, axes, normals. Use returned IDs in measure_distance, measure_thickness, measure_draft, or measure_geometry.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "file_path": {
    "description": "Path to STEP file on local filesystem.",
    "minLength": 1,
    "type": "string"
   },
   "filters": {
    "additionalProperties": false,
    "properties": {
     "area": {
      "additionalProperties": false,
      "properties": {
       "max": {
        "minimum": 0,
        "type": "number"
       },
       "min": {
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "body_ids": {
      "description": "Restrict to specific bodies from inspect_step.",
      "items": {
       "description": "Body ID: \"body:N\".",
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "normal": {
      "additionalProperties": false,
      "description": "Filter faces by normal direction.",
      "properties": {
       "direction": {
        "items": {
         "type": "number"
        },
        "maxItems": 3,
        "minItems": 3,
        "type": "array"
       },
       "match": {
        "default": "parallel",
        "enum": [
         "same_direction",
         "opposite_direction",
         "parallel"
        ],
        "type": "string"
       },
       "tolerance_degrees": {
        "default": 10,
        "maximum": 180,
        "minimum": 0,
        "type": "number"
       }
      },
      "required": [
       "direction"
      ],
      "type": "object"
     },
     "quality": {
      "additionalProperties": false,
      "properties": {
       "tolerance_max": {
        "minimum": 0,
        "type": "number"
       },
       "valid": {
        "type": "boolean"
       }
      },
      "type": "object"
     },
     "radius": {
      "additionalProperties": false,
      "properties": {
       "max": {
        "minimum": 0,
        "type": "number"
       },
       "min": {
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "type": {
      "description": "Face surface type.",
      "enum": [
       "plane",
       "cylinder",
       "cone",
       "sphere",
       "torus",
       "bspline",
       "other"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "include": {
    "description": "Result detail presets. Omit for basic face identity, area, bounds, and adjacency.",
    "items": {
     "enum": [
      "basic",
      "bounds",
      "geometry",
      "adjacency",
      "topology",
      "quality"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "max_results": {
    "default": 100,
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "sort": {
    "enum": [
     "largest_area",
     "smallest_area",
     "largest_radius",
     "smallest_radius"
    ],
    "type": "string"
   },
   "summarize": {
    "additionalProperties": false,
    "properties": {
     "by": {
      "items": {
       "enum": [
        "type",
        "body",
        "axis",
        "normal_direction",
        "area_range",
        "radius_range"
       ],
       "type": "string"
      },
      "maxItems": 3,
      "minItems": 1,
      "type": "array"
     },
     "stats": {
      "items": {
       "enum": [
        "count",
        "area",
        "radius",
        "diameter"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     },
     "unique": {
      "items": {
       "enum": [
        "radius",
        "diameter"
       ],
       "type": "string"
      },
      "minItems": 1,
      "type": "array"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "file_path"
  ],
  "type": "object"
 },
 "name": "find_faces"
}
