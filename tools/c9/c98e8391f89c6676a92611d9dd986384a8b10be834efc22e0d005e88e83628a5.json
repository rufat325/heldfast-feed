 "description": "Compare placeholder structure across locales. A placeholder missing from a translation renders blank in some frameworks and throws in others, so the same file is a cosmetic bug in one stack and a crash in the next. ICU braces, printf conversions and mustache pairs are all recognised. Also reports a placeholder no base string supplies, a positional count that differs, a syntax that differs between locales, and unindexed printf placeholders reordered by a translation, which the renderer ignores. Pay 220000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "locales": {
    "description": "The locale files to compare. One entry per locale. Exactly one may be marked as the base; when none is, the first supplied is used and that is reported.",
    "example": [
     {
      "base": true,
      "locale": "en",
      "messages": {
       "app": {
        "greeting": "Hello, {name}",
        "title": "Dashboard"
       },
       "cart": {
        "item_one": "You have {count} item in your cart",
        "item_other": "You have {count} items in your cart"
       },
       "errors": {
        "generic": "Something went wrong",
        "retry": "Try again"
       },
       "invoice": {
        "total": "Total: {amount, number, ::currency/USD}"
       },
       "legal": {
        "terms": "By continuing you accept the <a href=\"/terms\">terms</a>"
       },
       "shared": {
        "cancel": "Cancel",
        "dismiss": "Cancel"
       }
      }
     },
     {
      "locale": "de",
      "messages": {
       "app": {
        "greeting": "Hallo, {vorname}",
        "title": "\u00dcbersicht"
       },
       "cart": {
        "item_one": "Sie haben {count} Artikel im Warenkorb",
        "item_other": "Sie haben {count} Artikel im Warenkorb"
       },
       "errors": {
        "generic": "Etwas ist schiefgelaufen",
        "retry": "Erneut versuchen"
       },
       "invoice": {
        "total": "Gesamt"
       },
       "legal": {
        "terms": "Mit dem Fortfahren akzeptieren Sie die <a href=\"/terms\">Bedingungen</a>"
       },
       "shared": {
        "cancel": "Abbrechen",
        "dismiss": "Verwerfen"
       }
      }
     },
     {
      "locale": "fr",
      "messages": {
       "app": {
        "greeting": "Bonjour, {{name}}",
        "title": "Tableau de bord"
       },
       "cart": {
        "item_one": "Vous avez {count} article",
        "item_other": "Vous avez {count} articles"
       },
       "errors": {
        "generic": "Une erreur est survenue",
        "retry": "R\u00e9essayer"
       },
       "invoice": {
        "total": "Total : {amount}"
       },
       "legal": {
        "terms": "En continuant vous acceptez les conditions"
       },
       "shared": {
        "cancel": "Annuler",
        "dismiss": "Ignorer"
       }
      }
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "base": {
       "description": "Whether this is the source locale the others are compared against.",
       "type": "boolean"
      },
      "locale": {
       "description": "A language tag such as en, pt-BR or ar.",
       "maxLength": 35,
       "type": "string"
      },
      "messages": {
       "description": "This locale\u2019s messages. A messages object, or JSON text, at most 2097152 bytes. Nested objects are flattened to separated keys, so a file written either way is read the same. Nothing is fetched: the files are supplied, so an arbitrary project can be audited.",
       "type": [
        "object",
        "string"
       ]
      }
     },
     "required": [
      "locale",
      "messages"
     ],
     "type": "object"
    },
    "maxItems": 60,
    "minItems": 2,
    "type": "array"
   }
  },
  "required": [
   "locales"
  ],
  "type": "object"
 },
