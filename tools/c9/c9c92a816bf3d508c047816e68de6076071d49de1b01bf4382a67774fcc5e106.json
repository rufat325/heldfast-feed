{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only: sample cook times over a window (N samples \u00d7 intervalMs) and rank hotspot nodes by p95 cook time. Use this to diagnose intermittent stalls that a single get_td_performance snapshot misses. Returns {path, samples, intervalMs, targetFps, frameBudgetMs, windowMs, hotspots[], warnings[]}.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "intervalMs": {
    "default": 100,
    "description": "Delay between snapshots in milliseconds (>= one frame at 60fps).",
    "maximum": 2000,
    "minimum": 16,
    "type": "integer"
   },
   "samples": {
    "default": 30,
    "description": "How many snapshots to take across the window.",
    "maximum": 240,
    "minimum": 2,
    "type": "integer"
   },
   "scopePath": {
    "default": "/project1",
    "description": "Network root to profile (recursive).",
    "type": "string"
   },
   "targetFps": {
    "default": 60,
    "description": "Forwarded to get_td_performance for the per-frame budget annotation.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "topN": {
    "default": 15,
    "description": "How many hotspots to return, ranked desc by p95.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "profile_cook_cost",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "frameBudgetMs": {
    "type": "number"
   },
   "hotspots": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "maxCookMs": {
       "type": "number"
      },
      "meanCookMs": {
       "type": "number"
      },
      "overBudget": {
       "type": "boolean"
      },
      "p95CookMs": {
       "type": "number"
      },
      "path": {
       "type": "string"
      },
      "sampleCount": {
       "type": "number"
      },
      "type": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "meanCookMs",
      "p95CookMs",
      "maxCookMs",
      "sampleCount",
      "overBudget"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "intervalMs": {
    "type": "number"
   },
   "path": {
    "type": "string"
   },
   "samples": {
    "type": "number"
   },
   "targetFps": {
    "type": "number"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "windowMs": {
    "type": "number"
   }
  },
  "required": [
   "path",
   "samples",
   "intervalMs",
   "targetFps",
   "frameBudgetMs",
   "windowMs",
   "hotspots",
   "warnings"
  ],
  "type": "object"
 },
 "title": "Profile cook cost"
}
