{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Whether a secret link is still waiting, has been opened, expired, or was revoked. Never returns the secret.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "code": {
    "description": "The code create_secret returned for this secret.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "code"
  ],
  "type": "object"
 },
 "name": "check_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "createdAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "expiresAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "openedAt": {
    "type": [
     "string",
     "null"
    ]
   },
   "status": {
    "description": "waiting: not opened yet. opened: the recipient has it, and the link no longer works.",
    "enum": [
     "waiting",
     "opened",
     "expired",
     "revoked"
    ],
    "type": "string"
   },
   "type": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "status",
   "type",
   "openedAt",
   "expiresAt",
   "createdAt"
  ],
  "type": "object"
 },
 "title": "Check a secret link"
}
