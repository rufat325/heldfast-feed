    "type": "object"
   },
   "currentSequentialNumber": {
    "type": "number"
   },
   "defaultDueDays": {
    "type": "number"
   },
   "defaultNotes": {
    "type": "string"
   },
   "defaultTaxRate": {
    "type": "number"
   },
   "id": {
    "type": "string"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "isDefault": {
    "type": "boolean"
   },
   "layoutStyle": {
    "enum": [
     "classic",
     "neutral"
    ],
    "type": "string"
   },
   "logoPlacement": {
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "prefix": {
    "type": "string"
   },
   "showBillingPeriod": {
    "type": "boolean"
   },
   "showProjectTitle": {
    "type": "boolean"
   },
   "useSequentialNumbers": {
    "type": "boolean"
   }
