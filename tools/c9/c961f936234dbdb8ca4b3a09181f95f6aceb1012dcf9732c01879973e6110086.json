{
 "annotations": {
  "readOnlyHint": true,
  "title": "Get a sales report"
 },
 "description": "Sales report for one or more events: gross, net, fees, royalty and quantity per time bucket, optionally grouped (by ticket, payment method, country, ...). Eventbrite: GET /reports/sales/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date_facet": {
    "description": "Time bucket for the data points (default day).",
    "enum": [
     "fifteen",
     "hour",
     "day",
     "event_day",
     "week",
     "month",
     "year",
     "none"
    ],
    "type": "string"
   },
   "end_date": {
    "description": "Report end date, e.g. 2026-09-30.",
    "type": "string"
   },
   "event_ids": {
    "description": "One or more Event IDs to report on.",
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "event_status": {
    "description": "Filter by event status.",
    "enum": [
     "all",
     "live",
     "ended"
    ],
    "type": "string"
   },
   "group_by": {
    "description": "Group the report by this dimension.",
    "enum": [
     "payment_method",
     "payment_method_application",
     "ticket",
     "ticket_application",
     "currency",
     "event_currency",
     "reserved_section",
     "event",
     "event_ticket",
     "event_application",
     "country",
     "city",
     "state",
     "source",
     "zone",
     "location",
     "access_level",
     "device_name",
     "sales_channel_lvl_1",
     "sales_channel_lvl_2",
     "sales_channel_lvl_3",
     "delivery_method"
    ],
    "type": "string"
   },
   "period": {
    "description": "Number of date_facet units back from now, e.g. date_facet=hour + period=3 = last 3 hours.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "start_date": {
    "description": "Report start date, e.g. 2026-09-01.",
    "type": "string"
   },
   "timezone": {
    "description": "Timezone for the report (default: the first event's).",
    "type": "string"
   }
  },
  "required": [
   "event_ids"
  ],
  "type": "object"
 },
 "name": "eventbrite_get_sales_report",
 "title": "Get a sales report"
}
