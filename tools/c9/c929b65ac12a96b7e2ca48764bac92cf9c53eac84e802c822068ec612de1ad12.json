{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Record the original network question for priority research. Provide missing context or explain why an answer was not useful. Feedback alone does not change or quarantine published knowledge.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "context": {
    "additionalProperties": false,
    "default": {},
    "properties": {
     "model": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "operating_system": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "runtime_mode": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "shell_environment": {
      "maxLength": 120,
      "minLength": 1,
      "type": "string"
     },
     "vendor": {
      "maxLength": 240,
      "minLength": 1,
      "type": "string"
     },
     "version": {
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9()._\\-/]*$",
      "type": "string"
     }
    },
    "type": "object"
   },
   "question": {
    "maxLength": 2000,
    "minLength": 3,
    "type": "string"
   },
   "reason": {
    "maxLength": 1000,
    "minLength": 3,
    "type": "string"
   },
   "revision_refs": {
    "default": [],
    "items": {
     "format": "uuid",
     "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
     "type": "string"
    },
    "maxItems": 5,
    "type": "array"
   }
  },
  "required": [
   "question",
   "reason"
  ],
  "type": "object"
 },
 "name": "report_knowledge_gap",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "learning": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "active_tasks": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "string"
         }
        ]
       },
       "elapsed_seconds": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "string"
         }
        ]
       },
       "id": {
        "format": "uuid",
        "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
        "type": "string"
       },
       "last_error_code": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "last_progress_at": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "message": {
        "type": "string"
       },
       "needs_context": {
        "type": "boolean"
       },
       "queued_tasks": {
        "anyOf": [
         {
          "type": "number"
         },
         {
          "type": "string"
         }
        ]
       },
       "revision_ref": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "stage": {
        "anyOf": [
         {
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "status": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "status",
       "stage",
       "message",
       "needs_context",
       "elapsed_seconds",
       "last_progress_at",
       "last_error_code",
       "queued_tasks",
       "active_tasks",
       "revision_ref"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   }
  },
  "required": [
   "learning"
  ],
  "type": "object"
 },
 "title": "Report an Incomplete or Incorrect Answer"
}
