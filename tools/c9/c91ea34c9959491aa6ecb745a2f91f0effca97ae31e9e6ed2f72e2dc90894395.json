{
 "description": "Record an attributed observation with provenance. Qualified and paid-work outcomes require actual accepted work.",
 "inputSchema": {
  "properties": {
   "id": {
    "format": "uuid",
    "type": "string"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "observation": {
    "properties": {
     "blinding": {
      "default": "not_blinded",
      "type": "string"
     },
     "evidenceNote": {
      "type": "string"
     },
     "interactionId": {
      "default": null,
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     },
     "kind": {
      "type": "string"
     },
     "origin": {
      "default": "research_directed",
      "type": "string"
     },
     "submissionId": {
      "default": null,
      "format": "uuid",
      "type": [
       "string",
       "null"
      ]
     }
    },
    "required": [
     "kind",
     "evidenceNote"
    ],
    "type": "object"
   }
  },
  "required": [
   "id",
   "observation",
   "idempotencyKey"
  ],
  "type": "object"
 },
 "name": "record_research_observation"
}
