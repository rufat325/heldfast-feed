{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Invoices, credit notes and quotes of a company, filtered by type, state, settlement state, contact or date range. `state` is the document (draft, posted, cancelled) and `payment_state` is the settlement (not_paid, partially_paid, paid) \u2014 two different questions. Returns headers and totals, not lines; use get_document for those.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "company_id": {
    "description": "The company to work in. Ask list_companies if unsure.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "contact_id": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "doc_type": {
    "enum": [
     "sale_invoice",
     "sale_credit_note",
     "sale_quote",
     "purchase_invoice",
     "purchase_credit_note",
     "purchase_order"
    ],
    "type": "string"
   },
   "from": {
    "description": "Earliest document date.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "payment_state": {
    "enum": [
     "not_paid",
     "partially_paid",
     "paid",
     "overpaid",
     "reversed"
    ],
    "type": "string"
   },
   "state": {
    "enum": [
     "draft",
     "posted",
     "cancelled"
    ],
    "type": "string"
   },
   "to": {
    "description": "Latest document date.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "unpaid": {
    "description": "True: posted and still owed \u2014 not paid, or partially.",
    "type": "boolean"
   }
  },
  "required": [
   "company_id"
  ],
  "type": "object"
 },
 "name": "list_documents",
 "title": "List documents"
}
