{
 "annotations": {
  "destructiveHint": true,
  "title": "Update an activity"
 },
 "description": "Change an activity's subject, note, status (e.g. mark it completed) or priority. Only the fields you pass are changed (PATCH). Neon: PATCH /activities/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "activity_id": {
    "description": "The activity id.",
    "minLength": 1,
    "type": "string"
   },
   "note": {
    "description": "New note (replaces the old one).",
    "type": "string"
   },
   "priority": {
    "description": "New priority.",
    "enum": [
     "High",
     "Normal",
     "Low"
    ],
    "type": "string"
   },
   "status_id": {
    "description": "New status id (neon_list_properties name=activityStatuses).",
    "type": "string"
   },
   "subject": {
    "description": "New subject.",
    "type": "string"
   }
  },
  "required": [
   "activity_id"
  ],
  "type": "object"
 },
 "name": "neon_update_activity",
 "title": "Update an activity"
}
