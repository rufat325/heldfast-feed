{
 "description": "Distribute elements evenly (horizontal or vertical)",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "direction": {
    "enum": [
     "horizontal",
     "vertical"
    ],
    "type": "string"
   },
   "elementIds": {
    "items": {
     "maxLength": 64,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 3,
    "type": "array"
   }
  },
  "required": [
   "elementIds",
   "direction"
  ],
  "type": "object"
 },
 "name": "distribute_elements"
}
