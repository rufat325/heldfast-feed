{
 "description": "Search EU directives/regulations with Swedish implementation info. Use get_swedish_implementations for specific EU document details.",
 "inputSchema": {
  "properties": {
   "community": {
    "description": "Filter by EU community",
    "enum": [
     "EU",
     "EG",
     "EEG",
     "Euratom"
    ],
    "type": "string"
   },
   "has_swedish_implementation": {
    "description": "Only return EU documents with Swedish implementations",
    "type": "boolean"
   },
   "limit": {
    "default": 20,
    "description": "Maximum results to return",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "query": {
    "description": "Keyword search (title, short name, CELEX, description)",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Filter by document type",
    "enum": [
     "directive",
     "regulation"
    ],
    "type": "string"
   },
   "year_from": {
    "description": "Filter by year (from)",
    "minimum": 1950,
    "type": "number"
   },
   "year_to": {
    "description": "Filter by year (to)",
    "maximum": 2030,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "search_eu_implementations"
}
