{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Resolve, validate, and preview an issue write. Returns a token valid for ten minutes; does not change the external provider.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "body": {
    "minLength": 1,
    "type": "string"
   },
   "comment_id": {
    "description": "Edit this existing comment after verifying it belongs to the target issue",
    "minLength": 1,
    "type": "string"
   },
   "cwd": {
    "description": "Git working directory; defaults to the server process cwd",
    "minLength": 1,
    "type": "string"
   },
   "fields": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "identifier": {
    "minLength": 1,
    "type": "string"
   },
   "operation": {
    "enum": [
     "create",
     "update",
     "comment",
     "transition",
     "close",
     "reopen",
     "link"
    ],
    "type": "string"
   },
   "parent_comment_id": {
    "description": "Reply to this comment after verifying it belongs to the target issue",
    "minLength": 1,
    "type": "string"
   },
   "preset": {
    "minLength": 1,
    "type": "string"
   },
   "provider": {
    "description": "Explicit configured provider alias",
    "minLength": 1,
    "type": "string"
   },
   "status": {
    "enum": [
     "open",
     "in_progress",
     "done",
     "canceled"
    ],
    "type": "string"
   },
   "target_url": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "operation"
  ],
  "type": "object"
 },
 "name": "prepare_issue_change",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "required": [
     "code",
     "message"
    ],
    "type": "object"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "changes": {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "expiresAt": {
      "type": "string"
     },
     "identity": {
      "additionalProperties": false,
      "properties": {
       "id": {
        "type": "string"
       },
       "name": {
        "type": "string"
       },
       "scope": {
        "type": "string"
       }
      },
      "required": [
       "id",
       "name",
       "scope"
      ],
      "type": "object"
     },
     "operation": {
      "enum": [
       "create",
       "update",
       "comment",
       "transition",
       "close",
       "reopen",
       "link"
      ],
      "type": "string"
     },
     "providerAlias": {
      "type": "string"
     },
     "providerType": {
      "enum": [
       "linear",
       "github",
       "jira-cloud"
      ],
      "type": "string"
     },
     "repositoryId": {
      "type": "string"
     },
     "target": {
      "additionalProperties": false,
      "properties": {
       "identifier": {
        "type": "string"
       },
       "title": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "identifier",
       "title",
       "version"
      ],
      "type": "object"
     },
     "token": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     }
    },
    "required": [
     "token",
     "expiresAt",
     "repositoryId",
     "providerAlias",
     "providerType",
     "identity",
     "operation",
     "changes"
    ],
    "type": "object"
   }
  },
  "type": "object"
 },
 "title": "Preview issue change"
}
