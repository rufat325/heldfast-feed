{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Extract caller-supplied literal labels and adjacent native-text values with page and block evidence. Missing labels return null; no semantic extraction or OCR is performed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "capability": {
    "description": "Document capability returned by POST /v1/documents.",
    "maxLength": 64,
    "minLength": 40,
    "type": "string"
   },
   "document_id": {
    "description": "UUID returned by POST /v1/documents.",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "fields": {
    "description": "One to twenty literal labels to extract.",
    "items": {
     "properties": {
      "label": {
       "description": "Literal label to locate.",
       "maxLength": 160,
       "minLength": 1,
       "type": "string"
      },
      "name": {
       "description": "Output field name.",
       "maxLength": 80,
       "minLength": 1,
       "type": "string"
      },
      "page": {
       "description": "Optional 1-based page filter.",
       "maximum": 100,
       "minimum": 1,
       "type": "integer"
      }
     },
     "required": [
      "name",
      "label"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "document_id",
   "capability",
   "fields"
  ],
  "type": "object"
 },
 "name": "extract_document_fields",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "description": "Literal PDF field values with page and block evidence.",
  "properties": {
   "accepts": {
    "items": {},
    "type": "array"
   },
   "documentId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "error": {},
   "extensions": {},
   "fields": {
    "items": {},
    "type": "array"
   },
   "resource": {},
   "warning": {
    "type": "string"
   },
   "x402Version": {
    "type": "number"
   }
  },
  "type": "object"
 },
 "title": "Extract labeled PDF fields"
}
