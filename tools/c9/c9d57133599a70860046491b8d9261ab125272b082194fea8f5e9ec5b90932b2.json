{
 "description": "Create a span within a trace. Spans represent logical units of work and can be nested via parent_span_id.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "metadata": {
    "additionalProperties": {},
    "description": "Optional span metadata",
    "type": "object"
   },
   "parent_span_id": {
    "description": "Parent span ID for nesting (creates a tree)",
    "type": "string"
   },
   "span_name": {
    "description": "Name of this span (e.g. \"research\", \"code_generation\", \"validation\")",
    "type": "string"
   },
   "trace_id": {
    "description": "Trace to attach this span to",
    "type": "string"
   }
  },
  "required": [
   "trace_id",
   "span_name"
  ],
  "type": "object"
 },
 "name": "trace_span"
}
