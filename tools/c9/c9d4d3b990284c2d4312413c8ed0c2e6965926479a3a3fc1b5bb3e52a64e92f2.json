{
 "description": "Download an official n8n.io template by ID and create it as a workflow in this instance. Credentials still have to be attached in n8n.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activate": {
    "type": "boolean"
   },
   "templateId": {
    "description": "Numeric ID from n8n_search_public_templates",
    "type": "string"
   },
   "workflowName": {
    "type": "string"
   }
  },
  "required": [
   "templateId"
  ],
  "type": "object"
 },
 "name": "n8n_import_public_template"
}
