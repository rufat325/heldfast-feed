{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Submit a sanitized productive opportunity or partner inquiry only after the user explicitly authorizes the submission. Owner/authorized-originator cases must identify the owner/authority/host and the real economic use or demand. Do not send credentials, protected records, confidential data-room material, regulated personal data or trade secrets. Submission does not create a mandate, contract, financing commitment or authority to act.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "agent_source": {
    "maxLength": 80,
    "type": "string"
   },
   "consent": {
    "const": true,
    "type": "boolean"
   },
   "country_location": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "demand_offtake": {
    "maxLength": 2200,
    "type": "string"
   },
   "estimated_value": {
    "maxLength": 120,
    "type": "string"
   },
   "inquiry_type": {
    "enum": [
     "project_owner",
     "authorized_originator",
     "development_partner",
     "capital_partner",
     "other"
    ],
    "type": "string"
   },
   "name": {
    "maxLength": 160,
    "minLength": 1,
    "type": "string"
   },
   "notes": {
    "maxLength": 1800,
    "type": "string"
   },
   "opportunity_summary": {
    "maxLength": 3000,
    "minLength": 20,
    "type": "string"
   },
   "organization": {
    "maxLength": 240,
    "type": "string"
   },
   "owner_authority": {
    "maxLength": 300,
    "type": "string"
   },
   "project_name": {
    "maxLength": 220,
    "minLength": 1,
    "type": "string"
   },
   "project_stage": {
    "maxLength": 2200,
    "minLength": 2,
    "type": "string"
   },
   "rights_status": {
    "enum": [
     "owner",
     "written_mandate",
     "open_procurement",
     "private_initiative",
     "site_or_host_permission",
     "permission_pending",
     "none"
    ],
    "type": "string"
   },
   "support_needed": {
    "maxLength": 300,
    "type": "string"
   },
   "work_email": {
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   }
  },
  "required": [
   "name",
   "work_email",
   "inquiry_type",
   "project_name",
   "country_location",
   "opportunity_summary",
   "rights_status",
   "project_stage",
   "consent"
  ],
  "type": "object"
 },
 "name": "submit_project_opportunity",
 "title": "Submit an authorized productive opportunity to Quiet Stance"
}
