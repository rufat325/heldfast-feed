{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Use this when someone who ordered from 3D Printer on Demand asks where their order is or what state it is in. It takes the private order link from their order email and returns the order's status, its parts, how many have shipped, and any tracking numbers. It does not show the shipping address and it does not change the order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "order_link": {
    "description": "The private order link from the order confirmation or shipping email.",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "order_link"
  ],
  "type": "object"
 },
 "name": "get_order_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "expedited": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "need_by": {
    "type": "string"
   },
   "order_number": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "found",
     "not_found",
     "invalid_link",
     "try_later",
     "unavailable"
    ],
    "type": "string"
   },
   "packages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "carrier": {
       "type": "string"
      },
      "delivered_on": {
       "type": "string"
      },
      "items": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "name": {
          "type": "string"
         },
         "quantity": {
          "type": "number"
         }
        },
        "required": [
         "name",
         "quantity"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "shipped_on": {
       "type": "string"
      },
      "tracking_number": {
       "type": "string"
      },
      "tracking_url": {
       "type": "string"
      }
     },
     "required": [
      "items"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "paid": {
    "type": "boolean"
   },
   "parts": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "can_reorder": {
       "type": "boolean"
      },
      "color": {
       "type": "string"
      },
      "material": {
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "shipped_quantity": {
       "type": "number"
      }
     },
     "required": [
      "name",
      "material",
      "quantity",
      "shipped_quantity",
      "can_reorder"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "placed_on": {
    "type": "string"
   },
   "status": {
    "type": "string"
   },
   "status_detail": {
    "type": "string"
   },
   "totals": {
    "additionalProperties": false,
    "properties": {
     "currency": {
      "const": "USD",
      "type": "string"
     },
     "order_fee_usd": {
      "type": "number"
     },
     "shipping_usd": {
      "type": "number"
     },
     "subtotal_usd": {
      "type": "number"
     },
     "tax_usd": {
      "type": "number"
     },
     "total_usd": {
      "type": "number"
     }
    },
    "required": [
     "currency",
     "total_usd"
    ],
    "type": "object"
   }
  },
  "required": [
   "outcome",
   "message"
  ],
  "type": "object"
 },
 "title": "Check an order's status"
}
