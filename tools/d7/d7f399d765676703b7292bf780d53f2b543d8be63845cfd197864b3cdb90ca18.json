{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "File a manual geolocated incident report (same as POST /api/reports). Reports are moderated before they appear publicly. Errors: 'report submission disabled' if the caller is blocked; 'rate limited' past 20 reports/hour via MCP.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "category": {
    "description": "Incident category (default 'report')",
    "enum": [
     "crime",
     "fire",
     "disaster",
     "weather",
     "unrest",
     "health",
     "infra",
     "alert",
     "report"
    ],
    "type": "string"
   },
   "description": {
    "description": "Details, up to 2000 chars",
    "maxLength": 2000,
    "type": "string"
   },
   "lat": {
    "description": "Latitude, -90 to 90",
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "description": "Longitude, -180 to 180",
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "severity": {
    "description": "low | medium | high | critical (default 'medium')",
    "enum": [
     "low",
     "medium",
     "high",
     "critical"
    ],
    "type": "string"
   },
   "title": {
    "description": "Short headline, 1\u2013200 chars",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "title",
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "submit_report",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "report": {
    "additionalProperties": false,
    "properties": {
     "approximate": {
      "type": "boolean"
     },
     "category": {
      "type": "string"
     },
     "confirms": {
      "type": "number"
     },
     "count": {
      "type": "number"
     },
     "description": {
      "type": "string"
     },
     "flags": {
      "type": "number"
     },
     "group": {
      "type": "string"
     },
     "id": {
      "type": "string"
     },
     "lat": {
      "type": "number"
     },
     "lon": {
      "type": "number"
     },
     "nhood": {
      "type": "string"
     },
     "region": {
      "type": "string"
     },
     "reporter": {
      "additionalProperties": false,
      "properties": {
       "confirmed": {
        "type": "number"
       },
       "handle": {
        "type": "string"
       },
       "reports": {
        "type": "number"
       },
       "role": {
        "anyOf": [
         {
          "enum": [
           "curator",
           "moderator"
          ],
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       }
      },
      "required": [
       "handle",
       "role",
       "reports",
       "confirmed"
      ],
      "type": "object"
     },
     "resolves": {
      "type": "number"
     },
     "severity": {
      "type": "string"
     },
     "source": {
      "type": "string"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "status": {
      "enum": [
       "pending",
       "active",
       "resolved",
       "hidden"
      ],
      "type": "string"
     },
     "time": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "type": {
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "id",
     "source",
     "category",
     "type",
     "title",
     "lat",
     "lon",
     "time",
     "severity"
    ],
    "type": "object"
   }
  },
  "required": [
   "report"
  ],
  "type": "object"
 },
 "title": "Submit incident report"
}
