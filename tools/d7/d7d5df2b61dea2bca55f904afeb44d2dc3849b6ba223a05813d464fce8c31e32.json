{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "campaign.write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create NPC mnemons"
 },
 "description": "Create NPC mnemons (FACTION or INDIVIDUAL). npcType is REQUIRED on each item. Use memberNpcEntryIds (on FACTIONs) and affiliationEntryIds (on INDIVIDUALs) to wire membership; the server projects into MEMBER relationships. Players may not call this \u2014 GM/co-GM only.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "campaignId": {
    "minLength": 1,
    "type": "string"
   },
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "affiliationEntryIds": {
       "description": "INDIVIDUAL only: factions this person belongs to.",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "markdown": {
       "description": "Body content as Markdown. Mentions: @[label](mnemon:<entryId>). Images: ![caption](asset:<assetId>@<campaignId>) \u2014 upload the asset first.",
       "minLength": 1,
       "type": "string"
      },
      "memberNpcEntryIds": {
       "description": "FACTION only: members of this faction (NPC entryIds or titles).",
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "npcType": {
       "description": "Required: FACTION (organization) or INDIVIDUAL (person).",
       "enum": [
        "FACTION",
        "INDIVIDUAL"
       ],
       "type": "string"
      },
      "primaryLocationEntryId": {
       "description": "Home location \u2014 entryId or exact title.",
       "type": "string"
      },
      "relationshipIds": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "sheetId": {
       "type": "string"
      },
      "tags": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "description": "Title of the new entry.",
       "minLength": 1,
       "type": "string"
      },
      "visibility": {
       "enum": [
        "HIDDEN",
        "INTERNAL",
        "PUBLIC"
       ],
       "type": "string"
      }
     },
     "required": [
      "title",
      "markdown",
      "npcType"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "campaignId",
   "items"
  ],
  "type": "object"
 },
 "name": "create_npc_mnemons",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "entryId": {
       "type": "string"
      },
      "error": {
       "type": "string"
      },
      "failedOpIndex": {
       "type": "number"
      },
      "index": {
       "type": "number"
      },
      "success": {
       "type": "boolean"
      },
      "title": {
       "type": "string"
      },
      "warnings": {
       "items": {
        "type": "string"
       },
       "type": "array"
      }
     },
     "required": [
      "index",
      "success"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "results"
  ],
  "type": "object"
 },
 "title": "Create NPC mnemons"
}
