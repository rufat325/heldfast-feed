{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Recently launched tokens on Robinhood Chain launchpads (NOXA and The Odyssey), newest first, scanned from on-chain logs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "launchpad": {
    "description": "Restrict to one launchpad.",
    "enum": [
     "noxa",
     "odyssey"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max launches to return (default 25).",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "lookbackBlocks": {
    "description": "Blocks to scan back (~30k \u2248 1h; default 30000).",
    "exclusiveMinimum": 0,
    "maximum": 500000,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "get_recent_launches",
 "title": "Recent launchpad launches"
}
