{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Searches Sahadeva's deterministic local catalogue and geographic index. It never invokes another AI model. If no result exists, the MCP host should resolve the place with its own capabilities and pass coordinates to the chart tool.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 8,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_locations",
 "outputSchema": {
  "properties": {
   "matches": {
    "items": {
     "required": [
      "label",
      "latitude",
      "longitude",
      "timezone",
      "timezoneOffset"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "query": {
    "type": "string"
   },
   "status": {
    "enum": [
     "resolved",
     "ambiguous",
     "not_found"
    ],
    "type": "string"
   }
  },
  "required": [
   "query",
   "status",
   "matches"
  ],
  "type": "object"
 },
 "title": "Find a chart location"
}
