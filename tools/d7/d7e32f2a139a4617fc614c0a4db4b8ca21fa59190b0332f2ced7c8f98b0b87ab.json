{
 "annotations": {
  "readOnlyHint": true,
  "title": "List appointments"
 },
 "description": "List individual appointments, optionally filtered by patient/practitioner/business/type and a starts_at date-time window (starts_from / starts_to, ISO 8601). GET /individual_appointments.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "appointment_type_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Filter by appointment type id."
   },
   "business_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Filter by business id."
   },
   "order": {
    "description": "Sort direction. asc | desc.",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Default 1.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "patient_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Filter by patient id (q[]=patient_id:=)."
   },
   "per_page": {
    "description": "Results per page (max 100). Default 50.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "practitioner_id": {
    "anyOf": [
     {
      "exclusiveMinimum": 0,
      "maximum": 9007199254740991,
      "type": "integer"
     },
     {
      "minLength": 1,
      "type": "string"
     }
    ],
    "description": "Filter by practitioner id."
   },
   "sort": {
    "description": "Field to sort by, e.g. created_at.",
    "type": "string"
   },
   "starts_from": {
    "description": "Only appointments starting at/after this ISO 8601 time (q[]=starts_at:>).",
    "type": "string"
   },
   "starts_to": {
    "description": "Only appointments starting before this ISO 8601 time (q[]=starts_at:<).",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "cliniko_list_appointments",
 "title": "List appointments"
}
