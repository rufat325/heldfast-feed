{
 "description": "List all installed plugins",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "search": {
    "description": "Search plugin name, description and author",
    "type": "string"
   },
   "site": {
    "description": "Site id (see list_sites)",
    "type": "string"
   },
   "status": {
    "description": "Limit to these statuses (network-active only on multisite)",
    "items": {
     "enum": [
      "active",
      "inactive",
      "network-active"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "wp_list_plugins"
}
