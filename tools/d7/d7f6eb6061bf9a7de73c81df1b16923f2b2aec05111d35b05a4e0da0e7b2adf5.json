{
 "annotations": {
  "idempotentHint": true,
  "title": "Fill Layer with Color"
 },
 "description": "Fill the active layer (or the current selection within it) with a solid RGB color. Idempotent for the same color. Throws on fully-locked or text layers \u2014 rasterize text first if needed.",
 "inputSchema": {
  "properties": {
   "blue": {
    "description": "Blue component (0-255)",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   },
   "green": {
    "description": "Green component (0-255)",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   },
   "red": {
    "description": "Red component (0-255)",
    "maximum": 255,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "red",
   "green",
   "blue"
  ],
  "type": "object"
 },
 "name": "ps_fill_layer",
 "outputSchema": {
  "properties": {
   "color": {
    "type": "object"
   },
   "filled": {
    "type": "boolean"
   },
   "layerName": {
    "type": "string"
   }
  },
  "type": "object"
 }
}
