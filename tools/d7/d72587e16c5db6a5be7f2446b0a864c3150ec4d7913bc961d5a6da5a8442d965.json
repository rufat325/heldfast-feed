{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Expected back-in-stock week for one colour of a MyHairMail wig that is backordered or out of stock, from live factory availability. restock_eta_week is the Monday (YYYY-MM-DD) of the ISO week of expected arrival; eta_display is human phrasing ('week of Nov 9'). preorder_available=true means it can be ordered now and ships when restocked. discontinued means it will not restock; the response then includes next_step naming the tool that finds an equivalent. For an in_stock colour this simply confirms availability. Never returns quantities. Terms: https://mcp.myhairmailtools.com/terms",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "brand": {
    "description": "Brand name, e.g. 'Envy', 'Jon Renau'",
    "type": "string"
   },
   "color": {
    "description": "Colour name or code exactly as listed by check_stock, e.g. 'Prosecco' or 'FS26/31S6'",
    "type": "string"
   },
   "style": {
    "description": "Style name, e.g. 'Charlotte Hand-Tied'",
    "type": "string"
   }
  },
  "required": [
   "brand",
   "style",
   "color"
  ],
  "type": "object"
 },
 "name": "get_restock_eta",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": {},
  "properties": {
   "did_you_mean": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "brand": {
       "type": "string"
      },
      "color": {
       "type": "string"
      },
      "style": {
       "type": "string"
      }
     },
     "required": [
      "brand",
      "style"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "match": {
    "type": "boolean"
   },
   "next_step": {
    "additionalProperties": {},
    "properties": {
     "reason": {
      "type": "string"
     },
     "tool": {
      "type": "string"
     }
    },
    "required": [
     "tool",
     "reason"
    ],
    "type": "object"
   },
   "note": {
    "type": "string"
   },
   "product": {
    "additionalProperties": {},
    "properties": {
     "availability": {
      "enum": [
       "in_stock",
       "out_of_stock",
       "backordered",
       "discontinued"
      ],
      "type": "string"
     },
     "brand": {
      "type": "string"
     },
     "color": {
      "type": "string"
     },
     "compare_at_price_usd": {
      "type": "number"
     },
     "eta_display": {
      "type": "string"
     },
     "notify_url": {
      "type": "string"
     },
     "preorder_available": {
      "type": "boolean"
     },
     "price_usd": {
      "type": "number"
     },
     "product_url": {
      "type": "string"
     },
     "restock_eta_week": {
      "type": "string"
     },
     "ships_today_cutoff": {
      "type": "string"
     },
     "style": {
      "type": "string"
     }
    },
    "required": [
     "brand",
     "style",
     "availability",
     "price_usd",
     "product_url",
     "preorder_available",
     "notify_url"
    ],
    "type": "object"
   },
   "retailer": {
    "type": "string"
   },
