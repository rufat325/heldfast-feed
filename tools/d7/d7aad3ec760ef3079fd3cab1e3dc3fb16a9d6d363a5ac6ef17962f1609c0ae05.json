{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update asset cost"
 },
 "description": "Update an existing asset cost entry by ID - the record type shown on the AssetLab \"Expenses\" page. Requires asset_costs:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "description": "Cost amount",
    "minimum": 0,
    "type": "number"
   },
   "asset_id": {
    "description": "Asset ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "building_id": {
    "description": "Building ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "category": {
    "description": "Cost category",
    "enum": [
     "Repair",
     "PM",
     "Operation",
     "Replacement",
     "Decommission",
     "Other"
    ],
    "type": "string"
   },
   "cost_date": {
    "description": "Cost date (ISO 8601)",
    "type": "string"
   },
   "description": {
    "description": "Description",
    "type": "string"
   },
   "id": {
    "description": "Asset cost ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "invoice_number": {
    "description": "Invoice number (free text)",
    "maxLength": 200,
    "type": "string"
   },
   "po_number": {
    "description": "Purchase order number (free text)",
    "maxLength": 200,
    "type": "string"
   },
   "purchase_order_id": {
    "anyOf": [
     {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Purchase order that paid this cost - resolve via list_purchase_orders. Counts against the order's remaining balance unless the cost belongs to a work order; null clears it."
   },
   "site_id": {
    "description": "Site ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "work_order_id": {
    "description": "Work order ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_asset_cost",
 "title": "Update asset cost"
}
