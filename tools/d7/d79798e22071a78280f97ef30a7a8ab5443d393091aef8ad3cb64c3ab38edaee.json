{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "I2S bit clock (BCLK/SCK) from audio format: BCLK = Fs x bits x channels.\nArgs: sample_rate_hz (e.g. 48000), bits_per_sample (e.g. 16/24/32), channels (default 2).\nReturns (structured): { bclk_hz, bclk_period_ns, lrclk_hz }.\nExample: 48 kHz, 24-bit, stereo -> BCLK 2.304 MHz (434.03 ns), LRCLK 48 kHz.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bits_per_sample": {
    "description": "Bits per sample per channel (16/24/32)",
    "maximum": 32,
    "minimum": 8,
    "type": "integer"
   },
   "channels": {
    "default": 2,
    "description": "Channel count (2 = stereo)",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   },
   "sample_rate_hz": {
    "description": "Sample rate Fs in Hz (44100, 48000, ...)",
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "sample_rate_hz",
   "bits_per_sample"
  ],
  "type": "object"
 },
 "name": "embedcalc_i2s_clocks",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bclk_hz": {
    "type": "number"
   },
   "bclk_period_ns": {
    "type": "number"
   },
   "lrclk_hz": {
    "type": "number"
   }
  },
  "required": [
   "bclk_hz",
   "bclk_period_ns",
   "lrclk_hz"
  ],
  "type": "object"
 },
 "title": "I2S Clock Calculator"
}
