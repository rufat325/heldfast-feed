{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update Custom Field"
 },
 "description": "Update a custom field definition label, type, options, required flag, or sort order.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "definitionId": {
    "description": "Custom field definition ID",
    "type": "string"
   },
   "fieldLabel": {
    "description": "Human-readable label",
    "minLength": 1,
    "type": "string"
   },
   "fieldType": {
    "description": "Field type",
    "enum": [
     "text",
     "number",
     "date",
     "select",
     "multiselect",
     "boolean",
     "url",
     "email",
     "phone"
    ],
    "type": "string"
   },
   "isRequired": {
    "description": "Whether this field is required",
    "type": "boolean"
   },
   "options": {
    "description": "Allowed values for select/multiselect fields",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "sortOrder": {
    "description": "Display order",
    "type": "number"
   }
  },
  "required": [
   "definitionId"
  ],
  "type": "object"
 },
 "name": "update_custom_field",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Tool result payload \u2014 shape varies per tool, see the tool description"
   },
   "renderType": {
    "description": "UI rendering hint for the result",
    "enum": [
     "table",
     "detail",
     "stats",
     "text",
     "chart",
     "download"
    ],
    "type": "string"
   },
   "summary": {
    "description": "One-line human-readable summary of the action",
    "type": "string"
   }
  },
  "required": [
   "data",
   "summary",
   "renderType"
  ],
  "type": "object"
 }
}
