 "description": "Use this when the connected user asks to select, change or clear their own items on an existing shared bill, such as one pizza portion and one tip share, for calculating their personal share. Saves absolute item selection quantities for that user; it does not change bill items, prices or the total. Do not use to create or edit a bill, select for friends, or mark a payment as completed. Use actual bill_id and item IDs; quantity 0 clears a selection, and omitted selections remain unchanged. Selections and the user's display name are visible to anyone with the bill link. Cannot select on behalf of other people or collect payments. Requires OAuth; no profile lookup is needed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bill_id": {
    "description": "Bill ID to update selections for",
    "type": "string"
   },
   "selections": {
    "description": "Selections by item",
    "items": {
     "additionalProperties": false,
     "properties": {
      "item_id": {
       "description": "Bill item ID",
       "type": "string"
      },
      "quantity": {
       "description": "Selected quantity as numeric string",
       "type": "string"
      }
     },
     "required": [
      "item_id",
      "quantity"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "bill_id",
   "selections"
  ],
  "type": "object"
 },
 "name": "set_bill_selections_batch",
