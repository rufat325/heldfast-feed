{
 "description": "Decode a URL-encoded (percent-encoded) string",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "full": {
    "default": false,
    "description": "If true, decode a full URL (use decodeURI); otherwise decode a component (decodeURIComponent)",
    "type": "boolean"
   },
   "input": {
    "description": "URL-encoded string to decode",
    "type": "string"
   }
  },
  "required": [
   "input"
  ],
  "type": "object"
 },
 "name": "decode_url"
}
