{
 "description": "Log an advisory need.v1 request. Do not include personal or secret data. Returns need-id; persistence is partial until private ingestion and publication.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "need": {
    "additionalProperties": false,
    "properties": {
     "adaptation": {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "enum": [
         "none",
         "view",
         "next_season",
         "on_demand"
        ],
        "type": "string"
       }
      },
      "required": [
       "kind"
      ],
      "type": "object"
     },
     "constraints": {
      "additionalProperties": false,
      "properties": {
       "data_residency": {
        "enum": [
         "any",
         "ch",
         "eu",
         "us"
        ],
        "type": "string"
       },
       "interfaces": {
        "items": {
         "enum": [
          "api",
          "cli",
          "mcp"
         ],
         "type": "string"
        },
        "maxItems": 3,
        "type": "array"
       },
       "languages": {
        "items": {
         "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$",
         "type": "string"
        },
        "maxItems": 10,
        "type": "array"
       },
       "max_cost_per_unit_usd": {
        "minimum": 0,
        "type": "number"
       },
       "max_latency_ms": {
        "exclusiveMinimum": 0,
        "maximum": 9007199254740991,
        "type": "integer"
       }
      },
      "type": "object"
     },
     "description": {
      "type": "string"
     },
     "priorities": {
      "additionalProperties": false,
      "properties": {
       "cost": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "latency": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "quality": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       },
       "reliability": {
        "maximum": 1,
        "minimum": 0,
        "type": "number"
       }
      },
      "type": "object"
     },
     "requester": {
      "additionalProperties": false,
      "properties": {
       "kind": {
        "enum": [
         "agent",
         "buyer",
         "vendor",
         "operator",
         "researcher"
        ],
        "type": "string"
       },
       "origin": {
        "type": "string"
       }
      },
      "required": [
       "kind",
       "origin"
      ],
      "type": "object"
     },
     "schema": {
      "const": "need.v1",
      "type": "string"
     },
     "task_class": {
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$",
      "type": "string"
     }
    },
    "required": [
     "schema",
     "requester",
     "task_class"
    ],
    "type": "object"
   }
  },
  "required": [
   "need"
  ],
  "type": "object"
 },
 "name": "submit_need"
}
