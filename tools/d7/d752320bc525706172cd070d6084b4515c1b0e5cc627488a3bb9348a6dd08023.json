{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Top Holders"
 },
 "description": "Classification-aware UNION across insider transactions (latest post_transaction_shares per insider), 13F institutional holdings, and SC 13D / 13G blockholder filings for one issuer.  Each row carries holder_class \u2208 {insider, institutional, blockholder_13D, blockholder_13G}.  Dedupes overlapping filers by precedence (13D > 13G > institutional > insider).  One call, classified cap table \u2014 Bloomberg charges separately for INSIDER<GO>, OWNER<GO>, and HDS<GO>; this consolidates them.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "as_of_date": {
    "description": "Point-in-time cutoff (YYYY-MM-DD): only filings ACCEPTED by SEC on or before this date are considered across all three sources (institutional via accepted_at, insider via accepted_at, blockholders via accepted_at). Excludes amendments/late filings accepted after this date (zero look-ahead). Omit for the latest knowable cap table.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "period_end": {
    "description": "13F REPORTING period_end. Omit for latest. NOT a point-in-time cutoff \u2014 use as_of_date.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "ticker": {
    "description": "Issuer ticker symbol \u2014 or a CIK (SEC identifier).",
    "maxLength": 10,
    "minLength": 1,
    "pattern": "^[A-Za-z0-9.\\-]+$",
    "type": "string"
   },
   "top_n": {
    "default": 25,
    "description": "Maximum holders to return, ranked by shares. Default 25.",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "ticker"
  ],
  "type": "object"
 },
 "name": "get_top_holders",
