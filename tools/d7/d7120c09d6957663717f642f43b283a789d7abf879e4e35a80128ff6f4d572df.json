{
 "description": "Generate images (Nano Banana 2 / DALL-E 3) or videos (Veo 3.1) via Oculo. Returns saved file path. Supports image-to-image editing with reference image.",
 "inputSchema": {
  "properties": {
   "duration": {
    "description": "Video duration: 4, 6, or 8 seconds",
    "type": "number"
   },
   "image": {
    "description": "Path to reference image for image-to-image editing/transformation (Gemini only)",
    "type": "string"
   },
   "model": {
    "description": "Image model: nano-banana-2 (default), nano-banana-pro, nano-banana",
    "type": "string"
   },
   "prompt": {
    "description": "What to create",
    "type": "string"
   },
   "provider": {
    "description": "Override: gemini, openai, stability",
    "type": "string"
   },
   "size": {
    "description": "Image: 1024x1024, 2K, 4K. Video: 16:9, 9:16",
    "type": "string"
   },
   "style": {
    "description": "natural, vivid, cinematic, anime",
    "type": "string"
   },
   "type": {
    "description": "Generate an image or video",
    "enum": [
     "image",
     "video"
    ],
    "type": "string"
   }
  },
  "required": [
   "type",
   "prompt"
  ],
  "type": "object"
 },
 "name": "media"
}
