{
 "description": "List ERC-20 tokens with richer filters (verified, sorting).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "network": {
    "description": "Network to query. Defaults to the server's configured network (mainnet).",
    "enum": [
     "mainnet",
     "sepolia"
    ],
    "type": "string"
   },
   "page": {
    "description": "Page number (1-based). Defaults to 1.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "pageSize": {
    "description": "Items per page: 10, 25, 50, or 100. Defaults to 25. Keep small to save context.",
    "enum": [
     10,
     25,
     50,
     100
    ],
    "type": "number"
   },
   "sortBy": {
    "description": "Sort attribute. Defaults to \"holders\".",
    "enum": [
     "holders",
     "transfers",
     "market_cap"
    ],
    "type": "string"
   },
   "verified": {
    "description": "Only verified tokens when true.",
    "type": "boolean"
   }
  },
  "type": "object"
 },
 "name": "list_erc20_tokens"
}
