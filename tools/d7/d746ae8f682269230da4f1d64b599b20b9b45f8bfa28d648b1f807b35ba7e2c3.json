{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Get hotel details"
 },
 "description": "Get full property details (description, amenities, photos, policies, location) for a hotel, identified by its `ref` from `search_hotels` (or its supplierCode + supplierHotelId).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "adults": {
    "description": "Adults (default 2).",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "checkIn": {
    "description": "Check-in date, ISO 8601 (YYYY-MM-DD). Pass the guest's dates when known: some suppliers only return a hotel that has rooms for them.",
    "type": "string"
   },
   "checkOut": {
    "description": "Check-out date, ISO 8601 (YYYY-MM-DD).",
    "type": "string"
   },
   "children": {
    "description": "Children (default 0).",
    "maximum": 6,
    "minimum": 0,
    "type": "integer"
   },
   "ref": {
    "description": "The hotel `ref` from search (e.g. 'tbo:1360717').",
    "type": "string"
   },
   "rooms": {
    "description": "Rooms (default 1).",
    "maximum": 9,
    "minimum": 1,
    "type": "integer"
   },
   "supplierCode": {
    "description": "Alternative to `ref`: supplier code.",
    "type": "string"
   },
   "supplierHotelId": {
    "description": "Alternative to `ref`: supplier hotel id.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_hotel_details",
 "title": "Get hotel details"
}
