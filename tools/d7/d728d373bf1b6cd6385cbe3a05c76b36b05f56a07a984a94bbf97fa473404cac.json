{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Read the SHrimp terminal inbox.\n\nRequires the SHrimp iOS app (paired mode). Not available in local mode.\n\nItem sources: email, shareExtension, siri, github, clipboard, composer\nItem statuses: pending, processing, processed, failed",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Max items to return (default 50, max 100)",
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "source": {
    "description": "Filter by item source",
    "enum": [
     "email",
     "shareExtension",
     "siri",
     "github",
     "clipboard",
     "composer"
    ],
    "type": "string"
   },
   "status": {
    "description": "Filter by item status",
    "enum": [
     "pending",
     "processing",
     "processed",
     "failed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "shrimp_inbox",
 "title": "Read Inbox"
}
