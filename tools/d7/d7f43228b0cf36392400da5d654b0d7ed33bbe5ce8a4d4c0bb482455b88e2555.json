{
 "description": "Mints a pllm_ routing key (returned once) for OPENAI_API_KEY-style use against the gateway. Optionally wires the provider chain in the same call; discover wireable lane ids with proxyllm_list_routing_keys include_lanes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "account_token": {
    "type": "string"
   },
   "label": {
    "maxLength": 60,
    "type": "string"
   },
   "mode": {
    "enum": [
     "fallback",
     "classifier"
    ],
    "type": "string"
   },
   "monthly_budget_usd": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "providers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "bridge_instance_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "codex_session_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "credential_id": {
       "type": [
        "string",
        "null"
       ]
      },
      "model": {
       "type": [
        "string",
        "null"
       ]
      },
      "provider": {
       "description": "codex, bridge, or an API-key provider (openai, anthropic, openrouter, ...)",
       "type": "string"
      }
     },
     "required": [
      "provider"
     ],
     "type": "object"
    },
    "maxItems": 5,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "proxyllm_create_routing_key",
 "title": "Create a routing key"
}
