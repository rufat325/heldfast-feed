{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get leaderboard"
 },
 "description": "Models ranked by accuracy; defaults to all effort levels for compatibility.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "effort": {
    "description": "best, all (default), or one effort level; empty means all",
    "type": "string"
   },
   "family": {
    "description": "Comma-separated family ids; empty means no filter",
    "type": "string"
   },
   "min_correct": {
    "description": "Minimum puzzles solved in the selected tier; default 0 includes unsolved variants",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "open_weights": {
    "description": "Only open-weight (true) or closed (false) models",
    "type": "boolean"
   },
   "provider": {
    "description": "Comma-separated provider ids; empty means no filter",
    "type": "string"
   },
   "reasoning": {
    "description": "Only reasoning (true) or non-reasoning (false) variants",
    "type": "boolean"
   },
   "size": {
    "description": "Grid size to filter on",
    "enum": [
     "5x5",
     "10x10",
     "15x15",
     "20x20"
    ],
    "type": "string"
   },
   "version": {
    "description": "Comma-separated benchmark versions: 1.0, 1.1, 1.2; empty means all",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "get_leaderboard",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "models": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "accuracy": {
       "description": "Percentage of puzzles solved",
       "type": "number"
      },
      "correct": {
       "type": "number"
      },
      "displayName": {
       "type": "string"
      },
      "effort": {
       "type": [
        "string",
        "null"
       ]
      },
      "family": {
       "type": "string"
      },
      "model": {
       "description": "Model variant id, e.g. claude-opus-5.5-high",
       "type": "string"
      },
      "provider": {
       "type": [
        "string",
        "null"
       ]
      },
      "rank": {
       "type": "number"
      },
      "reasoning": {
       "type": "boolean"
      },
      "total": {
       "type": "number"
      },
      "totalCostUsd": {
       "type": "number"
      }
     },
     "required": [
      "model",
      "displayName",
      "family",
      "effort",
      "provider",
      "reasoning",
      "accuracy",
      "rank",
      "correct",
      "total",
      "totalCostUsd"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "size": {
    "type": "string"
   },
   "updatedAt": {
    "type": "string"
   }
  },
  "required": [
   "updatedAt",
   "size",
   "models"
  ],
  "type": "object"
 },
 "title": "Get leaderboard"
}
