{
 "description": "Create practical weekly plans and adaptive updates based on real availability, missed sessions, and fatigue.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "availability": {
    "properties": {
     "daily_minutes": {
      "maximum": 600,
      "minimum": 1,
      "type": "integer"
     },
     "days_per_week": {
      "maximum": 7,
      "minimum": 1,
      "type": "integer"
     },
     "weekly_minutes": {
      "maximum": 4000,
      "minimum": 1,
      "type": "integer"
     }
    },
    "type": "object"
   },
   "goals": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "profile_id": {
    "type": "string"
   },
   "week_context": {
    "properties": {
     "completed_minutes": {
      "maximum": 4000,
      "minimum": 0,
      "type": "integer"
     },
     "fatigue": {
      "enum": [
       "low",
       "medium",
       "high"
      ],
      "type": "string"
     },
     "missed_days": {
      "maximum": 7,
      "minimum": 0,
      "type": "integer"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "goals",
   "availability"
  ],
  "type": "object"
 },
 "name": "practice_coach",
 "title": "Practice Coach"
}
