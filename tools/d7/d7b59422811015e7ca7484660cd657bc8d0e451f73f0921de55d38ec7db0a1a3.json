{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Update floorplan region"
 },
 "description": "Update a floorplan region - rename, reshape polygon, link to a Location, or mark as reviewed. Requires floorplan_regions:write scope.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confidence": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "id": {
    "description": "Floorplan region ID",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "label": {
    "description": "New label",
    "maxLength": 500,
    "type": "string"
   },
   "location_id": {
    "description": "Linked Location ID (set to null to unlink)",
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12})$",
    "type": "string"
   },
   "polygon": {
    "description": "Polygon outline as an array of [x, y] points in normalized 0-1 coordinates (origin top-left). At least 3 points.",
    "items": {
     "items": {
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     },
     "maxItems": 2,
     "minItems": 2,
     "type": "array"
    },
    "minItems": 3,
    "type": "array"
   },
   "reviewed": {
    "description": "Mark region as reviewed by admin",
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_floorplan_region",
 "title": "Update floorplan region"
}
