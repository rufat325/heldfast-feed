{"_meta":{"flowstate/actions":{"additive":["add","block","claim","renew","release","handoff"],"destructive":["update","unblock"],"read":["list","next"]}},"annotations":{"destructiveHint":true,"idempotentHint":false,"openWorldHint":false,"readOnlyHint":false,"title":"Todos"},"description":"Todos. list; next: top unblocked (others' claims last). update: status, priority or title, when done and before you end. block / unblock: waits on todos or a problem. add: subtask, blocker or due date only (else log_work). claim before you start (fails if someone has it); renew; release or handoff (with a note). Returns rows.","inputSchema":{"properties":{"action":{"description":"The operation; see the tool description.","enum":["list","next","update","block","unblock","add","claim","renew","release","handoff"],"type":"string"},"blocked_by":{"description":"Todo ids it waits on.","items":{"type":"integer"},"type":"array"},"blocked_by_problem":{"description":"Problem id it waits on.","type":"integer"},"compact":{"description":"list: shorter rows.","type":"boolean"},"component_id":{"description":"add: component id.","type":"integer"},"description":{"description":"add / update.","type":"string"},"due_date":{"description":"add: ISO due date.","type":"string"},"limit":{"description":"next: how many (default 5).","type":"integer"},"min_priority":{"description":"list: this or more urgent.","enum":["critical","urgent","high","normal","medium","low"],"type":"string"},"minutes":{"description":"claim / renew: 1-120, default 15.","type":"integer"},"model":{"description":"Model name if known. Never guess.","type":"string"},"next_step":{"description":"handoff: the next step.","type":"string"},"parent_todo_id":{"description":"add: parent todo id.","type":"integer"},"priority":{"description":"add / update. list: filter.","enum":["critical","urgent","high","normal","medium","low"],"type":"string"},"project":{"description":"Project name or id. Required.","type":["string","integer"]},"sort":{"description":"list: default priority.","enum":["priority","due","newest"],"type":"string"},"status":{"description":"update: new. list: filter.","enum":["pending","in_progress","blocked","done","cancelled"],"type":"string"},"title":{"description":"add (required) / update.","type":"string"},"todo_id":{"description":"#id in the brief.","type":"integer"},"where_i_was":{"description":"handoff: your progress.","type":"string"}},"required":["action","project"],"type":"object"},"name":"manage_todos"}
