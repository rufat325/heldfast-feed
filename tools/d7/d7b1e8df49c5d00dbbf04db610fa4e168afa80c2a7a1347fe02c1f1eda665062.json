{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Compare tours"
 },
 "description": "Compare 2 to 4 TripWays tours side by side by bokun_id: from-price, duration, rating, cancellation type, hotel pickup, languages, inclusions, and exclusions. The result also names the tour with the lowest from-price, the shortest duration, the best rating (10+ reviews), and which have free cancellation. Ids that are not bookable tours come back in not_found. For group totals on a date, use check_availability and get_price_quote.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "bokun_ids": {
    "description": "Two to four tour ids (the number in tripways.com/t/{id}).",
    "items": {
     "pattern": "^[0-9]+$",
     "type": "string"
    },
    "maxItems": 4,
    "minItems": 2,
    "type": "array",
    "uniqueItems": true
   }
  },
  "required": [
   "bokun_ids"
  ],
  "type": "object"
 },
 "name": "compare_tours",
 "outputSchema": {
  "properties": {
   "error": {
    "description": "Present when ok is false. code: tour_not_found, destination_not_found, destination_ambiguous, or unpriced. message is written for the traveler.",
    "properties": {
     "code": {
      "type": "string"
     },
     "message": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "highlights": {
    "description": "bokun_id of the tour with the lowest from-price, the shortest duration, and the best rating (10+ reviews), and the ids with free cancellation.",
    "properties": {
     "best_rated": {
      "type": "string"
     },
     "free_cancellation": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "lowest_from_price": {
      "type": "string"
     },
     "shortest": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "not_found": {
    "description": "Ids that are not bookable tours.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "note": {
    "type": "string"
   },
   "ok": {
    "type": "boolean"
   },
   "tours": {
    "description": "One row per tour found, in the order asked.",
    "items": {
     "properties": {
      "activities": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "bokun_id": {
       "description": "Tour id; the number in tripways.com/t/{id}.",
       "type": "string"
      },
      "bookable_natively": {
       "description": "True when checkout_url opens TripWays checkout; false when it opens the operator calendar.",
       "type": "boolean"
      },
      "cancellation": {
       "description": "free, flexible, partial, or non_refundable.",
       "type": "string"
      },
      "checkout_url": {
       "description": "TripWays checkout for this tour.",
       "type": "string"
      },
      "destinations": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "duration_hours": {
       "type": "number"
      },
      "duration_text": {
       "type": "string"
      },
      "exclusions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "from_price": {
       "description": "Lowest adult price.",
       "properties": {
        "amount": {
         "minimum": 0,
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "type": "object"
      },
      "gttd_eligible": {
       "description": "Listed on Google Things to Do.",
       "type": "boolean"
      },
      "hero_image": {
       "description": "Main photo URL.",
       "type": "string"
      },
      "hotel_pickup": {
       "type": "boolean"
      },
      "inclusions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "languages": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "meeting_pickup_label": {
       "type": "string"
      },
      "rating": {
       "properties": {
        "count": {
         "type": "integer"
        },
        "low_confidence": {
         "description": "True when there are fewer than 10 reviews.",
         "type": "boolean"
        },
        "value": {
         "type": [
          "number",
          "null"
         ]
        }
       },
       "type": "object"
      },
      "reason": {
       "description": "Why checkout works the way it does, e.g. pickup_required.",
       "type": [
        "string",
        "null"
       ]
      },
      "summary": {
       "type": "string"
      },
      "themes": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "The tour's TripWays page.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 },
 "title": "Compare tours"
}
