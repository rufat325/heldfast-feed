{
 "annotations": {
  "destructiveHint": true
 },
 "description": "Create a Google Ads Performance Max campaign. Requires images, headlines, descriptions, and a business name.",
 "inputSchema": {
  "properties": {
   "business_name": {
    "description": "Business name (max 25 chars)",
    "type": "string"
   },
   "campaign_name": {
    "description": "Name for the campaign",
    "type": "string"
   },
   "daily_budget": {
    "description": "Daily budget in USD",
    "type": "number"
   },
   "descriptions": {
    "description": "Descriptions (2-5 accepted; provide 4-5; max 90 chars each)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "final_url": {
    "description": "Landing page URL",
    "type": "string"
   },
   "geo_targets": {
    "description": "Geo target codes",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "headlines": {
    "description": "Headlines (3-15 accepted; provide 11+, 15 recommended \u2014 fewer produces a weak Ad Strength rating; max 30 chars each)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "landscape_image_url": {
    "description": "URL to 1200x628 landscape image",
    "type": "string"
   },
   "logo_url": {
    "description": "URL to square logo (min 128x128)",
    "type": "string"
   },
   "long_headline": {
    "description": "Long headline (max 90 chars)",
    "type": "string"
   },
   "square_image_url": {
    "description": "URL to 1200x1200 square image",
    "type": "string"
   },
   "target_cpa": {
    "description": "Target CPA in USD (optional)",
    "type": "number"
   }
  },
  "required": [
   "campaign_name",
   "daily_budget",
   "headlines",
   "long_headline",
   "descriptions",
   "business_name",
   "final_url"
