 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Text diff"
 },
 "description": "Diff two texts: unified diff (patch format), a line/word-level change list, and similarity % \u2014 compare versions of a doc, config or code. jsdiff. mode=lines gives a unified patch; mode=words gives word-level changes for prose. Price: free. Errors: returns isError with a message for invalid input or an upstream failure (not charged).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "a": {
    "description": "Original text.",
    "type": "string",
    "x-raw": true
   },
   "b": {
    "description": "Changed text.",
    "type": "string",
    "x-raw": true
   },
   "context": {
    "default": 3,
    "description": "Unchanged lines of context around each change in the patch. Range 0-20. Default 3.",
    "maximum": 20,
    "minimum": 0,
    "type": "integer"
   },
   "mode": {
    "default": "lines",
    "description": "Diff granularity. One of \"lines\", \"words\". Default \"lines\".",
    "enum": [
     "lines",
     "words"
    ],
    "type": "string"
   }
  },
  "required": [
   "a",
   "b"
  ],
  "type": "object"
 },
 "name": "text_diff",
 "outputSchema": {
  "properties": {
   "changes": {
    "items": {
     "properties": {
      "op": {
       "type": [
        "string",
        "null"
       ]
      },
      "text": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "type": [
      "object",
      "null"
     ]
    },
    "type": "array"
   },
   "chars_added": {
    "type": [
     "number",
     "null"
    ]
   },
   "chars_removed": {
    "type": [
     "number",
     "null"
    ]
   },
   "identical": {
    "type": [
     "boolean",
     "null"
    ]
   },
   "similarity_pct": {
    "type": [
     "number",
     "null"
    ]
   },
   "unified": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "title": "Text diff"
}
