{
 "annotations": {
  "destructiveHint": true,
  "title": "Create patient"
 },
 "description": "Creates a Patient in Metriport (writes PHI and initiates health-information-exchange queries). Medical API: POST /medical/v1/patient (facilityId is a required query param).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "address": {
    "description": "One or more addresses for the Patient.",
    "items": {
     "properties": {
      "addressLine1": {
       "description": "Street address line 1.",
       "type": "string"
      },
      "addressLine2": {
       "description": "Street address line 2 (apt/suite).",
       "type": "string"
      },
      "city": {
       "description": "City.",
       "type": "string"
      },
      "country": {
       "description": "Country. Defaults to USA.",
       "type": "string"
      },
      "state": {
       "description": "2-letter US state code, e.g. CA.",
       "type": "string"
      },
      "zip": {
       "description": "ZIP / postal code.",
       "type": "string"
      }
     },
     "required": [
      "addressLine1",
      "city",
      "state",
      "zip"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "contact": {
    "description": "Optional contact info (phone / email).",
    "items": {
     "properties": {
      "email": {
       "description": "Email address.",
       "type": "string"
      },
      "phone": {
       "description": "10-digit phone number, e.g. 1234567890.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "dob": {
    "description": "Date of birth, yyyy-mm-dd.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "facilityId": {
    "description": "REQUIRED. The Facility ID where the Patient receives care.",
    "type": "string"
   },
   "firstName": {
    "description": "The Patient's first name(s).",
    "type": "string"
   },
   "genderAtBirth": {
    "description": "Gender at birth: M, F, O (other), or U (unknown).",
    "enum": [
     "M",
     "F",
     "O",
     "U"
    ],
    "type": "string"
   },
   "lastName": {
    "description": "The Patient's last name(s).",
    "type": "string"
   },
   "middleName": {
    "description": "The Patient's middle name(s).",
    "type": "string"
   },
   "personalIdentifiers": {
    "description": "Optional personal IDs (driver's license / SSN).",
    "items": {
     "properties": {
      "assigner": {
       "type": "string"
      },
      "state": {
       "description": "2-letter state code (required for driversLicense).",
       "type": "string"
      },
      "type": {
       "description": "Identifier type.",
       "enum": [
        "driversLicense",
        "ssn"
       ],
       "type": "string"
      },
      "value": {
       "description": "The ID number.",
       "type": "string"
      }
     },
     "required": [
      "type",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "facilityId",
   "firstName",
   "lastName",
   "dob",
   "genderAtBirth",
   "address"
  ],
  "type": "object"
 },
 "name": "metriport_create_patient",
 "title": "Create patient"
}
