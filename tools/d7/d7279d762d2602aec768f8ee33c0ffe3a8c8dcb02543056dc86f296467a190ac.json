      "quantity": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "size": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "product_id",
      "title",
      "color",
      "size",
      "quantity",
      "image_url",
      "mockups"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_step": {
