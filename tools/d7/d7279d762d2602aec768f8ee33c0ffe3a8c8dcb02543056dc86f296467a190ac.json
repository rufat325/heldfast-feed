{
 "_meta": {
  "securitySchemes": [
   {
    "type": "noauth"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Turn a quote into an order. Needs quote_id, the full recipient address (it must match the quoted destination) and rights_attestation=true. contact_email is the payer's own email, never the gift recipient's. Returns order_id and payment.url: the order page where the person pays by card, Apple Pay or Google Pay. Nothing is printed until the payment is confirmed. Idempotent per quote_id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact_email": {
    "description": "Email of the payer, for the order confirmation and the payment receipt. Not the recipient's email: for a gift, the recipient must not see the price. Optional.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "gift_message": {
    "description": "Short message for the packing slip of a gift. Not printed yet: the answer says so.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "orders": {
    "description": "Many parcels with one payment: one quote_id and one recipient per parcel. Not live yet: call purchase once per quote_id for now.",
    "items": {
     "properties": {
      "quote_id": {
       "description": "quote_id returned by quote.",
       "type": "string"
      },
      "recipient": {
       "description": "Shipping address. Country, state and postal code must match the quote destination. Send the full address when you have it. If you cannot collect the street address, send only country_code, postal_code (and state_code for US, CA and AU): the person then enters the address on the order page before paying.",
       "properties": {
        "address1": {
         "description": "Street and house number.",
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "address2": {
         "description": "Apartment, floor, etc.",
         "maxLength": 100,
         "type": "string"
        },
        "city": {
         "maxLength": 60,
         "minLength": 1,
         "type": "string"
        },
        "company": {
         "maxLength": 100,
         "type": "string"
        },
        "country_code": {
         "description": "ISO 3166-1 alpha-2 country code, e.g. CZ, DE, US.",
         "maxLength": 2,
         "minLength": 2,
         "type": "string"
        },
        "email": {
         "description": "Recipient email, for carrier delivery notices only. Never used for receipts. For a gift, leave it empty unless the recipient agrees.",
         "format": "email",
         "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
         "type": "string"
        },
        "name": {
         "description": "Full name of the recipient.",
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "phone": {
         "maxLength": 30,
         "type": "string"
        },
        "postal_code": {
         "maxLength": 20,
         "minLength": 1,
         "type": "string"
        },
        "state_code": {
         "description": "State or province code. Required for US, CA and AU.",
         "maxLength": 10,
         "type": "string"
        }
       },
       "required": [
        "name",
        "address1",
        "city",
        "postal_code",
        "country_code"
       ],
       "type": "object"
      }
     },
     "required": [
      "quote_id",
      "recipient"
     ],
     "type": "object"
    },
    "maxItems": 50,
    "minItems": 2,
    "type": "array"
   },
   "payment_capabilities": {
    "default": [
     "hosted_checkout"
    ],
    "description": "Payment methods the calling agent can use. \"hosted_checkout\" = a link that the person opens to pay by card, Apple Pay or Google Pay. Always supported.",
    "items": {
     "enum": [
      "hosted_checkout",
      "x402",
      "mpp"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "quote_id": {
    "description": "quote_id returned by quote, for one parcel. Set quote_id or orders, not both.",
    "type": "string"
   },
   "recipient": {
    "description": "Shipping address. Country, state and postal code must match the quote destination. Send the full address when you have it. If you cannot collect the street address, send only country_code, postal_code (and state_code for US, CA and AU): the person then enters the address on the order page before paying. Required with quote_id.",
    "properties": {
     "address1": {
      "description": "Street and house number.",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "address2": {
      "description": "Apartment, floor, etc.",
      "maxLength": 100,
      "type": "string"
     },
     "city": {
      "maxLength": 60,
      "minLength": 1,
      "type": "string"
     },
     "company": {
      "maxLength": 100,
      "type": "string"
     },
     "country_code": {
      "description": "ISO 3166-1 alpha-2 country code, e.g. CZ, DE, US.",
      "maxLength": 2,
      "minLength": 2,
      "type": "string"
     },
     "email": {
      "description": "Recipient email, for carrier delivery notices only. Never used for receipts. For a gift, leave it empty unless the recipient agrees.",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     },
     "name": {
      "description": "Full name of the recipient.",
      "maxLength": 100,
      "minLength": 1,
      "type": "string"
     },
     "phone": {
      "maxLength": 30,
      "type": "string"
     },
     "postal_code": {
      "maxLength": 20,
      "minLength": 1,
      "type": "string"
     },
     "state_code": {
      "description": "State or province code. Required for US, CA and AU.",
      "maxLength": 10,
      "type": "string"
     }
    },
    "required": [
     "postal_code",
     "country_code"
    ],
    "type": "object"
   },
   "rights_attestation": {
    "const": true,
    "description": "Must be true: confirms the customer owns or is licensed to print all submitted artwork, and that it is not prohibited content.",
    "type": "boolean"
   }
  },
  "required": [
   "rights_attestation"
  ],
  "type": "object"
 },
 "name": "purchase",
