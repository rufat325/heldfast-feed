{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "tail.post"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Send version bsd-agent-tail-v1. Preview a draft from either an owned saved Grade report (reportId, text, showStake, placement) or saved Doctor exchange (source doctor_exchange, threadId, messageId, text) through the app service. Publish only after showing the exact preview and getting the customer\u2019s confirmation. For action publish reuse the same draft and previewBinding, pass confirmation PUBLISH_POST, placementConfirmation, fWarning and a stable commandKey. Publishing enters the app moderation queue; it is not a wager.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "preview",
     "publish"
    ],
    "type": "string"
   },
   "commandKey": {
    "maxLength": 120,
    "minLength": 16,
    "type": "string"
   },
   "confirmation": {
    "const": "PUBLISH_POST",
    "type": "string"
   },
   "draft": {
    "additionalProperties": false,
    "description": "The exact app post draft: either a saved Grade report or a saved Doctor exchange.",
    "properties": {
     "messageId": {
      "description": "Saved Doctor reply in that thread.",
      "format": "uuid",
      "type": "string"
     },
     "placement": {
      "description": "Ticket post only.",
      "enum": [
       "asking",
       "self_reported_placed"
      ],
      "type": "string"
     },
     "pollOptions": {
      "items": {
       "maxLength": 50,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 4,
      "minItems": 2,
      "type": "array"
     },
     "reportId": {
      "description": "Owned saved Grade job ID for a ticket post.",
      "format": "uuid",
      "type": "string"
     },
     "showStake": {
      "description": "Ticket post only.",
      "type": "boolean"
     },
     "source": {
      "const": "doctor_exchange",
      "type": "string"
     },
     "text": {
      "maxLength": 280,
      "type": "string"
     },
     "threadId": {
      "description": "Owned Doctor thread for an exchange post.",
      "format": "uuid",
      "type": "string"
     }
    },
    "required": [
     "text"
    ],
    "type": "object"
   },
   "fWarning": {
    "enum": [
     "acknowledge",
     "dont_ask_again",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "placementConfirmation": {
    "enum": [
     "NOT_PLACED",
     "SELF_REPORTED_PLACED"
    ],
    "type": "string"
   },
   "previewBinding": {
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "version": {
    "const": "bsd-agent-tail-v1",
    "type": "string"
   }
  },
  "required": [
   "version",
   "action",
   "draft"
  ],
  "type": "object"
 },
 "name": "tail_post",
 "securitySchemes": [
  {
   "scopes": [
    "tail.post"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Preview or publish to Tail"
}
