{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the Shield policy revision, CRS exclusions and the last 24 hours of WAF audit findings for one app: requests that would have been blocked, blocked requests and the top five static CRS rules. No visitor identity. Requires read scope.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_get_shield",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "shield": {
      "additionalProperties": false,
      "properties": {
       "audit_review": {
        "additionalProperties": false,
        "properties": {
         "blocked_requests": {
          "minimum": 0,
          "type": "integer"
         },
         "note": {
          "type": "string"
         },
         "top_rules": {
          "items": {
           "properties": {
            "category": {
             "type": "string"
            },
            "description": {
             "type": "string"
            },
            "matches": {
             "type": "integer"
            },
            "rule_id": {
             "type": "integer"
            }
           },
           "required": [
            "rule_id",
            "category",
            "description",
            "matches"
           ],
           "type": "object"
          },
          "type": "array"
         },
         "window_hours": {
          "type": "integer"
         },
         "would_block_requests": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "window_hours",
         "would_block_requests",
         "blocked_requests",
         "top_rules",
         "note"
        ],
        "type": "object"
       },
       "controls": {
        "additionalProperties": false,
        "properties": {
         "attack_expires_at": {
          "minimum": 0,
          "type": "integer"
         },
         "pow_difficulty": {
          "type": [
           "integer",
           "null"
          ]
         },
         "pow_paths": {
          "items": {
           "type": "string"
          },
          "type": "array"
         },
         "rate_limit_rpm": {
          "type": [
           "integer",
           "null"
          ]
         },
         "trusted_sources": {
          "items": {
           "type": "string"
          },
          "type": "array"
         }
        },
        "required": [
         "pow_paths",
         "rate_limit_rpm",
         "pow_difficulty",
         "trusted_sources",
         "attack_expires_at"
        ],
        "type": "object"
       },
       "controls_required_capability": {
        "type": "string"
       },
       "controls_supported": {
        "type": "boolean"
       },
       "deployment_id": {
        "type": "string"
       },
       "exclusions": {
        "items": {
         "properties": {
          "path_prefix": {
           "type": "string"
          },
          "rule_id": {
           "type": "integer"
          }
         },
         "required": [
          "rule_id"
         ],
         "type": "object"
        },
        "type": "array"
       },
       "minimum_agent_version": {
        "type": "string"
       },
       "mode": {
        "enum": [
         "audit",
         "enforce"
        ],
        "type": "string"
       },
       "policy_updated_at": {
        "type": [
         "string",
         "null"
        ]
       },
       "profile": {
        "enum": [
         "off",
         "standard",
         "hardened",
         "max"
        ],
        "type": "string"
       },
       "required_capability": {
        "type": "string"
       },
       "revision": {
        "minimum": 0,
        "type": "integer"
       },
       "under_attack": {
        "additionalProperties": false,
        "properties": {
         "active": {
          "type": "boolean"
         },
         "difficulty": {
          "type": "integer"
         },
         "expires_at": {
          "type": [
           "string",
           "null"
          ]
         },
         "remaining_seconds": {
          "minimum": 0,
          "type": "integer"
         }
        },
        "required": [
         "active",
         "expires_at",
         "remaining_seconds",
         "difficulty"
        ],
        "type": "object"
       },
       "v2_supported": {
        "type": "boolean"
       }
      },
      "required": [
       "deployment_id",
       "profile",
       "mode",
       "revision",
       "exclusions",
       "v2_supported",
       "controls",
       "controls_supported",
       "controls_required_capability",
       "under_attack",
       "required_capability",
       "minimum_agent_version",
       "audit_review",
       "policy_updated_at"
      ],
      "type": "object"
     }
    },
    "required": [
     "shield"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Review Impreza Shield audit findings"
}
