 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "locationId": {
    "description": "The location ID to create the custom value in",
    "type": "string"
   },
   "location_id": {
