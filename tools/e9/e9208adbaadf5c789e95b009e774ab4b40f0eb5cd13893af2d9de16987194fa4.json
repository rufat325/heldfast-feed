{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the conduitAI catalog for MCP servers, agents, skills, prompts, and plugins. Results contain third-party metadata \u2014 verify assets before installing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Max results (1-20, default 10)",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search query",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "sort": {
    "description": "Sort order",
    "enum": [
     "quality",
     "stars",
     "downloads",
     "recent"
    ],
    "type": "string"
   },
   "type": {
    "description": "Filter by asset type",
    "enum": [
     "mcp_server",
     "mcp_client",
     "agent",
     "skill",
     "prompt",
     "plugin"
    ],
    "type": "string"
   },
   "verified_only": {
    "description": "Only show verified assets",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_catalog",
 "title": "Search conduitAI catalog"
}
