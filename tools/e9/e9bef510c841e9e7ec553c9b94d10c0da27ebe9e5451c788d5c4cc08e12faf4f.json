{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List every DNS record on a zone managed by Infomaniak. Use the root domain (e.g. 'example.com'), not a subdomain.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "zone": {
    "description": "Zone (root domain), e.g. 'example.com'",
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "zone"
  ],
  "type": "object"
 },
 "name": "infomaniak_dns_list_records",
 "outputSchema": {
  "additionalProperties": false,
  "properties": {
   "count": {
    "type": "number"
   },
   "records": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "type": "number"
      },
      "source": {
       "type": "string"
      },
      "target": {
       "type": "string"
      },
      "ttl": {
       "minimum": 0,
       "type": "integer"
      },
      "type": {
       "enum": [
        "A",
        "AAAA",
        "CNAME",
        "MX",
        "TXT",
        "SRV",
        "NS",
        "CAA",
        "PTR",
        "SPF"
       ],
       "type": "string"
      },
      "updated_at": {
       "type": "number"
      }
     },
     "required": [
      "source",
      "type",
      "ttl",
      "target"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "zone": {
    "type": "string"
   }
  },
  "required": [
   "zone",
   "count",
   "records"
  ],
  "type": "object"
 }
}
