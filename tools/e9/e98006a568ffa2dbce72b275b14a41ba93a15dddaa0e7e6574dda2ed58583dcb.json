{
 "description": "Match a list of changed files against failing tests to determine which failures are directly caused by the code changes in this commit. Returns a correlation mapping.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "affectedTests": {
    "description": "Optional: test names already known to be affected (e.g. from ast-impact-mapper-mcp)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "changedFiles": {
    "description": "List of file paths changed in this commit/PR",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "failures": {
    "description": "Failures to correlate against",
    "items": {
     "properties": {
      "duration": {
       "type": "number"
      },
      "errorMessage": {
       "type": "string"
      },
      "filePath": {
       "type": "string"
      },
      "suiteName": {
       "type": "string"
      },
      "testName": {
       "type": "string"
      }
     },
     "required": [
      "testName",
      "suiteName",
      "errorMessage"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "changedFiles",
   "failures"
  ],
  "type": "object"
 },
 "name": "correlate_code_changes"
}
