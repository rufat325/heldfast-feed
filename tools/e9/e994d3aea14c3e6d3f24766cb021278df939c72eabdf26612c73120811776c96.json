{
 "_meta": {
  "category": "install",
  "tier": "none"
 },
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Doctor (health check)"
 },
 "description": "Run a startup health check on the Log10x MCP installation. Probes: environment configuration validity, prometheus.log10x.com reachability and auth, Reporter tier detection (Edge / Cloud / none), Retriever endpoint configuration (informational), Datadog destination credentials (informational), paste endpoint reachability, cross-pillar enrichment floor (v1.4, when LOG10X_CUSTOMER_METRICS_URL is set). Returns a markdown report with pass / warn / fail per check and remediation hints. Call this once at the start of a session to verify the install, or any time a tool returns an unexpected error and you want to isolate whether the problem is configuration or transient.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "environment": {
    "description": "Optional environment nickname to probe. In multi-env setups, omit to run the checks against ALL configured environments; pass a specific nickname to check only that one.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "log10x_doctor",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": true,
  "properties": {
   "actions": {
    "default": [],
    "items": {
     "additionalProperties": false,
     "properties": {
      "args": {
       "additionalProperties": {},
       "default": {},
       "type": "object"
      },
      "reason": {
       "type": "string"
      },
      "role": {
       "enum": [
        "required-next",
        "recommended-next",
        "optional-followup",
        "alternative"
       ],
       "type": "string"
      },
      "tool": {
       "type": "string"
      }
     },
     "required": [
      "tool",
      "reason"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "data": {},
   "generated_at": {
    "type": "string"
   },
   "images": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "alt": {
       "type": "string"
      },
      "data": {
       "type": "string"
      },
      "mimeType": {
       "default": "image/png",
       "enum": [
        "image/png",
        "image/jpeg",
        "image/gif",
        "image/webp"
       ],
       "type": "string"
      }
     },
     "required": [
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": "string"
   },
   "render_hint": {
    "additionalProperties": false,
    "properties": {
     "callouts": {
      "default": [],
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "chart": {
      "enum": [
       "sparkline",
       "timeseries",
       "bar",
       "none"
      ],
      "type": "string"
     },
     "units": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "schema_epoch": {
    "type": "string"
   },
   "schema_version": {
    "const": "1.0",
    "type": "string"
   },
   "summary": {
    "additionalProperties": false,
    "properties": {
     "bullets": {
      "items": {
       "type": "string"
      },
      "maxItems": 5,
      "type": "array"
     },
     "callout": {
      "type": "string"
     },
     "headline": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "headline"
    ],
    "type": "object"
   },
   "tool": {
