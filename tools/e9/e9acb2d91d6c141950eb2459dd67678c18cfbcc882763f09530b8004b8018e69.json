{
 "description": "Find dental practices near a UK postcode. Returns name, address, phone, rating, services, NHS status, and booking URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "default": 5,
    "description": "Max results to return (default 5, max 20)",
    "type": "number"
   },
   "nhs_only": {
    "description": "Only return practices accepting NHS patients",
    "type": "boolean"
   },
   "postcode": {
    "description": "UK postcode to search near (e.g. 'SW1A 1AA', 'M1 1AA')",
    "type": "string"
   },
   "treatment": {
    "description": "Filter by treatment/service (e.g. 'whitening', 'implants', 'invisalign')",
    "type": "string"
   }
  },
  "required": [
   "postcode"
  ],
  "type": "object"
 },
 "name": "search_practices"
}
