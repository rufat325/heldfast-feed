{
 "annotations": {
  "destructiveHint": true,
  "title": "Update a constituent"
 },
 "description": "WRITE: update fields on an existing constituent's profile (names, job, status, primary address/email/phone). Only the fields you supply are sent. Bloomerang: PUT /constituent/{id}.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "birthdate": {
    "description": "Birth date (YYYY-MM-DD).",
    "type": "string"
   },
   "constituent_id": {
    "description": "The API Id of the constituent (not the CRM AccountNumber).",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "employer": {
    "type": "string"
   },
   "envelope_name": {
    "type": "string"
   },
   "first_name": {
    "type": "string"
   },
   "formal_name": {
    "type": "string"
   },
   "full_name": {
    "description": "Organization name, or an explicit individual full name.",
    "type": "string"
   },
   "gender": {
    "enum": [
     "Male",
     "Female",
     "Other"
    ],
    "type": "string"
   },
   "informal_name": {
    "type": "string"
   },
   "job_title": {
    "type": "string"
   },
   "last_name": {
    "type": "string"
   },
   "middle_name": {
    "type": "string"
   },
   "prefix": {
    "description": "Must match a prefix configured in the CRM, e.g. Mr., Ms., Dr.",
    "type": "string"
   },
   "primary_address": {
    "description": "Primary postal address.",
    "properties": {
     "City": {
      "type": "string"
     },
     "Country": {
      "description": "Must match a country configured in the Bloomerang CRM.",
      "type": "string"
     },
     "PostalCode": {
      "type": "string"
     },
     "State": {
      "description": "Must match a state configured in the Bloomerang CRM.",
      "type": "string"
     },
     "Street": {
      "type": "string"
     },
     "Type": {
      "enum": [
       "Home",
       "Vacation",
       "Work"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "primary_email": {
    "description": "Primary email address.",
    "properties": {
     "Type": {
      "enum": [
       "Home",
       "Work"
      ],
      "type": "string"
     },
     "Value": {
      "description": "The email address.",
      "format": "email",
      "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
      "type": "string"
     }
    },
    "required": [
     "Value"
    ],
    "type": "object"
   },
   "primary_phone": {
    "description": "Primary phone.",
    "properties": {
     "Extension": {
      "type": "string"
     },
     "Number": {
      "description": "The phone number, formatting allowed, without the extension.",
      "type": "string"
     },
     "Type": {
      "enum": [
       "Home",
       "Work",
       "Mobile",
       "Fax"
      ],
      "type": "string"
     }
    },
    "required": [
     "Number"
    ],
    "type": "object"
   },
   "recognition_name": {
    "type": "string"
   },
   "status": {
    "description": "Constituent status.",
    "enum": [
     "Active",
     "Inactive",
     "Deceased"
    ],
    "type": "string"
   },
   "suffix": {
    "description": "Must match a suffix configured in the CRM.",
    "type": "string"
   },
   "website": {
    "type": "string"
   }
  },
  "required": [
   "constituent_id"
  ],
  "type": "object"
 },
 "name": "bloomerang_update_constituent",
 "title": "Update a constituent"
}
