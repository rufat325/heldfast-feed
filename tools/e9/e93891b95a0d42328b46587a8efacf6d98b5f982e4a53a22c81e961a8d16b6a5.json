{
 "description": "Generate a QR code PNG from text or a URL.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "outputPath": {
    "description": "Where to write the result. Defaults to a temp file; the path is returned.",
    "type": "string"
   },
   "size": {
    "default": 512,
    "maximum": 2048,
    "minimum": 64,
    "type": "integer"
   },
   "text": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "qr_generate"
}
