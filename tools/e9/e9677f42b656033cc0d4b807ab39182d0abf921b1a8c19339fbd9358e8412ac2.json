{
 "_meta": {
  "openai/toolInvocation/invoked": "Forms configuration retrieved",
  "openai/toolInvocation/invoking": "Fetching forms configuration"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read the form-to-email relay config of a site, plus the resolved delivery mode, the active From address, and (for a custom sender domain) the DNS records to publish and their verification status. The submission format for the site's form is described under set_forms_config.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "siteName": {
    "description": "The site whose forms-relay config to read.",
    "type": "string"
   }
  },
  "required": [
   "siteName"
  ],
  "type": "object"
 },
 "name": "get_forms_config",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "activeSender": {
    "description": "The From that will actually be used right now.",
    "type": "string"
   },
   "delivery": {
    "description": "platform | verified-domain | verified-domain-pending | custom-relay.",
    "type": "string"
   },
   "enabled": {
    "type": "boolean"
   },
   "endpoint": {
    "description": "URL the site's form should POST to.",
    "type": "string"
   },
   "formsConfig": {
    "anyOf": [
     {
      "additionalProperties": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "description": "Stored config (smtpRelay.password redacted to hasPassword)."
   },
   "notes": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "senderDomain": {
    "additionalProperties": {},
    "description": "DNS records to publish + verification status (verified-domain path).",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "siteName": {
    "type": "string"
   }
  },
  "required": [
   "siteName",
   "enabled",
   "endpoint",
   "delivery",
   "activeSender",
   "formsConfig",
   "notes"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "sites:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Get forms-relay config for a site"
}
