{
 "description": "Create a purchasable product for a Neblla app. type must be \"one_time\" (single purchase, fixed price) or \"consumable\" (quantity selector, price per unit). name should be a multi-language object e.g. { en: \"Gold Coins\", es: \"Monedas de Oro\" }. price (one_time) and pricePerUnit (consumable) are in cents (e.g. 499 = $4.99).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "appId": {
    "description": "The app public ID",
    "type": "string"
   },
   "currency": {
    "description": "ISO 4217 code, e.g. \"eur\" (default usd)",
    "pattern": "^[a-zA-Z]{3}$",
    "type": "string"
   },
   "defaultLang": {
    "enum": [
     "en",
     "es",
     "fr",
     "de",
     "it",
     "pt",
     "ja",
     "ko",
     "zh",
     "ar"
    ],
    "type": "string"
   },
   "description": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Description, string or per-language object"
   },
   "image": {
    "description": "Product image URL",
    "type": "string"
   },
   "max": {
    "description": "Maximum quantity for consumable",
    "type": "number"
   },
   "min": {
    "description": "Minimum quantity for consumable",
    "type": "number"
   },
   "name": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     }
    ],
    "description": "Product name, string or { en: \"...\", es: \"...\" }"
   },
   "price": {
    "description": "Price in cents \u2014 required for one_time",
    "type": "number"
   },
   "pricePerUnit": {
    "description": "Price per unit in cents \u2014 required for consumable",
    "type": "number"
   },
   "published": {
    "description": "Buyable right away (default true; forced false until Stripe Connect is active)",
    "type": "boolean"
   },
   "step": {
    "description": "Quantity step for consumable selector",
    "type": "number"
   },
   "type": {
    "enum": [
     "one_time",
     "consumable"
    ],
    "type": "string"
   }
  },
  "required": [
   "appId",
   "name",
   "type"
  ],
  "type": "object"
 },
 "name": "neblla_create_product"
}
