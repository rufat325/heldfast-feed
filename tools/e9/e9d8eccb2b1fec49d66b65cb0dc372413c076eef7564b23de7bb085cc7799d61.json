{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":false,"title":"Update customer"},"description":"Update an existing customer's name, email, city, region, country, or status. The only supported status value is 'archived'; setting it here is the same operation as ls_archive_customer and is treated as destructive (rate-limited and audited). Other field edits are not.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"city":{"description":"New city","maxLength":10000,"type":"string"},"country":{"description":"New country (ISO 3166-1 alpha-2 code)","maxLength":10000,"type":"string"},"customerId":{"description":"The customer ID to update","maxLength":10000,"pattern":"^[1-9]\\d*$","type":"string"},"email":{"description":"New email","format":"email","maxLength":320,"pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"name":{"description":"New name","maxLength":10000,"type":"string"},"region":{"description":"New region/state","maxLength":10000,"type":"string"},"status":{"const":"archived","description":"Set to 'archived' to archive the customer. Equivalent to calling ls_archive_customer.","type":"string"}},"required":["customerId"],"type":"object"},"name":"ls_update_customer"}
