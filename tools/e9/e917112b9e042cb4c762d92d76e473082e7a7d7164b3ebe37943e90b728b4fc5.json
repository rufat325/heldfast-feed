{"annotations":{"destructiveHint":false,"openWorldHint":true,"readOnlyHint":false,"title":"Create track output"},"description":"Append a track-specific transcode or preview output to an already-processed track and queue processing (POST /v1/track/:track_id/output). Prefer output_type_id \"transcode\" or \"preview\" (variant_type_id is accepted as a legacy alias). Call adn_list_output_presets first so the new index does not collide. The track returns to processing until the new file is ready. Requires AudioDN OAuth sign-in (call adn_sign_in or complete account login first).","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"bitrate":{"maximum":320,"minimum":12,"type":"integer"},"codec":{"enum":["aac","mp3","ogg","opus"],"type":"string"},"index":{"maxLength":64,"minLength":2,"type":"string"},"is_required":{"type":"boolean"},"is_stereo":{"type":"boolean"},"is_strip_cover":{"type":"boolean"},"is_strip_tags":{"type":"boolean"},"notes":{"type":"string"},"output_type_id":{"enum":["transcode","preview"],"type":"string"},"preview_max_percent":{"type":"number"},"preview_max_seconds":{"type":"number"},"preview_min_percent":{"type":"number"},"preview_min_seconds":{"type":"number"},"preview_percent":{"type":"number"},"preview_seconds":{"type":"number"},"preview_start_percent":{"maximum":100,"minimum":0,"type":"number"},"preview_type":{"enum":["seconds","percent"],"type":"string"},"track_id":{"format":"uuid","type":"string"},"variant_type_id":{"enum":["transcode","preview"],"type":"string"}},"required":["track_id","index"],"type":"object"},"name":"adn_create_track_output"}
