{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Decision Commit"
 },
 "description": "Commit or confirm the rationale for a draft or extracted decision.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Decision node id to commit.",
    "minLength": 1,
    "type": "string"
   },
   "rationale": {
    "description": "Confirmed rationale for the decision.",
    "minLength": 1,
    "type": "string"
   },
   "similarity_threshold": {
    "description": "Similarity threshold from 0 to 1. Overrides RAVEN_DECISION_SIMILARITY_THRESHOLD for this commit.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "id",
   "rationale"
  ],
  "type": "object"
 },
 "name": "decision_commit"
}
