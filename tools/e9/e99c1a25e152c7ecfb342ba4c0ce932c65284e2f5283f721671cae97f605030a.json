{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "account:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Ask Otto"
 },
 "description": "Ask Otto, Applystead's job search coach, a question about the member's search, an application or a company.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "application_id": {
    "description": "An application's id from get_applications.",
    "pattern": "^[a-f0-9]{64}$",
    "type": "string"
   },
   "company_slug": {
    "description": "A company's slug, e.g. from get_jobs.",
    "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
    "type": "string"
   },
   "mode": {
    "description": "How Otto answers (default ask): ask a question, coach (a coaching session on a topic) or plan (a 30-day job search plan).",
    "enum": [
     "ask",
     "coach",
     "plan"
    ],
    "type": "string"
   },
   "question": {
    "description": "The question.",
    "maxLength": 4000,
    "minLength": 1,
    "type": "string"
   },
   "topic": {
    "description": "With mode coach only, and required there.",
    "enum": [
     "stalled_search",
     "career_change",
     "interview_prep"
    ],
    "type": "string"
   }
  },
  "required": [
   "question"
  ],
  "type": "object"
 },
 "name": "ask_otto",
 "securitySchemes": [
  {
   "scopes": [
    "account:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Ask Otto"
}
