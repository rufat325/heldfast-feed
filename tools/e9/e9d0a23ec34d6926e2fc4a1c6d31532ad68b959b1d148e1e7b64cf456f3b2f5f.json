{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Change the server spec (CPU/Memory) of a Cloud DB for MySQL instance",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudMysqlInstanceNo": {
    "description": "Cloud MySQL instance number (getCloudMysqlInstanceList)",
    "type": "string"
   },
   "cloudMysqlProductCode": {
    "description": "New MySQL server product (spec) code (getCloudMysqlProductList)",
    "type": "string"
   },
   "isRolling": {
    "description": "Rolling upgrade (default: false). true: sequential upgrade with minimal downtime (G3 only). false: all servers stop simultaneously.",
    "type": "boolean"
   },
   "regionCode": {
    "description": "Region code (default: first region)",
    "type": "string"
   }
  },
  "required": [
   "cloudMysqlInstanceNo",
   "cloudMysqlProductCode"
  ],
  "type": "object"
 },
 "name": "ncloud_change_mysql_spec"
}
