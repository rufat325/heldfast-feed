{
 "_meta": {
  "ui": {
   "resourceUri": "ui://maplibre/show-map.html"
  },
  "ui/resourceUri": "ui://maplibre/show-map.html"
 },
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Shows the user an interactive MapLibre map in the chat, with GeoJSON layers and markers on an OpenFreeMap basemap. The user sees the map and you do not; to look at a map yourself, use render_style. Without center and zoom, the map fits the layers and markers. Needs a client that supports MCP Apps.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "basemap": {
    "default": "liberty",
    "description": "The OpenFreeMap style to draw on.",
    "enum": [
     "liberty",
     "bright",
     "positron",
     "dark",
     "fiord"
    ],
    "type": "string"
   },
   "bearing": {
    "type": "number"
   },
   "center": {
    "description": "[longitude, latitude] of the map center.",
    "items": {
     "type": "number"
    },
    "maxItems": 2,
    "minItems": 2,
    "type": "array"
   },
   "layers": {
    "default": [],
    "items": {
     "properties": {
      "data": {
       "additionalProperties": {},
       "description": "A GeoJSON FeatureCollection, Feature or geometry.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "layout": {
       "additionalProperties": {},
       "description": "Layout properties for the layer type.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "paint": {
       "additionalProperties": {},
       "description": "Paint properties for the layer type, like {\"fill-color\": \"#d33\"}.",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": {
       "enum": [
        "fill",
        "line",
        "circle",
        "symbol",
        "fill-extrusion",
        "heatmap"
       ],
       "type": "string"
      }
     },
     "required": [
      "type",
      "data"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "markers": {
    "default": [],
    "items": {
     "properties": {
      "color": {
       "type": "string"
      },
      "label": {
       "description": "Shown in a popup when the user clicks the marker.",
       "type": "string"
      },
      "position": {
       "description": "[longitude, latitude]",
       "items": {
        "type": "number"
       },
       "maxItems": 2,
       "minItems": 2,
       "type": "array"
      }
     },
     "required": [
      "position"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pitch": {
    "maximum": 85,
    "minimum": 0,
    "type": "number"
   },
   "zoom": {
    "maximum": 22,
    "minimum": 0,
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "show_map",
 "title": "Show map"
}
