{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Find columns by name or description text across libraries. Matches COLUMN_NAME, SYSTEM_COLUMN_NAME, and COLUMN_TEXT. Use * as a wildcard. When a schema allowlist is configured, only those libraries are searched. Otherwise system libraries (Q* and SYS*) are skipped unless include_system is true.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "filter": {
    "description": "Name or text to match. Use * as a wildcard. Example: \"ITEM*\" matches columns starting with ITEM",
    "type": "string"
   },
   "include_system": {
    "description": "Include Q* and SYS* libraries. Ignored when a schema or a schema allowlist is set.",
    "type": "boolean"
   },
   "limit": {
    "description": "Maximum rows to return. Capped by QUERY_MAX_LIMIT.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "schema": {
    "description": "Limit the search to one library. Must be in the schema allowlist when one is configured.",
    "type": "string"
   }
  },
  "required": [
   "filter"
  ],
  "type": "object"
 },
 "name": "search_columns",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "count": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "data": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "business_description": {
       "type": "string"
      },
      "column_name": {
       "type": "string"
      },
      "column_text": {
       "type": [
        "string",
        "null"
       ]
      },
      "data_type": {
       "type": "string"
      },
      "length": {
       "type": [
        "number",
        "null"
       ]
      },
      "numeric_scale": {
       "type": [
        "number",
        "null"
       ]
      },
      "schema_name": {
       "type": "string"
      },
      "system_column_name": {
       "type": "string"
      },
      "table_name": {
       "type": "string"
      }
     },
     "required": [
      "schema_name",
      "table_name",
      "column_name",
      "system_column_name",
      "data_type",
      "length",
      "numeric_scale",
      "column_text"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "error": {
    "type": "string"
   },
   "success": {
    "type": "boolean"
   },
   "truncated": {
    "type": "boolean"
   }
  },
  "required": [
   "success"
  ],
  "type": "object"
 },
 "title": "Search Columns"
}
