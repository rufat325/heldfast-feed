{
 "description": "Launch a new token on Base (gasless). The platform pays gas via paymaster. Returns tokenAddress + txHash. Requires THRYX_API_KEY. Image required (public URL or data: URL).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "article": {
    "description": "Optional long-form article body, max ~10K chars.",
    "type": "string"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "image": {
    "description": "Image URL (https:// public URL) or data: URL. PNG/JPEG/GIF/WebP, under 400KB.",
    "type": "string"
   },
   "name": {
    "description": "Display name, e.g. \"My Agent Coin\".",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "symbol": {
    "description": "Ticker, 1\u201312 chars, will be uppercased.",
    "maxLength": 12,
    "minLength": 1,
    "type": "string"
   },
   "telegram": {
    "format": "uri",
    "type": "string"
   },
   "twitter": {
    "format": "uri",
    "type": "string"
   },
   "website": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "name",
   "symbol",
   "image"
  ],
  "type": "object"
 },
 "name": "thryx_launch"
}
