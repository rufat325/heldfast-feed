{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Resolve a place"
 },
 "description": "Resolve a Croatian place name (any grammatical case, e.g. \"Zadru\", \"Dugom Selu\", \"otok Krk\") to coordinates, kind and county; or coordinates (lat, lon) to the nearest town. Use when the user names a place and you need coordinates, or to tell a user where coordinates are.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "lat": {
    "description": "Or a point: latitude\u2026",
    "type": "number"
   },
   "lon": {
    "description": "\u2026and longitude.",
    "type": "number"
   },
   "name": {
    "description": "The place's name in any grammatical case.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "resolve_place",
 "outputSchema": {
  "properties": {
   "data": {
    "properties": {
     "county": {
      "type": "string"
     },
     "kind": {
      "type": "string"
     },
     "latitude": {
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
      "type": [
       "string",
       "number"
      ]
     },
     "longitude": {
      "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?(?:[eE][+-]?\\d+)?$",
      "type": [
       "string",
       "number"
      ]
     },
     "name": {
      "type": "string"
     },
     "population": {
      "pattern": "^-?(?:0|[1-9]\\d*)$",
      "type": [
       "string",
       "integer"
      ]
     }
    },
    "required": [
     "name",
     "kind",
     "county",
     "latitude",
     "longitude",
     "population"
    ],
    "type": "object"
   },
   "meta": {
    "description": "count, plan, include_filler, the limits applied (e.g. radius_limited_to), and for a nearby search its center.",
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "title": "Resolve a place"
}
