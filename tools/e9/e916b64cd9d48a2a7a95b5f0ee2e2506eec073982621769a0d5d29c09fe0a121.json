{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Read a published material by numeric id or slug, in any site language. Returns Markdown, source URL and per-field translation language. Restricted text is a teaser; unrevealed answers are hidden.",
 "inputSchema": {
  "additionalProperties": false,
  "anyOf": [
   {
    "required": [
     "id"
    ]
   },
   {
    "required": [
     "slug"
    ]
   }
  ],
  "properties": {
   "id": {
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "kind": {
    "enum": [
     "razdel",
     "section",
     "article",
     "digest",
     "question",
     "post"
    ],
    "type": "string"
   },
   "lang": {
    "default": "ru",
    "description": "Language of content and source URLs. Missing fields fall back to Russian with explicit field_languages.",
    "enum": [
     "ru",
     "en",
     "de",
     "zh-hans",
     "es",
     "tr"
    ],
    "type": "string"
   },
   "root": {
    "description": "Root section slug from list_sections.",
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [],
  "type": "object"
 },
 "name": "get_document"
}
