{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Change a set in place: retitle it, retag it, or add cards. Pass addCards to append (the usual case after reviewing results) or cards to replace the list wholesale \u2014 never both. Replacing the cards resets what the learner has already studied.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addCards": {
    "description": "Append cards to the existing list. Cannot be combined with cards",
    "items": {
     "description": "One flashcard",
     "properties": {
      "definition": {
       "description": "Translation or definition, in the learner's own language",
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "example": {
       "description": "A short sentence showing the term in use",
       "maxLength": 1000,
       "type": "string"
      },
      "imageUrl": {
       "description": "Optional illustration URL",
       "maxLength": 1000,
       "type": "string"
      },
      "term": {
       "description": "The word or phrase in the language being learned",
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "term",
      "definition"
     ],
     "type": "object"
    },
    "maxItems": 300,
    "type": "array"
   },
   "cards": {
    "description": "Replace the whole card list. Cannot be combined with addCards",
    "items": {
     "description": "One flashcard",
     "properties": {
      "definition": {
       "description": "Translation or definition, in the learner's own language",
       "maxLength": 1000,
       "minLength": 1,
       "type": "string"
      },
      "example": {
       "description": "A short sentence showing the term in use",
       "maxLength": 1000,
       "type": "string"
      },
      "imageUrl": {
       "description": "Optional illustration URL",
       "maxLength": 1000,
       "type": "string"
      },
      "term": {
       "description": "The word or phrase in the language being learned",
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "term",
      "definition"
     ],
     "type": "object"
    },
    "maxItems": 300,
    "type": "array"
   },
   "description": {
    "maxLength": 2000,
    "type": "string"
   },
   "notes": {
    "maxLength": 4000,
    "type": "string"
   },
   "setId": {
    "description": "Set id returned by create_study_set or list_study_sets",
    "minLength": 1,
    "type": "string"
   },
   "title": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "topic": {
    "maxLength": 500,
    "type": "string"
   },
   "visibility": {
    "enum": [
     "private",
     "public"
    ],
    "type": "string"
   }
  },
  "required": [
   "setId"
  ],
  "type": "object"
 },
 "name": "update_study_set",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cardCount": {
    "type": "number"
   },
   "setId": {
    "type": "string"
   },
   "updated": {
    "description": "Which fields changed, e.g. ['title', 'addCards']",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "setId",
   "cardCount",
   "updated"
  ],
  "type": "object"
 },
 "title": "Update a study set"
}
