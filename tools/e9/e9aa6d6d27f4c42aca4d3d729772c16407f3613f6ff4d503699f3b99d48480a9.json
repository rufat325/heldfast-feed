{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"1\uc8fc \uc8fc\ud734\uc218\ub2f9\uacfc \ud55c \ub2ec \ud3c9\uade0\uc744 \uacc4\uc0b0\ud55c\ub2e4(\uc0ac\uc774\ud2b8 /tools/weekly-holiday-pay \uc640 \uac19\uc740 \uc5d4\uc9c4). \uc8fc\ud734\uc218\ub2f9 = \uc2dc\uae09 \u00d7 1\uc77c \uc18c\uc815\uadfc\ub85c\uc2dc\uac04, 1\uc77c \uc18c\uc815\uadfc\ub85c\uc2dc\uac04 = 1\uc8fc \uc18c\uc815\uadfc\ub85c\uc2dc\uac04 \u00f7 \ud1b5\uc0c1\uadfc\ub85c\uc790 1\uc8fc \uc18c\uc815\uadfc\ub85c\uc77c \uc218(\ubcf4\ud1b5 5\uc77c, 8\uc2dc\uac04\uae4c\uc9c0). \uc8fc 15\uc2dc\uac04 \ubbf8\ub9cc\uc774\uba74 \uc5c6\uace0, \uadf8 \uc8fc \uc18c\uc815\uadfc\ub85c\uc77c\uc744 \uac1c\uadfc\ud574\uc57c \uc0dd\uae34\ub2e4.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"fullAttendance":{"description":"\uadf8 \uc8fc \uc18c\uc815\uadfc\ub85c\uc77c\uc744 \ubaa8\ub450 \ub098\uc654\ub098(\uae30\ubcf8 true)","type":"boolean"},"fullTimeDays":{"description":"\uac19\uc740 \uc77c\uc744 \ud558\ub294 \ud1b5\uc0c1\uadfc\ub85c\uc790\uc758 1\uc8fc \uc18c\uc815\uadfc\ub85c\uc77c \uc218(\uae30\ubcf8 5)","type":"integer"},"hourlyWage":{"description":"\uc2dc\uae09(\uc6d0)","type":"number"},"weeklyHours":{"description":"1\uc8fc \uc18c\uc815\uadfc\ub85c\uc2dc\uac04(4\uc8fc \ud3c9\uade0, \uc5f0\uc7a5\uadfc\ub85c \uc81c\uc678)","type":"number"}},"required":["hourlyWage","weeklyHours"],"type":"object"},"name":"calc_weekly_holiday_pay","title":"\uc8fc\ud734\uc218\ub2f9 \uacc4\uc0b0"}
