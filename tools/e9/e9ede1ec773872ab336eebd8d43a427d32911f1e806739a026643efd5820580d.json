{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create an automation"
 },
 "description": "Creates an automation: on an event (a workflow or crawl completed, a monitor change, a webhook, a schedule) it runs a workflow, sends a notification templated over the event's data, and/or wakes an AI agent. Event, template and webhook options: writ_help('writ_create_automation').",
 "inputSchema": {
  "properties": {
   "ai_prompt": {
    "description": "Wake an AI agent with this task.",
    "type": "string"
   },
   "channels": {
    "description": "Notification channels.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "type": "string"
   },
   "notify": {
    "description": "Message template, e.g. {{result.extracted_data.0.title}}.",
    "type": "string"
   },
   "on_workflow": {
    "description": "Source workflow for workflow_* events.",
    "type": "string"
   },
   "run_workflow": {
    "description": "Workflow to run.",
    "type": "string"
   },
   "schedule": {
    "description": "when='scheduled': {kind, interval_minutes | time, days, tz}.",
    "type": "object"
   },
   "target_id": {
    "description": "change_detected: the monitor_id.",
    "type": "integer"
   },
   "when": {
    "description": "workflow_completed | crawl_completed | change_detected | webhook_received | scheduled | ...",
    "enum": [
     "workflow_completed",
     "workflow_started",
     "crawl_completed",
     "crawl_failed",
     "ai_session_completed",
     "ai_session_started",
     "change_detected",
     "webhook_received",
     "scheduled"
    ],
    "type": "string"
   }
  },
  "required": [
   "name"
  ],
  "type": "object"
 },
 "name": "writ_create_automation",
 "securitySchemes": [
  {
   "scopes": [
    "mcp:read",
    "mcp:execute",
    "workflows:read",
    "workflows:write",
    "workflows:execute",
    "runs:read",
    "datasets:read",
    "crawl:read",
    "crawl:execute",
    "scrape:execute",
    "personas:read",
    "personas:write",
    "devices:read",
    "devices:write",
    "monitors:read",
    "monitors:write",
    "triggers:read",
    "triggers:write",
    "marketplace:read"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Create an automation"
}
