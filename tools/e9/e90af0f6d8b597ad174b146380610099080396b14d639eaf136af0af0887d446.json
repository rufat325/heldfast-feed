{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Demangle an ordered bounded batch of Swift symbols without requiring Hopper. Each input returns demangled, unchanged, or invalid status.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "examples": [
   {
    "symbols": [
     "$s4Test3fooyyF"
    ]
   }
  ],
  "properties": {
   "symbols": {
    "description": "Ordered bounded Swift symbols to demangle.",
    "items": {
     "maxLength": 4096,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "symbols"
  ],
  "type": "object"
 },
 "name": "demangle_swift",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "evidence_id": {
    "pattern": "^ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "evidence_uri": {
    "pattern": "^rea:\\/\\/evidence\\/ev_[a-f0-9]{64}$",
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "limitations": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "provenance": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "command": {
         "items": {
          "type": "string"
         },
         "type": "array"
        },
        "executable_sha256": {
         "pattern": "^[a-f0-9]{64}$",
         "type": "string"
        },
        "exit": {
         "additionalProperties": false,
         "properties": {
          "code": {
           "anyOf": [
            {
             "maximum": 9007199254740991,
             "minimum": -9007199254740991,
             "type": "integer"
            },
            {
             "type": "null"
            }
           ]
          },
          "signal": {
           "anyOf": [
            {
             "type": "string"
            },
            {
             "type": "null"
            }
           ]
          }
         },
         "required": [
          "code",
          "signal"
         ],
         "type": "object"
        },
        "stderr_bytes": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "stderr_truncated": {
         "type": "boolean"
        },
        "stdout_bytes": {
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "stdout_truncated": {
         "type": "boolean"
        },
        "tool": {
         "minLength": 1,
         "type": "string"
        },
        "tool_version": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "version_reason": {
         "anyOf": [
          {
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "tool",
        "command",
        "tool_version",
        "version_reason",
        "executable_sha256",
        "exit",
        "stdout_bytes",
        "stderr_bytes",
        "stdout_truncated",
        "stderr_truncated"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "symbols": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "input": {
         "type": "string"
        },
        "output": {
         "type": "string"
        },
        "status": {
         "enum": [
          "demangled",
          "unchanged",
          "invalid"
         ],
         "type": "string"
        }
       },
       "required": [
        "input",
        "output",
        "status"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "required": [
     "symbols",
     "provenance",
     "limitations"
    ],
    "type": "object"
   }
  },
  "required": [
   "result",
   "evidence_id",
   "evidence_uri"
  ],
  "type": "object"
 },
 "title": "Demangle Swift"
}
