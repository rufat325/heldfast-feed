{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Returns the exact lease text for one name and term, its version and sha256, and the never-sell guarantee in one sentence; call it before the human rents, so they read what they sign.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "host": {
    "description": "The domain name as the user gave it: a URL or a bare host both work.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "term_months": {
    "default": 12,
    "description": "The term: 12, 6 or 1 month. The 12 month rate is the listed rate; shorter terms cost more per month.",
    "enum": [
     12,
     6,
     1
    ],
    "type": "number"
   }
  },
  "required": [
   "host"
  ],
  "type": "object"
 },
 "name": "get_lease_terms",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "host": {
    "type": "string"
   },
   "monthly": {
    "type": [
     "string",
     "null"
    ]
   },
   "monthly_cents": {
    "anyOf": [
     {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ]
   },
   "never_sell": {
    "type": "string"
   },
   "next_step": {
    "type": "string"
   },
   "status": {
    "enum": [
     "listed",
     "rented",
     "not_listed"
    ],
    "type": "string"
   },
   "term_months": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "terms_sha256": {
    "type": [
     "string",
     "null"
    ]
   },
   "terms_text": {
    "type": [
     "string",
     "null"
    ]
   },
   "terms_version": {
    "type": "string"
   }
  },
  "required": [
   "host",
   "status",
   "term_months",
   "monthly_cents",
   "monthly",
   "terms_version",
   "terms_sha256",
   "never_sell",
   "terms_text",
   "next_step"
  ],
  "type": "object"
 },
 "title": "Get the lease terms"
}
