 "description": "Compare keys across locales, separating the three states a single completeness figure hides. An absent key shows the base string, the key itself or nothing, depending on the loader. An empty value satisfies a completeness count and renders nothing, which is how a blank interface passes a translation report. A value identical to the base is either untranslated or a loan word, and nothing says which, so the ambiguity is stated. Also reports a key no base locale defines. Pay 180000 atomic USDC on Base via exact x402. MCP does not pay; it provides a challenge handoff.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "locales": {
    "description": "The locale files to compare. One entry per locale. Exactly one may be marked as the base; when none is, the first supplied is used and that is reported.",
    "example": [
     {
      "base": true,
      "locale": "en",
      "messages": {
       "app": {
        "greeting": "Hello, {name}",
        "title": "Dashboard"
       },
       "cart": {
        "item_one": "You have {count} item in your cart",
        "item_other": "You have {count} items in your cart"
       },
       "errors": {
        "generic": "Something went wrong",
        "retry": "Try again"
       },
       "invoice": {
        "total": "Total: {amount, number, ::currency/USD}"
       },
       "legal": {
        "terms": "By continuing you accept the <a href=\"/terms\">terms</a>"
       },
       "shared": {
        "cancel": "Cancel",
        "dismiss": "Cancel"
       }
      }
     },
     {
      "locale": "ja",
      "messages": {
       "app": {
        "greeting": "\u3053\u3093\u306b\u3061\u306f\u3001{name}",
        "title": "\u30c0\u30c3\u30b7\u30e5\u30dc\u30fc\u30c9"
       },
       "cart": {
        "item_one": "{count} \u4ef6",
        "item_other": "{count} \u4ef6"
       },
       "errors": {
        "generic": ""
       },
       "invoice": {
        "total": "\u5408\u8a08: {amount, number, ::currency/USD}"
       },
       "legal": {
        "terms": "\u7d9a\u884c\u3059\u308b\u3068<a href=\"/terms\">\u898f\u7d04</a>\u306b\u540c\u610f\u3057\u305f\u3082\u306e\u3068\u307f\u306a\u3055\u308c\u307e\u3059"
       },
       "removed": {
        "old_banner": "\u3082\u3046\u4f7f\u3063\u3066\u3044\u307e\u305b\u3093"
       },
       "shared": {
        "cancel": "\u30ad\u30e3\u30f3\u30bb\u30eb",
        "dismiss": "\u9589\u3058\u308b"
       }
      }
     },
     {
      "locale": "nl",
      "messages": {
       "app": {
        "greeting": "Hallo, {name}",
        "title": "Dashboard"
       },
       "cart": {
        "item_one": "U heeft {count} item",
        "item_other": "U heeft {count} items"
       },
       "errors": {
        "generic": "Er is iets misgegaan",
        "retry": "Opnieuw proberen"
       },
       "invoice": {
        "total": "Totaal: {amount, number, ::currency/USD}"
       },
       "legal": {
        "terms": "Door verder te gaan accepteert u de <a href=\"/terms\">voorwaarden</a>"
       },
       "shared": {
        "cancel": "Annuleren",
        "dismiss": "Sluiten"
       }
      }
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "base": {
       "description": "Whether this is the source locale the others are compared against.",
       "type": "boolean"
      },
      "locale": {
       "description": "A language tag such as en, pt-BR or ar.",
       "maxLength": 35,
       "type": "string"
      },
      "messages": {
       "description": "This locale\u2019s messages. A messages object, or JSON text, at most 2097152 bytes. Nested objects are flattened to separated keys, so a file written either way is read the same. Nothing is fetched: the files are supplied, so an arbitrary project can be audited.",
       "type": [
        "object",
        "string"
       ]
      }
     },
     "required": [
      "locale",
      "messages"
     ],
     "type": "object"
    },
    "maxItems": 60,
    "minItems": 2,
    "type": "array"
   },
   "treat_identical_as_untranslated": {
    "description": "Report a value identical to the base. Defaults to true. A value with no letters is never reported, since a number or a symbol is often correctly identical.",
    "type": "boolean"
   }
  },
  "required": [
   "locales"
  ],
  "type": "object"
 },
 "name": "locale_key_coverage_audit",
