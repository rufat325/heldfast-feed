 "description": "Runs vision OCR on an uploaded cap table file and returns the extracted rows without persisting them. Each row may include a vesting schedule (vesting_start_date / vesting_total_months / vesting_cliff_months) for service equity held by founders, employees, and advisors. PRESERVE these vesting fields and pass them through to RecordCapTableInvestment when creating each holding \u2014 do not drop them or record such holdings as fully vested. Investor instruments (SAFE, preferred) carry no vesting.",
 "inputSchema": {
  "properties": {
   "formationId": {
    "description": "UUID value wrapper.",
    "properties": {
     "value": {
      "format": "uuid",
      "type": "string"
     }
    },
    "type": "object"
   },
   "mimeType": {
    "maxLength": 100,
    "minLength": 1,
    "pattern": "^(image/(png|jpeg|webp)|application/pdf|text/csv|application/vnd\\.openxmlformats-officedocument\\.spreadsheetml\\.sheet)$",
    "type": "string"
   },
   "sourceS3Uri": {
    "maxLength": 2048,
    "minLength": 1,
    "pattern": "^s3://[a-z0-9.-]+/.+$",
    "type": "string"
   }
  },
  "required": [
   "formationId"
  ],
  "type": "object"
 },
