{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Diagnose this account in one call: the credential you are holding (scopes, expiry, spend ceiling), whether each agent is reporting, deployments that failed or are stuck or report \"running\" without ever passing a health check, suspended or pending services, and the balance against what is due. Every finding names the exact tool that fixes it. Start here when something is wrong and you do not know which tool to reach for, or when a customer says \"it is not working\". Pass client_time to also check for clock skew, which presents as random authentication failures.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "client_time": {
    "description": "Your own clock as ISO-8601 (e.g. 2026-09-09T15:04:05Z), to compare against the server. Optional; skip it if you cannot read a reliable clock.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "impreza_doctor",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "checked": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "findings": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "code": {
         "type": "string"
        },
        "fix": {
         "type": "string"
        },
        "message": {
         "type": "string"
        },
        "severity": {
         "enum": [
          "error",
          "warn",
          "info"
         ],
         "type": "string"
        }
       },
       "required": [
        "severity",
        "code",
        "message",
        "fix"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "healthy": {
      "type": "boolean"
     },
     "server_time": {
      "type": "string"
     }
    },
    "required": [
     "healthy",
     "checked",
     "findings",
     "server_time"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Diagnose account"
}
