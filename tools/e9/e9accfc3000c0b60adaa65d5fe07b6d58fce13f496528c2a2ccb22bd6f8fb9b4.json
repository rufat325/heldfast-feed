{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Update an existing draft email. Only the provided fields are changed (subject, body, to, cc, importance). Use send_draft to send it afterwards.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "New email body (HTML supported)",
    "type": "string"
   },
   "cc": {
    "$ref": "#/properties/to",
    "description": "Replace the CC recipient list"
   },
   "id": {
    "description": "Draft message ID (draftId from create_draft)",
    "type": "string"
   },
   "importance": {
    "description": "Email importance",
    "enum": [
     "low",
     "normal",
     "high"
    ],
    "type": "string"
   },
   "subject": {
    "description": "New email subject",
    "type": "string"
   },
   "to": {
    "anyOf": [
     {
      "items": {
       "format": "email",
       "maxLength": 254,
       "type": "string"
      },
      "maxItems": 500,
      "type": "array"
     },
     {
      "$ref": "#/properties/to/anyOf/0/items"
     }
    ],
    "description": "Replace the recipient list"
   }
  },
  "type": "object"
 },
 "name": "update_draft"
}
