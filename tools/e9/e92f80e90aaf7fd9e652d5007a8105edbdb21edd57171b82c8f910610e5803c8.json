{"_meta":{"securitySchemes":[{"scopes":["mcp:read"],"type":"oauth2"}]},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"No charge. Render a sample PDF from a mailing rule and optional sample body (max 100000 characters; omission uses the built-in sample, an empty string leaves it blank), without saving the rule, ingesting email, buying postage or changing credits. Workspace authentication required; staging keys may preview. Returns embedded PDF resource, pages and sample price. Optional rule.color defaults false; color adds $0.49 for each page. Returns the selected color flag; the site renders grayscale when false. Source PDF artwork and fonts are retained. Supports rule.format header/address visibility, greeting, signature, reply cleanup, spacing, margins and page numbers. Actual emails are priced after formatting.","inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"body":{"description":"Omit for the built-in sample; an empty string intentionally renders no body text.","maxLength":100000,"type":"string"},"rule":{"additionalProperties":false,"properties":{"additionalSenders":{"description":"Additional exact sender emails, matched with OR against sender. Up to 19; recipient and subject conditions still apply.","items":{"format":"email","maxLength":254,"pattern":"^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$","type":"string"},"maxItems":19,"type":"array"},"color":{"default":false,"type":"boolean"},"enabled":{"default":true,"type":"boolean"},"font":{"default":"times","enum":["times","librebaskerville","ebgaramond","sourceserif4","lora","merriweather","spectral","inter","roboto","opensans","notosans","nunito","ptserif"],"type":"string"},"fontSize":{"default":12,"maximum":24,"minimum":8,"type":"integer"},"format":{"additionalProperties":false,"default":{"dateFormat":"email","greeting":"