{"annotations":{"destructiveHint":false,"openWorldHint":false,"readOnlyHint":true},"description":"List water systems with at least one PFAS detection under EPA UCMR5 occurrence monitoring (2023-2025), worst first by maximum detected concentration. Filter by state, by county (requires state), or by a single analyte (e.g. PFOA, PFOS) to rank by that analyte's maximum. Only systems sampled under UCMR5 can appear; absence means not sampled, not PFAS-free.","inputSchema":{"properties":{"analyte":{"description":"UCMR5 analyte name, e.g. PFOA, PFOS, PFHxS, PFBS","type":"string"},"county":{"description":"County name as reported to SDWIS, e.g. COOK (requires state)","type":"string"},"limit":{"default":50,"description":"Max results (default 50, max 500)","type":"number"},"state":{"description":"Two-letter state code, e.g. IL","type":"string"}},"type":"object"},"name":"list_systems_with_pfas_detections","outputSchema":{"properties":{"data":{"anyOf":[{"properties":{"count":{"type":"integer"},"systems":{"items":{"properties":{"first_sample_date":{"type":"string"},"last_sample_date":{"type":"string"},"max_analyte":{"type":"string"},"max_ppt":{"type":["number"]},"max_ug_l":{"type":"number"},"name":{"type":"string"},"pfas_analytes_detected":{"type":"integer"},"pfas_detections":{"type":"integer"},"population_served":{"type":"integer"},"pwsid":{"type":"string"},"state":{"type":"string"}},"type":"object"},"type":"array"}},"required":["count","systems"],"type":"object"},{"type":"null"}]},"provenance":{"properties":{"as_of":{"type":"string"},"cadence":{"type":"string"},"cadence_detail":{"type":"string"},"fetched_at":{"type":"string"},"source":{"type":"string"},"source_detail":{"type":"string"}},"required":["as_of","cadence","cadence_detail","fetched_at","source","source_detail"],"type":"object"},"status":{"enum":["ok","no_data","source_unavailable","withheld"],"type":"string"},"status_detail":{"type":"string"}},"required":["status","data","provenance"],"type":"object"}}
