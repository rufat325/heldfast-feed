  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "slug": {
    "description": "Optional permanent slug such as billing. Omit to use this process's anonymous inspect URL. A named slug requires OPENWEBHOOK_TOKEN.",
    "maxLength": 128,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "watch.stop",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "slug": {
    "type": "string"
   },
   "stopped": {
    "type": "boolean"
   },
   "watched": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "stopped",
   "watched"
  ],
  "type": "object"
 },
 "title": "Stop watch"
}
