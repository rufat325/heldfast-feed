{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true},"description":"Compare baseline and candidate STEP artifacts, as filesystem paths or file: URIs. Returns both content revisions, geometry deltas in the baseline declared unit, declared PMI counts (dimensions, geometric tolerances, datums, and how many tolerance values could not be read), and parsed document facts: schema, product names/count, assembly flag, authoring system, and organization. The PMI counts show whether a revision added or dropped callouts; they compare how many callouts exist, not whether any is met. These are file-level facts; they do not explain design intent.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"baseline":{"additionalProperties":false,"description":"Original STEP artifact.","properties":{"uri":{"description":"STEP file to read, as a file: URI or an absolute filesystem path.","minLength":1,"type":"string"}},"required":["uri"],"type":"object"},"candidate":{"additionalProperties":false,"description":"Modified STEP artifact.","properties":{"uri":{"description":"STEP file to read, as a file: URI or an absolute filesystem path.","minLength":1,"type":"string"}},"required":["uri"],"type":"object"}},"required":["baseline","candidate"],"type":"object"},"name":"diff","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"deltas":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"exchange":{"additionalProperties":{},"propertyNames":{"type":"string"},"type":"object"},"inputs":{"items":{"additionalProperties":false,"properties":{"artifact":{"additionalProperties":false,"properties":{"format":{"const":"step","type":"string"},"revision":{"pattern":"^sha256:[a-f0-9]{64}$","type":"string"},"units":{"type":"string"},"uri":{"minLength":1,"type":"string"}},"required":["revision","uri","format","u