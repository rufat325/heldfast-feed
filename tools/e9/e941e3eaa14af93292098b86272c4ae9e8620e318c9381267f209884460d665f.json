{
 "annotations": {
  "destructiveHint": true,
  "title": "Create a vehicle"
 },
 "description": "Create a vehicle, optionally attached to a customer. Shopmonkey: POST /v3/vehicle.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "color": {
    "description": "Vehicle color.",
    "enum": [
     "White",
     "Silver",
     "Gray",
     "Black",
     "Blue",
     "Red",
     "Brown",
     "Burgundy",
     "Tan",
     "Gold",
     "Green",
     "Yellow",
     "Orange",
     "Pink",
     "Purple",
     "Other"
    ],
    "type": "string"
   },
   "customerId": {
    "description": "The owning customer's id.",
    "type": "string"
   },
   "engine": {
    "description": "Engine description.",
    "type": "string"
   },
   "licensePlate": {
    "description": "License plate.",
    "type": "string"
   },
   "licensePlateState": {
    "description": "License plate state / province.",
    "type": "string"
   },
   "locationId": {
    "description": "The shop location id (see shopmonkey_get_current_user for the key's own location).",
    "type": "string"
   },
   "make": {
    "description": "Make, e.g. Toyota.",
    "type": "string"
   },
   "mileage": {
    "description": "Current odometer reading.",
    "minimum": 0,
    "type": "number"
   },
   "model": {
    "description": "Model, e.g. Camry.",
    "type": "string"
   },
   "note": {
    "description": "Internal note on the vehicle.",
    "type": "string"
   },
   "size": {
    "description": "LightDuty (cars, light trucks), HeavyDuty, or Other.",
    "enum": [
     "HeavyDuty",
     "LightDuty",
     "Other"
    ],
    "type": "string"
   },
   "submodel": {
    "description": "Submodel / trim, e.g. LE.",
    "type": "string"
   },
   "unit": {
    "description": "Fleet unit number.",
    "type": "string"
   },
   "vin": {
    "description": "Vehicle identification number.",
    "type": "string"
   },
   "year": {
    "description": "Model year.",
    "maximum": 2100,
    "minimum": 1900,
    "type": "integer"
   }
  },
  "required": [
   "size"
  ],
  "type": "object"
 },
 "name": "shopmonkey_create_vehicle",
 "title": "Create a vehicle"
}
