     "cm2",
     "ft2",
     "in2",
     "m2"
    ],
    "type": "string"
   },
   "Kb": {
    "description": "Capacity correction factor for back pressure, default 1.0",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "Kc": {
    "description": "Combination correction factor (rupture disk), default 1.0",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "Kd": {
    "description": "Effective coefficient of discharge, default 0.975",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "M": {
    "description": "Relieving mass flow rate",
    "properties": {
     "unit": {
      "enum": [
       "kg/day",
       "kg/hr",
       "kg/min",
       "kg/sec",
       "klb/hr",
       "lb/day",
       "lb/hr",
       "ton/day"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "MW": {
