       "kg/kmol",
       "lb/lbmol",
       "lb/mol"
      ],
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "P1": {
