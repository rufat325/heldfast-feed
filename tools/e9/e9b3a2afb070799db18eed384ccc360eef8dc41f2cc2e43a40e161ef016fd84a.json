      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "required": [
     "value",
     "unit"
    ],
    "type": "object"
   },
   "k": {
    "description": "Heat capacity ratio (Cp/Cv), default 1.4",
    "properties": {
     "unit": {
      "type": "string"
     },
     "value": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "M",
   "P1",
   "P2",
   "T1",
   "MW"
  ],
  "type": "object"
 },
 "name": "PSVGAS"
}
