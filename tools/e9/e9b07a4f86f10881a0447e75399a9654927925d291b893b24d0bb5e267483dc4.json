{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update the content, title, folder, or source of an existing knowledge base entry.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "content": {
    "description": "New content for the entry",
    "type": "string"
   },
   "entryId": {
    "description": "Unique identifier of the entry to update",
    "type": "string"
   },
   "folder": {
    "description": "New folder: 'general', 'skills', 'contexts', 'documents', or 'faqs'",
    "type": "string"
   },
   "kbId": {
    "description": "Unique identifier of the knowledge base",
    "type": "string"
   },
   "metadata": {
    "additionalProperties": {},
    "description": "New metadata key-value pairs",
    "type": "object"
   },
   "source": {
    "description": "New source type for the entry",
    "enum": [
     "manual",
     "document",
     "url"
    ],
    "type": "string"
   },
   "title": {
    "description": "New title for the entry",
    "type": "string"
   }
  },
  "required": [
   "kbId",
   "entryId"
  ],
  "type": "object"
 },
 "name": "neuron_update_kb_entry",
 "title": "Update Knowledge Base Entry"
}
