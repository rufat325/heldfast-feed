{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Pass the person to a licensed adviser: saves the enquiry, emails them their shortlist, emails the adviser and\n    returns a WhatsApp link and a reference. Only call it once they have given a name and a phone number or email and\n    have said they want to be contacted. Never put a health detail in the note; the adviser asks directly. Needs a key on the public server; without one it returns key_required and tells the user where to get one.",
 "inputSchema": {
  "properties": {
   "age": {
    "anyOf": [
     {
      "maximum": 99,
      "minimum": 0,
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Age"
   },
   "email": {
    "anyOf": [
     {
      "maxLength": 160,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Email"
   },
   "gender": {
    "anyOf": [
     {
      "pattern": "^[MF]$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Gender"
   },
   "name": {
    "maxLength": 120,
    "title": "Name",
    "type": "string"
   },
   "note": {
    "anyOf": [
     {
      "maxLength": 1000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "What they asked for. Never any health detail.",
    "title": "Note"
   },
   "option_id": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The plan they want to talk about",
    "title": "Option Id"
   },
   "phone": {
    "anyOf": [
     {
      "maxLength": 60,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Phone"
   },
   "preferred_contact": {
    "anyOf": [
     {
      "pattern": "^(WhatsApp|Phone|Email)$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Preferred Contact"
   }
  },
  "required": [
   "name"
  ],
  "title": "create_leadArguments",
  "type": "object"
 },
 "name": "create_lead",
 "outputSchema": {
  "additionalProperties": true,
  "title": "create_leadDictOutput",
  "type": "object"
 },
 "title": "Hand over to a licensed adviser"
}
