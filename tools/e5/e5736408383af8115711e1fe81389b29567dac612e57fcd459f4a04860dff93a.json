{
 "_meta": {
  "openai/outputTemplate": "ui://haus/widgets/v2",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://haus/widgets/v2",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Add a contact to the address book. Only firstName is required; address, date of birth, notes and the birthday-present flag can follow via update_contact.",
 "inputSchema": {
  "examples": [
   {
    "address": {
     "countryCode": "GB",
     "line1": "12 Baker Street",
     "postalCode": "NW1 6XE"
    },
    "dateOfBirth": "1990-05-15",
    "email": "sarah.jones@example.com",
    "firstName": "Sarah",
    "lastName": "Jones",
    "notes": "Met at the neighbourhood BBQ.",
    "phone": "+44 7911 123456",
    "prepareBirthdayPresent": true
   }
  ],
  "properties": {
   "address": {
    "description": "Postal address.",
    "properties": {
     "countryCode": {
      "description": "ISO country code, e.g. GB.",
      "examples": [
       "GB"
      ],
      "type": "string"
     },
     "line1": {
      "description": "Line 1, typically number and street.",
      "examples": [
       "12 Baker Street"
      ],
      "type": "string"
     },
     "line2": {
      "description": "Line 2, e.g. apartment or unit.",
      "examples": [
       "Flat 3"
      ],
      "type": "string"
     },
     "line3": {
      "description": "Line 3, e.g. town or city.",
      "examples": [
       "London"
      ],
      "type": "string"
     },
     "postalCode": {
      "description": "Postal or ZIP code.",
      "examples": [
       "NW1 6XE"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "dateOfBirth": {
    "description": "Date of birth, YYYY-MM-DD. Drives the birthday reminder.",
    "examples": [
     "1990-05-15"
    ],
    "type": "string"
   },
   "displayName": {
    "description": "Name to show instead of first/last, e.g. a nickname or company.",
    "examples": [
     "Sarah from book club"
    ],
    "type": "string"
   },
   "email": {
    "description": "Email address.",
    "examples": [
     "sarah.jones@example.com"
    ],
    "type": "string"
   },
   "firstName": {
    "description": "First name. The only required field.",
    "examples": [
     "Sarah"
    ],
    "type": "string"
   },
   "lastName": {
    "description": "Last (family) name.",
    "examples": [
     "Jones"
    ],
    "type": "string"
   },
   "notes": {
    "description": "Free-text notes.",
    "examples": [
     "Met at the neighbourhood BBQ."
    ],
    "type": "string"
   },
   "phone": {
    "description": "Phone number, any format.",
    "examples": [
     "+44 7911 123456"
    ],
    "type": "string"
   },
   "prepareBirthdayPresent": {
    "description": "Whether to flag a birthday present for them.",
    "examples": [
     true
    ],
    "type": "boolean"
   }
  },
  "required": [
   "firstName"
  ],
  "type": "object"
 },
 "name": "create_contact",
 "outputSchema": {
  "properties": {
   "items": {
    "items": {
     "type": "object"
    },
    "type": "array"
   },
   "message": {
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "variant": {
    "enum": [
     "list",
     "detail",
     "confirmation"
    ],
    "type": "string"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 }
}
