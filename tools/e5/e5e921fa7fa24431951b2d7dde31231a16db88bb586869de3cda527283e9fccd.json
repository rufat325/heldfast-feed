{
 "description": "Free. Instance types available in a region with coverage dates.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "prefix": {
    "description": "Type-name prefix filter, e.g. c5.",
    "type": "string"
   },
   "provider": {
    "description": "Cloud provider",
    "enum": [
     "aws",
     "gcp",
     "azure"
    ],
    "type": "string"
   },
   "region": {
    "description": "Region slug from the catalog tool (e.g. us-east-1, us-central1, us-east)",
    "type": "string"
   }
  },
  "required": [
   "provider",
   "region"
  ],
  "type": "object"
 },
 "name": "instances"
}
