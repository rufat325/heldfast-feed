{
 "description": "Rule-based preflight for an explicit task state. Does not read chat histories or predict a calibrated success probability.",
 "inputSchema": {
  "properties": {
   "acceptance": {
    "maxLength": 2000,
    "type": "string"
   },
   "acceptanceEvidence": {
    "type": "string"
   },
   "acceptancePassed": {
    "type": "boolean"
   },
   "artifactCreated": {
    "type": "boolean"
   },
   "blockers": {
    "items": {
     "maxLength": 2000,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "cancelled": {
    "type": "boolean"
   },
   "goal": {
    "maxLength": 2000,
    "type": "string"
   },
   "permissionRequired": {
    "type": "boolean"
   },
   "repeatFailures": {
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "goal",
   "acceptance"
  ],
  "type": "object"
 },
 "name": "review_task_state"
}
