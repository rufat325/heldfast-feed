{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a retry-safe manual-review physical verification request in Japan. Reuse the same idempotency_key for the same logical request. No payment, worker hire, or fulfillment commitment is created automatically.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "constraints": {
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "deadline": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
    "type": "string"
   },
   "evidence_requirements": {
    "items": {
     "maxLength": 500,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "idempotency_key": {
    "description": "Stable key for this logical request. Reuse the same key when retrying create after a lost response.",
    "maxLength": 200,
    "minLength": 8,
    "type": "string"
   },
   "location": {
    "maxLength": 500,
    "minLength": 2,
    "type": "string"
   },
   "objective": {
    "maxLength": 4000,
    "minLength": 3,
    "type": "string"
   }
  },
  "required": [
   "location",
   "objective",
   "idempotency_key"
  ],
  "type": "object"
 },
 "name": "create_verification_request",
 "title": "Create Japan physical verification request"
}
