{
 "description": "Find traffic-carrying pages for a domain and route them into protect, refresh, expand, or recover actions.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "historical_serp_mode": {
    "default": "live",
    "enum": [
     "live",
     "lost",
     "all"
    ],
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "limit": {
    "default": 50,
    "maximum": 250,
    "minimum": 10,
    "type": "integer"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "min_traffic": {
    "default": 0,
    "maximum": 10000000,
    "minimum": 0,
    "type": "integer"
   },
   "sort_by": {
    "default": "estimated_traffic",
    "enum": [
     "estimated_traffic",
     "keyword_count",
     "top3",
     "opportunity"
    ],
    "type": "string"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   },
   "target": {
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "target"
  ],
  "type": "object"
 },
 "name": "agentseo_domain_relevant_pages",
 "title": "AgentSEO Domain Relevant Pages"
}
