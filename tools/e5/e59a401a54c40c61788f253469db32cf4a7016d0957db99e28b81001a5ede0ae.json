{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Remove or conclude an enrollment from a course. The 'delete' task is permanent; 'conclude' and 'deactivate' are reversible.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "enrollment_id": {
    "description": "The enrollment ID to remove",
    "type": "number"
   },
   "task": {
    "description": "The action to perform on the enrollment",
    "enum": [
     "conclude",
     "delete",
     "deactivate"
    ],
    "type": "string"
   }
  },
  "required": [
   "course_id",
   "enrollment_id",
   "task"
  ],
  "type": "object"
 },
 "name": "remove_enrollment",
 "title": "Remove Enrollment"
}
