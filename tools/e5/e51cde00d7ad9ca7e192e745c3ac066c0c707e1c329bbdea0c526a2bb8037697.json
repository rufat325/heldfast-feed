{
 "description": "Anticipate future receivables (Stone's flagship 'antecipa\u00e7\u00e3o')",
 "inputSchema": {
  "properties": {
   "account_id": {
    "description": "Merchant account ID",
    "type": "string"
   },
   "amount": {
    "description": "Amount in cents to anticipate",
    "type": "number"
   },
   "receivable_ids": {
    "description": "Specific receivable IDs to anticipate (optional; else auto-selected)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "timeframe": {
    "description": "When to settle (default end)",
    "enum": [
     "start",
     "end",
     "exact"
    ],
    "type": "string"
   }
  },
  "required": [
   "account_id",
   "amount"
  ],
  "type": "object"
 },
 "name": "create_anticipation"
}
