{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Report Kibi coverage and proofs"
 },
 "description": "Generate curated structural coverage and conservative end-to-end requirement proof reports for requirements, symbols, or grouped types. Reports include the compatible repair plan plus typed kibi.migration-plan.v2 actions; semantic and E2E actions remain review/execution work. Paginated plans identify incomplete scope and no mutation occurs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "by": {
    "anyOf": [
     {
      "const": "req",
      "type": "string"
     },
     {
      "const": "symbol",
      "type": "string"
     },
     {
      "const": "type",
      "type": "string"
     }
    ]
   },
   "includeMigrationPreview": {
    "description": "Opt in to a deterministic, read-only kibi.legacy-migration-plan.v1 preview for ready semantic-inventory repair batches.",
    "type": "boolean"
   },
   "includePassing": {
    "type": "boolean"
   },
   "includeTransitive": {
    "type": "boolean"
   },
   "limit": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "migrationLimit": {
    "description": "Maximum requirement migration batches to preview. Defaults to one review batch.",
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "migrationOffset": {
    "description": "Zero-based offset into ready semantic-inventory batches.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "migrationPredicateLimit": {
    "description": "Maximum exact predicate-schema candidates retained per assertive proposition.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "migrationPredicateMinScore": {
    "description": "Minimum deterministic predicate-schema rank score retained in migration previews.",
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "offset": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "statuses": {
    "description": "Requirement proof-status filter (req mode): include only rows whose proofStatus is listed. Selecting statuses implies include-passing; not_applicable rows carry their typed applicability reason in proofStages.applicability.reason. The summary always reflects the whole KB.",
    "items": {
     "anyOf": [
      {
       "const": "proven",
       "type": "string"
      },
      {
       "const": "missing",
       "type": "string"
      },
      {
       "const": "unresolved",
       "type": "string"
      },
      {
       "const": "not_applicable",
       "type": "string"
      }
     ]
    },
    "type": "array"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workspaceRoot": {
    "description": "Optional absolute path of the workspace this call is about when it differs from the one the server started in, for example the git worktree you are working in. The server answers from that workspace's knowledge base when it is a worktree of the same repository or lies under the client's MCP roots; otherwise it answers from its own workspace and adds a workspace_mismatch diagnostic. Host hooks fill this in automatically where available.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "kb_coverage",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "legacyMigrationPlan": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "meta": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "migrationPlan": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "repairPlan": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "rows": {
      "items": {
       "additionalProperties": {},
       "properties": {},
       "type": "object"
      },
      "type": "array"
     },
     "summary": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     },
     "symbolRepairPlan": {
      "additionalProperties": {},
      "properties": {},
      "type": "object"
     }
    },
    "type": "object"
   },
   "diagnostics": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "category": {
       "type": "string"
      },
      "code": {
       "type": "string"
      },
      "detail": {},
      "file": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "anyOf": [
        {
         "const": "info",
         "type": "string"
        },
        {
         "const": "warning",
         "type": "string"
        },
        {
         "const": "error",
         "type": "string"
        }
       ]
      },
      "suggestion": {
       "type": "string"
      }
     },
     "required": [
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "effects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "detail": {},
      "errorCode": {
       "type": "string"
      },
      "kind": {
       "type": "string"
      },
      "status": {
       "anyOf": [
        {
         "const": "completed",
         "type": "string"
        },
        {
         "const": "failed",
         "type": "string"
        },
        {
         "const": "not_applicable",
         "type": "string"
        }
       ]
      }
     },
     "required": [
      "kind",
      "status"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "error": {
    "additionalProperties": false,
    "properties": {
     "code": {
      "type": "string"
     },
     "details": {},
     "message": {
      "type": "string"
     },
     "retryable": {
      "type": "boolean"
     }
    },
    "required": [
     "code",
     "message",
     "retryable"
    ],
    "type": "object"
   },
   "kibiProtocol": {
    "const": 1,
    "type": "number"
   },
   "nextActions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "input": {},
      "operation": {
       "type": "string"
      },
      "reason": {
       "type": "string"
      },
      "required": {
       "type": "boolean"
      }
     },
     "required": [
      "operation",
      "reason",
      "required"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "operation": {
    "const": "kb_coverage",
    "type": "string"
   },
   "resultVersion": {
    "const": "kibi.kb_coverage.v1",
    "type": "string"
   },
   "status": {
    "anyOf": [
     {
      "const": "success",
      "type": "string"
     },
     {
      "const": "committed_with_repairs",
      "type": "string"
     },
     {
      "const": "error",
      "type": "string"
     }
    ]
   }
  },
  "required": [
   "kibiProtocol",
   "operation",
   "resultVersion",
   "status",
   "data",
   "effects",
   "diagnostics",
   "nextActions"
  ],
  "type": "object"
 }
}
