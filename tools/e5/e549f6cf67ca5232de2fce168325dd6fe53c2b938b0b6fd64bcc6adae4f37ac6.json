{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "mcp_crm"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Listing health"
 },
 "description": "Checks YOUR agency's own listings for what is holding them back, and\nlists the ones with problems, most problems first:\n  - stale: online for 90 days or more, no enquiry in the last\n    60 days and no price change in the last 90\n  - too_few_photos: fewer than the 5 photos a listing needs to\n    publish\n  - no_energy_rating\n  - missing_description: no Spanish or no English description\n  - no_price: no asking price and not marked price on application\nDefaults to online listings; status 'draft' checks what is not\npublished yet (what stops it publishing), 'all' checks both.\n\nRequires a linked PropertyList account (or an agency API key); only the calling agency's own\nlistings.\n",
 "inputSchema": {
  "properties": {
   "issue": {
    "description": "Only listings with this problem. Optional.",
    "enum": [
     "stale",
     "too_few_photos",
     "no_energy_rating",
     "missing_description",
     "no_price"
    ],
    "type": "string"
   },
   "limit": {
    "default": 20,
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "status": {
    "default": "online",
    "enum": [
     "online",
     "draft",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "listing_health",
 "outputSchema": {
  "properties": {
   "checked": {
    "type": "integer"
   },
   "issues": {
    "description": "Issue name to how many listings have it.",
    "type": "object"
   },
   "listings": {
    "items": {
     "properties": {
      "days_online": {
       "type": "integer"
      },
      "issues": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "last_enquiry_at": {
       "type": "string"
      },
      "last_price_change_at": {
       "type": "string"
      },
      "missing_languages": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "photos": {
       "type": "integer"
      },
      "price": {
       "type": [
        "integer",
        "null"
       ]
      },
      "price_period": {
       "type": [
        "string",
        "null"
       ]
      },
      "reference": {
       "type": "string"
      },
      "status": {
       "type": "string"
      }
     },
     "required": [
      "reference",
      "issues"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "rules": {
    "type": "object"
   }
  },
  "required": [
   "checked",
   "issues",
   "rules",
   "listings"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "mcp_crm"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Listing health"
}
