{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Repository Blast Radius"
 },
 "description": "Run blast-radius / file impact analysis for one or more files or dependencies. Returns projected data flows, entry points, and call edges. Requires PRO, ENTERPRISE, or ADMIN tier (STARTUP is not eligible) and consumes credits.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "demo": {
    "description": "Run in demo mode (pre-signup, public data, IP-based credits)",
    "type": "boolean"
   },
   "dependencies": {
    "description": "Multiple dependency names to analyze",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "dependency": {
    "description": "Single dependency name to analyze",
    "type": "string"
   },
   "file": {
    "description": "Single file path to analyze",
    "type": "string"
   },
   "files": {
    "description": "Multiple file paths to analyze",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "include": {
    "description": "Projection kinds to include (e.g. data_flows, entry_points, call_edges)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "limit": {
    "description": "Max targets to return",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "repo_key": {
    "description": "Repository UUID or clone URL",
    "type": "string"
   }
  },
  "required": [
   "repo_key"
  ],
  "type": "object"
 },
 "name": "code-fundi-repo-radius"
}
