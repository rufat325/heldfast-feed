{
 "_meta": {
  "openai/toolInvocation/invoked": "Domain verification complete",
  "openai/toolInvocation/invoking": "Verifying your custom domain"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Check the TXT record from add_custom_domain and, when it is found, start serving the site on that domain (HTTPS is issued automatically within about 30 s). If it fails, DNS has usually not propagated yet: wait a few minutes and call it again.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "recordId": {
    "description": "The recordId returned by add_custom_domain.",
    "type": "string"
   },
   "siteName": {
    "description": "The site the domain was attached to.",
    "type": "string"
   }
  },
  "required": [
   "siteName",
   "recordId"
  ],
  "type": "object"
 },
 "name": "verify_custom_domain",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "domain": {
    "type": "string"
   },
   "message": {
    "type": "string"
   },
   "verified": {
    "type": "boolean"
   }
  },
  "required": [
   "verified",
   "domain",
   "message"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "deploy",
    "sites:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Verify a custom domain (step 2 of 2)"
}
