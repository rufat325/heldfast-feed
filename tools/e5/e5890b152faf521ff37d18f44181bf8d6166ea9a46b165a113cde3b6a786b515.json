{"annotations":{"destructiveHint":true,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":false},"description":"Previews a native Anki deck rename or move under an existing parent. Preserves deck and card identity, reviews descendant paths, and requires the impact hash and explicit confirmation before applying. Requires AnkiConnect v1.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"confirmRename":{"default":false,"type":"boolean"},"dryRun":{"default":true,"type":"boolean"},"expectedImpactHash":{"description":"Impact hash from the reviewed rename preview","pattern":"^[0-9a-f]{64}$","type":"string"},"name":{"description":"Exact current full deck path","maxLength":1000,"minLength":1,"type":"string"},"newName":{"description":"New full path; the destination parent must already exist","maxLength":1000,"minLength":1,"type":"string"}},"required":["name","newName"],"type":"object"},"name":"rename-deck","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"applied":{"type":"boolean"},"blockers":{"items":{"type":"string"},"type":"array"},"changeCount":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"changes":{"items":{"additionalProperties":false,"properties":{"afterName":{"type":"string"},"beforeName":{"type":"string"},"deckId":{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"}},"required":["deckId","beforeName","afterName"],"type":"object"},"maxItems":100,"type":"array"},"deckId":{"anyOf":[{"exclusiveMinimum":0,"maximum":9007199254740991,"type":"integer"},{"type":"null"}]},"dryRun":{"type":"boolean"},"impactHash":{"anyOf":[{"pattern":"^[0-9a-f]{64}$","type":"string"},{"type":"null"}]},"verified":{"type":"boolean"},"warnings":{"items":{"type":"string"},"type":"array"}},"required":["dryRun","applied","verified","deckId","impactHash","changeCount","changes","blockers","warnings"],"type":"object"},"title":"Rename or move a deck"}
