      "payment": "PAY-2"
     }
    ],
    "items": {
     "additionalProperties": false,
     "properties": {
      "amount": {
       "description": "Applied from that payment to that invoice. A decimal string is preferred, because a JSON number cannot hold most two-place decimals exactly and the digits may already differ from what was written by the time they arrive. A number is accepted and that risk is reported.",
       "type": [
        "string",
        "number"
       ]
      },
