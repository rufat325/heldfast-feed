{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "LIN bus timing: bit time, break field duration (13 bits), and worst-case frame time per LIN 2.x nominal (header 34 + response 10*(n+1) bits with 1.4x budget = (43+10n)/baud).\nArgs: baud (typ. 9600/19200), data_bytes (1-8).\nReturns (structured): { bit_time_us, break_time_us, frame_time_us }.\nExample: 19200 baud, 8 bytes -> bit 52.08 \u00b5s, break 677 \u00b5s, frame 6406 \u00b5s.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "baud": {
    "default": 19200,
    "description": "LIN baud rate (max 20 kbit/s)",
    "exclusiveMinimum": 0,
    "maximum": 20000,
    "type": "integer"
   },
   "data_bytes": {
    "default": 8,
    "description": "Response data bytes",
    "maximum": 8,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "embedcalc_lin_timing",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bit_time_us": {
    "type": "number"
   },
   "break_time_us": {
    "type": "number"
   },
   "frame_time_us": {
    "type": "number"
   }
  },
  "required": [
   "bit_time_us",
   "break_time_us",
   "frame_time_us"
  ],
  "type": "object"
 },
 "title": "LIN Bus Timing Calculator"
}
