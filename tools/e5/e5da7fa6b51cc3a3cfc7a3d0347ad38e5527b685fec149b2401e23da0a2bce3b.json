{
 "_meta": {
  "openai/toolInvocation/invoked": "Sign-in updated",
  "openai/toolInvocation/invoking": "Checking sign-in\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Poll after **ucode_login_start**. Links the ChatGPT session when the user has finished in the browser \u2014 **call repeatedly** until complete; do not ask users to paste tokens or to type \u201cdone\u201d as the only completion signal.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "sessionId": {
    "description": "sessionId returned by ucode_login_start",
    "minLength": 16,
    "type": "string"
   }
  },
  "required": [
   "sessionId"
  ],
  "type": "object"
 },
 "name": "ucode_login_poll",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "billingUrl": {
    "type": "string"
   },
   "code": {
    "type": "string"
   },
   "countryName": {
    "type": "string"
   },
   "credits": {
    "type": "number"
   },
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "endDate": {
    "type": "string"
   },
   "error": {
    "type": "string"
   },
   "httpStatus": {
    "type": "number"
   },
   "neededCredits": {
    "type": "number"
   },
   "ok": {
    "type": "boolean"
   },
   "phone": {
    "type": "string"
   },
   "phoneNumber": {
    "type": "string"
   },
   "providerRentalId": {
    "type": "string"
   },
   "remainingSeconds": {
    "type": "number"
   },
   "rentalId": {
    "type": "string"
   },
   "serviceName": {
    "type": "string"
   },
   "smsCode": {
    "type": "string"
   },
   "summary": {
    "type": "string"
   },
   "uiView": {
    "type": "string"
   }
  },
  "required": [
   "ok",
   "summary"
  ],
  "type": "object"
 },
 "title": "Finish browser sign-in"
}
