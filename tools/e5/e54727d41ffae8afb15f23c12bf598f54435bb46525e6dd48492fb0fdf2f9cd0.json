{
 "_meta": {
  "opentrain.ai/authoring-retry": {
   "allowedRetryAction": "Inspect the same folder/page/asset. Explicitly repeat cancellation only while cancelable. Never infer cancellation from a missing asset or allocate a replacement after an uncertain provider outcome.",
   "automaticRetry": false,
   "identityFields": [
    "folderId",
    "pageId",
    "assetId"
   ],
   "inspect": [
    {
     "method": "GET",
     "path": "/api/public/v1/instructions/folders/{folderId}/videos/{assetId}"
    }
   ],
   "keyRequirement": "NO_CLIENT_KEY",
   "missingResourceBehavior": "UNKNOWN_NOT_SUCCESS",
   "policy": "ASSET_IDENTITY_INSPECTION",
   "schemaVersion": "folder-instruction-authoring-retry/1",
   "staleStateBehavior": "READY is immutable and cannot be canceled. A missing row/404 or uncertain provider result requires reconciliation, not success.",
   "stateActions": {
    "CANCELED": "CANONICAL_CANCELLATION_RESPONSE_ONLY",
    "CANCELING": "POLL_THEN_RECONCILE_SAME_ASSET",
    "NOT_FOUND": "UNKNOWN_NOT_SUCCESS",
    "PENDING": "EXPLICIT_SAME_ASSET_CANCEL_ALLOWED",
    "PROCESSING": "EXPLICIT_SAME_ASSET_CANCEL_ALLOWED",
    "READY": "IMMUTABLE_CONFLICT",
    "UNKNOWN": "RECONCILIATION_REQUIRED"
   }
  }
 },
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Release an unfinished upload. A ready asset is immutable; canceling means provider release is pending and requires a same-asset retry. Requires current employer folder access. Empty destinations require reviewed activation; published/unknown delivery writes refuse without changing release/read/ack flags. Requires instructions:write.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "assetId": {
    "$ref": "#/properties/folderId"
   },
   "confirmed": {
    "const": true,
    "type": "boolean"
   },
   "folderId": {
    "pattern": "^[A-Za-z0-9._:-]{1,128}$",
    "type": "string"
   }
  },
  "required": [
   "folderId",
   "assetId",
   "confirmed"
  ],
  "type": "object"
 },
 "name": "opentrain_folder_instructions_video_cancel",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "apiBaseUrl": {
    "type": "string"
   },
   "result": {
    "additionalProperties": false,
    "properties": {
     "assetId": {
      "$ref": "#/properties/result/properties/folderId"
     },
     "canonicalSource": {
      "const": "FOLDER_INSTRUCTION_SET",
      "type": "string"
     },
     "folderId": {
      "pattern": "^[A-Za-z0-9._:-]{1,128}$",
      "type": "string"
     },
     "status": {
      "enum": [
       "canceled",
       "canceling",
       "ready"
      ],
      "type": "string"
     }
    },
    "required": [
     "canonicalSource",
     "folderId",
     "assetId",
     "status"
    ],
    "type": "object"
   }
  },
  "required": [
   "apiBaseUrl",
   "result"
  ],
  "type": "object"
 }
}
