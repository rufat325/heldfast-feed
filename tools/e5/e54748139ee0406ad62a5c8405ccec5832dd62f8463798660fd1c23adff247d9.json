{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List replies to a comment.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "commentId": {
    "description": "The comment to list replies for",
    "type": "string"
   },
   "fields": {
    "description": "Fields to include (e.g. \"replies(id,content,action),nextPageToken\")",
    "type": "string"
   },
   "fileId": {
    "description": "The file the comment belongs to",
    "type": "string"
   },
   "includeDeleted": {
    "description": "Whether to include deleted replies (they have no content)",
    "type": "boolean"
   },
   "pageSize": {
    "description": "Max replies to return (default 20)",
    "type": "number"
   },
   "pageToken": {
    "description": "Page token from a previous call",
    "type": "string"
   }
  },
  "required": [
   "fileId",
   "commentId"
  ],
  "type": "object"
 },
 "name": "drive_replies_list"
}
