   "idempotency_key": {
    "maxLength": 128,
    "minLength": 22,
    "type": "string"
   },
   "origin": {
    "type": "string"
   },
   "paths": {
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "payment_signature": {
    "type": "string"
   },
   "quote_mode": {
    "enum": [
     "fast"
    ],
    "type": "string"
   },
   "recovery_capability": {
    "type": "string"
   }
  },
  "required": [
   "origin"
  ],
  "type": "object"
 },
 "name": "scan_origin"
}
