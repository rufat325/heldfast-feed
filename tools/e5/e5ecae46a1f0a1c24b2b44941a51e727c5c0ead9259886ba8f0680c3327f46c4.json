{
 "description": "Find all federal court cases involving a specific company. Returns opinions, dockets, and case summaries.",
 "inputSchema": {
  "properties": {
   "company": {
    "description": "Company name (e.g. \"Apple Inc\", \"Goldman Sachs\")",
    "type": "string"
   },
   "court": {
    "description": "Limit to specific court (e.g. ca9, scotus)",
    "type": "string"
   },
   "date_after": {
    "description": "Only cases filed after date (YYYY-MM-DD)",
    "type": "string"
   },
   "limit": {
    "default": 10,
    "description": "Number of results (max 20)",
    "type": "number"
   }
  },
  "required": [
   "company"
  ],
  "type": "object"
 },
 "name": "get_company_cases"
}
