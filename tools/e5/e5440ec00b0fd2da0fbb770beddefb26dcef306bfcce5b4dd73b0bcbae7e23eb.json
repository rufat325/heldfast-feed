{
 "description": "Obtain oracle assessment evidence for a swap/DeFi intent BEFORE trading. Insight runs the oracle safety check and, if the verdict is PASS/CAUTION, returns a machine-readable \"execution certification handle\": preTradeUid, requestHash, CAIP-19 asset ids, the certified price (destination per source) and maxSlippageBps, plus a required operation-input check for both asset legs and a fresh Uniswap V3 on-chain route quote cross-checked by two Ethereum RPCs. If either input assessment is not SUFFICIENT, either route quote is stale or outside policy, or either oracle gate blocks, no execution handle is issued. The assessments are independently EIP-712 signed and linked to the receipt through both pre-trade UIDs. participant/source-group counts and the pre-trade signing time. Execute the trade with YOUR wallet, then call execution_receipt with this handle + txHash to obtain the signed, verifiable Execution Receipt. If the verdict is DANGER or BLOCK this tool refuses (do not trade). This is oracle assessment evidence, not principal authorization \u2014 pair it with execution_receipt.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "action": {
    "enum": [
     "swap",
     "borrow",
     "lend",
     "liquidate",
     "repay"
    ],
    "type": "string"
   },
   "asset": {
    "description": "Source asset symbol being sold, e.g. ETH, USDC",
    "type": "string"
   },
   "chainId": {
    "description": "Chain ID where the trade executes, e.g. 1=Ethereum, 42161=Arbitrum, 8453=Base",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "decisionInput": {
    "additionalProperties": false,
    "description": "Required operation-input gate for both assets and the caller-reported route quote. Insight also obtains an exact-notional Uniswap V3 quote on Ethereum mainnet, sized from a fresh Chainlink price and cross-checked by two RPCs at one block. No execution handle is issued unless both signed assessments pass and the on-chain quote, caller quote, and oracle cross-rate satisfy the 50 bps-capped policy. Supported pairs are ETH/WETH, USDC, and WBTC on Ethereum; other routes fail closed.",
    "properties": {
     "destination": {
      "additionalProperties": false,
      "properties": {
       "decisionPriceUsd": {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "maxQuoteAgeSeconds": {
        "maximum": 300,
        "minimum": 1,
        "type": "integer"
       },
       "maxReferenceDeviationBps": {
        "maximum": 10000,
        "minimum": 0,
        "type": "integer"
       },
       "maxSlippageBps": {
        "maximum": 50,
        "minimum": 0,
        "type": "integer"
       },
       "quoteObservedAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       "quotePriceUsd": {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "quoteProvenance": {
        "additionalProperties": false,
        "properties": {
         "asset": {
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$",
          "type": "string"
         },
         "captureMethod": {
          "enum": [
           "client-held",
           "onchain-read"
          ],
          "type": "string"
         },
         "chainId": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
         },
         "quotePriceUsd": {
          "exclusiveMinimum": 0,
          "type": "number"
         },
         "requestHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         },
         "responseHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         },
         "rightsScope": {
          "enum": [
           "synthetic",
           "onchain",
           "customer-authorized",
           "vendor-licensed",
           "research-quarantined"
          ],
          "type": "string"
         },
         "schemaVersion": {
          "const": 1,
          "type": "number"
         },
         "sourceId": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "type": "string"
         }
        },
        "required": [
         "schemaVersion",
         "sourceId",
         "rightsScope",
         "captureMethod",
         "asset",
         "chainId",
         "quotePriceUsd",
         "observedAt",
         "requestHash",
         "responseHash"
        ],
        "type": "object"
       }
      },
      "required": [
       "decisionPriceUsd",
       "quotePriceUsd",
       "quoteObservedAt",
       "maxReferenceDeviationBps",
       "maxSlippageBps",
       "maxQuoteAgeSeconds",
       "quoteProvenance"
      ],
      "type": "object"
     },
     "routeQuoteObservedAt": {
      "description": "Timezone-qualified caller quote timestamp; checked for freshness as an additional condition",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     "routeQuotePrice": {
      "description": "Caller-reported destination-per-source route quote, compared with Insight's on-chain quote",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "source": {
      "additionalProperties": false,
      "properties": {
       "decisionPriceUsd": {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "maxQuoteAgeSeconds": {
        "maximum": 300,
        "minimum": 1,
        "type": "integer"
       },
       "maxReferenceDeviationBps": {
        "maximum": 10000,
        "minimum": 0,
        "type": "integer"
       },
       "maxSlippageBps": {
        "maximum": 50,
        "minimum": 0,
        "type": "integer"
       },
       "quoteObservedAt": {
        "format": "date-time",
        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
        "type": "string"
       },
       "quotePriceUsd": {
        "exclusiveMinimum": 0,
        "type": "number"
       },
       "quoteProvenance": {
        "additionalProperties": false,
        "properties": {
         "asset": {
          "pattern": "^[A-Za-z0-9_.:-]{1,80}$",
          "type": "string"
         },
         "captureMethod": {
          "enum": [
           "client-held",
           "onchain-read"
          ],
          "type": "string"
         },
         "chainId": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "type": "integer"
         },
         "observedAt": {
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
          "type": "string"
         },
         "quotePriceUsd": {
          "exclusiveMinimum": 0,
          "type": "number"
         },
         "requestHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         },
         "responseHash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
         },
         "rightsScope": {
          "enum": [
           "synthetic",
           "onchain",
           "customer-authorized",
           "vendor-licensed",
           "research-quarantined"
          ],
          "type": "string"
         },
         "schemaVersion": {
          "const": 1,
          "type": "number"
         },
         "sourceId": {
          "pattern": "^[A-Za-z0-9_.:-]{1,160}$",
          "type": "string"
         }
        },
        "required": [
         "schemaVersion",
         "sourceId",
         "rightsScope",
         "captureMethod",
         "asset",
         "chainId",
         "quotePriceUsd",
         "observedAt",
         "requestHash",
         "responseHash"
        ],
        "type": "object"
       }
      },
      "required": [
       "decisionPriceUsd",
       "quotePriceUsd",
       "quoteObservedAt",
       "maxReferenceDeviationBps",
       "maxSlippageBps",
       "maxQuoteAgeSeconds",
       "quoteProvenance"
      ],
      "type": "object"
     }
    },
    "required": [
     "source",
     "destination",
     "routeQuotePrice",
     "routeQuoteObservedAt"
    ],
    "type": "object"
   },
   "destinationAsset": {
    "description": "Destination asset symbol being bought, e.g. USDC, ETH",
    "type": "string"
   },
   "maxSlippageBps": {
    "const": 50,
    "description": "Current pre-committed execution tolerance; custom values are rejected",
    "type": "number"
   },
   "protocolId": {
    "description": "Optional lending protocol id (lending actions only)",
    "type": "string"
   },
   "sourceGroupCount": {
    "description": "Distinct non-derived operator groups; defaults to participantCount",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
