    "format": "date",
    "type": "string"
   },
   "property_id": {
    "description": "The property's id, from search_stays.",
    "type": "string"
   },
   "to": {
    "description": "Exclusive",
    "format": "date",
    "type": "string"
   }
  },
  "required": [
   "property_id",
   "from",
   "to"
  ],
  "type": "object"
 },
 "name": "check_availability",
