     "additionalProperties": true,
     "description": "One night.",
     "properties": {
      "available": {
       "type": "boolean"
      },
      "date": {
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "property_id": {
    "type": "string"
   },
   "timezone": {
    "type": "string"
   }
  },
  "type": "object"
 },
 "title": "Check a property's calendar"
}
