{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get contact timeline"
 },
 "description": "Get a unified, chronological feed of ALL items related to a contact \u2014 entries, tasks, and notes \u2014 sorted by date (most recent first). Much more efficient than fetching entries, tasks, and notes separately.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "from": {
    "description": "Start date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "id": {
    "description": "Contact UUID",
    "format": "uuid",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 20)",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "offset": {
    "description": "Pagination offset",
    "minimum": 0,
    "type": "integer"
   },
   "to": {
    "description": "End date filter (YYYY-MM-DD)",
    "type": "string"
   },
   "type": {
    "description": "Filter by item type (default: all)",
    "enum": [
     "all",
     "entries",
     "tasks",
     "notes"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_contact_timeline"
}
