{
 "description": "Run a command and detect if it hangs or enters an infinite loop. Returns hang status, location, and stack trace if hung.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "args": {
    "description": "Command arguments (e.g., [\"test.js\"])",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "command": {
    "description": "The command to execute (e.g., \"node\", \"npm\")",
    "type": "string"
   },
   "cwd": {
    "description": "Working directory for the process",
    "type": "string"
   },
   "sampleInterval": {
    "description": "Sample interval in milliseconds for infinite loop detection (e.g., 100)",
    "type": "number"
   },
   "timeout": {
    "description": "Timeout in milliseconds (e.g., 5000)",
    "type": "number"
   }
  },
  "required": [
   "command",
   "timeout"
  ],
  "type": "object"
 },
 "name": "debugger_detect_hang"
}
