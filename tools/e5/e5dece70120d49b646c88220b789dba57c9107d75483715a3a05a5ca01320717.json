{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Casts a server-time horary chart, checks chart fitness, and returns an auditable structural judgment plus outcome-confirmation hook.",
 "inputSchema": {
  "anyOf": [
   {
    "required": [
     "place"
    ]
   },
   {
    "required": [
     "latitude",
     "longitude",
     "timezone"
    ]
   }
  ],
  "properties": {
   "category": {
    "enum": [
     "career",
     "relationship",
     "money",
     "property",
     "travel",
     "lost-object",
     "general"
    ],
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "longitude": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "place": {
    "description": "Catalogue query or display label when explicit coordinates are supplied",
    "type": "string"
   },
   "question": {
    "maxLength": 500,
    "minLength": 3,
    "type": "string"
   },
   "timezone": {
    "description": "Required IANA timezone when explicit coordinates are supplied, for example Asia/Kolkata",
    "type": "string"
   },
   "timezoneOffset": {
    "description": "Optional fallback offset; derived from timezone and the requested local date when omitted",
    "maximum": 14,
    "minimum": -14,
    "type": "number"
   }
  },
  "required": [
   "question",
   "category"
  ],
  "type": "object"
 },
 "name": "calculate_prashna",
 "outputSchema": {
  "additionalProperties": true,
  "required": [
   "schemaVersion",
   "consultationId",
   "chartFitness",
   "judgment",
   "feedback",
   "safety"
  ],
  "type": "object"
 },
 "title": "Ask a Prashna question"
}
