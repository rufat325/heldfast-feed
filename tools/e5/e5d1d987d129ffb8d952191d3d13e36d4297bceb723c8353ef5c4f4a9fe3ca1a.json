{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "taptax:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List my transactions"
 },
 "description": "Read and search the signed-in person's own income and expense records in their TapTax account, newest first. Filter by tax year or dates, type, text in the description, or needsReview=true for the ones still waiting for a business-or-personal decision (the review queue). Needs no details from the person beyond what to look for.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "from": {
    "description": "On or after this date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "needsReview": {
    "type": "boolean"
   },
   "search": {
    "description": "Text to find in the description",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "taxYear": {
    "enum": [
     "2024-25",
     "2025-26",
     "2026-27"
    ],
    "type": "string"
   },
   "to": {
    "description": "On or before this date",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "type": {
    "enum": [
     "income",
     "expense"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "list_transactions",
 "title": "List my transactions"
}
