{
 "description": "Create a new record for a custom object schema.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "access_token": {
    "description": "CRM access token",
    "type": "string"
   },
   "associations": {
    "description": "Array of association objects linking this record to other records or contacts",
    "items": {},
    "type": "array"
   },
   "locationId": {
    "description": "Location / sub-account ID",
    "type": "string"
   },
   "location_id": {
    "description": "CRM sub-account location ID",
    "type": "string"
   },
   "owners": {
    "description": "Array of user IDs who own this record",
    "items": {},
    "type": "array"
   },
   "properties": {
    "additionalProperties": {},
    "description": "Key-value map of field values for the record",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "schemaKey": {
    "description": "Custom object schema key",
    "type": "string"
   }
  },
  "required": [
   "access_token",
   "schemaKey",
   "locationId",
   "properties"
  ],
  "type": "object"
 },
 "name": "crm_create_object_record"
}
