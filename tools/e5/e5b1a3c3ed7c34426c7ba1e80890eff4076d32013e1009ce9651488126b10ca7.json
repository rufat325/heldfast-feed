{
 "_meta": {
  "openai/outputTemplate": "ui://widget/bench.html",
  "openai/toolInvocation/invoked": "Vetted engineers found",
  "openai/toolInvocation/invoking": "Searching vetted engineers\u2026",
  "openai/widgetAccessible": true,
  "ui": {
   "resourceUri": "ui://widget/bench.html",
   "visibility": [
    "model",
    "app"
   ]
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Search Ruzora's Vetted Engineers"
 },
 "description": "See blind profiles of senior engineers in Latin America who already passed Ruzora's coding and interview vetting and are available now, filtered by stack, level and US-hours overlap.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "level": {
    "description": "Optional seniority filter",
    "enum": [
     "Mid",
     "Senior",
     "Staff"
    ],
    "type": "string"
   },
   "min_overlap_hours": {
    "description": "Optional minimum overlap with US working hours",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "page": {
    "description": "Optional page of results: 1 (default) is the best matches. Send 2, 3... only when the user asks to see more engineers for the same search; the previous result names the next page.",
    "maximum": 10,
    "minimum": 1,
    "type": "number"
   },
   "stack": {
    "description": "Technologies, e.g. [\"React\", \"Node\", \"AWS\"]",
    "items": {
     "maxLength": 40,
     "type": "string"
    },
    "maxItems": 8,
    "type": "array"
   }
  },
  "required": [
   "stack"
  ],
  "type": "object"
 },
 "name": "search_vetted_engineers",
 "title": "Search Ruzora's Vetted Engineers"
}
