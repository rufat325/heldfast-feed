{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "doctofam:read"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check DoctoFam plan and limits"
 },
 "description": "Use this when someone asks which DoctoFam plan a practice is on, whether it is active, or how many appointments, patients, rooms or users it allows. Returns the plan name, status, billing frequency and plan caps, or the default Free plan when none is active. Not for invoices or amounts billed.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "clinicId": {
    "description": "Practice id: 24 lowercase hexadecimal characters",
    "pattern": "^[0-9a-f]{24}$",
    "type": "string"
   }
  },
  "required": [
   "clinicId"
  ],
  "type": "object"
 },
 "name": "get_subscription_status",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "subscription": {
    "additionalProperties": false,
    "description": "The practice's active or past-due plan, or the default Free plan (isDefaultFreePlan) when neither exists. Seats are rooms; caps are limits, not usage. Billing identifiers, payment-provider data, amounts, currencies, patient records and clinical data are never returned.",
    "properties": {
     "billingFrequency": {
      "anyOf": [
       {
        "enum": [
         "MONTHLY",
         "YEARLY"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "isDefaultFreePlan": {
      "type": "boolean"
     },
     "lastEditTime": {
      "anyOf": [
       {
        "maxLength": 32,
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     },
     "maxNumberOfAppointments": {
      "anyOf": [
       {
        "maximum": 9007199254740991,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "maxNumberOfPatients": {
      "$ref": "#/properties/subscription/properties/maxNumberOfAppointments"
     },
     "maxNumberOfSeats": {
      "$ref": "#/properties/subscription/properties/maxNumberOfAppointments"
     },
     "maxNumberOfUsers": {
      "$ref": "#/properties/subscription/properties/maxNumberOfAppointments"
     },
     "productName": {
      "maxLength": 200,
      "type": "string"
     },
     "status": {
      "anyOf": [
       {
        "enum": [
         "ACTIVE",
         "PAST_DUE",
         "CANCELED"
        ],
        "type": "string"
       },
       {
        "type": "null"
       }
      ]
     }
    },
    "required": [
     "status",
     "productName",
     "billingFrequency",
     "maxNumberOfAppointments",
     "maxNumberOfPatients",
     "maxNumberOfSeats",
     "maxNumberOfUsers",
     "lastEditTime",
     "isDefaultFreePlan"
    ],
    "type": "object"
   }
  },
  "required": [
   "subscription"
  ],
  "type": "object"
 },
 "title": "Check DoctoFam plan and limits"
}
