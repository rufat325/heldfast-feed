{
 "annotations": {
  "destructiveHint": false,
  "readOnlyHint": false
 },
 "description": "Generate an AI meal plan for the given dates (creates draft meal sittings \u2014 async; poll with skylight_get_auto_creation_intent, then approve).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "add_to_grocery_list": {
    "type": "boolean"
   },
   "dates": {
    "description": "YYYY-MM-DD dates to generate meals for.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "frameId": {
    "type": "string"
   },
   "meal_category_id": {
    "description": "Meal category id (from skylight_list_meal_categories).",
    "type": [
     "string",
     "number"
    ]
   },
   "mouths_to_feed": {
    "description": "How many people to feed.",
    "type": "number"
   },
   "recipe_source": {
    "description": "Defaults to 'generate' (AI-generated).",
    "type": "string"
   }
  },
  "required": [
   "meal_category_id",
   "dates"
  ],
  "type": "object"
 },
 "name": "skylight_generate_meal_plan"
}
