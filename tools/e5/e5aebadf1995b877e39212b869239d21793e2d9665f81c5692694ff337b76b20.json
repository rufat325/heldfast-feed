{
 "description": "Update an existing campaign in the workspace",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artist_name": {
    "description": "Updated artist name",
    "type": "string"
   },
   "campaign_id": {
    "description": "Campaign ID to update",
    "type": "string"
   },
   "goal": {
    "description": "Updated campaign goal",
    "type": "string"
   },
   "name": {
    "description": "Updated campaign name",
    "type": "string"
   },
   "release_date": {
    "description": "Updated release date (YYYY-MM-DD)",
    "type": "string"
   },
   "release_name": {
    "description": "Updated release name",
    "type": "string"
   },
   "services": {
    "description": "Updated target channels",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "status": {
    "description": "Campaign status",
    "enum": [
     "draft",
     "active",
     "paused",
     "completed",
     "archived"
    ],
    "type": "string"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "tap_update_campaign"
}
