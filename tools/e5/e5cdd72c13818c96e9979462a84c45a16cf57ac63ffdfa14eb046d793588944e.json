{
 "description": "Start adding new content to an existing world pack. Returns generation prompts for the requested content types.",
 "inputSchema": {
  "properties": {
   "locationContext": {
    "description": "Location ID or description for contextual content",
    "type": "string"
   },
   "packId": {
    "description": "World pack ID to augment",
    "type": "string"
   },
   "request": {
    "description": "Content counts to generate",
    "properties": {
     "archetypes": {
      "description": "Number of archetypes to add",
      "type": "number"
     },
     "encounters": {
      "description": "Number of encounters to add",
      "type": "number"
     },
     "items": {
      "description": "Number of items to add",
      "type": "number"
     },
     "locations": {
      "description": "Number of locations to add",
      "type": "number"
     },
     "monsters": {
      "description": "Number of monsters to add",
      "type": "number"
     },
     "npcs": {
      "description": "Number of NPCs to add",
      "type": "number"
     }
    },
    "type": "object"
   },
   "theme": {
    "description": "Theme or focus for new content",
    "type": "string"
   }
  },
  "required": [
   "packId",
   "request"
  ],
  "type": "object"
 },
 "name": "start_augmentation"
}
