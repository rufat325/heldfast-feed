{
 "description": "Render data as ASCII charts. Types: progress (bar), sparkline (trend), heatmap (2D grid).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "colLabels": {
    "description": "Heatmap: column labels",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "data": {
    "description": "Heatmap: 2D array of numeric values",
    "items": {
     "items": {
      "type": "number"
     },
     "maxItems": 20,
     "type": "array"
    },
    "maxItems": 20,
    "type": "array"
   },
   "items": {
    "description": "Progress: multiple labeled bars",
    "items": {
     "properties": {
      "label": {
       "type": "string"
      },
      "percent": {
       "maximum": 100,
       "minimum": 0,
       "type": "number"
      }
     },
     "required": [
      "label",
      "percent"
     ],
     "type": "object"
    },
    "maxItems": 20,
    "type": "array"
   },
   "label": {
    "description": "Progress: label for single bar",
    "maxLength": 30,
    "type": "string"
   },
   "percent": {
    "description": "Progress: completion % (0-100)",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "rowLabels": {
    "description": "Heatmap: row labels",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "style": {
    "default": "default",
    "description": "Visual style (varies by type)",
    "type": "string"
   },
   "type": {
    "description": "Chart type",
    "enum": [
     "progress",
     "sparkline",
     "heatmap"
    ],
    "type": "string"
   },
   "values": {
    "description": "Sparkline: numeric values to chart",
    "items": {
     "type": "number"
    },
    "maxItems": 100,
    "type": "array"
   },
   "width": {
    "default": 20,
    "description": "Width in characters",
    "maximum": 50,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "type"
  ],
  "type": "object"
 },
 "name": "chart"
}
