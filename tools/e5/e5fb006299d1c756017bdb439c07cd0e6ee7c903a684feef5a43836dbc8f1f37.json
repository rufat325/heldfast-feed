{
 "annotations": {
  "idempotentHint": true,
  "readOnlyHint": true
 },
 "description": "Read-only validation of the exact run contract before execution or spend. Use after planning and before martin_run to check engine, verifier, path scope, and budget. Do not use as execution or completion proof. Next: call martin_run if allowed, otherwise resolve the reported blocker.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "allowedPaths": {
    "description": "Repo-relative path globs Martin may modify.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "context": {
    "description": "Optional issue context carried into the run contract.",
    "type": "string"
   },
   "deniedPaths": {
    "description": "Repo-relative path globs Martin must never modify.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "engine": {
    "description": "Which agent CLI would be used. Defaults to claude.",
    "enum": [
     "claude",
     "codex",
     "gemini",
     "openai"
    ],
    "type": "string"
   },
   "maxCommands": {
    "description": "Estimated maximum commands allowed for the run contract.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxFilesChanged": {
    "description": "Estimated maximum files changed for the run contract.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxIterations": {
    "description": "Maximum number of loop attempts.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxMinutes": {
    "description": "Estimated wall-clock minutes allowed for the run contract.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxTokens": {
    "description": "Maximum total tokens across all attempts.",
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "maxUsd": {
    "description": "Hard budget ceiling in USD.",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "model": {
    "description": "Model override passed to the CLI.",
    "type": "string"
   },
   "objective": {
    "description": "The coding task to validate.",
    "type": "string"
   },
   "policyPack": {
    "enum": [
     "solo-founder",
     "startup-team",
     "enterprise-strict",
     "oss-maintainer",
     "security-sensitive"
    ],
    "type": "string"
   },
   "projectId": {
    "type": "string"
   },
   "verificationPlan": {
    "description": "Commands that must all exit 0 for completion.",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "workingDirectory": {
    "description": "Optional repo-root override resolved under the MCP workspace root.",
    "type": "string"
   },
   "workspaceId": {
    "type": "string"
   }
  },
  "required": [
   "objective"
  ],
  "type": "object"
 },
 "name": "martin_preflight",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "execution": {
    "additionalProperties": false,
    "properties": {
     "engineAvailability": {
      "additionalProperties": true,
      "properties": {
       "available": {
        "type": "boolean"
       },
       "detail": {
        "type": "string"
       },
       "resolvedPath": {
        "type": "string"
       }
      },
      "required": [
       "available",
       "detail"
      ],
      "type": "object"
     },
     "expectedRunLayout": {
      "additionalProperties": false,
      "properties": {
       "loopRecordPathPattern": {
        "type": "string"
       },
       "runDirectoryPattern": {
        "type": "string"
       }
      },
      "required": [
       "runDirectoryPattern",
       "loopRecordPathPattern"
      ],
      "type": "object"
     },
     "pathScope": {
      "additionalProperties": false,
      "properties": {
       "allowedPathsCount": {
        "type": "integer"
       },
       "deniedPathsCount": {
        "type": "integer"
       },
       "hasScopeConflicts": {
        "type": "boolean"
       },
       "repoRoot": {
        "type": "string"
       }
      },
      "required": [
       "repoRoot",
       "allowedPathsCount",
       "deniedPathsCount",
       "hasScopeConflicts"
      ],
      "type": "object"
     },
     "requestedEngine": {
      "type": "string"
     },
     "runsRoot": {
      "type": "string"
     }
    },
    "required": [
     "requestedEngine",
     "engineAvailability",
     "runsRoot",
     "pathScope",
     "expectedRunLayout"
    ],
    "type": "object"
   },
   "normalized": {
    "additionalProperties": true,
    "properties": {
     "allowedPaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "budget": {
      "additionalProperties": false,
      "properties": {
       "maxIterations": {
        "type": "integer"
       },
       "maxTokens": {
        "type": "integer"
       },
       "maxUsd": {
        "type": "number"
       },
       "softLimitUsd": {
        "type": "number"
       }
      },
      "required": [
       "maxUsd",
       "softLimitUsd",
       "maxIterations"
      ],
      "type": "object"
     },
     "deniedPaths": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "engine": {
      "type": "string"
     },
     "model": {
      "type": "string"
     },
     "objective": {
      "type": "string"
     },
     "projectId": {
      "type": "string"
     },
     "verificationPlan": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "workingDirectory": {
      "type": "string"
     },
     "workspaceId": {
      "type": "string"
     }
    },
    "required": [
     "objective",
     "workingDirectory",
     "engine",
     "budget",
     "verificationPlan",
     "workspaceId",
     "projectId"
    ],
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   },
   "readiness": {
    "additionalProperties": false,
    "properties": {
     "engineReady": {
      "type": "boolean"
     },
     "liveMode": {
      "type": "boolean"
     },
     "mode": {
      "enum": [
       "live",
       "proof"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode",
     "liveMode",
     "engineReady"
    ],
    "type": "object"
   },
   "receiptScope": {
    "additionalProperties": false,
    "properties": {
     "invocationRoot": {
      "type": "string"
     },
     "repoRoot": {
      "type": "string"
     },
     "runsRoot": {
      "type": "string"
     },
     "workingDirectory": {
      "type": "string"
     }
    },
    "required": [
     "invocationRoot",
     "workingDirectory",
     "repoRoot",
     "runsRoot"
    ],
    "type": "object"
   },
   "summary": {
    "type": "string"
   },
   "warnings": {
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "ok",
   "summary",
   "warnings",
   "receiptScope",
   "readiness",
   "normalized",
   "execution"
  ],
  "type": "object"
 }
}
