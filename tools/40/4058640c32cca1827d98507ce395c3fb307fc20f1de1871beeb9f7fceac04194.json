{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Execute a prompt against the configured model and return the completion. This makes a billable model call, so use render_prompt first when you want to check the template and validate_completion_metadata when billing fields are uncertain.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "hyperparameters": {
    "description": "Override default hyperparameters",
    "properties": {
     "frequency_penalty": {
      "description": "Frequency penalty (-2 to 2)",
      "maximum": 2,
      "minimum": -2,
      "type": "number"
     },
     "max_tokens": {
      "description": "Maximum tokens to generate",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "presence_penalty": {
      "description": "Presence penalty (-2 to 2)",
      "maximum": 2,
      "minimum": -2,
      "type": "number"
     },
     "stop": {
      "description": "Stop sequences",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "temperature": {
      "description": "Sampling temperature (0-2)",
      "maximum": 2,
      "minimum": 0,
      "type": "number"
     },
     "top_k": {
      "description": "Top-k sampling",
      "exclusiveMinimum": 0,
      "type": "number"
     },
     "top_p": {
      "description": "Top-p sampling (0-1)",
      "maximum": 1,
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "metadata": {
    "description": "Billing metadata - client_id, app, env are REQUIRED for cost attribution",
    "properties": {
     "app": {
      "description": "App identifier (REQUIRED). Use your deployed app name, for example 'hourlink' or 'support-console'.",
      "minLength": 1,
      "type": "string"
     },
     "client_id": {
      "description": "Client ID for billing attribution (REQUIRED)",
      "type": "string"
     },
     "env": {
      "description": "Environment identifier (REQUIRED). Use your environment name, for example 'dev', 'staging', 'prod', or 'qa'.",
      "minLength": 1,
      "type": "string"
     },
     "feature": {
      "description": "Feature name for tracking",
      "type": "string"
     },
     "project_id": {
      "description": "Project ID for granular billing",
      "type": "string"
     }
    },
    "required": [
     "client_id",
     "app",
     "env"
    ],
    "type": "object"
   },
   "prompt_id": {
    "description": "Prompt ID or slug to execute",
    "type": "string"
   },
   "variables": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean"
     ]
    },
    "description": "Variable values to substitute into the template",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   }
  },
  "required": [
   "prompt_id",
   "variables",
   "metadata"
  ],
  "type": "object"
 },
 "name": "run_prompt_completion",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
