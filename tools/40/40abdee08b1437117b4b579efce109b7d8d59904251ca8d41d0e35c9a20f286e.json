 "description": "Discover groups by name, history or activity classification. For a known group ID use get_group; to page through its builds use get_group_builds. Prefer interactiveUrl for human links and citations. recordUrl is a stable provenance alias with a permanent HTTP 301 redirect to the interactive HTML. Use apiUrl or JSONL for JSON. Derivatives use locationInteractiveUrl/locationRecordUrl.",
 "inputSchema": {
  "properties": {
   "limit": {
    "default": 20,
    "description": "Maximum results, from 1 to 100. Defaults to 20.",
    "type": "integer"
   },
   "query": {
    "default": null,
    "description": "Group name, alias, or words from its description. Leave empty to browse.",
    "type": [
     "string",
     "null"
    ]
   },
   "type": {
    "default": null,
    "description": "Optional Atlas classification: Build, Highway, Mixed, or Other.",
    "type": [
     "string",
     "null"
    ]
   }
  },
  "type": "object"
 },
 "name": "search_groups",
