{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Score a proposed library plan against the nine OrchestrUI quality and licensing categories.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "existing_stack": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 20,
    "type": "array"
   },
   "includes_paid_content": {
    "default": false,
    "type": "boolean"
   },
   "redistributes_react_bits": {
    "default": false,
    "type": "boolean"
   },
   "rive_asset_rights": {
    "default": "not-applicable",
    "enum": [
     "confirmed",
     "unconfirmed",
     "not-applicable"
    ],
    "type": "string"
   },
   "selected_libraries": {
    "default": [],
    "items": {
     "maxLength": 80,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 7,
    "type": "array"
   },
   "verifications": {
    "default": [],
    "items": {
     "properties": {
      "category": {
       "enum": [
        "visual coherence",
        "library discipline",
        "accessibility",
        "responsiveness",
        "motion/reduced-motion",
        "data-viz readability",
        "Rive lifecycle/asset rights",
        "engineering checks/dependencies/secrets",
        "licensing/Pro/React Bits"
       ],
       "type": "string"
      },
      "evidence": {
       "maxLength": 500,
       "minLength": 1,
       "type": "string"
      },
      "status": {
       "enum": [
        "pass",
        "fail"
       ],
       "type": "string"
      }
     },
     "required": [
      "category",
      "status",
      "evidence"
     ],
     "type": "object"
    },
    "maxItems": 9,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "audit_plan",
 "title": "Audit an OrchestrUI plan"
}
