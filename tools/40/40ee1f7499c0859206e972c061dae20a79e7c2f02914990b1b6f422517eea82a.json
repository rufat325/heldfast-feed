{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compute an ideal two-body Keplerian orbit around one solar mass. Time starts at periapsis; distances use AU and time uses days. This model is not a real celestial ephemeris.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "eccentricity": {
    "maximum": 0.9,
    "minimum": 0,
    "type": "number"
   },
   "elapsed_days": {
    "maximum": 365250,
    "minimum": 0,
    "type": "number"
   },
   "semi_major_au": {
    "maximum": 30,
    "minimum": 0.1,
    "type": "number"
   }
  },
  "required": [
   "eccentricity",
   "elapsed_days",
   "semi_major_au"
  ],
  "type": "object"
 },
 "name": "compute_orbit",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "distance_au": {
    "maximum": 60,
    "minimum": 0,
    "type": "number"
   },
   "elapsed_ms": {
    "maximum": 1000000000000,
    "minimum": 0,
    "type": "number"
   },
   "engine": {
    "const": "rust-cpu",
    "type": "string"
   },
   "method": {
    "maxLength": 1024,
    "minLength": 1,
    "type": "string"
   },
   "orbit": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "x": {
       "maximum": 60,
       "minimum": -60,
       "type": "number"
      },
      "y": {
       "maximum": 60,
       "minimum": -60,
       "type": "number"
      }
     },
     "required": [
      "x",
      "y"
     ],
     "type": "object"
    },
    "maxItems": 241,
    "minItems": 241,
    "type": "array"
   },
   "period_days": {
    "maximum": 61000,
    "minimum": 0,
    "type": "number"
   },
   "position": {
    "additionalProperties": false,
    "properties": {
     "x": {
      "maximum": 60,
      "minimum": -60,
      "type": "number"
     },
     "y": {
      "maximum": 60,
      "minimum": -60,
      "type": "number"
     }
    },
    "required": [
     "x",
     "y"
    ],
    "type": "object"
   },
   "provenance": {
    "additionalProperties": false,
    "properties": {
     "client": {
      "additionalProperties": {},
      "properties": {
       "name": {
        "type": "string"
       },
       "version": {
        "type": "string"
       }
      },
      "required": [
       "name",
       "version"
      ],
      "type": "object"
     },
     "identity_source": {
      "type": "string"
     },
     "model": {
      "type": "null"
     },
     "server": {
      "const": "scorecompute",
      "type": "string"
     },
     "tool": {
      "const": "compute_orbit",
      "type": "string"
     }
    },
    "required": [
     "tool",
     "server",
     "client",
     "identity_source",
     "model"
    ],
    "type": "object"
   }
  },
  "required": [
   "distance_au",
   "elapsed_ms",
   "engine",
   "method",
   "orbit",
   "period_days",
   "position",
   "provenance"
  ],
  "type": "object"
 }
}
