{
 "description": "Run a composite trust screen across sanctions, registry, domain, email, and phone checks. Only completed checks are charged. Optionally long-polls when still running.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "checks": {
    "description": "Checks to run in parallel.",
    "items": {
     "enum": [
      "sanctions",
      "registry",
      "domain",
      "email",
      "phone"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "entity": {
    "additionalProperties": false,
    "description": "Entity identifiers \u2014 each check uses what it needs.",
    "properties": {
     "country": {
      "type": "string"
     },
     "domain": {
      "type": "string"
     },
     "email": {
      "type": "string"
     },
     "name": {
      "type": "string"
     },
     "phone": {
      "type": "string"
     },
     "registration_number": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "idempotency_key": {
    "description": "Optional Idempotency-Key header.",
    "type": "string"
   },
   "max_credits": {
    "description": "Hard spend cap; excess checks are skipped.",
    "type": "number"
   },
   "wait_seconds": {
    "description": "Long-poll up to N seconds when status is queued/running.",
    "maximum": 60,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "entity",
   "checks"
  ],
  "type": "object"
 },
 "name": "screen"
}
