{
 "description": "Pause, activate, or update excluded paths for a pixel.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "excludedPaths": {
    "anyOf": [
     {
      "items": {
       "maxLength": 500,
       "minLength": 2,
       "pattern": "^\\/.*",
       "type": "string"
      },
      "maxItems": 50,
      "type": "array"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "format": "uuid",
    "type": "string"
   },
   "status": {
    "enum": [
     "active",
     "paused"
    ],
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_pixel",
 "title": "Update Pixel"
}
