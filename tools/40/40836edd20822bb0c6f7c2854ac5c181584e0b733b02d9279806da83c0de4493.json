{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use this for a fully formed Dynamics 365 Business Central or Finance and Supply Chain Management transaction that needs central enforced authorization. CommerceGate evaluates line economics first and, only after policy clears, atomically authorizes the agent budget before returning the binary ALLOW or BLOCK decision used by the ERP enforcement shell. The tool can reserve budget and returns a reason-coded validation response; unlike the Shadow evaluator, it does not promise a retrievable dossier. It never writes, posts, releases, or modifies the ERP transaction itself. ALLOW is authorization evidence for the exact transaction, not user consent to perform the ERP write.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "erp_region": {
    "description": "ERP deployment region sent as X-ERP-Region.",
    "maxLength": 50,
    "minLength": 1,
    "type": "string"
   },
   "request": {
    "additionalProperties": false,
    "properties": {
     "agent_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     },
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "erp_type": {
      "enum": [
       "D365_BC",
       "D365_FSCM"
      ],
      "type": "string"
     },
     "lines": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "cost_base": {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        },
        "line_id": {
         "maximum": 2147483647,
         "minimum": 1,
         "type": "integer"
        },
        "quantity": {
         "exclusiveMinimum": 0,
         "maximum": 1000000000,
         "type": "number"
        },
        "sku": {
         "maxLength": 100,
         "minLength": 1,
         "type": "string"
        },
        "unit_price": {
         "maximum": 1000000000000,
         "minimum": 0,
         "type": "number"
        }
       },
       "required": [
        "line_id",
        "sku",
        "quantity",
        "unit_price",
        "cost_base"
       ],
       "type": "object"
      },
      "maxItems": 200,
      "minItems": 1,
      "type": "array"
     },
     "tenant_id": {
      "format": "uuid",
      "type": "string"
     },
     "timestamp": {
      "format": "date-time",
      "type": "string"
     },
     "transaction_id": {
      "maxLength": 160,
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "transaction_id",
     "erp_type",
     "tenant_id",
     "timestamp",
     "agent_id",
     "currency",
     "lines"
    ],
    "type": "object"
   }
  },
  "required": [
   "erp_region",
   "request"
  ],
  "type": "object"
 },
 "name": "commercegate_validate_erp_transaction",
 "title": "Validate an ERP Transaction"
}
