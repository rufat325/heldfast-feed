{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change a custom app's environment variables. For secret values, use the owner portal link from impreza_prepare_secret_entry rather than placing values in chat or tool arguments. Read current variables with impreza_api_call on /platform/deployments/custom/{id}/vars: masked values mean leave unchanged when passed back. Platform-managed keys such as DOMAIN_URL and HOST_PORT are ignored and listed in the response. Saving does not restart the app; explicitly call impreza_redeploy_deployment to apply changes while keeping the domain and port.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "deployment_id": {
    "description": "The dpl_\u2026 deployment id (from impreza_list_deployments).",
    "type": "string"
   },
   "set": {
    "description": "Variables to add or update, as flat key/value pairs. Keys are upper-cased.",
    "type": "object"
   },
   "unset": {
    "description": "Variable names to remove.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "required": [
   "deployment_id"
  ],
  "type": "object"
 },
 "name": "impreza_set_deployment_vars",
 "outputSchema": {
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "ignored_keys": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "ignored_note": {
      "type": "string"
     },
     "managed": {
      "type": [
       "object",
       "array"
      ]
     },
     "managed_keys": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "note": {
      "type": "string"
     },
     "vars": {
      "type": [
       "object",
       "array"
      ]
     }
    },
    "required": [
     "vars",
     "managed",
     "managed_keys",
     "note"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "additionalProperties": false,
      "properties": {
       "code": {
        "pattern": "^[A-Z][A-Z_0-9]{1,63}$",
        "type": "string"
       },
       "message": {
        "type": "string"
       },
       "next_steps": {
        "items": {
         "additionalProperties": false,
         "properties": {
          "action": {
           "type": "string"
          },
          "doc": {
           "pattern": "^https://docs[.]imprezahost[.]com/",
           "type": "string"
          },
          "missing": {
           "items": {
            "type": "string"
           },
           "type": "array"
          },
          "requires": {
           "type": "string"
          },
          "tool": {
           "type": "string"
          }
         },
         "required": [
          "action",
          "doc"
         ],
         "type": "object"
        },
        "minItems": 1,
        "type": "array"
       }
      },
      "required": [
       "code",
       "message",
       "next_steps"
      ],
      "type": "object"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Set app environment variables"
}
