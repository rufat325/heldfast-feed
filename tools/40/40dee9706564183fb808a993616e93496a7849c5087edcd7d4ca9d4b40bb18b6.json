{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create ruleset (TDD)"
 },
 "description": "Create a new rule ruleset with source text and test cases (TDD). Test cases are required. After creation, call aethis_generate_and_test.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "contract_version": {
    "const": 1,
    "description": "Required when acceptance expectations or expected_review_bindings are supplied.",
    "type": "number"
   },
   "domain": {
    "description": "Domain hint (e.g., 'uk_immigration')",
    "type": "string"
   },
   "expected_review_bindings": {
    "additionalProperties": {
     "additionalProperties": {
      "type": [
       "boolean",
       "null"
      ]
     },
     "type": "object"
    },
    "description": "Optional review-binding catalogue; omit for no assertion or use {} to assert zero bindings.",
    "type": "object"
   },
   "name": {
    "description": "Human-readable name for the rule ruleset",
    "type": "string"
   },
   "section_id": {
    "description": "Unique section identifier (e.g., 'flight_readiness')",
    "type": "string"
   },
   "source_text": {
    "description": "The source legislation, policy, or specification text",
    "type": "string"
   },
   "test_cases": {
    "description": "Test cases with optional strict acceptance expectations.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "expectations": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "pending_reviews": {
           "additionalProperties": false,
           "properties": {
            "resolution_fields": {
             "items": {
              "type": "string"
             },
             "maxItems": 500,
             "type": "array"
            },
            "unmapped_count": {
             "maximum": 500,
             "minimum": 0,
             "type": "integer"
            }
           },
           "required": [
            "unmapped_count"
           ],
           "type": "object"
          },
          "useful_unknown_fields": {
           "items": {
            "$ref": "#/properties/test_cases/items/properties/expectations/anyOf/0/properties/pending_reviews/properties/resolution_fields/items"
           },
           "maxItems": 500,
           "type": "array"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "expected_outcome": {
       "enum": [
        "eligible",
        "not_eligible",
        "undetermined"
       ],
       "type": "string"
      },
      "field_values": {
       "additionalProperties": {},
       "type": "object"
      },
      "name": {
       "minLength": 1,
       "type": "string"
      }
     },
     "required": [
      "name",
      "field_values",
      "expected_outcome"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "name",
   "section_id",
   "source_text",
   "test_cases"
  ],
  "type": "object"
 },
 "name": "aethis_create_ruleset"
}
