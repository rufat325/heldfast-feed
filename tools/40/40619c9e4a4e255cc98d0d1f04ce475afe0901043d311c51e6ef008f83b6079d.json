{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get recent news / patch notes for a game by appid (title, date, author, excerpt, link). Each excerpt is the first ~400 characters of the post with HTML stripped \u2014 follow `url` for the full text. An unknown/unassigned appid comes back as an empty list rather than an error, the same as get_global_achievements. Get the appid from search_games. No API key required.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "appid": {
    "description": "Steam application id (appid). Get it from search_games.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "limit": {
    "default": 5,
    "description": "How many news items (1-20). Default 5.",
    "exclusiveMinimum": 0,
    "maximum": 20,
    "type": "integer"
   }
  },
  "required": [
   "appid"
  ],
  "type": "object"
 },
 "name": "get_game_news",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "type": [
        "string",
        "null"
       ]
      },
      "excerpt": {
       "type": [
        "string",
        "null"
       ]
      },
      "feed": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "title",
      "date",
      "author",
      "feed",
      "excerpt",
      "url"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "items"
  ],
  "type": "object"
 },
 "title": "Get game news"
}
