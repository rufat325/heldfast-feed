    "description": "Buyer's company name",
    "type": "string"
   },
   "buyer_email": {
    "description": "Buyer's email address",
    "format": "email",
    "type": "string"
   },
   "buyer_name": {
    "description": "Buyer's full name",
    "type": "string"
   },
   "product_id": {
    "description": "Product ID (format: product_123)",
    "type": "string"
   },
   "quantity": {
    "description": "Number of units to purchase",
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "product_id",
   "quantity",
   "buyer_email"
  ],
  "type": "object"
 },
 "name": "quick_buy",
 "securitySchemes": [
  {
