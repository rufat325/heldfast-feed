{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Run a pivot table report with row and column dimensions.\n\n\u26a0\ufe0f TOKEN OPTIMIZATION: Pivot reports can be VERY large.\nLimit dimensions and use small date ranges. Recommended for analysis, not raw data extraction.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "dateRanges": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "endDate": {
       "description": "End date (YYYY-MM-DD or \"yesterday\", \"today\", \"7daysAgo\")",
       "type": "string"
      },
      "name": {
       "description": "Optional name for the date range",
       "type": "string"
      },
      "startDate": {
       "description": "Start date (YYYY-MM-DD or \"yesterday\", \"today\", \"7daysAgo\")",
       "type": "string"
      }
     },
     "required": [
      "startDate",
      "endDate"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "dimensions": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "name": {
       "type": "string"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "metrics": {
    "items": {
     "$ref": "#/properties/dimensions/items"
    },
    "type": "array"
   },
   "pivots": {
    "description": "Pivot specifications with fieldNames",
    "items": {
     "additionalProperties": false,
     "properties": {
      "fieldNames": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "limit": {
       "exclusiveMinimum": 0,
       "type": "integer"
      }
     },
     "required": [
      "fieldNames"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "propertyId": {
    "description": "GA4 property ID to query (overrides the default GA_PROPERTY_ID). Accepts \"123456789\" or \"properties/123456789\". Use ga_get_account_summaries to discover IDs.",
    "type": "string"
   }
  },
  "required": [
   "dateRanges",
   "metrics",
   "pivots"
  ],
  "type": "object"
 },
 "name": "ga_run_pivot_report"
}
