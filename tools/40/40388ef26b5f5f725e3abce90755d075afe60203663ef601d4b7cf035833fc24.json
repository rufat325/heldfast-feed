{
 "description": "Create an automation rule that reacts to events. Triggers: TEST_FAILED, TEST_RECOVERED, INCIDENT_CREATED, INCIDENT_RESOLVED, TARGET_DOWN, TARGET_RECOVERED. Actions: escalate (change severity), suppress (mute), rerun (schedule retry), notify, webhook, add_note.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "actions": {
    "description": "Actions to execute when triggered",
    "items": {
     "additionalProperties": false,
     "properties": {
      "delayMs": {
       "description": "Delay in ms before executing (for rerun action)",
       "maximum": 600000,
       "minimum": 0,
       "type": "integer"
      },
      "note": {
       "description": "Note text (for add_note action)",
       "maxLength": 1000,
       "type": "string"
      },
      "severity": {
       "description": "Target severity (for escalate action)",
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "type": {
       "description": "Action type",
       "enum": [
        "escalate",
        "suppress",
        "rerun",
        "notify",
        "webhook",
        "add_note"
       ],
       "type": "string"
      },
      "webhookUrl": {
       "description": "Webhook URL (for webhook action)",
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "type"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   },
   "conditions": {
    "additionalProperties": false,
    "description": "Optional conditions that must be met",
    "properties": {
     "minRecurrence": {
      "description": "Minimum finding recurrence count to trigger",
      "minimum": 1,
      "type": "integer"
     },
     "severities": {
      "description": "Only trigger for these severity levels",
      "items": {
       "enum": [
        "CRITICAL",
        "WARNING",
        "INFO"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "targetIds": {
      "description": "Only trigger for these target IDs",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "testSlugs": {
      "description": "Only trigger for these test slugs",
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "name": {
    "description": "Rule name",
    "maxLength": 100,
    "minLength": 1,
    "type": "string"
   },
   "priorityOrder": {
    "default": 0,
    "description": "Priority order (lower = evaluated first)",
    "type": "integer"
   },
   "targetId": {
    "description": "Optional target ID to scope rule to a specific target",
    "type": "string"
   },
   "trigger": {
    "description": "Event that triggers the rule",
    "enum": [
     "TEST_FAILED",
     "TEST_RECOVERED",
     "INCIDENT_CREATED",
     "INCIDENT_RESOLVED",
     "TARGET_DOWN",
     "TARGET_RECOVERED"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "trigger",
   "actions"
  ],
  "type": "object"
 },
 "name": "create_automation_rule",
 "title": "Create Automation Rule"
}
