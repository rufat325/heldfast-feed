    "description": "A city, to list its current WINs.",
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "limit": {
    "description": "How many WINs to list for a city (default 10).",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "listing_id": {
    "description": "The listing's public id (its slug), e.g. 2268-rice-st.",
    "maxLength": 80,
    "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
    "type": "string"
   }
  },
