{
 "description": "Raggruppa pi\u00f9 DDT, ordini, preventivi o rapportini in un unico documento (es. fattura riepilogativa di fine mese).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "company_id": {
    "description": "Azienda su cui operare. Default: FIC_COMPANY_ID o l'unica azienda del token",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "date": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dry_run": {
    "default": false,
    "type": "boolean"
   },
   "group": {
    "description": "Raggruppa le righe uguali",
    "type": "boolean"
   },
   "ids": {
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "minItems": 2,
    "type": "array"
   },
   "source_type": {
    "enum": [
     "delivery_notes",
     "orders",
     "quotes",
     "work_reports"
    ],
    "type": "string"
   }
  },
  "required": [
   "ids",
   "source_type"
  ],
  "type": "object"
 },
 "name": "join_documents"
}
