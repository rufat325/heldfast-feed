{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true
 },
 "description": "Update an existing SourceBuild project configuration",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "artifactBackup": {
    "description": "Backup artifacts",
    "type": "boolean"
   },
   "artifactBucket": {
    "description": "Object Storage bucket",
    "type": "string"
   },
   "artifactFilename": {
    "description": "Artifact filename",
    "type": "string"
   },
   "artifactPath": {
    "description": "Artifact paths",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "artifactStoragePath": {
    "description": "Path within bucket",
    "type": "string"
   },
   "artifactUse": {
    "description": "Save build artifacts",
    "type": "boolean"
   },
   "branch": {
    "description": "Branch to build from",
    "type": "string"
   },
   "buildCommands": {
    "description": "Build commands",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "cacheImage": {
    "description": "Cache image name",
    "type": "string"
   },
   "cacheLatest": {
    "description": "Set latest tag for cache",
    "type": "boolean"
   },
   "cacheRegistry": {
    "description": "Cache registry",
    "type": "string"
   },
   "cacheTag": {
    "description": "Cache image tag",
    "type": "string"
   },
   "cacheUse": {
    "description": "Save build image",
    "type": "boolean"
   },
   "computeId": {
    "description": "Compute type ID",
    "type": "number"
   },
   "description": {
    "description": "Project description",
    "type": "string"
   },
   "dockerId": {
    "description": "Docker engine version ID",
    "type": "number"
   },
   "dockerUse": {
    "description": "Include Docker engine",
    "type": "boolean"
   },
   "dockerbuildDockerfile": {
    "description": "Dockerfile path",
    "type": "string"
   },
   "dockerbuildImage": {
    "description": "Docker build image name",
    "type": "string"
   },
   "dockerbuildLatest": {
    "description": "Set latest tag",
    "type": "boolean"
   },
   "dockerbuildRegistry": {
    "description": "Docker build target registry",
    "type": "string"
   },
   "dockerbuildTag": {
    "description": "Docker build image tag",
    "type": "string"
   },
   "dockerbuildUse": {
    "description": "Enable Docker image build",
    "type": "boolean"
   },
   "envVars": {
    "description": "Build environment variables",
    "items": {
     "additionalProperties": false,
     "properties": {
      "key": {
       "type": "string"
      },
      "value": {
       "type": "string"
      }
     },
     "required": [
      "key",
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "image": {
    "description": "Image name",
    "type": "string"
   },
   "linkedCloudLogAnalytics": {
    "description": "Cloud Log Analytics integration",
    "type": "boolean"
   },
   "linkedFileSafer": {
    "description": "File Safer integration",
    "type": "boolean"
   },
   "osId": {
    "description": "OS ID (if platformType=SourceBuild)",
    "type": "number"
   },
   "platformType": {
    "description": "Platform type: SourceBuild | ContainerRegistry | PublicRegistry",
    "type": "string"
   },
   "postBuildCommands": {
    "description": "Post-build commands",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "preBuildCommands": {
    "description": "Pre-build commands",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "projectId": {
    "description": "Project ID to update",
    "type": "string"
   },
   "registryName": {
    "description": "Container Registry name",
    "type": "string"
   },
   "repository": {
    "description": "Source repository name",
    "type": "string"
   },
   "runtimeId": {
    "description": "Runtime type ID",
    "type": "number"
   },
   "runtimeVersionId": {
    "description": "Runtime version ID",
    "type": "number"
   },
   "sourceType": {
    "description": "Source repository type",
    "type": "string"
   },
   "tag": {
    "description": "Image tag",
    "type": "string"
   },
   "timeout": {
    "description": "Build timeout in minutes (5-540)",
    "type": "number"
   }
  },
  "required": [
   "projectId"
  ],
  "type": "object"
 },
 "name": "ncloud_sourcebuild_update_project"
}
