{
 "description": "Shared versioned artifacts between agents on the same daemon (and peers). put requires base_version (optimistic concurrency); lock is a short lease. Alias: memory_artifact.",
 "inputSchema": {
  "properties": {
   "action": {
    "description": "Artifact operation",
    "enum": [
     "list",
     "get",
     "put",
     "patch",
     "lock",
     "unlock",
     "watch_hint"
    ],
    "type": "string"
   },
   "base_version": {
    "description": "Required for concurrent-safe put; omit or 0 to create",
    "type": "integer"
   },
   "content": {
    "description": "Full content for put",
    "type": "string"
   },
   "find": {
    "description": "patch: substring to replace once",
    "type": "string"
   },
   "limit": {
    "description": "list limit",
    "type": "integer"
   },
   "path": {
    "description": "Logical path, e.g. notes/plan.md",
    "type": "string"
   },
   "prefix": {
    "description": "list: path prefix filter",
    "type": "string"
   },
   "replace": {
    "description": "patch: replacement",
    "type": "string"
   },
   "ttl_seconds": {
    "description": "lock lease length (default 60)",
    "type": "integer"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "cuba_artefacto"
}
