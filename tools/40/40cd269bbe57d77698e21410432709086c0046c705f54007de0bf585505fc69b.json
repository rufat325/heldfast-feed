{
 "_meta": {
  "openai/outputTemplate": "ui://widget/aviasurf-flight-results.html",
  "openai/toolInvocation/invoked": "Aviasurf results ready",
  "openai/toolInvocation/invoking": "Searching Aviasurf\u2026",
  "ui": {
   "resourceUri": "ui://widget/aviasurf-flight-results.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Find indicative flight prices"
 },
 "description": "Find cached indicative 'from' fares for a route and render interactive flight cards. Prices are per adult. These are historical observations, not live availability or booking offers. Always link the returned search_url from a short label in the answer language, for example \"Check live prices on Aviasurf\"; never paste the raw URL as text.",
 "inputSchema": {
  "additionalProperties": false,
  "not": {
   "required": [
    "depart_date",
    "depart_month"
   ]
  },
  "properties": {
   "currency": {
    "description": "Three-letter output currency. Set it only when the user explicitly requests a currency; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "depart_date": {
    "description": "Optional exact departure date. Omit both date fields for the cheapest observations across the cached horizon; do not combine with depart_month.",
    "format": "date",
    "type": "string"
   },
   "depart_month": {
    "description": "Optional departure month. Omit both date fields for the cheapest observations across the cached horizon; do not combine with depart_date.",
    "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$",
    "type": "string"
   },
   "destination": {
    "description": "Destination city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "direct": {
    "default": false,
    "description": "Request nonstop options only.",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "description": "Maximum number of public fare items to return.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "default": "en",
    "description": "Language locale for names and response text.",
    "pattern": "^[A-Za-z]{2}(?:-[A-Za-z]{2})?$",
    "type": "string"
   },
   "market": {
    "description": "Two-letter country market. Set it only when the user explicitly requests a country market or local Aviasurf site; otherwise the service derives it from the departure country.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "one_way": {
    "description": "Search a one-way trip; inferred from return_date when omitted.",
    "type": "boolean"
   },
   "origin": {
    "description": "Origin city or airport IATA code.",
    "pattern": "^[A-Za-z]{3}$",
    "type": "string"
   },
   "return_date": {
    "description": "Optional return date for a round trip.",
    "format": "date",
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
