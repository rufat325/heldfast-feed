{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search colleges"
 },
 "description": "Find U.S. colleges by name, state, public/private, and acceptance-rate range. Give a SAT score to rank schools by how close the student sits to each school's 75th percentile. Returns names to pass to the estimate tools.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "limit": {
    "description": "Results to return, default 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "maxAcceptanceRate": {
    "description": "Highest acceptance rate, in percent.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "minAcceptanceRate": {
    "description": "Lowest acceptance rate, in percent.",
    "maximum": 100,
    "minimum": 0,
    "type": "number"
   },
   "query": {
    "description": "Part of a college name.",
    "type": "string"
   },
   "sat": {
    "description": "Rank results by SAT fit.",
    "maximum": 1600,
    "minimum": 400,
    "type": "integer"
   },
   "state": {
    "description": "Two-letter state code.",
    "pattern": "^[A-Za-z]{2}$",
    "type": "string"
   },
   "type": {
    "enum": [
     "public",
     "private"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "search_colleges",
 "title": "Search U.S. colleges"
}
