{
 "description": "Check whether a stay is available for a date range. Dates are YYYY-MM-DD; end date is the check-out day (exclusive). Returns whether the range is free plus the listing's busy ranges.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "endDate": {
    "description": "Check-out, YYYY-MM-DD (exclusive).",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "slug": {
    "description": "The stay's slug.",
    "type": "string"
   },
   "startDate": {
    "description": "Check-in, YYYY-MM-DD.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "slug",
   "startDate",
   "endDate"
  ],
  "type": "object"
 },
 "name": "check_availability",
 "title": "Check a stay's availability"
}
