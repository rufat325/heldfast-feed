{
 "description": "Paid Strategy Backtest ($0.10 USDC). Tests built-in long-only spot strategies against bounded public Binance OHLCV history. Signals form at candle close and execute at the next candle open. Applies configured fees/slippage; accepts declarative parameters only and never executes user code. Historical results are not predictions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "end": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "fee_bps": {
    "default": 10,
    "maximum": 500,
    "minimum": 0,
    "type": "number"
   },
   "initial_capital": {
    "maximum": 100000000,
    "minimum": 10,
    "type": "number"
   },
   "market": {
    "pattern": "^[A-Z0-9]{4,20}$",
    "type": "string"
   },
   "slippage_bps": {
    "default": 5,
    "maximum": 500,
    "minimum": 0,
    "type": "number"
   },
   "start": {
    "format": "date",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
    "type": "string"
   },
   "strategy": {
    "additionalProperties": false,
    "properties": {
     "parameters": {
      "additionalProperties": {
       "type": "number"
      },
      "default": {},
      "propertyNames": {
       "type": "string"
      },
      "type": "object"
     },
     "type": {
      "enum": [
       "moving_average_crossover",
       "rsi_mean_reversion",
       "momentum",
       "breakout",
       "buy_and_hold"
      ],
      "type": "string"
     }
    },
    "required": [
     "type"
    ],
    "type": "object"
   },
   "timeframe": {
    "enum": [
     "1h",
     "4h",
     "1d"
    ],
    "type": "string"
   }
  },
  "required": [
   "market",
   "timeframe",
   "start",
   "end",
   "initial_capital",
   "strategy"
  ],
  "type": "object"
 },
 "name": "backtest_strategy",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": {},
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "meta": {
    "additionalProperties": false,
    "properties": {
     "cache": {
      "additionalProperties": false,
      "properties": {
       "age_ms": {
        "minimum": 0,
        "type": "number"
       },
       "hit": {
        "type": "boolean"
       }
      },
      "required": [
       "hit",
       "age_ms"
      ],
      "type": "object"
     },
     "failed_sources": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "reason": {
         "type": "string"
        },
        "source": {
         "type": "string"
        }
       },
       "required": [
        "source",
        "reason"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "latency_ms": {
      "minimum": 0,
      "type": "number"
     },
     "partial": {
      "type": "boolean"
     },
     "sources": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "sources",
     "latency_ms",
     "partial",
     "failed_sources",
     "cache"
    ],
    "type": "object"
   },
   "success": {
    "const": true,
    "type": "boolean"
   },
   "timestamp": {
    "format": "date-time",
    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
    "type": "string"
   },
   "tool": {
    "type": "string"
   }
  },
  "required": [
   "success",
   "tool",
   "timestamp",
   "data",
   "meta"
  ],
  "type": "object"
 }
}
