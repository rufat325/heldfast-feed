   "board_id": {
    "description": "The open Shoot Board's board_id, from Open Shoot Board or your context.",
    "type": "string"
   },
   "page": {
    "default": 1,
    "minimum": 1,
    "type": "integer"
   },
   "workflow_id": {
    "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
    "type": "string"
   }
  },
  "required": [
   "workflow_id",
   "board_id"
  ],
  "type": "object"
 },
 "name": "mcp_recipe_history",
