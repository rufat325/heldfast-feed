{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Find dispensing pharmacies"
 },
 "description": "Find UK pharmacies that dispense cannabis-based medicines against a prescription a clinic has already issued, by name, town or postcode, optionally only those that deliver. Returns up to 25 pharmacies with page URL, town and postcode, delivery and collection, and review score. A pharmacy cannot prescribe. It does not return stock, prices, or which products a pharmacy holds: those are shown only to patients and professionals with access. `query` is matched as text, not by distance. For one pharmacy in full, use get_listing.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "delivers": {
    "description": "Only pharmacies that offer delivery.",
    "type": "boolean"
   },
   "limit": {
    "description": "How many to return, 1-25. Default 10.",
    "maximum": 25,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Pharmacy name, town or postcode, matched as text (not by distance). Omit to list all.",
    "maxLength": 120,
    "type": "string"
   },
   "sort": {
    "description": "az (default), za, or by town.",
    "enum": [
     "az",
     "za",
     "city"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "find_pharmacies",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "note": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "city": {
       "type": [
        "string",
        "null"
       ]
      },
      "name": {
       "type": "string"
      },
      "offersCollection": {
       "type": "boolean"
      },
      "offersDelivery": {
       "type": "boolean"
      },
      "postcode": {
       "type": [
        "string",
        "null"
       ]
      },
      "rating": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "average": {
           "type": "number"
          },
          "count": {
           "type": "integer"
          }
         },
         "required": [
          "average",
          "count"
         ],
         "type": "object"
        },
        {
         "type": "null"
        }
       ],
       "description": "Published patient reviews; null when there are none"
      },
      "slug": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "anyOf": [
        {
         "format": "uri",
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Canonical Findabis page, absolute; null when the listing has no page"
      }
     },
     "required": [
      "name",
      "slug",
      "url",
      "city",
      "postcode",
      "offersDelivery",
      "offersCollection",
      "rating"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "description": "How many matched in all; narrow the query when this exceeds the results",
    "type": "integer"
   }
  },
  "required": [
   "results",
   "total"
  ],
  "type": "object"
 },
 "title": "Find dispensing pharmacies"
}
