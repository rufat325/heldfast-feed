{
 "description": "Expand one seed keyword into prioritized long-tail keyword ideas with search metrics.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "exact_match": {
    "default": false,
    "type": "boolean"
   },
   "ignore_synonyms": {
    "default": true,
    "type": "boolean"
   },
   "include_seed_keyword": {
    "default": true,
    "type": "boolean"
   },
   "keyword": {
    "description": "Seed keyword or topic",
    "minLength": 3,
    "type": "string"
   },
   "language": {
    "default": "en",
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 5,
    "type": "integer"
   },
   "location": {
    "default": "United States",
    "type": "string"
   },
   "location_code": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "min_search_volume": {
    "default": 0,
    "maximum": 1000000,
    "minimum": 0,
    "type": "integer"
   },
   "sync": {
    "default": true,
    "type": "boolean"
   }
  },
  "required": [
   "keyword"
  ],
  "type": "object"
 },
 "name": "agentseo_keyword_ideas_suggest",
 "title": "AgentSEO Keyword Ideas Suggest"
}
