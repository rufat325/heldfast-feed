{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Search projects, portfolios or goals. Filter by name substring, field values or sort the result. Use entityType \"goal\" for OKR goals, \"portfolio\" for project portfolios.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "entityType": {
    "description": "Entity type: \"project\", \"portfolio\" or \"goal\"",
    "enum": [
     "project",
     "portfolio",
     "goal"
    ],
    "type": "string"
   },
   "fields": {
    "description": "Comma-separated extra fields to include, e.g. \"entityStatus,author,followers\"",
    "type": "string"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Field filter, e.g. {\"entityStatus\": \"in_progress\", \"lead\": \"user1\"}",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "input": {
    "description": "Substring of the entity name",
    "type": "string"
   },
   "orderAsc": {
    "description": "Sort ascending (default false)",
    "type": "boolean"
   },
   "orderBy": {
    "description": "Field key to sort by, e.g. \"entityStatus\"",
    "type": "string"
   },
   "page": {
    "description": "Page number, default 1",
    "type": "number"
   },
   "perPage": {
    "description": "Results per page, default 50",
    "type": "number"
   },
   "rootOnly": {
    "description": "Only return top-level entities",
    "type": "boolean"
   }
  },
  "required": [
   "entityType"
  ],
  "type": "object"
 },
 "name": "search_entities"
}
