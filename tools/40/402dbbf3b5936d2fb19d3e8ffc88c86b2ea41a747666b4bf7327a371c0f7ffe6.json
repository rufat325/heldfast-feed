{
 "description": "Get directions with real-time traffic-aware ETA. Returns predictive travel time based on current traffic conditions.",
 "inputSchema": {
  "properties": {
   "destination": {
    "description": "End point as 'lat,lng'",
    "type": "string"
   },
   "origin": {
    "description": "Start point as 'lat,lng'",
    "type": "string"
   },
   "profile": {
    "description": "Travel mode (default: driving)",
    "enum": [
     "driving",
     "trucking",
     "biking",
     "walking"
    ],
    "type": "string"
   }
  },
  "required": [
   "origin",
   "destination"
  ],
  "type": "object"
 },
 "name": "get_directions_with_traffic"
}
