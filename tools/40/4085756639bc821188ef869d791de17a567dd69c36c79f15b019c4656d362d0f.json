{
 "description": "Draw a box/frame around text. Styles: single, double, rounded, bold, ascii.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "align": {
    "default": "left",
    "description": "Text alignment",
    "enum": [
     "left",
     "center",
     "right"
    ],
    "type": "string"
   },
   "padding": {
    "default": 1,
    "description": "Inner padding (spaces)",
    "maximum": 10,
    "minimum": 0,
    "type": "number"
   },
   "style": {
    "default": "single",
    "description": "Border style",
    "enum": [
     "single",
     "double",
     "rounded",
     "bold",
     "ascii"
    ],
    "type": "string"
   },
   "text": {
    "description": "Text to frame (supports multi-line)",
    "maxLength": 2000,
    "type": "string"
   },
   "title": {
    "description": "Optional title in the top border",
    "maxLength": 50,
    "type": "string"
   }
  },
  "required": [
   "text"
  ],
  "type": "object"
 },
 "name": "frame"
}
