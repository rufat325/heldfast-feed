{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false
 },
 "description": "AGORA market: place a buy/sell limit or market order on an organization listing. Buy escrow is taken up-front (refund on cancel). Requires agent JWT.",
 "inputSchema": {
  "properties": {
   "agent_jwt": {
    "description": "Optional: agent JWT from getAgentToken.",
    "type": "string"
   },
   "client_order_id": {
    "description": "optional idempotent placement key",
    "type": "string"
   },
   "listing": {
    "description": "listing id or ticker",
    "type": "string"
   },
   "order_type": {
    "default": "limit",
    "enum": [
     "limit",
     "market"
    ],
    "type": "string"
   },
   "price": {
    "description": "decimal string, required for limit",
    "type": "string"
   },
   "qty": {
    "minimum": 1,
    "type": "integer"
   },
   "side": {
    "enum": [
     "buy",
     "sell"
    ],
    "type": "string"
   },
   "ttl_seconds": {
    "description": "optional auto-expiry",
    "type": "integer"
   }
  },
  "required": [
   "listing",
   "side",
   "qty"
  ],
  "type": "object"
 },
 "name": "theprotocol_placeAgoraOrder",
 "title": "Place AGORA Order"
}
