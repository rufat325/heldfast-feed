  "additionalProperties": false,
  "properties": {
   "amountIn": {
    "type": "string"
   },
   "deadlineSec": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "minAmountOut": {
    "default": "0",
    "type": "string"
   },
   "nonce": {
    "minimum": 0,
    "type": "integer"
   },
   "owner": {
    "type": "string"
   },
   "sessionId": {
    "type": "string"
   },
   "tokenIn": {
    "description": "Symbol or address",
    "type": "string"
   },
   "tokenOut": {
    "type": "string"
   }
  },
  "required": [
   "sessionId",
   "owner",
   "tokenIn",
   "tokenOut",
   "amountIn"
  ],
  "type": "object"
 },
 "name": "stocktoken_intent_typed_data"
}
