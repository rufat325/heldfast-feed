{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Add columns to a sheet table"
 },
 "description": "Adds columns to the end of a table. Existing records leave them empty.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "approvalId": {
    "description": "Approval id from a prior needs_confirmation response. Omit on the first call.",
    "type": "string"
   },
   "columns": {
    "items": {
     "properties": {
      "description": {
       "description": "What the column holds \u2014 shown to people and to interfaces.",
       "maxLength": 1000,
       "type": "string"
      },
      "format": {
       "description": "Number columns.",
       "enum": [
        "plain",
        "currency",
        "percent"
       ],
       "type": "string"
      },
      "name": {
       "maxLength": 120,
       "minLength": 1,
       "type": "string"
      },
      "options": {
       "description": "Choices, for select and multi_select columns.",
       "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
       },
       "maxItems": 100,
       "type": "array"
      },
      "type": {
       "enum": [
        "text",
        "long_text",
        "number",
        "date",
        "checkbox",
        "select",
        "multi_select",
        "person",
        "url",
        "email"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "type"
     ],
     "type": "object"
    },
    "maxItems": 30,
    "minItems": 1,
    "type": "array"
   },
   "sheetId": {
    "description": "Sheet id from napkin_sheets_list.",
    "type": "string"
   },
   "table": {
    "description": "The table tab's name or id.",
    "type": "string"
   },
   "workspace": {
    "description": "Workspace slug. Personal tokens with no default workspace MUST pass this.",
    "type": "string"
   }
  },
  "required": [
   "sheetId",
   "table",
   "columns"
  ],
  "type": "object"
 },
 "name": "napkin_tables_add_columns",
 "title": "Add columns to a sheet table"
}
