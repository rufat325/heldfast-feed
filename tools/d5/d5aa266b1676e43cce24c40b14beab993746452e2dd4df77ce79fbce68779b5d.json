{
 "description": "Retrieve all projects (folders/lists) for the current user.\n\nWHEN TO USE:\n- Get an overview of all projects\n- Find a project ID before operating on tasks\n- Check project names, colors, and view modes\n\nRETURNS: Project list with id, name, color, viewMode, permissions, kind (TASK/NOTE).\n\n\ud83d\udca1 TIP: After getting the project list, use 'list_tasks' with projectId to get tasks, or 'get_project_data' for complete project data including tasks.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {},
  "type": "object"
 },
 "name": "list_projects",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "projects": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "closed": {
       "type": "boolean"
      },
      "color": {
       "type": "string"
      },
      "groupId": {
       "type": "string"
      },
      "id": {
       "type": "string"
      },
      "kind": {
       "enum": [
        "TASK",
        "NOTE"
       ],
       "type": "string"
      },
      "name": {
       "type": "string"
      },
      "permission": {
       "enum": [
        "read",
        "write",
        "comment"
       ],
       "type": "string"
      },
      "sortOrder": {
       "type": "number"
      },
      "viewMode": {
       "enum": [
        "list",
        "kanban",
        "timeline"
       ],
       "type": "string"
      }
     },
     "required": [
      "id",
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total": {
    "type": "number"
   }
  },
  "required": [
   "projects",
   "total"
  ],
  "type": "object"
 },
 "title": "List Projects"
}
