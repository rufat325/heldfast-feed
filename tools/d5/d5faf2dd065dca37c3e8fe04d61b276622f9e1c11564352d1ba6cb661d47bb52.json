{
 "annotations": {
  "readOnlyHint": true,
  "title": "List transactions (gifts)"
 },
 "description": "List transactions \u2014 donations, pledges, pledge payments, recurring donations and their payments \u2014 with their designations (fund, campaign, appeal). Filter by constituent, amount range, type or last-modified date. Read only. Bloomerang: GET /transactions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "constituent_ids": {
    "description": "Only these constituent (AccountId) Ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "ids": {
    "description": "Only these transaction Ids.",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "last_modified": {
    "description": "Only records last modified after this date/time (ISO 8601, e.g. 2026-01-31).",
    "type": "string"
   },
   "max_amount": {
    "description": "Maximum amount, inclusive.",
    "type": "number"
   },
   "min_amount": {
    "description": "Minimum amount, inclusive.",
    "type": "number"
   },
   "order_by": {
    "description": "Default Date.",
    "enum": [
     "Amount",
     "CreatedDate",
     "Date",
     "LastModifiedDate"
    ],
    "type": "string"
   },
   "order_direction": {
    "description": "Sort direction (default Desc).",
    "enum": [
     "Asc",
     "Desc"
    ],
    "type": "string"
   },
   "skip": {
    "description": "Records to skip (offset). Default 0.",
    "maximum": 9007199254740991,
    "minimum": 0,
    "type": "integer"
   },
   "take": {
    "description": "Page size, 1-50. Default 50.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "transaction_numbers": {
    "description": "Only these TransactionNumbers (called Payment Number in CRM reporting).",
    "items": {
     "exclusiveMinimum": 0,
     "maximum": 9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "types": {
    "description": "Only transactions with at least one designation of these types.",
    "items": {
     "enum": [
      "Donation",
      "Pledge",
      "PledgePayment",
      "RecurringDonation",
      "RecurringDonationPayment"
     ],
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "bloomerang_list_transactions",
 "title": "List transactions (gifts)"
}
