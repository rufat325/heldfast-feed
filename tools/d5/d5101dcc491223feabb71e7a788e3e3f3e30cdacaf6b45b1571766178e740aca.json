{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Web search"
 },
 "description": "Search the web and get the top results (title, URL, snippet) as clean JSON. Live Google results, any country or city. Use when you need current information, sources, or links. Price: $0.01 per successful call; failed calls are free.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "api_key": {
    "description": "Your Unstuck API key, if this connection has none. Leave empty to try free tools or to get a key and payment link.",
    "maxLength": 200,
    "type": "string"
   },
   "location": {
    "description": "Country or place to search from, e.g. \"Houston, TX\". Default \"United States\" (or the connection's default location).",
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "num": {
    "description": "How many results, default 10, max 20.",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "What to search for.",
    "maxLength": 300,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "web_search",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "balance_usd": {
    "description": "Remaining prepaid balance, USD.",
    "type": "number"
   },
   "charged_usd": {
    "description": "Amount charged for this call, USD.",
    "type": "number"
   },
   "location": {
    "description": "Location searched from.",
    "type": "string"
   },
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "domain": {
       "type": [
        "string",
        "null"
       ]
      },
      "position": {
       "description": "Rank among organic results, 1 = top.",
       "type": "number"
      },
      "snippet": {
       "type": [
        "string",
        "null"
       ]
      },
      "title": {
       "type": [
        "string",
        "null"
       ]
      },
      "url": {
       "type": [
        "string",
        "null"
       ]
      }
     },
     "required": [
      "position",
      "title",
      "url",
      "domain",
      "snippet"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "query",
   "location",
   "results",
   "charged_usd",
   "balance_usd"
  ],
  "type": "object"
 },
 "title": "Web search"
}
