{
 "description": "Upload all print files from a local folder to an uploader URL (non-recursive). Filters by extension.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "extensions": {
    "description": "Allowed extensions (default: .pdf,.jpg,.jpeg,.png)",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "folderPath": {
    "description": "Absolute path to the local folder",
    "minLength": 1,
    "type": "string"
   },
   "uploadUrl": {
    "format": "uri",
    "type": "string"
   }
  },
  "required": [
   "uploadUrl",
   "folderPath"
  ],
  "type": "object"
 },
 "name": "uploadFolderToUploader"
}
