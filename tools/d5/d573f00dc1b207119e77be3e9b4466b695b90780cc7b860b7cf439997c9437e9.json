{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Alert preview"
 },
 "description": "A free sample of procurements by terms and filters, or editable suggestions by CNPJ. It does not create alerts.",
 "inputSchema": {
  "properties": {
   "cnpj": {
    "description": "CNPJ to suggest up to 8 families of terms, without turning them on.",
    "type": "string"
   },
   "filtros": {
    "additionalProperties": false,
    "description": "Extra filter: modalities, municipalities, exclusions, values, open proposals and CNAEs. PATCH replaces the whole filter; {} clears it.",
    "properties": {
     "abertas": {
      "type": "boolean"
     },
     "cnaes": {
      "items": {
       "pattern": "^\\d{4}-?\\d/?\\d{2}$",
       "type": "string"
      },
      "maxItems": 8,
      "type": "array"
     },
     "excluir": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "modalidades": {
      "items": {
       "maximum": 19,
       "minimum": 1,
       "type": "integer"
      },
      "maxItems": 10,
      "type": "array"
     },
     "municipios": {
      "items": {
       "type": "string"
      },
      "maxItems": 10,
      "type": "array"
     },
     "valor_max": {
      "minimum": 0,
      "type": "number"
     },
     "valor_min": {
      "minimum": 0,
      "type": "number"
     }
    },
    "type": "object"
   },
   "termos": {
    "description": "Object terms; a space requires all words, | accepts alternatives.",
    "type": "string"
   },
   "uf": {
    "description": "State (UF) abbreviation; empty means all.",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "preview_alert",
 "securitySchemes": [
  {
   "type": "noauth"
  },
  {
   "scopes": [
    "mcp"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Alert preview"
}
