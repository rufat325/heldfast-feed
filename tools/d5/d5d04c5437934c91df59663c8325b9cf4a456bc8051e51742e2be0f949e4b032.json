{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Create and start a cold email campaign"
 },
 "description": "Queue a cold email campaign against a lead list. It starts sending as soon as the worker picks it up, so show the user the final subject, body and audience size and get their agreement before calling this. Use {{first_name}}, {{company}} style placeholders in the body. Sending speed defaults are conservative on purpose; do not raise them without being asked.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "body": {
    "description": "Email body as HTML or plain text, placeholders allowed",
    "type": "string"
   },
   "daily_limit": {
    "default": 200,
    "description": "Max emails per day",
    "maximum": 5000,
    "minimum": 1,
    "type": "integer"
   },
   "follow_ups": {
    "description": "Optional follow-up steps sent to non-repliers",
    "items": {
     "additionalProperties": false,
     "properties": {
      "body": {
       "description": "Follow-up body",
       "type": "string"
      },
      "delay_days": {
       "description": "Days after the previous step",
       "type": "integer"
      },
      "subject": {
       "description": "Subject, empty keeps the thread",
       "type": "string"
      }
     },
     "required": [
      "delay_days",
      "body"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "hourly_limit": {
    "default": 50,
    "description": "Max emails per hour",
    "maximum": 1000,
    "minimum": 1,
    "type": "integer"
   },
   "lead_filter": {
    "description": "Only send to leads with these verification statuses. Defaults to valid plus catch-all.",
    "items": {
     "description": "Status",
     "enum": [
      "valid",
      "catchall",
      "unknown",
      "invalid",
      "disposable"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "list_id": {
    "description": "Lead list to send to",
    "type": "integer"
   },
   "mailbox_ids": {
    "description": "Mailboxes to rotate through. Defaults to the active mailbox.",
    "items": {
     "type": "integer"
    },
    "type": "array"
   },
   "max_delay_seconds": {
    "default": 180,
    "description": "Maximum gap between sends",
    "minimum": 10,
    "type": "integer"
   },
   "min_delay_seconds": {
    "default": 45,
    "description": "Minimum gap between sends",
    "minimum": 5,
    "type": "integer"
   },
   "name": {
    "description": "Internal campaign name",
    "type": "string"
   },
   "subject": {
    "description": "Subject line, placeholders allowed",
    "type": "string"
   },
   "track_clicks": {
    "default": true,
    "description": "Track clicks",
    "type": "boolean"
   },
   "track_opens": {
    "default": true,
    "description": "Track opens",
    "type": "boolean"
   }
  },
  "required": [
   "name",
   "list_id",
   "subject",
   "body"
  ],
  "type": "object"
 },
 "name": "create_campaign",
 "title": "Create and start a cold email campaign"
}
