{
 "description": "Rank candidate games for a specific user with @buzzr/entertainment-engine v5: base entertainment score plus bounded personal-affinity and social adjustments. Returns the ranked list with per-game factor breakdowns.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "games": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "awayTeam": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "baseScore": {
       "anyOf": [
        {
         "maximum": 10,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Precomputed base entertainment score (1-10). Estimated when absent."
      },
      "engagement": {
       "additionalProperties": false,
       "description": "Fan engagement signals for the matchup.",
       "properties": {
        "averageRating": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "fireCount": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": 0,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "ratingCount": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": 0,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "skipCount": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": 0,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "type": "object"
      },
      "gameType": {
       "anyOf": [
        {
         "enum": [
          "regular",
          "playin",
          "playoff"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Regular season, play-in, or playoff."
      },
      "homeTeam": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "id": {
       "anyOf": [
        {
         "maxLength": 128,
         "minLength": 1,
         "type": "string"
        },
        {
         "type": "null"
        }
       ],
       "description": "Stable game id, used for social signals."
      },
      "injuries": {
       "additionalProperties": false,
       "description": "Injury impact per team.",
       "properties": {
        "away": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "home": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "type": "object"
      },
      "league": {
       "description": "League code, e.g. \"NBA\", \"NFL\", \"EPL\", \"WC\".",
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "narratives": {
       "additionalProperties": false,
       "description": "Narrative flags that boost buzz (rivalries, debuts, revenge games).",
       "properties": {
        "hasDebut": {
         "type": "boolean"
        },
        "isRivalry": {
         "type": "boolean"
        },
        "playerVsFormerTeam": {
         "type": "boolean"
        },
        "rivalryIntensity": {
         "anyOf": [
          {
           "const": 1,
           "type": "number"
          },
          {
           "const": 2,
           "type": "number"
          },
          {
           "const": 3,
           "type": "number"
          }
         ]
        }
       },
       "type": "object"
      },
      "odds": {
       "additionalProperties": false,
       "description": "Betting-market context for the game.",
       "properties": {
        "awayMoneyline": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "homeMoneyline": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "overUnder": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "spread": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ],
         "description": "Point spread relative to the home team."
        }
       },
       "type": "object"
      },
      "searchHeat": {
       "additionalProperties": false,
       "description": "Per-team search interest in [-1, 1].",
       "properties": {
        "away": {
         "anyOf": [
          {
           "maximum": 1,
           "minimum": -1,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "home": {
         "anyOf": [
          {
           "maximum": 1,
           "minimum": -1,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "type": "object"
      },
      "starPower": {
       "anyOf": [
        {
         "maximum": 1,
         "minimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Marquee player availability / skill density in [0, 1]."
      },
      "startsAt": {
       "description": "ISO 8601 kickoff/tip-off time, e.g. \"2026-07-06T19:30:00Z\".",
       "format": "date-time",
       "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
       "type": "string"
      },
      "status": {
       "description": "Game status. The model only predicts games that are not in progress.",
       "enum": [
        "scheduled",
        "in_progress",
        "final",
        "postponed",
        "cancelled"
       ],
       "type": "string"
      },
      "teamPower": {
       "additionalProperties": false,
       "description": "Team power ratings.",
       "properties": {
        "away": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        },
        "home": {
         "anyOf": [
          {
           "maximum": 1000000000,
           "minimum": -1000000000,
           "type": "number"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "type": "object"
      }
     },
     "required": [
      "league",
      "homeTeam",
      "awayTeam",
      "startsAt"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "description": "Return only the top N games.",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "integer"
   },
   "profile": {
    "additionalProperties": false,
    "default": {},
    "description": "The user taste profile used to personalize the ranking.",
    "properties": {
     "favoriteLeagues": {
      "items": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 0,
      "type": "array"
     },
     "favoriteTeams": {
      "items": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "maxItems": 50,
      "minItems": 0,
      "type": "array"
     },
     "leagueAffinity": {
      "additionalProperties": {
       "maximum": 1,
       "minimum": -1,
       "type": "number"
      },
      "description": "Per-league affinity in [-1, 1], keyed by league code.",
      "propertyNames": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "type": "object"
     },
     "socialSignal": {
      "additionalProperties": {
       "maximum": 1,
       "minimum": -1,
       "type": "number"
      },
      "description": "Fire-ratio in [-1, 1], keyed by game id.",
      "propertyNames": {
       "maxLength": 128,
       "minLength": 1,
       "type": "string"
      },
      "type": "object"
     },
     "teamAffinity": {
      "additionalProperties": {
       "maximum": 1,
       "minimum": -1,
       "type": "number"
      },
      "description": "Per-team affinity in [-1, 1], keyed by team name.",
      "propertyNames": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "type": "object"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "games",
   "profile"
  ],
  "type": "object"
 },
 "name": "rank_games",
 "title": "Rank games for a user"
}
