{
 "description": "Copia molti documenti in una volta, es. tutte le fatture di settembre con data di oggi. dry_run \u00e8 TRUE per default: controlla l'anteprima, poi rilancia con dry_run=false.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "company_id": {
    "description": "Azienda su cui operare. Default: FIC_COMPANY_ID o l'unica azienda del token",
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "date": {
    "description": "Data delle copie, default oggi",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "dry_run": {
    "default": true,
    "type": "boolean"
   },
   "ids": {
    "description": "Documenti espliciti",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "overrides": {
    "description": "Applicate a tutte le copie",
    "properties": {
     "items": {
      "description": "Modifiche alle singole righe (importo, quantit\u00e0, descrizione)",
      "items": {
       "properties": {
        "description": {
         "type": "string"
        },
        "gross_price": {
         "type": "number"
        },
        "index": {
         "description": "Posizione della riga, da 0",
         "maximum": 9007199254740991,
         "minimum": 0,
         "type": "integer"
        },
        "name": {
         "type": "string"
        },
        "net_price": {
         "type": "number"
        },
        "qty": {
         "type": "number"
        }
       },
       "required": [
        "index"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "items_list": {
      "description": "Sostituisce tutte le righe",
      "items": {
       "additionalProperties": {},
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      },
      "type": "array"
     },
     "notes": {
      "type": "string"
     },
     "numeration": {
      "description": "Sezionale, es. '/A'",
      "type": "string"
     },
     "subject": {
      "type": "string"
     },
     "type": {
      "description": "Cambia tipo nella copia, es. proforma \u2192 invoice",
      "enum": [
       "invoice",
       "quote",
       "proforma",
       "receipt",
       "delivery_note",
       "credit_note",
       "order",
       "work_report",
       "supplier_order",
       "self_own_invoice",
       "self_supplier_invoice"
      ],
      "type": "string"
     },
     "visible_subject": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "q": {
    "description": "In alternativa a ids: filtro, es. \"date >= '2026-09-01' and date <= '2026-09-30'\"",
    "type": "string"
   },
   "type": {
    "description": "Con q: tipo da cercare (default invoice)",
    "enum": [
     "invoice",
     "quote",
     "proforma",
     "receipt",
     "delivery_note",
     "credit_note",
     "order",
     "work_report",
     "supplier_order",
     "self_own_invoice",
     "self_supplier_invoice"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "bulk_duplicate"
}
