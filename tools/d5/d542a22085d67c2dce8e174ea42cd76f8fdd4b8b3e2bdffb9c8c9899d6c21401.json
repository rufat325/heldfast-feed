  "title": "Get campaign metrics"
 },
 "description": "Get delivery/engagement metrics for a campaign over time. App API: GET /v1/campaigns/{campaign_id}/metrics.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "campaign_id": {
    "description": "Campaign id.",
    "type": [
     "string",
     "number"
    ]
   },
   "period": {
    "description": "Bucket size. Default days.",
    "enum": [
     "hours",
     "days",
     "weeks",
     "months"
    ],
    "type": "string"
   },
   "steps": {
    "description": "Number of periods to return.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "type": {
    "description": "Metric type filter (e.g. email, push, sms).",
    "type": "string"
   }
  },
  "required": [
   "campaign_id"
  ],
  "type": "object"
 },
 "name": "customerio_get_campaign_metrics",
 "title": "Get campaign metrics"
}
