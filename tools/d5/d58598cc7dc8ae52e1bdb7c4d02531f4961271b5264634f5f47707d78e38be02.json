{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List subnets available for creating a Cloud DB for Cache instance in a VPC",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "cloudCacheImageProductCode": {
    "description": "Cache image product code (from ncloud_get_cache_image_products)",
    "type": "string"
   },
   "isPublic": {
    "description": "true: public subnets only, false: private subnets only",
    "type": "boolean"
   },
   "regionCode": {
    "description": "Region code (e.g., KR, JPN, SGN)",
    "type": "string"
   },
   "vpcNo": {
    "description": "VPC number (from ncloud_get_cache_target_vpcs)",
    "type": "string"
   }
  },
  "required": [
   "vpcNo",
   "cloudCacheImageProductCode"
  ],
  "type": "object"
 },
 "name": "ncloud_get_cache_target_subnets"
}
