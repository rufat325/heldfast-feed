 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create marketing poster"
 },
 "description": "Create a saved marketing poster (a grid of cards for the Marketing Builder). kind fixes the entity type: 'speakers', 'sponsors' or 'attendees'. entity_ids are the ids of the entities to show on the poster (get them from list_speakers/list_sponsors/list_attendees). cols_desktop/cols_mobile are grid columns; png_cols is the cards-per-row used for PNG export; card_urls carries hosted card PNGs ({fp: templateFingerprint, urls: {cardId: url}}).",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "card_urls": {
    "anyOf": [
     {
      "additionalProperties": true,
      "type": "object"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "cols_desktop": {
    "default": 3,
    "type": "integer"
   },
   "cols_mobile": {
    "default": 1,
    "type": "integer"
   },
   "entity_ids": {
    "anyOf": [
     {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "event_id": {
    "type": "string"
   },
   "kind": {
    "enum": [
     "speakers",
     "sponsors",
     "attendees"
    ],
    "type": "string"
   },
   "name": {
    "type": "string"
   },
   "png_cols": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   }
  },
  "required": [
   "event_id",
   "kind",
   "name"
  ],
  "type": "object"
 },
 "name": "create_marketing_poster",
 "outputSchema": {
  "additionalProperties": true,
  "type": "object"
 },
 "title": "Create marketing poster"
}
