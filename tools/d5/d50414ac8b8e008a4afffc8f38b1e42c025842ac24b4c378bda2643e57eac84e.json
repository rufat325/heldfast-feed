{
 "annotations": {
  "readOnlyHint": true,
  "title": "Suggest adventures"
 },
 "description": "Suggest candidate adventures near a location by scoring nearby trails/parks/campgrounds deterministically.",
 "inputSchema": {
  "properties": {
   "lat": {
    "type": "number"
   },
   "lng": {
    "type": "number"
   },
   "max_results": {
    "default": 20,
    "type": "integer"
   },
   "radius_miles": {
    "default": 100,
    "type": "integer"
   },
   "trail_difficulty": {
    "default": null,
    "type": [
     "null",
     "string"
    ]
   },
   "types": {
    "default": [
     "trail",
     "park",
     "campground"
    ],
    "type": "array"
   }
  },
  "required": [
   "lat",
   "lng"
  ],
  "type": "object"
 },
 "name": "adventure.candidates"
}
