{
 "_meta": {
  "openai/outputTemplate": "ui://widget/blumee-offers-v2.html",
  "openai/toolInvocation/invoked": "Catalog results ready",
  "openai/toolInvocation/invoking": "Browsing the catalog\u2026",
  "ui": {
   "resourceUri": "ui://widget/blumee-offers-v2.html"
  }
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Browse catalog"
 },
 "description": "List offers by exact attributes: flower, colour, occasion, shop, price range, delivery time, with sorting and paging. Use this to answer \"what does shop X have\", \"cheapest tulips\", or to page through everything matching a filter. The first call (no cursor) also returns available_values \u2014 the valid flower, colour, occasion and shop values. For free-form wishes use search_flower_offers.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "colors": {
    "description": "Colour values exactly as listed in available_values.colors.",
    "items": {
     "maxLength": 32,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "cursor": {
    "description": "next_cursor from a previous browse_catalog call, for the next page.",
    "maxLength": 512,
    "minLength": 1,
    "type": "string"
   },
   "flowers": {
    "description": "German flower names exactly as listed in available_values.flowers (e.g. \"Rose\", \"Tulpe\").",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "limit": {
    "description": "How many offers to return (default 8, max 20).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "max_delivery_days": {
    "description": "Latest acceptable delivery, in days from today, for an address in Germany (1 = tomorrow). If the user names a date, convert it to days. Hard filter on the shop-stated delivery time.",
    "maximum": 30,
    "minimum": 1,
    "type": "integer"
   },
   "max_price_eur": {
    "description": "Upper price limit in EUR, inclusive. Hard filter.",
    "exclusiveMinimum": 0,
    "maximum": 10000,
    "type": "number"
   },
   "min_price_eur": {
    "description": "Lower price limit in EUR. Hard filter.",
    "maximum": 10000,
    "minimum": 0,
    "type": "number"
   },
   "occasions": {
    "description": "Occasion keywords, e.g. \"birthday\", \"valentines\", \"Geburtstag\". Matched as substrings.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "shops": {
    "description": "Shop names exactly as listed in available_values.shops.",
    "items": {
     "maxLength": 64,
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 10,
    "type": "array"
   },
   "sort": {
    "description": "Result order. Default mixes shops.",
    "enum": [
     "default",
     "price_asc",
     "price_desc",
     "newest"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "browse_catalog",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "available_values": {
    "additionalProperties": false,
    "properties": {
     "colors": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "flowers": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "occasions": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "price_range_eur": {
      "additionalProperties": false,
      "properties": {
       "maxEur": {
        "type": "number"
       },
       "minEur": {
        "type": "number"
       }
      },
      "required": [
       "minEur",
       "maxEur"
      ],
      "type": "object"
     },
     "shops": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "flowers",
     "colors",
     "occasions",
     "shops",
     "price_range_eur"
    ],
    "type": "object"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   },
   "offers": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "buy_url": {
       "description": "Link to order at the partner shop, via Blumee. Show this to the user.",
       "format": "uri",
       "type": "string"
      },
      "colors": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "currency": {
       "type": "string"
      },
      "delivery": {
       "additionalProperties": false,
       "properties": {
        "area": {
         "const": "DE",
         "type": "string"
        },
        "cost_eur": {
         "type": [
          "number",
          "null"
         ]
        },
        "days_max": {
         "anyOf": [
          {
           "type": "integer"
          },
          {
           "type": "null"
          }
         ],
         "description": "Shop-stated delivery time to any address in Germany."
        },
        "days_min": {
         "anyOf": [
          {
           "type": "integer"
          },
          {
           "type": "null"
          }
         ]
        }
       },
       "required": [
        "days_min",
        "days_max",
        "cost_eur",
        "area"
       ],
       "type": "object"
      },
      "flowers": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "id": {
       "format": "uuid",
       "type": "string"
      },
      "image_url": {
       "description": "Product photo, ~640 px WebP on img.blumee.app (the shop original until it is mirrored).",
       "type": [
        "string",
        "null"
       ]
      },
      "occasion": {
       "type": [
        "string",
        "null"
       ]
      },
      "price": {
       "type": "number"
      },
      "shop": {
       "type": "string"
      },
      "similarity": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "Blumee product page (canonical).",
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "price",
      "currency",
      "image_url",
      "shop",
      "delivery",
      "flowers",
      "colors",
      "occasion",
      "url",
      "buy_url"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "total_matches": {
    "type": "integer"
   }
  },
  "required": [
   "total_matches",
   "offers",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "Browse catalog"
}
