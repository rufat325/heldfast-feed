{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true
 },
 "description": "Enroll a user in a course with a specified role.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "course_id": {
    "description": "The Canvas course ID",
    "type": "number"
   },
   "enrollment_state": {
    "description": "Initial enrollment state (defaults to invited)",
    "enum": [
     "active",
     "invited",
     "inactive"
    ],
    "type": "string"
   },
   "type": {
    "description": "The enrollment type",
    "enum": [
     "StudentEnrollment",
     "TeacherEnrollment",
     "TaEnrollment",
     "ObserverEnrollment",
     "DesignerEnrollment"
    ],
    "type": "string"
   },
   "user_id": {
    "description": "The Canvas user ID to enroll",
    "type": "number"
   }
  },
  "required": [
   "course_id",
   "user_id",
   "type"
  ],
  "type": "object"
 },
 "name": "enroll_user",
 "title": "Enroll User"
}
