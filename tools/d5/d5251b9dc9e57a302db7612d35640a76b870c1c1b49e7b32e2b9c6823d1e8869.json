{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Meta DX tool: scaffolds a new tdmcp tool file (xSchema + xImpl + registerX) and a matching offline msw unit test from a one-line idea. Returns the exact integration-hint (import line + array entry + layer index path) so the integrator can wire it without re-deciding shape. No TouchDesigner bridge call \u2014 pure local filesystem generator.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "description": {
    "description": "One-line MCP tool description",
    "minLength": 1,
    "type": "string"
   },
   "layer": {
    "default": "layer2",
    "description": "Destination layer directory under src/tools/",
    "enum": [
     "layer1",
     "layer2",
     "layer3",
     "library",
     "vault"
    ],
    "type": "string"
   },
   "name": {
    "description": "snake_case tool name, e.g. 'create_smoke_field'",
    "minLength": 1,
    "pattern": "^[a-z][a-z0-9_]*$",
    "type": "string"
   },
   "overwrite": {
    "default": false,
    "description": "Overwrite existing file if true",
    "type": "boolean"
   },
   "repo_root": {
    "description": "Repo root (default: process.cwd()); for tests use a tmpdir",
    "type": "string"
   },
   "surface": {
    "default": "bridge",
    "description": "Scaffold template variant",
    "enum": [
     "bridge",
     "layer1_build",
     "prompt",
     "local_only"
    ],
    "type": "string"
   }
  },
  "required": [
   "name",
   "description"
  ],
  "type": "object"
 },
 "name": "scaffold_tool_generator",
 "title": "Scaffold tool generator"
}
