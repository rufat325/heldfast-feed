{
 "description": "Create a new task in the Vaiz workspace",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "data": {
    "additionalProperties": false,
    "properties": {
     "assignees": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "boardId": {
      "minLength": 1,
      "type": "string"
     },
     "description": {
      "description": "Task document content in Markdown format. Supports headings, lists, code blocks, tables, etc. Converted to rich document content automatically.",
      "type": "string"
     },
     "dueEnd": {
      "type": "string"
     },
     "dueStart": {
      "type": "string"
     },
     "followers": {
      "additionalProperties": {
       "type": "string"
      },
      "type": "object"
     },
     "groupId": {
      "type": "string"
     },
     "milestones": {
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "name": {
      "minLength": 1,
      "type": "string"
     },
     "parentTask": {
      "type": "string"
     },
     "priority": {
      "default": "1",
      "enum": [
       "0",
       "1",
       "2",
       "3"
      ],
      "type": "string"
     },
     "types": {
      "items": {
       "type": "string"
      },
      "type": "array"
     }
    },
    "required": [
     "name",
     "boardId"
    ],
    "type": "object"
   }
  },
  "required": [
   "data"
  ],
  "type": "object"
 },
 "name": "create_task"
}
