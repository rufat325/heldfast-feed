{
 "description": "Compute a 0-100 Hound Score for a package version combining vulnerability severity, OpenSSF Scorecard, release recency, and license risk. Returns a letter grade (A-F) with a breakdown.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ecosystem": {
    "default": "npm",
    "description": "Package ecosystem (default: npm)",
    "enum": [
     "npm",
     "pypi",
     "go",
     "maven",
     "cargo",
     "nuget",
     "rubygems",
     "pub"
    ],
    "type": "string"
   },
   "name": {
    "description": "Package name",
    "type": "string"
   },
   "version": {
    "description": "Package version",
    "type": "string"
   }
  },
  "required": [
   "name",
   "version"
  ],
  "type": "object"
 },
 "name": "hound_score"
}
