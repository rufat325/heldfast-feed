{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Create a new contact in a Nextcloud address book with name, email, phone, address, organization, and other properties.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "addressBookName": {
    "default": "contacts",
    "description": "The address book name (default: 'contacts')",
    "type": "string"
   },
   "addresses": {
    "description": "Physical addresses",
    "items": {
     "properties": {
      "city": {
       "description": "City",
       "type": "string"
      },
      "country": {
       "description": "Country",
       "type": "string"
      },
      "postalCode": {
       "description": "Postal/ZIP code",
       "type": "string"
      },
      "region": {
       "description": "State or province",
       "type": "string"
      },
      "street": {
       "description": "Street address",
       "type": "string"
      },
      "type": {
       "description": "Address type",
       "enum": [
        "HOME",
        "WORK",
        "OTHER"
       ],
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "birthday": {
    "description": "Birthday in YYYY-MM-DD or YYYYMMDD format",
    "type": "string"
   },
   "categories": {
    "description": "Groups/categories for the contact",
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "emails": {
    "description": "Email addresses",
    "items": {
     "properties": {
      "type": {
       "description": "Email type",
       "enum": [
        "HOME",
        "WORK",
        "OTHER"
       ],
       "type": "string"
      },
      "value": {
       "description": "Email address",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "firstName": {
    "description": "First/given name",
    "type": "string"
   },
   "fullName": {
    "description": "The contact's full display name (required)",
    "type": "string"
   },
   "lastName": {
    "description": "Last/family name",
    "type": "string"
   },
   "note": {
    "description": "Notes about the contact",
    "type": "string"
   },
   "org": {
    "description": "Organization name",
    "type": "string"
   },
   "phones": {
    "description": "Phone numbers",
    "items": {
     "properties": {
      "type": {
       "description": "Phone type",
       "enum": [
        "HOME",
        "WORK",
        "CELL",
        "FAX",
        "PAGER",
        "OTHER"
       ],
       "type": "string"
      },
      "value": {
       "description": "Phone number",
       "type": "string"
      }
     },
     "required": [
      "value"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "prefix": {
    "description": "Name prefix (e.g. Dr., Mr.)",
    "type": "string"
   },
   "suffix": {
    "description": "Name suffix (e.g. Jr., III)",
    "type": "string"
   },
   "title": {
    "description": "Job title",
    "type": "string"
   },
   "url": {
    "description": "Website URL",
    "type": "string"
   }
  },
  "required": [
   "fullName"
  ],
  "type": "object"
 },
 "name": "create_contact",
 "title": "Create Contact"
}
