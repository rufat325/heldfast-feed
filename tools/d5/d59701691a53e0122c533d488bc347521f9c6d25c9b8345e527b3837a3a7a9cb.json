  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update an existing broadcast's name, message content, or media before sending. The broadcast must still be in draft status.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Unique identifier (UUID) of the broadcast to update",
    "type": "string"
   },
   "mediaUrl": {
    "description": "New media URL to attach",
    "type": "string"
   },
   "message": {
    "description": "New message content to broadcast",
    "type": "string"
   },
   "messageType": {
    "description": "New message type (e.g., 'text', 'image', 'document')",
    "type": "string"
   },
   "name": {
    "description": "New display name or label for the broadcast",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "neuron_update_broadcast",
 "title": "Update Broadcast"
}
