{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "OHLCV candles for a Hyperliquid market, computed from tick-level trades.",
 "inputSchema": {
  "properties": {
   "interval": {
    "description": "Candle interval (1m, 5m, 15m, 1h, 4h, 1d). Default: 1h",
    "enum": [
     "1m",
     "5m",
     "15m",
     "1h",
     "4h",
     "1d"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Number of candles to return (1-500, default 24)",
    "type": "number"
   },
   "market": {
    "description": "Market symbol \u2014 native HL perp (e.g. \"BTC-PERP\", \"ETH-PERP\") or HIP-3 builder market namespaced as \"<issuer>:<base>-PERP\" (e.g. \"flx:GAS-PERP\", \"xyz:NVDA-PERP\")",
    "type": "string"
   }
  },
  "required": [
   "market"
  ],
  "type": "object"
 },
 "name": "get_candles",
 "outputSchema": {
  "description": "OHLCV candles",
  "properties": {
   "data": {
    "description": "OHLCV candles",
    "items": {
     "description": "One row",
     "properties": {
      "base_market": {
       "description": "Display symbol without the HIP-3 issuer prefix"
      },
      "close": {
       "description": "Close price"
      },
      "display_symbol": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "high": {
       "description": "High price"
      },
      "interval": {
       "description": "Candle interval"
      },
      "issuer": {
       "description": "HIP-3 builder code (\"\" for native markets)"
      },
      "low": {
       "description": "Low price"
      },
      "market": {
       "description": "Display symbol, e.g. \"BTC-PERP\" or \"xyz:NVDA-PERP\""
      },
      "open": {
       "description": "Open price"
      },
      "quote_asset": {
       "description": "Quote asset, e.g. USDC"
      },
      "source": {
       "description": "Venue, always hyperliquid"
      },
      "timestamp": {
       "description": "Unix milliseconds"
      },
      "trade_count": {
       "description": "Trades in the candle"
      },
      "venue": {
       "description": "Venue, always hyperliquid"
      },
      "volume": {
       "description": "Volume in base units"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "pagination": {
    "description": "Cursor pagination",
    "properties": {
     "has_more": {
      "description": "Whether more rows exist"
     },
     "next_cursor": {
      "description": "Pass as cursor to fetch the next page; null on the last page"
     }
    },
    "type": "object"
   }
  },
  "type": "object"
 }
}
