  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "URL Unshorten & Redirect Check"
 },
 "description": "Follows a URL's HTTP redirects hop by hop (max 10, page bodies never read) and returns the final URL, status, the full chain and heuristic safety flags: shortener_used, cross_domain_redirect, https_downgrade, ip_address_host, punycode_host, userinfo_in_url, high_abuse_tld, credential_keyword_after_redirect, loops. Risk low/medium/high. Use before an agent clicks, fetches or forwards an unfamiliar or shortened link. Not a malware-reputation lookup. $0.01 USDC. Paid tool: call it once to get the x402 PaymentRequired object, then retry with params._meta[\"x402/payment\"].",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "url": {
    "description": "http(s) URL to expand. A bare host gets https:// added. Private/loopback hosts are refused.",
    "examples": [
     "https://bit.ly/3x402"
    ],
    "maxLength": 2048,
    "minLength": 4,
    "type": "string"
   }
  },
  "required": [
   "url"
  ],
  "type": "object"
 },
 "name": "url_unshorten",
 "title": "URL Unshorten & Redirect Check"
