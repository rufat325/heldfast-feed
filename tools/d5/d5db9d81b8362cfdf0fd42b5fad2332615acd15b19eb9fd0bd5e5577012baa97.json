    "default": 100,
    "description": "launches per call",
    "maximum": 100,
    "minimum": 1,
    "title": "Limit",
    "type": "integer"
   },
   "min_p_grad": {
    "default": 0.0,
    "description": "keep items whose P(true graduation) is at least this (0 = no floor)",
    "maximum": 1,
    "minimum": 0,
    "title": "Min P Grad",
    "type": "number"
   },
   "no_avoid": {
    "default": false,
    "description": "true or 1: leave out items whose verdict is avoid",
    "title": "No Avoid",
    "type": "boolean"
   },
   "since": {
