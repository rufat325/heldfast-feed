{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Get Jungle Scout estimated monthly sales units and revenue for a specific Amazon ASIN. Also returns current BSR, price, reviews, and rating to provide context for the estimate.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "asin": {
    "description": "Amazon ASIN. Example: B07XJ8C8F5",
    "pattern": "^[A-Z0-9]{10}$",
    "type": "string"
   },
   "end_date": {
    "description": "End date YYYY-MM-DD (must be before today). Defaults to yesterday.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "marketplace": {
    "default": "us",
    "description": "Amazon marketplace code. Defaults to 'us'.",
    "enum": [
     "us",
     "ca",
     "mx",
     "br",
     "uk",
     "de",
     "fr",
     "it",
     "es",
     "nl",
     "pl",
     "se",
     "tr",
     "ae",
     "in",
     "sg",
     "au",
     "jp"
    ],
    "type": "string"
   },
   "start_date": {
    "description": "Start date YYYY-MM-DD. Defaults to 30 days ago.",
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   }
  },
  "required": [
   "asin"
  ],
  "type": "object"
 },
 "name": "sales_estimates",
 "title": "Sales estimates"
}
