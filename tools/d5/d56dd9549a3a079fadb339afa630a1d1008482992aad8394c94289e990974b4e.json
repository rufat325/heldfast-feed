{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Builds a normal-person South Indian astrology report covering identity, mind, family, communication, home, learning, routines, relationships, change, beliefs, career, networks, rest, measured strengths, Vargas, structural Yogas, current Dasha and upcoming Antardashas. Interpretations remain qualified and evidence-linked.",
 "inputSchema": {
  "properties": {
   "asOfDate": {
    "description": "ISO date or instant for the current-timing section; defaults to now",
    "type": "string"
   },
   "birthTimeAccuracyMinutes": {
    "default": 5,
    "maximum": 1440,
    "minimum": 0,
    "type": "number"
   },
   "date": {
    "type": "string"
   },
   "focus": {
    "default": "general",
    "enum": [
     "general",
     "career",
     "marriage",
     "children",
     "education",
     "property",
     "health",
     "spirituality"
    ],
    "type": "string"
   },
   "horizonYears": {
    "default": 5,
    "maximum": 10,
    "minimum": 1,
    "type": "integer"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "type": "number"
   },
   "longitude": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "type": "string"
   },
   "time": {
    "type": "string"
   },
   "timezone": {
    "type": "string"
   },
   "timezoneOffset": {
    "type": "number"
   }
  },
  "required": [
   "name",
   "date",
   "time",
   "place",
   "latitude",
   "longitude",
   "timezoneOffset"
  ],
  "type": "object"
 },
 "name": "generate_full_life_report",
 "outputSchema": {
  "properties": {
   "anchors": {
    "type": "object"
   },
   "ashtakavarga": {
    "type": "object"
   },
   "aspects": {
    "type": "object"
   },
   "currentTiming": {
    "type": "object"
   },
   "divisionalChartAnchors": {
    "type": "object"
   },
   "measuredStrengths": {
    "type": "array"
   },
   "placements": {
    "type": "array"
   },
   "plainLanguageReading": {
    "type": "object"
   },
   "safety": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-full-life-report-1"
   },
   "sourceCoverage": {
    "type": "object"
   },
   "subject": {
    "type": "object"
   },
   "uncertainty": {
    "type": "object"
   }
  },
  "required": [
   "schemaVersion",
   "subject",
   "anchors",
   "plainLanguageReading",
   "placements",
   "measuredStrengths",
   "aspects",
   "ashtakavarga",
   "divisionalChartAnchors",
   "currentTiming",
   "sourceCoverage",
   "uncertainty",
   "safety"
  ],
  "type": "object"
 },
 "title": "Generate a complete evidence-linked life report"
}
