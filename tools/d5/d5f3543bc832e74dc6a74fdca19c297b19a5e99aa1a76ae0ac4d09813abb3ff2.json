{
 "_meta": {
  "openai/toolInvocation/invoked": "Comment threads read",
  "openai/toolInvocation/invoking": "Reading comment threads\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "List Artifact comment threads"
 },
 "description": "List the comment threads people left on one of your Artifacts, newest activity first. Pass activated_only: true to get only the threads where someone mentioned the agent, which are the ones you may reply to and resolve. Each thread carries its anchor (what it is pinned to), the version it was left on, a preview, and agent_activated.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "activated_only": {
    "description": "Only threads where the agent was mentioned.",
    "type": "boolean"
   },
   "after": {
    "description": "RFC 3339 date-time; only threads with activity after it.",
    "type": "string"
   },
   "artifact_id": {
    "description": "The Artifact id (art_\u2026).",
    "pattern": "^art_[a-zA-Z0-9]+$",
    "type": "string"
   },
   "cursor": {
    "description": "next_cursor from a prior page.",
    "type": "string"
   },
   "status": {
    "description": "Default open.",
    "enum": [
     "open",
     "resolved",
     "all"
    ],
    "type": "string"
   }
  },
  "required": [
   "artifact_id"
  ],
  "type": "object"
 },
 "name": "list_artifact_threads",
 "outputSchema": {
  "properties": {
   "artifact_id": {
    "type": "string"
   },
   "items": {
    "items": {
     "properties": {
      "agent_activated": {
       "description": "True once someone mentioned the agent; only then may the agent reply or resolve.",
       "type": "boolean"
      },
      "anchor": {
       "description": "Where the thread is pinned: kind element (selector, snapshot, slide), text (quote), or page.",
       "type": "object"
      },
      "artifact_id": {
       "type": "string"
      },
      "created_at": {
       "type": "string"
      },
      "created_by": {
       "description": "Who wrote it: { kind: \"user\", uid, name, handle, avatarUrl } or { kind: \"agent\", principal, name, via }.",
       "type": "object"
      },
      "last_message_at": {
       "type": "string"
      },
      "mentions": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "message_count": {
       "type": "integer"
      },
      "participants": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "preview": {
       "type": "string"
      },
      "resolved_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "root_message_id": {
       "type": "string"
      },
      "status": {
       "enum": [
        "open",
        "resolved"
       ],
       "type": "string"
      },
      "thread_id": {
       "type": "string"
      },
      "updated_at": {
       "type": "string"
      },
      "version_id": {
       "type": "string"
      },
      "version_number": {
       "type": "integer"
      }
     },
     "required": [
      "thread_id",
      "artifact_id",
      "status",
      "anchor",
      "version_number",
      "preview",
      "message_count",
      "agent_activated",
      "created_by",
      "created_at",
      "last_message_at"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_cursor": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "artifact_id",
   "items",
   "next_cursor"
  ],
  "type": "object"
 },
 "title": "List Artifact comment threads"
}
