{
 "description": "Create a Grok Imagine task on RunAPI (text to image). Returns a task id, status, and output URLs.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "aspect_ratio": {
    "anyOf": [
     {
      "const": "1:1",
      "type": "string"
     },
     {
      "const": "2:3",
      "type": "string"
     },
     {
      "const": "3:2",
      "type": "string"
     },
     {
      "const": "16:9",
      "type": "string"
     },
     {
      "const": "9:16",
      "type": "string"
     }
    ],
    "description": "Output aspect ratio."
   },
   "callback_url": {
    "description": "Webhook URL for terminal Task delivery.",
    "type": "string"
   },
   "enable_pro": {
    "description": "Not accepted by this model.",
    "type": "boolean"
   },
   "enable_safety_checker": {
    "description": "Not accepted by this model.",
    "type": "boolean"
   },
   "model": {
    "description": "RunAPI model slug for this model line.",
    "enum": [
     "grok-imagine-image-2-0",
     "grok-imagine-text-to-image"
    ],
    "type": "string"
   },
   "poll_interval_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "prompt": {
    "description": "Image generation prompt.",
    "type": "string"
   },
   "timeout_ms": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "wait": {
    "default": true,
    "description": "Poll until the task reaches a terminal status.",
    "type": "boolean"
   }
  },
  "required": [
   "prompt"
  ],
  "type": "object"
 },
 "name": "text_to_image"
}
