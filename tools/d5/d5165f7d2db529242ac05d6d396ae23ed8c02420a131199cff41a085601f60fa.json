 "annotations": {
  "destructiveHint": true,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false,
  "title": "Change campaign pause permission"
 },
 "description": "Change one platform auto-pause grant. Changes in one call. An optional expectedChangedAt detects changes since a prior read; without it the current revision is read automatically. Retain the stable UUID clientRequestId. Free; grants or removes permission to pause campaigns, without starting ads or raising budgets. Reconcile uncertain changes by reading current permissions. Full field guide: soclo://tools/soclo_ads_watch_auto_pause_set.",
 "icons": [
  {
   "mimeType": "image/png",
   "sizes": [
    "1024x1024"
   ],
   "src": "https://mcp.soclo.app/icon.png"
  }
 ],
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "clientRequestId": {
    "format": "uuid",
    "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
    "type": "string"
   },
   "confirm": {
    "type": "boolean"
   },
   "enabled": {
    "type": "boolean"
   },
   "expectedChangedAt": {
    "anyOf": [
     {
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "platform": {
    "enum": [
     "openai-ads",
     "tiktok-ads",
     "google",
     "linkedin-ads",
     "pinterest-ads",
     "x-ads"
    ],
    "type": "string"
   }
  },
  "required": [
