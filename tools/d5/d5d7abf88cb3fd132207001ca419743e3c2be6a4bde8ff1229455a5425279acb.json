{
 "description": "ATENCAO: altera producao. Avalia um chamado ja finalizado.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "comment": {
    "type": "string"
   },
   "custom_fields": {
    "description": "Campos personalizados em JSON objeto. Ex.: {\"ID_DO_CAMPO\":\"valor\"}.",
    "type": "string"
   },
   "grade": {
    "description": "5 otimo, 4 bom, 3 regular, 2 ruim, 1 pessimo.",
    "maximum": 5,
    "minimum": 1,
    "type": "integer"
   },
   "problem_solved": {
    "description": "1 se o problema foi resolvido.",
    "maximum": 1,
    "minimum": 0,
    "type": "integer"
   },
   "ticket_id": {
    "description": "Identificador do chamado (ticket_id).",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "ticket_id",
   "grade"
  ],
  "type": "object"
 },
 "name": "tomticket_evaluate_ticket"
}
