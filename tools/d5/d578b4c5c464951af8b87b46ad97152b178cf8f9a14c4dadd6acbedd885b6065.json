{
 "description": "Send the next turn in an open conversation. Rich content degrades to smsFallbackText on the SMS leg.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "conversationId": {
    "type": "string"
   },
   "expiresAt": {
    "type": "string"
   },
   "expiresIn": {
    "exclusiveMinimum": 0,
    "maximum": 2592000,
    "type": "integer"
   },
   "idempotencyKey": {
    "type": "string"
   },
   "media": {
    "additionalProperties": false,
    "properties": {
     "altText": {
      "description": "What the file says, for anyone who cannot see it. Required.",
      "type": "string"
     },
     "thumbnailUrl": {
      "type": "string"
     },
     "url": {
      "description": "https only \u2014 Google fetches it from their own infrastructure, so it must be publicly reachable.",
      "type": "string"
     }
    },
    "required": [
     "url",
     "altText"
    ],
    "type": "object"
   },
   "smsFallbackText": {
    "type": "string"
   },
   "suggestions": {
    "description": "Strings are reply chips; objects are action chips (openUrl, dial, calendar, location).",
    "items": {
     "anyOf": [
      {
       "maxLength": 25,
       "type": "string"
      },
      {
       "additionalProperties": false,
       "properties": {
        "action": {
         "additionalProperties": {},
         "description": "Exactly one of: {openUrl}, {dial}, {calendar:{title,startTime,endTime}}, {viewLocation:{query}} or {viewLocation:{lat,long}}, {shareLocation:true}.",
         "type": "object"
        },
        "smsFallback": {
         "type": "string"
        },
        "text": {
         "maxLength": 25,
         "type": "string"
        }
       },
       "required": [
        "text",
        "action"
       ],
       "type": "object"
      }
     ]
    },
    "maxItems": 11,
    "type": "array"
   },
   "text": {
    "type": "string"
   }
  },
  "required": [
   "conversationId"
  ],
  "type": "object"
 },
 "name": "cadence_send"
}
