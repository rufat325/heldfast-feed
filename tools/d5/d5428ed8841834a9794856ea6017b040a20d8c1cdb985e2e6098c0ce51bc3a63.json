{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Search or inspect the complete Godot\u2026",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "oneOf": [
   {
    "additionalProperties": true,
    "description": "Allowed option 1",
    "properties": {
     "action": {
      "const": "search"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   {
    "additionalProperties": true,
    "description": "Allowed option 2",
    "properties": {
     "action": {
      "const": "describe"
     }
    },
    "required": [
     "action",
     "toolName"
    ],
    "type": "object"
   }
  ],
  "properties": {
   "action": {
    "description": "Read-only catalog action",
    "enum": [
     "search",
     "describe"
    ],
    "type": "string"
   },
   "backend": {
    "description": "Optional execution-backend filter",
    "enum": [
     "process",
     "subprocess",
     "runtime",
     "runtime-buffer",
     "godot-cli",
     "local"
    ],
    "type": "string"
   },
   "detail": {
    "description": "Description detail.",
    "enum": [
     "summary",
     "schema",
     "full"
    ],
    "type": "string"
   },
   "domain": {
    "description": "Optional owning-domain filter",
    "enum": [
     "lifecycle",
     "project",
     "game"
    ],
    "type": "string"
   },
   "effect": {
    "description": "Optional effect-scope filter",
    "enum": [
     "read-only",
     "project-persistent",
     "runtime-ephemeral",
     "process",
     "external-open-world"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Maximum ranked search results.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "mutation": {
    "description": "Optional mutation-behavior filter",
    "enum": [
     "read-only",
     "mutating",
     "mixed"
    ],
    "type": "string"
   },
   "privilege": {
    "description": "Optional privilege filter",
    "enum": [
     "none",
     "required"
    ],
    "type": "string"
   },
   "query": {
    "description": "User intent, Godot concept, action,\u2026",
    "maxLength": 200,
    "type": "string"
   },
   "state": {
    "description": "Optional required-state filter",
    "enum": [
     "none",
     "project",
     "editor",
     "runtime"
    ],
    "type": "string"
   },
   "toolName": {
    "description": "Required for describe.",
    "pattern": "^[a-z][a-z0-9_]*$",
    "type": "string"
   }
  },
  "required": [
   "action"
  ],
  "type": "object"
 },
 "name": "godot_catalog",
 "outputSchema": {
  "additionalProperties": false,
  "oneOf": [
   {
    "not": {
     "required": [
      "error"
     ]
    },
    "properties": {
     "ok": {
      "const": true
     }
    },
    "required": [
     "data"
    ]
   },
   {
    "not": {
     "required": [
      "data"
     ]
    },
    "properties": {
     "ok": {
      "const": false
     }
    },
    "required": [
     "error"
    ]
   }
  ],
  "properties": {
   "data": {},
   "error": {
    "type": "object"
   },
   "meta": {
    "type": "object"
   },
   "ok": {
    "type": "boolean"
   }
  },
  "required": [
   "ok",
   "meta"
  ],
  "type": "object"
 },
 "title": "Godot Catalog"
}
