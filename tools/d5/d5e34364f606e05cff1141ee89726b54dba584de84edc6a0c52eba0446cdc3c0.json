{
 "description": "[tutorial+live] Get emitted events from a zkApp address via the Archive-Node-API. Events are state-change notifications emitted by zkApp account updates. Snapshot mode does not run an Archive-Node-API and rejects this tool.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "zkApp public key (B62...)",
    "type": "string"
   },
   "from": {
    "description": "Start block height (inclusive)",
    "type": "number"
   },
   "status": {
    "default": "ALL",
    "description": "Block status filter",
    "enum": [
     "ALL",
     "PENDING",
     "CANONICAL"
    ],
    "type": "string"
   },
   "to": {
    "description": "End block height (exclusive)",
    "type": "number"
   },
   "tokenId": {
    "description": "Token ID (defaults to MINA token)",
    "type": "string"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "get_events"
}
