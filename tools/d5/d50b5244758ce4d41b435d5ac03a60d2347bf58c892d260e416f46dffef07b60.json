{"annotations":{"destructiveHint":true,"openWorldHint":true,"readOnlyHint":false},"description":"\u0421\u043e\u0437\u0434\u0430\u0442\u044c, \u0438\u0437\u043c\u0435\u043d\u0438\u0442\u044c \u0438\u043b\u0438 \u0443\u0434\u0430\u043b\u0438\u0442\u044c \u043e\u0431\u0449\u0438\u0435 \u043d\u0430\u0431\u043e\u0440\u044b \u043c\u0438\u043d\u0443\u0441-\u0444\u0440\u0430\u0437 \u0430\u043a\u043a\u0430\u0443\u043d\u0442\u0430. \u0412 update \u043f\u043e \u0443\u043c\u043e\u043b\u0447\u0430\u043d\u0438\u044e negative_keywords \u0437\u0430\u043c\u0435\u043d\u044f\u044e\u0442 \u0441\u043f\u0438\u0441\u043e\u043a \u043d\u0430\u0431\u043e\u0440\u0430 \u0446\u0435\u043b\u0438\u043a\u043e\u043c; negative_keywords_mode=add \u0434\u043e\u043f\u0438\u0441\u044b\u0432\u0430\u0435\u0442 \u043a \u0442\u0435\u043a\u0443\u0449\u0438\u043c \u0444\u0440\u0430\u0437\u0430\u043c, remove \u0443\u0431\u0438\u0440\u0430\u0435\u0442 \u043d\u0430\u0437\u0432\u0430\u043d\u043d\u044b\u0435 \u2014 \u0447\u0438\u0442\u0430\u0442\u044c \u043d\u0430\u0431\u043e\u0440 \u043f\u0435\u0440\u0435\u0434 \u044d\u0442\u0438\u043c \u043d\u0435 \u043d\u0443\u0436\u043d\u043e, add \u0438 remove \u0434\u0435\u043b\u0430\u044e\u0442 \u044d\u0442\u043e \u0441\u0430\u043c\u0438.","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"action":{"description":"\u0427\u0442\u043e \u0441\u0434\u0435\u043b\u0430\u0442\u044c \u0441 \u043d\u0430\u0431\u043e\u0440\u0430\u043c\u0438: add, update \u0438\u043b\u0438 delete (\u043d\u0435\u043e\u0431\u0440\u0430\u0442\u0438\u043c\u043e)","enum":["add","update","delete"],"type":"string"},"add_sets":{"description":"\u041d\u0430\u0431\u043e\u0440\u044b \u0434\u043b\u044f \u0441\u043e\u0437\u0434\u0430\u043d\u0438\u044f; \u043e\u0431\u044f\u0437\u0430\u0442\u0435\u043b\u0435\u043d \u043f\u0440\u0438 action=add","items":{"properties":{"name":{"description":"\u041d\u0430\u0437\u0432\u0430\u043d\u0438\u0435 \u043d\u0430\u0431