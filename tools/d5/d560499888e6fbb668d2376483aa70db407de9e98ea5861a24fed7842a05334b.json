{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Confronta un nome (persona o ente) con la lista consolidata delle sanzioni finanziarie UE, con matching tollerante (ignora forme societarie e accenti). Restituisce le possibili corrispondenze con un punteggio 0-1. Screening indicativo, non un sistema AML certificato: 'da_verificare' significa che un umano deve controllare.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "nome": {
    "description": "Denominazione o nome e cognome da verificare, es. 'Mario Rossi' o 'Esempio Trading S.r.l.'",
    "type": "string"
   },
   "soglia": {
    "description": "Soglia di somiglianza (default 0.8)",
    "maximum": 1,
    "minimum": 0.5,
    "type": "number"
   }
  },
  "required": [
   "nome"
  ],
  "type": "object"
 },
 "name": "controlla_sanzioni",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "esito": {
    "enum": [
     "nessuna_corrispondenza",
     "da_verificare",
     "lista_non_caricata"
    ],
    "type": "string"
   },
   "fonte": {
    "type": "string"
   },
   "lista_aggiornata_al": {
    "type": [
     "string",
     "null"
    ]
   },
   "nome_cercato": {
    "type": "string"
   },
   "possibili_corrispondenze": {
    "items": {
     "additionalProperties": {},
     "properties": {
      "id": {
       "type": "string"
      },
      "nome_in_lista": {
       "type": "string"
      },
      "programmi": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "punteggio": {
       "description": "Somiglianza 0-1",
       "type": "number"
      },
      "tipo": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "tipo",
      "nome_in_lista",
      "programmi",
      "punteggio"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "soglia": {
    "type": "number"
   },
   "voci_in_lista": {
    "type": "number"
   }
  },
  "required": [
   "fonte",
   "lista_aggiornata_al",
   "voci_in_lista",
   "nome_cercato",
   "soglia",
   "possibili_corrispondenze",
   "esito"
  ],
  "type": "object"
 },
 "title": "Screening sanzioni UE"
}
