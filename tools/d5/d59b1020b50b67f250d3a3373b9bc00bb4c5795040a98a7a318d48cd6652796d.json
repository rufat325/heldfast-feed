{
 "description": "Create a quotation on a deal. Provide one or more line items.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "deal_id": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "description": {
       "type": "string"
      },
      "extended_description": {
       "type": "string"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "tax_rate_id": {
       "type": "string"
      },
      "unit_price_amount": {
       "type": "number"
      },
      "unit_price_currency": {
       "default": "EUR",
       "type": "string"
      }
     },
     "required": [
      "quantity",
      "description",
      "unit_price_amount",
      "tax_rate_id"
     ],
     "type": "object"
    },
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "deal_id",
   "line_items"
  ],
  "type": "object"
 },
 "name": "teamleader_quotations_create"
}
