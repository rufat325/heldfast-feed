{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Record a repository read locally"
 },
 "description": "Record a repository's material read on the caller's machine (README, files written for agents, merged pull requests, issues) against a product. Used by `npx bluet-mcp init` when linked to bluet.dev, so a repository GitHub will not let bluet.dev read can still be read. Same rule as a sync: transcriptions are recorded, inferences are proposed.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "files": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "md": {
       "type": "string"
      },
      "path": {
       "type": "string"
      }
     },
     "required": [
      "path",
      "md"
     ],
     "type": "object"
    },
    "maxItems": 40,
    "type": "array"
   },
   "issues": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "body": {
       "type": [
        "string",
        "null"
       ]
      },
      "closed_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "labels": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "number": {
       "type": "integer"
      },
      "state": {
       "enum": [
        "open",
        "closed"
       ],
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "number",
      "title",
      "body",
      "url",
      "state",
      "labels",
      "author",
      "closed_at"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "product": {
    "type": "string"
   },
   "pulls": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "author": {
       "type": [
        "string",
        "null"
       ]
      },
      "body": {
       "type": [
        "string",
        "null"
       ]
      },
      "merged_at": {
       "type": [
        "string",
        "null"
       ]
      },
      "number": {
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "type": "string"
      }
     },
     "required": [
      "number",
      "title",
      "body",
      "url",
      "merged_at",
      "author"
     ],
     "type": "object"
    },
    "maxItems": 500,
    "type": "array"
   },
   "readme": {
    "type": [
     "string",
     "null"
    ]
   },
   "repo": {
    "description": "owner/name, or the directory name",
    "type": "string"
   }
  },
  "required": [
   "product",
   "repo"
  ],
  "type": "object"
 },
 "name": "bluet_repo_ingest",
 "title": "Record a repository read locally"
}
