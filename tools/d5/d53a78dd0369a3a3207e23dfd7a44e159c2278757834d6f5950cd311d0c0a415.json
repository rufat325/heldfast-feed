{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":true,"readOnlyHint":true},"description":"A website's history from the Internet Archive's Wayback Machine: first and last capture, how many years and months it was archived, activity by year, the longest gap, the last capture's HTTP status and links to the first and last snapshots. Useful for domain age, due diligence and spotting parked or re-registered domains. Costs $0.003 USDC on Base via x402.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":false,"properties":{"url":{"description":"Domain or page URL (stripe.com)","pattern":"^\\S+$","type":"string"}},"required":["url"],"type":"object"},"name":"website_history","outputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","additionalProperties":true,"properties":{"archivedSinceYears":{"description":"number, e.g. 30"},"firstCapture":{"description":"string, e.g. \"1996-10-29T20:48:28Z\""},"firstSnapshotUrl":{"description":"string, e.g. \"https://web.archive.org/web/19961029204828/basecamp.com\""},"lastCapture":{"description":"string, e.g. \"2026-10-01T00:35:11Z\""},"lastCaptureStatus":{"description":"number, e.g. 301"},"lastLiveCapture":{"description":"string, e.g. \"2026-06-01T00:06:48Z\""},"lastSnapshotUrl":{"description":"string, e.g. \"https://web.archive.org/web/20261001003511/basecamp.com\""},"longestGap":{"description":"object"},"monthsWithCaptures":{"description":"number, e.g. 300"},"monthsWithCapturesByYear":{"description":"object"},"notes":{"description":"string, e.g. \"From the Internet Archive's Wayback Machine, counting month"},"target":{"description":"string, e.g. \"basecamp.com\""},"yearsArchived":{"description":"number, e.g. 31"}},"type":"object"},"title":"Website history"}
