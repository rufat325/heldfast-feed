{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "One Model Tracker model's applied changes since 2026-10-05 (input, output and cached input price per 1M text tokens by default, or one field), each with its source URL and time, plus the price step series. Prices are decimal strings as stored.",
 "inputSchema": {
  "properties": {
   "field": {
    "enum": [
     "inputPrice",
     "outputPrice",
     "cachedInputPrice",
     "contextWindow",
     "maxOutput",
     "releaseDate",
     "modalitiesIn",
     "modalitiesOut",
     "lifecycle",
     "deprecationDate",
     "retirementDate",
     "availability",
     "license",
     "openWeights",
     "category",
     "apiId",
     "name"
    ],
    "type": "string"
   },
   "slug": {
    "description": "Model Tracker slug, as in /model-tracker/{slug}",
    "type": "string"
   }
  },
  "required": [
   "slug"
  ],
  "type": "object"
 },
 "name": "get_price_history",
 "outputSchema": {
  "properties": {
   "attribution": {
    "type": "string"
   },
   "data": {
    "properties": {
     "changes": {
      "items": {
       "properties": {
        "at": {
         "description": "ISO 8601 time the change was applied",
         "type": "string"
        },
        "field": {
         "type": "string"
        },
        "from": {
         "description": "value before the change as stored; null = no value on record before",
         "type": [
          "string",
          "null"
         ]
        },
        "sourceUrl": {
         "type": "string"
        },
        "to": {
         "type": [
          "string",
          "null"
         ]
        }
       },
       "required": [
        "field",
        "from",
        "to",
        "at",
        "sourceUrl"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "historyStart": {
      "type": "string"
     },
     "model": {
      "type": "object"
     },
     "series": {
      "type": "object"
     }
    },
    "type": "object"
   },
   "license": {
    "type": "object"
   }
  },
  "required": [
   "attribution",
   "data"
  ],
  "type": "object"
 },
 "title": "Model price history"
}
