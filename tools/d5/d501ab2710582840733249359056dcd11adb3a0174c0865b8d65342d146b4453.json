{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "List all Metabase users with filtering options",
 "inputSchema": {
  "properties": {
   "group_id": {
    "description": "Filter by permission group ID (optional)",
    "type": "number"
   },
   "status": {
    "default": "all",
    "description": "Filter by user status",
    "enum": [
     "active",
     "inactive",
     "all"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "mb_user_list",
 "outputSchema": {
  "properties": {
   "count": {
    "type": "number"
   },
   "users": {
    "items": {
     "properties": {
      "email": {
       "type": "string"
      },
      "first_name": {
       "type": "string"
      },
      "id": {
       "type": "number"
      },
      "is_active": {
       "type": "boolean"
      },
      "last_name": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "email"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "users"
  ],
  "type": "object"
 },
 "title": "List Users"
}
