    "enum": [
     "summary",
     "full"
    ],
    "type": "string"
   },
   "limit": {
    "default": 5,
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "offset": {
    "default": 0,
    "maximum": 1000,
    "minimum": 0,
    "type": "integer"
   },
   "operation": {
    "description": "Exact operation name for its input schema and policy",
    "maxLength": 64,
    "minLength": 1,
    "type": "string"
   },
   "query": {
    "description": "Keywords such as mailbox, DNS, or population",
    "maxLength": 256,
    "minLength": 1,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "discover",
