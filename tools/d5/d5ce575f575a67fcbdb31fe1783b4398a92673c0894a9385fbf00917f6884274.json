{
 "description": "Suggest a product for the directory. The submission is saved as pending and reviewed by a person; nothing is published automatically.",
 "inputSchema": {
  "properties": {
   "agent_name": {
    "type": "string"
   },
   "category": {
    "enum": [
     "utilities",
     "productivity",
     "developer",
     "education",
     "sports",
     "environment",
     "ai-agents"
    ],
    "type": "string"
   },
   "contact": {
    "description": "Optional private email.",
    "type": "string"
   },
   "name": {
    "maxLength": 100,
    "type": "string"
   },
   "one_liner": {
    "maxLength": 240,
    "type": "string"
   },
   "tags": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "url": {
    "description": "Official website or app-store URL.",
    "type": "string"
   },
   "why_try": {
    "description": "What a user can do with the free option.",
    "type": "string"
   }
  },
  "required": [
   "name",
   "url",
   "one_liner",
   "why_try",
   "category"
  ],
  "type": "object"
 },
 "name": "submit_project"
}
