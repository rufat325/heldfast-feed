          "high": {
           "exclusiveMinimum": 0,
           "maximum": 1000000,
           "type": "number"
          },
          "low": {
           "exclusiveMinimum": 0,
           "maximum": 1000000,
           "type": "number"
          },
          "metric": {
           "const": "frequency",
           "type": "string"
          },
          "per": {
           "enum": [
            "day",
            "week",
            "month",
            "year"
           ],
           "type": "string"
          }
         },
         "required": [
          "metric",
          "low",
          "high",
          "per"
         ],
         "type": "object"
        },
        {
         "properties": {
          "amount": {
           "maximum": 1000000000,
           "minimum": 0,
           "type": "number"
          },
          "currency": {
           "pattern": "^[A-Z]{3}$",
           "type": "string"
          },
          "metric": {
           "const": "hardCost",
           "type": "string"
          },
          "per": {
           "enum": [
            "run",
            "month"
