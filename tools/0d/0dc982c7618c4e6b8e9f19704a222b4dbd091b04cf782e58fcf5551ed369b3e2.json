           "minimum": 0,
           "type": "number"
          },
          "metric": {
           "const": "working",
           "type": "string"
          }
         },
         "required": [
          "metric",
          "low",
          "high"
         ],
         "type": "object"
        },
        {
         "properties": {
          "high": {
           "maximum": 1000000,
           "minimum": 0,
           "type": "number"
          },
          "low": {
           "maximum": 1000000,
           "minimum": 0,
           "type": "number"
          },
          "metric": {
           "const": "waiting",
           "type": "string"
          }
         },
         "required": [
          "metric",
          "low",
          "high"
         ],
         "type": "object"
        },
        {
