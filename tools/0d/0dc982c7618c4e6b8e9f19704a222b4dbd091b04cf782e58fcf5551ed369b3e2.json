          }
         },
         "required": [
          "metric",
          "amount",
          "currency",
          "per"
         ],
         "type": "object"
        }
       ]
      },
      "nature": {
       "description": "What kind of work the step is: rote (a machine could do it), judgment (needs a person; AI can draft or check), relationship (people talking to people), wait (work sitting with someone else), gate (an approval or check).",
       "enum": [
        "rote",
        "judgment",
        "relationship",
        "wait",
        "gate"
       ],
       "type": "string"
      },
      "nodeId": {
