{
 "annotations": {
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search aidata.stream"
 },
 "description": "Full-text search across aidata.stream: documentation, blog posts, changelog, pricing, FAQ and the home page. Returns the best-matching sections with a snippet and a URL (with anchor where available). Use get_page to read a whole page afterwards. English by default; pass lang for the French or German site.",
 "inputSchema": {
  "properties": {
   "lang": {
    "description": "Site language to search (default en).",
    "enum": [
     "en",
     "fr",
     "de"
    ],
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 6).",
    "maximum": 20,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Search terms, e.g. \"connect GA4 service account\" or \"pricing extra seats\".",
    "type": "string"
   },
   "section": {
    "description": "Restrict to one section of the site.",
    "enum": [
     "docs",
     "blog",
     "changelog",
     "core"
    ],
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_site",
 "outputSchema": {
  "properties": {
   "query": {
    "type": "string"
   },
   "results": {
    "items": {
     "properties": {
      "heading": {
       "type": "string"
      },
      "lang": {
       "enum": [
        "en",
        "fr",
        "de"
       ],
       "type": "string"
      },
      "score": {
       "type": "number"
      },
      "section": {
       "enum": [
        "docs",
        "blog",
        "changelog",
        "core"
       ],
       "type": "string"
      },
      "snippet": {
       "type": "string"
      },
      "title": {
       "type": "string"
      },
      "url": {
       "description": "Absolute URL, with #anchor when the match is a specific section.",
       "type": "string"
      }
     },
     "type": "object"
    },
    "type": "array"
   },
   "total_matches": {
    "type": "integer"
   }
  },
  "required": [
   "query",
   "total_matches",
   "results"
  ],
  "type": "object"
 },
 "title": "Search aidata.stream"
}
