{"_meta":{"openai/outputTemplate":"ui://lenius/order-card.html","openai/toolInvocation/invoked":"Prisen er beregnet","openai/toolInvocation/invoking":"Beregner prisen \u2026","openai/widgetAccessible":true,"ui":{"resourceUri":"ui://lenius/order-card.html"}},"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Quote order"},"description":"Price an order exactly like the shop checkout (lines, fees, discounts, total in DKK incl. VAT), check that the time, products, minimum order and delivery address are OK, and tell how it is paid. Nothing is saved. Shows a card with the products (with their images), fees and total so the customer can see what they are ordering; show the result to the customer before place_order.","execution":{"taskSupport":"forbidden"},"inputSchema":{"$schema":"http://json-schema.org/draft-07/schema#","properties":{"address":{"description":"Required for delivery","properties":{"city":{"maxLength":60,"minLength":2,"type":"string"},"postal_code":{"maxLength":10,"minLength":3,"type":"string"},"street":{"description":"Street and number","maxLength":120,"minLength":2,"type":"string"}},"required":["street","postal_code","city"],"type":"object"},"date":{"description":"YYYY-MM-DD (from available_times)","pattern":"^\\d{4}-\\d{2}-\\d{2}$","type":"string"},"fulfillment":{"enum":["pickup","delivery"],"type":"string"},"items":{"items":{"properties":{"options":{"description":"Answers to the product's options from get_menu (option_id + choice_id, option_id + text, or option_id + choices for choose_many). Required options must be answered; ask the customer, never pick for them.","items":{"anyOf":[{"additionalProperties":false,"properties":{"choice_id":{"description":"choice_id from get_menu","maxLength":32,"minLength":1,"type":"string"},"option_id":{"maxLength":32,"minLength":1,"type":"string"}},"required":["option_id","choice_id"],"type":"object"},{"additionalProperties":false,"properties":{"option_id":{"ma