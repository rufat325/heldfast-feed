{
 "description": "Return an engagement by id.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "id": {
    "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
    "type": "string"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "get_engagement",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "engagement": {
    "anyOf": [
     {},
     {
      "type": "null"
     }
    ]
   },
   "found": {
    "type": "boolean"
   }
  },
  "required": [
   "found",
   "engagement"
  ],
  "type": "object"
 },
 "title": "Get an engagement"
}
