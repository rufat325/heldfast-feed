{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Replaces a site's protectedPaths / localStorageSync / authButton configuration. For a freemium app whose free and premium code are nearly identical, prefer gating just the specific files/paths that carry the premium value over splitting the whole app into two trees \u2014 the shared UI can stay one codebase. Client-side, window.__GK_STATUS__ ({ authenticated, activePlanId }, injected before the app boots) can conditionally show/hide premium UI, but it's informational only and never re-checked server-side \u2014 real enforcement always needs an actual protectedPaths entry (here, or per-plan via create_plan/update_plan_paths), never just a client-side check.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "config": {
    "additionalProperties": false,
    "properties": {
     "ads": {
      "additionalProperties": false,
      "properties": {
       "enabled": {
        "type": "boolean"
       }
      },
      "required": [
       "enabled"
      ],
      "type": "object"
     },
     "authButton": {
      "additionalProperties": false,
      "properties": {
       "enabled": {
        "type": "boolean"
       },
       "position": {
        "default": "bottom-right",
        "enum": [
         "top-right",
         "top-left",
         "bottom-right",
         "bottom-left"
        ],
        "type": "string"
       }
      },
      "required": [
       "enabled"
      ],
      "type": "object"
     },
     "authOnlyPaths": {
      "$ref": "#/properties/config/properties/protectedPaths",
      "default": []
     },
     "autoRedirectIfEntitled": {
      "additionalProperties": false,
      "properties": {
       "path": {
        "minLength": 1,
        "type": "string"
       },
       "to": {
        "minLength": 1,
        "type": "string"
       }
      },
      "required": [
       "path",
       "to"
      ],
      "type": "object"
     },
     "brandingBanner": {
      "additionalProperties": false,
      "properties": {
       "position": {
        "default": "bottom-left",
        "enum": [
         "top-right",
         "top-left",
         "bottom-right",
         "bottom-left"
        ],
        "type": "string"
       }
      },
      "type": "object"
     },
     "localStorageSync": {
      "additionalProperties": false,
      "properties": {
       "allowlist": {
        "items": {
         "minLength": 1,
         "type": "string"
        },
        "type": "array"
       }
      },
      "type": "object"
     },
     "protectedPaths": {
      "default": [],
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "site_id": {
    "description": "The site's id, from list_sites or create_site.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "site_id",
   "config"
  ],
  "type": "object"
 },
 "name": "set_config",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "ads": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     }
    },
    "required": [
     "enabled"
    ],
    "type": "object"
   },
   "authButton": {
    "additionalProperties": false,
    "properties": {
     "enabled": {
      "type": "boolean"
     },
     "position": {
      "default": "bottom-right",
      "enum": [
       "top-right",
       "top-left",
       "bottom-right",
       "bottom-left"
      ],
      "type": "string"
     }
    },
    "required": [
     "enabled"
    ],
    "type": "object"
   },
   "authOnlyPaths": {
    "$ref": "#/properties/protectedPaths",
    "default": []
   },
   "autoRedirectIfEntitled": {
    "additionalProperties": false,
    "properties": {
     "path": {
      "minLength": 1,
      "type": "string"
     },
     "to": {
      "minLength": 1,
      "type": "string"
     }
    },
    "required": [
     "path",
     "to"
    ],
    "type": "object"
   },
   "brandingBanner": {
    "additionalProperties": false,
    "properties": {
     "position": {
      "default": "bottom-left",
      "enum": [
       "top-right",
       "top-left",
       "bottom-right",
       "bottom-left"
      ],
      "type": "string"
     }
    },
    "type": "object"
   },
   "localStorageSync": {
    "additionalProperties": false,
    "properties": {
     "allowlist": {
      "items": {
       "minLength": 1,
       "type": "string"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "protectedPaths": {
    "default": [],
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "title": "Set site config"
}
