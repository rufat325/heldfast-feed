{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "List available reservation slots at a specific venue for a date + party size. Returns slot config_tokens suitable for booking. Tokens expire quickly; book soon after fetching.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "date": {
    "description": "YYYY-MM-DD",
    "type": "string"
   },
   "lat": {
    "type": "number"
   },
   "lng": {
    "type": "number"
   },
   "party_size": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "venue_id": {
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "venue_id",
   "date",
   "party_size"
  ],
  "type": "object"
 },
 "name": "resy_find_slots"
}
