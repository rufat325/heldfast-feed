{
 "description": "Wallpaper rolls needed for a wall, accounting for pattern repeat and openings. Use a standard roll preset (eu, us-single, us-double, commercial54) or custom roll dimensions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "openings_m2": {
    "default": 0,
    "description": "Area of doors/windows to subtract",
    "minimum": 0,
    "type": "number"
   },
   "pattern_repeat_m": {
    "default": 0,
    "description": "Pattern repeat length",
    "minimum": 0,
    "type": "number"
   },
   "roll_length_m": {
    "description": "Custom roll length (overrides preset)",
    "minimum": 0,
    "type": "number"
   },
   "roll_preset": {
    "enum": [
     "us-single",
     "us-double",
     "eu",
     "commercial54"
    ],
    "type": "string"
   },
   "roll_width_m": {
    "description": "Custom roll width (overrides preset)",
    "minimum": 0,
    "type": "number"
   },
   "wall_height_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "wall_width_m": {
    "exclusiveMinimum": 0,
    "type": "number"
   }
  },
  "required": [
   "wall_width_m",
   "wall_height_m"
  ],
  "type": "object"
 },
 "name": "wallpaper_calculator"
}
