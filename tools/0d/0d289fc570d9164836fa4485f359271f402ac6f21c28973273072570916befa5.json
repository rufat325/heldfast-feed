{
 "description": "Read-only quality screen across all Robinhood Chain launchpads. Uses GMGN server-side filters; this tool never executes a trade.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "launchpads": {
    "description": "Restrict to GMGN launchpad platforms on Robinhood; omit for all launchpads.",
    "items": {
     "enum": [
      "pons",
      "trench"
     ],
     "type": "string"
    },
    "minItems": 1,
    "type": "array"
   },
   "limit": {
    "default": 40,
    "maximum": 80,
    "minimum": 1,
    "type": "integer"
   },
   "maxRugRatio": {
    "maximum": 1,
    "minimum": 0,
    "type": "number"
   },
   "minLiquidityUsd": {
    "minimum": 0,
    "type": "number"
   },
   "minSmartMoneyCount": {
    "minimum": 0,
    "type": "integer"
   },
   "profile": {
    "default": "safe",
    "enum": [
     "safe",
     "smart-money",
     "strict"
    ],
    "type": "string"
   },
   "stage": {
    "default": "new_creation",
    "enum": [
     "new_creation",
     "near_completion",
     "completed"
    ],
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "agentcity_screen_robinhood_launchpads"
}
