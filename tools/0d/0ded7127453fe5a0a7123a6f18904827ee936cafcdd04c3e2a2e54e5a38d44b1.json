{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Close or reopen a poll"
 },
 "description": "Close a DooDates poll so it stops accepting votes, or reopen it with reopen=true.\nReversible. Closing stops new votes; it does not set a final date.\nAccess requires the organizer's admin link (admin_url, the full link containing #owner_token=)\nor its token; the vote link alone does not grant access.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "admin_token": {
    "description": "Admin token, if given separately.",
    "maxLength": 256,
    "type": "string"
   },
   "admin_url": {
    "description": "Admin link returned at creation (\u2026/results#owner_token=\u2026).",
    "maxLength": 2048,
    "type": "string"
   },
   "language": {
    "description": "Language of the poll and of the messages (default: en).",
    "enum": [
     "fr",
     "en",
     "es"
    ],
    "type": "string"
   },
   "poll": {
    "description": "Poll slug, vote link or admin link (https://doodates.com/poll/{slug}/...).",
    "maxLength": 2048,
    "type": "string"
   },
   "reopen": {
    "description": "true to reopen a closed poll.",
    "type": "boolean"
   }
  },
  "required": [
   "poll"
  ],
  "type": "object"
 },
 "name": "close_poll",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "poll_id": {
    "type": "string"
   },
   "previous_status": {
    "type": "string"
   },
   "status": {
    "enum": [
     "closed",
     "active"
    ],
    "type": "string"
   },
   "winner": {
    "additionalProperties": false,
    "description": "Absent without any positive vote.",
    "properties": {
     "date": {
      "type": "string"
     },
     "maybe": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "no": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "score": {
      "type": "number"
     },
     "slot": {
      "description": "Time slot \"HH:MM - HH:MM\"; absent for an all-day option.",
      "type": "string"
     },
     "yes": {
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "date",
     "yes",
     "maybe",
     "no",
     "score"
    ],
    "type": "object"
   }
  },
  "required": [
   "poll_id",
   "status",
   "previous_status"
  ],
  "type": "object"
 },
 "title": "Close or reopen a poll"
}
