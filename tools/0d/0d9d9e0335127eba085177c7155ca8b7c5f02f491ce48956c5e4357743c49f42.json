{
 "annotations": {},
 "description": "Update an existing price alert. Pass null for a threshold to clear it (Premium only - free users must keep exactly one direction). isActive toggles enable/disable without deleting. Requires IWMM_API_KEY.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "decreasePct": {
    "anyOf": [
     {
      "minimum": 0.01,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "id": {
    "description": "Alert ID from list_price_alerts.",
    "minimum": 1,
    "type": "integer"
   },
   "increasePct": {
    "anyOf": [
     {
      "minimum": 0.01,
      "type": "number"
     },
     {
      "type": "null"
     }
    ]
   },
   "isActive": {
    "type": "boolean"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
 "name": "update_price_alert"
}
