{
 "annotations": {
  "readOnlyHint": true,
  "title": "List short links"
 },
 "description": "List short links, filtered by domain, tag, folder or a text search. Dub: GET /links.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "domain": {
    "description": "Only links on this short domain.",
    "type": "string"
   },
   "folderId": {
    "description": "Only links in this folder.",
    "type": "string"
   },
   "page": {
    "description": "1-based page number.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "pageSize": {
    "description": "Page size, 1-100.",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "search": {
    "description": "Free-text search over the key, URL and title.",
    "type": "string"
   },
   "showArchived": {
    "description": "Include archived links.",
    "type": "boolean"
   },
   "tagNames": {
    "description": "Only links carrying these tag names.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "dub_list_links",
 "title": "List short links"
}
