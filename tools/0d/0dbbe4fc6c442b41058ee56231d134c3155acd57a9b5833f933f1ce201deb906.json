{
 "description": "List contacts in the workspace with optional filters",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bbc_only": {
    "description": "Only show BBC contacts",
    "type": "boolean"
   },
   "genre": {
    "description": "Genre filter",
    "type": "string"
   },
   "limit": {
    "description": "Max results (default 50)",
    "type": "number"
   },
   "offset": {
    "type": "number"
   },
   "search": {
    "description": "Search name, email, outlet",
    "type": "string"
   },
   "status": {
    "description": "Pipeline status filter",
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "tap_list_contacts"
}
