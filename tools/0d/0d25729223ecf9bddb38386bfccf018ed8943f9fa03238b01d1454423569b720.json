{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Use this when the user asks how serious a CVE is, such as \"how bad is CVE-2021-44228?\". Pass the CVE id. Returns a priority (exploited, likely, routine or unknown), the description, CVSS score and severity, whether the CISA Known Exploited Vulnerabilities catalog lists it, the EPSS exploitation probability, a patch or advisory link when tagged, and the as_of dates. A lookup by CVE id: it does not know which software the user runs or whether they are affected.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "cve": {
    "description": "A CVE id such as \"CVE-2021-44228\"",
    "maxLength": 30,
    "pattern": "^[Cc][Vv][Ee]-[0-9]{4}-[0-9]{4,19}$",
    "type": "string"
   }
  },
  "required": [
   "cve"
  ],
  "type": "object"
 },
 "name": "check_cve",
 "outputSchema": {
  "properties": {
   "as_of": {
    "properties": {
     "epss": {
      "type": [
       "string",
       "null"
      ]
     },
     "nvd": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": "object"
   },
   "cve": {
    "type": "string"
   },
   "cvss": {
    "properties": {
     "score": {
      "type": "number"
     },
     "scored_by": {
      "enum": [
       "NVD",
       "CNA"
      ],
      "type": "string"
     },
     "severity": {
      "type": [
       "string",
       "null"
      ]
     },
     "version": {
      "type": "string"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "description": {
    "type": [
     "string",
     "null"
    ]
   },
   "epss": {
    "properties": {
     "as_of": {
      "type": "string"
     },
     "percentile": {
      "type": "number"
     },
     "score": {
      "type": "number"
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "fix_url": {
    "type": [
     "string",
     "null"
    ]
   },
   "kev": {
    "properties": {
     "added_on": {
      "type": "string"
     },
     "due_date": {
      "type": [
       "string",
       "null"
      ]
     },
     "name": {
      "type": [
       "string",
       "null"
      ]
     },
     "required_action": {
      "type": [
       "string",
       "null"
      ]
     }
    },
    "type": [
     "object",
     "null"
    ]
   },
   "last_modified": {
    "type": [
     "string",
     "null"
    ]
   },
   "message": {
    "type": "string"
   },
   "notice": {
    "type": "string"
   },
   "priority": {
    "enum": [
     "exploited",
     "likely",
     "routine",
     "unknown",
     null
    ],
    "type": [
     "string",
     "null"
    ]
   },
   "published": {
    "type": [
     "string",
     "null"
    ]
   },
   "references": {
    "items": {
     "type": "string"
    },
    "type": "array"
   },
   "retry_after_seconds": {
    "type": "integer"
   },
   "source": {
    "type": "string"
   },
   "status": {
    "enum": [
     "ok",
     "not_found",
     "rate_limited",
     "unavailable",
     "deferred"
    ],
    "type": "string"
   },
   "vuln_status": {
    "type": [
     "string",
     "null"
    ]
   }
  },
  "required": [
   "cve",
   "status",
   "priority",
   "references",
   "as_of",
   "source",
   "notice"
  ],
  "type": "object"
 },
 "title": "Check a CVE"
}
