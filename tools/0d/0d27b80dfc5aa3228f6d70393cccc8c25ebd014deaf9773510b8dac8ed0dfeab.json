    "maxLength": 120,
    "minLength": 16,
    "pattern": "^[a-zA-Z0-9_-]+$",
    "type": "string"
   },
   "depth": {
    "enum": [
     "fast",
     "smart",
     "deep",
     "elite"
    ],
    "type": "string"
   },
   "funding": {
