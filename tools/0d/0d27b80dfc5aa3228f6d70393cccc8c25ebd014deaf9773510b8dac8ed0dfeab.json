         "user_reported",
         "unknown"
        ],
        "type": "string"
       },
       "version": {
        "anyOf": [
         {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_.:@/-]+$",
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "voids": {
        "enum": [
         "refund",
         "reprice",
         "unknown"
        ],
        "type": "string"
       }
      },
      "required": [
       "source",
       "reference",
       "version",
       "pushes",
       "voids"
      ],
      "type": "object"
     },
     "source": {
      "const": "manual",
      "type": "string"
     },
     "stakeMinor": {
      "maximum": 1000000000000,
      "minimum": 0,
      "type": "integer"
     }
    },
    "required": [
