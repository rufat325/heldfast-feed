        },
        "quoteVersion": {
         "anyOf": [
          {
           "maxLength": 200,
           "minLength": 1,
           "pattern": "^[a-zA-Z0-9_.:@/-]+$",
           "type": "string"
          },
          {
           "type": "null"
          }
         ]
        },
        "side": {
         "maxLength": 200,
         "minLength": 1,
         "pattern": "^[a-zA-Z0-9_.:@/-]+$",
