        "eventId",
        "entityId",
        "provider",
        "sport",
        "league",
        "market",
        "period",
        "side",
        "line",
        "label",
        "startsAt",
        "bookId",
        "jurisdiction",
        "oddsAmerican",
        "observedAt",
        "quoteVersion"
       ],
       "type": "object"
      },
      "maxItems": 25,
      "minItems": 1,
      "type": "array"
     },
     "settlementTerms": {
      "additionalProperties": false,
      "properties": {
       "cashSingle": {
        "const": "win_loss_refund",
        "type": "string"
       },
       "pushes": {
        "enum": [
         "refund",
         "reprice",
         "lose",
         "unknown"
        ],
        "type": "string"
       },
       "reference": {
        "anyOf": [
         {
          "maxLength": 500,
          "minLength": 1,
          "type": "string"
         },
         {
          "type": "null"
         }
        ]
       },
       "source": {
        "enum": [
