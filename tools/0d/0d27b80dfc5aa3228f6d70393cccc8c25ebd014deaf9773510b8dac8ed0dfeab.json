      "const": "exact_fields_confirmed",
      "type": "string"
     },
     "currency": {
      "pattern": "^[A-Z]{3}$",
      "type": "string"
     },
     "intent": {
      "enum": [
       "singles",
       "parlay"
      ],
      "type": "string"
     },
     "offeredReturnMinor": {
      "anyOf": [
       {
        "maximum": 1000000000000,
        "minimum": 0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ]
     },
     "parentTicketId": {
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
      "type": "string"
     },
     "selections": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "bookId": {
         "maxLength": 200,
         "minLength": 1,
         "pattern": "^[a-zA-Z0-9_.:@/-]+$",
