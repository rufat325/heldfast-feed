{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Stores one atomic claim and a consent-scoped outcome for descriptive validation without training on narration.",
 "inputSchema": {
  "properties": {
   "chartVersion": {
    "type": "string"
   },
   "claim": {
    "type": "string"
   },
   "claimClass": {
    "type": "string"
   },
   "claimId": {
    "type": "string"
   },
   "consentScope": {
    "enum": [
     "service-follow-up",
     "descriptive-outcomes",
     "blind-validation"
    ],
    "type": "string"
   },
   "evidence": {
    "type": "object"
   },
   "notes": {
    "type": "string"
   },
   "outcome": {
    "enum": [
     "confirmed",
     "partly-confirmed",
     "not-confirmed",
     "unresolved"
    ],
    "type": "string"
   },
   "outcomeBlinded": {
    "type": "boolean"
   },
   "resolutionWindowEnd": {
    "type": "string"
   },
   "resolutionWindowStart": {
    "type": "string"
   },
   "resolvedAt": {
    "type": "string"
   },
   "rulesetVersion": {
    "type": "string"
   },
   "tradition": {
    "type": "string"
   },
   "userSawClaim": {
    "type": "boolean"
   }
  },
  "required": [
   "claimId",
   "claim",
   "claimClass",
   "tradition",
   "chartVersion",
   "rulesetVersion",
   "outcome",
   "consentScope"
  ],
  "type": "object"
 },
 "name": "record_consultation_outcome",
 "outputSchema": {
  "additionalProperties": true,
  "required": [
   "schemaVersion",
   "claimId",
   "outcomeId",
   "status"
  ],
  "type": "object"
 },
 "title": "Record a versioned prediction claim and later outcome"
}
