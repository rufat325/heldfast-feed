{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Check whether the VERIDEX API is up, and see today's demand: uptime, the number of verification calls served today and the distinct callers.\n\nFree and unauthenticated. The request count excludes the service's own healthchecks and local tests, so it answers 'is anyone using this?' rather than 'is the process alive?'. Useful before starting a paid flow.",
 "inputSchema": {
  "properties": {},
  "title": "health_checkArguments",
  "type": "object"
 },
 "name": "health_check",
 "outputSchema": {
  "$defs": {
   "ErrorInfo": {
    "description": "A typed failure. ``code`` is the field to branch on.",
    "properties": {
     "code": {
      "title": "Code",
      "type": "string"
     },
     "details": {
      "additionalProperties": true,
      "title": "Details",
      "type": "object"
     },
     "http_status": {
      "anyOf": [
       {
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "default": null,
      "description": "null when the request never reached the API (DNS, TLS, timeout).",
      "title": "Http Status"
     },
     "message": {
      "default": "",
      "title": "Message",
      "type": "string"
     },
     "retryable": {
      "default": false,
      "title": "Retryable",
      "type": "boolean"
     }
    },
    "required": [
     "code"
    ],
    "title": "ErrorInfo",
    "type": "object"
   }
  },
  "description": "Result of ``health_check``.",
  "properties": {
   "api_url": {
    "default": "",
    "title": "Api Url",
    "type": "string"
   },
   "checked_at": {
    "default": "",
    "title": "Checked At",
    "type": "string"
   },
   "error": {
    "anyOf": [
     {
      "$ref": "#/$defs/ErrorInfo"
     },
     {
      "type": "null"
     }
    ],
    "default": null
   },
   "latency_ms": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Latency Ms"
   },
   "ok": {
    "title": "Ok",
    "type": "boolean"
   },
   "reachable": {
    "default": false,
    "title": "Reachable",
    "type": "boolean"
   },
   "requests_today": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Requests Today"
   },
   "status": {
    "default": "unknown",
    "description": "'ok' when the API is serving.",
    "title": "Status",
    "type": "string"
   },
   "unique_agents_today": {
    "anyOf": [
     {
      "type": "integer"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Unique Agents Today"
   },
   "uptime_seconds": {
    "anyOf": [
     {
      "type": "number"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Uptime Seconds"
   }
  },
  "required": [
   "ok"
  ],
  "title": "HealthResult",
  "type": "object"
 },
 "title": "VERIDEX API health and today's traffic"
}
