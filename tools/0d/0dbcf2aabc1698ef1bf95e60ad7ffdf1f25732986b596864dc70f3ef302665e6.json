{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Update a goal: change status, progress, toggle milestones, or add a progress note.",
 "inputSchema": {
  "properties": {
   "current_value": {
    "description": "Current value (for numeric goals, >= 0)",
    "type": "number"
   },
   "description": {
    "description": "New description",
    "type": "string"
   },
   "goal_id": {
    "description": "Goal ID",
    "type": "integer"
   },
   "note": {
    "description": "Progress update note (saved in goal timeline)",
    "type": "string"
   },
   "priority": {
    "description": "Priority: 1=high, 2=medium, 3=low",
    "enum": [
     1,
     2,
     3
    ],
    "type": "integer"
   },
   "start_value": {
    "description": "Value the goal started from; progress is measured from it (use for goals that go down, e.g. 90 -> 80 kg)",
    "type": "number"
   },
   "status": {
    "description": "New status",
    "enum": [
     "active",
     "paused",
     "completed",
     "abandoned"
    ],
    "type": "string"
   },
   "target_date": {
    "description": "New target date (Y-m-d)",
    "type": "string"
   },
   "target_value_num": {
    "description": "Target value (numeric and habit goals)",
    "type": "number"
   },
   "title": {
    "description": "New title",
    "type": "string"
   },
   "toggle_milestone": {
    "description": "Toggle milestone by index (0-based). Ticking the last open one completes the goal; unticking reopens it.",
    "type": "integer"
   }
  },
  "required": [
   "goal_id"
  ],
  "type": "object"
 },
 "name": "update_goal",
 "title": "Update goal"
}
