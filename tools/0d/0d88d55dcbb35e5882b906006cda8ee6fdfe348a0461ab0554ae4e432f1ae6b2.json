{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Return the rule kind, description, default severity, detection method, and threshold for a given Code Auditor rule or analyzer. Call this when a user asks what a specific rule does (e.g. import-ban, sql-injection, n+1).",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "rule_id": {
    "description": "Rule or analyzer id, e.g. import-ban, sql-injection, n+1.",
    "type": "string"
   }
  },
  "required": [
   "rule_id"
  ],
  "type": "object"
 },
 "name": "lookup_rule",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
   {
    "additionalProperties": false,
    "properties": {
     "category": {
      "type": "string"
     },
     "config": {
      "type": "string"
     },
     "description": {
      "type": "string"
     },
     "method": {
      "type": "string"
     },
     "rule": {
      "type": "string"
     },
     "severity": {
      "enum": [
       "critical",
       "severe",
       "high"
      ],
      "type": "string"
     },
     "threshold": {
      "type": "string"
     }
    },
    "required": [
     "rule",
     "category",
     "severity",
     "description",
     "method"
    ],
    "type": "object"
   },
   {
    "additionalProperties": false,
    "properties": {
     "error": {
      "type": "string"
     }
    },
    "required": [
     "error"
    ],
    "type": "object"
   }
  ],
  "type": "object"
 },
 "title": "Look Up Rule"
}
