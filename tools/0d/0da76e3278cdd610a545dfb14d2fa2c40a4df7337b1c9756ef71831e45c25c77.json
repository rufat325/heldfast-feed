 "description": "Counts by Gregorian or Hijri year/month, or pooled lunar month. Group by country/newspaper. Partial dates and missing lunar dates are disclosed. normalize_by returns numerator counts and per-bucket denominators in the same country/outlet/date scope, removing thematic filters. Shares describe IWAC holdings.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "calendar": {
    "description": "gregorian (default) | hijri \u2014 bucket by the Islamic (Umm al-Qura) calendar",
    "type": "string"
   },
   "country": {
    "description": "Exact country name (accents optional)",
    "type": "string"
   },
   "date_from": {
    "description": "Inclusive date bounds: YYYY[-MM[-DD]]",
    "type": "string"
   },
   "date_to": {
    "type": "string"
   },
   "exact": {
    "additionalProperties": {
     "items": {
      "type": "string"
     },
     "maxItems": 20,
     "minItems": 1,
     "type": "array"
    },
    "description": "AND values. Fields: subject/spatial/author/language/country/newspaper/topic_id/min_prob/scored_by; country_raw=whole cell; polarity:<model>.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "granularity": {
    "description": "year (default) | month | lunar_month (all years collapsed into 12 lunar months; needs calendar=hijri)",
    "type": "string"
   },
   "group_by": {
    "description": "country | newspaper \u2014 one distribution per group value",
    "type": "string"
   },
   "hijri_month": {
    "type": "string"
   },
   "hijri_year": {
    "type": "integer"
   },
   "keyword": {
    "minLength": 1,
    "type": "string"
   },
   "keyword_aliases": {
    "items": {
     "minLength": 1,
     "type": "string"
    },
    "maxItems": 12,
    "type": "array"
   },
   "keyword_mode": {
    "enum": [
     "literal",
     "all_terms"
    ],
    "type": "string"
   },
   "newspaper": {
    "description": "Newspaper/periodical substring",
    "type": "string"
   },
   "normalize_by": {
    "description": "Share per bucket in the same country/outlet/date scope; searchable restricts both counts to full text. Thematic filters are removed from the denominator.",
    "enum": [
     "scope",
     "searchable"
    ],
    "type": "string"
   },
   "subject": {
    "description": "Exact tag",
    "type": "string"
   },
   "subset": {
    "description": "articles (default) | publications | references | documents | audiovisual | images",
    "type": "string"
   }
  },
  "type": "object"
 },
