{
 "annotations": {
  "readOnlyHint": true,
  "title": "List customers"
 },
 "description": "List or search customers, 30 per page. Every filter is an exact match on that field. Use `only` to keep the response small. Kickserv: GET /{account}/customers.xml.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "billing_city": {
    "description": "Billing city.",
    "maxLength": 128,
    "type": "string"
   },
   "billing_state": {
    "description": "Billing state.",
    "maxLength": 64,
    "type": "string"
   },
   "customer_number": {
    "description": "Customer number.",
    "exclusiveMinimum": 0,
    "maximum": 9007199254740991,
    "type": "integer"
   },
   "email_address": {
    "description": "Exact email address.",
    "maxLength": 255,
    "type": "string"
   },
   "include": {
    "description": "Related data to embed: contacts, jobs, tasks, notes, tax_entity, custom_field_assignments.",
    "items": {
     "enum": [
      "contacts",
      "jobs",
      "tasks",
      "notes",
      "tax_entity",
      "custom_field_assignments"
     ],
     "type": "string"
    },
    "type": "array"
   },
   "name": {
    "description": "Exact customer name.",
    "maxLength": 255,
    "type": "string"
   },
   "only": {
    "description": "Comma-separated list of columns to return, e.g. `customer_number,name`. Kickserv recommends this: it makes responses much smaller and faster.",
    "pattern": "^[a-z0-9_]+(,[a-z0-9_]+)*$",
    "type": "string"
   },
   "page": {
    "description": "Page number (Kickserv returns 30 records per page). Omit for page 1.",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "phone_number": {
    "description": "Exact phone number, e.g. 800-555-1212.",
    "maxLength": 64,
    "type": "string"
   },
   "service_city": {
    "description": "Service city.",
    "maxLength": 128,
    "type": "string"
   },
   "service_state": {
    "description": "Service state (2-letter abbreviation).",
    "maxLength": 64,
    "type": "string"
   },
   "service_zip_code": {
    "description": "Service ZIP (full zip+4 if the record has one).",
    "maxLength": 32,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "kickserv_list_customers",
 "title": "List customers"
}
