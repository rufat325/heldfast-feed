{
 "description": "Search across tasks, projects, workspaces, comments, and activities.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "limit": {
    "description": "Maximum results, 1 to 50. Defaults to 20.",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "projectId": {
    "description": "Limit to one project",
    "minLength": 1,
    "type": "string"
   },
   "q": {
    "description": "Search query",
    "minLength": 1,
    "type": "string"
   },
   "type": {
    "description": "Restrict results to one kind. Defaults to all.",
    "enum": [
     "all",
     "tasks",
     "projects",
     "workspaces",
     "comments",
     "activities"
    ],
    "type": "string"
   },
   "workspaceId": {
    "description": "Limit to one workspace",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "q"
  ],
  "type": "object"
 },
 "name": "search"
}
