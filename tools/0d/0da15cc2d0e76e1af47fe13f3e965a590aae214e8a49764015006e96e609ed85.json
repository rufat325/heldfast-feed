{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a new prompt template and initial version. Use this for first-time setup; use migrate_prompt for idempotent CI/CD flows. Accepts plain text or structured chat messages, creates a new version immediately, and returns the prompt id, slug, and version id. For multi-message chat prompts pass messages (preferred) or a JSON-encoded array as string.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "ai_model_id": {
    "description": "AI model ID (alternative to model). Required unless model or finetune_id is provided",
    "type": "string"
   },
   "collection_id": {
    "description": "Collection ID to organize the prompt in (use list_collections to find)",
    "type": "string"
   },
   "dry_run": {
    "description": "When true, validate without creating",
    "type": "boolean"
   },
   "finetune_id": {
    "description": "Fine-tune ID (alternative to model). Required unless model or ai_model_id is provided",
    "type": "string"
   },
   "functions": {
    "description": "Function definitions for function calling",
    "items": {
     "properties": {
      "description": {
       "description": "Function description",
       "type": "string"
      },
      "name": {
       "description": "Function name",
       "type": "string"
      },
      "parameters": {
       "additionalProperties": {},
       "description": "Function parameters schema",
       "propertyNames": {
        "type": "string"
       },
       "type": "object"
      }
     },
     "required": [
      "name"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "is_raw_template": {
    "description": "Render the stored template as a raw structural template",
    "type": "boolean"
   },
   "messages": {
    "description": "Structured chat template alias. Serialized to the legacy string format before creation.",
    "items": {
     "additionalProperties": {},
     "description": "Structured chat message in a prompt template",
     "properties": {
      "content": {
       "description": "Message content blocks",
       "items": {
        "additionalProperties": {},
        "description": "Content block within a structured chat message",
        "properties": {
         "text": {
          "description": "Text content for text-based blocks",
          "type": "string"
         },
         "type": {
          "description": "Content block type",
          "type": "string"
         }
        },
        "required": [
         "type"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "role": {
       "description": "Message role in the chat template",
       "enum": [
        "system",
        "user",
        "assistant"
       ],
       "type": "string"
      }
     },
     "required": [
      "role",
      "content"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "model": {
    "description": "Model identifier (e.g., 'gpt-4', 'claude-3-opus'). Required unless ai_model_id or finetune_id is provided",
    "type": "string"
   },
   "name": {
    "description": "Display name for the prompt",
    "type": "string"
   },
   "parameters": {
    "additionalProperties": {},
    "description": "Default values for template variables",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "string": {
    "description": "Legacy prompt template string. Use plain text for single-message prompts, or a JSON-encoded messages array string for multi-message chat prompts.",
    "type": "string"
   },
   "template_metadata": {
    "additionalProperties": {},
    "description": "Custom metadata (app, env, source_file, etc.)",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "tool_choice": {
    "description": "Tool choice strategy",
    "properties": {
     "function_name": {
      "description": "Required when mode is 'function'; ignored otherwise",
      "type": "string"
     },
     "mode": {
      "description": "Tool choice mode: auto lets the model decide, none disables tool use, function forces one function by name",
      "enum": [
       "auto",
       "none",
       "function"
      ],
      "type": "string"
     }
    },
    "required": [
     "mode"
    ],
    "type": "object"
   },
   "tools": {
    "description": "Tool definitions for tool use",
    "items": {
     "properties": {
      "function": {
       "description": "Function definition",
       "properties": {
        "description": {
         "description": "Function description",
         "type": "string"
        },
        "name": {
         "description": "Function name",
         "type": "string"
        },
        "parameters": {
         "additionalProperties": {},
         "description": "Function parameters schema",
         "propertyNames": {
          "type": "string"
         },
         "type": "object"
        }
       },
       "required": [
        "name"
       ],
       "type": "object"
      },
      "type": {
       "const": "function",
       "description": "Tool type",
       "type": "string"
      }
     },
     "required": [
      "type",
      "function"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "version_description": {
    "description": "Description for this prompt version",
    "type": "string"
   },
   "virtual_key": {
    "description": "Virtual key slug for model access",
    "type": "string"
   }
  },
  "required": [
   "name",
   "collection_id",
   "parameters",
   "virtual_key"
  ],
  "type": "object"
 },
 "name": "create_prompt",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Structured success payload when ok is true"
   },
   "error": {
    "additionalProperties": false,
    "description": "Structured error payload when ok is false",
    "properties": {
     "details": {
      "description": "Optional structured error details"
     },
     "message": {
      "description": "Human-readable error message",
      "type": "string"
     }
    },
    "required": [
     "message"
    ],
    "type": "object"
   },
   "ok": {
    "description": "Whether the tool call succeeded and returned structured data",
    "type": "boolean"
   }
  },
  "required": [
   "ok"
  ],
  "type": "object"
 }
}
