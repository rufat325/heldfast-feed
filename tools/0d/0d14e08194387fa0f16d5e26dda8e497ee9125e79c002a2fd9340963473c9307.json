{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Convert one gross pay figure (USD) between hourly, daily, weekly, monthly and yearly for a stated schedule. Overtime hours are paid at 1.5x the base rate; `hour` blends base and overtime. Gross pay only: no taxes, benefits or deductions.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "amount": {
    "exclusiveMinimum": 0,
    "maximum": 10000000,
    "type": "number"
   },
   "daysPerWeek": {
    "default": 5,
    "maximum": 7,
    "minimum": 1,
    "type": "number"
   },
   "hoursPerWeek": {
    "default": 40,
    "maximum": 100,
    "minimum": 1,
    "type": "number"
   },
   "overtimeHours": {
    "default": 0,
    "maximum": 60,
    "minimum": 0,
    "type": "number"
   },
   "unit": {
    "enum": [
     "hour",
     "day",
     "week",
     "month",
     "year"
    ],
    "type": "string"
   },
   "weeksPerYear": {
    "default": 52,
    "maximum": 52,
    "minimum": 1,
    "type": "number"
   }
  },
  "required": [
   "amount",
   "unit"
  ],
  "type": "object"
 },
 "name": "convert_pay",
 "title": "Convert pay between hourly and salary"
}
