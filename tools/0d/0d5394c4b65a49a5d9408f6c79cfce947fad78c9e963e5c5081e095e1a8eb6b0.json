{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Mistral OCR"
 },
 "description": "Run Mistral OCR on a PDF or image, returning structured markdown per page.\n\nInput `document` is one of:\n  - { type: \"document_url\", documentUrl: \"https://...pdf\" }\n  - { type: \"image_url\", imageUrl: \"https://...\" | \"data:image/...\" }\n  - { type: \"file\", fileId: \"<id-from-files-api>\" }\n\nOptions:\n  - `pages`: array of 0-indexed page numbers or string like \"0-5,7\".\n  - `tableFormat`: 'markdown' (default) or 'html'.\n  - `extractHeader` / `extractFooter`: include page header/footer when present.\n  - `includeImageBase64`: embed extracted image bytes as base64 in the response.\n  - `document_annotation_format`: JSON schema for whole-document structured extraction.\n  - `bbox_annotation_format`: JSON schema for extracted image / bbox annotations.\n  - `confidence_scores_granularity`: 'page' or 'word'.\n\nReturns `pages[].markdown` plus optional `pages[].hyperlinks`, `header`, `footer`,\n`images` bounding boxes, annotations, confidence scores, and `dimensions`.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "bbox_annotation_format": {
    "additionalProperties": false,
    "properties": {
     "json_schema": {
      "additionalProperties": false,
      "properties": {
       "description": {
        "type": "string"
       },
       "name": {
        "minLength": 1,
        "type": "string"
       },
       "schema": {
        "additionalProperties": {},
        "type": "object"
       },
       "strict": {
        "type": "boolean"
       }
      },
      "required": [
       "name",
       "schema"
      ],
      "type": "object"
     },
     "type": {
      "const": "json_schema",
      "description": "Only json_schema is accepted by OCR annotation formats.",
      "type": "string"
     }
    },
    "required": [
     "type",
     "json_schema"
    ],
    "type": "object"
   },
   "confidence_scores_granularity": {
    "enum": [
     "page",
     "word"
    ],
    "type": "string"
   },
   "document": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "documentName": {
        "type": "string"
       },
       "documentUrl": {
        "description": "HTTPS URL to a PDF or image.",
        "type": "string"
       },
       "type": {
        "const": "document_url",
        "type": "string"
       }
      },
      "required": [
       "type",
       "documentUrl"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "imageUrl": {
        "description": "HTTPS URL or data:image/...;base64,... payload.",
        "type": "string"
       },
       "type": {
        "const": "image_url",
        "type": "string"
       }
      },
      "required": [
       "type",
       "imageUrl"
      ],
      "type": "object"
     },
     {
      "additionalProperties": false,
      "properties": {
       "fileId": {
        "description": "ID of a file previously uploaded via the Files API.",
        "type": "string"
       },
       "type": {
        "const": "file",
        "type": "string"
       }
      },
      "required": [
       "type",
       "fileId"
      ],
      "type": "object"
     }
    ]
   },
   "document_annotation_format": {
    "$ref": "#/properties/bbox_annotation_format"
   },
   "document_annotation_prompt": {
    "type": "string"
   },
   "extractFooter": {
    "type": "boolean"
   },
   "extractHeader": {
    "type": "boolean"
   },
   "imageLimit": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "imageMinSize": {
    "exclusiveMinimum": 0,
    "type": "integer"
   },
   "includeImageBase64": {
    "type": "boolean"
   },
   "model": {
    "description": "OCR model. Default: mistral-ocr-latest.",
    "enum": [
     "mistral-ocr-latest"
    ],
    "type": "string"
   },
   "pages": {
    "anyOf": [
     {
      "type": "string"
     },
     {
      "items": {
       "minimum": 0,
       "type": "integer"
      },
      "type": "array"
     }
    ]
   },
   "tableFormat": {
    "enum": [
     "markdown",
     "html"
    ],
    "type": "string"
   }
  },
  "required": [
   "document"
  ],
  "type": "object"
 },
 "name": "mistral_ocr",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "annotations": {
    "additionalProperties": false,
    "properties": {
     "document_annotation": {
      "type": "string"
     },
     "image_annotations": {
      "items": {
       "additionalProperties": false,
       "properties": {
        "annotation": {
         "type": "string"
        },
        "bbox": {
         "additionalProperties": false,
         "properties": {
          "bottom_right_x": {
           "type": "number"
          },
          "bottom_right_y": {
           "type": "number"
          },
          "top_left_x": {
           "type": "number"
          },
          "top_left_y": {
           "type": "number"
          }
         },
         "type": "object"
        },
        "image_id": {
         "type": "string"
        },
        "page_index": {
         "type": "integer"
        }
       },
       "required": [
        "page_index",
        "annotation"
       ],
       "type": "object"
      },
      "type": "array"
     }
    },
    "type": "object"
   },
   "document_annotation": {
    "type": "string"
   },
   "model": {
    "type": "string"
   },
   "pages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "confidence_scores": {
       "additionalProperties": false,
       "properties": {
        "average_page_confidence_score": {
         "type": "number"
        },
        "minimum_page_confidence_score": {
         "type": "number"
        },
        "word_confidence_scores": {
         "items": {
          "additionalProperties": false,
          "properties": {
           "confidence": {
            "type": "number"
           },
           "start_index": {
            "type": "integer"
           },
           "text": {
            "type": "string"
           }
          },
          "required": [
           "text",
           "confidence",
           "start_index"
          ],
          "type": "object"
         },
         "type": "array"
        }
       },
       "required": [
        "average_page_confidence_score",
        "minimum_page_confidence_score"
       ],
       "type": "object"
      },
      "dimensions": {
       "anyOf": [
        {
         "additionalProperties": false,
         "properties": {
          "dpi": {
           "type": "number"
          },
          "height": {
           "type": "number"
          },
          "width": {
           "type": "number"
          }
         },
         "type": "object"
        },
        {
         "type": "null"
        }
       ]
      },
      "footer": {
       "type": [
        "string",
        "null"
       ]
      },
      "header": {
       "type": [
        "string",
        "null"
       ]
      },
      "hyperlinks": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "images": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "bottom_right_x": {
          "type": "number"
         },
         "bottom_right_y": {
          "type": "number"
         },
         "id": {
          "type": "string"
         },
         "image_annotation": {
          "type": "string"
         },
         "image_base64": {
          "type": "string"
         },
         "top_left_x": {
          "type": "number"
         },
         "top_left_y": {
          "type": "number"
         }
        },
        "type": "object"
       },
       "type": "array"
      },
      "index": {
       "type": "integer"
      },
      "markdown": {
       "type": "string"
      },
      "tables": {
       "items": {},
       "type": "array"
      }
     },
     "required": [
      "index",
      "markdown"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "pages_count": {
    "type": "integer"
   },
   "usage": {
    "additionalProperties": false,
    "properties": {
     "doc_size_bytes": {
      "type": "number"
     },
     "pages_processed": {
      "type": "number"
     }
    },
    "type": "object"
   }
  },
  "required": [
   "pages",
   "model",
   "pages_count"
  ],
  "type": "object"
 },
 "title": "Mistral OCR (document to markdown)"
}
