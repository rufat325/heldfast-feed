{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Search the Cyber Library"
 },
 "description": "Full-text search over the published pages of cyberlibrary.com (titles, descriptions, paths). Returns the best matches with their path and URL; pass a path to get_page to read it. Docs: https://www.cyberlibrary.com/en/mcp",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "limit": {
    "description": "Max results, default 10",
    "maximum": 50,
    "minimum": 1,
    "type": "integer"
   },
   "locale": {
    "description": "Locale code, default \"en\"",
    "type": "string"
   },
   "query": {
    "description": "Search terms, e.g. \"kerberoasting\" or \"container escape\"",
    "minLength": 2,
    "type": "string"
   }
  },
  "required": [
   "query"
  ],
  "type": "object"
 },
 "name": "search_library",
 "title": "Search the Cyber Library"
}
