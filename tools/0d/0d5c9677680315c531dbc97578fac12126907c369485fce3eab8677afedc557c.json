{
 "description": "Execute a whitelisted Frappe method",
 "inputSchema": {
  "properties": {
   "args": {
    "default": [],
    "description": "Arguments for the method",
    "items": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "type": "boolean"
      },
      {
       "type": "object"
      },
      {
       "type": "array"
      },
      {
       "type": "null"
      }
     ]
    },
    "type": "array"
   },
   "method": {
    "description": "Method path (e.g., 'frappe.client.get')",
    "type": "string"
   },
   "site": {
    "default": "mkahawa.localhost",
    "description": "Site name",
    "type": "string"
   }
  },
  "required": [
   "method"
  ],
  "type": "object"
 },
 "name": "frappe_call_method"
}
