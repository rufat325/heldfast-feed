{
 "annotations": {
  "destructiveHint": true,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": false
 },
 "description": "Change one or more existing transactions: amount, account, main category (null = uncategorized), payee, comment, date, original currency amount; transfers also to_account / to_amount. The type cannot change (delete and re-create instead). Use list_transactions to find ids.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "dry_run": {
    "default": false,
    "description": "Preview the outcome without saving anything",
    "type": "boolean"
   },
   "updates": {
    "items": {
     "properties": {
      "account": {
       "description": "Move to another account (transfers: source account); a currency change requires amount",
       "type": "string"
      },
      "amount": {
       "description": "New amount in the account's currency (transfers: amount leaving; a plain same-currency transfer updates both sides)",
       "exclusiveMinimum": 0,
       "type": "number"
      },
      "category": {
       "description": "New main category (secondary tags are kept); null leaves the transaction uncategorized",
       "type": [
        "string",
        "null"
       ]
      },
      "comment": {
       "description": "New comment; null clears it",
       "type": [
        "string",
        "null"
       ]
      },
      "date": {
       "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
       "type": "string"
      },
      "id": {
       "description": "Transaction id",
       "type": "string"
      },
      "original_amount": {
       "anyOf": [
        {
         "exclusiveMinimum": 0,
         "type": "number"
        },
        {
         "type": "null"
        }
       ],
       "description": "Original-currency amount; null removes it"
      },
      "original_currency": {
       "type": "string"
      },
      "payee": {
       "description": "New payee; null clears it",
       "type": [
        "string",
        "null"
       ]
      },
      "to_account": {
       "description": "Transfers: new destination account",
       "type": "string"
      },
      "to_amount": {
       "description": "Transfers: new amount arriving",
       "exclusiveMinimum": 0,
       "type": "number"
      }
     },
     "required": [
      "id"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "updates"
  ],
  "type": "object"
 },
 "name": "update_transactions",
 "title": "Edit transactions"
}
