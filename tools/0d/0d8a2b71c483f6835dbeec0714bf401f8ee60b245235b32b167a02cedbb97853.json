{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Roof area from the house footprint and pitch, converted to roofing squares (100 sq ft) and shingle bundles. Formula: Pitch factor = \u221a(1 + (rise/12)\u00b2). Roof area = (L + 2\u00d7overhang) \u00d7 (W + 2\u00d7overhang) \u00d7 pitch factor. Squares = area \u00f7 100 \u00d7 (1 + waste%).",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "bundles_per_square": {
    "description": "Bundles per square (see wrapper); default 3",
    "type": "number"
   },
   "footprint_length_ft": {
    "description": "Footprint length (ft); default 40",
    "type": "number"
   },
   "footprint_width_ft": {
    "description": "Footprint width (ft); default 30",
    "type": "number"
   },
   "overhang_in": {
    "description": "Eave/rake overhang (in); default 12",
    "type": "number"
   },
   "pitch_rise": {
    "description": "Pitch (rise per 12 in run) (in); default 6",
    "type": "number"
   },
   "waste_pct": {
    "description": "Waste allowance (%); default 10",
    "type": "number"
   }
  },
  "type": "object"
 },
 "name": "calc_roofing",
 "title": "Roofing Calculator (Squares, Bundles & Pitch Factor)"
}
