  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "How a token's metrics moved"
 },
 "description": "How a token's metrics moved this period\n\nThe latest snapshot plus, for holders, volume, liquidity, concentration, heartbeat, price and market cap, the average over the last `period` days against the `period` before it, with the change and percentage change. Public. A metric with no data in either period is left out, and `change`/`pctChange` appear only when both periods have data. The id is `<symbol>.<chainKey>`; an unknown id answers 200 with nothing in it.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "The token as `<symbol>.<chainKey>` in lower case, e.g. `pepe.base` (not the numeric token id)",
    "examples": [
     "pepe.base"
    ],
    "type": "string"
   },
   "period": {
    "default": 7,
    "description": "Days per period",
    "maximum": 365,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "id"
  ],
  "type": "object"
 },
