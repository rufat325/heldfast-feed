{
 "description": "Change a site's url, timezone or week start. Omitted fields are left alone. Returns the updated site. Changing the url to one this account already has is refused (site_exists).",
 "inputSchema": {
  "properties": {
   "site": {
    "description": "site_id from list_sites.",
    "type": [
     "string",
     "integer"
    ]
   },
   "timezone": {
    "description": "Optional IANA name.",
    "type": "string"
   },
   "url": {
    "description": "Optional. Full origin including scheme.",
    "type": "string"
   },
   "week_start": {
    "description": "Optional. 0 = Sunday ... 6 = Saturday.",
    "maximum": 6,
    "minimum": 0,
    "type": "integer"
   }
  },
  "required": [
   "site"
  ],
  "type": "object"
 },
 "name": "update_site"
}
