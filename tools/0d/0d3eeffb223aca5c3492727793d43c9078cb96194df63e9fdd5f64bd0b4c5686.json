{
 "_meta": {
  "securitySchemes": [
   {
    "scopes": [
     "train:write"
    ],
    "type": "oauth2"
   }
  ]
 },
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Use after get_voice_conversion says the job is complete and the user wants the cleaned or standard output. Each download uses the source audio's duration from the account's conversion-download minutes. If the exact file was downloaded before, ask before retrying and then set confirmRepeat true.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "confirmRepeat": {
    "default": false,
    "description": "Only true after the user explicitly confirms downloading the same artifact again.",
    "type": "boolean"
   },
   "conversionId": {
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   },
   "eventId": {
    "pattern": "^[A-Za-z0-9_-]{8,80}$",
    "type": "string"
   },
   "kind": {
    "description": "Prefer cleaned unless the user specifically asks for standard RVC.",
    "enum": [
     "cleaned",
     "normal"
    ],
    "type": "string"
   }
  },
  "required": [
   "conversionId",
   "kind"
  ],
  "type": "object"
 },
 "name": "download_voice_conversion_output",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": {},
  "properties": {
   "accepted": {
    "type": "boolean"
   },
   "downloadCount": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "downloadUrl": {
    "format": "uri",
    "type": "string"
   },
   "secondsCharged": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   }
  },
  "required": [
   "accepted",
   "downloadUrl",
   "downloadCount",
   "secondsCharged"
  ],
  "type": "object"
 },
 "securitySchemes": [
  {
   "scopes": [
    "train:write"
   ],
   "type": "oauth2"
  }
 ],
 "title": "Download a completed voice conversion"
}
