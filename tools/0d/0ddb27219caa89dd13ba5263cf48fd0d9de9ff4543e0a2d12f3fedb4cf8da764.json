{
 "description": "Compare two configuration files in any supported format (JSON, YAML, TOML, INI). Shows additions, removals, and changes with nested path information.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "content_a": {
    "description": "First config file content",
    "type": "string"
   },
   "content_b": {
    "description": "Second config file content",
    "type": "string"
   },
   "format_a": {
    "default": "auto",
    "description": "Format of first file (default: auto-detect)",
    "enum": [
     "json",
     "yaml",
     "toml",
     "ini",
     "auto"
    ],
    "type": "string"
   },
   "format_b": {
    "default": "auto",
    "description": "Format of second file (default: auto-detect)",
    "enum": [
     "json",
     "yaml",
     "toml",
     "ini",
     "auto"
    ],
    "type": "string"
   }
  },
  "required": [
   "content_a",
   "content_b"
  ],
  "type": "object"
 },
 "name": "config_diff"
}
