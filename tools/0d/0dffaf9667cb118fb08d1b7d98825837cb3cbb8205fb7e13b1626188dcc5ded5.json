{
 "description": "Structured personalized forecast for birth data \u2014 per-area tones, day calendar, ingresses, dasha standing. period: daily (optional date), weekly, monthly (optional year+month), or yearly (optional year). Deterministic engine output, no LLM narration. lang: en or hi (default en). Same compute path as POST /api/b2b/forecast.",
 "inputSchema": {
  "properties": {
   "birth_data": {
    "properties": {
     "dob": {
      "description": "Birth date, YYYY-MM-DD.",
      "type": "string"
     },
     "lat": {
      "description": "Birth latitude, -90 to 90.",
      "type": "number"
     },
     "lng": {
      "description": "Birth longitude, -180 to 180.",
      "type": "number"
     },
     "tob": {
      "description": "Birth time, HH:MM (24h).",
      "type": "string"
     },
     "tz": {
      "description": "UTC offset (e.g. 5.5) or IANA zone name (e.g. Asia/Kolkata).",
      "type": [
       "number",
       "string"
      ]
     }
    },
    "required": [
     "dob",
     "tob",
     "lat",
     "lng",
     "tz"
    ],
    "type": "object"
   },
   "date": {
    "description": "YYYY-MM-DD (daily period only).",
    "type": "string"
   },
   "lang": {
    "enum": [
     "en",
     "hi"
    ],
    "type": "string"
   },
   "month": {
    "description": "Target month 1-12 (monthly period only).",
    "type": "integer"
   },
   "period": {
    "enum": [
     "daily",
     "weekly",
     "monthly",
     "yearly"
    ],
    "type": "string"
   },
   "year": {
    "description": "Target year (monthly/yearly periods).",
    "type": "integer"
   }
  },
  "required": [
   "birth_data",
   "period"
  ],
  "type": "object"
 },
 "name": "get_forecast"
}
