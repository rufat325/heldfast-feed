{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "List SWSD users. Returns id, name, email, disabled, available_for_assignment, role, site, department, title. Set `available_for_assignment_only: true` to find valid assignees for swsd_assign_incident. Set `email` to look up one user exactly.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "available_for_assignment_only": {
    "default": false,
    "description": "If true, only return users who can be assigned tickets.",
    "type": "boolean"
   },
   "email": {
    "description": "Filter to a specific email exactly.",
    "format": "email",
    "maxLength": 320,
    "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "page": {
    "default": 1,
    "description": "Page number (1-indexed).",
    "maximum": 10000,
    "minimum": 1,
    "type": "integer"
   },
   "per_page": {
    "default": 25,
    "description": "Results per page (1-100).",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "description": "Optional name or email substring filter.",
    "maxLength": 2000,
    "type": "string"
   }
  },
  "type": "object"
 },
 "name": "swsd_list_users",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "pagination": {
    "additionalProperties": false,
    "properties": {
     "has_more": {
      "description": "True when more pages exist beyond this one.",
      "type": "boolean"
     },
     "next_page": {
      "description": "The next page number to request, when has_more is true.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "page": {
      "description": "Current page (1-indexed).",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "per_page": {
      "description": "Items per page used in the request.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     },
     "total": {
      "description": "Total record count when SWSD returns X-Total-Count.",
      "maximum": 9007199254740991,
      "minimum": -9007199254740991,
      "type": "integer"
     }
    },
    "required": [
     "page",
     "per_page",
     "has_more"
    ],
    "type": "object"
   },
   "users": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "available_for_assignment": {
       "type": "boolean"
      },
      "department": {
       "type": "string"
      },
      "disabled": {
       "type": "boolean"
      },
      "email": {
       "type": "string"
      },
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "name": {
       "type": "string"
      },
      "role": {
       "type": "string"
      },
      "site": {
       "type": "string"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "name",
      "disabled"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "users",
   "pagination"
  ],
  "type": "object"
 }
}
