{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Create a hiring pipeline"
 },
 "description": "Create a custom pipeline template with optional inline stages. Does not affect the org default pipeline or candidate tracking.",
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "description": {
    "anyOf": [
     {
      "maxLength": 2000,
      "type": "string"
     },
     {
      "type": "null"
     }
    ]
   },
   "idempotency_key": {
    "minLength": 1,
    "type": "string"
   },
   "name": {
    "maxLength": 200,
    "minLength": 1,
    "type": "string"
   },
   "request_id": {
    "minLength": 1,
    "type": "string"
   },
   "slug": {
    "pattern": "^[a-z0-9][a-z0-9_]{0,62}$",
    "type": "string"
   },
   "stages": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "approval_scope": {
       "anyOf": [
        {
         "enum": [
          "applications:offer",
          "applications:hire",
          "applications:reject",
          "applications:withdraw"
         ],
         "type": "string"
        },
        {
         "type": "null"
        }
       ]
      },
      "is_terminal": {
       "type": "boolean"
      },
      "name": {
       "maxLength": 200,
       "minLength": 1,
       "type": "string"
      },
      "slug": {
       "pattern": "^[a-z0-9][a-z0-9_]{0,62}$",
       "type": "string"
      },
      "stage_kind": {
       "enum": [
        "normal",
        "offer",
        "hired",
        "rejected",
        "terminal"
       ],
       "type": "string"
      }
     },
     "required": [
      "name",
      "slug",
      "stage_kind"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "type": "array"
   }
  },
  "required": [
   "name",
   "slug"
  ],
  "type": "object"
 },
 "name": "yardstick_pipelines_create",
 "title": "Create a hiring pipeline"
}
