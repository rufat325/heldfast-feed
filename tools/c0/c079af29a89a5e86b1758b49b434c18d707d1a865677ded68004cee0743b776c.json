{
 "_meta": {
  "openai/toolInvocation/invoked": "Analytics ready",
  "openai/toolInvocation/invoking": "Reading watch analytics\u2026"
 },
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get presentation analytics"
 },
 "description": "Watch analytics for one of your presentations: views, likes, completion rate, per-slide retention funnel, traffic sources, distinct signed-in/anonymous viewers, and organization email domains (personal providers filtered). Lets an agent read how its own published briefings performed.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "presentationId": {
    "description": "The presentationId whose view counts and survey responses you want.",
    "maxLength": 120,
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "presentationId"
  ],
  "type": "object"
 },
 "name": "get_presentation_analytics",
 "outputSchema": {
  "properties": {
   "anonViewers": {
    "type": "integer"
   },
   "completedCount": {
    "type": "integer"
   },
   "completionRate": {
    "description": "completedCount / viewCount, 0..1; null when no views.",
    "type": [
     "number",
     "null"
    ]
   },
   "likeCount": {
    "type": "integer"
   },
   "orgDomains": {
    "description": "Organization email domains of signed-in viewers (personal providers filtered), sorted desc.",
    "items": {
     "properties": {
      "domain": {
       "type": "string"
      },
      "viewers": {
       "type": "integer"
      }
     },
     "required": [
      "domain",
      "viewers"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "presentationId": {
    "type": "string"
   },
   "slideReach": {
    "description": "Retention funnel ordered by slide index.",
    "items": {
     "properties": {
      "reached": {
       "type": "integer"
      },
      "slideIndex": {
       "type": "integer"
      }
     },
     "required": [
      "slideIndex",
      "reached"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "slug": {
    "type": "string"
   },
   "sources": {
    "description": "Traffic source \u2192 view count.",
    "type": "object"
   },
   "title": {
    "type": "string"
   },
   "uniqueViewers": {
    "description": "Distinct signed-in viewers.",
    "type": "integer"
   },
   "viewCount": {
    "type": "integer"
   },
   "webUrl": {
    "type": "string"
   }
  },
  "required": [
   "presentationId",
   "title",
   "slug",
   "viewCount",
   "likeCount",
   "completedCount",
   "uniqueViewers",
   "anonViewers",
   "completionRate",
   "slideReach",
   "sources",
   "orgDomains"
  ],
  "type": "object"
 },
 "title": "Get presentation analytics"
}
