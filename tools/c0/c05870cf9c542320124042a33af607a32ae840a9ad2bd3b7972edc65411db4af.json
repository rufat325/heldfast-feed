    "pattern": "^[a-zA-Z0-9_-]{1,100}$",
    "type": "string"
   },
   "game": {
    "enum": [
     "pokemon",
     "pokemon_jp",
     "magic",
     "lorcana",
     "onepiece",
     "yugioh"
    ],
    "type": "string"
   },
   "limit": {
    "default": 25,
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   },
   "query": {
    "default": "",
    "description": "Case-insensitive card name match; empty browses the catalogue.",
    "maxLength": 100,
    "type": "string"
   },
   "set": {
    "description": "Exact set ID from a catalogue response.",
    "maxLength": 100,
    "type": "string"
   },
   "view": {
    "default": "compact",
    "enum": [
     "compact",
     "full"
    ],
    "type": "string"
   }
  },
  "required": [
   "game"
  ],
  "type": "object"
