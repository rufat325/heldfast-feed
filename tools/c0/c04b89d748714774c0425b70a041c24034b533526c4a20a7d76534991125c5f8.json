   },
   "name": {
    "description": "Collection or table name.",
    "minLength": 1,
    "type": "string"
   },
   "update": {
    "additionalProperties": {},
    "description": "Update operators, e.g. {\"$set\": {\"status\": \"done\"}, \"$inc\": {\"views\": 1}}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "upsert": {
    "default": false,
    "description": "Insert when nothing matches (collections).",
    "type": "boolean"
   }
  },
  "required": [
