   "mimeType": "image/svg+xml",
   "sizes": [
    "any"
   ],
   "src": "data:image/svg+xml;base64,"
  }
 ],
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "confirm": {
    "description": "Set ONLY after you described the impact and the user approved it in a later message: the exact target name. The original request is not approval; never guess or self-approve.",
    "type": "string"
   },
   "database": {
    "description": "Database to use: name, id, or Data API endpoint URL. Omit for the configured default.",
    "minLength": 1,
    "type": "string"
   },
   "filter": {
    "additionalProperties": {},
    "description": "Data API filter, e.g. {\"status\": \"active\", \"year\": {\"$gte\": 2020}}. Typed ids as {\"$uuid\": \"\u2026\"} / {\"$objectId\": \"\u2026\"}.",
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "keyspace": {
    "description": "Keyspace. Omit for the configured/default keyspace.",
    "minLength": 1,
    "type": "string"
   },
   "kind": {
