{"annotations":{"destructiveHint":false,"idempotentHint":true,"openWorldHint":false,"readOnlyHint":true,"title":"Look at a picture"},"description":"Fetch one picture so you can see it: returns the image itself, plus its permanent links and alt text. Use it only when you need to look (to check a picture suits the user, or to describe it); to hand a picture over, give the user the url from search_backgrounds instead. size 1280 (WebP, usually 100 to 300 KB) is the default and enough to look at; 640 is smaller; 1920 is the full JPG of up to 1 MB and rarely needed. Example: {\"id\": \"bg-001\", \"time\": \"night\"}","inputSchema":{"additionalProperties":false,"properties":{"id":{"description":"Scene id, like bg-001.","maxLength":20,"pattern":"^[A-Za-z]+-[0-9]+$","type":"string"},"size":{"default":1280,"description":"Width in pixels: 640 or 1280 (WebP), 1920 (JPG).","enum":[640,1280,1920],"type":"integer"},"time":{"description":"Time of day; the scene's first time (usually day) when absent. get_scene lists the times a scene has.","enum":["day","sunset","night","rain","snow"],"type":"string"}},"required":["id"],"type":"object"},"name":"download_image","outputSchema":{"properties":{"image":{"properties":{"alt":{"type":"string"},"colors":{"items":{"type":"string"},"type":"array"},"description":{"type":"string"},"download":{"type":"string"},"format":{"type":"string"},"height":{"type":"integer"},"palette":{"type":"string"},"preview":{"type":"string"},"thumbnail":{"type":"string"},"time":{"type":"string"},"url":{"type":"string"},"width":{"type":"integer"}},"required":["time","url","width","height","format","preview","thumbnail","download","alt","description","palette","colors"],"type":"object"},"included":{"type":"boolean"},"license":{"properties":{"ai_generated":{"type":"boolean"},"ai_training_dataset":{"type":"boolean"},"attribution_required":{"type":"boolean"},"commercial_use":{"type":"boolean"},"modification":{"type":"boolean"},"name":{"type":"string"},"redistribution_as_is