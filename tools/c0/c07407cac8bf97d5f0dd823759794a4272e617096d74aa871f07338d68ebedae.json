{
 "description": "Anonymous cost estimate. Returns $low\u2013$high range computed from regional + case factors. Only procedure_slug is required: anything omitted gets a stated default listed in \"assumptions\" (no zip \u2192 the state, else the national range). Deterministic on identical inputs. PII fields are rejected \u2014 use quote_for_case for the PII path.",
 "inputSchema": {
  "additionalProperties": false,
  "properties": {
   "case_factors": {
    "description": "All optional. Defaults (stated in the result): dog, m, adult, moderate, elective. Plain words and numbers are understood.",
    "properties": {
     "age_band": {
      "description": "puppy, young-adult, adult or senior.",
      "type": "string"
     },
     "age_years": {
      "type": "number"
     },
     "comorbidities": {
      "description": "cardiac, renal, endocrine, obesity.",
      "items": {
       "type": "string"
      },
      "type": "array"
     },
     "severity": {
      "description": "mild, moderate or severe.",
      "type": "string"
     },
     "species": {
      "description": "dog or cat (canine/feline understood).",
      "type": "string"
     },
     "urgency": {
      "description": "elective, urgent or emergency.",
      "type": "string"
     },
     "weight_band": {
      "description": "xs <5 kg \u00b7 s 5\u201315 \u00b7 m 15\u201330 \u00b7 l 30\u201350 \u00b7 xl >50.",
      "type": "string"
     },
     "weight_kg": {
      "type": "number"
     },
     "weight_lb": {
      "type": "number"
     }
    },
    "type": "object"
   },
   "city": {
    "description": "City slug. Optional.",
    "type": "string"
   },
   "procedure_slug": {
    "description": "From list_procedures, e.g. tplo-surgery.",
    "type": "string"
   },
   "state": {
    "description": "US state code or name. Optional; used for the regional adjustment when there is no zip.",
    "type": "string"
   },
   "zip": {
    "description": "US ZIP (5-digit or ZIP+4). Optional.",
    "type": "string"
   }
  },
  "required": [
   "procedure_slug"
  ],
  "type": "object"
 },
 "name": "estimate_procedure_cost"
}
