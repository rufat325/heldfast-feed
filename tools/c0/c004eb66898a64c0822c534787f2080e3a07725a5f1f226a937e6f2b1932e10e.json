{
 "annotations": {
  "openWorldHint": false,
  "readOnlyHint": true
 },
 "description": "Compare project state against a point in time. Returns new tickets, title/description/score changes, deleted tickets, and tag changes since the timestamp.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "project": {
    "description": "Project name (falls back to .rewelo.json)",
    "type": "string"
   },
   "since": {
    "description": "ISO timestamp to diff from (e.g. '2026-03-10T00:00:00Z')",
    "type": "string"
   }
  },
  "required": [
   "since"
  ],
  "type": "object"
 },
 "name": "project_diff",
 "outputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
   "deletedTickets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "newTickets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "id": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "priority": {
       "type": "number"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "title",
      "priority"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "now": {
    "description": "ISO timestamp",
    "type": "string"
   },
   "since": {
    "description": "ISO timestamp",
    "type": "string"
   },
   "tagChanges": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "added": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "removed": {
       "items": {
        "type": "string"
       },
       "type": "array"
      },
      "ticketId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "ticketTitle": {
       "type": "string"
      }
     },
     "required": [
      "ticketId",
      "ticketTitle",
      "added",
      "removed"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "updatedTickets": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "changes": {
       "items": {
        "additionalProperties": false,
        "properties": {
         "field": {
          "type": "string"
         },
         "from": {},
         "to": {}
        },
        "required": [
         "field",
         "from",
         "to"
        ],
        "type": "object"
       },
       "type": "array"
      },
      "ticketId": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      }
     },
     "required": [
      "ticketId",
      "title",
      "changes"
     ],
     "type": "object"
    },
    "type": "array"
   }
  },
  "required": [
   "since",
   "now",
   "newTickets",
   "updatedTickets",
   "deletedTickets",
   "tagChanges"
  ],
  "type": "object"
 }
}
