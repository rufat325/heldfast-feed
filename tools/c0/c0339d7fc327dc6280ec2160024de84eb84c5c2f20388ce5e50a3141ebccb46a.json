{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Retrieve one public asset by its exact kind and id. Source is returned only where the asset's contentLevel and license permit it. Remote templates include their actual file set only when the live source is available; if it is down, the tool returns a structured unavailable error with safe metadata and does not treat a download URL as source code. External and restricted assets expose metadata, license, attribution and source links only.\n\nArgs:\n  - kind: the namespace returned by stylekit_list_assets.\n  - id: the exact identifier within that namespace.\n\nReturns complete structured JSON and JSON text, preserving the namespace and provenance.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "id": {
    "description": "Exact asset id within the namespace",
    "pattern": "^[a-z0-9][a-z0-9-]{0,127}$",
    "type": "string"
   },
   "kind": {
    "description": "Public asset namespace",
    "enum": [
     "style",
     "recipe",
     "animation",
     "background",
     "gradient",
     "shadow",
     "typography",
     "palette",
     "component-pattern",
     "spacing",
     "layout-grid",
     "design-principle",
     "visual-hierarchy",
     "type-scale",
     "archetype",
     "prompt",
     "template",
     "experience-pack"
    ],
    "type": "string"
   }
  },
  "required": [
   "kind",
   "id"
  ],
  "type": "object"
 },
 "name": "stylekit_get_asset",
