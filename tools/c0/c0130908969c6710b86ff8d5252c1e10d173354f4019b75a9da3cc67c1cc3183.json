{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "Read a filing section"
 },
 "description": "Read a named section from an SEC filing id. Omitting section returns the section index without text. A section reply contains at most 20,000 characters, with its original length and an explicit truncation flag.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "filing_id": {
    "pattern": "^\\d{1,10}-\\d{18}$",
    "type": "string"
   },
   "max_characters": {
    "default": 12000,
    "maximum": 20000,
    "minimum": 500,
    "type": "integer"
   },
   "section": {
    "pattern": "^[a-z0-9-]{1,80}$",
    "type": "string"
   }
  },
  "required": [
   "filing_id"
  ],
  "type": "object"
 },
 "name": "read_filing_section",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "api_url": {
    "type": "string"
   },
   "docs_url": {
    "type": "string"
   },
   "error": {
    "maxLength": 80,
    "type": "string"
   },
   "http_status": {
    "maximum": 9007199254740991,
    "minimum": -9007199254740991,
    "type": "integer"
   },
   "id": {
    "type": "string"
   },
   "index_only": {
    "type": "boolean"
   },
   "message": {
    "type": "string"
   },
   "meta": {
    "additionalProperties": {
     "type": [
      "string",
      "number",
      "boolean",
      "null"
     ]
    },
    "propertyNames": {
     "type": "string"
    },
    "type": "object"
   },
   "parserVersion": {
    "type": "string"
   },
   "product": {
    "const": "filings",
    "type": "string"
   },
   "retry_after": {
    "maxLength": 80,
    "type": "string"
   },
   "section_found": {
    "type": "boolean"
   },
   "sections": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "chars": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "id": {
       "type": "string"
      },
      "markdown": {
       "maxLength": 20000,
       "type": "string"
      },
      "returned_characters": {
       "maximum": 9007199254740991,
       "minimum": -9007199254740991,
       "type": "integer"
      },
      "title": {
       "type": "string"
      },
      "truncated": {
       "type": "boolean"
      }
     },
     "required": [
      "id",
      "title",
      "chars"
     ],
     "type": "object"
    },
    "maxItems": 80,
    "type": "array"
   },
   "sections_truncated": {
    "type": "boolean"
   },
   "sourceUrl": {
    "type": "string"
   },
   "status": {
    "enum": [
     "success",
     "tool_error",
     "internal_error"
    ],
    "type": "string"
   },
   "title": {
    "type": "string"
   },
   "topics": {
    "items": {
     "type": "string"
    },
    "type": "array"
