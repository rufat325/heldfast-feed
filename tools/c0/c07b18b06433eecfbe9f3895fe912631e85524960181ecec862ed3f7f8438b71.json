{
 "description": "Batch-fetch market data for up to 50 markets in a single request. Pass either 'addresses' or 'conditionIds'. Returns the same shape as get_market for each market.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "addresses": {
    "description": "Up to 50 market contract addresses.",
    "items": {
     "pattern": "^0x[a-fA-F0-9]{40}$",
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   },
   "conditionIds": {
    "description": "Up to 50 conditionIds (bytes32 hex strings).",
    "items": {
     "type": "string"
    },
    "maxItems": 50,
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "batch_get_markets"
}
