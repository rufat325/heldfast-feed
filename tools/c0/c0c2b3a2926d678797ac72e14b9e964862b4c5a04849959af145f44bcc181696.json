  "readOnlyHint": true,
  "title": "utilpeek: look up a phone number prefix (country, line type, original network)"
 },
 "description": "utilpeek: Look up a phone number prefix: country, line type and original network, with ambiguity. To parse a full number use parse_phone_number. Returns the country, line type, original network, time zones and E.164 form of the leading digits of a number (0917, +63917, 0063917), `ambiguous` with `candidates` when they span networks; `list` with `region` lists a country's mobile prefixes by network. Input: `prefix`, optional `region` to read a national form such as 0917; or `list: true` with `region` and no prefix. Original range holder, not the current network (number portability); offline metadata; a national form without `region` lists candidate `countries`. Bad input is a 422 (not charged). Typically under 0.1 s. Price: USD 0.001. Free: 10 utilpeek calls per IP per UTC day. The submitted text is never logged or stored. Docs: https://tanod.dev/learn/phone-number-prefix-lookup-api.html",
 "inputSchema": {
  "properties": {
   "list": {
    "default": false,
    "description": "With `region` (and no prefix): return every mobile prefix of that country at the 4-digit national level (e.g. 0905, 0917), grouped by network.",
    "title": "List",
    "type": "boolean"
   },
   "prefix": {
    "anyOf": [
     {
      "maxLength": 24,
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "The leading digits of a number, in any form: 0917, 917, +63917, 0063917 or 63917 (digits with an optional leading + or 00; separators space - . ( ) are ignored). Without `region` a national form (0917) is read in every country and the reply lists the candidate `countries`. Omit with `list`.",
    "title": "Prefix"
   },
   "region": {
    "anyOf": [
     {
      "pattern": "^[A-Za-z]{2}$",
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "description": "ISO 3166-1 alpha-2 country (PH, US, GB, ...): reads a national prefix and selects the country for `list`.",
    "title": "Region"
   }
  },
  "title": "lookup_phone_prefixArguments",
  "type": "object"
 },
