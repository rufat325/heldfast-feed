{
 "annotations": {
  "destructiveHint": true,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Changes access on explicit request only. Never publishes a draft. The password is never returned.\n\n        This tool sets the password and the addresses; to make a draft public, use foliade_publish_catalogue.\n\n        Declaring a domain does not configure DNS/TLS; activation remains a separate operation.\n        ",
 "inputSchema": {
  "properties": {
   "catalogue_id": {
    "pattern": "^[A-Za-z0-9_-]{1,64}$",
    "title": "Catalogue Id",
    "type": "string"
   },
   "domaine": {
    "anyOf": [
     {
      "maxLength": 160,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Domaine"
   },
   "dry_run": {
    "default": false,
    "title": "Dry Run",
    "type": "boolean"
   },
   "expected_revision": {
    "pattern": "^[a-f0-9]{64}$",
    "title": "Expected Revision",
    "type": "string"
   },
   "password": {
    "default": "",
    "maxLength": 128,
    "title": "Password",
    "type": "string"
   },
   "protection": {
    "default": "keep",
    "enum": [
     "keep",
     "none",
     "password"
    ],
    "title": "Protection",
    "type": "string"
   },
   "sous_domaine": {
    "anyOf": [
     {
      "maxLength": 64,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "default": null,
    "title": "Sous Domaine"
   }
  },
  "required": [
   "catalogue_id",
   "expected_revision"
  ],
  "title": "set_catalogue_accessArguments",
  "type": "object"
 },
 "name": "foliade_set_catalogue_access",
 "title": "Set the catalogue protection and addresses"
}
