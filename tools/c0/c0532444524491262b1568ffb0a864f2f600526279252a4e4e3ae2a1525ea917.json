{
 "annotations": {
  "readOnlyHint": true
 },
 "description": "Query time-series monitoring data from Cloud Insight. Returns metric data for a specific product and metric.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "aggregation": {
    "description": "Aggregation type (default: AVG)",
    "enum": [
     "AVG",
     "MIN",
     "MAX",
     "SUM",
     "COUNT"
    ],
    "type": "string"
   },
   "cw_key": {
    "description": "Product key (cw_key) identifying the service (see Cloud Insight metrics)",
    "type": "string"
   },
   "dimensions": {
    "additionalProperties": {
     "type": "string"
    },
    "description": "Dimension filters as key-value pairs (e.g., {\"instanceNo\": \"12345\"})",
    "type": "object"
   },
   "interval": {
    "description": "Aggregation interval (default: Min5)",
    "enum": [
     "Min1",
     "Min5",
     "Min30",
     "Hour2",
     "Day1"
    ],
    "type": "string"
   },
   "metric": {
    "description": "Metric name to query (e.g., \"avg_cpu_used_rto\", \"mem_usert\")",
    "type": "string"
   },
   "prodName": {
    "description": "Product name (e.g., \"System/Server(VPC)\")",
    "type": "string"
   },
   "timeEnd": {
    "description": "End time in Unix epoch milliseconds",
    "type": "number"
   },
   "timeStart": {
    "description": "Start time in Unix epoch milliseconds",
    "type": "number"
   }
  },
  "required": [
   "cw_key",
   "prodName",
   "metric",
   "timeStart",
   "timeEnd"
  ],
  "type": "object"
 },
 "name": "ncloud_query_monitoring_data"
}
