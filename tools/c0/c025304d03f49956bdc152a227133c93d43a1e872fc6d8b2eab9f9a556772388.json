{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": false,
  "readOnlyHint": false,
  "title": "Suggest resort"
 },
 "description": "Suggest a missing resort for human review. This never adds it directly to the resort index.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "country": {
    "maxLength": 80,
    "minLength": 2,
    "type": "string"
   },
   "lat": {
    "maximum": 90,
    "minimum": -90,
    "type": "number"
   },
   "lon": {
    "maximum": 180,
    "minimum": -180,
    "type": "number"
   },
   "name": {
    "maxLength": 100,
    "minLength": 2,
    "type": "string"
   },
   "notes": {
    "maxLength": 500,
    "type": "string"
   },
   "website": {
    "format": "uri",
    "maxLength": 300,
    "type": "string"
   }
  },
  "required": [
   "name",
   "country",
   "lat",
   "lon"
  ],
  "type": "object"
 },
 "name": "suggest_resort",
 "title": "Suggest resort"
}
