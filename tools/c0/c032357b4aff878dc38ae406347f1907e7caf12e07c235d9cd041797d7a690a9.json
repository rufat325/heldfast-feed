{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Get combined dasha and transit context"
 },
 "description": "For one date, returns active Vimshottari periods plus Saturn, Jupiter and node transit houses from natal Moon and Lagna. Sade Sati and Dhaiya are labelled structural periods, not guaranteed outcomes.",
 "inputSchema": {
  "properties": {
   "date": {
    "type": "string"
   },
   "language": {
    "default": "en",
    "enum": [
     "en",
     "te"
    ],
    "type": "string"
   },
   "latitude": {
    "type": "number"
   },
   "longitude": {
    "type": "number"
   },
   "name": {
    "type": "string"
   },
   "place": {
    "type": "string"
   },
   "queryDate": {
    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
    "type": "string"
   },
   "queryTime": {
    "default": "12:00",
    "type": "string"
   },
   "time": {
    "type": "string"
   },
   "timezone": {
    "type": "string"
   },
   "timezoneOffset": {
    "type": "number"
   }
  },
  "required": [
   "date",
   "time",
   "place",
   "latitude",
   "longitude",
   "timezoneOffset",
   "queryDate"
  ],
  "type": "object"
 },
 "name": "get_timing_context",
 "outputSchema": {
  "properties": {
   "dasha": {
    "type": "object"
   },
   "queryDate": {
    "type": "string"
   },
   "saturnPeriods": {
    "type": "object"
   },
   "schemaVersion": {
    "const": "sahadeva-timing-1"
   },
   "transits": {
    "type": "array"
   }
  },
  "required": [
   "schemaVersion",
   "queryDate",
   "dasha",
   "transits",
   "saturnPeriods"
  ],
  "type": "object"
 },
 "title": "Get combined dasha and transit context"
}
