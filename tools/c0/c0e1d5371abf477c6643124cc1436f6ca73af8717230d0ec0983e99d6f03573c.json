{
 "description": "Corrige um valor pela infla\u00e7\u00e3o (IPCA). Mostra quanto um valor do passado equivale hoje, ou quanto o poder de compra diminuiu. Par\u00e2metros obrigat\u00f3rios: original_value, years. Opcionais: annual_inflation, direction. Use exatamente estes nomes, em ingl\u00eas.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "annual_inflation": {
    "default": 5.5,
    "description": "Infla\u00e7\u00e3o anual m\u00e9dia (%, padr\u00e3o 5.5% \u2014 IPCA 2026)",
    "exclusiveMinimum": -100,
    "maximum": 1000,
    "type": "number"
   },
   "direction": {
    "default": "past_to_present",
    "description": "Dire\u00e7\u00e3o do c\u00e1lculo",
    "enum": [
     "past_to_present",
     "present_to_future"
    ],
    "type": "string"
   },
   "original_value": {
    "description": "Valor original em R$",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "years": {
    "description": "N\u00famero de anos",
    "exclusiveMinimum": 0,
    "maximum": 50,
    "type": "number"
   }
  },
  "required": [
   "original_value",
   "years"
  ],
  "type": "object"
 },
 "name": "calculate_inflation_adjustment"
}
