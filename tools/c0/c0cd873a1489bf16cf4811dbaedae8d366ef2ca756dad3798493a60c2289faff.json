{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": true
 },
 "description": "Search the TCLP knowledge graph using fusion search (semantic + BM25).\n\n    Args:\n        query: Free-text search query (max 1000 characters).\n        node_type: Content scope \u2014 \"tclp\" (clauses, glossary terms, guides) or \"all\".\n            Laws, regulations, standards and frameworks are not searchable here:\n            use `find_legal_resources`.\n        limit: Maximum number of results to return (1\u201350).\n        rerank: Whether to apply RRF reranking when combining graph and text results.\n        include_full_text: Include each hit's full body text (Markdown). Off by\n            default \u2014 bodies are large; request only when you need the content,\n            and prefer a small `limit` when you do.\n\n    Returns:\n        JSON with \"meta\" (totals, timing) and \"results\" (ranked hits with title,\n        url, content_type, scores, optionally relationships_text, related and\n        full_text).\n        Each hit's \"references\" lists the instruments it cites: pass a\n        reference's `work_id` to `get_legal_resource` for details. A reference's\n        `edge` (governs, references, describes) says how the content relates to\n        the instrument; it is not a statement of the instrument's legal effect.\n        If meta.degraded contains \"lrsf\", references could not be loaded: do not\n        conclude that a hit cites no instruments.\n    ",
 "inputSchema": {
  "properties": {
   "include_full_text": {
    "default": false,
    "title": "Include Full Text",
    "type": "boolean"
   },
   "limit": {
    "default": 10,
    "title": "Limit",
    "type": "integer"
   },
   "node_type": {
    "default": "all",
    "enum": [
     "tclp",
     "all"
    ],
    "title": "Node Type",
    "type": "string"
   },
   "query": {
    "title": "Query",
    "type": "string"
   },
   "rerank": {
    "default": true,
    "title": "Rerank",
    "type": "boolean"
   }
  },
  "required": [
   "query"
  ],
  "title": "searchArguments",
  "type": "object"
 },
 "name": "search",
 "outputSchema": {
  "$defs": {
   "_Reference": {
    "properties": {
     "edge": {
      "title": "Edge",
      "type": "string"
     },
     "jurisdiction": {
      "items": {
       "type": "string"
      },
      "title": "Jurisdiction",
      "type": "array"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "nature": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Nature"
     },
     "staleness": {
      "title": "Staleness",
      "type": "string"
     },
     "status": {
      "title": "Status",
      "type": "string"
     },
     "work_id": {
      "title": "Work Id",
      "type": "string"
     }
    },
    "required": [
     "edge",
     "work_id",
     "name",
     "nature",
     "jurisdiction",
     "status",
     "staleness"
    ],
    "title": "_Reference",
    "type": "object"
   },
   "_Related": {
    "properties": {
     "id": {
      "title": "Id",
      "type": "string"
     },
     "name": {
      "title": "Name",
      "type": "string"
     },
     "url": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Url"
     }
    },
    "required": [
     "id",
     "name",
     "url"
    ],
    "title": "_Related",
    "type": "object"
   },
   "_SearchHit": {
    "properties": {
     "content_type": {
      "title": "Content Type",
      "type": "string"
     },
     "entity_matches": {
