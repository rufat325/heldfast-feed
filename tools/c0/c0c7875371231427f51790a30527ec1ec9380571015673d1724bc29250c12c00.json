{
 "annotations": {
  "openWorldHint": true,
  "readOnlyHint": true,
  "title": "List past sweeps"
 },
 "description": "List past sweeps for a wallet address, with status and amounts. Useful for confirming a chain was already emptied before trying again.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "address": {
    "description": "Wallet address to list sweeps for",
    "pattern": "^0x[a-fA-F0-9]{40}$",
    "type": "string"
   },
   "limit": {
    "description": "Maximum number of results (default: 10)",
    "maximum": 100,
    "minimum": 1,
    "type": "integer"
   }
  },
  "required": [
   "address"
  ],
  "type": "object"
 },
 "name": "zerodust_list_sweeps"
}
