{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Check action against AMP manifest constraints"
 },
 "description": "Given an intended HTTP action (method + path or full URL) and a manifest, determine whether the action aligns with declared endpoints, authentication, payment onboarding, rate limits, and language in agent_notes.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "description": "Intended operation, e.g. \"POST /baking/validate-mix\", \"GET /health\", or \"POST https://api.example.com/v1/search\".",
    "minLength": 1,
    "type": "string"
   },
   "intends_unauthenticated": {
    "description": "Set true if the agent plans to call the API without credentials.",
    "type": "boolean"
   },
   "manifest": {
    "additionalProperties": {},
    "description": "Parsed AMP manifest object (agentmanifest-0.2 or agentmanifest-0.3).",
    "type": "object"
   },
   "payment_onboarded": {
    "description": "Set true if AMP payment onboarding is already complete for this API.",
    "type": "boolean"
   }
  },
  "required": [
   "action",
   "manifest"
  ],
  "type": "object"
 },
 "name": "check_agent_permissions",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "action": {
    "additionalProperties": false,
    "properties": {
     "method": {
      "type": [
       "string",
       "null"
      ]
     },
     "path": {
      "type": [
       "string",
       "null"
      ]
     },
     "raw": {
      "type": "string"
     }
    },
    "required": [
     "raw",
     "method",
     "path"
    ],
    "type": "object"
   },
   "compliant": {
    "type": "boolean"
   },
   "findings": {
    "items": {
     "additionalProperties": false,
     "properties": {
      "code": {
       "type": "string"
      },
      "message": {
       "type": "string"
      },
      "severity": {
       "enum": [
        "error",
        "warning",
        "info"
       ],
       "type": "string"
      }
     },
     "required": [
      "code",
      "severity",
      "message"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "matched_endpoint": {
    "anyOf": [
     {
      "additionalProperties": false,
      "properties": {
       "method": {
        "type": "string"
       },
       "path": {
        "type": "string"
       }
      },
      "required": [
       "path",
       "method"
      ],
      "type": "object"
     },
     {
      "type": "null"
     }
    ]
   },
   "verdict": {
    "enum": [
     "compliant",
     "violation",
     "warning",
     "unknown"
    ],
    "type": "string"
   }
  },
  "required": [
   "verdict",
   "compliant",
   "action",
   "findings",
   "matched_endpoint"
  ],
  "type": "object"
 },
 "title": "Check action against AMP manifest constraints"
}
