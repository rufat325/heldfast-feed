{
 "annotations": {
  "readOnlyHint": true,
  "title": "Search opportunities"
 },
 "description": "Search/list opportunities (deals). All filters optional; returns a page of opportunities. Copper REST: POST /opportunities/search.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "assignee_ids": {
    "description": "Filter to opportunities owned by these user ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "company_ids": {
    "description": "Filter to opportunities at these company ids.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "name": {
    "description": "Opportunity-name filter (substring match).",
    "type": "string"
   },
   "page_number": {
    "description": "1-based page number to fetch (default 1).",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "page_size": {
    "description": "Results per page (default 20, max 200).",
    "maximum": 200,
    "minimum": 1,
    "type": "integer"
   },
   "pipeline_ids": {
    "description": "Filter to opportunities in these pipelines.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "pipeline_stage_ids": {
    "description": "Filter to opportunities at these pipeline stages.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "sort_by": {
    "description": "Field to sort by, e.g. 'name', 'date_created', 'monetary_value' (default 'name').",
    "type": "string"
   },
   "sort_direction": {
    "description": "Sort direction \u2014 'asc' or 'desc' (default asc).",
    "enum": [
     "asc",
     "desc"
    ],
    "type": "string"
   },
   "status_ids": {
    "description": "Filter by status id: 0=Open, 1=Won, 2=Lost, 3=Abandoned.",
    "items": {
     "maximum": 9007199254740991,
     "minimum": -9007199254740991,
     "type": "integer"
    },
    "type": "array"
   },
   "tags": {
    "description": "Filter to opportunities carrying any of these tags.",
    "items": {
     "type": "string"
    },
    "type": "array"
   }
  },
  "type": "object"
 },
 "name": "copper_search_opportunities",
 "title": "Search opportunities"
}
