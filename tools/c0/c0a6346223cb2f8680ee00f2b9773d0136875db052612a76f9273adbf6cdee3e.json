{
 "annotations": {
  "destructiveHint": true,
  "title": "Edit a contact"
 },
 "description": "Edit an existing contact's name, email or contact custom fields (c-cf-<id>). Phone numbers are edited via happyfox_create_contact with the phone id. HappyFox: POST /api/1.1/json/user/<id>/.",
 "inputSchema": {
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
   "contact_id": {
    "description": "The contact id.",
    "maximum": 9007199254740991,
    "minimum": 1,
    "type": "integer"
   },
   "custom_fields": {
    "additionalProperties": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "number"
      },
      {
       "items": {
        "maximum": 9007199254740991,
        "minimum": -9007199254740991,
        "type": "integer"
       },
       "type": "array"
      }
     ]
    },
    "description": "Custom field values keyed \"c-cf-<id>\". Contact fields. Values: text = string, number = number, dropdown = choice id, multiple choice = array of choice ids, date = yyyy-mm-dd.",
    "propertyNames": {
     "pattern": "^(c\\-cf\\-)\\d+$",
     "type": "string"
    },
    "type": "object"
   },
   "email": {
    "description": "New email address.",
    "format": "email",
    "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$",
    "type": "string"
   },
   "name": {
    "description": "New name.",
    "minLength": 1,
    "type": "string"
   }
  },
  "required": [
   "contact_id"
  ],
  "type": "object"
 },
 "name": "happyfox_update_contact",
 "title": "Edit a contact"
}
