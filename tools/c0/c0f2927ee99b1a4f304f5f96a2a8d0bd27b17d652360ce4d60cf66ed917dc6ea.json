{
 "annotations": {
  "destructiveHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Create a MadMapper OSC surface/media control scaffold with source handoff notes for Syphon/Spout or NDI.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "active": {
    "default": false,
    "type": "boolean"
   },
   "handoff_mode": {
    "default": "syphon_spout",
    "enum": [
     "none",
     "syphon_spout",
     "ndi"
    ],
    "type": "string"
   },
   "madmapper_host": {
    "default": "127.0.0.1",
    "description": "MadMapper OSC host.",
    "type": "string"
   },
   "media_count": {
    "default": 4,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   },
   "name": {
    "default": "madmapper_surface",
    "description": "Generated baseCOMP name.",
    "type": "string"
   },
   "parent_path": {
    "default": "/project1",
    "description": "Parent COMP for the MadMapper scaffold.",
    "type": "string"
   },
   "receive_port": {
    "default": 8011,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "send_port": {
    "default": 8010,
    "maximum": 65535,
    "minimum": 1,
    "type": "integer"
   },
   "source_top_path": {
    "description": "Optional TD TOP intended for projection handoff.",
    "type": "string"
   },
   "surface_count": {
    "default": 4,
    "maximum": 64,
    "minimum": 1,
    "type": "integer"
   }
  },
  "type": "object"
 },
 "name": "connect_madmapper_surface",
 "title": "Connect MadMapper surface"
}
