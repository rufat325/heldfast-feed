{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": true,
  "openWorldHint": false,
  "readOnlyHint": true,
  "title": "Position size calculator"
 },
 "description": "Work out how large a position to take so that hitting the stop-loss loses only a chosen percentage of the account. Enter account size, risk percentage, entry price and stop-loss price. Returns units to buy, position value, amount at risk and stop distance. Figures are treated as GBP. Source: https://hopi.co.uk/position-size-calculator/",
 "inputSchema": {
  "properties": {
   "account": {
    "description": "Total account size",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "entry": {
    "description": "Entry price per unit",
    "exclusiveMinimum": 0,
    "type": "number"
   },
   "risk": {
    "description": "Percentage of the account to risk on this trade (above 0, up to 100)",
    "exclusiveMinimum": 0,
    "maximum": 100,
    "type": "number"
   },
   "stop": {
    "description": "Stop-loss price per unit",
    "minimum": 0,
    "type": "number"
   }
  },
  "required": [
   "account",
   "risk",
   "entry",
   "stop"
  ],
  "type": "object"
 },
 "name": "hopi_position_size_calculator",
 "outputSchema": {
  "additionalProperties": true,
  "properties": {
   "amountAtRisk": {
    "type": "number"
   },
   "amountAtRiskString": {
    "type": "string"
   },
   "direction": {
    "type": "string"
   },
   "note": {
    "type": "string"
   },
   "positionValue": {
    "type": "number"
   },
   "positionValueString": {
    "type": "string"
   },
   "source_url": {
    "description": "The tool's page on hopi.co.uk (cite or open to check the figure)",
    "type": "string"
   },
   "stopDistancePercent": {
    "type": "number"
   },
   "summary": {
    "type": "string"
   },
   "units": {
    "type": "number"
   },
   "unitsString": {
    "type": "string"
   }
  },
  "required": [
   "source_url",
   "summary"
  ],
  "type": "object"
 },
 "title": "Position size calculator"
}
