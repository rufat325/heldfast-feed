{
 "description": "Assign a task to a workspace member, or pass a null userId to unassign it.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "properties": {
   "taskId": {
    "minLength": 1,
    "type": "string"
   },
   "userId": {
    "anyOf": [
     {
      "minLength": 1,
      "type": "string"
     },
     {
      "type": "null"
     }
    ],
    "description": "Member user ID, or null to unassign"
   }
  },
  "required": [
   "taskId",
   "userId"
  ],
  "type": "object"
 },
 "name": "update_task_assignee"
}
