{"annotations":{"readOnlyHint":true},"description":"Poll one recent project-history window and return updates newer than an optional version cursor. In a group that starts before the cursor, only project operations at or after it are listed. Returns projectId, currentVersion (null when the window is empty), nextSinceVersion (pass it back as sinceVersion; on an empty window it repeats sinceVersion, or is null without one), hasEarlierHistory, gapDetected, and updates, newest first. Each update has fromVersion, toVersion, ISO startedAt and endedAt, authors ({ id, displayName } or null), paths, projectOperations (add, rename with newPath, remove, each with atVersion), labels, and origin ({ kind, path?, timestamp?, version? } or null).","inputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","properties":{"projectId":{"description":"Overleaf project ID","minLength":1,"type":"string"},"sinceVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["projectId"],"type":"object"},"name":"monitor_project_history","outputSchema":{"$schema":"https://json-schema.org/draft/2020-12/schema","additionalProperties":false,"properties":{"currentVersion":{"anyOf":[{"maximum":9007199254740991,"minimum":0,"type":"integer"},{"type":"null"}]},"gapDetected":{"type":"boolean"},"hasEarlierHistory":{"type":"boolean"},"nextSinceVersion":{"anyOf":[{"maximum":9007199254740991,"minimum":0,"type":"integer"},{"type":"null"}]},"projectId":{"type":"string"},"updates":{"items":{"additionalProperties":false,"properties":{"authors":{"items":{"anyOf":[{"additionalProperties":false,"properties":{"displayName":{"type":"string"},"id":{"type":"string"}},"required":["id","displayName"],"type":"object"},{"type":"null"}]},"type":"array"},"endedAt":{"type":"string"},"fromVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"labels":{"items":{"additionalProperties":false,"properties":{"comment":{"type":"string"},"createdAt":{"type":"string"},"id":{"type":"string"},"userDisplayName":{"type":["string","null"]},"userId":{"type":["string","null"]},"version":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["id","comment","version","createdAt","userId","userDisplayName"],"type":"object"},"type":"array"},"origin":{"anyOf":[{"additionalProperties":false,"properties":{"kind":{"type":"string"},"path":{"type":"string"},"timestamp":{"type":"string"},"version":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["kind"],"type":"object"},{"type":"null"}]},"paths":{"items":{"type":"string"},"type":"array"},"projectOperations":{"items":{"oneOf":[{"additionalProperties":false,"properties":{"atVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"path":{"type":"string"},"type":{"const":"add","type":"string"}},"required":["type","atVersion","path"],"type":"object"},{"additionalProperties":false,"properties":{"atVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"newPath":{"type":"string"},"path":{"type":"string"},"type":{"const":"rename","type":"string"}},"required":["type","atVersion","path","newPath"],"type":"object"},{"additionalProperties":false,"properties":{"atVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"},"path":{"type":"string"},"type":{"const":"remove","type":"string"}},"required":["type","atVersion","path"],"type":"object"}]},"type":"array"},"startedAt":{"type":"string"},"toVersion":{"maximum":9007199254740991,"minimum":0,"type":"integer"}},"required":["fromVersion","toVersion","startedAt","endedAt","authors","paths","projectOperations","labels","origin"],"type":"object"},"type":"array"}},"required":["projectId","currentVersion","nextSinceVersion","hasEarlierHistory","gapDetected","updates"],"type":"object"}}
