        },
        "title": {
         "type": "string"
        }
       },
       "required": [
        "id",
        "title",
        "price",
        "source",
        "authoritative"
       ],
       "type": "object"
      },
      "type": "array"
     },
     "selected_option_id": {
      "type": "string"
     }
    },
    "type": "object"
   },
   "id": {
    "type": "string"
   },
   "idempotency_key": {
    "type": "string"
   },
   "intent": {
    "additionalProperties": true,
    "properties": {
     "action": {
      "type": "string"
     },
     "context": {
      "type": "string"
     },
     "locale": {
      "type": "string"
     }
    },
    "required": [
     "action"
    ],
    "type": "object"
   },
   "label": {
    "type": "string"
   },
   "line_items": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "id": {
       "type": "string"
      },
      "price": {
       "additionalProperties": true,
       "properties": {
        "amount": {
         "type": "number"
        },
        "currency": {
         "type": "string"
        }
       },
       "required": [
        "amount",
        "currency"
       ],
       "type": "object"
      },
      "product_id": {
       "type": "string"
      },
      "quantity": {
       "type": "number"
      },
      "title": {
       "type": "string"
      },
      "variant_id": {
       "type": "string"
      },
      "variant_title": {
       "type": "string"
      }
     },
     "required": [
      "id",
      "product_id",
      "title",
      "quantity",
      "price"
     ],
     "type": "object"
    },
    "type": "array"
   },
   "next_action": {
    "additionalProperties": true,
    "properties": {
     "actor": {
      "const": "buyer",
      "type": "string"
     },
     "do": {
      "enum": [
       "approve",
       "pay"
      ],
      "type": "string"
     },
     "instruction": {
      "type": "string"
     },
     "reuse_arguments": {
      "items": {
       "enum": [
        "checkout_session_id",
        "checkout_id",
        "idempotency_key"
       ],
       "type": "string"
      },
      "type": "array"
     },
     "then_call": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
     },
     "url": {
      "type": "string"
     }
    },
    "required": [
     "actor",
     "do",
     "url",
     "instruction"
    ],
    "type": "object"
   },
   "next_step": {
    "const": "ask_user_payment_method",
    "type": "string"
   },
   "next_step_message": {
    "type": "string"
   },
   "payment_options": {
    "items": {
     "additionalProperties": true,
     "properties": {
      "available": {
       "type": "boolean"
      },
      "funding_source": {
       "anyOf": [
        {
         "enum": [
