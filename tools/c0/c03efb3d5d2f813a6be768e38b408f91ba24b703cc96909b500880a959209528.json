{
 "annotations": {
  "destructiveHint": false,
  "idempotentHint": false,
  "openWorldHint": true,
  "readOnlyHint": false
 },
 "description": "Add up to 100 documents/links to a voice agent's knowledge base in one call. Requires the OWNER or ADMIN role. Each is fetched and embedded independently in the background. Use this instead of calling create_voice_agent_resource in a loop.",
 "execution": {
  "taskSupport": "forbidden"
 },
 "inputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "agentId": {
    "minLength": 1,
    "type": "string"
   },
   "resources": {
    "description": "1 to 100 entries, each shaped like create_voice_agent_resource's body minus agentId.",
    "items": {
     "additionalProperties": false,
     "properties": {
      "action": {
       "enum": [
        "link",
        "presentation"
       ],
       "type": "string"
      },
      "contentType": {
       "enum": [
        "video",
        "pdf",
        "image"
       ],
       "type": "string"
      },
      "description": {
       "maxLength": 1000,
       "type": "string"
      },
      "title": {
       "maxLength": 200,
       "type": "string"
      },
      "url": {
       "format": "uri",
       "type": "string"
      }
     },
     "required": [
      "url",
      "title",
      "description",
      "action"
     ],
     "type": "object"
    },
    "maxItems": 100,
    "minItems": 1,
    "type": "array"
   }
  },
  "required": [
   "agentId",
   "resources"
  ],
  "type": "object"
 },
 "name": "bulk_create_voice_agent_resources",
 "outputSchema": {
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
   "data": {
    "description": "Response payload from the Speak AI API"
   }
  },
  "type": "object"
 },
 "title": "Bulk Create Voice Agent Resources"
}
